                ],
                "senses": [
                    {
                        "sense_id": "0504658b-c408-3315-b322-de4b1e10b4ec",
                        "entry_id": "38ba6672-0605-3614-ad53-16f54a183cf6",
                        "glosses": [
                            "taki, którego nie da się zatopić"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da604cf8-3b77-4d94-b7eb-aea3bb3ca791",
                                "sense_id": "0504658b-c408-3315-b322-de4b1e10b4ec",
                                "text": "Jak mówią w Cunardzie, nowy statek nie jest co prawda niezatapialny, ale zrobiono wszystko, co możliwe, by uczynić go bezpiecznym"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0f5e925e-2734-3b1f-ad76-fcc774a0dd7f",
                        "entry_id": "38ba6672-0605-3614-ad53-16f54a183cf6",
                        "glosses": [
                            "o osobie pełniącej jakieś stanowisko długo utrzymujący się na stanowisku"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ce9e8ef-7308-4a49-8beb-661a5e946ba2",
                        "source_entry_id": "38ba6672-0605-3614-ad53-16f54a183cf6",
                        "source_sense_id": "0504658b-c408-3315-b322-de4b1e10b4ec",
                        "target_lang_word": "unsinkable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsinkable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79a9f8a6-a361-36fc-9b57-7a42b53972de",
                                        "entry_id": "602f328d-c467-341c-ab90-2b41bf40dcf4",
                                        "glosses": [
                                            "That cannot be sunk."
                                        ],
                                        "tags": [
                                            "of ships"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8ee40bf-0493-4125-b46b-228f00a42c28",
                                                "sense_id": "79a9f8a6-a361-36fc-9b57-7a42b53972de",
                                                "text": "Any true Grecophile will understand when I say that the unsinkable condom and the smell of shit which precede the moment of illumination make it more exciting when it happens."
                                            },
                                            {
                                                "example_id": "5bdbeca2-181b-490c-ae9d-b99d58af0ebd",
                                                "sense_id": "79a9f8a6-a361-36fc-9b57-7a42b53972de",
                                                "text": "It was the kind of place with a neon martini glass for a name and an unsinkable turd floating in the toilet."
                                            },
                                            {
                                                "example_id": "bdf9cff5-df24-4a2a-abde-ada84d5d6f53",
                                                "sense_id": "79a9f8a6-a361-36fc-9b57-7a42b53972de",
                                                "text": "That was the connection, the hook, the key, that was the thought that had been bobbing around like an unsinkable turd in the toilet of my subconscious all night."
                                            },
                                            {
                                                "example_id": "6a7190d6-ed12-4130-8590-4ecde62ca873",
                                                "sense_id": "79a9f8a6-a361-36fc-9b57-7a42b53972de",
                                                "text": "The Sydney water team are hoping that by showing families the 'unflushable' and 'unsinkable' items, that the environment will be a lot better off."
                                            },
                                            {
                                                "example_id": "3348aba2-3947-4c79-a74d-3a22eb0c1d96",
                                                "sense_id": "79a9f8a6-a361-36fc-9b57-7a42b53972de",
                                                "text": "The RMS Titanic, a British passenger liner which had been marketed as “unsinkable”, sank on its maiden voyage in April 1912, on a route from Britain to the US after being holed by an iceberg, claiming the lives of 1,514 of the 2,224 passengers and crew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb8d9dad-901e-306d-a9e3-844b940cd8b5",
                                        "entry_id": "602f328d-c467-341c-ab90-2b41bf40dcf4",
                                        "glosses": [
                                            "That cannot be overcome or defeated."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "968367bc-e4c8-428b-a77b-ada4f869617e",
                                                "sense_id": "cb8d9dad-901e-306d-a9e3-844b940cd8b5",
                                                "text": "unsinkable optimism"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unsinkable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19f1c344-d818-391d-884c-73f8f96844de",
                                        "entry_id": "808857f6-9e6c-39bf-855a-3d03b957b0ca",
                                        "glosses": [
                                            "A ship that was designed to be unsinkable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e38116b-e10c-4e8b-bf6c-eb63af20df72",
                                                "sense_id": "19f1c344-d818-391d-884c-73f8f96844de",
                                                "text": "As the construction and preparation of the unsinkables would require six weeks or two months , I thought it best to make report of my plan to the admiral before the departure from Key West ."
                                            },
                                            {
                                                "example_id": "60c600d4-b888-4651-bc8a-0b0595643851",
                                                "sense_id": "19f1c344-d818-391d-884c-73f8f96844de",
                                                "text": "German unsinkables with their penetrating shell and safety magazines? That there was this acute material disparity between this type of ship of both nations there can be no doubt."
                                            },
                                            {
                                                "example_id": "6c8e3ae2-a1f4-43bc-97f9-329248c57aa8",
                                                "sense_id": "19f1c344-d818-391d-884c-73f8f96844de",
                                                "text": "But no large ship has vanished without trace since the whaleback Clifton, another of the “unsinkables” and skippered by Emmet Gallagher of Beaver Island, sailed through a crack in Lake Huron on September 22, 1924, taking all hands — a total of 28— down with her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
