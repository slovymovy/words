                    },
                    {
                        "translation_id": "f126a307-906a-427b-b931-d6382f30a3a4",
                        "source_entry_id": "f135cc5f-674f-3936-b54f-85afa1c4e498",
                        "source_sense_id": "dca48790-64b5-333d-953c-e812812eb2e0",
                        "source_sense_description": "not elegant",
                        "target_lang_word": "inélégant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inélégant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8af481a-3025-3be8-b8bd-e7590ab649e2",
                                        "entry_id": "a1fae44b-0de3-34ed-a44a-cbe4ab2979eb",
                                        "glosses": [
                                            "Qui manque d’élégance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8351da4-1062-48dc-a003-de9fd6c9f7f0",
                                                "sense_id": "b8af481a-3025-3be8-b8bd-e7590ab649e2",
                                                "text": "Et la pauvre Solange n'avait pas mis le pied dehors, de peur de se trouver mêlée à la foule inélégante qui encombre les rues de Paris, pendant les jours gras."
                                            },
                                            {
                                                "example_id": "62eacbbb-5657-4aaf-a194-b32669c8434d",
                                                "sense_id": "b8af481a-3025-3be8-b8bd-e7590ab649e2",
                                                "text": "Presque aussitôt, en un décolletage inélégant, Bert se penchait au-dessus de la table, sur laquelle il étalait une liasse de plans."
                                            },
                                            {
                                                "example_id": "7eb38171-94cc-4049-abc7-5e121ffba90a",
                                                "sense_id": "b8af481a-3025-3be8-b8bd-e7590ab649e2",
                                                "text": "J’aime à me vêtir avec le maximum d’élégance ; pourtant, à cause des défauts que je viens de relever dans ma structure et de mes moyens qui, sans que je puisse me dire pauvre, sont plutôt limités, je me juge d’ordinaire profondément inélégant."
                                            },
                                            {
                                                "example_id": "2ce2ef5c-881a-4deb-b055-a4f8252750fd",
                                                "sense_id": "b8af481a-3025-3be8-b8bd-e7590ab649e2",
                                                "text": "L’hostilité que j’ai contre le mien [son père] vient surtout de son aspect physique inélégant, de sa vulgarité bonasse et de l’absence totale de goût qu’il avait en matière artistique."
                                            },
                                            {
                                                "example_id": "7ea16311-7f1a-45e0-b131-25345ab6042c",
                                                "sense_id": "b8af481a-3025-3be8-b8bd-e7590ab649e2",
                                                "text": "En dépit des « ducon », des « je t’emmerde » et d’inélégants doigts d'honneur, Archi arriva au château avec un quart d'heure de retard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
