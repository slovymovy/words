                    {
                        "sense_id": "f424635f-c42b-3cd6-b137-79dd9d116f15",
                        "entry_id": "6e864006-eca3-35bf-afc2-6af40d82b4ab",
                        "glosses": [
                            "Climbing; represented with its front legs raised."
                        ],
                        "tags": [
                            "not-comparable",
                            "postpositional"
                        ],
                        "examples": [
                            {
                                "example_id": "909c005c-3457-49b3-97cb-ec71e5d3b732",
                                "sense_id": "f424635f-c42b-3cd6-b137-79dd9d116f15",
                                "text": "Sa. three goats, climant, ar. GARFORTH (Yorkshire)."
                            },
                            {
                                "example_id": "9d7aa1bc-0be1-4cec-b6aa-7fc4724deafa",
                                "sense_id": "f424635f-c42b-3cd6-b137-79dd9d116f15",
                                "text": "The nearest to the quartered coat, \"Vert, a goat passant arg.,\" that I find there is \"Vert, a goat climant arg.,\" assigned by Papworth to Felbury, of Northumberland, and similarly blazoned and assigned by Sir Bernard Burke[…]"
                            },
                            {
                                "example_id": "da9affa6-3859-4137-8b63-63f31a308fd7",
                                "sense_id": "f424635f-c42b-3cd6-b137-79dd9d116f15",
                                "text": "Gules, a goat climant argent, attired or — BARWELL. Gules, a goat salient argent, armed or — BENSTED. Argent, a goat rampant sable, the head and part of the neck of the first armed vert — DE BUCKTON."
                            },
                            {
                                "example_id": "d06ea1a4-5d43-4e19-901a-584b59a9f74c",
                                "sense_id": "f424635f-c42b-3cd6-b137-79dd9d116f15",
                                "text": "Obv. — A goat climant within a border of 12 cinquefoils interrupted by the type. Rev. — A device of doubtful interpretation intersected by two crosses in saltire and surmounted by a third."
                            }
                        ]
                    }
