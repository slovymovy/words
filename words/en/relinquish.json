{
    "word_family": [
        "relinquishment",
        "relinquisher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04c79ce3-6636-3ce6-93bf-0afa8c2f2a7a",
                    "sense_definition": "To formally give up a claim, office, or right; to voluntarily cease to keep or possess something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surrender_possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aging king decided to <w>relinquish</w> his throne to his eldest daughter during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Стареющий король решил <w>оставить</w> трон своей старшей дочери во время церемонии."
                            }
                        },
                        {
                            "text": "He was forced to <w>relinquish</w> control of the company after the board of directors voted against him.",
                            "target_lang_translations": {
                                "ru": "Он был вынужден <w>отказаться</w> от контроля над компанией после того, как совет директоров проголосовал против него."
                            }
                        }
                    ],
                    "synonyms": [
                        "renounce",
                        "surrender",
                        "cede",
                        "waive"
                    ],
                    "antonyms": [
                        "retain",
                        "keep",
                        "claim"
                    ],
                    "common_phrases": [
                        "relinquish control",
                        "relinquish a title",
                        "relinquish rights",
                        "relinquish power"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal or legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формально отказаться от претензии, должности или права; добровольно прекратить владение чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отказываться",
                                "target_lang_sense_clarification": "от прав или претензий"
                            },
                            {
                                "target_lang_word": "уступать",
                                "target_lang_sense_clarification": "передавать контроль или владение"
                            },
                            {
                                "target_lang_word": "оставлять",
                                "target_lang_sense_clarification": "пост или должность"
                            },
                            {
                                "target_lang_word": "передавать",
                                "target_lang_sense_clarification": "полномочия или власть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d78f4ec-c139-3d59-b3e7-028fbf3bd553",
                    "sense_definition": "To stop holding or keeping something; to let go of a physical object or a metaphorical grip.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "release",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child would not <w>relinquish</w> his grip on the toy even when it was time to go home.",
                            "target_lang_translations": {
                                "ru": "Ребенок не хотел <w>отпускать</w> игрушку, даже когда пришло время идти домой."
                            }
                        },
                        {
                            "text": "The team took an early lead and refused to <w>relinquish</w> their advantage for the rest of the match.",
                            "target_lang_translations": {
                                "ru": "Команда захватила лидерство в начале игры и отказывалась <w>упускать</w> свое преимущество до конца матча."
                            }
                        }
                    ],
                    "synonyms": [
                        "release",
                        "loosen",
                        "yield"
                    ],
                    "antonyms": [
                        "clutch",
                        "grasp",
                        "hold"
                    ],
                    "common_phrases": [
                        "relinquish a grip",
                        "relinquish a lead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать держать или сохранять что-либо; выпустить физический объект или ослабить метафорическую хватку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпускать",
                                "target_lang_sense_clarification": "физически разжимать руки"
                            },
                            {
                                "target_lang_word": "выпускать",
                                "target_lang_sense_clarification": "из рук"
                            },
                            {
                                "target_lang_word": "упускать",
                                "target_lang_sense_clarification": "преимущество или лидерство"
                            },
                            {
                                "target_lang_word": "ослаблять",
                                "target_lang_sense_clarification": "хватку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ae03fde-2971-3fa7-9566-b998c3683cff",
                    "sense_definition": "To withdraw or give up a plan, habit, or demand, often as a result of negotiation or necessity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abandonment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The negotiators had to <w>relinquish</w> their demands for higher wages to reach a final agreement.",
                            "target_lang_translations": {
                                "ru": "Переговорщикам пришлось <w>отказаться</w> от своих требований о повышении зарплаты, чтобы достичь окончательного соглашения."
                            }
                        },
                        {
                            "text": "She found it difficult to <w>relinquish</w> her long-held beliefs even when presented with new evidence.",
                            "target_lang_translations": {
                                "ru": "Ей было трудно <w>оставить</w> свои давние убеждения, даже когда ей представили новые доказательства."
                            }
                        }
                    ],
                    "synonyms": [
                        "abandon",
                        "discard",
                        "forsake"
                    ],
                    "antonyms": [
                        "persist",
                        "maintain"
                    ],
                    "common_phrases": [
                        "relinquish a claim",
                        "relinquish a demand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отозвать или оставить план, привычку или требование, часто в результате переговоров или необходимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отказываться",
                                "target_lang_sense_clarification": "от требований или убеждений"
                            },
                            {
                                "target_lang_word": "оставлять",
                                "target_lang_sense_clarification": "привычку или план"
                            },
                            {
                                "target_lang_word": "сдавать",
                                "target_lang_sense_clarification": "позиции в споре"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}