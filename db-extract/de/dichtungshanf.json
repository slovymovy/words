                ],
                "senses": [
                    {
                        "sense_id": "a9644684-0557-3510-945e-5c30bca649d4",
                        "entry_id": "d2f03533-46a7-3689-9a7a-45914949d502",
                        "glosses": [
                            "hanfenes Abdichtmittel für Schraubverbindungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54b40ecd-6694-49d0-9eac-40bc5655db9a",
                                "sense_id": "a9644684-0557-3510-945e-5c30bca649d4",
                                "text": "Mit Dichtungshanf können Sie Gas- und Wasserleitungen fachgerecht abdichten."
                            },
                            {
                                "example_id": "9e49ee2e-a692-44f5-aad4-7160465018b8",
                                "sense_id": "a9644684-0557-3510-945e-5c30bca649d4",
                                "text": "Der Dichtungshanf wird zur Abdichtung von Gewinden vorwiegend in der Sanitär- und Heizungsbranche verwendet."
                            },
                            {
                                "example_id": "6822f752-a32c-4bba-9888-2ad63ba96a02",
                                "sense_id": "a9644684-0557-3510-945e-5c30bca649d4",
                                "text": "Die zur Erzeugung von Dichtungshanf benötigte Hanfreibeanlage funktionierte, war aber nur zeitweise in Betrieb, weil der Bedarf an Dichtungshanf kein derartig großer war, um die Maschine dauernd zu verwenden."
                            },
                            {
                                "example_id": "a4d4b255-0dce-4de7-8c01-11da172667e5",
                                "sense_id": "a9644684-0557-3510-945e-5c30bca649d4",
                                "text": "Roy holte ein Smartphone aus seinem Rucksack und zeigte seine Werkzeuge, die er immer bei sich trug: Zentimetermaß, Schrauben und Muttern, Dichtungshanf, Tuben mit Silicon und Herdplattenschwärze, Schraubenzieher – er war für jeden Auftrag vorbereitet."
                            },
                            {
                                "example_id": "c511966a-e8fb-4773-a96d-647fbd626647",
                                "sense_id": "a9644684-0557-3510-945e-5c30bca649d4",
                                "text": "Die Rohstoffe Hanf und Jute stiegen ganz beträchtlich im Preise; nur italienischer Dichtungshanf ging infolge der günstigen Ernte etwas im Preise zurück."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
