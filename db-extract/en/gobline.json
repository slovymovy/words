                "senses": [
                    {
                        "sense_id": "ff9c2659-970f-3a63-87fe-6d5dcdafc4ca",
                        "entry_id": "481eb5f4-e5e9-3e32-b6a5-d6652ae800be",
                        "glosses": [
                            "Goblin."
                        ],
                        "tags": [
                            "India"
                        ],
                        "examples": [
                            {
                                "example_id": "98543ccb-6cf6-4509-81fa-0fe5cc20de63",
                                "sense_id": "ff9c2659-970f-3a63-87fe-6d5dcdafc4ca",
                                "text": "So, my dear Yudhishthira, the observance of the fast on the Jaya Ekadahee day saves the observer from falling into the low strata of ghosts, gobline and fiends, affords all the merits attainable by sacrifices, charities and penances and ensures pleasurable life in the Heaven for thousands of years."
                            },
                            {
                                "example_id": "1e3c681b-cdbb-4d25-8b09-e1dbf8ede82b",
                                "sense_id": "ff9c2659-970f-3a63-87fe-6d5dcdafc4ca",
                                "text": "In the paintings of the Ajanta caves, executed when Buddhism dominated north India, \"the female, or Rākshasi, is represented as a gobline in the shape of a handsome woman, red, fair, or dark, with flowing hair, killing men and feeding on their flesh and blood\" (Crooke 1907:238)."
                            },
                            {
                                "example_id": "3778b1dd-5afc-4d41-952c-8bb66af02aa7",
                                "sense_id": "ff9c2659-970f-3a63-87fe-6d5dcdafc4ca",
                                "text": "The gobline tilted her head."
                            }
                        ]
                    }
                ],
