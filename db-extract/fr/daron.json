        "fr-extract.jsonl": [
            {
                "entry_id": "7eb799ca-7b9e-3ab9-853c-c5182fac9568",
                "word": "daron",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9f798340-a6cc-472a-84f3-e0f6412be28a",
                        "entry_id": "7eb799ca-7b9e-3ab9-853c-c5182fac9568",
                        "tags": [
                            "plural"
                        ],
                        "form": "darons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "deb530f7-fb59-3af4-ba23-cc5a39d07e20",
                        "entry_id": "7eb799ca-7b9e-3ab9-853c-c5182fac9568",
                        "glosses": [
                            "Père."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b70aafbf-1863-43fa-986d-d3b3b6319523",
                                "sense_id": "deb530f7-fb59-3af4-ba23-cc5a39d07e20",
                                "text": "J’en avais un écœurement qu’était même plus racontable de retrouver, sur la table, toutes les conneries de mon daron, étalées là, noir sur blanc."
                            },
                            {
                                "example_id": "5131ef9a-3f20-47ed-b8f0-d30b387e091f",
                                "sense_id": "deb530f7-fb59-3af4-ba23-cc5a39d07e20",
                                "text": "Après une journée éprouvante de darons, une partie d’Imaginarium, c’est tout sauf du repos."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b64b7e9-0012-342d-9364-fbb540672b57",
                        "entry_id": "7eb799ca-7b9e-3ab9-853c-c5182fac9568",
                        "glosses": [
                            "Patron, supérieur hiérarchique."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "417a5df8-9f6a-4d30-a8af-a3bc5f189750",
                                "sense_id": "7b64b7e9-0012-342d-9364-fbb540672b57",
                                "text": "Derrière son burlingue, le daron est impavide. ."
                            },
                            {
                                "example_id": "caf99736-fc7f-4f22-bf5b-4bc1c8fea6c8",
                                "sense_id": "7b64b7e9-0012-342d-9364-fbb540672b57",
                                "text": "Ça le passionnait ce vieux daron... Il voulait se faire une idée."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e614b55-eeb8-3d99-b433-568687592b4c",
                        "entry_id": "7eb799ca-7b9e-3ab9-853c-c5182fac9568",
                        "glosses": [
                            "Au jeu des osselets, un des cinq osselets identifié par une couleur différente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfb3ec7d-2126-456e-9c8f-24c7701ce2ad",
                                "sense_id": "9e614b55-eeb8-3d99-b433-568687592b4c",
                                "text": "Un jeu d’osselets comporte, habituellement, cinq osselets, dont un peut être identifié, par exemple par une couleur différente. On appelle cet osselet « le daron ».."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe72eb6e-b115-4f5d-b872-12245b0a54df",
                        "source_entry_id": "7eb799ca-7b9e-3ab9-853c-c5182fac9568",
                        "target_lang_word": "old man",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "old man",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d599e840-0e88-3330-b824-af8395ed79d4",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "An elderly man."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literally",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6134631-ff77-3736-b67f-112b84ff9830",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "One's father."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aabf2fa-047e-4d7d-b8ac-6376ba1c518f",
                                                "sense_id": "d6134631-ff77-3736-b67f-112b84ff9830",
                                                "text": "He smacked me around some. Didn't everybody's old man?"
                                            },
                                            {
                                                "example_id": "f9d55b14-77c9-4d48-9909-c54ad0781637",
                                                "sense_id": "d6134631-ff77-3736-b67f-112b84ff9830",
                                                "text": "‘I use the same back-hand flip me old man useda use to knock me old lady arse-over-’ead an’ Stiffer than Mo.’"
                                            },
                                            {
                                                "example_id": "718a6eaa-60f7-44ed-9e84-1e17477e4ddc",
                                                "sense_id": "d6134631-ff77-3736-b67f-112b84ff9830",
                                                "text": "See, my old man's got a problem / He lives with a bottle, that's the way it is"
                                            },
                                            {
                                                "example_id": "4327355c-f541-4638-9c32-fc06dcb99b75",
                                                "sense_id": "d6134631-ff77-3736-b67f-112b84ff9830",
                                                "text": "\"How'd your in-laws feel about you marryin' your wife? Maybe you could pass the paper bag and the comb test, but your old man had dark skin, kinky hair, and he was a dyed-in-the-wool baptist from out in the sticks.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3265b1d-0392-34e6-9ccb-fa7dfbba536a",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "A husband, or male significant other, irrespective of age."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcaf4eba-4cd6-490a-b007-0c986704cfa0",
                                                "sense_id": "f3265b1d-0392-34e6-9ccb-fa7dfbba536a",
                                                "text": "“[…] Now if that thing is balling—and your old lady or your old man is off somewhere flashing and doesn't want to be touched—well, you get put down on acid, you can be on a bummer for months.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce7c257d-7d86-39c1-8924-66fcd9fc03d7",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "One's male employer, irrespective of age."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b7e651c-9d38-3a1d-ae8d-e01137806f48",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "A unit's commanding officer, or the commander of a naval vessel, irrespective of age."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d45804a8-1d69-3207-9794-91fb94f19520",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "Term of address for a male friend, irrespective of age."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2bfb163-1335-4642-bb1c-c25ac8c2e3c6",
                                                "sense_id": "d45804a8-1d69-3207-9794-91fb94f19520",
                                                "text": "“Don't mention it, old man,” I responded courteously."
                                            },
                                            {
                                                "example_id": "7ca2f554-8503-4b8e-a478-bc556d11379b",
                                                "sense_id": "d45804a8-1d69-3207-9794-91fb94f19520",
                                                "text": "'Coming up, coming up, coming up,' Pop said. 'There you are, Charley, old man. Larkin Special. Don't ask what's in it. Don't stare at it. Don't think. Just drink it down. In ten minutes you'll feel perfick again.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c47ec811-ca3e-3e46-b9b1-25b12da537a8",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "Synonym of Old Adam."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad46cb20-7aaf-3561-94eb-135e057a3895",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "Synonym of southernwood."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cfa2e61-716f-38dc-bb43-93513e73ebad",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "The state of human nature without the spiritual transformation brought about by redemption through Jesus Christ."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cec5f53b-f83e-415a-9d27-9090f216ba36",
                                                "sense_id": "7cfa2e61-716f-38dc-bb43-93513e73ebad",
                                                "text": "A new light has entered into the life and transformed it wonderfully, the soul has been born again, the old man has been put off, the new man which is akin to Jesus Christ has been put on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "581e43ef-80e0-3276-b65a-ca3eb087d72c",
                                        "entry_id": "b5efbe7c-7f4e-388e-a1a6-566a5ffc284b",
                                        "glosses": [
                                            "Used attributively to denote something of exceptional size, strength, age etc."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9ceb6d2-7037-4eb2-8e34-bc1a1a38e360",
                                                "sense_id": "581e43ef-80e0-3276-b65a-ca3eb087d72c",
                                                "text": "‘You watch out for them old man brown snakes in here. I seen a shed skin back there in the hall.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
