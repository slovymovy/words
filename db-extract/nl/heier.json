                        ],
                        "examples": [
                            {
                                "example_id": "e5660d6e-6598-48fd-9b93-98720460fc26",
                                "sense_id": "d2b3613f-2975-3ef2-9964-060603331110",
                                "text": "Heiers hebben vrijdagmiddag bij werkzaamheden in de Leeuwarder wijk Bilgaard menselijke resten gevonden. De heiers waren aan het werk op het terrein van de gesloopte sporthal aan de Fennen."
                            },
                            {
                                "example_id": "d4041cac-3118-48d2-bc50-a13e9bb27e5b",
                                "sense_id": "d2b3613f-2975-3ef2-9964-060603331110",
                                "text": "Er werd niet geheid tussen 13 en 17 februari van 09.00 tot 12.00 uur. Bij eventuele vertraging van de werkzaamheden kon de bouwer op een ander tijdstip langer doorgaan. Dat zou niet zijn gebeurd. \"Of er wel of niet langer door geheid moet worden, is niet aan de gemeente maar aan de heier\", aldus de woordvoerster van de gemeente."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d85d47f-edac-364e-b528-2e14349c79ab",
                        "entry_id": "545295d2-4a1f-3b26-8dec-3be704814cb9",
                        "glosses": [
                            "machine waarmee men heit"
                        ],
