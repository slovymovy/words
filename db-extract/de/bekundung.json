                ],
                "senses": [
                    {
                        "sense_id": "edb9521a-9655-320f-a090-2f9254205e07",
                        "entry_id": "d59201df-ba2d-3292-9fad-f173ea7f8c06",
                        "glosses": [
                            "Handlung, etwas zum Ausdruck zu bringen, etwas auszusagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c032e734-9a6b-4e0e-9e1f-d5f93eb4cb0a",
                                "sense_id": "edb9521a-9655-320f-a090-2f9254205e07",
                                "text": "„Die mündliche Bekundung des Scheidungswillens war für den Vollzug einer Scheidung ausreichend und konnte von beiden Seiten ausgesprochen werden, sofern es sich um eine Ehe (matrimonium) handelte.“"
                            },
                            {
                                "example_id": "f48f6065-4215-4ba0-9cfb-e2d61c9e1434",
                                "sense_id": "edb9521a-9655-320f-a090-2f9254205e07",
                                "text": "„Jede Bekundung nationalen oder religiösen Hasses und jede Rassenhetze ist verboten und wird auf das strengste bestraft.“"
                            },
                            {
                                "example_id": "f727f0c4-752b-4107-9076-a4a7716c7f5f",
                                "sense_id": "edb9521a-9655-320f-a090-2f9254205e07",
                                "text": "„Die Meinungsfreiheit hängt auch sehr eng mit der Versammlungsfreiheit zusammen, denn diese ist ein Instrument der außerparlamentarischen Opposition und Bekundung des Volkswillens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
