                "senses": [
                    {
                        "sense_id": "abfafcb3-8987-34ab-9bc7-cb99bc025742",
                        "entry_id": "2d5281a6-dfdd-3fb2-9486-e9876fe073ab",
                        "glosses": [
                            "Bestimmung im Vorwege; Festlegung zukünftiger Ereignisse; Vorherbestimmung des Schicksals eines Einzelnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24346b1f-d92a-405f-8523-f55f5e0c0559",
                                "sense_id": "abfafcb3-8987-34ab-9bc7-cb99bc025742",
                                "text": "„Zärtlich hielt sie seine Hand umfasst und fragte: ‚Glaubst du an Vorbestimmung, Ethan?‘“"
                            },
                            {
                                "example_id": "6cb0dde4-8947-4b26-9262-36141ef8a4b1",
                                "sense_id": "abfafcb3-8987-34ab-9bc7-cb99bc025742",
                                "text": "„Dadurch, dass man weitergeht, als Gottes Wort es zulässt, werden die Vorkenntnis, die Auserwählung und die Vorbestimmung manchmal in einen falschen Zusammenhang gestellt.“"
                            },
                            {
                                "example_id": "b0610535-d45f-4dd7-a5db-b5d349ece45a",
                                "sense_id": "abfafcb3-8987-34ab-9bc7-cb99bc025742",
                                "text": "„Vielleicht ist das, was wir so gerne Schicksal nennen, nichts anderes als Vorbestimmung.“"
                            },
                            {
                                "example_id": "27c02f18-aff9-4dfc-b6a0-01bcd9b0bac7",
                                "sense_id": "abfafcb3-8987-34ab-9bc7-cb99bc025742",
                                "text": "„Das Mittelalter zerbrach sich den Kopf über die Vorbestimmung: wenn Gott alles weiß und bestimmt, voraus weiß und vorbestimmt, wer wird gut, wer schlecht sein, wer erlöst und wer verdammt?“"
                            },
                            {
                                "example_id": "c0923ee2-8f3f-4faa-9fe8-4bf104a7be73",
                                "sense_id": "abfafcb3-8987-34ab-9bc7-cb99bc025742",
                                "text": "„Das bedeutet, wollte man eine Vorbestimmung ändern, gelingt es nicht dadurch, dass man einfach eine Neue über die Alte stülpt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
