                    {
                        "sense_id": "3dd378cf-76ea-37a9-a90f-e1c282350447",
                        "entry_id": "ed97daa8-9a37-3252-a94e-29e552b7abea",
                        "glosses": [
                            "execution (of a task or plan)"
