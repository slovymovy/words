                        "de": "Mit viel Licht erfüllt, gut beleuchtet; das Gegenteil von dunkel."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светлый",
                                "target_lang_sense_clarification": "хорошо освещенный"
