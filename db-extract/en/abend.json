                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b03435ca-78cc-32f2-9303-c712063fa2c7",
                        "entry_id": "c540b99c-99e2-3423-b949-b41041faaf60",
                        "glosses": [
                            "Acronym of absent by enforced net deprivation."
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
                            "alt-of",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "06ae22d7-0c64-4434-b461-7ce8569bceb6",
                                "sense_id": "b03435ca-78cc-32f2-9303-c712063fa2c7",
                                "text": "Folks, I just heard from Paul Saunders, another of our patrons who is ABEND at the moment."
                            },
                            {
                                "example_id": "5d180d1c-2f90-41b3-bd08-fec1d8493a81",
                                "sense_id": "b03435ca-78cc-32f2-9303-c712063fa2c7",
                                "text": "ABEND when translated means i had a VERY crappy 5 day weekend and now i am WAY behind at work and i won't be around for awhile till i catch up."
                            },
                            {
                                "example_id": "df43b547-e38f-460a-8e42-b2394d407836",
                                "sense_id": "b03435ca-78cc-32f2-9303-c712063fa2c7",
                                "text": "Unfortunately she is ABEND. Some of us Jackals have been taking turns filling in during her absence."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
