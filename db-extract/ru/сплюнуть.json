                    },
                    {
                        "form_id": "d6700455-93d4-4209-8fb7-e6beca39c3cf",
                        "entry_id": "49377c5f-dbb9-3303-b3b5-2440b9aacdb9",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "сплю́нувши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27b92860-9ab1-3418-a612-cf720d9a8e8d",
                        "entry_id": "49377c5f-dbb9-3303-b3b5-2440b9aacdb9",
                        "glosses": [
                            "выплюнуть изо рта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48e8d92a-c1b1-4849-95c8-3783e665a71a",
                                "sense_id": "27b92860-9ab1-3418-a612-cf720d9a8e8d",
                                "text": "Чтоб не дать слабину, он зажал его пальцами, кровь забулькала в горле, он попробовал сплюнуть её, а она улучила момент и опять побежала по пальцам и по губам."
                            }
                        ]
                    },
                    {
                        "sense_id": "a70a8b40-81df-3c55-a5dd-6470554ee676",
                        "entry_id": "49377c5f-dbb9-3303-b3b5-2440b9aacdb9",
                        "glosses": [
                            "плюнуть с силой (с целью выразить какое-нибудь чувство)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a278761-c2ba-4c04-bb47-208d06474e8c",
                                "sense_id": "a70a8b40-81df-3c55-a5dd-6470554ee676",
                                "text": "Помолчав, довольно свирепо сплюнул."
                            },
                            {
                                "example_id": "9d7fbd44-7897-479e-9211-2a35b1d36b26",
                                "sense_id": "a70a8b40-81df-3c55-a5dd-6470554ee676",
                                "text": "Чертовка! — негромко выругался Василий и обиженно сплюнул."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87de0db9-28ab-4b1f-9d4e-225a95224a39",
                        "source_entry_id": "49377c5f-dbb9-3303-b3b5-2440b9aacdb9",
                        "target_lang_word": "ausspucken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ausspucken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b88f8319-a046-38dd-a83a-353d39904364",
                                        "entry_id": "b20e212c-f50a-371d-983a-2801305cfddf",
                                        "glosses": [
                                            "etwas aus dem Mund stoßen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd6ebb49-d776-4c91-9f9e-4f0557bcfdc3",
                                                "sense_id": "b88f8319-a046-38dd-a83a-353d39904364",
                                                "text": "Er aß eine Kirsche und spuckte den Kern aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "115ea274-1499-34ab-9804-317f800ba108",
                                        "entry_id": "b20e212c-f50a-371d-983a-2801305cfddf",
                                        "glosses": [
                                            "Speichel aus dem Mund ausstoßen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daade301-793b-4f99-9dd6-d1cabb2dfb97",
                                                "sense_id": "115ea274-1499-34ab-9804-317f800ba108",
                                                "text": "„Die Dame sah ihm nach, schnitt eine Grimasse und spuckte ostentativ aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2cd881cf-b2b3-3443-addb-d574f3a1b730",
                                        "entry_id": "b20e212c-f50a-371d-983a-2801305cfddf",
                                        "glosses": [
                                            "übertragen, (viel) Geld ausgeben"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0793ebfb-df76-4106-9500-5926063018b0",
                                                "sense_id": "2cd881cf-b2b3-3443-addb-d574f3a1b730",
                                                "text": "Auf in die Spielhalle, dort spuckt der Automat das Kleingeld nur so aus!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "bddfe974-38fc-3da4-b519-638e88abad6e",
                                        "entry_id": "b20e212c-f50a-371d-983a-2801305cfddf",
                                        "glosses": [
                                            "übertragen, (große Mengen von etwas) auswerfen; (als Ergebnis) hervorbringen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6151cfbc-0f40-4ce9-9f5f-b08c88fdfd18",
                                                "sense_id": "bddfe974-38fc-3da4-b519-638e88abad6e",
                                                "text": "Es dauerte ein Weilchen, bis der Computer das Ergebnis ausspuckte."
                                            },
                                            {
                                                "example_id": "c18b56d2-8e56-4ca5-b4f7-3e0d2c15ae0b",
                                                "sense_id": "bddfe974-38fc-3da4-b519-638e88abad6e",
                                                "text": "„Bei Volkswagen ist eine Pilotanlage im niedersächsischen Salzgitter bereits in Betrieb, direkt neben der geplanten Gigafabrik, die von 2024 an jährlich Akkus für bis zu 500.000 E-Autos ausspucken soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e3beec2f-e1d3-32c4-b57d-ac67e83eb013",
                                        "entry_id": "b20e212c-f50a-371d-983a-2801305cfddf",
                                        "glosses": [
                                            "übertragen, meist als eine Aufforderung, Information preiszugeben"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc9ea787-0277-4292-8123-78155edc26f3",
                                                "sense_id": "e3beec2f-e1d3-32c4-b57d-ac67e83eb013",
                                                "text": "„Was? Du weißt, wer es war? Nun spuck's schon endlich aus!“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
