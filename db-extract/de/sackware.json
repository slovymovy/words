                ],
                "senses": [
                    {
                        "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                        "entry_id": "69f64ffa-cfaf-3a6c-9983-5c805fdb35bc",
                        "glosses": [
                            "schüttfähiges Produkt (beispielsweise Kaffee, Kakao, Mehl, Reis, Zucker, Holzpellets, Gartenerde, Zement), das in Säcken verpackt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d475ead0-9588-4968-beba-d22209da15b2",
                                "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                                "text": "„Während loser Kaffee direkt in ein Silo zur Zwischenlagerung gefördert werden kann, ist die Sackware erst maschinell zu öffnen und zu entleeren.“"
                            },
                            {
                                "example_id": "955e27f5-cf4b-44b0-b3b0-4a096aaca885",
                                "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                                "text": "[Mehl:] „Die Sackware wurde in den fünf Obergeschossen gelagert, während im Erdgeschoss der Versand untergebracht war.“"
                            },
                            {
                                "example_id": "60de7678-01ed-49ca-b9bc-3a06896a1c3b",
                                "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                                "text": "[Pelletheizung:] „Gleichzeitig sind sie ähnlich leicht zu bedienen: Die Pellets werden als Sackware in den integrierten Vorratsbehälter geschüttet und gelangen von dort vollautomatisch in den Brennraum.“"
                            },
                            {
                                "example_id": "956202e7-96bd-4059-aafe-729171a9012a",
                                "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                                "text": "[Holzpellets:] „Der Brennstoff wird als Sackware (15–20 kg) zur händischen Befüllung, in 1–2 m³ großen Kunststofftüten (Bigbags) oder lose angeboten.“"
                            },
                            {
                                "example_id": "ef0adcf4-0763-4ebd-8406-b9c38e8b24e4",
                                "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                                "text": "„Die 15-kg-Sackware kostet zwischen 7 und 20 % mehr als lose Ware und auch für Bigbags (750 bis 1000 kg) werden Aufschläge berechnet.“"
                            },
                            {
                                "example_id": "c7640057-6515-4b64-a3bc-79f8eba00ef2",
                                "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                                "text": "[Komposterde:] „Hierbei schwankten die Erlöse zwischen einer kostenneutralen Abgabe in die Landwirtschaft (teilweise frei Acker) bis hin zu Erlösen von 3-4 € für Kompost in Sackware (ca. 40 bis 50 Liter Säcke).“"
                            },
                            {
                                "example_id": "7d84d18d-f683-4eea-aeb4-eb135e50dc2d",
                                "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                                "text": "[Komposterde:] „Praxistipp: Wer nur ein Balkon-Hochbeet zu befüllen hat, kann ohne Bedenken zu vorkonfektionierter Sackware greifen.“"
                            },
                            {
                                "example_id": "d5d90e66-4d57-40e8-b85d-7a725b3ce285",
                                "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                                "text": "„Torffreie Blumenerde können Sie auch als Sackware kaufen.“"
                            },
                            {
                                "example_id": "a8cc7705-301f-4320-ad80-b92668130195",
                                "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                                "text": "[Blumenerde:] „Gerade wer davon große Mengen benötigt – z.B. um das neue Hochbeet zu befüllen – kommt mit selbst gemischter Erde günstiger davon, als wenn man entsprechend viel Sackware im Gartencenter kauft.“"
                            },
                            {
                                "example_id": "96517dcb-9ba2-4606-ab14-493bb6430891",
                                "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                                "text": "[Baumarkteröffnungen in der Coronapandemie:] „Vor allem im Gartenbereich ist jetzt Hochsaison: Pflanzen, Erde, Gartengeräte. Aber auch Sackware für den Bau, Außen und Innenfarben werden grad jetzt bei der Wiedereröffnung gut gehen.“"
                            },
                            {
                                "example_id": "d8d05d0c-aefe-4886-80f7-41b0bafbb631",
                                "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                                "text": "[Handel in der Coronapandemie:] „Dank der aktuellen Lockerungen für den Einzelhandel bietet das Erdenwerk für alle Pflanzen- und Gartenbegeisterte nun wieder Sackware für Hochbeete, Garten und Blumen, sowie Erden und Kompost zum Selbstabfüllen an.“"
                            },
                            {
                                "example_id": "6fdf712f-9c13-49ba-a312-3db60ac03431",
                                "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                                "text": "„Kleine Mengen von fertig angemischtem Mörtel können Sie als fertige Sackware im Baustoffhandel oder Baumarkt erwerben.“"
                            },
                            {
                                "example_id": "10f14bdd-991c-4395-b548-1479e9a7ac32",
                                "sense_id": "1b5ec1a0-fce0-3d74-a139-75133b840def",
                                "text": "„«Der Gipser-Beruf beansprucht einen körperlich sehr», sagt der Gipser Lukas Scherler. Sackware und Gipsplatten schleppen, Wände verputzen, immer wieder Leitern hoch- und runtersteigen: Das setze schon ihm zu, sagt der 31-Jährige, der umso mehr über die Leistung seiner älteren Kollegen staunt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
