                        "source_entry_id": "341cab9a-39b4-3479-a82f-f88719b6610a",
                        "source_sense_id": "66823984-21d7-3673-9c77-e05e42282448",
                        "source_sense_description": "person from the fictional land of Ruritania",
                        "target_lang_word": "persan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
