                            {
                                "example_id": "a8edc9da-bd05-47a6-94e7-b247e766cf53",
                                "sense_id": "30b32d12-fd35-3b4f-918c-aa9f7b283818",
                                "text": "Dat kwam vermoedelijk mede door de bijna martelaar-achtige manier waarop hij stierf, die knie op zijn nek, het ‘I can’t breathe’, kwetsbaar, bijna Christusachtig."
                            }
                        ]
