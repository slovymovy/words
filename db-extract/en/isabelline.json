                        "sense_id": "2112a9ad-1559-35df-9a6a-4108384a9e45",
                        "entry_id": "4ba0aa8f-54b0-3f69-8a4f-7c67e654e93a",
                        "glosses": [
                            "Coloured a greyish yellow."
                        ],
                        "tags": [
                            "of animals"
                        ],
                        "examples": [
                            {
                                "example_id": "0454b7a9-f063-4fa5-9fda-267d2abea069",
                                "sense_id": "2112a9ad-1559-35df-9a6a-4108384a9e45",
                                "text": "The isabelline (or Daurian) shrike is a greyish-yellow and hunts from prominent perches, impaling the corpses on thorns as a larder."
                            },
                            {
                                "example_id": "1be42aca-2e52-4ee5-8b5a-2f791ce2d45a",
                                "sense_id": "2112a9ad-1559-35df-9a6a-4108384a9e45",
                                "text": "As Mr. Tristram has remarked, in regard to the inhabitants of the Sahara, all are protected by their “isabelline or sand-colour.”"
                            },
                            {
                                "example_id": "d26d71da-e194-421c-926f-6b7286dc3e08",
                                "sense_id": "2112a9ad-1559-35df-9a6a-4108384a9e45",
                                "text": "Isabelline -us: pale yellow with some red and brown [chronic lemon with a little carmine and roman sepia]."
                            }
                        ]
                    }
                ],
