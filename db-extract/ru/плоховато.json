        "ru-extract.jsonl": [
            {
                "entry_id": "7569efae-da9a-3663-81d2-852a58218b7e",
                "word": "плоховато",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0f7d23e2-dc8d-3120-b33d-1d9a6f9e542e",
                        "entry_id": "7569efae-da9a-3663-81d2-852a58218b7e",
                        "glosses": [
                            "разг. наречие к плоховатый; довольно плохо"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "d00e96df-1594-41d4-b98d-f5adc085a452",
                                "sense_id": "0f7d23e2-dc8d-3120-b33d-1d9a6f9e542e",
                                "text": "Но и после этого многие плоховато знали урок, особенно слабые, а Разумников хотел, чтобы у него все без исключения учились хорошо."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ea1131e-f6a6-3189-a2e7-6aaefa09bb56",
                        "entry_id": "7569efae-da9a-3663-81d2-852a58218b7e",
                        "glosses": [
                            "разг., является довольно плохим, не очень хорошо"
                        ],
                        "tags": [
                            "в знач. сказуемого"
                        ],
                        "examples": [
                            {
                                "example_id": "fdb944be-b104-44dd-ad14-7994d46d81b3",
                                "sense_id": "4ea1131e-f6a6-3189-a2e7-6aaefa09bb56",
                                "text": "Тут сперва плоховато было, потому что кормят похуже, чем на фронте, а я покушать люблю и к фронтовому пайку слишком привык."
                            }
                        ]
                    }
                ],
