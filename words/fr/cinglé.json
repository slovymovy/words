                {
                    "sense_id": "110d7e55-b927-36e0-b6a0-88e73275c10c",
                    "sense_definition": "Qui est pris d'une violente colère, enragé.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "colere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand il a découvert la trahison de ses associés, il est devenu <w>cinglé</w> de rage.",
                            "target_lang_translations": {
                                "en": "When he discovered his partners had betrayed him, he flew into a <w>furious</w> rage.",
                                "ru": "Когда он узнал о предательстве своих компаньонов, он был <w>взбешён</w>.",
                                "de": "Als er den Verrat seiner Geschäftspartner entdeckte, war er <w>rasend</w> vor Wut.",
                                "es": "Cuando descubrió la traición de sus socios, se puso <w>furioso</w> de rabia.",
                                "zh": "他发现合伙人背叛了自己，顿时<w>狂怒</w>不已。"
                            }
                        },
                        {
                            "text": "Le client était <w>cinglé</w> et criait sur tous les employés du magasin.",
                            "target_lang_translations": {
                                "en": "The customer was <w>livid</w> and shouting at all the store's employees.",
                                "ru": "Клиент был <w>разъярён</w> и кричал на всех сотрудников магазина.",
                                "de": "Der Kunde war <w>wütend</w> und schrie alle Angestellten des Ladens an.",
                                "es": "El cliente estaba <w>furioso</w> y gritaba a todos los empleados de la tienda.",
                                "zh": "那位顾客<w>暴怒</w>不已，对着店里的所有员工大喊大叫。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Overcome by violent anger; enraged.",
                        "ru": "Испытывающий сильную ярость; разъярённый, взбешённый.",
                        "de": "Von heftigem Zorn erfasst; sehr wütend oder aufgebracht.",
                        "es": "Que está dominado por una ira violenta; muy enfadado o enfurecido.",
                        "zh": "形容怒火极盛，怒不可遏。"
                    },
