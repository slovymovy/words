                        "examples": [
                            {
                                "example_id": "fb46e7de-ffea-49ad-b795-ed8462436e30",
                                "sense_id": "169c808d-d930-3680-8c7d-fa6980d84e2c",
                                "text": "Many regions of the country have been deindustrialized in recent years.",
                                "translation": "Πολλές περιοχές της χώρας έχουν αποβιομηχανιστεί τα τελευταία χρόνια."
                            },
                            {
                                "example_id": "564e64d0-cf3c-4e00-9abf-814941007dca",
                                "sense_id": "169c808d-d930-3680-8c7d-fa6980d84e2c",
                                "text": "After the factories closed, the city became completely deindustrialized.",
                                "translation": "Μετά το κλείσιμο των εργοστασίων, η πόλη αποβιομηχανίστηκε πλήρως."
                            }
