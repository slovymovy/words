                "senses": [
                    {
                        "sense_id": "b4f827e8-509a-3031-a448-92d4c5e7df02",
                        "entry_id": "18b25580-5e26-38ed-bb7d-7455951e7ee6",
                        "glosses": [
                            "Dans l’hindouisme, adoration d’une image sacrée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3fa814c-3e32-41fe-8701-e22725f9ba8e",
                                "sense_id": "b4f827e8-509a-3031-a448-92d4c5e7df02",
                                "text": "Quand on arrive au pied d’un sommet himalayen, la première chose à faire est de célébrer une puja pour demander pardon au dieu de la montagne dont on foule les flancs en montant, et lui faire des offrandes – du riz, de la farine, des fruits et de la bière – pour invoquer sa bénédiction."
                            },
                            {
                                "example_id": "9883b2b2-0255-46d8-8f29-6e15e5c55ff5",
                                "sense_id": "b4f827e8-509a-3031-a448-92d4c5e7df02",
                                "text": "Elle demanderait aujourd’hui si elle pouvait rentrer chez elle pour la puja que sa mère avait prévu d’organiser pour la naissance du premier fils de son frère."
                            },
                            {
                                "example_id": "17b2fef7-8d13-4cdc-b33c-78d079a916be",
                                "sense_id": "b4f827e8-509a-3031-a448-92d4c5e7df02",
                                "text": "Pourquoi donc ? Ta grand-mère faisait bien sa prière régulièrement. Moi ça ne me plaisait pas. Par respect des convenances, je déposais deux ou trois fleurs. Si ça plaît à Bini de faire cette puja, je ne sais pas où tu vois de la comédie là-dedans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aecdda92-469a-405f-90a7-7cbe31208528",
                        "source_entry_id": "18b25580-5e26-38ed-bb7d-7455951e7ee6",
                        "source_sense_id": "b4f827e8-509a-3031-a448-92d4c5e7df02",
                        "target_lang_word": "puja",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puja",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80d0bc67-1fa4-3fec-88f9-f3be373b5897",
                                        "entry_id": "a7142f0f-a95c-3362-b222-219ad574771d",
                                        "glosses": [
                                            "A religious ritual performed in South Asia as an act of worship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a0cd81f-fb63-4799-8797-aafc49e63a8f",
                                                "sense_id": "80d0bc67-1fa4-3fec-88f9-f3be373b5897",
                                                "text": "The Grunth, the holy book of the Sikhs, seems to be becoming an object of idolatrous worship. They do puja to it, and carry it in procession daily."
                                            },
                                            {
                                                "example_id": "26b33c14-39b5-46f0-9c4f-ccd1f5a67f62",
                                                "sense_id": "80d0bc67-1fa4-3fec-88f9-f3be373b5897",
                                                "text": "‘Godbole's pujah did it,’ cried the Englishman."
                                            },
                                            {
                                                "example_id": "a0c9e85e-7bd5-43fb-8388-16d9db8bac6e",
                                                "sense_id": "80d0bc67-1fa4-3fec-88f9-f3be373b5897",
                                                "text": "The priest had performed the puja and tied a string around his father's silk purse to make sure that the Rana didn't spend even a copper coin while he was a guest of Merta."
                                            },
                                            {
                                                "example_id": "e080ff59-e59a-473d-a5e4-fe576def7fe4",
                                                "sense_id": "80d0bc67-1fa4-3fec-88f9-f3be373b5897",
                                                "text": "Deeming the tank ‘polluted’ and its water unfit for consumption, a puja ceremony was performed by Brahmin men to ‘purify’ the reservoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
