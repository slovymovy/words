                "senses": [
                    {
                        "sense_id": "ab986275-dfaa-3fa3-8570-3f4bea75fdf8",
                        "entry_id": "0c613fc4-a45b-36f0-8015-d7be0fc82a28",
                        "glosses": [
                            "dünnes Blatt, das auf einer Seite eine Farbschicht aufweist und dazu genutzt wird, um die Originalschrift auf ein darunterliegendes zweites Blatt zu kopieren (durchzuschreiben)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0f8d921-8d8e-43a5-b7b2-265b30d62c89",
                                "sense_id": "ab986275-dfaa-3fa3-8570-3f4bea75fdf8",
                                "text": "„Dann nahm er einen kleinen Rechnungsblock, legte das Kohlepapier zwischen die dicke Quittungsseite und die dünne Kopie und schrieb ad hoc eine Rechnung.“"
                            },
                            {
                                "example_id": "a0bd3953-9044-4e2c-a9d6-65ae9359a495",
                                "sense_id": "ab986275-dfaa-3fa3-8570-3f4bea75fdf8",
                                "text": "„Manche Themen dieser auf Kohlepapier vervielfältigten Blätter haben auch den Sprung in das Zeitalter des Cyberspace geschafft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
