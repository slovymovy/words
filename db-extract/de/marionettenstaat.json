                ],
                "senses": [
                    {
                        "sense_id": "9fff9578-fb3d-3049-bc5f-bec6481f8f2a",
                        "entry_id": "0df48bd6-e896-3a8d-9cd0-4cd43484b369",
                        "glosses": [
                            "Staat, dessen Regierung durch eine fremden Staat eingesetzt wurde und/oder geleitet und beeinflusst wird"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "1ab55550-2ac8-4d98-9a0b-be93d957026c",
                                "sense_id": "9fff9578-fb3d-3049-bc5f-bec6481f8f2a",
                                "text": "„Zwar gelang es am 12. September deutschen Fallschirmjägern, Hitlers Verbündeten zu befreien, und der «Führer» ernannte ihn dann zum Chef eines faschistischen Marionettenstaates in Norditalien (der «Italienischen Sozialen Republik»), aber der gebrochene und kranke Mussolini gewann weder die Anerkennung der Bevölkerung noch die Macht zurück.“"
                            },
                            {
                                "example_id": "780cc530-2487-44a3-a526-01be620c7f7a",
                                "sense_id": "9fff9578-fb3d-3049-bc5f-bec6481f8f2a",
                                "text": "„Das Ziel der Apartheid war im Grunde, aus Südafrika ein weißes Land zu machen, wo alle Schwarzen ihrer Staatsbürgerschaft beraubt waren und in den Homelands lebten, den Bantustans, semisouveränen schwarzen Territorien, die jedoch in Wirklichkeit Marionettenstaaten der Regierung in Pretoria waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
