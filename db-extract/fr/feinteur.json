                                            {
                                                "example_id": "793ac336-525e-473a-b47f-b6296ac30e56",
                                                "sense_id": "f3c4a971-57e5-3b38-aa1b-b022ac56db81",
                                                "text": "She's faker than the plastic food in the pictures on the McDonald's menu."
                                            },
                                            {
                                                "example_id": "10c5f1f0-de3d-41b2-842e-dd5ec2c40c8f",
                                                "sense_id": "f3c4a971-57e5-3b38-aa1b-b022ac56db81",
                                                "text": "He returns my smile, although his is probably faker than mine."
                                            },
                                            {
                                                "example_id": "373d88e9-2d5a-4819-9ccf-9094c83b0afe",
                                                "sense_id": "f3c4a971-57e5-3b38-aa1b-b022ac56db81",
                                                "text": "The name sounds faker than fake."
                                            }
