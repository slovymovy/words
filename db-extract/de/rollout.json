                "senses": [
                    {
                        "sense_id": "35759a03-0a5c-3b89-923b-3105cbbbc828",
                        "entry_id": "957403dd-3e74-35cc-9d96-89452b0dce9d",
                        "glosses": [
                            "Verteilen von Software auf mehrere bis sehr viele Rechner/Smartphones"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "559b8360-df0e-4049-aa7d-431b409a3096",
                                "sense_id": "35759a03-0a5c-3b89-923b-3105cbbbc828",
                                "text": "„FAI […] stellt eine Software für den massenhaften und automatisierten Rollout von Linux-Systemen dar.“"
                            },
                            {
                                "example_id": "44d06388-86be-45cc-a3f9-bb96ba362d4b",
                                "sense_id": "35759a03-0a5c-3b89-923b-3105cbbbc828",
                                "text": "„Die Mitarbeiter sind ausreichend auf die Einführung der CRM-Software vorbereitet und trainiert. Jetzt geht es an den Rollout der Software im Echtzeitbetrieb.“"
                            },
                            {
                                "example_id": "190044be-7cad-4b13-925d-6003248781c3",
                                "sense_id": "35759a03-0a5c-3b89-923b-3105cbbbc828",
                                "text": "„Nun hat der Rollout für alle Windows-Nutzer begonnen.“"
                            },
                            {
                                "example_id": "04e7a0d3-17c0-4bd8-95b0-d9c85b87357a",
                                "sense_id": "35759a03-0a5c-3b89-923b-3105cbbbc828",
                                "text": "„Der Rollout von Pokémon Go wird sich in Deutschland wohl noch eine Weile hinauszögern.“"
                            },
                            {
                                "example_id": "a3ff9a67-d6d6-4937-8631-d8064131271d",
                                "sense_id": "35759a03-0a5c-3b89-923b-3105cbbbc828",
                                "text": "„Das Rollout von Chrome 79 hat am 10. Dezember begonnen und wohl inzwischen etwa bereits die Hälfte aller Android-Nutzer erreicht.“"
                            },
                            {
                                "example_id": "45919d7c-f895-45ad-b7e2-37c307a3f4b8",
                                "sense_id": "35759a03-0a5c-3b89-923b-3105cbbbc828",
                                "text": "„Vor dem Rollout gab es eine mehrstufige Betaphase mit insgesamt über 10.000 Teilnehmern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ceae6b5e-8d0d-360b-9a6a-27ef09437e40",
                        "entry_id": "957403dd-3e74-35cc-9d96-89452b0dce9d",
                        "glosses": [
                            "umfangreicher Austausch von Hardware (beispielsweise von vielen Desktop-PCs, Laptops, Druckern in einem Unternehmen / einer Behörde / an Endkunden)"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "bfdca138-fc1d-4a1e-aa11-bbee81738bc7",
                                "sense_id": "ceae6b5e-8d0d-360b-9a6a-27ef09437e40",
                                "text": "„Dem Verband [Anmerkung: gemeint ist der IT-Branchenverband Bitkom] geht das sogenannte Rollout der Stromzähler aber nicht schnell genug.“"
                            },
                            {
                                "example_id": "5ae80c6b-a7c5-47fe-8da9-31f3491d4998",
                                "sense_id": "ceae6b5e-8d0d-360b-9a6a-27ef09437e40",
                                "text": "„Die Versteigerung [Anmerkung: von 5G-Mobilfunkfrequenzen durch die Bundesnetzagentur] soll einen schnellen, flexiblen und bedarfsgerechten 5G-Rollout in Deutschland ermöglichen.“"
                            },
                            {
                                "example_id": "a6df09ff-811d-45d9-8f37-75af0ed3f03b",
                                "sense_id": "ceae6b5e-8d0d-360b-9a6a-27ef09437e40",
                                "text": "„Die Bundesnetzagentur prüft inzwischen den Rollout der WLAN-Hotspots durch den Kabelnetzbetreiber.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "81b818b1-d765-3f13-a729-1d4a1b156554",
                        "entry_id": "957403dd-3e74-35cc-9d96-89452b0dce9d",
                        "glosses": [
                            "Vorstellung eines überarbeiteten oder neuen Produktes, beispielsweise in der Flugzeug-, Fahrzeug- oder Schiffbauindustrie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e49e2a38-6478-4f8d-a9d3-6c8b1bee89d0",
                                "sense_id": "81b818b1-d765-3f13-a729-1d4a1b156554",
                                "text": "„Die erste öffentliche Vorstellung eines Dreamliners, das sog. Rollout, fand am 8. Juli 2007 im Endmontagewerk in Everett, Washington, statt […].“"
                            },
                            {
                                "example_id": "eb9a87f2-fea8-4694-92e0-7b5c96ab4d8c",
                                "sense_id": "81b818b1-d765-3f13-a729-1d4a1b156554",
                                "text": "„Die Stanser Pilatuswerke wollen mit einem grossen Fest den Rollout des PC-24 feiern. Der Business-Jet wird am 1. August auf dem Flugplatz Buochs erstmals vorgeführt.“"
                            },
                            {
                                "example_id": "4b7ef405-31e7-4d07-99c7-58de91b91b61",
                                "sense_id": "81b818b1-d765-3f13-a729-1d4a1b156554",
                                "text": "„Mehrere Jahre hat es gedauert, bis «SKYe SH09» für das Rollout bereit war. «SKYe SH09» – das ist der Prototyp des ersten Helikopters made in Switzerland.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "daac1862-6a1a-3451-833e-3448670093ea",
                        "entry_id": "957403dd-3e74-35cc-9d96-89452b0dce9d",
                        "glosses": [
                            "erstmaliges Herausrollen eines Prototyps oder neuen Flugzeugs (beispielsweise aus einem Hangar)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "391d86b9-ab82-49cb-b311-01d0f6009ddf",
                                "sense_id": "daac1862-6a1a-3451-833e-3448670093ea",
                                "text": "„Am Dienstag fand das Rollout des neuen Sauber-Rennautos in Barcelona statt.“"
                            },
                            {
                                "example_id": "3ca3ebd5-a773-4ad5-a6c0-9bef9c262963",
                                "sense_id": "daac1862-6a1a-3451-833e-3448670093ea",
                                "text": "„Auf Fotos der beiden Raumfahrtagenturen im Internet war zu sehen, wie die massige Proton-Rakete aufgerichtet wurde. «Der Rollout ist abgeschlossen», teilte die Esa mit.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
