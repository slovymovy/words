            {
                "entry_id": "048ea7a4-269e-378b-ac0e-cbe879002cc5",
                "word": "Dahlia",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "927cf460-1389-3e6c-a0a5-085ebe38030d",
                        "entry_id": "048ea7a4-269e-378b-ac0e-cbe879002cc5",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d8d9745-0aa1-4350-aef1-49e349592ca7",
                                "sense_id": "927cf460-1389-3e6c-a0a5-085ebe38030d",
                                "text": "J’ai sollicité l’avis de Dahlia Namian sur les récents développements dans l’univers des milliardaires. Car cette professeure de travail social à l’Université d’Ottawa a publié il y a deux ans un petit essai lapidaire sur « l’obscénité des riches », intitulé La société de provocation."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "41a5ae88-fb14-3a7f-b51a-487b7ae75d8d",
                "word": "dahlia",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "04a836bb-cab1-44be-b837-e18c44699f25",
                        "entry_id": "41a5ae88-fb14-3a7f-b51a-487b7ae75d8d",
                        "tags": [
                            "plural"
                        ],
                        "form": "dahlias"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c5ac4e4-b867-3e77-8fae-b410a639d663",
                        "entry_id": "41a5ae88-fb14-3a7f-b51a-487b7ae75d8d",
                        "glosses": [
                            "Astéracée qui porte des fleurs simples ou doubles, dont les tiges naissent en touffe et dont les racines sont des tubercules."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "d273680c-a573-4541-b916-191cbb41f820",
                                "sense_id": "0c5ac4e4-b867-3e77-8fae-b410a639d663",
                                "text": "Ajoutez une bougerie qui ne sert guère, hélas ! un petit jardin où la ménagère plante autour des carrés de choux et d’oignons quelques pieds de dahlias, de glaudinettes et de reines-marguerites ; vous aurez le domaine d’un paysan lorrain."
                            },
                            {
                                "example_id": "62c66f34-e7b8-4261-99bb-a0f2990c2095",
                                "sense_id": "0c5ac4e4-b867-3e77-8fae-b410a639d663",
                                "text": "Jusqu’en 1872, c'est-à-dire jusqu'à l’introduction du Dahlia juarezii, on connut seulement les dahlias simples. Puis, ce fut la merveilleuse aventure des hybrideurs. Tous les coloris existent chez le dahlia, sauf le bleu."
                            },
                            {
                                "example_id": "e1d4d1e4-5ca5-4aa9-bb84-e53a4b9134e8",
                                "sense_id": "0c5ac4e4-b867-3e77-8fae-b410a639d663",
                                "text": "Connu par les Aztèques pour ses vertus médicinales, le dahlia fut décrit pour la première fois au XVIᵉ siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "f14d9f09-be31-31c9-aceb-d089789011e5",
                        "entry_id": "41a5ae88-fb14-3a7f-b51a-487b7ae75d8d",
                        "glosses": [
                            "Autre nom d’une gamme de colorant nommé violet de Hofmann ils se distinguent par un code alphabétique : dahlia B, dahlia BB, dahlia R, etc."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "410774bf-b0ff-47d7-95d3-bc9ebfde8826",
                        "source_entry_id": "41a5ae88-fb14-3a7f-b51a-487b7ae75d8d",
                        "target_lang_word": "Dahlie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dahlie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0de3fd39-eb71-36f5-985a-a14aa58d9594",
                                        "entry_id": "6358fc10-9b47-3f49-b8c2-385f3506c084",
                                        "glosses": [
                                            "Gartenpflanze (Dahlia) aus der Familie der Korbblütler (Asteraceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa868a88-ce9a-47b0-b7af-a3553f32e77f",
                                                "sense_id": "0de3fd39-eb71-36f5-985a-a14aa58d9594",
                                                "text": "Dahlien gibt es nahezu in allen Blütenfarben, außer in Blau."
                                            },
                                            {
                                                "example_id": "8f421b97-175c-4cca-92aa-46c2b112e02a",
                                                "sense_id": "0de3fd39-eb71-36f5-985a-a14aa58d9594",
                                                "text": "Die Dahlie ist eine beliebte Gartenpflanze."
                                            },
                                            {
                                                "example_id": "a0734bd2-c56f-4e68-b4ed-daa54cba4557",
                                                "sense_id": "0de3fd39-eb71-36f5-985a-a14aa58d9594",
                                                "text": "Nach den Rosen sind die Dahlien unsere Lieblinge."
                                            },
                                            {
                                                "example_id": "b3e43276-dcd0-474d-bebd-6d308f8de795",
                                                "sense_id": "0de3fd39-eb71-36f5-985a-a14aa58d9594",
                                                "text": "„[Die Saatgutmischung] \"Bienenparadies\" enthält unter anderem bienenfreundliche gelbe Dahlien und blaue Anemonen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
