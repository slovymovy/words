                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a492c0b-fc6b-44c6-8922-c3eca30082e4",
                        "source_entry_id": "a71adf05-fb84-3bd2-a3f4-04944bf24685",
                        "source_sense_id": "c047f694-3c6a-3b18-9196-1e78a320e8e0",
                        "source_sense_description": "Angehörige eines Volkes, das ein bestimmtes Gebiet als erstes bewohnt hat",
                        "target_lang_word": "native",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "native",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                        "entry_id": "1dbcf200-3284-3b72-86c7-2e6f36354fd8",
                                        "glosses": [
                                            "Belonging to one by birth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af9dea13-5f74-4a00-be12-5a424536380d",
                                                "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                                "text": "This is my native land."
                                            },
                                            {
                                                "example_id": "629f4250-cb2a-49ec-846b-8a0c36cb5c06",
                                                "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                                "text": "English is not my native language."
                                            },
                                            {
                                                "example_id": "32ceaa51-2ddc-4473-82a6-84b3837b5d35",
                                                "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                                "text": "I need a volunteer native New Yorker for my next joke…"
                                            },
                                            {
                                                "example_id": "d22e732a-6316-4460-95fc-bd8ee9febe70",
                                                "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                                "text": "In my natyf language I wyl not opres, / More of her werke, for it is obscure; / Who wyl therof knowe all the perfeytnes / In phylosophy he shall fynde it ryght sure, / Whyche all the trouth can to hym discure."
                                            },
                                            {
                                                "example_id": "67e8c706-79cf-4403-be59-04a1b781d73b",
                                                "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                                "text": "The Language I haue learn’d these forty yeares (My natiue English) now I must forgo."
                                            },
                                            {
                                                "example_id": "824787e4-8e86-4a09-a080-25da1e8f9bfd",
                                                "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                                "text": "Thy sentence…robs my tongue from breathing natiue breath."
                                            },
                                            {
                                                "example_id": "6fd2ba06-b483-4551-932a-177a5ce336f6",
                                                "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                                "text": "They have a native language of their owne, but the Persian tongue is understood by most."
                                            },
                                            {
                                                "example_id": "a6eb69fd-b1a8-4036-b634-def3cb80c942",
                                                "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                                "text": "Happy the man, whose wish and care / A few paternal acres bound, / Content to breathe his native air / In his own ground."
                                            },
                                            {
                                                "example_id": "a64e3ddb-cc1c-4c7f-9ebb-f55b33ea5ed0",
                                                "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                                "text": "Those of the western church were obliged to acquire some knowledge of Latin; and for Greek, to those of the eastern church it was still (with a few corruptions) their native language."
                                            },
                                            {
                                                "example_id": "2954e258-d9e2-4a1c-b71f-51cee182ef5a",
                                                "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                                "text": "[…] But to the Snake those accents sweet were known / His native tongue and hers; […]"
                                            },
                                            {
                                                "example_id": "2394c521-34a1-4f1e-864b-84abaa997b84",
                                                "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                                "text": "Their habits, as we can see them transacted, are native."
                                            },
                                            {
                                                "example_id": "8551e403-c619-4343-90a9-0e16c85cbca0",
                                                "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                                "text": "His name has been metamorphosed in Syria and Egypt into the more native-sounding Abulides."
                                            },
                                            {
                                                "example_id": "2356ccca-d8ce-4157-8b41-11fe6d0afa7d",
                                                "sense_id": "9ec2e37b-73a0-3317-a80c-11e84c3e2d23",
                                                "text": "They were dressed in their native costumes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffcd24b2-1bb5-3a21-afe7-7a1768a17dfd",
                                        "entry_id": "1dbcf200-3284-3b72-86c7-2e6f36354fd8",
                                        "glosses": [
                                            "Characteristic of or relating to people inhabiting a region from prehistoric times."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67e63a10-696a-4f59-b869-ddf14c1ba15f",
                                                "sense_id": "ffcd24b2-1bb5-3a21-afe7-7a1768a17dfd",
                                                "text": "What are now called ‘Native Americans’ used to be called Indians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "665195df-cc75-3d66-b5c0-8761081d4dce",
                                        "entry_id": "1dbcf200-3284-3b72-86c7-2e6f36354fd8",
                                        "glosses": [
                                            "Alternative letter-case form of Native (of or relating to the native inhabitants of the Americas, or of Australia)."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "420565f5-fcc0-374f-a39c-1293e5ddb21e",
                                        "entry_id": "1dbcf200-3284-3b72-86c7-2e6f36354fd8",
                                        "glosses": [
                                            "Born or grown in the region in which it lives or is found; not foreign or imported."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "303a3b8c-6ae7-4426-8759-97dcc74744e3",
                                                "sense_id": "420565f5-fcc0-374f-a39c-1293e5ddb21e",
                                                "text": "a native inhabitant"
                                            },
                                            {
                                                "example_id": "0ce9497f-4e97-4243-80d4-3a4fe7b1aca8",
                                                "sense_id": "420565f5-fcc0-374f-a39c-1293e5ddb21e",
                                                "text": "native oysters or strawberries"
                                            },
                                            {
                                                "example_id": "8517684f-6333-43cd-9190-36003fdb97ee",
                                                "sense_id": "420565f5-fcc0-374f-a39c-1293e5ddb21e",
                                                "text": "Many native artists studied abroad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7124ba74-e23c-3972-854f-f2d782aafe32",
                                        "entry_id": "1dbcf200-3284-3b72-86c7-2e6f36354fd8",
                                        "glosses": [
                                            "Which occurs of its own accord in a given locality, to be contrasted with a species introduced by humans."
                                        ],
                                        "tags": [
                                            "of a species"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf1a84b3-83cc-4e26-96c9-2586af250d4e",
                                                "sense_id": "7124ba74-e23c-3972-854f-f2d782aafe32",
                                                "text": "The naturalized Norway maple often outcompetes the native North American sugar maple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a4b858c-fbbc-3cc0-bf7e-9d5ccdc94219",
                                        "entry_id": "1dbcf200-3284-3b72-86c7-2e6f36354fd8",
                                        "glosses": [
                                            "Pertaining to the system or architecture in question."
                                        ],
                                        "tags": [
                                            "of software"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef35251-c030-417b-9c6a-0b73891a017b",
                                                "sense_id": "7a4b858c-fbbc-3cc0-bf7e-9d5ccdc94219",
                                                "text": "This is a native back-end to gather the latest news feeds."
                                            },
                                            {
                                                "example_id": "6a7b6e78-1538-41a6-a41c-c6404560a808",
                                                "sense_id": "7a4b858c-fbbc-3cc0-bf7e-9d5ccdc94219",
                                                "text": "The native integer size is sixteen bits."
                                            },
                                            {
                                                "example_id": "a4bec797-042d-4b7a-8f0e-a256f41fffff",
                                                "sense_id": "7a4b858c-fbbc-3cc0-bf7e-9d5ccdc94219",
                                                "text": "cloud native, crypto native"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4de0a09-95f1-300a-8644-4ff1bd0fb280",
                                        "entry_id": "1dbcf200-3284-3b72-86c7-2e6f36354fd8",
                                        "glosses": [
                                            "Occurring naturally in its pure or uncombined form."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "393f4b0c-5614-4d64-bbfd-5fbae2e2d907",
                                                "sense_id": "b4de0a09-95f1-300a-8644-4ff1bd0fb280",
                                                "text": "native aluminium"
                                            },
                                            {
                                                "example_id": "fcaaf7b1-06c8-4ffb-841e-bdc296d024b2",
                                                "sense_id": "b4de0a09-95f1-300a-8644-4ff1bd0fb280",
                                                "text": "native salt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d12c4660-43b4-38ba-b6ad-afedaa705cd2",
                                        "entry_id": "1dbcf200-3284-3b72-86c7-2e6f36354fd8",
                                        "glosses": [
                                            "Arising by birth; having an origin; born."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6dbd8aa8-dfa1-3c09-be99-3c0bcd12d069",
                                        "entry_id": "1dbcf200-3284-3b72-86c7-2e6f36354fd8",
                                        "glosses": [
                                            "Original; constituting the original substance of anything."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b7a7a4-d05f-440c-8ed8-1a69ef556e0b",
                                                "sense_id": "6dbd8aa8-dfa1-3c09-be99-3c0bcd12d069",
                                                "text": "native dust"
                                            },
                                            {
                                                "example_id": "7fbbabb9-e306-4004-90c5-32c12b5d01f4",
                                                "sense_id": "6dbd8aa8-dfa1-3c09-be99-3c0bcd12d069",
                                                "text": "Must I thus leave thee Paradise? thus leave Thee Native Soile, these happie Walks and Shades,\n Fit haunt of Gods?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56bd4ce3-56ab-3e70-9865-e32178a6ae62",
                                        "entry_id": "1dbcf200-3284-3b72-86c7-2e6f36354fd8",
                                        "glosses": [
                                            "Naturally related; cognate; connected (with)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ed75983-fda7-4665-8e59-745d1a35004b",
                                                "sense_id": "56bd4ce3-56ab-3e70-9865-e32178a6ae62",
                                                "text": "The head is not more native to the heart, […]\n Than is the throne of Denmark to thy father."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "native",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d5af48b-b749-3bed-b205-a67143cc4d5d",
                                        "entry_id": "78bca70a-8850-37a2-a570-7c15263a73fd",
                                        "glosses": [
                                            "A person who is native to a place; a person who was born in a place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "535b273f-db3d-391d-aad9-40bd31b3bd0f",
                                        "entry_id": "78bca70a-8850-37a2-a570-7c15263a73fd",
                                        "glosses": [
                                            "A person of aboriginal descent, as distinguished from a person who was or whose ancestors were foreigners or settlers/colonizers. Alternative letter-case form of Native (aboriginal inhabitant of the Americas or Australia)."
                                        ],
                                        "tags": [
                                            "in particular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86cb556b-4e18-4e51-a149-2e459c3e93f9",
                                                "sense_id": "535b273f-db3d-391d-aad9-40bd31b3bd0f",
                                                "text": "Mail trains are limited to first and second class passengers, but on the mixed trains third class is also provided, and this is patronised exclusively by natives."
                                            },
                                            {
                                                "example_id": "f0b4a76a-b5cc-485b-8927-d9090dd3ff56",
                                                "sense_id": "535b273f-db3d-391d-aad9-40bd31b3bd0f",
                                                "text": "Dr John Reid, a historian called to testify for Mr Marshall, distinguished between the fur trade at the truckhouses and a smaller scale trade between natives and settlers: \"It seems that there were native persons who were selling small amounts […]\""
                                            },
                                            {
                                                "example_id": "a8bc3c00-d0d9-413f-833c-c3a6147740ca",
                                                "sense_id": "535b273f-db3d-391d-aad9-40bd31b3bd0f",
                                                "text": "As for the wars between natives and settlers, far from having “ceased,” they would continue well into the twentieth century, and over much the same things that had always sparked them—trade, land, and settler arrogance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e560f60e-9248-39a5-b909-2ee09e637cd1",
                                        "entry_id": "78bca70a-8850-37a2-a570-7c15263a73fd",
                                        "glosses": [
                                            "A native speaker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58dd1881-d40b-3ec2-ae0c-238925545df8",
                                        "entry_id": "78bca70a-8850-37a2-a570-7c15263a73fd",
                                        "glosses": [
                                            "An oyster of species Ostrea edulis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1e29e0f-2b14-4d5c-82cb-29143eef5f11",
                        "source_entry_id": "a71adf05-fb84-3bd2-a3f4-04944bf24685",
                        "source_sense_id": "c047f694-3c6a-3b18-9196-1e78a320e8e0",
                        "source_sense_description": "Angehörige eines Volkes, das ein bestimmtes Gebiet als erstes bewohnt hat",
                        "target_lang_word": "indigenous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indigenous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47dfd9ab-67ff-368c-8f0e-cf27c5deeaae",
                                        "entry_id": "81c515cb-8754-3729-a8cd-e7e5e3a72e0a",
                                        "glosses": [
                                            "Born or originating in, native to a land or region, especially before an intrusion."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4e18115-f6fd-4c84-b55f-a3172a723b94",
                                                "sense_id": "47dfd9ab-67ff-368c-8f0e-cf27c5deeaae",
                                                "text": "The Aboriginals were indigenous to Victoria before the World War."
                                            },
                                            {
                                                "example_id": "693a725c-fe27-4778-a80b-49d96df20dd2",
                                                "sense_id": "47dfd9ab-67ff-368c-8f0e-cf27c5deeaae",
                                                "text": "Not only the Indian, but many indigenous insects, birds, and quadrupeds, welcomed the apple-tree to these shores."
                                            },
                                            {
                                                "example_id": "c76c2a34-7b18-4002-897e-08f3c143c305",
                                                "sense_id": "47dfd9ab-67ff-368c-8f0e-cf27c5deeaae",
                                                "text": "Horses, like camels, had once been indigenous to Latin America but had become extinct."
                                            },
                                            {
                                                "example_id": "5dbd66e9-cfc4-44c6-b860-6bf26275fdf0",
                                                "sense_id": "47dfd9ab-67ff-368c-8f0e-cf27c5deeaae",
                                                "text": "Berlin is unique in being home to numerous East German converts to Islam who belong to the same German-speaking Muslim communities as West German converts. […] I attempt in this book to give a good sense of the diversity of contemporary indigenous Sunni Muslims in Germany, while pointing to commonalities and differences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5fc8acd-cfa8-3950-a0be-e66acc33c58e",
                                        "entry_id": "81c515cb-8754-3729-a8cd-e7e5e3a72e0a",
                                        "glosses": [
                                            "Born or originating in, native to a land or region, especially before an intrusion.",
                                            "In particular, of or relating to a people (or their language or culture) that inhabited a region prior to the arrival of people of other cultures which became dominant (e.g., through colonialism), and which maintains a distinct culture."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "031bb142-8e3c-461c-b6eb-f04519cdfe8e",
                                                "sense_id": "e5fc8acd-cfa8-3950-a0be-e66acc33c58e",
                                                "text": "The Ainu are the indigenous ethnic group of Japan's Hokkaido Island."
                                            },
                                            {
                                                "example_id": "1a6839a3-0c8e-4445-8d63-566633ce9cd4",
                                                "sense_id": "e5fc8acd-cfa8-3950-a0be-e66acc33c58e",
                                                "text": "About 98 per cent of Taiwan's inhabitants are Han Chinese, a diverse mix of ethnic and linguistic groups, including Hakka, Cantonese and Fujianese, who came from China's southern coast. Taiwan's other two per cent are from one of the nine indigenous tribes, which are scattered throughout the island but largely concentrated along the east coast and in the Central Mountain Range."
                                            },
                                            {
                                                "example_id": "7ab07152-e158-48e2-95f0-5fb356ef4dbf",
                                                "sense_id": "e5fc8acd-cfa8-3950-a0be-e66acc33c58e",
                                                "text": "The team auctioned off the right to name the new species to publicize the find and raise awareness and funds for the indigenous Lahu people of northern Thailand, a group that Sippawat is part of."
                                            },
                                            {
                                                "example_id": "55bd64df-b74e-4474-a129-31c3c77c0577",
                                                "sense_id": "e5fc8acd-cfa8-3950-a0be-e66acc33c58e",
                                                "text": "Muksin specifically mentioned 11 extinct indigenous languages, such as Tandia and Mawes in West Papua and Papua, along with Kajeli, Piru, Moksela, Palumata, Ternateno, Hukumina, Hoti, Serua, and Nila in different areas of Maluku."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63d6480d-8464-3d2b-af6c-b450dc7fc597",
                                        "entry_id": "81c515cb-8754-3729-a8cd-e7e5e3a72e0a",
                                        "glosses": [
                                            "Innate, inborn."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0093f1a2-4f6f-49d3-a930-d801a25229bc",
                                                "sense_id": "63d6480d-8464-3d2b-af6c-b450dc7fc597",
                                                "text": "She was a native and essential cook, as much as Aunt Chloe,—cooking being an indigenous talent of the African race."
                                            },
                                            {
                                                "example_id": "2bc00e9c-d9ed-49d3-bff4-56ff8784a409",
                                                "sense_id": "63d6480d-8464-3d2b-af6c-b450dc7fc597",
                                                "text": "He had all the tricks of a newspaper boy indigenous in him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
