                "word": "mitosis",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "229d6124-f642-4433-b72e-8290d1f924ed",
                        "entry_id": "f8b4d33c-cf56-39a0-bcc3-33ae2c8843c7",
                        "tags": [
                            "plural"
                        ],
                        "form": "mitoses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fca3c2c7-3cb1-36a3-b419-605543caf2be",
                        "entry_id": "f8b4d33c-cf56-39a0-bcc3-33ae2c8843c7",
                        "glosses": [
                            "The division of a cell nucleus in which the genome is copied and separated into two identical halves. It is normally followed by cell division."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b4fc6d9e-dde9-42c7-b132-ffe3b96007e1",
                                "sense_id": "fca3c2c7-3cb1-36a3-b419-605543caf2be",
                                "text": "Meronyms: prophase, metaphase, anaphase, telophase"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df5583eb-344f-4d95-9a6d-047855c6a440",
                        "source_entry_id": "f8b4d33c-cf56-39a0-bcc3-33ae2c8843c7",
                        "source_sense_id": "fca3c2c7-3cb1-36a3-b419-605543caf2be",
                        "source_sense_description": "division of a cell nucleus",
                        "target_lang_word": "mitóza",
