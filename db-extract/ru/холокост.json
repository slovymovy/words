                "senses": [
                    {
                        "sense_id": "4f136faf-9b44-338c-8784-999762330b05",
                        "entry_id": "e0ab6e1d-eee9-39c7-8c2b-aab81b46dfa0",
                        "glosses": [
                            "истор. геноцид европейских евреев во Второй мировой войне"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a9f281b-c942-4d5b-bd38-36c45e27daac",
                                "sense_id": "4f136faf-9b44-338c-8784-999762330b05",
                                "text": "А вышло ― Вторая мировая война, холокост, 40 миллионов смертей только в СССР и распад самой Германии."
                            }
                        ]
                    },
                    {
                        "sense_id": "0802be61-c2a2-3bc4-b4be-4321472ee562",
                        "entry_id": "e0ab6e1d-eee9-39c7-8c2b-aab81b46dfa0",
                        "glosses": [
                            "истор. преследование и массовое уничтожение нацистами представителей различных этнических и социальных групп (советских военнопленных, поляков, евреев, цыган, гомосексуальных мужчин, масонов, безнадёжно больных и инвалидов и др.) в период существования нацистской Германии"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1213752d-c40e-4817-b571-88fa7ebb1ac4",
                        "source_entry_id": "e0ab6e1d-eee9-39c7-8c2b-aab81b46dfa0",
                        "target_lang_word": "Holocaust",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holocaust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b06c63a3-6cfd-35d4-82ef-b9f9f1464b71",
                                        "entry_id": "132f7e46-6ace-3ac5-b32c-9f14dd868252",
                                        "glosses": [
                                            "The systematic mass murder (genocide) of six million Jews perpetrated by Nazi Germany shortly before and during World War II."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24366e15-9789-4053-a8ec-02ad5a5e6b7e",
                                                "sense_id": "b06c63a3-6cfd-35d4-82ef-b9f9f1464b71",
                                                "text": "Among Soloway’s congregants injured in the attack was Barbara Steinmetz, an 88-year-old Holocaust survivor who has become one of the most poignant symbols of the attack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6bbd4cc-876c-3037-95f4-43ad9964bd94",
                                        "entry_id": "132f7e46-6ace-3ac5-b32c-9f14dd868252",
                                        "glosses": [
                                            "The systematic mass murder (democide) of somewhere between eleven and fourteen million people, namely six million Jews and from five to eight million others (including Romanis, Slavs, homosexuals, and people with physical and mental disabilities), perpetrated by Nazi Germany shortly before and during World War II."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b396fa7-a741-44a2-a9ed-82758cdd177b",
                                                "sense_id": "c6bbd4cc-876c-3037-95f4-43ad9964bd94",
                                                "text": "For quotations using this term, see Citations:Holocaust."
                                            }
                                        ]
                                    }
                                ]
