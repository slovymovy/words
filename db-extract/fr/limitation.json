                                    {
                                        "sense_id": "99a8e086-0378-3edb-b69c-2850634348b9",
                                        "entry_id": "1fac6e9f-f438-3355-8c99-8110dcaaebaa",
                                        "glosses": [
                                            "The act of limiting or the state of being limited."
                                        ],
