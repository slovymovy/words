                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро отбросить ноги назад, чтобы избежать захвата в единоборствах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отбрасывать ноги",
                                "target_lang_sense_clarification": "защита от прохода в ноги"
                            },
                            {
                                "target_lang_word": "делать спрол",
                                "target_lang_sense_clarification": "технический термин в борьбе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85096682-4332-3908-bb51-87dc546a1913",
                    "sense_definition": "The disorganized and unattractive expansion of an urban area into the surrounding countryside.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expansion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local government is trying to limit urban <w>sprawl</w> to protect the environment.",
                            "target_lang_translations": {
                                "ru": "Местные власти пытаются ограничить <w>разрастание</w> городов, чтобы защитить окружающую среду."
                            }
                        },
                        {
                            "text": "Many residents are concerned about the rapid <w>sprawl</w> of new housing developments.",
                            "target_lang_translations": {
                                "ru": "Многие жители обеспокоены быстрым <w>расширением</w> новых жилых районов."
                            }
