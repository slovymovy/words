                "forms": [],
                "senses": [
                    {
                        "sense_id": "8096f7ad-aa9a-36d4-bb49-d57eb4aebe5f",
                        "entry_id": "89bd0241-8dc1-3027-aa84-2247b59413f2",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9712f1ef-6b64-4a05-86d2-8be3c06da182",
                                "sense_id": "8096f7ad-aa9a-36d4-bb49-d57eb4aebe5f",
                                "text": "1895 : les rayons X sont découverts par Wilhem Röntgen en Allemagne, alors que Becquerel découvre la radioactivité en France."
