                                    {
                                        "sense_id": "7c47506e-f3d1-3db9-a3de-c039c25892e9",
                                        "entry_id": "fa8d7d71-034f-34a6-92d2-22cd160c14c0",
                                        "glosses": [
                                            "ein Haarersatz aus Natur- oder Kunsthaaren, um kahle Körperstellen (meist am Kopf) zu bedecken"
                                        ],
                                        "tags": [
                                            "Kosmetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f04b6f27-9c79-4e30-8d01-6438c4550d46",
                                                "sense_id": "7c47506e-f3d1-3db9-a3de-c039c25892e9",
                                                "text": "Dem ranghohen Politiker ist nicht anzusehen, dass er ein Toupet trägt und sein Resthaar dunkel färbt."
                                            },
                                            {
                                                "example_id": "d1900401-19de-41e2-b497-44302600ea33",
                                                "sense_id": "7c47506e-f3d1-3db9-a3de-c039c25892e9",
                                                "text": "„Ein Toupet kommt für mich nicht infrage."
                                            },
                                            {
                                                "example_id": "96474a40-c874-4be8-8b8f-9d40c22cf10b",
                                                "sense_id": "7c47506e-f3d1-3db9-a3de-c039c25892e9",
                                                "text": "„Seit dem Tag, an dem er mich mit einer gewissen Erregung und sehr feuchten Augen gefragt hatte, ob es mich störte, wenn er ein Toupet trüge, ging mir dieser Anblick auf die Nerven.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
