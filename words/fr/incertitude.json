                    "frequency": "Middle",
                    "semantic_group_id": "imprevisibilite_situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La crise économique a créé une longue période d'<w>incertitude</w> pour les petites entreprises."
                        },
                        {
                            "text": "Les prévisions météorologiques comportent toujours une grande part d'<w>incertitude</w>."
                        }
                    ],
                    "synonyms": [
                        "imprévisibilité"
                    ],
                    "antonyms": [
                        "certitude"
                    ],
                    "common_phrases": [
