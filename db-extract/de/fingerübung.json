                ],
                "senses": [
                    {
                        "sense_id": "a0977bab-0fce-37ef-9e52-80c5afcd2055",
                        "entry_id": "bdfbea6a-cdb9-364a-a4b5-3772ad189137",
                        "glosses": [
                            "Praxis zum Training der Fingerfertigkeit beim Spielen eines Musikinstruments"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "abafc1eb-951e-487b-a4c0-e91d5d09790e",
                                "sense_id": "a0977bab-0fce-37ef-9e52-80c5afcd2055",
                                "text": "„‚Das ist wie die regelmäßige Fingerübung beim Klavierspiel, ohne die man nicht weiterkommt‘, sagt Herget.“"
                            },
                            {
                                "example_id": "668086e1-5542-4ef1-8130-99ae567245ad",
                                "sense_id": "a0977bab-0fce-37ef-9e52-80c5afcd2055",
                                "text": "„Lange Stunden vergingen über den Fingerübungen, und im Laufe der Zeit wurde allen klar, dass der Junge kein Virtuose werden würde.“"
                            },
                            {
                                "example_id": "820c0bb6-c85e-421d-becf-1b2a4344326f",
                                "sense_id": "a0977bab-0fce-37ef-9e52-80c5afcd2055",
                                "text": "„Der Klavierspieler hackte seine Fingerübungen im Tangotempo.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "09130941-15ec-312f-abc8-d334fb038050",
                        "entry_id": "bdfbea6a-cdb9-364a-a4b5-3772ad189137",
                        "glosses": [
                            "spezielles Musikstück für [a]"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "00ce1e5b-34a0-4a9c-95b5-3fe7bc833976",
                                "sense_id": "09130941-15ec-312f-abc8-d334fb038050",
                                "text": "„Eine zweite und dritte Sammlung der Cembalosuiten, von geschäftstüchtigen Verlegern zusammengestellt, umfasste zwar meist originale Werke; aber sie wurden einfallslos aneinandergereiht und bezogen mindere Stücke – Fingerübungen für Schüler und ambitiöse Dilettanten – ungeniert mit ein.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "03807244-f4da-3d77-9243-119f62cce752",
                        "entry_id": "bdfbea6a-cdb9-364a-a4b5-3772ad189137",
                        "glosses": [
                            "simples, beiläufig erstelltes Werk"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "c9b96f4d-aebb-4671-9724-26a4bee34f42",
                                "sense_id": "03807244-f4da-3d77-9243-119f62cce752",
                                "text": "„Aber das Meldegesetz ist im Vergleich zu den kommenden Zielen nur eine Fingerübung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
