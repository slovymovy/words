                        "glosses": [
                            "…zachęcający do walki, wyrażający zachwyt, uznanie itp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b6398c4-33bc-4317-b09b-2fd26b083248",
                                "sense_id": "c1e420c6-b776-32e8-bbdf-4f4b36bd022e",
                                "text": "Jak na stadionie gwizdkami gwizdać zaczęli, a potem znowu łołłoł i ole ole ole śpiewać"
                            },
                            {
                                "example_id": "8814baaa-838d-41e0-8d6d-6a4755ac7529",
                                "sense_id": "c1e420c6-b776-32e8-bbdf-4f4b36bd022e",
                                "text": "Kiedy w posadach trzeszczy cały gmach, ¶ ty się napraszasz z głupkowatym ole!"
                            },
                            {
                                "example_id": "64bcd77e-f08c-481f-9a22-7366a1e4ed80",
                                "sense_id": "c1e420c6-b776-32e8-bbdf-4f4b36bd022e",
                                "text": "Z miłością jest jak z tańcem: każda para ma swój własny układ choreograficzny — jedni wirują patrząc sobie w oczy, inni chaotycznie ganiają się w tę i z powrotem, co jakiś czas histerycznie wykrzykując: „Ole!”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
