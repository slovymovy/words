                "translations": [
                    {
                        "translation_id": "8e13b6d1-b24d-467b-8d40-967952fba68c",
                        "source_entry_id": "eb18922a-69a9-3d8a-9ee4-26809fd46f4f",
                        "source_sense_description": "избавляясь от чьего-либо общества, заставить удалиться",
                        "target_lang_word": "drive away",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drive away",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "553b432d-a3d8-3f70-a318-e42c59ee1647",
                                        "entry_id": "5d7db88c-8ee4-3f24-baea-efc0e44d43f3",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see drive, away."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4e77c14-9a21-429e-93a4-7ae0eddcaf3e",
                                                "sense_id": "553b432d-a3d8-3f70-a318-e42c59ee1647",
                                                "text": "This car's a real bargain, and you could drive it away this afternoon!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d43217c-e75f-37df-bd9c-6fba498a5f6b",
                                        "entry_id": "5d7db88c-8ee4-3f24-baea-efc0e44d43f3",
                                        "glosses": [
                                            "To force someone or something to leave"
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "638518ea-12ad-4d7f-945d-682ff6c3b477",
                                                "sense_id": "5d43217c-e75f-37df-bd9c-6fba498a5f6b",
                                                "text": "I managed to drive the vultures away by shouting and waving my arms about."
                                            },
                                            {
                                                "example_id": "883bb4d3-24d8-4949-8592-abafb8d207a8",
                                                "sense_id": "5d43217c-e75f-37df-bd9c-6fba498a5f6b",
                                                "text": "Unsanitary conditions are driving away business."
                                            },
                                            {
                                                "example_id": "f7b7b836-ad0e-4880-ba5c-749b8b94785b",
                                                "sense_id": "5d43217c-e75f-37df-bd9c-6fba498a5f6b",
                                                "text": "Sébastien Bassong is being driven away by the \"madness\" at Newcastle United, a source close to the Frenchman has told the local Evening Chronicle newspaper."
                                            },
                                            {
                                                "example_id": "477fe27b-bf62-4a86-80ca-84835478019a",
                                                "sense_id": "5d43217c-e75f-37df-bd9c-6fba498a5f6b",
                                                "text": "We would like to believe in the enchanting influence of Gandhigiri as the single absolute force that drove away the whites who probably went muttering, 'bloody Indians', an expression that was enthusiastically attributed to Englishmen by innumerable Hindi films."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "335e2fa9-9e59-41e5-bd9e-2a0f520502aa",
                        "source_entry_id": "eb18922a-69a9-3d8a-9ee4-26809fd46f4f",
                        "source_sense_description": "заставить исчезнуть, пройти, миновать",
                        "target_lang_word": "dispel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
