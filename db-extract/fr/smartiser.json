                "senses": [
                    {
                        "sense_id": "97b1e7bd-da8f-3d03-bc36-6c66a2c96fec",
                        "entry_id": "f17e3e9c-1e22-31c6-9229-9be81beb4871",
                        "glosses": [
                            "Donner un caractère smart à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95ab473d-5540-4f9b-a51f-d31408a0aab6",
                                "sense_id": "97b1e7bd-da8f-3d03-bc36-6c66a2c96fec",
                                "text": "Car pour concevoir un « Smart building » de qualité, il ne suffit pas de le « smartiser », autrement dit de conserver sa fonction première en le complétant par une fonction de connectivité et une fonction de services connectés."
                            },
                            {
                                "example_id": "9c29575d-87a9-4469-a8c7-1966855d7d95",
                                "sense_id": "97b1e7bd-da8f-3d03-bc36-6c66a2c96fec",
                                "text": "Désormais, on a l'impression que tout veut être « smartisé »."
                            },
                            {
                                "example_id": "2e12e038-628b-426b-bd45-b9350ee26078",
                                "sense_id": "97b1e7bd-da8f-3d03-bc36-6c66a2c96fec",
                                "text": "Chez @Enedis on a besoin des #startups pour “smartiser“ nos réseaux."
                            }
                        ]
