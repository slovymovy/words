    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c9a971fc-6299-3707-84d6-fa2ec078159c",
                "word": "knifed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dfb7fde9-cae8-3c53-a31d-4467e0d8a458",
                        "entry_id": "c9a971fc-6299-3707-84d6-fa2ec078159c",
                        "glosses": [
                            "Having been cut or stabbed with a knife."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "89d83207-5f79-4f17-bbb0-c7cb98f375c5",
                                "sense_id": "dfb7fde9-cae8-3c53-a31d-4467e0d8a458",
                                "text": "These reports show no difference, or, at all events, no significant difference, between the lambs that were seared and those which were knifed, at any of the weighings. Any difference is in favour of the knifed lambs, but it would be a mistake to attach much importance to this result particularly since it was obtained in one season only."
                            },
                            {
                                "example_id": "d44d6077-bc76-4bdd-af82-c8ff9facb060",
                                "sense_id": "dfb7fde9-cae8-3c53-a31d-4467e0d8a458",
                                "text": "The police were on the pavement outside; the knifed man lay holding his side with blood through his fingers spreading up his cheap shirt like litmus paper turning red."
                            },
                            {
                                "example_id": "6066fa84-ef95-44ca-a811-f4ff21101717",
                                "sense_id": "dfb7fde9-cae8-3c53-a31d-4467e0d8a458",
                                "text": "“Is it drugs?” I prompted when he frowned but remained silent. “We'll let the experts decide that, shall we?” he said calmly. As if it were an everyday occurrence to find a baggie of pills in a ransacked storeroom with a knifed owner next door."
                            }
                        ]
                    },
                    {
                        "sense_id": "befa6260-eb8c-3bf2-96fd-cc06a8fd28d3",
                        "entry_id": "c9a971fc-6299-3707-84d6-fa2ec078159c",
                        "glosses": [
                            "Wearing or carrying (a specified type of) knife (utensil or tool)."
                        ],
                        "tags": [
                            "in-compounds",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3c1d9338-f1d7-415c-80a7-4f39529825af",
                                "sense_id": "befa6260-eb8c-3bf2-96fd-cc06a8fd28d3",
                                "text": "Ha! more times than a few had Monsieur John knocked down some long-haired and long-knifed rowdy, and kicked the breath out of him for looking saucily at her; but that was like him, he was so brave and kind;—and he is gone!"
                            },
                            {
                                "example_id": "23dfe401-2d1b-43a9-adf7-0b7dddba6c6b",
                                "sense_id": "befa6260-eb8c-3bf2-96fd-cc06a8fd28d3",
                                "text": "Soon, like the backhand stroke / Of a knifed assassin skulking in the brush, / New agonies awoke, / And smote as though all nature in a rush / Of anger had combined to castigate / Man’s follies with a self-inflicted fate."
                            },
                            {
                                "example_id": "922bb10b-65f7-4457-bcf8-18056f97f600",
                                "sense_id": "befa6260-eb8c-3bf2-96fd-cc06a8fd28d3",
                                "text": "It is despicable what the sharp-knifed general and his army have done to the honorable Commander Francisco Caso y Luengo, one of our most revered Spanish military figures."
                            }
                        ]
                    },
                    {
                        "sense_id": "6bc178eb-b9e1-3e7f-a3d7-dcbf713c4312",
                        "entry_id": "c9a971fc-6299-3707-84d6-fa2ec078159c",
                        "glosses": [
                            "Having a knife (blade-like part) of the specified type."
                        ],
                        "tags": [
                            "in-compounds",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4b22376d-1239-4375-ac39-cea42f2223c2",
                                "sense_id": "6bc178eb-b9e1-3e7f-a3d7-dcbf713c4312",
                                "text": "A short-knifed wheat header, such as is used in harvesting wheat and barley in California, if especially strongly built, has been suggested as a practicable contrivance."
                            },
                            {
                                "example_id": "d2362332-10a7-4aa6-8a6e-8420faae3d5f",
                                "sense_id": "6bc178eb-b9e1-3e7f-a3d7-dcbf713c4312",
                                "text": "Most of the Raven’s crew would be fighting with their long-knifed cutlasses, the sailors’ weapon of choice."
                            },
                            {
                                "example_id": "a4d4d6cc-b378-4d07-88b4-1e70472af656",
                                "sense_id": "6bc178eb-b9e1-3e7f-a3d7-dcbf713c4312",
                                "text": "Back in the Civil War, soldiers would have used single shot muzzle-loading long rifles with long-knifed bayonets attached to the barrels."
                            }
                        ]
                    }
                ],
