                "senses": [
                    {
                        "sense_id": "0710cee3-5932-3aea-b592-81eba9e003e8",
                        "entry_id": "2fffa3fe-25f2-3d6d-bf2a-62694d4aa8da",
                        "glosses": [
                            "истор. религиозно-политическое направление в католицизме, сторонники которого отстаивают идею неограниченной верховной власти римского папы и его право вмешиваться в светские дела любого государства"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84db4d98-1861-43e1-a020-f94992a61eb5",
