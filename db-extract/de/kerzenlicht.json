                        "form": "das Kerzenlicht"
                    },
                    {
                        "form_id": "d512d1bb-2660-41ab-b905-7ecb64c45554",
                        "entry_id": "a2a8dd93-b4b1-34c0-9a44-47e916d93189",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kerzenlichter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                        "entry_id": "a2a8dd93-b4b1-34c0-9a44-47e916d93189",
                        "glosses": [
                            "von einer Kerze emittiertes Licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9426c697-2e37-43e3-a368-ba9905db288c",
                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                "text": "Ich biete Dir ein romantisches Abendessen im Kerzenlicht an."
                            },
                            {
                                "example_id": "a0fb4a38-cdc2-4fcd-9dd2-e3bb6602f76e",
                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                "text": "„Als die Gäste kamen, erklärte Helena, sie würden einen ganz besonderen Abend bei Kerzenlicht verbringen, ohne warmes Essen, nur mit Süßigkeiten.“"
                            },
                            {
                                "example_id": "0c203548-2e96-439f-8f37-3237e8b552f6",
                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                "text": "„Wir saßen nun in einem kleinen Kreis um ihn herum, Kerzenlicht machte uns alle gleich jung und schön.“"
                            },
                            {
                                "example_id": "7b6dfc7a-d401-4800-9b84-3b84a33043ed",
                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                "text": "„Die Farbe der Wände mochte er nicht, deshalb hatte er beschlossen, daß sie bei Kerzenlicht aßen.“"
                            },
                            {
                                "example_id": "ff50f5c1-7183-445d-92f2-e873f3adf0ae",
                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                "text": "„Er drückte ihr noch einmal die Hand und liess sie dann los, und nun kehrte Natascha an ihren Platz im Kerzenlicht zurück und nahm wieder die Haltung von vorhin ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0c5d7f0-8444-4a9e-9f64-f7d988d8cb81",
                        "source_entry_id": "a2a8dd93-b4b1-34c0-9a44-47e916d93189",
                        "source_sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                        "source_sense_description": "von einer Kerze emittiertes Licht",
                        "target_lang_word": "candlelight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "candlelight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92a9c00b-51a4-3485-9391-55935fa15174",
                                        "entry_id": "76140ec3-4a93-3ce9-a825-7e4186e5d609",
                                        "glosses": [
                                            "The light emitted by a candle."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "053f2ca6-2d0a-4405-9dd1-4ba95688b847",
                                                "sense_id": "92a9c00b-51a4-3485-9391-55935fa15174",
                                                "text": "I looked across the table into her shining eyes, which were golden in the candlelight, with my fingers round the stem of my own glass, ready for the toast."
                                            },
                                            {
                                                "example_id": "a94de985-eff4-4ec7-a720-d5ac40c8bf0c",
                                                "sense_id": "92a9c00b-51a4-3485-9391-55935fa15174",
                                                "text": "Cradled in the arms of Night, the gleam of moon and candlelight bring images alive from days gone by."
                                            },
                                            {
                                                "example_id": "d6e988be-752a-4920-8516-511adfee04bd",
                                                "sense_id": "92a9c00b-51a4-3485-9391-55935fa15174",
                                                "text": "Using survey data gathered from social media users who participated in the candlelight vigils, he explores the prevalence of social media use during the protests, how it differs in terms of individual-level demographic and socioeconomic characteristics, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c877be2-a783-3e5a-848d-ebf70f434dbb",
                                        "entry_id": "76140ec3-4a93-3ce9-a825-7e4186e5d609",
                                        "glosses": [
                                            "The evening, when darkness falls and it is time to light candles."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68c5c652-912a-4f2a-8fe6-e85770babd20",
                                                "sense_id": "3c877be2-a783-3e5a-848d-ebf70f434dbb",
                                                "text": "Morning dress is that which is worn during business hours or at any time in any place, where semiformal dress is not required until candlelight or seven o'clock in the evening ."
                                            },
                                            {
                                                "example_id": "f3bd84d7-b95e-444c-af7c-cb0890092af4",
                                                "sense_id": "3c877be2-a783-3e5a-848d-ebf70f434dbb",
                                                "text": "The attack finally ceased Monday morning, but \"soon after candlelight, came on a most terrible bombardment and cannonade, on both sides, as if heaven and earth were engaged.\""
                                            },
                                            {
                                                "example_id": "66e4bd24-8061-4a87-b5e7-7556d948c2c2",
                                                "sense_id": "3c877be2-a783-3e5a-848d-ebf70f434dbb",
                                                "text": "As Marie glances at the window, she sees that the day has gone; it is almost candlelight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcb1214d-06a8-4160-8f17-be50199730f2",
                        "source_entry_id": "a2a8dd93-b4b1-34c0-9a44-47e916d93189",
