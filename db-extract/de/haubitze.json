                "senses": [
                    {
                        "sense_id": "041f8027-e9c0-3e87-91ae-6df333f71343",
                        "entry_id": "4b3a621f-2176-3f3b-ae16-4f6e4b320fd1",
                        "glosses": [
                            "Artilleriegeschütz zum indirekten sowie direkten Beschuss auf große Entfernung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bee2dca4-9ba1-4320-bb67-f73c3fd4bd58",
                                "sense_id": "041f8027-e9c0-3e87-91ae-6df333f71343",
                                "text": "Das Rohr einer Haubitze ist kürzer als das einer Kanone, dafür kann es in einem steileren Winkel angestellt werden."
                            },
                            {
                                "example_id": "0a145814-f1ba-47c1-b9ec-2bd3af368658",
                                "sense_id": "041f8027-e9c0-3e87-91ae-6df333f71343",
                                "text": "„Eine ovale Photographie erklärte, daß es einmal einen jungen Kanonier Jepsen gegeben hatte, der neben einer leichten Haubitze kniete wie vor einem Altar, derselbe Kanonier trug in Galizien einen Mantel und sang mit anderen Kanonieren einen Weihnachtsbaum an.“"
                            },
                            {
                                "example_id": "8fd9cbb5-b6e7-432c-ac21-55e058e291c3",
                                "sense_id": "041f8027-e9c0-3e87-91ae-6df333f71343",
                                "text": "„Im selben Augenblick krachten die Haubitzen der Serben, und etwa hundert Schritte vor uns ging ein Sprühregen von Schrapnellkugeln nieder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85d6f79e-0cdf-44c2-af40-9979d884d258",
                        "source_entry_id": "4b3a621f-2176-3f3b-ae16-4f6e4b320fd1",
                        "source_sense_id": "041f8027-e9c0-3e87-91ae-6df333f71343",
                        "source_sense_description": "Militär: Artilleriegeschütz zum indirekten sowie direkten Beschuss auf große Entfernung",
                        "target_lang_word": "howitzer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "howitzer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d4710bb-6433-30e7-aa0d-8c224722aa00",
                                        "entry_id": "c27f7de3-1771-32f2-8374-4ac1bc65ac20",
                                        "glosses": [
                                            "A cannon that combines certain characteristics of field guns and mortars, delivering projectiles with medium velocities, usually with relatively high trajectories; normally a cannon with a tube length of 20 to 30 calibers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d0c5b6c-483f-3be5-8193-86b148aa03ca",
                                        "entry_id": "c27f7de3-1771-32f2-8374-4ac1bc65ac20",
                                        "glosses": [
                                            "A powerfully hit shot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3af552b8-fd07-476d-aec6-d2522d7890ea",
                                                "sense_id": "2d0c5b6c-483f-3be5-8193-86b148aa03ca",
                                                "text": "Belgium took a little while to catch Scotland with the first of the howitzer blows, but when the first one landed there was a certainty of more. Many more."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "howitzer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6817624a-7be6-3d25-990d-467bd213c46f",
                                        "entry_id": "042fec36-fff8-3640-b2bb-da37783080ff",
                                        "glosses": [
                                            "To attack with a howitzer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c453aa60-e78f-4fe5-b399-96f3e0942e32",
                        "source_entry_id": "4b3a621f-2176-3f3b-ae16-4f6e4b320fd1",
                        "source_sense_id": "041f8027-e9c0-3e87-91ae-6df333f71343",
                        "source_sense_description": "Militär: Artilleriegeschütz zum indirekten sowie direkten Beschuss auf große Entfernung",
                        "target_lang_word": "obusier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obusier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e99caebd-d96e-3607-9912-1ffdd7d96891",
                                        "entry_id": "1391ed18-886b-38a6-bcdf-5d647aa02581",
                                        "glosses": [
                                            "Pièce d’artillerie courte qui lance des obus, généralement à tir plongeant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d1ee270-1f59-4be6-86cc-a1ccb3d857fc",
                                                "sense_id": "e99caebd-d96e-3607-9912-1ffdd7d96891",
                                                "text": "À onze heures, il arriva de l’infanterie, à laquelle on remit les canons et l’obusier, et à une heure du matin le régiment de lanciers, mourant de faim, hommes et chevaux, repartit pour Nancy."
                                            },
                                            {
                                                "example_id": "09c78e67-f754-4ff5-a2af-0c7fc99ab0f4",
                                                "sense_id": "e99caebd-d96e-3607-9912-1ffdd7d96891",
                                                "text": "Les gros obusiers allemands portaient à douze kilomètres ; ainsi ils se tenaient à peu près hors d’atteinte ; il fallait une très bonne oreille pour entendre leur coup de départ."
                                            },
                                            {
                                                "example_id": "91892476-8aac-4b3f-9c47-f0f4a0708e45",
                                                "sense_id": "e99caebd-d96e-3607-9912-1ffdd7d96891",
                                                "text": "Un autre accord-cadre signé par la Pologne avec l'entreprise sud-coréenne Hanwha Defense prévoit la livraison de 672 obusiers automoteurs K9A1, dont leur version coproduite K9PL."
                                            },
                                            {
                                                "example_id": "6bb751c4-cb49-47a9-902c-e8b1def46c06",
                                                "sense_id": "e99caebd-d96e-3607-9912-1ffdd7d96891",
                                                "text": "– C’est exactement ce que je crois, approuva Mac Mahon. De toute façon, il nous faut faire tomber Icheriden, c’est le seul passage vers Aguemoun-Ysen et le territoire des Menguellat. Clerc, avec vos obusiers vous allez m’arroser généreusement toute cette zone entre les barricades et le village, c’est là que se situent les réserves en hommes de l’ennemi. Si notre feu est suffisamment puissant, cela les obligera à se retirer, et ainsi leurs défenseurs seront coupés de leurs renforts. Bourbaki, vous mènerez le premier assaut avec vos gars, trois colonnes devraient suffire pour l’instant. C’est pour demain matin. Un 24 juin, la date anniversaire de ma fille… D’autres questions ? Parfait, messieurs, à vos postes !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
