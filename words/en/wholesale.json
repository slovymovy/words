{
    "word_family": [
        "wholesaler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2756248d-9248-33a1-9c27-d64c3b06e455",
                    "sense_definition": "Of or relating to sale in large quantities, for resale.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "commercial_trade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wholesale</w> price is significantly lower than what customers pay in stores.",
                            "target_lang_translations": {
                                "ru": "<w>Оптовая</w> цена значительно ниже той, которую покупатели платят в магазинах.",
                                "zh": "<w>批发</w>价格远低于顾客在商店支付的价格。"
                            }
                        },
                        {
                            "text": "They operate a successful <w>wholesale</w> business supplying local restaurants.",
                            "target_lang_translations": {
                                "ru": "Они ведут успешный <w>оптовый</w> бизнес, снабжая местные рестораны.",
                                "zh": "他们经营着一家成功的<w>批发</w>企业，为当地餐馆供货。"
                            }
                        }
                    ],
                    "antonyms": [
                        "retail"
                    ],
                    "common_phrases": [
                        "wholesale price",
                        "wholesale market",
                        "wholesale trade",
                        "wholesale cost"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к продаже товаров крупными партиями для последующей перепродажи.",
                        "zh": "指与大批量销售或转售相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опто́вый",
                                "target_lang_sense_clarification": "относящийся к торговле крупными партиями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批发",
                                "target_lang_sense_clarification": "指大批量销售商品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23b54784-1eb4-3d85-9ae4-b0b37076ab2b",
                    "sense_definition": "Extensive, indiscriminate, all-encompassing; blanket.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_extensive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new manager implemented <w>wholesale</w> changes to the company structure.",
                            "target_lang_translations": {
                                "ru": "Новый менеджер внедрил <w>масштабные</w> изменения в структуру компании.",
                                "zh": "新经理对公司结构进行了<w>全面</w>的改革。"
                            }
                        },
                        {
                            "text": "The bombing resulted in <w>wholesale</w> destruction of the city infrastructure.",
                            "target_lang_translations": {
                                "ru": "Бомбардировка привела к <w>массовому</w> разрушению городской инфраструктуры.",
                                "zh": "轰炸导致城市基础设施遭到<w>大规模</w>破坏。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wholesale destruction",
                        "wholesale changes",
                        "wholesale slaughter",
                        "wholesale rejection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обширный, всеобъемлющий, затрагивающий всё или многих; часто употребляется в контексте радикальных мер или разрушений.",
                        "zh": "广泛的、不加区分的、全面的；指彻底的改变或破坏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ма́ссовый",
                                "target_lang_sense_clarification": "затрагивающий большое количество людей или объектов"
                            },
                            {
                                "target_lang_word": "масшта́бный",
                                "target_lang_sense_clarification": "значительный по размаху"
                            },
                            {
                                "target_lang_word": "поголо́вный",
                                "target_lang_sense_clarification": "всеобщий, без исключений (часто негативн.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大规模的",
                                "target_lang_sense_clarification": "指涉及范围广"
                            },
                            {
                                "target_lang_word": "全面的",
                                "target_lang_sense_clarification": "指不留余地或彻底的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71c7c459-2faa-3b44-a961-8dc1f57039bf",
                    "sense_definition": "The sale of products, often in large quantities, to retailers or other merchants.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "commercial_trade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Merchants can purchase goods at <w>wholesale</w> to sell them later for a profit.",
                            "target_lang_translations": {
                                "ru": "Торговцы могут закупать товары <w>оптом</w>, чтобы затем выгодно их перепродать.",
                                "zh": "商人可以<w>批发</w>购入商品，以便日后转售获利。"
                            }
                        },
                        {
                            "text": "The company specializes in the <w>wholesale</w> of electronics and computer parts.",
                            "target_lang_translations": {
                                "ru": "Компания специализируется на <w>оптовой торговле</w> электроникой и компьютерными комплектующими.",
                                "zh": "该公司专门从事电子产品和电脑零件的<w>批发</w>业务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bulk supply"
                    ],
                    "antonyms": [
                        "retail"
                    ],
                    "common_phrases": [
                        "at wholesale",
                        "in wholesale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продажа товаров, обычно крупными партиями, розничным торговцам или другим коммерсантам.",
                        "zh": "将产品（通常是大批量）销售给零售商或其他商家的商业活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опто́вая торго́вля",
                                "target_lang_sense_clarification": "вид коммерческой деятельности"
                            },
                            {
                                "target_lang_word": "опт",
                                "target_lang_sense_clarification": "разг. оптовая продажа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批发",
                                "target_lang_sense_clarification": "商业贸易中的批发业务"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8b649ed0-602a-31ad-af52-681603474c87",
                    "sense_definition": "In bulk or large quantity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commercial_trade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is usually much cheaper to buy paper towels <w>wholesale</w>.",
                            "target_lang_translations": {
                                "ru": "Обычно гораздо дешевле покупать бумажные полотенца <w>оптом</w>.",
                                "zh": "通常<w>批发</w>购买纸巾要便宜得多。"
                            }
                        },
                        {
                            "text": "Farmers often sell their produce <w>wholesale</w> to large supermarket chains.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто продают свою продукцию <w>оптом</w> крупным сетям супермаркетов.",
                                "zh": "农民经常将农产品<w>批发</w>给大型连锁超市。"
                            }
                        }
                    ],
                    "antonyms": [
                        "retail"
                    ],
                    "common_phrases": [
                        "buy wholesale",
                        "sell wholesale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупными партиями, в большом количестве.",
                        "zh": "以大批量或大量的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о́птом",
                                "target_lang_sense_clarification": "наречие: большими партиями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批发地",
                                "target_lang_sense_clarification": "以批发方式进行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15f8d279-83ee-3155-a421-52e4c5cb7050",
                    "sense_definition": "Indiscriminately.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_extensive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee rejected the proposal <w>wholesale</w> without discussing the details.",
                            "target_lang_translations": {
                                "ru": "Комитет отверг предложение <w>целиком</w>, не обсуждания деталей.",
                                "zh": "委员会在没有讨论细节的情况下，<w>一概</w>否决了该提案。"
                            }
                        },
                        {
                            "text": "They adopted the new regulations <w>wholesale</w> despite the initial concerns.",
                            "target_lang_translations": {
                                "ru": "Они приняли новые правила <w>полностью</w>, несмотря на первоначальные опасения.",
                                "zh": "尽管最初有顾虑，他们还是<w>完全</w>采纳了新规。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rejected wholesale",
                        "accepted wholesale",
                        "adopted wholesale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без разбора, полностью, целиком; не вникая в детали.",
                        "zh": "不加区分地、完全地、一概地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целико́м",
                                "target_lang_sense_clarification": "полностью, без изъятий"
                            },
                            {
                                "target_lang_word": "без разбо́ра",
                                "target_lang_sense_clarification": "не вникая в детали"
                            },
                            {
                                "target_lang_word": "огу́льно",
                                "target_lang_sense_clarification": "необоснованно обобщая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一概",
                                "target_lang_sense_clarification": "指全部，没有例外"
                            },
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "指彻底地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "017ad8d7-87bd-3641-aa8c-91de143acf21",
                    "sense_definition": "To sell at wholesale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commercial_trade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory <w>wholesales</w> furniture to various stores across the region.",
                            "target_lang_translations": {
                                "ru": "Фабрика <w>продает оптом</w> мебель в различные магазины по всему региону.",
                                "zh": "这家工厂向该地区的各家商店<w>批发</w>家具。"
                            }
                        },
                        {
                            "text": "He <w>wholesales</w> imported coffee beans to local cafes and restaurants.",
                            "target_lang_translations": {
                                "ru": "Он <w>поставляет оптом</w> импортные кофейные зерна в местные кафе и рестораны.",
                                "zh": "他向当地的咖啡馆和餐馆<w>批发</w>进口咖啡豆。"
                            }
                        }
                    ],
                    "antonyms": [
                        "retail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продавать товары оптом (крупными партиями).",
                        "zh": "以批发方式销售商品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продава́ть о́птом",
                                "target_lang_sense_clarification": "сбывать товар партиями"
                            },
                            {
                                "target_lang_word": "торгова́ть о́птом",
                                "target_lang_sense_clarification": "заниматься оптовой торговлей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批发",
                                "target_lang_sense_clarification": "动词，指进行批发销售"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}