                                "target_lang_sense_clarification": "выражающий тоску"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sad",
                                "target_lang_sense_clarification": "appearing sorrowful, such as a face or look"
                            },
                            {
                                "target_lang_word": "gloomy",
                                "target_lang_sense_clarification": "sombre or depressing in appearance or atmosphere"
                            },
                            {
                                "target_lang_word": "rueful",
                                "target_lang_sense_clarification": "expressing regret or sorrow in a wry way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "038add00-d6d7-38ed-bae7-2204aabe743d",
                    "sense_definition": "Godny pożałowania, dający powód do smutku.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "przyczyna_smutku",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To była wyjątkowo <w>smutna</w> historia, która poruszyła serca wszystkich widzów w kinie.",
                            "target_lang_translations": {
                                "ru": "Это была исключительно <w>грустная</w> история, которая тронула сердца всех зрителей в кинотеатре.",
                                "en": "It was an exceptionally <w>sad</w> story that touched the hearts of everyone in the cinema."
                            }
                        },
                        {
                            "text": "Niedostrzeganie tej <w>smutnej</w> prawdy bardzo poważnie zaciążyło na ich wzajemnych relacjach.",
                            "target_lang_translations": {
                                "ru": "Игнорирование этой <w>печальной</w> правды очень серьезно сказалось на их взаимоотношениях.",
                                "en": "Failing to see this <w>sad</w> truth weighed very heavily on their mutual relationship."
                            }
                        }
                    ],
                    "synonyms": [
                        "przykry",
                        "zasmucający",
                        "przygnębiający",
                        "godny pożałowania"
                    ],
                    "antonyms": [
                        "dobry",
                        "pozytywny",
                        "rozweselający"
                    ],
                    "common_phrases": [
                        "smutna prawda",
                        "smutna historia",
                        "smutny koniec"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достойный сожаления, вызывающий грусть или печаль.",
                        "en": "Regrettable, giving cause for sadness."
                    },
                    "translations": {
                        "ru": [
