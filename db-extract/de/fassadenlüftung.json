                "senses": [
                    {
                        "sense_id": "6c33dea7-39b8-35e6-8070-168c25ef61c2",
                        "entry_id": "7ec2d612-02a3-3561-93aa-38841b329595",
                        "glosses": [
                            "Hinterlüftung einer vorgestellten Außenwand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b91a7166-e8df-4d1c-baa3-6e4cba69d991",
                                "sense_id": "6c33dea7-39b8-35e6-8070-168c25ef61c2",
                                "text": "„Das thermoaktive Bauteilsystem TABS, eine leistungsstarke Fassadenlüftung und ein zentrales Gebäudesteuerungssystem sind die Highlights des Projekts.“"
                            },
                            {
                                "example_id": "2e2477b9-8988-4459-84eb-b9a228d4d9f6",
                                "sense_id": "6c33dea7-39b8-35e6-8070-168c25ef61c2",
                                "text": "„Im Zusammenspiel von Fassadenlüftung und Wärmetauschern, LED-Beleuchtung und Präsenzschaltungen sowie der Photovoltaik soll der Jahres-Primärenergieverbrauch um 44 % unter der EnEV 2009 liegen.“"
                            },
                            {
                                "example_id": "bf099fdd-4591-456a-b781-9610bb8e7630",
                                "sense_id": "6c33dea7-39b8-35e6-8070-168c25ef61c2",
                                "text": "„So werden ebm-papst Radial- und Axialventilatoren schon lange erfolgreich in der Bad-WC-Lüftung, in RLT-Anlagen, in der Fassadenlüftung und in Dachventilatoren eingesetzt.“"
                            },
                            {
                                "example_id": "4d24f0bd-4f0f-4f35-83fd-b7787c93d41e",
                                "sense_id": "6c33dea7-39b8-35e6-8070-168c25ef61c2",
                                "text": "„ Kleine erdgasbetriebene Aggregatewärmen und kühlen das Gebäude, eine intelligente Fassadenlüftung bringt Wohlfühlklima, eine Fotovoltaikanlage holt zudem den Strom vom Himmel.“"
                            },
                            {
                                "example_id": "fb2b2d74-1536-4bb3-8a16-355c1e626e10",
                                "sense_id": "6c33dea7-39b8-35e6-8070-168c25ef61c2",
                                "text": "„Die Systeme A bis C stellen etwa insbesondere für die Gebäude eine geeignete Alternative dar, in denen keine flexible Raumnutzung vorgesehen ist, besondere Vorgaben hinsichtlich Luftfeuchte- und -reinheit bestehen, sich ein Luftansaug- bzw. -ausblaspunkt thermisch und wetterbedingt unkritisch lediglich an einer zentralen Stelle platzieren lässt oder aus Denkmalschutzgründen eine dezentrale Fassadenlüftung nicht möglich ist.“"
                            }
                        ],
