            "senses": [
                {
                    "sense_id": "b251922b-8722-3de7-83d8-aa6ce120ef96",
                    "sense_definition": "Verbogen vorm van <w>gul</w> voor mannelijk/vrouwelijk enkelvoud attributief",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "inflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij gaf een <w>gulle</w> lach aan iedereen die langskwam.",
                            "target_lang_translations": {
                                "zh": "她对每一个路过的人都报以<w>慷慨的</w>微笑。"
                            }
                        },
                        {
                            "text": "Hij ontving een <w>gulle</w> gift voor het goede doel.",
                            "target_lang_translations": {
                                "zh": "他为慈善事业收到了一笔<w>慷慨的</w>捐款。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gulle lach",
                        "gulle gift"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammaticale buigingsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "形容词“gul”（慷慨的、大方的）的屈折形式，用于修饰阳性或阴性单数名词。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "慷慨的",
                                "target_lang_sense_clarification": "形容人或行为大方、不吝啬。"
                            },
                            {
                                "target_lang_word": "大方的",
                                "target_lang_sense_clarification": "形容给予或态度宽宏。"
                            }
                        ]
                    }
                },
                {
