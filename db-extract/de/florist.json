                        "entry_id": "3d844490-0d31-3947-ae06-8234673cfd9d",
                        "glosses": [
                            "Person, die Blumen und Pflanzenteile zu Sträußen, Gestecken, Kränzen und Ähnlichem verarbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdf21981-c57e-4c36-88ad-09edb06c23aa",
                                "sense_id": "59d6fc8d-e43d-395d-80e4-b8e4d965cf59",
                                "text": "Der Blumenstrauß stammt von einem ausgebildeten Floristen, nicht von der Tankstelle."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
