                    {
                        "translation_id": "c2c58786-a92d-4454-b7dd-356e6ed2b960",
                        "source_entry_id": "0412aa0e-d8c1-38fe-bbe7-200e23e8519a",
                        "source_sense_id": "55444d8d-66b9-37c2-a0bc-6e7e14c62bcd",
