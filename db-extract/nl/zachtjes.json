        "nl-extract.jsonl": [
            {
                "entry_id": "d1397398-97eb-3991-962e-f9a60e426268",
                "word": "zachtjes",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "826a18ef-d5f1-3352-a17e-e9cbbb84c9f3",
                        "entry_id": "d1397398-97eb-3991-962e-f9a60e426268",
                        "glosses": [
                            "stilletjes, met een laag geluidniveau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a7c6b83-dab9-4a98-9380-44f37f7972d3",
                                "sense_id": "826a18ef-d5f1-3352-a17e-e9cbbb84c9f3",
                                "text": "Hij was zachtjes bezig met zijn werk."
                            },
                            {
                                "example_id": "85208d39-0966-47d4-b1d6-1bb04ab29d08",
                                "sense_id": "826a18ef-d5f1-3352-a17e-e9cbbb84c9f3",
                                "text": "'Dat gaat hij helemaal niet doen ' Olive had de keukendeur zachtjes opengedaan en was op de drempel blijven staan luisteren."
                            },
                            {
                                "example_id": "12f22c87-a4b5-47b3-a468-916f650dd27f",
                                "sense_id": "826a18ef-d5f1-3352-a17e-e9cbbb84c9f3",
                                "text": "‘Oké…’ hoorde ik op een obligate toon zachtjes achter me."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bbd1750-bd06-32d0-886d-d40f0006b6e1",
                        "entry_id": "d1397398-97eb-3991-962e-f9a60e426268",
                        "glosses": [
                            "met weinig kracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16f9fd16-457d-4c85-94d2-d033ab2b9667",
                                "sense_id": "3bbd1750-bd06-32d0-886d-d40f0006b6e1",
                                "text": "Ze knikt en raakt zachtjes mijn bovenarm aan bij wijze van begroeting."
                            },
                            {
                                "example_id": "97c9cbb0-7ae9-45f8-b5b6-49181efb42d9",
                                "sense_id": "3bbd1750-bd06-32d0-886d-d40f0006b6e1",
                                "text": "Daar stond het kleine Pietje bij de schimmel en aaide zachtjes over zijn hals."
                            }
                        ]
                    },
                    {
                        "sense_id": "72bea9cd-2bcd-3544-8ed6-6596861b8198",
                        "entry_id": "d1397398-97eb-3991-962e-f9a60e426268",
                        "glosses": [
                            "met weinig snelheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c6fe6e1-c3de-4f3e-9a8a-79d15e8b1844",
                                "sense_id": "72bea9cd-2bcd-3544-8ed6-6596861b8198",
                                "text": "Ik verschuif zachtjes mijn been, dat in een ongemakkelijke kronkel ligt."
                            },
                            {
                                "example_id": "d460a8b6-c686-427d-a8ae-5876a201869a",
                                "sense_id": "72bea9cd-2bcd-3544-8ed6-6596861b8198",
                                "text": "Zachtjes trippel ik over de plavuizen naar de badkamer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffa88aeb-f007-426c-9636-fda2303864c0",
                        "source_entry_id": "d1397398-97eb-3991-962e-f9a60e426268",
                        "source_sense_id": "826a18ef-d5f1-3352-a17e-e9cbbb84c9f3",
                        "source_sense_description": "stilletjes, met een laag geluidniveau",
                        "target_lang_word": "softly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "softly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4551f94e-68f1-3d23-ae50-d674eb05c9c6",
                                        "entry_id": "19d560f7-05c7-35d8-8046-1d2f06d5e12e",
                                        "glosses": [
                                            "In a soft manner; gently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3cecd2f-b4e7-46cd-b4fe-3fecf102946e",
                                                "sense_id": "4551f94e-68f1-3d23-ae50-d674eb05c9c6",
                                                "text": "The masseuse was rubbing my back too softly for my liking, so I asked her to go harder."
                                            },
                                            {
                                                "example_id": "c77e3ca9-df67-41ad-93d2-3796161f1332",
                                                "sense_id": "4551f94e-68f1-3d23-ae50-d674eb05c9c6",
                                                "text": "He had married a lady well educated and softly nurtured, but not dowered with worldly wealth. […] They would give up ideas of gentle living, of soft raiment, and delicate feeding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1c62db8-34ed-3a11-aee0-ff19395ac13d",
                                        "entry_id": "19d560f7-05c7-35d8-8046-1d2f06d5e12e",
                                        "glosses": [
                                            "Not loudly; nearly inaudibly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f7ac6f1-5e92-45f1-8cec-77aae41d81c7",
                                                "sense_id": "e1c62db8-34ed-3a11-aee0-ff19395ac13d",
                                                "text": "whisper softly in someone's ear"
                                            },
                                            {
                                                "example_id": "9c22bad6-7ccd-4f58-a02e-4ed377560ff8",
                                                "sense_id": "e1c62db8-34ed-3a11-aee0-ff19395ac13d",
                                                "text": "play music softly"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "542c7fdf-2b24-3255-ab69-d5f75b7a5870",
                                        "entry_id": "19d560f7-05c7-35d8-8046-1d2f06d5e12e",
                                        "glosses": [
                                            "With subdued color; faded or misty with distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ac4721-97b8-44c6-830b-4a48acabc289",
                                                "sense_id": "542c7fdf-2b24-3255-ab69-d5f75b7a5870",
                                                "text": "And they sat very still, the two of them, and looked out over that great, beautiful desert—away to the home mesa that they could see, softly blue, in the distance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d4a607d-2f0b-4295-baee-6d76cf341043",
                        "source_entry_id": "d1397398-97eb-3991-962e-f9a60e426268",
                        "source_sense_id": "826a18ef-d5f1-3352-a17e-e9cbbb84c9f3",
                        "source_sense_description": "stilletjes, met een laag geluidniveau",
                        "target_lang_word": "doucement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doucement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d2cb77c-b3fb-37d3-b750-1f7019a00f9c",
                                        "entry_id": "988447c2-7555-362a-bb52-b157203325cf",
                                        "glosses": [
                                            "D’une manière douce."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6e57c26-4255-4a0d-9b17-e417b0c2e039",
                                                "sense_id": "6d2cb77c-b3fb-37d3-b750-1f7019a00f9c",
                                                "text": "Ce qui venait de tomber sur le lit, en un mince lambeau soyeux, léger et lent, c’était le corsage qui la serrait doucement au cou, et fort à la taille…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4c50d30-784c-3fbd-8a74-e038673491a7",
                                        "entry_id": "988447c2-7555-362a-bb52-b157203325cf",
                                        "glosses": [
                                            "Avec ménagement, délicatement, sans violence, sans brutalité."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "348fa3ef-b45c-4f76-95a6-955e334014d1",
                                                "sense_id": "f4c50d30-784c-3fbd-8a74-e038673491a7",
                                                "text": "Après trois mois, je commençais à ne plus me contenter de la part qui m’était faite, et je caressais doucement la main d’Henriette en essayant de transborder ainsi les riches voluptés qui m’embrasaient."
                                            },
                                            {
                                                "example_id": "84be4d43-8b30-4748-8199-bfef0b3457e7",
                                                "sense_id": "f4c50d30-784c-3fbd-8a74-e038673491a7",
                                                "text": "Il saisit Héloïse, l'enlève entre ses bras […], et la transporte doucement, parmi les couvertures qu'il rabat sur elle."
                                            },
                                            {
                                                "example_id": "7611a1c5-a7c0-4497-a683-aafed50243d2",
                                                "sense_id": "f4c50d30-784c-3fbd-8a74-e038673491a7",
                                                "text": "Cette affaire veut être conduite doucement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d29b114-b7a0-37e9-8a8a-416bdeaf493e",
                                        "entry_id": "988447c2-7555-362a-bb52-b157203325cf",
                                        "glosses": [
                                            "Lentement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6e2a2a8-8bd2-4155-9bbc-b6c2d552a925",
                                                "sense_id": "7d29b114-b7a0-37e9-8a8a-416bdeaf493e",
                                                "text": "Vous marchez bien doucement. — Allez doucement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16f08f88-33f2-3fb5-9867-0567167515b0",
                                        "entry_id": "988447c2-7555-362a-bb52-b157203325cf",
                                        "glosses": [
                                            "Sans bruit, avec peu de bruit."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0daa0d6e-df48-4112-a92a-7df4d668177e",
                                                "sense_id": "16f08f88-33f2-3fb5-9867-0567167515b0",
                                                "text": "[…] ; et l’on voyait déjà quelques embarcations filer doucement sur l’eau que battaient les grands avirons, pareils à des vols de goélands lents et bas."
                                            },
                                            {
                                                "example_id": "f82db233-bdd4-4801-83a9-747805ba60d3",
                                                "sense_id": "16f08f88-33f2-3fb5-9867-0567167515b0",
                                                "text": "Il faut marcher doucement dans la chambre d’un malade. — Je me glissai doucement auprès de lui. — Frapper doucement à la porte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "884bddf0-b4f7-3119-850a-21247f36748e",
                                        "entry_id": "988447c2-7555-362a-bb52-b157203325cf",
                                        "glosses": [
                                            "À voix basse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c24834d-0448-4412-9cba-0c531e4980f7",
                                                "sense_id": "884bddf0-b4f7-3119-850a-21247f36748e",
                                                "text": "Ils parlaient très doucement, de façon à ne pas être entendus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e34c4a1-8b45-324d-b9d2-06a5967966c8",
                                        "entry_id": "988447c2-7555-362a-bb52-b157203325cf",
                                        "glosses": [
                                            "Sans éprouver d’agitation, avec calme."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c67434bb-010f-4a11-bedf-24fd9605512b",
                                                "sense_id": "4e34c4a1-8b45-324d-b9d2-06a5967966c8",
                                                "text": "Sommeiller doucement. — Vivre doucement dans la solitude. — Mourir doucement au milieu de ses amis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc0844cf-ce5d-3ee8-ab1f-db83106f76b7",
                                        "entry_id": "988447c2-7555-362a-bb52-b157203325cf",
                                        "glosses": [
                                            "Avec humanité, avec bonté."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b20a2cf5-4e10-46b9-b086-f99466c3b9a5",
                                                "sense_id": "fc0844cf-ce5d-3ee8-ab1f-db83106f76b7",
                                                "text": "Un vainqueur généreux traite doucement les vaincus. — Il en use doucement avec son personnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28f12738-c080-320c-b98a-d688bbfd4712",
                                        "entry_id": "988447c2-7555-362a-bb52-b157203325cf",
                                        "glosses": [
                                            "Sans sévérité, sans aigreur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aee4ac86-6297-406e-ba48-327e3d176809",
                                                "sense_id": "28f12738-c080-320c-b98a-d688bbfd4712",
                                                "text": "Châtier doucement. — Reprendre quelqu’un doucement de ses fautes. — Je lui fis doucement la guerre sur sa négligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1937f18f-347f-3af4-8ce2-98aaa63a7df7",
                                        "entry_id": "988447c2-7555-362a-bb52-b157203325cf",
                                        "glosses": [
                                            "Sans emportement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f54c74d-eb90-4e27-979c-4190b33b328c",
                                                "sense_id": "1937f18f-347f-3af4-8ce2-98aaa63a7df7",
                                                "text": "Nous nous expliquâmes doucement, et il fut convenu que…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd648bfe-72d1-3800-b9fe-49dcd281c7ed",
                                        "entry_id": "988447c2-7555-362a-bb52-b157203325cf",
                                        "glosses": [
                                            "Agréablement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43d32019-1746-43b2-921a-93646949ae2c",
                                                "sense_id": "fd648bfe-72d1-3800-b9fe-49dcd281c7ed",
                                                "text": "Passer le temps doucement avec ses amis, avec ses livres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5756fc6-a54e-3408-a55b-bcb0fdd6d59f",
                                        "entry_id": "988447c2-7555-362a-bb52-b157203325cf",
                                        "glosses": [
                                            "Médiocrement, faiblement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac80548b-18a8-454b-b525-1a945cc54c41",
                                                "sense_id": "a5756fc6-a54e-3408-a55b-bcb0fdd6d59f",
                                                "text": "Comment va le malade ? Doucement, très doucement."
                                            },
                                            {
                                                "example_id": "5410ea8c-7649-4a43-a8a7-a0ead027cc77",
                                                "sense_id": "a5756fc6-a54e-3408-a55b-bcb0fdd6d59f",
                                                "text": "Cette affaire marche-t-elle ? Tout doucement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doucement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5d2a1a7-5fa8-36c5-933b-49021719f360",
                                        "entry_id": "4b25cda8-481b-39ac-a4d8-a6c8e1194fe6",
                                        "glosses": [
                                            "Interjection pour contenir ou réprimer la vivacité, la pétulance, l’impatience, l’emportement, etc., de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0fd228a-a0a2-452f-951c-b75110c5fadb",
                                                "sense_id": "f5d2a1a7-5fa8-36c5-933b-49021719f360",
                                                "text": "Doucement, chauffeur, vous allez trop vite."
                                            },
                                            {
                                                "example_id": "b7a7791a-a548-4004-99ee-0313f4d7d8a4",
                                                "sense_id": "f5d2a1a7-5fa8-36c5-933b-49021719f360",
                                                "text": "Doucement, monsieur, vous oubliez les égards qui sont dus à mon âge."
                                            },
                                            {
                                                "example_id": "3ffc1d97-0b98-4f67-a267-4fc77f6b21ae",
                                                "sense_id": "f5d2a1a7-5fa8-36c5-933b-49021719f360",
                                                "text": "Oh! Doucement, il me reste encore des objections à vous faire."
                                            },
                                            {
                                                "example_id": "a5e038a6-30a1-4b93-be03-d8c797c54478",
                                                "sense_id": "f5d2a1a7-5fa8-36c5-933b-49021719f360",
                                                "text": "Doucement, doucement, ne nous échauffons point."
                                            },
                                            {
                                                "example_id": "eb31ee04-6fc0-443f-aaa7-1ea4e86bde0f",
                                                "sense_id": "f5d2a1a7-5fa8-36c5-933b-49021719f360",
                                                "text": "Doucement, les basses !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3dc4bfe-0100-346d-9a36-39d9a02cf2ff",
                                        "entry_id": "4b25cda8-481b-39ac-a4d8-a6c8e1194fe6",
                                        "glosses": [
                                            "Formule de politesse sollicitant le pardon des auditeurs."
                                        ],
                                        "tags": [
                                            "Bénin"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
