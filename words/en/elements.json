                    "target_lang_definitions": {
                        "zh": "基督教圣餐礼中使用的饼和酒。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "圣餐饼酒",
                                "target_lang_sense_clarification": "指圣餐礼中使用的饼和酒"
                            }
                        ]
                    }
                }
            ]
        }
    ]
