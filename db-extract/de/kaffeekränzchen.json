                    {
                        "form_id": "ff7c8bf0-e220-4643-ba7c-f83397fefc8e",
                        "entry_id": "c6d2be70-6849-3c2a-ab58-fb57ac017045",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kaffeekränzchen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ae99b8a-4036-3ab8-a32c-1be848d63ec4",
                        "entry_id": "c6d2be70-6849-3c2a-ab58-fb57ac017045",
                        "glosses": [
                            "gemütliche Gesprächsrunde, bei der meist Kaffee getrunken und Kuchen gegessen wird"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "f20df54b-92fa-4ea3-aadd-653c8ddb634e",
                                "sense_id": "1ae99b8a-4036-3ab8-a32c-1be848d63ec4",
                                "text": "„Nach dem gemeinsamen Kaffeekränzchen machte er sich an die Arbeit, die in den letzten Tagen liegen geblieben war.“"
                            },
                            {
                                "example_id": "acdcbec6-cc7c-4ef5-a009-0241b93a623f",
                                "sense_id": "1ae99b8a-4036-3ab8-a32c-1be848d63ec4",
                                "text": "„Tommys und Annikas Mama hatte einige Damen zum Kaffeekränzchen eingeladen, und da sie reichlich gebacken hatte, meinte sie, Tommy und Annika könnten auch Pippi einladen.“"
                            },
                            {
                                "example_id": "10d1ab82-2a2d-44d3-b077-2e910cbd290c",
                                "sense_id": "1ae99b8a-4036-3ab8-a32c-1be848d63ec4",
                                "text": "„Als ich mal wieder meine Eltern in Freiburg besuche, schleppen sie mich zu einem langweiligen Kaffeekränzchen, das zum Geburtstag meiner Stieftante zweiten Grades ausgerichtet wird.“"
                            },
                            {
                                "example_id": "a67f9180-6807-44f7-9520-46db45e2e086",
                                "sense_id": "1ae99b8a-4036-3ab8-a32c-1be848d63ec4",
                                "text": "„Wegen des großzügigeren Platzangebotes fanden die häufigen nachmittäglichen Kaffeekränzchen in der Wohnung von Tante Luise statt.“"
                            },
                            {
                                "example_id": "3cfc095d-41e9-459e-9365-7ba5dbb271a1",
                                "sense_id": "1ae99b8a-4036-3ab8-a32c-1be848d63ec4",
                                "text": "„Dolores und Angela brauchten sich auch keine Gedanken mehr zu machen, denn die Dirne blieb still und unaufgeregt auf ihren Stuhl sitzen und plauderte, als ob sie mit ihren Freundinnen ein Kaffeekränzchen hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "696c0e12-49f6-3ed5-a7b3-190d01c80aa3",
                        "entry_id": "c6d2be70-6849-3c2a-ab58-fb57ac017045",
                        "glosses": [
                            "kleine Gruppe (meist Frauen), die sich zum Kaffeekränzchen zusammenfindet"
                        ],
