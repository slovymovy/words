                        "entry_id": "49aee053-50ed-3687-9d1c-1652e88d970f",
                        "glosses": [
                            "Plancton animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72b34c35-0d03-458d-8508-169527123a7f",
                                "sense_id": "77f31df7-7957-3cd4-9124-d3db33945921",
                                "text": "Le plancton rassemble les espèces aquatiques entraînées par le courant, animales comme des méduses pour le zooplancton, et végétales comme les algues pour le phytoplancton, ainsi que des bactéries et des virus."
                            },
                            {
                                "example_id": "6f7a1f2a-44b1-413b-96a7-13077de329b7",
                                "sense_id": "77f31df7-7957-3cd4-9124-d3db33945921",
                                "text": "« Si ces algues sont là, cela veut dire que les organismes —zooplanctons ou petits crustacés— qui les mangent sont en train de disparaître »."
                            }
                        ]
                    }
                ],
