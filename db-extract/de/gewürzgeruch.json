                ],
                "senses": [
                    {
                        "sense_id": "7c80fd3b-6093-3cd1-a149-6a5ad91bb790",
                        "entry_id": "c0e0bd02-1631-3cfe-b94f-39ead76bb971",
                        "glosses": [
                            "Wahrnehmung von Geruch, der von Substanzen stammt, die als Gewürz gelten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6012b47e-2cc6-4989-885a-4eb679660605",
                                "sense_id": "7c80fd3b-6093-3cd1-a149-6a5ad91bb790",
                                "text": "„Selbst marinieren bevorzugen: Bei fertig mariniertem Grillfleisch wird ein eventuell säuerlicher Geruch (Indiz für Verderb) durch den Gewürzgeruch verdeckt.“"
                            },
                            {
                                "example_id": "620f612b-9a5f-4abb-9d45-27db52163708",
                                "sense_id": "7c80fd3b-6093-3cd1-a149-6a5ad91bb790",
                                "text": "„Kurz nach der Ankunft in Tunesien, bei etwa 25°C Außentemperatur, liegt im Flughafen schon ein leichter Gewürzgeruch in der Luft.“"
                            },
                            {
                                "example_id": "831df58e-c3a0-4173-9e2a-f2f4c785abb7",
                                "sense_id": "7c80fd3b-6093-3cd1-a149-6a5ad91bb790",
                                "text": "„So zögerte ein Vermieter, Edathy 2002 eine Wohnung zu überlassen, weil er befürchtete, Edathy sei Inder und würde die Räume durch starken Gewürzgeruch ruinieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
