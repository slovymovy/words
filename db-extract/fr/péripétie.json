        "fr-extract.jsonl": [
            {
                "entry_id": "b0a7441d-7b46-387e-bd9d-0a56993f0994",
                "word": "péripétie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "13cae4a6-b8bd-4273-a0d3-2a432d578253",
                        "entry_id": "b0a7441d-7b46-387e-bd9d-0a56993f0994",
                        "tags": [
                            "plural"
                        ],
                        "form": "péripéties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6260eaa0-72c8-31c6-b4b3-cb0de0d2ea6f",
                        "entry_id": "b0a7441d-7b46-387e-bd9d-0a56993f0994",
                        "glosses": [
                            "Changement subit et imprévu d’un état dans un autre, notamment des changements de ce genre qui ont lieu dans les pièces de théâtre, les romans, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ee506f-79f8-41ea-b534-ea8201365e8f",
                                "sense_id": "6260eaa0-72c8-31c6-b4b3-cb0de0d2ea6f",
                                "text": "La péripétie est bien amenée dans cette pièce."
                            },
                            {
                                "example_id": "4a032b23-7bff-4d2e-bc0b-2edca931ecf4",
                                "sense_id": "6260eaa0-72c8-31c6-b4b3-cb0de0d2ea6f",
                                "text": "Une péripétie ingénieuse, touchante, inattendue."
                            },
                            {
                                "example_id": "65494529-179c-4250-9f55-068e53123326",
                                "sense_id": "6260eaa0-72c8-31c6-b4b3-cb0de0d2ea6f",
                                "text": "Mais il existe des femmes dont le cœur trop fortement dilaté s’anévrise dans ces terribles péripéties; d’autres, chez lesquelles le sang se tourne, et qui font de graves maladies."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2a64d52-d765-3f45-8469-c40cbee941c5",
                        "entry_id": "b0a7441d-7b46-387e-bd9d-0a56993f0994",
                        "glosses": [
                            "Ensemble d’événements imprévus, d’aventures, de déboires et d’histoires ennuyeuses ou agitées."
                        ],
                        "tags": [
                            "broadly",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "215b1a15-0a38-4945-8f6d-02181a1e0c1b",
                                "sense_id": "d2a64d52-d765-3f45-8469-c40cbee941c5",
                                "text": "Elle se plaisait à rappeler dans son esprit prévenu les différentes péripéties de cette tragédie de quelques heures, pendant lesquelles le chasseur avait joué le plus grand rôle."
                            },
                            {
                                "example_id": "aedce6ba-d833-48cb-91f0-9f37fa88c168",
                                "sense_id": "d2a64d52-d765-3f45-8469-c40cbee941c5",
                                "text": "Après une semaine fertile en péripéties et en catastrophes, Hervé, depuis la résurrection d'Alain Kernoul, venait de passer bien des heures paisibles."
                            },
                            {
                                "example_id": "3c7cf2df-6143-4967-b538-0d7e889d10d1",
                                "sense_id": "d2a64d52-d765-3f45-8469-c40cbee941c5",
                                "text": "Bert avait suivi les péripéties de la catastrophe, depuis la séparation des eaux jusqu’à la culée du pont."
                            },
                            {
                                "example_id": "b4c16c2b-b2b8-423c-804f-a4a78de81e8d",
                                "sense_id": "d2a64d52-d765-3f45-8469-c40cbee941c5",
                                "text": "On a prodigieusement écrit sur l’affaire Dreyfus. Joseph Reinach a consacré je ne sais combien de volumes à en retracer toutes les péripéties."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8baeb3dd-26ce-409d-aefd-2a4ce1bd8eae",
                        "source_entry_id": "b0a7441d-7b46-387e-bd9d-0a56993f0994",
                        "target_lang_word": "twists and turns",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twists and turns",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3fed60c-69d7-3ea3-8b65-c4123ecd9dd7",
                                        "entry_id": "b7320728-2916-364e-a228-e4595c13f1f7",
                                        "glosses": [
                                            "Abrupt changes in direction or orientation (often used figuratively)."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e98aa8d6-7c33-4b96-99fa-fdec08730e17",
                                                "sense_id": "f3fed60c-69d7-3ea3-8b65-c4123ecd9dd7",
                                                "text": "The same ignorance and avarice which made him think the education of his children an useless expense, caused him to reject the advice of his friends to make a will, which would also be attended with a little expense; and there were so many twists and turns in the law he said, every one ought to keep clear of it […]"
                                            },
                                            {
                                                "example_id": "29fd7ca0-c6bd-4fc2-9c55-4e08bad03067",
                                                "sense_id": "f3fed60c-69d7-3ea3-8b65-c4123ecd9dd7",
                                                "text": "“What a romantic old lane this it,” said Diana, as they walked along its twists and turns."
                                            },
                                            {
                                                "example_id": "3ca1ef41-6f6c-421c-b0b5-a1ae57da191d",
                                                "sense_id": "f3fed60c-69d7-3ea3-8b65-c4123ecd9dd7",
                                                "text": "There was no question, of course, as to its final outcome, with six against one; but meanwhile the one was giving the six the surprise of their lives in the shape of well-dealt blows and skillful twists and turns that caused their own strength and weight to react upon themselves in a most astonishing fashion."
                                            },
                                            {
                                                "example_id": "dab585b4-8297-4bac-b643-2a6912db1fc3",
                                                "sense_id": "f3fed60c-69d7-3ea3-8b65-c4123ecd9dd7",
                                                "text": "The twists and turns of U.S. policy, which once bewildered our allies as well as our enemies, can be expected to straighten out into a more surely predictable course."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "twists and turns",
                                "target_lang_code": "en",
