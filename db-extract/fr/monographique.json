                "senses": [
                    {
                        "sense_id": "5d7e6730-f1d4-378f-ba1c-fde2845babf8",
                        "entry_id": "4b20aa60-587b-3212-b2e1-8b16aed82fc7",
                        "glosses": [
                            "Qui appartient à une monographie ; qui est du genre de la monographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd596609-56c2-479c-8f73-e591c739a6b0",
                                "sense_id": "5d7e6730-f1d4-378f-ba1c-fde2845babf8",
                                "text": "Le seul étang à grèves est l’étang Pellevin auquel nous réservons une esquisse monographique spéciale."
                            },
                            {
                                "example_id": "0d1dad5d-7629-4cfc-bc35-7c6d43a6feca",
                                "sense_id": "5d7e6730-f1d4-378f-ba1c-fde2845babf8",
                                "text": "Le modèle se révélera si contraignant que la sociologie prostitutionnelle restera fidèle aux méthodes initiales et négligera, par exemple, les techniques monographiques de l’école de Le Play."
                            },
                            {
                                "example_id": "e13d8679-48b1-4aaf-b3b6-07d0e153c0a8",
                                "sense_id": "5d7e6730-f1d4-378f-ba1c-fde2845babf8",
                                "text": "C’est moins la pauvreté économique que la nature du lien social que visent les enquêtes monographiques de Le Play : il ne tente aucune agrégation statistique à partir de ses relevés, présentés et commentés l’un après l’autre."
                            }
                        ]
                    }
