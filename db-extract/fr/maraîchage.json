                ],
                "senses": [
                    {
                        "sense_id": "a613d7f7-6797-3908-8648-0238376e54fa",
                        "entry_id": "220bc581-595e-3f7c-8232-a7c9fd8dc83d",
                        "glosses": [
                            "Culture jardinière de légumes, de primeurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68dd1800-b509-4cb1-8c4d-a98660bffe2a",
                                "sense_id": "a613d7f7-6797-3908-8648-0238376e54fa",
                                "text": "Le maraîchage est souvent pratiqué près des grandes villes."
                            },
                            {
                                "example_id": "15e860b2-28b9-4bbd-916b-a4a78ae52410",
                                "sense_id": "a613d7f7-6797-3908-8648-0238376e54fa",
                                "text": "L’âge du chef exploitant, qui est positivement et fortement corrélé avec le nombre d’années d’expérience dans le maraîchage, semble avoir une influence sur l’utilisation des pesticides chimiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a32cf684-1dfe-479a-a6e1-71d216e1371e",
                        "source_entry_id": "220bc581-595e-3f7c-8232-a7c9fd8dc83d",
                        "source_sense_id": "a613d7f7-6797-3908-8648-0238376e54fa",
                        "target_lang_word": "Gärtnerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gärtnerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0a3b16d-9154-3080-9fd9-ab456a35b5b6",
                                        "entry_id": "9497a0e9-a476-3d40-8416-044c75fc1afe",
                                        "glosses": [
                                            "Gewerbebetrieb zur Anzucht und dem Verkauf von Pflanzen, wie Blumen, Stauden, Sträuchern, Bäumen, usw."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f11c15-00f5-460c-9374-e8e824128d09",
                                                "sense_id": "e0a3b16d-9154-3080-9fd9-ab456a35b5b6",
                                                "text": "Wo ist die nächste Gärtnerei in diesem Ort?"
                                            },
                                            {
                                                "example_id": "0decd3d3-4a17-4c12-8e5f-31f31ab7d817",
                                                "sense_id": "e0a3b16d-9154-3080-9fd9-ab456a35b5b6",
                                                "text": "Unsere Gärtnerei übernimmt auch Aufträge in der Gartengestaltung."
                                            },
                                            {
                                                "example_id": "f04d796d-824f-45eb-9286-fe52f5ef6554",
                                                "sense_id": "e0a3b16d-9154-3080-9fd9-ab456a35b5b6",
                                                "text": "Umgeben von zahlreichen Gärtnereien bezeichnet man Tulln auch als Rosenstadt."
                                            },
                                            {
                                                "example_id": "95a78193-bd5d-4f15-a22c-cfb0e1bf3509",
                                                "sense_id": "e0a3b16d-9154-3080-9fd9-ab456a35b5b6",
                                                "text": "In der Gärtnerei „Irinas Tomaten & Kräuter“ zieht sie mit ihrem Ehemann mehr als 1000 [Tomaten-]Sorten in einem Farbspektrum von grün über gelb bis rot, pink und lila."
                                            },
                                            {
                                                "example_id": "16d8bc3b-b4a5-4025-b5f7-a2f06e2fba3f",
                                                "sense_id": "e0a3b16d-9154-3080-9fd9-ab456a35b5b6",
                                                "text": "Die Londoner Firma \"Growing Underground\" betreibt in einem ehemaligen Luftschutzbunker eine Gärtnerei. Hier züchtet sie Erbsen, Fenchel und Brokkolisprossen - 33 Meter unter der Erde."
                                            },
                                            {
                                                "example_id": "54e54d3c-756f-49d7-b9e1-e5666a53e555",
                                                "sense_id": "e0a3b16d-9154-3080-9fd9-ab456a35b5b6",
                                                "text": "In Europas größter Gärtnerei in Emsbüren müssen Stiefmütterchen, Primeln und Osterglocken schon vor Frühlingsbeginn blühen."
                                            },
                                            {
                                                "example_id": "0e809f94-6bc9-45e8-8b82-44bf98549668",
                                                "sense_id": "e0a3b16d-9154-3080-9fd9-ab456a35b5b6",
                                                "text": "Es wird überall [Glyphosat] gespritzt, ob auf Bahndämmen, in privaten Gärtnereien oder in der Lebensmittelproduktion."
                                            },
                                            {
                                                "example_id": "638d8e4a-7b02-48f1-8b83-63f1fff6c5c6",
                                                "sense_id": "e0a3b16d-9154-3080-9fd9-ab456a35b5b6",
                                                "text": "1921 gründete er [Friedrich Baur] zunächst seine eigene Gärtnerei und übernahm 1932 den Betrieb seiner Eltern, den er in den Folgejahren zu einem Großbetrieb ausbaute."
                                            },
                                            {
                                                "example_id": "08dc2832-d246-437e-9b3e-2c1b5164cf22",
                                                "sense_id": "e0a3b16d-9154-3080-9fd9-ab456a35b5b6",
                                                "text": "Die Trockenheit in Kalifornien spitzt sich zu. Alle Bereiche des Lebens, privater Wasserverbrauch, industrieller Wasserverbrauch, Verbrauch von Wasser in der Landwirtschaft und in den der Gärtnereien, geraten unter Druck."
                                            },
                                            {
                                                "example_id": "7442c094-4bf4-4636-a791-09f94046fba3",
                                                "sense_id": "e0a3b16d-9154-3080-9fd9-ab456a35b5b6",
                                                "text": "Das Winterwetter führt alljährlich auf dem Bau, in der Landwirtschaft, in Gärtnereien und der Gastronomie vorübergehend zu einem Jobabbau."
                                            },
                                            {
                                                "example_id": "92c73820-47a2-45da-8a17-671ccec979ab",
                                                "sense_id": "e0a3b16d-9154-3080-9fd9-ab456a35b5b6",
                                                "text": "Für 70.000 Euro erwarb die Jüdische Gemeinde schließlich vor drei Jahren das Gelände einer ehemaligen Gärtnerei, die direkt neben dem großen Riensberger Friedhof liegt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fbe132b7-cd0c-3143-b457-b2a2197a05b9",
                                        "entry_id": "9497a0e9-a476-3d40-8416-044c75fc1afe",
                                        "glosses": [
                                            "Arbeit im Garten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "580faddc-0d21-4d9c-838e-e485e4df76e1",
                                                "sense_id": "fbe132b7-cd0c-3143-b457-b2a2197a05b9",
                                                "text": "Die Gärtnerei am Wochenende tut mir gut und bringt mich an die frische Luft."
                                            },
                                            {
                                                "example_id": "1b704139-0d4e-4804-b0a6-b9f926d74741",
                                                "sense_id": "fbe132b7-cd0c-3143-b457-b2a2197a05b9",
                                                "text": "„Da sie sich auf die Gärtnerei verstanden, mußte ihnen auch der Ackerbau gelingen – und der Ehrgeiz packte sie, ihren Pachthof zu bestellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
