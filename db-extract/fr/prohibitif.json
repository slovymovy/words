                    },
                    {
                        "form_id": "ddf19e46-624a-4d1a-a23d-1070d0f89065",
                        "entry_id": "6688aa37-d183-3b92-9ebb-9cf92ceea4cb",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "prohibitives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4591bbc-6add-3af5-b84a-28bb8b7ea12c",
                        "entry_id": "6688aa37-d183-3b92-9ebb-9cf92ceea4cb",
                        "glosses": [
                            "Qui défend, qui interdit, qui restreint."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "211ef9d1-ed1c-485d-8e03-9f80fe4309ec",
                                "sense_id": "a4591bbc-6add-3af5-b84a-28bb8b7ea12c",
                                "text": "Les principes canoniques établissaient un empêchement prohibitif au mariage des catholiques avec les hérétiques."
                            },
                            {
                                "example_id": "da6a7596-0b77-499e-bc89-3d454f86bc23",
                                "sense_id": "a4591bbc-6add-3af5-b84a-28bb8b7ea12c",
                                "text": "Enfin, c’est pas cool pour les habitants de Maastricht mais tout le monde sait que les lois prohibitives ne fonctionnent pas, c’est pas nouveau. Au moins, si cette expérience se relève être un échec, on pourra s’en servir comme argument."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2a406bc-1903-3e48-b39f-35abd83abc61",
                        "entry_id": "6688aa37-d183-3b92-9ebb-9cf92ceea4cb",
                        "glosses": [
                            "Qui est de nature à empêcher ou à interdire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18db9373-7b04-4a89-aca8-54848c5f7d07",
                                "sense_id": "c2a406bc-1903-3e48-b39f-35abd83abc61",
                                "text": "Des droits prohibitifs."
                            },
                            {
                                "example_id": "3bda9035-c5ec-4eda-aec9-ea8307dfefd5",
                                "sense_id": "c2a406bc-1903-3e48-b39f-35abd83abc61",
                                "text": "Ce tarif de douane est prohibitif."
                            }
                        ]
                    },
                    {
                        "sense_id": "895bcc17-b609-386f-963e-c109d9b68851",
                        "entry_id": "6688aa37-d183-3b92-9ebb-9cf92ceea4cb",
                        "glosses": [
                            "Se dit d’un prix trop élevé qui éloigne les acheteurs."
                        ],
                        "tags": [
                            "Plus courant"
                        ],
                        "examples": [
                            {
                                "example_id": "32143dc1-b0ca-4dee-b798-8fd5d288f0c9",
                                "sense_id": "895bcc17-b609-386f-963e-c109d9b68851",
                                "text": "Par exemple, le gentleman qui avait quatre fusils à bord, malgré le prix prohibitif des excédents de bagages, se rendait sûrement à Nairobi pour chasser les grands fauves."
                            },
                            {
                                "example_id": "4c66c958-6a65-49c8-beac-3582a9a29144",
                                "sense_id": "895bcc17-b609-386f-963e-c109d9b68851",
                                "text": "L'open access est un mouvement qui propose un accès libre et rapide à la production scientifique (articles, thèses, rapports, etc.). Il est apparu dans les années 1990 en réaction à l'augmentation des coûts d'abonnement aux revues scientifiques devenus prohibitifs pour les chercheurs et les bibliothèques."
                            },
                            {
                                "example_id": "56f9a4d0-5158-4aaa-9b2f-d0984c0dea9a",
                                "sense_id": "895bcc17-b609-386f-963e-c109d9b68851",
                                "text": "Affectés par leur gigantisme et par des contestations croissantes au sein des démocraties en raison de leurs coûts prohibitifs, les grands événements sportifs sont plus souvent tombés dans le giron des Etats autoritaires ou illibéraux.."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef9a5d5c-04f5-4586-8cdc-6bdb374883ff",
                        "source_entry_id": "6688aa37-d183-3b92-9ebb-9cf92ceea4cb",
                        "target_lang_word": "prohibitive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prohibitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13cf99dc-4bc8-3ffc-9255-d091661b947c",
                                        "entry_id": "8d53b778-cbc2-38fa-8142-f04a8462539d",
                                        "glosses": [
                                            "Tending to prohibit, preclude, or disallow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a93361-b18a-4c76-9b49-f1483baef8b7",
                                                "sense_id": "13cf99dc-4bc8-3ffc-9255-d091661b947c",
                                                "text": "Some countries are more prohibitive than others when it comes to hot topics like euthanasia and cloning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48f873d5-dcd2-3753-a793-174f28e40b71",
                                        "entry_id": "8d53b778-cbc2-38fa-8142-f04a8462539d",
                                        "glosses": [
                                            "Requiring an unreasonable or impractical effort."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8db903b-c211-37ac-bd40-2467630e9c63",
                                        "entry_id": "8d53b778-cbc2-38fa-8142-f04a8462539d",
                                        "glosses": [
                                            "Costly to the extreme; beyond budget."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c58f98f-e0a1-41a7-919d-f6adbb370192",
                                                "sense_id": "c8db903b-c211-37ac-bd40-2467630e9c63",
                                                "text": "I'd like to visit Europe someday, but the cost is prohibitive right now."
                                            },
                                            {
                                                "example_id": "323cf71e-d0c9-4e9a-9c5b-e925a1cf93aa",
                                                "sense_id": "c8db903b-c211-37ac-bd40-2467630e9c63",
                                                "text": "The economics of rebuilding all the stations covered by the electrification would be prohibitive, but to help bring home to the Glasgow public that their North Clyde suburban service has been transformed, not merely re-equipped with new trains, stations have at least been associated psychologically with the rolling stock by a common colour scheme."
                                            },
                                            {
                                                "example_id": "1eccab0e-7c57-424f-93be-ac27fcfd8201",
                                                "sense_id": "c8db903b-c211-37ac-bd40-2467630e9c63",
                                                "text": "Hendy has come out as something of an evangelist for discontinuous electrification. For Waterloo-Exeter, this could make real sense on a route where the high capital cost of wiring or third rail all the way to Devon would be prohibitive. But what about his vocal support for it on East West Rail, which is effectively a brand new line?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "671207e6-b730-3bd3-abdf-573d109a9cd9",
                                        "entry_id": "8d53b778-cbc2-38fa-8142-f04a8462539d",
                                        "glosses": [
                                            "Being the presumptive or likely winner of a contest."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8ecf35c-eb06-4acc-b62d-6082acec4758",
                                                "sense_id": "671207e6-b730-3bd3-abdf-573d109a9cd9",
                                                "text": "“I think there’s no question about that. I think he’s the prohibitive favorite if he gets in,” Dennis Lennox, a Michigan-based Republican political consultant, told Politico."
                                            },
                                            {
                                                "example_id": "e9de9204-8940-480c-a24e-2652e1a8a578",
                                                "sense_id": "671207e6-b730-3bd3-abdf-573d109a9cd9",
                                                "text": "[B]ut the math says Joe is our prohibitive nominee, we need to bring the party together[.]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prohibitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5932164-5a84-3878-a51a-9f83bcd7a1b2",
