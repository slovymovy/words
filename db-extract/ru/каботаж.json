                        "source_entry_id": "a69d773b-d484-3726-a723-6f5753fc66d9",
                        "source_sense_description": "судоходство между портами одного государства",
                        "target_lang_word": "cabotage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabotage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef29420b-9276-3741-9805-2f576d25a8c9",
                                        "entry_id": "7411a230-3015-39ac-a80e-332a04c5a9e7",
                                        "glosses": [
                                            "The transport of goods or passengers between two points in the same country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af0538bd-ad4f-49f5-85e2-cf0cbd6e17a0",
                                                "sense_id": "ef29420b-9276-3741-9805-2f576d25a8c9",
                                                "text": "Cabotage traffic may be carried by a foreign carrier on special permission of the civil aeronautics authorities […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a05ecd84-885d-35d7-aa77-78a1cfd07bf3",
                                        "entry_id": "7411a230-3015-39ac-a80e-332a04c5a9e7",
                                        "glosses": [
                                            "The right to engage in such transport."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d0d8af3-732f-4b63-8d15-f884dd2200cb",
                                                "sense_id": "a05ecd84-885d-35d7-aa77-78a1cfd07bf3",
                                                "text": "Cabotage, used as a legal term, here refers to the right to transport goods or passengers between ports of a country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4532884-b835-30e6-8132-27ecab5447ba",
                                        "entry_id": "7411a230-3015-39ac-a80e-332a04c5a9e7",
                                        "glosses": [
                                            "The exclusive right of a country to control such transport."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8530ea6c-5012-462c-aa46-f1c409628f78",
                                                "sense_id": "f4532884-b835-30e6-8132-27ecab5447ba",
                                                "text": "Professor Levine distinguishes two kinds of cabotage: \"primary cabotage\" which can be compared with ninth freedom cabotages and \"long-haul limited cabotage\" which can be compared with eighth freedom cabotage […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
