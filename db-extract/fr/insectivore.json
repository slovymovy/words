                                        "sense_id": "7dd42004-a3dc-3640-830f-621e212533cc",
                                        "entry_id": "6fb0ca14-8616-3276-accb-6c27132bab2e",
                                        "glosses": [
                                            "dazu veranlagt, sich von Käfern, Fliegen und anderen Insekten und insektenähnlichen Tieren (z. B. Spinnen, Würmern) zu ernähren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d20b0694-9e9c-46a2-b192-3b64e7e2c35c",
                                                "sense_id": "7dd42004-a3dc-3640-830f-621e212533cc",
                                                "text": "Der Star ist ein insektenfressender Vogel."
