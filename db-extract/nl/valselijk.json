                                        "entry_id": "034d856e-cc91-386e-9613-25146cefc7d1",
                                        "glosses": [
                                            "In a false manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1c1f23-2096-4444-a485-3c1380a713e5",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "He protested his innocence to the end, claiming he had been falsely charged and convicted."
                                            },
                                            {
                                                "example_id": "65a30b8b-6180-4117-aba8-767ef1b3d580",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "This could not be more falsely stated."
                                            },
                                            {
                                                "example_id": "24cad39d-5f38-414e-a4cc-6980323b3674",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "Our insensitive laughter echoes even more falsely now."
                                            },
                                            {
                                                "example_id": "ea6ec17d-0583-4b71-b56a-0b3cfd29c4de",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "And on none of them does the name ring more falsely than on Robert Southey."
                                            },
                                            {
                                                "example_id": "8a1622e8-80be-45e6-94ad-77757122ccdf",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "President Donald Trump falsely claimed Thursday that some states saw gas prices fall to just $1.98 on Wednesday."
                                            }
