                        "examples": [
                            {
                                "example_id": "f9dd5720-8827-406c-a1d5-6929a15575de",
                                "sense_id": "c9f5c1eb-a965-311c-97f4-88e98b81a593",
                                "text": "I told the boys to stock up with all they could, and went back to the village to recce for someone to pay as per orders."
                            },
                            {
                                "example_id": "0c13ea42-d72e-43f2-a98a-30a2ec74db7c",
                                "sense_id": "c9f5c1eb-a965-311c-97f4-88e98b81a593",
                                "text": "Take him down there with Entry Two and recce first. If he can't confirm it, we pull out."
                            }
                        ]
                    }
