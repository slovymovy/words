                    {
                        "sense_id": "877ba267-b8aa-3fc6-be88-6eec01de5f9a",
                        "entry_id": "ccbabf1b-685a-3968-b40b-2b0cb646d018",
                        "glosses": [
                            "Stelle, an der jemand oder etwas mit einer Handlung (meist Abflug oder sportlicher Wettkampf) beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5825db38-af24-4ae4-b4db-6af1a7dfba59",
                                "sense_id": "877ba267-b8aa-3fc6-be88-6eec01de5f9a",
                                "text": "„Traditionell wurden Astronauten und Astronautinnen in den USA mit einem Astrovan von ihrem Quartier zum Startplatz der Rakete gefahren, quasi einem Wohnmobil mit Nasa-Logo, das man sich auch in einem Trailerpark mitten in Texas gut vorstellen könnte.“"
                            },
                            {
                                "example_id": "96a46344-037f-4953-9d8c-1879e88b2603",
                                "sense_id": "877ba267-b8aa-3fc6-be88-6eec01de5f9a",
                                "text": "„2500 Athleten werden auf der 3,8 Kilometer langen Schwimmstrecke, dem 180 Kilometer langen Radweg und bei einem anschließenden Marathon versuchen, einen Startplatz für die Weltmeisterschaft auf Hawaii zu ergattern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
