                            "verhüllend"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "651a10f8-d93a-37c2-a3f0-55b175fe4a5a",
                        "entry_id": "e12c5e39-0614-3ec7-ae77-aa6d4c826ada",
                        "glosses": [
                            "Vertiefung bei einem Vulkan, aus der Magma austritt oder ausgetreten ist"
                        ],
                        "tags": [
                            "veraltet, übertragen"
                        ],
                        "examples": [
                            {
                                "example_id": "e0b71e02-0c88-4978-8944-de05c353f347",
                                "sense_id": "651a10f8-d93a-37c2-a3f0-55b175fe4a5a",
                                "text": "Dort, wo das Rauchloch unverstopft war, gelangten Rauch und Flammen nach draußen."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "2c3ab32a-70df-33b0-b87d-812b107fecdc",
                        "entry_id": "e12c5e39-0614-3ec7-ae77-aa6d4c826ada",
                        "glosses": [
                            "Ort/Raum, der voll Rauch ist"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "6f5a1baa-d63a-4bad-ba49-d0a4ea6b35af",
                                "sense_id": "2c3ab32a-70df-33b0-b87d-812b107fecdc",
                                "text": "„Was hab' ich mit Euch zu schaffen? brummte der Maler. Hätt' ich gewußt, daß Ihr in diesem Rauchloche spukt - nicht zehn Pferde hätten mich herein gezogen, Carluccio.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
