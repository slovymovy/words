                        "source_sense_description": "a strain of bacteria that is resistant to many antibiotics",
                        "target_lang_word": "superbactérie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superbactérie",
