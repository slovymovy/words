                "senses": [
                    {
                        "sense_id": "0407b85c-8a6a-3113-a3cc-1c2c29b3983a",
                        "entry_id": "d793f388-fd27-393a-bbef-43027e60c2aa",
                        "glosses": [
                            "meist bei Krisen eingesetzte Regierung, die nur provisorisch und vorläufig im Amt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b2b9fa4-c0cc-45a5-b74d-5ddd38af1082",
                                "sense_id": "0407b85c-8a6a-3113-a3cc-1c2c29b3983a",
                                "text": "„Hunderttausende Islamisten haben am Freitag in Ägypten gegen die vorgeschlagenen Verfassungsleitlinien der Übergangsregierung protestiert.“"
                            },
                            {
                                "example_id": "18a44ce9-5135-48be-810f-c8e922098203",
                                "sense_id": "0407b85c-8a6a-3113-a3cc-1c2c29b3983a",
                                "text": "„Im März 1978 wurden eine Übergangsregierung eingesetzt und allgemeine Wahlen ausgeschrieben, bei denen die schwarze Bevölkerung erstmals das Wahlrecht erhielt, aber den Weißen auf einer separaten Wählerliste 28 Sitze im hundertköpfigen Parlament garantiert wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
