                        },
                        {
                            "text": "– Myślisz, że się tego boję? – <w>Wcale</w>!",
                            "target_lang_translations": {
                                "ru": "— Думаешь, я этого боюсь? — <w>Вовсе нет</w>!",
                                "en": "– Do you think I'm afraid of that? – <w>Not at all</w>!",
                                "nl": "– Denk je dat ik daar bang voor ben? – <w>Helemaal niet</w>!",
                                "de": "– Glaubst du, ich habe Angst davor? – <w>Keineswegs</w>!",
                                "fr": "– Tu penses que j'ai peur de ça ? – <w>Absolument pas</w> !",
                                "it": "– Pensi che io ne abbia paura? – <w>Per niente</w>!",
                                "cs": "– Myslíš, že se toho bojím? – <w>Vůbec</w>!",
                                "tr": "– Bundan korktuğumu mu sanıyorsun? – <w>Hiç de</w> değil!",
                                "es": "– ¿Crees que tengo miedo de eso? – ¡<w>Para nada</w>!",
                                "zh": "——你以为我怕这个吗？——<w>才不是</w>！"
