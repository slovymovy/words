                "senses": [
                    {
                        "sense_id": "55a7deaa-114e-3a58-809f-780f28010c23",
                        "entry_id": "803aee1b-6e4c-3275-a975-2833ead5f591",
                        "glosses": [
                            "Filled or overcome with awe or wonder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b107d07d-9d71-4926-9402-845093ca36ce",
                                "sense_id": "55a7deaa-114e-3a58-809f-780f28010c23",
                                "text": "Like so many others, I was awestruck by the first season, which captured a moment in time and successfully funnelled its rage outwards at a world in which women are indeed silenced, controlled and killed by men."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a87cea8-618f-4c5c-87d7-38992c0923ba",
                        "source_entry_id": "803aee1b-6e4c-3275-a975-2833ead5f591",
                        "source_sense_id": "55a7deaa-114e-3a58-809f-780f28010c23",
                        "source_sense_description": "filled or overcome with awe",
                        "target_lang_word": "ehrfürchtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ehrfürchtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca9248a6-ad54-3428-84c5-9a25bfd5c9ce",
                                        "entry_id": "c637db50-c2a7-37c5-9649-cb2c646f8830",
                                        "glosses": [
                                            "aufgrund der hohen Achtung von Würde, Erhabenheit oder Wert zurückhaltend, ängstlich oder schüchtern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d054584-f418-425e-a057-99d3292dd08d",
                                                "sense_id": "ca9248a6-ad54-3428-84c5-9a25bfd5c9ce",
                                                "text": "„Der Kirchenraum verlangt ehrfürchtiges Verhalten, so empfinden wir. Wir ärgern uns, wenn Touristen darin lachen und lärmen wie auf dem Markt.“"
                                            },
                                            {
                                                "example_id": "7ffbee83-8c5e-4c01-adea-c0d210ee4d02",
                                                "sense_id": "ca9248a6-ad54-3428-84c5-9a25bfd5c9ce",
                                                "text": "„Natürlich war dieser ehrfürchtige Ausspruch zunächst eine Respektbekundung vor dem musikalischen Talent der Britin.“"
                                            },
                                            {
                                                "example_id": "f9cd4b72-15dc-40a1-a1d2-0474b043cc1d",
                                                "sense_id": "ca9248a6-ad54-3428-84c5-9a25bfd5c9ce",
                                                "text": "„Unser konkretes Engagement für die Bewahrung der Schöpfung und ein ehrfürchtiger Umgang mit den Geschöpfen sind Ausdruck dieser Spiritualität.“"
                                            },
                                            {
                                                "example_id": "ff4a58d3-38ed-43e8-8883-eeb1a8221435",
                                                "sense_id": "ca9248a6-ad54-3428-84c5-9a25bfd5c9ce",
                                                "text": "„Jeder religiöse Mensch sei ein ehrfürchtiger Mensch. Doch ist die ehrfurchtsvolle Haltung nicht bei allen religiösen Menschen gleich stark ausgeprägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "305bcbdd-0654-433c-a04f-cc4f5e9ea909",
                        "source_entry_id": "803aee1b-6e4c-3275-a975-2833ead5f591",
