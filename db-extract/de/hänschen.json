                "senses": [
                    {
                        "sense_id": "2037507a-3aa4-3129-9f74-cda5ccbf79d3",
                        "entry_id": "f042d2ef-cf0d-30ab-9846-1109f33ddf59",
                        "glosses": [
                            "deutscher Vorname"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "e3338744-9362-46f2-bdf9-796285d08960",
                                "sense_id": "2037507a-3aa4-3129-9f74-cda5ccbf79d3",
                                "text": "Hänschen rief: „Sie haben vergessen, dass das Volk nicht nur aus Erwachsenen, sondern auch aus Kindern besteht.“"
                            },
                            {
                                "example_id": "e8809b7f-256b-4c6c-961f-16b3196a7bd1",
                                "sense_id": "2037507a-3aa4-3129-9f74-cda5ccbf79d3",
                                "text": "Schließlich wird nur aus dem lesenden Hänschen ein lesender Hans."
                            },
                            {
                                "example_id": "d91a0871-efe7-4206-b09e-ee7c60128584",
                                "sense_id": "2037507a-3aa4-3129-9f74-cda5ccbf79d3",
                                "text": "Nicht jede alte Redensart gilt auch heute noch: Denn was Hänschen nicht gelernt hat, kann Hans sehr wohl noch lernen."
                            },
                            {
                                "example_id": "6750d66e-78cb-493c-8292-bf3498e18ca3",
                                "sense_id": "2037507a-3aa4-3129-9f74-cda5ccbf79d3",
                                "text": "Hänschen sah betroffen in das plötzlich umwölkte Gesicht des Alten und verschwand mit seiner Schultasche unter dem Eingang."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "203514a5-0965-4e64-9cd8-b92fb466a47a",
                        "source_entry_id": "f042d2ef-cf0d-30ab-9846-1109f33ddf59",
