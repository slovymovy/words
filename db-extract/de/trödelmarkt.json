                "senses": [
                    {
                        "sense_id": "f3718844-68d3-302e-8536-fe61b40a6163",
                        "entry_id": "4e5600be-5027-3bde-82fe-dd6f2304f117",
                        "glosses": [
                            "Markt, auf dem meist alte, gebrauchte Waren von geringem Wert zum Verkauf angeboten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef1100e2-21ca-4bff-8cf3-4af4ea1d7ec4",
                                "sense_id": "f3718844-68d3-302e-8536-fe61b40a6163",
                                "text": "Sie erstanden auf dem Trödelmarkt viele alte Schallplatten."
                            },
                            {
                                "example_id": "b9a4dd24-8133-4d42-8b83-088656373e39",
                                "sense_id": "f3718844-68d3-302e-8536-fe61b40a6163",
                                "text": "„Sie sprechen zu diesem Zweck nicht nur private Kunstsammler an, die hier neuerdings in großer Zahl vorhanden sind, sondern gehen auch auf Trödelmärkte, wo Tafelbilder zu Spottpreisen verramscht werden.“"
                            },
                            {
                                "example_id": "66cde06d-2653-43aa-99cc-d758e8180bda",
                                "sense_id": "f3718844-68d3-302e-8536-fe61b40a6163",
                                "text": "„Als Pierre in seinem Kutscherkaftan, den Gerassim ihm besorgt und ausgekocht hatte, mit dem alten Diener zusammen zum Trödelmarkt am Sucharew-Turm gegangen war, um sich dort eine Pistole zu kaufen, war er den Rostows begegnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd495f60-9ea0-451e-ad4a-1fb5a0db19d6",
                        "source_entry_id": "4e5600be-5027-3bde-82fe-dd6f2304f117",
                        "source_sense_id": "f3718844-68d3-302e-8536-fe61b40a6163",
                        "source_sense_description": "Markt, auf dem meist alte, gebrauchte Waren von geringem Wert zum Verkauf angeboten werden",
                        "target_lang_word": "flea market",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flea market",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28ad17ff-2d4b-3e70-be98-9e84c6111600",
                                        "entry_id": "e65eb451-5fea-30c8-af9f-2ff736917637",
                                        "glosses": [
                                            "An outdoor temporary market selling inexpensive antiques, curios, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45f6e52e-1f1c-42ff-8082-986c973a1af1",
                                                "sense_id": "28ad17ff-2d4b-3e70-be98-9e84c6111600",
                                                "text": "Although things are sold cheaper at the flea market, it's always a good idea to check whether the item is stolen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6320489f-4125-3907-92b1-6815ffd07140",
                                        "entry_id": "e65eb451-5fea-30c8-af9f-2ff736917637",
                                        "glosses": [
                                            "A permanent indoor market of stalls in a warehouse selling inexpensive antiques, outdated goods, curios, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faa7dcec-e117-4e70-b403-6932426f8fa4",
                                                "sense_id": "6320489f-4125-3907-92b1-6815ffd07140",
                                                "text": "The Towne Hall is a big inflatable building in the middle of the Snooze ’n’ Crusie. It is Derelict Las Vegas: convenience store, video arcade, laundromat, bar, liquor store, flea market, whorehouse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20a94ee9-ebe9-430e-bab8-d81d6c199c44",
                        "source_entry_id": "4e5600be-5027-3bde-82fe-dd6f2304f117",
                        "source_sense_id": "f3718844-68d3-302e-8536-fe61b40a6163",
                        "source_sense_description": "Markt, auf dem meist alte, gebrauchte Waren von geringem Wert zum Verkauf angeboten werden",
                        "target_lang_word": "marché aux puces",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marché aux puces",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47bb45d6-7cf9-3edc-852d-b784bc34e3c0",
                                        "entry_id": "28ab28bb-43fe-3d81-b2cf-f4685575d368",
                                        "glosses": [
                                            "Marché où se vendent des objets d’occasion, souvent de faible valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36cee2f5-6c26-4b53-9dc3-9111d43f6e18",
                                                "sense_id": "47bb45d6-7cf9-3edc-852d-b784bc34e3c0",
                                                "text": "L’ensemble de l’étalage rappelle les exhibitions de ce marché de brocanteurs dénommé « le Marché aux puces »."
                                            },
                                            {
                                                "example_id": "3dc20a3e-dbc6-4117-ba97-6e5cb62890ab",
                                                "sense_id": "47bb45d6-7cf9-3edc-852d-b784bc34e3c0",
                                                "text": "Les flâneries du photographe au marché aux puces, avec des prises de vue échelonnées sur six ans, n'ont pas le même degré d'étrangeté : le marché aux puces est, dans l'entre-deux-guerres, un motif littéraire et plastique fréquent."
                                            },
                                            {
                                                "example_id": "fe9c3e90-7b89-4753-bb26-53432338491c",
                                                "sense_id": "47bb45d6-7cf9-3edc-852d-b784bc34e3c0",
                                                "text": "Mais Minouche tirait déjà un casier puis deux d’un vieux meuble de musée qu’elle avait découvert au marché aux puces et qu’elle avait, elle-même, gratté et reverni."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a93ea1a1-8c01-42ff-a4c8-027b47e71611",
                        "source_entry_id": "4e5600be-5027-3bde-82fe-dd6f2304f117",
                        "source_sense_id": "f3718844-68d3-302e-8536-fe61b40a6163",
                        "source_sense_description": "Markt, auf dem meist alte, gebrauchte Waren von geringem Wert zum Verkauf angeboten werden",
                        "target_lang_word": "brocante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brocante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb6fbdb2-771d-3d83-86e8-1d1289300e6b",
                                        "entry_id": "73b5c8f6-e5cc-387b-86fa-ede94f223021",
                                        "glosses": [
                                            "Revente, vente occasionnelle de marchandises de peu de valeur, trouvées çà et là."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a459f87d-4504-4b81-aa4e-a613719b980b",
                                                "sense_id": "bb6fbdb2-771d-3d83-86e8-1d1289300e6b",
                                                "text": "Ma collection, je l'ai bâtie au fil des années, des semaines et plus particulièrement des week-ends. Enfin, surtout des dimanches matin. Chaque semaine, de mars à octobre, nos villages de France organisent une multitude de vide-greniers, bric-à-brac, brocantes et autres foires à tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f8af1bf-954b-308e-a492-eca8efb9b737",
                                        "entry_id": "73b5c8f6-e5cc-387b-86fa-ede94f223021",
                                        "glosses": [
                                            "Petit marché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b67d97b-b0bf-459a-a1f1-ba6828db598f",
                                                "sense_id": "9f8af1bf-954b-308e-a492-eca8efb9b737",
                                                "text": "Je n'ai eu, je n'ai fait, dira un marchand, que deux ou trois petites brocantes aujourd'hui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f893b007-b07d-3c13-949f-40b676cac77a",
                                        "entry_id": "73b5c8f6-e5cc-387b-86fa-ede94f223021",
                                        "glosses": [
                                            "Boutique où l’on trouve pêle-mêle des objets usagés ou cassés, mis au rebut, ou dont le propriétaire s’est défait pour se faire quelques sous. Activité, passion de celui qui brocante, qui chine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fce6953a-6314-4c7d-8ed3-b819608b8c79",
                                                "sense_id": "f893b007-b07d-3c13-949f-40b676cac77a",
                                                "text": "Pour les meilleurs d’entre nous, l’étude des arts, le goût de la brocante, les collections, les jardins, ne sont que des ersatz, des succédanés, des alibis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53cda03c-9390-3246-af85-ad9c487712e5",
                                        "entry_id": "73b5c8f6-e5cc-387b-86fa-ede94f223021",
                                        "glosses": [
                                            "Marchandise neuve, rutilante de nouveauté, de peu de valeur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "317c2258-e8d5-46cf-b31e-b142e494dcbc",
                                                "sense_id": "53cda03c-9390-3246-af85-ad9c487712e5",
                                                "text": "Déverser sa brocante, sa quincaillerie, ses productions cinématographiques sur le tiers-monde et l’Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e3ac105-1b45-3672-b19a-3b4b04de5fdd",
                                        "entry_id": "73b5c8f6-e5cc-387b-86fa-ede94f223021",
