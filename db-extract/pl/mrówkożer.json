                                        "glosses": [
                                            "Petit marsupial endémique d’Australie occidentale se nourrissant presque exclusivement de termites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a88c3316-5667-457b-99e2-671f4f9bf7ec",
                                                "sense_id": "f3888e58-4d26-3fb4-812e-c550bf42f3bf",
                                                "text": "Les termites étant actifs de jour, le numbat est le seul marsupial australien totalement diurne."
                                            },
