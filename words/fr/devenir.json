                    ]
                },
                {
                    "sense_id": "ff2d6109-5276-321b-aa17-349619c407a2",
                    "sense_definition": "Processus continu ou mouvement par lequel un être ou une réalité se transforme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur prometteur est considéré comme un grand écrivain en <w>devenir</w> par la critique."
                        },
                        {
                            "text": "Certains philosophes décrivent l'univers comme un perpétuel <w>devenir</w> où rien ne reste immobile."
                        }
                    ],
                    "common_phrases": [
                        "en devenir",
                        "perpétuel devenir"
                    ]
                }
            ]
        }
    ]
