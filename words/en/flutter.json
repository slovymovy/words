                            {
                                "target_lang_word": "třepotat se",
                                "target_lang_sense_clarification": "rychlé pohyby křídel"
                            },
                            {
                                "target_lang_word": "poletovat",
                                "target_lang_sense_clarification": "létat sem a tam lehkým způsobem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92265dbf-1c73-3d7c-b926-35e4b52c390c",
                    "sense_definition": "To cause something to flap or move quickly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird <w>flutters</w> its wings to dry them after the rain.",
                            "target_lang_translations": {
                                "cs": "Pták <w>třepotá</w> křídly, aby si je po dešti osušil."
                            }
                        },
                        {
                            "text": "She <w>fluttered</w> her fan to cool herself down in the heat.",
                            "target_lang_translations": {
                                "cs": "V horku si <w>ovívala</w> tvář vějířem, aby se ochladila."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, že se něco třepotá nebo rychle pohybuje."
                    },
                    "translations": {
