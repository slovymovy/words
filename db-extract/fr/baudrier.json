        "fr-extract.jsonl": [
            {
                "entry_id": "f965078b-a7e0-3b06-bfee-cc4978971a2d",
                "word": "Baudrier",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a5cd9f62-b2f7-3d2f-ab96-95bf2769f0ab",
                        "entry_id": "f965078b-a7e0-3b06-bfee-cc4978971a2d",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2111d4d-97d9-4de2-948c-b615276bbd52",
                                "sense_id": "a5cd9f62-b2f7-3d2f-ab96-95bf2769f0ab",
                                "text": "L’adjoint à la construction et élu communiste, Jacques Baudrier, a suivi tout le programme et peste contre « des bobos qui considèrent que c’est bien de laisser des pauvres dix ans de plus dans leur merde pour se faire plaisir intellectuellement »."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6d9601be-80b4-33e8-918e-5149f6769416",
                "word": "baudrier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d17da19f-aa30-426f-a2d4-52275dffb1f6",
                        "entry_id": "6d9601be-80b4-33e8-918e-5149f6769416",
                        "tags": [
                            "plural"
                        ],
                        "form": "baudriers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bbfbb57f-e221-3c33-b05f-ad727968cc81",
                        "entry_id": "6d9601be-80b4-33e8-918e-5149f6769416",
                        "glosses": [
                            "Bande de buffle, de cuir ou d’étoffe qui se porte en écharpe et qui sert à soutenir le sabre ou l’épée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc77bbab-a246-47df-8b4a-777c97f36224",
                                "sense_id": "bbfbb57f-e221-3c33-b05f-ad727968cc81",
                                "text": "Ils étaient armés de sabres recourbés ayant la poignée et le baudrier incrustés d’or."
                            },
                            {
                                "example_id": "37e91d8c-c023-419c-89f3-ad8dc7009468",
                                "sense_id": "bbfbb57f-e221-3c33-b05f-ad727968cc81",
                                "text": "Lorenzo. – Je roule votre baudrier autour de votre épée, et je la mets sous votre chevet. Il est bon d’avoir toujours une arme sous la main.\nIl entortille le baudrier de manière à empêcher l’épée de sortir du fourreau."
                            },
                            {
                                "example_id": "acb2a992-72fa-4ffb-a7e9-85f8bce012ae",
                                "sense_id": "bbfbb57f-e221-3c33-b05f-ad727968cc81",
                                "text": "L'un d'eux, surtout, portant des leggings, un casque, des lunettes, baudrier de cuir et toutes ses décorations..."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e137422-b7ef-36f3-944f-25116d160809",
                        "entry_id": "6d9601be-80b4-33e8-918e-5149f6769416",
                        "glosses": [
                            "Équipement permettant de s’attacher ; harnais de sécurité."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "27be6681-5407-46e0-9d48-c8d22e245118",
                                "sense_id": "8e137422-b7ef-36f3-944f-25116d160809",
                                "text": "À partir des années quatre-vingts, le baudrier s’ergonomise, notamment autour des cuisses. Dès lors, ce sont des boucles de sangles de plus en plus confortables qui enserrent les jambes."
                            }
                        ]
                    },
                    {
                        "sense_id": "5094b204-4056-3985-9862-19d2b17b4e8b",
                        "entry_id": "6d9601be-80b4-33e8-918e-5149f6769416",
                        "glosses": [
                            "Cuir de vache pour les escarpins."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34ba67c6-d3ae-4192-91e5-83cae381ff1b",
                        "source_entry_id": "6d9601be-80b4-33e8-918e-5149f6769416",
                        "source_sense_id": "bbfbb57f-e221-3c33-b05f-ad727968cc81",
                        "source_sense_description": "Bande en écharpe",
                        "target_lang_word": "Wehrgehänge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b4aa235a-fcb3-41fc-9617-aa4f8f64b727",
                        "source_entry_id": "6d9601be-80b4-33e8-918e-5149f6769416",
                        "source_sense_id": "bbfbb57f-e221-3c33-b05f-ad727968cc81",
                        "source_sense_description": "Bande en écharpe",
                        "target_lang_word": "baldrick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baldrick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2060b010-4f8f-3a1f-8116-56ead9567375",
                                        "entry_id": "049925c6-71b8-382e-9887-d121347149d0",
                                        "glosses": [
                                            "Alternative form of baldric."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dc6f53c-1d85-45b4-a8b5-a87c7259568e",
                                                "sense_id": "2060b010-4f8f-3a1f-8116-56ead9567375",
                                                "text": "And the bright green belt on his body he bore, oblique, like a baldrick, bound at his side below his left shoulder, laced in a knot..."
                                            },
                                            {
                                                "example_id": "0d7a4492-7584-4180-a52d-6e9a6a884aca",
                                                "sense_id": "2060b010-4f8f-3a1f-8116-56ead9567375",
                                                "text": "That a woman conceiv'd me, I thank her; that she brought me up, I likewise give her most humble thanks; but that I will have a rechate winded in my forehead, or hang my bugle in an invisible baldrick, all women shall pardon me."
                                            },
                                            {
                                                "example_id": "bf1bbf6e-5a43-4fd2-a793-0c362a57e4c1",
                                                "sense_id": "2060b010-4f8f-3a1f-8116-56ead9567375",
                                                "text": "And from his blazoned baldrick slung, a mighty silver bugle hung..."
                                            },
                                            {
                                                "example_id": "24bb6a93-07cb-420e-8d96-9c7390860f75",
                                                "sense_id": "2060b010-4f8f-3a1f-8116-56ead9567375",
                                                "text": "The sword was carried in a belt of buff or other leather girded round the body, or thrown over the right shoulder, these shoulder belts were called baudricks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
