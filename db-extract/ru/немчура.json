                "senses": [
                    {
                        "sense_id": "30f4a746-74a9-38c2-b5bb-476e749f287f",
                        "entry_id": "5c5f6edb-443b-3ed1-b884-4d6a8491c0b6",
                        "glosses": [
                            "собир., пренебр. немцы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8f70a6f-3ad8-462b-a7ea-27b3c25ce33a",
                                "sense_id": "30f4a746-74a9-38c2-b5bb-476e749f287f",
                                "text": "Это ведь французишки с англичанами и немчурой довольствуются жалкими тринадцатью процентами, а наш без ста-двухсотпроцентной накрутки и с дивана не слезет!"
                            }
                        ]
                    },
                    {
                        "sense_id": "d4841941-3195-3333-8460-9985fc80d37d",
                        "entry_id": "5c5f6edb-443b-3ed1-b884-4d6a8491c0b6",
                        "glosses": [
                            "пренебр. немец, немка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90cbc9ae-cb00-40b5-9c30-3737927ba44f",
                                "sense_id": "d4841941-3195-3333-8460-9985fc80d37d",
                                "text": "― А?! Вот немчура! ― захохотала Анна, показывая пальцем своего немца, опять самодовольно выключившегося из разговора."
                            }
                        ]
                    }
                ],
