                                "target_lang_sense_clarification": "ботанический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe76bfbf-d7f0-3c7f-a00a-279c52adb2f6",
                    "sense_definition": "Een specifieke plantensoort met witte bloemen die grote, platte zaden produceert.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "planten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer oogst de <w>boon</w> voordat de peulen te hard worden.",
                            "target_lang_translations": {
                                "en": "The farmer harvests the <w>broad bean</w> before the pods become too hard.",
                                "ru": "Фермер собирает <w>бобы</w>, пока стручки не стали слишком твердыми."
                            }
                        },
                        {
                            "text": "Deze specifieke <w>tuinboon</w> staat bekend om zijn grote zaden.",
                            "target_lang_translations": {
