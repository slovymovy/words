                                        "entry_id": "11cdae91-090e-34e2-911e-e7d76edeb007",
                                        "glosses": [
                                            "Bewohner der historischen Region Mähren in der heutigen Tschechischen Republik"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "179be318-bb5b-4a5f-8a23-e82471cbf21d",
                                                "sense_id": "61565925-83d4-3878-8c25-9ebc862459a9",
                                                "text": "Viele von Michaelas Verwandten waren Mährer."
                                            },
                                            {
                                                "example_id": "588df89b-c9f3-4f3d-a897-6a265648d8e7",
                                                "sense_id": "61565925-83d4-3878-8c25-9ebc862459a9",
                                                "text": "Der Mährer hat den Hut verloren und die Mährin hat's gemerkt."
                                            },
                                            {
                                                "example_id": "7288110f-0ebf-488c-bdaf-31c2cf767cfd",
                                                "sense_id": "61565925-83d4-3878-8c25-9ebc862459a9",
                                                "text": "„Dies bewiesen 1905 die Mährer mit ihrem »mährischen Ausgleich«, der in der nationalistischen Historiographie kaum erwähnt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f738071b-b752-343c-9d2d-ad67aeb1a55d",
                                        "entry_id": "11cdae91-090e-34e2-911e-e7d76edeb007",
                                        "glosses": [
                                            "Angehöriger eines gleichnamigen westslawischen Volksstammes"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b28290e-2eb5-4cec-9859-3e05295385ba",
                                                "sense_id": "f738071b-b752-343c-9d2d-ad67aeb1a55d",
                                                "text": "„Die Mährer werden erstmals 822 in einer fränkischen Quelle erwähnt, als sie auf einer Reichsversammlung in Frankfurt am Main erscheinen und Geschenke überbringen, gewiß als Zeichen einer lockeren Abhängigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
