                "senses": [
                    {
                        "sense_id": "838c7a36-9619-3fe7-972e-114fac21e7ab",
                        "entry_id": "e7c0cbdd-d451-34f6-9dc9-d90dfa5a59aa",
                        "glosses": [
                            "The fear of itching or of small crawling insects that cause itching, such as mites or lice."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bb2bca69-3368-49ba-8461-addf0b8347cb",
                                "sense_id": "838c7a36-9619-3fe7-972e-114fac21e7ab",
                                "text": "His acarophobia was obvious from his reaction when I told him he had lice."
                            },
                            {
                                "example_id": "3748fc9c-8df3-46f0-81f4-0e6d3ebb0b91",
                                "sense_id": "838c7a36-9619-3fe7-972e-114fac21e7ab",
                                "text": "The term delusions of parasitosis was coined by Wilson and Miller (1946) dispelling earlier use of the word acarophobia (Thibierge 1894), entomophobia, and parasitophobia."
                            }
                        ]
                    }
                ],
