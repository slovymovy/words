                                                "sense_id": "efd84a8e-0537-3213-bf65-fda3d49e2997",
                                                "text": "„Natürlich könnte ein zehnjähriger zermürbender Krieg gegen Troja als Erklärung des Endes der Mykener herangezogen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
