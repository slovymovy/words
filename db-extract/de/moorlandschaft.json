                "senses": [
                    {
                        "sense_id": "96351eff-cd4c-3295-869c-543db44c6e20",
                        "entry_id": "c4e3e5c4-e79f-3672-9109-b08644d9843b",
                        "glosses": [
                            "Landschaft, die von einem Moor/von Mooren geprägt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b243ae63-f63f-4b4c-bcdf-e77a7dc560cf",
                                "sense_id": "96351eff-cd4c-3295-869c-543db44c6e20",
                                "text": "„Nach kaum einer halben Stunde sind wir dort, eine niedersächsische Siedlung in flacher Moorlandschaft, Einzugsgebiet des VW-Werks.“"
                            },
                            {
                                "example_id": "c89866f4-64c8-4752-a989-f05df71cf6ee",
                                "sense_id": "96351eff-cd4c-3295-869c-543db44c6e20",
                                "text": "„Meine Schwester Joan reagierte auf diese seltsame Gegend im Südwesten Englands nicht auf die gleiche Weise wie ich: Die gewaltigen Menhire und Megalithformationen, die thronend aus den Moorlandschaften aufragten, schienen vage Erinnerungen an meine Herkunft zurückzubringen und meine keltische Fantasie anzuregen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
