                ],
                "senses": [
                    {
                        "sense_id": "4e805729-e9d9-332e-9a88-3a80973284a0",
                        "entry_id": "29fa26f6-5ca7-3489-9194-4a1e45a7d94d",
                        "glosses": [
                            "Stammesbewusstsein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf97530-1f58-4a1c-89c1-aff1553d2ef2",
                                "sense_id": "4e805729-e9d9-332e-9a88-3a80973284a0",
                                "text": "In unserem Land, das angeblich Zweitausend Jahre alt ist, herrscht immer noch der dumpfe Tribalismus, der dumpfe Glaube an die alte Stammeszugehörigkeit."
                            },
                            {
                                "example_id": "d2b68e81-6d5d-4d68-96cb-59a4d6e7fbd8",
                                "sense_id": "4e805729-e9d9-332e-9a88-3a80973284a0",
                                "text": "„Nur durch den Tribalismus war es ihnen gelungen, Afrika zu kolonialisieren.“"
                            },
                            {
                                "example_id": "7986615b-b49c-4941-9991-6ffc09d5595d",
                                "sense_id": "4e805729-e9d9-332e-9a88-3a80973284a0",
                                "text": "„Zuletzt das ewig gleiche Problem, die ewig gleiche afrikanische Krankheit: Tribalismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cf10e2d3-dd3d-3834-ad3d-1d75a065cb8f",
                        "entry_id": "29fa26f6-5ca7-3489-9194-4a1e45a7d94d",
                        "glosses": [
                            "Glaube an die Stammeszugehörigkeit"
