                                        "entry_id": "06053054-4bdd-3dcb-815b-dd66e52822e1",
                                        "glosses": [
                                            "An Italian-American soup consisting of green vegetables and meat in a chicken-based broth."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3977373-6e46-4167-aaf2-c936363e4275",
                                                "sense_id": "f4a856bc-44ff-300f-813d-dc7cc8f89e93",
                                                "text": "You have probably heard of wedding soup, an Italian-American favorite that gets its name not because it is served at weddings, but because it is a marriage of meat (in the form of tiny meatballs) and vegetables […]"
                                            },
                                            {
                                                "example_id": "42121de4-4b43-4ab6-b25a-4bcce89404e9",
                                                "sense_id": "f4a856bc-44ff-300f-813d-dc7cc8f89e93",
                                                "text": "This was his second helping and he'd already eaten three slices of bread, a salad, and a cup of wedding soup."
                                            },
                                            {
                                                "example_id": "c89d2741-527b-499d-bfc8-7f58345e86c0",
                                                "sense_id": "f4a856bc-44ff-300f-813d-dc7cc8f89e93",
                                                "text": "[The] shopper creates a version of wedding soup and incorporates beans into the mix to allow for extra protein."
                                            }
                                        ]
