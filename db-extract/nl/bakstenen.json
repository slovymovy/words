                                                "sense_id": "0af70de4-6cfe-3097-bb7d-25bb20169d5e",
                                                "text": "I was on deck watching the firing, and looking at the direction in which our guns were pointing, it was obvious that it was not going to be Centurion who was going to receive our bricks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39e046e7-8a26-35d0-81ab-29f01ce6ed68",
                                        "entry_id": "c94adb48-94c5-35fe-9797-17adfc2543d8",
                                        "glosses": [
                                            "A carton of 500 rimfire cartridges, which forms the approximate size and shape of a brick."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
