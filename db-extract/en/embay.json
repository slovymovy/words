                        "entry_id": "3d850d86-ad36-3987-a1df-21f48be567c7",
                        "glosses": [
                            "To bathe; to steep."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "93b72acb-4588-48e1-bdc3-2d19319cabbe",
                                "sense_id": "655e0aa6-027b-3c68-944b-bf74490f6d71",
                                "text": "Sweete Loue, that doth his golding wings embay / In bleſſed Nectar, and pure Pleaſures well[…]."
                            },
                            {
                                "example_id": "a95b5324-7cf6-48bc-ad68-5e705f48fad9",
                                "sense_id": "655e0aa6-027b-3c68-944b-bf74490f6d71",
                                "text": "Their ſwords both points and edges ſharpe embay / In purple bloud, where ſo they hit or light[…]"
                            }
                        ]
                    }
                ],
