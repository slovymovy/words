                                            {
                                                "example_id": "ab6b4d43-b6cf-49bb-a332-740d45354c44",
                                                "sense_id": "a1f0636e-e6da-3a76-85bf-aa8b7c28801b",
                                                "text": "„Bleibend, Geschlechter und Geschlechter überdauernd, war nur Attila, der Zuchtganter, ein schwerer Gänserich von einundzwanzig Pfund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
