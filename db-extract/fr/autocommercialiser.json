                ],
                "senses": [
                    {
                        "sense_id": "2f5b4678-36d8-3248-9265-e4bb6a30f16f",
                        "entry_id": "88df044b-35d8-3f4e-aa92-7848d21e9ec6",
                        "glosses": [
                            "Commercialiser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffda897b-e38b-4e9b-a816-52ff34e403d7",
                                "sense_id": "2f5b4678-36d8-3248-9265-e4bb6a30f16f",
                                "text": "Le travail à façon pour le groupe Frobenius, ou plus exactement Frobenius-Herwagen, et la besogne autocommercialisée par Thomas persistent l’un et l’autre."
                            },
                            {
                                "example_id": "e13269fa-010a-47ff-baef-0a16c25ab9c4",
                                "sense_id": "2f5b4678-36d8-3248-9265-e4bb6a30f16f",
                                "text": "Le producteur doit déclarer la quantité de kilogrammes à autocommercialiser, sur le formulaire réglementaire 501, 22 semaines avant la période d’allocation de récoltes."
                            },
                            {
                                "example_id": "3cdd7274-2811-44ec-a960-58da2db9d99e",
                                "sense_id": "2f5b4678-36d8-3248-9265-e4bb6a30f16f",
                                "text": "Cela leur a permis d'atteindre par la suite des sommets inespérés, tout simplement en les aidant à \"s’autocommercialiser\"."
                            }
                        ]
                    }
                ],
