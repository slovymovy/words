{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e8ffe924-c204-357f-b89f-04041418ad82",
                    "sense_definition": "A serious bacterial disease that spreads quickly and kills a large number of people; an epidemic.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historians estimate that the <w>plague</w> killed a third of the population in Europe.",
                            "target_lang_translations": {
                                "ru": "Историки подсчитали, что <w>чума</w> убила треть населения Европы.",
                                "zh": "历史学家估计，那场<w>瘟疫</w>夺走了欧洲三分之一人口的生命。"
                            }
                        },
                        {
                            "text": "Doctors worked tirelessly to stop the spread of the <w>plague</w> in the remote village.",
                            "target_lang_translations": {
                                "ru": "Врачи без устали работали, чтобы остановить распространение <w>чумы</w> в отдалённой деревне.",
                                "zh": "医生们不知疲倦地工作，以阻止<w>瘟疫</w>在那个偏远村庄蔓延。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pestilence"
                    ],
                    "common_phrases": [
                        "bubonic plague",
                        "avoid like the plague",
                        "outbreak of plague"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжёлое бактериальное заболевание, которое быстро распространяется и приводит к гибели множества людей; эпидемия.",
                        "zh": "一种传播迅速并导致大量人口死亡的严重细菌性疾病；瘟疫。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чума",
                                "target_lang_sense_clarification": "болезнь"
                            },
                            {
                                "target_lang_word": "мор",
                                "target_lang_sense_clarification": "устар. эпидемия, повальная болезнь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瘟疫",
                                "target_lang_sense_clarification": "指大规模传染病"
                            },
                            {
                                "target_lang_word": "鼠疫",
                                "target_lang_sense_clarification": "特指由鼠疫杆菌引起的烈性传染病"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94554d67-fca6-3f2d-95ee-1038f6bff35d",
                    "sense_definition": "A widespread disaster, affliction, or destructive influx that causes great damage.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers struggled to save their crops from a sudden <w>plague</w> of locusts.",
                            "target_lang_translations": {
                                "ru": "Фермеры изо всех сил пытались спасти свой урожай от внезапного <w>нашествия</w> саранчи.",
                                "zh": "农民们努力保护庄稼，免受突如其来的蝗虫<w>侵袭</w>。"
                            }
                        },
                        {
                            "text": "Corruption is a <w>plague</w> that prevents the country from developing its economy.",
                            "target_lang_translations": {
                                "ru": "Коррупция — это <w>бич</w>, который мешает стране развивать свою экономику.",
                                "zh": "腐败是阻碍该国经济发展的<w>祸害</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scourge",
                        "pestilence"
                    ],
                    "common_phrases": [
                        "plague of locusts",
                        "ten plagues"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широкомасштабное бедствие или разрушительное явление, наносящее огромный ущерб.",
                        "zh": "造成巨大破坏的广泛灾难、苦难或毁灭性涌入。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нашествие",
                                "target_lang_sense_clarification": "наплыв вредителей (напр. саранчи)"
                            },
                            {
                                "target_lang_word": "бич",
                                "target_lang_sense_clarification": "перен. источник бедствий"
                            },
                            {
                                "target_lang_word": "бедствие",
                                "target_lang_sense_clarification": "катастрофа, несчастье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灾难",
                                "target_lang_sense_clarification": "指严重的祸害"
                            },
                            {
                                "target_lang_word": "祸害",
                                "target_lang_sense_clarification": "指造成损害的人或事物"
                            },
                            {
                                "target_lang_word": "侵袭",
                                "target_lang_sense_clarification": "指害虫或灾害的大规模到来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efbdda65-b9e9-32e6-9bfb-3889306482a8",
                    "sense_definition": "A person or thing that causes constant annoyance, trouble, or irritation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My little brother can be a real <w>plague</w> when he wants attention.",
                            "target_lang_translations": {
                                "ru": "Мой младший брат может быть сущим <w>наказанием</w>, когда хочет внимания.",
                                "zh": "我弟弟想引起注意时，简直是个令人头疼的<w>麻烦</w>。"
                            }
                        },
                        {
                            "text": "That broken car alarm is a <w>plague</w> on the whole neighborhood.",
                            "target_lang_translations": {
                                "ru": "Эта сломанная автосигнализация — настоящая <w>напасть</w> для всего района.",
                                "zh": "那辆坏掉的汽车警报器成了整个社区的<w>祸害</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pest",
                        "scourge",
                        "torment"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used hyperbolically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, вызывающий постоянное раздражение, проблемы или беспокойство.",
                        "zh": "引起持续烦恼、麻烦或恼怒的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наказание",
                                "target_lang_sense_clarification": "перен. о ком-то или чём-то несносном"
                            },
                            {
                                "target_lang_word": "напасть",
                                "target_lang_sense_clarification": "разг. беда, неприятность"
                            },
                            {
                                "target_lang_word": "чума",
                                "target_lang_sense_clarification": "разг. о взбалмошном или надоедливом человеке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "麻烦",
                                "target_lang_sense_clarification": "指令人烦恼的人或事"
                            },
                            {
                                "target_lang_word": "祸害",
                                "target_lang_sense_clarification": "指令人讨厌的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d86f9f66-bf5f-343d-80fb-8254fc3e9d6f",
                    "sense_definition": "To cause continual trouble, distress, or suffering to someone or something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The expedition was <w>plagued</w> by bad weather and equipment failure from the start.",
                            "target_lang_translations": {
                                "ru": "Экспедицию с самого начала <w>преследовали</w> плохая погода и поломки оборудования.",
                                "zh": "探险队从一开始就受到恶劣天气和设备故障的<w>困扰</w>。"
                            }
                        },
                        {
                            "text": "Financial problems have <w>plagued</w> the company for the last decade.",
                            "target_lang_translations": {
                                "ru": "Финансовые проблемы <w>терзали</w> компанию последнее десятилетие.",
                                "zh": "过去十年里，财务问题一直<w>困扰</w>着这家公司。"
                            }
                        }
                    ],
                    "synonyms": [
                        "torment",
                        "beset",
                        "bedevil",
                        "scourge"
                    ],
                    "common_phrases": [
                        "plagued by",
                        "plagued with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять постоянные неприятности, страдания или мучения.",
                        "zh": "使某人或某事持续遭受麻烦、痛苦或折磨。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преследовать",
                                "target_lang_sense_clarification": "неотступно следовать (о неудачах, проблемах)"
                            },
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "доставлять страдания"
                            },
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "сильно мучить, беспокоить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "困扰",
                                "target_lang_sense_clarification": "指长期受问题或痛苦折磨"
                            },
                            {
                                "target_lang_word": "折磨",
                                "target_lang_sense_clarification": "指使人痛苦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e216c44a-7d05-3c1c-b260-dabc67607fba",
                    "sense_definition": "To annoy, harass, or bother someone persistently.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reporters continued to <w>plague</w> the celebrity for a comment on the scandal.",
                            "target_lang_translations": {
                                "ru": "Репортёры продолжали <w>осаждать</w> знаменитость просьбами прокомментировать скандал.",
                                "zh": "记者们不断<w>纠缠</w>那位名人，要求其对丑闻发表评论。"
                            }
                        },
                        {
                            "text": "She <w>plagued</w> her father with questions until he finally answered her.",
                            "target_lang_translations": {
                                "ru": "Она <w>донимала</w> отца вопросами, пока он наконец не ответил ей.",
                                "zh": "她不断用问题<w>烦扰</w>父亲，直到他最终回答了她。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pester",
                        "harass",
                        "badger",
                        "hound",
                        "bug",
                        "vex",
                        "harry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настойчиво досаждать, беспокоить или приставать к кому-либо.",
                        "zh": "持续地烦扰、骚扰或打扰某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "донимать",
                                "target_lang_sense_clarification": "надоедать, приставать"
                            },
                            {
                                "target_lang_word": "изводить",
                                "target_lang_sense_clarification": "мучить придирками или просьбами"
                            },
                            {
                                "target_lang_word": "осаждать",
                                "target_lang_sense_clarification": "не давать прохода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纠缠",
                                "target_lang_sense_clarification": "指不断打扰某人"
                            },
                            {
                                "target_lang_word": "烦扰",
                                "target_lang_sense_clarification": "指不断打扰使人烦恼"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}