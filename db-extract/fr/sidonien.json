                        "entry_id": "8e739626-0345-32e6-8be8-6e3dc48381dc",
                        "glosses": [
                            "Relatif à Sidon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ba6389d-01aa-4e60-88f4-9469dd63e911",
                                "sense_id": "a78fd53b-3cf4-3733-8b3a-0e0b7bd54945",
                                "text": "C'est un gouverneur sidonien qui voyage sur un chariot. Comme les mulets sont fatigués et ne peuvent plus avancer, le cocher les détache pour qu'ils broutent un peu et se reposent. Mais, une fois libérés, ils détalent."
                            },
                            {
                                "example_id": "f807f855-66bd-4c3c-86a5-bc7954b4f04a",
                                "sense_id": "a78fd53b-3cf4-3733-8b3a-0e0b7bd54945",
                                "text": "Les monnaies sidoniennes avec le nom de Mazday ont longtemps été réparties en deux groupes constitués à partir des chiffres : le premier avec les chiffres qu'on y lit de 1 à 4 et le second avec les chiffres de 16 à 21."
                            }
                        ]
                    }
