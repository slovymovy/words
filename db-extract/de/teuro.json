        "de-extract.jsonl": [
            {
                "entry_id": "0830949f-d3b1-3539-b3eb-f5012b14cf52",
                "word": "TEuro",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "537ed63b-cc13-3c38-a7b2-fa0a99a712cd",
                        "entry_id": "0830949f-d3b1-3539-b3eb-f5012b14cf52",
                        "glosses": [
                            "tausend Euro"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ecd759f-8b53-4cff-9cee-df84481dc19a",
                                "sense_id": "537ed63b-cc13-3c38-a7b2-fa0a99a712cd",
                                "text": "„Das Gesamtinvestitionsvolumen von TEuro 887,0 konnte an die Vorjahre anknüpfen.“"
                            },
                            {
                                "example_id": "b404189d-6d14-4578-8075-9046bbfdd3cf",
                                "sense_id": "537ed63b-cc13-3c38-a7b2-fa0a99a712cd",
                                "text": "„Hier wurden im Jahr 2010 mit TEuro 4.587 rund 91% des Umsatzes getätigt.“"
                            },
                            {
                                "example_id": "e64e3f11-1137-4773-9b7c-9da12996ff61",
                                "sense_id": "537ed63b-cc13-3c38-a7b2-fa0a99a712cd",
                                "text": "„Das Eigenkapital hat sich aufgrund des Jahresüberschusses auf 266,8 TEuro um 4,6 TEuro erhöht.“"
                            },
                            {
                                "example_id": "c4e1eaaa-24e1-4837-a67e-762fee8e005e",
                                "sense_id": "537ed63b-cc13-3c38-a7b2-fa0a99a712cd",
                                "text": "„Mit einem Bilanzgewinn von TEuro 157,2 konnten wir das Genossenschaftsjahr positiv beenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
