                "senses": [
                    {
                        "sense_id": "3d8916bf-43ab-3071-bf91-f09ec16ce7bc",
                        "entry_id": "17ff0cda-31a8-3d6f-986e-903d2b152847",
                        "glosses": [
                            "Eintrittskarte oder Fahrkarte, die für einen bestimmten Zeitraum gültig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25962c19-4a60-40be-8af8-6754aeaebb5c",
                                "sense_id": "3d8916bf-43ab-3071-bf91-f09ec16ce7bc",
                                "text": "„Der private Bahnbetreiber fühlt sich bei der Abrechnung der Zeitkarten in den Verkehrsverbünden unfair behandelt.“"
                            },
                            {
                                "example_id": "e1cf4e00-868b-4faf-92d7-3e92204e684b",
                                "sense_id": "3d8916bf-43ab-3071-bf91-f09ec16ce7bc",
                                "text": "„Für Nutzer von Einzel- oder Streifenkarten würde der Preisanstieg beim Überfahren einer Tarifgrenze dadurch geringer, für Besitzer von Zeitkarten etwas teurer ausfallen.“"
                            },
                            {
                                "example_id": "cad876bc-2107-491e-9e49-03e2e5ce2938",
                                "sense_id": "3d8916bf-43ab-3071-bf91-f09ec16ce7bc",
                                "text": "„Die Bahn will Kunden mit einer ICE- oder IC-Zeitkarte im Abo nach eigenen Angaben selbst aktiv ansprechen und ihnen eine Teilerstattung anbieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
