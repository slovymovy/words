                    {
                        "sense_id": "0ef2feb0-29e5-3ddb-a03c-9a2236d7dc9b",
                        "entry_id": "c85b5c10-6de0-368f-9a9b-3ef38a80e60d",
                        "glosses": [
                            "ein Ereignis, das jemand mit einem Geruch erlebt hat"
