    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [
            {
                "entry_id": "83ed3f53-89ca-320f-95e9-11c42e335d07",
                "word": "Рейнгольд",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5549925b-4f0a-3831-9811-aaad18dad085",
                        "entry_id": "83ed3f53-89ca-320f-95e9-11c42e335d07",
                        "glosses": [
                            "мужское имя германского происхождения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cde9c5c1-9fa1-481c-ab44-c8f52ffca53c",
                                "sense_id": "5549925b-4f0a-3831-9811-aaad18dad085",
                                "text": "Само собою разумеется, что дворянство было этим недовольно, и один из среды его, Рейнгольд Паткуль, человек горячий и предприимчивый, до того задорно начал протестовать против действий правительства и возбуждать других к противодействию, что шведское правительство обвинило его в измене."
                            }
                        ]
                    },
                    {
                        "sense_id": "b635179b-76cd-3070-8496-9d15c0314b93",
                        "entry_id": "83ed3f53-89ca-320f-95e9-11c42e335d07",
                        "glosses": [
                            "фамилия германского происхождения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa1d856b-4dca-43d5-bdf0-98f6a8c8cda1",
                                "sense_id": "b635179b-76cd-3070-8496-9d15c0314b93",
                                "text": "Еще более отдаленные воспоминания доходили до меня по рассказам нашего домашнего врача Эмилия Ивановича Рейнгольда, бывшего лейб-медиком императора Николая, — когда-то полкового врача, бывшего под Фридландом и Бородином, участника походов 1812, 1813, 1814 и 1815 годов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "769d8fa5-c631-442b-b728-83ad39f84d9d",
                        "source_entry_id": "83ed3f53-89ca-320f-95e9-11c42e335d07",
                        "target_lang_word": "Reynold",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reynold",
