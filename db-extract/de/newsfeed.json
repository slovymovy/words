                                        "examples": [
                                            {
                                                "example_id": "1aacf20e-9e2a-46df-b924-25af2cd88234",
                                                "sense_id": "65a49059-9af5-370d-aa63-38fd1be14199",
                                                "text": "The National Black Network, the nation’s first black‐owned and operated radio news network, went on the air yesterday at 6 A.M. with hourly five-minute news feeds to stations in 40 cities."
                                            },
                                            {
                                                "example_id": "1995d3ad-5c47-43cc-8ac8-0a87bdf22c72",
                                                "sense_id": "65a49059-9af5-370d-aa63-38fd1be14199",
                                                "text": "From next year Europa will take video news feeds from EBU [European Broadcasting Union] members but will provide its own commentary in English."
                                            },
                                            {
                                                "example_id": "41e0981b-d366-4a0b-9578-f938a5f55741",
                                                "sense_id": "65a49059-9af5-370d-aa63-38fd1be14199",
                                                "text": "[Juan] Nagore is also interested in watching the proceedings via online streams and news feeds and hopes to eventually meet with the local legislators."
                                            }
