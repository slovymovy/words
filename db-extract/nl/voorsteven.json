                "translations": [
                    {
                        "translation_id": "b5a2c45e-b34f-4a6b-b205-2231de8908b2",
                        "source_entry_id": "a19a94e4-a3f9-3a1b-a4e0-fa4c595be67e",
                        "target_lang_word": "prow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "489a93ed-8d5e-3008-8704-76eae02f0531",
                                        "entry_id": "69d78310-1f2f-3942-9aaa-8c2ed74cbbe5",
                                        "glosses": [
                                            "The front part of a vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "968e4c11-3e41-4533-bc00-c8778e791a0a",
                                                "sense_id": "489a93ed-8d5e-3008-8704-76eae02f0531",
                                                "text": "The floating vessel swum / Uplifted, and secure with beaked prow / rode tilting o'er the waves."
                                            },
                                            {
                                                "example_id": "d3cb1c33-d955-4968-a706-cd6a8d1755f8",
                                                "sense_id": "489a93ed-8d5e-3008-8704-76eae02f0531",
                                                "text": "We were already rather close in; but I ordered the U-33's prow turned inshore and we crept slowly along, constantly dipping up the water and tasting it to assure ourselves that we didn't get outside the fresh-water current."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06e50555-5b6b-3872-b26e-c885f2b9b90a",
                                        "entry_id": "69d78310-1f2f-3942-9aaa-8c2ed74cbbe5",
                                        "glosses": [
                                            "A vessel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "prow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98881a33-2d7d-3ea3-b03c-285a00550c31",
                                        "entry_id": "ae0f9010-5eb8-38b0-a87d-fa0fc124754e",
                                        "glosses": [
                                            "Brave, valiant, gallant."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1f9ff26-af52-4b63-891e-7c2ba92fcf7a",
                                                "sense_id": "98881a33-2d7d-3ea3-b03c-285a00550c31",
                                                "text": "For they be two the prowest knights on ground, / And oft approu’d in many hard assay […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a7d1518-fac1-3fc3-8607-1040d07e92d1",
                                        "entry_id": "543d6dff-20f3-381b-9089-f3e7af3be81b",
                                        "glosses": [
                                            "Alternative form of proa."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6634e6b9-149a-4d07-9869-e87042d383cb",
                        "source_entry_id": "a19a94e4-a3f9-3a1b-a4e0-fa4c595be67e",
                        "target_lang_word": "proa",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proa",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "64f88cb4-f356-38e9-bc72-d8c1d4b98b48",
                                        "entry_id": "bbd9b943-43ef-37dd-acb3-0bca7a15c0a3",
                                        "glosses": [
                                            "Extremo delantero de una embarcación."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "899d0bb0-b28a-4ebb-9860-2c54d638747e",
                                                "sense_id": "64f88cb4-f356-38e9-bc72-d8c1d4b98b48",
                                                "text": "E tornó el capitán a sus galeas, e queriendo remar la galea del capitán, no pudieron, que encallava de proa en tierra."
                                            },
                                            {
                                                "example_id": "ba36cba6-55c9-42a4-a008-11a5f9fc851b",
                                                "sense_id": "64f88cb4-f356-38e9-bc72-d8c1d4b98b48",
                                                "text": "También me sorprendieron las teorías de un sabio noruego expuestas en un Congreso que hubo poco ha en Nuremberg, atribuyendo a los audaces navegadores y piratas normandos el descubrimiento de América a par que la invención de la arquitectura gótica, porque poniendo de punta o verticales las barcazas en que navegaban, crearon el arco ojival, que no es más que la proa afilada de cualquiera de dichas barcazas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6d23093-4d8f-3330-a26c-45e2ee7f33bb",
                                        "entry_id": "bbd9b943-43ef-37dd-acb3-0bca7a15c0a3",
                                        "glosses": [
                                            "Por extensión, sección delantera de la embarcación."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae4981b8-a36a-47b7-88a5-9dac524a5ac0",
                                                "sense_id": "c6d23093-4d8f-3330-a26c-45e2ee7f33bb",
                                                "text": "Venidos aquellos dozientos omes en la proa de la nao, estando sobre la dicha tierra, respondieron todo lo primero."
                                            },
                                            {
                                                "example_id": "258d82d1-5d9c-415a-8fef-4b46f6954e0a",
                                                "sense_id": "c6d23093-4d8f-3330-a26c-45e2ee7f33bb",
                                                "text": "Uno dellos, que a una parte de la proa[Siguiente] iba sentado, descubrió, con la claridad de los bajos rayos de la luna, que cuatro bajeles de remo, a larga y tirada boga, con gran celeridad y priesa, hacia la nave se encaminaban, y al momento conosció ser de contrarios."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e65f3703-4b6b-36f2-af4d-cedd831464de",
                                        "entry_id": "bbd9b943-43ef-37dd-acb3-0bca7a15c0a3",
                                        "glosses": [
                                            "Por extensión, proa_(1–2) de una aeronave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c25353bc-fc9b-470a-ab7a-2fa9c32ca9cc",
                                                "sense_id": "e65f3703-4b6b-36f2-af4d-cedd831464de",
                                                "text": "Avión proyectado por don Daniel Montero Martín en 1914. Se aprecia en la proa el dispositivo de su invención, llamado ‘aeroestable’, para corregir automáticamente las variaciones de posición del aparato en vuelo. Es una de las primeras concepciones de piloto automático."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
