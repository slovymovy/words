                                            {
                                                "example_id": "cd133b83-e88c-4c65-8f39-c182be4229b6",
                                                "sense_id": "990b20c6-6b26-36d1-b0d6-b825963dca0e",
                                                "text": "Our prejudices bias our views."
                                            },
                                            {
                                                "example_id": "d0c7f228-123b-4f40-ae4b-a436788f425e",
                                                "sense_id": "990b20c6-6b26-36d1-b0d6-b825963dca0e",
                                                "text": "No doubt they overlook the L.M.R.'s allegedly faulty financial estimates for the Euston-Liverpool/Manchester scheme, which have biassed the Treasury, and perhaps the open-minded Dr. Beeching, against electrification without renewed examination of projects."
                                            }
                                        ]
