                        ],
                        "examples": [
                            {
                                "example_id": "4a2a14e9-95d6-47e1-8126-4dac52a0b97a",
                                "sense_id": "4b678cc2-be66-36a8-8fcc-d9f0ba1bb059",
                                "text": "À 6 heures 30, Jean-Pierre enlève sa petite calotte et ses vêtements enfarinés, il s’habille et va retrouver des camarades avec qui il fait quelques parties de “ping-foot”, ce que sa famille désapprouve hautement."
                            },
                            {
                                "example_id": "4b02534e-ae0f-4a70-a7ed-ae0481fa5f8e",
                                "sense_id": "4b678cc2-be66-36a8-8fcc-d9f0ba1bb059",
                                "text": "Certains l’appellent le pingfoot, d’autres pensent que notre bon bieux baby-foot tout en bois sans pièce métallique s'appelle ainsi, où est la vérité ?."
                            },
                            {
                                "example_id": "f5156011-47dd-4a59-b042-a8e303efb53e",
                                "sense_id": "4b678cc2-be66-36a8-8fcc-d9f0ba1bb059",
                                "text": "Le ping foot rassemble une trentaine de joueurs."
                            }
                        ]
