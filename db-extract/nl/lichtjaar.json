                "senses": [
                    {
                        "sense_id": "93e10d0a-a0f0-3a87-8655-0dfefd065b74",
                        "entry_id": "499d24fc-4649-3dbb-81fb-c9c021675ece",
                        "glosses": [
                            "de afstand die het licht in één jaar aflegt in een vacuüm, ongeveer 9460 miljard kilometer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c22cbbe7-d159-41eb-8888-967938fee0c4",
                                "sense_id": "93e10d0a-a0f0-3a87-8655-0dfefd065b74",
                                "text": "Een lichtjaar is een lengtemaat die wordt gebruikt in de astronomie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "104cb532-1012-47a6-9689-f27649d9e566",
                        "source_entry_id": "499d24fc-4649-3dbb-81fb-c9c021675ece",
                        "source_sense_id": "93e10d0a-a0f0-3a87-8655-0dfefd065b74",
                        "source_sense_description": "de afstand die het licht in één jaar aflegt, ongeveer 9460 miljard kilometer",
                        "target_lang_word": "Lichtjahr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lichtjahr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1487a6ed-f961-39af-94a6-d36b246c6a53",
                                        "entry_id": "4002cc04-a164-3586-bf62-6784a128aac7",
                                        "glosses": [
                                            "Entfernung, die das Licht in einem Jahr zurücklegt (entspricht 9,46 Billionen Kilometern)"
                                        ],
                                        "tags": [
                                            "Entfernungseinheit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "929264f6-6b5d-4bcc-8056-9d65b933c473",
                                                "sense_id": "1487a6ed-f961-39af-94a6-d36b246c6a53",
                                                "text": "Der nächste Stern, Proxima Centauri, ist ca. 4,3 Lichtjahre weit entfernt."
                                            },
                                            {
                                                "example_id": "21c10f1e-2145-49a4-b0a4-7837cf2600ff",
                                                "sense_id": "1487a6ed-f961-39af-94a6-d36b246c6a53",
                                                "text": "„Mit der Geschwindigkeit von 40000 km/Std., die unsere »Raumschiffe« zwischen Erde und Mond derzeit erreichen, würde eine Reise zum rund 4 Lichtjahre entfernten sonnennächsten Fixstern über 100000 Jahre dauern.“"
                                            },
                                            {
                                                "example_id": "b2d1ca43-54bc-492a-b85b-2ce550d54e81",
                                                "sense_id": "1487a6ed-f961-39af-94a6-d36b246c6a53",
                                                "text": "„Als das Männlein fertiggeschnitzt war, trieb mein Vater ihm zwei Schusternägel in den Kopf, und so traue ich mir zu, ihn wiederzuerkennen, auch wenn ich ihn erst nach vielen Lichtjahren in der Milchstraße treffen sollte.“"
                                            },
                                            {
                                                "example_id": "9e66721f-2e2a-4463-983f-9335fc2ca82e",
                                                "sense_id": "1487a6ed-f961-39af-94a6-d36b246c6a53",
                                                "text": "„Vergleicht man diese beiden Zeremonien, so erkennt man, dass Lichtjahre eine deutsche Kanzlerin von einem französischen Präsidenten trennen.“"
                                            },
                                            {
                                                "example_id": "30c19a40-c19c-4a1c-8ba3-cd9a48c544bb",
                                                "sense_id": "1487a6ed-f961-39af-94a6-d36b246c6a53",
                                                "text": "„Sie füllt inzwischen die lokale Blase aus, ein staubfreies Areal von 300 Lichtjahren Durchmesser mit unserer Sonne mittendrin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21b94b67-cc4e-47ff-af21-273576566c26",
                        "source_entry_id": "499d24fc-4649-3dbb-81fb-c9c021675ece",
                        "source_sense_id": "93e10d0a-a0f0-3a87-8655-0dfefd065b74",
                        "source_sense_description": "de afstand die het licht in één jaar aflegt, ongeveer 9460 miljard kilometer",
                        "target_lang_word": "light year",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "light year",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ddf5956-cfec-3422-ac05-664960909daa",
                                        "entry_id": "fbda889c-d66d-38db-852b-f52795211e30",
                                        "glosses": [
                                            "A unit of length (abbreviation ly; equal to just under 10 trillion kilometres (10¹⁶ metres)) equal to the distance light travels in one Julian year; used to measure extremely large distances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf6c5e19-6516-484c-837b-ea1b2370eb11",
                                                "sense_id": "6ddf5956-cfec-3422-ac05-664960909daa",
                                                "text": "We live our lives in three dimensions for our threescore and ten allotted years. Yet every branch of contemporary science, from statistics to cosmology, alludes to processes that operate on scales outside of human experience: the millisecond and the nanometer, the eon and the light-year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25b7e79e-5fe1-325d-96c4-03d1d50a0afe",
                                        "entry_id": "fbda889c-d66d-38db-852b-f52795211e30",
                                        "glosses": [
                                            "A very long way."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "in-plural",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5422401f-6ccd-4aef-8a53-c62c5c34c756",
                                                "sense_id": "25b7e79e-5fe1-325d-96c4-03d1d50a0afe",
                                                "text": "The marathon runner in the lead is light years ahead of the one at the back."
                                            },
                                            {
                                                "example_id": "4ba05a5d-8c05-4702-b7bf-0c35563909fb",
                                                "sense_id": "25b7e79e-5fe1-325d-96c4-03d1d50a0afe",
                                                "text": "Now that they've graduated, they'll have to make some mature decisions in their future. One of which? Settling on their signature scent that is lightyears away from the $10 body spray they had throughout school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff52ee92-c97c-3845-8d9a-b06a17ec6ff9",
                                        "entry_id": "fbda889c-d66d-38db-852b-f52795211e30",
                                        "glosses": [
                                            "A very long time."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "in-plural",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdfb1449-dca0-4ec5-ae86-753b1e4ce4de",
                                                "sense_id": "ff52ee92-c97c-3845-8d9a-b06a17ec6ff9",
                                                "text": "Some of Leonardo da Vinci’s inventions were light years ahead of their time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48a7aa92-3d2a-49e7-b7b5-34e52de5c056",
                        "source_entry_id": "499d24fc-4649-3dbb-81fb-c9c021675ece",
