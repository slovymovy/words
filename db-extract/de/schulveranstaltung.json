                ],
                "senses": [
                    {
                        "sense_id": "d318d799-3b7f-30c1-83ff-933e2bc46399",
                        "entry_id": "95a0b227-c67d-35c9-9af2-ef9694c90735",
                        "glosses": [
                            "gemeinsame Unternehmung einer Schulklasse außerhalb des regulären Unterrichts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f9b8b3-477f-42fe-8a42-4f70f78641bb",
                                "sense_id": "d318d799-3b7f-30c1-83ff-933e2bc46399",
                                "text": "„Werden Schulveranstaltungen unterschiedlicher Art und Höchstdauer zusammengelegt, gilt für die kombinierte Schulveranstaltung die jeweils längere Dauer als zulässige Höchstdauer.“"
                            },
                            {
                                "example_id": "794ac341-d0c8-4887-b5f6-f366bc4838da",
                                "sense_id": "d318d799-3b7f-30c1-83ff-933e2bc46399",
                                "text": "„Solange Ihre Tochter alle verpflichtenden Schulveranstaltungen besucht, kann sie dazwischen das Schulgelände jederzeit verlassen.“"
                            },
                            {
                                "example_id": "e978180d-8af5-4559-afc2-c9aa78ba2fbc",
                                "sense_id": "d318d799-3b7f-30c1-83ff-933e2bc46399",
                                "text": "„Sie sponsern Schulveranstaltungen, vertreiben Schulhefte mit Firmenlogos oder schicken gar Dozenten.“"
                            },
                            {
                                "example_id": "a0ae50b5-d7e7-4108-9730-2ab4ee296b5b",
                                "sense_id": "d318d799-3b7f-30c1-83ff-933e2bc46399",
                                "text": "„[Schüler aus Hartz-IV-Familien] müssen […] an gemeinsamen Schulveranstaltungen teilnehmen dürfen.“"
                            },
                            {
                                "example_id": "6ee74f2c-2f23-46aa-951a-eca3888c3476",
                                "sense_id": "d318d799-3b7f-30c1-83ff-933e2bc46399",
                                "text": "„Nach der sog. Wanderrichtlinie sei zwingend eine Befreiung von der Teilnahme an mehrtätigen Schulveranstaltungen zu erteilen, wenn die Erziehungsberechtigten auch nach einem Gespräch über Ziele und Inhalte der Schulveranstaltung eine Befreiung aus religiösen Gründen wünschten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
