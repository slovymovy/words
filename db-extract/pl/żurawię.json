                        "examples": [
                            {
                                "example_id": "f2e66dbb-5dd2-4521-b91b-1b751b54148e",
                                "sense_id": "932eeec0-4936-317c-a0cd-fd6c517393fb",
                                "text": "W gnieździe baraszkowało jedno żurawię."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa522a15-0810-4436-8f24-9668442d0027",
                        "source_entry_id": "80ee05b0-0d1c-3b69-a6cf-ce008985f3c5",
                        "source_sense_id": "932eeec0-4936-317c-a0cd-fd6c517393fb",
                        "target_lang_word": "young",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "young",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34a5a2c2-cd48-39cd-b970-754f777a300c",
                                        "entry_id": "52f5a8c2-f02d-34cd-b0ef-20ada7833b71",
                                        "glosses": [
                                            "In the early part of growth or life; born not long ago."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8be1e789-2aed-4d5a-a7a7-d668f265a3d1",
                                                "sense_id": "34a5a2c2-cd48-39cd-b970-754f777a300c",
                                                "text": "a lamb is a young sheep"
                                            },
                                            {
                                                "example_id": "e3f841f2-5662-4d5b-aa85-ada8f0d76720",
                                                "sense_id": "34a5a2c2-cd48-39cd-b970-754f777a300c",
                                                "text": "these picture books are for young readers"
                                            },
                                            {
                                                "example_id": "1d6de8a1-8c39-4db4-b393-8c18179a3a09",
                                                "sense_id": "34a5a2c2-cd48-39cd-b970-754f777a300c",
                                                "text": "Bliss was it in that dawn to be alive,\nBut to be young was very heaven!"
                                            },
                                            {
                                                "example_id": "496f2d4e-a697-4577-a826-d83b1c443850",
                                                "sense_id": "34a5a2c2-cd48-39cd-b970-754f777a300c",
                                                "text": "\"What a charming amusement for young people this is, Mr. Darcy! There is nothing like dancing after all. I consider it as one of the first refinements of polished society.\""
                                            },
                                            {
                                                "example_id": "122de17f-c5c7-4e25-abd5-39b924f4c068",
                                                "sense_id": "34a5a2c2-cd48-39cd-b970-754f777a300c",
                                                "text": "I stumbled along through the young pines and huckleberry bushes. Pretty soon I struck into a sort of path that, I cal'lated, might lead to the road I was hunting for. It twisted and turned, and, the first thing I knew, made a sudden bend around a bunch of bayberry scrub and opened out into a big clear space like a lawn."
                                            },
                                            {
                                                "example_id": "53095a10-9641-43d9-a621-59614c2a9964",
                                                "sense_id": "34a5a2c2-cd48-39cd-b970-754f777a300c",
                                                "text": "At Columbia-Greene, staffers go for the most unadoptable animals to save them from euthanasia. The youngest, healthiest, cutest pets are waiting for you."
                                            },
                                            {
                                                "example_id": "1946127c-b83c-4fb3-9eb0-5c1c96237a4b",
                                                "sense_id": "34a5a2c2-cd48-39cd-b970-754f777a300c",
                                                "text": "The factors related to increase in number of abscondings were younger age, psychiatric problems, multi-drug abuse and living alone."
                                            },
                                            {
                                                "example_id": "3b5bff78-323e-4ada-8d43-13722a29d87a",
                                                "sense_id": "34a5a2c2-cd48-39cd-b970-754f777a300c",
                                                "text": "Irregular bedtimes may disrupt healthy brain development in young children, according to a study of intelligence and sleeping habits. ¶ Going to bed at a different time each night affected girls more than boys, but both fared worse on mental tasks than children who had a set bedtime, researchers found."
                                            },
                                            {
                                                "example_id": "a8b94db6-04e4-46bd-a233-501f1ca78a30",
                                                "sense_id": "34a5a2c2-cd48-39cd-b970-754f777a300c",
                                                "text": "The number of young children in the US who have died from opioid overdoses has increased significantly, according to a new study on accidental poisonings of children 5 and younger."
                                            },
                                            {
                                                "example_id": "767bfbe7-5713-4c13-9b64-6c26f7292c36",
                                                "sense_id": "34a5a2c2-cd48-39cd-b970-754f777a300c",
                                                "text": "These concerns were shared by other SNP women who told the Guardian there was a chronic lack of support from the party, including for those with younger families."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59c12fb0-a73b-32b1-b5ff-f3be4e26453f",
                                        "entry_id": "52f5a8c2-f02d-34cd-b0ef-20ada7833b71",
                                        "glosses": [
                                            "At an early stage of existence or development; having recently come into existence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60405238-1854-4cea-84c1-5be4a503d4ac",
                                                "sense_id": "59c12fb0-a73b-32b1-b5ff-f3be4e26453f",
                                                "text": "the age of space travel is still young"
                                            },
                                            {
                                                "example_id": "01e105da-85bf-42ad-8771-a1826efb3d95",
                                                "sense_id": "59c12fb0-a73b-32b1-b5ff-f3be4e26453f",
                                                "text": "a young business"
                                            },
                                            {
                                                "example_id": "99895479-f96c-43af-b08a-5d728e255f9a",
                                                "sense_id": "59c12fb0-a73b-32b1-b5ff-f3be4e26453f",
                                                "text": "[…] while the Fears of the People were young, they were encreas’d strangely by several odd Accidents […]"
                                            },
                                            {
                                                "example_id": "5ba9df45-06a2-4d6a-a2ee-5ca506d469f9",
                                                "sense_id": "59c12fb0-a73b-32b1-b5ff-f3be4e26453f",
                                                "text": "Look at that sky, life's begun / Nights are warm and the days are young"
                                            },
                                            {
                                                "example_id": "2443d3c3-3c2c-4265-bcb6-3a3c32160567",
                                                "sense_id": "59c12fb0-a73b-32b1-b5ff-f3be4e26453f",
                                                "text": "A team of Irish astronomers have captured an out-of-this-world image of one of the youngest stars known to scientists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1af924b-b90c-3158-9ad8-6f0891c6f5a3",
                                        "entry_id": "52f5a8c2-f02d-34cd-b0ef-20ada7833b71",
                                        "glosses": [
                                            "advanced in age; (far towards or) at a specified stage of existence or age."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0a565fd-f607-4f5c-8dc6-eee521c066f6",
                                                "sense_id": "d1af924b-b90c-3158-9ad8-6f0891c6f5a3",
                                                "text": "And thou, our Mother, twice two centuries young,\nBend with bright shafts of truth thy bow fresh-strung."
                                            },
                                            {
                                                "example_id": "a6a904d3-6fe0-4dbd-b2e9-ead1bf93d977",
                                                "sense_id": "d1af924b-b90c-3158-9ad8-6f0891c6f5a3",
                                                "text": "How young is your dog?"
                                            },
                                            {
                                                "example_id": "70d626aa-45af-448d-b590-92600a9eb5c9",
                                                "sense_id": "d1af924b-b90c-3158-9ad8-6f0891c6f5a3",
                                                "text": "Her grandmother turned 70 years young last month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69ae2a3b-4345-363b-86f5-f70c81137c36",
                                        "entry_id": "52f5a8c2-f02d-34cd-b0ef-20ada7833b71",
                                        "glosses": [
                                            "Junior (of two related people with the same name)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18543f92-64a3-4c86-8212-cf2c1ba91028",
                                                "sense_id": "69ae2a3b-4345-363b-86f5-f70c81137c36",
                                                "text": "The young Mr. Chester must be in the wrong, and the old Mr. Chester must be in the right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5167948d-61c5-32ab-a965-48ffd3e941c1",
                                        "entry_id": "52f5a8c2-f02d-34cd-b0ef-20ada7833b71",
                                        "glosses": [
                                            "Early. (of a decade of life)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fb6e262-ac3b-4d50-ad90-36f4bfbd1b50",
                                                "sense_id": "5167948d-61c5-32ab-a965-48ffd3e941c1",
                                                "text": "1922, E. Barrington, “The Mystery of Stella” in “The Ladies!” A Shining Constellation of Wit and Beauty, Boston: Atlantic Monthly Press, pp. 40-41,\n[…] Miss Hessy is as pretty a girl as eye can see, in her young twenties and a bit of a fortune to boot."
                                            },
                                            {
                                                "example_id": "af54d5ae-647d-4b75-89a6-25d0a69a121e",
                                                "sense_id": "5167948d-61c5-32ab-a965-48ffd3e941c1",
                                                "text": "Ephraim would be in his young thirties."
                                            },
                                            {
                                                "example_id": "7bc29437-9867-4349-9baa-43e4997e7139",
                                                "sense_id": "5167948d-61c5-32ab-a965-48ffd3e941c1",
                                                "text": "[…] while this may appeal to older, better-off shoppers, vast numbers, especially those in their teens and young twenties, still want fast, cheap fashion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bcfdcf5-2bae-3dd6-a90c-b23210f8c44a",
                                        "entry_id": "52f5a8c2-f02d-34cd-b0ef-20ada7833b71",
                                        "glosses": [
                                            "Youthful; having the look or qualities of a young person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91a1be8f-25d1-4915-98e7-7426fea6c49d",
                                                "sense_id": "6bcfdcf5-2bae-3dd6-a90c-b23210f8c44a",
                                                "text": "Think of banking today and the image is of grey-suited men in towering skyscrapers. Its future, however, is being shaped in converted warehouses and funky offices in San Francisco, New York and London, where bright young things in jeans and T-shirts huddle around laptops, sipping lattes or munching on free food."
                                            },
                                            {
                                                "example_id": "bbdaeb14-94ee-4322-965e-3019a10bc2d5",
                                                "sense_id": "6bcfdcf5-2bae-3dd6-a90c-b23210f8c44a",
                                                "text": "My grandmother is a very active woman and is quite young for her age."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef02d074-1cd7-3a48-a6b3-c8696ed6b8e4",
                                        "entry_id": "52f5a8c2-f02d-34cd-b0ef-20ada7833b71",
                                        "glosses": [
                                            "Of or belonging to the early part of life."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2fee3c-5eaa-4a82-ac0a-4afa5ea24526",
                                                "sense_id": "ef02d074-1cd7-3a48-a6b3-c8696ed6b8e4",
                                                "text": "The cynical world soon shattered my young dreams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "841129ca-1b98-3f0b-8665-b843eaeeb0cd",
                                        "entry_id": "52f5a8c2-f02d-34cd-b0ef-20ada7833b71",
                                        "glosses": [
                                            "Having little experience; inexperienced; unpracticed; ignorant; weak."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33d5a0c9-9a2c-421f-a7fd-f59c70078803",
                                                "sense_id": "841129ca-1b98-3f0b-8665-b843eaeeb0cd",
                                                "text": "Come, come, elder brother, you are too young in this."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "young",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "234befa4-0f33-33c4-b1d9-bca97b571fe7",
                                        "entry_id": "3cbe1367-b542-3a0e-908e-599db4022181",
                                        "glosses": [
                                            "Offspring, especially the immature offspring of animals."
