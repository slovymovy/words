                "senses": [
                    {
                        "sense_id": "093ab038-e7f7-3b87-a23a-82a577ceb2dd",
                        "entry_id": "c57f4673-d26f-3cfe-91e8-475df58e1a83",
                        "glosses": [
                            "mechanische oder von Hand gesteuerte, absperrbare Einlass-, Anlass- oder Durchtrittsvorrichtung für Gase oder Flüssigkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bde56bbd-8293-4721-aa47-9c519af5ce1a",
                                "sense_id": "093ab038-e7f7-3b87-a23a-82a577ceb2dd",
                                "text": "„Alternativ sorgen Tellerventile als kombiniertes Zuluft- und Abluftventil dafür, dass ein geregelter Luftstrom über eine größtmögliche Fläche entsteht.“"
                            },
                            {
                                "example_id": "e4d68de8-5947-4914-85f5-e65e23b0ec9d",
                                "sense_id": "093ab038-e7f7-3b87-a23a-82a577ceb2dd",
                                "text": "„Das hochwertige Tellerventil TVLNA eignet sich für den Einsatz in Gebäuden, in denen spezielle Anforderungen an die Schalldämmung gestellt werden.“"
                            },
                            {
                                "example_id": "cac57af9-eb6e-45aa-b7cf-47eb26fc186b",
                                "sense_id": "093ab038-e7f7-3b87-a23a-82a577ceb2dd",
                                "text": "„Die Tellerventile aus Kunststoff zeichnen sich ganz speziell durch ihre hohe Qualität und Langlebigkeit aus.“"
                            },
                            {
                                "example_id": "a85fffbc-7a06-4c65-a638-0d44cdf4c975",
                                "sense_id": "093ab038-e7f7-3b87-a23a-82a577ceb2dd",
                                "text": "„Das Zehnder Tellerventil ist sowohl für den Wand- als auch für den Deckeneinbau geeignet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "475af7da-c4d5-41b2-9f6f-0bad873162fb",
                        "source_entry_id": "c57f4673-d26f-3cfe-91e8-475df58e1a83",
                        "source_sense_id": "093ab038-e7f7-3b87-a23a-82a577ceb2dd",
                        "target_lang_word": "poppet valve",
