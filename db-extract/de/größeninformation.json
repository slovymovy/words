                "senses": [
                    {
                        "sense_id": "08519cf0-e32d-3a0c-875a-97881df28388",
                        "entry_id": "4ee071d7-a2d3-3287-a797-d0cdf1910ffa",
                        "glosses": [
                            "Angaben über die Maßen (eines Produkts); Information, die dem Kunden hilft, passende Größe auszuwählen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fb22e25-4aea-4cfd-b797-6890e68dc9f0",
                                "sense_id": "08519cf0-e32d-3a0c-875a-97881df28388",
                                "text": "„Hinweis: Bitte überprüfen Sie die Größeninformationen, bevor Sie diese bestellen.“"
                            },
                            {
                                "example_id": "59a3a0eb-9f3e-455e-8588-9aa829c64efa",
                                "sense_id": "08519cf0-e32d-3a0c-875a-97881df28388",
                                "text": "„Damit Sie die richtige Größe finden, klicken Sie einfach auf den Button „Größentabelle“, dann werden Sie umgehend zur Größeninformation Fynch Hatton Casual Fit weitergeleitet.“"
                            },
                            {
                                "example_id": "a6ccb6e3-e823-44e8-9953-780642ea9dd0",
                                "sense_id": "08519cf0-e32d-3a0c-875a-97881df28388",
                                "text": "„Erklärung zur Größeninformation (ersichtlich bei der Schuhgröße): IL = Innenschuhlänge in cm IB = Innenschuhbreite in cm“"
                            },
                            {
                                "example_id": "8ca4e758-1ac0-4cd0-bfea-ee1274bbf0b1",
                                "sense_id": "08519cf0-e32d-3a0c-875a-97881df28388",
                                "text": "Größeninformationen entnehmen Sie bitte der Größentabelle (siehe Abbildungen)“"
                            },
                            {
                                "example_id": "aac52464-cb3f-4e0e-94b0-feee1909533d",
                                "sense_id": "08519cf0-e32d-3a0c-875a-97881df28388",
                                "text": "„Größeninformation: Selin ist 1,70 m groß und trägt Größe S / Noa-Sofia ist 1,75 m groß und trägt Gr. L“"
                            },
                            {
                                "example_id": "aefd9419-c75e-4939-93e3-291e557c0640",
                                "sense_id": "08519cf0-e32d-3a0c-875a-97881df28388",
                                "text": "„Wenn du dir selbst eine schöne Babymütze häkeln, stricken oder schneidern möchtest, findest du hier weitere Größeninformationen zur Mützenhöhe und dem Mützendurchmesser:“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
