                ],
                "senses": [
                    {
                        "sense_id": "4529a10d-d6be-3efd-a848-cdb68e2df110",
                        "entry_id": "46850b0f-ba0d-3382-9838-9280de7f6e84",
                        "glosses": [
                            "Person, die eine technische Apparatur oder eine technische Anlage planmäßig zusammenbaut oder wartet sowie ggf. (bspw. einen Wasserzähler) austauscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fd79e03-86af-48ee-86cb-edf7ef2e35d7",
                                "sense_id": "4529a10d-d6be-3efd-a848-cdb68e2df110",
                                "text": "„Er baut solche Steuergeräte und möchte nicht, dass sein Name oder der seines Arbeitgebers genannt werden. Der Einblick, den die Monteure in den Werkstätten in die Systeme bekämen, sei \"oberflächlich\", bestätigt er. Es geben zu viele Autotypen und die Daten seien zu komplex, daher könne eine Werkstatt nicht jede Einzelheit kennen.“"
                            },
                            {
                                "example_id": "c04100f5-a909-49ce-980b-f5176c6f7a60",
                                "sense_id": "4529a10d-d6be-3efd-a848-cdb68e2df110",
                                "text": "„Am Depot waren die Monteuere dabei, noch einmal die Wagen nachzusehen.“"
                            },
                            {
                                "example_id": "ef3c37a8-96de-4e14-9029-5d1393889c4d",
                                "sense_id": "4529a10d-d6be-3efd-a848-cdb68e2df110",
                                "text": "Am kommenden Dienstag kommt der Monteur um den Funkwasserzähler auszutauschen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14b2ec09-cdaa-4d4c-a7b7-ea065e374c46",
                        "source_entry_id": "46850b0f-ba0d-3382-9838-9280de7f6e84",
                        "source_sense_id": "4529a10d-d6be-3efd-a848-cdb68e2df110",
                        "source_sense_description": "Person, die eine technische Apparatur oder eine technische Anlage planmäßig zusammenbaut",
                        "target_lang_word": "assembler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assembler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "269d9be5-76df-3574-946d-3b56d907611b",
                                        "entry_id": "bdf33934-89a6-3eb0-a046-fc8780ccf722",
                                        "glosses": [
                                            "A program that reads source code written in assembly language and produces executable machine code, possibly together with information needed by linkers, debuggers and other tools."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "108a9de8-2d1b-45c8-8afe-2709c94227ae",
                                                "sense_id": "269d9be5-76df-3574-946d-3b56d907611b",
                                                "text": "The system includes an 8080 and a Z80 assembler, a Tektronix format downloader and other utilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f18609a0-64e6-35ee-ab2d-90c421298d61",
                                        "entry_id": "bdf33934-89a6-3eb0-a046-fc8780ccf722",
                                        "glosses": [
                                            "Assembly language."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "906627c6-5279-423f-809b-d7e0113b28d8",
                                                "sense_id": "f18609a0-64e6-35ee-ab2d-90c421298d61",
                                                "text": "I wrote that program in assembler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d4f5b43-56b4-3b4a-b020-96cc4cf3add5",
                                        "entry_id": "bdf33934-89a6-3eb0-a046-fc8780ccf722",
                                        "glosses": [
                                            "One who assembles items."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16139d36-734e-4cb6-b085-b66d44e97bc3",
                                                "sense_id": "7d4f5b43-56b4-3b4a-b020-96cc4cf3add5",
                                                "text": "Our father worked as an assembler in a radio factory that would go out of business in the early 1960s, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3062f229-e3c6-3fcf-8c4d-8db0f32cc0f8",
                                        "entry_id": "bdf33934-89a6-3eb0-a046-fc8780ccf722",
                                        "glosses": [
                                            "A nanodevice capable of assembling nanodevices, possibly including copies of itself, according to a plan."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de701452-6708-404b-95c3-a79365336a11",
                                                "sense_id": "3062f229-e3c6-3fcf-8c4d-8db0f32cc0f8",
                                                "text": "Assembler (nanotechnology) on Wikipedia.Wikipedia"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80661332-c8ca-483a-9792-528a8c541b4e",
                        "source_entry_id": "46850b0f-ba0d-3382-9838-9280de7f6e84",
                        "source_sense_id": "4529a10d-d6be-3efd-a848-cdb68e2df110",
                        "source_sense_description": "Person, die eine technische Apparatur oder eine technische Anlage planmäßig zusammenbaut",
                        "target_lang_word": "monteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c0feebd-7ca8-3187-bb2d-27bdacc17503",
                                        "entry_id": "2903399f-f4ce-319d-9d36-baf868e78880",
                                        "glosses": [
                                            "Ouvrier qui monte des pierres fines, des pièces d’orfèvrerie, de machines, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9b6ebc2-b8cf-466c-a4f2-9c2c01e542a9",
                                                "sense_id": "6c0feebd-7ca8-3187-bb2d-27bdacc17503",
                                                "text": "Fils d’un ouvrier pauvre, Martial était presque devenu, à force de travail et d’économie, un ouvrier riche. Son père était monteur en bronze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf8a372-80ad-30ff-a03d-f023b98d5f46",
                                        "entry_id": "2903399f-f4ce-319d-9d36-baf868e78880",
                                        "glosses": [
                                            "Celui qui est en charge d’assembler bout à bout plusieurs plans, issus du tournage, pour, lors du montage, former des séquences qui formeront à leur tour un film."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6819bf2-a919-4fc1-b0e6-0481707862ac",
                                                "sense_id": "9bf8a372-80ad-30ff-a03d-f023b98d5f46",
                                                "text": "Mis au point dans les années 1980, le montage virtuel est non linéaire et permet de placer n’importe quel plan dans n’importe quel ordre sans que le monteur soit obligé de revoir chronologiquement toutes les séquences montées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
