                        "translation_id": "04e03ec3-0a90-4c0f-848f-b3662ca69e98",
                        "source_entry_id": "062af0de-1472-340c-aab8-e08f9f526e6c",
                        "source_sense_id": "3af2c43b-b80a-381a-b478-3bb6be398173",
                        "source_sense_description": "the quality of being tight",
                        "target_lang_word": "étroitesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
