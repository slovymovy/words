                "senses": [
                    {
                        "sense_id": "7497a050-45bc-3252-b8c8-ed4f79f2338d",
                        "entry_id": "3c951b27-bcf4-3d4e-bef4-32ad893650a3",
                        "glosses": [
                            "das Bundesland betreffende Aktions-/Entscheidungsebene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e67cf89-5b21-4625-ad6e-1abe11b4be83",
                                "sense_id": "7497a050-45bc-3252-b8c8-ed4f79f2338d",
                                "text": "„Die Bundesstaatlichkeit fußt auf der Demokratie auf Bundesebene und auf der Demokratie auf Landesebene.“"
                            },
                            {
                                "example_id": "91d77241-b4f6-4ef5-8672-441ffdd475a9",
                                "sense_id": "7497a050-45bc-3252-b8c8-ed4f79f2338d",
                                "text": "„Mittels Process-Tracing werden in diesem Buch die komplexen Kausalmechanismen aufgedeckt, die die gelegentliche Demokratisierung der innerparteilichen Willensbildung der Parteien auf Landesebene erklären.“"
                            },
                            {
                                "example_id": "eb0b17a6-268c-433b-8a5d-d514c0462df2",
                                "sense_id": "7497a050-45bc-3252-b8c8-ed4f79f2338d",
                                "text": "„Es ist davon auszugehen, dass bislang auf Landesebene noch nicht etablierte Interessenvertretungen der Pflegeschulen spätesten mit Inkrafttreten des Pflegeberufegesetzes gebildet werden.“"
                            },
                            {
                                "example_id": "47022b0e-1854-4460-af03-98bfe1f0c5c1",
                                "sense_id": "7497a050-45bc-3252-b8c8-ed4f79f2338d",
                                "text": "„Direkte Demokratie findet ausschließlich auf Kommunal- und Landesebene statt und wird selbst auf diesen Ebenen durch Quoren und Themeneinschränkungen blockiert.“"
                            },
                            {
                                "example_id": "4bf42de2-08fd-44d9-b330-0a42985a2d1c",
                                "sense_id": "7497a050-45bc-3252-b8c8-ed4f79f2338d",
                                "text": "„Formale Fragen der staatlichen Ordnung spielen aber auf Bundesebene fast keine, auf Landesebene nur eine untergeordnete Rolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
