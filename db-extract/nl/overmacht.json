        "nl-extract.jsonl": [
            {
                "entry_id": "a956d1c9-eb6c-3ca9-a561-bfbbe8c107b7",
                "word": "overmacht",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "07b62cf8-f2df-3e94-8068-c7372e6594bc",
                        "entry_id": "a956d1c9-eb6c-3ca9-a561-bfbbe8c107b7",
                        "glosses": [
                            "iets waar je niet de mogelijkheid hebt om iets anders te doen of te laten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "061a9606-2454-4b9f-8041-c75a032ca77e",
                                "sense_id": "07b62cf8-f2df-3e94-8068-c7372e6594bc",
                                "text": "Hij kon echt niet meer remmen, het was overmacht dat het ongeluk toch gebeurde."
                            },
                            {
                                "example_id": "726f9a90-66f6-44ec-9cb0-0e2ee652d558",
                                "sense_id": "07b62cf8-f2df-3e94-8068-c7372e6594bc",
                                "text": "\"Passagiers van wie de vlucht is geannuleerd zullen ongetwijfeld claims indienen bij vliegmaatschappijen. Tenzij er sprake is van overmacht, zullen maatschappijen hun passagiers moeten compenseren. Een verzoek tot annulering kan niet gezien worden als overmacht. Daarom hebben de vliegmaatschappijen geen andere keuze dan Schiphol aansprakelijk te stellen\", staat in de brief."
                            }
                        ]
                    },
                    {
                        "sense_id": "535d87dc-7f97-35b9-9983-d991b6bbb373",
                        "entry_id": "a956d1c9-eb6c-3ca9-a561-bfbbe8c107b7",
                        "glosses": [
                            "een kracht die heel veel groter is dan die van de concurrenten of vijanden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "016ea0b2-40c5-4201-bafd-5e1a021d1214",
                                "sense_id": "535d87dc-7f97-35b9-9983-d991b6bbb373",
                                "text": "Hij won met overmacht de 100 meter sprint."
                            },
                            {
                                "example_id": "a3e0c489-4442-4017-bf1d-f3fe718d5c4d",
                                "sense_id": "535d87dc-7f97-35b9-9983-d991b6bbb373",
                                "text": "Zijn trouwe Roodhoofden hadden geen enkele kans gemaakt tegen de overmacht."
                            }
                        ]
                    }
                ],
