                "senses": [
                    {
                        "sense_id": "5648343a-4083-35a5-bc3e-3fa70a93ca68",
                        "entry_id": "3b9ed49f-815c-394f-bf59-d158e858a19e",
                        "glosses": [
                            "Bouquet de fleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91729beb-34ec-4d03-91b2-12773cf7f4b7",
                                "sense_id": "5648343a-4083-35a5-bc3e-3fa70a93ca68",
                                "text": "Sie bekam von ihrem Freund ein schönes Bouquet.",
                                "translation": "Elle a reçu de son ami un joli bouquet."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e79ca8d-beb2-30ea-b90b-cf438e8fe2d0",
                        "entry_id": "3b9ed49f-815c-394f-bf59-d158e858a19e",
                        "glosses": [
                            "Bouquet : ensemble d’arômes développés par le vin en vieillissant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a83108a-f0b4-4e9b-8312-c3248bf95c5b",
                                "sense_id": "7e79ca8d-beb2-30ea-b90b-cf438e8fe2d0",
                                "text": "Das starke Bouquet diese Weins passt gut mit dem Braten zusammen.",
                                "translation": "Le bouquet intense de ce vin va bien avec le rôti."
                            }
                        ]
                    }
                ],
