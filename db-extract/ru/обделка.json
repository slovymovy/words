                    {
                        "translation_id": "f20d8f04-e668-4f7e-bb63-a8e4cc34631a",
                        "source_entry_id": "6047938f-d8e1-3857-a44b-028b96234dc8",
                        "target_lang_word": "Revestimiento",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b8056cfc-fb61-4103-8395-b84bad0b8656",
                        "source_entry_id": "6047938f-d8e1-3857-a44b-028b96234dc8",
                        "target_lang_word": "Cubierta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "29c9afec-76cd-4cb5-9447-055de92a612d",
                        "source_entry_id": "6047938f-d8e1-3857-a44b-028b96234dc8",
                        "target_lang_word": "Verkleidung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verkleidung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c792e1e-6c70-3bc4-b614-0333de3f2e64",
                                        "entry_id": "9fc734c0-6757-357f-a98e-49b16172af39",
                                        "glosses": [
                                            "Kleidungsstück(e), um in eine fremde Rolle zu schlüpfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c947d491-f66c-430e-9501-8f314cec800c",
                                                "sense_id": "0c792e1e-6c70-3bc4-b614-0333de3f2e64",
                                                "text": "Trotz Verkleidung habe ihn alle schnell erkannt."
                                            },
                                            {
                                                "example_id": "416526da-ff23-4b00-8a43-ca63e9fac0e6",
                                                "sense_id": "0c792e1e-6c70-3bc4-b614-0333de3f2e64",
                                                "text": "Meine Tochter wünscht sich eine Verkleidung als Prinzessin Leia."
                                            },
                                            {
                                                "example_id": "e2fdef5d-25d0-4373-82a0-b67992ff4960",
                                                "sense_id": "0c792e1e-6c70-3bc4-b614-0333de3f2e64",
                                                "text": "„Sie hatte sich zu dieser Verkleidung überreden lassen.“"
                                            },
                                            {
                                                "example_id": "44f1b7ef-e915-4a91-b286-42b95dbb4788",
                                                "sense_id": "0c792e1e-6c70-3bc4-b614-0333de3f2e64",
                                                "text": "„Sonjas Verkleidung war am allerbesten gelungen.“"
                                            },
                                            {
                                                "example_id": "1a15f87d-8ff0-47cb-bb04-79e9107a5c87",
                                                "sense_id": "0c792e1e-6c70-3bc4-b614-0333de3f2e64",
                                                "text": "„Die Gäste kamen, und der Marchese sagte uns, die Verkleidung sei so beschaffen, daß wir mehr Vergnügen hätten, wenn wir uns vor dem Essen umziehen würden als nachher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "424c6565-b53c-33c6-8618-236c2c9e1b7f",
                                        "entry_id": "9fc734c0-6757-357f-a98e-49b16172af39",
                                        "glosses": [
                                            "Umhüllung zum Schutz vor Außeneinflüssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae3fae2-73b9-4f0e-b321-75d0d540e249",
                                                "sense_id": "424c6565-b53c-33c6-8618-236c2c9e1b7f",
                                                "text": "Die nachträgliche Verkleidung schützt gegen Wetterschäden."
                                            },
                                            {
                                                "example_id": "a363e64f-3ba7-48ef-84e8-e9dd37846db7",
                                                "sense_id": "424c6565-b53c-33c6-8618-236c2c9e1b7f",
                                                "text": "„Mit fahrigen Fingern tastet er die Verkleidung unter dem Fenster ab, schnappt nach dem Türhebel, klappt und zerrt daran, rüttelt mit beiden Händen an der Tür.“"
                                            },
                                            {
                                                "example_id": "c5124c7d-19bd-45bd-acf9-c30111385e02",
                                                "sense_id": "424c6565-b53c-33c6-8618-236c2c9e1b7f",
                                                "text": "Um unseren Flur zu verschönern, bekam der Heizkörper eine Verkleidung."
                                            },
                                            {
                                                "example_id": "1cad3895-2db4-40f7-ae13-872b844d1327",
                                                "sense_id": "424c6565-b53c-33c6-8618-236c2c9e1b7f",
                                                "text": "„Da gibt es Falltüren im Fußboden, Gegengifte, Verkleidungen, und alles geht wild durcheinander, rennt und entwirrt sich, ohne dem Leser eine Minute Zeit zum Nachdenken zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
