    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b7f965f7-2143-3c85-831f-0c74b4b71ab3",
                    "sense_definition": "Mettre un terme à quelque chose, interrompre le cours d'une action ou d'un processus.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "arret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement tente de <w>stopper</w> la progression de l'épidémie en imposant des règles strictes."
                        },
                        {
                            "text": "Nous devons absolument <w>stopper</w> cette dispute avant qu'elle ne dégénère complètement."
                        }
                    ],
                    "synonyms": [
                        "arrêter"
                    ],
                    "common_phrases": [
                        "stopper l'hémorragie",
                        "stopper la progression"
                    ]
                },
                {
                    "sense_id": "f1e98594-1ef6-347d-94ab-85faefd2a261",
                    "sense_definition": "S'arrêter ou immobiliser un véhicule, un convoi ferroviaire ou une machine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "arret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur a dû <w>stopper</w> net pour éviter un chevreuil sur la chaussée."
                        },
                        {
                            "text": "Une puissante voiture de marque étrangère <w>stoppa</w> au bout de l'avenue avant de repartir."
                        }
                    ],
                    "synonyms": [
                        "arrêter"
                    ],
                    "common_phrases": [
                        "stopper net"
                    ]
                },
                {
                    "sense_id": "1e9f2211-21cf-3fb3-9caa-7ea62bf8222a",
                    "sense_definition": "Recevoir ou essuyer un coup violent ou un projectile.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soldat a <w>stoppé</w> une balle perdue à l'épaule lors de la confrontation."
                        },
                        {
                            "text": "Pendant la bagarre au bar, il a malheureusement <w>stoppé</w> un mauvais coup au visage."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "registre populaire ou argotique"
                        }
                    ]
                },
                {
                    "sense_id": "a376b08b-7fcd-3a18-9e41-82682688f20f",
                    "sense_definition": "Réparer un accroc ou un trou dans un tissu de manière invisible par stoppage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a confié sa veste en laine à une couturière afin de la faire <w>stopper</w> discrètement."
                        },
                        {
                            "text": "L'artisan est parvenu à <w>stopper</w> ce pantalon de costume sans laisser la moindre trace visible."
                        }
                    ],
                    "common_phrases": [
                        "faire stopper"
                    ]
                }
            ]
        }
    ]
