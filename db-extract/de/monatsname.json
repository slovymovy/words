                                        "examples": [
                                            {
                                                "example_id": "3d9f0e13-9a6a-48d0-a647-4b2a80f6ea70",
                                                "sense_id": "30a38a3f-6021-399c-9ae9-1d2504642a5d",
                                                "text": "De pup blijkt een maand oud te zijn."
