                    }
                ],
                "senses": [
                    {
                        "sense_id": "7984e6d8-7f9e-3b6a-b2b3-9e7d8524d45b",
                        "entry_id": "f09c6820-65dd-3d49-b997-797ba824d032",
                        "glosses": [
                            "пронзительный и высокий звук, обычно — крик"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1939f65-bd39-4749-8517-1af97350379d",
                                "sense_id": "7984e6d8-7f9e-3b6a-b2b3-9e7d8524d45b",
                                "text": "Через все окна и двери вламываются арапы с копьями и щитами. Леди, Бетси с визгом бросаются в сторону."
                            },
                            {
                                "example_id": "bd7c470d-b8b4-4afa-8d9e-eb1ede4887b2",
                                "sense_id": "7984e6d8-7f9e-3b6a-b2b3-9e7d8524d45b",
                                "text": "Лишь в порту лебёдок визг обычный, // Новый деррик над углём кряхтит – // В трюмы пароходов заграничных // Грузят лес и камень-апатит."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8a6c90c-84ae-4228-a7f9-14bc020cc255",
                        "source_entry_id": "f09c6820-65dd-3d49-b997-797ba824d032",
                        "source_sense_id": "7984e6d8-7f9e-3b6a-b2b3-9e7d8524d45b",
                        "target_lang_word": "squeal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squeal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8338e796-933c-3ae8-8bc5-fae515bd05a2",
                                        "entry_id": "a9134ee1-e9d7-3273-90ae-a409f150a0f7",
                                        "glosses": [
                                            "A high-pitched sound, such as the scream of a child or a female person, or noisy worn-down brake pads."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9ea632b-75a5-3182-9ae9-6bb8bbe4f7fe",
                                        "entry_id": "a9134ee1-e9d7-3273-90ae-a409f150a0f7",
                                        "glosses": [
                                            "The cry of a pig."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "squeal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8e70ddd-6219-339f-a8f9-431343d55793",
                                        "entry_id": "a46ada7c-20d3-3dd5-a8c6-225089f452df",
                                        "glosses": [
                                            "To scream with a shrill, prolonged sound."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eba0cf1a-93f9-48ce-90ec-64ce3d2209eb",
                                                "sense_id": "b8e70ddd-6219-339f-a8f9-431343d55793",
                                                "text": "The children squealed with delight while opening their Christmas presents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77ba9f30-7f45-3d24-9340-bce9492e13cd",
                                        "entry_id": "a46ada7c-20d3-3dd5-a8c6-225089f452df",
                                        "glosses": [
                                            "To make a squealing noise. (of an object)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e405da50-e6ab-4042-a726-db5ebe01d675",
                                                "sense_id": "77ba9f30-7f45-3d24-9340-bce9492e13cd",
                                                "text": "The brakes squeal terribly."
                                            },
                                            {
                                                "example_id": "73dcfb77-24f3-40c4-abd6-4dbf747fb017",
                                                "sense_id": "77ba9f30-7f45-3d24-9340-bce9492e13cd",
                                                "text": "We continue through suburban Newcastle along the edge of the Tyne, before squealing around the tight curves onto the magnificent High Level bridge, which affords glorious views across Newcastle and along the river before arriving at journey's end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "553b1fcf-d5af-35eb-b4b5-dd15f5a56ef9",
                                        "entry_id": "a46ada7c-20d3-3dd5-a8c6-225089f452df",
                                        "glosses": [
                                            "To give sensitive information about someone to a third party; to rat on someone."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04071781-08b3-4182-9b28-a7b2df681d52",
                                                "sense_id": "553b1fcf-d5af-35eb-b4b5-dd15f5a56ef9",
                                                "text": "You'd better not squeal on me to the cops."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a42f3ca-af6f-432d-b075-9d62717065a8",
                        "source_entry_id": "f09c6820-65dd-3d49-b997-797ba824d032",
                        "source_sense_id": "7984e6d8-7f9e-3b6a-b2b3-9e7d8524d45b",
                        "target_lang_word": "screech",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "screech",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "daa8d9c6-7e23-3afd-ac76-e52218980b20",
                                        "entry_id": "c02639e0-4ad2-33cc-b6f6-7eb9cb785f39",
                                        "glosses": [
                                            "A high-pitched strident or piercing sound, such as that between a moving object and any surface."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad5f27d7-624a-3b19-b6f4-fa6d3b5707d9",
                                        "entry_id": "c02639e0-4ad2-33cc-b6f6-7eb9cb785f39",
                                        "glosses": [
                                            "A harsh, shrill cry, as of one in acute pain or in fright; a shriek; a scream."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cde702a-27ff-3d3c-9513-61728c993354",
                                        "entry_id": "c02639e0-4ad2-33cc-b6f6-7eb9cb785f39",
                                        "glosses": [
                                            "Newfoundland rum."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04a34c53-6253-3dab-994b-b9a120457101",
                                        "entry_id": "c02639e0-4ad2-33cc-b6f6-7eb9cb785f39",
                                        "glosses": [
                                            "A form of home-made rye whiskey made from used oak rye barrels from a distillery."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "screech",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a14b1370-6cc8-3af2-8cd9-ea0625879fa8",
                                        "entry_id": "37f8ae7f-9d1b-35fd-9d3b-4a5f795f97f0",
                                        "glosses": [
                                            "To make such a sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d5f0d23-5b40-47f1-af84-71c9f3688dba",
                                                "sense_id": "a14b1370-6cc8-3af2-8cd9-ea0625879fa8",
                                                "text": "That the night owl should screech before the noonday sun, that the bat should wheel around the bad of beauty […]"
                                            },
                                            {
                                                "example_id": "7fcdea28-71b3-4b99-9072-60664b1a83f1",
                                                "sense_id": "a14b1370-6cc8-3af2-8cd9-ea0625879fa8",
                                                "text": "\"Have you not met them?\" \"No, I have met nothing but three cormorants, which were sitting on a bit of drift-wood screeching.\""
                                            },
                                            {
                                                "example_id": "2a12b58b-8a24-4b63-abdc-532c73b4024a",
                                                "sense_id": "a14b1370-6cc8-3af2-8cd9-ea0625879fa8",
                                                "text": "They said he had caused the fire in some way; be that as it may, he was screeching most horribly."
                                            },
                                            {
                                                "example_id": "147f8880-e7a2-4690-8383-37ec4ee69dd8",
                                                "sense_id": "a14b1370-6cc8-3af2-8cd9-ea0625879fa8",
                                                "text": "The tide was out, and we drew up amid the strong bracing smell of seaweed, with gulls screeching, wheeling around, and gliding on the wind."
                                            },
                                            {
                                                "example_id": "61fcb9e8-05f9-4c88-a3c9-80b488d2683e",
                                                "sense_id": "a14b1370-6cc8-3af2-8cd9-ea0625879fa8",
                                                "text": "AS THE residents of the quiet Midlothian housing estate prepared for the day ahead, the early-morning stillness was disturbed by the sound of screeching brakes and slamming doors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a92842e-7404-3cb5-810a-09fb18770b03",
                                        "entry_id": "37f8ae7f-9d1b-35fd-9d3b-4a5f795f97f0",
                                        "glosses": [
                                            "To travel very fast, as if making the sound of a car that is driving too fast."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "020358bd-4674-415e-9f7d-2252292cfbb0",
                                                "sense_id": "3a92842e-7404-3cb5-810a-09fb18770b03",
                                                "text": "You've got to admire their balls. Real Madrid screeched after them: an entire herd, powerful and co-ordinated, salivating and breathing hard, murder in their eyes. So Barcelona moved the ball on, away from them. Forced back, it was played into Víctor Valdés, the goalkeeper, who slotted it to Carles Puyol, who gave it back again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
