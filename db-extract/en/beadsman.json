                        "glosses": [
                            "A man employed in praying; especially one who prays for another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45bfce02-b3b6-4feb-8936-8e630e9c4596",
                                "sense_id": "90868274-8936-3c72-894b-6f8f6a8d1f1e",
                                "text": "Good Lord Cromwell, stand my friend: exert yourself for Thomas Howard, who is your daily beadsman, your debtor for life."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2723ffb-a941-397b-899c-55a47168a4fe",
                        "entry_id": "9f6ad3e8-7b9f-3a84-9911-4715f22048d9",
                        "glosses": [
                            "A poor man, supported in a beadhouse, and required to pray for the soul of its founder; an almsman."
                        ],
                        "tags": [
                            "England",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "12b958e6-202a-4e99-9e49-e7126d4ef59f",
                                "sense_id": "f2723ffb-a941-397b-899c-55a47168a4fe",
                                "text": "Whereby ye shall bind me to be […]your poor beadsman for ever unto Almighty God."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5014fb1-ff60-3c6f-93fe-d4134cfb2f82",
                        "entry_id": "9f6ad3e8-7b9f-3a84-9911-4715f22048d9",
                        "glosses": [
                            "A public almsman; one who received alms from the king, and was expected in return to pray for the royal welfare and that of the state; a licensed beggar."
