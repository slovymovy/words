{
    "word_family": [
        "seclude",
        "secluded"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe967b3d-7414-3edc-9ebc-0622f70447c4",
                    "sense_definition": "The state of being away from other people or society; solitude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_being_alone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The writer moved to a cabin in the woods to enjoy the <w>seclusion</w> of nature.",
                            "target_lang_translations": {
                                "zh": "这位作家搬进了森林里的小木屋，以享受大自然的<w>隐居</w>生活。"
                            }
                        },
                        {
                            "text": "She found peace and quiet in her voluntary <w>seclusion</w> from the busy city life.",
                            "target_lang_translations": {
                                "zh": "她主动选择远离繁忙的城市生活，在<w>独处</w>中找到了宁静。"
                            }
                        }
                    ],
                    "synonyms": [
                        "solitude",
                        "isolation"
                    ],
                    "common_phrases": [
                        "enjoy the seclusion",
                        "voluntary seclusion"
                    ],
                    "target_lang_definitions": {
                        "zh": "远离他人或社会的状态；独处。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "隐居",
                                "target_lang_sense_clarification": "指远离尘世，过清静的生活。"
                            },
                            {
                                "target_lang_word": "独处",
                                "target_lang_sense_clarification": "指一个人待着，不与他人接触。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "281f4e15-399c-348b-9610-964b04218667",
                    "sense_definition": "The act of keeping someone apart from others, often for safety or control.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state_of_being_alone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was placed in <w>seclusion</w> to prevent them from harming themselves.",
                            "target_lang_translations": {
                                "zh": "为了防止病人伤害自己，他们被安排在<w>隔离</w>室中。"
                            }
                        },
                        {
                            "text": "Strict <w>seclusion</w> protocols were enforced during the medical emergency.",
                            "target_lang_translations": {
                                "zh": "在医疗紧急情况下，执行了严格的<w>隔离</w>规程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "isolation"
                    ],
                    "common_phrases": [
                        "placed in seclusion"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某人与他人隔离开来，通常是为了安全或控制。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "隔离",
                                "target_lang_sense_clarification": "指为了防止接触或传播而将人分开。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d525b5f-9259-3952-9eac-f0eacd494778",
                    "sense_definition": "A private, quiet, or isolated place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was a perfect <w>seclusion</w> for reading and meditation.",
                            "target_lang_translations": {
                                "zh": "这座花园是阅读和冥想的绝佳<w>隐蔽处</w>。"
                            }
                        },
                        {
                            "text": "They searched for a quiet <w>seclusion</w> away from the crowded tourist areas.",
                            "target_lang_translations": {
                                "zh": "他们寻找一处远离拥挤旅游区的安静<w>幽静之地</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "solitude"
                    ],
                    "common_phrases": [
                        "perfect seclusion"
                    ],
                    "target_lang_definitions": {
                        "zh": "一个私密、安静或偏僻的地方。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "隐蔽处",
                                "target_lang_sense_clarification": "指安静且不易被发现的地方。"
                            },
                            {
                                "target_lang_word": "幽静之地",
                                "target_lang_sense_clarification": "指环境清幽、远离喧嚣的场所。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92225303-ab8c-3ffb-8408-f2c6e367dde5",
                    "sense_definition": "The final stage of an extratropical cyclone's life cycle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meteorology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meteorologists monitored the storm as it entered the phase of warm <w>seclusion</w>.",
                            "target_lang_translations": {
                                "zh": "气象学家监测着风暴，因为它进入了<w>暖核隔离</w>阶段。"
                            }
                        },
                        {
                            "text": "The <w>seclusion</w> of the warm air mass indicates the cyclone is weakening.",
                            "target_lang_translations": {
                                "zh": "暖气团的<w>暖核隔离</w>表明气旋正在减弱。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "warm seclusion"
                    ],
                    "target_lang_definitions": {
                        "zh": "温带气旋生命周期的最后阶段。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "暖核隔离",
                                "target_lang_sense_clarification": "气象学术语，指暖空气被冷空气包围并脱离气旋中心。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}