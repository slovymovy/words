        "pl-extract.jsonl": [
            {
                "entry_id": "32cf41cc-8fc8-375c-bb2b-5119163fd451",
                "word": "pomadka",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "441559dc-a91c-3492-b460-b8f17d2b1e70",
                        "entry_id": "32cf41cc-8fc8-375c-bb2b-5119163fd451",
                        "glosses": [
                            "kosmetyk do malowania ust"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "830b1ade-d141-45ff-84c4-87d1b03b0653",
                                "sense_id": "441559dc-a91c-3492-b460-b8f17d2b1e70",
                                "text": "Przed wyjściem z domu zawsze pokrywam usta pomadką."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1d650d8e-ca9b-3374-934e-fe8601ff33fd",
                        "entry_id": "32cf41cc-8fc8-375c-bb2b-5119163fd451",
                        "glosses": [
                            "cukierek z miękkiej masy mlecznej lub czekoladowej"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8d643544-5596-4abe-bc6d-282192efa512",
                                "sense_id": "1d650d8e-ca9b-3374-934e-fe8601ff33fd",
                                "text": "Publiczność zrobiła się kapryśna, nie wiadomo, czy będzie oklaskiwać lwa i rzucać pomadki deserowe w jego zbryzganą posoką paszczę, czy też obrzuci kwiatami obgryzione do czysta kości męczennika i będzie na nie głosować w wyborach."
                            },
                            {
                                "example_id": "af67520a-0a2c-4be5-b20b-939fd58c67e6",
                                "sense_id": "1d650d8e-ca9b-3374-934e-fe8601ff33fd",
                                "text": "Jeżeli chce się mieć śnieżno białe pomadki, trzeba po wylaniu massy, gdy trochę przestygnie, wymieszać ją bardzo dobrze kopystką, a potem dopiero rozciągnąć nożem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fe3b2ff-fdfd-4508-a88f-676f8fafe87c",
                        "source_entry_id": "32cf41cc-8fc8-375c-bb2b-5119163fd451",
                        "source_sense_id": "441559dc-a91c-3492-b460-b8f17d2b1e70",
                        "target_lang_word": "lipstick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lipstick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1823a806-6b27-3236-bcfa-617d05055ff1",
                                        "entry_id": "0db0337c-a5ed-3277-9037-5975abddfe6b",
                                        "glosses": [
                                            "Makeup for the lips."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eb79f71-9990-45cb-bbfb-169ee8ed5b18",
                                                "sense_id": "1823a806-6b27-3236-bcfa-617d05055ff1",
                                                "text": "Are you wearing any lipstick today?"
                                            },
                                            {
                                                "example_id": "dddbe88c-9dee-48e5-963c-6628abac8ff4",
                                                "sense_id": "1823a806-6b27-3236-bcfa-617d05055ff1",
                                                "text": "In fact, I just saw the movie Shirley Valentine (for the umpteenth time!), and couldn't even look at the adult Marjorie Majors without seeing Patsy and her boofed up hair and red lipstick and long cigarette holder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5338ea4-1828-3530-8dbe-f8a016e71ed9",
                                        "entry_id": "0db0337c-a5ed-3277-9037-5975abddfe6b",
                                        "glosses": [
                                            "A stick of this makeup."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "902ede44-265d-4494-86b7-497cbe6b18b1",
                                                "sense_id": "b5338ea4-1828-3530-8dbe-f8a016e71ed9",
                                                "text": "I'd like three lipsticks in this shade."
                                            },
                                            {
                                                "example_id": "7db86f9c-4a71-40de-8b7d-ffa01e55bbec",
                                                "sense_id": "b5338ea4-1828-3530-8dbe-f8a016e71ed9",
                                                "text": "She darkens up her eyebrows with it and then runs a tube of pink lipstick over her mouth. She immediately wipes it off with the palm of her hand. She should have black lipstick. A true ninja woman would wear black lipstick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e5d391b-e6d5-3286-a216-15772a9d3033",
                                        "entry_id": "0db0337c-a5ed-3277-9037-5975abddfe6b",
                                        "glosses": [
                                            "A dog's penis."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "750bbef4-232a-4328-bad7-8e4852065f8b",
                                                "sense_id": "2e5d391b-e6d5-3286-a216-15772a9d3033",
                                                "text": "“So she storms off, yelling at me, ‘Tell your dog to put his lipstick back in its case!’ and that dog and I just stared after them. Both of us were totally smitten.”"
                                            },
                                            {
                                                "example_id": "ce626c06-bf5d-4efe-99af-9e5a6d0855ab",
                                                "sense_id": "2e5d391b-e6d5-3286-a216-15772a9d3033",
                                                "text": "I looked over at our new house-wolf, hoping for a connection, but it was too soon. I felt nothing but resentment. What I saw, however, was something I would have to look away from regularly. He had his lipstick out."
                                            },
                                            {
                                                "example_id": "03a555e8-751c-463b-8026-00cbf2102876",
                                                "sense_id": "2e5d391b-e6d5-3286-a216-15772a9d3033",
                                                "text": "“Speaking of loyalty…” I give Shit a nasty side-eye but he only pants at me, eyes slightly glazed. That’s when I realize his lipstick is all the way out.\n “Hey, stop turning my dog on,” I tell Mac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18419f15-eea2-3c31-8f0f-5fc9f8df8f53",
                                        "entry_id": "0db0337c-a5ed-3277-9037-5975abddfe6b",
                                        "glosses": [
                                            "Ellipsis of lipstick lesbian."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe2f3beb-f6f4-49aa-a2b4-f805848819a0",
                                                "sense_id": "18419f15-eea2-3c31-8f0f-5fc9f8df8f53",
                                                "text": "Joya was what they called a Lipstick Lesbian. Without wandering too far through the minefield that gay culture can be for the moderately indoctrinated, let stand the observation that this thriving local fauna (The Lipsticks, that is) struck some observers as representing a step up (or forward) in the social evolution of female homosexuality."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lipstick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13df0c6b-5357-3863-9cab-918326863b88",
                                        "entry_id": "1ad1a139-dc79-3ccb-a035-43c9d2065346",
                                        "glosses": [
                                            "To apply lipstick to; to paint with lipstick."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6073afc-23e6-4d05-ab8c-050dc0861651",
                                                "sense_id": "13df0c6b-5357-3863-9cab-918326863b88",
                                                "text": "She had even white teeth and a mouth that needed no lipsticking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac3a9cff-5f99-4469-afa0-432b079324bf",
                        "source_entry_id": "32cf41cc-8fc8-375c-bb2b-5119163fd451",
                        "source_sense_id": "441559dc-a91c-3492-b460-b8f17d2b1e70",
                        "target_lang_word": "rouge à lèvres",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rouge à lèvres",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3e64742-c260-331d-990d-4ce1a8d82803",
                                        "entry_id": "1dffe1c1-c1df-3835-82aa-32964fbd0f0c",
                                        "glosses": [
                                            "Produit de maquillage coloré ou non (→ voir brillant à lèvres) pour souligner les lèvres."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "399f7ea9-c725-4289-93d9-7a3b079994da",
                                                "sense_id": "c3e64742-c260-331d-990d-4ce1a8d82803",
                                                "text": "J’ai badigeonné mes lèvres d’1 couche de rouge à lèvres « Carmin profond » acheté il y a 20 ans pour le mariage d’une cousine. La longévité de ces choses ineptes, quand des vies valeureuses périssent chaque jour, ne laissera jamais de me confondre."
                                            },
                                            {
                                                "example_id": "e311f83a-53b2-4fa5-8acd-573edb03d018",
                                                "sense_id": "c3e64742-c260-331d-990d-4ce1a8d82803",
                                                "text": "Le rouge à lèvres laissait des demi-cercles sur les verres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af9e541d-c27f-3d49-af2b-609bd761000b",
                                        "entry_id": "1dffe1c1-c1df-3835-82aa-32964fbd0f0c",
                                        "glosses": [
                                            "Bâtonnet gras pour se maquiller la bouche."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5734bcf4-1658-4a81-b759-2bfc326b59a0",
                                                "sense_id": "af9e541d-c27f-3d49-af2b-609bd761000b",
                                                "text": "Il lui arrivait tout de même de se rebeller, elle suivait un régime, s’efforçait de maigrir, s'achetait un rouge à lèvres et se coupait une jupe droite avec un pli Dior qui mettait en valeur ses jambes fuselées."
                                            },
                                            {
                                                "example_id": "dbbc7211-58bf-4c03-a8f5-e88e8bfdf445",
                                                "sense_id": "af9e541d-c27f-3d49-af2b-609bd761000b",
                                                "text": "— Lorsque j’ai présenté mon nouveau rouge à lèvres, les femmes m’ont demandé s’il était à base de tomate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61acde54-9afa-46fb-ae12-f8eec1395120",
                        "source_entry_id": "32cf41cc-8fc8-375c-bb2b-5119163fd451",
                        "source_sense_id": "441559dc-a91c-3492-b460-b8f17d2b1e70",
                        "target_lang_word": "Lippenstift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lippenstift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "410f8650-491a-3a5d-afbb-66fb4b889193",
                                        "entry_id": "af57ee38-6459-3da9-9979-5958b11df339",
                                        "glosses": [
                                            "Kosmetikutensil zum Färben der Lippen, das überwiegend von Frauen benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3795046f-e0fa-4de2-b563-7419580e49c1",
                                                "sense_id": "410f8650-491a-3a5d-afbb-66fb4b889193",
                                                "text": "Nach der zärtlichen Begegnung stellte Herr Bleibein fest, dass ihr Lippenstift nicht kussecht war."
                                            },
                                            {
                                                "example_id": "cc92d34f-5057-4c6f-be54-85cf64fdab81",
                                                "sense_id": "410f8650-491a-3a5d-afbb-66fb4b889193",
                                                "text": "Was kosten die Lippenstifte im Dreierpack?"
                                            },
                                            {
                                                "example_id": "0618bde2-9a08-4aef-b928-d324773cd556",
                                                "sense_id": "410f8650-491a-3a5d-afbb-66fb4b889193",
                                                "text": "„Lippenstift ist natürlich nicht gleich Lippenstift, für den knallroten Mund muss man regelrecht geboren sein, er steht nicht jeder Frau.“"
                                            },
                                            {
                                                "example_id": "91f49458-6aa8-4a4a-814f-8f69b6f8b45b",
                                                "sense_id": "410f8650-491a-3a5d-afbb-66fb4b889193",
                                                "text": "„Mit einem Kleenex wischte ich mir das Gesicht ab, überlegte es mir anders und trug meinen rosafarbenen Lippenstift wieder auf.“"
                                            },
                                            {
                                                "example_id": "3ae8f618-312c-4885-bee3-d1b2de6cdba8",
                                                "sense_id": "410f8650-491a-3a5d-afbb-66fb4b889193",
                                                "text": "„Viele Artikel des täglichen Bedarfs, vom Lippenstift bis zum Abflußreiniger, dürfen nicht in den Handel gebracht werden, bevor ihre gesundheitliche Unbedenklichkeit nachgewiesen ist.“"
                                            },
                                            {
                                                "example_id": "02f3f9ca-1434-4d15-a2ab-21792b5965e5",
                                                "sense_id": "410f8650-491a-3a5d-afbb-66fb4b889193",
                                                "text": "„Sie liebte rosafarbenen Lippenstift, ohne je einen besessen zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
