        "nl-extract.jsonl": [
            {
                "entry_id": "f5f11637-d312-3b5e-9c7a-64e6916faca5",
                "word": "citadel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "2f032029-3814-406d-aa43-48673bfb1238",
