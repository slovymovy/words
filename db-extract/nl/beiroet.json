                    },
                    {
                        "translation_id": "29c0a857-8fb1-4145-84e7-4bbe16bd272e",
                        "source_entry_id": "f53b9462-5821-3531-9138-264720adcb6c",
                        "source_sense_id": "456969bf-d4e5-3da0-8f2e-72f29e200641",
                        "source_sense_description": "hoofdstad van Libanon",
                        "target_lang_word": "Beirut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beirut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                        "entry_id": "fa324aa0-3977-3965-9a14-bb54f48bc4d1",
                                        "glosses": [
                                            "Hauptstadt des Libanons"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2a53371-7a25-449d-b58a-63aa37d8a624",
                                                "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                                "text": "„In Beirut war eine Autobombe explodiert, und nun zeigten sie die zertrümmerten Häuser, die weinenden Augenzeugen, die zerrissenen Leichen.“"
                                            },
                                            {
                                                "example_id": "b455c09a-9b54-4607-a8e7-83705d9d2c57",
                                                "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                                "text": "„Diese Süßigkeiten da habe ich letzte Woche aus Beirut mitgebracht.“"
                                            },
                                            {
                                                "example_id": "eceb9374-c8fa-4e60-9966-b29f7ff0476d",
                                                "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                                "text": "„Einen ganzen Monat verbrachte ich in Beirut damit, durch die Stadt zu streifen, sie kennenzulernen.“"
                                            },
                                            {
                                                "example_id": "3824beae-c4b3-4d62-9b15-85b2f9336970",
                                                "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                                "text": "„Die jüngsten Turbulenzen in Beirut nähren aber offenbar so sehr die Furcht vor einer neuen bürgerkriegsartigen Eskalation, dass beide Führer sich entschlossen haben, in einer gemeinsamen Mission die Gemüter im Libanon zu beruhigen.“"
                                            },
                                            {
                                                "example_id": "b659d9c0-2793-4c88-ad7b-f0f6ff566f26",
                                                "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                                "text": "„Wenige Tage zuvor hatten der saudische König und der syrische Diktator Beirut besucht, um vor Abenteuern zu warnen.“"
                                            },
                                            {
                                                "example_id": "480e7df7-43b7-4ffa-a689-d5fa9047ef1b",
                                                "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                                "text": "„Der Kinofilm Caramel von Regisseurin und Hauptdarstellerin Nadine Labaki spielt in einem Beauty-Salon in Beirut und zeigt das Alltagsleben von fünf Frauen im Libanon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77408be7-7cdc-422c-84a9-f6c3eb91fe9b",
                        "source_entry_id": "f53b9462-5821-3531-9138-264720adcb6c",
