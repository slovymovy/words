                "senses": [
                    {
                        "sense_id": "72945352-676b-3ef3-9e65-2e909dcabc6b",
                        "entry_id": "38d7314a-6be8-35a4-8797-fce1be690a30",
                        "glosses": [
                            "Par temps couvert, bref moment où une discontinuité de la couverture nuageuse laisse le soleil briller de tout son éclat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72de1420-a604-4c66-bc35-f8a27e037542",
                                "sense_id": "72945352-676b-3ef3-9e65-2e909dcabc6b",
                                "text": "Bien que, par intervalles, de brèves et pâles soleillées courussent sur les chemins défoncés, sur les prairies semées de flaques miroitantes, on pressentait que l'accalmie serait de peu de durée, et que l'averse recommencerait avant la fin du jour."
                            },
                            {
                                "example_id": "ba5d2004-4295-436e-9a8e-c0c42a3c87a7",
                                "sense_id": "72945352-676b-3ef3-9e65-2e909dcabc6b",
                                "text": "Dans la tiédeur molle d'une soleillée d'automne."
                            },
                            {
                                "example_id": "dd0b6f08-bdeb-45d3-9a79-8e6f274e8faf",
                                "sense_id": "72945352-676b-3ef3-9e65-2e909dcabc6b",
                                "text": "Malgré les soleillées qui précisaient les dessins délicats des ramilles s'enchevêtrant, la forêt de la Côte, dominant le village, restait maussade et grise."
                            }
                        ]
                    }
