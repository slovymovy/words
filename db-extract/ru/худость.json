                ],
                "senses": [
                    {
                        "sense_id": "010c23a7-3ce8-3e7f-b6c7-d6a618167c8f",
                        "entry_id": "c45340cd-1a1f-3b43-bb66-403ac6de6cc7",
                        "glosses": [
                            "разг. свойство по значению прилагательного худой; низкое качество чего-либо; отсутствие положительных или желательных качеств"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66003fa-1e6a-475d-bf6e-4b7aebae076f",
                                "sense_id": "010c23a7-3ce8-3e7f-b6c7-d6a618167c8f",
                                "text": "Несмотря на нашу худость, мы являемся избранниками Божиими."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1d2dd2a-dbca-352c-882b-aa4d8bf2d4cc",
                        "entry_id": "c45340cd-1a1f-3b43-bb66-403ac6de6cc7",
                        "glosses": [
                            "разг. свойство по значению прилагательного худой; ветхость, изношенность, дырявость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58e4af67-60d9-41a4-a989-bfdf5fdcfb10",
                                "sense_id": "b1d2dd2a-dbca-352c-882b-aa4d8bf2d4cc",
                                "text": "На якорь, за худостью каната, не решались стать и потому, оставаясь в дрейфе, были волнами многократно накрываемы."
                            }
                        ]
                    }
