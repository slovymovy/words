                "senses": [
                    {
                        "sense_id": "e8f561a4-8de9-387d-a5e0-2e8dc602f1ed",
                        "entry_id": "99b48db0-69f6-36e5-9f69-8811d1f838ef",
                        "glosses": [
                            "A building, shed, or room for horses and cattle; a stable."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cc2ecd40-a30e-43c1-9e07-61ab076785c6",
                                "sense_id": "e8f561a4-8de9-387d-a5e0-2e8dc602f1ed",
                                "text": "There was a very fine house and a great deal of stabling; we went into the yard through a stone gateway, and John asked for Mr. York."
                            },
                            {
                                "example_id": "d2822895-ab7f-4bd9-a70b-708c7024a968",
                                "sense_id": "e8f561a4-8de9-387d-a5e0-2e8dc602f1ed",
                                "text": "I forget how much stabling there is, but we always had a lot of horses there, twenty-five or thirty, and yet there always seemed to be plenty of room, and plenty of work for more."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0d77a73-b775-4ce0-a5f6-0f272331e810",
                        "source_entry_id": "99b48db0-69f6-36e5-9f69-8811d1f838ef",
                        "source_sense_id": "e8f561a4-8de9-387d-a5e0-2e8dc602f1ed",
                        "source_sense_description": "stable",
                        "target_lang_word": "Stallung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
