                ],
                "senses": [
                    {
                        "sense_id": "69b9a1ea-4ef9-3826-b7ab-e7cc5714d9f0",
                        "entry_id": "1f7d3fe7-fa3c-3af8-b987-c08d673d7913",
                        "glosses": [
                            "Atteindre tout juste, frôler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94e6cf5b-389b-4171-87ed-166d7ab19ce4",
                                "sense_id": "69b9a1ea-4ef9-3826-b7ab-e7cc5714d9f0",
                                "text": "Proches de la vague, ils la tangentent, la déchirent légèrement et remontent décrire à nouveau leurs cercles qui s’entrecroisent."
                            },
                            {
                                "example_id": "1e8c6be9-5803-499a-8dd0-cb0632f9655e",
                                "sense_id": "69b9a1ea-4ef9-3826-b7ab-e7cc5714d9f0",
                                "text": "La ministre de l’Économie, Christine Lagarde, a affirmé dimanche, sur France 3, que la croissance française devrait « tangenter les 2% »."
                            },
                            {
                                "example_id": "45a46fe1-4862-49c2-ac5a-f514a43fb447",
                                "sense_id": "69b9a1ea-4ef9-3826-b7ab-e7cc5714d9f0",
                                "text": "Esprit assez littéraire, M. Mélenchon pratique volontiers ce que les linguistes nomment le verbe performatif – ces énoncés où le dire équivaut au faire, jusqu'à tangenter parfois une bouffée de wishful thinking."
                            }
                        ]
                    }
