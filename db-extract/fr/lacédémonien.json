        "fr-extract.jsonl": [
            {
                "entry_id": "8aac34ba-694e-3897-85e9-69710885bea6",
                "word": "lacédémonien",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "da96ef18-9721-4096-adaa-8345ee2814ec",
                        "entry_id": "8aac34ba-694e-3897-85e9-69710885bea6",
                        "tags": [
