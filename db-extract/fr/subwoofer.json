                                            "clipping",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec076574-311a-4907-b489-9ea70216a919",
                                                "sense_id": "16abc435-bbc3-3f52-968f-f4f0ce07fd74",
                                                "text": "[…] roleplay where a sub or bottom takes care of a top's bodily and hygiene needs […]"
                                            },
                                            {
                                                "example_id": "7807c31f-c198-4bfd-9ce6-0119d46b00ac",
                                                "sense_id": "16abc435-bbc3-3f52-968f-f4f0ce07fd74",
                                                "text": "\"It means that I'm both a sub and a dom.\" \"Submissive and dominant,\" I said. He nodded."
                                            },
                                            {
                                                "example_id": "c778c888-9fa7-4afb-a96b-bb7d2d7af179",
                                                "sense_id": "16abc435-bbc3-3f52-968f-f4f0ce07fd74",
                                                "text": "Typically a dom and a sub have a more or less standard routine that they like to go through all the time."
                                            },
                                            {
                                                "example_id": "8feef9ed-3f7e-434a-98c9-cbd1a63cfdd5",
                                                "sense_id": "16abc435-bbc3-3f52-968f-f4f0ce07fd74",
                                                "text": "We're not that kind of sub!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5686f1ab-34b9-3152-aa2a-12ab4abfac8d",
                                        "entry_id": "00cba8d9-c51e-3d9f-94a6-9105100353c2",
                                        "glosses": [
                                            "Clipping of subordinate"
                                        ],
                                        "tags": [
