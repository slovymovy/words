                "senses": [
                    {
                        "sense_id": "13a3e0c8-bbaf-3654-9048-92531d0fe311",
                        "entry_id": "b947d7c4-8308-371c-ab8a-a4098ede88f5",
                        "glosses": [
                            "Criminel opérant au sein de l’industrie pornographique, qui imite ou s’inspire de ses codes et de ses modes opératoires, ou bien dont il est commanditaire et complice par sa consommation de pornographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "209bd79f-6d04-4a54-bdbc-72f4e601e451",
                                "sense_id": "13a3e0c8-bbaf-3654-9048-92531d0fe311",
                                "text": "Sur la majorité des sites pornographiques, les pornocriminels classent les femmes dans des catégories profondément racistes et coloniales, et leur attribuent des spécificités en fonction de leur origine ethnique, réelle ou supposée."
                            },
                            {
                                "example_id": "409b66ad-9e51-4c6e-a712-aa9bdf437422",
                                "sense_id": "13a3e0c8-bbaf-3654-9048-92531d0fe311",
                                "text": "La mise en examen récente de dirigeants de sites pornos laisse espérer la fin de l’impunité pour les pornocriminels."
                            }
                        ]
                    }
