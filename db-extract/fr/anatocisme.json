                        "entry_id": "758299ae-9ae2-31d3-bf9d-bf604d0d6a25",
                        "glosses": [
                            "Capitalisation des intérêts d’une somme due."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc6750d4-2c2a-420c-8250-dbadb70b9e19",
                                "sense_id": "c816c53d-452d-3909-b6bb-9659bc8f8330",
                                "text": "Pendant longtemps, l’anatocisme a été interdit : on le considérait comme usuraire."
                            },
                            {
                                "example_id": "37dde164-44e1-48ea-8400-e0de78c170f9",
                                "sense_id": "c816c53d-452d-3909-b6bb-9659bc8f8330",
                                "text": "Leur comptabilité impitoyable ne fait pas grâce d'un centime, et les mystères de l’anatocisme ont bien vite fait doubler la dette du nhaqué, sans qu'il puisse en soupçonner le mécanisme."
                            }
                        ]
                    }
