{
    "word_family": [
        "shine",
        "shiner",
        "shininess"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5bf8dbb1-ae30-38e9-b542-55a2766aa9d7",
                    "sense_definition": "Reflecting light; having a smooth, glossy, or polished surface.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reflecting_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She brushed her hair until it was smooth and <w>shiny</w>.",
                            "target_lang_translations": {
                                "ru": "Она расчесывала волосы, пока они не стали гладкими и <w>блестящими</w>.",
                                "zh": "她把头发梳得又顺又<w>亮</w>。"
                            }
                        },
                        {
                            "text": "The <w>shiny</w> new car reflected the sunlight in the driveway.",
                            "target_lang_translations": {
                                "ru": "<w>Блестящая</w> новая машина отражала солнечный свет на подъездной дорожке.",
                                "zh": "那辆<w>闪亮</w>的新车在车道上反射着阳光。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shining",
                        "mirrorlike",
                        "glossy",
                        "polished"
                    ],
                    "antonyms": [
                        "dull",
                        "matte",
                        "flat"
                    ],
                    "common_phrases": [
                        "shiny object",
                        "shiny hair",
                        "shiny surface",
                        "shiny new"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отражающий свет; имеющий гладкую, глянцевую или полированную поверхность.",
                        "zh": "反射光线的；具有光滑、有光泽或抛光表面的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блестящий",
                                "target_lang_sense_clarification": "отражающий свет"
                            },
                            {
                                "target_lang_word": "глянцевый",
                                "target_lang_sense_clarification": "о поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪亮的",
                                "target_lang_sense_clarification": "反射光线的"
                            },
                            {
                                "target_lang_word": "有光泽的",
                                "target_lang_sense_clarification": "指表面质感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15558b6d-4c14-386d-b591-31a8173beb49",
                    "sense_definition": "Bright, luminous, or clear; often used to describe weather or the sky.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emitting_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>shiny</w> day with not a single cloud in the blue sky.",
                            "target_lang_translations": {
                                "ru": "Это был <w>солнечный</w> день, и на голубом небе не было ни облачка.",
                                "zh": "那是一个<w>晴朗</w>的日子，蓝天上没有一丝云彩。"
                            }
                        },
                        {
                            "text": "The moon looked big and <w>shiny</w> above the dark forest.",
                            "target_lang_translations": {
                                "ru": "Луна выглядела большой и <w>сияющей</w> над темным лесом.",
                                "zh": "月亮在黑暗的森林上方显得又大又<w>明亮</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shining",
                        "relucent"
                    ],
                    "antonyms": [
                        "dark",
                        "dull"
                    ],
                    "common_phrases": [
                        "shiny day",
                        "shiny night"
                    ],
                    "target_lang_definitions": {
                        "ru": "Яркий, светящийся или ясный; часто используется для описания погоды или неба.",
                        "zh": "明亮、发光或清澈的；常用于描述天气或天空。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солнечный",
                                "target_lang_sense_clarification": "о погоде или дне"
                            },
                            {
                                "target_lang_word": "сияющий",
                                "target_lang_sense_clarification": "излучающий свет"
                            },
                            {
                                "target_lang_word": "ясный",
                                "target_lang_sense_clarification": "о небе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晴朗的",
                                "target_lang_sense_clarification": "指天气或日子"
                            },
                            {
                                "target_lang_word": "明亮的",
                                "target_lang_sense_clarification": "指发光体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb68d36e-f323-3903-a1eb-c778fb111889",
                    "sense_definition": "Excellent, remarkable, or very good.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't worry about the schedule; everything is <w>shiny</w>.",
                            "target_lang_translations": {
                                "ru": "Не волнуйся о расписании, всё <w>отлично</w>.",
                                "zh": "别担心日程安排，一切都<w>没问题</w>。"
                            }
                        },
                        {
                            "text": "We made a <w>shiny</w> deal that should benefit everyone involved.",
                            "target_lang_translations": {
                                "ru": "Мы заключили <w>блестящую</w> сделку, которая должна принести пользу всем участникам.",
                                "zh": "我们达成了一项<w>出色</w>的协议，应该会让所有相关方受益。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often associated with the TV series Firefly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный, замечательный или очень хороший.",
                        "zh": "优秀的、卓越的或非常好的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отличный",
                                "target_lang_sense_clarification": "превосходный"
                            },
                            {
                                "target_lang_word": "блестящий",
                                "target_lang_sense_clarification": "в переносном смысле: великолепный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极好的",
                                "target_lang_sense_clarification": "指事物状态"
                            },
                            {
                                "target_lang_word": "出色的",
                                "target_lang_sense_clarification": "指表现或结果"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19c432f3-6c69-315d-a06b-4a6884fef10a",
                    "sense_definition": "Anything that glitters or reflects light; a small trinket or bauble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magpie is known for stealing <w>shinies</w> and hiding them in its nest.",
                            "target_lang_translations": {
                                "ru": "Сороки известны тем, что воруют <w>блестяшки</w> и прячут их в своих гнездах.",
                                "zh": "喜鹊以偷窃<w>闪光物</w>并藏在窝里而闻名。"
                            }
                        },
                        {
                            "text": "She keeps a box of cheap <w>shinies</w> and jewelry on her dresser.",
                            "target_lang_translations": {
                                "ru": "Она хранит шкатулку с дешевыми <w>побрякушками</w> и украшениями на комоде.",
                                "zh": "她在梳妆台上放了一盒廉价的<w>小玩意儿</w>和首饰。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-либо сверкающее или отражающее свет; мелкая безделушка или украшение.",
                        "zh": "任何闪闪发光或反射光线的物体；小饰品或廉价装饰品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блестяшка",
                                "target_lang_sense_clarification": "разг. блестящий предмет"
                            },
                            {
                                "target_lang_word": "побрякушка",
                                "target_lang_sense_clarification": "дешевое украшение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪光物",
                                "target_lang_sense_clarification": "指闪亮的小东西"
                            },
                            {
                                "target_lang_word": "小玩意儿",
                                "target_lang_sense_clarification": "指廉价装饰品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c063f50c-128d-3f2c-bb1a-003c94f373f5",
                    "sense_definition": "A desirable collectible item, such as a rare trading card or a special version of a character in a game.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was excited to find a rare <w>shiny</w> in the pack of cards he bought.",
                            "target_lang_translations": {
                                "ru": "Он был в восторге, найдя редкую <w>блестящую карту</w> в купленной колоде.",
                                "zh": "他很兴奋地在他买的卡包里发现了一张稀有的<w>闪卡</w>。"
                            }
                        },
                        {
                            "text": "Collectors are willing to pay a lot of money for these <w>shinies</w>.",
                            "target_lang_translations": {
                                "ru": "Коллекционеры готовы платить большие деньги за эти <w>редкости</w>.",
                                "zh": "收藏家们愿意花大价钱购买这些<w>稀有收藏品</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in gaming contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Желанный предмет коллекционирования, например, редкая карта или особая версия персонажа в игре.",
                        "zh": "令人向往的收藏品，例如稀有的集换式卡牌或游戏中的特殊版本角色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "редкий экземпляр",
                                "target_lang_sense_clarification": "коллекционный предмет"
                            },
                            {
                                "target_lang_word": "шайни",
                                "target_lang_sense_clarification": "сленг геймеров"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪卡",
                                "target_lang_sense_clarification": "指游戏或卡牌中的稀有闪亮版本"
                            },
                            {
                                "target_lang_word": "稀有收藏品",
                                "target_lang_sense_clarification": "指具有收藏价值的物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6abdb84e-a214-38c4-91c0-7330ff763c97",
                    "sense_definition": "A person who works at a desk, often used disparagingly by field workers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers in the field often complain that the <w>shinies</w> at headquarters don't understand the reality of war.",
                            "target_lang_translations": {
                                "ru": "Солдаты на передовой часто жалуются, что <w>штабные крысы</w> в штабе не понимают реалий войны.",
                                "zh": "前线士兵常抱怨总部那些<w>坐办公室的</w>根本不懂战争的现实。"
                            }
                        },
                        {
                            "text": "He didn't want to become just another <w>shiny</w> pushing paper all day.",
                            "target_lang_translations": {
                                "ru": "Он не хотел становиться очередным <w>бумагомарателем</w>, перекладывающим бумажки весь день.",
                                "zh": "他不想成为另一个整天只会处理文件的<w>文牍主义者</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, работающий за письменным столом; часто используется пренебрежительно работниками «в поле».",
                        "zh": "在办公室工作的人，常被外勤人员贬义地使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штабная крыса",
                                "target_lang_sense_clarification": "военный сленг"
                            },
                            {
                                "target_lang_word": "бумагомаратель",
                                "target_lang_sense_clarification": "пренебрежительно о бюрократе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坐办公室的",
                                "target_lang_sense_clarification": "指文职人员"
                            },
                            {
                                "target_lang_word": "文牍主义者",
                                "target_lang_sense_clarification": "贬义，指只管文书工作的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}