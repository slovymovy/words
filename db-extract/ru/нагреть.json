                                "sense_id": "46f14368-d400-3fb6-a4a2-5b1df7ea4204",
                                "text": "Незнако́мец нагре́л меня́ на сто рубле́й.",
                                "translation": "A stranger swindled me out of a hundred rubles.",
                                "english": "A stranger swindled me out of a hundred rubles."
                            }
