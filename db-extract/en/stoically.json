                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fea1c111-5a12-4931-9961-57dd5d3233cc",
                        "entry_id": "5b3d04fb-bc98-3f28-a717-df4f91142793",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more stoically"
                    },
                    {
                        "form_id": "40cb0660-419f-4973-84cc-e94aaaaa2a84",
                        "entry_id": "5b3d04fb-bc98-3f28-a717-df4f91142793",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most stoically"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "babfaea2-0c03-35f3-b966-409d3622f01c",
                        "entry_id": "5b3d04fb-bc98-3f28-a717-df4f91142793",
                        "glosses": [
                            "In a manner that endures pain and hardship without outwardly showing suffering or expressing complaint."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b503d150-87fe-4a55-a967-4f6cd6bceb2c",
                                "sense_id": "babfaea2-0c03-35f3-b966-409d3622f01c",
                                "text": "Frank Connor look the news stoically and, except for a sudden and nearly unnoticed grimace, with no outward show of emotion."
                            }
                        ]
                    },
                    {
                        "sense_id": "d646d0f5-45ae-342f-8bb0-8d961ae2d328",
                        "entry_id": "5b3d04fb-bc98-3f28-a717-df4f91142793",
                        "glosses": [
                            "In an unfeeling manner that inwardly is unaffected by pain or distress."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79288a3e-30cd-4710-a8ed-6af613aed016",
                                "sense_id": "d646d0f5-45ae-342f-8bb0-8d961ae2d328",
                                "text": "Regardless of how involved Carl outwardly appears, inside he holds himself stoically detached."
                            }
                        ]
                    },
                    {
                        "sense_id": "87c9902d-ce51-3ab4-8707-d48e5f0642cc",
                        "entry_id": "5b3d04fb-bc98-3f28-a717-df4f91142793",
                        "glosses": [
                            "In a manner consistent with the philosophy of stoicism."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fa67cd7-3faf-4b74-81d4-e40ac6386740",
                        "source_entry_id": "5b3d04fb-bc98-3f28-a717-df4f91142793",
                        "source_sense_description": "in a manner that endures pain and hardship without outwardly showing suffering",
                        "target_lang_word": "stoïquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoïquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66094bf5-73a5-38d3-a1e0-2a90aa5db8c3",
                                        "entry_id": "abc84139-96ce-31d0-8f84-7a6a9332fefa",
                                        "glosses": [
                                            "En stoïcien, avec courage et fermeté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d2d8181-51eb-43c4-a77f-5057a5e9316f",
                                                "sense_id": "66094bf5-73a5-38d3-a1e0-2a90aa5db8c3",
                                                "text": "La maréchale de Clérembaut est ici : elle soutient stoïquement sa disgrâce, et ne se fera point ouvrir les veines, […]"
                                            },
                                            {
                                                "example_id": "98a1af9c-9803-4689-a53a-6888cadcc1a2",
                                                "sense_id": "66094bf5-73a5-38d3-a1e0-2a90aa5db8c3",
                                                "text": "Ils attendent l'aube stoïquement, devant un café-crème ou, favorisés par la chance, font parfois la rencontre d'un compatriote qui leur paie à souper."
                                            },
                                            {
                                                "example_id": "95345251-1b30-479d-b870-29cea4d62d8e",
                                                "sense_id": "66094bf5-73a5-38d3-a1e0-2a90aa5db8c3",
                                                "text": "Fandor, le pantalon retroussé, le col du pardessus relevé, traversait stoïquement sous la pluie l’esplanade des Invalides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
