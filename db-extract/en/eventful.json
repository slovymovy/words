                        "entry_id": "157eb781-a48e-3fb0-a90f-30ae942d4422",
                        "glosses": [
                            "Of or pertaining to high levels of activity; having many memorable events."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e53c844b-b46e-441c-bdde-a3645170d1ca",
                                "sense_id": "a2c2ed4b-5298-3a45-b4b1-5cf5476ab45c",
                                "text": "With the number of drunken revellers on the streets it could hardly fail to be an eventful night."
                            },
                            {
                                "example_id": "6f2464af-f82a-415c-b643-b52c558a4985",
                                "sense_id": "a2c2ed4b-5298-3a45-b4b1-5cf5476ab45c",
                                "text": "[…] there was something of the habitude of the wild animal in the unreflecting instinct with which she rambled on — disconnecting herself by littles from her eventful past at every step, obliterating her identity […]"
                            }
                        ]
                    }
                ],
                "translations": [
