                    {
                        "sense_id": "872b37e3-f443-3b9f-a58c-d81765a187db",
                        "entry_id": "dfea6413-8c67-33d5-b3c7-fcac7f4d8ae3",
                        "glosses": [
                            "Tanz- oder Varietélokal ohne oder mit nur geringem Niveau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ee6f08d-1b5e-4f3e-be42-c0e6dae31b15",
                                "sense_id": "872b37e3-f443-3b9f-a58c-d81765a187db",
                                "text": "Wir sind dann später noch in so ein Tingeltangel am Ende der Reeperbahn gegangen, und das war ganz witzig da."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e851f28d-a15b-3321-bc0c-06e0c9f0a148",
                        "entry_id": "dfea6413-8c67-33d5-b3c7-fcac7f4d8ae3",
                        "glosses": [
                            "flache, anspruchslose und oberflächliche Unterhaltungsveranstaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06772bc6-eb57-4ab0-9784-0af2a1d07d04",
                                "sense_id": "e851f28d-a15b-3321-bc0c-06e0c9f0a148",
                                "text": "Dass das künstlerisch wertvoll war, kann man wohl nicht behaupten, eher so Tingeltangel auf Vorortsniveau."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
