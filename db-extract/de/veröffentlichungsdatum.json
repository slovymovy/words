                ],
                "senses": [
                    {
                        "sense_id": "d5b0b07e-5953-3cf4-8234-19dafe2d7655",
                        "entry_id": "c0eb896b-921c-3668-b67b-5900409a3df2",
                        "glosses": [
                            "Datum, das für das Erscheinen eines Werkes festgelegt und bekanntgegeben wird"
                        ],
                        "tags": [
                            "Urheberrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "bd7bee88-2703-4f5c-b6fe-012e80669d06",
                                "sense_id": "d5b0b07e-5953-3cf4-8234-19dafe2d7655",
                                "text": "Ursprünglich sollte das Lied nicht als „Bonustitel“ auf dem Album erscheinen, aber Knowles hatte die Möglichkeit, noch mehr Material für das Album aufzunehmen, nachdem das Veröffentlichungsdatum des Albums einmal verschoben wurde."
                            },
                            {
                                "example_id": "0ccf0851-7bde-4b05-9de8-c28d531ac188",
                                "sense_id": "d5b0b07e-5953-3cf4-8234-19dafe2d7655",
                                "text": "… – und nun steht auch schon das Veröffentlichungsdatum für eines der wohl am meisten erwarteten Alben des Jahres fest."
                            },
                            {
                                "example_id": "55314ef7-1270-42f0-ae8a-6d135688d9d0",
                                "sense_id": "d5b0b07e-5953-3cf4-8234-19dafe2d7655",
                                "text": "Außerdem werden nicht nur enthaltene Wörter und Phrasen, sondern auch Metadaten wie z.B. die Sprache des Dokuments, das Veröffentlichungsdatum, der Autor oder die Referenzen als Features erfasst."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8cc8364-f54b-33a0-b4a2-482f31537bd2",
                        "entry_id": "c0eb896b-921c-3668-b67b-5900409a3df2",
                        "glosses": [
                            "Datum, an dem ein auf einem Medium gespeichertes Werk der Öffentlichkeit zugänglich gemacht wird"
                        ],
                        "tags": [
                            "Urheberrecht",
                            "Patentrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "31236886-20c4-4814-95c1-5abb396f87dc",
                                "sense_id": "c8cc8364-f54b-33a0-b4a2-482f31537bd2",
                                "text": "Außerdem werden nicht nur enthaltene Wörter und Phrasen, sondern auch Metadaten wie z.B. die Sprache des Dokuments, das Veröffentlichungsdatum, der Autor oder die Referenzen als Features erfasst."
                            },
                            {
                                "example_id": "16b11a2a-fa3b-42da-8418-c59786483ccc",
                                "sense_id": "c8cc8364-f54b-33a0-b4a2-482f31537bd2",
                                "text": "Die Musikproduktionen sind nach VÖ-Datum (Veröffentlichungsdatum) sortiert und werden in der entsprechenden Kalenderwoche angezeigt."
                            },
                            {
                                "example_id": "b2f4401e-286c-44aa-bc1c-3d78aef343ea",
                                "sense_id": "c8cc8364-f54b-33a0-b4a2-482f31537bd2",
                                "text": "Fragt man Amazons Alexa nach dem Veröffentlichungsdatum von Katy Perrys nächstem Album, dann antwortet Alexa „14ter August“."
                            },
                            {
                                "example_id": "0c0c6ed6-13a0-49bc-b013-c12ce9e33adb",
                                "sense_id": "c8cc8364-f54b-33a0-b4a2-482f31537bd2",
                                "text": "Da die Szene mittlerweile jedoch sehr gut organisiert ist, werden Spiele trotzdem sehr zeitnah zum eigentlichen Veröffentlichungsdatum auch illegal veröffentlicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
