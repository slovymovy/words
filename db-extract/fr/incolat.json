                        "glosses": [
                            "Droit de certains souverains, ou de certains gouvernements, d'attribuer à un étranger les mêmes droits et prérogatives que ceux que possèdent les habitants du pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ad3a4e9-6fbf-4978-b31c-f31e30076525",
                                "sense_id": "1af816c3-edb3-3a38-b71d-0d29df7a0440",
                                "text": "L’incolat consiste dans l'établissement par lequel un étranger vient se fixer en France, & y acquiert la qualité de républicole."
                            },
                            {
                                "example_id": "86d0f9dd-83cc-4225-8cb0-2f5a05425270",
                                "sense_id": "1af816c3-edb3-3a38-b71d-0d29df7a0440",
                                "text": "Il ne le quittait qu’en présentant, en bonne et due forme, une « renonciation à l’incolat », l’incolat étant l’autre nom donné à ce droit d’habitantage."
                            }
                        ]
                    }
