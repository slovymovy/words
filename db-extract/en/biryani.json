                        "entry_id": "fbb3502b-bcdb-3c2c-8059-d535400225e8",
                        "glosses": [
                            "A spiced dish of rice, blended with meat and/or vegetables."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5ff1925c-ebc0-4cb9-852d-61c163b02e87",
                                "sense_id": "80aaf724-6438-3834-9dc9-cf110e451cb3",
                                "text": "Thereafter, the menu is divided into a number of sections: Syrian Christian specialities from Kerala; coastal seafood dishes; Malabar biryanis; vegetable curries; and special dosas."
                            }
                        ]
                    }
                ],
                "translations": [
