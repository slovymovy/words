                                "target_senses": [
                                    {
                                        "sense_id": "96301f58-b806-3542-ac4e-14215aada86c",
                                        "entry_id": "85aa613c-d1ca-3f1b-907b-fb9193fd06b0",
                                        "glosses": [
                                            "Person, die sich mit der Ornithologie befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c8360d0-1b53-43a8-bb1f-7df9a22da816",
                                                "sense_id": "96301f58-b806-3542-ac4e-14215aada86c",
                                                "text": "Ornithologen haben im brasilianischen Regenwald zwei neue Vogelarten entdeckt."
                                            },
                                            {
                                                "example_id": "23e34744-419c-471c-b4d0-b27828e6c9d6",
                                                "sense_id": "96301f58-b806-3542-ac4e-14215aada86c",
                                                "text": "Zum Handwerkszeug des Ornithologen gehört unbedingt ein Fernglas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7243b730-5198-4649-93f5-065af386d039",
                        "source_entry_id": "95048502-d8e0-3239-9fb8-d1af1ced1a58",
                        "source_sense_id": "069e1a0d-4599-35df-a764-c3b4fb17f33b",
                        "target_lang_word": "Vogelkenner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fc80dd15-194f-4348-b077-78ca0cb09381",
                        "source_entry_id": "95048502-d8e0-3239-9fb8-d1af1ced1a58",
                        "source_sense_id": "069e1a0d-4599-35df-a764-c3b4fb17f33b",
                        "target_lang_word": "Vogelkundler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vogelkundler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c5f1a77-e2b0-3c2d-aa98-001df5426de2",
                                        "entry_id": "96bbcb24-6183-3b8e-aa85-df223508e55e",
                                        "glosses": [
                                            "Wissenschaftler, der sich mit dem Gebiet der Ornithologie (Vogelkunde) beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dbe6485-a7e2-42b6-b632-77129540fddb",
                                                "sense_id": "9c5f1a77-e2b0-3c2d-aa98-001df5426de2",
                                                "text": "„Ornithologen sind Vogelkundler, die einen großen Teil ihrer Zeit damit verbringen, leise und geduldig in versteckten Unterschlüpfen zu hocken und Vögel zu beobachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62bae14c-9c6b-4247-8c5f-b0a1342d0197",
                        "source_entry_id": "95048502-d8e0-3239-9fb8-d1af1ced1a58",
                        "source_sense_id": "069e1a0d-4599-35df-a764-c3b4fb17f33b",
                        "target_lang_word": "ornitholoog",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornitholoog",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "02687a81-5857-326e-b9a5-40c13de23b7b",
                                        "entry_id": "f04b6973-8f4c-3c6e-b576-d16ff0678aad",
                                        "glosses": [
                                            "iemand die veel verstand heeft van vogels; vogeldeskundige"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4fe7adb-7854-43d7-a37a-a328cd61ccab",
                                                "sense_id": "02687a81-5857-326e-b9a5-40c13de23b7b",
                                                "text": "Voor alle zekerheid vraagt ornitholoog Anje om 'niet met flitslicht' te fotograferen. Als de kraanvogels tegen zonsondergang naar hun slaapplaats in het veengebied vliegen kunnen ze door de 'blitz' gedesoriënteerd raken. De vijftig lezers van De Twentsche Courant Tubantia begrijpen wat hun Duitse gids bedoeld. Daar zijn het natuurliefhebbers voor."
                                            },
                                            {
                                                "example_id": "5f1c0a37-2e0a-415d-9124-2b5160bd627b",
                                                "sense_id": "02687a81-5857-326e-b9a5-40c13de23b7b",
                                                "text": "In het Amazonegebied in Brazilië zijn vijftien nieuwe vogelsoorten ontdekt. Het gaat om de grootste ornithologische ontdekking in Brazilië in meer dan 140 jaar, aldus ornitholoog Luis Fabio Silveira van de universiteit van Sao Paulo."
                                            },
                                            {
                                                "example_id": "16a12c63-c5a1-4b08-8bad-20f3ad397440",
                                                "sense_id": "02687a81-5857-326e-b9a5-40c13de23b7b",
                                                "text": "De vogelarts groeide zelf op in die cultuur. Zijn jeugd bracht hij door in India en Nepal waar hij als kleuter al kromsnavels en zangvogels hield. Later leerde hij veel van de bekende Amerikaanse ornitholoog Bob Flemming, met wie hij veelvuldig de natuur in trok."
                                            }
                                        ]
                                    }
                                ]
                            }
