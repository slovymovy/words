                "senses": [
                    {
                        "sense_id": "5a5fb8e8-686b-338b-b7a2-a82935122cda",
                        "entry_id": "fe97bdf6-8db8-3087-a5dd-4c4a3db76e60",
                        "glosses": [
                            "Alternative spelling of carol."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "9231716f-7ec4-4dc1-9d89-91b1bc0fe088",
                                "sense_id": "5a5fb8e8-686b-338b-b7a2-a82935122cda",
                                "text": "The humane mortals want their winter heere\nNo night is now with hymme or carroll bleſt;\nTherefore the Moone (the gouerneſſe of floods)\nPale in her anger, waſhes all the aire;\nThat Rheumaticke diſeaſes do abound."
                            },
                            {
                                "example_id": "0e749c20-86fe-4bf5-8d23-8fd51050e937",
                                "sense_id": "5a5fb8e8-686b-338b-b7a2-a82935122cda",
                                "text": "Carolle: f[eminine]. A kind of daunce wherein many daunce together; alſo, a Carroll, or Chriſtmas ſong."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
