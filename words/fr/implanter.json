                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur s'efforce d'<w>implanter</w> l'esprit critique chez tous ses jeunes étudiants."
                        },
                        {
                            "text": "Cette nouvelle coutume a mis plusieurs décennies à s'<w>implanter</w> dans la société."
                        }
                    ],
                    "common_phrases": [
                        "implanter une idée",
                        "implanter une habitude"
                    ]
                },
                {
                    "sense_id": "ecc9ea7a-890d-3ed3-a3eb-76c8aa7ad583",
                    "sense_definition": "Installer et configurer un logiciel ou un système informatique pour le faire fonctionner dans un environnement précis.",
