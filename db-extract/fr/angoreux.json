                        "examples": [
                            {
                                "example_id": "87972508-e035-4a80-bbcf-27d50b3faf7e",
                                "sense_id": "64663db0-5219-30ec-8c46-92a1e55714fa",
                                "text": "Une formule d’huiles essentielles pour tous les patients qui ont un terrain angoreux."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e6c2733-dd76-340e-bbfa-ba252b1b5b0a",
                        "entry_id": "06b5727e-8e47-30d0-aaaf-5a10e023cd2a",
                        "glosses": [
                            "Qui est sujet à des crises d’angor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99523851-49ab-4312-be19-0dc2aefbe147",
                                "sense_id": "1e6c2733-dd76-340e-bbfa-ba252b1b5b0a",
                                "text": "Le médecin prescrit des antibiotiques par voie orale et externe, un tonicardiaque, mais à la suite du choc psychologique, le cœur angoreux défaille."
                            }
                        ]
                    }
