                "senses": [
                    {
                        "sense_id": "73074c02-cd7d-3b32-b204-1c552fed9a66",
                        "entry_id": "a27e209c-b862-3838-8234-319df3c05368",
                        "glosses": [
                            "Jouer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54195fa8-88ae-4d2e-a52a-2dc2872987fb",
                                "sense_id": "73074c02-cd7d-3b32-b204-1c552fed9a66",
                                "text": "La bobine est vraiment presque trop naturelle\nOn s’attend à la voir schpiler à la marelle"
                            },
                            {
                                "example_id": "803ae2e4-56b0-4a43-b3df-e1dccbb7ebcc",
                                "sense_id": "73074c02-cd7d-3b32-b204-1c552fed9a66",
                                "text": "Pour peu qu’il se soit mis à schpiler, le Mondain, ou bien à prendre le délire du grossium, l’Élégant va le retrouver tondu !"
                            },
                            {
                                "example_id": "69b0c9e9-04d1-42cd-91ca-657b6532c89f",
                                "sense_id": "73074c02-cd7d-3b32-b204-1c552fed9a66",
                                "text": "Mademoiselle Lemierre devait schpiler un rôle de vestale dans l’opéra nouveau : mais elle est en cloque pour la deuxième fois ; on ne sait pas qui la remplacera."
                            }
                        ]
                    },
                    {
                        "sense_id": "08db215f-f262-339e-a5cc-fdd3257e27c7",
                        "entry_id": "a27e209c-b862-3838-8234-319df3c05368",
                        "glosses": [
                            "Réussir un beau coup, en particulier en jouant en bourse."
                        ],
                        "tags": [],
                        "note": "Dans le sens boursier, on trouve plus souvent aujourd’hui le verbe spieler, refait sur l’allemand",
                        "examples": []
                    }
