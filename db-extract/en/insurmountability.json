                                "example_id": "b6efb727-c561-4d8e-a36d-44c726e7301a",
                                "sense_id": "08898a44-36fc-3d61-83ea-77024dda3010",
                                "text": "The tragedy of a genius towering above its contemporaries does not end with death. The latter merely helps to accentuate more forcibly the insurmountability of inherent contrasts."
                            }
                        ]
