                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eb587ca-05c3-4912-8964-327e000c89b3",
                                                "sense_id": "089fb89e-ac1b-33f0-928b-7f13e6f47c39",
                                                "text": "Eine Tarnkappe verleiht Alberich in der Nibelungensage seine Unsichtbarkeit."
                                            },
                                            {
                                                "example_id": "e156e3bf-5437-40ec-886e-6cc7fd6b5caf",
                                                "sense_id": "089fb89e-ac1b-33f0-928b-7f13e6f47c39",
                                                "text": "Wissenschaftler forschen an Materialien, die Menschen und Fahrzeugen Unsichtbarkeit verleihen."
                                            }
