                                "target_senses": [
                                    {
                                        "sense_id": "f863f239-0d23-314a-af5d-55340d346488",
                                        "entry_id": "5fa7fafc-c2dd-3eb7-a8ce-25acc236eef5",
                                        "glosses": [
                                            "in vier talen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5274a9c-8d9a-4bc2-853b-aee99d86e858",
                                                "sense_id": "f863f239-0d23-314a-af5d-55340d346488",
                                                "text": "We zouden van de woorden in een viertalig woordenboek, die hetzelfde betekenen, ook kunnen beweren dat ze synoniem zijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "724c0831-60a0-3630-ac77-59f2f334e309",
                                        "entry_id": "5fa7fafc-c2dd-3eb7-a8ce-25acc236eef5",
                                        "glosses": [
                                            "vier talen sprekend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9869c6c-b3ab-4d12-bafb-5014375ab86c",
                                                "sense_id": "724c0831-60a0-3630-ac77-59f2f334e309",
                                                "text": "Omdat het onderwijs in vreemde talen al op de basisschool begint is elke moderne Benditaan viertalig: we spreken Spaans en Lahua, de officiële talen, en Engels en Russisch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
