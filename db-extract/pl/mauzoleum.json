                    {
                        "translation_id": "e65d08df-e490-43f1-8d26-32879c42f995",
                        "source_entry_id": "04b40d04-82e9-312c-99c7-3bea7907a3f2",
                        "source_sense_id": "ea07ca38-ac07-38e0-91bc-1a757af28710",
                        "target_lang_word": "Mausoleum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mausoleum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2e3d9d9-e4fe-3cf1-9c41-c37b05c97df8",
                                        "entry_id": "063f94fc-5b8b-3469-8e10-aec6a804b71a",
                                        "glosses": [
                                            "eine Grabstätte, in der der Leichnam einer Person in einem extra angefertigten Gebäude aufbewahrt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "522895bf-5aa1-49d0-953d-c19f3e2d7c7e",
                                                "sense_id": "b2e3d9d9-e4fe-3cf1-9c41-c37b05c97df8",
                                                "text": "Das indische Taj Mahal war im 17. Jahrhundert von Schah Jahan als Mausoleum für seine im Kindbett verstorbene zweite Frau errichtet worden."
                                            },
                                            {
                                                "example_id": "a3975740-4826-4555-8d04-954ffe8a8064",
                                                "sense_id": "b2e3d9d9-e4fe-3cf1-9c41-c37b05c97df8",
                                                "text": "Die Banner für die Siegesparade am 9. Mai sind schon gestrafft, derweil Russlands Kommunisten eine betrübliche Meldung lesen mussten über jenen Herrn, der am Roten Platz im Mausoleum ruht."
                                            },
                                            {
                                                "example_id": "5c3dba21-2c42-4671-9f4f-1085aa2ad9ca",
                                                "sense_id": "b2e3d9d9-e4fe-3cf1-9c41-c37b05c97df8",
                                                "text": "„Ich kehre zu meinem Tagebuch zurück, beginnend mit der Stelle, wo die Prinzessin am königlichen Mausoleum eintraf:…“"
                                            },
                                            {
                                                "example_id": "1d95054e-f50a-459e-adc3-8e0c57bfb67a",
                                                "sense_id": "b2e3d9d9-e4fe-3cf1-9c41-c37b05c97df8",
                                                "text": "„Sie schlängeln sich zwischen moosbewachsenen Mausoleen aus einem vergangenen Jahrhundert hindurch, das uns ferner ist als manches aus der strahlenden Antike.“"
                                            },
                                            {
                                                "example_id": "ce70b464-8dd1-4f81-9f4a-290ddaafbbf2",
                                                "sense_id": "b2e3d9d9-e4fe-3cf1-9c41-c37b05c97df8",
                                                "text": "„Bijapur beeindruckt den Besucher noch heute durch das Mausoleum des Sultans Muhammad Adil Shah, das 1659 erbaut wurde und Gol Gumbaz genannt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
