                ],
                "senses": [
                    {
                        "sense_id": "ed8312eb-64e4-327e-a4f3-aff8a486f371",
                        "entry_id": "10a3c31c-0545-347b-acdb-76c856adcb13",
                        "glosses": [
                            "To strip the blubber or skin from, as from a whale, seal, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "710f16a9-613a-4355-bae9-12fd32335bd9",
                                "sense_id": "ed8312eb-64e4-327e-a4f3-aff8a486f371",
                                "text": "In this domain right sex is capital, it flenses the feelings of all the poisonous artifices brought in by the think-box in the guise of clever ideas."
                            },
                            {
                                "example_id": "bdeb4582-7be2-4d3f-aea4-7543061c7f6d",
                                "sense_id": "ed8312eb-64e4-327e-a4f3-aff8a486f371",
                                "text": "His eyes sprang open. Umegat stared straight at him for the fraction of a second, and Cazaril felt flensed."
                            },
                            {
                                "example_id": "61465766-c164-4477-b605-35a08a82956c",
                                "sense_id": "ed8312eb-64e4-327e-a4f3-aff8a486f371",
                                "text": "For that reason, among others, he would never evince the particular guantness, the cut and flagrant sense of purpose - all compromise and capacity for surrender flensed away - which had made Thomas Covenant ir-refusable to her."
                            },
                            {
                                "example_id": "613aa758-b4e9-4710-8f0d-3739fb007365",
                                "sense_id": "ed8312eb-64e4-327e-a4f3-aff8a486f371",
                                "text": "It engulfed screaming soldiers who disappeared before his eyes, their flesh, armor, even bone, flensed into a suspended mist that was heading straight for them."
                            },
                            {
                                "example_id": "c65da6e5-4568-465f-9e19-9886c801a072",
                                "sense_id": "ed8312eb-64e4-327e-a4f3-aff8a486f371",
                                "text": "The Lemakot in the north strangled widows and threw them into the cremation pyres of their dead husbands. If they defeated potential invaders the New Irish hanged the vanquished from banyan trees, flensed their windpipes, removed their heads, left their intestines to jerk in the sun."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fe0cc47-e961-42f8-b260-64a5db8ab678",
                        "source_entry_id": "10a3c31c-0545-347b-acdb-76c856adcb13",
                        "source_sense_id": "ed8312eb-64e4-327e-a4f3-aff8a486f371",
                        "source_sense_description": "To strip the blubber or skin from, as from a whale, seal, etc",
                        "target_lang_word": "flensen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flensen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16197993-8dbf-37ca-a13c-3bcb68a00846",
                                        "entry_id": "87080b7c-8c38-39db-9871-13e6a0c66a92",
                                        "glosses": [
                                            "die Speckschicht von einem erlegten Wal abtrennen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09344a4d-8fb0-4e52-92ed-20632bce41fc",
                                                "sense_id": "16197993-8dbf-37ca-a13c-3bcb68a00846",
                                                "text": "„‚Flensen‘ bedeutet ausnehmen – im Monstermaßstab. Wo bei einem Fisch ein Schnitt genügt und die Organe auf den Tisch suppen, watet man beim Flensen metertief durch den Horror. Flensen ist das Zerlegen eines Wals.“ (2017)"
                                            },
                                            {
                                                "example_id": "5d8e112c-8bd8-4458-adfc-8702990c1c91",
                                                "sense_id": "16197993-8dbf-37ca-a13c-3bcb68a00846",
                                                "text": "„Die übrigen Offiziere waren der Speckschneider und sein Gehilfe, der Speckschneidersmaat, die Harpunierdienste taten und beim Flensen die schwierige Aufgabe hatten, den Fisch zu zerteilen, wie dies oben näher dargelegt ist.“ (2015)"
                                            },
                                            {
                                                "example_id": "a478f6f1-1e9d-420c-9fa2-1b45557b7c3c",
                                                "sense_id": "16197993-8dbf-37ca-a13c-3bcb68a00846",
                                                "text": "„Flensen, auf Grönlandsfahrern; Schwedisch: Flensa: Dänisch: Flense; Holländisch: Vlensen; die vom Wallfisch abgeschnittenen Speckstücke mit einer Talje ins Schiff holen. Am Bord werden diese Stücke noch kleiner geschnitten, und dann in den Raum geschafft.“ (1850)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
