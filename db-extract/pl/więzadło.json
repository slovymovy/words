                                    },
                                    {
                                        "sense_id": "86f1302e-7b9d-3037-a0d3-b5a40f9874d6",
                                        "entry_id": "6a33812d-c74a-3aa6-a7ab-a6b3e70d7fad",
                                        "glosses": [
                                            "несколько однородных объектов, связанных воедино"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
