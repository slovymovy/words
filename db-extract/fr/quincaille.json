                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ba15ef6-b79e-3881-8677-89b941e01f13",
                                        "entry_id": "21942f0c-39a6-374e-99a0-e6afd774b98e",
                                        "glosses": [
                                            "Medals or trophies."
                                        ],
