                "senses": [
                    {
                        "sense_id": "9ca7ee31-ed56-3e29-96c6-9386480cf9e5",
                        "entry_id": "4fc57f12-476f-3295-b392-a20feb152154",
                        "glosses": [
                            "dick-measuring contest"
                        ],
                        "tags": [
                            "figuratively",
