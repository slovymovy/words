                },
                {
                    "sense_id": "b95dc85e-aa31-3df1-bbd3-ba409bc9870a",
                    "sense_definition": "Pigeons' dung used in tanning.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In historical leather production, workers applied <w>grains</w> to the hides to help soften them.",
                            "target_lang_translations": {
                                "ru": "В историческом кожевенном производстве рабочие наносили <w>голубиный помёт</w> на шкуры, чтобы помочь их размягчить.",
                                "pl": "W historycznej produkcji skóry robotnicy nakładali <w>odchody gołębie</w> na skóry, aby pomóc je zmiękczyć."
                            }
                        },
                        {
                            "text": "The specific mixture of <w>grains</w> was essential for the traditional tanning process described in the manual.",
                            "target_lang_translations": {
                                "ru": "Особая смесь <w>помёта</w> была необходима для традиционного процесса дубления, описанного в руководстве.",
                                "pl": "Specjalna mieszanka <w>odchodów gołębich</w> była niezbędna w tradycyjnym procesie garbowania opisanym w podręczniku."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical tanning term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Голубиный помёт, используемый в процессе дубления кожи (устаревший термин).",
                        "pl": "Odchody gołębi używane dawniej w garbarstwie (termin historyczny)."
