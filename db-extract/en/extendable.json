                        "target_lang_word": "dehnbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dehnbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88644376-99ca-3b78-9063-2b0dafeeffa9",
                                        "entry_id": "e1b6f3ae-708f-3d1e-a46b-815144ec62cf",
                                        "glosses": [
                                            "in Länge oder Form änderbar (von Materialien)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f83282-9448-4813-8df1-b5bcf84b4888",
                                                "sense_id": "88644376-99ca-3b78-9063-2b0dafeeffa9",
                                                "text": "Der Magen ist ein sehr dehnbares Organ."
                                            },
                                            {
                                                "example_id": "6fe8ab71-df95-442d-870c-8ea050038d45",
                                                "sense_id": "88644376-99ca-3b78-9063-2b0dafeeffa9",
                                                "text": "Eine Mangan-Silizium-Aluminium-Legierung soll Stahl deutlich dehnbarer machen."
                                            },
                                            {
                                                "example_id": "b161c4d3-b791-4825-9830-04d9117643ee",
                                                "sense_id": "88644376-99ca-3b78-9063-2b0dafeeffa9",
                                                "text": "Vor allem Stahl mit einem Gehalt von 15 Prozent Mangan und jeweils drei Prozent Aluminium und Silizium hat sich im Labor als extrem fest und zugleich sehr dehnbar erwiesen."
                                            },
                                            {
                                                "example_id": "3f49ec7c-f2fa-44b8-8a07-5d7c114d4e16",
                                                "sense_id": "88644376-99ca-3b78-9063-2b0dafeeffa9",
                                                "text": "Weil die verwendeten Materialien unterschiedlich dehnbar sind, wölbt sich der entsprechende Abschnitt - und die Gliedmaße stellt sich auf."
                                            },
                                            {
                                                "example_id": "1379835b-5309-49e3-81be-a295db773834",
                                                "sense_id": "88644376-99ca-3b78-9063-2b0dafeeffa9",
                                                "text": "Kollagenfasern sind stark belastbar und wenig dehnbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "732483a5-d93d-30df-91f2-8c2b8a98b8ee",
                                        "entry_id": "e1b6f3ae-708f-3d1e-a46b-815144ec62cf",
                                        "glosses": [
                                            "nicht klar umrissen; vieldeutig; mehrere Deutungen zulassend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38981979-5354-4a4b-bf14-ea3a97ef9fa5",
                                                "sense_id": "732483a5-d93d-30df-91f2-8c2b8a98b8ee",
                                                "text": "Kaum ein Begriff ist so dehnbar wie „wissenschaftlich nicht allgemein anerkannt“. Wer will definieren, was der Stand der Wissenschaft ist?"
                                            },
                                            {
                                                "example_id": "3c90b9f5-ca27-4db1-a1a9-222dbd5ab344",
                                                "sense_id": "732483a5-d93d-30df-91f2-8c2b8a98b8ee",
                                                "text": "Zu fragen ist aber, ob die Gesetzesparagraphen wirklich so dehnbar sind, daß Chrysler mit der Kreditbürgschaft hindurchschlüpfen kann."
                                            },
                                            {
                                                "example_id": "bed8713c-186d-4150-bd0a-088f5316ff33",
                                                "sense_id": "732483a5-d93d-30df-91f2-8c2b8a98b8ee",
                                                "text": "Die beste Illustration dafür ist der Beruf der Sekretärin. Ihre Tätigkeitsmerkmale sind äußerst dehnbar."
                                            },
                                            {
                                                "example_id": "b0fdb908-6d1a-421e-a53f-de0332292a0d",
                                                "sense_id": "732483a5-d93d-30df-91f2-8c2b8a98b8ee",
                                                "text": "Freilich ist der Begriff pauci dies dehnbar; aber 3 Monate können sicher nicht darunter verstanden sein."
                                            },
                                            {
                                                "example_id": "c41b84c3-a177-4aef-a2c1-774688c620f9",
                                                "sense_id": "732483a5-d93d-30df-91f2-8c2b8a98b8ee",
                                                "text": "… denn die Wahrheit ist vielgestaltig und die Pflicht, die Wahrheit zu sagen, sehr dehnbar."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
