                "senses": [
                    {
                        "sense_id": "f64ccd4e-01a7-3b57-9f50-9e38195def8e",
                        "entry_id": "71186979-98ce-349b-b253-5c6ec16f9699",
                        "glosses": [
                            "Bewohner des gesamten britischen Mandatsgebiets Palästina (1922–1948), egal, welcher Volkszugehörigkeit oder Religion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80c2d8a-449b-4e63-ab93-8dfbcbdef98f",
                                "sense_id": "f64ccd4e-01a7-3b57-9f50-9e38195def8e",
                                "text": "Das Adjektiv palästinisch bezieht sich in der Regel auf das antike Palästina, so zum Beispiel der Begriff „palästinische Juden“, nicht auf heutige Palästinenser."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "00b9292f-1c6d-3e23-b68c-792df2693ca3",
                        "entry_id": "71186979-98ce-349b-b253-5c6ec16f9699",
                        "glosses": [
                            "Bewohner Palästinas"
                        ],
                        "tags": [
                            "ab 1964"
                        ],
                        "examples": [
                            {
                                "example_id": "8f48853b-42da-41b7-a078-204a2dad6408",
                                "sense_id": "00b9292f-1c6d-3e23-b68c-792df2693ca3",
                                "text": "Der Sechstagekrieg 1967 führte zu einer Verschärfung des Palästinenser-Problems im Nahen Osten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6504b85c-d954-31ce-8065-ee8dd37a3fe9",
                        "entry_id": "71186979-98ce-349b-b253-5c6ec16f9699",
                        "glosses": [
                            "Bewohner der Palästinensischen Autonomiegebiete"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a624bfdb-0bca-455a-80ff-d1b1425bd4ac",
                                "sense_id": "6504b85c-d954-31ce-8065-ee8dd37a3fe9",
                                "text": "Ein sehr bekannter Palästinenser war Jassir Arafat ^(→ WP)."
                            },
                            {
                                "example_id": "a19a0a88-358d-4c6a-948f-1f4757729f32",
                                "sense_id": "6504b85c-d954-31ce-8065-ee8dd37a3fe9",
                                "text": "„In den Kreisen, in denen ich verkehrte, sprach man über alles, nicht aber über Palästinenser und Flüchtlingslager.“"
                            },
                            {
                                "example_id": "de8357ff-9016-440f-a7fe-4b4c517cc6d0",
                                "sense_id": "6504b85c-d954-31ce-8065-ee8dd37a3fe9",
                                "text": "„Seit 17 Jahren kämpft der Palästinenser einen Kampf, den er nicht gewinnen kann.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
