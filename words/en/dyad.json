                    ]
                },
                {
                    "sense_id": "a2e6ff7b-93b3-3625-8a3d-0cf81ca9b43d",
                    "sense_definition": "The relationship or interaction itself in reference to a couple.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "relationship_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The therapist focused on strengthening the <w>dyad</w> rather than treating the individuals separately."
