                                            {
                                                "example_id": "0e629839-d688-4056-a48f-8f8bc0bfe793",
                                                "sense_id": "72e3b715-a468-3583-ac13-8932327ee84d",
                                                "text": "Das gestrige Besäufnis blieb allen Teilnehmern lange in Erinnerung."
                                            },
                                            {
                                                "example_id": "657f6524-2c2d-4726-96a4-deeae095b3b7",
                                                "sense_id": "72e3b715-a468-3583-ac13-8932327ee84d",
                                                "text": "„Den um Reputierlichkeit bemühten Vater provoziert Franz Jung mit einem Besäufnis im besten Restaurant der Stadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
