                                                "sense_id": "ef4a7228-99b7-317a-a9ee-99b5ae50efc6",
                                                "text": "C’est une nature poétique."
                                            },
                                            {
                                                "example_id": "7d79803e-8319-459f-af3c-5749625640ad",
                                                "sense_id": "ef4a7228-99b7-317a-a9ee-99b5ae50efc6",
                                                "text": "Ce paysage a quelque chose de poétique."
