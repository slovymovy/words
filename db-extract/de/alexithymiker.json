                "senses": [
                    {
                        "sense_id": "9c65651e-3752-3171-9baf-bfbaa26ea062",
                        "entry_id": "f2b41080-12b4-3a33-9e88-26cc8fcc63c5",
                        "glosses": [
                            "(männliche) Person, die alexithymisch veranlagt ist; die Alexithymie hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eed1b3a9-b878-450f-b5dc-9cefae107a43",
                                "sense_id": "9c65651e-3752-3171-9baf-bfbaa26ea062",
                                "text": "„Nicht minder populär ist die Theorie von der spezifischen „ psychosomatischen Persönlichkeitsstruktur “ – der Alexithymie. Alexithymiker, also für psychosomatische Erkrankungen besonders anfällige Menschen, seien durch banale, sterile und leere sprachliche Äußerungen ebenso gekennzeichnet wie durch ihre Unfähigkeit zur Phantasie. Statt mit Worten sprächen diese Menschen deshalb mittels ihres Körpers, und der spricht nun einmal mittels Krankheiten.“"
                            },
                            {
                                "example_id": "8985a7c5-af53-4dd2-954b-91b872511cca",
                                "sense_id": "9c65651e-3752-3171-9baf-bfbaa26ea062",
                                "text": "„Und weil Alexithymiker ihre körperlichen Reaktionen auf Gefühle zwar durchaus spüren, aber nicht zuordnen können, deuten sie diffuse somatische Regungen oft als Zeichen von Krankheit.“"
                            },
                            {
                                "example_id": "3fd6f24e-cfe9-4cdc-978a-81b618a8ee08",
                                "sense_id": "9c65651e-3752-3171-9baf-bfbaa26ea062",
                                "text": "Die Alexithymiker werden oft als gesund gesehen, wenn sie dieses Persönlichkeitsmerkmal seit ihrer Kindheit aufweisen. Die Alexithymie kann man aber auch später durch große Belastungen erworben werden, was eventuell zu Somatisierungsstörungen führen kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
