                                    {
                                        "sense_id": "62e04169-f057-3b71-ad20-86ab2fe35e77",
                                        "entry_id": "7fd9cab1-d6e9-3308-8505-2c609b18a56b",
                                        "glosses": [
                                            "Brightness, brilliancy."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d86a7928-1c65-4dea-a2c9-e4b5a85aa1a5",
                                                "sense_id": "62e04169-f057-3b71-ad20-86ab2fe35e77",
                                                "text": "Thenne sayd he Fair swete fader Ihesu Cryst yf euer I dyd thyng that pleasyd the lord / for thy pyte ne haue me not in despyte for my synnes done afore tyme / and that thou shewe me some thynge of that I seke / And with that he sawe the chamber dore open and there came oute a grete clerenes / that the hows was as bryghte as all torches of the world had ben there"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "965349ae-9ddb-3ab2-b4e8-b6b43a1953f2",
                                        "entry_id": "7fd9cab1-d6e9-3308-8505-2c609b18a56b",
                                        "glosses": [
                                            "Mental or sensory distinctness; clarity of understanding, perception etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3328637b-4109-425c-97c9-f81c8194120f",
                                                "sense_id": "965349ae-9ddb-3ab2-b4e8-b6b43a1953f2",
                                                "text": "The daily press is the evil principle of the modern world, and time will only serve to disclose this fact with greater and greater clearness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e78eec1-fe84-3dc2-b0b0-25715f38b5bb",
                                        "entry_id": "7fd9cab1-d6e9-3308-8505-2c609b18a56b",
                                        "glosses": [
                                            "The state of being free from obscurities or opacity; distinctness of light, colour etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7aebb71-2a62-4547-9457-21673eccb1c3",
                                                "sense_id": "5e78eec1-fe84-3dc2-b0b0-25715f38b5bb",
                                                "text": "The clearness of the water meant I could still see the key lying on the river-bed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "825ce557-cdc4-3489-aed7-bfba4068689f",
                                        "entry_id": "7fd9cab1-d6e9-3308-8505-2c609b18a56b",
                                        "glosses": [
                                            "The state of being free from obstruction or interference."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72759dca-f818-4653-84c5-37bf11840da8",
                                                "sense_id": "825ce557-cdc4-3489-aed7-bfba4068689f",
                                                "text": "The clearness of the path made for an easy hike."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eedfbae3-8327-4039-afba-c9e854c44a88",
