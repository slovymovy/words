                                    {
                                        "sense_id": "51601cde-c71a-3cc0-a39f-8f0d4f2d638a",
                                        "entry_id": "10327f57-2d2f-3531-8caa-ef45caa08cb5",
                                        "glosses": [
                                            "The action of the verb to peep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb73f4d2-b429-4f93-aab5-aadd8aceed8e",
                                                "sense_id": "51601cde-c71a-3cc0-a39f-8f0d4f2d638a",
                                                "text": "You will know them by their sly looks; their skulkings, peepings, watchings, and the snares they lay;—by the great papers, with great seals, that they carry; […]"
                                            },
                                            {
                                                "example_id": "47ad6511-0971-4231-b3ee-057707da6598",
                                                "sense_id": "51601cde-c71a-3cc0-a39f-8f0d4f2d638a",
                                                "text": "Yet, terrible as was the danger we incurred, the attraction of peeping was for both of us irresistible."
                                            }
                                        ]
                                    }
                                ]
                            },
