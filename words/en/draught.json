{
    "word_family": [
        "draughtsman",
        "draughtsmanship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e8708cc5-848b-3c94-97b5-8a0ea2fdc726",
                    "sense_definition": "A current of cool air in a room or other enclosed space.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "air_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She could feel a <w>draught</w> coming from the open window.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала <w>сквозня́к</w>, идущий от открытого окна."
                            }
                        },
                        {
                            "text": "Close the door to stop the cold <w>draught</w>.",
                            "target_lang_translations": {
                                "ru": "Закрой дверь, чтобы остановить холодный <w>сквозня́к</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cold draught"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поток холодного воздуха в помещении или другом закрытом пространстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сквозня́к",
                                "target_lang_sense_clarification": "поток воздуха, возникающий при открытии окон или дверей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30544f85-5233-3893-abc9-227267113544",
                    "sense_definition": "Beer served from a cask or keg rather than a bottle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They serve excellent <w>draught</w> beer at the local pub.",
                            "target_lang_translations": {
                                "ru": "В местном пабе подают отличное <w>разливно́е</w> пиво."
                            }
                        },
                        {
                            "text": "Would you prefer a bottle or <w>draught</w>?",
                            "target_lang_translations": {
                                "ru": "Вы предпочитаете бутылочное или <w>разливно́е</w>?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "draught beer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пиво, подаваемое из бочки или кега, а не в бутылках."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разливно́е пи́во",
