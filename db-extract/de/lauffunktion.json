                ],
                "senses": [
                    {
                        "sense_id": "9f1cefdd-7a8b-3763-89bc-3cbc84bde443",
                        "entry_id": "03f9ebaf-e30c-377f-a3e0-bbc91351b072",
                        "glosses": [
                            "biologische (physiologische) Funktion des (menschlichen oder tierlichen) Körpers zu gehen oder zu laufen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90ab1188-44aa-4539-95b4-f0b5f8ef81a0",
                                "sense_id": "9f1cefdd-7a8b-3763-89bc-3cbc84bde443",
                                "text": "„Dieser leichte, etwas hochgezogene Wanderschuh erlaubt es deinen Füßen ihrer natürlichen Lauffunktion nachzukommen und optimal zu funktionieren.“"
                            },
                            {
                                "example_id": "d1fd8685-60ff-440e-b049-f3e809ee76b0",
                                "sense_id": "9f1cefdd-7a8b-3763-89bc-3cbc84bde443",
                                "text": "„Die Funktion der Wadenmuskulatur wird von der nicht durchtrennten Nervenversorgung (die Wadenmuskulatur besteht aus drei Muskelbäuchen, sogenannter Triceps surae) weiterhin aufrecht erhalten, sodass die Lauffunktion, das Stehen auf den Zehenspitzen, etc. nicht gefährdet sind, bei dieser Form der Wadenverkleinerung.“"
                            },
                            {
                                "example_id": "ce42dfc2-64e9-4e86-9c01-ad1fd4c3c5d3",
                                "sense_id": "9f1cefdd-7a8b-3763-89bc-3cbc84bde443",
                                "text": "„Jeder Patient mit eingeschränkter Lauffunktion wünscht sich einen Rollator und erwartet ein funktionelles langlebiges Hilfsmittel mit allen Vorteilen, welches ihm alles ein bisschen leichter macht!“"
                            },
                            {
                                "example_id": "74270e54-c1f4-4cd3-8e7a-4678c9eceecb",
                                "sense_id": "9f1cefdd-7a8b-3763-89bc-3cbc84bde443",
                                "text": "„Ohne einen Rollator als unterstützende- rollende Gehhilfe würden höchstwahrscheinlich viel weniger gehandikapte Personen, bei welchen die Lauffunktion geschwächt ist, ihre Wohnstätte freiwillig nicht mehr alleine verlassen, von ausgedehnteren ‚Touren‚ ganz zu schweigen.“"
                            },
                            {
                                "example_id": "5314f2d0-e505-4260-a823-c446c9910ef7",
                                "sense_id": "9f1cefdd-7a8b-3763-89bc-3cbc84bde443",
                                "text": "„Bemerkenswert hierbei sei, dass im Rahmen einer Fragenbogenerhebung die Kopfkontrolle in 79 % erreicht worden sei und vor allem auch Hand- und Greiffunktionen sich zu 87 % verbessert hätten, das Stehen in 40 % habe erlernt werden können und Lauffunktionen mit 18 % einzelne Patienten hätten erlangen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6f7c9fb2-6236-3700-ab11-ee611d65c430",
                        "entry_id": "03f9ebaf-e30c-377f-a3e0-bbc91351b072",
                        "glosses": [
                            "mit dem Laufen zusammenhängende Funktion eines Geräts, Systems oder einer Anwendung, die in der Regel das Laufen unterstützt, simuliert, steuert oder erleichtert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7d7905b-6751-4b18-98a8-886ebda0d781",
                                "sense_id": "6f7c9fb2-6236-3700-ab11-ee611d65c430",
                                "text": "„Laufbegeisterte können mit der intelligenten Lauffunktion ihre gewünschte Laufgeschwindigkeit vor dem Laufen einstellen und sich an das Tempo erinnern lassen, um auf Kurs zu bleiben.“"
                            },
                            {
                                "example_id": "45c6dba0-16f7-4cc5-9fd6-f3ab5929e4f3",
                                "sense_id": "6f7c9fb2-6236-3700-ab11-ee611d65c430",
                                "text": "„Diese Sportuhr zeichnet sich besonders durch ihre zahlreichen Lauffunktionen aus.“"
                            },
                            {
                                "example_id": "156f4906-7886-4331-b250-dfa488cab829",
                                "sense_id": "6f7c9fb2-6236-3700-ab11-ee611d65c430",
                                "text": "„Das Laufband selbst hat den großen Vorteil, dass es verschiedene Lauffunktionen aufweist.“"
                            },
                            {
                                "example_id": "e00d928c-4017-4441-88df-3e8100b0b86f",
                                "sense_id": "6f7c9fb2-6236-3700-ab11-ee611d65c430",
                                "text": "„Idealerweise sollte er mit einem Griff oder Knopf bedient werden können, der die Lauffunktion des Rollators auslöst.“"
                            },
                            {
                                "example_id": "46d59e18-b230-4706-9da2-b7a07e39f120",
                                "sense_id": "6f7c9fb2-6236-3700-ab11-ee611d65c430",
                                "text": "„So sind moderne Beinprothesen mit Sensoren und Microcomputern ausgestattet und sind somit in der Lage, sich an unterschiedliche Lauffunktionen anzupassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
