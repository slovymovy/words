                                "target_senses": [
                                    {
                                        "sense_id": "beaf2cac-72eb-317f-97ae-3cfc7161bf1f",
                                        "entry_id": "01793565-51c7-3f68-be54-8f950b88fda7",
                                        "glosses": [
                                            "Arbustes sarmenteux du genre Jasminum, de la famille des Oleaceae, aux fleurs souvent jaunes ou blanches et dont plusieurs espèces cultivées ont des fleurs très odoriférantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42f6f011-640d-4b47-aa88-b623b689f976",
                                                "sense_id": "beaf2cac-72eb-317f-97ae-3cfc7161bf1f",
                                                "text": "Une vigne l’encadre joyeusement ; des jasmins, parmi lesquels se mêlent quelques roses grimpantes, tapissent sa façade de briques sombres."
                                            },
                                            {
                                                "example_id": "15618c50-0e54-401c-afe8-a3e8209d0427",
                                                "sense_id": "beaf2cac-72eb-317f-97ae-3cfc7161bf1f",
                                                "text": "Ne sois jamais une mauvais odeur pour tout un royaume, mon enfant. Promène-toi comme un jasmin au milieu de tous."
                                            },
                                            {
                                                "example_id": "127345e2-cf2f-4c21-860e-7ddd4d6b3691",
                                                "sense_id": "beaf2cac-72eb-317f-97ae-3cfc7161bf1f",
                                                "text": "Au restaurant, hier soir, maman a commandé un thé au jasmin et elle m’a fait goûter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fd5d3f0-efbf-3fa5-be3e-66b0df2e27b1",
                                        "entry_id": "01793565-51c7-3f68-be54-8f950b88fda7",
                                        "glosses": [
                                            "Jasmin officinal."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d09acaf4-ed7e-35a3-8b4e-434e66ea5f57",
                                        "entry_id": "01793565-51c7-3f68-be54-8f950b88fda7",
                                        "glosses": [
                                            "Fleur de ces plantes."
