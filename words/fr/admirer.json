                    "frequency": "High",
                    "semantic_group_id": "appreciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis le balcon de l'hôtel, nous aimons <w>admirer</w> le paysage chaque matin."
                        },
                        {
                            "text": "Beaucoup de jeunes musiciens <w>admirent</w> ce compositeur pour son immense talent."
                        }
                    ],
                    "synonyms": [
                        "contempler",
                        "estimer"
                    ],
                    "antonyms": [
                        "détester",
                        "mépriser"
                    ],
                    "common_phrases": [
                        "admirer la vue",
                        "admirer le paysage"
                    ]
                },
                {
                    "sense_id": "1dcc11be-6a74-3391-b82c-d0c796179a74",
                    "sense_definition": "Constater avec étonnement, souvent par ironie, l'excès ou la témérité d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ironie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>admire</w> votre audace de parler ainsi devant le directeur."
                        },
                        {
                            "text": "J'<w>admire</w> vraiment sa capacité à inventer des excuses aussi ridicules."
                        }
                    ],
                    "synonyms": [
                        "s'étonner"
                    ],
                    "common_phrases": [
