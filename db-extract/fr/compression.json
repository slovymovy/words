                        "sense_id": "acec7141-3982-3ea0-86b3-4be928a2c3eb",
                        "entry_id": "35172133-439b-3c0d-bf0a-273f56de0b0d",
                        "glosses": [
                            "Action de comprimer ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fe94b87-baf9-4eea-a538-4f8306d9e3ad",
                                "sense_id": "acec7141-3982-3ea0-86b3-4be928a2c3eb",
                                "text": "La noix verte du cocotier donne une eau rafraîchissante, […]; de l'amande râpée on extraie par compression un lait crémeux qui entre dans la préparation des aliments."
                            }
                        ]
                    },
                    {
                        "sense_id": "b398f1a6-aec5-3737-bedc-44c1d2d0053b",
