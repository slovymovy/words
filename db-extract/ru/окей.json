                                                "example_id": "c5410574-68f1-473e-b431-fd4fe5627980",
                                                "sense_id": "54f40c4d-2a96-3ddd-86d8-95791f39d636",
                                                "text": "« OK, t’as gagné… Et chose promise, chose due. »"
                                            }
