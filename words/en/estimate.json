                                "target_lang_word": "tahmini",
                                "target_lang_sense_clarification": "yaklaşık olarak belirlenmiş"
                            },
                            {
                                "target_lang_word": "yaklaşık",
                                "target_lang_sense_clarification": "kesin olmayan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "估计的",
                                "target_lang_sense_clarification": "非精确的"
                            },
                            {
