{
    "word_family": [
        "lopen",
        "vastloper",
        "vastleggen",
        "vastzitten"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b38b494-e067-32ab-9bd4-0f4aaad1d0ae",
                    "sense_definition": "niet meer verder kunnen functioneren of bewegen door een blokkade",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De machine was <w>vastgelopen</w> en kapot gegaan doordat het oliepeil te laag was.",
                            "target_lang_translations": {
                                "en": "The machine had <w>jammed</w> and broken down because the oil level was too low."
                            }
                        },
                        {
                            "text": "Het papier is in de printer <w>vastgelopen</w> tijdens het afdrukken.",
                            "target_lang_translations": {
                                "en": "The paper <w>got stuck</w> in the printer during printing."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in de printer vastlopen",
                        "volledig vastlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "To no longer be able to function or move due to a blockage"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jam",
                                "target_lang_sense_clarification": "mechanical blockage"
                            },
                            {
                                "target_lang_word": "get stuck",
                                "target_lang_sense_clarification": "unable to move"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e5e5b0b-d8ea-3f18-99ad-f995f3407669",
                    "sense_definition": "niet meer verder kunnen gaan met een proces of gesprek",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De onderhandelingen waren <w>vastgelopen</w> en de vrede was niets dichterbij gekomen.",
                            "target_lang_translations": {
                                "en": "The negotiations had <w>stalled</w> and peace had come no closer."
                            }
                        },
                        {
                            "text": "Ik ben met mijn onderzoek <w>vastgelopen</w> en weet niet hoe ik verder moet.",
                            "target_lang_translations": {
                                "en": "I have <w>gotten bogged down</w> with my research and don't know how to proceed."
                            }
                        }
                    ],
                    "common_phrases": [
                        "met onderhandelingen vastlopen",
                        "in je werk vastlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be unable to proceed with a process, conversation, or task"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stall",
                                "target_lang_sense_clarification": "process or negotiations"
                            },
                            {
                                "target_lang_word": "get bogged down",
                                "target_lang_sense_clarification": "stuck in details or progress"
                            },
                            {
                                "target_lang_word": "reach a deadlock",
                                "target_lang_sense_clarification": "negotiations"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e9d376e-c4a0-3551-8dad-6319519ab6b3",
                    "sense_definition": "het plotseling stoppen met reageren van software of een computer",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technisch falen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn computer is gisteren tijdens het gamen helemaal <w>vastgelopen</w>.",
                            "target_lang_translations": {
                                "en": "My computer completely <w>froze</w> yesterday while gaming."
                            }
                        },
                        {
                            "text": "Als de software blijft <w>vastlopen</w>, moet je het programma opnieuw installeren.",
                            "target_lang_translations": {
                                "en": "If the software keeps <w>crashing</w>, you should reinstall the program."
                            }
                        }
                    ],
                    "common_phrases": [
                        "computer laten vastlopen",
                        "steeds weer vastlopen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The sudden failure of software or a computer to respond"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "freeze",
                                "target_lang_sense_clarification": "computer or software"
                            },
                            {
                                "target_lang_word": "crash",
                                "target_lang_sense_clarification": "system failure"
                            },
                            {
                                "target_lang_word": "hang",
                                "target_lang_sense_clarification": "unresponsive software"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2994d9d3-01b2-3e83-abd5-4e1ffc92903e",
                    "sense_definition": "met de onderkant van een schip de bodem raken en niet meer verder kunnen varen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "scheepvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het grote schip is op een zandbank <w>vastgelopen</w> vlak voor de kust.",
                            "target_lang_translations": {
                                "en": "The large ship <w>ran aground</w> on a sandbank just off the coast."
                            }
                        },
                        {
                            "text": "Door de lage waterstand kan de boot gemakkelijk <w>vastlopen</w> in de rivier.",
                            "target_lang_translations": {
                                "en": "Due to the low water level, the boat can easily <w>get stuck</w> in the river."
                            }
                        }
                    ],
                    "synonyms": [
                        "stranden"
                    ],
                    "common_phrases": [
                        "op een zandbank vastlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "To hit the bottom with the underside of a ship and be unable to sail further"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run aground",
                                "target_lang_sense_clarification": "ship hitting the bottom"
                            },
                            {
                                "target_lang_word": "strand",
                                "target_lang_sense_clarification": "becoming stuck on land/sand"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}