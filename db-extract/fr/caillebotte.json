                "senses": [
                    {
                        "sense_id": "761aca04-c6b2-3c92-9451-89b98a9c929b",
                        "entry_id": "8130df59-6f6c-3e94-97ac-3f972032e9bd",
                        "glosses": [
                            "Masse de lait caillé."
                        ],
                        "tags": [
                            "Caséologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6b0715b3-364b-4ae5-9f32-56f0213daec3",
                                "sense_id": "761aca04-c6b2-3c92-9451-89b98a9c929b",
                                "text": "Il dut faire un grand effort pour ne pas commettre une folie de grand-père et l’enlever, à deux heures du matin, encore chaude de sommeil entre ses langes et fleurant la caillebotte de berceau."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbb20353-aca9-391c-9034-b66809934d0a",
                        "entry_id": "8130df59-6f6c-3e94-97ac-3f972032e9bd",
                        "glosses": [
                            "Ancien nom de la caséine."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5fbe3fa8-42d9-4463-8b11-b4285be1e6ea",
                                "sense_id": "dbb20353-aca9-391c-9034-b66809934d0a",
                                "text": "… un produit désigné indifféremment sous les noms de caillebotte, caséine, caséogomme, laclarine ou caséine précipitée du lait par le carbonate de soude et qu'on emploie à la place de l'albumine pour l'impression des étoffes et l'encollage des papiers."
                            }
                        ]
                    },
