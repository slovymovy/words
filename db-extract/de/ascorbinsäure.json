                "senses": [
                    {
                        "sense_id": "b387ff3d-517e-36eb-8f3a-1acfeeec350f",
                        "entry_id": "09f9b276-bcb0-3aa9-95e6-f7836b67281b",
                        "glosses": [
                            "farbloses Kristallpulver, mit säuerlichem Geschmack; wirkt als Reduktionsmittel; als Vitamin ein Coenzymbestandteil wasserstoffübertragender Enzyme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1077548-9600-4289-8181-08f02a45baa7",
                                "sense_id": "b387ff3d-517e-36eb-8f3a-1acfeeec350f",
                                "text": "„Die Liste der Vitamine variiert von Tierart zu Tierart. Die meisten Säuger können beispielsweise ihre eigene Ascorbinsäure (Vitamin C) herstellen.“"
                            },
                            {
                                "example_id": "3ea0b456-4425-4aad-9bbd-048ee172f7a3",
                                "sense_id": "b387ff3d-517e-36eb-8f3a-1acfeeec350f",
                                "text": "Vitamin C kennt jeder, aber in seiner Form als Ascorbinsäure kostet es nahezu nichts, 100g sind für unter 3 Euro zu bekommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58db7e24-a9a7-43f6-9d21-602389f83d47",
                        "source_entry_id": "09f9b276-bcb0-3aa9-95e6-f7836b67281b",
