                                "target_senses": [
                                    {
                                        "sense_id": "816c4d55-d28d-3346-b67d-9d9db6b33372",
                                        "entry_id": "698edbfa-b214-3f2b-83dd-19b880db1864",
                                        "glosses": [
                                            "A person or firm that owes money; one in debt; one who owes a debt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2027db2a-117b-468c-b919-a5a5a9728547",
                                                "sense_id": "816c4d55-d28d-3346-b67d-9d9db6b33372",
                                                "text": "The debtor agreed to repay the loan within six months."
                                            },
                                            {
                                                "example_id": "6cbfcd27-ab0f-419a-aa04-d8ef0c92e623",
                                                "sense_id": "816c4d55-d28d-3346-b67d-9d9db6b33372",
                                                "text": "The law protects both the debtor and the creditor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6099d48-6bb1-3eb3-9551-1e524d55f9df",
                                        "entry_id": "698edbfa-b214-3f2b-83dd-19b880db1864",
                                        "glosses": [
                                            "One who owes another anything, or is under obligation, arising from express agreement, implication of law, or principles of natural justice, to pay money or to fulfill some other obligation; in bankruptcy or similar proceedings, the person who is the subject of the proceeding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97865a81-8d67-4a55-b820-efe4b4c4d51a",
                                                "sense_id": "b6099d48-6bb1-3eb3-9551-1e524d55f9df",
                                                "text": "As a debtor, he faced constant letters from the bank."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee878ed4-53e4-43bf-a3d7-5ae156f39483",
                        "source_entry_id": "f253afe4-275f-3926-980f-dfe7b5e6f1b4",
                        "source_sense_id": "79195cb2-40e6-3470-b7ef-0b1b0b4ce8f2",
                        "source_sense_description": "jemand, der einem Geld schuldet; jemand, der Verbindlichkeiten bei einem hat",
                        "target_lang_word": "débiteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débiteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e3e520f-d42c-32db-a7cb-105a8a40ef12",
                                        "entry_id": "e3bb0466-aedb-3a10-8ce8-73aa3d67f21b",
                                        "glosses": [
                                            "Celui qui doit de l’argent, qui a une dette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4dde4ca-ec0a-472c-a64c-5b2101fb26e3",
                                                "sense_id": "3e3e520f-d42c-32db-a7cb-105a8a40ef12",
                                                "text": "Le notaire certifiant que les testatrices ont voulu faire une disposition en sa faveur, il n'y a de prouvé que sa faute ; et sa responsabilité en est la conséquence. Si les testatrices devaient savoir qu'elles étaient ses créancières, devait-il ignorer qu'il était leur débiteur ?"
                                            },
                                            {
                                                "example_id": "e5d8110c-5a0b-4096-b45a-702216afd8d8",
                                                "sense_id": "3e3e520f-d42c-32db-a7cb-105a8a40ef12",
                                                "text": "Des créanciers qui réclament le remboursement de leurs dettes excitent toujours les rancœurs de leurs débiteurs."
                                            },
                                            {
                                                "example_id": "ae23f98e-d27b-40a5-9ddc-3aa5142289ad",
                                                "sense_id": "3e3e520f-d42c-32db-a7cb-105a8a40ef12",
                                                "text": "Le créancier peut ainsi exercer l’ensemble des droits de son débiteur, tels l’action en paiement, l’action en résolution, l’exécution forcée, l’intentement d’un appel, une mesure de saisie conservatoire…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d38b81b6-520f-3db3-8b9d-2e4ec6e6db54",
                                        "entry_id": "e3bb0466-aedb-3a10-8ce8-73aa3d67f21b",
                                        "glosses": [
                                            "Celui qui débite."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05a14909-409d-4f33-8777-f5d53d9c3ae6",
                                                "sense_id": "d38b81b6-520f-3db3-8b9d-2e4ec6e6db54",
                                                "text": "Un Mémoire (de janvier) le note à Aulas comme « un dangereux homme. Il a été chassé de Sommières ; c'est un débiteur de mauvaises nouvelles » ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92adad4c-ecc8-3f80-99df-f25aad5cdc4f",
                                        "entry_id": "e3bb0466-aedb-3a10-8ce8-73aa3d67f21b",
                                        "glosses": [
                                            "Mécanisme qui assure le débit régulier d'une matière nécessaire à l'alimentation d'une machine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
