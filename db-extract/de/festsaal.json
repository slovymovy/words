                "senses": [
                    {
                        "sense_id": "020d8f21-fbfb-32dd-8544-113e4911e6e6",
                        "entry_id": "6f676662-7355-3a11-9381-0a699df6fd1e",
                        "glosses": [
                            "großer Raum für ein Fest/für Feste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dee5e8b-41b6-4ac2-b45f-709590deb2ce",
                                "sense_id": "020d8f21-fbfb-32dd-8544-113e4911e6e6",
                                "text": "„Ich muß wohl ein wenig eingenickt sein, denn auf einmal war alles im Festsaal verändert.“"
                            },
                            {
                                "example_id": "aef51fa8-bd07-4c29-994d-8ef40fbbf362",
                                "sense_id": "020d8f21-fbfb-32dd-8544-113e4911e6e6",
                                "text": "„Aus dem Festsaal wird eine Kantine mit Tüllgardinen.“"
                            },
                            {
                                "example_id": "7564a12c-6582-4530-965c-b1f3da57563e",
                                "sense_id": "020d8f21-fbfb-32dd-8544-113e4911e6e6",
                                "text": "„Im großen Festsaal, am Vormittag von der Hausdame und ihren Mädchen mit einer Fülle von Blumengestecken und Girlanden dekoriert, wurden die Dessert-Teller abgeräumt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a653714-0808-4a8b-b713-8dc559a21a1a",
                        "source_entry_id": "6f676662-7355-3a11-9381-0a699df6fd1e",
                        "source_sense_id": "020d8f21-fbfb-32dd-8544-113e4911e6e6",
                        "source_sense_description": "großer Raum für ein Fest/für Feste",
                        "target_lang_word": "salle des fêtes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salle des fêtes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95ea5445-80b8-324a-aa66-419f065e74d5",
                                        "entry_id": "c05d90fd-cde6-3195-bdf5-5e8339149e3c",
                                        "glosses": [
                                            "Salle destinée à l’organisation de festivités, de repas, publics ou privés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6893fca0-ee6c-41a2-9d50-ece944734921",
                                                "sense_id": "95ea5445-80b8-324a-aa66-419f065e74d5",
                                                "text": "La salle des fêtes tenait un rôle important dans la vie locale, maintenant on appelle ça de trente autres noms, on a droit à espace culturel au lieu de salle polyvalente. Je suppose qu'avant l'âge des salles des fêtes on se contentait des granges, d'une salle fournie par la mairie, du préau de l'école ou de sa version école catholique, le patronage."
                                            },
                                            {
                                                "example_id": "00456869-eb59-4c04-a505-a6fba418bd4a",
                                                "sense_id": "95ea5445-80b8-324a-aa66-419f065e74d5",
                                                "text": "La salle des fêtes était habillée pour une grande cérémonie, de somptueux rideaux blancs et pourpres qui tombaient du haut plafond jusqu'au bas des portes et des fenêtres."
                                            },
                                            {
                                                "example_id": "152794ac-dd4f-4e7a-8bfb-294b4e2453b0",
                                                "sense_id": "95ea5445-80b8-324a-aa66-419f065e74d5",
                                                "text": "Bien sûr vous avez commencé votre visite par la salle des fêtes, mais Patelin vaut vraiment le détour, puisque dans le genre, c'est le nec plus ultra des trous paumés."
                                            },
                                            {
                                                "example_id": "12119ad4-8d2f-4c7d-a4ca-66fe4d418652",
                                                "sense_id": "95ea5445-80b8-324a-aa66-419f065e74d5",
                                                "text": "Fabio revoyait leurs soixante-deux invités entassés dans cette petite salle des fêtes surchauffée de la mairie, tout enguirlandée pour l’occasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56876916-1cf4-391b-aa60-bc728c8eb187",
                                        "entry_id": "c05d90fd-cde6-3195-bdf5-5e8339149e3c",
                                        "glosses": [
                                            "Vagin."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdda4142-6599-4919-9d4e-352dbf7d1383",
                                                "sense_id": "56876916-1cf4-391b-aa60-bc728c8eb187",
                                                "text": "Les termes flatteurs disparaissent dès qu'on passe à la langue populaire, qui n'a pas assez de termes crus pour évoquer le sexe stricto sensu en l'appelant la «tirelire», le trou qui pisse ou, et c'est un moindre mal, la salle des fêtes!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
