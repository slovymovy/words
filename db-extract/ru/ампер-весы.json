                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04bee429-db4d-4503-956a-b437cad36ed3",
                                                "sense_id": "1e105693-6295-376a-a39d-9d2c8e6ab452",
                                                "text": "The mantle is important to our discussion in that its viscous nature can conduct convection currents that have effects on the crust upon which we live."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55254497-c013-3605-837f-17035251ab2d",
                                        "entry_id": "28c390a3-dc10-31de-b373-9daf8fb690c0",
                                        "glosses": [
                                            "The part of a fluid that moves continuously in a certain direction, especially (oceanography) ellipsis of ocean current."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1d6567e-171e-3054-94d5-90af37a6c804",
                                        "entry_id": "28c390a3-dc10-31de-b373-9daf8fb690c0",
