                        "glosses": [
                            "Pertaining to or influenced by Bardaisan; Bardaisanite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea248809-f67c-4c04-ba92-2cca71d69d94",
                                "sense_id": "2756b742-111c-36cf-b444-7cec2baac3db",
                                "text": "As a matter of fact these chapters coincide pretty closely with the Book of the Laws of Countries extant in Syriac and in part in Greek, written by an early Bardesanist ; and comparison shows that the Recognitions borrowed from the Bardesanist Book , not vice versâ ”"
                            },
                            {
                                "example_id": "9b407bec-6231-4d76-92c6-56caeda937ff",
                                "sense_id": "2756b742-111c-36cf-b444-7cec2baac3db",
                                "text": "Singing here, as if in harmonious unison, the voices of the self-discovered Cartesian cogito, the Freudian Narcissus, Lacan's mirrored ego, Satre's ego-in-the-look-of-the-other, and Piaget's egocentric child hymn and irenic other, Bardesanist bards minstreling the master narrative that governs physis, bios, and psyche, cosmos, civilization, and self in unending remugience."
                            }
                        ]
                    }
