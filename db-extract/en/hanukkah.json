                                        "glosses": [
                                            "ośmiodniowe święto, upamiętniające zwycięstwo Machabeuszy nad Seleucydami oraz oczyszczenie i ponowne poświęcenie świątyni w Jerozolimie po jej sprofanowaniu poprzez umieszczenie tam bóstw greckich"
                                        ],
                                        "tags": [
                                            "Jewish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ea728ee-a3b2-437d-8fc0-540326d595ae",
                                                "sense_id": "12824a3b-fcf7-38be-90cf-ffcdad1ca58e",
                                                "text": "Przeszłam na judaizm. W piątki wieczorem błogosławię świece. W Chanukę palę kolorowe świeczki. Wie pan, co to jest Chanuka? Takie święto?"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
