                                "target_senses": [
                                    {
                                        "sense_id": "7bfd6bb9-73a4-3ebe-a25e-de506b8c49cf",
                                        "entry_id": "2b3f8dcc-a12b-30c8-9076-b1d1a3778be1",
                                        "glosses": [
                                            "A person of importance in a group or organization."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc0bed0e-af8f-49ea-b61f-75b17afea187",
                                                "sense_id": "7bfd6bb9-73a4-3ebe-a25e-de506b8c49cf",
                                                "text": "The company bigwig is gathering his staff together for a meeting today."
                                            },
                                            {
                                                "example_id": "3d744bc3-ef1e-413d-80d0-462f3db0cdb0",
                                                "sense_id": "7bfd6bb9-73a4-3ebe-a25e-de506b8c49cf",
                                                "text": "[…] more innocently, and no doubt profitably, than if he had dined at a big-wig's board or bemused himself with smoke and beer among his brethren of the pen."
                                            },
                                            {
                                                "example_id": "27bb3ad4-b1c5-474d-9bb8-d777bb61fa79",
                                                "sense_id": "7bfd6bb9-73a4-3ebe-a25e-de506b8c49cf",
                                                "text": "Before her hay-day, she attended many derbys under her dad's celebrity where she'd hobnob with the bigwigs in Millionaire's Row."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
