                "senses": [
                    {
                        "sense_id": "aa8c4332-47a9-33bc-a015-6a62b0b53aab",
                        "entry_id": "6fb695c5-7e17-3a64-b55e-e74f9204a03c",
                        "glosses": [
                            "Sonde (ein unbemannter Flugkörper), die in den Weltraum geschickt wird, um andere Planeten und/oder den Weltraum zu erforschen/untersuchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbb218f1-2c31-49c7-8b2e-6f5c074d3003",
                                "sense_id": "aa8c4332-47a9-33bc-a015-6a62b0b53aab",
                                "text": "„Würde eine Raumsonde zur Erde gleiten, um nach Lebewesen zu suchen, wären die ersten konkreten Lebenszeichen in einer Höhe von etwa 20 km zu finden, und zwar Mikroben, Sporen und Pollenkörner, die vom Wind dorthin befördert wurden.“"
                            },
                            {
                                "example_id": "ed732413-938a-4607-a103-0a33dd9e9a6a",
                                "sense_id": "aa8c4332-47a9-33bc-a015-6a62b0b53aab",
                                "text": "„Würde die Raumsonde auf der Erde aufsetzten, stieße sie wahrscheinlich sofort auf Leben.“"
                            },
                            {
                                "example_id": "2dc65b9b-c198-4a47-87d8-7d1c458e19d7",
                                "sense_id": "aa8c4332-47a9-33bc-a015-6a62b0b53aab",
                                "text": "„Amateurastronomen haben mit einem Teleskop in den Niederlanden Signale der Raumsonde Voyager 1 empfangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
