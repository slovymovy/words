                    {
                        "translation_id": "7b494269-01b0-41af-82b0-aa5d0ebf73ff",
                        "source_entry_id": "a8824976-0d20-360d-90cf-edee22a9610a",
                        "source_sense_id": "f686ce52-0701-3ff1-aaee-2606cf76ef4b",
                        "target_lang_word": "Zwergstaat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwergstaat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99eb4add-7afe-3d63-beee-48087455e799",
                                        "entry_id": "3ee9f1c4-8cfd-30b0-bf93-ab1a6c97da5f",
                                        "glosses": [
                                            "Staat mit besonders geringer Fläche und kleiner Bevölkerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0fcc536-261b-46d8-a567-d7fbe6ff9e76",
                                                "sense_id": "99eb4add-7afe-3d63-beee-48087455e799",
                                                "text": "„Die Fahrt damals in der miefigen Stretchlimo... auf dieser Reise zu irgendeinem abgelegenen Drehort in Angola oder Algerien oder Alaska beklagte sich der kulturelle Kontaktmann des Zwergstaats vor Ort bei uns darüber, Guerillakämpfer hätten ganze Schiffsladungen überschüssigen Käses aus den Vereinigten Staaten gekapert, und der Verlust dieser lebenswichtigen Quelle nährstoffreicher Proteinkonzentrate habe zur Folge, dass in sämtlichen Dörfern der Region Hunger herrsche.“"
                                            },
                                            {
                                                "example_id": "354f9480-939b-40ab-b73f-0fcdde5bca90",
                                                "sense_id": "99eb4add-7afe-3d63-beee-48087455e799",
                                                "text": "„Der Stadtstaat liegt innerhalb der italienischen Hauptstadt Rom und ist damit als Enklave vollständig von Italien umgeben. Aufgrund seiner geringen Fläche von 0,49 Quadratkilometern und seinen insgesamt etwa 1000 Einwohnern wird die Vatikanstadt als Zwergstaat bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
