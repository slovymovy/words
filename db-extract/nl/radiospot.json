                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f2d5d71-5477-405f-9916-25751a595b1e",
                                "sense_id": "37f2bdb7-6256-3552-b456-cf21ca8562ba",
                                "text": "Minister Ferd Grapperhaus van Justitie en Veiligheid zegt: „Het is voor iedereen logisch de buitendeur op slot te draaien, maar dat geldt niet voor onze digitale deuren.” De campagne, die er ook op is gericht foute links te leren herkennen, is te zien op sociale media als Facebook, Twitter en Snapchat. Ook is er een radiospot."
                            },
                            {
                                "example_id": "8fd7c6ec-8191-48a9-a1b4-38a430ecbd25",
                                "sense_id": "37f2bdb7-6256-3552-b456-cf21ca8562ba",
                                "text": "Renault gaf net als vorig jaar het meest uit aan radiospotjes. Op de tweede plaats staat Ziggo, voor de winkelketens Kruidvat en Lidl. T-Mobile verdubbelde zijn radio-uitgaven en steeg daardoor naar de vijfde plaats."
                            }
                        ]
                    }
