{
    "word_family": [
        "aanhang",
        "aanhanger",
        "aanhangsel",
        "aanhankelijk"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "317d9c33-4128-3dbd-a253-fed69433df52",
                    "sense_definition": "een bepaald idee, geloof of een filosofie steunen en volgen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "overtuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel mensen in deze regio <w>hangen</w> een specifieke politieke ideologie <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "Many people in this region <w>adhere to</w> a specific political ideology."
                            }
                        },
                        {
                            "text": "Hij bleef zijn principes trouw en <w>hing</w> de oude tradities <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "He remained true to his principles and <w>followed</w> the old traditions."
                            }
                        }
                    ],
                    "synonyms": [
                        "volgen",
                        "steunen",
                        "toegedaan zijn"
                    ],
                    "antonyms": [
                        "verwerpen",
                        "bestrijden"
                    ],
                    "common_phrases": [
                        "een geloof aanhangen",
                        "een theorie aanhangen"
                    ],
                    "target_lang_definitions": {
                        "en": "To support and follow a specific idea, belief, or philosophy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adhere to",
                                "target_lang_sense_clarification": "to follow a belief or ideology"
                            },
                            {
                                "target_lang_word": "subscribe to",
                                "target_lang_sense_clarification": "to agree with or support an idea"
                            },
                            {
                                "target_lang_word": "follow",
                                "target_lang_sense_clarification": "to be a follower of a doctrine"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ea82815-2d42-3a4b-ac8b-d727c7a4cde2",
                    "sense_definition": "iets ergens aan vastmaken zodat het naar beneden hangt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bevestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er werd een klein merkteken aan de koffer <w>aangehangen</w> voor identificatie.",
                            "target_lang_translations": {
                                "en": "A small mark was <w>attached</w> to the suitcase for identification."
                            }
                        },
                        {
                            "text": "Je kunt het label eenvoudig <w>aanhangen</w> met een touwtje.",
                            "target_lang_translations": {
                                "en": "You can easily <w>hang</w> the label <w>on</w> with a piece of string."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevestigen",
                        "vastmaken"
                    ],
                    "antonyms": [
                        "afhalen",
                        "losmaken"
                    ],
                    "common_phrases": [
                        "een label aanhangen",
                        "een kaartje aanhangen"
                    ],
                    "target_lang_definitions": {
                        "en": "To attach something to something else so that it hangs down."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "attach",
                                "target_lang_sense_clarification": "to fasten a tag or label"
                            },
                            {
                                "target_lang_word": "hang on",
                                "target_lang_sense_clarification": "to suspend something from an object"
                            },
                            {
                                "target_lang_word": "append",
                                "target_lang_sense_clarification": "to add or attach as an accessory"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "620e02b2-1cae-3dbf-a0b6-14c9f8b822cc",
                    "sense_definition": "door te hangen ergens aan vast blijven zitten",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vastzitten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de regenbui <w>hing</w> er nog een grote druppel aan de tak.",
                            "target_lang_translations": {
                                "en": "After the rain shower, a large drop was still <w>clinging</w> to the branch."
                            }
                        },
                        {
                            "text": "Er <w>hingen</w> nog wat resten van het papier aan de muur.",
                            "target_lang_translations": {
                                "en": "Some remnants of the paper were still <w>hanging</w> on the wall."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastzitten",
                        "kleven"
                    ],
                    "common_phrases": [
                        "er hangt iets aan"
                    ],
                    "target_lang_definitions": {
                        "en": "To remain attached to something by hanging."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cling to",
                                "target_lang_sense_clarification": "to stick or hold onto something"
                            },
                            {
                                "target_lang_word": "hang from",
                                "target_lang_sense_clarification": "to be suspended from something"
                            },
                            {
                                "target_lang_word": "stick to",
                                "target_lang_sense_clarification": "to remain attached"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}