    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43203194-a391-3b88-9e26-42325f59b23b",
                    "sense_definition": "A fixed portion of a limited resource, especially food, allocated to a person or group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The daily <w>ration</w> of bread was barely enough to keep the soldiers going."
                        },
                        {
                            "text": "During the war, every family received a small <w>ration</w> of sugar and coffee."
                        }
                    ],
                    "common_phrases": [
                        "daily ration",
                        "food ration"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf9d7667-3f31-32f9-ae55-a285c4072711",
                    "sense_definition": "To distribute a limited supply of something in small, controlled amounts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>ration</w> our water supply carefully while lost in the desert."
                        },
                        {
                            "text": "The government decided to <w>ration</w> fuel to ensure everyone had enough for emergencies."
                        }
                    ],
                    "synonyms": [
                        "Hooverize"
                    ],
                    "common_phrases": [
                        "ration water",
                        "ration supplies"
                    ]
                },
                {
                    "sense_id": "8f2b6309-39a8-3aba-9957-e20a38761d2e",
                    "sense_definition": "To limit someone to a specific, restricted allowance of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach <w>rationed</w> the players to only one sports drink after the game."
                        },
                        {
                            "text": "Parents often <w>ration</w> their children to a limited amount of screen time each day."
                        }
                    ],
                    "common_phrases": [
                        "ration someone"
                    ]
                },
                {
                    "sense_id": "4e361cb4-3742-3df5-ae8f-786b8c98baa2",
                    "sense_definition": "To restrict access to a service or activity, often based on eligibility or cost.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics argue that the new policy will <w>ration</w> healthcare to only the wealthiest citizens."
                        },
                        {
                            "text": "Access to the exclusive club is <w>rationed</w> by a strict membership committee."
                        }
                    ]
                }
            ]
        }
    ]
