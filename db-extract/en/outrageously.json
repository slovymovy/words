                "senses": [
                    {
                        "sense_id": "1d174904-54da-3d77-ba96-2088f2b21c5b",
                        "entry_id": "6078fd25-121b-3946-84be-ab553000fc6f",
                        "glosses": [
                            "In an outrageous manner; to an outrageous degree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40b82b4c-f229-4d89-b844-275b7b7ccd67",
                                "sense_id": "1d174904-54da-3d77-ba96-2088f2b21c5b",
                                "text": "The hotel was wonderful, but the food was outrageously expensive."
                            },
                            {
                                "example_id": "b2537bdb-c92e-4328-828f-9b8a1d6f8720",
                                "sense_id": "1d174904-54da-3d77-ba96-2088f2b21c5b",
                                "text": "[…] John Currin moved from painting yearbookish images of anonymous girls to painting outrageously goofy pictures of women with ridiculously oversize breasts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa8d4dda-ab9f-40c0-9c5a-74b9556cb973",
                        "source_entry_id": "6078fd25-121b-3946-84be-ab553000fc6f",
