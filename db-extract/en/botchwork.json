                        "examples": [
                            {
                                "example_id": "dd1637aa-cc21-40d6-8a01-4ab0e6c098c1",
                                "sense_id": "8a941966-1327-3098-bb3d-6b7716b25d4f",
                                "text": "Dilettanteism presupposes art as botchwork does handicraft; and the Dilettante holds the same relation to the artist that the botcher does to the craftsman. From handicraft the way is open to rise in art but not from botchwork."
                            },
                            {
                                "example_id": "52d2deba-816c-432a-afee-26dc2406846d",
                                "sense_id": "8a941966-1327-3098-bb3d-6b7716b25d4f",
                                "text": "Yet, to make good speed on the right track, we must not start overloaded; not too many things to be undertaken, lest they prove hasty botchwork."
                            }
                        ]
                    }
