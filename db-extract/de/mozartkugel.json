                ],
                "senses": [
                    {
                        "sense_id": "3ed25e28-82dc-39a4-ad44-3a780dcb9100",
                        "entry_id": "2e82db61-5646-30ff-b306-76dd95ec6fc2",
                        "glosses": [
                            "kugelförmige Schokoladenpraline, die mit Marzipan gefüllt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1819c85-437c-45ad-8969-ac22e1a82b43",
                                "sense_id": "3ed25e28-82dc-39a4-ad44-3a780dcb9100",
                                "text": "Er bot seinen Gästen Mozartkugeln zum Essen an."
                            },
                            {
                                "example_id": "8caf7519-9329-49e5-a50b-a7355ed08dd6",
                                "sense_id": "3ed25e28-82dc-39a4-ad44-3a780dcb9100",
                                "text": "„Außer den berühmten Mozartkugeln kann man in Salzburg in besonders vielen Gourmetrestaurants lecker speisen.“"
                            },
                            {
                                "example_id": "714914f2-c82d-4ccf-89e8-f571dad1dc42",
                                "sense_id": "3ed25e28-82dc-39a4-ad44-3a780dcb9100",
                                "text": "„Beim Kaufhof am Berliner Alexanderplatz reicht die Spanne vom preiswerten Schokokalender für 79 Cent bis zum Großen Reber Kalender (24,95 Euro), der mit Mozartkugeln und anderen Pralinen-Spezialitäten gefüllt ist.“"
                            },
                            {
                                "example_id": "d87295af-07c7-4cad-bd43-79e78fed449a",
                                "sense_id": "3ed25e28-82dc-39a4-ad44-3a780dcb9100",
                                "text": "„Der weltweite Jahresumsatz an Mozartkugeln übersteigt jede Vorstellungskraft und ist, da zig Hersteller ihr Konfekt unter solchem Namen auf den Markt bringen, nicht zuverlässig zu ermitteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
