                    {
                        "sense_id": "b42c5ac2-51a1-395c-8c6e-1f93824c255e",
                        "entry_id": "fcfdb867-9878-3559-8804-11f51c55bf3c",
                        "glosses": [
                            "naczynie służące do przechowywania szczątków zmarłego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9bd2320-9137-4e2a-81cf-d080efd18cb6",
                                "sense_id": "b42c5ac2-51a1-395c-8c6e-1f93824c255e",
                                "text": "Ossuarium, w którym pochowano Jakuba, jest dość proste i pozbawione ozdób."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e9256824-e4e1-3439-a5f8-d216f4abb95e",
                        "entry_id": "fcfdb867-9878-3559-8804-11f51c55bf3c",
                        "glosses": [
                            "budowla lub pomieszczenie ze szczątkami zmarłych, często w obrębie cmentarza"
                        ],
                        "tags": [],
