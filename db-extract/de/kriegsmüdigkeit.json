                ],
                "senses": [
                    {
                        "sense_id": "08438ab8-d397-3310-b081-d6621139a61d",
                        "entry_id": "f36fca2e-928d-3c9f-abda-659d7aa30a07",
                        "glosses": [
                            "Ablehnung einer Aufnahme oder Fortsetzung des Krieges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e31195d2-8b6d-4819-bab6-50f7882b8712",
                                "sense_id": "08438ab8-d397-3310-b081-d6621139a61d",
                                "text": "„Aus einem Bericht des Wehrkreiskommando XVII (Wien) vom März 1945: allenorten machen sich Kriegsmüdigkeit, Überreizung und zum Teil auch nicht nur defätistische, sondern ausgesprochen destruktive Tendenzen bemerkbar.“"
                            },
                            {
                                "example_id": "ec347e5c-44ee-482b-9d52-f59f0d238490",
                                "sense_id": "08438ab8-d397-3310-b081-d6621139a61d",
                                "text": "„Auch in Bayern war das Volk kriegsmüde, zur Kriegsmüdigkeit kam die Angst, daß italienische Truppen nach dem Zusammenbruch Österreichs in Bayern einmarschieren würden.“"
                            },
                            {
                                "example_id": "1431fdf9-6b66-41af-b6ab-6acdbfa8011c",
                                "sense_id": "08438ab8-d397-3310-b081-d6621139a61d",
                                "text": "„Weder ausschließlich noch vorwiegend der Liebknecht-Flügel nährte die Kriegsmüdigkeit in der Provinz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
