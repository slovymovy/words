                ],
                "senses": [
                    {
                        "sense_id": "a17526c2-b8f6-3d1e-b5b6-595327c2f016",
                        "entry_id": "7e8e6229-d747-3236-a5b5-6452fb749f49",
                        "glosses": [
                            "Caractère de ce qui est soudain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c5a8870-6cea-4713-b6b2-0a588f78c3d4",
                                "sense_id": "a17526c2-b8f6-3d1e-b5b6-595327c2f016",
                                "text": "Avec cette soudaineté d’action qui distingue les gens du midi, Gazonal sauta de l’hôtel dans la rue, de la rue dans un cabriolet, et alla rue de Berlin chez son cousin."
                            },
                            {
                                "example_id": "b608cc99-151a-4ef0-a95f-04bcbaeaf3cf",
                                "sense_id": "a17526c2-b8f6-3d1e-b5b6-595327c2f016",
                                "text": "Rien dans les langages humains, aucune traduction de la pensée faite à l’aide des couleurs, des marbres, des mots ou des sons, ne saurait rendre le nerf, la vérité, le fini, la soudaineté du sentiment dans l’âme !"
                            },
                            {
                                "example_id": "03628717-6a72-46d7-ac82-da5896460f20",
                                "sense_id": "a17526c2-b8f6-3d1e-b5b6-595327c2f016",
                                "text": "Bert avait serré les freins avec une telle soudaineté que la jeune fille se trouva lancée entre ses jambes au moment où il mettait pied à terre."
                            },
                            {
                                "example_id": "c5bb7b85-45b1-49ef-8de9-3c09cfdc3162",
                                "sense_id": "a17526c2-b8f6-3d1e-b5b6-595327c2f016",
                                "text": "Il ne pouvait cependant échapper à un homme réfléchi que les cataclysmes fondent sur une nation avec la soudaineté de la tempête en mer calme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19469723-e0bc-4062-8f3d-578167b93355",
                        "source_entry_id": "7e8e6229-d747-3236-a5b5-6452fb749f49",
                        "source_sense_id": "a17526c2-b8f6-3d1e-b5b6-595327c2f016",
                        "target_lang_word": "Plötzlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plötzlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02c2a48c-bfcb-3bf3-9c0c-856373f3cf01",
                                        "entry_id": "5b0a4a83-989e-37f8-9ed3-2ed8d4c60dfc",
                                        "glosses": [
                                            "Eigenschaft eines Vorgangs, der sich schlagartig/unvermittelt ereignet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aad0de78-2b4b-4c12-b0c2-ac0ca8d81612",
                                                "sense_id": "02c2a48c-bfcb-3bf3-9c0c-856373f3cf01",
                                                "text": "„Die Sterne erschienen mit jäher Plötzlichkeit wie hergezaubert.“"
                                            },
                                            {
                                                "example_id": "135ba0d2-d995-4697-b11f-fb7394161c76",
                                                "sense_id": "02c2a48c-bfcb-3bf3-9c0c-856373f3cf01",
                                                "text": "„Der Zusammenbruch von Autorität und Macht, der in der Regel nicht nur die Zeitungsleser in seiner Plötzlichkeit überrascht, sondern auch alle Geheimdienste und ihre Experten, die solche Dinge beobachten, wird nur dann zu einer Revolution im vollen Wortsinne, wenn Menschen bereit und in der Lage sind, die Macht aufzugreifen, in das Machtvakuum vorzustoßen und sozusagen einzudringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
