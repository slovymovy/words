                "senses": [
                    {
                        "sense_id": "88c3a06f-d569-33d6-a2b9-3a93a81ffd7e",
                        "entry_id": "0db78f6f-a83a-3a86-99d8-91e331029133",
                        "glosses": [
                            "struktura występująca w cytoplazmie komórki, wyspecjalizowana do pełnienia określonej funkcji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b64d88d-e773-4032-a1ea-9f33f20095f9",
                                "sense_id": "88c3a06f-d569-33d6-a2b9-3a93a81ffd7e",
                                "text": "Do organelli zalicza się m.in. mitochondria, plastydy i retikulum endoplazmatyczne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bccae24-7c9c-4601-800b-2d9b4d5a4a8e",
