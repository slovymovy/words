                                    {
                                        "sense_id": "085bbd53-b94b-3b6d-900b-3e8e42c7ad36",
                                        "entry_id": "900c09f6-5f3e-39c8-910c-371ea1b20efd",
                                        "glosses": [
                                            "Person, die etwas überbringt, zum Beispiel eine Nachricht, Laufbursche einer Firma"
                                        ],
                                        "tags": [
                                            "deshalb auch für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8139632-1fd4-4360-8037-067900277ff3",
                                                "sense_id": "085bbd53-b94b-3b6d-900b-3e8e42c7ad36",
                                                "text": "Der Bote wurde vom Feind abgefangen und so erreichte die Nachricht nie ihren Bestimmungsort."
                                            },
                                            {
                                                "example_id": "e46278ac-da4f-4a85-8677-f632a75c752d",
                                                "sense_id": "085bbd53-b94b-3b6d-900b-3e8e42c7ad36",
                                                "text": "„Am Nachmittag schickte der Kaiser einen Boten mit weißer Flagge zu den russischen Linien, der eine Botschaft an den Oberkommandierenden überbringen sollte.“"
                                            },
                                            {
                                                "example_id": "004fc720-1042-41ad-9a26-4383aa540b02",
                                                "sense_id": "085bbd53-b94b-3b6d-900b-3e8e42c7ad36",
                                                "text": "„Väsele Li bat ihn durch den kleinen Boten zur Besprechung in ihre hinteren Gemächer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb06ed33-1d46-3553-89e4-8c83ea7bf557",
                                        "entry_id": "900c09f6-5f3e-39c8-910c-371ea1b20efd",
                                        "glosses": [
                                            "erstes Anzeichen für etwas"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff694b61-eb2e-455d-953c-c662f625cdd7",
                                                "sense_id": "eb06ed33-1d46-3553-89e4-8c83ea7bf557",
                                                "text": "Als erster Bote des Morgens erschien ein dünner roter Streifen über den Bergen im Osten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
