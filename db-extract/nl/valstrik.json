                    {
                        "sense_id": "9ccb8530-b7cd-36ff-81aa-ad58a4eb1416",
                        "entry_id": "7c2ed52f-f97c-3086-94b8-1b1a3ef8e709",
                        "glosses": [
                            "een contraptie of manipulatie bedoeld mens of dier te vangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bcb207b-d18c-4319-a8a6-4841453efdf6",
                                "sense_id": "9ccb8530-b7cd-36ff-81aa-ad58a4eb1416",
                                "text": "Die uitnodiging was duidelijk een valstrik."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9aaf1499-3632-4c89-ab2c-e13ab77c6cab",
                        "source_entry_id": "7c2ed52f-f97c-3086-94b8-1b1a3ef8e709",
                        "source_sense_id": "9ccb8530-b7cd-36ff-81aa-ad58a4eb1416",
                        "source_sense_description": "een contraptie of manipulatie bedoeld mens of dier te vangen",
                        "target_lang_word": "Fallstrick",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fallstrick",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                        "entry_id": "f300070b-af81-35d4-a1c4-eb747cfb0257",
                                        "glosses": [
                                            "Mittel, um jemanden zu Fall zu bringen oder zu schaden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c361a54-b213-424a-a465-d11a12170ffd",
                                                "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                                "text": "„So gilt Brigitte Ederer etwa als eine sehr erfahrene Personalerin, die lange auf ihrem Posten war und wohl eher über politische Fallstricke gestolpert ist als über eigenes Versagen.“"
                                            },
                                            {
                                                "example_id": "33e6be87-81a2-427e-a11b-e6fcf59d4b28",
                                                "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                                "text": "„Aber sein Weg war voller Fallstricke.“"
                                            },
                                            {
                                                "example_id": "30200dd1-c849-447f-86a1-36cafcc19b4e",
                                                "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                                "text": "„Ich glaubte im Gegenteil, gerade weil ich C. C. liebte, müsse ich hingehen, um sie vor anderen Fallstricken zu bewahren.“"
                                            },
                                            {
                                                "example_id": "6ad1597d-145e-4e12-a883-cac7fa0962a9",
                                                "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                                "text": "„Wenn man mit 280 Zeichen langen Tweets Wahlen beeinflussen, Pandemien kartieren und Märkte erschüttern kann, kommt es darauf an, die Verheißungen und Fallstricke von Buchstaben, Schriftarten, Emojis und Satzzeichen, vor allem aber der paradoxen !!! zu verstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03ee9f93-b30a-408d-a378-2013b4e39209",
                        "source_entry_id": "7c2ed52f-f97c-3086-94b8-1b1a3ef8e709",
                        "source_sense_id": "9ccb8530-b7cd-36ff-81aa-ad58a4eb1416",
                        "source_sense_description": "een contraptie of manipulatie bedoeld mens of dier te vangen",
                        "target_lang_word": "List",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "List",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a01352c-6278-33ac-9c44-424fc59a5b4a",
                                        "entry_id": "797c4597-1017-34c2-9601-7aa97f33f254",
                                        "glosses": [
                                            "schlauer Plan, ein bestimmtes Ziel mithilfe einer Täuschung zu erreichen"
                                        ],
                                        "tags": [
                                            "zählbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d4af74e-cf13-4d5c-a43b-1d39a202380a",
                                                "sense_id": "1a01352c-6278-33ac-9c44-424fc59a5b4a",
                                                "text": "Das war eine teuflische List."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ec14455-8356-365e-81b9-b1856d9b470a",
                                        "entry_id": "797c4597-1017-34c2-9601-7aa97f33f254",
                                        "glosses": [
                                            "Fähigkeit und Gewohnheit, seine Ziele durch Täuschung zu erreichen"
                                        ],
                                        "tags": [
                                            "unzählbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87338cd0-5e7d-4c01-b942-efa73ff98370",
                                                "sense_id": "5ec14455-8356-365e-81b9-b1856d9b470a",
                                                "text": "Er siegt mit List, nicht mit Gewalt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "List",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "232fd94d-31d8-3b6c-b465-79707e1f28ae",
                                        "entry_id": "77c1b948-bcfe-34c8-be20-2e757f199a02",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ff74e19-2579-404c-a72e-bc2423885ef3",
                                                "sense_id": "232fd94d-31d8-3b6c-b465-79707e1f28ae",
                                                "text": "Der List trägt nie die Schals, die die List ihm strickt."
                                            },
                                            {
                                                "example_id": "84edd740-42f1-49f1-b0b3-b9b3f6601504",
                                                "sense_id": "232fd94d-31d8-3b6c-b465-79707e1f28ae",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau List kommt, geht der Herr List.“"
                                            },
                                            {
                                                "example_id": "2f0456a2-cd1e-4353-b397-8c5ae7c1f170",
                                                "sense_id": "232fd94d-31d8-3b6c-b465-79707e1f28ae",
                                                "text": "List kommt und geht."
                                            },
                                            {
                                                "example_id": "a9a4c76b-f526-4a9d-abfc-f6aa216f653b",
                                                "sense_id": "232fd94d-31d8-3b6c-b465-79707e1f28ae",
                                                "text": "Lists kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "7f4e0fb5-d0f2-4625-9881-b4b8c6121c66",
                                                "sense_id": "232fd94d-31d8-3b6c-b465-79707e1f28ae",
                                                "text": "Frau List ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "a205b99a-be0a-4488-ab51-557a2694b51b",
                                                "sense_id": "232fd94d-31d8-3b6c-b465-79707e1f28ae",
                                                "text": "Herr List wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "62132ac0-d4ee-4c4b-9bff-b4a3975d9e63",
                                                "sense_id": "232fd94d-31d8-3b6c-b465-79707e1f28ae",
                                                "text": "Die Lists fliegen heute nach La Paz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "List",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29798592-aa10-3418-8bc2-dc7e34dec0ba",
                                        "entry_id": "13c9b811-747f-3101-ab6f-3e0c750f66d2",
                                        "glosses": [
                                            "ein Seebad im Norden der Insel Sylt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c27fa467-2211-4f9e-bff5-b4197cb25a0c",
                                                "sense_id": "29798592-aa10-3418-8bc2-dc7e34dec0ba",
                                                "text": "Warum die Knutsons jeden Urlaub in List verbringen, weiß ich nicht."
                                            },
                                            {
                                                "example_id": "1759a639-5d17-466e-9a6f-6577b882ce54",
                                                "sense_id": "29798592-aa10-3418-8bc2-dc7e34dec0ba",
                                                "text": "„Der Ort List ist von einer Landschaft aus Wanderdünen, Heide und Salzwiesen umgeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
