                "senses": [
                    {
                        "sense_id": "a73c846f-9d0e-3794-bfe3-4cf2034c50b7",
                        "entry_id": "2588d04e-b8d6-394b-a110-65ca82445084",
                        "glosses": [
                            "Fach- und/oder Führungskraft in der Gastronomie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79bed49c-541b-450e-8f37-a55678f40239",
                                "sense_id": "a73c846f-9d0e-3794-bfe3-4cf2034c50b7",
                                "text": "„Der Gastronom Fred Austin sagt, dass er bei sich im ‚Katz's‘ keine Toilettentüren hatte wegen der Junkies.“"
                            },
                            {
                                "example_id": "ff5c7968-586f-456c-bcbc-54bf2433e930",
                                "sense_id": "a73c846f-9d0e-3794-bfe3-4cf2034c50b7",
                                "text": "„Gastronomen und Gastronominnen übernehmen qualifizierte Fach- und Führungsaufgaben in Unternehmen der Gastronomie.“"
                            },
                            {
                                "example_id": "cb32f99f-376e-481f-aa17-746983c12c4d",
                                "sense_id": "a73c846f-9d0e-3794-bfe3-4cf2034c50b7",
                                "text": "„Mein Onkel sah unsere Gegend durch die Augen eines Gastes, ich weiß aber, dass Gastronomen es hier schwer haben.“"
                            },
                            {
                                "example_id": "ab70c1c5-43a1-457f-b0d3-ea061beec44b",
                                "sense_id": "a73c846f-9d0e-3794-bfe3-4cf2034c50b7",
                                "text": "„Dem Gastronomen und seinen Mitarbeitern ist es mittlerweile gelungen, sich sehr gut in die besonderen Anforderungen einer Clubgastronomie einzufinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
