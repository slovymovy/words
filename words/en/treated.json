        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2c2108b5-1494-3fcb-9986-8944c1da3371",
                    "sense_definition": "Subjected to a chemical or physical process to improve, protect, or alter it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>treated</w> wood is resistant to rot and insects.",
                            "target_lang_translations": {
                                "ru": "<w>Обработанная</w> древесина устойчива к гниению и насекомым.",
                                "cs": "<w>Ošetřené</w> dřevo je odolné vůči hnilobě a hmyzu."
                            }
                        },
                        {
                            "text": "They used chemically <w>treated</w> water for the experiment.",
                            "target_lang_translations": {
                                "ru": "Для эксперимента они использовали химически <w>обработанную</w> воду.",
                                "cs": "Pro experiment použili chemicky <w>upravenou</w> vodu."
                            }
                        }
                    ],
                    "synonyms": [
                        "processed",
                        "prepared",
                        "cured"
                    ],
                    "antonyms": [
                        "untreated",
                        "raw",
                        "natural"
                    ],
                    "common_phrases": [
                        "treated wood",
                        "treated water",
                        "chemically treated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергнутый химической или физической обработке для улучшения, защиты или изменения свойств.",
                        "cs": "Podrobený chemickému nebo fyzikálnímu procesu za účelem zlepšení, ochrany nebo změny vlastností."
                    },
