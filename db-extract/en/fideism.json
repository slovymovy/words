                "senses": [
                    {
                        "sense_id": "2c11aa3a-1a86-3e5b-a8ed-b7a7c00aef25",
                        "entry_id": "9b7a4d99-f7ca-3a9d-b007-b10e778f3e6e",
                        "glosses": [
                            "The doctrine that faith is the basis of all knowledge."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0394cafa-cb2b-490a-9802-4ff9c1082837",
                                "sense_id": "2c11aa3a-1a86-3e5b-a8ed-b7a7c00aef25",
                                "text": "We were warned at Cambridge, your grace, of the dangers of what is termed fideism."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa56e14e-880b-4290-ab9e-e4aaa0029b9e",
                        "source_entry_id": "9b7a4d99-f7ca-3a9d-b007-b10e778f3e6e",
                        "source_sense_id": "2c11aa3a-1a86-3e5b-a8ed-b7a7c00aef25",
                        "source_sense_description": "doctrine",
                        "target_lang_word": "fidéisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fidéisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a796c86f-73f3-3169-b868-cbeb2f0fd023",
                                        "entry_id": "80917983-9865-3cda-bb4f-fff4971194ee",
                                        "glosses": [
                                            "Doctrine philosophique qui fonde la certitude des vérités essentielles de l’ordre moral, non seulement surnaturel, mais même naturel, sur la révélation et sur la foi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a2a2957-e01e-4131-b444-90cc79a63af5",
                                                "sense_id": "a796c86f-73f3-3169-b868-cbeb2f0fd023",
                                                "text": "Ceux-ci, allant du rationalisme de saint Anselme au fidéisme des Ockhamistes, chercheront à délimiter la juridiction réciproque de la raison det de la foi et le concours mutuel qu’elles peuvent se prêter."
                                            },
                                            {
                                                "example_id": "186b7bf3-2532-4102-b923-1cbeb1389181",
                                                "sense_id": "a796c86f-73f3-3169-b868-cbeb2f0fd023",
                                                "text": "Fidéisme temporisateur, soumission zélée au prestige de l'Empire, traditionnalisme têtu, tous ces traits de caractère de l'élite gouvernante canadienne, qui recruta son lot de serviteurs canadiens-français britannisés attirés par les largesses du pouvoir, ne l'ont guère prédisposée à embrasser les idées radicales ou à emprunter les sentiers hasardeux de la révolution et de la rénovation démocratique, dont ses voisins du sud, de la guerre d'indépendance à la guerre de sécession, avaient fourni de redoutables exemples."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eeaf063b-c54f-4b43-aebf-ed158c2830bb",
                        "source_entry_id": "9b7a4d99-f7ca-3a9d-b007-b10e778f3e6e",
                        "source_sense_id": "2c11aa3a-1a86-3e5b-a8ed-b7a7c00aef25",
