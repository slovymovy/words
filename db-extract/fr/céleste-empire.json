                ],
                "senses": [
                    {
                        "sense_id": "aad34a3f-448e-3022-a877-7b630af17cf1",
                        "entry_id": "732c99eb-da0e-37df-bfa6-b3f7580f6521",
                        "glosses": [
                            "La Chine de la période impériale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b6259bf-11a2-40e2-8b61-2de1103e01cd",
                                "sense_id": "aad34a3f-448e-3022-a877-7b630af17cf1",
                                "text": "Ce que je fais là, je me propose de le refaire à Pékin dans une quinzaine de jours. Mais, en attendant les pagodes et les yamens du Céleste-Empire, voici ce que Tiflis offre à mes regards : […]."
                            },
                            {
                                "example_id": "ad98377f-f088-4fc2-8701-c6f0c23ab805",
                                "sense_id": "aad34a3f-448e-3022-a877-7b630af17cf1",
                                "text": "Voici encore, toujours chez M. Koch, un jeune chirobate du Céleste-Empire et une figure d’Ascète, et des griffons, des chimères, des fleurs, des oiseaux, toute une faune quelque peu apocalyptique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "101f06e8-310f-4f8d-b2c1-7a5a27cff024",
                        "source_entry_id": "732c99eb-da0e-37df-bfa6-b3f7580f6521",
                        "source_sense_id": "aad34a3f-448e-3022-a877-7b630af17cf1",
                        "target_lang_word": "Celestial Empire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Celestial Empire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70f88780-c07f-3bf3-9fb6-384631051e69",
                                        "entry_id": "e9ac8e31-9d5c-3758-937e-109101eed665",
                                        "glosses": [
                                            "The Empire of China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5d3d784-9f0b-4e4f-b30e-7323edf1007b",
                                                "sense_id": "70f88780-c07f-3bf3-9fb6-384631051e69",
                                                "text": "It is true, there is Turkish of which I had picked up a few phrases, and there is Chinese of which I did not understand a single word. But I had no fear of remaining dumb in Turkestan and the Celestial Empire."
                                            },
                                            {
                                                "example_id": "0b30e15f-0027-4173-86c1-2f175f82f475",
                                                "sense_id": "70f88780-c07f-3bf3-9fb6-384631051e69",
                                                "text": "Had it not been for the casual discovery in the year 1625 of a deeply buried black marble tablet near Hsi-an containing nearly 1,700 Chinese characters, and a long list of names of priests in Syriac, the fact that such a sect rooted itself in the Celestial Empire would never have been believed, as indeed after the tablet was unearthed it was for a long time discredited."
                                            },
                                            {
                                                "example_id": "bde6052c-e0f4-4388-a189-acc52f1c2601",
                                                "sense_id": "70f88780-c07f-3bf3-9fb6-384631051e69",
                                                "text": "LIKE THE MANDARINS of old, the rulers of China live behind high walls. When they emerge, which they rarely do, they travel in cars with rear windows curtained like sedan chairs.\nThey live in the Chung Nan Hai, a walled park adjacent to the Forbidden City from where ancient dynasties ruled the Celestial Empire."
                                            },
                                            {
                                                "example_id": "49421de7-eafb-4c71-bfae-e5323ca35066",
                                                "sense_id": "70f88780-c07f-3bf3-9fb6-384631051e69",
                                                "text": "[…] Does China want to supplant the U.S. wholesale as the global superpower[…]? Or does it want to retreat and become the celestial empire once more, as the Qing dynasty once called itself—close the doors against all of the barbarians, seize Taiwan because it must[,] to fulfill the aims of Mao in the Civil War, and mostly dominate its near neighbors?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
