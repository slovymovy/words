                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7753bbfc-0bd4-4ad3-959c-dd2c1ab9d299",
                                                "sense_id": "c8d3f33b-a6c5-36a0-a30e-4e6959f511f6",
                                                "text": "Your ideas deserve clarification."
