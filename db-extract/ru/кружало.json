                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b946bcf5-7844-45f0-9eaf-a1e5b8244f18",
                                "sense_id": "7bfcf836-b6f9-340e-9b84-04d3702c9156",
                                "text": "А в кружалах и фартинах царских грамотеи книжные шепотком подметные письма читали."
                            },
                            {
                                "example_id": "c849c604-5166-47ca-bcdf-4c423958d257",
                                "sense_id": "7bfcf836-b6f9-340e-9b84-04d3702c9156",
                                "text": "Ночью подлый народ // До креста пропивался в кружалах…"
                            }
                        ]
                    }
