                "senses": [
                    {
                        "sense_id": "c234984a-8e6d-3625-9264-ce37f127afe8",
                        "entry_id": "7db0e8fe-656c-3134-93cb-ed9f48554207",
                        "glosses": [
                            "Ausgang einer Wahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "528d3e31-6a95-4a26-bf06-f3134a5a3b5c",
                                "sense_id": "c234984a-8e6d-3625-9264-ce37f127afe8",
                                "text": "Der Wahlausgang überraschte viele Beobachter."
                            },
                            {
                                "example_id": "4318de10-b388-4199-b8d2-052c9f2f7007",
                                "sense_id": "c234984a-8e6d-3625-9264-ce37f127afe8",
                                "text": "Wir hatten mit diesem Wahlausgang gerechnet."
                            },
                            {
                                "example_id": "374a04e4-b617-4c4a-a272-76511186bd17",
                                "sense_id": "c234984a-8e6d-3625-9264-ce37f127afe8",
                                "text": "Trotz vieler Umfragen im Vorfeld sind die Wahlausgänge in den einzelnen Bundesländern noch offen."
                            },
                            {
                                "example_id": "8a8aef87-2038-40ac-833e-2ef6f8df97ff",
                                "sense_id": "c234984a-8e6d-3625-9264-ce37f127afe8",
                                "text": "[4. Novmber 2024:] „Wiederholt weigert sich Ex-Präsident Donald Trump, dass er das Resultat unabhängig vom Wahlausgang diesmal anerkennen werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
