                ],
                "senses": [
                    {
                        "sense_id": "904ee865-5b38-3306-b37c-37467f962e21",
                        "entry_id": "bf032085-0e30-366c-8afc-263de5182637",
                        "glosses": [
                            "Krankheitsbild mit mehreren Faktoren/Symptomen (Syndrom), das Nachwirkungen/Langzeitfolgen von Covid-19 beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07206fb9-e455-47a6-9862-3a321920da07",
                                "sense_id": "904ee865-5b38-3306-b37c-37467f962e21",
                                "text": "„Als Post-Covid-Syndrom werden Symptome bezeichnet, die länger als zwölf Wochen nach einer Corona-Infektion andauern.“"
                            },
                            {
                                "example_id": "0adbff31-62ef-43c7-a31e-3d3fd86c90fd",
                                "sense_id": "904ee865-5b38-3306-b37c-37467f962e21",
                                "text": "„Gesundheitsminister Klaus Holetschek (CSU) warnt vor dem Post-Covid-Syndrom als ‚komplexem Krankheitsbild‘, das Experten zufolge etwa zehn Prozent aller an Corona erkrankten Erwachsenen betreffe.“"
                            },
                            {
                                "example_id": "be06d334-9be7-4d2f-93b6-127a32c2a47c",
                                "sense_id": "904ee865-5b38-3306-b37c-37467f962e21",
                                "text": "„Dann ist von Long Covid oder dem Post-Covid-Syndrom die Rede: Erkrankte haben auch vier Wochen nach überstandener Infektion noch körperliche oder psychische Beeinträchtigung.“"
                            },
                            {
                                "example_id": "2dc1927b-d3e9-4653-909c-8c21bc867eb5",
                                "sense_id": "904ee865-5b38-3306-b37c-37467f962e21",
                                "text": "„Gerade was Covid-19 betrifft, scheint es Fallberichten zufolge eine Art Post-Covid-Syndrom zu geben, das körperliche und psychische Komponenten hat.“"
                            },
                            {
                                "example_id": "e43b9a2c-6186-4157-884e-1aec5f9d9f51",
                                "sense_id": "904ee865-5b38-3306-b37c-37467f962e21",
                                "text": "„Alles über 3 Monate wird als Post-Covid-Syndrom bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
