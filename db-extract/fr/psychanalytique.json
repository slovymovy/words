                            {
                                "example_id": "e39bd5d6-5c38-4849-95d3-4555ceb1a23c",
                                "sense_id": "1cd25480-4b2d-31fd-ac90-0bff9343158e",
                                "text": "Psychothérapie psychanalytique."
                            },
                            {
                                "example_id": "9f0e96df-a1e9-44a9-a270-e897ce1c6206",
                                "sense_id": "1cd25480-4b2d-31fd-ac90-0bff9343158e",
                                "text": "Les théories psychanalytiques ont introduit une conception dynamique de la vie mentale."
                            }
                        ]
