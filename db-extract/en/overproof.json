                "senses": [
                    {
                        "sense_id": "92c90b8b-ae96-38af-99e2-4caa82c3f004",
                        "entry_id": "c73bf9ce-cfb4-3911-a576-96fe8b3c908c",
                        "glosses": [
                            "To proof (allow dough containing yeast to rise) excessively."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fe6fadef-ceda-4bf0-a7fc-92c46a4e4d59",
                                "sense_id": "92c90b8b-ae96-38af-99e2-4caa82c3f004",
                                "text": "The product may have an open or irregular grain because of the following: a. Underproofing or Overproofing the Dough. b. Too Little Fermentation. c. Baking in an Oven That is Too Cool."
                            },
                            {
                                "example_id": "2f42f954-8fc2-4f8f-984e-e36b72eb5518",
                                "sense_id": "92c90b8b-ae96-38af-99e2-4caa82c3f004",
                                "text": "[I]f the loaf is overproofed, it will not rise or brown in the oven and will taste of alcohol. Usually, even the act of moving the overproofed loaf into the oven will cause it to collapse and flatten. If this happens, punch down the loaf, reshape it, and proof again. Although the flavor will be slightly compromised, the loaf will be saved. Note: You can only save it once, and this works best if the dough is overproofed by no more than 30 to 45 minutes. If the dough has been forgotten for hours, it's hopeless."
                            },
                            {
                                "example_id": "85b5e03d-1d92-4d6a-9949-62ab48f7b0ac",
                                "sense_id": "92c90b8b-ae96-38af-99e2-4caa82c3f004",
                                "text": "Learn when dough is ready to be shaped. When the first rise is complete, dough should feel airy and have a lightness to it. […] With time, you will learn when the dough's lightness is good and be able to catch it before it overproofs."
                            }
                        ]
                    }
