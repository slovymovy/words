        "fr-extract.jsonl": [
            {
                "entry_id": "4bf3511d-10e8-3181-8107-54c3ba0693d5",
                "word": "talmouse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "729cf84b-1048-47ac-be15-73132b23d642",
                        "entry_id": "4bf3511d-10e8-3181-8107-54c3ba0693d5",
                        "tags": [
                            "plural"
                        ],
                        "form": "talmouses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf2a3bac-4e6c-3b77-8738-b72c99b9d2fd",
                        "entry_id": "4bf3511d-10e8-3181-8107-54c3ba0693d5",
                        "glosses": [
                            "Pâtisserie faite avec de la crème, de la farine, du fromage, des œufs, du sucre et du beurre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad604ec5-6e56-4c05-a78f-41dfd8e867f4",
                                "sense_id": "bf2a3bac-4e6c-3b77-8738-b72c99b9d2fd",
                                "text": "Des talmouses de saint Denis."
                            },
                            {
                                "example_id": "61482929-e5df-4620-baf7-21012193cd3d",
                                "sense_id": "bf2a3bac-4e6c-3b77-8738-b72c99b9d2fd",
                                "text": "…et les classiques talmouses, autrefois en vogue à Paris, exilées aujourd’hui de la capitale, on ne sait trop par quel caprice, et dont les pâtissiers de Saint-Denis ont, seuls contre tous, protégé la retraite, de sorte que talmouse et Saint-Denis, Saint-Denis et talmouse, sont presque devenus synonymes, et qu’il n’est pas permis au voyageur que son pèlerinage conduit vers le tombeau des rois de quitter la nouvelle Mecque sans avoir donné l’obole à cette célébrité déchue, qui, du reste, comme toutes les anciennes puissances, a encore ses partisans et ses admirateurs."
                            },
                            {
                                "example_id": "5f7cb5ee-6a61-4ef1-8a8c-07a98105b7f5",
                                "sense_id": "bf2a3bac-4e6c-3b77-8738-b72c99b9d2fd",
                                "text": "La pizza est une espèce de talmouse comme on en fait à Saint-Denis."
                            },
                            {
                                "example_id": "a65f4b73-0059-4f40-ab63-185ccb6254b5",
                                "sense_id": "bf2a3bac-4e6c-3b77-8738-b72c99b9d2fd",
                                "text": "À côté, c’est sa grande bêtasse de fille, qui ressemble à une talmouse gonflée sur laquelle on a jeté du sucre en poudre."
                            },
                            {
                                "example_id": "6f2bc06f-877a-4e30-a727-142b9a1dc274",
                                "sense_id": "bf2a3bac-4e6c-3b77-8738-b72c99b9d2fd",
                                "text": "Au lieu et place de la talmouse succulente qu’elle croquait et reposait tour à tour sur sa toilette, la dame avait saisi et mordu à belles dents un bâton de cosmétique qui voisinait avec le gâteau."
                            },
                            {
                                "example_id": "6b990fd8-614c-4ee0-b224-9cd34f231916",
                                "sense_id": "bf2a3bac-4e6c-3b77-8738-b72c99b9d2fd",
                                "text": "Tchitchikov se retourna et aperçut sur la table une copieuse collation : champignons, croustades, œufs sur le plat, beignets, crêpes, talmouses, et toutes sortes de bouchées : à la ciboule, aux pavots, au fromage blanc, aux éperlans."
                            }
                        ]
                    }
                ],
