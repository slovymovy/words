                "senses": [
                    {
                        "sense_id": "f63ca9f7-05ab-3114-8402-a99b338b1d85",
                        "entry_id": "44f56250-7a00-303f-b71b-13d256320a8e",
                        "glosses": [
                            "kleine Lampe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69214b73-c407-470d-8989-b5627c2f4184",
                                "sense_id": "f63ca9f7-05ab-3114-8402-a99b338b1d85",
                                "text": "Mit diesem Lämpchen kann man nicht genug sehen."
                            },
                            {
                                "example_id": "02d30508-76d4-4bca-9386-71ae0e465410",
                                "sense_id": "f63ca9f7-05ab-3114-8402-a99b338b1d85",
                                "text": "„Drinnen war es halbdunkel; nur vor den Heiligenbildern brannten zwei Lämpchen, und es roch angenehm nach Räucherwerk und Blumen.“"
                            },
                            {
                                "example_id": "fcd7292d-130c-4d99-a9a1-d895b9ab16f7",
                                "sense_id": "f63ca9f7-05ab-3114-8402-a99b338b1d85",
                                "text": "„Bebend entzündete sie die kleinen Lämpchen mit den roten Schirmen hinter dem Bett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
