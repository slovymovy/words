                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e6c90390-1f7e-4ae4-bf53-19dbf7f65bd1",
                        "source_entry_id": "b6fe9b69-bba8-3b31-92e7-1fc9b9c2218a",
                        "target_lang_word": "Leichnam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leichnam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b83324e-c13c-39c5-9c44-3be8215d36db",
                                        "entry_id": "ffb182a5-a15f-37d7-9e7c-a7f0a718a4a6",
                                        "glosses": [
                                            "Körper eines Verstorbenen"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbbf165b-c4f0-4732-9f04-8fa51784ba5c",
                                                "sense_id": "3b83324e-c13c-39c5-9c44-3be8215d36db",
                                                "text": "Der Leichnam ist in der Leichenhalle aufgebahrt."
                                            },
                                            {
                                                "example_id": "a6e023d2-1096-4b6f-8a45-567fef6107b0",
                                                "sense_id": "3b83324e-c13c-39c5-9c44-3be8215d36db",
                                                "text": "„Sein Leichnam fing schon an zu verwesen, als Polizisten ihn im Juni 1999 auf einem Kornfeld nahe St. Louis, Missouri, entdeckten.“"
                                            },
                                            {
                                                "example_id": "4c21be04-156e-44a8-988f-44e137e543c1",
                                                "sense_id": "3b83324e-c13c-39c5-9c44-3be8215d36db",
                                                "text": "„Den Leichnam hatte man inzwischen entfernt.“"
                                            },
                                            {
                                                "example_id": "c8203517-213a-4a84-8255-17e433fdbdcb",
                                                "sense_id": "3b83324e-c13c-39c5-9c44-3be8215d36db",
                                                "text": "„Die Idee, den Leichnam dauerhaft zu konservieren, wurde unmittelbar nach Lenins Ableben zur Staatsangelegenheit erhoben.“"
                                            },
                                            {
                                                "example_id": "f860f6d6-af25-4e04-9aa7-2235bb7f8445",
                                                "sense_id": "3b83324e-c13c-39c5-9c44-3be8215d36db",
                                                "text": "„Der Leichnam wird in die Grube geworfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5bb39ac-b7d8-407e-a477-131974ca3434",
                        "source_entry_id": "b6fe9b69-bba8-3b31-92e7-1fc9b9c2218a",
                        "target_lang_word": "restes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd200186-407b-34cb-9886-355d38eb679b",
                                        "entry_id": "5f0edf0f-5a06-33b9-9ae4-0c9b3895416a",
                                        "glosses": [
                                            "Pluriel de reste."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3942f621-945c-3385-9104-46d80e6a10ec",
                                        "entry_id": "5f0edf0f-5a06-33b9-9ae4-0c9b3895416a",
                                        "glosses": [
                                            "Ce qui n'a pas été consommé d’un repas."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16d76bba-5d48-48f5-a3b9-dbccf13f394a",
                                                "sense_id": "3942f621-945c-3385-9104-46d80e6a10ec",
                                                "text": "Mais lui, qu’il mange au moins, qu’il paie mes efforts, intraitable déjà, les restes me font horreur, comme une peine perdue, du gâchis d’énergie, et puis traîner dans le frigo un passé de nourriture qu’il faudra regoûter, resservir, maquiller, j’en ai mal au cœur d’avance."
                                            },
                                            {
                                                "example_id": "08616c7e-2e63-4603-a5f6-019f50b510b1",
                                                "sense_id": "3942f621-945c-3385-9104-46d80e6a10ec",
                                                "text": "Elles mangent des sandwichs, des wraps et des chips, rient avec leurs collègues et amis, qui sont parfois au bout du fil. Et visiblement désopilants. Des écureuils et des pigeons attendent qu’on leur donne les restes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4cd6b8e-1f76-3ff9-a531-96d3336bc23e",
                                        "entry_id": "5f0edf0f-5a06-33b9-9ae4-0c9b3895416a",
                                        "glosses": [
                                            "Dépouille mortelle d’un être."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee7144a6-570a-4158-bef4-eb2879719c58",
                                                "sense_id": "a4cd6b8e-1f76-3ff9-a531-96d3336bc23e",
                                                "text": "On a rapatrié ses restes pour les enterrer ici."
                                            },
                                            {
                                                "example_id": "aa698f1c-fd3e-4ec7-ad14-8790519181ba",
                                                "sense_id": "a4cd6b8e-1f76-3ff9-a531-96d3336bc23e",
                                                "text": "Je l’ai trouvé mort, ses restes en état de décomposition avancée."
                                            },
                                            {
                                                "example_id": "62f3c586-90f4-40a5-9392-0a3b9f651112",
                                                "sense_id": "a4cd6b8e-1f76-3ff9-a531-96d3336bc23e",
