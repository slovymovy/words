                        {
                            "text": "Bij het volgende kruispunt moet je <w>rechts</w> afslaan.",
                            "target_lang_translations": {
                                "en": "At the next intersection you must turn <w>right</w>.",
                                "ru": "На следующем перекрестке тебе нужно повернуть <w>направо</w>.",
                                "pl": "Na następnym skrzyżowaniu musisz skręcić <w>w prawo</w>.",
                                "de": "An der nächsten Kreuzung musst du nach <w>rechts</w> abbiegen.",
                                "fr": "Au prochain croisement, tu dois tourner <w>à droite</w>.",
                                "it": "Al prossimo incrocio devi svoltare <w>a destra</w>.",
                                "cs": "Na příští křižovatce musíte odbočit <w>doprava</w>.",
                                "tr": "Bir sonraki kavşakta <w>sağa</w> dönmelisin.",
                                "es": "En el próximo cruce tienes que girar <w>a la derecha</w>."
                            }
                        },
                        {
                            "text": "Kijk eerst naar links en dan naar <w>rechts</w> voordat je oversteekt.",
                            "target_lang_translations": {
                                "en": "Look left first and then <w>right</w> before you cross.",
                                "ru": "Посмотри сначала налево, а затем <w>направо</w>, прежде чем переходить.",
                                "pl": "Przed przejściem przez ulicę spójrz najpierw w lewo, a potem <w>w prawo</w>.",
                                "de": "Schau erst nach links und dann nach <w>rechts</w>, bevor du über die Straße gehst.",
                                "fr": "Regarde d'abord à gauche puis <w>à droite</w> avant de traverser.",
                                "it": "Guarda prima a sinistra e poi <w>a destra</w> prima di attraversare.",
                                "cs": "Než přejdeš, podívej se nejprve doleva a pak <w>doprava</w>.",
                                "tr": "Karşıya geçmeden önce önce sola, sonra <w>sağa</w> bak.",
                                "es": "Mira primero a la izquierda y luego <w>a la derecha</w> antes de cruzar."
                            }
