                            {
                                "example_id": "822791fb-64a5-4760-90a4-4b6f0c2d10f8",
                                "sense_id": "9a250f8d-f220-39f0-ad3a-bf68ae916370",
                                "text": "Moreira de Melo is na haar internationale hockeycarrière actief als padelspeelster. Ze is gerangschikt als nummer 48 in Nederland en bereidt zich momenteel voor op het WK padel voor senioren."
                            },
                            {
                                "example_id": "c8e0de8c-0a9d-4859-95c9-fa2d58273f9d",
                                "sense_id": "9a250f8d-f220-39f0-ad3a-bf68ae916370",
                                "text": "Bekend als de Johan Cruijff van het hockey, combineert hij zijn passie voor de sport met een rustige en bedachtzame benadering als coach. In gesprek met Erben & Renate Wennemars vertelt hij over zijn lange hockeycarrière en blikt hij vooruit op die van dochter Lilli, die recent goud behaalde met Jong Oranje."
                            }
