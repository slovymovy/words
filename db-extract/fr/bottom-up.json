                                        "sense_id": "8166dc9f-b907-35fc-955f-f1ab0d91c61c",
                                        "entry_id": "3b4fcb7c-f41a-3d45-a9d3-0d6002c76296",
                                        "glosses": [
                                            "Of or relating to a hierarchical system in which lower levels influence higher levels."
                                        ],
