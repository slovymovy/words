                "senses": [
                    {
                        "sense_id": "78e5fa47-9293-30c6-a4d8-3c7e779661a4",
                        "entry_id": "cb0a6996-ac6c-3213-9b02-53a4d05027c9",
                        "glosses": [
                            "Donner un caractère andorran à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27fd47e7-1264-490e-a524-8b5d59915d8a",
                                "sense_id": "78e5fa47-9293-30c6-a4d8-3c7e779661a4",
                                "text": "Nekkaz a quelques bonnes idées, mais hélas aussi des propositions débiles et démagogiques. La plus amusante est d’\"andorraniser\" Israël !!"
                            },
                            {
                                "example_id": "25408bd5-9375-4f3b-9158-c28dec9f3271",
                                "sense_id": "78e5fa47-9293-30c6-a4d8-3c7e779661a4",
                                "text": "Il s'agissait d’andorraniser un minimum les élèves des systèmes grâce à quelques heures par semaine de langue catalane et d’histoire et géographie d’Andorre avec un matériel préparé sous forme de fiches qui devait se transformer plus tard en manuels."
                            },
                            {
                                "example_id": "fdaa60ce-071b-488e-89ce-8b2b86e5feb2",
                                "sense_id": "78e5fa47-9293-30c6-a4d8-3c7e779661a4",
                                "text": "L’introduction de bétail espagnol \"andorranisé\" fut en effet l’une des préoccupations majeures des autorités locales françaises."
                            }
                        ]
                    }
                ],
