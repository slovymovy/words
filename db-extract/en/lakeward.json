                                "sense_id": "c1f05d49-1880-345a-abcc-7cd39fd7c211",
                                "text": "Lakeward, partly hidden by a fringe of trees, was a green little meadow through which a creek ran, and in it were two tents."
                            },
                            {
                                "example_id": "e4e09916-650e-4d3d-9024-52fbaf125f42",
                                "sense_id": "c1f05d49-1880-345a-abcc-7cd39fd7c211",
                                "text": "The puma sat there for several minutes in the oblique honeyed light, tautly upright, looking like a Lalique ornament as it gazed lakeward into the rising sun."
                            }
                        ]
                    }
