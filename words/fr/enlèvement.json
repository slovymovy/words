                    "semantic_group_id": "criminalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a ouvert une enquête criminelle après l'<w>enlèvement</w> de cette jeune fille."
                        },
                        {
                            "text": "Les ravisseurs ont exigé une forte rançon immédiatement après cet <w>enlèvement</w> prémédité."
                        }
                    ],
                    "synonyms": [
