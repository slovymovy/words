                "senses": [
                    {
                        "sense_id": "3ba17b0d-5aac-3a22-9321-9e52115e880e",
                        "entry_id": "cc8f0d09-a1ca-3718-aa27-1be93940a751",
                        "glosses": [
                            "einem Europiden ähnlicher Angehöriger einer nicht-europäischen Rasse"
                        ],
                        "tags": [
                            "Anthropologie",
                            "Rassenkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "7d8a7ab7-2d62-4db5-b401-23ba92c01699",
                                "sense_id": "3ba17b0d-5aac-3a22-9321-9e52115e880e",
                                "text": "„Denn es kann ja kein Zweifel darüber bestehen, daß die Europäiden als die ursprünglichen Träger der (totemistischen) Klingenkulturen anzusehen sind.“"
                            },
                            {
                                "example_id": "22616954-3bd5-4bc1-a35b-07afb95e3e87",
                                "sense_id": "3ba17b0d-5aac-3a22-9321-9e52115e880e",
                                "text": "„Unter ihnen sind sehr viele europäide Rassen vertreten, es gibt auch Europäide in Afrika, die nicht hamitisch reden, und hamitisch redende, die keine Europäiden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
