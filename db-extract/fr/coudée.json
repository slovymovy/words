            {
                "entry_id": "073d28f1-9bf5-31b8-b0ac-21feb4280e3c",
                "word": "coudée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "af8bee02-b7a4-4e63-bf33-eafd848a2e7a",
                        "entry_id": "073d28f1-9bf5-31b8-b0ac-21feb4280e3c",
                        "tags": [
                            "plural"
                        ],
                        "form": "coudées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "abee91fb-9f2e-39cd-b1a2-7b93e08a4366",
                        "entry_id": "073d28f1-9bf5-31b8-b0ac-21feb4280e3c",
                        "glosses": [
                            "Toute l’étendue du bras depuis le coude jusqu’au bout du doigt du milieu : environ 50 centimètres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbe96ac0-8983-42fa-8632-7761f6c73126",
                                "sense_id": "abee91fb-9f2e-39cd-b1a2-7b93e08a4366",
                                "text": "Avoir ses coudées franches, les coudées franches."
                            }
                        ]
                    },
                    {
                        "sense_id": "337d8ec2-ca92-33ae-9587-f4209f08821d",
                        "entry_id": "073d28f1-9bf5-31b8-b0ac-21feb4280e3c",
                        "glosses": [
                            "Mesure de longueur prise sur l’étendue qu’il y a depuis le coude jusqu’au bout du doigt du milieu."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "10710537-44e0-400d-a151-8194b2792158",
                                "sense_id": "337d8ec2-ca92-33ae-9587-f4209f08821d",
                                "text": "[…] que Vos Révérences continuent de suivre ce sentier jusqu’à ce qu’elles arrivent à une croix aux trois quarts enterrée et dont à peine il reste une coudée hors de terre […]"
                            },
                            {
                                "example_id": "407762a2-44eb-4cc3-a953-9644f2d9fe61",
                                "sense_id": "337d8ec2-ca92-33ae-9587-f4209f08821d",
                                "text": "Le stade philétérien ou d’Alexandrie, dont 7 ½ faisaient le mille, se divisait en 6 plèthres = 10 amma = 60 acènes = 100 orgyies = 300 coudées de 2 pieds = 400 coudées philétériennes = 600 pieds philétériens."
                            },
                            {
                                "example_id": "9a462990-ac02-456f-8661-75ef7bfaf134",
                                "sense_id": "337d8ec2-ca92-33ae-9587-f4209f08821d",
                                "text": "Je me suis fait l’effet de celui dont parle l’Écriture, qui s’efforce d’ajouter une coudée à sa taille."
                            },
                            {
                                "example_id": "2f62184d-393a-4919-99ed-2f7c4307bdc4",
                                "sense_id": "337d8ec2-ca92-33ae-9587-f4209f08821d",
                                "text": "Il avait saisi l’arbre à pleins bras […] À chaque effort, il se haussait d’une demi-coudée. Dans ses reins se mouvaient des souplesses de lézard ; l’écorce pétillait sous ses orteils nus […]"
                            },
                            {
                                "example_id": "250b6a75-601d-450f-af6b-4e71b1d2664b",
                                "sense_id": "337d8ec2-ca92-33ae-9587-f4209f08821d",
                                "text": "Châteaubedeau, d’une distance de cent coudées, lançait une pierre de la grosseur du poing au milieu d’une vitre de l’orangerie."
                            },
                            {
                                "example_id": "2421845f-1e83-46f3-8fc9-a265ee56e30b",
                                "sense_id": "337d8ec2-ca92-33ae-9587-f4209f08821d",
                                "text": "— Que de fois, dans les loisirs de l’imagination, j’ai revu l’une de ces belles soirées automnales où les jeunes âmes font des progrès comparables à ces arbres qui poussent de plusieurs coudées par un coup de foudre."
                            },
                            {
                                "example_id": "ecbb8eeb-e3f4-47dc-97a1-8167cfd23fa8",
                                "sense_id": "337d8ec2-ca92-33ae-9587-f4209f08821d",
                                "text": "— Mais, supérieur de plusieurs coudées à tous ceux qui l’entouraient, il aurait dû guider ses amis […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50eb38a3-e579-4eb7-ad72-28d8202dad22",
                        "source_entry_id": "073d28f1-9bf5-31b8-b0ac-21feb4280e3c",
                        "source_sense_description": "Mesure de longueur",
                        "target_lang_word": "Elle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7736e63-8b16-3944-8da9-738836826941",
                                        "entry_id": "b8a41d0c-18d0-3091-8304-4c6a1e4e6947",
                                        "glosses": [
                                            "einer der beiden Unterarmknochen des Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "478b6b12-10f5-4539-9896-af06455d09fe",
                                                "sense_id": "f7736e63-8b16-3944-8da9-738836826941",
                                                "text": "Sie brach sich zwar die Elle, die Speiche blieb aber heil."
                                            },
                                            {
                                                "example_id": "4bdb310d-05e9-492b-81a8-5c06a704b3f5",
                                                "sense_id": "f7736e63-8b16-3944-8da9-738836826941",
                                                "text": "Die Elle ist weniger kräftig als die Speiche."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2a74305-d163-3062-98d4-5f6970926e1c",
                                        "entry_id": "b8a41d0c-18d0-3091-8304-4c6a1e4e6947",
                                        "glosses": [
                                            "ein altes Längenmaß von regional und zeitlich unterschiedlicher Länge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de215db8-136b-4666-aa19-6eeef9555229",
                                                "sense_id": "b2a74305-d163-3062-98d4-5f6970926e1c",
                                                "text": "„Der unterste Gang war fünf Ellen weit und der mittelste sechs Ellen weit und der dritte sieben Ellen weit; denn er machte Absätze außen am Hause umher, daß die Balken nicht in die Wände des Hauses eingriffen.“"
                                            },
                                            {
                                                "example_id": "7b8a1d94-617c-4584-ad24-92f305e35612",
                                                "sense_id": "b2a74305-d163-3062-98d4-5f6970926e1c",
                                                "text": "„Da sprach Gott zu Noah: Mache dir einen Kasten aus Tannenholz, und mache ihn also: Dreihundert Ellen sei die Länge, fünfzig Ellen die Breite und dreißig Ellen die Höhe.“"
                                            },
                                            {
                                                "example_id": "f82ab4b1-ffeb-40c0-bae1-5311e4cfc705",
                                                "sense_id": "b2a74305-d163-3062-98d4-5f6970926e1c",
                                                "text": "„Die Spanne seiner Flügel betrug gut fünf Ellen, und wie ein munterer Besen fegte der Schatten den Haufen an Vorbehalten beiseite, der sich im Bewusstsein der Sumbinger festgesetzt hatte.“"
                                            },
                                            {
                                                "example_id": "3a47aed7-a94e-494b-a94c-33937df79a75",
                                                "sense_id": "b2a74305-d163-3062-98d4-5f6970926e1c",
                                                "text": "„Fürst Andrej sah Kutusow an, und unwillkürlich blieb sein Blick auf den nur eine halbe Elle von ihm entfernten sauber gepflegten Falten der Narbe an Kutusows Schläfe haften, wo ihn bei Ismail die Kugel in den Kopf getroffen und er das eine Auge verloren hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "516135f9-f10f-3ab7-aea5-9a01649bc050",
                                        "entry_id": "b8a41d0c-18d0-3091-8304-4c6a1e4e6947",
                                        "glosses": [
                                            "ein Messinstrument zum Ausmessen des Stoffes"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a733d72b-a454-4a8b-a450-f2bd542d0817",
                                                "sense_id": "516135f9-f10f-3ab7-aea5-9a01649bc050",
                                                "text": "Manch aufwendig hergestellte Elle hatte ein Edelholzfurnier und Intarsien aus Metall."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
