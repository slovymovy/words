                                        "sense_id": "3b12cb40-4f49-3505-8c57-ef18df23b44c",
                                        "entry_id": "b4516c87-f902-3e58-ba42-898cfb458b57",
                                        "glosses": [
                                            "bestimmte Konstellation des Personals auf der Bühne; bei Personen- oder Szenewechsel beginnt ein neuer Auftritt"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a2967fb-e5f7-4e56-a4b4-94ae13410a9d",
                                                "sense_id": "3b12cb40-4f49-3505-8c57-ef18df23b44c",
                                                "text": "Akte von Theaterstücken werden nach Auftritten gegliedert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19da4a64-d2d2-375a-b00c-128860bc8cef",
                                        "entry_id": "b4516c87-f902-3e58-ba42-898cfb458b57",
                                        "glosses": [
                                            "das Erscheinen eines Darstellers auf der Bühne"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "396116cb-67f9-4132-9a9f-08522ca25e27",
                                                "sense_id": "19da4a64-d2d2-375a-b00c-128860bc8cef",
                                                "text": "Der Schauspieler hatte seinen Auftritt beinahe verpasst."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "35012344-8e64-3b87-b872-57e27531c12e",
                                        "entry_id": "b4516c87-f902-3e58-ba42-898cfb458b57",
                                        "glosses": [
                                            "Art und Weise, wie sich jemand einer Öffentlichkeit präsentiert"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cc731e8-2a35-419c-af88-27039fcf3f98",
                                                "sense_id": "35012344-8e64-3b87-b872-57e27531c12e",
                                                "text": "„Ihr Vater konnte diesen Auftritt gut gebrauchen, denn er lief Gefahr, durch seine abfälligen Äußerungen Frauen gegenüber in der Wählergunst abzusacken.“"
                                            },
                                            {
                                                "example_id": "8f747a59-a080-4e07-8363-56995096c84a",
                                                "sense_id": "35012344-8e64-3b87-b872-57e27531c12e",
                                                "text": "Ihr Auftritt bei der Feier hatte etwas Nonchalantes."
                                            },
                                            {
                                                "example_id": "857f5414-0568-4312-a6ba-debec190404e",
                                                "sense_id": "35012344-8e64-3b87-b872-57e27531c12e",
                                                "text": "„Vieles wirkt bei Trumps Auftritten wie nur so dahergesagt, weil es gerade passt.“"
                                            },
                                            {
                                                "example_id": "8e1a75d6-75f4-4999-9afc-57c8da61068b",
                                                "sense_id": "35012344-8e64-3b87-b872-57e27531c12e",
                                                "text": "„Nach diesem Auftritt wagte das Gesindel im Saal nicht mehr, mich anzublicken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "145746e8-db1b-3699-9efe-4f050e2eb9eb",
                                        "entry_id": "b4516c87-f902-3e58-ba42-898cfb458b57",
                                        "glosses": [
                                            "eine Stufe oder dergleichen, auf die man treten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5e35c8e-eb8e-481c-b515-c68bb03e45ee",
                                                "sense_id": "145746e8-db1b-3699-9efe-4f050e2eb9eb",
                                                "text": "„Seidel stand auf einem Auftritt, das Gewehr neben sich, und sah aufmerksam auf das Armauflagebrett vor sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9404bfc5-27ae-476a-8fe4-f232472af47d",
                        "source_entry_id": "66ec3897-f62f-3ec4-bdc0-c477fdf8564a",
                        "source_sense_description": "public revelation of homosexuality",
                        "target_lang_word": "outing",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outing",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cb726b6-fead-3dd4-89a2-a7627b89af30",
                                        "entry_id": "6be0aa13-8033-3db0-bac9-84751ede5742",
                                        "glosses": [
                                            "Fait de révéler l’orientation sexuelle et/ou l’identité de genre d’une personne sans ou contre son avis."
                                        ],
                                        "tags": [
                                            "LGBTQ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62ba07e9-2cad-47a3-aa69-37e1df38fd34",
                                                "sense_id": "4cb726b6-fead-3dd4-89a2-a7627b89af30",
                                                "text": "Act-up avait menacé d'outing (révélation contre son gré de son homosexualité) un député d'opposition ayant participé à la manifestation organisée contre le Pacs du 31 janvier à Paris, estimant que ce rassemblement avait «été le théâtre d'une haine antihomosexuelle d'une rare violence»."
                                            },
                                            {
                                                "example_id": "f92e9be6-80da-4825-b19a-be9463978607",
                                                "sense_id": "4cb726b6-fead-3dd4-89a2-a7627b89af30",
                                                "text": "« On retrouve également des personnes de la communauté LGBT+, qui ont souvent été victimes d’outing [le fait de révéler l’orientation sexuelle de quelqu’un sans son consentement] », ajoute Juliette Sanchez-Lambert."
                                            }
