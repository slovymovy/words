                "senses": [
                    {
                        "sense_id": "a0b37c1b-da06-3680-b175-72c3f0b2c995",
                        "entry_id": "abcfb351-751a-3a0e-890b-90889675ef0f",
                        "glosses": [
                            "Racler avec les dents les parcelles de viande qui restent sur un os."
                        ],
                        "tags": [
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "10f94316-f74c-4dbc-b094-c5ad0b93cd19",
                                "sense_id": "a0b37c1b-da06-3680-b175-72c3f0b2c995",
                                "text": "Le gone, il aime raquigner les os du poulet !"
                            },
                            {
                                "example_id": "ec74bfa7-4d9a-4fb9-bb72-425247e56610",
                                "sense_id": "a0b37c1b-da06-3680-b175-72c3f0b2c995",
                                "text": "Son père le gronde fort et pour qu’il arrête de raquigner son os, intervient avec ce qui lui passe sous la main."
                            },
                            {
                                "example_id": "76fa8d5d-62d8-4e7c-adbd-2f3b2545d981",
                                "sense_id": "a0b37c1b-da06-3680-b175-72c3f0b2c995",
                                "text": "Vraiment une volonté de rogner le moindre acquis dans tous les chapitres de la loi (de \"raquigner\" dirait Mireille encore dépositaire de mots lyonnais), de détricoter (pour le coup, le mot est juste) la logique du Code du travail en substituant entre autres les accords d’entreprise au détriment de la loi."
                            }
                        ]
                    }
