            {
                "entry_id": "fa86391a-02b7-3dd8-9980-60645c9c254f",
                "word": "nicodème",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "888ca65c-dcf1-454d-ad29-ba0dc586a08d",
                        "entry_id": "fa86391a-02b7-3dd8-9980-60645c9c254f",
                        "tags": [
                            "plural"
                        ],
                        "form": "nicodèmes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "305c7d04-a527-32ea-8ca9-0ee1cc196ca7",
                        "entry_id": "fa86391a-02b7-3dd8-9980-60645c9c254f",
                        "glosses": [
                            "Homme niais, nigaud."
                        ],
                        "tags": [
                            "obsolete",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "677e751e-5272-4d78-8450-abaffeaf36c6",
                                "sense_id": "305c7d04-a527-32ea-8ca9-0ee1cc196ca7",
                                "text": "Un coquebin, un rossard, un lendore, un barguigneur, un niguedouille, un coquefredouille, un marmiteux, un clampin, un boniface, un pisse-froid, un nicodème, un soliveau, un frelampier, un claude."
                            },
                            {
                                "example_id": "ba6f2648-879b-4ba7-aae4-55eba6034b34",
                                "sense_id": "305c7d04-a527-32ea-8ca9-0ee1cc196ca7",
                                "text": "D’autres prenaient dans leurs filets les messieurs trop bien mis qui se pavanaient sous le balcon des dames ; des cacheux ou chasseurs, armés d’un fusil déculassé, soufflaient du son à la face des nicodèmes."
                            },
                            {
                                "example_id": "d8dbb476-5c5e-402e-9baf-7a6766c46caf",
                                "sense_id": "305c7d04-a527-32ea-8ca9-0ee1cc196ca7",
                                "text": "Et que fait-il, lui Delisle, sinon se donner en spectacle, faire la parade, débiter son boniment, exécuter des tours de passe-passe devant des nicodèmes poudrés ?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
