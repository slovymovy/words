        "fr-extract.jsonl": [
            {
                "entry_id": "bf67d291-fc8f-3eb1-a176-9fa71e47e514",
                "word": "agreste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1cb5b6ce-5993-4bdf-87de-11b0b5eb6931",
                        "entry_id": "bf67d291-fc8f-3eb1-a176-9fa71e47e514",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "agrestes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1ddb763-3430-3be8-bb7e-86fda34a601e",
                        "entry_id": "bf67d291-fc8f-3eb1-a176-9fa71e47e514",
                        "glosses": [
                            "Qui a rapport aux champs, à la campagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aab945ab-29ef-412d-a36c-fed12ff62f58",
                                "sense_id": "a1ddb763-3430-3be8-bb7e-86fda34a601e",
                                "text": "Malgré la silencieuse immobilité des aubépines, cette intermittente odeur était comme le murmure de leur vie intense dont l’autel vibrait ainsi qu’une haie agreste visitée par de vivantes antennes."
                            },
                            {
                                "example_id": "d6339270-b0ee-4fd5-bbe7-991ff82f5d4f",
                                "sense_id": "a1ddb763-3430-3be8-bb7e-86fda34a601e",
                                "text": "Narcisse, comme dans toutes les bonnes maisons, était délégué par monsieur le curé pour aller au-devant de Monseigneur et le saluer de la part de son maître, propriétaire de ce manoir agreste que l’on appelle humblement le presbytère."
                            },
                            {
                                "example_id": "f0e42e42-9740-49d7-8034-0a5d925f843d",
                                "sense_id": "a1ddb763-3430-3be8-bb7e-86fda34a601e",
                                "text": "Alors que l'immense métropole a poussé des tentacules au-delà du Middlesex, vers le Hertford, elle a laissé à Bushtree son illusion champêtre et même un agreste parfum de solitude."
                            }
                        ]
                    },
                    {
                        "sense_id": "f12b9648-028a-3915-9908-7ba53d66cd6d",
                        "entry_id": "bf67d291-fc8f-3eb1-a176-9fa71e47e514",
                        "glosses": [
                            "Qui est rude, qui manque de civilité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a0e641b3-7624-401d-b8a1-8b5b6c9b16b7",
                                "sense_id": "f12b9648-028a-3915-9908-7ba53d66cd6d",
                                "text": "Car enfin, M. Yves Florenne en était encore à fignoler des romans paysans, des « drames de la terre », des histoires de mauvais œil, quand, l’œil autrement mauvais qu’un agreste héros de jettatura, Hitler énonçait […]"
                            },
                            {
                                "example_id": "94445c83-e083-4652-89cf-4c14dfe78a64",
                                "sense_id": "f12b9648-028a-3915-9908-7ba53d66cd6d",
                                "text": "Humeur agreste."
                            },
                            {
                                "example_id": "1fd76095-cae2-4529-99dc-b41ea5315119",
                                "sense_id": "f12b9648-028a-3915-9908-7ba53d66cd6d",
                                "text": "Manières agrestes."
                            },
                            {
                                "example_id": "923c6d05-ddd9-4149-a613-4937d4237f3c",
                                "sense_id": "f12b9648-028a-3915-9908-7ba53d66cd6d",
                                "text": "Si le commerce adoucit les mœurs agrestes, il déprave les mœurs simples et pures; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "53f033f1-7ddd-38ce-9fbc-9d05ed4d7954",
                        "entry_id": "bf67d291-fc8f-3eb1-a176-9fa71e47e514",
                        "glosses": [
                            "Qui a un goût âpre."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46bf0ae6-3523-4545-b58a-ec4a21cad78b",
                        "source_entry_id": "bf67d291-fc8f-3eb1-a176-9fa71e47e514",
                        "source_sense_description": "Qui a rapport aux champs",
                        "target_lang_word": "ländlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ländlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1eb682d-56f8-36d8-8e35-5f82fbcdbc15",
                                        "entry_id": "7397c3dc-deac-3159-84f8-c18d0c5ac2ed",
                                        "glosses": [
                                            "charakteristisch für das (landwirtschaftlich orientierte) Leben, die Bevölkerung, die Gegend außerhalb von Städten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba8a5f6b-b466-4faf-bb19-8cb6057f1c90",
                                                "sense_id": "d1eb682d-56f8-36d8-8e35-5f82fbcdbc15",
                                                "text": "Ländlich geprägte Regionen sind wieder beliebte Urlaubsziele."
                                            },
                                            {
                                                "example_id": "c3ea3892-78da-4492-82da-8fbff923a6ca",
                                                "sense_id": "d1eb682d-56f8-36d8-8e35-5f82fbcdbc15",
                                                "text": "„Kim Davis, eine Standesbeamtin aus dem ländlichen Kentucky, wurde zur Jeanne d'Arc religiöser Fundamentalisten, weil sie sich rechtswidrig weigerte, gleichgeschlechtlichen Paaren Ehedokumente auszustellen.“"
                                            },
                                            {
                                                "example_id": "575e7a08-ebef-404b-ae65-71382cba9b6c",
                                                "sense_id": "d1eb682d-56f8-36d8-8e35-5f82fbcdbc15",
                                                "text": "„Der Goldbergbau entwickelte sich schnell zum Industrialisierungsmotor Südafrikas und zog viele, oft gut ausgebildete Arbeitskräfte aus Europa in die bis dahin ländlich geprägte Burenrepublik.“"
                                            },
                                            {
                                                "example_id": "bc459deb-4547-4d16-8886-234141d9360c",
                                                "sense_id": "d1eb682d-56f8-36d8-8e35-5f82fbcdbc15",
                                                "text": "[…] „Der Wohnungsmangel hat auch ländliche Regionen erreicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
