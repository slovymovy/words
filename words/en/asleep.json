                {
                    "sense_id": "85434181-347f-3bac-b331-4b452ef54c3c",
                    "sense_definition": "Having a numb or prickling sensation in a body part, usually due to lack of blood flow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My arm fell <w>asleep</w> after I leaned on it for too long.",
                            "target_lang_translations": {
                                "ru": "У меня <w>затекла</w> рука после того, как я слишком долго на нее опирался.",
                                "pl": "Ręka mi <w>zdrętwiała</w> po tym, jak zbyt długo się na niej opierałem.",
                                "nl": "Mijn arm werd <w>gevoelloos</w> nadat ik er te lang op had geleund.",
                                "de": "Mein Arm ist <w>eingeschlafen</w>, nachdem ich mich zu lange darauf gestützt habe.",
                                "fr": "Mon bras s'est <w>engourdi</w> après que je me suis appuyé dessus trop longtemps.",
                                "it": "Mi si è <w>addormentato</w> il braccio dopo che mi ci sono appoggiato sopra per troppo tempo.",
                                "cs": "Když jsem se o ni příliš dlouho opíral, <w>přeležel</w> jsem si ruku.",
                                "tr": "Üzerine çok uzun süre yaslandığım için kolum <w>uyuştu</w>.",
                                "es": "Se me <w>durmió</w> el brazo después de apoyarme en él durante demasiado tiempo.",
                                "zh": "我靠在手臂上太久，它<w>发麻</w>了。",
                                "ja": "長く寄りかかっていたせいで、腕が<w>痺れてしまいました</w>。",
                                "pt": "O braço ficou-me <w>adormecido</w> depois de me apoiar nele durante demasiado tempo."
                            }
                        },
                        {
                            "text": "She stood up and realized her foot was <w>asleep</w>.",
                            "target_lang_translations": {
                                "ru": "Она встала и поняла, что у нее <w>онемела</w> нога.",
                                "pl": "Wstała i zdała sobie sprawę, że jej stopa <w>zdrętwiała</w>.",
                                "nl": "Ze stond op en merkte dat haar voet <w>sliep</w>.",
                                "de": "Sie stand auf und bemerkte, dass ihr Fuß <w>eingeschlafen</w> war.",
                                "fr": "Elle s'est levée et s'est rendu compte que son pied était <w>engourdi</w>.",
                                "it": "Si è alzata e si è resa conto che il suo piede era <w>addormentato</w>.",
                                "cs": "Vstala a uvědomila si, že jí <w>zdřevěněla</w> noha.",
                                "tr": "Ayağa kalktı ve ayağının <w>uyuşmuş</w> olduğunu fark etti.",
                                "es": "Se levantó y se dio cuenta de que su pie estaba <w>dormido</w>.",
                                "zh": "她站起来时发现脚<w>麻</w>了。",
                                "ja": "彼女は立ち上がると、足が<w>痺れている</w>ことに気づきました。",
                                "pt": "Levantou-se e apercebeu-se de que tinha o pé <w>adormecido</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fall asleep",
                        "leg fell asleep",
                        "foot asleep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Онемевший, потерявший чувствительность (о части тела).",
                        "pl": "Zdrętwiały lub mrowiący (o części ciała), zazwyczaj z powodu braku dopływu krwi.",
                        "nl": "Een tintelend of gevoelloos gevoel hebben in een lichaamsdeel, meestal door een gebrek aan bloedtoevoer.",
                        "de": "Ein taubes oder kribbelndes Gefühl in einem Körperteil habend, meist aufgrund mangelnder Durchblutung.",
                        "fr": "Avoir une sensation d'engourdissement ou de picotement dans une partie du corps, généralement due à un manque de circulation sanguine.",
                        "it": "Che presenta una sensazione di intorpidimento o formicolio in una parte del corpo, solitamente per mancanza di flusso sanguigno.",
                        "cs": "Znecitlivělý nebo brnící (o části těla), obvykle kvůli nedostatečnému průtoku krve.",
                        "tr": "Genellikle kan akışının azalması nedeniyle bir vücut parçasında uyuşma veya karıncalanma hissi olması.",
                        "es": "Tener una sensación de entumecimiento o cosquilleo en una parte del cuerpo, generalmente debido a la falta de flujo sanguíneo.",
                        "zh": "身体部位因血液循环不畅而产生的麻木或刺痛感。",
                        "ja": "血流が妨げられるなどして、体の一部の感覚がなくなり、しびれていること。",
                        "pt": "Com sensação de formigueiro ou dormência numa parte do corpo, geralmente por falta de circulação do sangue."
                    },
