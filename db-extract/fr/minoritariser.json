                ],
                "senses": [
                    {
                        "sense_id": "e2d00550-6b32-34fa-9547-ec2822a3620d",
                        "entry_id": "e043fecf-c0af-3d35-8f26-0b2de769a363",
                        "glosses": [
                            "Donner un caractère minoritaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cffc580-50ee-44af-a9d6-370f9acb3757",
                                "sense_id": "e2d00550-6b32-34fa-9547-ec2822a3620d",
                                "text": "Le vampire de Louisiane est ainsi minoritaire dans un État lui-même « minoritarisé »."
                            },
                            {
                                "example_id": "78318610-a953-48cd-92f4-7b902dd71159",
                                "sense_id": "e2d00550-6b32-34fa-9547-ec2822a3620d",
                                "text": "Je différencierai la communauté et le communautarisme (ou le multiculturalisme) qui est une invention de l'Etat pour essayer de diviser les pauvres et les \"minoritariser\", eux et leurs problèmes."
                            },
                            {
                                "example_id": "40c67955-2003-45d2-9efe-6fa425d79180",
                                "sense_id": "e2d00550-6b32-34fa-9547-ec2822a3620d",
                                "text": "Au lieu d’encadrer les étudiants et de les guider, de les former à l’innovation et à la non-violence, l’Université a décidé de sanctionner ces derniers ; de cesser de résister, de se résigner, de capituler devant « la peur », ce mal qui ronge et « minoritarise » tous les chrétiens, qui braque tous les Libanais au sein de leurs enclos communautaires"
                            }
                        ]
                    }
                ],
