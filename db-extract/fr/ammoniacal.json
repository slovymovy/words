                        "glosses": [
                            "Qui a rapport à l’ammoniaque, qui en contient, qui en a l’odeur ou les propriétés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97175b12-02a8-4b05-a311-9ead6f75833e",
                                "sense_id": "0a7e68bd-536e-3d23-898e-686f6bd38a0f",
                                "text": "Et Jean, resté seul, termina sa besogne, déposant tous les dix mètres des fourchées de fumier, qui dégageaient un redoublement de vapeurs ammoniacales."
                            },
                            {
                                "example_id": "ea264095-bfd0-4ff1-97e7-a9234afe120e",
                                "sense_id": "0a7e68bd-536e-3d23-898e-686f6bd38a0f",
                                "text": "La solution d'ammoniaque est utilisée dans l'industrie pour le dégraissage, la fabrication des sels ammoniacaux."
                            }
                        ]
                    }
