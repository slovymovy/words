                                "target_senses": [
                                    {
                                        "sense_id": "f328395d-d38f-3f08-a90e-7eeb25ebeca1",
                                        "entry_id": "eda3ca08-4bcb-38a2-9ed9-28646c84389c",
                                        "glosses": [
                                            "Behörde, die für die Strafverfolgung und Strafvollstreckung zuständig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db457c9a-afbc-49e9-b57d-738c30822d56",
                                                "sense_id": "f328395d-d38f-3f08-a90e-7eeb25ebeca1",
                                                "text": "Laut Ermittlungen der Staatsanwaltschaft hat der Unternehmer die Bilanz gefälscht."
                                            },
                                            {
                                                "example_id": "e1d0111c-0385-488f-bdb2-094b0de8e0bf",
                                                "sense_id": "f328395d-d38f-3f08-a90e-7eeb25ebeca1",
                                                "text": "„Die Staatsanwaltschaft ordnete eine Blutentnahme zur Überprüfung auf Alkohol- und Drogenkonsum an.“"
                                            },
                                            {
                                                "example_id": "80e89af9-cd8c-4c04-add7-673e3bd77206",
                                                "sense_id": "f328395d-d38f-3f08-a90e-7eeb25ebeca1",
                                                "text": "„Er ist froh, dass die Staatsanwaltschaft ein paar Tage zuvor Anklage erhoben hat gegen den mutmaßlichen Täter.“"
                                            },
                                            {
                                                "example_id": "1dbdca96-d956-405a-89bc-91cb754fc648",
                                                "sense_id": "f328395d-d38f-3f08-a90e-7eeb25ebeca1",
                                                "text": "„Denn die sieben Männer und die eine Frau, denen die Staatsanwaltschaft versuchten Mord und die Bildung einer terroristischen Vereinigung vorwirft, sind keine Radikalen aus dem Untergrund.“"
                                            },
                                            {
                                                "example_id": "e8f1ee5c-0945-4298-8e23-78e9e68271fe",
                                                "sense_id": "f328395d-d38f-3f08-a90e-7eeb25ebeca1",
                                                "text": "„Bei Staatsanwaltschaft und Verteidigern ist er beliebt, weil er routinierte, schnelle Verhandlungen macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
