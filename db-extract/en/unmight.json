                        "glosses": [
                            "The absence or lack of might; powerlessness; weakness"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "678f2411-18db-4f95-a3ac-11501f95596d",
                                "sense_id": "8df0603c-096e-3c2a-9eb9-7a727a6927ee",
                                "text": "They might fail to grant redress either because, to use the expressive words of various ordinances,“there was too great might on the one side and too great unmight on the other,” [...]"
                            },
                            {
                                "example_id": "fa9b9d89-2b1f-46fa-a8a0-07c340541750",
                                "sense_id": "8df0603c-096e-3c2a-9eb9-7a727a6927ee",
                                "text": "In this, our lord shewed a parte of the feendes malice, and fully his unmight, for he shewed that the passion of him is the overcoming of the feende."
                            },
                            {
                                "example_id": "3aa9158b-e3d5-47c3-ac63-83bde0224f98",
                                "sense_id": "8df0603c-096e-3c2a-9eb9-7a727a6927ee",
                                "text": "She sees the devil's great malice but she sees also his “unmight:” his powerlessness."
                            }
                        ]
                    }
