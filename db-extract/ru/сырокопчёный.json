                        "glosses": [
                            "копчёный в сыром виде"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33e2a922-23ba-4adc-893c-f341e461e102",
                                "sense_id": "e19c031a-23a2-3097-85bc-c3d0de4c94f9",
                                "text": "Сырокопчёный окорок. При холодном копчении (20–25°) продукт обрабатывают дымом в течение 2–4 суток, затем выдерживают в подвешенном состоянии 3–5 недель."
                            }
                        ]
                    }
                ],
