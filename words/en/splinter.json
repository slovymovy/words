{
    "word_family": [
        "splintery",
        "splintering",
        "splinterproof"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5132a630-8108-30e7-904a-ceb678e87434",
                    "sense_definition": "A small, sharp fragment of wood, glass, or other material that becomes embedded in the skin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a pair of tweezers to carefully remove a tiny <w>splinter</w> from her finger.",
                            "target_lang_translations": {
                                "ru": "Она воспользовалась пинцетом, чтобы аккуратно вытащить крошечную <w>занозу</w> из пальца."
                            }
                        },
                        {
                            "text": "Walking barefoot on the old wooden deck is a quick way to get a painful <w>splinter</w>.",
                            "target_lang_translations": {
                                "ru": "Ходьба босиком по старому деревянному настилу — это быстрый способ посадить болезненную <w>занозу</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sliver",
                        "spelk"
                    ],
                    "common_phrases": [
                        "get a splinter",
                        "remove a splinter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький острый осколок дерева, стекла или другого материала, застрявший в коже."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заноза",
                                "target_lang_sense_clarification": "острый осколок в коже"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0de09b52-8e15-324d-b89e-c5ce96333930",
                    "sense_definition": "A long, sharp fragment of material, such as wood or glass, that has broken off from a larger piece.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explosion sent every <w>splinter</w> of glass flying across the room.",
                            "target_lang_translations": {
                                "ru": "Взрыв разбросал каждый <w>осколок</w> стекла по всей комнате."
                            }
                        },
                        {
                            "text": "He swept up the sharp <w>splinters</w> of wood left on the workshop floor.",
                            "target_lang_translations": {
                                "ru": "Он подмёл острые деревянные <w>щепки</w>, оставшиеся на полу мастерской."
                            }
                        }
                    ],
                    "synonyms": [
                        "sliver",
                        "shard",
                        "spill"
                    ],
                    "common_phrases": [
                        "splinters of wood",
                        "splinters of glass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный острый осколок материала (например, дерева или стекла), отколовшийся от более крупного куска."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осколок",
                                "target_lang_sense_clarification": "стекла, металла и т.д."
                            },
                            {
                                "target_lang_word": "щепка",
                                "target_lang_sense_clarification": "дерева"
                            },
                            {
                                "target_lang_word": "лучина",
                                "target_lang_sense_clarification": "тонкая щепка дерева"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0d50840-a72b-3cd6-8b02-c34c1376cc4a",
                    "sense_definition": "A small group that has broken away from a larger organization, political party, or sect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "faction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A radical <w>splinter</w> of the party decided to form its own independent coalition.",
                            "target_lang_translations": {
                                "ru": "Радикальная <w>фракция</w> партии решила создать свою собственную независимую коалицию."
                            }
                        },
                        {
                            "text": "The main organization struggled to maintain unity after a small <w>splinter</w> broke off.",
                            "target_lang_translations": {
                                "ru": "Основная организация изо всех сил пыталась сохранить единство после того, как от неё откололась небольшая <w>группа</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "faction",
                        "splinter group"
                    ],
                    "common_phrases": [
                        "splinter group",
                        "splinter faction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая группа, отколовшаяся от более крупной организации, политической партии или секты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отколовшаяся группа",
                                "target_lang_sense_clarification": "фракция"
                            },
                            {
                                "target_lang_word": "фракция",
                                "target_lang_sense_clarification": "политическая или религиозная группа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e3486cc-93ee-39b4-8e0f-f5746712e1d6",
                    "sense_definition": "A fragment of a component word used in a blend or portmanteau.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the portmanteau word 'brunch', 'unch' is a linguistic <w>splinter</w> from 'lunch'.",
                            "target_lang_translations": {
                                "ru": "В гибридном слове «бранч» элемент «unch» является лингвистическим <w>осколком</w> от слова «ланч»."
                            }
                        },
                        {
                            "text": "Morphological analysis shows how a <w>splinter</w> can become a productive combining form.",
                            "target_lang_translations": {
                                "ru": "Морфологический анализ показывает, как <w>осколок слова</w> может стать продуктивной словообразовательной формой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistic terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фрагмент исходного слова, используемый при образовании слова-слитка (портманто)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осколок слова",
                                "target_lang_sense_clarification": "в лингвистике"
                            },
                            {
                                "target_lang_word": "сегмент",
                                "target_lang_sense_clarification": "часть слова"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69f0bf94-8619-3122-8d79-5c82e7870235",
                    "sense_definition": "A double-jump bid in bridge that indicates a shortage of cards in the bid suit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bridge_game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her sudden double-jump bid was interpreted by her partner as a classic <w>splinter</w>.",
                            "target_lang_translations": {
                                "ru": "Её внезапная заявка с двойным прыжком была истолкована партнёром как классический <w>сплинтер</w>."
                            }
                        },
                        {
                            "text": "Using a <w>splinter</w> bid helped the pair reach a successful slam contract.",
                            "target_lang_translations": {
                                "ru": "Использование заявки <w>сплинтер</w> помогло паре выйти на успешный шлемовый контракт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "splinter bid"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "card games"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявка с двойным прыжком в бридже, показывающая краткость (синглет или ренонс) в масти заявки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплинтер",
                                "target_lang_sense_clarification": "заявка в бридже"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6262a918-cb4d-34c1-b403-e542f85750c0",
                    "sense_definition": "To break or split into long, sharp, thin pieces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "breakage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden mast began to <w>splinter</w> under the immense pressure of the wind.",
                            "target_lang_translations": {
                                "ru": "Старая деревянная мачта начала <w>расщепляться</w> под огромным напором ветра."
                            }
                        },
                        {
                            "text": "We watched the dry branches <w>splinter</w> and crack as the heavy vehicle drove over them.",
                            "target_lang_translations": {
                                "ru": "Мы смотрели, как сухие ветки <w>ломаются</w> и трещат, когда по ним проезжает тяжелая машина."
                            }
                        }
                    ],
                    "synonyms": [
                        "sliver"
                    ],
                    "common_phrases": [
                        "begin to splinter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распадаться или раскалываться на длинные, острые, тонкие части."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расщепляться",
                                "target_lang_sense_clarification": "на щепки или волокна"
                            },
                            {
                                "target_lang_word": "раскалываться",
                                "target_lang_sense_clarification": "на мелкие части"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eead2cc3-b498-3a14-8a5f-dbe9ede9d809",
                    "sense_definition": "To cause something to break apart into sharp, thin fragments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "breakage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy impact of the rock managed to <w>splinter</w> the wooden shield.",
                            "target_lang_translations": {
                                "ru": "Сильный удар камня сумел <w>расколоть</w> деревянный щит."
                            }
                        },
                        {
                            "text": "A single blow from his axe was enough to <w>splinter</w> the door into pieces.",
                            "target_lang_translations": {
                                "ru": "Одного удара его топора было достаточно, чтобы <w>разнести</w> дверь в щепки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "splinter the door"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать разрушение чего-либо на острые, тонкие осколки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расщеплять",
                                "target_lang_sense_clarification": "на щепки"
                            },
                            {
                                "target_lang_word": "раскалывать",
                                "target_lang_sense_clarification": "на куски"
                            },
                            {
                                "target_lang_word": "разносить в щепки",
                                "target_lang_sense_clarification": "полностью разрушать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "030c26d5-ed5f-398f-9387-9e053158887b",
                    "sense_definition": "To break, or cause to break, into smaller, often disagreeing factions or groups.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "factionalism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Disagreements over leadership caused the political movement to <w>splinter</w> into rival factions.",
                            "target_lang_translations": {
                                "ru": "Разногласия по поводу лидерства заставили политическое движение <w>расколоться</w> на соперничающие фракции."
                            }
                        },
                        {
                            "text": "The controversial decision threatened to <w>splinter</w> the entire community.",
                            "target_lang_translations": {
                                "ru": "Это спорное решение грозило <w>расколоть</w> всё сообщество."
                            }
                        }
                    ],
                    "common_phrases": [
                        "splinter into factions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распадаться или заставлять распадаться на более мелкие, часто несогласные друг с другом фракции или группы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскалываться",
                                "target_lang_sense_clarification": "о группе, партии"
                            },
                            {
                                "target_lang_word": "распадаться",
                                "target_lang_sense_clarification": "на фракции"
                            },
                            {
                                "target_lang_word": "раскалывать",
                                "target_lang_sense_clarification": "вносить разлад"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2eeef85e-7828-3017-b879-f0541fa15ae1",
                    "sense_definition": "To support or secure a broken bone or limb using splints.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medic had to <w>splinter</w> the soldier's broken leg before moving him.",
                            "target_lang_translations": {
                                "ru": "Медику пришлось <w>наложить шину</w> на сломанную ногу солдата, прежде чем переносить его."
                            }
                        },
                        {
                            "text": "They used thick branches and bandages to <w>splinter</w> the fractured limb in the wilderness.",
                            "target_lang_translations": {
                                "ru": "Они использовали толстые ветки и бинты, чтобы <w>зафиксировать</w> сломанную конечность в условиях дикой природы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "splinter a broken limb"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "more commonly 'splint' in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживать или фиксировать сломанную кость или конечность с помощью шин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накладывать шину",
                                "target_lang_sense_clarification": "при переломе"
                            },
                            {
                                "target_lang_word": "шинировать",
                                "target_lang_sense_clarification": "фиксировать конечность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0eab7d35-db2a-3b9d-805b-c4ace35b09c2",
                    "sense_definition": "A English surname derived from the noun.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Splinter</w> to speak at our local historical society meeting.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили господина <w>Сплинтера</w> выступить на заседании нашего местного исторического общества."
                            }
                        },
                        {
                            "text": "The old records show that a family named <w>Splinter</w> lived in this valley during the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Старые записи показывают, что семья по фамилии <w>Сплинтер</w> жила в этой долине в девятнадцатом веке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, происходящая от существительного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сплинтер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}