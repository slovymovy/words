                    {
                        "translation_id": "0ebf4073-4515-479a-9589-8c6c0de9b9b8",
                        "source_entry_id": "a0960a98-88b3-3cf2-b3cf-680687d45b80",
                        "source_sense_id": "59c92a43-1ea5-30c5-a1b3-329c1c2a0a17",
                        "target_lang_word": "à pied",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à pied",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79d77f39-53c9-3167-add8-069e3361367e",
                                        "entry_id": "e315d4f7-86f8-37c8-899f-a040ec052b18",
                                        "glosses": [
                                            "Au moyen de ses pieds ; en marchant ; pédestrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dde9b15a-1743-4749-af93-56e07e8b84a7",
                                                "sense_id": "79d77f39-53c9-3167-add8-069e3361367e",
                                                "text": "Les gendarmes étaient venus à pied, par sept kilomètres de vieux chemins."
                                            },
                                            {
                                                "example_id": "84c2794c-477f-441e-bd9a-47ad37748846",
                                                "sense_id": "79d77f39-53c9-3167-add8-069e3361367e",
                                                "text": "Elle avait fait la route à pied jusqu’à mon sixième du Boulevard Port-Royal ; ne me trouvant pas, elle était allée, à pied toujours, à la Chapelle, chez une autre camarade."
                                            },
                                            {
                                                "example_id": "965858e1-497e-4757-a95d-0359df090661",
                                                "sense_id": "79d77f39-53c9-3167-add8-069e3361367e",
                                                "text": "Ceux des montagnards qui obéirent à l’appel du chef austrasien vinrent au rendez-vous, les uns à pied, les autres à cheval, avec leur armement habituel, c’est-à-dire, en équipage de chasse, l’épieu à la main et la trompe ou le cornet en bandoulière."
                                            },
                                            {
                                                "example_id": "fa627545-7478-4fff-8c27-128890e30b7f",
                                                "sense_id": "79d77f39-53c9-3167-add8-069e3361367e",
                                                "text": "C’est presque une banalité de répéter que le seule manière adéquate de visiter certaines régions, c’est de les parcourir à pied."
                                            },
                                            {
                                                "example_id": "52814ccb-b809-4594-a963-c26dbc04b55e",
                                                "sense_id": "79d77f39-53c9-3167-add8-069e3361367e",
                                                "text": "Denise était venue à pied de la gare Saint-Lazare, où un train de Cherbourg l'avait débarquée avec ses deux frères, après une nuit passée sur la dure banquette d'un wagon de troisième classe."
                                            },
                                            {
                                                "example_id": "4235f869-ba46-4bc6-8c57-5aee8a0288d8",
                                                "sense_id": "79d77f39-53c9-3167-add8-069e3361367e",
                                                "text": "— Je sais que les schmitts ne vont pas tarder à me contrôler vu qu'il ne reste plus qu'un pèlerin à pied dans tout le Bois et que ce pèlerin, c'est moi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
