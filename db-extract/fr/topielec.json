                        "glosses": [
                            "Esprit des eaux de la mythologie polonaise, qui attire ses victimes pour les noyer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff61586-fa23-4ac6-b30e-549fe35b3d5f",
                                "sense_id": "5590ae12-81e0-31e0-9bd8-b95454a9c752",
                                "text": "Cela n'a qu'un lointain rapport, mais le vodyanoi et son homologue le topielec polonais apparaissent régulièrement dans les jeux vidéos de la série The Witcher inspirés des oeuvres d'Andrzej Sapkowski."
                            },
                            {
                                "example_id": "584ac96e-5b2e-4ae4-ad59-6b30c5fdd7ce",
                                "sense_id": "5590ae12-81e0-31e0-9bd8-b95454a9c752",
                                "text": "Grimoire, trouve-moi immédiatement une incantation pour tuer une sirène Topielec."
                            },
                            {
                                "example_id": "47c2dd0d-b38b-43eb-8ba5-0d08a1b478bb",
                                "sense_id": "5590ae12-81e0-31e0-9bd8-b95454a9c752",
                                "text": "Un Topielec, c'est un zombie proche du Vodianoï qui noie des gens..."
                            }
                        ]
                    }
