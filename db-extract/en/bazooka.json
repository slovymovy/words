                                        "entry_id": "e46bf7c5-d20d-375a-ae92-0644db79e2fa",
                                        "glosses": [
                                            "Arme conçue pour projeter des roquettes, lance-grenade propulsé par roquette."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "916fde38-5fbc-4d64-89f5-45bdb46e0a24",
                                                "sense_id": "62d198de-dab9-351d-954b-9e52e84c3240",
                                                "text": "Une première livraison de 18 de ces lance-roquettes, qui seront montés sur les châssis polonais Jelcz, ainsi que leurs munitions, arrivera en Pologne en 2023."
                                            },
                                            {
                                                "example_id": "b9442eb3-c9a2-4586-8184-51dc2deff9fb",
                                                "sense_id": "62d198de-dab9-351d-954b-9e52e84c3240",
                                                "text": "D’autres bombardements au lance-roquette multiple ont visé la région de Tcherniguiv dans le nord de l’Ukraine, tirés depuis le Bélarus voisin, un allié de Moscou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "113e834e-9eea-4006-98a4-c0d077879c45",
                        "source_entry_id": "ac391acf-9234-3988-b35f-92e11ffdba67",
                        "source_sense_description": "any shoulder fired rocket grenade launcher",
                        "target_lang_word": "Panzerfaust",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Panzerfaust",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b9fec2e-92fb-3f8a-a254-10fb99dd1fec",
                                        "entry_id": "edc224e4-5712-36b7-a94c-821984e9c93e",
                                        "glosses": [
                                            "rückstoßfreie, tragbare Panzerabwehrwaffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f87897a8-54ad-495e-82a6-7155068f7169",
                                                "sense_id": "6b9fec2e-92fb-3f8a-a254-10fb99dd1fec",
                                                "text": "Die Panzerfaust verschießt ein Hohlladungsgeschoss."
                                            },
                                            {
                                                "example_id": "c08251f6-c4f3-47a9-aee0-3beec493296f",
                                                "sense_id": "6b9fec2e-92fb-3f8a-a254-10fb99dd1fec",
                                                "text": "„Sie hängten sich die Karabiner um, schulterten die Panzerfäuste, nahmen die Kisten mit Munition und Handgranaten auf und bewegten sich in der einzigen Gangart, die das Gewicht der Waffen erlaubte …“"
                                            },
                                            {
                                                "example_id": "2df2ef17-63b9-4f05-9974-1bc7176c50be",
                                                "sense_id": "6b9fec2e-92fb-3f8a-a254-10fb99dd1fec",
                                                "text": "„Sie wurden mit Panzerfäusten ausgerüstet und in Marsch gesetzt.“"
                                            },
                                            {
                                                "example_id": "88bf9e7b-8df9-4c57-972b-90bdcfccc45d",
                                                "sense_id": "6b9fec2e-92fb-3f8a-a254-10fb99dd1fec",
                                                "text": "„Schröter ist wie in Gedanken umhergegangen, als er die Panzerfäuste entdeckt hat, wendet er sich wieder an den Rottenführer.“"
                                            },
                                            {
                                                "example_id": "7b5d98a1-06b7-4a25-87e3-4988ac64b25b",
                                                "sense_id": "6b9fec2e-92fb-3f8a-a254-10fb99dd1fec",
                                                "text": "„Wir hatten natürlich Revolver und Gewehre und andere Waffen, auch Panzerfäuste und Mörser, Maschinenpistolen und tragbare Maschinengewehre, leichte und schwere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
