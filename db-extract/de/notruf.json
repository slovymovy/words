                "senses": [
                    {
                        "sense_id": "71fa5fbd-c6a9-3158-b07d-db5a94696c95",
                        "entry_id": "e59a531f-0b95-3803-bab3-ee4624c14832",
                        "glosses": [
                            "Appel d’urgence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c13ad9d8-45ca-441c-a5e5-2d2156da36df",
                                "sense_id": "71fa5fbd-c6a9-3158-b07d-db5a94696c95",
                                "text": "Der Notruf wird Europaweit auf 112 angeglichen.",
                                "translation": "L'appel d'urgence sera harmonisé au 112 dans toute l'Europe."
                            },
                            {
                                "example_id": "787e8069-0769-4833-a23a-a657a6bff27d",
                                "sense_id": "71fa5fbd-c6a9-3158-b07d-db5a94696c95",
                                "text": "Daher habe ich den Notruf gewählt.",
                                "translation": "C'est pourquoi j'ai appelé les secours."
                            }
                        ]
                    }
                ],
