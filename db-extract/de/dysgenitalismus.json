                "senses": [
                    {
                        "sense_id": "92950062-b087-3f49-bd32-c0a170adbe3b",
                        "entry_id": "f7a5fe7a-b8dd-3868-8bf2-8e1c2278ba5c",
                        "glosses": [
                            "Fehlentwicklung der inneren und/oder äußeren Geschlechtsorgane (Genitalien)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d33badee-2d98-41e7-b8e0-658b07bb8733",
                                "sense_id": "92950062-b087-3f49-bd32-c0a170adbe3b",
                                "text": "„Wahre Fettsucht gehört keineswegs zu den Merkmalen des Dysgenitalismus, worauf J. Tandler mit Recht hinwies, und wie von Noorden ausführlich darlegte.“"
                            },
                            {
                                "example_id": "f975dc22-a46b-41de-9279-8d453769df8e",
                                "sense_id": "92950062-b087-3f49-bd32-c0a170adbe3b",
                                "text": "„Zuständen mit Wachstumshemmung die Differentialdiagnose zwischen primärem Dysgenitalismus, speziell essentiellem oder glandulärem allgemeinen Infantilismus und hypophysärem Zwergwuchs zu gestalten.“"
                            },
                            {
                                "example_id": "6b6e9414-e59a-488b-b844-e2c39bb7e46d",
                                "sense_id": "92950062-b087-3f49-bd32-c0a170adbe3b",
                                "text": "„Bei dieser pluriglandulären Affektion, gewöhnlich mit starkem Dysgenitalismus und Hodenatrophie, habe ich schwere sekundäre Anämien gesehenl, desgleichen FANCONI bei einem 12jährigen Knaben mit progressiver Dystrophia musculorum, bei Hodenatrophie und anderen Störungen.“"
                            }
                        ],
