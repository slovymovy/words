                "senses": [
                    {
                        "sense_id": "9c9594e3-cb0a-33bc-8ac5-ccb0484f97a4",
                        "entry_id": "94e2d77b-ca2d-3854-87a2-a0b3d9dafee8",
                        "glosses": [
                            "Donner un caractère expérimental à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4140f84-12ef-4ee8-a285-409fe22dc46c",
                                "sense_id": "9c9594e3-cb0a-33bc-8ac5-ccb0484f97a4",
                                "text": "Sans doute, on pourrait avancer là un argument de nature à la fois méthodologique et psychologique, argument que l’introduction du Traité rappelle : la philosophie morale ne peut expérimentaliser comme le fait la philosophie naturelle."
                            },
                            {
                                "example_id": "4e8c4731-cc4d-404e-add5-74ef6b4c4729",
                                "sense_id": "9c9594e3-cb0a-33bc-8ac5-ccb0484f97a4",
                                "text": "Ceci est de la plus grande importance, car on discerne le biais par où la métaphysique swedenborgienne va pouvoir s’articuler avec une théorie empiriste de la connaissance ; on aperçoit comment sa mystique va, si j’ose dire, s’expérimentaliser."
                            }
                        ]
                    }
                ],
