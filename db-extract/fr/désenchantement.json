                                "target_senses": [
                                    {
                                        "sense_id": "07248028-8bd0-3d04-a37d-aead0229bf93",
                                        "entry_id": "5119f0cc-d94b-3e15-aafd-e2a31478d9ba",
                                        "glosses": [
                                            "The act of disenchanting or the state of being disenchanted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab20d2bb-72cc-38e6-a4af-8a0e48fe2b0d",
                                        "entry_id": "5119f0cc-d94b-3e15-aafd-e2a31478d9ba",
                                        "glosses": [
                                            "Freeing from false belief or illusions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7d889b6-f728-43fc-9a25-b99a136b7881",
                                                "sense_id": "ab20d2bb-72cc-38e6-a4af-8a0e48fe2b0d",
                                                "text": "Disenchantment with the religion led to a sharp fall in church attendance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab6e8948-ef3a-33d4-8769-a272f20887a0",
                                        "entry_id": "5119f0cc-d94b-3e15-aafd-e2a31478d9ba",
                                        "glosses": [
                                            "The devaluation of religion or mysticism apparent in modern society."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d82fbdc4-978e-4136-8d55-ab9d2bad4908",
                                                "sense_id": "ab6e8948-ef3a-33d4-8769-a272f20887a0",
                                                "text": "Blumenberg's thesis, which has since been reiterated by a number of philosophers and historians, is that nominalism, as it became widespread in Protestant theology, led to the Enlightenment, disenchantment, and the scientific revolution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
