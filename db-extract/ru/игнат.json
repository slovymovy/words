                                "target_senses": [
                                    {
                                        "sense_id": "45b6a3f1-b094-366a-ab83-0c9f4b12bcc4",
                                        "entry_id": "447652f0-ca27-326d-bdeb-c6a9dd77844d",
                                        "glosses": [
