                "senses": [
                    {
                        "sense_id": "9672e6d4-8767-36ce-b459-71ba58aacbdc",
                        "entry_id": "6ebfe247-e12f-378d-b1d9-27cc9c0d3336",
                        "glosses": [
                            "część uposażenia lub uposażenie dodatkowe wypłacane w naturze artykułami pierwszej potrzeby, typu opał, żywność"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c981b151-554e-48b4-9627-f1f8b81ca117",
                                "sense_id": "9672e6d4-8767-36ce-b459-71ba58aacbdc",
                                "text": "W tym roku żadna z pracowniczek nie dostała deputatu."
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6091f3bb-6808-4e76-a736-b78494d128e1",
                        "source_entry_id": "6ebfe247-e12f-378d-b1d9-27cc9c0d3336",
                        "source_sense_id": "9672e6d4-8767-36ce-b459-71ba58aacbdc",
                        "target_lang_word": "Deputat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Deputat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8987da7-5fb5-38cf-af73-4c9c7fed64e2",
                                        "entry_id": "bc6f7bc9-f86f-366e-82be-1d1adf628da5",
                                        "glosses": [
                                            "regelmäßige Leistung von Naturalien als Teil des Arbeitslohns (Naturallohn) oder der Altersversorgung, zum Beispiel in Form von Lebensmitteln, Getränken, Kohle, Tabakwaren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d067bb5-e96d-4691-abe7-25762a0fbd22",
                                                "sense_id": "d8987da7-5fb5-38cf-af73-4c9c7fed64e2",
                                                "text": "Ein Arbeitnehmer, der sein Deputat abholt, um es nach Hause zu bringen, steht dabei unter dem Schutz der gesetzlichen Unfallversicherung."
                                            },
                                            {
                                                "example_id": "ff51d651-52b6-497c-be7a-b8665deceecd",
                                                "sense_id": "d8987da7-5fb5-38cf-af73-4c9c7fed64e2",
                                                "text": "„Was die kleine Petruschkan abends von den Gutsfeldern heimbuckelt, gehört nicht zu ihrem Deputat.“"
                                            },
                                            {
                                                "example_id": "245f760b-4d52-4778-80a7-94a1a0951b23",
                                                "sense_id": "d8987da7-5fb5-38cf-af73-4c9c7fed64e2",
                                                "text": "„1234 schenkte der Erzbischof von Salzburg ein jährlich Deputat von zwei Kufen Salz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "87543777-7687-3684-a558-c81375e2f24e",
                                        "entry_id": "bc6f7bc9-f86f-366e-82be-1d1adf628da5",
                                        "glosses": [
                                            "Lehrverpflichtung; Anzahl der Pflichtstunden, die eine Lehrkraft zu geben hat (vorwiegend im Hochschulbereich)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79963d60-ddce-42dc-b06b-e476088e9743",
                                                "sense_id": "87543777-7687-3684-a558-c81375e2f24e",
                                                "text": "Die Antragsgegner in hat keine neuen Gründe vorgebracht, die eine weitergehende Reduzierung des Lehrdeputats rechtfertigen könnten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
