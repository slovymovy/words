    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a46862c1-def7-33b2-966d-57e2f64dfb28",
                "word": "repaint",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f4ffa6f8-c16b-42e0-87fe-c183ce514daa",
                        "entry_id": "a46862c1-def7-33b2-966d-57e2f64dfb28",
                        "tags": [
                            "plural"
                        ],
                        "form": "repaints"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "849adf35-b3aa-3ef0-86e3-9af98b6292a7",
                        "entry_id": "a46862c1-def7-33b2-966d-57e2f64dfb28",
                        "glosses": [
                            "The act or process of painting something again, especially if recently painted."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9abe032-8bb1-4c09-bffb-de5ff92556bc",
                                "sense_id": "849adf35-b3aa-3ef0-86e3-9af98b6292a7",
                                "text": "They didn't like the color so we had to do a repaint."
                            },
                            {
                                "example_id": "4194b393-e6fb-48b5-9331-3756982cea56",
                                "sense_id": "849adf35-b3aa-3ef0-86e3-9af98b6292a7",
                                "text": "More join us at Colwall and at the lovely station at Great Malvern, although the place is in need of some TLC nowadays. The ornate canopy supports are overdue a repaint, and the closed cafe gives the place a forlorn air."
                            }
                        ]
                    },
                    {
                        "sense_id": "34535f68-4fb5-3867-b82f-671a54df409c",
                        "entry_id": "a46862c1-def7-33b2-966d-57e2f64dfb28",
                        "glosses": [
                            "The act of drawing or rendering again on the display."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dc59678-ab04-4cc2-8e1e-58d6224a0c51",
                                "sense_id": "34535f68-4fb5-3867-b82f-671a54df409c",
                                "text": "WPF will call your OnRender function when it needs to know what content your visual displays, but the way graphics acceleration works in WPF means that this happens far less often than the equivalent repaints in Win32."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
