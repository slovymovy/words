                ],
                "senses": [
                    {
                        "sense_id": "fd934fb6-f5ed-3117-8b95-fef25e5f4a8d",
                        "entry_id": "40fc4e32-422d-3a8f-88b0-88f0fef4e972",
                        "glosses": [
                            "Schal aus Wolle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf452377-1771-4a94-954d-4a55f3354ba2",
                                "sense_id": "fd934fb6-f5ed-3117-8b95-fef25e5f4a8d",
                                "text": "„Nora Maria Foerst, jene Psychologin, die am 11. Oktober auf dem Heimweg von Polizisten nach dem Antigesichtsverhüllungsgesetz angezeigt wurde, weil sie ihren Wollschal zu weit im Gesicht trug, erhielt inzwischen die \"Aufforderung zur Rechtfertigung\" von der Landespolizeidirektion über ihren Anwalt Georg Zanger zugestellt.“"
                            },
                            {
                                "example_id": "e4d66a38-f12b-44ec-8ca8-da2723be432f",
                                "sense_id": "fd934fb6-f5ed-3117-8b95-fef25e5f4a8d",
                                "text": "„Sie trug ihre Pelzjacke, ihre Schneeschuhe und einen kleinen Wollschal um den Kopf – wie die Frauen sich heutzutage in den Strandbädern ein seidenes Taschentuch um die Haare binden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
