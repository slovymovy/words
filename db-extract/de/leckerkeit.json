                ],
                "senses": [
                    {
                        "sense_id": "552f725a-deff-3da9-87d7-69c417a29532",
                        "entry_id": "22f7a8d8-de70-303b-83f7-4b58929b85bf",
                        "glosses": [
                            "Maß, wie lecker etwas ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be4515fa-e001-400c-835e-ae3d0f46816c",
                                "sense_id": "552f725a-deff-3da9-87d7-69c417a29532",
                                "text": "Das Aussehen beeinträchtigt die Leckerkeit in keiner Weise."
                            },
                            {
                                "example_id": "5cab532d-bd35-4297-b24e-900e6e61b3cb",
                                "sense_id": "552f725a-deff-3da9-87d7-69c417a29532",
                                "text": "Leckerkeit ist das Maß aller essbaren Dinge."
                            },
                            {
                                "example_id": "e70893e6-ac9f-4a45-975b-d17d1f082b40",
                                "sense_id": "552f725a-deff-3da9-87d7-69c417a29532",
                                "text": "„Was die holländische Küche betrifft, so unterscheidet sie sich von letzterer, erstens durch die Reinlichkeit, zweitens durch die eigentliche Leckerkeit.“"
                            },
                            {
                                "example_id": "a8f39962-338e-4642-bb10-94a502e903c7",
                                "sense_id": "552f725a-deff-3da9-87d7-69c417a29532",
                                "text": "„Aber im ganzen mangelt es dieser tropischen Liebe an Naturalismus und Psychologie; die Schilderung ist überzuckert, und die größte Leckerkeit ist nicht einmal die schamhafte Cochonerie, mit der gedient wird, sondern jenes keusche Gegenstück, das sich von dem Sumpf abheben soll, Marineoffizier romanischen Geschmacks und reines Mädchen aus Gouverneursfamilie“"
                            },
                            {
                                "example_id": "9463ea13-2e4d-4b79-be75-ff16bc0f53ea",
                                "sense_id": "552f725a-deff-3da9-87d7-69c417a29532",
                                "text": "„Wir bieten Ihnen eine kulinarische Leckerkeit mit Geschichte … unsere hauseigenen Krapfen nach einer Rezeptur von Margarethe Hauer (1908-1998) und Anton Hauer (1909-1943).“"
                            },
                            {
                                "example_id": "210a3148-c3df-4cf1-a4b7-ded2e15b62ca",
                                "sense_id": "552f725a-deff-3da9-87d7-69c417a29532",
                                "text": "„Solch eine Gans hatte es noch nie gegeben. – Bob sagte, er könne nicht glauben, daß jemals eine solche Gans gebraten worden wäre. Ihre Zartheit und Leckerkeit, ihre Größe und ihre Billigkeit waren der Gegenstand allgemeiner Bewunderung“"
                            },
                            {
                                "example_id": "d3ab2f0f-fe2a-4931-9c42-b224d3b086bf",
                                "sense_id": "552f725a-deff-3da9-87d7-69c417a29532",
                                "text": "„Wenig kostet der Hunger, die Leckerkeit aber ist theuer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
