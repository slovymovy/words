                    {
                        "translation_id": "4fca9813-bf1c-4304-a06e-8cc41a35efa8",
                        "source_entry_id": "7a187eb6-b170-378a-84ef-45c6ad032de8",
                        "source_sense_id": "2fd24e61-2f53-393d-b7e1-5883184ab01c",
                        "target_lang_word": "listlessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "listlessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00863df2-d759-3b71-a17f-79267ce9719c",
                                        "entry_id": "99739af9-59be-343e-b1a9-c5a61cae7841",
                                        "glosses": [
                                            "In a listless manner; without energy or enthusiasm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad694172-b62b-4da1-9fc3-1217236b1980",
                                                "sense_id": "00863df2-d759-3b71-a17f-79267ce9719c",
                                                "text": "The lamb bunted several irresponsive objects - never its dam's udder - baaing listlessly."
                                            },
                                            {
                                                "example_id": "3694fd5e-8099-47df-a063-24859c733dd2",
                                                "sense_id": "00863df2-d759-3b71-a17f-79267ce9719c",
                                                "text": "And as a child stares at the bare walls of a narrow hut, so the gods looked all listlessly upon the worlds, saying: “Will no new thing be?”"
                                            },
                                            {
                                                "example_id": "6edde84e-68f8-48b4-a6cd-6fe3aad5eb11",
                                                "sense_id": "00863df2-d759-3b71-a17f-79267ce9719c",
                                                "text": "He thrust his head into the aisle. \"Boy!\" A Chinese in a white coat responded listlessly. \"What will you have? Beer?\""
                                            },
                                            {
                                                "example_id": "4325b4b4-3c42-404e-bae1-e15f7504b321",
                                                "sense_id": "00863df2-d759-3b71-a17f-79267ce9719c",
                                                "text": "Since first tossing its cartoonish, good-time cock-rock to the masses in the early ’00s, The Darkness has always fallen back on this defense: The band is a joke, but hey, it’s a good joke. With Hot Cakes—the group’s third album, and first since reforming last year—the laughter has died. In its place is the sad wheeze of the last surviving party balloon slowly, listlessly deflating."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
