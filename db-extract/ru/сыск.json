                        ]
                    },
                    {
                        "translation_id": "170ae5b5-ca21-4f22-8eab-2f28292c5251",
                        "source_entry_id": "a8365fd6-0a36-36e9-94b3-9e8fdb6de1bd",
                        "source_sense_id": "8900c0f6-9862-3568-bc2d-c7499528244c",
                        "target_lang_word": "police",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "police",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9eba33da-3264-3e35-90da-2c934e8d00d6",
                                        "entry_id": "4037208d-512a-3215-a212-f7c8c77b3436",
                                        "glosses": [
                                            "Ordre, règlement établi dans un État, dans une ville, pour tout ce qui regarde la sûreté, la tranquillité et la commodité des citoyens, des habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f374be5b-1abc-49e7-9cbe-a7b49d5e0dd5",
                                                "sense_id": "9eba33da-3264-3e35-90da-2c934e8d00d6",
                                                "text": "Dans les mellahs, le moqadem des quartiers de la vie musulmane était remplacé par le cheikh el yhoud qui en assurait la police sous l'autorité du gouverneur de la ville."
                                            },
                                            {
                                                "example_id": "2d12b9bb-2948-4f81-9a22-52f5b7d014a5",
                                                "sense_id": "9eba33da-3264-3e35-90da-2c934e8d00d6",
                                                "text": "Règlement, ordonnance de police."
                                            },
                                            {
                                                "example_id": "86f0fc8b-cf6b-4965-ad5b-7ee8c31c5602",
                                                "sense_id": "9eba33da-3264-3e35-90da-2c934e8d00d6",
                                                "text": "La police est bien faite dans cette ville."
                                            },
                                            {
                                                "example_id": "ff60b236-8c65-423f-a4a4-5109a8000109",
                                                "sense_id": "9eba33da-3264-3e35-90da-2c934e8d00d6",
                                                "text": "En bonne police, telle chose devrait être défendue."
                                            },
                                            {
                                                "example_id": "c0307d71-2947-49e8-a795-10b5a8b35887",
                                                "sense_id": "9eba33da-3264-3e35-90da-2c934e8d00d6",
                                                "text": "La police des mœurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "905777ae-5446-379f-b272-b24899118648",
                                        "entry_id": "4037208d-512a-3215-a212-f7c8c77b3436",
                                        "glosses": [
                                            "Administration qui exerce cette police."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92f90463-960c-4fa9-b530-dbd304f4e028",
                                                "sense_id": "905777ae-5446-379f-b272-b24899118648",
                                                "text": "Personne ne croit plus que les chrétiens se réfugiaient dans des carrières souterraines pour échapper aux perquisitions de la police ; […]."
                                            },
                                            {
                                                "example_id": "3ec7217b-6e07-4d91-a44f-b7a8f8a07bfc",
                                                "sense_id": "905777ae-5446-379f-b272-b24899118648",
                                                "text": "Des repaires dangereux existaient où la police n’osait s’aventurer."
                                            },
                                            {
                                                "example_id": "3505ff6a-cc04-4a3b-abd2-440c8d163835",
                                                "sense_id": "905777ae-5446-379f-b272-b24899118648",
                                                "text": "Cette infiltration de la police partout où nous étions allé me stupéfiait. Ainsi, je n'en pouvais douter, elle avait ses secrets aboutissant jusqu'en cette basse-pègre cependant si cauteleuse."
                                            },
                                            {
                                                "example_id": "e465bd46-8b23-4d11-8ee1-a2907fbcc67a",
                                                "sense_id": "905777ae-5446-379f-b272-b24899118648",
                                                "text": "Essayez donc de vous soustraire, filles imprudentes non pas à l’œil de la police ; mais à ce bavardage incessant qui, dans la dernière bourgade, scrute les actions les plus indifférentes, […]."
                                            },
                                            {
                                                "example_id": "97bee2bc-7c4a-43fe-b76a-6475211642ff",
                                                "sense_id": "905777ae-5446-379f-b272-b24899118648",
                                                "text": "La police attend avec des mitrailleuses et des gaz les grévistes noirs de Pennsylvanie."
                                            },
                                            {
                                                "example_id": "9c6289a6-0646-4815-a2a3-410b7b01ce55",
                                                "sense_id": "905777ae-5446-379f-b272-b24899118648",
                                                "text": "[…] la haine et le dégoût profonds que j’ai pour la police (physiquement : brutes grossières, sentant la sueur, le derrière brumeux et le prépuce mal lavé – bien plus sales que des ouvriers qui eux, du moins, ne traînent pas ces relents de chambrée)."
                                            },
                                            {
                                                "example_id": "fe939102-da96-46f1-aaa3-4e72dba1c5ad",
                                                "sense_id": "905777ae-5446-379f-b272-b24899118648",
                                                "text": "Introduit en France vers 1725, ce jeu devint rapidement populaire et il donna lieu à de tels excès que la police s’efforça, à maintes reprises, de l’interdire."
                                            },
                                            {
                                                "example_id": "8f212eae-1531-455a-984d-d5855f783927",
                                                "sense_id": "905777ae-5446-379f-b272-b24899118648",
                                                "text": "La veille de ce mercredi 12 juin, mon ami Maurice Andin, […], avait été arrêté à son domicile et la police y avait laissé un inspecteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f835361-e5f5-3cb1-95b3-bc453aeb560e",
                                        "entry_id": "4037208d-512a-3215-a212-f7c8c77b3436",
                                        "glosses": [
                                            "Ordre ou règlement établi dans quelque assemblée, dans quelque société que ce soit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d2223d9-5132-402e-a97b-e76389a37aa0",
                                                "sense_id": "6f835361-e5f5-3cb1-95b3-bc453aeb560e",
                                                "text": "De plus, ils faisaient en société les entreprises qu’ils ne pouvaient faire seuls ; et la police de ces sociétés était inviolable, par la rigueur des peines imposées à ceux qui ne les suivaient pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aede7c5a-80a3-385b-b086-216b45a4daae",
                                        "entry_id": "4037208d-512a-3215-a212-f7c8c77b3436",
                                        "glosses": [
                                            "Agent de police, policier."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8c3702c-6122-49c3-a5e0-250f8735c260",
                                                "sense_id": "aede7c5a-80a3-385b-b086-216b45a4daae",
                                                "text": "Il est une police."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "police",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c54a3ec-9d03-3c35-9d57-0b2e988e1cd6",
                                        "entry_id": "38c7a6cd-fcff-3e67-91a3-1f83ca31e131",
                                        "glosses": [
                                            "Contrat par lequel une compagnie d’assurances s’engage, moyennant une somme convenue, appelée prime, à indemniser quelqu’un de certaines pertes ou dommages éventuels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa6462e9-6649-4258-b76f-ee0af515723f",
                                                "sense_id": "6c54a3ec-9d03-3c35-9d57-0b2e988e1cd6",
                                                "text": "Ma police d’assurance pour mon habitation était expirée depuis le jour précédent, et […] il avait été convenu qu'à six heures je me présenterais devant le conseil des directeurs de la compagnie pour arrêter les termes d’un renouvellement."
                                            },
                                            {
                                                "example_id": "b91060f4-6d1e-4dcc-8732-663539c08a7c",
                                                "sense_id": "6c54a3ec-9d03-3c35-9d57-0b2e988e1cd6",
                                                "text": "Aussi, avait-il fait préparer une police d’assurance sur la vie au nom de la comédienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "276dca91-9fc2-3633-a20b-325f54866321",
                                        "entry_id": "38c7a6cd-fcff-3e67-91a3-1f83ca31e131",
                                        "glosses": [
                                            "Contrat d’abonnement au gaz, à l’électricité, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31ff0289-e21f-3b49-955c-0be90e9a3971",
                                        "entry_id": "38c7a6cd-fcff-3e67-91a3-1f83ca31e131",
                                        "glosses": [
                                            "Liste de tous les caractères composant une fonte, avec leur nombre (éventuellement au poids)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c15c8562-1ba5-463c-86b2-8a22d74e2d1d",
                                                "sense_id": "31ff0289-e21f-3b49-955c-0be90e9a3971",
                                                "text": "Quand un maître imprimeur veut acquérir une fonte, son premier soin doit être de dresser la police du caractère dont il a besoin, c’est-à-dire la liste de toutes les lettres qui composent la casse, avec l’indication de la quantité respective de chaque sorte de lettres pour un poids général déterminé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "725de755-ad4a-3b8b-82d5-3fc0447a313b",
                                        "entry_id": "38c7a6cd-fcff-3e67-91a3-1f83ca31e131",
                                        "glosses": [
                                            "Ensemble des caractères portés sur cette liste, constituant un alphabet complet existant normalement en plusieurs corps."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb15ca18-33b7-444c-91d1-9c9b9e3497d3",
                                                "sense_id": "725de755-ad4a-3b8b-82d5-3fc0447a313b",
                                                "text": "Cette table s’appelait la police (de l’italien polizia, liste ; c’est le mot que l’on retrouve dans « police d’assurance ») ; quand on a eu besoin de ces nouvelles tables, on a remplacé dans les polices le nombre de caractères par leur chasse (leur largeur) et on a gardé le mot police qui a alors désigné la fonte elle-même. Nous préférons garder ici le mot « fonte », même pour les numériques."
                                            },
                                            {
                                                "example_id": "6f45c9af-2257-48a1-b903-9ad12df0c716",
                                                "sense_id": "725de755-ad4a-3b8b-82d5-3fc0447a313b",
                                                "text": "Quelle police utilises-tu ?"
                                            },
                                            {
                                                "example_id": "1360b904-cff4-4870-8e34-f90389ee13c5",
                                                "sense_id": "725de755-ad4a-3b8b-82d5-3fc0447a313b",
                                                "text": "Il n’y a pas d’outil parfaitement capable d’identifier n’importe quelle police à partir d’une image."
                                            },
                                            {
                                                "example_id": "5b60060c-a627-47e3-b0f7-7011fb5652f0",
                                                "sense_id": "725de755-ad4a-3b8b-82d5-3fc0447a313b",
                                                "text": "Sur l’écran noir apparaissent des signes cabalistiques en police Courier."
                                            }
                                        ]
                                    }
                                ]
                            },
