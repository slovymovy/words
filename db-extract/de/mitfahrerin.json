                "senses": [
                    {
                        "sense_id": "b3e8c5d6-5229-3f80-92d5-eebb53db653a",
                        "entry_id": "ab0eaa7b-61a0-33c9-9263-b954f31407e5",
                        "glosses": [
                            "weibliche Person, die sich bei einer Fahrt mitnehmen lässt, eventuell gegen Fahrtkostenbeteiligung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bd1dc51-011a-44e3-a65f-dc49f86a2593",
                                "sense_id": "b3e8c5d6-5229-3f80-92d5-eebb53db653a",
                                "text": "„Mit 73 km/h ist ein 40-Jähriger samt 31-jähriger Mitfahrerin am Montagnachmittag auf seinem E-Scooter durch Wien-Döbling gerast, bevor er nach kurzer Verfolgung durch Beamte der Polizeiinspektion Billrothstraße im Kreuzungsbereich Heiligenstädter Straße und Kuchelauer Hafenstraße eingeholt und angehalten wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acdaaa88-ff68-4dea-9b65-a7e16855740f",
                        "source_entry_id": "ab0eaa7b-61a0-33c9-9263-b954f31407e5",
                        "source_sense_id": "b3e8c5d6-5229-3f80-92d5-eebb53db653a",
                        "source_sense_description": "weibliche Person, die sich bei einer Fahrt mitnehmen lässt, eventuell gegen Fahrtkostenbeteiligung",
                        "target_lang_word": "passagère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passagère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0a9423f-ff0d-3392-a5de-283e8192fc7e",
                                        "entry_id": "8a0f4a76-a71d-3b74-80a4-ab9e58c5ce48",
                                        "glosses": [
                                            "Celle qui prend passage à bord d’un navire, ou d’un aéronef, ou d’un train, ou d’un autre véhicule de transport collectif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a2857fe-e5da-4503-89f5-496a09dc9069",
                                                "sense_id": "a0a9423f-ff0d-3392-a5de-283e8192fc7e",
                                                "text": "Comme on le pense, elle fut présentée au commandant et entourée de tous les égards dus à une passagère de choix."
                                            },
                                            {
                                                "example_id": "29a5c9f8-cd7a-4281-992e-f3fdba60e2c4",
                                                "sense_id": "a0a9423f-ff0d-3392-a5de-283e8192fc7e",
                                                "text": "La rencontre avec sa passagère, Élise, puis la complicité avec sa propre fille, Klara, vont conduire Brendan, au fil des rebondissements de ce roman, à une prise de conscience inédite pour lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71380e52-37e7-3a31-a399-596de01b0684",
                                        "entry_id": "8a0f4a76-a71d-3b74-80a4-ab9e58c5ce48",
                                        "glosses": [
                                            "Une espèce d’insecte lépidoptère (papillon) de nuit de la famille des noctuidés (Noctuidae) dont le dos des ailes est de couleur grise avec des bandes foncées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a8a7b0b-a864-4e95-9a4b-07b83662975e",
                                                "sense_id": "71380e52-37e7-3a31-a399-596de01b0684",
                                                "text": "La chenille de la passagère se nourrit sur des ronces ou des saules."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "passagère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78e09155-5319-393d-857e-3951493a794c",
                                        "entry_id": "89ff7a31-f6eb-3447-86a0-05c77911d533",
                                        "glosses": [
                                            "Féminin singulier de passager."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4d683ad-5b81-4bdf-b4a2-af9a6fc6022b",
                                                "sense_id": "78e09155-5319-393d-857e-3951493a794c",
                                                "text": "Envie passagère d’être seul, ou de voir qui viendrait me « déchambrer »."
                                            }
                                        ]
                                    }
