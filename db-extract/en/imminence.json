                        "entry_id": "5f178871-9580-3fb9-a06a-e5c1399644a4",
                        "glosses": [
                            "The state or condition of being about to happen; imminent quality."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "266e53a3-c3a4-4131-be36-821e9d786f54",
                                "sense_id": "024d29db-6187-3a3d-8876-a8f490ca108b",
                                "text": "For three years there had been pestilence, and in the last of the three a famine; moreover, there was imminence of war."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dda60729-e6cc-4929-b01b-6357b59809b9",
                        "source_entry_id": "5f178871-9580-3fb9-a06a-e5c1399644a4",
                        "source_sense_id": "024d29db-6187-3a3d-8876-a8f490ca108b",
                        "source_sense_description": "state or condition of being imminent",
                        "target_lang_word": "imminence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
