        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d50149a-a799-3eff-8dec-9f165551221b",
                    "sense_definition": "To give a brief summary of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_summarize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>summed</w> up the situation perfectly in just a few words.",
                            "target_lang_translations": {
                                "ru": "Он идеально <w>подытожил</w> ситуацию всего в нескольких словах.",
                                "zh": "他只用了几句话就完美地<w>总结</w>了局势。"
                            }
                        },
                        {
                            "text": "To <w>sum</w> up, we need to focus on reducing costs.",
                            "target_lang_translations": {
                                "ru": "<w>Подытоживая</w>, нам нужно сосредоточиться на снижении расходов.",
                                "zh": "总而言之，我们需要专注于降低成本，<w>概括</w>来说就是这样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "summarize",
                        "review"
                    ],
                    "common_phrases": [
                        "sum up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кратко излагать суть, подводить итог.",
                        "zh": "简要概括某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подытоживать",
                                "target_lang_sense_clarification": "подводить итог"
                            },
                            {
                                "target_lang_word": "резюмировать",
                                "target_lang_sense_clarification": "обобщать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总结",
                                "target_lang_sense_clarification": "概括要点"
                            },
                            {
                                "target_lang_word": "概括",
                                "target_lang_sense_clarification": "简要说明"
                            }
                        ]
                    }
                },
