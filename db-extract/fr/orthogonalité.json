                        "source_entry_id": "84d435cf-185d-3239-abc2-8fada01905da",
                        "source_sense_id": "ba4cf44a-4987-3a11-824d-634dc419b71f",
                        "target_lang_word": "orthogonality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orthogonality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81bf5292-7308-3df3-a076-a8c9245b0106",
                                        "entry_id": "508fbdc1-05af-35c2-bd2d-6c8e261e2e3b",
                                        "glosses": [
                                            "The property of being orthogonal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afabf871-e065-478d-a015-a04664c62601",
                                                "sense_id": "81bf5292-7308-3df3-a076-a8c9245b0106",
                                                "text": "In this chapter we develop one of the key concepts in the geometry of the vector space Rⁿ, namely, the concept of orthogonality of vectors."
                                            },
                                            {
                                                "example_id": "819a3b44-95c0-4140-8407-4c25579e238a",
                                                "sense_id": "81bf5292-7308-3df3-a076-a8c9245b0106",
                                                "text": "Suppose we have an imaginary pair of axes with a set of comparable language entities on one and a set of attributes or capabilities on the other. When we talk of “orthogonality”, we usually mean that the space defined by these axes is as “full” as we can logically make it. Part of the Ruby way is to strive for this orthogonality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
