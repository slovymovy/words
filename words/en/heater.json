    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "08df293e-e8f9-3204-bb70-708d2eb52c68",
                    "sense_definition": "A device that produces and radiates heat, typically to raise the temperature of a room or building.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "heating_devices",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please turn on the <w>heater</w> because it is getting very cold in this room.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, включи <w>обогреватель</w>, потому что в комнате становится очень холодно."
                            }
                        },
                        {
                            "text": "The electric <w>heater</w> was enough to keep the small bedroom warm all night.",
                            "target_lang_translations": {
                                "ru": "Электрического <w>обогревателя</w> было достаточно, чтобы в маленькой спальне было тепло всю ночь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "electric heater",
                        "portable heater",
                        "turn on the heater"
                    ],
                    "target_lang_definitions": {
