                            },
                            {
                                "target_word": "Strauß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e4ad50f-2445-342a-b667-1a838966ca98",
                                        "entry_id": "94e648ff-84e7-32de-972d-aaa5f9b86123",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72d75ba4-1789-45c2-ae1f-167486112d70",
                                                "sense_id": "0e4ad50f-2445-342a-b667-1a838966ca98",
                                                "text": "Frau Strauß ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "7c80c3df-3c62-49b1-8454-7296b4fe50b1",
                                                "sense_id": "0e4ad50f-2445-342a-b667-1a838966ca98",
                                                "text": "Herr Strauß wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "4e445b7a-b56f-44c8-b598-4ba71d57829e",
                                                "sense_id": "0e4ad50f-2445-342a-b667-1a838966ca98",
                                                "text": "Die Straußens fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "6c35f3d2-405e-447a-9b42-afe7fac42cdb",
                                                "sense_id": "0e4ad50f-2445-342a-b667-1a838966ca98",
                                                "text": "Der Strauß trägt nie die Schals, die die Strauß ihm strickt."
                                            },
                                            {
                                                "example_id": "92a4ecac-469b-407b-a63c-f6296b86f916",
                                                "sense_id": "0e4ad50f-2445-342a-b667-1a838966ca98",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Strauß kommt, geht der Herr Strauß.“"
                                            },
                                            {
                                                "example_id": "ea8ac385-bd72-4b14-a0f0-12688231b63b",
                                                "sense_id": "0e4ad50f-2445-342a-b667-1a838966ca98",
                                                "text": "Strauß kommt und geht."
                                            },
                                            {
                                                "example_id": "1e807243-47fe-4562-8148-f1d8c83d0231",
                                                "sense_id": "0e4ad50f-2445-342a-b667-1a838966ca98",
                                                "text": "Strauß kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
