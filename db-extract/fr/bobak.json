                                "example_id": "f53b348c-6636-49a2-8372-198f9a881d5e",
                                "sense_id": "774984de-a1bb-3fef-80fa-9e29dc991d2e",
                                "text": "Les locataires se transmettaient la fureur, comme au Moyen Âge, en Mongolie, les chasseurs de la petite marmotte nommée bobak se passaient la peste."
                            }
