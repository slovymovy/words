            {
                "entry_id": "5acf79d8-f0bd-3981-878d-c672ae0f350e",
                "word": "Polyphème",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "505ddc72-b20a-3527-9e8a-2aaac930a1c5",
                        "entry_id": "5acf79d8-f0bd-3981-878d-c672ae0f350e",
                        "glosses": [
                            "Cyclope, fils de Poséidon et de la nymphe Thoosa, personnage de l’Odyssée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2188bf9-302e-4c49-b12d-13fedb78fad3",
                                "sense_id": "505ddc72-b20a-3527-9e8a-2aaac930a1c5",
                                "text": "C'est là que Polyphème a jeté à la mer d'un seul bras ces blocs sombres percés de grottes où l'on va en barque chercher l'ombre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4de87cd-241a-4aa5-8c42-10ea36d0b8b9",
                        "source_entry_id": "5acf79d8-f0bd-3981-878d-c672ae0f350e",
                        "source_sense_id": "505ddc72-b20a-3527-9e8a-2aaac930a1c5",
                        "target_lang_word": "Polyphem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polyphem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb6593f5-4a96-3727-a5ac-06f923df3f11",
                                        "entry_id": "6e4c7174-a194-311a-95d1-46ad9b714376",
                                        "glosses": [
                                            "besonders durch Homers „Odyssee“ bekannter Zyklop; Sohn des Poseidon"
                                        ],
                                        "tags": [
                                            "griechische Mythologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6baddc2e-b2a4-422e-ac06-dff188a6f7ba",
                                                "sense_id": "cb6593f5-4a96-3727-a5ac-06f923df3f11",
                                                "text": "„Der bekannteste Zyklop ist Polyphem, einer jener drei, die der unstete Odysseus im Laufe seiner Irrfahrt trifft.“"
                                            },
                                            {
                                                "example_id": "46bd5509-6c66-49d1-93ad-83b242c42ca4",
                                                "sense_id": "cb6593f5-4a96-3727-a5ac-06f923df3f11",
                                                "text": "„Aus dieser Verbindung konnte nichts Gutes werden, denn der einäugige Polyphem war zwar ungeheuer stark, aber leider ebenso dumm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5f75d36-0e26-406e-9146-417fca1a708b",
                        "source_entry_id": "5acf79d8-f0bd-3981-878d-c672ae0f350e",
                        "source_sense_id": "505ddc72-b20a-3527-9e8a-2aaac930a1c5",
                        "target_lang_word": "Polyphemos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polyphemos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba2f9cdc-e2e9-3f3e-a750-57c5725bea96",
                                        "entry_id": "3facde8f-4e9d-3ef6-8c94-b2fb46caddd4",
                                        "glosses": [
                                            "besonders durch Homers „Odyssee“ bekannter Zyklop; Sohn des Poseidon"
                                        ],
                                        "tags": [
                                            "griechische Mythologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44d1d276-bc31-40f2-aa53-245bb8fe9612",
                                                "sense_id": "ba2f9cdc-e2e9-3f3e-a750-57c5725bea96",
                                                "text": "„Auf Sizilien begegneten Odysseus und seinen Kameraden der Zyklop Polyphemos.“ [sic!]"
                                            },
                                            {
                                                "example_id": "8a8679f0-ed1e-4b95-a6e7-923a1d717f18",
                                                "sense_id": "ba2f9cdc-e2e9-3f3e-a750-57c5725bea96",
                                                "text": "„Gewaltig wie Polyphemos und widerwärtig wie ein riesiges Ungeheuer aus einem Albtraum schoss es den Monolithen hoch, um den es seine gigantischen, schuppenbedeckten Arme schlang, während es sein scheußliches Haupt neigte und rhythmische Laute ausstieß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
