                "translations": [
                    {
                        "translation_id": "6a2991b6-1478-4854-be63-9971bc030bb5",
                        "source_entry_id": "709f79df-2751-3fec-8742-0029ae1c446d",
                        "source_sense_id": "53c37784-da6a-326d-8b23-4841f45ce9b0",
                        "source_sense_description": "(Garn) Strang, Docke",
                        "target_lang_word": "Strang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c39693cf-8318-3389-9100-df679499cd0f",
                                        "entry_id": "b3965361-9ddd-3a4a-b3df-0773bbcfa1c5",
                                        "glosses": [
                                            "aus mehreren Fäden biegsamen Materials zusammengewirkter länglicher Strick"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b81e5557-b0c5-4207-811f-f8f3465f3a6d",
                                                "sense_id": "c39693cf-8318-3389-9100-df679499cd0f",
                                                "text": "Obwohl es gegen die Verurteilten keinerlei Beweise gab und alle Alibis hatten, sollten die Angeklagten, unter ihnen der gerade 23-jährige Louis Lingg, am Strang aufgehängt sterben."
                                            },
                                            {
                                                "example_id": "8a2ad264-0d89-4add-8966-c262f483f7ad",
                                                "sense_id": "c39693cf-8318-3389-9100-df679499cd0f",
                                                "text": "Die irakische Justiz hatte Madschid sowie zwei Mitangeklagte im Juni 2007 wegen Völkermordes, Kriegsverbrechen und Verbrechen gegen die Menschlichkeit zum Tod durch den Strang verurteilt."
                                            },
                                            {
                                                "example_id": "a064f953-2dde-4304-a657-44494e94f122",
                                                "sense_id": "c39693cf-8318-3389-9100-df679499cd0f",
                                                "text": "In ihrem Bemühen, den Kaller Jugendlichen einen geeigneten Raum für regelmäßige Treffen bereitzustellen, ziehen alle Fraktionen an einem Strang."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a48460b-7eed-3c67-a4d9-d3eed668c694",
                                        "entry_id": "b3965361-9ddd-3a4a-b3df-0773bbcfa1c5",
                                        "glosses": [
                                            "lang und schmal sich erstreckender Gegenstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20fd8452-ce32-4f70-bba6-517cfeda1475",
                                                "sense_id": "4a48460b-7eed-3c67-a4d9-d3eed668c694",
                                                "text": "Weiter ist geplant, einen Strang auf dem Meeresgrund über Griechenland nach Süditalien und einen zweiten über Serbien und Ungarn nach Österreich hinzuzufügen."
                                            },
                                            {
                                                "example_id": "df83323a-028f-447d-9142-7f187c674ae6",
                                                "sense_id": "4a48460b-7eed-3c67-a4d9-d3eed668c694",
                                                "text": "Ein schier endloser Strang aus Nerven, glänzend wie Seidenbast, teilt sich und teilt sich in millimeterdünne Nervenwurzeln und feinste Faszikel: das menschliche Hauptkabel."
                                            },
                                            {
                                                "example_id": "c55124db-62c0-49b5-b8ef-7db891673bcf",
                                                "sense_id": "4a48460b-7eed-3c67-a4d9-d3eed668c694",
                                                "text": "Darauf in die Mitte einen dicken Strang Creme spritzen."
                                            },
                                            {
                                                "example_id": "80b52668-5802-41a8-8efc-ceb9007a9c7c",
                                                "sense_id": "4a48460b-7eed-3c67-a4d9-d3eed668c694",
                                                "text": "Nur 500 Meter sind es auf diesem Strang bis Weiche 18"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c901b156-3dc2-3bab-ba28-9e4e8c3361b7",
                                        "entry_id": "b3965361-9ddd-3a4a-b3df-0773bbcfa1c5",
                                        "glosses": [
                                            "sich hinziehendes Ereignis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bff59b9-d38e-46b8-9861-590bbbb42875",
                                                "sense_id": "c901b156-3dc2-3bab-ba28-9e4e8c3361b7",
                                                "text": "Die Grünen haben zwei gesellschaftliche Wurzeln: Zum einen die junge und alte Linke… Der zweite Strang kam direkt aus dem Bürgertum,…"
                                            },
                                            {
                                                "example_id": "28dfe88a-1e97-40a6-9019-9b9998315870",
                                                "sense_id": "c901b156-3dc2-3bab-ba28-9e4e8c3361b7",
                                                "text": "Am Ende des einen Stranges müsse dann die Mittlere Reife stehen, am anderen Strang der Hauptschulabschluss."
                                            },
