                "senses": [
                    {
                        "sense_id": "f476b09a-d256-3577-8603-8737ceab2cbf",
                        "entry_id": "dc33258b-bd24-3272-bf88-b6f548788d66",
                        "glosses": [
                            "Enlever sa patine à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a21cc6ed-58fa-4c70-b1fe-d2f426ff56b8",
                                "sense_id": "f476b09a-d256-3577-8603-8737ceab2cbf",
                                "text": "La pièce a été dépatinée, ainsi qu’il était souvent de mode vers les années 1920, laissant à nu le métal lisse, brun sombre."
                            },
                            {
                                "example_id": "d5369fbb-efc7-4310-9258-a2a446471ea6",
                                "sense_id": "f476b09a-d256-3577-8603-8737ceab2cbf",
                                "text": "De telles figures offrent généralement une patine totale, certaines sont dépatinées."
                            },
                            {
                                "example_id": "e23f564d-318c-40ea-aafa-e7248184e02a",
                                "sense_id": "f476b09a-d256-3577-8603-8737ceab2cbf",
                                "text": "Dans Thomas l’imposteur, il avait combiné à une apparence de psychologie « rudimentaire » des aperçus ou constats très fins et pénétrants, dépatinant les sentiments les plus convenus (amour, plaisir, ambition), les sortant du lieu commun."
                            }
                        ]
                    }
