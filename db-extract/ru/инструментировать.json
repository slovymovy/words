                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebd45ada-15aa-39d7-b342-de86220f40c5",
                                        "entry_id": "43bfcc71-ca60-3f54-94a8-0a098bf6f76c",
                                        "glosses": [
                                            "A device used to produce music."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "282ad24b-3cca-4b29-8103-732776601346",
                                                "sense_id": "ebd45ada-15aa-39d7-b342-de86220f40c5",
                                                "text": "The violinist was a master of her instrument."
                                            },
                                            {
                                                "example_id": "47e9795e-765f-4576-a39f-9b069c152bba",
                                                "sense_id": "ebd45ada-15aa-39d7-b342-de86220f40c5",
                                                "text": "The Harpe. […] A harper with his wreſt maye tune the harpe wrong / Mys tunying of an Inſtrument ſhal hurt a true ſonge"
                                            },
                                            {
                                                "example_id": "8c9ff15a-3810-4409-a4af-0a040aa99551",
                                                "sense_id": "ebd45ada-15aa-39d7-b342-de86220f40c5",
                                                "text": "MOHAMMAD REZA SHAJARIAN (Thursday) Renowned in his native Iran, the vocalist Mohammad Reza Shajarian has been performing since the 1960s, and is now widely considered one of the finest classical Persian singers in the world. Mr. Shajarian’s son, Homayoun Shajarian, will provide additional vocals and tombak (goblet drum), while Ensemble Ava, a four-piece, will contribute additional instrumentation on the ancient Persian instruments barbat (short-necked lute), tar (long-necked lute), kamancheh (spike fiddle) and daf (frame drum)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8049308a-9c4b-3210-b0bd-fc4eca53a292",
                                        "entry_id": "43bfcc71-ca60-3f54-94a8-0a098bf6f76c",
                                        "glosses": [
                                            "A means or agency for achieving an effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ef25e4-406e-403b-baa2-a9c6e80c7bb4",
                                                "sense_id": "8049308a-9c4b-3210-b0bd-fc4eca53a292",
                                                "text": "“There the cause of death was soon ascertained ; the victim of this daring outrage had been stabbed to death from ear to ear with a long, sharp instrument, in shape like an antique stiletto, which […] was subsequently found under the cushions of the hansom. […]”"
                                            },
                                            {
                                                "example_id": "dfef2705-e2a6-4e58-bc51-d2d974b1c037",
                                                "sense_id": "8049308a-9c4b-3210-b0bd-fc4eca53a292",
                                                "text": "On the rocky island of Tungyin, 50 miles off the coast of Red China, is the headquarters of a little-known military unit called the Anti-Communist Salvation Army. The secret army, 30,000 strong, is Chiang Kai-shek's instrument for the long-promised return to the mainland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f47de32-de30-3c03-9c65-4a370ebeb769",
                                        "entry_id": "43bfcc71-ca60-3f54-94a8-0a098bf6f76c",
                                        "glosses": [
                                            "A measuring or displaying device."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f83e4ae7-1161-488c-b51c-9156ae70f949",
                                                "sense_id": "4f47de32-de30-3c03-9c65-4a370ebeb769",
                                                "text": "The instrument detected an increase in radioactivity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7c9b5da-77cd-38f2-ad6e-63e5c723f208",
                                        "entry_id": "43bfcc71-ca60-3f54-94a8-0a098bf6f76c",
                                        "glosses": [
                                            "A tool, implement used for manipulation or measurement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5553c0a3-6fa5-4a32-a47a-e32b0e281c89",
                                                "sense_id": "c7c9b5da-77cd-38f2-ad6e-63e5c723f208",
                                                "text": "The dentist set down his tray of instruments."
                                            },
                                            {
                                                "example_id": "0f27c26e-3cf5-40f8-8328-8728e5c7ae41",
                                                "sense_id": "c7c9b5da-77cd-38f2-ad6e-63e5c723f208",
                                                "text": "The scientist recorded the temperature with a thermometer, but wished he had a more accurate instrument."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45316325-a411-361e-91dc-f88f8426ed5d",
                                        "entry_id": "43bfcc71-ca60-3f54-94a8-0a098bf6f76c",
                                        "glosses": [
                                            "A tool, implement used for manipulation or measurement.",
                                            "Ellipsis of flight instrument."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9144655-7758-4dd9-aa3b-f3948558e399",
                                                "sense_id": "45316325-a411-361e-91dc-f88f8426ed5d",
                                                "text": "Flight within clouds must be made by reference to your instruments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a99e4cf-803a-3dc8-a7d9-e2bcdad766e1",
                                        "entry_id": "43bfcc71-ca60-3f54-94a8-0a098bf6f76c",
                                        "glosses": [
                                            "A legal document, such as a contract, deed, trust, mortgage, power, indenture, or will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18303eb1-0885-44d1-9339-6066d76d3bc8",
                                                "sense_id": "4a99e4cf-803a-3dc8-a7d9-e2bcdad766e1",
                                                "text": "A bond indenture is the instrument that gives a bond its value."
                                            },
                                            {
                                                "example_id": "ed4a2c28-fe2c-40a4-84a0-ac5c235f97f0",
                                                "sense_id": "4a99e4cf-803a-3dc8-a7d9-e2bcdad766e1",
                                                "text": "Negotiable instruments are the foundation of the debt markets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1770bd6-6919-33a6-ab0b-2b3edfb6da8a",
                                        "entry_id": "43bfcc71-ca60-3f54-94a8-0a098bf6f76c",
                                        "glosses": [
                                            "A person used as a mere tool for achieving a goal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a22197b4-ffa8-449d-aaed-0208b3c2f263",
                                                "sense_id": "d1770bd6-6919-33a6-ab0b-2b3edfb6da8a",
                                                "text": "Or useful serving man and instrument, / To any sovereign state."
                                            },
                                            {
                                                "example_id": "0cd09bcf-a8ad-4b0f-aeab-0b617597379c",
                                                "sense_id": "d1770bd6-6919-33a6-ab0b-2b3edfb6da8a",
                                                "text": "The bold are but the instruments o' the wise."
                                            }
                                        ]
                                    }
                                ]
