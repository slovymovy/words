                "senses": [
                    {
                        "sense_id": "8891929b-bf0f-31ef-967e-6192835b2e6b",
                        "entry_id": "1f279b6a-24bb-3411-96d4-0eaec47fba65",
                        "glosses": [
                            "разг. тот, кто безобразничает; озорник"
                        ],
                        "tags": [],
