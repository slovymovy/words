                "senses": [
                    {
                        "sense_id": "5c2925a1-09d8-328f-9cfc-26a9a9b3725e",
                        "entry_id": "25287b6e-0bac-3f17-ae50-b7bdd331e1d7",
                        "glosses": [
                            "meist bedeutsames Geschehen oder Erlebnis im Zusammenhang mit offenem Feuer"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "288db80c-989d-4649-a4be-e6df159fb9db",
                                "sense_id": "5c2925a1-09d8-328f-9cfc-26a9a9b3725e",
                                "text": "„Informieren Sie sich hier, wie Sie vorgehen müssen, wenn Ihr Besitz oder Teile davon durch ein Feuerereignis beschädigt oder zerstört worden ist.“"
                            },
                            {
                                "example_id": "0a6d6c6b-f6e7-4b2b-afca-94f6dff3ba78",
                                "sense_id": "5c2925a1-09d8-328f-9cfc-26a9a9b3725e",
                                "text": "„Durch ein Feuerereignis oder Leitungswasserschaden wird oft der Hausrat vernichtet.“"
                            },
                            {
                                "example_id": "161bd7f1-7b14-4baa-8be4-88422ab58079",
                                "sense_id": "5c2925a1-09d8-328f-9cfc-26a9a9b3725e",
                                "text": "„Bereits in der ersten Stunde nach dem Feuerereignis, bei dem mindestens 20 überwiegend ältere Menschen ihr Leben verloren und weitere verletzt wurden, kam das Kriseninterventionsteam des RDA zusammen, um erste Analysen zur Unfallursache und weiterführende Maßnahmen zu koordinieren.“"
                            },
                            {
                                "example_id": "f6f40601-5172-4dc8-a85c-1cdf7d73055f",
                                "sense_id": "5c2925a1-09d8-328f-9cfc-26a9a9b3725e",
                                "text": "„Entscheidend jedoch ist die Tatsache, dass bei einem Feuerereignis vor allem Passagiere und natürlich auch die Fracht ernsthaft gefährdet sind.“"
                            },
                            {
                                "example_id": "e7dbee03-2fad-4940-ab2d-232a71eb1b0b",
                                "sense_id": "5c2925a1-09d8-328f-9cfc-26a9a9b3725e",
                                "text": "„Wie Brandereignise in Tunnels zeigen (Tauerntunnel) breitet sich ein Feuerereignis von Fahrzeug zu Fahrzeug in erster Linie durch Strahlungshitze aus, die Intensität von Wärmestrahlng nimmt mit dem Quadrat der Entfernung der Strahlungsquelle ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
