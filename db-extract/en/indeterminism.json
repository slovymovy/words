                        ]
                    },
                    {
                        "translation_id": "ea7bfb43-f99f-48ed-aec2-9556d402cef4",
                        "source_entry_id": "7bab935b-8703-327c-9e8f-818bd6c0d468",
                        "source_sense_description": "Translations",
                        "target_lang_word": "indéterminisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indéterminisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1796086c-02cb-3f02-be08-3b137019baf3",
                                        "entry_id": "decc52de-a73d-3336-890f-68b6e0d5ab92",
                                        "glosses": [
                                            "Système opposé au déterminisme, c’est-à-dire système qui admet la liberté de la volonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c98e6019-eea0-46f4-afc2-165520ee1777",
                                                "sense_id": "1796086c-02cb-3f02-be08-3b137019baf3",
                                                "text": "Le libertarisme : nous avons un libre arbitre véritable, et c’est pourquoi le déterminisme doit être faux ; seul l’indéterminisme est vrai."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fd2f029-88e9-47c6-91fe-ae2dc1ed38d5",
                        "source_entry_id": "7bab935b-8703-327c-9e8f-818bd6c0d468",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Indeterminismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indeterminismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "525d2ada-13e7-38f1-93e4-a04fdce0d413",
                                        "entry_id": "a74a0558-d7a7-3df5-93e3-698f63db00bd",
                                        "glosses": [
                                            "Weltbild, das nicht vom Determinismus ausgeht, sondern vertritt, dass der menschliche Willensakt nicht bestimmbar und vorhersehbar ist"
                                        ],
                                        "tags": [
                                            "des Geistes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bffece4-2870-4de4-9ace-ef8c134d480d",
                                                "sense_id": "525d2ada-13e7-38f1-93e4-a04fdce0d413",
                                                "text": "„Eine letzte Frage betrifft schließlich das bereits gelegentlich angeschnittene Problem des Verältnisses von Determinismus und Indeterminismus.“"
                                            },
                                            {
                                                "example_id": "066bc63d-277a-4f97-818b-8809b8c58a16",
                                                "sense_id": "525d2ada-13e7-38f1-93e4-a04fdce0d413",
                                                "text": "Der Indeterminismus geht davon aus, dass der menschliche Wille sich selbst die Richtung gibt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
