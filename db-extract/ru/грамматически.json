                                "target_senses": [
                                    {
                                        "sense_id": "b6ee72f6-43bf-34bd-8e05-09bfd4612a25",
                                        "entry_id": "8f4fae54-fe85-34c3-a928-347b07ebced9",
                                        "glosses": [
                                            "die Grammatik betreffend, sich auf sie beziehend (= die Sprachlehre betreffend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b0ab48-920b-450b-933b-99b68fc8ae10",
                                                "sense_id": "b6ee72f6-43bf-34bd-8e05-09bfd4612a25",
                                                "text": "Ein ungrammatischer Satz ist grammatikalisch falsch."
                                            },
                                            {
                                                "example_id": "561c5cad-4a9c-4597-8530-88d105b44e38",
                                                "sense_id": "b6ee72f6-43bf-34bd-8e05-09bfd4612a25",
                                                "text": "„Was die Unabhängigkeit einer Sprache beweise, führt er aus, sei nicht so sehr ihr Wortschatz als vielmehr ihre grammatikalische Struktur.“"
                                            },
                                            {
                                                "example_id": "d87eae7a-039c-4d94-a9cb-3f5f3e0f0bda",
                                                "sense_id": "b6ee72f6-43bf-34bd-8e05-09bfd4612a25",
                                                "text": "„Die Verknüpfung von Nebensätzen ist hingegen ein deutlich komplexeres Unterfangen, da es einen oder mehrere grammatikalische Bezüge und formale Anschlüsse zu realisieren gilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4565d3ba-709a-4029-a1b0-0f830307ee4b",
                        "source_entry_id": "6b290702-f45f-3046-9148-8c46dd420077",
                        "source_sense_id": "b640360b-80d9-371d-bd67-d0361c369a88",
                        "target_lang_word": "grammatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
