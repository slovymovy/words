                                        "sense_id": "b30eb2a0-a584-3227-bd51-e1fe0af37e3b",
                                        "entry_id": "6f538cef-37ce-3ec3-8ef1-93ab1b4081e7",
                                        "glosses": [
                                            "The head of certain religious orders, especially Dominicans or Jesuits."
