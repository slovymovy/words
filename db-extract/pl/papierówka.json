                "senses": [
                    {
                        "sense_id": "a42883fc-f23e-3f3f-8869-8c3aaa804566",
                        "entry_id": "4d33639c-4009-33a5-ab6e-14eefafb8d1f",
                        "glosses": [
                            "wczesna odmiana uprawna jabłoni domowej o białawych lub bladożółtych owocach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85265e7c-36e2-48f9-a960-34368e9a2e1e",
                                "sense_id": "a42883fc-f23e-3f3f-8869-8c3aaa804566",
                                "text": "Trzeba podeprzeć gałęzie papierówki, bo się złamią pod ciężarem tylu owoców."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fc66a436-7695-3b49-a659-8c6256c5006d",
                        "entry_id": "4d33639c-4009-33a5-ab6e-14eefafb8d1f",
                        "glosses": [
                            "białawe lub bladożółte jabłko o cienkiej skórce, owoc papierówki (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00f2e46e-8ca9-456f-9362-3a1bd7d572e1",
                                "sense_id": "fc66a436-7695-3b49-a659-8c6256c5006d",
                                "text": "Jak te papierówki pięknie pachną! Aż ślinka cieknie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "596f682b-b2aa-3f88-8270-152be0ff386a",
