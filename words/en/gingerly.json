{
    "word_family": [
        "ginger"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ea80039a-7967-3b13-baab-87e19170d4da",
                    "sense_definition": "In a cautious and delicate manner; very carefully.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cautious_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He placed the glass jar <w>gingerly</w> on the concrete step.",
                            "target_lang_translations": {
                                "cs": "Skleněnou nádobu položil <w>opatrně</w> na betonový schod.",
                                "ru": "Он <w>осторожно</w> поставил стеклянную банку на бетонную ступеньку."
                            }
                        },
                        {
                            "text": "The injured man <w>gingerly</w> stepped over the broken glass on the floor.",
                            "target_lang_translations": {
                                "cs": "Zraněný muž <w>opatrně</w> překročil střepy na podlaze.",
                                "ru": "Раненый мужчина <w>опасливо</w> перешагнул через битое стекло на полу."
                            }
                        }
                    ],
                    "synonyms": [
                        "tentatively",
                        "warily"
                    ],
                    "common_phrases": [
                        "handle gingerly",
                        "step gingerly"
                    ],
                    "target_lang_definitions": {
                        "cs": "Opatrným a jemným způsobem; velmi obezřetně.",
                        "ru": "Осторожно, бережно и с особой осмотрительностью."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "opatrně",
                                "target_lang_sense_clarification": "obecné vyjádření opatrnosti při pohybu či manipulaci"
                            },
                            {
                                "target_lang_word": "obezřetně",
                                "target_lang_sense_clarification": "vyjadřuje zvýšenou pozornost a ostražitost"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "осторожно",
                                "target_lang_sense_clarification": "с опаской, стараясь не сделать резких движений"
                            },
                            {
                                "target_lang_word": "бережно",
                                "target_lang_sense_clarification": "деликатно и аккуратно, чтобы не повредить"
                            },
                            {
                                "target_lang_word": "опасливо",
                                "target_lang_sense_clarification": "с боязнью, опасением или настороженностью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0465b483-dc75-3585-a5c3-2e8586f78e10",
                    "sense_definition": "In a dainty or affected manner, often involving small steps.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "dainty_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked <w>gingerly</w> across the stage in her high heels.",
                            "target_lang_translations": {
                                "cs": "Na vysokých podpatcích kráčela po jevišti <w>křehce</w>.",
                                "ru": "Она <w>жеманно</w> прошла по сцене на высоких каблуках."
                            }
                        },
                        {
                            "text": "The dancer moved <w>gingerly</w> to match the delicate rhythm of the music.",
                            "target_lang_translations": {
                                "cs": "Tanečník se pohyboval <w>křehce</w>, aby ladil s jemným rytmem hudby.",
                                "ru": "Танцор двигался <w>изящно</w>, подстраиваясь под тонкий ритм музыки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "V jemném nebo afektovaném stylu, často zahrnujícím drobné krůčky.",
                        "ru": "Изящно, жеманно или неестественно деликатно, часто мелкими шажками."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "křehce",
                                "target_lang_sense_clarification": "zdůrazňuje jemnost a lehkost pohybu"
                            },
                            {
                                "target_lang_word": "vybraně",
                                "target_lang_sense_clarification": "v kontextu afektovaného či přehnaně kultivovaného chování"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "жеманно",
                                "target_lang_sense_clarification": "с манерностью и неестественной грацией"
                            },
                            {
                                "target_lang_word": "манерно",
                                "target_lang_sense_clarification": "с излишней деланностью в движениях"
                            },
                            {
                                "target_lang_word": "деликатно",
                                "target_lang_sense_clarification": "тонко, изящно и легко"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d52ff459-e43b-3812-9ba4-3502dfcd558f",
                    "sense_definition": "Very careful, cautious, or delicate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cautious_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat made a <w>gingerly</w> approach toward the strange object.",
                            "target_lang_translations": {
                                "cs": "Kočka se k podivnému předmětu přiblížila <w>opatrným</w> způsobem.",
                                "ru": "Кошка совершила <w>осторожное</w> приближение к странному предмету."
                            }
                        },
                        {
                            "text": "He took a <w>gingerly</w> step onto the thin ice.",
                            "target_lang_translations": {
                                "cs": "Učinil <w>opatrný</w> krok na tenký led.",
                                "ru": "Он сделал <w>опасливый</w> шаг на тонкий лед."
                            }
                        }
                    ],
                    "synonyms": [
                        "tentative",
                        "wary"
                    ],
                    "common_phrases": [
                        "gingerly approach",
                        "gingerly step"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velmi opatrný, obezřetný nebo jemný.",
                        "ru": "Очень осмотрительный, осторожный или деликатный."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "opatrný",
                                "target_lang_sense_clarification": "nejčastější přídavné jméno pro vyjádření obezřetnosti"
                            },
                            {
                                "target_lang_word": "váhavý",
                                "target_lang_sense_clarification": "vyjadřuje nejistotu a pomalý přístup"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "осторожный",
                                "target_lang_sense_clarification": "проявляющий крайнюю осмотрительность"
                            },
                            {
                                "target_lang_word": "робкий",
                                "target_lang_sense_clarification": "нерешительный, опасливый"
                            },
                            {
                                "target_lang_word": "осмотрительный",
                                "target_lang_sense_clarification": "взвешенный и аккуратный в действиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42dfa3b4-04c1-3213-a993-19cce3d8acdb",
                    "sense_definition": "Excessively delicate or affected in manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "dainty_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>gingerly</w> behavior seemed out of place at the casual party.",
                            "target_lang_translations": {
                                "cs": "Její <w>afektované</w> chování se na neformálním večírku nehodilo.",
                                "ru": "Её <w>жеманное</w> поведение казалось неуместным на непринуждённой вечеринке."
                            }
                        },
                        {
                            "text": "He adopted a <w>gingerly</w> tone that annoyed his colleagues.",
                            "target_lang_translations": {
                                "cs": "Zvolil <w>přecitlivělý</w> tón, který jeho kolegy obtěžoval.",
                                "ru": "Он заговорил <w>манерным</w> тоном, который раздражал его коллег."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nadměrně jemný nebo afektovaný v chování.",
                        "ru": "Чрезмерно деликатный, чопорный или жеманный."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přecitlivělý",
                                "target_lang_sense_clarification": "v kontextu přehnané jemnosti"
                            },
                            {
                                "target_lang_word": "afektovaný",
                                "target_lang_sense_clarification": "v kontextu nepřirozeného, strojeného chování"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "жеманный",
                                "target_lang_sense_clarification": "неестественный, показной и манерный"
                            },
                            {
                                "target_lang_word": "чопорный",
                                "target_lang_sense_clarification": "чрезмерно строгий и щепетильный в поведении"
                            },
                            {
                                "target_lang_word": "манерный",
                                "target_lang_sense_clarification": "лишенный простоты и естественности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}