                        "entry_id": "040ab6a9-aaa0-3b0f-b78a-b505259c3a24",
                        "glosses": [
                            "Nom vernaculaire générique donné à certaines espèces d'hypolaïs."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "091f8298-0adc-4d33-93d9-f018d0bd6db0",
                                "sense_id": "efe1dc2a-4f8b-3e25-acce-66553d972ae0",
                                "text": "On donne encore parfois le nom de contrefaisant à certaines espèces d'hypolaïs comme l'hypolaïs ictérine (Hippolais icterina: contrefaisant à ailes longues ou grand contrefaisant), l'hypolaïs polyglotte (Hippolais polyglotta: petit contrefaisant ou contrefaisant à ailes courtes), l'hypolaïs des oliviers (Hippolais oliverum: contrefaisant des oliviers) et l'hypolaïs pâle (Iduna pallida & Iduna opaca: contrefaisant pâle)."
                            }
                        ]
                    }
