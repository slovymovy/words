                        "cross_references": [
                            {
                                "target_word": "collude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec0de37-1548-3f2c-ae3c-3b19205cc70f",
                                        "entry_id": "67bf0d4d-e201-3b97-bee3-d8887daaab39",
                                        "glosses": [
                                            "to act in concert with; to conspire"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d1dbf37-567d-456f-9476-bdb8c4f22c3b",
                                                "sense_id": "6ec0de37-1548-3f2c-ae3c-3b19205cc70f",
                                                "text": "William understood Diana more but idealized her less. He was privy to her volatile love life. He knew the tabloids made her life hell, but he also knew she colluded with them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
