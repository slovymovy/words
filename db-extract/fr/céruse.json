                                        "entry_id": "b7bb830a-32ba-39fd-b839-cf84439c533e",
                                        "glosses": [
                                            "Synonym of white lead, a hydrate of lead mixed with carbonate, particularly as used to whiten skin or in early medicine."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7047e877-60b3-49d7-bdf9-e32830cce1c1",
                                                "sense_id": "80fc4bec-77d7-3c74-bb90-7ee2274a8783",
                                                "text": "Galen hath taken exceptions at such waters which run through leaden pipes, ob cerussam quæ in iis generatur, for that unctuous ceruse, which causeth dysenteries and fluxes […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
