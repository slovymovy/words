                    {
                        "form_id": "cd1b66ee-0a35-43c8-9839-e5cb37cb79e7",
                        "entry_id": "18520805-ecc3-3a98-b81d-fa7531c46d7c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Aluminiumfolie"
                    },
                    {
                        "form_id": "66573321-2639-401e-b0b4-cb42c2b07582",
                        "entry_id": "18520805-ecc3-3a98-b81d-fa7531c46d7c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Aluminiumfolien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                        "entry_id": "18520805-ecc3-3a98-b81d-fa7531c46d7c",
                        "glosses": [
                            "sehr dünn gewalztes Metall (= Folie) aus Aluminium, häufig zum Verpacken von Lebensmitteln eingesetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83bceeb2-fd90-4da1-88c3-6d4d103587d6",
                                "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                                "text": "In Aluminiumfolie gewickelt halten Lebensmittel länger."
                            },
                            {
                                "example_id": "423ca1d8-8f26-44d1-b57a-3bb57cfcb4ec",
                                "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                                "text": "„Lammbraten mit mediterranen Knödeln“ – […] „15 Minuten muss der Teig ziehen, bevor er auf eine eingefettete Aluminiumfolie kommt. Dann den Knödelteig fest in der Aluminiumfolie einwickeln. Für 25 Minuten kommen die Knödel in das kochende Wasser.“"
                            },
                            {
                                "example_id": "ef83a645-2dc8-4944-bfae-256e5ec2840c",
                                "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                                "text": "„Beim Grillabend gehören Aluminiumfolie und Aluschalen häufig dazu - auch, wenn Aluminium in großen Mengen gesundheitsschädlich sein kann. Grillen geht auch ganz ohne Alu.“"
                            },
                            {
                                "example_id": "d0618fde-23ee-46ba-a4ce-7459e905d288",
                                "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                                "text": "„Beim täglichen Umgang mit Aluminium ist manchmal auch Vorsicht geboten. So sollten zum Beispiel salzige oder saure Lebensmittel nicht in Aluminiumfolie verpackt werden. Die Säure löst das Aluminium und man könnte das Metall mit der Speise aufnehmen.“"
                            },
                            {
                                "example_id": "cded395f-f992-4dc6-9eae-e60a9ab47905",
                                "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                                "text": "„Für Gesundheit und Ernährungssicherheit empfiehlt es sich, stark saure oder salzhaltige Lebensmittel nicht über längere Zeit in Kochgeschirr aus unbehandeltem Aluminium aufzubewahren. Auch Aluminiumfolien sollten nicht zum Abdecken solcher Speisen verwendet werden.“"
                            },
                            {
                                "example_id": "1f56b4fe-468a-44e9-89b9-cb0f9597210d",
                                "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                                "text": "Man kann Kabel gegen äußere elektromagnetische Störungen mithilfe von Aluminiumfolie schützen."
                            },
                            {
                                "example_id": "9d02b234-93da-48de-ab36-cb6d019eb43f",
                                "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                                "text": "Im zweiten Weltkrieg wurden aus Flugzeugen Streifen aus Aluminiumfolie abgeworfen, um das gegenerische Radar zu täuschen."
                            },
                            {
                                "example_id": "904157af-1089-4421-ba19-fb9b3a09c204",
                                "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                                "text": "„Die Fenster waren mit Aluminiumfolie abgeklebt, um Einblicke von außen zu verhindern.“"
                            },
                            {
                                "example_id": "854836e5-0f25-44ce-b515-503a9b11f010",
                                "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                                "text": "„Silberbesteck mit Aluminiumfolie reinigen“ - […] „Das Besteck etwa für eine Minute ins Wasser legen, so dass es in Kontakt mit der Aluminiumfolie steht. Danach mit Spülmittel reinigen und trocken reiben. Lässt die Wirkung des Wassers nach, muss die Aluminiumfolie ersetzt werden.“"
                            },
                            {
                                "example_id": "161032ea-23b3-45e7-8e82-801f952ed547",
                                "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                                "text": "„Alles, was produziert wird, muss ja hinterher wieder aufwändig getrennt werden. Das klassische Beispiel dafür ist der Joghurtbecher mit Deckel aus Aluminiumfolie:“ […]"
                            },
                            {
                                "example_id": "8eae015a-6214-4975-9477-6187681878f2",
                                "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                                "text": "[Weihnachtsbaumschmuck:] „Heute werden die Engel meist aus bunt bemaltem Papier oder Aluminiumfolie gefaltet.“"
                            },
                            {
                                "example_id": "033253f6-af56-47e4-84b5-c0e3b5e30d6c",
                                "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                                "text": "[…] „»Der Sonnenkollektor ist nichts Anderes als ein Karton aus Pappe, 2 Meter mal 1,90. Darauf haben wir Aluminiumfolie geklebt, eigentlich aus Kaugummi-Papier, und die sammelt dann die Sonnenenergie.«“"
                            },
                            {
                                "example_id": "2d8cfb7d-0d7b-497e-b764-446c8bd2d151",
                                "sense_id": "cc416ef3-9a86-3ff0-b300-09ad8ffee888",
                                "text": "„«Das Sonnensegel muss man sich als eine ungefähr ein Meter hohe Aluminiumfolie vorstellen», sagt Benz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
