                                        "entry_id": "10131d33-1a54-3b8e-ad46-549e83d09ac7",
                                        "glosses": [
                                            "Aufnahme eines sprachlichen Ausdrucks als Lemma/Stichwort in ein Wörterbuch"
                                        ],
