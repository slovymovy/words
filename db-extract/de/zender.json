                "senses": [
                    {
                        "sense_id": "eec46050-7543-34a1-a87d-3b3ba7e819b2",
                        "entry_id": "5b1291ce-c20b-3ac7-876e-136be4aaf4f8",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9701d43-a2ee-4932-b9e4-5609cd027a18",
                                "sense_id": "eec46050-7543-34a1-a87d-3b3ba7e819b2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zender kommt, geht der Herr Zender.“"
                            },
                            {
                                "example_id": "bb0eabfa-15ba-457d-abab-325f75d76f13",
                                "sense_id": "eec46050-7543-34a1-a87d-3b3ba7e819b2",
                                "text": "Zender kommt und geht."
                            },
                            {
                                "example_id": "7863b756-188f-41e6-bc0a-7120d990115d",
                                "sense_id": "eec46050-7543-34a1-a87d-3b3ba7e819b2",
                                "text": "Zenders kamen, sahen und siegten."
                            },
                            {
                                "example_id": "923af752-6e97-4a46-a5a4-b976a633957d",
                                "sense_id": "eec46050-7543-34a1-a87d-3b3ba7e819b2",
                                "text": "Frau Zender ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2cde98b8-61a2-4c2a-b9f3-aaf73d81c9c6",
                                "sense_id": "eec46050-7543-34a1-a87d-3b3ba7e819b2",
                                "text": "Herr Zender wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c9e6606d-3086-4012-a9de-9d385453ef88",
                                "sense_id": "eec46050-7543-34a1-a87d-3b3ba7e819b2",
                                "text": "Die Zenders fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b38bc1c7-d41a-48f6-a7bf-a26064be0af4",
                                "sense_id": "eec46050-7543-34a1-a87d-3b3ba7e819b2",
                                "text": "Der Zender trägt nie die Schals, die die Zender ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
