                        "examples": [
                            {
                                "example_id": "a25bdace-40e7-48fd-9842-1d4e6b4e8713",
                                "sense_id": "01a97cb1-a53a-3617-bfc3-4f09208ab57b",
                                "text": "Auf dem Chefsessel darf manchmal auch die Sekretärin sitzen."
                            },
                            {
                                "example_id": "4e134d90-6c5c-4e0c-9a5c-8ec6f68b3547",
                                "sense_id": "01a97cb1-a53a-3617-bfc3-4f09208ab57b",
                                "text": "„Zufrieden lehnt er sich in seinem ledernen Chefsessel zurück und freut sich über einen Fachartikel, den er gerade gelesen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
