                    {
                        "sense_id": "b3f1213c-e7d3-39c8-9f8c-08a4bee093fe",
                        "entry_id": "f8257b87-b26a-311a-af0d-bbd1895375bc",
                        "glosses": [
                            "S’autoriser soi-même."
                        ],
