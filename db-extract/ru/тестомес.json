                                        "entry_id": "7f275452-a3df-3368-9a8c-bff4df3a47bb",
                                        "glosses": [
                                            "One who kneads."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9b188d-f653-45be-b31f-82a902a1bd89",
                                                "sense_id": "32242de9-a8ac-34b4-a4eb-4b649743314e",
                                                "text": "If you practice building your massage muscles as I suggest in Chapter 9, you can be a better kneader because this particular maneuver requires a lot of strength in the hands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9da4217a-1882-3135-b2cd-f4c40c39f288",
                                        "entry_id": "7f275452-a3df-3368-9a8c-bff4df3a47bb",
                                        "glosses": [
                                            "A machine that kneads dough or any other highly elastoviscous mixture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
