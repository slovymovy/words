            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17052d4c-cdf8-324e-b1ae-6ee6aa7e7bc6",
                    "sense_definition": "naar beneden komen van een hoger gelegen plaats",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleine jongen durfde niet alleen van de hoge glijbaan <w>af</w> te <w>komen</w>.",
                            "target_lang_translations": {
                                "en": "The little boy didn't dare to <w>come down</w> from the high slide by himself."
                            }
                        },
                        {
                            "text": "Pas op dat je niet valt als je de trap <w>afkomt</w> met die zware doos.",
                            "target_lang_translations": {
                                "en": "Be careful not to fall when you <w>come down</w> the stairs with that heavy box."
                            }
                        }
                    ],
                    "common_phrases": [
                        "van de trap afkomen",
                        "van het dak afkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to come down from a higher place"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come down",
                                "target_lang_sense_clarification": "descend from a higher position"
                            },
                            {
                                "target_lang_word": "get down",
                                "target_lang_sense_clarification": "descend, often with some effort"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4eb5df0c-d0ac-380f-b11e-e29e19cd12a1",
                    "sense_definition": "bij iemand op bezoek gaan of ergens verschijnen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bezoek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zal ik morgenavond even bij je <w>afkomen</w> om de plannen te bespreken?",
                            "target_lang_translations": {
                                "en": "Shall I <w>come over</w> to your place tomorrow evening to discuss the plans?"
                            }
                        },
                        {
                            "text": "Er <w>kwamen</w> veel mensen op het gratis concert in het park <w>af</w>.",
                            "target_lang_translations": {
                                "en": "Many people <w>showed up</w> for the free concert in the park."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eens even afkomen",
                        "op een feestje afkomen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in informal invitations"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to visit someone or show up somewhere"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come over",
                                "target_lang_sense_clarification": "visit someone's house informally"
                            },
                            {
                                "target_lang_word": "drop by",
                                "target_lang_sense_clarification": "visit briefly and informally"
                            },
                            {
                                "target_lang_word": "show up",
                                "target_lang_sense_clarification": "appear at an event or location"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dedf8e1-72ec-3622-ba99-f4714649adff",
                    "sense_definition": "rechtstreeks in de richting van iets of iemand bewegen, vaak op een dreigende manier",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zag de boze hond met hoge snelheid op me <w>afkomen</w>.",
                            "target_lang_translations": {
                                "en": "I saw the angry dog <w>coming at</w> me at high speed."
                            }
                        },
                        {
                            "text": "De fietser lette niet op en <w>kwam</w> recht op de geparkeerde auto <w>af</w>.",
                            "target_lang_translations": {
                                "en": "The cyclist wasn't paying attention and <w>headed</w> straight for the parked car."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op iemand afkomen",
                        "recht op je afkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move directly towards something or someone, often in a threatening way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come at",
                                "target_lang_sense_clarification": "approach in a threatening manner"
                            },
                            {
                                "target_lang_word": "head for",
                                "target_lang_sense_clarification": "move directly towards a target"
                            },
                            {
                                "target_lang_word": "approach",
                                "target_lang_sense_clarification": "move closer to someone or something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32e8a3e2-a181-3d0a-9f3b-9d4fb63e8ea4",
                    "sense_definition": "bevrijd worden van iets vervelends of ongewensts",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verlossing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is erg lastig om van deze hardnekkige verkoudheid <w>af</w> te <w>komen</w>.",
                            "target_lang_translations": {
                                "en": "It is very difficult to <w>get rid of</w> this persistent cold."
                            }
                        },
                        {
                            "text": "Hij wil zo snel mogelijk van zijn oude schulden <w>afkomen</w>.",
                            "target_lang_translations": {
                                "en": "He wants to <w>get rid of</w> his old debts as quickly as possible."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwijt raken",
                        "af zijn van",
                        "wegdoen"
                    ],
                    "common_phrases": [
                        "van je schulden afkomen",
                        "van een probleem afkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to be freed from something annoying or unwanted"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get rid of",
                                "target_lang_sense_clarification": "to free oneself from something unwanted"
                            },
                            {
                                "target_lang_word": "shake off",
                                "target_lang_sense_clarification": "to get rid of something like an illness or habit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dee18336-b11d-3166-a6b4-664394587dbf",
                    "sense_definition": "ergens uit voortvloeien of de oorsprong ergens hebben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oorsprong",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel Nederlandse woorden <w>komen</w> oorspronkelijk van het Frans <w>af</w>.",
                            "target_lang_translations": {
                                "en": "Many Dutch words originally <w>come from</w> French."
                            }
                        },
                        {
                            "text": "Die vreemde gewoonte <w>komt</w> waarschijnlijk van zijn grootvader <w>af</w>.",
                            "target_lang_translations": {
                                "en": "That strange habit probably <w>stems from</w> his grandfather."
                            }
                        }
                    ],
                    "common_phrases": [
                        "van de familie afkomen",
                        "ergens van afkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to stem from or have its origin in something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come from",
                                "target_lang_sense_clarification": "have as an origin"
                            },
                            {
                                "target_lang_word": "derive from",
                                "target_lang_sense_clarification": "have a specified beginning or source"
                            },
                            {
                                "target_lang_word": "stem from",
                                "target_lang_sense_clarification": "originate in something"
                            }
                        ]
