            {
                "entry_id": "db808ba4-2623-39e9-a39c-6012af0a063b",
                "word": "NOP",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a5c0f163-ce10-3c97-a16e-18cba231a870",
                        "entry_id": "db808ba4-2623-39e9-a39c-6012af0a063b",
                        "glosses": [
                            "Instruction commune de langage d’assemblage n’ayant aucun effet excepté l’exécution de l’instruction elle-même, utilisée pour attendre quelques cycles ou pour ajuster le pipeline de processeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4d29b58-2412-453b-a7fc-52097a56ff31",
                                "sense_id": "a5c0f163-ce10-3c97-a16e-18cba231a870",
                                "text": "La constante 0 équivaut à un NOP (on saute à l’instruction suivante) et la constante −1 fait reboucler sur le saut lui-même (boucle sans fin)."
                            },
                            {
                                "example_id": "1d287c21-d584-480c-b27e-a6401a63dc52",
                                "sense_id": "a5c0f163-ce10-3c97-a16e-18cba231a870",
                                "text": "Il existe par exemple l’option FTRACE, qui active une trace sur toutes les fonctions du noyau, en utilisant une fonctionnalité du compilateur pour insérer une zone de NOP (instruction sans opération) sur cinq octets à chaque début de fonction (absolument négligeable en termes d’occupation mémoire et d’overhead CPU)."
                            }
                        ]
                    }
                ],
