                                            {
                                                "example_id": "928eb4d6-95c4-42dc-9e1c-7d547c969cca",
                                                "sense_id": "72ef6931-2b95-36f3-b690-f0c761071088",
                                                "text": "He does woodwork as a hobby."
                                            },
                                            {
                                                "example_id": "a6d144ac-71d5-47ed-b05b-c5403817f6f2",
                                                "sense_id": "72ef6931-2b95-36f3-b690-f0c761071088",
                                                "text": "The unthinking man assumes that if woodwork is to be taught, the best person to do it must be a carpenter"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ee70ab2-4226-3e3a-b07d-0f53a2b9a99c",
                                        "entry_id": "9963ed83-2f57-34c1-a604-8d90a991ae26",
                                        "glosses": [
                                            "A place of concealment or obscurity."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be699631-9110-4224-a4a8-b1a4c9274f25",
                                                "sense_id": "9ee70ab2-4226-3e3a-b07d-0f53a2b9a99c",
                                                "text": "out of the woodwork"
                                            },
                                            {
                                                "example_id": "18a80e08-c8e0-45cf-8dc5-5776743d78aa",
                                                "sense_id": "9ee70ab2-4226-3e3a-b07d-0f53a2b9a99c",
                                                "text": "Friends and relatives were coming out of the woodwork to celebrate his good fortune."
                                            },
                                            {
                                                "example_id": "05074270-494e-4f30-a6f3-2db99407ef37",
                                                "sense_id": "9ee70ab2-4226-3e3a-b07d-0f53a2b9a99c",
                                                "text": "So when he wants to, he can just kind of blend into the woodwork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86fa563a-2661-30bb-a000-047265024f6a",
                                        "entry_id": "9963ed83-2f57-34c1-a604-8d90a991ae26",
                                        "glosses": [
                                            "The frame of the goal, i.e. the goalpost or crossbar."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd295dd2-ddaf-4f7d-846d-2b6ef460df5a",
                                                "sense_id": "86fa563a-2661-30bb-a000-047265024f6a",
                                                "text": "That goal was so close, it went in off the woodwork."
                                            },
                                            {
                                                "example_id": "d7dc391f-0a09-4984-af22-08379ae314a6",
                                                "sense_id": "86fa563a-2661-30bb-a000-047265024f6a",
                                                "text": "Carroll thought he had equalised with his header against the bar with eight minutes left. Liverpool claimed the ball had cross the line and Chelsea were grateful for a miraculous intervention from Cech to turn his effort on to the woodwork."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "woodwork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dec1855b-2232-376b-b4bb-90c2e622ef27",
                                        "entry_id": "1d39088e-c9ef-321b-8fb1-5c5d6a206f32",
                                        "glosses": [
                                            "To go completely stealth as a transgender person. (From the idea of fading or blending into the woodwork.)"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df0edb02-bba8-4c29-8870-edf92a5d3082",
                                                "sense_id": "dec1855b-2232-376b-b4bb-90c2e622ef27",
                                                "text": "\"Instead of 'woodworking,' or disappearing into the mainstream — as we are capable of and qualified to do — we have chosen not to do so.\" Outside of the transsexual community, other changes were taking place that made it possible for[…]"
                                            },
                                            {
                                                "example_id": "f967511f-f109-4171-9a28-1c08c6ebe18e",
                                                "sense_id": "dec1855b-2232-376b-b4bb-90c2e622ef27",
                                                "text": "Maybe — and this was essential for political activism — you didn't have to \"woodwork\" but could be transgendered for all to see. By the mid '90s the Internet had arrived — and spread these new ideas like wildfire.[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
