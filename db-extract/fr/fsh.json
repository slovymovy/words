                        "glosses": [
                            "Hormone folliculostimulante, hormone peptidique (glycoprotéine) produite par l'antéhypophyse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9f4363-00fd-4444-85a2-82ac41b0ff0a",
                                "sense_id": "9668315a-a821-3ad0-a457-ebc675df29b7",
                                "text": "La stimulation de l’ovulation par injection d’hormone (la FSH) en cas d’infertilité féminine due à un trouble de l’ovulation."
                            },
                            {
                                "example_id": "2f7879d0-91a7-4dcf-8636-ec40240b85b6",
                                "sense_id": "9668315a-a821-3ad0-a457-ebc675df29b7",
                                "text": "La sécrétion de la GnRH et donc de la LH, et à un moindre degré, de la FSH, est pulsatile."
                            },
                            {
                                "example_id": "d82947e8-21aa-4666-b810-517d39264cba",
                                "sense_id": "9668315a-a821-3ad0-a457-ebc675df29b7",
                                "text": "Il s’agit de la LH (hormone lutéinisante) et de la FSH (hormone folliculostimulante), qui sont à l’origine de la régulation des œstrogènes et de la progestérone."
                            }
                        ]
