                        {
                            "text": "С каждым шагом берег становился всё <w>дальше</w>.",
                            "target_lang_translations": {
                                "en": "With every step, the shore became <w>further</w> away.",
                                "zh": "每走一步，岸边就变得更<w>远</w>了。"
                            }
                        }
                    ],
                    "antonyms": [
