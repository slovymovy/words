                                        "entry_id": "ef1fa610-6069-3af7-9bb6-4e09f7676a40",
                                        "glosses": [
                                            "förmlich, unter (gewissenhafter) Beachtung der Form, der (äußeren) Form nach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3d07a16-a799-4fb4-b1b4-ba1424e149d1",
                                                "sense_id": "f09d20c5-20de-3fc5-bb11-5332fdfc1266",
                                                "text": "Meinen Frack trage ich nur zu formellen Anlässen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d3f91bd-5b44-437f-9b0f-08a7d08a2216",
                        "source_entry_id": "32dcbf96-c6cb-3d02-bc3d-f0d4c867fe3a",
