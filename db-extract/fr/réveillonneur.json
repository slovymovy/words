                            {
                                "example_id": "33906aa9-0b39-4de0-880c-dbe554af3e3e",
                                "sense_id": "761270b6-c61e-3477-b4d4-397e8c262173",
                                "text": "Pas un ces réveillonneurs du temps passé n’avait voulu venir chez M. Pilois. Ils étaient tous restés dans le clocher de Saint-Germain."
                            },
                            {
                                "example_id": "c33a3542-a7dc-43a0-b06f-0b95b9d0b478",
                                "sense_id": "761270b6-c61e-3477-b4d4-397e8c262173",
                                "text": "Mais ce jour-là, l’euphorie est d’autant plus grande que la victoire est au rendez-vous et que Tatischeff se surpasse en utilisant un assortiment de cotillons usagés pour singer le retour chez lui d’un réveillonneur passablement saoul."
                            }
                        ]
                    }
