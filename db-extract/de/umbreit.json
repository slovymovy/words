                ],
                "senses": [
                    {
                        "sense_id": "91f6a95e-7ddc-3cc4-b063-2a24e9a913d0",
                        "entry_id": "3c85655c-cf8f-3ff4-94ba-6b34356995b3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec564387-bd2b-4993-b1d4-10a579194c0f",
                                "sense_id": "91f6a95e-7ddc-3cc4-b063-2a24e9a913d0",
                                "text": "Umbreits kamen, sahen und siegten."
                            },
                            {
                                "example_id": "82bac494-04be-47d2-b344-7a83429e153e",
                                "sense_id": "91f6a95e-7ddc-3cc4-b063-2a24e9a913d0",
                                "text": "Frau Umbreit ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f811c0cc-4a0a-4052-b91a-2c62c2442de3",
                                "sense_id": "91f6a95e-7ddc-3cc4-b063-2a24e9a913d0",
                                "text": "Herr Umbreit wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a90d0ccd-fa5c-4e1d-bfd1-1afb2584825f",
                                "sense_id": "91f6a95e-7ddc-3cc4-b063-2a24e9a913d0",
                                "text": "Die Umbreits fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d4493aea-2d2c-43f7-a3da-ade2b25934d4",
                                "sense_id": "91f6a95e-7ddc-3cc4-b063-2a24e9a913d0",
                                "text": "Der Umbreit trägt nie die Schals, die die Umbreit ihm strickt."
                            },
                            {
                                "example_id": "d4477c37-ae5c-45be-93ff-286bdda8e1ed",
                                "sense_id": "91f6a95e-7ddc-3cc4-b063-2a24e9a913d0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Umbreit kommt, geht der Herr Umbreit.“"
                            },
                            {
                                "example_id": "f99752cf-2156-4fe9-ba8f-59f1b6d00732",
                                "sense_id": "91f6a95e-7ddc-3cc4-b063-2a24e9a913d0",
                                "text": "Umbreit kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
