                "senses": [
                    {
                        "sense_id": "fade19c3-9673-3774-ab04-b3af77c806d9",
                        "entry_id": "f1111eac-9c0d-39d8-b87a-af2a9ea1ca5e",
                        "glosses": [
                            "ehemaliges Dorf am Fluss Swist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2636617-2ebc-47bb-a4d9-fd372b765e8a",
                                "sense_id": "fade19c3-9673-3774-ab04-b3af77c806d9",
                                "text": "Das Dorf Swist, gelegen auf dem Swisterberg, brannte am 7. Februar 1757 ab und die Bewohner bauten im Tal, unterhalb des verbliebenen Swister Turm, das Weilerswist, so wie wir es heute kennen, weiter mit auf."
                            },
                            {
                                "example_id": "5d45fc5b-c137-4756-8544-11c26763d60e",
                                "sense_id": "fade19c3-9673-3774-ab04-b3af77c806d9",
                                "text": "„Der Swister Turm auf dem Swister Berg ist der Turm einer ehemaligen Pfarr- und Wallfahrtskirche des Dorfes Swist oder Niederswist.“"
                            },
                            {
                                "example_id": "10defa32-3467-4da9-83cd-23c197cfe140",
                                "sense_id": "fade19c3-9673-3774-ab04-b3af77c806d9",
                                "text": "„Der Swister Turm, erbaut in den Jahren 1100 – 1125, ist der Überrest der alten Pfarr- und Wallfahrtskirche des ehemaligen Dorfes Swist am Swisterberg in Weilerswist.“"
                            },
                            {
                                "example_id": "8f19166f-9560-4183-89b1-90b298c9efec",
                                "sense_id": "fade19c3-9673-3774-ab04-b3af77c806d9",
                                "text": "„Der Swister Turm ist ein Überrest der alten Pfarr-und Wallfahrtskirche des untergegangenen Dorfes Swist auf dem Swisterberg (erbaut ca. 1100-1125).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
