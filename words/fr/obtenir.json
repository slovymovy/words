                {
                    "sense_id": "9393ef78-ee16-378e-82ac-629de9843d00",
                    "sense_definition": "Parvenir à faire prononcer ou accorder par la justice ce que l'on réclame légalement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a plaidé la cause pour <w>obtenir</w> un jugement favorable devant le tribunal.",
                            "target_lang_translations": {
                                "en": "The lawyer argued the case to <w>win</w> a favorable judgment in court.",
                                "ru": "Адвокат защищал дело, чтобы <w>добиться</w> благоприятного решения суда.",
                                "nl": "De advocaat pleitte de zaak om voor de rechtbank een gunstig vonnis <w>te verkrijgen</w>.",
                                "de": "Der Anwalt hat den Fall vertreten, um vor Gericht ein günstiges Urteil <w>zu erstreiten</w>.",
                                "pl": "Adwokat bronił sprawy, aby przed sądem <w>uzyskać</w> korzystny wyrok.",
                                "it": "L'avvocato ha discusso la causa per <w>ottenere</w> una sentenza favorevole davanti al tribunale.",
                                "cs": "Advokát případ obhajoval, aby u soudu <w>získal</w> příznivý rozsudek.",
                                "tr": "Avukat, mahkemeden lehine bir karar <w>almak</w> için davayı savundu.",
                                "es": "El abogado defendió el caso para <w>obtener</w> un fallo favorable en el tribunal.",
                                "zh": "律师为在法庭上<w>胜诉</w>而据理力争。"
                            }
                        },
                        {
                            "text": "La victime espère <w>obtenir</w> réparation pour les préjudices subis durant l'incident.",
                            "target_lang_translations": {
                                "en": "The victim hopes to <w>secure</w> compensation for the harm suffered during the incident.",
                                "ru": "Пострадавший надеется <w>получить</w> компенсацию за ущерб, понесённый во время инцидента.",
                                "nl": "Het slachtoffer hoopt schadevergoeding <w>te verkrijgen</w> voor de schade die tijdens het incident is geleden.",
                                "de": "Das Opfer hofft, für die beim Vorfall erlittenen Schäden <w>Schadenersatz zu erhalten</w>.",
                                "pl": "Poszkodowany ma nadzieję <w>uzyskać</w> odszkodowanie za szkody poniesione podczas incydentu.",
                                "it": "La vittima spera di <w>ottenere</w> un risarcimento per i danni subiti durante l'incidente.",
                                "cs": "Oběť doufá, že si <w>vysoudí</w> odškodnění za újmu způsobenou při incidentu.",
                                "tr": "Mağdur, olay sırasında uğradığı zararlar için tazminat <w>elde etmeyi</w> umuyor.",
                                "es": "La víctima espera <w>conseguir</w> una indemnización por los daños sufridos durante el incidente.",
                                "zh": "受害者希望为事件中所受的损失<w>争取</w>赔偿。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "obtenir un jugement",
                        "obtenir réparation",
                        "obtenir gain de cause"
                    ],
                    "target_lang_definitions": {
                        "en": "To succeed in having a court grant or confirm what one legally claims.",
                        "ru": "Добиться через суд признания или удовлетворения законного требования.",
                        "nl": "Er door een rechter in slagen dat een wettelijke eis wordt toegekend of bevestigd.",
                        "de": "Durch ein Gericht erreichen, dass eine rechtlich beanspruchte Forderung zugesprochen oder bestätigt wird.",
                        "pl": "Doprowadzenie do tego, że sąd przyzna lub potwierdzi to, czego ktoś domaga się prawnie.",
                        "it": "Riuscire a far riconoscere o concedere dal tribunale ciò che si rivendica per legge.",
                        "cs": "Dosáhnout toho, aby soud přiznal nebo potvrdil to, co se člověk oprávněně domáhá.",
                        "tr": "Mahkemeye başvurarak yasal olarak talep edilen bir hakkın kabul edilmesine ya da onaylanmasına karar verdirmek.",
                        "es": "Lograr, mediante un procedimiento judicial, que el tribunal conceda o confirme lo que se reclama legalmente.",
                        "zh": "通过诉讼，使法院判决或确认自己依法请求的权利。"
                    },
