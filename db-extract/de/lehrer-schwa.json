                "senses": [
                    {
                        "sense_id": "9d63e622-eed2-31c2-a0d8-625475264ddf",
                        "entry_id": "d0e42c0e-aac4-3c9f-9072-89137e9159b7",
                        "glosses": [
                            "Vokal, der zwischen einem [a] und einem [ə] (Schwa) liegt und im Deutschen nur unbetont vorkommt"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "0ef5b818-f523-46d5-b21b-bf5a051ddede",
                                "sense_id": "9d63e622-eed2-31c2-a0d8-625475264ddf",
                                "text": "„Sie würde allerdings als Vokal ‚a-Schwa‘ bzw. ‚Lehrer-Schwa‘ notiert.“"
                            },
                            {
                                "example_id": "1b883c6f-8804-449c-8ce4-ff096fcdb780",
                                "sense_id": "9d63e622-eed2-31c2-a0d8-625475264ddf",
                                "text": "„Bisher bekannt:"
                            },
                            {
                                "example_id": "ca4c5fb7-0e7e-40b8-8a96-68daead160a1",
                                "sense_id": "9d63e622-eed2-31c2-a0d8-625475264ddf",
                                "text": "„In postvokalischer Stellung im Silbenauslaut -er (›Lehrer-Schwa‹) und mit hoher Wahrscheinlichkeit nach Langvokal, dagegen nur eingeschränkt nach Kurzvokal.“"
                            },
                            {
                                "example_id": "1ba1d0a1-dd54-45e5-8082-c7ff4a8e1d55",
                                "sense_id": "9d63e622-eed2-31c2-a0d8-625475264ddf",
                                "text": "„Ausgewählt wurden vier Themen: […] der Lehrer-Schwa /ɐ/, der als [ə], [ɐ], [r] oder als ‚Zwischending‘ zwischen [ə] und [ɐ] gesprochen werden kann, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
