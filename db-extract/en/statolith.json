                        "glosses": [
                            "A specialized form of amyloplast involved in graviperception by plant roots and most invertebrates."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fba050e5-b435-4464-8dbe-ed3d734d554b",
                                "sense_id": "1d4c2a6a-132a-3776-82cf-747665f6784a",
                                "text": "The statolith is either acquired from the animal's surroundings or secreted by the epithelial cells of the statocyst."
                            },
                            {
                                "example_id": "394989d4-e419-4273-9861-02031247d73e",
                                "sense_id": "1d4c2a6a-132a-3776-82cf-747665f6784a",
                                "text": "When the squid (or other cephalopod) accelerates, the statolith is pressed back in its “seat” like a person in a car."
                            }
                        ]
                    }
