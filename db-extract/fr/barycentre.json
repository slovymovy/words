                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c2e31379-1cca-3d31-b97d-67eb774ee5e2",
                        "entry_id": "88c5762a-4744-3267-a91b-39ffe12386e1",
                        "glosses": [
                            "Centre de gravité."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d0d5d484-0a22-4382-bf59-fe01aef53458",
                                "sense_id": "c2e31379-1cca-3d31-b97d-67eb774ee5e2",
                                "text": "Les géomètres-experts de la Marne ont mesuré le centre de gravité, ou barycentre, du Champagne marnais."
                            }
                        ]
                    },
                    {
                        "sense_id": "12f26ab9-5b01-3142-bd68-cc203a2846be",
                        "entry_id": "88c5762a-4744-3267-a91b-39ffe12386e1",
                        "glosses": [
                            "Notion de moyenne (ou espérance)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f3acfb61-b00c-3d1f-a69b-2363986eb8f0",
                        "entry_id": "88c5762a-4744-3267-a91b-39ffe12386e1",
                        "glosses": [
                            "Notion de centre d’inertie (ou de centre de masse ou de centre de gravité)."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b89c199b-41ab-32d1-bd9c-c663bac31b28",
                        "entry_id": "88c5762a-4744-3267-a91b-39ffe12386e1",
                        "glosses": [
                            "Notion de moment (moment d’inertie, moment cinétique)."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9d6dcd9a-5ef3-3d0e-a295-b6c4778337e7",
                        "entry_id": "88c5762a-4744-3267-a91b-39ffe12386e1",
                        "glosses": [
                            "Centre de masse d’une molécule, utilisé pour décrire ses mouvements globaux sans tenir compte des mouvements internes des atomes ou des électrons."
                        ],
                        "tags": [
                            "Physique moléculaire"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cdd0cf6e-e77f-3a9a-b580-1ecc7ad3bf12",
                        "entry_id": "88c5762a-4744-3267-a91b-39ffe12386e1",
                        "glosses": [
                            "Noyau, milieu, partie centrale."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "63c71ea8-8b72-4cd8-b7d0-5e9b38277b77",
                                "sense_id": "cdd0cf6e-e77f-3a9a-b580-1ecc7ad3bf12",
                                "text": "Au total, le barycentre de cet ensemble paraît se situer un peu plus à gauche que celui de Benjamin Griveaux."
                            }
                        ]
                    }
                ],
