                    {
                        "sense_id": "0f854c75-cb52-31ec-ab60-3bd7b7b92885",
                        "entry_id": "d3125b6b-09d3-3b0d-8474-aa33b790ea80",
                        "glosses": [
                            "Phénoménologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a95fb7c9-f333-4859-80eb-880ea812668f",
                                "sense_id": "0f854c75-cb52-31ec-ab60-3bd7b7b92885",
                                "text": "Phenomenological \"things\" are not commonsense objects or sense data but the phenomena in their presentation, grasped as intentional objects. – Maurice Natanson, \"The Schism between Theory and Ardent Empiricism,\" Philosophy and Phenomenological Research, 1956, vol. 17, no. 2 (Dec), p. 244."
                            },
                            {
                                "example_id": "fee91191-05de-496e-97de-f753f1b4f688",
                                "sense_id": "0f854c75-cb52-31ec-ab60-3bd7b7b92885",
                                "text": "I call my models \"mechanistic\" to distinguish them from classical models that are more phenomenological. – David Tilman, \"Phenomenology From the Natural Standpoint: A Reply to Van Meter Ames,\" The American Naturalist, 1991, vol. 138, no. 5 (Nov), p. 1284."
                            }
                        ]
                    }
