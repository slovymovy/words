                                                "sense_id": "f49a49d5-7977-36ec-aa04-095e5cd88642",
                                                "text": "The man became the leader of the group as a default."
                                            },
                                            {
                                                "example_id": "7e163601-4bf1-4999-8b37-eb63c02083a2",
                                                "sense_id": "f49a49d5-7977-36ec-aa04-095e5cd88642",
                                                "text": "One of the darlings of the early vegetarian movement (particularly in its even sadder form, the cutlet), it was on the menu at John Harvey Kellogg's Battle Creek Sanitarium [sic], and has since become the default Sunday option for vegetarians – and a default source of derision for everyone else."
                                            },
                                            {
                                                "example_id": "3d00819b-1e4d-4359-af23-852e554c80d3",
                                                "sense_id": "f49a49d5-7977-36ec-aa04-095e5cd88642",
                                                "text": "Overall the signage at NIE has the appearance being a top-down artefact driven by institutional policy with English set as the default language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30e611b1-e942-3d8e-9a76-0822d969ebf9",
                                        "entry_id": "1bb9c168-3f78-3f94-81a2-f525d6003052",
                                        "glosses": [
                                            "A value used when none has been given; a tentative value or standard that is presumed."
                                        ],
