            "senses": [
                {
                    "sense_id": "4d0c9844-40fb-3095-9b34-28a177dfa942",
                    "sense_definition": "geneigd om zich gemakkelijk aan te passen of toe te geven aan de wensen van anderen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij stelde zich heel <w>meegaand</w> op tijdens de moeilijke onderhandelingen.",
                            "target_lang_translations": {
                                "en": "He took a very <w>accommodating</w> approach during the difficult negotiations."
                            }
                        },
                        {
                            "text": "Zij is een <w>meegaand</w> persoon en vermijdt ruzies het liefst.",
                            "target_lang_translations": {
                                "en": "She is an <w>easygoing</w> person and prefers to avoid arguments."
                            }
                        }
                    ],
                    "synonyms": [
                        "inschikkelijk",
                        "toegevend"
                    ],
                    "antonyms": [
                        "koppig",
                        "dwars"
                    ],
                    "common_phrases": [
                        "meegaand karakter",
                        "zich meegaand opstellen"
                    ],
                    "target_lang_definitions": {
