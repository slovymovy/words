{
    "word_family": [
        "reside",
        "residence",
        "residential",
        "residency"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d7ea48e8-e0e1-3dfb-b205-3b84659efdc8",
                    "sense_definition": "A person who lives in a particular place or specific area.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dweller_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>residents</w> of the apartment block share a communal garden.",
                            "target_lang_translations": {
                                "ru": "<w>Жители</w> многоквартирного дома пользуются общим садом.",
                                "tr": "Apartman <w>sakinleri</w> ortak bir bahçeyi paylaşıyor.",
                                "zh": "这栋公寓楼的<w>居民</w>共用一个公共花园。"
                            }
                        },
                        {
                            "text": "She has been a <w>resident</w> of this town for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Она является <w>жительницей</w> этого города уже более двадцати лет.",
                                "tr": "Yirmi yılı aşkın süredir bu kasabanın <w>sakinidir</w>.",
                                "zh": "她已经是这个城镇的<w>居民</w>二十多年了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inhabitant",
                        "dweller",
                        "occupant",
                        "local",
                        "citizen"
                    ],
                    "antonyms": [
                        "visitor",
                        "tourist",
                        "guest",
                        "outsider"
                    ],
                    "common_phrases": [
                        "local resident",
                        "city resident",
                        "community resident"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который живет в определенном месте или районе.",
                        "tr": "Belirli bir yerde veya bölgede yaşayan kişi.",
                        "zh": "居住在特定地点或区域的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "житель",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "местный житель",
                                "target_lang_sense_clarification": "человек из данной местности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sakin",
                                "target_lang_sense_clarification": "bir yerde oturan kişi"
                            },
                            {
                                "target_lang_word": "yerli",
                                "target_lang_sense_clarification": "o bölgede ikamet eden kişi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "居民",
                                "target_lang_sense_clarification": "居住在某地的人"
                            },
                            {
                                "target_lang_word": "住户",
                                "target_lang_sense_clarification": "居住在某处的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7e45ad3-cab7-350a-9a80-171a15a644e9",
                    "sense_definition": "A person who has the legal right to live permanently in a country but is not necessarily a citizen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dweller_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must be a legal <w>resident</w> to apply for a driver's license here.",
                            "target_lang_translations": {
                                "ru": "Вы должны быть законным <w>резидентом</w> (постоянным жителем), чтобы подать заявление на получение водительских прав здесь.",
                                "tr": "Burada ehliyet başvurusunda bulunmak için yasal bir <w>yerleşik</w> olmalısınız.",
                                "zh": "你必须是合法的<w>居民</w>才能在这里申请驾照。"
                            }
                        },
                        {
                            "text": "My neighbor is a permanent <w>resident</w> of the United States.",
                            "target_lang_translations": {
                                "ru": "Мой сосед — постоянный <w>житель</w> Соединенных Штатов.",
                                "tr": "Komşum Amerika Birleşik Devletleri'nin daimî <w>yerleşiğidir</w>.",
                                "zh": "我的邻居是美国的<w>永久居民</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "permanent resident",
                        "legal resident",
                        "resident alien"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, имеющий законное право постоянно проживать в стране, но не обязательно являющийся ее гражданином.",
                        "tr": "Bir ülkede sürekli yaşama yasal hakkı olan ancak mutlaka vatandaş olması gerekmeyen kişi.",
                        "zh": "拥有在某国长期居住的合法权利，但不一定是该国公民的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резидент",
                                "target_lang_sense_clarification": "юридический или налоговый статус"
                            },
                            {
                                "target_lang_word": "постоянный житель",
                                "target_lang_sense_clarification": "иммиграционный статус"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yerleşik",
                                "target_lang_sense_clarification": "oturan/ikamet eden kişi"
                            },
                            {
                                "target_lang_word": "oturan",
                                "target_lang_sense_clarification": "yasal ikameti olan kişi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "永久居民",
                                "target_lang_sense_clarification": "拥有长期居留权的身份"
                            },
                            {
                                "target_lang_word": "定居者",
                                "target_lang_sense_clarification": "在某地长期定居的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a23bede-ee7c-3b1d-8a20-8d1b6285525f",
                    "sense_definition": "A doctor who is receiving specialized training at a hospital after graduating from medical school.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>resident</w> checked the patient's vital signs every hour.",
                            "target_lang_translations": {
                                "ru": "<w>Ординатор</w> проверял жизненные показатели пациента каждый час.",
                                "tr": "<w>Asistan doktor</w> hastanın yaşam bulgularını her saat başı kontrol etti.",
                                "zh": "<w>住院医师</w>每小时检查一次病人的生命体征。"
                            }
                        },
                        {
                            "text": "He worked long hours as a surgical <w>resident</w> at the city hospital.",
                            "target_lang_translations": {
                                "ru": "Он работал долгие часы как хирургический <w>ординатор</w> в городской больнице.",
                                "tr": "Şehir hastanesinde cerrahi <w>asistanı</w> olarak uzun saatler çalıştı.",
                                "zh": "他在市医院担任外科<w>住院医师</w>，工作时间很长。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "medical resident",
                        "surgical resident",
                        "chief resident"
                    ],
                    "target_lang_definitions": {
                        "ru": "Врач, проходящий специализированную подготовку в больнице после окончания медицинского института.",
                        "tr": "Tıp fakültesinden mezun olduktan sonra hastanede uzmanlık eğitimi alan doktor.",
                        "zh": "医学院毕业后在医院接受专业培训的医生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ординатор",
                                "target_lang_sense_clarification": "врач-стажер"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "asistan doktor",
                                "target_lang_sense_clarification": "uzmanlık eğitimi alan doktor"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "住院医师",
                                "target_lang_sense_clarification": "正在接受专科培训的医生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07712543-63f0-301e-825c-829e980455c4",
                    "sense_definition": "A bird or animal that stays in the same area all year round and does not migrate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cardinal is a common <w>resident</w> in our garden throughout the winter.",
                            "target_lang_translations": {
                                "ru": "Кардинал — обычный <w>оседлый обитатель</w> нашего сада в течение всей зимы.",
                                "tr": "Kardinal kuşu, kış boyunca bahçemizin yaygın bir <w>yerleşik türüdür</w>.",
                                "zh": "红雀是整个冬天我们花园里常见的<w>留鸟</w>。"
                            }
                        },
                        {
                            "text": "Unlike migratory species, this bird is a permanent <w>resident</w> of the forest.",
                            "target_lang_translations": {
                                "ru": "В отличие от перелетных видов, эта птица — постоянный <w>обитатель</w> леса.",
                                "tr": "Göçücü türlerin aksine, bu kuş ormanın kalıcı bir <w>sakinidir</w>.",
                                "zh": "与候鸟不同，这种鸟是森林里的<w>定居者</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "migrant"
                    ],
                    "common_phrases": [
                        "summer resident",
                        "winter resident"
                    ],
                    "target_lang_definitions": {
                        "ru": "Птица или животное, которое остается в одной и той же местности круглый год и не мигрирует.",
                        "tr": "Tüm yıl boyunca aynı bölgede kalan ve göç etmeyen kuş veya hayvan.",
                        "zh": "全年留在同一地区而不迁徙的鸟类或动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оседлый вид",
                                "target_lang_sense_clarification": "биологический термин"
                            },
                            {
                                "target_lang_word": "постоянный обитатель",
                                "target_lang_sense_clarification": "общее описание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yerleşik tür",
                                "target_lang_sense_clarification": "göç etmeyen canlı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "留鸟",
                                "target_lang_sense_clarification": "不迁徙的鸟类"
                            },
                            {
                                "target_lang_word": "定居动物",
                                "target_lang_sense_clarification": "不迁徙的动物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "df4a60ac-59be-3d70-95c0-106e27e96b1f",
                    "sense_definition": "Living or staying in a place for a long period.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is currently <w>resident</w> in Spain for tax purposes.",
                            "target_lang_translations": {
                                "ru": "В настоящее время он <w>проживает</w> в Испании в целях налогообложения.",
                                "tr": "Vergi amaçlarıyla şu anda İspanya'da <w>ikamet etmektedir</w>.",
                                "zh": "出于税务目的，他目前<w>居住</w>在西班牙。"
                            }
                        },
                        {
                            "text": "The species is <w>resident</w> in the tropical rainforests of Brazil.",
                            "target_lang_translations": {
                                "ru": "Этот вид <w>обитает</w> в тропических лесах Бразилии.",
                                "tr": "Bu tür Brezilya'nın tropikal yağmur ormanlarında <w>yaşamaktadır</w>.",
                                "zh": "该物种<w>栖息</w>在巴西的热带雨林中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "living",
                        "dwelling",
                        "inhabiting"
                    ],
                    "antonyms": [
                        "non-resident"
                    ],
                    "common_phrases": [
                        "resident in",
                        "resident population"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проживающий или находящийся в каком-либо месте в течение длительного периода.",
                        "tr": "Bir yerde uzun süre yaşayan veya ikamet eden.",
                        "zh": "在某地长期居住或停留。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проживающий",
                                "target_lang_sense_clarification": "о людях"
                            },
                            {
                                "target_lang_word": "обитающий",
                                "target_lang_sense_clarification": "о животных или видах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ikamet eden",
                                "target_lang_sense_clarification": "yaşayan kişi"
                            },
                            {
                                "target_lang_word": "yerleşik",
                                "target_lang_sense_clarification": "bir yerde oturan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "居住",
                                "target_lang_sense_clarification": "指人长期生活在某地"
                            },
                            {
                                "target_lang_word": "栖息",
                                "target_lang_sense_clarification": "指动物在某地生活"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80518c61-ec19-38f4-880e-5f34b10074f2",
                    "sense_definition": "Employed by an organization to work at its premises, often having a specific skill or role.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is the magazine's <w>resident</w> expert on gardening.",
                            "target_lang_translations": {
                                "ru": "Она — <w>штатный</w> эксперт журнала по садоводству.",
                                "tr": "O, derginin bahçıvanlık konusundaki <w>kadrolu</w> uzmanıdır.",
                                "zh": "她是该杂志<w>驻场</w>的园艺专家。"
                            }
                        },
                        {
                            "text": "The hotel has a <w>resident</w> pianist who plays in the lobby every night.",
                            "target_lang_translations": {
                                "ru": "В отеле есть <w>штатный</w> пианист, который играет в холле каждый вечер.",
                                "tr": "Otelin her gece lobide çalan <w>yerleşik</w> bir piyanisti var.",
                                "zh": "酒店有一位<w>驻场</w>钢琴师，每晚在大堂演奏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "in-house"
                    ],
                    "common_phrases": [
                        "resident expert",
                        "resident artist",
                        "resident DJ"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нанятый организацией для работы в ее помещении, часто обладающий определенным навыком или ролью.",
                        "tr": "Bir kurum tarafından bünyesinde çalıştırılan, belirli bir uzmanlığı veya rolü olan.",
                        "zh": "受雇于某机构并在其场所工作，通常具有特定技能或角色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штатный",
                                "target_lang_sense_clarification": "сотрудник в штате"
                            },
                            {
                                "target_lang_word": "постоянный",
                                "target_lang_sense_clarification": "регулярно работающий"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kadrolu",
                                "target_lang_sense_clarification": "kurumda yerleşik çalışan"
                            },
                            {
                                "target_lang_word": "yerleşik",
                                "target_lang_sense_clarification": "sürekli bulunan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "驻场",
                                "target_lang_sense_clarification": "在特定场所工作的"
                            },
                            {
                                "target_lang_word": "专职",
                                "target_lang_sense_clarification": "机构内部聘用的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2c6f6fc-f5b8-3b85-8373-2c75e247ea0d",
                    "sense_definition": "Kept in the computer's memory and available for immediate use.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The virus scanner stays <w>resident</w> in memory to protect the system.",
                            "target_lang_translations": {
                                "ru": "Антивирусный сканер остается <w>резидентным</w> в памяти для защиты системы.",
                                "tr": "Virüs tarayıcısı, sistemi korumak için bellekte <w>yerleşik</w> kalır.",
                                "zh": "病毒扫描程序<w>驻留</w>在内存中以保护系统。"
                            }
                        },
                        {
                            "text": "This program is <w>resident</w>, so it can be activated instantly with a hotkey.",
                            "target_lang_translations": {
                                "ru": "Эта программа <w>резидентная</w>, поэтому ее можно активировать мгновенно горячей клавишей.",
                                "tr": "Bu program <w>yerleşiktir</w>, dolayısıyla bir kısayol tuşuyla anında etkinleştirilebilir.",
                                "zh": "该程序是<w>驻留</w>程序，因此可以通过热键立即激活。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "memory resident"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хранящийся в памяти компьютера и доступный для немедленного использования.",
                        "tr": "Bilgisayar belleğinde tutulan ve anında kullanıma hazır olan.",
                        "zh": "保存在计算机内存中并可立即使用的程序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резидентный",
                                "target_lang_sense_clarification": "компьютерный термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yerleşik",
                                "target_lang_sense_clarification": "bellekte bulunan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "驻留",
                                "target_lang_sense_clarification": "计算机内存中常驻的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}