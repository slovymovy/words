                        "entry_id": "52b6c318-3b02-33fe-a330-b03d1a01cf8b",
                        "glosses": [
                            "wyposażone w długi kabel urządzenie zawierające jedno lub więcej gniazd elektrycznych, służące do przedłużania zasięgu między siecią elektryczną a czerpiącymi z niej urządzeniami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76066f34-1455-482c-b462-3257287abf25",
                                "sense_id": "65f08a7e-596f-3d33-aaac-8837c281d395",
                                "text": "Żaden zwykły przedłużacz nie ochroni nas przed możliwymi przepięciami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bbae163f-d179-3a5c-9bff-0a86d31cc1f6",
                        "entry_id": "52b6c318-3b02-33fe-a330-b03d1a01cf8b",
                        "glosses": [
                            "coś, co zwiększa zasięg lub trwałość czegoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a6d7be-fbe9-4659-a6ab-f56958641e20",
                                "sense_id": "bbae163f-d179-3a5c-9bff-0a86d31cc1f6",
                                "text": "Działają tak przede wszystkim dania typu fast food i produkty przetworzone przemysłowo, zawierające przedłużacze świeżości."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
