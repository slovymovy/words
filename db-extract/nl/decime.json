                                            {
                                                "example_id": "bdf6fb64-c729-4b09-a67c-a93ae48a2894",
                                                "sense_id": "dc6a821a-33aa-33f3-81b5-b97b557f5527",
                                                "text": "Le premier Français, Mehdi Frère, a terminé dixième, en 2h11’04”."
                                            },
                                            {
                                                "example_id": "6def5c0f-2b31-4bdd-b3e3-5721684a0665",
                                                "sense_id": "dc6a821a-33aa-33f3-81b5-b97b557f5527",
                                                "text": "Le Gouvernement a renouvelé pour la dixième fois, en 1865, le grand concours biennal de composition musicale, institué par l'arrêté royal du 19 septembre 1840."
                                            },
                                            {
                                                "example_id": "f8bca886-498a-4e52-9ac1-dbceae9fa826",
                                                "sense_id": "dc6a821a-33aa-33f3-81b5-b97b557f5527",
                                                "text": "Un reporter qui ne précise pas, c’est un géomètre qui néglige de pousser ses calculs jusqu’à la dixième décimale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7288f051-f238-3519-ac3c-f684f2e6ca11",
                                        "entry_id": "7404131a-eeca-3027-8b92-97b2c531e731",
                                        "glosses": [
                                            "(Lui dixième, elle dixième ou en dixième) Avec neuf autres."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3673a9c7-2646-41d2-a434-677ccdc09663",
                                                "sense_id": "7288f051-f238-3519-ac3c-f684f2e6ca11",
                                                "text": "Étant capitaine de grenadiers au régiment de Tournon, il entra, lui dixième, dans Coni, ville des États sardes, et, abattu sous trente-trois blessures, il fut fait prisonnier."
                                            }
                                        ]
                                    }
                                ]
                            },
