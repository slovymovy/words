                "senses": [
                    {
                        "sense_id": "51e6c631-0390-35d7-a4bd-ecba270e6fb0",
                        "entry_id": "083c7c05-8932-3093-bc61-b0e370bd0d60",
                        "glosses": [
                            "Aufhebung politischer oder geografischer Grenzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88bbacab-ec3a-4d53-be29-8f6c6f81d776",
                                "sense_id": "51e6c631-0390-35d7-a4bd-ecba270e6fb0",
                                "text": "Die Lösung nationaler Probleme liegt in der Entgrenzung. Wir müssen Themen wie die Umweltregenerierung global angehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e96ef151-49ea-327e-aaeb-43043a8a21cc",
                        "entry_id": "083c7c05-8932-3093-bc61-b0e370bd0d60",
                        "glosses": [
                            "das Übertreten oder Auflösen moralischer, geistiger, physischer oder Ähnlicher Beschränkungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec24872c-0301-4818-a1f0-0215a7cd4793",
                                "sense_id": "e96ef151-49ea-327e-aaeb-43043a8a21cc",
                                "text": "„Die Erfahrungen mit Paramilitarismus in der Weimarer Republik, aber auch die aktuellen Entgrenzungen kriegerischer Gewalt durch selbst ernannte Warlords zeigen, wie gefährlich die Aufkündigung des staatlichen Gewaltmonopols ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dc4c7183-3869-3fa4-9bdd-6020134bd1db",
                        "entry_id": "083c7c05-8932-3093-bc61-b0e370bd0d60",
                        "glosses": [
                            "„Auflösung von zeitlichen, räumlichen und sachlichen Strukturen der Erwerbsarbeit“"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d965c238-da84-4044-b343-05467445e0dc",
                                "sense_id": "dc4c7183-3869-3fa4-9bdd-6020134bd1db",
                                "text": "Die Entgrenzung der Arbeit vom Leben wird sehr deutlich, wenn wir das Arbeiten im Homeoffice anschauen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "76d5cea3-2dea-3a0e-9148-530e0c7a5eca",
                        "entry_id": "083c7c05-8932-3093-bc61-b0e370bd0d60",
                        "glosses": [
                            "Öffnung für Neues"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a78e73d8-d033-4d88-a370-f8c5208bdd2a",
                                "sense_id": "76d5cea3-2dea-3a0e-9148-530e0c7a5eca",
                                "text": "Die Entgrenzung des Ästhetischen bedeutet, dass es nicht nur im Museum anzutreffen ist, seine Auffindbarkeit muss überall in der Gesellschaft und Zivilisation gewährleistet sein."
