{
    "word_family": [
        "flickering",
        "flickery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "be8a24b7-f40c-3d22-b35f-5dd9499d8889",
                    "sense_definition": "To burn or shine unsteadily, or with a wavering light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candle began to <w>flicker</w> in the drafty room before finally going out.",
                            "target_lang_translations": {
                                "ru": "Свеча начала <w>мерцать</w> в комнате со сквозняками, прежде чем окончательно погаснуть."
                            }
                        },
                        {
                            "text": "We watched the campfire <w>flicker</w> in the dark woods.",
                            "target_lang_translations": {
                                "ru": "Мы смотрели, как костёр <w>мерцает</w> в тёмном лесу."
                            }
                        }
                    ],
                    "synonyms": [
                        "glimmer",
                        "waver",
                        "flutter"
                    ],
                    "common_phrases": [
                        "flicker in the dark",
                        "flicker and die"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гореть или светиться неровным, колеблющимся светом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерцать",
                                "target_lang_sense_clarification": "о свете, свече, пламени"
                            },
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "о пламени"
                            },
                            {
                                "target_lang_word": "тлеть",
                                "target_lang_sense_clarification": "слабо гореть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e65abe7a-b892-3cc8-99df-185e2e836730",
                    "sense_definition": "To appear and disappear for short moments; to keep going on and off.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A brief smile <w>flickered</w> across her face when she heard the good news.",
                            "target_lang_translations": {
                                "ru": "Мимолётная улыбка <w>мелькнула</w> на её лице, когда она услышала хорошие новости."
                            }
                        },
                        {
                            "text": "The old television screen started to <w>flicker</w> during the storm.",
                            "target_lang_translations": {
                                "ru": "Экран старого телевизора начал <w>мигать</w> во время грозы."
                            }
                        }
                    ],
                    "synonyms": [
                        "blink",
                        "flutter"
                    ],
                    "common_phrases": [
                        "flicker across the face"
                    ],
                    "target_lang_definitions": {
                        "ru": "Появляться и исчезать на короткие мгновения; то включаться, то выключаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мигать",
                                "target_lang_sense_clarification": "о свете, экране"
                            },
                            {
                                "target_lang_word": "мелькать",
                                "target_lang_sense_clarification": "о выражении лица, улыбке"
                            },
                            {
                                "target_lang_word": "промелькнуть",
                                "target_lang_sense_clarification": "быстро появиться и исчезнуть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "549f8cdf-d5ec-3513-bf80-fb167cbb7dae",
                    "sense_definition": "To flutter or flap.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small bird <w>flickered</w> its wings rapidly before taking off from the branch.",
                            "target_lang_translations": {
                                "ru": "Маленькая птичка быстро <w>затрепетала</w> крыльями, прежде чем взлететь с ветки."
                            }
                        },
                        {
                            "text": "The baby <w>flickered</w> his hands in excitement when he saw his mother.",
                            "target_lang_translations": {
                                "ru": "Малыш возбуждённо <w>замахал</w> ручками, когда увидел маму."
                            }
                        }
                    ],
                    "synonyms": [
                        "flutter",
                        "flap"
                    ],
                    "common_phrases": [
                        "flicker wings"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly used in older literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трепетать, порхать или быстро махать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трепетать",
                                "target_lang_sense_clarification": "о крыльях"
                            },
                            {
                                "target_lang_word": "порхать",
                                "target_lang_sense_clarification": "о птице, бабочке"
                            },
                            {
                                "target_lang_word": "махать",
                                "target_lang_sense_clarification": "быстро двигать руками или крыльями"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c27be8ab-e6d2-3274-80e2-71b9d93a2b5c",
                    "sense_definition": "An unsteady flash of light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light_phenomenon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>flicker</w> of a flashlight in the distance caught our attention.",
                            "target_lang_translations": {
                                "ru": "Внезапная <w>вспышка</w> фонарика вдали привлекла наше внимание."
                            }
                        },
                        {
                            "text": "We could see the faint <w>flicker</w> of a candle through the window.",
                            "target_lang_translations": {
                                "ru": "Сквозь окно мы видели слабое <w>мерцание</w> свечи."
                            }
                        }
                    ],
                    "synonyms": [
                        "glimmer",
                        "gleam",
                        "spark"
                    ],
                    "common_phrases": [
                        "flicker of light",
                        "flicker of a candle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неровная, колеблющаяся вспышка света."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерцание",
                                "target_lang_sense_clarification": "слабый колеблющийся свет"
                            },
                            {
                                "target_lang_word": "вспышка",
                                "target_lang_sense_clarification": "кратковременный свет"
                            },
                            {
                                "target_lang_word": "огонёк",
                                "target_lang_sense_clarification": "слабый источник света"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "664d3be2-0f15-3ebb-9dbf-6d4e3c74ce29",
                    "sense_definition": "A short, brief moment of a feeling or emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "brief_moment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the bad news, she felt a tiny <w>flicker</w> of hope inside her.",
                            "target_lang_translations": {
                                "ru": "Несмотря на плохие новости, она почувствовала слабый <w>проблеск</w> надежды внутри себя."
                            }
                        },
                        {
                            "text": "A sudden <w>flicker</w> of recognition showed in his eyes when he saw his old friend.",
                            "target_lang_translations": {
                                "ru": "Внезапная <w>искра</w> узнавания появилась в его глазах, когда он увидел старого друга."
                            }
                        }
                    ],
                    "synonyms": [
                        "glimmer",
                        "hint",
                        "spark"
                    ],
                    "common_phrases": [
                        "flicker of hope",
                        "flicker of recognition",
                        "flicker of interest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое, мимолётное проявление чувства или эмоции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблеск",
                                "target_lang_sense_clarification": "надежды, понимания"
                            },
                            {
                                "target_lang_word": "искра",
                                "target_lang_sense_clarification": "чувства, интереса"
                            },
                            {
                                "target_lang_word": "вспышка",
                                "target_lang_sense_clarification": "эмоции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b9b5326-9285-35e0-9563-370f60aa1e25",
                    "sense_definition": "Any of certain small woodpeckers, especially of the genus Colaptes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A northern <w>flicker</w> landed on the tree trunk to search for insects.",
                            "target_lang_translations": {
                                "ru": "Золотистый шилоклювый <w>дятел</w> сел на ствол дерева в поисках насекомых."
                            }
                        },
                        {
                            "text": "We identified the bird as a <w>flicker</w> by its distinctive spotted breast.",
                            "target_lang_translations": {
                                "ru": "Мы определили, что эта птица — <w>дятел</w>, по её характерной пятнистой грудке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "northern flicker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой дятел, особенно из рода Colaptes (шилоклювый дятел)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дятел",
                                "target_lang_sense_clarification": "птица семейства дятловых"
                            },
                            {
                                "target_lang_word": "шилоклювый дятел",
                                "target_lang_sense_clarification": "род птиц Colaptes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f4a0a6b-a977-3a36-9913-e4e03c65d848",
                    "sense_definition": "One who flicks.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agent_nouns",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The card <w>flicker</w> entertained the crowd with his quick finger tricks.",
                            "target_lang_translations": {
                                "ru": "Трюкач, <w>бросающий</w> карты, развлекал толпу своими быстрыми фокусами."
                            }
                        },
                        {
                            "text": "As a habitual ash <w>flicker</w>, he always kept an ashtray nearby.",
                            "target_lang_translations": {
                                "ru": "Как человек, привыкший <w>стряхивать</w> пепел, он всегда держал поблизости пепельницу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто совершает резкие щелчки пальцами или стряхивает что-то."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "de6b83eb-23d5-3f3f-8d75-0c38965561f5",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Flicker</w> to speak at our annual community meeting.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили господина <w>Фликера</w> выступить на нашем ежегодном собрании жителей."
                            }
                        },
                        {
                            "text": "The historical documents were signed by a man named Arthur <w>Flicker</w>.",
                            "target_lang_translations": {
                                "ru": "Исторические документы были подписаны человеком по имени Артур <w>Фликер</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фликер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}