{
    "word_family": [
        "laudable",
        "laudably",
        "laudatory",
        "laudation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a21739d7-4a30-3689-adfe-2b6a84180844",
                    "sense_definition": "To praise or glorify someone or something highly, especially in a public context.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee chose to <w>laud</w> her efforts to improve local public transport.",
                            "target_lang_translations": {
                                "zh": "委员会决定<w>赞扬</w>她在改善当地公共交通方面所做的努力。"
                            }
                        },
                        {
                            "text": "Critics from across the country continue to <w>laud</w> the director's newest documentary.",
                            "target_lang_translations": {
                                "zh": "全国各地的影评人持续对这位导演的最新纪录片表示<w>称赞</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ainoi"
                    ],
                    "common_phrases": [
                        "widely laud"
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指在公开场合）极力赞扬，称赞，赞颂"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "赞美",
                                "target_lang_sense_clarification": "表示称赞与褒奖"
                            },
                            {
                                "target_lang_word": "称赞",
                                "target_lang_sense_clarification": "用语言表达对人或事的认可"
                            },
                            {
                                "target_lang_word": "赞颂",
                                "target_lang_sense_clarification": "高度称赞与歌颂"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
