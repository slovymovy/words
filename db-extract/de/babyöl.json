                                        "entry_id": "fb3061d5-0342-329d-9671-83c71482e2c9",
                                        "glosses": [
                                            "A mineral oil used primarily to moisten the skin of babies after bathing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3d1c612-332e-4051-b98a-ef00fc65392f",
                                                "sense_id": "45e21ec1-2bb3-35fa-8474-d9406a4cea41",
                                                "text": "Oil-based lubricants like Crisco, Vaseline, and baby oil may make condoms break."
                                            }
                                        ]
