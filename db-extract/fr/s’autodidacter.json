                        "examples": [
                            {
                                "example_id": "d4f556e2-5434-4d9f-88e4-d1bcafeb7a88",
                                "sense_id": "a49bcce3-1e4c-3154-ab61-700f193623a8",
                                "text": "J’en avais marre de pas lire ni écrire, alors j’ai décidé de venir m’autodidacter à Paris."
                            },
                            {
                                "example_id": "d9b1cf44-ab8f-4493-8d9f-8da49d96763b",
                                "sense_id": "a49bcce3-1e4c-3154-ab61-700f193623a8",
                                "text": "Le grand frère fraîchement déjonqué s’autodidacte le français"
                            },
                            {
                                "example_id": "330b0db3-8603-4e63-9ccf-3cee4898e145",
                                "sense_id": "a49bcce3-1e4c-3154-ab61-700f193623a8",
                                "text": "Autodidacte à la gratte, au djembé et sur séquenceur... on va s’autodidacter ensemble!!"
                            },
                            {
                                "example_id": "1adf2513-6070-471a-8ad7-f21074d3d149",
                                "sense_id": "a49bcce3-1e4c-3154-ab61-700f193623a8",
                                "text": "sur ce, l’autodidacte va continuer à s’autodidacter."
                            }
                        ]
