                "senses": [
                    {
                        "sense_id": "7b1ec5ab-d1d3-3938-9ea9-f488d0ca8b27",
                        "entry_id": "daf8a236-093f-3a11-af64-2b292df4dbda",
                        "glosses": [
                            "grammatische Funktion von Satzgliedern, die darin besteht, eine Aussage über Ort, Zeit, Umstand oder Ursache zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d48d3d79-03df-405c-b195-d05081b85a5d",
                                "sense_id": "7b1ec5ab-d1d3-3938-9ea9-f488d0ca8b27",
                                "text": "In \"Peter kam gestern\" ist \"gestern\" ein adverbiales Satzglied in der Funktion einer Umstandsbestimmung."
                            },
                            {
                                "example_id": "e3e1c9b6-08b4-4e38-a663-35d588a1d830",
                                "sense_id": "7b1ec5ab-d1d3-3938-9ea9-f488d0ca8b27",
                                "text": "In \"Peter schlief den ganzen Tag\" ist \"den ganzen Tag\" ein nominales Satzglied in der Funktion einer Umstandsbestimmung."
                            },
                            {
                                "example_id": "c92d92ba-a63e-4b2c-be7a-1180069d8ed3",
                                "sense_id": "7b1ec5ab-d1d3-3938-9ea9-f488d0ca8b27",
                                "text": "„Die drei Formen sind Hauptsatz, Nebensatz und die sogenannte adverbiale Bestimmung (Umstandsbestimmung).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
