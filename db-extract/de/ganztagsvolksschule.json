                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7938226-a8db-4348-abc8-d45a9aa90817",
                                "sense_id": "27504ebf-6437-3a3a-a5a7-ae766f102499",
                                "text": "„Der folgende Ausschnitt stammt aus einem Interview mit Gerda. Sie ist zum Zeitpunkt des Interviews 51 Jahre alt, begann also sehr spät mit der Ausbildung zur Volksschullehrerin, und arbeitet in ihrem sechsten Dienstjahr an einer Ganztagsvolksschule in Wien.“"
                            },
                            {
                                "example_id": "d2583aac-01b5-4a95-8c0c-735048f943e7",
                                "sense_id": "27504ebf-6437-3a3a-a5a7-ae766f102499",
                                "text": "„Meine Kinder besuch(t)en eine Ganztagsvolksschule in Wien mit hohem Ausländeranteil.“"
                            },
                            {
                                "example_id": "070d6e2f-24e9-462b-9eeb-62ebc74daa65",
                                "sense_id": "27504ebf-6437-3a3a-a5a7-ae766f102499",
                                "text": "„Bereits 1990 war an der Kühlergasse in Wien die erste Ganztagsvolksschule eröffnet worden (ebd., 156).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
