                                "target_senses": [
                                    {
                                        "sense_id": "7bdd6b66-cf05-31b8-bda3-eae439c1a12d",
                                        "entry_id": "7cf73ab2-cec6-3202-bb05-d5b1e92b1c4a",
                                        "glosses": [
                                            "Examen minucioso o riguroso de una cosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02813759-2932-4f28-a20c-8502dad331bd",
                                                "sense_id": "7bdd6b66-cf05-31b8-bda3-eae439c1a12d",
                                                "text": "Sin entrar en las disquisiciones de los historiadores de la filosofía, parece cierto que Parménides fue discípulo de Jenófanes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
