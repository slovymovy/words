                    "sense_id": "b09f9802-b653-3a3f-94c2-57838b30cc0a",
                    "sense_definition": "Een kledingstuk dat buiten over andere kleding wordt gedragen om het bovenlichaam te bedekken en warm te houden.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing_coat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergeet niet om je <w>jas</w> aan te trekken als je naar buiten gaat.",
                            "target_lang_translations": {
                                "en": "Don't forget to put on your <w>coat</w> when you go outside.",
                                "ru": "Не забудь надеть <w>куртку</w>, когда пойдешь на улицу.",
                                "zh": "出门时别忘了穿上你的<w>外套</w>。",
                                "pl": "Nie zapomnij założyć <w>płaszcza</w>, kiedy wychodzisz na zewnątrz.",
                                "de": "Vergiss nicht, deine <w>Jacke</w> anzuziehen, wenn du nach draußen gehst.",
                                "fr": "N'oublie pas de mettre ton <w>manteau</w> quand tu sors.",
                                "it": "Non dimenticare di metterti la <w>giacca</w> quando esci.",
                                "cs": "Nezapomeň si vzít <w>kabát</w>, když jdeš ven.",
                                "tr": "Dışarı çıkarken <w>montunu</w> giymeyi unutma.",
                                "es": "No olvides ponerte el <w>abrigo</w> cuando salgas."
                            }
                        },
                        {
                            "text": "Hij kocht een nieuwe warme <w>jas</w> voor de winter.",
                            "target_lang_translations": {
                                "en": "He bought a new warm <w>coat</w> for the winter.",
                                "ru": "Он купил новую теплую <w>куртку</w> на зиму.",
                                "zh": "他买了一件新的保暖<w>大衣</w>过冬。",
                                "pl": "Kupił nową, ciepłą <w>kurtkę</w> na zimę.",
                                "de": "Er kaufte einen neuen warmen <w>Mantel</w> für den Winter.",
                                "fr": "Il a acheté un nouveau <w>manteau</w> chaud pour l'hiver.",
                                "it": "Ha comprato un nuovo <w>cappotto</w> caldo per l'inverno.",
                                "cs": "Koupil si na zimu nový teplý <w>kabát</w>.",
                                "tr": "Kış için yeni ve sıcak tutan bir <w>palto</w> aldı.",
                                "es": "Él compró un <w>abrigo</w> nuevo y cálido para el invierno."
                            }
                        }
