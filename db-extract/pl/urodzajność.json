                    {
                        "translation_id": "5f789c7c-80c5-472f-8cbf-d1f4a97494ce",
                        "source_entry_id": "2ad2defa-17f4-3941-81f2-5f1757e4b813",
                        "source_sense_id": "227701b3-dcad-3616-8ab9-4e2e6ed4fc58",
                        "target_lang_word": "fruitfulness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fruitfulness",
