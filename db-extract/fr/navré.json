                "entry_id": "8c328583-6f3a-3d68-b3d4-1557b442f256",
                "word": "navré",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "63f5efed-bf71-47fc-b7ea-7ca3725112d9",
                        "entry_id": "8c328583-6f3a-3d68-b3d4-1557b442f256",
                        "tags": [
