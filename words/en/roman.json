                        "zh": [
                            {
                                "target_lang_word": "罗马天主教的",
                                "target_lang_sense_clarification": "指宗教信仰或教会"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac6f7ed3-2788-3cfc-b8be-261968090a44",
                    "sense_definition": "Denoting a standard upright typeface, as opposed to italic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "typography_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The main text is set in <w>roman</w> type.",
                            "target_lang_translations": {
                                "ru": "Основной текст набран <w>прямым</w> шрифтом.",
                                "zh": "正文采用<w>正体</w>排版。"
                            }
                        },
                        {
                            "text": "Please change the font from italic to <w>roman</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, измените шрифт с курсива на <w>прямой</w>.",
                                "zh": "请将字体从斜体改为<w>正体</w>。"
                            }
                        }
                    ],
                    "antonyms": [
