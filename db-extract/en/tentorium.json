                        "glosses": [
                            "The framework of internal supports (a false endoskeleton) within an arthropod head, formed by ingrowths of the exoskeleton called apophyses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0d643d6-1bd9-4782-aa2e-d73a007e3e6d",
                                "sense_id": "f7ac57e8-b169-3bdc-9717-47c9f4de878f",
                                "text": "In the female of Culex the tentoria arise in front of the border of the occipital foramen and ascend at an angle of twenty-five degrees with the floor of the head."
                            }
                        ]
                    },
                    {
                        "sense_id": "7fa2f36d-281f-3b67-beb2-8b2330d937c5",
                        "entry_id": "8168c30b-ae38-3a4e-9c11-791b79dc54a9",
                        "glosses": [
                            "The tentorium cerebelli, an extension of the dura mater that separates the cerebellum from the inferior portion of the occipital lobes."
                        ],
