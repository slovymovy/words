        "fr-extract.jsonl": [
            {
                "entry_id": "9d18a6ce-73fb-3ef6-a95a-2d91c5edae0b",
                "word": "dissentiment",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a7336c58-8b40-4eba-9a9e-8d3fd9210ec2",
                        "entry_id": "9d18a6ce-73fb-3ef6-a95a-2d91c5edae0b",
                        "tags": [
                            "plural"
                        ],
                        "form": "dissentiments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52068968-1c27-3568-8deb-be165c77fe91",
                        "entry_id": "9d18a6ce-73fb-3ef6-a95a-2d91c5edae0b",
                        "glosses": [
                            "Différence de manière de voir, de juger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c714f9a-7e21-4518-bf25-bb48678811f2",
                                "sense_id": "52068968-1c27-3568-8deb-be165c77fe91",
                                "text": "M. de Champagnoles, je vous interdis de répondre ; il ne convient pas qu’un dissentiment politique dégénère en querelle personnelle."
                            },
                            {
                                "example_id": "3a2d76ad-3f82-42db-9905-c8ac882308a8",
                                "sense_id": "52068968-1c27-3568-8deb-be165c77fe91",
                                "text": "Ces causes de dissentiment qui couvaient depuis longtemps aboutirent à une rupture ouverte quand la loi judiciaire de C. Gracchus eut jeté les sénateurs et les chevaliers en face les uns des autres…"
                            },
                            {
                                "example_id": "bb568d5c-535c-4640-b0ec-5d7961a06efb",
                                "sense_id": "52068968-1c27-3568-8deb-be165c77fe91",
                                "text": "Il sait, en 1902, tirer parti des circonstances, jouer du dissentiment entre Waldeck-Rousseau et Léon Bourgeois."
                            },
                            {
                                "example_id": "4370d61e-6249-45d2-b5b4-e640e375c1bf",
                                "sense_id": "52068968-1c27-3568-8deb-be165c77fe91",
                                "text": "Une rivalité politique envenimée par les dissentiments religieux préparait depuis longtemps la guerre entre le roi d’Espagne et la reine d’Angleterre."
                            },
                            {
                                "example_id": "f6ab3455-a20c-4825-aac0-4fc7adb722ff",
                                "sense_id": "52068968-1c27-3568-8deb-be165c77fe91",
                                "text": "Cibler Anonymous et les hacktivistes revient à cibler des citoyens parce qu’ils ont exprimé leurs convictions politiques, ce qui finit par étouffer tout dissentiment légitime."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7872346f-99f6-4bc9-ac6a-e3c9a33bc0e2",
                        "source_entry_id": "9d18a6ce-73fb-3ef6-a95a-2d91c5edae0b",
                        "source_sense_id": "52068968-1c27-3568-8deb-be165c77fe91",
                        "source_sense_description": "1. Différence de manière de voir, de juger.",
                        "target_lang_word": "Meinungsverschiedenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meinungsverschiedenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                        "entry_id": "42600527-e54f-3bb4-9ca7-ae299cbb9e16",
                                        "glosses": [
                                            "unterschiedliche Beurteilung, Einschätzung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2145cd9e-7287-4880-ad99-15519fc2ad8f",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Im Herbst 1919 startete die Weiße Armee eine Großoffensive auf Moskau, die aber unter anderem wegen Meinungsverschiedenheiten zwischen den Generälen scheiterte.“"
                                            },
                                            {
                                                "example_id": "420da42d-1914-484a-81fa-3eb616401c62",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Am Ende erwiesen sich die alliierten Meinungsverschiedenheiten in der Reparationsfrage als unüberbrückbar.“"
                                            },
                                            {
                                                "example_id": "23279758-86e2-44d5-ab89-71ec04931b71",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Während er zu irgendeinem Gegenstand geführt wurde, merkte er, dass unter seinen Führern Meinungsverschiedenheiten und eine gewisse Verwirrung entstanden waren.“"
                                            },
                                            {
                                                "example_id": "38ef3c91-4edf-448b-acb2-a8d2a4fea93f",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„In den meisten Fällen herrscht ein Geist von Kooperation und gegenseitigem Verstehen, und es hat sich eine Art guter Beziehung entwickelt, die gewöhnlich gravierende Meinungsverschiedenheiten verhindert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f43bcfa8-e1ee-3976-830e-cedea445ae49",
                                        "entry_id": "42600527-e54f-3bb4-9ca7-ae299cbb9e16",
                                        "glosses": [
                                            "verbale Auseinandersetzung, Streit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad229162-e4f1-4d42-8624-ee5b91e2b449",
                                                "sense_id": "f43bcfa8-e1ee-3976-830e-cedea445ae49",
                                                "text": "Nach dieser Meinungsverschiedenheit war die Stimmung vorübergehend etwas getrübt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "720931e8-9118-4b51-a48d-66b5544bc692",
                        "source_entry_id": "9d18a6ce-73fb-3ef6-a95a-2d91c5edae0b",
                        "source_sense_id": "52068968-1c27-3568-8deb-be165c77fe91",
                        "source_sense_description": "1. Différence de manière de voir, de juger.",
                        "target_lang_word": "dissent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aadbda02-3ae4-3d99-a381-15d94e5abc16",
                                        "entry_id": "091aab4a-a325-3954-9973-cbc913c2f9a0",
                                        "glosses": [
                                            "To disagree; to withhold assent. Construed with from (or, formerly, to)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "612d3015-6b42-4de1-8057-8e0644ba280c",
                                                "sense_id": "aadbda02-3ae4-3d99-a381-15d94e5abc16",
                                                "text": "Where a trustee refuses either to assent or dissent, the Court will itself exercise his authority."
                                            },
                                            {
                                                "example_id": "45f12739-12b0-4e96-84ac-a5a55ca759a7",
                                                "sense_id": "aadbda02-3ae4-3d99-a381-15d94e5abc16",
                                                "text": "Those who openly dissented from the acts which the King had carried through the Parliament."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52bd54b7-6168-36a4-9b59-2245c39a1830",
                                        "entry_id": "091aab4a-a325-3954-9973-cbc913c2f9a0",
                                        "glosses": [
                                            "To differ from, especially in opinion, beliefs, etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c8a5a7-d464-432e-be75-8317f713aee4",
                                                "sense_id": "52bd54b7-6168-36a4-9b59-2245c39a1830",
                                                "text": "Some are so eristical and teasty, that they will not ... bear with any that dissent."
                                            },
                                            {
                                                "example_id": "98a1a6b0-cac1-45ea-b6c6-34647b3a03cf",
                                                "sense_id": "52bd54b7-6168-36a4-9b59-2245c39a1830",
                                                "text": "Natural reason dictates, that motion ought to be assigned to the bodies, which in kind and essence most agree with those bodies which do undoubtedly move, and rest to those which most dissent from them."
                                            },
                                            {
                                                "example_id": "d55aef83-c903-443c-ac1e-b2eacfb42065",
                                                "sense_id": "52bd54b7-6168-36a4-9b59-2245c39a1830",
                                                "text": "If the public dissent from our views, we say that they ought to concur with us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eefbc0a1-375c-32bd-9346-ef098ae6e3c4",
                                        "entry_id": "091aab4a-a325-3954-9973-cbc913c2f9a0",
                                        "glosses": [
                                            "To be different; to have contrary characteristics."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f38728c2-052d-4126-aeed-78370138086c",
                                                "sense_id": "eefbc0a1-375c-32bd-9346-ef098ae6e3c4",
                                                "text": "it was wholly unlawful, in any thing to dissent from him"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dissent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2ca0b88-7976-3956-a89d-f132c2bcbc4d",
                                        "entry_id": "acdd4bed-9c4f-33e5-b8a5-65cd2a115c58",
                                        "glosses": [
                                            "Disagreement with the ideas, doctrines, decrees, etc. of a political party, government or religion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98b07425-f362-4a99-9326-990450390a33",
                                                "sense_id": "a2ca0b88-7976-3956-a89d-f132c2bcbc4d",
                                                "text": "ethnopolitical dissent"
                                            },
                                            {
                                                "example_id": "1f45b40e-35b1-459a-84eb-5ffd42bad480",
                                                "sense_id": "a2ca0b88-7976-3956-a89d-f132c2bcbc4d",
                                                "text": "A system that suppresses dissent is fault-intolerant, ignorant and fragile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4347768-1063-3ee8-828a-18f6996681dc",
                                        "entry_id": "acdd4bed-9c4f-33e5-b8a5-65cd2a115c58",
                                        "glosses": [
                                            "An act of disagreeing with, or deviating from, the views and opinions of those holding authority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ccebdd5-b7c3-3861-8c0d-753ab544e2fb",
                                        "entry_id": "acdd4bed-9c4f-33e5-b8a5-65cd2a115c58",
                                        "glosses": [
                                            "A separate opinion filed in a case by judges who disagree with the outcome of the majority of the court in that case"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "022592c8-791a-3948-997f-d519ed204c98",
                                        "entry_id": "acdd4bed-9c4f-33e5-b8a5-65cd2a115c58",
                                        "glosses": [
                                            "A violation that arises when disagreement with an official call is expressed in an inappropriate manner such as foul language, rude gestures, or failure to comply."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d19665d2-656b-4c3a-9dea-3b0349fc57c4",
                                                "sense_id": "022592c8-791a-3948-997f-d519ed204c98",
                                                "text": "City had been woeful, their anger at their own inertia summed up when Samir Nasri received a booking for dissent, and they did not have a shot on target until the 66th minute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
