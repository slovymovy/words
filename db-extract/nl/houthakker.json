                        "glosses": [
                            "iemand die beroepsmatig houthakt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "416ef943-2a85-440a-8bac-0a753ad7984a",
                                "sense_id": "a8aa3500-fbda-3f4d-9f3c-fbabb6012521",
                                "text": "Eén jongen die me direct opviel door zijn gigantische rode baard vertelde me dat hij een houthakker uit Tennessee was. Deze ‘Pogue Mahone’ (‘kiss my arse’ in Gaelic) leek sprekend op de ‘The Dude’ uit de film ‘The Big Lebowski’ met zijn relaxte houding en opvallende charisma."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "416beb42-c794-4e88-a0a7-dfa6f117293e",
                        "source_entry_id": "bbc727d9-d1d1-33ba-88a5-27892c84e9f2",
                        "source_sense_id": "a8aa3500-fbda-3f4d-9f3c-fbabb6012521",
                        "source_sense_description": "iemand die beroepsmatig houthakt",
                        "target_lang_word": "Holzfäller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holzfäller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a768640-1689-3dd1-a34b-0acf1ced6c6f",
                                        "entry_id": "26ec6511-d008-3b69-843c-0c7ee97c0f83",
                                        "glosses": [
                                            "Person, deren Beruf das Fällen von Bäumen und die Vorbereitung zum Abtransport ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86f69826-7eba-486d-ac39-a256932cb927",
                                                "sense_id": "5a768640-1689-3dd1-a34b-0acf1ced6c6f",
                                                "text": "Holzfäller tragen zumeist eine spezielle Schutzkleidung, um Verletzungen durch Kettensägen zu vermeiden."
                                            },
                                            {
                                                "example_id": "7edbd5c6-7faf-4af9-a8a1-a2c666434482",
                                                "sense_id": "5a768640-1689-3dd1-a34b-0acf1ced6c6f",
                                                "text": "„Auf dem legendären Cover: ein sinnlicher, lachender Adonis – schmale Hüften, breite Schultern, bloßer Oberkörper, mit deutlich in der Hose liegendem Geschlechtsteil, blond, mit Tolle, balanciert als Holzfäller und Flößer auf einem Baumstamm in der Flussmitte, an seiner Hüfte das typische Finnenmesser, in den Händen die Flößerstange.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecbe8583-6c33-4192-829f-2df44f5870ac",
                        "source_entry_id": "bbc727d9-d1d1-33ba-88a5-27892c84e9f2",
                        "source_sense_id": "a8aa3500-fbda-3f4d-9f3c-fbabb6012521",
