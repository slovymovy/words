                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a2756df-58f6-4ebf-93a7-b05493ba6018",
                                "sense_id": "a3623824-2e98-377b-8450-b7e694c68d4b",
                                "text": "La barque varino, faite pour un seul pêcheur, souvent aidé d'un gamin, est en usage sur le Tage, le Sâdo, le Douro et la Rîa."
                            },
                            {
                                "example_id": "76c134e7-b2ea-4909-bc0a-01e5635d1acc",
                                "sense_id": "a3623824-2e98-377b-8450-b7e694c68d4b",
                                "text": "Mais l'éclectisme a aussi fini par dominer ce centre de pêche, qui était le résultat de la migration de varinos vers la côte de Nazaré au XVIII^(ème) siècle."
                            }
                        ]
                    }
