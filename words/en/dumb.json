                },
                {
                    "sense_id": "00eea3f6-c601-3b73-a09a-c6eadcefbcc7",
                    "sense_definition": "Unable to speak; lacking the power of speech.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trauma left the child <w>dumb</w> for several months.",
                            "target_lang_translations": {
                                "ru": "Травма оставила ребенка <w>немы́м</w> на несколько месяцев.",
                                "tr": "Travma, çocuğu birkaç ay boyunca <w>dilsiz</w> bıraktı.",
                                "zh": "那次创伤导致孩子有几个月<w>无法说话</w>。"
                            }
                        },
                        {
                            "text": "Historically, people used the phrase deaf and <w>dumb</w>, but it is now considered offensive.",
                            "target_lang_translations": {
                                "ru": "Исторически люди использовали фразу \"глухой и <w>немо́й</w>\", но сейчас это считается оскорбительным.",
                                "tr": "Tarihsel olarak insanlar 'sağır ve <w>dilsiz</w>' ifadesini kullanırlardı ancak bu artık hakaret kabul ediliyor.",
                                "zh": "历史上人们曾使用“聋哑人”这个词，但现在这被认为具有冒犯性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mute",
                        "speechless"
                    ],
                    "common_phrases": [
                        "deaf and dumb",
                        "dumb animals"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often considered offensive in modern usage when referring to people"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неспособный говорить; лишенный дара речи.",
                        "tr": "Konuşamayan, konuşma yeteneği olmayan.",
                        "zh": "无法说话；丧失语言能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "немо́й",
                                "target_lang_sense_clarification": "физически неспособный говорить"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dilsiz",
                                "target_lang_sense_clarification": "konuşma engelli"
                            },
                            {
                                "target_lang_word": "niteliksiz",
                                "target_lang_sense_clarification": "eski kullanım"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哑的",
                                "target_lang_sense_clarification": "生理上无法说话"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63845e8e-b442-3179-b278-83a2d09d0018",
                    "sense_definition": "Temporarily silent or speechless, often due to shock or shyness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was struck <w>dumb</w> by the unexpected news.",
                            "target_lang_translations": {
                                "ru": "Она <w>онеме́ла</w> от неожиданной новости.",
                                "tr": "Beklenmedik haber karşısında <w>dili tutuldu</w>.",
                                "zh": "听到那个意外的消息，她<w>惊呆了</w>，一句话也说不出来。"
                            }
                        },
                        {
                            "text": "The audience remained <w>dumb</w> with amazement at the performance.",
                            "target_lang_translations": {
                                "ru": "Публика оставалась <w>безмо́лвной</w> от изумления представлением.",
                                "tr": "Seyirciler gösteri karşısındaki şaşkınlıktan <w>sessiz</w> kaldı.",
                                "zh": "观众对这场表演感到惊叹，<w>沉默</w>不语。"
                            }
                        }
                    ],
                    "synonyms": [
                        "speechless",
                        "silent",
                        "wordless"
                    ],
                    "common_phrases": [
                        "struck dumb",
                        "dumb show"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временно потерявший дар речи, часто из-за шока или смущения.",
                        "tr": "Genellikle şok veya utangaçlık nedeniyle geçici olarak sessiz kalmış, dili tutulmuş.",
                        "zh": "因震惊或害羞而暂时沉默或无法说话。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "онеме́вший",
                                "target_lang_sense_clarification": "потерявший дар речи"
                            },
                            {
                                "target_lang_word": "безмо́лвный",
                                "target_lang_sense_clarification": "хранящий молчание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dili tutulmuş",
                                "target_lang_sense_clarification": "şaşkınlıktan konuşamayan"
                            },
                            {
                                "target_lang_word": "nutku tutulmuş",
                                "target_lang_sense_clarification": "şok nedeniyle"
                            },
                            {
                                "target_lang_word": "sessiz",
                                "target_lang_sense_clarification": "sessiz kalmış"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目瞪口呆",
                                "target_lang_sense_clarification": "因震惊而说不出话"
                            },
                            {
                                "target_lang_word": "哑口无言",
                                "target_lang_sense_clarification": "因尴尬或无话可说"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01902b62-d3c2-310f-9040-d1214561d11a",
                    "sense_definition": "Lacking internal processing power or intelligent features; not \"smart\".",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>dumb</w> phone can only make calls and send texts, unlike a smartphone.",
                            "target_lang_translations": {
                                "ru": "<w>Просто́й</w> телефон может только звонить и отправлять смс, в отличие от смартфона.",
                                "tr": "Bir akıllı telefonun aksine, <w>basit</w> bir telefon sadece arama yapabilir ve mesaj gönderebilir.",
                                "zh": "与智能手机不同，<w>非智能</w>手机只能打电话和发短信。"
                            }
                        },
                        {
                            "text": "The computer connects to a <w>dumb</w> terminal that simply displays data.",
                            "target_lang_translations": {
                                "ru": "Компьютер подключается к <w>неинтеллектуа́льному</w> терминалу, который просто отображает данные.",
                                "tr": "Bilgisayar, yalnızca verileri görüntüleyen <w>akılsız</w> bir terminale bağlanır.",
                                "zh": "计算机连接到一个仅用于显示数据的<w>哑</w>终端。"
                            }
                        }
                    ],
                    "synonyms": [
                        "basic"
                    ],
                    "antonyms": [
                        "smart",
                        "intelligent"
                    ],
                    "common_phrases": [
                        "dumb terminal",
                        "dumb phone",
                        "dumb bomb"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный функций обработки данных или интеллектуальных возможностей; не \"умный\".",
                        "tr": "Dahili işlem gücü veya akıllı özellikleri olmayan; \"akıllı\" olmayan.",
                        "zh": "缺乏内部处理能力或智能功能；非“智能”的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просто́й",
                                "target_lang_sense_clarification": "базовый, без смарт-функций"
                            },
                            {
                                "target_lang_word": "неинтеллектуа́льный",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "akılsız",
                                "target_lang_sense_clarification": "akıllı teknoloji karşıtı"
                            },
                            {
                                "target_lang_word": "basit",
                                "target_lang_sense_clarification": "temel düzeyde"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非智能的",
                                "target_lang_sense_clarification": "技术领域用语"
                            },
                            {
                                "target_lang_word": "基础的",
                                "target_lang_sense_clarification": "功能简单的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e22b5a4a-c98d-355f-a838-c4f44051d790",
                    "sense_definition": "To make something simpler or easier to understand, often reducing its intellectual quality.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to <w>dumb</w> down the report for the general public.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>упрости́ть</w> отчет для широкой публики.",
                                "tr": "Raporu genel kamuoyu için <w>basite indirgemek</w> zorunda kaldılar.",
                                "zh": "他们不得不为了大众将报告<w>简化</w>。"
                            }
                        },
                        {
                            "text": "Don't <w>dumb</w> the lesson down just because it is difficult.",
                            "target_lang_translations": {
                                "ru": "Не <w>упроща́й</w> урок только потому, что он сложный.",
                                "tr": "Sırf zor diye dersi <w>basitleştirme</w>.",
                                "zh": "不要因为课程难就将其<w>通俗化</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dumb down"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-то проще или понятнее, часто снижая интеллектуальное качество.",
                        "tr": "Bir şeyi daha basit veya anlaşılır hale getirmek, genellikle kalitesini veya seviyesini düşürmek.",
                        "zh": "使某事变得更简单或更容易理解，通常会降低其智力深度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упроща́ть",
                                "target_lang_sense_clarification": "делать примитивнее"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "basitleştirmek",
                                "target_lang_sense_clarification": "kolaylaştırmak"
                            },
                            {
                                "target_lang_word": "basite indirgemek",
                                "target_lang_sense_clarification": "kalitesini düşürerek basit kılmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简化",
                                "target_lang_sense_clarification": "使内容变简单"
                            },
                            {
                                "target_lang_word": "通俗化",
                                "target_lang_sense_clarification": "降低门槛以适应大众"
                            }
                        ]
                    }
                }
            ]
        },
        {
