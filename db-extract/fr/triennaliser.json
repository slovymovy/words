                "senses": [
                    {
                        "sense_id": "10625324-d9b8-3777-8129-6043abdcfa53",
                        "entry_id": "7ce129ea-55b5-34f6-be70-eba5f6c06099",
                        "glosses": [
                            "Donner un caractère triennal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60bf9746-a9d9-4950-a89f-f7ce9dc49933",
                                "sense_id": "10625324-d9b8-3777-8129-6043abdcfa53",
                                "text": "J’invite également M. Hediger, quant à son chantage de «triennaliser» toutes les subventions du département des sports, à consulter le budget et les pages jaunes des budgets des dix dernières années; il verra qu’il y a très peu de lignes qui ont changé et qu’elles sont pratiquement toutes restées au même niveau."
                            },
                            {
                                "example_id": "ea258b20-ba63-4276-8c15-8619aa159636",
                                "sense_id": "10625324-d9b8-3777-8129-6043abdcfa53",
                                "text": "Ca leur permet ainsi de « triennaliser » les heures supplémentaires autrement dit de peu ou pas les payer et d'imposer la flexibilité."
                            },
                            {
                                "example_id": "b5b81eaa-6723-4872-8a15-4e0dacb0f323",
                                "sense_id": "10625324-d9b8-3777-8129-6043abdcfa53",
                                "text": "Ce mécanisme revient à « triennaliser » les heures supplémentaires et finalement à priver les salariés de la majoration de leurs heures supplémentaires."
                            }
                        ]
                    }
