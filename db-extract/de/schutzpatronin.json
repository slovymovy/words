                ],
                "senses": [
                    {
                        "sense_id": "78a25a6b-30c8-32f9-9fc4-e3ec4eb0a3f2",
                        "entry_id": "62a8abbc-095a-3e08-a2ad-b3765da1928c",
                        "glosses": [
                            "weibliche Person, die als Heilige oder andere wirkmächtige Figur verehrt wird, der man zutraut, bestimmten Personengruppen oder Objekten Schutz gewähren zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e970c28a-1632-4c6a-ae3d-4db4230e440f",
                                "sense_id": "78a25a6b-30c8-32f9-9fc4-e3ec4eb0a3f2",
                                "text": "„Heute gilt Cyana als die Schutzpatronin der Taucher, im Namen der Unterwasseramazone geht es auch heute noch in Tiefen bis zu 3000 Meter: Ein französisches Tauchboot in weltweitem Forschungseinsatz ist nach Cyana benannt.“"
                            },
                            {
                                "example_id": "bda7b562-1e70-4b99-9490-63090faf1fc3",
                                "sense_id": "78a25a6b-30c8-32f9-9fc4-e3ec4eb0a3f2",
                                "text": "„Damit wollte er ihr den sicheren Weg zum ewigen Heil weisen, in Nachahmung der Buße ihrer neuen Schutzpatronin, deren Leben sie bisher geführt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
