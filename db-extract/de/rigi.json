                            {
                                "example_id": "125d97a7-71f6-4f78-a3d8-5a3c2e2ae373",
                                "sense_id": "09ebc2a9-cbe7-3b56-8ef1-e92d39f14436",
                                "text": "„Am dritten Abend saßen wir im Hotel Bergsonne auf dem Rigi hoch über dem Vierwaldstätter See.“"
                            },
                            {
                                "example_id": "8f253b32-b3b1-4245-a59e-f5cc7dcfe707",
                                "sense_id": "09ebc2a9-cbe7-3b56-8ef1-e92d39f14436",
                                "text": "„Wer auf die Rigi wandert statt fährt, erkennt: Diese ist viel mehr als ein Berg der Bähnchen und Bergbeizen.“"
                            }
                        ],
