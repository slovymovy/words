                "senses": [
                    {
                        "sense_id": "d9035bcf-2a4a-35b2-b915-e33e21b51440",
                        "entry_id": "7e7a232e-3960-305f-a422-6a2ae7c855a3",
                        "glosses": [
                            "iemand die van mooie boeken houdt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "634545ff-47c7-433d-a962-0c5fd26198ff",
                                "sense_id": "d9035bcf-2a4a-35b2-b915-e33e21b51440",
                                "text": "Het grote onderscheid tussen bibliomanen en bibliofielen is dat bibliomanen dwangmatig boeken kopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a006890-94bf-47b4-8379-6ad88e9e1fdd",
                        "source_entry_id": "7e7a232e-3960-305f-a422-6a2ae7c855a3",
                        "source_sense_id": "d9035bcf-2a4a-35b2-b915-e33e21b51440",
                        "target_lang_word": "bibliophile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bibliophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d118f508-a5ee-31c1-995f-e6164c15872f",
                                        "entry_id": "13607d8b-0ad1-30e1-932a-9f9351150f38",
                                        "glosses": [
                                            "Amateur de livres rares et précieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82aaa7ef-5f17-4b7e-858e-01f4dda6d5d4",
                                                "sense_id": "d118f508-a5ee-31c1-995f-e6164c15872f",
                                                "text": "Un bûcher où le bois était rangé avec autant d’exactitude que peuvent l’être les livres d’un bibliophile."
                                            },
                                            {
                                                "example_id": "787ea2ca-722d-4e6d-88d1-90a4708526b0",
                                                "sense_id": "d118f508-a5ee-31c1-995f-e6164c15872f",
                                                "text": "À quoi je répondrai qu’un bibliophile sérieux ne communique pas ses livres. Lui-même ne les lit pas, de crainte de les fatiguer."
                                            },
                                            {
                                                "example_id": "d7c68864-1ead-4d0b-a39c-cdc1ab9b81cd",
                                                "sense_id": "d118f508-a5ee-31c1-995f-e6164c15872f",
                                                "text": "Les livres érotiques, qu’on appelle par euphémisme : éditions pour bibliophiles…"
                                            },
                                            {
                                                "example_id": "5fe234ee-38bf-4e9d-8c10-3b8a3aa5c5aa",
                                                "sense_id": "d118f508-a5ee-31c1-995f-e6164c15872f",
                                                "text": "Sans être aucunement bibliophile, j’ai un soin quasi fétichiste de mes livres."
                                            },
                                            {
                                                "example_id": "be57f2f1-e072-4b7d-aedb-9752fa9b983b",
                                                "sense_id": "d118f508-a5ee-31c1-995f-e6164c15872f",
                                                "text": "Comme il avait passé toute la guerre à acheter et vendre des livres précieux, il connaissait non seulement les bibliophiles et les libraires parisiens que j’ai cités plus haut, mais également les marchands d’autographes, de lettres et manuscrits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0996c32f-27a8-4bfd-a7f0-cb4bc1d927f8",
                        "source_entry_id": "7e7a232e-3960-305f-a422-6a2ae7c855a3",
                        "source_sense_id": "d9035bcf-2a4a-35b2-b915-e33e21b51440",
                        "target_lang_word": "bibliófilo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bibliófilo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "b386794c-1fe2-3d13-b480-0ebb357d21ff",
                                        "entry_id": "a4031e46-d458-30b0-8665-acd854d2daf8",
                                        "glosses": [
                                            "Que ama o tiene afición por los libros, en especial por ediciones con características especiales."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b4202d4-1ce1-41df-9b5f-6dfe6c122aec",
                                                "sense_id": "b386794c-1fe2-3d13-b480-0ebb357d21ff",
                                                "text": "libros que él coleccionaba como antiguos y que era una inconsciente iniciación de su tendencia bibliófila"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
