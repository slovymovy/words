                "senses": [
                    {
                        "sense_id": "35488dfe-e492-3519-ac6e-600848e27826",
                        "entry_id": "4942ccb7-17f6-3dee-bfa7-a79476440976",
                        "glosses": [
                            "Hai mit auffallendem Hautmuster aus der Familie der Requiemhaie"
                        ],
                        "tags": [
                            "Ichthyologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ffb50ffe-295b-47d0-b6c9-56d10e3c3be7",
                                "sense_id": "35488dfe-e492-3519-ac6e-600848e27826",
                                "text": "„Damien Hirst und sein in Formaldehyd gelagerter Tigerhai werden zum Symbol einer dekadenten, raffgierigen Kunstwelt.“"
                            },
                            {
                                "example_id": "4b3d6d67-d307-4960-b3c9-b0059c241e49",
                                "sense_id": "35488dfe-e492-3519-ac6e-600848e27826",
                                "text": "„Mit fünf bis sechs Metern Länge und einem sehr gut entwickelten Geruchs- und Gesichtssinn ist der Tigerhai (Galeocerdo cuvier) ein Spitzenprädator.“"
                            },
                            {
                                "example_id": "5bb9b19d-35ab-43ad-85c6-e63743fd5b4f",
                                "sense_id": "35488dfe-e492-3519-ac6e-600848e27826",
                                "text": "„In dem Moment habe sie nicht wahrgenommen, dass ein Tigerhai ganz in ihrer Nähe gewesen sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
