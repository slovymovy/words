                        "glosses": [
                            "overheersend uitgangspunt voor een samenhangend gedachtegoed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c34a0d55-3f6d-4c35-b948-826b2dd19dd9",
                                "sense_id": "6949c1c4-9234-3b1a-9c4a-8187f674199d",
                                "text": "Hij laat een pamflet zien met de kleuren van de oude Libische vlag. Verkiezingen, een nieuwe grondwet, een meerpartijensysteem en vrijheid van meningsuiting zijn de hoofdbeginselen."
                            },
                            {
                                "example_id": "10266e0c-f1d2-4821-a50c-8ad64048c2e5",
                                "sense_id": "6949c1c4-9234-3b1a-9c4a-8187f674199d",
                                "text": "Uit Gordons geschriften is af te leiden welke beginselen hij heeft gevolgd in de constructie van deze afbeelding. Het hoofdbeginsel is de vaststelling dat de Moetoana's die hij in het noorden gezien had in uiterlijk en taal overeenkwamen met de Kaffers die ver van Moetoana's woonden aan de oostgrens van de Kaapkolonie."
                            }
                        ]
                    }
