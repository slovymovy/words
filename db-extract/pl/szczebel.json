                "senses": [
                    {
                        "sense_id": "bf52928a-5507-33ac-8729-55e209a599a5",
                        "entry_id": "47884e34-795f-3982-9f7f-85da876a4a80",
                        "glosses": [
                            "poprzeczny drążek lub pręt w drabinie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "797deb74-bd6a-42d3-9ef2-dfcdf42af453",
                                "sense_id": "bf52928a-5507-33ac-8729-55e209a599a5",
                                "text": "W tej drabinie jest złamany szczebel – trzeba go albo wymienić, albo kupić nową drabinę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c30e420e-a053-3df2-a1c4-2c6e1269a353",
                        "entry_id": "47884e34-795f-3982-9f7f-85da876a4a80",
                        "glosses": [
                            "stopień w hierarchii społecznej, urzędniczej, naukowej, towarzyskiej itp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f230dac-4f26-475c-aecc-6d25c4b07a1d",
                                "sense_id": "c30e420e-a053-3df2-a1c4-2c6e1269a353",
                                "text": "Znacznie więcej niż połowa wyborców ma niskie wykształcenie, ale są oni poważnie niedoreprezentowani na wszystkich szczeblach polityki."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d10b6707-25ac-4d39-a267-b4b8a35e84ac",
                        "source_entry_id": "47884e34-795f-3982-9f7f-85da876a4a80",
                        "source_sense_id": "bf52928a-5507-33ac-8729-55e209a599a5",
                        "target_lang_word": "rung",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rung",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7dc422d-1db8-3e72-8766-eb0207679c2c",
                                        "entry_id": "79f666e4-f44c-3906-b1c8-3299c8ad442b",
                                        "glosses": [
                                            "A crosspiece forming a step of a ladder; a round."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e0a81e9-ec62-3515-a448-6d9aa762111f",
                                        "entry_id": "79f666e4-f44c-3906-b1c8-3299c8ad442b",
                                        "glosses": [
                                            "A crosspiece between legs of a chair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4145173-0726-4e08-8793-7fe24521e367",
                                                "sense_id": "1e0a81e9-ec62-3515-a448-6d9aa762111f",
                                                "text": "One of its arms was a disabled flail which used to be wielded by Goodman Rigby, before his spouse worried him out of this troublesome world; the other, if I mistake not, was composed of the pudding stick and a broken rung of a chair, tied loosely together at the elbow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ea8e99f-01e0-3594-9a8b-a82d917e2758",
                                        "entry_id": "79f666e4-f44c-3906-b1c8-3299c8ad442b",
                                        "glosses": [
                                            "A position in a hierarchy."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55a3717b-c832-43da-bae3-9d806c6fdd14",
                                                "sense_id": "8ea8e99f-01e0-3594-9a8b-a82d917e2758",
                                                "text": "the lowest rung of the society"
                                            },
                                            {
                                                "example_id": "90385992-26a9-4a25-b5b7-e8f1ebb87f7e",
                                                "sense_id": "8ea8e99f-01e0-3594-9a8b-a82d917e2758",
                                                "text": "“I’m very proud that I’ve worked on every rung of the ladder,” Ashley says. “When you go to college, you don’t want to be a senior right away—you want to be a freshman.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7454a5b-e19a-3e15-9b83-c4be99e60c60",
                                        "entry_id": "79f666e4-f44c-3906-b1c8-3299c8ad442b",
                                        "glosses": [
                                            "A floor timber in a ship."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa6074f4-d042-33e7-9896-8d710f30f0dd",
                                        "entry_id": "79f666e4-f44c-3906-b1c8-3299c8ad442b",
                                        "glosses": [
                                            "One of the stakes of a cart; a spar; a heavy staff."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99d1039f-2bd5-3b05-9d52-f61810b58977",
                                        "entry_id": "79f666e4-f44c-3906-b1c8-3299c8ad442b",
                                        "glosses": [
                                            "One of the radial handles projecting from the rim of a steering wheel."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96e9cdcc-57b5-3b08-b90a-32427c1e2ce7",
                                        "entry_id": "79f666e4-f44c-3906-b1c8-3299c8ad442b",
                                        "glosses": [
                                            "One of the pins or trundles of a lantern wheel."
                                        ],
