                        "translation_id": "f72d857a-2342-4a15-86fe-173bf6a1df0f",
                        "source_entry_id": "2bfc8fcc-4e50-38d6-b272-14f8693d4c0f",
                        "source_sense_id": "bbcd1edf-00fa-30a3-8b41-a9afc2e44869",
                        "source_sense_description": "kettengetriebenes Kraftfahrzeug mit Bugschaufel zur Geländeebnung",
                        "target_lang_word": "bulldozer",
