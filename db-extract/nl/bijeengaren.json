                "senses": [
                    {
                        "sense_id": "4d89966e-b7d9-3669-9506-c4508c2189b5",
                        "entry_id": "38a9be45-e9fd-3bbd-94ed-98af1969a244",
                        "glosses": [
                            "bij elkaar rapen"
