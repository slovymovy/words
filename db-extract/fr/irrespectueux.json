                    },
                    {
                        "form_id": "5036ddfe-0202-49b7-91c9-1a28870270df",
                        "entry_id": "3469f5cb-173a-3489-ab0a-4dd34b9468aa",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "irrespectueuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f35e74fe-8ad1-33cf-8009-396feba2de4d",
                        "entry_id": "3469f5cb-173a-3489-ab0a-4dd34b9468aa",
                        "glosses": [
                            "Qui manque au respect, ou qui blesse le respect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62cdc78f-e38f-44f0-bfc9-8330677aac64",
                                "sense_id": "f35e74fe-8ad1-33cf-8009-396feba2de4d",
                                "text": "Le mot de Renan à propos de Louis-Philippe : « Il faut pardonner aux rois leur médiocrité ; ils ne se sont pas choisis » n’est pas nécessairement irrespectueux."
                            },
                            {
                                "example_id": "e896ab69-daec-44cc-bad9-404fbbf9faa9",
                                "sense_id": "f35e74fe-8ad1-33cf-8009-396feba2de4d",
                                "text": "Il se montra fort irrespectueux envers son supérieur."
                            },
                            {
                                "example_id": "b4459011-419c-4c3d-9982-dd8c807d3113",
                                "sense_id": "f35e74fe-8ad1-33cf-8009-396feba2de4d",
                                "text": "Contenance irrespectueuse."
                            },
                            {
                                "example_id": "0795e0f1-07b9-4732-9073-931eeece8e10",
                                "sense_id": "f35e74fe-8ad1-33cf-8009-396feba2de4d",
                                "text": "Propos irrespectueux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16cffa26-3cf7-408c-abcb-79463a5334fe",
                        "source_entry_id": "3469f5cb-173a-3489-ab0a-4dd34b9468aa",
                        "source_sense_id": "f35e74fe-8ad1-33cf-8009-396feba2de4d",
                        "target_lang_word": "respektlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "respektlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                        "entry_id": "22bcd000-0015-36fd-b5a8-4c4c1483684d",
                                        "glosses": [
                                            "ohne Respekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38dfdd90-de43-4cf1-b861-d0693cca764b",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "Sein respektloses Verhalten gegenüber dem Lehrer hatte Konsequenzen."
                                            },
                                            {
                                                "example_id": "86cdd514-9b04-4a1a-81cb-ba6c796cbc0f",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Ein Kunde einer Pizzeria dürfte einen gehörigen Schock erlebt haben, als sein Blick auf den Kassenzettel fiel: Ein Angestellter des Restaurants hatte darauf respektlose Worte hinterlassen.“"
                                            },
                                            {
                                                "example_id": "d0694205-8972-41a7-978c-71f6e73da939",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Double-Gewinner Niko Kovac vom FC Bayern München hat einen respektlosen Umgang mit den Fußball-Trainern in der Bundesliga beklagt.“"
                                            },
                                            {
                                                "example_id": "3d5dd527-f2f3-40ed-80e6-5802f61e0943",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Über Trumps respektlosen Umgang mit verheirateten Frauen hat auch Trumps ehemalige Geschäftspartnerin Jill Harth berichtet, die über einen längeren Zeitraum von ihm sexuell belästigt worden sein soll.“"
                                            },
                                            {
                                                "example_id": "0b5fdaf6-f058-429a-b0b9-cb023ee2c910",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Diskus-Olympiasieger Christoph Harting hat nach seinen respektlosen Äußerungen und herablassenden Sprüchen über Verband und Konkurrenten offenbar einen Denkzettel erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db91a4a5-b685-48ea-8f71-8e50236fb429",
                        "source_entry_id": "3469f5cb-173a-3489-ab0a-4dd34b9468aa",
                        "source_sense_id": "f35e74fe-8ad1-33cf-8009-396feba2de4d",
                        "target_lang_word": "unehrerbietig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unehrerbietig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ffd6d7d-6004-3c5b-86ab-ed303350482e",
                                        "entry_id": "a069245e-749b-36b5-b846-3a63a646b3b3",
                                        "glosses": [
                                            "keinen Respekt zeigend; verachtend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1216341-8cbe-4fd1-973d-6c1079171b96",
                                                "sense_id": "9ffd6d7d-6004-3c5b-86ab-ed303350482e",
                                                "text": "„Der Sünder bestritt vor Gericht, so unehrerbietig gesprochen zu haben, aber Zeugen wußten es besser.“"
                                            },
                                            {
                                                "example_id": "771d8b10-b583-477d-b0e3-63956d1be6a9",
                                                "sense_id": "9ffd6d7d-6004-3c5b-86ab-ed303350482e",
                                                "text": "„Je weiser der Monarch ist, desto mehr ist er imstande, sich einen respektlosen, unehrerbietigen und ikonoklastischen Narren zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d6a72c6-1624-4377-be61-ddff5556e91c",
                        "source_entry_id": "3469f5cb-173a-3489-ab0a-4dd34b9468aa",
                        "source_sense_id": "f35e74fe-8ad1-33cf-8009-396feba2de4d",
                        "target_lang_word": "despektierlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despektierlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ae8424f-aa22-3187-8c17-cad1d9bbd014",
                                        "entry_id": "47b21214-1372-31e5-b6c4-b801e753c344",
                                        "glosses": [
                                            "ohne Respekt, mit einem gewissen Grad an Missachtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d62140-c943-4be9-a107-71a5b1a50e59",
                                                "sense_id": "2ae8424f-aa22-3187-8c17-cad1d9bbd014",
                                                "text": "Er hat in despektierlicher Weise über mich gesprochen."
                                            },
                                            {
                                                "example_id": "97fd9499-9681-4b3e-94cc-7f44b878f17f",
                                                "sense_id": "2ae8424f-aa22-3187-8c17-cad1d9bbd014",
                                                "text": "„Für einen Großteil der Franzosen bleibt das Recht, sich auch despektierlich über Religionen äußern zu können, ein hohes Gut.“"
                                            },
                                            {
                                                "example_id": "8070d2ec-2018-4600-9339-a1673f90cde9",
                                                "sense_id": "2ae8424f-aa22-3187-8c17-cad1d9bbd014",
                                                "text": "„Ed Catmull ist der Inbegriff dessen, was man im Amerikanischen etwas despektierlich einen ‚Geek‘ nennt: jemand, der geradezu besessen ist von technischen Möglichkeiten eines Computers, der sich in Zahlen und Programmen verlieren kann.“"
                                            },
                                            {
                                                "example_id": "9f6946be-549f-4db3-a446-51fa45f3fffa",
                                                "sense_id": "2ae8424f-aa22-3187-8c17-cad1d9bbd014",
                                                "text": "„Betrachtet man Krisen als despektierliche Situationen, die man besser unter den Tisch kehrt?“"
                                            },
                                            {
                                                "example_id": "e9ce3be1-6bef-4365-9823-9e2f989deb8e",
                                                "sense_id": "2ae8424f-aa22-3187-8c17-cad1d9bbd014",
                                                "text": "„Auch den despektierlichen Begriff vom ‚Hausfrauensport‘ hört der deutsche Olympia-Curler immer mal wieder, aber nicht mehr so oft wie früher.“"
                                            },
                                            {
                                                "example_id": "b8547dbe-799c-4a35-be5b-ecd16cd20f38",
                                                "sense_id": "2ae8424f-aa22-3187-8c17-cad1d9bbd014",
                                                "text": "„Die Bundesregierung wies die despektierliche Äußerungen des amerikanische Kongressabgeordneten über den früheren Bundeskanzler mit ‚Deutlichkeit und Entschiedenheit‘ zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12e14a86-8e9a-43c3-9db2-b95d06272e96",
                        "source_entry_id": "3469f5cb-173a-3489-ab0a-4dd34b9468aa",
