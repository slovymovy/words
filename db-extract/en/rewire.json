                        "entry_id": "de8b30f4-5794-3015-9e17-f5705a0009f5",
                        "glosses": [
                            "To replace or reconnect the wires of a device or installation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3c5fb50-6e3c-4890-9bb8-649b72555c03",
                                "sense_id": "e5a5bbeb-afaa-3353-bede-d94aaf44fce5",
                                "text": "The electrician said that we couldn't add a new outlet without rewiring."
                            },
                            {
                                "example_id": "f90db9c5-39ed-4fe7-95bb-26c66d31748e",
                                "sense_id": "e5a5bbeb-afaa-3353-bede-d94aaf44fce5",
                                "text": "I had to rewire the circuit where the old wires had shorted out."
                            },
                            {
                                "example_id": "bbd977e2-f42c-4d4f-82d1-96caadbdcbb5",
                                "sense_id": "e5a5bbeb-afaa-3353-bede-d94aaf44fce5",
                                "text": "During those overhauls the locomotives were also rewired, updated, and had any corrosion dealt with."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7983f92-ceb3-3e9c-949b-3e9956594817",
                        "entry_id": "de8b30f4-5794-3015-9e17-f5705a0009f5",
                        "glosses": [
                            "To change the functionality of something by altering the parameters or logic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb275420-cf33-41a0-ab97-f79fb5a1f1e8",
                                "sense_id": "c7983f92-ceb3-3e9c-949b-3e9956594817",
                                "text": "When our companies merged, I rewired our payment processing system to handle their invoices as well."
                            }
                        ]
                    }
