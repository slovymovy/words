                        "sense_id": "a2fe0e35-f397-3f35-8b36-08caf90c02d0",
                        "entry_id": "9a21d1bc-d946-31e5-8f91-1dad82a4531b",
                        "glosses": [
                            "Relatif à Reims, commune française située dans le département de la Marne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aba6025-e5e8-4308-bbaa-eff1d37d6caf",
                                "sense_id": "a2fe0e35-f397-3f35-8b36-08caf90c02d0",
                                "text": "Dans la Marne, les deux immeubles récemment soufflés avaient le même bailleur, le Foyer rémois, qui tient à se faire discret."
                            },
                            {
                                "example_id": "b6ccc93e-8591-491e-ae78-70600d835c10",
                                "sense_id": "a2fe0e35-f397-3f35-8b36-08caf90c02d0",
                                "text": "Nous étions réunis, au dernier étage d'un bâtiment de béton qui donnait sur la campagne rémoise."
                            }
                        ]
                    },
