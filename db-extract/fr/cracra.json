                "senses": [
                    {
                        "sense_id": "2a03b47e-1d80-3efb-a60a-42ff2f3f9154",
                        "entry_id": "a9cb66fd-bc4d-39bd-bb33-4eeaf2f00933",
                        "glosses": [
                            "Sale."
                        ],
                        "tags": [
                            "childish"
                        ],
                        "examples": [
                            {
                                "example_id": "afc6428c-7a9c-498e-b436-5a0ba3bb58cb",
                                "sense_id": "2a03b47e-1d80-3efb-a60a-42ff2f3f9154",
                                "text": "Il est cracra comme une poubelle et son accoutrement ferait merveille sur la piste de Médrano."
                            },
                            {
                                "example_id": "acfc70d8-f034-4b9a-b697-c5f281bf3c3c",
                                "sense_id": "2a03b47e-1d80-3efb-a60a-42ff2f3f9154",
                                "text": "Pas plus que la tante Élise, tanguante de graisse mais vive, un peu cracra, chez elle je sortais de dessous le lit avec des dentelles de moutons accrochées à ma robe, je tournais et retournais une cuiller mal décrottée avant d’oser fendre la peau plissée de ma poire au jus."
                            },
                            {
                                "example_id": "0bfd996e-a4cc-432e-bd07-e8bf43633d9e",
                                "sense_id": "2a03b47e-1d80-3efb-a60a-42ff2f3f9154",
                                "text": "Des grosses bêtes\nDes choses pas sympa\nDes gros trucs cracras qui craignent grouillent et qu’ont les crocs"
                            },
                            {
                                "example_id": "cec98919-fff2-430e-a5ac-c92fcea08db1",
                                "sense_id": "2a03b47e-1d80-3efb-a60a-42ff2f3f9154",
                                "text": "Ainsi, il suffisait de mélanger 3,5 % d’huile cracra aux carburants fossiles — au lieu de 7 % — pour respecter le seuil de mélange."
                            }
                        ]
                    }
                ],
