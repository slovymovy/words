                                "example_id": "114ce8e8-2f23-489f-ab4e-0f4ffd1a4734",
                                "sense_id": "26846393-4ae3-3b80-b9ae-c3d18b8c7786",
                                "text": "Il explique à l’infirmier trieur qu’il s'est fait mal au dos... la semaine dernière... en faisant, à l’école, un cumulet."
                            },
                            {
                                "example_id": "2138a9ed-43e5-49b1-9be6-f3ce30aaa491",
                                "sense_id": "26846393-4ae3-3b80-b9ae-c3d18b8c7786",
                                "text": "Je crus un instant que j'étais sur le point de faire un cumulet."
