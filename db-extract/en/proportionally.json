                                                "sense_id": "d627d29d-03bc-3513-954a-b61758fcfca6",
                                                "text": "Il leur a parlé proportionnément à leur capacité."
                                            },
                                            {
                                                "example_id": "294f1e93-9b0f-4013-b378-8ad77c1ef474",
                                                "sense_id": "d627d29d-03bc-3513-954a-b61758fcfca6",
