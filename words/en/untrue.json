    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "abba8682-0fce-3326-8780-df5497ba2c21",
                    "sense_definition": "Not in accordance with fact or reality; false or incorrect.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "not_true",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She claimed that I stole her necklace, but that accusation is completely <w>untrue</w>.",
                            "target_lang_translations": {
                                "zh": "她声称我偷了她的项链，但那项指控完全<w>不符合事实</w>。"
                            }
                        },
                        {
                            "text": "The newspaper had to apologize after publishing an <w>untrue</w> story about the mayor.",
                            "target_lang_translations": {
                                "zh": "那家报纸在刊登了一篇关于市长的<w>不实</w>报道后不得不道歉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "false",
                        "inaccurate",
                        "incorrect",
                        "wrong",
                        "erroneous",
                        "fictitious"
                    ],
                    "antonyms": [
                        "true",
                        "accurate",
                        "correct",
                        "factual",
                        "right"
                    ],
                    "common_phrases": [
                        "completely untrue",
                        "entirely untrue",
                        "prove untrue"
                    ],
                    "target_lang_definitions": {
                        "zh": "不符合事实或现实的；虚假的或不正确的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不真实的",
                                "target_lang_sense_clarification": "指事情并非事实、与实际情况不符"
                            },
                            {
                                "target_lang_word": "假的",
                                "target_lang_sense_clarification": "指虚假、捏造的"
                            },
                            {
                                "target_lang_word": "不符合事实的",
                                "target_lang_sense_clarification": "正式语境，指内容失实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49c5f3dc-03cd-3681-82fe-65dadfe3db1a",
                    "sense_definition": "Not faithful or loyal to a partner, friend, or duty.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "disloyal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He suspected that his partner had been <w>untrue</w> to him during the trip.",
                            "target_lang_translations": {
                                "zh": "他怀疑伴侣在旅行期间对他<w>不忠</w>。"
                            }
                        },
                        {
                            "text": "A good soldier would never be <w>untrue</w> to the solemn oath they took.",
                            "target_lang_translations": {
                                "zh": "一名优秀的士兵绝不会<w>背弃</w>自己立下的庄严誓言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unfaithful",
                        "perfidious"
                    ],
                    "antonyms": [
                        "faithful",
                        "true"
                    ],
                    "common_phrases": [
                        "untrue to"
                    ],
                    "target_lang_definitions": {
                        "zh": "对伴侣、朋友或职责不忠诚或不忠实的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不忠的",
                                "target_lang_sense_clarification": "指背叛感情或违反誓言"
                            },
                            {
                                "target_lang_word": "不忠实的",
                                "target_lang_sense_clarification": "指对伴侣或职责不够忠诚"
                            },
                            {
                                "target_lang_word": "背叛的",
                                "target_lang_sense_clarification": "违背誓言或背离职责"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}