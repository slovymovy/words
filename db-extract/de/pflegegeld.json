                "senses": [
                    {
                        "sense_id": "88e9584a-c5dd-30ae-ac67-0aa4f27f8378",
                        "entry_id": "9a4baedc-f2e9-35e9-8e0b-6d4f630e227d",
                        "glosses": [
                            "Sozialleistung aufgrund erhöhten Pflegebedarfs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e3ef859-7acc-4af1-b3eb-0d9a7bb30328",
                                "sense_id": "88e9584a-c5dd-30ae-ac67-0aa4f27f8378",
                                "text": "„Von einer ‚besonderen Pflege- oder Betreuungsbedürftigkeit‘ könne bei einem Anspruch auf ein Pflegegeld ab der Pflegestufe 1 ausgegangen werden.“"
                            },
                            {
                                "example_id": "ba566041-003a-4249-ac6e-d5b6ee0ffe4a",
                                "sense_id": "88e9584a-c5dd-30ae-ac67-0aa4f27f8378",
                                "text": "„Insgesamt 451.372 Personen hatten laut den aktuellsten Daten aus dem Sozialministerium mit Stand Juni 2018 Anspruch auf Pflegegeld – um 2.173 bzw. 0,48 Prozent mehr als im Juni des Vorjahres.“"
                            },
                            {
                                "example_id": "251f78b2-57b3-4741-8989-16baa3917299",
                                "sense_id": "88e9584a-c5dd-30ae-ac67-0aa4f27f8378",
                                "text": "„Anlässlich der aktuellen Zahlen zu den Pflegegeldbeziehern erneuert Volksanwalt Günther Kräuter die Forderung der Volksanwaltschaft nach einer spürbaren Anhebung des Pflegegeldes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
