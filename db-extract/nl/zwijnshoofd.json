                                    {
                                        "sense_id": "e416072c-5e1f-36b8-b63f-45339aea6c46",
                                        "entry_id": "c7b13037-4049-301e-a985-7d4941fc3ea9",
                                        "glosses": [
                                            "Kopf eines Schweins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c4c9662-6708-48f5-8cad-55df1fe70f32",
                                                "sense_id": "e416072c-5e1f-36b8-b63f-45339aea6c46",
                                                "text": "„Es dauerte lange, bis er begriff, dass er einen Schweinekopf umarmt hatte.“"
                                            },
                                            {
                                                "example_id": "a1b90965-8e86-468b-bace-e4b0d05ebef0",
                                                "sense_id": "e416072c-5e1f-36b8-b63f-45339aea6c46",
                                                "text": "„Lai-sing hatte bald danach den Wein und den Schweinekopf eingekauft und zur Küche gebracht.“"
                                            },
                                            {
                                                "example_id": "7a78188f-717f-40eb-9023-7ea9c12e35e4",
                                                "sense_id": "e416072c-5e1f-36b8-b63f-45339aea6c46",
                                                "text": "„In Jaffa bewarfen die Leute die Hasan-Beik-Moschee mit Steinen, und einmal wurde sie durch einen Schweinekopf entweiht, den man mit dem Namen des Propheten versehen und in den Hof geworfen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
