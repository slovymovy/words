    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d66c12f-75e9-3a1e-9f02-ec9e0d1a334d",
                    "sense_definition": "Iemand of iets in contact brengen met een schadelijke invloed, gevaar of straling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gevaar_inwerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wetenschappers willen proefpersonen niet onnodig <w>blootstellen</w> aan gevaarlijke straling.",
                            "target_lang_translations": {
                                "pl": "Naukowcy nie chcą niepotrzebnie <w>narażać</w> osób badanych na niebezpieczne promieniowanie."
                            }
                        },
                        {
                            "text": "Hij <w>stelt</w> zijn gevoelige huid te lang <w>bloot</w> aan de felle zon.",
                            "target_lang_translations": {
                                "pl": "Zbyt długo <w>wystawia</w> swoją wrażliwą skórę na ostre słońce."
                            }
                        }
                    ],
                    "synonyms": [
                        "exponeren"
                    ],
                    "antonyms": [
                        "beschermen",
                        "behoeden"
                    ],
                    "common_phrases": [
                        "blootstellen aan gevaar",
                        "blootstellen aan straling"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wystawić kogoś lub coś na działanie szkodliwego czynnika, niebezpieczeństwa lub promieniowania."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "narażać",
                                "target_lang_sense_clarification": "na szkodliwy wpływ, niebezpieczeństwo (niedokonany)"
                            },
                            {
                                "target_lang_word": "wystawiać",
                                "target_lang_sense_clarification": "na działanie słońca, promieniowania (niedokonany)"
                            },
                            {
                                "target_lang_word": "nazić",
                                "target_lang_sense_clarification": "na niebezpieczeństwo (dokonany)"
                            },
                            {
                                "target_lang_word": "wystawić",
                                "target_lang_sense_clarification": "na działanie promieni, słońca (dokonany)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bf26979-4505-3f5e-b943-7f4a3a465313",
                    "sense_definition": "Zichzelf in een kwetsbare positie brengen ten opzichte van kritiek, risico's of bedreigingen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kwetsbaarheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politicus wilde zijn familie niet langer <w>blootstellen</w> aan nare bedreigingen.",
                            "target_lang_translations": {
                                "pl": "Polityk nie chciał dłużej <w>narażać</w> swojej rodziny na przykre groźby."
                            }
                        },
                        {
                            "text": "Door eerlijk te spreken over haar fouten, <w>stelt</w> zij zich bewust <w>bloot</w> aan kritiek.",
                            "target_lang_translations": {
                                "pl": "Mówiąc szczerze o swoich błędach, świadomie <w>naraża się</w> na krytykę."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich blootstellen aan kritiek"
                    ],
                    "target_lang_definitions": {
                        "pl": "Postawić siebie lub kogoś w trudnej sytuacji wobec krytyki, ryzyka lub gróźb."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "narażać się",
                                "target_lang_sense_clarification": "stawiać się w trudnej sytuacji, np. na krytykę"
                            },
                            {
                                "target_lang_word": "wystawiać się",
                                "target_lang_sense_clarification": "np. na pośmiewisko, zarzuty"
                            },
                            {
                                "target_lang_word": "narażać",
                                "target_lang_sense_clarification": "kogoś innego na nieprzyjemności lub groźby"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}