                        "glosses": [
                            "onder schooltijd zwemles krijgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f1bc836-b7a8-45f7-89c2-e6655834da05",
                                "sense_id": "83ca7489-e34d-348a-812b-9a6ba826f73d",
                                "text": "Het bestuur van het katholiek basisonderwijs Oudenaarde (KBO) heeft beslist om met onmiddellijke ingang het schoolzwemmen in het nieuwe stedelijk zwembad Sportoase op te schorten. Volgens het schoolbestuur is de veiligheid in het zwembad niet gegarandeerd."
                            },
                            {
                                "example_id": "13d78366-98b5-45ff-9329-001c2bdf67c6",
                                "sense_id": "83ca7489-e34d-348a-812b-9a6ba826f73d",
                                "text": "De dood van de jongen doet denken aan de dood van de 9-jarige Syrische Salam uit Rhenen. Het meisje verdronk tijdens het schoolzwemmen in zwembad 't Gastland in haar woonplaats. De zaak kreeg veel aandacht. Twee leerkrachten van Salam werden vrijgesproken van betrokkenheid bij haar dood. De drie aanwezige badmeesters kregen 60 uur werkstraf vanwege nalatigheid. De uitspraak zorgde voor veel emoties bij de betrokkenen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8b3b7ce-c4b9-3fc2-bd01-f406d62fbb9d",
                        "entry_id": "a2824fe1-da88-3dd9-92b7-001b028fd2a3",
                        "glosses": [
                            "zich met de schoolslag door het water verplaatsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "720c5c67-0dd9-4843-aa54-788afb5ecdb2",
                                "sense_id": "e8b3b7ce-c4b9-3fc2-bd01-f406d62fbb9d",
                                "text": "De Noor, drie jaar geleden in Eindhoven doorgebroken met de Europese titel op de 100 meter schoolzwemmen, zwom fabelachtige tijden."
                            },
                            {
                                "example_id": "de938cc0-4ccb-4ec3-aa20-eda052398e47",
                                "sense_id": "e8b3b7ce-c4b9-3fc2-bd01-f406d62fbb9d",
                                "text": "Hij dong in twee nummers mede, en wel in: Gekleed zwemmen, 150 meter, met 3 kilo kleeren in drogen toestand, en schoolzwemmen, 300 meter (Schulschwimmen), en won in beide nummers den prijs."
                            }
                        ]
                    }
