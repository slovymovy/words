                "senses": [
                    {
                        "sense_id": "43c10a47-c18d-35f3-a8a3-86afdecb1203",
                        "entry_id": "d31c1afa-98ca-3124-a05a-31f715502c99",
                        "glosses": [
                            "Celui qui gagne, qui gagne habituellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "129459cd-0c0d-41b1-9380-710ee2997bf8",
                                "sense_id": "43c10a47-c18d-35f3-a8a3-86afdecb1203",
                                "text": "Cela n’est pas bon à courir, mais peut-être en peut-on amuser le roi preneur de villes et gagneur de batailles : car encore faut-il amuser son héros."
                            },
                            {
                                "example_id": "fc60eef7-286a-452a-85fa-fdeba7f1cc06",
                                "sense_id": "43c10a47-c18d-35f3-a8a3-86afdecb1203",
                                "text": "Les conquérants, les gagneurs,\nÇa m’fait vomir, ça m’fait peur,\nJ’sais pas quelle folie les mène."
                            },
                            {
                                "example_id": "17bd66d7-1575-4c93-9b35-3599cf851c59",
                                "sense_id": "43c10a47-c18d-35f3-a8a3-86afdecb1203",
                                "text": "Chacun doit être un gagneur, sinon il n’a pas sa place parmi nous."
                            }
                        ]
                    }
                ],
