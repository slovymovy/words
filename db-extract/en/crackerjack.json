                                    {
                                        "sense_id": "6dec44a9-e9d1-327e-bcab-20bddf846e51",
                                        "entry_id": "60623282-3461-3eec-b1a7-db71a5429a42",
                                        "glosses": [
                                            "Geschütz mit flachem Abschusswinkel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d473f33-cdd2-4400-8dfc-4018ce0d2d83",
                                                "sense_id": "6dec44a9-e9d1-327e-bcab-20bddf846e51",
                                                "text": "ein Schiff mit acht Segeln und mit fünfzig Kanonen — (Bertolt Brecht)"
                                            },
                                            {
                                                "example_id": "59b6e22d-fe4a-416b-8b43-9c3baab79609",
                                                "sense_id": "6dec44a9-e9d1-327e-bcab-20bddf846e51",
                                                "text": "„Sie führte nun zwölf Kanonen und einige Petereros auf dem Schandeck, von denen sich vorher nicht eine darauf befunden hatte…“"
                                            },
                                            {
                                                "example_id": "52391b1b-a9d6-4459-9ced-ecef8edfb8d8",
                                                "sense_id": "6dec44a9-e9d1-327e-bcab-20bddf846e51",
                                                "text": "„Da er fürchtete, sein Schiff könne angegriffen werden, befahl Kapitän Mary, die Decks gefechtsklar zu machen, die Musketen zu laden und die Kanonen feuerbereit zu halten.“"
                                            },
                                            {
                                                "example_id": "fc2a9461-7161-4c52-858c-f9fab9a19c1b",
                                                "sense_id": "6dec44a9-e9d1-327e-bcab-20bddf846e51",
                                                "text": "„Im selben Moment ließ uns das Donnern einer Kanone zusammenfahren.“"
                                            },
                                            {
                                                "example_id": "22efa797-9562-4037-9405-9201827c23f4",
                                                "sense_id": "6dec44a9-e9d1-327e-bcab-20bddf846e51",
                                                "text": "„Am Abend krachte auf einmal eine Kanone dicht vor uns.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a6d3696-b4fe-38a6-a3a7-4ff1fbf51c93",
                                        "entry_id": "60623282-3461-3eec-b1a7-db71a5429a42",
                                        "glosses": [
                                            "Feuerwaffe"
                                        ],
                                        "tags": [
                                            "casual",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae66438-7874-4159-93f0-cb2a8ae4c08a",
                                                "sense_id": "2a6d3696-b4fe-38a6-a3a7-4ff1fbf51c93",
                                                "text": "Steck die Kanone weg!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "40da654e-2e4a-32b3-a0c4-b02a56d5fa09",
                                        "entry_id": "60623282-3461-3eec-b1a7-db71a5429a42",
