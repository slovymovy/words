                "senses": [
                    {
                        "sense_id": "a1a24d4d-93a1-32bb-9384-a720357e97e8",
                        "entry_id": "1ac9906e-29a9-353b-8099-bc88b37124e0",
                        "glosses": [
                            "Landschaft in Osteuropa, die im heutigen Polen und der Ukraine liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09ff510e-e3cd-4ab8-ad65-7f972513f565",
                                "sense_id": "a1a24d4d-93a1-32bb-9384-a720357e97e8",
                                "text": "Galizien umfasst Teile der Westukraine und Südpolens."
                            },
                            {
                                "example_id": "db92df6d-de60-4d24-89ab-59a2441ee2ac",
                                "sense_id": "a1a24d4d-93a1-32bb-9384-a720357e97e8",
                                "text": "„In Galizien war Michael Rosenfeld Unteroffizier in einem Ulanenregiment gewesen.“"
                            },
                            {
                                "example_id": "b9bbd106-3e3d-4bb3-8775-6e4ba7d4e9f9",
                                "sense_id": "a1a24d4d-93a1-32bb-9384-a720357e97e8",
                                "text": "„Im 19. Jahrhundert war Galizien die nördlichste Provinz der österreichisch-ungarischen Monarchie, ihren Untertanen garantierte die Verfassung von 1867 freie Religionsausübung und gleiche Rechte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fe50124-909c-4436-9d5c-bfeb01ef4444",
