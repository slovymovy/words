                    {
                        "sense_id": "87f6ee8e-e963-396f-81ee-3c4b7bf41ee6",
                        "entry_id": "ad360e46-5831-3bba-90ee-cc63b66d03ad",
                        "glosses": [
                            "Kolonie der spanischen Krone auf dem amerikanischen Kontinent"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2472f6c6-198f-4303-97ed-d536cdce512c",
                                "sense_id": "87f6ee8e-e963-396f-81ee-3c4b7bf41ee6",
                                "text": "„Ein exakter Atlas von Neuspanien, diktierte er Gomez, während er auf dem Rücke lag und das Teleskop auf den Nachthimmel richtete, könne die Besiedlung der Kolonie fördern, die Unterwerfung der Natur beschleunigen, das Geschick des Landes in eine günstige Richtung lenken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ced8593-2948-469e-ba83-544320fb2745",
                        "source_entry_id": "ad360e46-5831-3bba-90ee-cc63b66d03ad",
                        "source_sense_id": "87f6ee8e-e963-396f-81ee-3c4b7bf41ee6",
                        "source_sense_description": "historisch: Kolonie der spanischen Krone auf dem amerikanischen Kontinent",
                        "target_lang_word": "New Spain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "New Spain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e10f879-687b-355f-8158-de89bcf2c02f",
                                        "entry_id": "2febdb40-7595-3d75-b31d-936f89f599d1",
                                        "glosses": [
                                            "A former viceroyalty (a type of colony) in North America and Central America that existed from 1521 to 1821. It comprised of Spain's territorial possessions in the New World including the southwestern United States, Mexico, Central America, and the Philippines, established following the Spanish conquest of the Aztec Empire in 1521."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "329992ce-6790-4656-8183-f54cafc5d9d6",
                                                "sense_id": "2e10f879-687b-355f-8158-de89bcf2c02f",
                                                "text": "After Cortés the government of New Spain degenerated under the rule of Nuño de Guzmán, president of the first audiencia, into a brutish exploitation of the Indians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90912b22-a4a7-49b9-964c-ae9e7e6b4646",
                        "source_entry_id": "ad360e46-5831-3bba-90ee-cc63b66d03ad",
                        "source_sense_id": "87f6ee8e-e963-396f-81ee-3c4b7bf41ee6",
                        "source_sense_description": "historisch: Kolonie der spanischen Krone auf dem amerikanischen Kontinent",
                        "target_lang_word": "Nouvelle-Espagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nouvelle-Espagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "adbcb066-ed42-3468-a997-4a8326faf164",
                                        "entry_id": "2835cb39-593d-3389-a2aa-6708078cc27c",
                                        "glosses": [
                                            "Division administrative de l’ancien empire colonial espagnol, correspondant au Mexique, à presque toute l’Amérique centrale (du Mexique à la frontière méridionale du Costa Rica), à plusieurs États du sud des États-Unis (Californie, Arizona, Nouveau-Mexique, Texas) et aux Philippines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78054f60-ccd5-4c66-894c-f3eec4c48852",
                                                "sense_id": "adbcb066-ed42-3468-a997-4a8326faf164",
                                                "text": "Malgré trois siècles de recul et les enseignements des Lumières, il n’est pas exclu que les Aborigènes eussent eu pour les colons moins bonne presse dans l’Australie du XIXᵉ siècle que les Aztèques dans la Nouvelle-Espagne du XVIᵉ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
