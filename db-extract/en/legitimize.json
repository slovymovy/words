                    {
                        "translation_id": "b87a5122-9975-497f-9b95-8060b9d75ccd",
                        "source_entry_id": "89d4112d-d59e-377d-9d57-fe82fd2a0239",
                        "source_sense_id": "bcc02121-3838-36cf-8f6a-bea9ae9088ab",
