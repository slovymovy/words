                "senses": [
                    {
                        "sense_id": "2b73663a-fde8-338e-a5a5-16b61a3ac837",
                        "entry_id": "d5de9a4c-19cc-36e5-a9f6-c9a69f882567",
                        "glosses": [
                            "Gouvernement ou fonction d’un caïd."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d43225c-be1e-4c03-997c-db9ef7179606",
                                "sense_id": "2b73663a-fde8-338e-a5a5-16b61a3ac837",
                                "text": "Les anciens impôts basés sur le Koran sont supprimés et remplacés par des contributions nouvelles qui seront recueillies par des fonctionnaires spéciaux, au lieu de l’être par les caïds. Ceux-ci n’achèteront plus leur caïdat, mais toucheront des appointements fixes et n'exploiteront plus leurs administrés."
                            },
                            {
                                "example_id": "44f2d91e-1d21-4844-9dce-2fbd43ab5276",
                                "sense_id": "2b73663a-fde8-338e-a5a5-16b61a3ac837",
                                "text": "Le grand-vizir s’est réservé le caïdat paternel des Glaoua et ceux, très productifs des Mesfioua et des Touggana administrés par des khalifas."
                            },
                            {
                                "example_id": "12640907-de61-414b-ba16-bba1bca82ae3",
                                "sense_id": "2b73663a-fde8-338e-a5a5-16b61a3ac837",
                                "text": "Voulez-vous que je vous fasse comprendre par une fable ce qui se passe dans mon caïdat."
                            }
                        ]
                    }
                ],
