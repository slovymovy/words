                        "glosses": [
                            "Rendre paraplégique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "294e1eed-c2ef-4901-8979-2338ec8ac3fc",
                                "sense_id": "0025b9df-f796-3c8d-9e95-c0a51c24b133",
                                "text": "El Pilarico se promène en chaise roulante, après s'être fait \"paraplégiser\" par un toro le 22/09:1984 à Albacete."
                            },
                            {
                                "example_id": "569b9c4d-7703-4fce-8826-2c8a8da363b6",
                                "sense_id": "0025b9df-f796-3c8d-9e95-c0a51c24b133",
                                "text": "La fin arrive sans prévenir, une voix d'écorcheur, une guitare qui pleure des larmes de sang et les gourdins du combo qui vous paraplégisent."
                            },
                            {
                                "example_id": "a1f0ef0e-0a19-42a5-afae-e88766c1d046",
                                "sense_id": "0025b9df-f796-3c8d-9e95-c0a51c24b133",
                                "text": "si on ne transmet pas aux jeunes l'idéologie de la Chevalerie et l'Esprit Motard, l’Avenir donnera deux sortes de motards : des jeunes qui vont se tuer ou se paraplégiser ou bien des vieux qui vont rouler d'hôtels en maisons de retraite : il faut véhiculer l'Esprit Motard Originel SI ON veut conserver un air d'Aventure..."
                            }
                        ]
                    }
