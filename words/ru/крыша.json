            "senses": [
                {
                    "sense_id": "1a1075db-c493-3cb2-9ce7-2c1b26f009d3",
                    "sense_definition": "Верхняя ограждающая конструкция здания или транспортного средства, защищающая от осадков.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "roof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В зависимости от уклона <w>крыши</w> условно делят на плоские и скатные."
                        },
                        {
                            "text": "Дождь всё барабанил и барабанил по <w>крыше</w> авто, мы молчали."
                        }
                    ],
                    "synonyms": [
                        "кро́вля"
                    ],
                    "antonyms": [
                        "фундамент"
                    ],
                    "common_phrases": [
                        "под крышей"
                    ]
                },
                {
                    "sense_id": "3e41926f-3bd3-34b9-b20f-ddfd87a55671",
                    "sense_definition": "Жилище или дом как место для проживания.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "home",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я за всю жизнь не заработал ни земли, ни собственной <w>крыши</w> над головой."
                        },
                        {
                            "text": "Многие люди в этом городе до сих пор не имеют надежной <w>крыши</w>."
                        }
                    ],
                    "synonyms": [
                        "кров",
                        "дом"
                    ],
                    "common_phrases": [
                        "крыша над головой"
                    ]
                },
                {
                    "sense_id": "80e83ac5-eca4-3977-8fee-904b96fde98a",
                    "sense_definition": "Группировка или структура, обеспечивающая кому-либо защиту и покровительство.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждая преступная группировка стремится стать <w>крышей</w> для коммерческих структур."
                        },
                        {
                            "text": "Бандиты требовали денег за свою <w>крышу</w>."
                        }
                    ],
                    "synonyms": [
                        "крышняк",
                        "крышак"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "криминальный жаргон"
                        }
                    ]
                },
                {
                    "sense_id": "ef0335e7-4807-33a7-9cf3-7552e6befdb7",
                    "sense_definition": "Голова или рассудок человека.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У неё нервы разбиты, <w>крыша</w> совсем не в порядке."
                        },
                        {
                            "text": "От таких новостей у любого человека может поехать <w>крыша</w>."
                        }
                    ],
                    "common_phrases": [
                        "крыша едет",
                        "крыша не в порядке"
                    ],
                    "traits": [
