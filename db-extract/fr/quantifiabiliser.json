                "senses": [
                    {
                        "sense_id": "7ef421fa-d45e-33b8-b6a1-0c737ea382d2",
                        "entry_id": "391edda8-7e7b-3a33-8ac9-7e1e9fe87509",
                        "glosses": [
                            "Rendre quantifiable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fc13044-0b84-49eb-95b7-f6d89dd8ad85",
                                "sense_id": "7ef421fa-d45e-33b8-b6a1-0c737ea382d2",
                                "text": "S’appuyant sur les vues de Culioli, tous deux ont montré que la fonction linguistique des C1N étaient de quantifiabiliser les noms, dans des langues où ils fonctionnent presque tous comme denses."
                            },
                            {
                                "example_id": "4bf48abf-1c91-48a6-a09b-d41d5c609097",
                                "sense_id": "7ef421fa-d45e-33b8-b6a1-0c737ea382d2",
                                "text": "Pour les notions auxquelles est associée la propriété /discontinu/, quantifiabiliser reviendra à construire la classe des occurrences constitutives de N."
                            }
                        ]
                    }
