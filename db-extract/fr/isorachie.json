                        "examples": [
                            {
                                "example_id": "4346d8f0-4837-4953-ba26-212fdd7bf24d",
                                "sense_id": "41f168db-880e-3800-b73f-2a199155119e",
                                "text": "Des courbes d’égal niveau ont été construites pour montrer quelle est, à un instant donné, la hauteur de la marée sur une certaine étendue de la mer. Ces courbes ont été appelées isorachies."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ee35691-d9d9-342f-b662-bd4ad208381f",
                        "entry_id": "720bfa0a-7761-3333-b9ea-fd8377e13c00",
                        "glosses": [
                            "Valeur horaire en un point d’une ligne cotidale."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "152e5738-af9f-4fa1-b630-c40b9bc9795f",
                                "sense_id": "5ee35691-d9d9-342f-b662-bd4ad208381f",
                                "text": "Il s’ensuivait que plus un pays se trouvait éloigné de Gibraltar et plus son isorachie était forte ou, autrement, plus grand était son retard de marée."
                            }
                        ]
                    }
