                "senses": [
                    {
                        "sense_id": "070a4860-6253-3bd8-a9d3-0dd7f1a1529a",
                        "entry_id": "57bc2de4-9d3e-324e-bed3-0530e49a5748",
                        "glosses": [
                            "Reihe von drei Personen oder Objekten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e37ed35-1a0c-4be2-b340-172fa2a9eb7a",
                                "sense_id": "070a4860-6253-3bd8-a9d3-0dd7f1a1529a",
                                "text": "„Falls sie es ertragen, eventuell ein paar Stunden lang von einem Fremden in der Mitte auf Abstand gehalten zu werden, können sie auch einen Trick versuchen: Sie buchen im hinteren Teil der Maschine in einer Dreierreihe die beiden äußeren Plätze.“"
                            },
                            {
                                "example_id": "39cd7b9e-1387-42ba-93d8-d3c0a60ace72",
                                "sense_id": "070a4860-6253-3bd8-a9d3-0dd7f1a1529a",
                                "text": "„Wenn ein Flieger nicht ausgebucht ist, hat man gute Chancen, zu zweit eine ganze Dreierreihe zu bekommen, wenn man den Fenster- und den Gangplatz bucht.“"
                            },
                            {
                                "example_id": "b2b65e2e-0802-42a4-b097-07fb649f86d8",
                                "sense_id": "070a4860-6253-3bd8-a9d3-0dd7f1a1529a",
                                "text": "„Dabei wies er auf die Dreiherreihe, die unten am Ärmel von Roberts Jackett aufgesetzt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
