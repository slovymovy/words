                    {
                        "sense_id": "d4bde028-ee69-37fa-8a42-7f3426342cdd",
                        "entry_id": "76c12459-5c2e-3902-a58b-208a4b92b506",
                        "glosses": [
                            "Donner une couleur moutarde à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cd27f18-33fe-48ec-9241-cc9a841c9860",
                                "sense_id": "d4bde028-ee69-37fa-8a42-7f3426342cdd",
                                "text": "Pas de H&M chez moi ni de COS, quel dommage j'aurais bien moutardiser tout ça moi, à ce que je lis on est toute copine de foulard, le gris plissé est en vente chez Camaieu pour 12e jcrois ben oui c’est malheureux !"
                            },
                            {
                                "example_id": "c5a9cb21-dba2-468c-8921-0a082f80dc47",
                                "sense_id": "d4bde028-ee69-37fa-8a42-7f3426342cdd",
                                "text": "L’air ahuri de Germaine, ses gestes suspendus, son cloaque buccal béant, sa respiration coupée, son tailleur jaune moutardisé."
                            }
                        ]
                    },
                    {
                        "sense_id": "84c1e89c-02f2-3ae7-92e7-7b3f469eb823",
                        "entry_id": "76c12459-5c2e-3902-a58b-208a4b92b506",
                        "glosses": [
                            "Prendre une couleur moutarde."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "08e1e2ac-0b2a-4fe8-b6a1-9664381d364c",
                                "sense_id": "84c1e89c-02f2-3ae7-92e7-7b3f469eb823",
                                "text": "La console fonctionne a merveille et le temps ne l'a pas trop fait « moutardiser » (couleur que prend les plastiques Nintendo de l'époque)."
                            }
                        ]
                    }
