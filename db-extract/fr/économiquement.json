                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fda1195a-355f-4df4-8a69-266dcd3dffcf",
                        "source_entry_id": "bb3e40fd-ab55-38fc-8b55-dc41ba164767",
                        "source_sense_id": "9b073c32-5b60-3879-b9fa-306c78aa4189",
                        "source_sense_description": "Selon les principes de l'économie politique",
                        "target_lang_word": "nach volkswirtschaftlichen Grundsätzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f13194e7-adbc-4d9d-b124-a896c90dfea6",
                        "source_entry_id": "bb3e40fd-ab55-38fc-8b55-dc41ba164767",
                        "source_sense_id": "9b073c32-5b60-3879-b9fa-306c78aa4189",
                        "source_sense_description": "Du point de vue économique",
                        "target_lang_word": "wirtschaftlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wirtschaftlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f132a37-41f6-3b05-98ee-c9c4f8972cb1",
                                        "entry_id": "23125f56-84fe-3771-a5a8-e019c1888d12",
                                        "glosses": [
                                            "die Wirtschaft, eine Volks- oder Betriebswirtschaft betreffend; ökonomisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8a55006-f5ba-486a-bc41-622c62bf4238",
                                                "sense_id": "2f132a37-41f6-3b05-98ee-c9c4f8972cb1",
                                                "text": "Das Ministerium ist für wirtschaftliche Fragen zuständig."
                                            },
                                            {
                                                "example_id": "1a1d8d8d-d72a-4523-87de-6e6fb4cda2c0",
                                                "sense_id": "2f132a37-41f6-3b05-98ee-c9c4f8972cb1",
                                                "text": "„In Kontinentaleuropa und besonders in Frankreich betrachtet man die ersten Nachkriegsjahrzehnte, die von starken staatlichen Eingriffen geprägt waren, als eine segensreiche Zeit des Wachstums und macht häufig die um 1980 eingeleitete wirtschaftliche Liberalisierung für seinen Rückgang verantwortlich.“"
                                            },
                                            {
                                                "example_id": "f7d8a90a-3e55-471d-8a22-b708ed353042",
                                                "sense_id": "2f132a37-41f6-3b05-98ee-c9c4f8972cb1",
                                                "text": "Brasilien steckt in einer der schwersten Rezessionen seit Jahrzehnten. Das Land hofft jedoch auf wirtschaftliche Impulse durch die eben zu Ende gegangenen Olympischen Spiele. Doch die dürften gering ausfallen, glaubt man Experten."
                                            },
                                            {
                                                "example_id": "e1b5e40b-3821-456a-bc6e-37edb527ec60",
                                                "sense_id": "2f132a37-41f6-3b05-98ee-c9c4f8972cb1",
                                                "text": "„Den USA geht es nicht gut. Die republikanischen und demokratischen Regionen driften wirtschaftlich auseinander.“"
                                            },
                                            {
                                                "example_id": "1a53ae9a-9e34-4076-92db-7bdbd2926682",
                                                "sense_id": "2f132a37-41f6-3b05-98ee-c9c4f8972cb1",
                                                "text": "„Aber die Grenzsprengung auf der wirtschaftlichen Seite hat zwangsweise die Grenzsprengung auf der sozial-gesellschaftlichen Seite zur Folge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6cccb272-1b7b-3f6a-bcdc-8ea9c630d482",
                                        "entry_id": "23125f56-84fe-3771-a5a8-e019c1888d12",
                                        "glosses": [
                                            "dem Prinzip der Wirtschaftlichkeit folgend; so, dass es sich rechnet und ein Gewinn entsteht"
                                        ],
                                        "tags": [
                                            "mit",
                                            "Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fb60efc-bc32-439a-8697-4132abde5ff6",
                                                "sense_id": "6cccb272-1b7b-3f6a-bcdc-8ea9c630d482",
                                                "text": "Investitionen müssen wirtschaftlich sein."
                                            },
                                            {
                                                "example_id": "4e4b98fd-f550-4d90-94bb-d6fb725bd606",
                                                "sense_id": "6cccb272-1b7b-3f6a-bcdc-8ea9c630d482",
                                                "text": "Grundsatz der Produktionslehre: Nur die Produktion am technologischen Rand ist wirtschaftlich."
                                            },
                                            {
                                                "example_id": "bddcd46d-6fdb-44af-8cab-90865b5af2d1",
                                                "sense_id": "6cccb272-1b7b-3f6a-bcdc-8ea9c630d482",
                                                "text": "Unterdessen saß Physikprofessor Dyson als Experte in der Operationszentrale des Bomber Command, \"kalkulierte, wie man auf wirtschaftlichste Weise weitere 100 000 Leute ermordet\" - obwohl doch, wie er dann 1984 schrieb, der Protest dagegen seine moralische Pflicht gewesen wäre."
                                            },
                                            {
                                                "example_id": "1ebb9a10-aaae-46e8-acc0-6306bf69c1f1",
                                                "sense_id": "6cccb272-1b7b-3f6a-bcdc-8ea9c630d482",
                                                "text": "Ein Zinssatz unter 2% ist zur Zeit nicht wirtschaftlich, da er unter der Teuerungsrate liegt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "28c34b52-b5ed-3789-b616-26815ca23365",
                                        "entry_id": "23125f56-84fe-3771-a5a8-e019c1888d12",
                                        "glosses": [
                                            "Fragen des Geldes und der Finanzen betreffend; finanziell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82d868f9-e9af-4997-9c88-27fe2420d74f",
                                                "sense_id": "28c34b52-b5ed-3789-b616-26815ca23365",
                                                "text": "Seine Schwiegereltern in spe haben erst einmal seine wirtschaftliche Situation durchleuchtet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
