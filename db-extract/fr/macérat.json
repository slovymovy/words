        "fr-extract.jsonl": [
            {
                "entry_id": "ffd29b8c-1c01-3fd3-aeeb-a0cb526b18d1",
                "word": "macérat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8468801c-d843-4abe-afd3-aef7b534ef9b",
                        "entry_id": "ffd29b8c-1c01-3fd3-aeeb-a0cb526b18d1",
                        "tags": [
                            "plural"
                        ],
                        "form": "macérats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06d64d42-51c7-365f-972c-eb09ff9c0d56",
                        "entry_id": "ffd29b8c-1c01-3fd3-aeeb-a0cb526b18d1",
                        "glosses": [
                            "Résultat de la macération."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f14339a7-1a36-4485-9ece-a7a2a3d88627",
                                "sense_id": "06d64d42-51c7-365f-972c-eb09ff9c0d56",
                                "text": "Quelle qu'ait été la forme sous laquelle le poivre ou ses dérivés furent employés, qu'il se soit agi d'inhalations de poivre en poudre, en macérat, en fumée de poivre ou de pipérine, d'injections de macérat alcoolique ou de pipérine, nous nous sommes trouvés en présence d'une inondation alvéolaire de leucocytes."
                            },
                            {
                                "example_id": "ccbb46bd-74e0-442d-9fbb-8196e89b4638",
                                "sense_id": "06d64d42-51c7-365f-972c-eb09ff9c0d56",
                                "text": "J'ai répété cette expérience, avec un mode opératoire un peu modifié, et j'ai trouvé avec des macérats de chou, chauffés pour détruire les ferments, après 24 heures, des pertes de 13 et 18% de la vitamine C qui avait été dissoute dans les dans les différents macérats après la destruction des ferments."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38dd1c4b-8ea1-4ded-a20c-7484206716b9",
                        "source_entry_id": "ffd29b8c-1c01-3fd3-aeeb-a0cb526b18d1",
                        "source_sense_id": "06d64d42-51c7-365f-972c-eb09ff9c0d56",
                        "target_lang_word": "macerate",
