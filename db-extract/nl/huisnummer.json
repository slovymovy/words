                        "entry_id": "8beb8167-d045-3187-a41b-91c16d55b2db",
                        "glosses": [
                            "het nummer dat door de overheid aan een opstal wordt gegeven en een onderdeel vormt van het adres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8092e28f-61c9-4f96-804e-ce50deaf5bb9",
                                "sense_id": "34ff06cf-c980-3e6e-9c2f-3ac325e4c710",
                                "text": "Op huisnummer 5 woont een ouder stel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73fba56f-ef49-4b67-a9bd-709e4438031c",
                        "source_entry_id": "8beb8167-d045-3187-a41b-91c16d55b2db",
                        "source_sense_id": "34ff06cf-c980-3e6e-9c2f-3ac325e4c710",
                        "target_lang_word": "Hausnummer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausnummer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f104d08c-ac86-3e86-b9f5-e556441a92c0",
                                        "entry_id": "ef37a08a-302f-3274-95e4-7ebddf8dfe8e",
                                        "glosses": [
                                            "die eindeutige Nummer eines Gebäudes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9bea6ef-73da-4bbf-a33d-2de04b3d846e",
                                                "sense_id": "f104d08c-ac86-3e86-b9f5-e556441a92c0",
                                                "text": "„Wir haben die Hausnummer 10.“"
                                            },
                                            {
                                                "example_id": "d543e28c-1617-4b9a-a6de-675d1bd68f8d",
                                                "sense_id": "f104d08c-ac86-3e86-b9f5-e556441a92c0",
                                                "text": "Die Hausnummer ist ein Bestandteil der Adresse."
                                            },
                                            {
                                                "example_id": "8d0b4411-41e8-4a91-b23f-51d7a107061f",
                                                "sense_id": "f104d08c-ac86-3e86-b9f5-e556441a92c0",
                                                "text": "„Melanie stand vor der Hausnummer, die Andreas ihr genannt hatte.“"
                                            },
                                            {
                                                "example_id": "8af9774f-9b9f-4525-9e14-8347392a71d9",
                                                "sense_id": "f104d08c-ac86-3e86-b9f5-e556441a92c0",
                                                "text": "„Elma fuhr im Schritttempo und versuchte die Hausnummern zu erkennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c33d4abc-21ad-3a05-a482-4ddba1eb81f3",
                                        "entry_id": "ef37a08a-302f-3274-95e4-7ebddf8dfe8e",
                                        "glosses": [
                                            "grobe Schätzung oder ungenaue Angabe einer Zahl, auf die man sich zum Beispiel nicht festlegen lassen will, Zahl, die keinen Wert darstellt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecd54a77-aa9a-44a2-b90b-5f9f26039d74",
                                                "sense_id": "c33d4abc-21ad-3a05-a482-4ddba1eb81f3",
                                                "text": "Kann mir jemand mal eine Hausnummer nennen, was man momentan in diesem Tätigkeitsbereich als Jahresgehalt erwarten dürfte?"
                                            },
                                            {
                                                "example_id": "fa30f833-c9f0-4a70-bf8f-1b431bc90322",
                                                "sense_id": "c33d4abc-21ad-3a05-a482-4ddba1eb81f3",
                                                "text": "Das Messgerät war nicht geeicht, deshalb wurden nur Hausnummern gemessen."
                                            },
                                            {
                                                "example_id": "588e66fe-5412-44b4-8ad8-98cab8a15f84",
                                                "sense_id": "c33d4abc-21ad-3a05-a482-4ddba1eb81f3",
                                                "text": "„Ferner muss eine Qualitätskontrolle eingebaut sein, die auf Störungen hinweist, um keine „Hausnummern\" zu messen, sondern möglichst genaue, interpretierbare Werte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
