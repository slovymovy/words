                },
                {
                    "sense_id": "a8193d93-b770-38aa-b8f0-1f0328deb87a",
                    "sense_definition": "In cricket, referring to a fielding position very close to the batsman.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cricket",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain decided to place a fielder at <w>silly</w> point to pressure the batsman.",
                            "target_lang_translations": {
                                "ru": "Капитан решил поставить полевого игрока в позицию <w>силли</w>-пойнт, чтобы оказать давление на бьющего.",
                                "tr": "Kaptan, vurucu üzerinde baskı kurmak için <w>silly</w> point pozisyonuna bir saha oyuncusu yerleştirmeye karar verdi.",
                                "de": "Der Kapitän entschied, einen Feldspieler an den <w>Silly</w> Point zu stellen, um den Schlagmann unter Druck zu setzen."
                            }
                        },
                        {
                            "text": "Standing at <w>silly</w> mid-on requires great reflexes and courage.",
                            "target_lang_translations": {
                                "ru": "Нахождение в позиции <w>силли</w>-мид-он требует отличных рефлексов и мужества.",
                                "tr": "<w>Silly</w> mid-on pozisyonunda durmak harika refleksler ve cesaret gerektirir.",
                                "de": "An der Position <w>Silly</w> Mid-on zu stehen, erfordert großartige Reflexe und Mut."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silly point",
                        "silly mid-on"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in cricket-playing regions"
