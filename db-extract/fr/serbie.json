                "forms": [
                    {
                        "form_id": "aff88530-43dd-451c-89e8-d418bd452e19",
                        "entry_id": "8c1571aa-8259-34e7-92aa-d001b06704bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "Serbies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5db4e3a-899a-3eb9-bf33-48b97fec0f7b",
                        "entry_id": "8c1571aa-8259-34e7-92aa-d001b06704bc",
                        "glosses": [
                            "Pays des Serbes, dans les Balkans, bordé au nord par la Hongrie, à l’est par la Roumanie et la Bulgarie, au sud par la Macédoine du Nord et l’Albanie, et à l’ouest par le Monténégro, la Bosnie-Herzégovine et la Croatie, et dont la capitale est Belgrade."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "38a2af96-366c-4cbe-91df-3dd5bb4fbe85",
                                "sense_id": "b5db4e3a-899a-3eb9-bf33-48b97fec0f7b",
                                "text": "Duvalius djokovici, c’est le nom scientifique choisi pour l’arthropode, est une espèce endémique – c’est-à-dire qu’il y vit exclusivement – d’une grotte du mont Povlen, située dans l’ouest de la Serbie."
                            },
                            {
                                "example_id": "919c117e-f590-4cb5-960e-b1821eee65b4",
                                "sense_id": "b5db4e3a-899a-3eb9-bf33-48b97fec0f7b",
                                "text": "L’austrophilie a regagné considérablement du terrain en Serbie et elle n’en a jamais perdu dans la Valachie."
                            },
                            {
                                "example_id": "e8f0697d-9f48-4620-9a79-2ad8f0626cbf",
                                "sense_id": "b5db4e3a-899a-3eb9-bf33-48b97fec0f7b",
                                "text": "Ces dernières années, plusieurs projets de production de lithium se sont confrontés à de fortes oppositions locales, de la région de Loznica, en Serbie, à Tréguennec (Finistère), en passant par le Portugal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f31215e0-da97-4ca0-a467-b78c97c58d3f",
                        "source_entry_id": "8c1571aa-8259-34e7-92aa-d001b06704bc",
                        "source_sense_id": "b5db4e3a-899a-3eb9-bf33-48b97fec0f7b",
                        "source_sense_description": "Pays d’Europe",
                        "target_lang_word": "Serbien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Serbien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                        "entry_id": "ec945141-22b6-3f97-9825-13c022806f1b",
                                        "glosses": [
                                            "Staat in Südosteuropa"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ce9d3eb-9887-4c45-93a6-c3d411044e04",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "Ich komme aus Serbien."
                                            },
                                            {
                                                "example_id": "eccfd2a3-34c6-4e9e-9798-54244f7bf8b3",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "Belgrad ist die Hauptstadt der Republik Serbien."
                                            },
                                            {
                                                "example_id": "3bd1a4a5-ec86-4629-b158-524f5bb84c9e",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "Alle wichtigen Verkehrswege Südosteuropas kreuzen sich in Serbien."
                                            },
                                            {
                                                "example_id": "fe707f9c-ce5d-4471-80bb-6ffd66f9f087",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "„Ich hatte Sébastien und seine hübsche Freundin Anis vor einer knappen Woche beim Donaudurchbruch in Serbien getroffen.“"
                                            },
                                            {
                                                "example_id": "96b70474-6c97-4c53-a358-fc30ea2c6efd",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "„Doch sosehr sie die Arbeit, die sie in Serbien verrichtete, schätzte, es war nicht ihre Art von Arbeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8977590-07fe-4778-a6a7-6d097e84970b",
                        "source_entry_id": "8c1571aa-8259-34e7-92aa-d001b06704bc",
