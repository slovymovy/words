                    {
                        "form_id": "df1f3546-0d9f-401e-b9c5-061c12c14a13",
                        "entry_id": "f825141a-d0e6-3be6-8fa7-99afd549e5d0",
                        "tags": [
                            "accusative",
                            "plural"
