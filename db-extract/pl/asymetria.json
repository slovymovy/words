        "pl-extract.jsonl": [
            {
                "entry_id": "9cf85975-6c13-3390-98fc-9c5533816751",
                "word": "asymetria",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dd3795b9-8d2f-383f-844c-fe8b20b8d919",
                        "entry_id": "9cf85975-6c13-3390-98fc-9c5533816751",
                        "glosses": [
                            "brak wzajemnej odpowiedniości części względem osi, punktu lub płaszczyzny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff8e7fdc-6d8d-4c31-94e7-818e7bd6c75f",
                                "sense_id": "dd3795b9-8d2f-383f-844c-fe8b20b8d919",
                                "text": "Flądry charakteryzują się asymetrią budowy ciała"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3ba93b6e-4c82-3794-a2a7-544922f2dfc1",
                        "entry_id": "9cf85975-6c13-3390-98fc-9c5533816751",
                        "glosses": [
                            "nierównomierny rozkład cech, wartości, sił lub zasobów w relacji, systemie czy strukturze"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "77a64e52-34b0-4e98-afba-f1fe5081ee2f",
                                "sense_id": "3ba93b6e-4c82-3794-a2a7-544922f2dfc1",
                                "text": "Relacja lekarz–pacjent nie jest spotkaniem równorzędnych stron, lecz charakteryzuje się asymetrią, w której to lekarz zazwyczaj znajduje się w pozycji władzy."
                            },
                            {
                                "example_id": "2b45fb14-f7f5-4609-9e1c-40cc0853772e",
                                "sense_id": "3ba93b6e-4c82-3794-a2a7-544922f2dfc1",
                                "text": "Specyfika rynków finansowych sprzyja występowaniu znacznej asymetrii informacyjnej."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb764ef2-7357-47c1-879c-f46e46f91ad8",
                        "source_entry_id": "9cf85975-6c13-3390-98fc-9c5533816751",
                        "source_sense_id": "dd3795b9-8d2f-383f-844c-fe8b20b8d919",
                        "target_lang_word": "asymmetry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asymmetry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61b83fd2-67a3-337e-b7b2-c2f42c21e0d6",
                                        "entry_id": "a330700b-d9d1-33aa-9803-4e75306f9719",
                                        "glosses": [
                                            "Absence of symmetry or proportion between the parts of a thing, or a distinction that produces such a lack of symmetry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18fd8c6b-91d4-4dde-83cf-aeac7232d9c2",
                                                "sense_id": "61b83fd2-67a3-337e-b7b2-c2f42c21e0d6",
                                                "text": "Despite the generally symmetrical appearance of the two hemispheres, however, a number of biological asymmetries have been documented during the last hundred years."
                                            },
                                            {
                                                "example_id": "aa16f9ea-afb6-4079-a7d2-8081ed539055",
                                                "sense_id": "61b83fd2-67a3-337e-b7b2-c2f42c21e0d6",
                                                "text": "If the planet is on moderate eccentric orbit (0.01), it creates large-scale azimuthal assymetries which evolve at the orbital velocity of the corresponding resonance, for example at half time the planet velocity for the stronger resonance, the 2:1 one."
                                            },
                                            {
                                                "example_id": "474b7c63-4325-4c59-b164-6b5eeb1916b0",
                                                "sense_id": "61b83fd2-67a3-337e-b7b2-c2f42c21e0d6",
                                                "text": "In this sense, the concern of political economy with assymetries of information among political actors is well-placed."
                                            },
                                            {
                                                "example_id": "6d2fd9d8-8b63-435f-b016-3cbec065ef9c",
                                                "sense_id": "61b83fd2-67a3-337e-b7b2-c2f42c21e0d6",
                                                "text": "Transnational feminists argue that feminists need to understand the material conditions that shape women's lives in diverse locations, particularly in a world \"structured by transnational economic links and cultural assymetries\" (Grewal and Kaplan, 3)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7b5906b-5801-322f-86a8-62998473640c",
                                        "entry_id": "a330700b-d9d1-33aa-9803-4e75306f9719",
                                        "glosses": [
                                            "The lack of a common measure between two objects or quantities; incommensurability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ccbd4508-77dd-4e4c-8d95-e764c51dd198",
                        "source_entry_id": "9cf85975-6c13-3390-98fc-9c5533816751",
                        "source_sense_id": "3ba93b6e-4c82-3794-a2a7-544922f2dfc1",
