                "senses": [
                    {
                        "sense_id": "25f78a12-8ca7-3c1a-8dc4-7500ff7a2847",
                        "entry_id": "df6dce80-c6e5-3dd3-9f4e-3d763039914b",
                        "glosses": [
                            "To make or adorn (something) with curlicues, or as if with curlicues."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a84fec49-c144-454f-b9ff-47ec27f5d363",
                                "sense_id": "25f78a12-8ca7-3c1a-8dc4-7500ff7a2847",
                                "text": "A chandelier the shape of an anchor, hanging over Smith's head as he passed out through this vestibule. Walls curlicued with comb marks of some fancy plasterer."
                            },
                            {
                                "example_id": "05f6d3af-98ce-4c79-b47d-c8db3f18d541",
                                "sense_id": "25f78a12-8ca7-3c1a-8dc4-7500ff7a2847",
                                "text": "I was looking, obliquely, at Bunny slumped over his bowl when all of a sudden, in the window behind his head, I saw the distant figure of Mr. Hatch, walking across the open field beyond the garden, carrying the dark, curlicued ruins of the Malacca chair to the rubbish heap."
                            },
                            {
                                "example_id": "2658758d-3afd-42a7-99d0-f4b2622dcf55",
                                "sense_id": "25f78a12-8ca7-3c1a-8dc4-7500ff7a2847",
                                "text": "“Here We Go Again” is the gentlest kiss-off imaginable, with strings and harp and curlicued guitars cushioning Ms. Stone’s farewell[…]"
                            }
                        ]
                    }
