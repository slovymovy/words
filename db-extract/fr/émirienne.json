                        "sense_id": "a2773d67-437e-3e4a-853c-9c5ecc95a452",
                        "entry_id": "6d06cfe2-d9dd-3547-9996-7fde4cf3f132",
                        "glosses": [
                            "Habitante des Émirats arabes unis, ou qui en est originaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9704a9f-1c56-4cc2-8770-0c9ee9de9823",
                                "sense_id": "a2773d67-437e-3e4a-853c-9c5ecc95a452",
                                "text": "Ce maillage serré qui s’est maintenant ouvert sur l’international permet ainsi à 80% des Émiriens et 95% des Émiriennes inscrits dans les classes Terminales de demander une poursuite d’études aux Émirats mêmes, ou à l’étranger."
                            },
                            {
                                "example_id": "7281448f-4e8b-43f3-97a7-41c1fba9b89b",
                                "sense_id": "a2773d67-437e-3e4a-853c-9c5ecc95a452",
                                "text": "Il va sans dire que la politique d’émiratisation n’a jamais visé à faire travailler les Émiriens sur les chantiers de travaux publics ou à confier les caisses des supermarchés à des Émiriennes."
                            }
                        ]
                    }
