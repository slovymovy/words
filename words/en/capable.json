{
    "word_family": [
        "capability",
        "capably",
        "incapable",
        "incapability"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "71b1c977-3a88-34ed-81f3-f6dcb7db9a85",
                    "sense_definition": "Having the necessary ability, power, or fitness to do something successfully.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a highly <w>capable</w> manager who handles every crisis with calm and efficiency.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>способный</w> менеджер, который справляется с любым кризисом спокойно и эффективно."
                            }
                        },
                        {
                            "text": "The young athlete proved she was <w>capable</w> of winning the gold medal.",
                            "target_lang_translations": {
                                "ru": "Молодая спортсменка доказала, что она <w>способна</w> выиграть золотую медаль."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "incapable"
                    ],
                    "common_phrases": [
                        "perfectly capable",
                        "capable of winning",
                        "highly capable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий необходимыми способностями, силой или пригодностью для успешного выполнения чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "способный",
                                "target_lang_sense_clarification": "обладающий талантом или умением"
                            },
                            {
                                "target_lang_word": "компетентный",
                                "target_lang_sense_clarification": "эффективный и знающий свое дело"
                            },
                            {
                                "target_lang_word": "в состоянии",
                                "target_lang_sense_clarification": "имеющий возможность или силу что-то сделать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ca8efc3-e194-38a6-98ed-68193b6905bb",
                    "sense_definition": "Having the capacity or space to hold, contain, or receive a certain amount.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "capacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new stadium is <w>capable</w> of seating over fifty thousand spectators.",
                            "target_lang_translations": {
                                "ru": "Новый стадион <w>вмещает</w> более пятидесяти тысяч зрителей."
                            }
                        },
                        {
                            "text": "They are building a storage facility <w>capable</w> of holding all the surplus grain.",
                            "target_lang_translations": {
                                "ru": "Они строят хранилище, <w>способное</w> вместить все излишки зерна."
                            }
                        }
                    ],
                    "common_phrases": [
                        "capable of seating",
                        "capable of holding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий вместимостью или пространством для содержания или приема определенного количества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмещающий",
                                "target_lang_sense_clarification": "способный вместить определенное количество"
                            },
                            {
                                "target_lang_word": "рассчитанный на",
                                "target_lang_sense_clarification": "предназначенный для определенного объема или числа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}