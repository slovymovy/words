                                                "example_id": "d463602b-ec31-41b2-8929-81e7b4204aeb",
                                                "sense_id": "c410bbe4-8c6e-302e-9b83-780b36604929",
                                                "text": "Die Flecks lieben die Natur und die Tiere."
