                                "target_word": "unvorstellbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "583f0f7b-8ca6-3767-a00a-484922b1cd1f",
                                        "entry_id": "ab9dac45-2bfc-3c8b-b491-cf3c10914154",
                                        "glosses": [
                                            "dem Verstand oder der Fantasie nicht zugänglich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eb7ab8b-3c91-4246-abb8-df43d1b55f5a",
                                                "sense_id": "583f0f7b-8ca6-3767-a00a-484922b1cd1f",
                                                "text": "\"Wir erleben in Deutschland einen Angriff in unvorstellbarem Ausmaß\", sagte BKA-Präsident Jörg Ziercke auf einer gemeinsamen Pressekonferenz mit der Finanzaufsicht BaFin."
                                            },
                                            {
                                                "example_id": "8905e0ed-a3ce-4637-bffc-2ed6a74dc15e",
                                                "sense_id": "583f0f7b-8ca6-3767-a00a-484922b1cd1f",
                                                "text": "Er ist die treibende Kraft hinter der Initiative, welche die Antwort sei \"auf alle Verbrechen, die einem Menschen das Leben und dessen Würde durch unvorstellbare und grausame Handlungen entreißen\"."
                                            },
                                            {
                                                "example_id": "a0f2b251-1719-4f87-a31f-7093501aff0f",
                                                "sense_id": "583f0f7b-8ca6-3767-a00a-484922b1cd1f",
                                                "text": "„Das hat unvorstellbare Schmerzen, Qualen und Leiden bedeutet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e2368e12-7125-3b11-9861-e459ab2302d4",
                                        "entry_id": "ab9dac45-2bfc-3c8b-b491-cf3c10914154",
                                        "glosses": [
                                            "außerordentlich, überaus"
                                        ],
                                        "tags": [
                                            "adverbiell und in Verbindung mit Adjektiven"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9415aebe-f4fb-4479-aec6-a64e4517491c",
                                                "sense_id": "e2368e12-7125-3b11-9861-e459ab2302d4",
                                                "text": "Die erwartete Datenmenge von jährlich 767 Exabyte ist unvorstellbar groß."
                                            },
                                            {
                                                "example_id": "7a42b6c6-c726-480b-91e2-e99a0903cf6d",
                                                "sense_id": "e2368e12-7125-3b11-9861-e459ab2302d4",
                                                "text": "\"Die Summen, die im Rahmen des Euro-Schutzschirms finanziert werden müssen, sind unvorstellbar hoch. …\""
                                            },
                                            {
                                                "example_id": "333d35a5-989d-4bd5-83a4-44fb8a26fcbb",
                                                "sense_id": "e2368e12-7125-3b11-9861-e459ab2302d4",
                                                "text": "In einer von seinem Management noch in der Nacht verbreiteten Mitteilung relativierte er seine Kritik an der Arbeit von Queiroz: „Man soll keine Geister heraufbeschwören, wo keine sind. Ich fühle mich am Boden zerstört, total verzweifelt, frustriert und unvorstellbar traurig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58e597c4-5b13-4022-8178-55936c6382fe",
                        "source_entry_id": "111c0d05-5c5c-3697-aa24-bb10315cdaf9",
                        "source_sense_id": "d6e629db-93fd-3edc-95b3-dab15f7b4dc7",
                        "source_sense_description": "unvorstellbar, undenkbar",
                        "target_lang_word": "undenkbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undenkbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20591c47-3507-3438-b2b9-4cb5d13bc8d7",
                                        "entry_id": "928e9534-b068-3c31-a6b8-4d547c5290c6",
                                        "glosses": [
                                            "nicht vorstellbar, nicht in Gedanken möglich, zugänglich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a431ff53-ffb7-4c42-9c8e-7539c205e2a8",
                                                "sense_id": "20591c47-3507-3438-b2b9-4cb5d13bc8d7",
                                                "text": "„Ein gemeinsames Abendessen mit Freunden, Camping oder an den Badesee – an schlechten Tagen undenkbar.“"
                                            },
                                            {
                                                "example_id": "b2b138d5-7d87-4151-add0-0b96f2042209",
                                                "sense_id": "20591c47-3507-3438-b2b9-4cb5d13bc8d7",
                                                "text": "„Der Mensch ist ein zutiefst soziales Wesen, unser Leben ist ohne zwischenmenschliche Interaktion undenkbar.“"
                                            },
                                            {
                                                "example_id": "a9dad813-2e4a-486a-b64c-ef24dac8e4fc",
                                                "sense_id": "20591c47-3507-3438-b2b9-4cb5d13bc8d7",
                                                "text": "„Unser Leben wird seit über einem Jahr beherrscht von Lockdowns und Beschränkungen unseres ökonomischen wie sozialen Lebens und unserer Grundrechte, die bislang in einer freien, demokratischen Gesellschaft undenkbar waren.“"
                                            },
                                            {
                                                "example_id": "99a5efca-1790-458b-86a8-59d6709c6323",
                                                "sense_id": "20591c47-3507-3438-b2b9-4cb5d13bc8d7",
                                                "text": "„Es folgen die sinnvollen, dann die gerade noch akzeptablen, die radikalen und schlussendlich die undenkbaren Positionen.“"
                                            },
                                            {
                                                "example_id": "a00f3d5b-cee0-4424-8af7-3ff8730dabb1",
                                                "sense_id": "20591c47-3507-3438-b2b9-4cb5d13bc8d7",
                                                "text": "„Facebook als das größte soziale Netzwerk der Welt hatte vergangene Woche den ersten – bisher undenkbaren – Schritt gemacht, Donald Trump für unbestimmte Zeit von seiner Plattform auszuschließen.“"
                                            },
                                            {
                                                "example_id": "2139129d-e1f2-46c9-adab-b19aab3ab77f",
                                                "sense_id": "20591c47-3507-3438-b2b9-4cb5d13bc8d7",
                                                "text": "„Wir haben uns vorbereitet und medizinische Kapazitäten für Covid-19 in einem bisher undenkbaren Ausmaß bereitgestellt.“"
                                            },
                                            {
                                                "example_id": "05f63227-85bc-4486-adad-28ecd314d1f6",
                                                "sense_id": "20591c47-3507-3438-b2b9-4cb5d13bc8d7",
                                                "text": "„Der Schiffers ihre Claudia ist nicht so, wie‚s Mädel sein soll, hat sich ‚bereits in jeder denkbaren Pantomine eines undenkbaren Koitus fotografieren lassen‘, und auch Demi Moore gibt sich einer ‚Moral in doppelter Ausfertigung‘ hin.“"
                                            },
                                            {
                                                "example_id": "d42679fe-512b-4b4f-a9a2-dbdf54e9b6c3",
                                                "sense_id": "20591c47-3507-3438-b2b9-4cb5d13bc8d7",
                                                "text": "„Über Monate hinweg demonstrierten entrüstete Bürger in Sofia gegen diesen in vielen EU-Staaten völlig undenkbaren, aber auch für das korruptionsgeplagte Bulgarien kaum glaublichen Vorstoß einer europäischen Regierung, einen Kernbestandteil staatlicher Souveränität an einen Oligarchen zu verhökern.“"
                                            },
                                            {
                                                "example_id": "79e6c321-fe07-42e1-96c9-75dddf6b619b",
                                                "sense_id": "20591c47-3507-3438-b2b9-4cb5d13bc8d7",
                                                "text": "„Wegen der klimatischen Bedingungen und des für Fußballspieler undenkbaren Programms von sieben Spielen in dreizehn Tagen hatte das IOC nach langem Zögern zugestimmt, dass die teilnehmenden Hockey-Nationen diesmal achtzehn statt der üblichen sechzehn Athleten nominieren dürfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
