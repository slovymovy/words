                ],
                "senses": [
                    {
                        "sense_id": "9381d45b-d9b2-320e-a7e6-e49bc2251173",
                        "entry_id": "3961cf77-c930-3f2f-9138-25a488d1021a",
                        "glosses": [
                            "Bestelleinheit in der Gastronomie für 10 oder mehr Glas Bier, die auf einem 1 Meter langen, dafür vorbereiteten Tragebrett gebracht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eb7c0f6-31dc-48c6-984c-f4783e2f61bf",
                                "sense_id": "9381d45b-d9b2-320e-a7e6-e49bc2251173",
                                "text": "Und mir kannst du noch einen Biermeter mitbringen."
                            },
                            {
                                "example_id": "7e1fe9c5-1ced-43b3-81e2-1ec1358d6753",
                                "sense_id": "9381d45b-d9b2-320e-a7e6-e49bc2251173",
                                "text": "„Die Mannschaft, die während des Turniers die meisten Biermeter (1 Meter = 11 Bier) getrunken hat, bekommt diesen Prestigepreis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d2430139-4f28-357d-acf5-41cdacf7536a",
                        "entry_id": "3961cf77-c930-3f2f-9138-25a488d1021a",
                        "glosses": [
                            "Tragebrett für Biergläser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1e45464-d506-4890-b8ab-4e745d7143b1",
                                "sense_id": "d2430139-4f28-357d-acf5-41cdacf7536a",
                                "text": "„Markieren Sie zunächst auf beiden Brettern mit einem dünnen Bleistiftstrich die Länge von exakt 100 cm – der magische Biermeter.“"
                            },
                            {
                                "example_id": "2fea87a8-d590-44d7-8432-f502e717ace9",
                                "sense_id": "d2430139-4f28-357d-acf5-41cdacf7536a",
                                "text": "„Anlässlich des zweijährigen Jubiläums und des vor der Tür stehenden Poloturniers war es dringend notwendig einen eigenen Biermeter zu bauen, um nicht mehr auf den Biermeter der No Mercys angewiesen zu seien.“"
                            },
                            {
                                "example_id": "5299e7c2-d489-478e-8eb3-1466b0dac204",
                                "sense_id": "d2430139-4f28-357d-acf5-41cdacf7536a",
                                "text": "„Das Biermeter und die Garderobe sind Eigentum des Schützenzuges. Der 1. Offizier ist für das Biermeter und die Garderobe verantwortlich.“"
                            },
                            {
                                "example_id": "5fb80160-bc8d-4df1-9015-408ea1ed6c3c",
                                "sense_id": "d2430139-4f28-357d-acf5-41cdacf7536a",
                                "text": "„Als ebenfalls originell lobten die anwesenden Brauereivertreter die Schaffung eines „Biermeters“, eines von der Lebenshilfe Amberg gefertigten großen Tragerls, das 14 verschiedene Biersorten fasst.“"
                            },
                            {
                                "example_id": "eff44abe-869b-40fe-ba50-3d8e728aedb4",
                                "sense_id": "d2430139-4f28-357d-acf5-41cdacf7536a",
                                "text": "„Der Biermeter wird beim Wackelzug mitgenommen und von den jüngsten Mitgliedern (Mitgliedszugehörigkeit) betreut.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
