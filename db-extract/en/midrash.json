                "senses": [
                    {
                        "sense_id": "531c38ee-7294-326f-94a2-488fe32e1f8d",
                        "entry_id": "a6e41f8a-a804-3cff-b5f2-698f759b2a05",
                        "glosses": [
                            "A Rabbinic commentary on a text from the Hebrew Scripture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aedacabf-d601-4570-bbb3-ffef1dce28d3",
                                "sense_id": "531c38ee-7294-326f-94a2-488fe32e1f8d",
                                "text": "In other stories of the midrashim, Adam, in penance for his fall, abstains from sexuality for 130 years, but he is not able to control his nocturnal emissions; in his dream state female spirits, the succubae, come and have intercourse with him, and with Adam's seed they give birth to demons."
                            }
                        ]
                    },
                    {
                        "sense_id": "44907b1c-8510-3778-a882-543407456867",
                        "entry_id": "a6e41f8a-a804-3cff-b5f2-698f759b2a05",
                        "glosses": [
                            "The Rabbinic technique or tradition of such exegesis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2d940f4-61e4-4f79-9a3c-1172c25809c9",
                                "sense_id": "44907b1c-8510-3778-a882-543407456867",
                                "text": "Midrash was not a purely intellectual pursuit and study was never an end in itself: it had to inspire practical action in the world."
                            }
                        ]
                    }
                ],
