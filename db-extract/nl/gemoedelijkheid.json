                        "examples": [
                            {
                                "example_id": "6921f72d-08b0-45c9-9e74-0cd018cba937",
                                "sense_id": "efcd2d1f-958e-354c-9039-322c4ed70524",
                                "text": "Hij voelde zich op zijn gemak in de gemoedelijkheid van het dorpscafé."
                            },
                            {
                                "example_id": "83bf2346-6ff6-471a-9349-8ce4c60f3644",
                                "sense_id": "efcd2d1f-958e-354c-9039-322c4ed70524",
                                "text": "Maar dat wij dit gesprek zo gewoontjes konden voeren, en niet hoefden te fluisteren of onzichtbare microfoons moesten ontlopen, tekende de gemoedelijkheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "53c69d12-7a1a-3294-85f5-c7f9845a22e2",
                        "entry_id": "c6c528a4-2293-33ec-ae92-ac7356768b9f",
                        "glosses": [
