                "senses": [
                    {
                        "sense_id": "e82adb9c-6f63-3fef-bf54-98150f950a5f",
                        "entry_id": "8a7577ba-1c03-364e-8e70-e53ffd51d841",
                        "glosses": [
                            "synonym of Astralleib (“astral body”)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "2247b6d9-6174-4369-8c4e-5494a7c5ffed",
                                "sense_id": "e82adb9c-6f63-3fef-bf54-98150f950a5f",
                                "text": "Jamie nämlich bekommt es nicht nur mit gelangweilt die Wahrheit aussprechenden toten Schriftstellern und der kriminellen Liebhaberin seiner Mutter zu tun, sondern auch mit einem veritablen Dämon, der sich im Astralkörper eines sehr bösen toten Mannes versteckt hat."
                            }
                        ]
                    },
                    {
                        "sense_id": "264441d8-676d-3993-9db5-ea7deab86640",
                        "entry_id": "8a7577ba-1c03-364e-8e70-e53ffd51d841",
                        "glosses": [
                            "beautiful body"
                        ],
                        "tags": [
                            "colloquial",
                            "ironic",
                            "masculine",
                            "often",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "33ab1efa-c7de-4217-aa5e-5bdf4f61dfdb",
                                "sense_id": "264441d8-676d-3993-9db5-ea7deab86640",
                                "text": "Auf der anderen Seite zwei schöne, schwarze junge Menschen mit perfekten Astralkörpern […]"
                            },
                            {
                                "example_id": "58886097-5fd2-4cb9-8c70-5256ed37adf1",
                                "sense_id": "264441d8-676d-3993-9db5-ea7deab86640",
                                "text": "Wenn man sich jetzt die neue isländische Serie in acht Teilen auf Arte anguckt, „Blackport“, gibt es da auch jede Menge Sex mit Menschen, denen man nicht unbedingt attestieren würde, was man früher einmal Astralkörper genannt hat. Body Positivity also."
                            }
                        ]
                    }
                ],
