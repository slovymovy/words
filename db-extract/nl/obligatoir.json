                        ]
                    },
                    {
                        "translation_id": "559f03bb-3747-4fd3-8b26-5734cbc3653b",
                        "source_entry_id": "7ae8fd50-722d-3cb8-9bf9-b49039b8ad89",
                        "source_sense_id": "d6b8496a-ed8c-3a93-9cd9-4fba9267a716",
                        "source_sense_description": "verplicht",
                        "target_lang_word": "obligatoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obligatoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "845488f7-cd14-3ce8-8f19-4aaea010cef0",
                                        "entry_id": "cb3f88d1-02c1-3ce0-adfd-c3f4ffa7bbca",
                                        "glosses": [
                                            "Qui a la force d’obliger suivant la loi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66aff470-f7dd-4be4-9900-32682de822c1",
                                                "sense_id": "845488f7-cd14-3ce8-8f19-4aaea010cef0",
                                                "text": "Ces sortes d'affaires s'instruisent sans huissiers ni défenseurs. Le ministère de ceux-ci est déclaré n'être pas obligatoire, et le surcroît de frais qu'il eût occasionné être irrépétible."
                                            },
                                            {
                                                "example_id": "dc173ec3-0a0d-4e65-b53f-345d86c3e3e2",
                                                "sense_id": "845488f7-cd14-3ce8-8f19-4aaea010cef0",
                                                "text": "Si, lors d’une déclaration de guerre, la mobilisation était facultative, bien peu d’hommes partiraient ; c’est du reste pour cette raison que les gouvernements ont institué le service militaire obligatoire."
                                            },
                                            {
                                                "example_id": "d8daf52a-1489-4378-a706-86c5d45de6af",
                                                "sense_id": "845488f7-cd14-3ce8-8f19-4aaea010cef0",
                                                "text": "Ceci ne signifie cependant pas que l’exercice fiscal coïncide nécessairement avec l’année civile. Si cette coïncidence est très fréquente en pratique, elle n'est obligatoire que pour les exploitations agricoles soumises au régime du forfait et les micro-entreprises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ef3eff-9f3e-3421-b421-47a2cf1bd6ba",
                                        "entry_id": "cb3f88d1-02c1-3ce0-adfd-c3f4ffa7bbca",
                                        "glosses": [
                                            "Ce qui est exigé par la bienséance, la morale."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "414ceca5-14e8-4052-b894-1fd80a183c61",
                                                "sense_id": "85ef3eff-9f3e-3421-b421-47a2cf1bd6ba",
                                                "text": "La tenue de soirée est obligatoire pour ce bal."
                                            },
                                            {
                                                "example_id": "51d28c1a-db0e-48a2-8566-0e82aa70facd",
                                                "sense_id": "85ef3eff-9f3e-3421-b421-47a2cf1bd6ba",
                                                "text": "Votre présence à cette cérémonie me paraît obligatoire."
                                            },
                                            {
                                                "example_id": "0fb7068e-7152-476c-94ee-a90325b3f59d",
                                                "sense_id": "85ef3eff-9f3e-3421-b421-47a2cf1bd6ba",
                                                "text": "Si la vaccination avait été obligatoire, on s’y serait soumis. Mais je ne crois pas que ça aurait été plus simple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84d8148c-6c0a-30c6-8fb8-832e4c9dc1a0",
                                        "entry_id": "cb3f88d1-02c1-3ce0-adfd-c3f4ffa7bbca",
                                        "glosses": [
                                            "Que l'on ne peut éviter."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "445697dc-8094-4b62-b1fc-b0cc55b2c42f",
                                                "sense_id": "84d8148c-6c0a-30c6-8fb8-832e4c9dc1a0",
                                                "text": "La mort, c’est tellement obligatoire que c’est presque une formalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
