                        "examples": [
                            {
                                "example_id": "40d61670-1694-43bd-8bd8-37fb9c454955",
                                "sense_id": "d373c755-6a75-3f03-b1bc-11abead046bd",
                                "text": "Das ist auch dem Philosophen Armen Avanessian aufgefallen. Bekannt geworden ist er vor allem als Vertreter der technophilen kapitalismuskritischen Denkrichtung des Akzelerationismus."
                            },
                            {
                                "example_id": "e180f0c4-dcf5-4182-bf79-eceb25eba1c3",
                                "sense_id": "d373c755-6a75-3f03-b1bc-11abead046bd",
                                "text": "Hieran knüpft die Autorin Aria Dean an und bringt den Akzelerationismus mit einer afrofuturistischen Blickrichtung zusammen. Ersterem wirft sie vor, wie etwa bei der Beschreibung der Entstehung des Kapitalismus allgemein, die Position des Kolonialismus ignoriert zu haben."
                            }
                        ]
                    }
