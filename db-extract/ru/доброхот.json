                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b8c7509-7f88-33eb-b5e0-93c0b60c3a96",
                        "entry_id": "2af98893-292f-3d7a-a080-81ea762f32af",
                        "glosses": [
                            "устар. или шутл. тот, кто желает добра кому-либо, проявляет участие, расположение к кому-либо; доброжелатель"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a449ba3f-a12e-4871-bf4e-32ab85123616",
                                "sense_id": "7b8c7509-7f88-33eb-b5e0-93c0b60c3a96",
                                "text": "Нашлись доброхоты и заступники, которые припоминали за Полуяновым немало добра."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b983f47-a0ec-30a5-a6b9-6e52733db7bf",
                        "entry_id": "2af98893-292f-3d7a-a080-81ea762f32af",
                        "glosses": [
                            "тот, кто по собственному желанию хочет участвовать в чём-либо; доброволец"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45308ba6-cf71-42da-91e0-401bf401aff9",
                        "source_entry_id": "2af98893-292f-3d7a-a080-81ea762f32af",
                        "source_sense_description": "доброжелатель",
                        "target_lang_word": "well-wisher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "well-wisher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7089471a-c394-3dba-a313-fe9a60e48955",
                                        "entry_id": "f454fe81-f219-3ea7-9935-45fa4a370f5a",
                                        "glosses": [
                                            "Someone who extends good wishes, or expresses sympathy, to someone else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a506aec-2eae-445c-97b6-69dc5fb90007",
                                                "sense_id": "7089471a-c394-3dba-a313-fe9a60e48955",
                                                "text": "[T]hose honest gentlemen that are always exposed to the wit and raillery of their well-wishers and companions; that are pelted by men, women, and children, friends and foes, and in a word, stand as butts in conversation, for every one to shoot at that pleases."
                                            },
                                            {
                                                "example_id": "2c9ea244-cca4-4509-a017-15aa8fd583ef",
                                                "sense_id": "7089471a-c394-3dba-a313-fe9a60e48955",
                                                "text": "[T]he actual traytor or rebel is guilty of perjury in the eye of the lavv; the ſecret promoter, or vvell-vviſher of the cauſe, is ſo before the Tribunal of conſcience."
                                            },
                                            {
                                                "example_id": "88a0dfe5-821f-4506-976b-ecac98032775",
                                                "sense_id": "7089471a-c394-3dba-a313-fe9a60e48955",
                                                "text": "Nor did he ſeem to have made an unreaſonable reply to them both, and it vvas eaſy for a ſpeech to be received favorably amongſt vvellvviſhers."
                                            },
                                            {
                                                "example_id": "39339655-0818-4af4-b3b1-383d83bf352e",
                                                "sense_id": "7089471a-c394-3dba-a313-fe9a60e48955",
                                                "text": "[G]ive me the hopes of my dear girl's approaching felicity, equal to the deſires of / Her ſincereſt VVellvviſher, / LAVINIA RAWLINS."
                                            },
                                            {
                                                "example_id": "78c16b70-a32c-4d90-8206-e279b7eca516",
                                                "sense_id": "7089471a-c394-3dba-a313-fe9a60e48955",
                                                "text": "She had still, however, her friends and well-wishers, many of whom thought, that as she was a lone woman, and known to be well to pass in the world, she would act wisely to retire from public life, and take down a sign which had no longer fascination for guests."
                                            },
                                            {
                                                "example_id": "1f48d52f-9f37-426e-bb6a-bb2ccf3fb4e1",
                                                "sense_id": "7089471a-c394-3dba-a313-fe9a60e48955",
                                                "text": "\"You see before you,\" she said, with choking utterance, \"one who, fallen and degraded as she is, would still venture to hope that she has a friend, at least a wellwisher, in Mr Thornton. If I am mistaken in this, alas! I am friendless.\""
                                            },
                                            {
                                                "example_id": "2bbd5725-309e-4ea9-bfda-319eb64e6702",
                                                "sense_id": "7089471a-c394-3dba-a313-fe9a60e48955",
                                                "text": "\"[…] [I]t would be a nice opportunity for any of his well-wishers to pay him a visit, if they knew how straight the path was made before them.\" / \"I am none of his well-wishers, sir: I don't care for him.\""
                                            },
                                            {
                                                "example_id": "3f93581f-c656-4484-940d-28ea2db4ed2e",
                                                "sense_id": "7089471a-c394-3dba-a313-fe9a60e48955",
                                                "text": "Already a J72 0-6-0T has been promised by a well-wisher and will be re-painted in North Eastern Railway livery."
                                            },
                                            {
                                                "example_id": "dfc78a88-a819-4b55-ae3c-e94a234fa2fa",
                                                "sense_id": "7089471a-c394-3dba-a313-fe9a60e48955",
                                                "text": "I'm a well-wisher, in that I don't wish you any specific harm."
                                            },
                                            {
                                                "example_id": "f6ec40e1-43a7-4abc-9a64-0efe3ccec763",
                                                "sense_id": "7089471a-c394-3dba-a313-fe9a60e48955",
                                                "text": "At each stopping place I stepped out of the train to chat to well-wishers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e67313e8-1ded-3cca-84bd-4ffbef9948c2",
                                        "entry_id": "f454fe81-f219-3ea7-9935-45fa4a370f5a",
                                        "glosses": [
                                            "Followed by to: someone who has an ambition to be or become something."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75cd9113-0451-44d7-b3b6-ac7780a2a6c3",
                                                "sense_id": "e67313e8-1ded-3cca-84bd-4ffbef9948c2",
                                                "text": "I never saw your chancellor, nor his chaplain. The latter has a good deal of learning, and is a well wisher to be an author: your chancellor is an excellent man."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "well-wisher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "135f5879-7c4e-31ad-989f-bfbb35fd847e",
                                        "entry_id": "1955797e-2ef7-37f3-998f-df15959dc093",
                                        "glosses": [
                                            "Someone who makes a wish at a wishing well."
                                        ],
                                        "tags": [
                                            "nonce-word",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a8c86a4-2aa6-499d-81c8-051969f63c5d",
                                                "sense_id": "135f5879-7c4e-31ad-989f-bfbb35fd847e",
                                                "text": "They strolled on and passed a smiling man standing by the Village wishing well. \"Well,\" said the well-wisher. Ah … must be the Village idiot."
                                            },
                                            {
                                                "example_id": "bca73e4b-a3eb-4da2-90e9-30aab6ce2a9a",
                                                "sense_id": "135f5879-7c4e-31ad-989f-bfbb35fd847e",
                                                "text": "\"I'll put a removable lid on it [a wishing well],\" he assured her. \"That way, it'll be safe for the nippers, but accessible to, um, well wishers. Have a wish in mind, Bree?\""
                                            },
                                            {
                                                "example_id": "d3b30a79-d3a0-4778-8530-4bdd104951c2",
                                                "sense_id": "135f5879-7c4e-31ad-989f-bfbb35fd847e",
                                                "text": "Maybe I am a wishing well, / I have regular well-wishers / Throwing me a coin. / Only change they throw me / Because they don't expect to see / Any change back."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e948f7b9-48a2-47b0-882a-6c4680dafa8a",
                        "source_entry_id": "2af98893-292f-3d7a-a080-81ea762f32af",
                        "source_sense_description": "доброволец",
                        "target_lang_word": "volunteer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volunteer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "117fa0bd-bbf1-3dd5-9b8a-9ad72e68abb2",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "One who enters into, or offers themselves for, any service of their own free will, especially when done without pay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2c8e9c7-6592-4364-8aec-e2caa7d68e8e",
                                                "sense_id": "117fa0bd-bbf1-3dd5-9b8a-9ad72e68abb2",
                                                "text": "The volunteers at the nature reserve meet up ever other Sunday to help its upkeep."
                                            },
                                            {
                                                "example_id": "971daf69-1465-4881-8149-de214d9f6e98",
                                                "sense_id": "117fa0bd-bbf1-3dd5-9b8a-9ad72e68abb2",
                                                "text": "The largest age group for volunteers was 35-44, the CNCS survey said, and volunteers were most likely to be parents with children under 18. The typical volunteer may live in Utah, which ranked first in the percentage of people who said they volunteered among all 50 states and Washington, DC."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38ac4b41-903c-3822-b1eb-9a9e5bcf42ac",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "One who enters into military service voluntarily (but who, when in service, is subject to discipline and regulations like other soldiers), as opposed to a conscript."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e22ba4e-6bc0-3c6e-a575-008bf96d5330",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "A voluntary member of the organized militia of a country, as distinguished from a regular or member of the standing army."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "846ff25a-7fc4-4e65-818e-7accadd7a9fe",
                                                "sense_id": "7e22ba4e-6bc0-3c6e-a575-008bf96d5330",
                                                "text": "That summer and fall the Army organized twenty-five regiments of volunteers, including two black regiments, which would have all-black captains and lieutenants. All officers were to be selected from regulars and volunteers who had distinguished themselves[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64e4831d-46f2-3884-8284-884730b9d549",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "A person who acts out of their own will without a legal obligation, such as a donor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4397e770-550c-3958-be77-27fed251fc77",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
