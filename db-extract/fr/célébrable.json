                        "glosses": [
                            "Qui peut ou doit être célébré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7069220f-ff3e-49fc-8c33-0e3fc3cbf31d",
                                "sense_id": "a9ee5bec-864e-34a9-aeed-169cec539e55",
                                "text": "Sa tendre piété envers ses Prédécesseurs, ses Religieux, Fondateurs & Bien-faiteurs l’engagea d’établir à perpétuité un anniversaire pour leur repos célébrable le Mardi après la fête de S. Galle, …"
                            },
                            {
                                "example_id": "13745827-517e-47d4-89eb-fd3a54d8aafd",
                                "sense_id": "a9ee5bec-864e-34a9-aeed-169cec539e55",
                                "text": "Retenez ceci : il n’y a de bon, de vrai, de gai, de triste, d’aimable, de variable, de désirable, de potable, de chantable, de célébrable, d’idolâtrable, que le delta qui existe depuis la ceinture d’une femme jusqu’à ses jarretières."
                            },
                            {
                                "example_id": "6cf488d8-09de-4afe-8b73-03d13f6c0882",
                                "sense_id": "a9ee5bec-864e-34a9-aeed-169cec539e55",
                                "text": "Car, de l’avis général, 92 n’est pas célébrable. 92, c’est déjà 93, et comment fêter la Terreur ?"
                            }
                        ]
                    }
