                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大肆宣传",
                                "target_lang_sense_clarification": "大力宣传某个产品、事件或人物"
                            },
                            {
                                "target_lang_word": "大肆炒作",
                                "target_lang_sense_clarification": "刻意制造热度和声势"
                            },
                            {
                                "target_lang_word": "造势",
