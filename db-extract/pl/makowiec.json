                    {
                        "translation_id": "8800ba1e-270e-449e-b4d7-1ea39b8e5dea",
                        "source_entry_id": "b7277d26-2c08-398b-9a8c-0ec062753d0a",
                        "source_sense_id": "af6ec6ff-1179-3c76-a48c-75c7b35d702d",
