                                                "example_id": "a7428835-8b89-4177-b013-bfaacdba1545",
                                                "sense_id": "710a5781-f683-3ef3-abc5-2522b7bbdc86",
                                                "text": "The cabin offers a lovely spacious view of the mountain meadows."
                                            }
