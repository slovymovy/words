{
    "word_family": [
        "restant",
        "resteren",
        "restwaarde"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5dd92ee7-fc94-3a88-9bd6-245624391d9f",
                    "sense_definition": "Datgene of degenen die overblijven nadat een deel is weggegaan of gebruikt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "overblijfsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb een deel van de taart opgegeten en de <w>rest</w> staat in de koelkast.",
                            "target_lang_translations": {
                                "en": "I ate part of the cake and the <w>rest</w> is in the fridge.",
                                "ru": "Я съел часть торта, а <w>остальное</w> стоит в холодильнике."
                            }
                        },
                        {
                            "text": "De <w>rest</w> van de groep gaat nu gewoon naar huis en wacht daar op bericht.",
                            "target_lang_translations": {
                                "en": "The <w>rest</w> of the group is just going home now and will wait there for a message.",
                                "ru": "<w>Остальные</w> из группы сейчас просто идут домой и ждут там сообщения."
                            }
                        }
                    ],
                    "synonyms": [
                        "overblijfsel",
                        "overschot"
                    ],
                    "common_phrases": [
                        "de rest van",
                        "voor de rest"
                    ],
                    "target_lang_definitions": {
                        "en": "That which or those who remain after a part has left or been used.",
                        "ru": "То, что или те, кто остается после того, как часть ушла или была использована."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rest",
                                "target_lang_sense_clarification": "the remaining part or people"
                            },
                            {
                                "target_lang_word": "remainder",
                                "target_lang_sense_clarification": "the part that is left over"
                            },
                            {
                                "target_lang_word": "others",
                                "target_lang_sense_clarification": "the remaining people in a group"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "остальное",
                                "target_lang_sense_clarification": "оставшаяся часть чего-либо"
                            },
                            {
                                "target_lang_word": "остальные",
                                "target_lang_sense_clarification": "оставшиеся люди в группе"
                            },
                            {
                                "target_lang_word": "остаток",
                                "target_lang_sense_clarification": "то, что осталось от целого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f003cf20-29a0-3273-8486-52f55e1d3374",
                    "sense_definition": "Een klein overgebleven gedeelte van iets, vaak in de vorm van afval of brokstukken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "overblijfsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pas na enige dagen werden de <w>resten</w> van het verongelukte vliegtuig teruggevonden.",
                            "target_lang_translations": {
                                "en": "Only after several days were the <w>remains</w> of the crashed plane found.",
                                "ru": "Только через несколько дней были найдены <w>останки</w> разбившегося самолета."
                            }
                        },
                        {
                            "text": "Er lagen nog enkele <w>resten</w> van de maaltijd op het bord.",
                            "target_lang_translations": {
                                "en": "There were still some <w>remnants</w> of the meal on the plate.",
                                "ru": "На тарелке еще лежали некоторые <w>остатки</w> еды."
                            }
                        }
                    ],
                    "synonyms": [
                        "overblijfsel"
                    ],
                    "common_phrases": [
                        "de resten van"
                    ],
                    "target_lang_definitions": {
                        "en": "A small remaining portion of something, often in the form of waste or fragments.",
                        "ru": "Небольшая оставшаяся часть чего-либо, часто в виде отходов или обломков."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "remains",
                                "target_lang_sense_clarification": "parts left over after destruction or use"
                            },
                            {
                                "target_lang_word": "remnants",
                                "target_lang_sense_clarification": "small remaining quantities"
                            },
                            {
                                "target_lang_word": "leftovers",
                                "target_lang_sense_clarification": "remaining food from a meal"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "останки",
                                "target_lang_sense_clarification": "части, оставшиеся после разрушения"
                            },
                            {
                                "target_lang_word": "остатки",
                                "target_lang_sense_clarification": "небольшие сохранившиеся части или еда"
                            },
                            {
                                "target_lang_word": "обломки",
                                "target_lang_sense_clarification": "фрагменты чего-то разрушенного"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4414c385-a57e-32b5-aa17-cf3b57df0044",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>resten</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>rest</w> mij niets anders dan u hartelijk te bedanken voor uw hulp.",
                            "target_lang_translations": {
                                "en": "Nothing <w>remains</w> for me but to thank you sincerely for your help.",
                                "ru": "Мне не <w>остается</w> ничего другого, кроме как сердечно поблагодарить вас за помощь."
                            }
                        },
                        {
                            "text": "Wat <w>rest</w> er nog van onze oude vriendschap na al die jaren?",
                            "target_lang_translations": {
                                "en": "What <w>remains</w> of our old friendship after all these years?",
                                "ru": "Что еще <w>осталось</w> от нашей старой дружбы спустя все эти годы?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "er rest mij"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To remain or be left over (specifically the first person singular or general present tense).",
                        "ru": "Оставаться или быть в остатке (форма глагола в настоящем времени)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "remain",
                                "target_lang_sense_clarification": "to be left over"
                            },
                            {
                                "target_lang_word": "be left",
                                "target_lang_sense_clarification": "to still exist after others are gone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "оставаться",
                                "target_lang_sense_clarification": "быть в наличии после того, как остальное исчезло"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}