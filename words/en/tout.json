{
    "word_family": [
        "touter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ceb35548-4d9b-3398-b0f0-03dc270a3b4b",
                    "sense_definition": "to publicize or promote something or someone, often with great praise or as a way of boasting",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "promotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is <w>touting</w> its new software as the most secure option on the market.",
                            "target_lang_translations": {
                                "ru": "Компания <w>расхваливает</w> свое новое программное обеспечение как самый безопасный вариант на рынке."
                            }
                        },
                        {
                            "text": "She has been <w>touted</w> as a potential successor to the current CEO due to her recent success.",
                            "target_lang_translations": {
                                "ru": "Ее <w>превозносят</w> как потенциального преемника нынешнего генерального директора благодаря ее недавним успехам."
                            }
                        }
                    ],
                    "synonyms": [
                        "promote",
                        "pitch"
                    ],
                    "common_phrases": [
                        "touted as a",
                        "widely touted"
                    ],
                    "target_lang_definitions": {
                        "ru": "рекламировать или продвигать что-либо или кого-либо, часто с большой похвалой или хвастовством"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расхваливать",
                                "target_lang_sense_clarification": "сильно хвалить, расточать похвалы"
                            },
                            {
                                "target_lang_word": "рекламировать",
                                "target_lang_sense_clarification": "активно продвигать товар или услугу"
                            },
                            {
                                "target_lang_word": "превозносить",
                                "target_lang_sense_clarification": "очень высоко оценивать, прославлять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abd993f5-6726-3563-9379-e692418051d1",
                    "sense_definition": "to actively look for or try to obtain something, such as business or work, typically used with the preposition 'for'",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "seeking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young man spent his mornings <w>touting</w> for work among the local construction crews.",
                            "target_lang_translations": {
                                "ru": "Молодой человек проводил утро, <w>пытаясь найти</w> работу среди местных строительных бригад."
                            }
                        },
                        {
                            "text": "Many small businesses are forced to <w>tout</w> for business in a very competitive environment.",
                            "target_lang_translations": {
                                "ru": "Многие малые предприятия вынуждены <w>зазывать</w> клиентов в условиях жесткой конкуренции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tout for business",
                        "tout for work"
                    ],
                    "target_lang_definitions": {
                        "ru": "активно искать или пытаться получить что-либо, например, заказы или работу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зазывать",
                                "target_lang_sense_clarification": "привлекать клиентов или покупателей"
                            },
                            {
                                "target_lang_word": "навязывать",
                                "target_lang_sense_clarification": "назойливо предлагать услуги или товары"
                            },
                            {
                                "target_lang_word": "искать клиентов",
                                "target_lang_sense_clarification": "пытаться получить заказы или работу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a3ec98a-8887-3c83-a4c5-336f457b3527",
                    "sense_definition": "to provide a tip or inside information on a racehorse, often for a reward",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a living by <w>touting</w> horses to wealthy gamblers at the track.",
                            "target_lang_translations": {
                                "ru": "Он зарабатывал на жизнь, <w>давая наводки</w> на лошадей богатым игрокам на ипподроме."
                            }
                        },
                        {
                            "text": "The man offered to <w>tout</w> a winner in exchange for a small percentage of the profit.",
                            "target_lang_translations": {
                                "ru": "Мужчина предложил <w>подсказать</w> победителя в обмен на небольшой процент от прибыли."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in horse racing contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "давать советы или инсайдерскую информацию о скаковой лошади, часто за вознаграждение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать наводку",
                                "target_lang_sense_clarification": "предоставлять информацию о вероятном победителе"
                            },
                            {
                                "target_lang_word": "продавать советы",
                                "target_lang_sense_clarification": "торговать прогнозами на скачках"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b332974-ecf8-3409-8339-bb2355737fff",
                    "sense_definition": "a person who advertises for customers or sells tickets in an aggressive or unofficial way",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "salesperson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were approached by a ticket <w>tout</w> who tried to sell us front-row seats for double the price.",
                            "target_lang_translations": {
                                "ru": "К нам подошел <w>перекупщик</w> билетов, который пытался продать нам места в первом ряду вдвое дороже."
                            }
                        },
                        {
                            "text": "The stadium security tried to clear out every <w>tout</w> standing near the main entrance.",
                            "target_lang_translations": {
                                "ru": "Охрана стадиона пыталась выгнать каждого <w>спекулянта</w>, стоявшего у главного входа."
                            }
                        }
                    ],
                    "synonyms": [
                        "barker",
                        "pitchman",
                        "spruiker"
                    ],
                    "common_phrases": [
                        "ticket tout"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который навязчиво рекламирует услуги или перепродает билеты неофициальным способом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекупщик",
                                "target_lang_sense_clarification": "тот, кто перепродает билеты с наценкой"
                            },
                            {
                                "target_lang_word": "зазывала",
                                "target_lang_sense_clarification": "человек, навязчиво приглашающий клиентов"
                            },
                            {
                                "target_lang_word": "спекулянт",
                                "target_lang_sense_clarification": "лицо, занимающееся перепродажей билетов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bc5ed54-e205-37e7-860a-744c023079e5",
                    "sense_definition": "an informer, especially one who provides information to the police or authorities about a paramilitary group",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "informer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group suspected he was a <w>tout</w> and had been leaking their plans to the police.",
                            "target_lang_translations": {
                                "ru": "Группа подозревала, что он был <w>осведомителем</w> и сливал их планы полиции."
                            }
                        },
                        {
                            "text": "In certain neighborhoods, being labeled a <w>tout</w> was a very dangerous accusation.",
                            "target_lang_translations": {
                                "ru": "В некоторых районах клеймо <w>стукача</w> было очень опасным обвинением."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in Northern Ireland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "информатор, особенно тот, кто сообщает властям сведения о военизированных группах"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "информатор",
                                "target_lang_sense_clarification": "лицо, тайно сообщающее сведения властям"
                            },
                            {
                                "target_lang_word": "осведомитель",
                                "target_lang_sense_clarification": "секретный сотрудник полиции или спецслужб"
                            },
                            {
                                "target_lang_word": "стукач",
                                "target_lang_sense_clarification": "презрительное обозначение доносчика"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f7f4cc4-a520-32e7-9a82-5ceca2d23190",
                    "sense_definition": "a person at a racecourse who sells or provides supposedly secret information on which horse is likely to win",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>tout</w> whispered the name of the winning horse into the gambler's ear.",
                            "target_lang_translations": {
                                "ru": "Старый <w>типстер</w> прошептал имя победившей лошади на ухо игроку."
                            }
                        },
                        {
                            "text": "He spent his days at the track acting as a <w>tout</w> for anyone willing to pay.",
                            "target_lang_translations": {
                                "ru": "Он проводил дни на ипподроме, выступая в роли <w>советчика</w> для всех, кто готов был заплатить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "racing tout"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек на ипподроме, который продает якобы секретную информацию о том, какая лошадь победит"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "типстер",
                                "target_lang_sense_clarification": "профессиональный советчик по ставкам"
                            },
                            {
                                "target_lang_word": "торговец прогнозами",
                                "target_lang_sense_clarification": "человек, продающий советы на скачках"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}