                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439abbbe-589f-4394-a552-103e5b885484",
                                                "sense_id": "7b65f0b6-46d3-3ed6-8d8b-e966f278b7ed",
                                                "text": "A drive to exploit the Highlands as a winter sports area, with all the necessary auxiliaries, such as chair lifts in the Cairngorms, shows increasing promise, […]."
                                            },
                                            {
                                                "example_id": "6417790b-18f3-47f5-b789-29ad053d191a",
                                                "sense_id": "7b65f0b6-46d3-3ed6-8d8b-e966f278b7ed",
                                                "text": "Auxiliaries and ancillaries are comprehensive, and include a Westinghouse motor-driven recriprocating compressor used for locomotive braking and general service air, two rotary exhauster sets for train brakes when hauling passenger or fitted freight trains, and an oil-fired train heating boiler."
                                            },
                                            {
                                                "example_id": "79900dd3-9af2-422f-af96-f0ec8bae22a9",
                                                "sense_id": "7b65f0b6-46d3-3ed6-8d8b-e966f278b7ed",
                                                "text": "Summer “felt betrayed” that a close friend had used AI as “an auxiliary” to talk to her."
                                            }
                                        ]
                                    },
