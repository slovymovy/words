        "ru-extract.jsonl": [
            {
                "entry_id": "c46afbfc-c9f9-3259-a37b-eaa0ecb5a4db",
                "word": "идеологически",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "22e86d6d-813c-3772-98ae-e7f5154ae553",
                        "entry_id": "c46afbfc-c9f9-3259-a37b-eaa0ecb5a4db",
                        "glosses": [
                            "с точки зрения идеологии как системы идей; идейно, мировоззренчески"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f42b0a-4e3b-40e2-82cf-f1ec7d54018e",
                                "sense_id": "22e86d6d-813c-3772-98ae-e7f5154ae553",
                                "text": "Свобода духа начинает идеологически отрицаться, как ставшая недоступной для ума, оторвавшегося от вечного Смысла."
                            }
                        ]
                    },
                    {
                        "sense_id": "c287c520-d194-3e4c-be35-370e09ceaac0",
                        "entry_id": "c46afbfc-c9f9-3259-a37b-eaa0ecb5a4db",
                        "glosses": [
                            "в соответствии с законами и принципами какой-либо идеологии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4791bcd-4aa6-4c67-b9be-b2851070f4f8",
                                "sense_id": "c287c520-d194-3e4c-be35-370e09ceaac0",
                                "text": "Там один художник сделал картину из волос. Большую картину со многими фигурами, заметьте, идеологически выдержанную, хотя художник и пользовался волосами беспартийных, ― был такой грех. Но идеологически, повторяю, картина была замечательно выдержана."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aeb2e1a9-ca94-443f-83ea-a1ab9a845a04",
                        "source_entry_id": "c46afbfc-c9f9-3259-a37b-eaa0ecb5a4db",
                        "target_lang_word": "ideologically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ideologically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "970f5ec1-2f66-3e30-9849-7dbe597fcc15",
                                        "entry_id": "157e4a58-f9b1-382a-863f-b086ba1b139f",
                                        "glosses": [
                                            "In an ideological manner; with respect to ideology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53d5ffe8-c069-4957-a528-82b1f9b073cf",
                                                "sense_id": "970f5ec1-2f66-3e30-9849-7dbe597fcc15",
                                                "text": "Nevertheless intellectually, ideologically and politically he identified with industrialists whom he, just like Smith, saw as the usherers of progress."
                                            },
                                            {
                                                "example_id": "2a55fb2a-7190-43c2-972e-0a703f8e856e",
                                                "sense_id": "970f5ec1-2f66-3e30-9849-7dbe597fcc15",
                                                "text": "His warning was chillingly resonant of late 20th century clashes between two ideologically opposed superpowers."
                                            },
                                            {
                                                "example_id": "88977aa9-8e07-4485-b76d-586fb50a09fa",
                                                "sense_id": "970f5ec1-2f66-3e30-9849-7dbe597fcc15",
                                                "text": "The Tories are ideologically opposed to large state-run industries, and the Lib Dems can sniff an opportunity to score points in their freshly won commuting constituencies outside London."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45dd5651-eb9b-4133-a117-4d4108db2328",
                        "source_entry_id": "c46afbfc-c9f9-3259-a37b-eaa0ecb5a4db",
