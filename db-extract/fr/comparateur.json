                                    {
                                        "sense_id": "370014e3-7be8-3942-a0c5-b4efc2f74a64",
                                        "entry_id": "adba7b0f-4015-309c-8539-4eddb82e999b",
                                        "glosses": [
                                            "An electronic device that compares two voltages, currents or streams of data."
