                ],
                "senses": [
                    {
                        "sense_id": "e2cffc60-8f70-3b6f-b342-b9cfb8f89a90",
                        "entry_id": "51d40317-acc1-3be4-9e84-5612f036af15",
                        "glosses": [
                            "Gâteau où, pour une livre, il entre un quart de farine, un quart de beurre, un quart de sucre et deux œufs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "add2b473-d10a-4235-918f-46f24842c5bf",
                                "sense_id": "e2cffc60-8f70-3b6f-b342-b9cfb8f89a90",
                                "text": "Chaque jour, en rentrant du lycée, elle préparait des quatre-quarts, des tartes aux pommes et autres délices de la pâtisserie occidentale."
                            },
                            {
                                "example_id": "273efcfb-7418-4e29-b667-d86f5abd3c18",
                                "sense_id": "e2cffc60-8f70-3b6f-b342-b9cfb8f89a90",
                                "text": "Les plats de prédilection de ce gourmand qui surveille sans trop y croire sa balance sont restés ceux que lui cuisinait sa mère : les spaghetti aux palourdes, le poulet rôti-pommes de terre, et le ciambellone contadino, une sorte de quatre-quarts maison."
                            },
                            {
                                "example_id": "4316160a-d898-4add-a462-3ec4a7538c9a",
                                "sense_id": "e2cffc60-8f70-3b6f-b342-b9cfb8f89a90",
                                "text": "Un premier quatre-quarts est déjà cuit, on le mange tous ensemble sur les bancs de la cuisine où flotte une odeur de citron et de café."
                            }
                        ]
                    },
                    {
                        "sense_id": "0568815f-3486-32bf-902a-616b00485abf",
                        "entry_id": "51d40317-acc1-3be4-9e84-5612f036af15",
                        "glosses": [
                            "Fraction 4/4 (valant 1)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d69c6674-c4b4-4ec7-b558-1eaab961e2b1",
                        "source_entry_id": "51d40317-acc1-3be4-9e84-5612f036af15",
                        "target_lang_word": "Rührkuchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rührkuchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db0773f7-5aad-3d9c-aa4f-ed3863890c7c",
                                        "entry_id": "481c72c3-5058-3148-a6c9-4831c5112bc8",
                                        "glosses": [
                                            "Kuchen aus einem angerührten, nicht gekneteten Teig (Rührteig), der in einer Form gebacken wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffb3a874-b5eb-403f-b1d1-8035d2f6a109",
                                                "sense_id": "db0773f7-5aad-3d9c-aa4f-ed3863890c7c",
                                                "text": "„Bei Eiern, die bereits im Ausland in Fertigprodukte gemischt werden, ist die Lage vollends unübersichtlich. In Instantnudeln aus Asien stecken wohl kaum gute Eier. Wer ganz sichergehen will, dass im Rührkuchen oder in den Bandnudeln keine Käfigeier versteckt sind, dem bleibt zurzeit nichts anderes übrig, als reine Bioprodukte zu kaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c959aa8-a11c-4e43-bc01-69ef1ea94966",
                        "source_entry_id": "51d40317-acc1-3be4-9e84-5612f036af15",
                        "target_lang_word": "pound cake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pound cake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2bcc5e7-4052-386a-aaee-cc1a59e36537",
                                        "entry_id": "8f61b855-7090-3142-9f66-75693e07ce3b",
                                        "glosses": [
                                            "A dense yellow cake, the traditional recipe for which consists of equal quantities (nominally one pound) of butter, eggs, flour, and sugar."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55115152-0d5e-4f14-8019-dbcdcaa0f14a",
                                                "sense_id": "c2bcc5e7-4052-386a-aaee-cc1a59e36537",
                                                "text": "But when I got to Anita Bryant′s pound cake, I stopped looking. Her recipe is my favorite so far. The cream isn′t quite authentic—real pound cakes are supposed to contain only butter, sugar, eggs and flour—but it does make the cake′s texture meltier."
                                            },
                                            {
                                                "example_id": "20be1bf1-f01f-4c25-80f1-e55628585494",
                                                "sense_id": "c2bcc5e7-4052-386a-aaee-cc1a59e36537",
                                                "text": "Pound cakes, butter cakes with a tender fine crumb, are English in origin. In the 1700s and 1800s, the basic cake formula was based on the pound cake—butter, sugar, flour, and eggs in equal proportions by weight, with no chemical leavening added."
                                            },
                                            {
                                                "example_id": "edd5ff90-c376-42f1-8c6c-d462fb2dce14",
                                                "sense_id": "c2bcc5e7-4052-386a-aaee-cc1a59e36537",
                                                "text": "Satisfied her aunt had things under control, Addy put on the coffee and sliced and arranged the pound cake on a cookie sheet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e23e63d4-a5e8-3c4f-b612-156017b435c3",
                                        "entry_id": "8f61b855-7090-3142-9f66-75693e07ce3b",
                                        "glosses": [
                                            "A term of attraction or desire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa7bf640-3770-42ca-b746-d6b5a42cd998",
                                                "sense_id": "e23e63d4-a5e8-3c4f-b612-156017b435c3",
                                                "text": "She's a cute little pound cake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87328840-0058-3faf-b452-6bbb22537071",
                                        "entry_id": "8f61b855-7090-3142-9f66-75693e07ce3b",
                                        "glosses": [
                                            "A butt cheek."
                                        ],
