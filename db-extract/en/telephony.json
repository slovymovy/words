                                        "entry_id": "adca8c14-9c3b-358f-aa9d-3cdedc522958",
                                        "glosses": [
                                            "Gesamtheit der organisatorischen Maßnahmen und Einrichtungen, die dem Aufbau oder der Unterhaltung eines Fernsprechnetzes dienen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7a5c28f-b3cd-44e4-a761-eed6421037d6",
                                                "sense_id": "c7dc8de4-f6ff-3ee1-9459-4b410048d0bf",
                                                "text": "„So hat der Siemenskonzern das Fernsprechwesen, namentlich die Selbstanschlußanlagen besonders berücksichtigt.“"
                                            },
                                            {
                                                "example_id": "478be0ab-1a2b-4950-a982-bfa0009b2bdc",
                                                "sense_id": "c7dc8de4-f6ff-3ee1-9459-4b410048d0bf",
                                                "text": "„Schon 1962 war die „Produktivität“ der im Fernsprechwesen eingesetzten 118700 Arbeitskräfte etwa zweieinhalbmal so groß wie bei den Beschäftigten im Postdienst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
