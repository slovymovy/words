                        "tags": [],
                        "examples": [
                            {
                                "example_id": "174e1aa5-b35f-4c88-9371-0cad5286ece9",
                                "sense_id": "d7f9aebb-c754-3668-845b-bd27e6de2df9",
                                "text": "'Een enkeling, zoals maaglijder Charles Darwin, zou ik graag een kuurtje hebben gegeven. Maar de rest niet. Terwijl waarschijnlijk ongeveer de hele bevolking drager van de bacterie was.'"
                            },
                            {
                                "example_id": "8a6c4213-95a2-4d3f-9520-7b4b708bf8c4",
                                "sense_id": "d7f9aebb-c754-3668-845b-bd27e6de2df9",
                                "text": "Er is nog een andere veelzeggende tegenstelling: Erasmus was een maaglijder en zonder twijfel een schrale eter; Luther hield van de overvloed in eten en drinken."
                            }
                        ]
                    }
