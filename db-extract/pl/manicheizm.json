                        "sense_id": "50ed08ff-270e-35db-9cae-da251291c53e",
                        "entry_id": "2c8957e5-34b1-33cc-840d-88cd7df2e683",
                        "glosses": [
                            "system religijno-filozoficzny, stworzony przez Maniego, zgodnie z którym podstawą bytu są dwie przeciwstawne siły: dobro i zło oraz światło i ciemność"
                        ],
                        "tags": [],
