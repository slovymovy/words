{
    "word_family": [
        "прижимать",
        "прижатие",
        "прижим",
        "жать",
        "сжать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e41a1f1-30cf-3ab8-b14f-a660c00babb9",
                    "sense_definition": "Тесно, плотно прислониться или приблизиться вплотную к кому-либо или чему-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Маленький испуганный ребёнок крепко <w>прижался</w> к матери и тихо заплакал.",
                            "target_lang_translations": {
                                "en": "The frightened little child <w>pressed tightly against</w> his mother and wept quietly."
                            }
                        },
                        {
                            "text": "От сильного холода пассажиры на остановке <w>прижались</w> друг к другу.",
                            "target_lang_translations": {
                                "en": "Because of the severe cold, the passengers at the bus stop <w>huddled</w> close to one another."
                            }
                        }
                    ],
                    "synonyms": [
                        "прильнуть",
                        "прислониться"
                    ],
                    "antonyms": [
                        "отстраниться",
                        "отлипнуть"
                    ],
                    "common_phrases": [
                        "прижаться к стене",
                        "прижаться к груди",
                        "прижаться друг к другу"
                    ],
                    "target_lang_definitions": {
                        "en": "To press closely against, lean tightly against, or snuggle up to someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "press oneself",
                                "target_lang_sense_clarification": "against someone or something"
                            },
                            {
                                "target_lang_word": "snuggle up",
                                "target_lang_sense_clarification": "to someone for comfort or warmth"
                            },
                            {
                                "target_lang_word": "cuddle up",
                                "target_lang_sense_clarification": "close to someone affectionately"
                            },
                            {
                                "target_lang_word": "huddle",
                                "target_lang_sense_clarification": "close together, e.g. for warmth or safety"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e8e1891-2b23-39ae-9ba7-e0de752b9e9d",
                    "sense_definition": "Страдательный залог к глаголу <w>прижать</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дверь плотно <w>прижалась</w> сквозняком к косяку, и её заклинило.",
                            "target_lang_translations": {
                                "en": "The door <w>was slammed shut</w> against the frame by the draft and got jammed."
                            }
                        },
                        {
                            "text": "Листок бумаги случайно <w>прижался</w> тяжёлой книгой к столу.",
                            "target_lang_translations": {
                                "en": "The piece of paper accidentally <w>got pinned</w> to the table by a heavy book."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be pressed, pinned down, or held firmly against a surface (passive sense)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be pressed",
                                "target_lang_sense_clarification": "held firmly against a surface"
                            },
                            {
                                "target_lang_word": "be pinned",
                                "target_lang_sense_clarification": "held tightly down by something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}