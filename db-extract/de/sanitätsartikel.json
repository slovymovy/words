                "senses": [
                    {
                        "sense_id": "acf03f6b-59d8-3192-b916-b22dfa053327",
                        "entry_id": "25e8c55e-f009-38b8-b99c-f8cfabad67e7",
                        "glosses": [
                            "Ware, die für die Gesundheitsversorgung und Pflege Kranker benutzt wird"
                        ],
                        "tags": [
                            "Handel"
                        ],
                        "examples": [
                            {
                                "example_id": "832c3383-5d01-461f-bd5c-ae98f02be4b0",
                                "sense_id": "acf03f6b-59d8-3192-b916-b22dfa053327",
                                "text": "In der Sanitätstasche befinden sich die Sanitätsartikel."
                            },
                            {
                                "example_id": "4cccbbea-1df5-4b90-bd6e-9796fa347d10",
                                "sense_id": "acf03f6b-59d8-3192-b916-b22dfa053327",
                                "text": "Sanitätsartikel kauft man entweder in der Apotheke oder im Sanitätshaus, dem Sanitätsfachhandel."
                            },
                            {
                                "example_id": "3ba2e950-6106-47f5-833e-3ba26b79a5d0",
                                "sense_id": "acf03f6b-59d8-3192-b916-b22dfa053327",
                                "text": "„Anfangs bis Mitte des Jahrhunderts waren es die Bandagisten die Bandagen, Verbände und Sanitätsartikel herstellten und vertrieben.“"
                            }
                        ],
