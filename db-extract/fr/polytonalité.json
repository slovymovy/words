                        "entry_id": "3b0cdd8f-1f9f-3e1b-a03e-1f26efe5a4df",
                        "glosses": [
                            "Utilisation de plusieurs tonalités au sein d'une même partition, par différents instruments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "169f06e2-cfd5-4c41-9fb8-57dec6ceb2ce",
                                "sense_id": "ba381580-dfbf-326a-a760-028a148b02e7",
                                "text": "La polytonalité n'apparaît clairement en tant que telle qu'à partir du début du XXe siècle, en particulier chez Stravinski."
                            },
                            {
                                "example_id": "e9dd3d20-5294-4763-89bb-bdcfd3db2e46",
                                "sense_id": "ba381580-dfbf-326a-a760-028a148b02e7",
                                "text": "La polytonalité a été pratiquée au XXᵉ siècle par des compositeurs plus ou moins hostiles à l’atonalité, comme Roussel et Milhaud."
                            }
                        ]
                    }
                ],
