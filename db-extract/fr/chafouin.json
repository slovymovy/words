                        "entry_id": "d32de513-741f-3e15-963a-32e420d6d04b",
                        "glosses": [
                            "Celui qui est maigre, de petite taille, avec une mine basse et sournoise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd7a57ec-0116-4c0d-acc3-2efa26a870f9",
                                "sense_id": "e5357c38-c9d2-3265-8e22-bc7e2ff50da8",
                                "text": "Sans répondre, l’argousin fait signe à ses hommes et s’en va bien vite. À peine est-il sorti dans la rue qu’un chafouin l’aborde : […]."
                            }
                        ]
                    }
