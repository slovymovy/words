                        "glosses": [
                            "Qui a la forme dʼune tache, qui en a lʼaspect."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "72e9c8b3-007f-4e26-bd29-9b98f8a1d4cc",
                                "sense_id": "34d307bc-947c-3005-8268-ba81b2a70b52",
                                "text": "MACULIFORME, adj., maculiformis, maculæformis (macula, tache, forma, forme) ; qui a la forme d’une tache, comme la fructification de certaines algues (ex. Dictyota dichotoma), ou comme divers champignons (ex. Auricularia maculæformis, Carcinotrichum maculiforme). Se dit aussi des écailles qui garnissent le chapeau de l’Agaricus lapideus."
                            },
                            {
                                "example_id": "f5c52730-b266-4350-9940-75d9e1b1c34e",
                                "sense_id": "34d307bc-947c-3005-8268-ba81b2a70b52",
                                "text": "La bande postérieure du premier segment est moins maculiforme et plus étendue que chez le type."
                            }
                        ]
                    }
