    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "407cdb7b-6d46-3835-b431-a79abdd71f9d",
                    "sense_definition": "present participle and gerund of <w>incline</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incline_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stood by the window, gently <w>inclining</w> her head to hear what he was whispering.",
                            "target_lang_translations": {
                                "ru": "Она стояла у окна, слегка <w>наклонив</w> голову, чтобы расслышать его шепот."
                            }
                        },
                        {
                            "text": "The committee members are <w>inclining</w> toward accepting the revised proposal.",
                            "target_lang_translations": {
                                "ru": "Члены комитета <w>склоняются</w> к принятию пересмотренного предложения."
                            }
                        }
                    ],
                    "synonyms": [
                        "leaning",
                        "sloping",
                        "tending"
                    ],
                    "common_phrases": [
                        "inclining toward",
                        "inclining his head",
                        "inclining her head"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола incline: наклоняющий(ся), склоняющий(ся); склонение, наклон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклоняющий",
                                "target_lang_sense_clarification": "физический наклон (головы, тела)"
                            },
                            {
                                "target_lang_word": "склоняющийся",
                                "target_lang_sense_clarification": "к определенному мнению, решению или выбору"
                            },
                            {
                                "target_lang_word": "склоняя",
                                "target_lang_sense_clarification": "деепричастие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "269fbb4a-4091-3ec6-9a18-8ba1aad69d3f",
                    "sense_definition": "An inclination, leaning, or tendency.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inclination_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to resist his natural <w>inclining</w> toward solitude and attend the social gathering.",
                            "target_lang_translations": {
                                "ru": "Он попытался побороть свою природную <w>склонность</w> к уединению и прийти на встречу."
                            }
                        },
                        {
                            "text": "Despite several <w>inclinings</w> to abandon the challenging project, she persevered to the end.",
                            "target_lang_translations": {
                                "ru": "Несмотря на неоднократные <w>порывы</w> бросить сложный проект, она довела дело до конца."
                            }
                        }
                    ],
                    "synonyms": [
                        "inclination",
                        "leaning",
                        "propensity",
                        "tendency"
                    ],
                    "antonyms": [
                        "aversion",
                        "disinclination"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rare or archaic in modern English, inclination is preferred."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонность, влечение или предрасположенность (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склонность",
                                "target_lang_sense_clarification": "предрасположенность к чему-либо"
                            },
                            {
                                "target_lang_word": "влечение",
                                "target_lang_sense_clarification": "тяга к чему-либо"
                            },
                            {
                                "target_lang_word": "порыв",
                                "target_lang_sense_clarification": "побуждение или импульс"
                            }
                        ]
                    }
                }
            ]
        }
    ]
