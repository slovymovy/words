                "senses": [
                    {
                        "sense_id": "7616ff18-8118-3043-ab5c-bffcdcc0537d",
                        "entry_id": "ddc20d9b-97cc-3200-8521-a3660bb06823",
                        "glosses": [
                            "Composition artistique ou littéraire dont les sujets ou les détails pittoresques sont empruntés aux mœurs turques ou au décor oriental."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f2c6217-8d89-4c16-8c8e-1c8b36b66a6a",
                                "sense_id": "7616ff18-8118-3043-ab5c-bffcdcc0537d",
                                "text": "L’une des raisons du succès qu’elle avait remporté à l’époque était ce portrait si juste que brossait Molière de la société entichée des « turqueries », mais aussi du « vouloir paraître »."
                            },
                            {
                                "example_id": "3470a8a7-e300-45af-b68c-907877e4d612",
                                "sense_id": "7616ff18-8118-3043-ab5c-bffcdcc0537d",
                                "text": "Nous traversons donc cette ville magique au crépuscule où tout n’est plus que halo, lumière tamisée, turquerie, juiverie, autrichiennerie, modernisme socialiste."
                            },
                            {
                                "example_id": "0563d5bd-14fc-4227-9d99-4d1def23a67c",
                                "sense_id": "7616ff18-8118-3043-ab5c-bffcdcc0537d",
                                "text": "Le roi veut un ballet, et qu’il y ait une turquerie plaisante ; au poète, au musicien, aux danseurs de bâtir là-dessus un divertissement qui plaise au roi."
                            }
                        ]
                    },
                    {
                        "sense_id": "d28d208d-4f13-3ad3-878c-793d7d52a2fe",
                        "entry_id": "ddc20d9b-97cc-3200-8521-a3660bb06823",
                        "glosses": [
                            "Objet, bibelot d’Orient."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "35d2d1d5-5e1d-346d-95c4-6e9fb324911a",
                        "entry_id": "ddc20d9b-97cc-3200-8521-a3660bb06823",
                        "glosses": [
                            "Âpreté, dureté."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e524c024-a0be-4603-a669-f79e4bbbd32a",
                                "sense_id": "35d2d1d5-5e1d-346d-95c4-6e9fb324911a",
                                "text": "Il est Turc là-dessus, mais d’une turquerie à désespérer tout le monde."
                            }
                        ]
                    }
