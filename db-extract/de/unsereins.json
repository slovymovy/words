                    {
                        "translation_id": "0411c2b7-a0c5-4826-ba12-100e62b04046",
                        "source_entry_id": "2767ab06-460f-3ed4-ac1e-8e71a033163f",
                        "source_sense_id": "77118912-1a66-3e4a-b288-910b9536ba3c",
