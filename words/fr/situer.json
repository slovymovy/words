    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b3253c9-9832-342e-9382-525894b3a9da",
                    "sense_definition": "Se trouver dans un lieu ou un espace déterminé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "localisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre nouvel appartement se <w>situe</w> juste à côté de l'école primaire."
                        },
                        {
                            "text": "Ce célèbre musée se <w>situe</w> en plein centre de la capitale."
                        }
                    ],
                    "synonyms": [
                        "se trouver"
                    ],
                    "common_phrases": [
                        "se situer à",
                        "se situer dans"
                    ]
                },
                {
                    "sense_id": "e6e914ca-49c2-314b-9450-bfb2b2fd3409",
                    "sense_definition": "Placer ou repérer un élément dans un lieu, une époque ou un contexte particulier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "localisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur a choisi de <w>situer</w> son roman au début du dix-neuvième siècle."
                        },
                        {
                            "text": "L'élève a réussi à <w>situer</w> chaque pays sur la carte du monde."
                        }
                    ],
                    "synonyms": [
                        "localiser",
                        "positionner"
                    ],
                    "common_phrases": [
                        "situer dans le temps",
                        "situer sur une carte"
                    ]
                },
                {
                    "sense_id": "931ce586-1c06-359b-84fa-d5682e1d623c",
                    "sense_definition": "Identifier mentalement l'emplacement, l'identité ou le rôle de quelqu'un ou de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "localisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son visage m'est familier mais je n'arrive pas du tout à le <w>situer</w>."
                        },
                        {
                            "text": "Elle a mentionné ce village mais personne autour de la table ne le <w>situe</w>."
                        }
                    ],
                    "synonyms": [
                        "remettre"
                    ],
                    "common_phrases": [
                        "situer une personne"
                    ]
                }
            ]
        }
