                "senses": [
                    {
                        "sense_id": "2207f903-6604-3a2d-b380-669074d46186",
                        "entry_id": "9286f6b1-86a4-3777-8f33-65a947a2b7c4",
                        "glosses": [
                            "Wiedererleben von bereits erlebten Gefühlszuständen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53ae6d25-0283-44f2-9ce2-bcc1fd1fa160",
                                "sense_id": "2207f903-6604-3a2d-b380-669074d46186",
                                "text": "Bei einigen Drogen kann es nach der Einnahme zu Flashbacks kommen."
                            },
                            {
                                "example_id": "02f3dfa4-90f6-49fa-afd4-e223d1ed02d7",
                                "sense_id": "2207f903-6604-3a2d-b380-669074d46186",
                                "text": "Das schreckliche Ereignis erlebte Dorothea in Form von Flashbacks immer wieder."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "95420a9a-6dc7-37a9-b21f-f14a608d4327",
                        "entry_id": "9286f6b1-86a4-3777-8f33-65a947a2b7c4",
                        "glosses": [
                            "Erzähltechnik, bei der Geschehnisse gezeigt werden, die zeitlich vor den bereits gezeigten liegen"
                        ],
                        "tags": [
                            "Film"
                        ],
                        "examples": [
                            {
                                "example_id": "e87ed6fe-3322-4357-ba14-6edf8cc8582b",
                                "sense_id": "95420a9a-6dc7-37a9-b21f-f14a608d4327",
                                "text": "In einem Flashback wird nun gezeigt, wie sich die beiden Helden kennen gelernt haben."
                            },
                            {
                                "example_id": "557dce08-bff2-47b0-9789-39a1e1d6a80c",
                                "sense_id": "95420a9a-6dc7-37a9-b21f-f14a608d4327",
                                "text": "Erst kurz vor Ende des Films wird mit einem Flashback enthüllt, wer der Mörder war."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7debf679-e82f-48ad-810c-8f50f25bbc96",
                        "source_entry_id": "9286f6b1-86a4-3777-8f33-65a947a2b7c4",
                        "source_sense_id": "2207f903-6604-3a2d-b380-669074d46186",
                        "source_sense_description": "Medizin: Wiedererleben von bereits erlebten Gefühlszuständen",
                        "target_lang_word": "flashback",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flashback",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "078b72cc-c5fd-3b40-a077-5c7aeb7629fa",
                                        "entry_id": "61c8c944-9c0e-3e77-97e5-491c008f1a3a",
                                        "glosses": [
                                            "A dramatic device in which an earlier event is inserted into the normal chronological flow of a narrative."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e32560d-09f9-378c-a04e-1127064ae049",
                                        "entry_id": "61c8c944-9c0e-3e77-97e5-491c008f1a3a",
                                        "glosses": [
                                            "A vivid mental image of a past trauma or other sensation that the trauma is happening in the present, especially one that recurs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f42d3b2-f43f-335c-a705-4370fc465619",
                                        "entry_id": "61c8c944-9c0e-3e77-97e5-491c008f1a3a",
                                        "glosses": [
                                            "A similar recurrence of the effects of a hallucinogenic drug."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04440c8a-5fec-400f-802f-c849b2328e37",
                                                "sense_id": "5f42d3b2-f43f-335c-a705-4370fc465619",
                                                "text": "Maude Lebowski: What do you do for recreation? / The Dude: Oh, the usual. I bowl. Drive around. The occasional acid flashback."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fa977d9-998a-3181-a224-63d1e12f92aa",
                                        "entry_id": "61c8c944-9c0e-3e77-97e5-491c008f1a3a",
                                        "glosses": [
                                            "The condition of the flame propagating down the hose of an oxy-fuel welding system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd69fda6-8692-386c-b59d-1b7b2339d859",
                                        "entry_id": "61c8c944-9c0e-3e77-97e5-491c008f1a3a",
                                        "glosses": [
                                            "A query that operates against data from an earlier time, before it was changed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "290237dc-117a-404e-b51f-b3db2bcf3a01",
                                                "sense_id": "dd69fda6-8692-386c-b59d-1b7b2339d859",
                                                "text": "As noted, that method provides limited support for multi-table flashbacks."
                                            },
                                            {
                                                "example_id": "97dedb83-7e8f-484d-9ffb-a8ac3b9843e7",
                                                "sense_id": "dd69fda6-8692-386c-b59d-1b7b2339d859",
                                                "text": "[…] less used and specialized types of queries, including composite queries, hierarchical queries, version flashbacks, and parallel queries."
                                            }
                                        ]
                                    }
                                ]
                            },
