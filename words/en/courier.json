                    "sense_definition": "A surname originating as an occupation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We have a meeting scheduled with Mr. <w>Courier</w> at ten o'clock.",
                            "target_lang_translations": {
                                "ru": "У нас запланирована встреча с мистером <w>Курье</w> на десять часов.",
                                "zh": "我们定于十点与<w>库里耶</w>先生会面。"
                            }
                        },
                        {
                            "text": "Jim <w>Courier</w> was a dominant figure in professional tennis during the 1990s.",
                            "target_lang_translations": {
                                "ru": "Джим <w>Курье</w> был доминирующей фигурой в профессиональном теннисе в 1990-х годах.",
                                "zh": "吉姆·<w>库里耶</w>是 20 世纪 90 年代职业网坛的领军人物。"
                            }
                        }
                    ],
