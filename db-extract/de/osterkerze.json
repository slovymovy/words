                ],
                "senses": [
                    {
                        "sense_id": "3bd6e42c-f1a5-3633-be04-61a593cd8d08",
                        "entry_id": "c17491a9-3488-333e-ac5a-14b3a06f58ff",
                        "glosses": [
                            "Kerze, die in der Osternacht mit den Buchstaben Alpha (Α) und Omega (Ω) bestückt und am Osterfeuer angezündet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45a55933-7d39-4f37-8cf7-7981ea0e51d4",
                                "sense_id": "3bd6e42c-f1a5-3633-be04-61a593cd8d08",
                                "text": "Die Osterkerze wird während der Osternacht am Osterfeuer entzündet."
                            },
                            {
                                "example_id": "3c7fc0e5-3ea8-4ebd-b3df-733d496aa0dc",
                                "sense_id": "3bd6e42c-f1a5-3633-be04-61a593cd8d08",
                                "text": "Wenn die Osterkerze angezündet wird und der Ruf ›Lumen Christi‹ erklingt, ist das das Zeichen, dass der Tod vor dem Leben und die Finsternis vor dem Licht weichen muss."
                            },
                            {
                                "example_id": "956001fd-6118-4b7f-8c2b-ce55ab8c7c14",
                                "sense_id": "3bd6e42c-f1a5-3633-be04-61a593cd8d08",
                                "text": "„Wir versprachen, im Sommer wiederzukommen, und die Bäuerin gab mir noch eine hausgemachte Mettwurst und eine Kerze, eine Osterkerze vom vergangenen Jahr, dem Todesjahr, mit auf den Weg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
