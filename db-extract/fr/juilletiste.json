                ],
                "senses": [
                    {
                        "sense_id": "2919bdde-978b-31e4-9fbc-9d604790651b",
                        "entry_id": "ea5142db-827f-394b-9433-5fafa61ae0c8",
                        "glosses": [
                            "Personne qui prend ses vacances au mois de juillet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8f67070-4b2a-404a-b792-943ec778cb51",
                                "sense_id": "2919bdde-978b-31e4-9fbc-9d604790651b",
                                "text": "Quelqu’un s'exclama « Là ! », pointant le doigt en l’air, plus exalté qu’un juilletiste dénichant une table libre dans une gargote bondée en front de mer."
                            },
                            {
                                "example_id": "157954ae-bbc9-4dec-99eb-8ce73a066aeb",
                                "sense_id": "2919bdde-978b-31e4-9fbc-9d604790651b",
                                "text": "Ça y est, les juilletistes et les aoûtiens ont levé le camp."
                            },
                            {
                                "example_id": "7ab65bf3-9e73-4b4c-8c79-3ef0c7f24b8c",
                                "sense_id": "2919bdde-978b-31e4-9fbc-9d604790651b",
                                "text": "Le traditionnel chassé-croisé des juilletistes et aoûtiens s’est traduit, samedi, par d’énormes bouchons sur les autoroutes, mais moindres que l’an dernier, tandis que la journée a surtout été marquée par quelques retards pour les TGV Méditerranée à cause d’un incendie près de la voie."
                            },
                            {
                                "example_id": "8a6a3fe5-35ab-4bfc-aac3-6ea9dc64f03e",
                                "sense_id": "2919bdde-978b-31e4-9fbc-9d604790651b",
                                "text": "À la radio, l’animateur souhaitait de bonnes vacances aux aoûtiens, et bon courage aux juilletistes qui allaient reprendre le taf lundi."
                            }
                        ]
                    }
                ],
