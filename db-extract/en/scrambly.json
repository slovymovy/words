                            "of a walk"
                        ],
                        "examples": [
                            {
                                "example_id": "e1a142c0-1c1d-42e4-975a-368f3109031e",
                                "sense_id": "81c72b73-f79e-353d-840a-751694b40b88",
                                "text": "You can now take a steep and scrambly path uphill to the higher, waymarked path, or else return to the roadside for the official start of that same path."
                            },
                            {
                                "example_id": "c1e4a065-01c9-4429-b416-06995b68401f",
                                "sense_id": "81c72b73-f79e-353d-840a-751694b40b88",
                                "text": "A ledge takes you behind the first fall, then it's over a rise and down a steep scrambly gully in the shadow of towering red flanks..."
                            },
                            {
                                "example_id": "144e095f-88cc-43a0-9cc8-2bc58f201dcf",
                                "sense_id": "81c72b73-f79e-353d-840a-751694b40b88",
                                "text": "In summer this is a scrambly mixture of vegetation and loose rock; when frozen solid or snow covered it's rather more pleasant."
                            }
                        ]
                    },
                    {
                        "sense_id": "607b9daf-f2cc-3f18-9f6e-532fbc9f0df6",
                        "entry_id": "294f761b-dfb2-3a0c-8617-6bad09fecbb8",
                        "glosses": [
                            "scrambled, mixed-up, unclear, garbled"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "7f1ae320-b912-41b4-b2b4-f47c06312470",
                                "sense_id": "607b9daf-f2cc-3f18-9f6e-532fbc9f0df6",
                                "text": "It is possible, in this scrambly way, not only to see colours, but almost to smell them, too."
                            }
                        ]
