                    "sense_definition": "Qui a une admiration excessive pour soi-même.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "admiration_soi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son attitude particulièrement <w>narcissique</w> agace tous ses collègues de bureau au quotidien."
                        },
                        {
                            "text": "Il passe des heures devant le miroir en raison d'un comportement très <w>narcissique</w>."
                        }
                    ],
                    "synonyms": [
