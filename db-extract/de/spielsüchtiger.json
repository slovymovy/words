                "senses": [
                    {
                        "sense_id": "82836adb-87ad-359c-8654-6f80dfd5b04e",
                        "entry_id": "8c2b5370-2ae8-3d26-a194-62abe5db930d",
                        "glosses": [
                            "Person, die spielsüchtig ist; jemand, der ein krankhaftes Verlangen nach Glücksspielen zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "730f34fa-5414-4995-a957-71ae0207948c",
                                "sense_id": "82836adb-87ad-359c-8654-6f80dfd5b04e",
                                "text": "„Er zerrt mich aus der Gruppe der Spielsüchtigen.“"
                            },
                            {
                                "example_id": "05f0d43f-0f99-41f1-b2bc-4dc5cb58a23f",
                                "sense_id": "82836adb-87ad-359c-8654-6f80dfd5b04e",
                                "text": "„Der Spielsüchtige […] geht seiner Triebbefriedigung nach. Er riskiert etwas und will mit dem Sieg belohnt werden, um das Dopamin zu bekommen, nach denen das Es verlangt.“"
                            }
                        ],
