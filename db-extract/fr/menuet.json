                                    {
                                        "sense_id": "3be8f1b8-b3e0-3bd0-946c-1a70aae5d31e",
                                        "entry_id": "93db692d-3325-3742-930b-76b5bf163686",
                                        "glosses": [
                                            "A tune or air to regulate the movements of the minuet dance: it has the dance form, and is commonly in 3/4, sometimes 3/8, measure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "deb585df-6a20-3d94-a350-8d461540718f",
                                        "entry_id": "93db692d-3325-3742-930b-76b5bf163686",
                                        "glosses": [
                                            "A complete short musical composition inspired by and conforming to many formal characteristics of the traditional musical accompaniment to the dance of same name."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1078f473-f971-3cb0-b603-f40633741de9",
                                        "entry_id": "93db692d-3325-3742-930b-76b5bf163686",
                                        "glosses": [
                                            "A movement which is part of a longer musical composition such as a suite, sonata, or symphony which is inspired by and conforming to formal characteristics of the dance of same name."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "minuet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "baab2089-7550-3811-9b98-ff5f8c8568e3",
                                        "entry_id": "13f4c959-50af-3762-be1e-e90d54300467",
                                        "glosses": [
                                            "To dance a minuet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dc7a9ed-034d-46d2-a0a1-d9a919fffa5f",
                                                "sense_id": "baab2089-7550-3811-9b98-ff5f8c8568e3",
                                                "text": "After he had raved his time upon the stage, the ladies and knights again minueted for an hour, and again gave place."
                                            },
                                            {
                                                "example_id": "5ead3c61-0207-4954-bb74-51fb4dd1e564",
                                                "sense_id": "baab2089-7550-3811-9b98-ff5f8c8568e3",
                                                "text": "Within the same circle with the pigeons, were beautiful albatrosses, poising and minueting with them in the most pleasing fellowship."
                                            },
                                            {
                                                "example_id": "5727b30c-81c2-420b-8576-85585c50a332",
                                                "sense_id": "baab2089-7550-3811-9b98-ff5f8c8568e3",
                                                "text": "This set the pattern for four years, as the two monarchs minueted around the vast Commonwealth, never again to face each other personally in battle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
