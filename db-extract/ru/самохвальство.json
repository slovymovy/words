                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2781fc7-f5c1-42ee-9102-b712df7a27ce",
                                "sense_id": "a4552ee5-50d9-3a01-a0e1-92ad8c1da4ed",
                                "text": "— Да, в меня́ здесь все влюбля́ются, — с угрю́мым самохва́льством сказа́л Передо́нов.",
                                "translation": "\" Yes, everyone falls in love with me here,\" said Peredonov with a grave boastfulness.",
                                "english": "\" Yes, everyone falls in love with me here,\" said Peredonov with a grave boastfulness."
                            }
                        ]
