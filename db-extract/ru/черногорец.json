                    {
                        "translation_id": "704f528b-ebc9-41d0-875f-bea9e7c12e4f",
                        "source_entry_id": "a7decaee-6aaa-32cb-8a75-8f7f77ec073c",
                        "source_sense_id": "801644fc-2f4f-3aa6-ab2e-33c9c01d200e",
