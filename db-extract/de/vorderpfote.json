                ],
                "senses": [
                    {
                        "sense_id": "980b56ad-7fbe-3d2a-8d03-7cfcdfddc5ce",
                        "entry_id": "ffea8eff-5735-3bf2-b40a-718285d6f333",
                        "glosses": [
                            "Pfote von einem Vorderbein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccb57e6b-fd11-45d2-b2c5-f546cdef811c",
                                "sense_id": "980b56ad-7fbe-3d2a-8d03-7cfcdfddc5ce",
                                "text": "Der Hund hat eine verletzte Vorderpfote."
                            },
                            {
                                "example_id": "e18796c8-0a5d-410f-9a2c-19f4752ba5c9",
                                "sense_id": "980b56ad-7fbe-3d2a-8d03-7cfcdfddc5ce",
                                "text": "Beide Vorderpfoten der Katze wurden untersucht."
                            },
                            {
                                "example_id": "0e24c051-f9ca-4795-ae0d-23beff209fc8",
                                "sense_id": "980b56ad-7fbe-3d2a-8d03-7cfcdfddc5ce",
                                "text": "„Mit einer Lähmung der linken Vorderpfote, deren Ursache wahrscheinlich ein Verkehrsunfall war, wurde er beim Tierarzt abgegeben.“"
                            },
                            {
                                "example_id": "1d2d943f-6cb6-4178-a972-d86147fd974e",
                                "sense_id": "980b56ad-7fbe-3d2a-8d03-7cfcdfddc5ce",
                                "text": "„Der Mischlingshund Sam liegt unterm Tisch, hebt kurz den Kopf, lauscht und legt ihn wieder zurück auf die Vorderpfoten.“"
                            },
                            {
                                "example_id": "9ccbe681-aec4-479b-9314-4b512e033616",
                                "sense_id": "980b56ad-7fbe-3d2a-8d03-7cfcdfddc5ce",
                                "text": "„Die weißen Spitze üben jetzt, auf den Vorderpfoten zu gehen.“"
                            },
                            {
                                "example_id": "3405e412-72b3-46cc-a091-1436c29bd9b9",
                                "sense_id": "980b56ad-7fbe-3d2a-8d03-7cfcdfddc5ce",
                                "text": "„Niemand bewegte sich, auch Top lag hingestreckt mit dem Kopf zwischen den Vorderpfoten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
