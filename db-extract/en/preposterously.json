                                "target_senses": [
                                    {
                                        "sense_id": "cf143fd3-8348-362a-9d28-f192dccd6719",
                                        "entry_id": "308b684a-ed00-3872-b03f-652769f1e121",
                                        "glosses": [
                                            "widersinnig, dem gesunden Menschenverstand widersprechend, abwegig, sinnlos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c390d369-1069-4900-b79b-cf3575be97ff",
                                                "sense_id": "cf143fd3-8348-362a-9d28-f192dccd6719",
                                                "text": "Die Vorschläge scheinen mir allesamt vollkommen absurd zu sein."
                                            },
                                            {
                                                "example_id": "57205d17-07aa-4df8-ab0e-04ebe47b9549",
                                                "sense_id": "cf143fd3-8348-362a-9d28-f192dccd6719",
                                                "text": "„Es ist absurd, dass – obwohl wir um den Klimawandel wissen – der Markt für SUVs boomt und die Autos immer größer werden. Es ist absurd, dass so viele Flugzeuge in der Luft sind wie noch nie und es billiger ist, von Berlin nach München zu fliegen als mit dem Zug zu fahren.“"
                                            },
                                            {
                                                "example_id": "643a0327-95da-4950-83bb-87e4c332e035",
                                                "sense_id": "cf143fd3-8348-362a-9d28-f192dccd6719",
                                                "text": "„Dieser Roman ist eigentlich kein Roman, sondern ein überbordendes Märchen, eine absurde Jetset-Story, eine dick aufgetragene Sinnsuche, die in Österreich beginnt und auf dem Mount Everest endet, wo hoch oben auf dem Gipfel die Erkenntnis liegt oder die Verzweiflung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2738bc2d-8906-4bda-b6b4-957c05747121",
                        "source_entry_id": "9e192271-4b15-3140-a208-58d6e1dd57fd",
                        "source_sense_id": "ce538172-902d-34d6-ab48-efbfe9ad0663",
                        "source_sense_description": "absurd/absurderweise, unsinnig/unsinnigerweise",
                        "target_lang_word": "absurderweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8e18eea1-4e85-4952-987a-a14156cb5acf",
                        "source_entry_id": "9e192271-4b15-3140-a208-58d6e1dd57fd",
                        "source_sense_id": "ce538172-902d-34d6-ab48-efbfe9ad0663",
                        "source_sense_description": "absurd/absurderweise, unsinnig/unsinnigerweise",
                        "target_lang_word": "unsinnig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsinnig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "289ea000-fc5e-3e45-b97c-6d6a6c156918",
                                        "entry_id": "ad0b58c0-c05a-36e3-9426-086738b333bb",
                                        "glosses": [
                                            "nicht sinnvoll, mit gesundem Menschenverstand nicht nachvollziehbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40ad2e87-5ed5-4bbc-83a6-d67ae50f48f9",
                                                "sense_id": "289ea000-fc5e-3e45-b97c-6d6a6c156918",
                                                "text": "Diese unsinnige Bemerkung hättest du dir besser gespart."
                                            },
                                            {
                                                "example_id": "df00fe34-0e2c-4d72-b8a9-7eca53dc6f41",
                                                "sense_id": "289ea000-fc5e-3e45-b97c-6d6a6c156918",
                                                "text": "Es ist unsinnig mehr Lebensmittel zu kaufen, als man nachher verzehrt."
                                            },
                                            {
                                                "example_id": "ca0513da-8dd8-45cd-bb6b-ddddb7c4a5c9",
                                                "sense_id": "289ea000-fc5e-3e45-b97c-6d6a6c156918",
                                                "text": "„Man könnte bei manchen Mommilies geradezu von einer Sozialisation durch unsinnige Formeln sprechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "76e76bb0-2352-3697-aa20-49c5deab92a4",
                                        "entry_id": "ad0b58c0-c05a-36e3-9426-086738b333bb",
                                        "glosses": [
                                            "sehr, übermäßig, übertrieben"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ef11f4f-f4bb-4f52-82d6-260b209c11f8",
                                                "sense_id": "76e76bb0-2352-3697-aa20-49c5deab92a4",
                                                "text": "Ich habe mich unsinnig gefreut, als ich nach über 20 Jahren wieder von ihr gehört habe."
                                            },
                                            {
                                                "example_id": "d46a187b-ef92-408b-8935-2d050f08518a",
                                                "sense_id": "76e76bb0-2352-3697-aa20-49c5deab92a4",
                                                "text": "Diese unsinnig hohe Forderung kann niemand erfüllen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
