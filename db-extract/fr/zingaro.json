                        "examples": [
                            {
                                "example_id": "1148840a-d09d-4230-9f26-80592ccd8879",
                                "sense_id": "9715c8e1-400a-343a-9a5b-9dbfda818e14",
                                "text": "On remarquait en outre que son horreur pour les égyptiennes et les zingari semblait redoubler depuis quelque temps."
                            },
                            {
                                "example_id": "1f7a211b-f09a-4a5e-b82b-f1035bfd7be7",
                                "sense_id": "9715c8e1-400a-343a-9a5b-9dbfda818e14",
                                "text": "Quelques tentes noires de zingari étaient dressées ; des hommes, des enfants, des femmes […] étaient accroupis autour d'un feu et se peignaient les cheveux."
                            }
                        ]
