                                ]
                            },
                            {
                                "target_word": "assureur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a1a1b52-1c8f-348f-b33b-53a80d52b712",
                                        "entry_id": "8a80fda8-48e1-32e5-8711-dae98627b87d",
                                        "glosses": [
                                            "Qui procure une assurance, œuvre dans le domaine des assurances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "182fb73c-23fe-4d5b-b5b6-5a70f9007c21",
                                                "sense_id": "7a1a1b52-1c8f-348f-b33b-53a80d52b712",
                                                "text": "Dans ce dernier cas, la contribution supérieure ainsi exigée, est bien une prime de risque que l’établissement assuré verse à l'établissement assureur."
                                            },
                                            {
                                                "example_id": "be731b7c-bfaf-4966-944f-4c87b76f818f",
                                                "sense_id": "7a1a1b52-1c8f-348f-b33b-53a80d52b712",
                                                "text": "L’Angleterre commerçante, transporteuse, banquière, assureuse, a véritablement mis le monde en forme pour la collaboration économique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97e916b8-4221-42aa-96c6-ed2d192b21d3",
                        "source_entry_id": "13afc843-730e-3e89-bbd2-e5b19e862cf7",
                        "source_sense_id": "9ab4da3e-68fd-3980-8692-b4dbbaee91d6",
                        "source_sense_description": "one who insures",
                        "target_lang_word": "assureuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assureuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "994eb7ea-aaa9-303d-8933-5a720465778e",
                                        "entry_id": "7bf8a822-5438-32f5-863b-0b1b26243cbc",
                                        "glosses": [
                                            "Femme qui travaille dans le domaine des assurances."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30d77218-b404-4873-bea3-10d209a892c6",
                                                "sense_id": "994eb7ea-aaa9-303d-8933-5a720465778e",
                                                "text": "C’est alors que la complice était intervenue. Au téléphone, elle s’était fait passer pour une assureuse jointe par son client, et avait persuadé l’octogénaire de verser 1 300 euros en guise de « réparation »."
                                            },
                                            {
                                                "example_id": "4913bf6a-d365-4dfc-ac8d-8bbbf7cf8cf8",
                                                "sense_id": "994eb7ea-aaa9-303d-8933-5a720465778e",
                                                "text": "Deuxièmement, si les inconditionnels d’«autrice» sont logiques avec eux-mêmes, ils doivent également s’attaquer à tous les autres féminins illogiques. Or, j’aimerais bien voir s’ils sont tout aussi prêts à dire «une assureuse», «une défenseuse», «une entrepreneuse», «une gouverneuse», «une metteuse en scène», «une procureuse», «une réviseuse», «une superviseuse», «une vainqueuse». Parce qu’en français, lorsqu’un nom est dérivé d’un verbe, c’est la terminaison en «euse» et non en «eure» qui est logique. Préférer «assureure» ou «réviseure», c’est se ranger du même côté que ceux qui préfèrent «auteure»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54e57fa0-bef8-31e6-a8c7-4f76349b67ed",
                                        "entry_id": "7bf8a822-5438-32f5-863b-0b1b26243cbc",
                                        "glosses": [
                                            "Femme qui assure un grimpeur ou une grimpeuse, qui le ou la retient par une corde d'escalade."
                                        ],
                                        "tags": [
                                            "Escalade"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2cb6c8-e2bb-4f50-9350-9e0875cbec0d",
                                                "sense_id": "54e57fa0-bef8-31e6-a8c7-4f76349b67ed",
                                                "text": "Je cherche et sens mes bras se gonfler d’acide. Puis je commence à entendre la voie de mon assureuse. Je dois me rapprocher ! Je donne tout pour sortir des ce maudit dévers. Maintenant il reste 4 longueurs. Et on va le faire !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "assureuse",
                                "target_lang_code": "fr",
                                "target_senses": [
