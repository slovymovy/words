                ],
                "senses": [
                    {
                        "sense_id": "d53d6ad2-a869-37a9-a9a0-86078a89a8e0",
                        "entry_id": "3a7ea6fb-4249-3f71-a319-6be41c503776",
                        "glosses": [
                            "Fineness; beauty."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b44f8296-1444-3ebf-abe2-de97d38f6580",
                        "entry_id": "3a7ea6fb-4249-3f71-a319-6be41c503776",
                        "glosses": [
                            "Ornament; decoration; especially, excessive decoration; showy clothes; jewels."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "239e1db6-27cc-45bc-8c6d-725203d5d9d6",
                                "sense_id": "b44f8296-1444-3ebf-abe2-de97d38f6580",
                                "text": "The city also shone through the luxury of the higher castes: in the fineries of their dress, the rich manner of their living, their many servants, silver table services, and showy furnishings."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d2368cc-54ac-333d-9a50-f5bfe21fa630",
                        "entry_id": "3a7ea6fb-4249-3f71-a319-6be41c503776",
                        "glosses": [
                            "fine point; minute characteristic"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4178e81a-312d-4c34-be6c-028ae1fce670",
                                "sense_id": "0d2368cc-54ac-333d-9a50-f5bfe21fa630",
                                "text": "the translator should master the language he translates from as thoroughly as his mother tongue, knowing all its fineries"
                            }
                        ]
                    },
                    {
                        "sense_id": "8f689dee-9ef0-3a92-9a22-e8454899e6fc",
                        "entry_id": "3a7ea6fb-4249-3f71-a319-6be41c503776",
                        "glosses": [
                            "A charcoal hearth or furnace for the conversion of cast iron into wrought iron, or into iron suitable for puddling."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b7e09850-0bc8-4c6b-90ee-c2a732c3923c",
                                "sense_id": "8f689dee-9ef0-3a92-9a22-e8454899e6fc",
                                "text": "In front of the finery hearth in which the sow is melted down again, the finer is working with a long iron bar called a ringer (from French 'ringard') with which he keeps the molten iron in motion by stirring, an essential stage in the process of refining."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2bf2467-5d46-4759-b6c8-a63abe55501a",
                        "source_entry_id": "3a7ea6fb-4249-3f71-a319-6be41c503776",
                        "source_sense_description": "excessive decoration, showy clothes, jewels",
                        "target_lang_word": "paráda",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "511c111f-506f-44a4-8ed4-a82751072eed",
                        "source_entry_id": "3a7ea6fb-4249-3f71-a319-6be41c503776",
                        "source_sense_description": "excessive decoration, showy clothes, jewels",
                        "target_lang_word": "убранство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "убранство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "994e82d4-3c61-3524-8272-2d29074f169e",
                                        "entry_id": "4a68ad15-a378-3a69-8cdc-ad73b0f91ae6",
                                        "glosses": [
                                            "то, что служит украшением чего-нибудь, внешняя отделка, обстановка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "064fa948-302f-47f1-a2d7-d7629bec7be4",
                                                "sense_id": "994e82d4-3c61-3524-8272-2d29074f169e",
                                                "text": "Длинный-предлинный стол, над ним веер, висящий с потолка вдоль всего стола, и в углу два не очень мягкие, некрасивые дивана составляли всё убранство залы."
                                            },
                                            {
                                                "example_id": "a755d7af-f0e0-426e-81b5-c8171a376f97",
                                                "sense_id": "994e82d4-3c61-3524-8272-2d29074f169e",
                                                "text": "Согласно роскошному обычаю того времени, пешие конюхи вели за ним под уздцы шесть верховых коней в полном убранстве; из них один был вороной, один буланый, один железно-серый, а три совершенно белой масти."
                                            },
                                            {
                                                "example_id": "749f7716-c401-4bd0-b1f3-138dfb20f962",
                                                "sense_id": "994e82d4-3c61-3524-8272-2d29074f169e",
                                                "text": "Убранство часовни состояло из довольно большого образа Знамения божией матери, голубого деревянного креста, покрытого белым ручником, да двух длинных скамеек, на которых ставили гробы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
