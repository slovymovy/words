                                                "sense_id": "2214f43b-4761-3d70-97cd-363568ec0be4",
                                                "text": "Ten kolarz został zawieszony na okres sześciu miesięcy za doping wydolnościowy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
