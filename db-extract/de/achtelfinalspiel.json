                "senses": [
                    {
                        "sense_id": "b75877f6-af9f-3d88-969f-0078cb2479a3",
                        "entry_id": "94561661-587f-3caa-b33a-6d64eb64871e",
                        "glosses": [
                            "eine der acht Austragungen eines Achtelfinales; Wettkampf der im Rahmen eines Achtelfinales ausgetragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "320e69c0-8257-433f-b204-38d2699395bf",
                                "sense_id": "b75877f6-af9f-3d88-969f-0078cb2479a3",
                                "text": "„Es wird, man wagt das vorauszusehen, wenn schon kein gutes, so doch ein mitreißendes Spiel. Und wenn schon kein mitreißendes, so doch ein sehr werthaltiges Achtelfinalspiel.“"
                            },
                            {
                                "example_id": "0cf6f296-77d6-429b-8c89-c50c7c7f67b2",
                                "sense_id": "b75877f6-af9f-3d88-969f-0078cb2479a3",
                                "text": "„Gestern behalten in den Achtelfinalspielen die Kroaten und Gastgeber Russland das glücklichere Ende für sich.“"
                            },
                            {
                                "example_id": "e84d1306-4115-4b29-89a8-444668f78880",
                                "sense_id": "b75877f6-af9f-3d88-969f-0078cb2479a3",
                                "text": "„Das mache er nicht mehr, seit er 2010 das Achtelfinalspiel Deutschland gegen England gesehen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
