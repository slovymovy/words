                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7ea9cdb8-91c3-472b-a02a-e467dc2765c5",
                                "sense_id": "eb47a144-67cc-32e7-ad39-06fa42e2fa7d",
                                "text": "Tymczasem,[…], obok drewnianych, z[]rzadka podmurowanych trzemów, chyzów, wież (namiotow), wznosiły się po kasztelach cerekwie^([sic – meaning cerkwie]) i kapły,[…].",
                                "translation": "Meanwhile, […], near wooden, rarely masoned houses, chambers, towers (tents), churches were towered on castella, […].",
                                "english": "Meanwhile, […], near wooden, rarely masoned houses, chambers, towers (tents), churches were towered on castella, […]."
                            },
                            {
                                "example_id": "3b21c0cd-6531-4df6-818d-09e3bbd53fe1",
                                "sense_id": "eb47a144-67cc-32e7-ad39-06fa42e2fa7d",
                                "text": "Niektóre domy [Polan][…]posiadały piętro i zwały się trzemem.",
                                "translation": "Some houses [of Polans] […] had a storey and were called a trzem.",
                                "english": "Some houses [of Polans] […] had a storey and were called a trzem."
                            }
                        ]
                    }
                ],
