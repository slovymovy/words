                "forms": [],
                "senses": [
                    {
                        "sense_id": "92a2ada9-8a9c-3537-be60-3980c01e85c5",
                        "entry_id": "6e75c572-30c2-3572-89c2-246bf8ebfe13",
                        "glosses": [
                            "De manière adéquate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c14e9f3-47a4-439a-8bf6-411bb0117ac1",
                                "sense_id": "92a2ada9-8a9c-3537-be60-3980c01e85c5",
                                "text": "Nos équations parviennent à saisir assez adéquatement les premiers moments de l’univers, mais, à mesure que l’on régresse dans le temps et que nous approchons de l’instant zéro, nos modèles mathématiques se désintègrent et plus rien ne fait sens."
                            },
                            {
                                "example_id": "2b839e1d-15a2-4104-8d51-2a21f4f939b8",
                                "sense_id": "92a2ada9-8a9c-3537-be60-3980c01e85c5",
                                "text": "Les manchons trayeurs et pulsateurs en bon état permettent un massage adéquat. Il est difficile de traire adéquatement si la machine à traire ne travaille pas correctement."
                            },
                            {
                                "example_id": "056a7f18-f28c-4df2-b9b5-fa7df27dba76",
                                "sense_id": "92a2ada9-8a9c-3537-be60-3980c01e85c5",
                                "text": "Les rares invités japonais étaient des trésors nationaux vivants mais de justesse, la plupart avaient au moins quatre-vingt-dix ans, on les aurait plus adéquatement qualifiés de trésors nationaux mourants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "394a23da-a7f3-4421-9451-64f14eeda53e",
                        "source_entry_id": "6e75c572-30c2-3572-89c2-246bf8ebfe13",
                        "source_sense_id": "92a2ada9-8a9c-3537-be60-3980c01e85c5",
