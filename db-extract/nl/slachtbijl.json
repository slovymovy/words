                        "glosses": [
                            "bijl die een slager gebruikt bij het slachten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c13660f6-e6ae-4421-af1b-ccf5c99d4e0c",
                                "sense_id": "32a840ab-1363-34b8-b8b1-dff216025ac5",
                                "text": "De beenhouwer deed een stap vooruit, hief de slachtbijl van de grond en wrong dezelve met een brandende woede in zijn vuist."
                            },
                            {
                                "example_id": "09dcc9d3-494d-4b3e-b935-c91cfd606564",
                                "sense_id": "32a840ab-1363-34b8-b8b1-dff216025ac5",
                                "text": "In het diepe van de zolder stond een kind, niet boven de veertien jaar oud, met een slachtbijl in de hand; bleek van angst en bevend hield hij dit wapen op de Fransen gericht, zonder dat het minste geluid uit zijn borst opkwam: uit zijn blauwe ogen schoten stralen van wanhoop en heldenmoed."
                            }
                        ]
                    }
