                "senses": [
                    {
                        "sense_id": "95660070-175c-35c7-a527-613aeef13490",
                        "entry_id": "f31125a2-a429-3284-aa82-df68a1405279",
                        "glosses": [
                            "Vertreter einer Gattung der größten, vierbeinigen Dinosaurier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ec1c1b7-2f4f-472c-b1a1-5ef60ac13cf2",
                                "sense_id": "95660070-175c-35c7-a527-613aeef13490",
                                "text": "„Ohne die Hohlräume in seinen Knochen hätte sich der riesige Argentinosaurier wohl kaum bewegen können.“"
                            },
                            {
                                "example_id": "394d1711-7331-4cc5-ba56-264ed6675b00",
                                "sense_id": "95660070-175c-35c7-a527-613aeef13490",
                                "text": "„Ein erwachsenes Tier [der neu entdeckten Titanosaurierart] erreichte eine Länge von rund 17 Metern und war damit klein im Vergleich zum gigantischen Argentinosaurier, […]“"
                            },
                            {
                                "example_id": "6c5e2134-a470-4912-b5ef-8aada051181c",
                                "sense_id": "95660070-175c-35c7-a527-613aeef13490",
                                "text": "„Dabei hebt sie die Kostbarkeit jedes einzelnen Tropfens hervor – denn es könnte ja sein, dass einst ein hundert Tonnen schwerer Argentinosaurier diesen einen Wassertropfen auf seiner Zunge zergehen ließ, der heute aus dem Hahn fließt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
