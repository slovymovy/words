                "senses": [
                    {
                        "sense_id": "1b73e35f-f253-3996-9ed3-08a28d103e2e",
                        "entry_id": "ecfc7d1b-8fbc-30dd-9e66-f8bef1bdde42",
                        "glosses": [
                            "Terme essentiellement employé par les ligues d'extrême-droite pour désigner une république mal dirigée selon elles, en particulier la République française."
                        ],
                        "tags": [
                            "neologism",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "71c8c02e-afe3-4560-b000-065f599215ea",
                                "sense_id": "1b73e35f-f253-3996-9ed3-08a28d103e2e",
                                "text": "Médiacratie et démocrature sont les deux mamelles de la Ripoublique."
                            },
                            {
                                "example_id": "588dfa88-dc42-4640-90ee-e80904ca226e",
                                "sense_id": "1b73e35f-f253-3996-9ed3-08a28d103e2e",
                                "text": "Pour ce faire, Maqueron utilisera toutes les ressources de la Vᵉ ripoublique : ordonnances, article 16 si le peuple descend dans la rue, article 49-3."
                            },
                            {
                                "example_id": "178f7edc-ac58-4e83-9c25-c30212425d57",
                                "sense_id": "1b73e35f-f253-3996-9ed3-08a28d103e2e",
                                "text": "Il est inutile, sans doute, de trop insister sur la dangerosité d'une telle attitude politique qui risque de couper sous les pieds des générations entières la branche de l'avenir et rabaisser la recherche et le niveau intellectuel général vers un seuil inadmissible de nombrilisme débile dont seules les ripoubliques bananières ont l'horrible et le terrible secret."
                            }
                        ]
                    }
                ],
