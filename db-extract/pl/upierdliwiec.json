                ],
                "translations": [
                    {
                        "translation_id": "c5a819b3-8248-4fed-853c-ecdc45e5fb3a",
                        "source_entry_id": "ef69b843-b831-3941-ae52-c3045672aee3",
                        "source_sense_id": "14175b8c-478d-39bc-acc2-7f05b36e9ee6",
                        "target_lang_word": "casse-couilles",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casse-couilles",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc7aa867-0e09-37dd-8055-a2dc6d578cca",
                                        "entry_id": "af2060d7-9192-3ee1-b3d6-a5220c747948",
                                        "glosses": [
                                            "Individu qui a le don d’énerver."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09ee37f-a5d1-4ef5-80cd-9d0c8ee8b31a",
                                                "sense_id": "bc7aa867-0e09-37dd-8055-a2dc6d578cca",
                                                "text": "C’était pour se plaindre de tout : du temps, du pays, de la nourriture, de la messe, des professeurs, des camarades, de la directrice. « Quel casse-couilles » se dit Manouche."
                                            },
                                            {
                                                "example_id": "d3364bee-4614-4956-88c8-a9b5ac1088c7",
                                                "sense_id": "bc7aa867-0e09-37dd-8055-a2dc6d578cca",
                                                "text": "Il y avait une soirée mousse à l'autre camping, pouvaient-elles y aller ?\nMa foi, c'était le premier jour des vacances, je n'allais pas non plus faire le casse-couilles en permanence."
                                            },
                                            {
                                                "example_id": "eb214208-624e-4497-aceb-b97d083f1917",
                                                "sense_id": "bc7aa867-0e09-37dd-8055-a2dc6d578cca",
                                                "text": "« Devoir d'informer ? mon cul ! » Sous ce titre fleuri, Bruno Masure, éternel casse-couilles et coupeur de cheveux en quatre, avait publié quelques jours après les attentats de janvier 2015 une tribune sur Rue 89, dénonçant « le jeu pervers et dangereux » de vouloir montrer à tout prix que l'on est mieux rencardé que ses concurrents directs, […]."
                                            },
                                            {
                                                "example_id": "cd43b3f5-d592-4f5e-8d73-349ebaae53f5",
                                                "sense_id": "bc7aa867-0e09-37dd-8055-a2dc6d578cca",
                                                "text": "La flache ! Il aurait pu dire la flaque, merde ! Là, il y a quelque chose non pas de poseur mais de vrai casse-couilles chez Rimbaud. Tu sors de douze minutes d’hallucinations pour arriver à « si je désire une eau d’Europe, c’est la flache »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "casse-couilles",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f92ddb02-2b85-30c0-a879-158e2f9c509a",
                                        "entry_id": "351e2831-a96b-3016-99fe-9ae78bfab042",
                                        "glosses": [
                                            "Pluriel de casse-couille."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "casse-couilles",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dee36e20-26fd-3825-9e27-20172b82c100",
                                        "entry_id": "f83403ad-3f75-30d5-bad7-b7af92f10152",
                                        "glosses": [
                                            "Qui énerve, horripile."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b2df307-b611-4b49-949e-348ebac5148d",
                                                "sense_id": "dee36e20-26fd-3825-9e27-20172b82c100",
                                                "text": "Au fond, il est pas méchant, tout juste un peu casse-couilles !"
                                            },
                                            {
                                                "example_id": "fe9bdbbe-8ad8-401b-a05b-c24d503ef558",
                                                "sense_id": "dee36e20-26fd-3825-9e27-20172b82c100",
                                                "text": "Ses subalternes avaient d’ailleurs observé judicieusement qu’en plus d’être presbyte, il n’en était pas moins casse-couilles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "casse-couilles",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d113d15d-e6b4-3833-9b1c-f9fdb5bb81cc",
                                        "entry_id": "ad7c20b3-056e-3590-923a-75c1cc9f938a",
                                        "glosses": [
                                            "Pluriel de casse-couille."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7731f016-2127-46a9-b4b8-ea81b93804fc",
                        "source_entry_id": "ef69b843-b831-3941-ae52-c3045672aee3",
                        "source_sense_id": "14175b8c-478d-39bc-acc2-7f05b36e9ee6",
                        "target_lang_word": "emmerdeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emmerdeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1f94107-470c-3c7a-b6fb-69080d5633ad",
                                        "entry_id": "462ffc2f-87cf-3345-875c-3396785a7e13",
                                        "glosses": [
                                            "Personne emmerdante, c'est-à-dire qui importune, qui ennuie, qui énerve les autres."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "offensive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "650c5e5a-0777-404b-8fc8-426d4de7a62b",
                                                "sense_id": "f1f94107-470c-3c7a-b6fb-69080d5633ad",
                                                "text": "Dire qu’il suffit de mettre un gigot au feu pour voir s’amener les emmerdeurs !"
                                            },
                                            {
                                                "example_id": "18c42f23-f4a5-48ce-ad9c-4fbd0855eb0c",
                                                "sense_id": "f1f94107-470c-3c7a-b6fb-69080d5633ad",
                                                "text": "Au retour des dernières épreuves avant BAT, j'ai vu qu'elle avait encore rétabli des pétouilles que j'avais pourtant annulées lors des premières navettes, mais j'ai quand même donné mon imprimatur pour ne pas passer pour un emmerdeur […]."
                                            },
                                            {
                                                "example_id": "fa367989-6413-4c42-9019-a123e97fa168",
                                                "sense_id": "f1f94107-470c-3c7a-b6fb-69080d5633ad",
                                                "text": "Tu n'es qu'un chichiteux, lui dit sa mère, un emmerdeur, précisent les autres membres de sa famille et ses amis, une foutue buse, déplore sa compagne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
