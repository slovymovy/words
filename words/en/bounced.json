    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "345e9af5-e500-3a81-a86a-4319917f8552",
                    "sense_definition": "Returned to the sender because of an error or unsuccessful delivery, especially of an email.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "email_delivery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I received a <w>bounced</w> email notification because the recipient's mailbox was completely full.",
                            "target_lang_translations": {
                                "ru": "Я получил уведомление о <w>возвращенном</w> письме, потому что почтовый ящик получателя был переполнен."
                            }
                        },
                        {
                            "text": "Please check the spelling of the address to avoid getting a <w>bounced</w> message.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте написание адреса, чтобы избежать получения <w>возвращенного</w> сообщения."
                            }
                        }
                    ],
                    "synonyms": [
                        "returned",
                        "rejected"
                    ],
                    "antonyms": [
                        "delivered"
                    ],
                    "common_phrases": [
                        "bounced email",
                        "bounced message"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращенный отправителю из-за ошибки или неудачной доставки (особенно об электронном письме)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращенный",
                                "target_lang_sense_clarification": "о письме или сообщении"
                            },
                            {
                                "target_lang_word": "недоставленный",
                                "target_lang_sense_clarification": "об электронном письме"
                            },
                            {
                                "target_lang_word": "отклоненный",
                                "target_lang_sense_clarification": "о сервере или почтовой системе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2af7ebd-a7d9-389f-ac00-f37f690bc301",
                    "sense_definition": "Simple past tense and past participle of <w>bounce</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The basketball <w>bounced</w> off the rim and went out of bounds.",
                            "target_lang_translations": {
                                "ru": "Баскетбольный мяч <w>отскочил</w> от кольца и улетел в аут."
                            }
                        },
                        {
                            "text": "She <w>bounced</w> the baby on her knee to make him laugh.",
                            "target_lang_translations": {
                                "ru": "Она <w>качала</w> малыша на коленях, чтобы рассмешить его."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола bounce (отскакивать, подпрыгивать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отскочил",
                                "target_lang_sense_clarification": "о мяче или предмете"
                            },
                            {
                                "target_lang_word": "качала",
                                "target_lang_sense_clarification": "о ребенке на коленях"
                            },
                            {
                                "target_lang_word": "подпрыгивал",
                                "target_lang_sense_clarification": "о движении вверх и вниз"
                            }
