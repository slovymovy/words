                    {
                        "sense_id": "ac83ce14-46b4-3e81-880e-480dad656dc7",
                        "entry_id": "baf9dcac-23ff-3177-b847-acfeebac2d8f",
                        "glosses": [
                            "grap die men met iemand uithaalt (vooral in de uitdrukking [iemand] een poets bakken)"
