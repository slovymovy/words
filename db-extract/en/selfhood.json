                        "entry_id": "7060fd13-c9f0-3356-a781-f7c294d9d9ee",
                        "glosses": [
                            "State of having a distinct identity, or being an individual distinct from others; individuality."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "04259c25-5e24-3263-a8b9-ccee810febcc",
                        "entry_id": "7060fd13-c9f0-3356-a781-f7c294d9d9ee",
                        "glosses": [
                            "The fully developed self; one's personality, character."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "573e3554-1c34-4b31-bfc5-deab6348cab7",
                                "sense_id": "04259c25-5e24-3263-a8b9-ccee810febcc",
                                "text": "Indeed, while geography is neither a key dimension of identity nor its determinant, it is one of the most important categories through which nationhood can be explored and articulated. It both grounds a sense of national selfhood and gives it a framework through which a continuous shaping of identity can \"take place.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "823320c5-d77b-366b-94b4-281643b49853",
                        "entry_id": "7060fd13-c9f0-3356-a781-f7c294d9d9ee",
                        "glosses": [
                            "The quality of being self-centered or egocentric; selfishness."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
