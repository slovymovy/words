        "nl-extract.jsonl": [
            {
                "entry_id": "be8f7fce-f9f0-3cae-96f7-2c1138abfd94",
                "word": "zielenpijn",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fa3516ea-d301-3729-9317-08c5c987f853",
                        "entry_id": "be8f7fce-f9f0-3cae-96f7-2c1138abfd94",
                        "glosses": [
                            "verdriet en ellende; geestelijke en psychische nood; geestelijk lijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73233d4f-bfaa-4916-9730-51fe38af08de",
                                "sense_id": "fa3516ea-d301-3729-9317-08c5c987f853",
                                "text": "Toch rolde, herinnert Hayward zich, het nummer vol zielenpijn en Weltschmerz ('Cause I love you, oohowowo I love you') er betrekkelijk gemakkelijk uit."
                            },
                            {
                                "example_id": "b3877b34-496f-4ef0-9893-05734916f2b9",
                                "sense_id": "fa3516ea-d301-3729-9317-08c5c987f853",
                                "text": "Dijksma zelf heeft het verkiezingsdebacle van de PvdA ervaren met een 'mengelmoes van zielenpijn, maar ook realisme'. Volgens haar is de belangrijkste oorzaak van het verlies dat de partij niet aan de kiezer heeft kunnen uitleggen waarom het nodig was dat er geregeerd moest worden met de VVD."
                            },
                            {
                                "example_id": "b62c672c-7964-4b21-9bfd-1109a2fecba2",
                                "sense_id": "fa3516ea-d301-3729-9317-08c5c987f853",
                                "text": "Nu moeten we het met z'n allen normaal gaan vinden dat mensen met zielenpijn naar een geestelijk verzorger gaan, net als gips bij een gebroken been."
                            }
                        ]
                    }
                ],
