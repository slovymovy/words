    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f549e105-bd83-3d21-be37-9eea71d3932a",
                    "sense_definition": "Déplacer une personne, un objet ou des données d'un endroit vers un autre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'hôpital a décidé de <w>transférer</w> le patient vers une clinique plus moderne."
                        },
                        {
                            "text": "Vous devez <w>transférer</w> vos dossiers importants sur une clé USB sécurisée."
                        }
                    ],
                    "synonyms": [
                        "déplacer",
                        "transporter"
                    ],
                    "antonyms": [
                        "garder",
                        "maintenir"
                    ],
                    "common_phrases": [
                        "transférer des données",
                        "transférer des fichiers",
                        "transférer un patient"
                    ]
                },
                {
                    "sense_id": "1e5e1848-cf35-38a2-867d-c335ecc78cfc",
                    "sense_definition": "Rediriger une communication, un appel téléphonique ou un message vers un autre destinataire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La secrétaire va <w>transférer</w> votre appel vers le responsable du service technique."
                        },
                        {
                            "text": "Pouvez-vous me <w>transférer</w> le courriel que vous avez reçu ce matin ?"
                        }
                    ],
                    "synonyms": [
                        "rediriger",
                        "renvoyer"
                    ],
                    "common_phrases": [
                        "transférer un appel",
                        "transférer un message",
                        "transférer un courriel"
                    ]
                },
                {
                    "sense_id": "f8131c03-0198-3439-b238-b15f2dc40488",
                    "sense_definition": "Céder formellement des droits, la propriété d'un bien ou une somme d'argent à une autre personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit_finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque a accepté de <w>transférer</w> les fonds sur votre compte d'épargne."
                        },
                        {
                            "text": "L'ancien propriétaire a signé le contrat pour <w>transférer</w> ses droits au repreneur."
                        }
                    ],
                    "synonyms": [
                        "céder",
                        "léguer"
                    ],
                    "antonyms": [
                        "conserver"
                    ],
                    "common_phrases": [
                        "transférer des fonds",
                        "transférer la propriété",
                        "transférer des droits"
                    ]
                },
                {
                    "sense_id": "5b21e7a2-b181-3a24-8fbd-7a9d7c7a6dca",
                    "sense_definition": "Déplacer le siège d'une autorité, d'une institution, d'un gouvernement ou d'une administration dans un autre lieu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'empereur a décidé de <w>transférer</w> le siège de son gouvernement dans une nouvelle capitale."
                        },
                        {
                            "text": "Le ministère a choisi de <w>transférer</w> le tribunal régional dans un bâtiment plus vaste."
                        }
                    ],
                    "synonyms": [
                        "délocaliser",
                        "réinstaller"
                    ],
                    "common_phrases": [
                        "transférer le siège",
                        "transférer la capitale"
                    ]
                },
                {
                    "sense_id": "2b5e5374-5071-3d90-8d42-1ab7e39bd92a",
                    "sense_definition": "Reporter une cérémonie, un jour férié ou une fête religieuse à une autre date.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le clergé a préféré <w>transférer</w> la célébration patronale au dimanche suivant pour rassembler les fidèles."
                        },
                        {
                            "text": "Les autorités municipales durent <w>transférer</w> la commémoration solennelle à une date ultérieure."
                        }
                    ],
                    "synonyms": [
                        "différer",
                        "remettre",
                        "reporter"
                    ],
                    "antonyms": [
                        "avancer"
                    ],
                    "common_phrases": [
                        "transférer une fête"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Principalement employé dans un registre liturgique ou solennel."
                        }
                    ]
                }
            ]
        }
    ]
}