                        "glosses": [
                            "The right to present a nominee to a vacant ecclesiastical benefice or church office."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "98fa132e-e479-435a-91ad-6134f83395c6",
                                "sense_id": "6e785b78-7e94-37cb-8c64-cc098495b8e0",
                                "text": "The advowson of the parsonages of Sempringham and Tirington, being the right of his father, he [St. Gilbert] was presented by him [his father] to those united livings, in 1123."
                            },
                            {
                                "example_id": "2c45f319-c090-489e-bfb6-ee93ce56f023",
                                "sense_id": "6e785b78-7e94-37cb-8c64-cc098495b8e0",
                                "text": "Advowson is the right to appoint the incumbent clergy of a parish, so three advowsons meant three incumbents."
                            }
                        ]
