                    {
                        "sense_id": "4f448366-c960-3c19-82ba-23649252a567",
                        "entry_id": "28afb9ba-a143-3672-b3bc-b46e0c781430",
                        "glosses": [
                            "Maske aus Gold, goldfarbene Maske"
