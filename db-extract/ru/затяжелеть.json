                "senses": [
                    {
                        "sense_id": "179a69a2-241a-3b0d-80c8-57a5231805ad",
                        "entry_id": "d6cf1159-5eb2-3471-ac78-35f62acf7488",
                        "glosses": [
                            "прост. стать тяжёлым, с трудом перемещаемым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9054e4cc-f5f1-47b9-bbfb-4b9dd9a95468",
                                "sense_id": "179a69a2-241a-3b0d-80c8-57a5231805ad",
                                "text": "Неразрешимая натуга налила жилы и мускулы. Пальцы распухли, затяжелели."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b9a0466-3776-3fa5-8151-11ce2f6b6d97",
                        "entry_id": "d6cf1159-5eb2-3471-ac78-35f62acf7488",
                        "glosses": [
                            "прост., рег. забеременеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f74a79cc-5550-42b3-8d4a-f9386133075f",
                                "sense_id": "8b9a0466-3776-3fa5-8151-11ce2f6b6d97",
                                "text": "Вышедши замуж-то, я затяжелела; ну, брюхом-то мне то того, то другого смерть вот как хочется."
                            },
                            {
                                "example_id": "2b5320bf-b59e-499b-98ef-6ab92216d7aa",
                                "sense_id": "8b9a0466-3776-3fa5-8151-11ce2f6b6d97",
                                "text": "Он не может отвязаться от мысли, не затяжелела ли Варвара опять…"
                            },
                            {
                                "example_id": "642d7605-d286-4ce4-ad20-40e6da7aa082",
                                "sense_id": "8b9a0466-3776-3fa5-8151-11ce2f6b6d97",
                                "text": "Бросишь, ай еще чего ― затяжелею, ― сама и взрощу, и выкормлю."
                            }
                        ]
                    }
                ],
