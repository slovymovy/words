                        "sense_id": "e56ceac2-14f1-38ac-a521-0db21c7aa013",
                        "entry_id": "f6ffc7b5-b863-3d93-92ad-3674eb4a4346",
                        "glosses": [
                            "Marchandiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7afe8e6e-66a2-4e88-a001-5794f5777101",
                                "sense_id": "e56ceac2-14f1-38ac-a521-0db21c7aa013",
                                "text": "Il cherche, sans y parvenir à une échelle suffisante, à individualiser, à « remarchandiser » un mode de satisfaction des besoins assez largement socialisé."
                            },
                            {
                                "example_id": "988b6bb6-1285-41a5-9adb-b1c79da75369",
                                "sense_id": "e56ceac2-14f1-38ac-a521-0db21c7aa013",
                                "text": "Cette réorganisation vise à encourager l'entreprise privée et à remarchandiser l'ensemble des composantes qui déterminent la valeur de la force de travail."
                            }
                        ]
                    }
