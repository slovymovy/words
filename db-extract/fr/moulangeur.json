                        "glosses": [
                            "Charpentier de moulins à vent ou de moulins à eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "978bba42-ca23-4885-9876-2fb1c3f3a5f0",
                                "sense_id": "2cf2db39-72fc-39ee-8bfe-98f800dae9f0",
                                "text": "La conception du moulin est tellement technique et spécifique qu’elle est confiée à un homme, le « moulangeur », qui ne s’occupe que de sa mise au point (très souvent spécifique de l’endroit où on désire l’implanter) et de sa fabrication."
                            }
                        ]
