                        "sense_id": "3d8038d2-88ba-329c-ad6c-c131955d041e",
                        "entry_id": "0d372f1e-bce5-340f-a84a-4fd9cd1d74bd",
                        "glosses": [
                            "Polizeikräfte, die für die Sicherung der Grenzen zuständig sind"
