                                        "glosses": [
                                            "weibliche Person, die ein Haus besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04a926bf-a967-4d65-a0a9-03215a9193f5",
                                                "sense_id": "d1ccbbd7-8a13-3f85-8572-afd40893514f",
                                                "text": "Die Hausbesitzerin von gegenüber kümmert sich liebevoll um ihren Vorgarten."
                                            }
