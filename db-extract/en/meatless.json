                "senses": [
                    {
                        "sense_id": "9648bfad-f46c-313d-a0af-84454a358a1d",
                        "entry_id": "b28e9e97-3aab-3da1-acc6-a4d7b95568bb",
                        "glosses": [
                            "Without meat."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f32b93ab-6539-413b-9f47-b6e21f7b6f98",
                                "sense_id": "9648bfad-f46c-313d-a0af-84454a358a1d",
                                "text": "A meatless day or a beerless or tealess day does not suggest moderation so much as immoderation."
                            },
                            {
                                "example_id": "e906f344-5781-4d5a-a400-1aa22105c0bb",
                                "sense_id": "9648bfad-f46c-313d-a0af-84454a358a1d",
                                "text": "Are we to understand from paragraph 1 (c) that [the residents of Malta] are entirely meatless? or have they cattle they can kill, and if so how many?"
                            },
                            {
                                "example_id": "66709698-bdee-430c-8711-0e7f0e22797c",
                                "sense_id": "9648bfad-f46c-313d-a0af-84454a358a1d",
                                "text": "“Eating more plants and going meatless is a good way to preserve your health,” said Dr. Robert Graham, who is board certified in both internal and integrative medicine. […] Some fun meatless recipes include jackfruit sandwiches in place of pulled pork; black bean meatless balls or eggplant and shiitake “meatballs.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ddd1fcc-c4b9-4226-96a9-c5870ba6a178",
                        "source_entry_id": "b28e9e97-3aab-3da1-acc6-a4d7b95568bb",
                        "source_sense_id": "9648bfad-f46c-313d-a0af-84454a358a1d",
                        "source_sense_description": "without meat",
                        "target_lang_word": "fleischlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fleischlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4a3939f-846c-39e8-83f2-09bae0d9008a",
                                        "entry_id": "6837685d-0d88-32c5-84d2-39d8a3239d9d",
                                        "glosses": [
                                            "ohne Fleisch"
                                        ],
                                        "tags": [
                                            "oft im Zusammenhang mit der Ernährung von Veganern und Vegetariern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4e65c53-e317-48c9-9f97-b366af3fb27e",
                                                "sense_id": "f4a3939f-846c-39e8-83f2-09bae0d9008a",
                                                "text": "„Die fleischlose Küche hat mich immer schon gereizt. Den ersten Ansporn für die vegetarische Küche gab mir bereits während meiner Kindheit meine Mutter, die regelmäßig außergewöhnliche fleischlose Gerichte kredenzte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b7b8178a-4291-38f6-983f-b91a65969698",
                                        "entry_id": "6837685d-0d88-32c5-84d2-39d8a3239d9d",
                                        "glosses": [
                                            "sehr mager, ohne Fett und Muskeln auf den Knochen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a892d3d1-d5e6-42d4-8740-a8281639492a",
                                                "sense_id": "b7b8178a-4291-38f6-983f-b91a65969698",
                                                "text": "„Sein so gut wie fleischloses Gesicht aber ließ durch seine Farbe, ein ins Grünliche gehendes Grau, schließen, daß er mehr oder weniger krank sein müsse: so redete er denn auch, sobald ein kleiner Kreis sich um ihn gebildet hatte.“"
                                            },
                                            {
                                                "example_id": "f2ec32e9-ef09-4865-8ca0-73c403694bdb",
                                                "sense_id": "b7b8178a-4291-38f6-983f-b91a65969698",
                                                "text": "„Blinde Augenhöhlen starrten die Eindringlinge an, fleischlose Kiefer waren erstarrt in immerwährendem Grinsen, von jeder fleischlichen Hülle entblößte Gliedmaßen und Hände entboten ihnen einen stummen Gruß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
