                "senses": [
                    {
                        "sense_id": "3216ceb7-4c8f-3dfd-8a99-58edc35b31e1",
                        "entry_id": "2240ef65-9438-3467-b92b-df1a693ccb6c",
                        "glosses": [
                            "Geruch des Holzes, das vom Zederbaum stammt oder diesem ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8024d57-a416-461f-b49b-05f2b98d9d8b",
                                "sense_id": "3216ceb7-4c8f-3dfd-8a99-58edc35b31e1",
                                "text": "„Der Zedernholzgeruch ist am Anfang intensiv und klingt mit der Zeit langsam aus.“"
                            },
                            {
                                "example_id": "f1b574b6-e374-43ee-bffe-9c73884e73dd",
                                "sense_id": "3216ceb7-4c8f-3dfd-8a99-58edc35b31e1",
                                "text": "„Durch die elegante Holzoberfläche und den typischen Zedernholzgeruch, den dieser Stuhl/Sessel verströmt, spricht er alle Sinne an und trägt zum allgemeinen Wohlbefinden bei.“"
                            },
                            {
                                "example_id": "7d07d11f-5ce4-420c-8656-fb1ca0f17acd",
                                "sense_id": "3216ceb7-4c8f-3dfd-8a99-58edc35b31e1",
                                "text": "„Virginia- und Texas-Zedernholzöl zeichnen sich beide durch einen charakteristischen würzig-pinienartigen Zedernholzgeruch aus.“"
                            },
                            {
                                "example_id": "714c2153-054c-494d-90ca-fb79f6d3a0fa",
                                "sense_id": "3216ceb7-4c8f-3dfd-8a99-58edc35b31e1",
                                "text": "„Zedernholz-Spanner mit Schmirgelpapier anrauen, dann kommt der typische Zedernholzgeruch wieder zurück.“"
                            },
                            {
                                "example_id": "35a1057c-0921-43f1-b155-01807751b216",
                                "sense_id": "3216ceb7-4c8f-3dfd-8a99-58edc35b31e1",
                                "text": "„Wald schwärmt vom Zedernholzgeruch der weichen Faber-B6-Bleistifte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
