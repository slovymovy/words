{
    "word_family": [
        "dig",
        "digger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9309a773-2c62-31e7-a79e-2e3197e67799",
                    "sense_definition": "Present participle and gerund of <w>dig</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog is <w>digging</w> a deep hole in the backyard.",
                            "target_lang_translations": {
                                "ru": "Собака <w>роет</w> глубокую яму на заднем дворе.",
                                "tr": "Köpek arka bahçede derin bir çukur <w>kazıyor</w>."
                            }
                        },
                        {
                            "text": "We spent the whole afternoon <w>digging</w> in the garden.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, <w>копаясь</w> в саду.",
                                "tr": "Bütün öğleden sonrayı bahçeyi <w>kazarak</w> geçirdik."
                            }
                        }
                    ],
                    "common_phrases": [
                        "digging up",
                        "digging deep",
                        "keep digging"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола dig (копать).",
                        "tr": "'dig' fiilinin şimdiki zaman ortacı ve ulaç biçimi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копание",
                                "target_lang_sense_clarification": "процесс работы с землей"
                            },
                            {
                                "target_lang_word": "рытьё",
                                "target_lang_sense_clarification": "создание углублений в земле"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kazma",
                                "target_lang_sense_clarification": "toprağı kazma eylemi"
                            },
                            {
                                "target_lang_word": "kazarak",
                                "target_lang_sense_clarification": "kazma eylemini yaparak"
                            },
                            {
                                "target_lang_word": "kazmak",
                                "target_lang_sense_clarification": "eylemin kendisi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15032edc-754b-3856-ad70-41b132287143",
                    "sense_definition": "The action performed by a person or thing that digs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>digging</w> from the construction site was very loud.",
                            "target_lang_translations": {
                                "ru": "Постоянный шум от <w>рытья</w> на стройке был очень громким.",
                                "tr": "İnşaat alanındaki aralıksız <w>kazı</w> sesi çok gürültülüydü."
                            }
                        },
                        {
                            "text": "His <w>digging</w> uncovered several ancient artifacts.",
                            "target_lang_translations": {
                                "ru": "Его <w>раскопки</w> открыли несколько древних артефактов.",
                                "tr": "Yaptığı <w>kazı</w> sayesinde birkaç antik eser gün yüzüne çıktı."
                            }
                        }
                    ],
                    "synonyms": [
                        "excavation",
                        "shoveling"
                    ],
                    "common_phrases": [
                        "illegal digging",
                        "start digging"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, выполняемое человеком или механизмом, который копает.",
                        "tr": "Kazan bir kişi veya alet tarafından gerçekleştirilen kazı eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскопки",
                                "target_lang_sense_clarification": "поиск чего-либо под землей"
                            },
                            {
                                "target_lang_word": "рытьё",
                                "target_lang_sense_clarification": "процесс выкапывания"
                            },
                            {
                                "target_lang_word": "копание",
                                "target_lang_sense_clarification": "общее действие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kazı",
                                "target_lang_sense_clarification": "toprağı kazma işi veya faaliyeti"
                            },
                            {
                                "target_lang_word": "kazma",
                                "target_lang_sense_clarification": "kazı süreci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ee5f6d8-bb99-3d16-951e-d2bc9bc325c9",
                    "sense_definition": "A place where ore is dug, especially certain localities where gold is obtained.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many prospectors traveled to the <w>diggings</w> hoping to find gold.",
                            "target_lang_translations": {
                                "ru": "Многие старатели отправились на <w>прииски</w> в надежде найти золото.",
                                "tr": "Pek çok maden arayıcısı altın bulma umuduyla <w>maden sahasına</w> gitti."
                            }
                        },
                        {
                            "text": "Life at the <w>diggings</w> was harsh and dangerous for the miners.",
                            "target_lang_translations": {
                                "ru": "Жизнь на <w>приисках</w> была суровой и опасной для шахтеров.",
                                "tr": "<w>Maden ocaklarındaki</w> yaşam madenciler için zorlu ve tehlikeliydi."
                            }
                        }
                    ],
                    "synonyms": [
                        "mine",
                        "excavation"
                    ],
                    "common_phrases": [
                        "gold diggings"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место добычи руды, особенно золота.",
                        "tr": "Cevherin, özellikle altının çıkarıldığı maden veya ocak alanı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прииск",
                                "target_lang_sense_clarification": "место добычи полезных ископаемых, обычно золота"
                            },
                            {
                                "target_lang_word": "копи",
                                "target_lang_sense_clarification": "рудники"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "maden sahası",
                                "target_lang_sense_clarification": "cevher çıkarılan yer"
                            },
                            {
                                "target_lang_word": "maden ocağı",
                                "target_lang_sense_clarification": "altın vb. çıkarılan alan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a2cdfae-a332-3f85-819c-1a6743e9935d",
                    "sense_definition": "Accommodation or lodgings.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He invited us back to his <w>diggings</w> for a cup of tea.",
                            "target_lang_translations": {
                                "ru": "Он пригласил нас к себе в <w>жильё</w> на чашку чая.",
                                "tr": "Bir fincan çay içmek için bizi <w>evine</w> davet etti."
                            }
                        },
                        {
                            "text": "She is looking for new <w>diggings</w> closer to the city center.",
                            "target_lang_translations": {
                                "ru": "Она ищет новое <w>жильё</w> поближе к центру города.",
                                "tr": "Şehir merkezine daha yakın yeni bir <w>kalacak yer</w> arıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "lodgings",
                        "quarters",
                        "digs"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жильё или съемная квартира (разговорное).",
                        "tr": "Kalacak yer, oda veya konut (genellikle çoğul kullanılır, samimi dil)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жильё",
