                                        "glosses": [
                                            "Étude des combinaisons de phonèmes pour former des syllabes, morphèmes ou mots, et aux restrictions qui s'y appliquent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67cb9894-8dbc-40ed-a006-94385b1612c9",
                                                "sense_id": "974138ad-f022-3771-8bb6-9d43fe7ccbb9",
                                                "text": "La définition de la syllabe rejoint celle d’une phonotaxe et des principes de scansion."
                                            }
