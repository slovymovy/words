                "senses": [
                    {
                        "sense_id": "879d1a40-1dfd-3607-b0e8-f4ee27fa3b55",
                        "entry_id": "7591f009-872c-3045-8e9d-fae7fbb18250",
                        "glosses": [
                            "besonderes Flugmanöver, bei dem die Flugbahn eine zur Erdoberfläche geöffnete Parabel beschreibt; Zweck ist das Erreichen von Schwerelosigkeit oder die Simulation einer verminderten Schwerkraft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf2511cb-f4c1-40ab-ab9e-700679f28d16",
                                "sense_id": "879d1a40-1dfd-3607-b0e8-f4ee27fa3b55",
                                "text": "„Es gibt jedoch Zustände, bei denen die Wirkung der Schwerkraft nicht spürbar ist, wie zum Beispiel bei einem freien Fall im Vakuum, in einem Satelliten oder beim Parabelflug.“"
                            },
                            {
                                "example_id": "8f7ea15f-ab8f-4b06-b3a6-16734d251da6",
                                "sense_id": "879d1a40-1dfd-3607-b0e8-f4ee27fa3b55",
                                "text": "„Auch in einem Zustand des freien Falls, beispielsweise in einem Parabelflug oder an Bord der ISS, herrscht Schwerelosigkeit und es gibt innerhalb dieses Systems kein oben und unten.“"
                            },
                            {
                                "example_id": "8416060c-7c8a-45af-8629-18cda9b1386b",
                                "sense_id": "879d1a40-1dfd-3607-b0e8-f4ee27fa3b55",
                                "text": "Parabelflüge ermöglichen Forschung ohne lästige Schwerkraft."
                            },
                            {
                                "example_id": "ad651dc1-0bbc-467a-af36-6c12df33f6d0",
                                "sense_id": "879d1a40-1dfd-3607-b0e8-f4ee27fa3b55",
                                "text": "„Die Rakete wurde in einen Parabelflug gebracht und kam dann wieder zur Erde zurück. Die Rakete stieg um 10.000 Kilometer hoch. […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
