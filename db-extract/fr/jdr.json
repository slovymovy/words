                            },
                            {
                                "target_word": "RPG",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ee5a43d-1015-372f-905b-692e746714b4",
                                        "entry_id": "9a95ef4d-e8a6-3411-ade9-5a0f4879c193",
                                        "glosses": [
                                            "Initialism of roleplaying game."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a597d8a-974d-4028-a955-3e7b08d8818b",
                                                "sense_id": "8ee5a43d-1015-372f-905b-692e746714b4",
                                                "text": "This is an RPG experience DBZ fans must have, but even if you've never seen DBZ, it's still an interesting game due to the unique fighting scenes and the ability to fly around the map."
                                            },
                                            {
                                                "example_id": "0074d38c-20b2-4de4-8ba8-4b67f8142eed",
                                                "sense_id": "8ee5a43d-1015-372f-905b-692e746714b4",
                                                "text": "I love shooters, RPGs, and pretty much anything with free-roam or gore."
                                            },
                                            {
                                                "example_id": "d0bb338f-1cc7-40eb-ae1c-73836742a8a3",
                                                "sense_id": "8ee5a43d-1015-372f-905b-692e746714b4",
                                                "text": "I reckon Runescape^([sic]) is the game that introduced my young, ignorant, and stubborn self to modern RPGs. In a way, I owe at least part of how my career has shaped up to trimmed rune and obby capes."
                                            },
                                            {
                                                "example_id": "fac5759f-a88c-4e58-b663-448784cd5162",
                                                "sense_id": "8ee5a43d-1015-372f-905b-692e746714b4",
                                                "text": "Through many of the most iconic RPGs of our time, we’ve seen a range of popular minigames come into focus."
                                            },
                                            {
                                                "example_id": "f9ec58b4-e240-4db1-b568-619e07c181fd",
                                                "sense_id": "8ee5a43d-1015-372f-905b-692e746714b4",
                                                "text": "Viral YouTuber and grandmother Shirley Curry, better known as ‘Skyrim Grandma’ is finally playing another Bethesda RPG after nine years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b46e531-a2bd-372a-a0c0-6efaaba3f88e",
                                        "entry_id": "9a95ef4d-e8a6-3411-ade9-5a0f4879c193",
                                        "glosses": [
                                            "Initialism of rocket-propelled grenade."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "928e9466-d5b0-3117-bf9f-edd6ebb77557",
                                        "entry_id": "9a95ef4d-e8a6-3411-ade9-5a0f4879c193",
                                        "glosses": [
                                            "Initialism of rebound per game."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35435b29-e6da-4866-b9c6-321803010759",
                                                "sense_id": "928e9466-d5b0-3117-bf9f-edd6ebb77557",
                                                "text": "The Nuggets star is averaging 24.9 PPG, 11.9 RPG (rebounds per game) and an agonizing 9.9 APG (assists per game) – demonstrating Jokić’s incredible all-around ability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5f5003e-058e-3f27-b1a7-5e77fa4ec617",
                                        "entry_id": "9a95ef4d-e8a6-3411-ade9-5a0f4879c193",
                                        "glosses": [
                                            "Initialism of research postgraduate."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "RPG",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f8ccbbb-285b-374b-b7c9-9a656fb85658",
                                        "entry_id": "de996742-0f3a-3d9d-acea-130b4b522a09",
                                        "glosses": [
                                            "To play a roleplaying game."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1fc0f40-7289-4d30-96bc-2dafbd55e3df",
                                                "sense_id": "0f8ccbbb-285b-374b-b7c9-9a656fb85658",
                                                "text": "When I got to my new school, it didn’t take me too long to find a group to hang out with. We RPGed, talked books, movies, and comics. We played video games, both in person and in co-op."
                                            },
                                            {
                                                "example_id": "d1a939d1-bf5b-42dc-8244-0448f50aca5d",
                                                "sense_id": "0f8ccbbb-285b-374b-b7c9-9a656fb85658",
                                                "text": "When you start RPGing, you describe an action your character is taking. Sometimes your DM will interject, asking you to make a test for success (typically a dice roll)."
                                            },
                                            {
                                                "example_id": "2b51c563-1301-4d70-bfde-e51717a7056f",
                                                "sense_id": "0f8ccbbb-285b-374b-b7c9-9a656fb85658",
                                                "text": "None of them really wanted to game without Beth. For one, it didn’t seem fair, and for another, the facts that she had a great imagination and really no concept of how RPGing was “supposed” to work meant she sprang stuff on the group that had livened up the games no end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e69e85d5-3ca8-3f84-8fd8-867ba6c38c55",
                                        "entry_id": "de996742-0f3a-3d9d-acea-130b4b522a09",
                                        "glosses": [
                                            "To attack with a rocket-propelled grenade."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "146e9727-9081-4d94-88aa-048467c650ae",
                                                "sense_id": "e69e85d5-3ca8-3f84-8fd8-867ba6c38c55",
                                                "text": "However, one group of Americans at the Embassy doesn’t creep around quivering in anxiety about being RPGed or machinegunned."
                                            },
                                            {
                                                "example_id": "2d77a0a5-fcda-4145-82c2-0e40892419f7",
                                                "sense_id": "e69e85d5-3ca8-3f84-8fd8-867ba6c38c55",
                                                "text": "It was like the movie Black Hawk Down without the rioters. I was RPGed so often I gradually stopped ducking."
                                            },
                                            {
                                                "example_id": "08c2159d-a9b1-485d-ad5e-3aec13ed537e",
                                                "sense_id": "e69e85d5-3ca8-3f84-8fd8-867ba6c38c55",
                                                "text": "The Taliban had buried a triple mine in the road a week ago and remotely detonated it under a Spartan. Then they RPGed the Scimitar trapped ahead of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
