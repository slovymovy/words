                "senses": [
                    {
                        "sense_id": "ad033e08-c43c-32f0-93db-10a27f5de00e",
                        "entry_id": "7b50950b-c75f-3a8d-9e30-8556dc01406f",
                        "glosses": [
                            "Donner un caractère vétéran à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2d96829-46b8-4159-83ec-ac8c716e6a21",
                                "sense_id": "ad033e08-c43c-32f0-93db-10a27f5de00e",
                                "text": "Pourquoi ne pas \"vétéraniser\" l'équipe de France au lieu de la rajeunir?"
                            },
                            {
                                "example_id": "55e3d744-a407-403f-8c54-da604637981d",
                                "sense_id": "ad033e08-c43c-32f0-93db-10a27f5de00e",
                                "text": "des vétérans n'apporteront rien de plus, étant donné que l'intérêt des sacrifices réside dans le remboursement, et donc que les unités représentent la même quantité de ressources, vétéranes ou non, mieux vaut ne pas les utiliser puisque vétéraniser des troupes prend du temps et que l'intérêt serait plutôt de les protéger, de les garder."
                            },
                            {
                                "example_id": "dabd4a93-3104-42ce-9fa2-dde29b75aa3d",
                                "sense_id": "ad033e08-c43c-32f0-93db-10a27f5de00e",
                                "text": "Donc, comment feriez vous pour vétéraniser ces gus?"
                            }
                        ]
                    }
