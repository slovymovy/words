{
    "word_family": [
        "merman",
        "merfolk",
        "merperson",
        "mermaiden",
        "mermaidcore"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b6ecda0-c90a-3aeb-a55c-a1e37751ec38",
                    "sense_definition": "A mythological creature with a woman's head and upper body, and a tail of a fish.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mythology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little <w>mermaid</w> sat on a rock and watched the ships pass by in the distance.",
                            "target_lang_translations": {
                                "ru": "Маленькая <w>русалка</w> сидела на скале и наблюдала за проплывающими вдали кораблями."
                            }
                        },
                        {
                            "text": "Many sailors used to believe in the <w>mermaid</w> legend, claiming they saw women with fish tails.",
                            "target_lang_translations": {
                                "ru": "Многие моряки верили в легенду о <w>русалках</w>, утверждая, что видели женщин с рыбьими хвостами."
                            }
                        }
                    ],
                    "synonyms": [
                        "mermaiden"
                    ],
                    "antonyms": [
                        "merman"
                    ],
                    "common_phrases": [
                        "mermaid legend",
                        "mermaid tail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мифологическое существо с головой и туловищем женщины и рыбьим хвостом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "русалка",
                                "target_lang_sense_clarification": "общее название"
                            },
                            {
                                "target_lang_word": "морская дева",
                                "target_lang_sense_clarification": "литературный вариант"
                            },
                            {
                                "target_lang_word": "сирена",
                                "target_lang_sense_clarification": "в контексте античной мифологии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa660681-060a-31e7-adca-368aa24bea05",
                    "sense_definition": "Coloured a brilliant turquoise or sea-green, often associated with the aesthetic of the ocean.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "colors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to dye her hair a bright <w>mermaid</w> blue for the summer festival.",
                            "target_lang_translations": {
                                "ru": "Она решила покрасить волосы в ярко-синий <w>русалочий</w> цвет к летнему фестивалю."
                            }
                        },
                        {
                            "text": "The bakery sold a <w>mermaid</w> smoothie that was topped with edible glitter and sea-green swirls.",
                            "target_lang_translations": {
                                "ru": "В пекарне продавали смузи «<w>Русалка</w>», украшенный съедобными блестками и завитками цвета морской волны."
                            }
                        }
                    ],
                    "synonyms": [
                        "turquoise",
                        "sea-green",
                        "aquamarine"
                    ],
                    "common_phrases": [
                        "mermaid hair",
                        "mermaid smoothie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in modern fashion and food trends"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ярко-бирюзовый или морской зеленый цвет, часто связанный с эстетикой океана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цвет морской волны",
                                "target_lang_sense_clarification": "оттенок"
                            },
                            {
                                "target_lang_word": "бирюзовый",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "русалочий",
                                "target_lang_sense_clarification": "стиль или оттенок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e816720-312a-3eb3-a53c-45842e43cfc3",
                    "sense_definition": "A prostitute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "occupations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old play, the character was warned not to waste his money on a <w>mermaid</w> at the tavern.",
                            "target_lang_translations": {
                                "ru": "В старой пьесе героя предупреждали, чтобы он не тратил деньги на <w>блудницу</w> в таверне."
                            }
                        },
                        {
                            "text": "The historical text used the term <w>mermaid</w> to describe women working in the city's red-light district.",
                            "target_lang_translations": {
                                "ru": "В историческом тексте термин «<w>русалка</w>» использовался для описания женщин, работающих в городском квартале красных фонарей."
                            }
                        }
                    ],
                    "synonyms": [
                        "prostitute",
                        "harlot",
                        "strumpet",
                        "lady of the night"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historical slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проститутка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блудница",
                                "target_lang_sense_clarification": "устаревшее"
                            },
                            {
                                "target_lang_word": "портовая девка",
                                "target_lang_sense_clarification": "исторический сленг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}