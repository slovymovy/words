                "senses": [
                    {
                        "sense_id": "bc6b81b9-77b5-31b3-afa6-ab7285753a86",
                        "entry_id": "0f564c86-4fa8-3b0e-a641-68cc536935af",
                        "glosses": [
                            "spezielle Farbe zum Färben von Ostereiern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0acf353-d69b-4d28-9dea-ac5c68f6b135",
                                "sense_id": "bc6b81b9-77b5-31b3-afa6-ab7285753a86",
                                "text": "„Statt klassisch im Labor experimentieren in diesem Semester 50 Studenten der Biotechnologie im HomeLab mit Smartphone und Ostereierfarbe.“"
                            },
                            {
                                "example_id": "ddbfa3f7-a8f5-4ec4-9f0b-8d213a1ba5af",
                                "sense_id": "bc6b81b9-77b5-31b3-afa6-ab7285753a86",
                                "text": "„Mehr als die Hälfte der erhältlichen Ostereierfarben zum Selberfärben enthalten bedenkliche Stoffe, warnt die Umweltschutzorganisation Greenpeace.“"
                            },
                            {
                                "example_id": "2cc4f835-ed58-4423-942a-4d884c974641",
                                "sense_id": "bc6b81b9-77b5-31b3-afa6-ab7285753a86",
                                "text": "„Als Ostereierfarbe wurden Zwiebelschalen, Safran und Gras genutzt.“"
                            },
                            {
                                "example_id": "f31db17e-8c0c-4c2f-87e3-5398e8fa28d5",
                                "sense_id": "bc6b81b9-77b5-31b3-afa6-ab7285753a86",
                                "text": "„Für das Färben eignen sind handelsübliche Ostereierfarben.“"
                            },
                            {
                                "example_id": "16848920-a09a-4aa0-bdbc-dd55765fbd24",
                                "sense_id": "bc6b81b9-77b5-31b3-afa6-ab7285753a86",
                                "text": "„Ostereierfarben aus dem Lebensmittelhandel, Brausetabletten oder bunte Stifte sind heute meist unbedenklich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
