                ],
                "senses": [
                    {
                        "sense_id": "c239bc2b-fe53-3e0f-afa0-643c7dd0d0bb",
                        "entry_id": "cea4211c-bbdd-3faa-b0e5-6445b18b057a",
                        "glosses": [
                            "Action de rougir ou de faire rougir. Résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ac5725c-f74e-4c1e-998e-61febc8d2508",
                                "sense_id": "c239bc2b-fe53-3e0f-afa0-643c7dd0d0bb",
                                "text": "Un rougissement fonça la peau jaune de l'homme de grand feu. Mais très vite, il redevint blême et son émotion ne fut plus appréciable qu'aux espacements dans sa parole."
                            },
                            {
                                "example_id": "e502a997-e80e-4f76-a82e-5de708af4091",
                                "sense_id": "c239bc2b-fe53-3e0f-afa0-643c7dd0d0bb",
                                "text": "Il s'ensuit diverses sensations physiques (p. ex., rougissements, tremblements, transpiration) et une contre-performance des fonctions cognitives (p. ex., problèmes de concentration, trous de mémoire)."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b5d1a4f-86c0-3acd-9882-a0311107968b",
                        "entry_id": "cea4211c-bbdd-3faa-b0e5-6445b18b057a",
                        "glosses": [
                            "Absorption interstellaire de la lumière des objets célestes, les poussières interstellaires laissant passer le rouge mieux que le bleu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dfbeb94-7ec6-47c5-afd5-b6d288522723",
                                "sense_id": "4b5d1a4f-86c0-3acd-9882-a0311107968b",
                                "text": "Si on se limite à l'étude du rougissement des étoiles situées au voisinage du plan galactique, il est possible d'analyser les fluctuations du rougissement comme on analyse les fluctuations de brillance de la voie lactée, sur la base d'un modèle de nuages discrets de matière interstellaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4334a87-f890-31c5-881a-a0884c620eb2",
                        "entry_id": "cea4211c-bbdd-3faa-b0e5-6445b18b057a",
                        "glosses": [
                            "Action de chauffer au rouge."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
