                "senses": [
                    {
                        "sense_id": "3b95d493-cdc0-357b-8d61-c54d41e72042",
                        "entry_id": "99fb3a0f-6870-31a1-8127-350b84ced1e2",
                        "glosses": [
                            "playfellow"
                        ],
                        "tags": [
                            "archaic",
