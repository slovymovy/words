{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d82291d9-7436-3075-9cf4-741d965f95e5",
                    "sense_definition": "A swinging bed or couch made of netting or canvas, suspended by cords at the ends.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the afternoon relaxing in a <w>hammock</w> under the trees.",
                            "target_lang_translations": {
                                "zh": "我们下午在树下的<w>吊床</w>里放松休息。"
                            }
                        },
                        {
                            "text": "The sailor slept in a <w>hammock</w> while at sea.",
                            "target_lang_translations": {
                                "zh": "水手在海上时睡在<w>吊床</w>里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swinging bed"
                    ],
                    "common_phrases": [
                        "swinging hammock"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用网或帆布制成的吊床，两端用绳子悬挂。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吊床",
                                "target_lang_sense_clarification": "指悬挂在两点之间供人休息的床。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "764adea5-547e-3ccc-b759-8dc4ef942b3e",
                    "sense_definition": "A small area of land that is thickly wooded and covered with bushes and vines.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers pushed through the dense <w>hammock</w> to reach the clearing.",
                            "target_lang_translations": {
                                "zh": "探险家们穿过茂密的<w>丛林</w>才到达了空地。"
                            }
                        },
                        {
                            "text": "Many rare birds nest within the protected <w>hammock</w> near the coast.",
                            "target_lang_translations": {
                                "zh": "许多珍稀鸟类在海岸附近的保护区<w>丛林</w>中筑巢。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thicket",
                        "grove"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in the Southern United States."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指美国南部地区一种植被茂密、灌木和藤蔓丛生的林地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "丛林",
                                "target_lang_sense_clarification": "指植被茂密的林地。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a817a8c-dafb-3e40-baa9-906ba0870074",
                    "sense_definition": "To rest or lie in a hammock.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>hammock</w> in the garden all afternoon.",
                            "target_lang_translations": {
                                "zh": "他们决定整个下午都<w>躺在吊床上</w>休息。"
                            }
                        },
                        {
                            "text": "It is peaceful to <w>hammock</w> while listening to the birds.",
                            "target_lang_translations": {
                                "zh": "一边听鸟叫一边<w>躺在吊床上</w>感觉很宁静。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "躺在吊床上休息。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "躺在吊床上",
                                "target_lang_sense_clarification": "指在吊床上休息的动作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b546163-ba21-3bd4-bd95-5baad3116c95",
                    "sense_definition": "To hang or suspend something in a way that curves like a hammock.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suspension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>hammocked</w> the fabric between two wooden beams.",
                            "target_lang_translations": {
                                "zh": "艺术家将布料<w>悬挂</w>在两根木梁之间。"
                            }
                        },
                        {
                            "text": "She <w>hammocked</w> the net to catch the falling leaves.",
                            "target_lang_translations": {
                                "zh": "她把网<w>悬挂</w>起来以接住落叶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drape",
                        "suspend"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某物悬挂或支撑起来，使其呈现出像吊床一样的弧度。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "悬挂",
                                "target_lang_sense_clarification": "指将物体挂起。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05e801a1-5524-3878-af30-6447fd7b7d28",
                    "sense_definition": "To wrap or hold something tightly in a curved shape.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wrapping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>hammocked</w> the baby in a soft blanket.",
                            "target_lang_translations": {
                                "zh": "她用柔软的毯子把婴儿<w>包裹</w>起来。"
                            }
                        },
                        {
                            "text": "The scarf <w>hammocked</w> her neck during the cold winter.",
                            "target_lang_translations": {
                                "zh": "寒冬里，围巾<w>包裹</w>着她的脖子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cradle",
                        "envelop"
                    ],
                    "target_lang_definitions": {
                        "zh": "用柔软的材料将某物包裹或托住，使其呈弧形。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "包裹",
                                "target_lang_sense_clarification": "指用布料等将物体围住。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a80378c7-1467-3992-bda8-df613153c577",
                    "sense_definition": "To place a less popular television program between two highly rated ones to increase its viewership.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "broadcasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The network decided to <w>hammock</w> the new comedy between two hit shows.",
                            "target_lang_translations": {
                                "zh": "电视台决定将这部新喜剧<w>夹心编排</w>在两部热门节目之间。"
                            }
                        },
                        {
                            "text": "They hope to <w>hammock</w> the documentary to gain more viewers.",
                            "target_lang_translations": {
                                "zh": "他们希望通过<w>夹心编排</w>这部纪录片来获得更多观众。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在电视节目编排中，将收视率较低的节目安排在两个高收视率节目之间，以提高其收视率。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "夹心编排",
                                "target_lang_sense_clarification": "电视行业术语，指将弱势节目置于强势节目之间。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "db565504-8e0d-3235-a664-f56fe59886e6",
                    "sense_definition": "A family name.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is named <w>Hammock</w>.",
                            "target_lang_translations": {
                                "zh": "这本书的作者名叫<w>哈莫克</w>。"
                            }
                        },
                        {
                            "text": "Mr. <w>Hammock</w> will be joining our meeting later today.",
                            "target_lang_translations": {
                                "zh": "<w>哈莫克</w>先生稍后会参加我们的会议。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "哈莫克",
                                "target_lang_sense_clarification": "Hammock 的音译姓氏。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}