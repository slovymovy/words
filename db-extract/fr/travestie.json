                    {
                        "sense_id": "40717787-f500-3cc6-aeef-27f5c8cfd06f",
                        "entry_id": "fca77a49-247a-35f2-a2b6-fbfdae417902",
                        "glosses": [
                            "Femme qui se vêt en homme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45373a6c-c0a3-44a0-ac78-0141a3902190",
                                "sense_id": "40717787-f500-3cc6-aeef-27f5c8cfd06f",
                                "text": "L'essentiel est qu'une travestie, qui a chanté pendant cinquante ans des couplets de Carmouche sur des airs empruntés à la clef du Caveau, ait une vieillesse heureuse."
                            },
                            {
                                "example_id": "f543fb46-0e0e-4630-a5f2-eda6343aa0cb",
                                "sense_id": "40717787-f500-3cc6-aeef-27f5c8cfd06f",
                                "text": "Il y a , dit - on , des troupes composées exclusivement de femmes et dans lesquelles les rôles d'hommes sont joués par des travesties."
                            },
                            {
                                "example_id": "063f40a5-bbb0-4489-a2c0-b74cc1c80ef2",
                                "sense_id": "40717787-f500-3cc6-aeef-27f5c8cfd06f",
                                "text": "Se représenter non féminisée marque moins une quelconque intention de se faire passer pour un homme ou une travestie qu'une farouche hostilité aux codes établis de l'apparence des femmes."
                            }
                        ]
                    }
