                ],
                "senses": [
                    {
                        "sense_id": "bcaf024c-be43-3df3-988d-0ccbddae806d",
                        "entry_id": "d65f649e-56ef-34fe-a53f-74bb1a060bcf",
                        "glosses": [
                            "militärische Aktion mit dem Ziel, etwas zu erobern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49a9d9b5-8887-4d40-8eb9-44d86eb1d68a",
                                "sense_id": "bcaf024c-be43-3df3-988d-0ccbddae806d",
                                "text": "„Darum sind die Darstellungen von Entdeckerreisen ins Innere Afrikas und die ihnen folgenden kolonialen Eroberungszüge häufig durch eigentümlich menschenleere Szenarien geprägt.“"
                            },
                            {
                                "example_id": "2c091876-5610-4de8-a672-ff9482992d27",
                                "sense_id": "bcaf024c-be43-3df3-988d-0ccbddae806d",
                                "text": "„Die Eroberungszüge des Königs Lalitaditya von Kashmir, der im 7. Jahrhundert bis tief nach Süden und danach auch noch nach Zentralasien vorstieß, waren die einsame Ausnahme.“"
                            },
                            {
                                "example_id": "67eb226c-de22-4a53-8b00-c52382bdebf6",
                                "sense_id": "bcaf024c-be43-3df3-988d-0ccbddae806d",
                                "text": "„Wenngleich es dem indischen Herrscher Yasodharman im Jahre 527 gelang, die Hunnen empfindlich zu schlagen und deren Eroberungszügen in Südasien Einhalt zu gebieten, zerfiel die Region in der Folgezeit in unzählige, miteinander rivalisierende Kleinreiche.“"
                            },
                            {
                                "example_id": "6a2f900a-5bb9-4d7f-948b-b1a28147c2c1",
                                "sense_id": "bcaf024c-be43-3df3-988d-0ccbddae806d",
                                "text": "„Dagegen blieb die Region südlich des Hindukusch von den arabischen Eroberungszügen verschont und damit für die kommenden zwei Jahrhunderte von islamischem Einfluss nahezu unberührt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
