        "fr-extract.jsonl": [
            {
                "entry_id": "6b6e6d4b-888c-3fa3-9a7a-be8b68812e27",
                "word": "sybaritisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d39680aa-42b8-4186-8f69-6abfbb63b815",
                        "entry_id": "6b6e6d4b-888c-3fa3-9a7a-be8b68812e27",
                        "tags": [
                            "plural"
                        ],
                        "form": "sybaritismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96ac95ec-01d2-378e-bad8-adad98f16f00",
                        "entry_id": "6b6e6d4b-888c-3fa3-9a7a-be8b68812e27",
                        "glosses": [
                            "Fait de vouloir vivre comme les Sybarites, dans le plaisir et la luxure."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8b10eb7d-18f4-3646-a2ad-98717de7872d",
                        "entry_id": "6b6e6d4b-888c-3fa3-9a7a-be8b68812e27",
                        "glosses": [
                            "Goût de luxe ; mollesse ; délicatesse exagérée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef2dd59d-ca25-4a43-b76e-ae5bc5a8a9ec",
                                "sense_id": "8b10eb7d-18f4-3646-a2ad-98717de7872d",
                                "text": "À eux trois, ces commis suffisaient à une besogne qui aurait mis sur les dents dix de ces employés dont le sybaritisme enfle aujourd'hui les colonnes du budget."
                            },
                            {
                                "example_id": "3d7f5fbb-d404-4d7f-84f6-48615bb0528f",
                                "sense_id": "8b10eb7d-18f4-3646-a2ad-98717de7872d",
                                "text": "Est-ce que c’est meilleur quand les autres ne l’ont pas ? Longtemps, j’ai été sûr de la réponse, à l’heure où le sybaritisme me poussait à faire une petite sieste, en milieu de semaine, quand je n’avais pas cours l’après-midi."
                            },
                            {
                                "example_id": "aae28e6f-76e4-475c-a16a-8dd133150a87",
                                "sense_id": "8b10eb7d-18f4-3646-a2ad-98717de7872d",
                                "text": "Il s'est donné corps et âme à François Fillon, ce qui ne l'empêche pas de lui reprocher sa prudence provinciale, son sybaritisme inavoué, sa réserve dans les sentiments."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4dc15635-1132-412f-9f7c-9d3ecbf1c47c",
                        "source_entry_id": "6b6e6d4b-888c-3fa3-9a7a-be8b68812e27",
                        "source_sense_id": "96ac95ec-01d2-378e-bad8-adad98f16f00",
                        "target_lang_word": "sybaritism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sybaritism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec7ae6bf-97a8-38c9-93ca-fbedf1fda6ba",
                                        "entry_id": "3e42b299-9c6a-3e69-adb8-84fc4e0b3394",
                                        "glosses": [
                                            "luxury, wantonness, voluptuousness, or hedonism"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "291f7c5b-a9f3-441d-8dc2-f0bd026ac2e2",
                                                "sense_id": "ec7ae6bf-97a8-38c9-93ca-fbedf1fda6ba",
                                                "text": "The samurai and others who flocked from the provinces to the capital when all offices were thrown open to talent, took kindly to the sybaritism which had been one of the causes of ruin to those they were supplanting."
                                            },
                                            {
                                                "example_id": "da6badf8-89a9-441a-a7d2-903e238aa2e0",
                                                "sense_id": "ec7ae6bf-97a8-38c9-93ca-fbedf1fda6ba",
                                                "text": "What fiend ever suggested to my landlady the combination of crimson roses and purplish paper? How I hate my environments! Poverty and sybaritism go as ill together as roses and purple paper, but I have always been too much given up to the gratification of the eyes and of the senses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
