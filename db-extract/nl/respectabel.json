                                    {
                                        "sense_id": "ea658864-e5df-3a36-a2cd-43df7b6df8f2",
                                        "entry_id": "5c45924a-5bc3-3571-b150-a039bb0b68a4",
                                        "glosses": [
                                            "Achtung und Respekt verdienend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26044547-532b-4ba6-9c51-6bb2ffd66b21",
                                                "sense_id": "ea658864-e5df-3a36-a2cd-43df7b6df8f2",
                                                "text": "In seiner Abschlussprüfung erzielte er eine respektable Leistung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a4f72dc-9efd-4f2e-9e00-8f6f1059286b",
                        "source_entry_id": "39ca7fe5-1a74-3510-adb0-80f2bca6a7ee",
                        "source_sense_id": "e5b01f9c-3a51-372b-96bb-5fe13afc902d",
                        "source_sense_description": "eerbiedwaardig",
                        "target_lang_word": "respectable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "respectable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8870a2b9-c2be-3590-a885-9fb462249b39",
                                        "entry_id": "ae6111f1-bd84-32a7-894f-4f876a7483a3",
                                        "glosses": [
                                            "Deserving respect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2bfbf02-f184-4b86-8178-2c1f2434fae1",
                                                "sense_id": "8870a2b9-c2be-3590-a885-9fb462249b39",
                                                "text": "His accomplishments, morals, loyalty, and stature make him a respectable person."
                                            },
                                            {
                                                "example_id": "aed99aaf-9c2e-4401-8eb0-e82b27b777bc",
                                                "sense_id": "8870a2b9-c2be-3590-a885-9fb462249b39",
                                                "text": "In former days every tavern of repute kept such a room for its own select circle, a club, or society, of habitués, who met every evening, for a pipe and a cheerful glass. In this way all respectable burgesses, down to fifty years ago, spent their evenings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90031d9c-3701-3986-b855-e75d20adce5b",
                                        "entry_id": "ae6111f1-bd84-32a7-894f-4f876a7483a3",
                                        "glosses": [
                                            "Decent; satisfactory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4cc15c4-b08a-49ff-b293-19eb2c935f07",
                                                "sense_id": "90031d9c-3701-3986-b855-e75d20adce5b",
                                                "text": "Turn up to the interview wearing something respectable.  She plays a respectable game of chess.  He got a respectable B+ on his last exam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74f834ee-e2bb-3465-9bae-3f9a437a313d",
                                        "entry_id": "ae6111f1-bd84-32a7-894f-4f876a7483a3",
                                        "glosses": [
                                            "Moderately well-to-do."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "respectable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff45c349-8d30-3d8f-9dcc-f3ee1d52df04",
                                        "entry_id": "47cdeffb-a4a4-398e-9dd7-ec9631e6a17b",
                                        "glosses": [
                                            "A person who is respectable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e241073a-cde2-422c-8ded-6b38921c13c0",
                                                "sense_id": "ff45c349-8d30-3d8f-9dcc-f3ee1d52df04",
                                                "text": "They forced their way into the meetings called by the respectables; and the respectables disappeared. It was of their own respectable good pleasure that they withdrew."
                                            },
                                            {
                                                "example_id": "804a20f3-e79a-4f85-ba7e-236904e46ccf",
                                                "sense_id": "ff45c349-8d30-3d8f-9dcc-f3ee1d52df04",
                                                "text": "The tensions between the \"respectables\" and the \"gay spoilers\""
                                            },
                                            {
                                                "example_id": "d4474847-e90f-4c42-ae6b-dde94c38ab40",
                                                "sense_id": "ff45c349-8d30-3d8f-9dcc-f3ee1d52df04",
                                                "text": "The “respectables”, then, impute to themselves an absence of such character blemishes, or stated in more positive terms, an allegiance to American mainstream morality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86b378a7-971a-4856-a549-c6a54dd2dea4",
                        "source_entry_id": "39ca7fe5-1a74-3510-adb0-80f2bca6a7ee",
                        "source_sense_id": "e5b01f9c-3a51-372b-96bb-5fe13afc902d",
                        "source_sense_description": "eerbiedwaardig",
                        "target_lang_word": "respectable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "respectable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cb4f997-074a-3ac4-8c8e-a2d51ed4c174",
                                        "entry_id": "8e5cce1b-1569-313b-acbc-8d57b16a01b5",
                                        "glosses": [
                                            "Qui mérite du respect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8169342-132e-42fd-ab12-185bd85ba087",
                                                "sense_id": "3cb4f997-074a-3ac4-8c8e-a2d51ed4c174",
                                                "text": "Ce n’est pas un spectacle extraordinaire à Saint-Louis que de voir deux hommes « respectables » mettre habit bas et se colleter publiquement."
                                            },
                                            {
                                                "example_id": "55f5ba69-80a4-4659-b968-17d87ec300cb",
                                                "sense_id": "3cb4f997-074a-3ac4-8c8e-a2d51ed4c174",
                                                "text": "Quant aux spiritualistes de la fin du XIXᵉ siècle, ils fustigent volontiers la bourgeoisie voltairienne qu'ils qualifient de matérialiste, d’hypocrite et qu'ils jugent faussement respectable."
                                            },
                                            {
                                                "example_id": "6fca4525-5917-4ee6-8b42-8dd46b812f0a",
                                                "sense_id": "3cb4f997-074a-3ac4-8c8e-a2d51ed4c174",
                                                "text": "Cette personne est respectable par son âge et par ses vertus. — Ce sentiment est respectable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d680b01-303c-30d4-a1f1-a34ba31c1be6",
                                        "entry_id": "8e5cce1b-1569-313b-acbc-8d57b16a01b5",
                                        "glosses": [
                                            "Qui incite au respect."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aa4a767-2059-46f6-87b2-320a44ddc4e8",
                                                "sense_id": "4d680b01-303c-30d4-a1f1-a34ba31c1be6",
                                                "text": "La ville avait la réputation d’être imprenable ; son château s’élevait à l’est et la ceinture de murailles qui entourait la cité venait s’y attacher; des portes, des bastions, des fossés formaient un respectable appareil de défense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4910650-f1c8-305a-be8f-fe719b90d881",
                                        "entry_id": "8e5cce1b-1569-313b-acbc-8d57b16a01b5",
                                        "glosses": [
                                            "Dont l’importance mérite considération."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b26a75fb-adbf-4d6a-bef6-86395dc0d784",
                                                "sense_id": "d4910650-f1c8-305a-be8f-fe719b90d881",
                                                "text": "Suivant les renseignements officiels qui m’ont été communiqués, la population de Reykjavik est actuellement de 2,600 habitants, ce qui est déjà bien respectable pour la capitale d’un pays qui ne compte que 70,000 âmes ; […]"
                                            },
                                            {
                                                "example_id": "0677900d-937a-495b-a640-d7e82a835003",
                                                "sense_id": "d4910650-f1c8-305a-be8f-fe719b90d881",
                                                "text": "[…], il entra dans le bois, d’où il ressortit un peu après, écorçant avec son couteau une trique de grosseur assez respectable."
                                            },
                                            {
                                                "example_id": "f46e25bf-b02d-4e11-835b-487f136ffe4e",
                                                "sense_id": "d4910650-f1c8-305a-be8f-fe719b90d881",
                                                "text": "La cellule numéro 14 était éclairée par une assez large fenêtre, munie de respectables barreaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
