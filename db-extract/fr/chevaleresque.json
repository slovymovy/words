        "fr-extract.jsonl": [
            {
                "entry_id": "a2abea21-fc03-397d-99d4-4b89166a075a",
                "word": "chevaleresque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "81416f42-6900-4d4a-b1ba-bd57ba9d8016",
                        "entry_id": "a2abea21-fc03-397d-99d4-4b89166a075a",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "chevaleresques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f6eca8d4-9dc6-3c68-b46f-a68719192dfb",
                        "entry_id": "a2abea21-fc03-397d-99d4-4b89166a075a",
                        "glosses": [
                            "Qui est relatif à la chevalerie, qui en a le caractère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07df022f-e9e0-496d-b923-4722295fbbfb",
                                "sense_id": "f6eca8d4-9dc6-3c68-b46f-a68719192dfb",
                                "text": "La maison d'Ambly, d'origine chevaleresque, paraît tirer son nom de la terre d’Ambly-sur-Bar, qui n'est plus aujourd'hui, avec ses treize habitants, qu'une dépendance de la commune de Vendresse, canton d'Omont, arrondissement de Mézières, département des Ardennes."
                            },
                            {
                                "example_id": "34364236-ac2d-4b28-ab6a-7f753b5ea26f",
                                "sense_id": "f6eca8d4-9dc6-3c68-b46f-a68719192dfb",
                                "text": "Précisons que les règles chevaleresques qui jouaient bel et bien au XIIIᵉ siècle un rôle de contrainte absolue, n’interviennent dans le roman qu’à titre d’obstacle mythique et de figures rituelles de rhétorique."
                            },
                            {
                                "example_id": "528709af-3e11-4a1a-a102-b06532568526",
                                "sense_id": "f6eca8d4-9dc6-3c68-b46f-a68719192dfb",
                                "text": "On les entendait dire : « Grâce pour le royalisme ! il a rendu plus d’un service. Il a rapporté la tradition, le culte, la religion, le respect. Il est fidèle, brave, chevaleresque, aimant, dévoué. […] »"
                            },
                            {
                                "example_id": "0ffa4fc7-9eb6-42a3-9ff0-f0cc10b7c9c3",
                                "sense_id": "f6eca8d4-9dc6-3c68-b46f-a68719192dfb",
                                "text": "L’urbanité, l’esprit chrétien et un je ne sais quoi d’antique et de chevaleresque qui régnait à sa cour, m’avaient fait désirer de la mieux connaître; […]."
                            },
                            {
                                "example_id": "ded18f1f-219c-4d59-baa8-498fbf720c35",
                                "sense_id": "f6eca8d4-9dc6-3c68-b46f-a68719192dfb",
                                "text": "S’il a des goûts relevés et chevaleresques, il prend une femme qui ne fait pas passer la rue par son lit."
                            },
                            {
                                "example_id": "1505b648-f2ce-49d6-be1f-0bed3fda77c0",
                                "sense_id": "f6eca8d4-9dc6-3c68-b46f-a68719192dfb",
                                "text": "Sire Réginald Front-de-Bœuf, avec ses nobles et chevaleresques alliés et compagnons, n’accepte point de défi de la part d’esclaves, de serfs ou de fugitifs."
                            },
                            {
                                "example_id": "2b5c60e5-5e7f-4382-b110-21ddf205719d",
                                "sense_id": "f6eca8d4-9dc6-3c68-b46f-a68719192dfb",
                                "text": "« Kevin contre la GroKo », cela pourrait être le titre d'une épopée enfantine et chevaleresque où un jeune héros finit par terrasser le monstre et réveiller la belle princesse endormie. Mais c'est bien autre chose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b314eb45-3cf0-4ebc-9b32-56933dde08b9",
                        "source_entry_id": "a2abea21-fc03-397d-99d4-4b89166a075a",
                        "source_sense_id": "f6eca8d4-9dc6-3c68-b46f-a68719192dfb",
                        "target_lang_word": "ritterlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ritterlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef4e04a9-33e6-30db-a3f6-9f54b6c0182c",
                                        "entry_id": "65e25fe7-aedf-3d91-aa4c-510f501eb70e",
                                        "glosses": [
                                            "dem Ritterstand angehörend, einem Ritter entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bae47895-395f-4903-b217-e2a4e0fe01c1",
                                                "sense_id": "ef4e04a9-33e6-30db-a3f6-9f54b6c0182c",
                                                "text": "„Auch die Sitze der ritterlichen Vasallen und Dienstmannen waren ursprünglich mehr oder weniger stark befestigt.“"
                                            },
                                            {
                                                "example_id": "57c25e8e-636f-446d-902a-5b3b7fe1df8d",
                                                "sense_id": "ef4e04a9-33e6-30db-a3f6-9f54b6c0182c",
                                                "text": "„Neben der ritterlichen Dichtung beeinflußte das deutsche Schrifttum der Mystik den Wortschatz des hochmittelalterlichen Deutsch am stärksten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24fed131-d49b-3c97-b0cf-601ec436f482",
                                        "entry_id": "65e25fe7-aedf-3d91-aa4c-510f501eb70e",
                                        "glosses": [
                                            "vom Verhalten her ehrenvoll, eine vornehme Gesinnung besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7309af83-dfc2-325d-864b-46899e8aa5e5",
                                        "entry_id": "65e25fe7-aedf-3d91-aa4c-510f501eb70e",
                                        "glosses": [
                                            "vom Verhalten her höflich, zuvorkommend und hilfsbereit"
                                        ],
