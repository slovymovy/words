        "fr-extract.jsonl": [
            {
                "entry_id": "26a11775-a0c8-3a23-a9bd-da5fb7f8d4e8",
                "word": "mocheté",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a9cf4166-3d79-4ff5-86cc-f99ffbeaf098",
                        "entry_id": "26a11775-a0c8-3a23-a9bd-da5fb7f8d4e8",
                        "tags": [
                            "plural"
                        ],
                        "form": "mochetés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e20ddcd6-b755-3705-a6ac-4bb4adbb1fb7",
                        "entry_id": "26a11775-a0c8-3a23-a9bd-da5fb7f8d4e8",
                        "glosses": [
                            "Laideur, caractère de ce qui est moche, esthétiquement ou moralement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "45bb7b97-f0fb-4c89-8f97-dec634856fb8",
                                "sense_id": "e20ddcd6-b755-3705-a6ac-4bb4adbb1fb7",
                                "text": "Avec ma femme aussi, c’était rudement bien. Au début… malgré sa mocheté incroyable."
                            },
                            {
                                "example_id": "ba6fd1d1-5086-474a-8bfd-e7383a68c50a",
                                "sense_id": "e20ddcd6-b755-3705-a6ac-4bb4adbb1fb7",
                                "text": "C’est d’une mocheté incroyable !"
                            }
                        ]
                    },
                    {
                        "sense_id": "47ad8be3-7c15-31a6-9d17-7bfccad7a734",
                        "entry_id": "26a11775-a0c8-3a23-a9bd-da5fb7f8d4e8",
                        "glosses": [
                            "Chose sans intérêt, plutôt désagréable pour les sens."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "963822ac-6518-4745-89fb-54b52623ec02",
                                "sense_id": "47ad8be3-7c15-31a6-9d17-7bfccad7a734",
                                "text": "Grégoire lui enviait ses traits réguliers, sa démarche, son aisance. Mais sa voix est une mocheté, se rassurait-il. Il mâche ses mots et parle du nez."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0211e67-85ab-3e9b-8d2e-6a29add88e6e",
                        "entry_id": "26a11775-a0c8-3a23-a9bd-da5fb7f8d4e8",
                        "glosses": [
                            "Personne laide, en particulier du sexe féminin. → voir laideron"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a2149a2e-c7f5-4d79-a07e-c129c7532dd2",
                                "sense_id": "f0211e67-85ab-3e9b-8d2e-6a29add88e6e",
                                "text": "C’est une vraie mocheté, mais tellement sympa qu’on finit par la trouver belle."
                            },
                            {
                                "example_id": "b64c0edc-79bd-4738-8e63-ed2658a8aeda",
                                "sense_id": "f0211e67-85ab-3e9b-8d2e-6a29add88e6e",
                                "text": "Je dois pourtant bien avoir l’air d'un zombie, quoique l’éclairage des bars fasse parfois des miracles (qui se transforment en cauchemar le lendemain matin quand on retrouve une mocheté dans son lit ou, pire, quand on se retrouve dans le lit d’une mocheté)."
                            }
                        ]
                    }
                ],
