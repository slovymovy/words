                "senses": [
                    {
                        "sense_id": "58cd1fe7-31a2-3550-aebd-60e82a9bc108",
                        "entry_id": "20dba0db-7322-3991-9dab-a8549d5047e0",
                        "glosses": [
                            "Commune française, située dans le département des Alpes-Maritimes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fa6b059-ba1b-4c93-a272-03e6e72a5e0a",
                                "sense_id": "58cd1fe7-31a2-3550-aebd-60e82a9bc108",
                                "text": "Installé à Saint-Paul de Vence puis à Vallauris, il travaille en collaboration avec des céramistes de renom tels Roger Capron, Jean Marais, le maître verrier Jean-Claude Novaro…"
                            },
                            {
                                "example_id": "504a435c-115a-4bf1-94d7-f0a3b5e3e2c2",
                                "sense_id": "58cd1fe7-31a2-3550-aebd-60e82a9bc108",
                                "text": "Pierre Bourdieu parle à propos de ces artisans-artistes d’une « petite bourgeoisie nouvelle », constituée d’individus issus de classes supérieures, mais d’un niveau scolaire plus faible que celui de leur classe d’origine, nonobstant supérieur à celui des classes moyennes, qui choisissent de se diriger vers des « professions nouvelles » telle celle d’artisans d'art, au point de constituer de véritables villages d’artisans au Nouveau Mexique comme à Vallauris ou Saint-Amand-en-Puisaye en France."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea09e6b2-42fe-364d-858d-ed52a664011f",
                        "entry_id": "20dba0db-7322-3991-9dab-a8549d5047e0",
                        "glosses": [
                            "Céramique, objets en céramique produits dans cette ville."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19397a9d-eac4-4a26-a1a2-c7d8264682ac",
                                "sense_id": "ea09e6b2-42fe-364d-858d-ed52a664011f",
                                "text": "Au chapitre des objets typiques, … figurent également : le petit vase en Vallauris » (j'ai longtemps cru que « le vallauris » était une matière ) , le décapsuleur - guitare fixé , grâce à un aimant, au ventre d'une figurine en fil de fer pourvue d'une tête en bois, …"
                            },
                            {
                                "example_id": "3828106a-696d-449e-a30d-3b7bfcddf843",
                                "sense_id": "ea09e6b2-42fe-364d-858d-ed52a664011f",
                                "text": "Oui c'est du Vallauris, j'y tiens beaucoup n'est ce pas."
                            }
                        ]
                    }
