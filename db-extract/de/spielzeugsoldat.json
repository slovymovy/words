                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bd90219-cb70-4c6b-be11-b4a1cca36637",
                                "sense_id": "955a8ccb-9bb0-34dc-aba0-0f28637a2ba3",
                                "text": "„Teddybären sehen aus, als seien sie von Spielzeugsoldaten massakriert worden, und ihre Leichen wirken, als hätte man sie achtlos auf diesem chaotischen Schlachtfeld liegen lassen.“"
                            },
                            {
                                "example_id": "809bd5b5-2b91-497e-965f-d2e73284cf2d",
                                "sense_id": "955a8ccb-9bb0-34dc-aba0-0f28637a2ba3",
                                "text": "„Shaws Blick fiel auf die Spielzeugsoldaten.“"
                            },
                            {
                                "example_id": "3c686b86-ed23-425b-a4bf-9fc4680fa247",
                                "sense_id": "955a8ccb-9bb0-34dc-aba0-0f28637a2ba3",
                                "text": "„Meine Spielzeugsoldaten interessierten mich überhaupt nicht mehr, obwohl ich eine ganze Armee davon besaß.“"
                            }
                        ],
