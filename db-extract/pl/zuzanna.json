                                        "sense_id": "8906b49f-ccc4-34d8-8f81-0bd3062afffe",
                                        "entry_id": "8539369b-c2f3-32fd-9a6b-7ffa2432e4e8",
                                        "glosses": [
                                            "Of or pertaining to the ancient city of Susa."
                                        ],
                                        "tags": [
                                            "historical",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Susan",
