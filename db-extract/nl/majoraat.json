                                "target_senses": [
                                    {
                                        "sense_id": "85d9625e-76d8-3069-93bd-4011a188ef4b",
                                        "entry_id": "03c5b9bd-2501-3814-95a9-cb7ae626d55e",
                                        "glosses": [
                                            "Immeuble inaliénable attaché à la possession d’un titre de noblesse et qui passe avec ce titre à l’héritier naturel ou adoptif du titulaire."
                                        ],
                                        "tags": [
                                            "Droit de propriété"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22e09f73-d25e-44b1-af20-42f99e090d12",
                                                "sense_id": "85d9625e-76d8-3069-93bd-4011a188ef4b",
                                                "text": "Aussi l’Angleterre admet-elle les majorats dans les grandes familles, chez les pairs du royaume, tandis que la France défend aux parents d’exhéréder leurs enfants, ne leur laisse la libre disposition de ce qu’ils possèdent que dans de certaines limites."
                                            },
                                            {
                                                "example_id": "0ea7f35f-9775-4ae9-a836-414eec8f3619",
                                                "sense_id": "85d9625e-76d8-3069-93bd-4011a188ef4b",
                                                "text": "La terre de La Bastie, reconstituée à plus de cent mille francs de rentes, était érigée en majorat par lettres patentes que la Cour Royale enregistra vers la fin du mois d’avril."
                                            },
                                            {
                                                "example_id": "56a6ab97-a679-4caa-8e33-201d026f2239",
                                                "sense_id": "85d9625e-76d8-3069-93bd-4011a188ef4b",
                                                "text": "Baron en 1818, Saillard constitue un majorat en 1821. Il a alors un revenu annuel de l’ordre de 60 000 F, dont son hôtel de la rue de Clichy, son domaine de Rugles (avec grosse forge, fourneau, fonderie et laminoir) et une ferme dans les Ardennes (avec laminoir en cuivre et fonderie) constituent les pièces maîtresses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c1c6c86-5585-3522-bd45-5f0a0d67b9fc",
                                        "entry_id": "03c5b9bd-2501-3814-95a9-cb7ae626d55e",
                                        "glosses": [
                                            "Charge d’infirmière-major."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c72aa1c-65ea-3ab6-a40c-9d79fb736770",
                                        "entry_id": "03c5b9bd-2501-3814-95a9-cb7ae626d55e",
                                        "glosses": [
                                            "Dignité de maire du palais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec5db39a-6dc9-48eb-a3ff-b9846773ca16",
                                                "sense_id": "4c72aa1c-65ea-3ab6-a40c-9d79fb736770",
                                                "text": "Carloman, en prenant l’habit monastique, céda le majorat d’Austrasie à son frère Pépin."
                                            }
                                        ]
                                    }
                                ]
                            }
