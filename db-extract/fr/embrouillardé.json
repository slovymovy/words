                        "examples": [
                            {
                                "example_id": "ca262568-1973-40df-b4ca-d493b5d37ada",
                                "sense_id": "4f576f42-5a0a-39e1-b855-bf4a57e7022e",
                                "text": "Un ethnologue, Dale Jarvis, publie un tas de livres sur les spectres, les fées, les monstres et d’autres créatures qui pullulent dans leur intermonde embrouillardé."
                            },
                            {
                                "example_id": "c09c779d-8e25-4962-a7a8-756fcb7c715a",
                                "sense_id": "4f576f42-5a0a-39e1-b855-bf4a57e7022e",
                                "text": "Ses longs plans-séquences, ses magnifiques images de métaphores entre introspection et observation du monde, son art de marier les temps sur des trajectoires éclatées, ses cieux « embrouillardés », lui confèrent une signature unique."
                            }
                        ]
