    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d200833-e33b-314b-8626-7814c53f0f82",
                    "sense_definition": "The use of a computer or computers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cloud <w>computing</w> allows users to access files from anywhere in the world.",
                            "target_lang_translations": {
                                "ru": "Облачные <w>вычисления</w> позволяют пользователям получать доступ к файлам из любой точки мира.",
                                "pl": "<w>Przetwarzanie w chmurze</w> pozwala użytkownikom na dostęp do plików z dowolnego miejsca na świecie."
                            }
                        },
                        {
                            "text": "Mobile <w>computing</w> has completely changed how people work and communicate.",
                            "target_lang_translations": {
                                "ru": "Мобильные <w>вычисления</w> полностью изменили то, как люди работают и общаются.",
                                "pl": "<w>Technologie mobilne</w> całkowicie zmieniły sposób, w jaki ludzie pracują i komunikują się."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cloud computing",
                        "mobile computing",
                        "home computing",
                        "personal computing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование компьютеров или компьютерных систем.",
                        "pl": "Korzystanie z komputerów lub przetwarzanie danych na komputerze."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычисления",
                                "target_lang_sense_clarification": "в терминах типа 'облачные вычисления'"
                            },
                            {
                                "target_lang_word": "компьютерные технологии",
                                "target_lang_sense_clarification": "общая сфера деятельности"
                            },
                            {
                                "target_lang_word": "работа на компьютере",
                                "target_lang_sense_clarification": "процесс использования"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przetwarzanie danych",
                                "target_lang_sense_clarification": "w kontekście technologii takich jak przetwarzanie w chmurze"
                            },
                            {
                                "target_lang_word": "informatyka",
                                "target_lang_sense_clarification": "zastosowanie technologii komputerowych"
                            },
                            {
                                "target_lang_word": "technologie komputerowe",
                                "target_lang_sense_clarification": "ogólna dziedzina korzystania z komputerów"
                            }
                        ]
