                        "examples": [
                            {
                                "example_id": "611f7fb1-e637-4896-b1c1-081eeff96e34",
                                "sense_id": "e3518c95-f90a-3f8f-b829-86dfca2b3338",
                                "text": "„Selbstverständlich trug hier niemand Namensschildchen.“"
                            },
                            {
                                "example_id": "4c491109-9c8a-4a5f-93c5-458de4e4eab1",
                                "sense_id": "e3518c95-f90a-3f8f-b829-86dfca2b3338",
                                "text": "„Noch immer in ihrer rosa Arbeitskleidung, dicke Schweißflecken unter den Armen. Namensschildchen an die Brust geheftet, und schon reden alle Fremden im Hotel sie mit Misty an.“"
                            },
                            {
                                "example_id": "9beb3e25-e5a3-4ec6-b53f-949b0812f40b",
                                "sense_id": "e3518c95-f90a-3f8f-b829-86dfca2b3338",
                                "text": "„Die eine, eine Miss Aldrich, beugte sich lächelnd über Suttree und entfernte sich wieder. Emailiertes Namensschildchen.“"
                            }
                        ],
