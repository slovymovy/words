                    {
                        "form_id": "331c4ca3-cfdd-4ea5-aa08-afc7eb543ce7",
                        "entry_id": "c6877022-97e3-3e9d-a70c-4e2feaf70677",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Benelux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa107483-e336-36cc-b047-2b4a93b5925b",
                        "entry_id": "c6877022-97e3-3e9d-a70c-4e2feaf70677",
                        "glosses": [
                            "Abkürzung für Belgien, Niederlande und Luxemburg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0daa1e0e-dc70-44cd-b1a3-946d9ea2a16d",
                                "sense_id": "fa107483-e336-36cc-b047-2b4a93b5925b",
                                "text": "„Folglich übernahmen die Benelux in vielen Bereichen eine Art Laborfunktion und stellten somit anderen Ländern wertvolle Erfahrung und Wissen bereit.“"
                            },
                            {
                                "example_id": "0391bee4-1e83-4870-8471-3a03506b3635",
                                "sense_id": "fa107483-e336-36cc-b047-2b4a93b5925b",
                                "text": "„Couve meinte, die Benelux sind zur Zeit blockiert.“"
                            },
                            {
                                "example_id": "959ea210-f4da-4430-bf51-eef927dc2f57",
                                "sense_id": "fa107483-e336-36cc-b047-2b4a93b5925b",
                                "text": "„Diese Ausnahme soll aber auch wiederum nur als Übergang gedacht sein, denn die Benelux sind verpflichtet, ihre Zollsätze für Stahl um zwei Punkte zu erhöhen, wenn nach Wegfall der Kontingente einer der den Benelux benachbarten Staaten – Deutschland oder Frankreich – auf die Verzollung indirekter Importe verzichtet.“"
                            },
                            {
                                "example_id": "977b32ac-fb0e-494b-b6dd-6204b23326ab",
                                "sense_id": "fa107483-e336-36cc-b047-2b4a93b5925b",
                                "text": "„Dies führt zu der allgemeinen Bemerkung, daß der Verfasser die Ergebnisse der besagten ‚neuen Forschungsrichtung‘ in Frankreich, in den Benelux, in England und anderswo leider wenig beachtet hat […].“"
                            },
                            {
                                "example_id": "d0e46599-b8ac-4517-9e76-f5472c56ad2d",
                                "sense_id": "fa107483-e336-36cc-b047-2b4a93b5925b",
                                "text": "„Die Kampagne läuft außer in Deutschland auch in den Benelux und Großbritannien.“"
                            },
                            {
                                "example_id": "bc677099-5431-4a7d-ade8-90071b25e0a5",
                                "sense_id": "fa107483-e336-36cc-b047-2b4a93b5925b",
                                "text": "„Deutschland wiederum habe eine andere Position, in Norwegen und Dänemark seien in Friedenszeiten keine Kernwaffen stationiert, und auch bei den Benelux und Italien fände man Eigenheiten, von Griechenland ganz zu schweigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
