                        "entry_id": "92f3c34d-e619-3751-a996-ff66cf3b6e73",
                        "glosses": [
                            "Qui bouche seulement partiellement le conduit auditif, en parlant d’écouteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74050c3b-3cd1-44dc-9666-b036d5c84534",
                                "sense_id": "b0396193-e444-3ed4-a6fe-76d59a860ffb",
                                "text": "Semi-intras — les écouteurs s’enfoncent moins dans les conduits auditifs —, ils réduisent considérablement la gêne pour nos oreilles."
                            },
                            {
                                "example_id": "62ea3037-571e-4307-b21d-7b05b9cfe706",
                                "sense_id": "b0396193-e444-3ed4-a6fe-76d59a860ffb",
                                "text": "Nos écouteurs semi-intra sans fil délivrent un son clair et équilibré."
                            },
                            {
                                "example_id": "9a30a934-b76f-4e62-9e44-3fcbce49d05b",
                                "sense_id": "b0396193-e444-3ed4-a6fe-76d59a860ffb",
                                "text": "Ce ne sont pas des écouteurs intra-auriculaires, mais des écouteurs « semi-intras »."
                            }
                        ]
                    }
                ],
