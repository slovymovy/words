                "senses": [
                    {
                        "sense_id": "19cca29a-517b-3207-a0a8-d764cd36f2ae",
                        "entry_id": "3983f24c-848e-32c0-8106-528f8a3a2a59",
                        "glosses": [
                            "Pot de chambre."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "31a82c32-af08-4e29-adea-e9ca80c1226c",
                                "sense_id": "19cca29a-517b-3207-a0a8-d764cd36f2ae",
                                "text": "Il note du reste que la fameuse propreté japonaise est toute relative; il a pénétré dans des régions où la saleté, les mauvaises odeurs, la vermine et les toiles dʼaraignées, voire les émanations du goguenot régnaient en maîtresses."
                            }
                        ]
                    },
                    {
                        "sense_id": "07976d6c-31bd-3734-aeba-847a37aab751",
                        "entry_id": "3983f24c-848e-32c0-8106-528f8a3a2a59",
                        "glosses": [
                            "Latrines."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "dd32f4b0-e621-4324-8221-aa94cbdf6ce1",
                                "sense_id": "07976d6c-31bd-3734-aeba-847a37aab751",
                                "text": "Celle-ci se composait pour l'essentiel de vinasse, de moisissure et d'humidité, lui révéla son nez, mais il s'y mêlait aussi de vagues effluves de goguenots, plus quelque chose comme un relent de cimetière."
                            }
                        ]
                    },
                    {
                        "sense_id": "882ff5d7-a920-315a-b89c-89f3806cf432",
                        "entry_id": "3983f24c-848e-32c0-8106-528f8a3a2a59",
                        "glosses": [
                            "Personne qui dans les prisons était chargée de nettoyer les cellules et de vider les latrines."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a4a230d9-e461-36f1-87c0-df651151135e",
                        "entry_id": "3983f24c-848e-32c0-8106-528f8a3a2a59",
                        "glosses": [
                            "Pot à cidre, (parfois godeneau)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "85fe4c47-e27c-3995-af19-98c1283402eb",
                        "entry_id": "3983f24c-848e-32c0-8106-528f8a3a2a59",
                        "glosses": [
                            "Cônes en poterie qui servent à maintenir de proche en proche un bétonnage."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1793f37a-785f-4ece-833f-4d2396bb0c86",
                        "source_entry_id": "3983f24c-848e-32c0-8106-528f8a3a2a59",
                        "source_sense_description": "pot de chambre",
                        "target_lang_word": "honey bucket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honey bucket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a36dd7e1-2087-3488-b5f2-df6021be4a12",
                                        "entry_id": "651452e5-4bb0-3c48-adda-e34abba611d8",
                                        "glosses": [
                                            "A chamber pot: a bucket used for urination and defecation."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59ff6b85-77d2-4e45-bcd8-c9c492b0f09d",
                                                "sense_id": "a36dd7e1-2087-3488-b5f2-df6021be4a12",
                                                "text": "A wood stove had been fashioned from a fifty-five gallon drum, matching the design of the honey bucket in the outhouse, the fish smoker on the riverbank and, its barrel sliced diagonally and mounted on a nose wheel, the wheelbarrow in the garden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90d55e80-b32d-4e7f-8bda-30fde5d7c1a4",
                        "source_entry_id": "3983f24c-848e-32c0-8106-528f8a3a2a59",
                        "source_sense_description": "pot de chambre",
                        "target_lang_word": "pisspot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pisspot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "143c1384-3e99-37da-9dd8-33ed94438a42",
                                        "entry_id": "0b1c56c9-7667-3bce-b0b9-247a48f369dc",
                                        "glosses": [
                                            "A portable container used for urination, especially in hospitals or in the absence of indoor plumbing; a chamber pot."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c757d42-2e43-42f0-9955-c1e0dcc4d2f2",
                                                "sense_id": "143c1384-3e99-37da-9dd8-33ed94438a42",
                                                "text": "Beauty looks like a pisspot. I tell her so. A compliment because the golden urine of life is poured into her by her Father the Sun. Hence, the Sun is sitting on a pisspot. That pisspot is the Zodiac."
                                            },
                                            {
                                                "example_id": "b55a792d-4df8-431c-b7df-7877b2c5319d",
                                                "sense_id": "143c1384-3e99-37da-9dd8-33ed94438a42",
                                                "text": "He was fumbling in his little night-table, where he keeps his pisspot."
                                            },
                                            {
                                                "example_id": "a341eb61-1812-42e8-8e5b-cbf52a5c37ff",
                                                "sense_id": "143c1384-3e99-37da-9dd8-33ed94438a42",
                                                "text": "Upstairs, Cornelius van den Meer is calling for the pisspot to be emptied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "196c2b49-d2dc-3fe2-be96-4bd11c580191",
                                        "entry_id": "0b1c56c9-7667-3bce-b0b9-247a48f369dc",
                                        "glosses": [
                                            "A very unpleasant person, particularly a mean, nasty, or contemptible one."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d3398e8-9291-4161-b75e-b628f8cbc522",
                                                "sense_id": "196c2b49-d2dc-3fe2-be96-4bd11c580191",
                                                "text": "That ought to satisfy the pisspot sons of bitches, he thought as he transmitted his apology to the spacecraft orbiting above."
                                            },
                                            {
                                                "example_id": "723c2feb-df17-4a6a-9c06-e8b7dc7a0111",
                                                "sense_id": "196c2b49-d2dc-3fe2-be96-4bd11c580191",
                                                "text": "‘I′m sorry about your place. It′s not my doing,’ I said.\n‘Like hell it isn′t.’ Then a yellow tooth glinted behind his lip and he added, ‘You little pisspot.’"
                                            },
                                            {
                                                "example_id": "ad5cda86-5096-411c-99e2-5fa96a22bad2",
                                                "sense_id": "196c2b49-d2dc-3fe2-be96-4bd11c580191",
                                                "text": "By now a large crowd had gathered; when she learned the kid was dead a sobbing Deluvina Maxwell cursed Garrett and pounded his chest. “You pisspot!” she raged, “you sonofabitch!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c000779-fb8e-3e90-bbd3-b9d768bdaeae",
                                        "entry_id": "0b1c56c9-7667-3bce-b0b9-247a48f369dc",
                                        "glosses": [
                                            "An unpleasant or disgusting place or thing."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f729c196-7dea-498e-b12d-47f90cb3c171",
                                                "sense_id": "4c000779-fb8e-3e90-bbd3-b9d768bdaeae",
                                                "text": "He sailed it out the hatch into the harbor, then shrugged off the wrap and balanced it in his hand. “Do for wiping rags, I guess,” he muttered. “I won′t be sorry to look down on this pisspot world, though.”"
                                            },
                                            {
                                                "example_id": "a2fe8dcb-3822-4825-bde7-8bebfd11069c",
                                                "sense_id": "4c000779-fb8e-3e90-bbd3-b9d768bdaeae",
                                                "text": "It was only the pisspots of the world that made it. The most dangerous places. The unstable countries, the feudal states, the anarchic backwaters, places you wouldn′t dare walk out the door without a gun, where bodyguards were fashion accessories—those places did a lot better in the end."
                                            },
                                            {
                                                "example_id": "91e226dd-1783-4549-99fa-8e204c60d271",
                                                "sense_id": "4c000779-fb8e-3e90-bbd3-b9d768bdaeae",
                                                "text": "“It should have been you who threw the feast, to welcome me back,” Ramsay complained, “and it should have been in Barrow Hall, not this pisspot of a castle.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6b4a9da-7eb8-3c89-b788-e05447723103",
                                        "entry_id": "0b1c56c9-7667-3bce-b0b9-247a48f369dc",
                                        "glosses": [
                                            "A large quantity."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f4ae74d-fb1e-479f-bb73-3edbf33aa2b7",
                                                "sense_id": "b6b4a9da-7eb8-3c89-b788-e05447723103",
                                                "text": "“Damned successful. In fact, I have made a veritable pisspot of money.”"
                                            },
                                            {
                                                "example_id": "6f9c0b4b-0fda-408e-bd30-7cf590391471",
                                                "sense_id": "b6b4a9da-7eb8-3c89-b788-e05447723103",
                                                "text": "“A whole colony?” Lightnin′ Jim swallowed. “That′ll cost you a whole pisspot of loot, Princess.”"
                                            },
                                            {
                                                "example_id": "5a11ab19-1f2a-4311-82c4-9eade2bdf3ff",
                                                "sense_id": "b6b4a9da-7eb8-3c89-b788-e05447723103",
                                                "text": "The shipowners are pissed off and will need a pisspot of money thrown at them to go away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edb28cc5-350e-3886-969b-1d3b8b7b67b4",
                                        "entry_id": "0b1c56c9-7667-3bce-b0b9-247a48f369dc",
                                        "glosses": [
                                            "A consumer of large quantities of alcohol; a drunkard."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "derogatory",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9211326d-aa5b-4d4e-96ca-fdfc5a3794fb",
                                                "sense_id": "edb28cc5-350e-3886-969b-1d3b8b7b67b4",
                                                "text": "“Today my son said to me, ‘You're a pisspot, dad, a bloody pisspot.’ You know what that Australian word ‘pisspot’ means, Kapetan Nikola? A ‘metho’, a drunkard. He called me, his own father, a ‘metho’...”"
                                            },
                                            {
                                                "example_id": "f3d9fcfa-8c72-4380-814f-89a48b7600c5",
                                                "sense_id": "edb28cc5-350e-3886-969b-1d3b8b7b67b4",
                                                "text": "I would get indignant at magazine articles that characterised Australia as a nation of pisspots. I remember one in particular because I was nearly inspired to write a letter to the editor. ‘Australians,’ claimed the journalist, ‘drank until they threw up on their shoes.’ And then I realised there was a good deal of truth in all this. Quite a few Australians do drink until they throw up on their shoes. I have done it myself."
                                            },
                                            {
                                                "example_id": "c7274592-ab5a-4253-b43e-a561dcf0d41e",
                                                "sense_id": "edb28cc5-350e-3886-969b-1d3b8b7b67b4",
                                                "text": "I mean, the bastard was an absolute bloody pisspot. The prick got the sack later anyway, for being drunk on the job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd8f979a-3d49-3a43-aa29-1bfa50880737",
                                        "entry_id": "0b1c56c9-7667-3bce-b0b9-247a48f369dc",
                                        "glosses": [
                                            "A doctor."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
