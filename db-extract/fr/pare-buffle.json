                                                "example_id": "aff84635-bd79-4d52-9625-b4c9ffeb5632",
                                                "sense_id": "b1644aad-4f47-3f13-a307-da1f12c48f71",
                                                "text": "„Das Bundesverkehrsministerium plant ein Verbot alter Frontschutzbügel – rund 600.000 Geländewagen droht der Entzug ihrer bisherigen Betriebserlaubnis.“"
                                            },
                                            {
                                                "example_id": "6ae39ec1-e30a-463b-a684-9ae7d48ed46b",
                                                "sense_id": "b1644aad-4f47-3f13-a307-da1f12c48f71",
                                                "text": "„Um so bedenklicher ist die Tatsache, dass Fahrzeuge aus rein optischen Gründen nachträglich mit sogenannten Frontschutzbügeln ausgerüstet werden, die bei einem Unfall eine erhebliche Gefahr für andere Verkehrsteilnehmer darstellen.“"
                                            }
                                        ],
