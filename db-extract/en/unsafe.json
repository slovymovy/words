                "senses": [
                    {
                        "sense_id": "0125e756-4094-3fd0-b59b-d6c1b213bb64",
                        "entry_id": "7783cef7-eafe-3619-8707-f113862182c4",
                        "glosses": [
                            "Not safe (various senses); dangerous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c2c2539-4462-47d7-bd57-35883e117ede",
                                "sense_id": "0125e756-4094-3fd0-b59b-d6c1b213bb64",
                                "text": "For much the same reasons that safe languages are preferred over unsafe languages, these powerful---but unsafe---capabilities in Java should be restricted."
                            },
                            {
                                "example_id": "4d588985-221c-4b96-90a2-6d4a9ec83e2f",
                                "sense_id": "0125e756-4094-3fd0-b59b-d6c1b213bb64",
                                "text": "\"RMT has made it clear that our members have a right to refuse to work in unsafe conditions, and the union will be closely monitoring the situation. [...]\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "915c6009-e2fc-4065-8a35-d40c7795d2bc",
                        "source_entry_id": "7783cef7-eafe-3619-8707-f113862182c4",
                        "source_sense_id": "0125e756-4094-3fd0-b59b-d6c1b213bb64",
                        "source_sense_description": "not safe",
                        "target_lang_word": "onveilig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onveilig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f307ab4d-4d5c-387f-9e12-54236e46a3d6",
                                        "entry_id": "70e6b767-fa38-3a4c-9f6c-13eb11e81a88",
                                        "glosses": [
                                            "gevaar met zich meebrengend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1858aa93-1bc5-4925-9def-0bd19d25a062",
                                                "sense_id": "f307ab4d-4d5c-387f-9e12-54236e46a3d6",
                                                "text": "Het hotel was erg mooi, maar wel in een onveilige buurt."
                                            },
                                            {
                                                "example_id": "89f38a2b-3674-464a-a33f-d0e7fd7d8cd3",
                                                "sense_id": "f307ab4d-4d5c-387f-9e12-54236e46a3d6",
                                                "text": "Het X-gebouw van hogeschool Windesheim is onveilig. De vloer moet verstevigd worden. Daarom blijft het gebouw de rest van het studiejaar dicht. Vermoedelijk kan het in de zomer van 2018 weer open."
                                            },
                                            {
                                                "example_id": "f830e871-c98c-49eb-92e0-dc5c99ac05be",
                                                "sense_id": "f307ab4d-4d5c-387f-9e12-54236e46a3d6",
                                                "text": "Zo staat het er dus voor met het land of the free: een land-in-revolutie dat afglijdt naar een politiestaat, onder leiding van machtsdronken bruten die zelf roekeloos soldaatje spelen op onveilige sociale media."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0e8170b-75b9-472e-854f-cb001751a775",
                        "source_entry_id": "7783cef7-eafe-3619-8707-f113862182c4",
                        "source_sense_id": "0125e756-4094-3fd0-b59b-d6c1b213bb64",
                        "source_sense_description": "not safe",
                        "target_lang_word": "dangereux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dangereux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe4e2c67-9486-32fc-aa50-44d3b2b4b13c",
                                        "entry_id": "933d8a62-c381-3f68-8eba-1d83f4738ba1",
                                        "glosses": [
                                            "Qui met en danger, qui expose à un danger ; ou simplement, qui est nuisible, pernicieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c5a902-afdc-440a-a8c5-5e8e33e3c7c1",
                                                "sense_id": "fe4e2c67-9486-32fc-aa50-44d3b2b4b13c",
                                                "text": "La recherche de micro-polluants organiques dangereux s’inscrit dans le concept de développement durable conciliant la protection de l’environnement et le développement économique."
                                            },
                                            {
                                                "example_id": "276d7c30-1485-4a0d-9b0b-172f39d053ea",
                                                "sense_id": "fe4e2c67-9486-32fc-aa50-44d3b2b4b13c",
                                                "text": "Des repaires dangereux existaient où la police n’osait s’aventurer."
                                            },
                                            {
                                                "example_id": "c9a123e7-1edf-4fb1-9782-3224cebe62e6",
                                                "sense_id": "fe4e2c67-9486-32fc-aa50-44d3b2b4b13c",
                                                "text": "Nous parlons sans ménagement de cette paix qui fut jusque-là la seule dangereuse, des deux ou trois camarades communs qu'elle a fait périr."
                                            },
                                            {
                                                "example_id": "2b8906e1-13cf-40fc-ae37-b2d9723cda07",
                                                "sense_id": "fe4e2c67-9486-32fc-aa50-44d3b2b4b13c",
                                                "text": "Sur Twitter, le professeur en médecine interne Josh Barocas, dans le Colorado, a critiqué l’attitude dangereuse du chef d’État, qu’il a même qualifiée de « préjudiciable »."
                                            },
                                            {
                                                "example_id": "6ce235e7-3695-46cb-9aa2-8677e4c7fcc2",
                                                "sense_id": "fe4e2c67-9486-32fc-aa50-44d3b2b4b13c",
                                                "text": "En Europe, au Moyen Âge, on donnait à l’aubergine le nom de malum insanum, ou « pomme de la folie », car, disait-on, elle était dangereuse pour la santé mentale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba1c07d9-50d1-3bb1-b991-c18583a297ac",
                                        "entry_id": "933d8a62-c381-3f68-8eba-1d83f4738ba1",
                                        "glosses": [
                                            "Qui a les moyens de nuire, ou à qui l’on ne peut se fier sans danger, avec lequel il y a danger à se lier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "115da2c5-db73-4a3e-bc14-c5889267cb8a",
                                                "sense_id": "ba1c07d9-50d1-3bb1-b991-c18583a297ac",
                                                "text": "Une presse complaisante jusqu’à la servilité répandait dans le public, depuis les salons jusqu'aux mansardes, les idées les plus fausses et les plus dangereuses."
                                            },
                                            {
                                                "example_id": "67e691f4-1482-49a6-a868-d5590f39af37",
                                                "sense_id": "ba1c07d9-50d1-3bb1-b991-c18583a297ac",
                                                "text": "Un ennemi dangereux."
                                            },
                                            {
                                                "example_id": "c75084b4-b4fe-4c80-a19c-cf2c7da424f8",
                                                "sense_id": "ba1c07d9-50d1-3bb1-b991-c18583a297ac",
                                                "text": "Un dangereux malfaiteur."
                                            },
                                            {
                                                "example_id": "5fa5166e-11b8-4af8-ab39-be37b3171e5a",
                                                "sense_id": "ba1c07d9-50d1-3bb1-b991-c18583a297ac",
                                                "text": "C’est une coquette fort dangereuse."
                                            },
                                            {
                                                "example_id": "009b9f32-e79c-4cac-9464-33181ee71524",
                                                "sense_id": "ba1c07d9-50d1-3bb1-b991-c18583a297ac",
                                                "text": "C’est un dangereux séducteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5374033b-9c43-4aa3-ad9a-8c407d526a92",
                        "source_entry_id": "7783cef7-eafe-3619-8707-f113862182c4",
