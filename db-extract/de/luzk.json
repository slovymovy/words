                "senses": [
                    {
                        "sense_id": "efa45141-a978-3e9a-8ac7-31baf4b64091",
                        "entry_id": "4f256ed2-02ce-3f02-b917-9f9ab5043b3a",
                        "glosses": [
                            "Stadt im Nordwesten der Ukraine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23b40740-7e84-417c-94d8-85f380b0c43a",
                                "sense_id": "efa45141-a978-3e9a-8ac7-31baf4b64091",
                                "text": "Er lebte seit zehn Jahren in Luzk."
                            },
                            {
                                "example_id": "ce244a91-179e-49b3-b97d-687fa024ba4c",
                                "sense_id": "efa45141-a978-3e9a-8ac7-31baf4b64091",
                                "text": "„Von dort aus betrat der Sekretär der Gesandtschaft bei seiner Rückkehr die Kathedrale von Luzk.“"
                            },
                            {
                                "example_id": "e6d45583-51b7-4ef2-ab08-d9e942835acb",
                                "sense_id": "efa45141-a978-3e9a-8ac7-31baf4b64091",
                                "text": "„In ihrer wechselvollen Geschichte gehörte Luzk zu Polen, Russland oder der Ukraine, war auch mal deutsch besetzt.“"
                            },
                            {
                                "example_id": "75d9ac52-1ffa-41ca-86e5-57bf70d93b77",
                                "sense_id": "efa45141-a978-3e9a-8ac7-31baf4b64091",
                                "text": "„So stellt sich heraus, dass der Großvater, der immer behauptet hatte, aus Odessa zu stammen, tatsächlich selbst der Gegend von Luzk kommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
