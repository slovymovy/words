                "senses": [
                    {
                        "sense_id": "696bb405-30d1-3946-bcf8-777a1186920e",
                        "entry_id": "ce3cc08b-85bb-32b2-9acd-57894853656f",
                        "glosses": [
                            "eine (elektrische) Spannung, die durch (elektromagnetische) Induktion hervorgerufen wurde"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "9d584d47-bd8c-4244-a693-00523a4d97f2",
                                "sense_id": "696bb405-30d1-3946-bcf8-777a1186920e",
                                "text": "„Bei der durch Induktion entstehenden elektrischen Spannung handelt es sich um eine sogenannte Umlaufspannung oder Induktionsspannung.“"
                            },
                            {
                                "example_id": "201c5160-b007-4c42-920f-abc5254020db",
                                "sense_id": "696bb405-30d1-3946-bcf8-777a1186920e",
                                "text": "„Ersetzt man den Leiter durch eine Spule mit n Windungen, dann addieren sich die Induktionsspannungen aller Windungen. […] Eine Induktionsspannung tritt nur bei Änderung des magnetischen Flusses auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
