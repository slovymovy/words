                "senses": [
                    {
                        "sense_id": "df5478eb-6731-3c38-8a0a-c5adf6c2f0cd",
                        "entry_id": "e4e01efd-c608-3f3b-a8c6-55f4739f52e3",
                        "glosses": [
                            "Person, die Satiren verfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d6caef3-784b-4860-85c5-eb0c9bedaa57",
                                "sense_id": "df5478eb-6731-3c38-8a0a-c5adf6c2f0cd",
                                "text": "„Doch London war mit eigenen Satirikern gut versorgt und brauchte keine Importe aus Bristol.“"
                            },
                            {
                                "example_id": "6c3c7b23-f956-4b04-b052-06ea6b24e8c4",
                                "sense_id": "df5478eb-6731-3c38-8a0a-c5adf6c2f0cd",
                                "text": "„Er ist Satiriker, aber kein Moralist und noch weniger Sittenrichter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
