{
    "word_family": [
        "фамильный",
        "однофамилец"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "337da11c-ffef-3b8c-98ff-1ac1a6b602ef",
                    "sense_definition": "Наследственное родовое имя, которое добавляется к личному имени человека и указывает на его принадлежность к определённой семье.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "name_identity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Напишите, пожалуйста, ваше имя и <w>фамилию</w> в анкете.",
                            "target_lang_translations": {
                                "en": "Please write your first name and <w>surname</w> on the form.",
                                "de": "Bitte schreiben Sie Ihren Vornamen und Ihren <w>Nachnamen</w> in den Fragebogen."
                            }
                        },
                        {
                            "text": "Её девичья <w>фамилия</w> была слишком сложной для произношения.",
                            "target_lang_translations": {
                                "en": "Her maiden <w>name</w> was too difficult to pronounce.",
                                "de": "Ihr Mädchen<w>name</w> war zu schwer auszusprechen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "девичья фамилия",
                        "имя и фамилия",
                        "сменить фамилию",
                        "носить фамилию"
                    ],
                    "target_lang_definitions": {
                        "en": "A hereditary name shared by all members of a family, usually written after the first name.",
                        "de": "Erblicher Name, der zusätzlich zum Vornamen geführt wird und die Zugehörigkeit zu einer Familie bezeichnet."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "surname",
                                "target_lang_sense_clarification": "standard/formal"
                            },
                            {
                                "target_lang_word": "last name",
                                "target_lang_sense_clarification": "common, especially in US English"
                            },
                            {
                                "target_lang_word": "family name",
                                "target_lang_sense_clarification": "formal"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Nachname",
                                "target_lang_sense_clarification": "alltäglich und gebräuchlich"
                            },
                            {
                                "target_lang_word": "Familienname",
                                "target_lang_sense_clarification": "offiziell und amtlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "666bc165-5df6-3c77-81eb-0740b0dbaff0",
                    "sense_definition": "Ряд поколений, происходящих от одного предка; то же, что род.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lineage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он происходил из старинной дворянской <w>фамилии</w>, известной своими военными заслугами.",
                            "target_lang_translations": {
                                "en": "He came from an ancient noble <w>family</w>, known for its military achievements.",
                                "de": "Er stammte aus einem alten adligen <w>Geschlecht</w>, das für seine militärischen Verdienste bekannt war."
                            }
                        },
                        {
                            "text": "Эта купеческая <w>фамилия</w> владела заводами по всей стране.",
                            "target_lang_translations": {
                                "en": "This merchant <w>family</w> owned factories across the country.",
                                "de": "Diese Kaufmanns<w>familie</w> besaß Fabriken im ganzen Land."
                            }
                        }
                    ],
                    "synonyms": [
                        "род",
                        "клан"
                    ],
                    "common_phrases": [
                        "древняя фамилия",
                        "знатная фамилия",
                        "дворянская фамилия"
                    ],
                    "target_lang_definitions": {
                        "en": "A line of ancestors and descendants; a dynasty or noble house.",
                        "de": "Folge von Generationen, die von denselben Vorfahren abstammen; Geschlecht oder Dynastie."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "family",
                                "target_lang_sense_clarification": "lineage or dynasty"
                            },
                            {
                                "target_lang_word": "house",
                                "target_lang_sense_clarification": "noble dynasty"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Geschlecht",
                                "target_lang_sense_clarification": "Adels- oder Abstammungslinie"
                            },
                            {
                                "target_lang_word": "Haus",
                                "target_lang_sense_clarification": "Herrscher- oder Adelsgeschlecht"
                            },
                            {
                                "target_lang_word": "Familie",
                                "target_lang_sense_clarification": "im Sinne von Dynastie oder Stammbaum"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86a27a35-a5ac-33ff-bb06-9decffc037cf",
                    "sense_definition": "Семья, члены семьи, живущие вместе.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "family_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вся <w>фамилия</w> собралась на кухне, чтобы обсудить последние новости.",
                            "target_lang_translations": {
                                "en": "The whole <w>family</w> gathered in the kitchen to discuss the latest news.",
                                "de": "Die ganze <w>Familie</w> versammelte sich in der Küche, um die neuesten Nachrichten zu besprechen."
                            }
                        },
                        {
                            "text": "На праздник пригласили всю нашу многочисленную <w>фамилию</w>.",
                            "target_lang_translations": {
                                "en": "They invited our entire numerous <w>family</w> to the celebration.",
                                "de": "Zum Fest wurde unsere gesamte kinderreiche <w>Familie</w> eingeladen."
                            }
                        }
                    ],
                    "synonyms": [
                        "семья",
                        "семейство"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A group of relatives or family members living together.",
                        "de": "Gruppe zusammenlebender Verwandter; Gesamtheit der Familienmitglieder."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "family",
                                "target_lang_sense_clarification": "archaic or colloquial usage"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Familie",
                                "target_lang_sense_clarification": "Gruppe der Angehörigen"
                            },
                            {
                                "target_lang_word": "Sippe",
                                "target_lang_sense_clarification": "oft scherzhaft oder weitläufig"
                            }
                        ]
                    }
                }
            ]
        }
