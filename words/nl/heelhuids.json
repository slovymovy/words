{
    "word_family": [
        "heel",
        "huid"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0908f135-d600-32eb-ace5-8f0105e6df74",
                    "sense_definition": "zonder verwondingen of schade te hebben opgelopen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ongedeerd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bergbeklimmers kwamen na een zware storm gelukkig <w>heelhuids</w> weer thuis.",
                            "target_lang_translations": {
                                "en": "Fortunately, the mountaineers returned home <w>safe and sound</w> after a severe storm."
                            }
                        },
                        {
                            "text": "Het is een wonder dat hij <w>heelhuids</w> is ontsnapt aan dat ernstige auto-ongeluk.",
                            "target_lang_translations": {
                                "en": "It is a miracle that he escaped <w>unscathed</w> from that serious car accident."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongedeerd",
                        "zonder kleerscheuren"
                    ],
                    "antonyms": [
                        "gewond"
                    ],
                    "common_phrases": [
                        "heelhuids thuiskomen",
                        "heelhuids ontsnappen"
                    ],
                    "target_lang_definitions": {
                        "en": "without having sustained any injuries or damage; safely and in one piece"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unharmed",
                                "target_lang_sense_clarification": "without suffering any injury or damage"
                            },
                            {
                                "target_lang_word": "unscathed",
                                "target_lang_sense_clarification": "without suffering any injury or harm, especially after a dangerous situation"
                            },
                            {
                                "target_lang_word": "in one piece",
                                "target_lang_sense_clarification": "safely, without being injured or damaged"
                            },
                            {
                                "target_lang_word": "safe and sound",
                                "target_lang_sense_clarification": "completely safe and uninjured"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1e14f117-57a1-3665-970a-30d434f67a11",
                    "sense_definition": "ongeschonden en niet gewond",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ongedeerd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de aardbeving bleek het historische gebouw gelukkig nog volledig <w>heelhuids</w> te zijn.",
                            "target_lang_translations": {
                                "en": "After the earthquake, the historic building fortunately turned out to be completely <w>intact</w>."
                            }
                        },
                        {
                            "text": "Zij kwamen als door een wonder <w>heelhuids</w> uit de brandende auto.",
                            "target_lang_translations": {
                                "en": "As if by a miracle, they got out of the burning car <w>unharmed</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongedeerd"
                    ],
                    "antonyms": [
                        "beschadigd",
                        "gewond"
                    ],
                    "common_phrases": [
                        "heelhuids overkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "undamaged and not injured; intact"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intact",
                                "target_lang_sense_clarification": "not damaged or impaired in any way; complete"
                            },
                            {
                                "target_lang_word": "unharmed",
                                "target_lang_sense_clarification": "not injured or hurt"
                            },
                            {
                                "target_lang_word": "undamaged",
                                "target_lang_sense_clarification": "not harmed or broken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}