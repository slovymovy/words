                        "examples": [
                            {
                                "example_id": "9cb0ee42-03d4-437d-b6e6-d932c5a66ac1",
                                "sense_id": "b05f1590-3197-3b46-a40d-7a4597ef8c65",
                                "text": "Wat vinden ze van hem? Hoe zouden ze reageren als ik zou zeggen dat deze gids met zijn verhalen mijn nieuwe liefde is? 'Dus na uren tevergeefs jagen op de inktvis die we aan onze moeders hadden beloofd, zwemt er ineens een murene voor ons langs."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a5049cf-9981-3268-9115-81b0453f5a52",
                        "entry_id": "4b9fe51a-c0af-38bb-bb3f-887503be1c2b",
                        "glosses": [
