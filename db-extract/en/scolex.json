                                                "sense_id": "a38a42ff-109c-3e82-8f38-3367de5a4755",
                                                "text": "W warzywniaku dostałem piękną główkę kapusty."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "d33211cb-830d-3aed-bb49-c4c4f3b7cd25",
