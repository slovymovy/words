{
    "word_family": [
        "Iberia",
        "Ibero-American"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b1f17e0d-a4b1-3d68-b370-2831b33e7ff6",
                    "sense_definition": "Of, relating to, or characteristic of the Iberian Peninsula, its people, or its culture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "iberian_peninsula_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many unique animal species live exclusively on the <w>Iberian</w> Peninsula.",
                            "target_lang_translations": {
                                "ru": "Многие уникальные виды животных обитают исключительно на <w>Пиренейском</w> полуострове."
                            }
                        },
                        {
                            "text": "The museum features an impressive exhibition on <w>Iberian</w> history and architecture.",
                            "target_lang_translations": {
                                "ru": "В музее представлена впечатляющая выставка, посвященная <w>иберийской</w> истории и архитектуре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Iberian Peninsula",
                        "Iberian lynx",
                        "Iberian ham"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Пиренейскому (Иберийскому) полуострову, его народам или культуре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иберийский",
                                "target_lang_sense_clarification": "относящийся к Иберии"
                            },
                            {
                                "target_lang_word": "пиренейский",
                                "target_lang_sense_clarification": "относящийся к Пиренейскому полуострову"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c020fa4-4cec-34ec-92de-1ce3f16b06a7",
                    "sense_definition": "Native to or originating in Iberia.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "iberian_peninsula_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wild boar is an <w>Iberian</w> species found in the mountains.",
                            "target_lang_translations": {
                                "ru": "Дикий кабан — это <w>иберийский</w> вид, встречающийся в горах."
                            }
                        },
                        {
                            "text": "Archaeologists uncovered several <w>Iberian</w> artifacts dating back over two thousand years.",
                            "target_lang_translations": {
                                "ru": "Археологи обнаружили несколько <w>иберийских</w> артефактов возрастом более двух тысяч лет."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий с Пиренейского полуострова, коренной для Иберии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иберийский",
                                "target_lang_sense_clarification": "о видах животных, растениях, артефактах"
                            },
                            {
                                "target_lang_word": "пиренейский",
                                "target_lang_sense_clarification": "о фауне или флоре"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9bc38d5-c180-3341-bca5-363c2c49f8d6",
                    "sense_definition": "A native or inhabitant of the Iberian Peninsula (such as a person from Spain, Portugal, Andorra, or Gibraltar).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "iberian_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Both the Portuguese and the Spanish are modern <w>Iberians</w>.",
                            "target_lang_translations": {
                                "ru": "И португальцы, и испанцы — современные <w>иберийцы</w>."
                            }
                        },
                        {
                            "text": "As an <w>Iberian</w>, she felt deeply connected to the regional music of the peninsula.",
                            "target_lang_translations": {
                                "ru": "Как <w>иберийка</w>, она чувствовала глубокую связь с региональной музыкой полуострова."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уроженец или житель Пиренейского полуострова (например, испанец или португалец)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ибериец",
                                "target_lang_sense_clarification": "житель Иберии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "159e0b6b-82a8-32f5-9b96-dba1f2425646",
                    "sense_definition": "A member of an ancient pre-Roman people who inhabited the eastern and southern parts of the Iberian Peninsula.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ancient_iberian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>Iberians</w> traded extensively with Phoenicians and Greeks.",
                            "target_lang_translations": {
                                "ru": "Древние <w>иберы</w> вели активную торговлю с финикийцами и греками."
                            }
                        },
                        {
                            "text": "Roman historians wrote detailed accounts about the tribes of the ancient <w>Iberians</w>.",
                            "target_lang_translations": {
                                "ru": "Римские историки оставили подробные описания племен древних <w>иберов</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ancient Iberians"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель древних доримских племен, населявших восточную и южную части Пиренейского полуострова."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ибер",
                                "target_lang_sense_clarification": "древний житель Испании"
                            },
                            {
                                "target_lang_word": "ибериец",
                                "target_lang_sense_clarification": "представитель древних иберов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a4592c8-cf73-3e09-beec-0bd55522a64b",
                    "sense_definition": "An inhabitant of Caucasian Iberia, an ancient kingdom located in what is now Georgia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historians study the ties between the Caucasian <w>Iberians</w> and the Persian Empire.",
                            "target_lang_translations": {
                                "ru": "Историки изучают связи кавказских <w>иберов</w> с Персидской империей."
                            }
                        },
                        {
                            "text": "The early medieval chronicler wrote about the conversion of the <w>Iberians</w> to Christianity.",
                            "target_lang_translations": {
                                "ru": "Раннесредневековый летописец писал о крещении <w>иверов</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Georgian"
                    ],
                    "common_phrases": [
                        "Caucasian Iberians"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to ancient Caucasian Iberia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Житель древней Кавказской Иберии (Иверии, исторической области на территории современной Грузии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ивер",
                                "target_lang_sense_clarification": "житель Кавказской Иверии"
                            },
                            {
                                "target_lang_word": "ибериец",
                                "target_lang_sense_clarification": "житель Кавказской Иберии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "49fc2534-abdf-387b-b577-3771c4e1c57d",
                    "sense_definition": "An extinct language isolate that was spoken in the eastern and southern parts of the Iberian Peninsula before Roman conquest.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "Linguists are still attempting to fully decipher the inscriptions written in <w>Iberian</w>.",
                            "target_lang_translations": {
                                "ru": "Лингвисты всё ещё пытаются полностью расшифровать надписи, сделанные на <w>иберском языке</w>."
                            }
                        },
                        {
                            "text": "Before the spread of Latin, <w>Iberian</w> was widely spoken along the coast.",
                            "target_lang_translations": {
                                "ru": "До распространения латыни на <w>иберском языке</w> широко говорили вдоль побережья."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вымерший изолированный язык, на котором говорили жители восточной и южной частей Пиренейского полуострова до римского завоевания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иберский язык",
                                "target_lang_sense_clarification": "язык древних иберов"
                            },
                            {
                                "target_lang_word": "иберийский язык",
                                "target_lang_sense_clarification": "древний язык Пиренейского полуострова"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}