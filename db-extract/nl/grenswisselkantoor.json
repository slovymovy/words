                "senses": [
                    {
                        "sense_id": "eaacbf16-5672-302b-9543-df65fe1ebe21",
                        "entry_id": "5c2ecbc7-69a4-33b1-8dc3-defa24b8303e",
                        "glosses": [
                            "kantoor aan de grens van een land waarbij men geld van de ene naar de andere valuta kan wisselen; tevens de naam van een bedrijf die deze dienst levert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fd51175-cc6b-4816-927e-ffd33e1e9f49",
                                "sense_id": "eaacbf16-5672-302b-9543-df65fe1ebe21",
                                "text": "In Zwolle is een man aangehouden die 100.000 D-mark wilde wisselen voor 50.000 euro's. Het Grenswisselkantoor kreeg argwaan omdat zelden zo'n groot bedrag wordt aangeboden en besloot de biljetten onder de loep te nemen."
                            },
                            {
                                "example_id": "364fc159-d4de-433b-992c-1b95d9c89e6d",
                                "sense_id": "eaacbf16-5672-302b-9543-df65fe1ebe21",
                                "text": "Oekraïense vluchtelingen kunnen vanaf vandaag kosteloos hun contante hryvnia's wisselen voor euro's. Ze kunnen daarvoor terecht bij wisselkantoren van GWK Travelex (het voormalige Grenswisselkantoor). De Nederlandsche Bank (DNB) zal de Oekraïense biljetten opkopen van het wisselbedrijf."
                            }
                        ]
                    }
