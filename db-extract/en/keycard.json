                    {
                        "translation_id": "4f0e75ac-a849-4b68-9b59-1bff27acb330",
                        "source_entry_id": "f0815a13-523d-3fee-ab2c-46bf97f0522c",
                        "source_sense_id": "778a82cf-5ac0-30da-81a1-7f0c64d319de",
                        "source_sense_description": "plastic card",
                        "target_lang_word": "Schlüsselkarte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlüsselkarte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89da0720-1048-3b8c-bf04-5c45b8fb1c44",
                                        "entry_id": "422517bf-580a-3c0b-a14d-48a60870a627",
                                        "glosses": [
                                            "mit einem Chip versehene Karte, mit der man eine Tür elektronisch entriegeln kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eca0599b-5d0a-4e57-8ccf-3fb7c748aff5",
                                                "sense_id": "89da0720-1048-3b8c-bf04-5c45b8fb1c44",
                                                "text": "„An der Rezeption bekam ich die Schlüsselkarte, die 408.“"
                                            },
                                            {
                                                "example_id": "669d222c-6a8d-4e0f-b14a-2c79046af639",
                                                "sense_id": "89da0720-1048-3b8c-bf04-5c45b8fb1c44",
                                                "text": "„Anna Obenauf zückt die Schlüsselkarte und öffnet die Tür zu Laborraum 3-076.“"
                                            },
                                            {
                                                "example_id": "3c2d1610-0ef7-4e15-a2e7-f7a9bbe06b15",
                                                "sense_id": "89da0720-1048-3b8c-bf04-5c45b8fb1c44",
                                                "text": "„Sie reichte mir die Schlüsselkarte, warf einen Blick auf meinen Mantel, fragte sich vielleicht, woher der stammte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f06d6d19-ff6a-42c4-8534-524baebc6dcd",
                        "source_entry_id": "f0815a13-523d-3fee-ab2c-46bf97f0522c",
                        "source_sense_id": "778a82cf-5ac0-30da-81a1-7f0c64d319de",
                        "source_sense_description": "plastic card",
                        "target_lang_word": "Pass",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pass",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd2f1a7c-68c7-35e8-b1f4-7288cce2781a",
                                        "entry_id": "74c9fe9f-806a-3df4-a576-81c651b89037",
                                        "glosses": [
                                            "Dokument, das für Auslandsreisen erforderlich ist, falls es zwischen dem Heimatland und dem Zielland keine Sondervereinbarungen gibt; Reisepass"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0ebedc6-967e-4c88-b25d-01595d1b9c60",
                                                "sense_id": "bd2f1a7c-68c7-35e8-b1f4-7288cce2781a",
                                                "text": "Für die Reise benötigen wir einen Pass."
                                            },
                                            {
                                                "example_id": "95db4a84-ec54-4ee5-a1a1-9313221cdde6",
                                                "sense_id": "bd2f1a7c-68c7-35e8-b1f4-7288cce2781a",
                                                "text": "„Jeder schwarze Arbeiter muss ständig einen Pass bei sich tragen.“"
                                            },
                                            {
                                                "example_id": "f5ab41ba-184e-4fe1-8745-28726178de27",
                                                "sense_id": "bd2f1a7c-68c7-35e8-b1f4-7288cce2781a",
                                                "text": "„Als Alek von Polycarp den Pass erhielt, sah sie, dass sie tatsächlich umgetauft worden war.“"
                                            },
                                            {
                                                "example_id": "22cd6073-e16b-44dd-9da0-67cf9802130b",
                                                "sense_id": "bd2f1a7c-68c7-35e8-b1f4-7288cce2781a",
                                                "text": "„Grenfeld lief nach oben, steckte den Pass ein und öffnete das Fenster.“"
                                            },
                                            {
                                                "example_id": "fc0f3f62-8b93-4598-9ac7-af0574d2e7c1",
                                                "sense_id": "bd2f1a7c-68c7-35e8-b1f4-7288cce2781a",
                                                "text": "„Wir sehen ihr nach, sehen, wie sie ihren Pass auf den Tresen legt, nach der Kontrolle wieder in der Handtasche verstaut und über eine Rolltreppe nach oben aus unserem Blickfeld verschwindet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb9fda3f-3627-3520-ac76-76c9ea57e816",
                                        "entry_id": "74c9fe9f-806a-3df4-a576-81c651b89037",
                                        "glosses": [
                                            "tiefergelegener Übergang durch ein Gebirge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2589ec7-4019-4c70-94d9-9a345bbcb460",
                                                "sense_id": "cb9fda3f-3627-3520-ac76-76c9ea57e816",
                                                "text": "Den Pass kann man nicht bei jedem Wetter befahren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9b0ba25a-d613-3715-a905-e9a31e9782c7",
                                        "entry_id": "74c9fe9f-806a-3df4-a576-81c651b89037",
                                        "glosses": [
                                            "enge Stelle eines Tales"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fcbd8d1-1edf-40fe-9d45-579e0d074f8d",
                                                "sense_id": "9b0ba25a-d613-3715-a905-e9a31e9782c7",
                                                "text": "„Der Finstermünzpass ist eine Engstelle der Reschenstraße beim Sperrfort Nauders im Bezirk Landeck, Tirol. Bei dieser Engstelle handelt es sich nicht um einen Pass im eigentlichen Wortsinn, da die bezeichnete Stelle weder eine Wasserscheide, noch eine Straßen- oder Weghöhe ist, von der das jenseitige Terrain abwärts führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8d58831f-c8e9-3a10-88eb-b214410d53e2",
                                        "entry_id": "74c9fe9f-806a-3df4-a576-81c651b89037",
                                        "glosses": [
                                            "Gangart von Vierbeinern, die sich aus der abwechselnden Bewegung der Beinpaare bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae3d3c24-7542-4a0c-a134-03bb01c92098",
                                                "sense_id": "8d58831f-c8e9-3a10-88eb-b214410d53e2",
                                                "text": "Der Isländer geht einen sauberen Pass."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4dafb98f-30e3-39b3-b8b5-ead47d37bbe7",
                                        "entry_id": "74c9fe9f-806a-3df4-a576-81c651b89037",
                                        "glosses": [
                                            "gezielte Ballabgabe an einen Spieler der eigenen Mannschaft"
                                        ],
                                        "tags": [
                                            "Spiel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceab9be9-d817-4110-9a7e-d0a88e44a198",
                                                "sense_id": "4dafb98f-30e3-39b3-b8b5-ead47d37bbe7",
                                                "text": "Er übergab den Ball mit einem langen Pass an seinen Mitspieler."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "be40d860-c690-3b7f-bfd4-e31b745626e5",
                                        "entry_id": "74c9fe9f-806a-3df4-a576-81c651b89037",
                                        "glosses": [
                                            "eine aus mehreren Kreisbögen bestehende Figur der Gotik"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e30971b-b025-4243-8b51-3b04f86da886",
                                                "sense_id": "be40d860-c690-3b7f-bfd4-e31b745626e5",
                                                "text": "Wichtiges Element ist zunächst der Pass, ein mit dem Zirkel konstruiertes Bauornament, das aus Dreiviertelkreisen besteht."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "184fb279-adc2-3298-b539-b10ad20669c6",
                                        "entry_id": "74c9fe9f-806a-3df4-a576-81c651b89037",
                                        "glosses": [
                                            "von niederem Haarwild ausgetretener Pfad"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bcd2a53-43a7-4138-aa4c-825358db86c7",
                                                "sense_id": "184fb279-adc2-3298-b539-b10ad20669c6",
                                                "text": "Wir sahen den Pass, den ziemlich ausgetretenen Weg, den der Dachs immer nimmt."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
