{
    "word_family": [
        "refrigerator",
        "refrigerate",
        "refrigeration",
        "refrigerant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "947a7f24-cd85-36f9-ba67-88ad2fc10ca3",
                    "sense_definition": "A large electric cupboard used for keeping food and drinks cold; a <w>refrigerator</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kitchen_appliances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put the milk back in the <w>fridge</w> after you use it.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убери молоко обратно в <w>холодильник</w> после использования."
                            }
                        },
                        {
                            "text": "I need to buy a new <w>fridge</w> because the old one is not cold enough.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить новый <w>холодильник</w>, потому что старый недостаточно холодный."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stock the fridge",
                        "empty the fridge",
                        "open the fridge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой электрический шкаф, используемый для хранения продуктов и напитков в холоде; холодильник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодильник",
                                "target_lang_sense_clarification": "бытовой прибор"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "774783de-944c-35fd-8826-bfcd027dcea3",
                    "sense_definition": "To place something inside a refrigerator to chill; to <w>refrigerate</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cooling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should have <w>fridged</w> the soda if you wanted it to be cold for the party.",
                            "target_lang_translations": {
                                "ru": "Тебе следовало <w>охладить</w> газировку, если ты хотел, чтобы она была холодной к вечеринке."
                            }
                        },
                        {
                            "text": "The recipe says to leave the dough <w>fridged</w> for at least two hours before baking.",
                            "target_lang_translations": {
                                "ru": "В рецепте сказано оставить тесто <w>охлаждаться</w> в холодильнике минимум на два часа перед выпечкой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fridged the drinks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поместить что-либо в холодильник для охлаждения; охладить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охлаждать",
                                "target_lang_sense_clarification": "в холодильнике"
                            },
                            {
                                "target_lang_word": "положить в холодильник",
                                "target_lang_sense_clarification": "действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bde550bd-2a6d-3744-9274-bf3893c37582",
                    "sense_definition": "To kill or remove a character from a story solely to motivate or provide emotional impact for another character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "literary_tropes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fans were upset when the female lead was <w>fridged</w> just to give the hero a reason to seek revenge.",
                            "target_lang_translations": {
                                "ru": "Фанаты были расстроены, когда главную героиню <w>убили ради мотивации</w> героя, просто чтобы дать ему повод для мести."
                            }
                        },
                        {
                            "text": "The writer avoided <w>fridging</w> the supporting cast by giving them their own independent story arcs.",
                            "target_lang_translations": {
                                "ru": "Писатель избежал <w>фриджинга</w> второстепенных персонажей, дав им собственные независимые сюжетные линии."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in literary and media criticism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Убить или вывести персонажа из сюжета исключительно для того, чтобы мотивировать или вызвать эмоциональный отклик у другого персонажа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«засунуть в холодильник»",
                                "target_lang_sense_clarification": "литературный троп"
                            },
                            {
                                "target_lang_word": "фриджинг",
                                "target_lang_sense_clarification": "сленг критиков"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82ec648a-e0d8-3f25-b281-5dbfc470cd1f",
                    "sense_definition": "To rub or chafe something; to wear away by friction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "friction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant movement of the heavy rope began to <w>fridge</w> the wooden post.",
                            "target_lang_translations": {
                                "ru": "Постоянное движение тяжелой веревки начало <w>перетирать</w> деревянный столб."
                            }
                        },
                        {
                            "text": "He noticed the collar of his old coat had started to <w>fridge</w> against his neck.",
                            "target_lang_translations": {
                                "ru": "Он заметил, что воротник его старого пальто начал <w>натирать</w> шею."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тереть или натирать что-либо; изнашиваться от трения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перетирать",
                                "target_lang_sense_clarification": "трением"
                            },
                            {
                                "target_lang_word": "истирать",
                                "target_lang_sense_clarification": "поверхность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0478039b-11c4-3a30-978b-d0e0415b2b2b",
                    "sense_definition": "To move restlessly or nervously; to <w>fidget</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child began to <w>fridge</w> in his seat during the long ceremony.",
                            "target_lang_translations": {
                                "ru": "Ребенок начал <w>ерзать</w> на своем месте во время долгой церемонии."
                            }
                        },
                        {
                            "text": "Stop <w>fridging</w> around and try to stay still for the photograph.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>суетиться</w> и постарайся не двигаться для фото."
                            }
                        }
                    ],
                    "synonyms": [
                        "fidge"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспокойно или нервно двигаться; ерзать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ерзать",
                                "target_lang_sense_clarification": "беспокойно двигаться"
                            },
                            {
                                "target_lang_word": "суетиться",
                                "target_lang_sense_clarification": "нервничать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}