                ],
                "senses": [
                    {
                        "sense_id": "7140f3ec-5c44-3c42-b9a1-55af572b6fef",
                        "entry_id": "ad59b4fd-20ad-34cf-b706-6a951f9bc8dd",
                        "glosses": [
                            "Doctrine et pratiques politiques développées en France de 1940 à 1944 sous l'autorité de Philippe Pétain."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6ae50b8c-27d0-3df4-9688-d035345b32db",
                        "entry_id": "ad59b4fd-20ad-34cf-b706-6a951f9bc8dd",
                        "glosses": [
                            "Adhésion à cette doctrine ou à une doctrine semblable ; participation à ces pratiques ou à des pratiques similaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d5d6c63-deae-4fd0-abb8-f5ca14441f0b",
                                "sense_id": "6ae50b8c-27d0-3df4-9688-d035345b32db",
                                "text": "Le pétainisme de certains doit être oublié pour que la France ait assez d'ingénieurs, de généraux et de grands commis pour reprendre sa place dans le monde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a38cd0c-e494-45d0-a7a0-9d02134c3f3c",
                        "source_entry_id": "ad59b4fd-20ad-34cf-b706-6a951f9bc8dd",
                        "target_lang_word": "Pétainism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pétainism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4c91af6-9016-3b8f-befc-d515f57d19c8",
                                        "entry_id": "5d3f694e-a67c-3477-9a95-1ecc1e6532aa",
                                        "glosses": [
                                            "The political ideology associated with Philippe Pétain."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df4194ed-2ec0-4342-9ca5-497c8d0ad3a2",
                                                "sense_id": "d4c91af6-9016-3b8f-befc-d515f57d19c8",
                                                "text": "Secondly, Pétainism was identified with common sense and realism. No argument against Pétain could start from a sound basis: it was made to look absurd, and people who objected to his leadership were 'flying in the face of fact'."
                                            },
                                            {
                                                "example_id": "385ab176-c4c3-40a6-97b7-9b37c0ba1b6e",
                                                "sense_id": "d4c91af6-9016-3b8f-befc-d515f57d19c8",
                                                "text": "In such ways the favoured status of Pétainism within Nazi-Occupied Europe limped on until the Allied invasions of 1944."
                                            },
                                            {
                                                "example_id": "1c5f0452-10eb-4635-857f-f0dbb4ade9ad",
                                                "sense_id": "d4c91af6-9016-3b8f-befc-d515f57d19c8",
                                                "text": "Giraud's escape from the Koenigstein prison camp did not mark a break with Pétainism; on the contrary, it was helped by elements of the Vichy intelligence service."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
