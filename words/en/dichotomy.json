    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ecfe314c-e002-335f-ad5d-f45606922a9c",
                    "sense_definition": "A division or contrast between two things that are or are represented as being opposed or entirely different.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dichotomy</w> between the private and the public spheres is a central theme in modern political theory."
                        },
                        {
                            "text": "Many people struggle with the false <w>dichotomy</w> of choosing between a successful career and a happy family life."
                        }
                    ],
                    "synonyms": [
                        "bisection"
                    ],
                    "common_phrases": [
                        "false dichotomy",
                        "sharp dichotomy",
                        "dichotomy between"
                    ]
                },
                {
                    "sense_id": "e8dbfa60-3ff1-3aa1-9ff2-42df744f9658",
                    "sense_definition": "The division of a class or group into two mutually exclusive and exhaustive subclasses.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In formal logic, a <w>dichotomy</w> must ensure that the two categories do not overlap and cover all possibilities."
                        },
                        {
                            "text": "The researcher established a clear <w>dichotomy</w> by dividing the participants into those who exercised and those who did not."
                        }
                    ],
                    "synonyms": [
                        "partition"
                    ],
                    "common_phrases": [
                        "logical dichotomy"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ]
                },
                {
                    "sense_id": "95432156-0195-33a2-a491-aae05aa10991",
                    "sense_definition": "A repeated branching or forking into two parts, especially in the growth of plants or the arrangement of veins.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "branching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist observed a distinct vein <w>dichotomy</w> in the fossilized leaf specimen."
                        },
                        {
                            "text": "In certain species of algae, the stem grows through a process of successive <w>dichotomy</w>."
                        }
                    ],
                    "common_phrases": [
                        "vein dichotomy",
                        "point of dichotomy"
