                        "entry_id": "9e174b08-91b4-3ea7-a0c8-39a3ca97f873",
                        "glosses": [
                            "Action de visionner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e2e50d0-122a-428f-ba63-57b78f8d8737",
                                "sense_id": "54ff1128-a5a2-34db-93aa-61093f3e7551",
                                "text": "Avec ses vidéos, Samir Hocine cumule les millions de visionnages sur les réseaux sociaux."
                            },
                            {
                                "example_id": "bf4832f8-abd9-4ca1-8d9b-661e6bb299f4",
                                "sense_id": "54ff1128-a5a2-34db-93aa-61093f3e7551",
                                "text": "Il s'ouvre sur un annonceur affirmant que la programmation régulière est interrompue pour une \"soirée de visionnage très spéciale\"."
                            }
                        ]
                    }
                ],
