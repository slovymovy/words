        "nl-extract.jsonl": [
            {
                "entry_id": "6cbfa853-c393-3557-9701-ef4664757d34",
                "word": "wrakhout",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "db7432a7-1bc4-31ef-b986-50e734d3f2d0",
                        "entry_id": "6cbfa853-c393-3557-9701-ef4664757d34",
                        "glosses": [
                            "hout van een scheepswrak"
                        ],
                        "tags": [
                            "aangespoeld"
                        ],
                        "examples": [
                            {
                                "example_id": "cf453299-93a4-4793-8d4b-29e7d6097f16",
                                "sense_id": "db7432a7-1bc4-31ef-b986-50e734d3f2d0",
                                "text": "Uiteindelijk werd de bal gevonden tussen aangespoeld wrakhout op het Noorse eiland Vanna. De vinder stuurde een mail naar de Schotse club. „Jullie hebben de beste verre trap in de wereld”, schreef hij. De bal is een beetje vies, maar nog steeds bruikbaar."
                            },
                            {
                                "example_id": "ceb99a69-6129-4ba1-a5f1-5513d7f50829",
                                "sense_id": "db7432a7-1bc4-31ef-b986-50e734d3f2d0",
                                "text": "De jongen overleefde omdat hij zich kon vastklampen aan een stuk wrakhout totdat hij werd gevonden door een Spaans schip. Hij is tot nu toe de enige overlevende die uit het water is gevist."
                            }
                        ]
                    },
                    {
                        "sense_id": "d835709e-f54c-3c13-9451-23eacf7b94fb",
                        "entry_id": "6cbfa853-c393-3557-9701-ef4664757d34",
                        "glosses": [
                            "iets of iemand die zwaar beschadigd is en als iets waardeloos is weggegooid"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4aa2b3ce-93d0-4701-92cf-55925d81eccc",
                                "sense_id": "d835709e-f54c-3c13-9451-23eacf7b94fb",
                                "text": "What Maisie Knew (drama) Van de film What Maisie Knew die nu in de Nederlandse bioscopen draait, word je helaas niet echt vrolijk. In deze aangrijpende film blijkt wel dat kleine potjes grote oren hebben, maar ouders willen dat nog wel eens vergeten. Het aangrijpende echtscheidingsdrama What Maisie Knew legt het perspectief bij de 7-jarige dochter van Susanna (Julianne Moore) en Beale (Steve Coogan). Zij hoort en ziet het huwelijk van haar ouders stranden en dobbert vervolgens zelf rond als wrakhout."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd902d86-8242-4998-9a43-bf5b63d89238",
                        "source_entry_id": "6cbfa853-c393-3557-9701-ef4664757d34",
                        "source_sense_id": "db7432a7-1bc4-31ef-b986-50e734d3f2d0",
                        "target_lang_word": "wreckage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wreckage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23e748d3-2846-31d3-8992-630cd2b1c9fd",
                                        "entry_id": "c7ded2f7-a07a-3779-819f-cefdcf78e774",
                                        "glosses": [
                                            "Something wrecked, especially the remains or debris of something which has been severely damaged or destroyed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87e4cfe6-f397-40ef-b6b8-399b5298de7a",
                                                "sense_id": "23e748d3-2846-31d3-8992-630cd2b1c9fd",
                                                "text": "About three or four minutes later still an express freight on the up main line ran into the wreckage at about 35 m.p.h. Its engine also overturned and 15 more wagons were added to the mounting pile of wreckage."
                                            },
                                            {
                                                "example_id": "e7c167c9-ca8e-4ddf-a0d2-3496a63914cc",
                                                "sense_id": "23e748d3-2846-31d3-8992-630cd2b1c9fd",
                                                "text": "Explorers have found the 153-year-old wreckage of the Bay State, one the earlier propeller-driven steamships to ply the waters of the Great Lakes."
                                            },
                                            {
                                                "example_id": "21be09e8-678c-4bfb-8f4f-bb4020a0ae05",
                                                "sense_id": "23e748d3-2846-31d3-8992-630cd2b1c9fd",
                                                "text": "Typically for the 'get-on-with-it' era, the railway and military worked like demons to restore the vital rail link. The crater was rapidly filled in and the earth tamped solid, the wreckage was removed by breakdown trains, new rails and sleepers were rushed forward by willing hands, and US Army bulldozers piled in. By 2020 on the same day, both tracks were open for traffic again where there had been a gaping pit just hours before."
                                            },
                                            {
                                                "example_id": "a6a71ae1-263c-46ea-af2f-66e0e0067730",
                                                "sense_id": "23e748d3-2846-31d3-8992-630cd2b1c9fd",
                                                "text": "More recent attempts to salvage general equilibrium theory from the Sonnenschein-Mantel-Debreu wreckage have met with little success[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "349cbab0-73aa-4614-9a1e-09b7e99ea850",
                        "source_entry_id": "6cbfa853-c393-3557-9701-ef4664757d34",
                        "source_sense_id": "db7432a7-1bc4-31ef-b986-50e734d3f2d0",
                        "target_lang_word": "driftwood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "driftwood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1b52958-3d96-327e-aac2-32232c1cf390",
                                        "entry_id": "ecf769f7-fd48-3dd4-8b40-0524ca3dace1",
                                        "glosses": [
                                            "A floating piece, or pieces, of wood that drifts with the current of a body of water."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82c4c39a-a43f-4a4b-8905-ca9cfd8c1ef2",
                                                "sense_id": "c1b52958-3d96-327e-aac2-32232c1cf390",
                                                "text": "Every wave on the Atlantic was like a dead seagull dragging its driftwood artillery from horizon to horizon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4679e2c4-b771-30c3-8411-dd6300589a16",
                                        "entry_id": "ecf769f7-fd48-3dd4-8b40-0524ca3dace1",
                                        "glosses": [
                                            "Such a piece of wood that has been cast ashore."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f86f3593-061b-4ac9-8be7-1d16b61e5585",
                                                "sense_id": "4679e2c4-b771-30c3-8411-dd6300589a16",
                                                "text": "Commonly the bear makes a stand in driftwood on a bank, or on a log that has fallen into or across a stream."
                                            },
                                            {
                                                "example_id": "c3de67ff-c931-432b-a50a-bc2429c159b6",
                                                "sense_id": "4679e2c4-b771-30c3-8411-dd6300589a16",
                                                "text": "We lit a driftwood fire to help keep the mosquitoes away. It was partially successful."
                                            },
                                            {
                                                "example_id": "d09eb4bb-dec3-4567-97e9-e29f661bf416",
                                                "sense_id": "4679e2c4-b771-30c3-8411-dd6300589a16",
                                                "text": "A few unreliable-looking boats were beached there, unpainted boats built largely of gray driftwood, or so it seemed to me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce7c8aa7-a8aa-4088-baa7-65cd6dc9b5b7",
                        "source_entry_id": "6cbfa853-c393-3557-9701-ef4664757d34",
                        "source_sense_id": "db7432a7-1bc4-31ef-b986-50e734d3f2d0",
                        "target_lang_word": "debris",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debris",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1620398d-8770-34c5-b5f2-85853d5d3ee9",
                                        "entry_id": "ec1ab707-728f-319b-bb40-fa4cf13ae0a2",
                                        "glosses": [
                                            "Rubble, wreckage, scattered remains of something destroyed."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa199f89-94b5-4f90-a392-09958347b679",
                                                "sense_id": "1620398d-8770-34c5-b5f2-85853d5d3ee9",
                                                "text": "His neighbors were still ripping out debris. But Mr. Ryan, a retired bricklayer who built his house by hand 30 years ago only to lose most of it to Hurricane Sandy, was already hard at work rebuilding."
                                            },
                                            {
                                                "example_id": "3bb9cf6c-9097-4820-92c3-ffd791e7f70d",
                                                "sense_id": "1620398d-8770-34c5-b5f2-85853d5d3ee9",
                                                "text": "But signalman Bridges was never to answer driver Gimbert's desperate question. A deafening, massive blast blew the wagon to shreds, the 44 high-explosive bombs exploding like simultaneous hits from the aircraft they should have been dropped from. The station was instantly reduced to bits of debris, and the line to a huge crater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "379706f9-6687-3aae-9a5e-9548a9562a3b",
                                        "entry_id": "ec1ab707-728f-319b-bb40-fa4cf13ae0a2",
                                        "glosses": [
                                            "Litter and discarded refuse."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b61e5ce1-7f70-4442-b4b1-e4d25d3a804a",
                                                "sense_id": "379706f9-6687-3aae-9a5e-9548a9562a3b",
                                                "text": "[The researchers] noticed many of their pieces of [plastic marine] debris sported surface pits around two microns across. Such pits are about the size of a bacterial cell. Closer examination showed that some of these pits did, indeed, contain bacteria, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ea9c012-159b-3a48-b44b-069d5affc95c",
                                        "entry_id": "ec1ab707-728f-319b-bb40-fa4cf13ae0a2",
                                        "glosses": [
                                            "The ruins of a broken-down structure."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
