                ],
                "senses": [
                    {
                        "sense_id": "43df2de4-3315-3a86-843b-2af1927961b7",
                        "entry_id": "6cdd724e-246d-3294-9ca2-e0ff4421ee36",
                        "glosses": [
                            "ein von Platon beschriebenes Inselreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b11ee8e-218d-43af-8c8c-b5bf4cb1df34",
                                "sense_id": "43df2de4-3315-3a86-843b-2af1927961b7",
                                "text": "Platon beschreibt Atlantis in zwei Werken."
                            },
                            {
                                "example_id": "698c9d59-051c-44da-8fc7-2098f9c8bf9e",
                                "sense_id": "43df2de4-3315-3a86-843b-2af1927961b7",
                                "text": "„Nach einem gescheiterten Angriff auf Athen sei Atlantis schließlich um 9600 v. Chr. in Folge einer Naturkatastrophe innerhalb „eines einzigen Tages und einer unglückseligen Nacht“ untergegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dd7580d1-5e64-33b9-972e-f0ebe9307ed8",
                        "entry_id": "6cdd724e-246d-3294-9ca2-e0ff4421ee36",
                        "glosses": [
                            "ein hypothetischer Brückenkontinent im Atlantischen Ozean"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f119fbaf-0c1f-4075-871b-df0340c60632",
                                "sense_id": "dd7580d1-5e64-33b9-972e-f0ebe9307ed8",
                                "text": "Die Annahme des Brückenkontinents Atlantis zwischen Europa und Afrika auf der einen und Amerika auf der anderen Seite ist zur Erklärung der biologischen Verwandtschaft von Floren- und Faunenelementen der Alten und der Neuen Welt nach Einführung der Theorien zur Kontinentaldrift und der Plattentektonik nicht mehr notwendig."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0cd4da26-5dff-33f6-818f-8be6d7f0d834",
                        "entry_id": "6cdd724e-246d-3294-9ca2-e0ff4421ee36",
                        "glosses": [
                            "unerwartet und plötzlich untergegangene, reiche Stadt, Kultur oder Zivilisation"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "318df2ac-a450-4478-a518-ac82de93eaeb",
                                "sense_id": "0cd4da26-5dff-33f6-818f-8be6d7f0d834",
                                "text": "Ubar ist das „Atlantis der Wüste“ (T. E. Lawrence)"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "0ffb286d-83cc-341e-b506-b97448d8e0d1",
                        "entry_id": "6cdd724e-246d-3294-9ca2-e0ff4421ee36",
                        "glosses": [
                            "Stadtteil von Kapstadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "454619cd-7bc6-494d-85df-bbb9a168bd64",
                                "sense_id": "0ffb286d-83cc-341e-b506-b97448d8e0d1",
                                "text": "„In seiner Wut wechselte Fransman Dekker vom weißen Afrikaans in den Dialekt und den Rhythmus des Townships Atlantis.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48130d59-70f5-452e-ba29-ef4311cefbd6",
                        "source_entry_id": "6cdd724e-246d-3294-9ca2-e0ff4421ee36",
                        "source_sense_id": "43df2de4-3315-3a86-843b-2af1927961b7",
                        "source_sense_description": "ein von Platon beschriebenes Inselreich",
                        "target_lang_word": "Atlantis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atlantis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2023dfba-e007-30c7-882c-8d725ee36e9e",
                                        "entry_id": "9a932dbc-b585-3e59-ba82-b834cf21f651",
                                        "glosses": [
                                            "A mythical country said to have sunk into the Atlantic Ocean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e74eefa-5118-497a-92ac-f496363ebcec",
                                                "sense_id": "2023dfba-e007-30c7-882c-8d725ee36e9e",
                                                "text": "How far, since then, the ocean streams / Have swept us from that land of dreams, / That land of fiction and of truth, / The lost Atlantis of our youth!"
                                            },
                                            {
                                                "example_id": "b9b299c5-fcb7-4bda-b6ac-b8bc22e08350",
                                                "sense_id": "2023dfba-e007-30c7-882c-8d725ee36e9e",
                                                "text": "I might have drifted on for my whole life as a psychical Researcher, showing a sympathetic, but more or less dilettante attitude towards the whole subject, as if we were arguing about some impersonal thing such as the existence of Atlantis or the Baconian controversy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f08b37a-2e26-42fa-8aeb-4ad3451d9ddc",
                        "source_entry_id": "6cdd724e-246d-3294-9ca2-e0ff4421ee36",
                        "source_sense_id": "43df2de4-3315-3a86-843b-2af1927961b7",
                        "source_sense_description": "ein von Platon beschriebenes Inselreich",
                        "target_lang_word": "Atlantide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atlantide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3478f48b-9b17-3917-815e-9f617491b8cd",
                                        "entry_id": "d985d59a-1e09-3061-8846-30fa28803c8b",
                                        "glosses": [
                                            "Grande terre qui, d’après des récits très obscurs supposément venus des Égyptiens par les Grecs, aurait existé dans l’océan Atlantique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71fdb4b8-2a2c-4c30-9a91-8425f0154acd",
                                                "sense_id": "3478f48b-9b17-3917-815e-9f617491b8cd",
                                                "text": "Si le nimbe poétique des légendes qui couronnait les Îles Fortunées est aujourd’hui à jamais évanoui, si les géologues ne veulent même plus nous permettre de voir en elles les restes d’une fabuleuse Atlantide engloutie par l’Océan, les Canaries, grâce à leurs beautés naturelles, à leur fertilité et à leur climat délicieux, n’en sont pas moins restées un archipel privilégié, une des régions les plus attrayantes du Globe."
                                            },
                                            {
                                                "example_id": "5167aa3f-65dd-4521-bf6b-9010816644f3",
                                                "sense_id": "3478f48b-9b17-3917-815e-9f617491b8cd",
                                                "text": "D’autres auteurs ont été plus loin dans le domaine des suppositions. C’est des confins de l’Europe que ceux-ci font venir les Américains, qui auraient alors emprunté pour chemin un immense continent aujourd’hui disparu : l’Atlantide.",
                                                "translation": "René Thévenin et Paul Coze, Mœurs et Histoire des Indiens Peaux-Rouges, Payot, 1929, 2ᵉ édition, page 15"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Atlantide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8597b0fd-332b-39f0-a4bc-97c825be5b3f",
                                        "entry_id": "1ce10d74-267f-31aa-ab25-dfbcc9d28407",
                                        "glosses": [
                                            "Nom désignant une des filles du Titan Atlas, c’est-à-dire les Hespérides, les Hyades et les Pléiades, auxquelles on ajoute parfois Calypso."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef68636-3e89-40ce-8403-9f8dfae25ed0",
                                                "sense_id": "8597b0fd-332b-39f0-a4bc-97c825be5b3f",
                                                "text": "ATLANTIDES. s.f. Terme de Mythologie. Atlantides. C’est le nom que les Poëtes donnent à la constellation qu’on appelle autrement Vergilies, Vergiliæ, composée de plusieurs étoilles, dont cinq sont appelées Hyades, & les autres Pléiades. On les nomme Atlantides, parce que les Poëtes les font filles d’Atlas, & de Pleïone, fille de l’Océan & de Téthys."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
