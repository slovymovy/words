                "senses": [
                    {
                        "sense_id": "49973688-9846-34f0-a091-098e802bef82",
                        "entry_id": "79902001-c19b-32aa-ac50-9bc5848c0312",
                        "glosses": [
                            "Austausch einer Spielerin/eines Spielers einer Mannschaft gegen eine/n andere/n während eines laufenden Spiels (meist durch den Trainer)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fff47bb-52aa-49b8-82c9-6d22d91a6135",
                                "sense_id": "49973688-9846-34f0-a091-098e802bef82",
                                "text": "„80. Minute: Spielerwechsel: Bei Borussia Dortmund kommt Mateu Morey für Thomas Meunier.“"
                            },
                            {
                                "example_id": "5c2b193e-e8a2-43c7-975a-61c9b0efaf93",
                                "sense_id": "49973688-9846-34f0-a091-098e802bef82",
                                "text": "„Bereits nach 35 Minuten entschied sich Janßen zu zwei Spielerwechseln: Für Nehrig und Sobotta kamen Flum und Bouhaddouz.“"
                            },
                            {
                                "example_id": "54ad13ca-8b4b-463c-8b9e-c069d523ab02",
                                "sense_id": "49973688-9846-34f0-a091-098e802bef82",
                                "text": "„Entscheidend sind Guardiolas Spielerwechsel.“"
                            },
                            {
                                "example_id": "d192ff37-d798-4580-9f52-f7f25132560f",
                                "sense_id": "49973688-9846-34f0-a091-098e802bef82",
                                "text": "[Coronapandemie 2020:] „Um Spieler zu schonen, hatte die Liga bereits die Regeln angepasst: Statt bisher drei sind nun fünf Spielerwechsel erlaubt.“"
                            },
                            {
                                "example_id": "eea40bdb-fe22-423e-a25e-b4e015f8de0e",
                                "sense_id": "49973688-9846-34f0-a091-098e802bef82",
                                "text": "„Wolfsburg gewinnt in der 1. Pokalrunde 3:1 nach Verlängerung bei Viertligist Preußen Münster – und könnte trotzdem noch rausfliegen! Grund: Wolfsburg Trainer Mark van Bommel (44) nahm insgesamt sechs Spielerwechsel vor.“"
                            },
                            {
                                "example_id": "2312d959-a116-416e-88ac-8cc143ecdc44",
                                "sense_id": "49973688-9846-34f0-a091-098e802bef82",
                                "text": "„In der 1. Runde hatten sich die Wolfsburger zwar mit 3:1 n.V. gegen Regionalligist Preußen Münster durchgesetzt, doch wegen eines nicht erlaubten sechsten Spielerwechsels wurde der Sieg am Grünen Tisch in eine Niederlage umgewandelt.“"
                            },
                            {
                                "example_id": "6cf4036e-a41b-4882-8cc1-d4f66a0ef254",
                                "sense_id": "49973688-9846-34f0-a091-098e802bef82",
                                "text": "„Gelb-Rot für Seedorf! Nicht, weil er gepöbelt hatte oder einem Gegenspieler von hinten in die Beine gesprungen war. Nein, Seedorf wollte den Platz bei einem Spielerwechsel partout nicht dort verlassen, wo der Schiedsrichter es gerne gehabt hätte.“"
                            },
                            {
                                "example_id": "55c76d4e-397e-41fb-8dd3-8c9cb78a9179",
                                "sense_id": "49973688-9846-34f0-a091-098e802bef82",
                                "text": "[Fußball, Meisterschaftsfinale 1922, Nürnberg – HSV:] „Zweimal 15 Minuten Verlängerung bis zum nächsten Tor, so die Regel. Aber das \"Golden Goal\" fällt nicht - auch nicht in der folgenden Verlängerung über zweimal zehn Minuten. Erschöpfung hüben wie drüben, denn Spielerwechsel sind nicht erlaubt.“"
                            },
                            {
                                "example_id": "76ed2ca0-7952-4cb5-af5d-c45a69d54167",
                                "sense_id": "49973688-9846-34f0-a091-098e802bef82",
                                "text": "„Neben Verletzungen und unbefriedigenden Leistungen einzelner Spieler kann man beobachten, dass viele Trainer mit dem Spielerwechsel auch die taktische Ausrichtung ihrer Mannschaft ändern.“"
                            },
                            {
                                "example_id": "b0900ae2-116a-4ff8-ad94-fb6b3d2dfbdb",
                                "sense_id": "49973688-9846-34f0-a091-098e802bef82",
                                "text": "[Basketball:] „Wenn es zum Spielerwechsel kommen soll, ist es nicht der Trainer, der dies ankündigt, sondern der Ersatzspieler selbst.“"
                            },
                            {
                                "example_id": "884bb492-e60a-4fac-b720-c1c90245de41",
                                "sense_id": "49973688-9846-34f0-a091-098e802bef82",
                                "text": "[Beachvolleyball:] „Steht es in den Länderduellen nach den beiden Matches remis, wird ein Entscheidungssatz ausgetragen. Hierfür können auch Spielerwechsel vorgenommen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "47ed5160-503c-3273-acd8-7dbc453a8759",
                        "entry_id": "79902001-c19b-32aa-ac50-9bc5848c0312",
                        "glosses": [
                            "Kauf/Verkauf eines Profisportlers/einer Profisportlerin und damit verbundener Transfer von einem Verein an einen anderen (meist Fußball)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4de14b09-1496-46dd-9c62-8d0c0532e9dd",
                                "sense_id": "47ed5160-503c-3273-acd8-7dbc453a8759",
                                "text": "In der Sommerpause, wenn die Fußballer im Urlaub sind, spekulieren die Medien über mögliche Spielerwechsel."
                            },
                            {
                                "example_id": "a854acf3-d35f-4640-9d38-80af982391f5",
                                "sense_id": "47ed5160-503c-3273-acd8-7dbc453a8759",
                                "text": "„Generell [sind] die möglichen Spielerwechsel DAS Thema unter den Fans im Sommer.“"
                            },
                            {
                                "example_id": "8be80c3d-4031-4692-b4bf-fbb80c247bdd",
                                "sense_id": "47ed5160-503c-3273-acd8-7dbc453a8759",
                                "text": "„Bayern München holt Marcel Sabitzer und Leipzig besorgt Ersatz aus Barcelona, Thomas Delaney geht nach Sevilla, Matheus Cunha zu Atletico Madrid. Zum Ende der Transferperiode werden letzte Spielerwechsel abgewickelt.“"
                            },
                            {
                                "example_id": "396cbf7d-6e9f-4c84-9a57-c46a121e95eb",
                                "sense_id": "47ed5160-503c-3273-acd8-7dbc453a8759",
                                "text": "„Doch wie ist bei so vielen Spielerwechseln überhaupt eine Identifikation mit der so besonderen Geschichte des Vereins möglich?“"
                            },
                            {
                                "example_id": "50876361-ec26-4027-b7c7-511677db7f9c",
                                "sense_id": "47ed5160-503c-3273-acd8-7dbc453a8759",
                                "text": "[Gaelic Football/Irland:] „Spielerwechsel gibt es innerhalb Irlands nicht, kein Verein kann die großen Stars der Gegner abwerben.“"
                            },
                            {
                                "example_id": "7ebc41d8-4e74-4102-a2ce-982c2ec68d8f",
                                "sense_id": "47ed5160-503c-3273-acd8-7dbc453a8759",
                                "text": "„Während in der NBA gerade der Transfermarkt explodiert und fast alle zehn Minuten ein Spielerwechsel zu exorbitant hohen Summen verkündet wird, genießt Dirk Nowitzki die Sommerpause.“"
                            },
                            {
                                "example_id": "dc8c4adc-e6e9-42f8-8741-898801f208e4",
                                "sense_id": "47ed5160-503c-3273-acd8-7dbc453a8759",
                                "text": "„Wie aus dem am Donnerstag veröffentlichten Bericht des Fußballweltverbandes (FIFA) hervorgeht, wurden im Wechselzeitraum in diesem Sommer umgerechnet fünf Milliarden Euro für internationale Spielerwechsel bewegt, womit das Niveau der Vorpandemiezeit fast wieder erreicht wurde.“"
                            },
                            {
                                "example_id": "5b12b734-2935-4590-80d4-629560800487",
                                "sense_id": "47ed5160-503c-3273-acd8-7dbc453a8759",
                                "text": "„Der Höchstetter Kaderspieler Simon Erni findet es schade, dass Spielerwechsel zu so viel Missgunst führen. «Es klingt hart, aber mit gewissen Mannschaften kann man einfach nicht weiterkommen», sagt der ehemalige Gondiswiler Hornusser.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
