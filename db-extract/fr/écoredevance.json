                        "entry_id": "27e75892-313f-3764-b7c8-974639e84b80",
                        "glosses": [
                            "Redevance dont l’instauration répond à des préoccupations écologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4309af2-fb74-4915-bac2-875917bfdacb",
                                "sense_id": "cb6d04b1-59d7-3c95-8339-de458f092926",
                                "text": "L’écoredevance revient en fait à inclure dans le prix du produit d’emballage les coûts de l’élimination du déchet d’emballage."
                            },
                            {
                                "example_id": "2191f1e2-1ad7-4919-985f-ddaa35299694",
                                "sense_id": "cb6d04b1-59d7-3c95-8339-de458f092926",
                                "text": "Une écoredevance poids lourds, qui sera mise en place en 2027, permettra de financer les travaux et l'entretien des routes, selon la région, qui a en attendant recours à des emprunts d'équilibre, en plus des quelque 32 millions d'euros fournis par l'État au titre du droit à compenser."
                            }
                        ]
                    }
