                    {
                        "form_id": "7d570b6c-c209-4739-9eed-3a20c1267e33",
                        "entry_id": "fa2919de-7438-3e40-b63a-87b9d94060ed",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Seltsamkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ca1cf3e-21e8-388d-9c94-e44b29124cb5",
                        "entry_id": "fa2919de-7438-3e40-b63a-87b9d94060ed",
                        "glosses": [
                            "Eigenschaft/Verhalten, sich ungewöhnlich/befremdlich zu geben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3abeecd-3e77-4c44-9e98-0186cc002333",
                                "sense_id": "6ca1cf3e-21e8-388d-9c94-e44b29124cb5",
                                "text": "„Dessen Seltsamkeit ging über das in der Familie ohnehin schon hohe und übliche Maß hinaus.“"
                            },
                            {
                                "example_id": "9a28e4b4-81de-487c-9469-2766e32326cb",
                                "sense_id": "6ca1cf3e-21e8-388d-9c94-e44b29124cb5",
                                "text": "„Seit längerem unterrichten Manfred Schmidt und der Unterzeichnete die Redaktion und die Leser in offenen Briefen über Seltsamkeiten des öffentlichen Lebens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec994a8a-082b-45d9-a361-aa70aa8622b9",
                        "source_entry_id": "fa2919de-7438-3e40-b63a-87b9d94060ed",
                        "source_sense_id": "6ca1cf3e-21e8-388d-9c94-e44b29124cb5",
                        "source_sense_description": "Eigenschaft/Verhalten, sich ungewöhnlich/befremdlich zu geben",
                        "target_lang_word": "étrangeté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étrangeté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0966dd34-3eb7-3fc1-9ea6-fb094e2d9d39",
                                        "entry_id": "0d0000ab-c8af-3ae0-9b8b-0ed7858f748b",
                                        "glosses": [
                                            "Caractère de ce qui est étrange."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e754bbed-bc5f-49c2-b588-d7080858b48c",
                                                "sense_id": "0966dd34-3eb7-3fc1-9ea6-fb094e2d9d39",
                                                "text": "L’île dépassait encore en sauvagerie et en étrangeté les autres Marquises."
                                            },
                                            {
                                                "example_id": "e0196b4d-bbe5-4245-aa90-3d985f9b1020",
                                                "sense_id": "0966dd34-3eb7-3fc1-9ea6-fb094e2d9d39",
                                                "text": "Mais c’était l’irrégularité de la couleur de ses iris, l’un bleu pâle et l’autre jaune, qui achevait de conférer à son visage une étrangeté indéfinissable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "498fd439-b520-3a5c-aa54-95dc38d4213d",
                                        "entry_id": "0d0000ab-c8af-3ae0-9b8b-0ed7858f748b",
                                        "glosses": [
                                            "Chose étrange."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe2fb48-e2ae-474e-9160-f18b857234f1",
                                                "sense_id": "498fd439-b520-3a5c-aa54-95dc38d4213d",
                                                "text": "Bizarrement, l’ombre portée sur la Lune ne devait pas être noire mais rouge profond. Une étrangeté qui pourtant s'explique par un simple cours de physique. Dans une telle situation, l'atmosphère terrestre qui englobe notre planète joue en effet le rôle de lentille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "851508f5-bbf5-392e-b562-6c33b93de17d",
                                        "entry_id": "0d0000ab-c8af-3ae0-9b8b-0ed7858f748b",
                                        "glosses": [
                                            "Chose anormale, inusitée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68ec6445-e1c5-4ba3-afe6-72fee181feee",
                                                "sense_id": "851508f5-bbf5-392e-b562-6c33b93de17d",
                                                "text": "Une étrangeté : l'emprunteur était rémunéré par le prêteur. Le monde à l'envers!."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcc183bb-2b02-3638-95fb-c4acce7a5069",
                                        "entry_id": "0d0000ab-c8af-3ae0-9b8b-0ed7858f748b",
                                        "glosses": [
                                            "Nombre quantique de certaines particules, telles que les baryons, défini comme la différence entre le nombre d’antiquarks étranges et de quarks étranges."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e229e25-ccaa-43f9-b91f-4ef5a456584c",
                        "source_entry_id": "fa2919de-7438-3e40-b63a-87b9d94060ed",
                        "source_sense_id": "6ca1cf3e-21e8-388d-9c94-e44b29124cb5",
                        "source_sense_description": "Eigenschaft/Verhalten, sich ungewöhnlich/befremdlich zu geben",
                        "target_lang_word": "bizarrerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bizarrerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa3fd05f-b82a-3e66-b21d-d836903071cc",
                                        "entry_id": "f6e2c53a-e471-3011-bb0b-576b371b196c",
                                        "glosses": [
                                            "Caractère de ce qui est bizarre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deb39877-cf22-4c0b-8573-e84230cc7f5d",
                                                "sense_id": "aa3fd05f-b82a-3e66-b21d-d836903071cc",
                                                "text": "Cette bizarrerie même de m'avoir envoyé une jolie fille pour me consoler, j'aurais parié qu'elle venait de son invention, et que c'était un effet de sa compassion pour mes peines."
                                            },
                                            {
                                                "example_id": "d3173faf-709a-486c-8ac5-f09319c678cf",
                                                "sense_id": "aa3fd05f-b82a-3e66-b21d-d836903071cc",
                                                "text": "Gardez-vous donc bien d’imiter le vulgaire, qui met la Fortune au nombre des dieux ; la bizarrerie de sa conduite l’éloigne entièrement du caractère de la divinité […]"
                                            },
                                            {
                                                "example_id": "ff31e0c9-ed89-4d30-a12a-d2ab5c7a58da",
                                                "sense_id": "aa3fd05f-b82a-3e66-b21d-d836903071cc",
                                                "text": "Petites plantes annuelles, herbacées, voisines des Luzernes (Medicago), que l’on sème sur place terreautée, et que l’on cultive pour la bizarrerie de leurs fruits, qui sont hérissés, écailleux, sillonnés, et imitent parfaitement une chenille, quelquefois un limaçon ou un ver."
                                            },
                                            {
                                                "example_id": "0c933025-2905-470f-bd4c-546ebefd2b02",
                                                "sense_id": "aa3fd05f-b82a-3e66-b21d-d836903071cc",
                                                "text": "[…] et, par une bizarrerie quelquefois observée, le météore était paré de toutes les couleurs du prisme, entre lesquelles le rouge s’accusait plus nettement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be83d175-ef31-337b-af2a-322247018319",
                                        "entry_id": "f6e2c53a-e471-3011-bb0b-576b371b196c",
                                        "glosses": [
                                            "Chose bizarre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23b4b1b1-f342-4557-9344-967ee3fa5144",
                                                "sense_id": "be83d175-ef31-337b-af2a-322247018319",
                                                "text": "Beaucoup de ces tournures, et particulièrement les idiotismes de figures, constituent des bizarreries dans la langue même qui les a enfantées ; […]."
                                            },
                                            {
                                                "example_id": "87f33b2c-303e-423f-8bff-3cfb3abdcd10",
                                                "sense_id": "be83d175-ef31-337b-af2a-322247018319",
                                                "text": "La bizarrerie administrative dont elle est victime, Othe s'en accommode depuis fort longtemps. Pensez donc ! Depuis 1790 (création des départements) qu'elle vit avec son statut d'enclave meurthe-et-mosellane en territoire meusien, elle s’est fait une raison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46b1dfae-370d-3495-80c9-454a7d7bb5b1",
                                        "entry_id": "f6e2c53a-e471-3011-bb0b-576b371b196c",
                                        "glosses": [
                                            "Humeur bizarre ; extravagance."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28ebd02b-dc32-4ab1-987c-880aa061ac9d",
                                                "sense_id": "46b1dfae-370d-3495-80c9-454a7d7bb5b1",
                                                "text": "Enfin, comme c’est un Anglais qui voyage, on doit s’attendre à des bizarreries, mais cela passe la permission."
                                            },
                                            {
                                                "example_id": "ea37faf4-0e70-4d56-90c9-ef352b6ac04b",
                                                "sense_id": "46b1dfae-370d-3495-80c9-454a7d7bb5b1",
                                                "text": "Je n’ai jamais vraiment essayé de me débarrasser de ces bizarreries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
