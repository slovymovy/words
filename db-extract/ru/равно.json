                "forms": [],
                "senses": [
                    {
                        "sense_id": "05627130-cd6f-356e-9fdd-1b9350528d56",
                        "entry_id": "b2215b89-f799-3600-916f-28c483f63a12",
                        "glosses": [
                            "в равной мере, степени; одинаково"
                        ],
                        "tags": [],
