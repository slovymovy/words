                                        "sense_id": "5c93e20b-88e3-368a-9a67-73e080aa9b21",
                                        "entry_id": "baa6937b-d138-3d39-8d77-d1b23161d188",
                                        "glosses": [
                                            "A diminutive of the female given name Patricia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e454d3b0-14fb-321b-907a-bd0cd81a1b75",
                                        "entry_id": "baa6937b-d138-3d39-8d77-d1b23161d188",
                                        "glosses": [
                                            "A diminutive of the male given name Patrick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30090055-9224-4b76-b9eb-efe68e29bc56",
                                                "sense_id": "e454d3b0-14fb-321b-907a-bd0cd81a1b75",
                                                "text": "One Nation, a new 501(c)4 linked to the Karl-Rove-backed American Crossroads super PAC, is spending more than $1.9 million on print, radio and digital ads highlighting the efforts of Illinois Sen. Mark Kirk, North Carolina Sen. Richard Burr, New Hampshire Sen. Kelly Ayotte, Ohio Sen. Rob Portman and Pennsylvania Sen. Pat Toomey to pass the “doc fix” legislation that realigned payments to Medicare providers with inflation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Pat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08a36fcb-a9ab-3801-8a5e-3ddd3dcfea79",
                                        "entry_id": "99959b8c-5e2c-3fc5-b64e-fbe7a3cc8dd0",
                                        "glosses": [
                                            "An Irish person."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "possibly",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "169f1000-4391-4cc6-9ec4-288f50a7d611",
                                                "sense_id": "08a36fcb-a9ab-3801-8a5e-3ddd3dcfea79",
                                                "text": "I'll do it, sir, by the honor of the Pats, just take your two good looking selves into the garden, […]"
                                            },
                                            {
                                                "example_id": "b0a419cc-66f2-4d24-a815-cfdad4b43b61",
                                                "sense_id": "08a36fcb-a9ab-3801-8a5e-3ddd3dcfea79",
                                                "text": "The stereotypes of the Irish were more negative. Irish men, the “Pats,” were seen as “always drunk, eternally fighting, lazy, and shiftless.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Pat",
                                "target_lang_code": "en",
                                "target_senses": [
