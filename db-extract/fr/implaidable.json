            },
            {
                "entry_id": "fb341874-a1c7-374b-b84c-ef5704c14022",
                "word": "implaidable",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ba699ab6-c79c-3a5a-8561-eee0c8fbd04d",
                        "entry_id": "fb341874-a1c7-374b-b84c-ef5704c14022",
                        "glosses": [
                            "Ce qui ne peut pas être plaidé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aabcf5e-3c29-41f4-9309-15e3cf40c8ac",
                                "sense_id": "ba699ab6-c79c-3a5a-8561-eee0c8fbd04d",
                                "text": "Un avocat peut défendre l’indéfendable, jamais plaider l’implaidable."
                            },
                            {
                                "example_id": "6b594881-2d97-4c2a-96bc-bd9c60685e0f",
                                "sense_id": "ba699ab6-c79c-3a5a-8561-eee0c8fbd04d",
                                "text": "Et à l’instar de l’auteur de Corydon, ne plaide-t-il pas l’implaidable, là où Rilke, Nietzsche et Hölderlin se seraient au contraire abandonnés à sa nuit ?"
                            },
                            {
                                "example_id": "710180a0-7bf0-4ad7-88db-3c085f9fc474",
                                "sense_id": "ba699ab6-c79c-3a5a-8561-eee0c8fbd04d",
                                "text": "Tout se plaide. Surtout « l’implaidable ». C’est même souvent ce qu’il y a de plus excitant."
                            }
                        ]
                    }
                ],
