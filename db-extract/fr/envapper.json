                ],
                "senses": [
                    {
                        "sense_id": "3337bf89-7484-3350-9781-8426b04ba866",
                        "entry_id": "962b508a-3c9c-32d3-abd7-d286e3a871ad",
                        "glosses": [
                            "Autre orthographe, nettement plus rare, de envaper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "413efcfb-2d9e-44cb-ab6d-fe7dac65aa13",
                                "sense_id": "3337bf89-7484-3350-9781-8426b04ba866",
                                "text": "Osez cliquer pour vous laisser envapper de ces délicieuses odeurs fauves de toutes sortes de biquetteries multiples et variées, à découvrir sourire jusqu'aux oreilles !"
                            },
                            {
                                "example_id": "cf27c935-f612-4608-a5fe-2192276b70aa",
                                "sense_id": "3337bf89-7484-3350-9781-8426b04ba866",
                                "text": "Encore 20 bonnes minutes à m'envapper..."
                            },
                            {
                                "example_id": "10bc6db6-566f-45c2-9b4f-a7217c0b1c75",
                                "sense_id": "3337bf89-7484-3350-9781-8426b04ba866",
                                "text": "Eh oui, c'est l'effet euro: un bon gros somnifère pour envapper tout le monde, depuis la décennie précédente!"
                            },
                            {
                                "example_id": "1ca5c91a-32fb-4d8b-a6c3-bf90bd73759a",
                                "sense_id": "3337bf89-7484-3350-9781-8426b04ba866",
                                "text": "Le même délire qui a fait du vieux touareg cette sorte de fakir envappé si vite évanoui, vautré par terre en dehors de la natte."
                            }
                        ]
                    }
                ],
