                    {
                        "form_id": "cb89f321-da08-4274-873c-99d3ffeb4d47",
                        "entry_id": "41719919-a8e6-3def-bb5c-2e49e08be99a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Glasbrüche"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                        "entry_id": "41719919-a8e6-3def-bb5c-2e49e08be99a",
                        "glosses": [
                            "Schaden an Gläsern (oft Fenstern), zerbrochenes Glas"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "aae488a0-e306-4029-a1ca-2b2ae1a15758",
                                "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                                "text": "„Zusatzpolicen sind wie bei vielen anderen Versicherungen auch bei der Wohngebäudeversicherung möglich - z. B. gegen Überspannungsschäden durch Blitz oder gegen Glasbruch.“"
                            },
                            {
                                "example_id": "540acb6e-b350-4977-8a6d-08e81ab899cd",
                                "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                                "text": "Glasbruch ist mitversichert."
                            },
                            {
                                "example_id": "53e783ae-8e87-4088-abbe-6782bb971a4c",
                                "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                                "text": "[KFZ-Versicherung:] „Die Teilkasko bezahlt bei Diebstahl oder Glasbruch – zum Beispiel, wenn ein Riss die Frontscheibe unbrauchbar macht.“"
                            },
                            {
                                "example_id": "8573dcbe-5c40-4605-911b-dc2b5c9d9747",
                                "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                                "text": "[Schwerin: Unbekannte demolieren mindestens 45 Autos:] „Zweifelhaft ist, ob die betroffenen Autobesitzer die Schäden ersetzt bekommen. Eine Vollkaskoversicherung deckt zwar meist auch Vandalismusschäden ab. Eine Teilkaskoversicherung deckt dagegen meist nur Glasbruch oder etwa Schäden durch ein Feuer, aber keine Lackschäden.“"
                            },
                            {
                                "example_id": "014d39d0-1109-43b0-a81b-6a12edade0c0",
                                "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                                "text": "„Manfred G. aus Pinneberg in Schleswig-Holstein hat sich zur Wärmedämmung eine Schiebetür mit Dreifachverglasung einbauen lassen. Vor einigen Monaten bemerkte er einen Riss an der Fensterscheibe, der immer größer wurde. Er wollte, dass der Hersteller die kaputte Scheibe austauscht. Doch der beharrt darauf, dass das Risiko von Glasbruch mit der Abnahme der Fenster auf den Käufer übergeht.“"
                            },
                            {
                                "example_id": "f6a40a63-b291-4d7f-98bd-b5e3dfc81f13",
                                "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                                "text": "„Die materiellen Schäden, die bislang durch die Beben an den Häusern entstanden sind, halten sich in engen Grenzen. Es treten Risse auf, defekte Fenster, Glasbruch.“"
                            },
                            {
                                "example_id": "3cc984a1-ebdf-43f8-934e-cde61c3c081e",
                                "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                                "text": "„Vorsicht ist jedoch bei stark wärmeabsorbierenden Glasfolien an Mehrfachverglasungen geboten. Sie können die Durchschnittstemperatur der Fensterscheibe derart erhöhen, dass es zum Glasbruch kommt.“"
                            },
                            {
                                "example_id": "1c898ea3-3646-4a4b-a9e2-9dcfef90084d",
                                "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                                "text": "„Schnee kann auch zu einer gefährlichen Last für Gewächshäuser werden. Wenn sich darauf viel nasser und schwerer Schnee ansammelt, kann es zu Glasbruch kommen.“"
                            },
                            {
                                "example_id": "ed62f059-0537-4004-b33f-17c903fde2f8",
                                "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                                "text": "„Um Glasbruch bei unvorsichtigem Anstoßen zu verhindern, wird bei Weizenbiergläsern unterhalb des Griffs mit dem Boden angestoßen.“"
                            },
                            {
                                "example_id": "b8d5645d-84af-4a47-83a9-6b21fba6ba37",
                                "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                                "text": "Hagel in Vogeleigrösse (25 bis 45 mm) kann zu Glasbruch und Schäden an Autokarosserien führen."
                            },
                            {
                                "example_id": "c916ae40-79a9-4187-a48e-28cc7418b822",
                                "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                                "text": "[Novemberpogrome 1938:] „Allein der Glasbruch kostete annähernd drei Millionen, die gesamten Versicherungsschäden wurden auf 225 Millionen Reichsmark beziffert.“"
                            },
                            {
                                "example_id": "9c785072-0ba1-414e-b770-168e6bc214cf",
                                "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                                "text": "„Maren Teubert fertigt lustige Bilder aus Meerglas und Glasbruch, das sie im Betonmischer bearbeitet.“"
                            },
                            {
                                "example_id": "edee2ae3-d92e-41b8-96c7-cf61b7242bab",
                                "sense_id": "2d1a56a2-69c1-3216-9b59-7c08c0a7cc42",
                                "text": "„Hierfür ist ein sog. Individualnachweis, d.h. Nachweis von Spuren, die nur individuell und einmalig vorkommen können, erforderlich. Dieser Nachweis kann z.B. durch die Untersuchung von Lackantragungen oder Bruchkanten (z.B. durch Glasbrüche) geführt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
