                    }
                ],
                "senses": [
                    {
                        "sense_id": "f6371373-074e-3848-b8ca-17d0b490fecd",
                        "entry_id": "b184e279-07ed-3820-a9b1-e9c8b105c59e",
                        "glosses": [
                            "To arrange words or items in order of the first (and then subsequent) letters as they occur in the alphabet."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c69e4c7a-c584-4a79-903c-972ac0ab0b3b",
                                "sense_id": "f6371373-074e-3848-b8ca-17d0b490fecd",
                                "text": "It was almost impossible to locate specific books in the library until we had alphabetized them by the authors' surnames."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15109282-366d-4452-863b-7b9590813ee5",
                        "source_entry_id": "b184e279-07ed-3820-a9b1-e9c8b105c59e",
                        "source_sense_id": "f6371373-074e-3848-b8ca-17d0b490fecd",
                        "source_sense_description": "to arrange alphabetically",
                        "target_lang_word": "alphabetisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alphabetisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99585df7-fd81-30e8-9732-35b74da9e979",
                                        "entry_id": "b016e298-a23e-3ebb-a7de-0d0bd254eeca",
                                        "glosses": [
                                            "etwas alphabetisch ordnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7d2c8c2-4b1b-4a20-8506-5cc76f82c8e7",
                                                "sense_id": "99585df7-fd81-30e8-9732-35b74da9e979",
                                                "text": "Ich muss erst alle Titel alphabetisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89542e21-bbea-376f-bdef-3488238cb251",
                                        "entry_id": "b016e298-a23e-3ebb-a7de-0d0bd254eeca",
                                        "glosses": [
                                            "jemandem das Lesen und Schreiben beibringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19bd7ccc-a7df-4332-a8a6-bc6350cbf534",
                                                "sense_id": "89542e21-bbea-376f-bdef-3488238cb251",
                                                "text": "Schulen helfen große Teile der Bevölkerung zu alphabetisieren."
                                            },
                                            {
                                                "example_id": "59159d85-5e86-4fc6-9f55-c2ef2c648476",
                                                "sense_id": "89542e21-bbea-376f-bdef-3488238cb251",
                                                "text": "Du alphabetisierst deine Schüler nicht mit dem Rohrstock, sondern nur durch geduldigen Unterricht."
                                            },
                                            {
                                                "example_id": "184f0317-e140-4835-b0f4-687847c64458",
                                                "sense_id": "89542e21-bbea-376f-bdef-3488238cb251",
                                                "text": "Alphabetisierte ich das Volk, so würden sie meine Absichten erkennen."
                                            },
                                            {
                                                "example_id": "d3b87ee9-d47e-4842-9a37-5a04febe269d",
                                                "sense_id": "89542e21-bbea-376f-bdef-3488238cb251",
                                                "text": "„Das Lesen auf dem Land und lange auch das in den Städten richtete sich - so die einfachen Leute überhaupt alphabetisiert waren - bis ins erste Drittel des 18. Jahrhunderts hauptsächlich auf Erbauungsbücher und die Bibel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
