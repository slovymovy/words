                                        "entry_id": "ee04cfcd-fd2a-33c7-a884-becb6ed5472c",
                                        "glosses": [
                                            "A betrayal portrayed as especially shocking."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
