            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d241d52-8055-3cc9-afa9-cf25e5adeda4",
                    "sense_definition": "Soumettre à un impôt ou à une taxe légale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fiscalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a décidé de <w>taxer</w> plus lourdement les produits contenant trop de sucre."
                        },
                        {
                            "text": "Les importations étrangères sont souvent <w>taxées</w> pour protéger l'économie locale."
                        }
                    ],
                    "common_phrases": [
                        "taxer les produits",
                        "taxer les bénéfices",
                        "lourdement taxé"
                    ]
                },
                {
                    "sense_id": "898163e3-7d52-381e-afcf-f8ae33ea9baf",
                    "sense_definition": "Prendre, dérober ou soutirer quelque chose à quelqu'un, souvent de manière opportune.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'avait plus de feu et a demandé à <w>taxer</w> une allumette à un passant."
                        },
                        {
                            "text": "Un inconnu a profité de la bousculade pour lui <w>taxer</w> son portefeuille dans le métro."
                        }
                    ],
                    "common_phrases": [
                        "taxer une cigarette",
                        "taxer du fric"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "registre très familier"
                        }
                    ]
                },
                {
                    "sense_id": "4b6cf02f-666b-3787-9e07-173827180e2d",
                    "sense_definition": "Qualifier ou accuser une personne d'un défaut ou d'un comportement blâmable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses collègues ont osé le <w>taxer</w> de paresse alors qu'il accomplit tout le travail."
                        },
                        {
                            "text": "On l'a immédiatement <w>taxée</w> d'égoïsme quand elle a refusé de prêter sa voiture."
                        }
                    ],
                    "synonyms": [
                        "qualifier",
                        "traiter"
                    ],
                    "common_phrases": [
                        "taxer d'incompétence",
                        "taxer de menteur"
                    ]
                },
                {
                    "sense_id": "adb95c64-8a0d-3c42-b353-e21e6a775685",
                    "sense_definition": "Fixer d'autorité le prix officiel d'une marchandise ou le tarif légal de certains actes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la famine, l'administration a dû <w>taxer</w> le prix du pain pour éviter les abus."
                        },
                        {
                            "text": "Le juge a enfin pris le temps de <w>taxer</w> les dépens du procès."
                        }
                    ],
                    "common_phrases": [
                        "taxer les denrées",
                        "taxer les dépens"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "terme principalement historique ou juridique"
                        }
                    ]
                },
                {
                    "sense_id": "0ebc968b-ce23-3460-83de-338d08bc8925",
                    "sense_definition": "S'engager de son plein gré à fournir une contribution financière déterminée pour une œuvre ou une cause.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour soutenir les victimes du sinistre, les membres de la communauté se sont <w>taxés</w> généreusement."
                        },
                        {
                            "text": "Chaque citoyen se <w>taxa</w> selon ses moyens afin de financer la reconstruction du pont."
                        }
                    ],
                    "common_phrases": [
                        "se taxer pour une cause"
                    ],
                    "traits": [
                        {
