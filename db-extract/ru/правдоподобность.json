                        "translation_id": "c409e4a3-72b8-42d7-a69e-d0f8e0bfa261",
                        "source_entry_id": "1bd2a5b8-3711-3ecf-b0ef-c9240e8bfdab",
                        "source_sense_id": "055a858a-114a-365e-89cd-846c60a40bde",
                        "target_lang_word": "verisimilitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verisimilitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f855b6c-44b7-39a3-92c9-37d89ba9d261",
                                        "entry_id": "b2d77a98-c28e-31bf-8cf9-39040a606422",
                                        "glosses": [
                                            "The property of seeming true, of resembling reality; resemblance to reality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fe23c2d-9749-3361-9525-70b976781da5",
                                        "entry_id": "b2d77a98-c28e-31bf-8cf9-39040a606422",
                                        "glosses": [
                                            "A statement which merely appears to be true."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28d06968-5a78-3bb5-b776-5d5bf43a9e86",
                                        "entry_id": "b2d77a98-c28e-31bf-8cf9-39040a606422",
                                        "glosses": [
                                            "Faithfulness to its own rules; internal cohesion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25a8e173-7d5b-4609-af76-1c2a67eb5e43",
                                                "sense_id": "28d06968-5a78-3bb5-b776-5d5bf43a9e86",
                                                "text": "On July 12, Madame filed suit for divorce, naming one Jane McManus as his principal mistress. Other adulteries were noted in the interest of verisimilitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88da1ba0-8c12-4acf-a58a-d253c7a17cff",
                        "source_entry_id": "1bd2a5b8-3711-3ecf-b0ef-c9240e8bfdab",
                        "source_sense_id": "055a858a-114a-365e-89cd-846c60a40bde",
                        "target_lang_word": "likelihood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "likelihood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "606082e3-2fd3-39ca-873b-f2ce7a2bd292",
                                        "entry_id": "9e407b1a-a0c8-3889-8d2f-ba226aa1688c",
                                        "glosses": [
                                            "The probability of a specified outcome; the chance of something happening; probability; the state or degree of being probable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9ca4a34-96c6-4921-85ef-a8e10a99ccb9",
                                                "sense_id": "606082e3-2fd3-39ca-873b-f2ce7a2bd292",
                                                "text": "In all likelihood the meeting will be cancelled."
                                            },
                                            {
                                                "example_id": "03f83326-2ae8-4099-bc68-f0d38a331ddf",
                                                "sense_id": "606082e3-2fd3-39ca-873b-f2ce7a2bd292",
                                                "text": "The likelihood is that the inflation rate will continue to rise."
                                            },
                                            {
                                                "example_id": "06e3d8c9-683b-461f-abe3-a33226b4215b",
                                                "sense_id": "606082e3-2fd3-39ca-873b-f2ce7a2bd292",
                                                "text": "While starting early can increase your likelihood of attaining millionaire status, the investments you choose play an equally important role."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0c90184-ed9e-30a1-ae00-39e91869be51",
                                        "entry_id": "9e407b1a-a0c8-3889-8d2f-ba226aa1688c",
                                        "glosses": [
                                            "The probability that some fixed outcome was generated by a random distribution with a specific parameter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6600937d-2128-3f01-b2b1-95652dc68707",
                                        "entry_id": "9e407b1a-a0c8-3889-8d2f-ba226aa1688c",
                                        "glosses": [
                                            "Likeness, resemblance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e04460f1-d399-4c37-9cce-868192bc7746",
                                                "sense_id": "6600937d-2128-3f01-b2b1-95652dc68707",
                                                "text": "There is no likelihood between pure light and black darkness, […]or between righteousness and reprobation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff1e2767-4ebc-36a6-835e-2c5ff595749c",
                                        "entry_id": "9e407b1a-a0c8-3889-8d2f-ba226aa1688c",
                                        "glosses": [
                                            "Appearance, show, sign, expression."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eaed3679-aadc-4256-9e91-aee35d74128a",
                        "source_entry_id": "1bd2a5b8-3711-3ecf-b0ef-c9240e8bfdab",
                        "source_sense_id": "055a858a-114a-365e-89cd-846c60a40bde",
                        "target_lang_word": "plausibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plausibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "548d7d87-ad84-385e-bea9-e5319a26dfe8",
                                        "entry_id": "a4fac28f-d510-3694-a598-4771d7a8da94",
                                        "glosses": [
                                            "The quality of deserving applause, praiseworthiness; something worthy of praise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f440a85-a4ec-435c-be71-e1bbac1db2ac",
                                                "sense_id": "548d7d87-ad84-385e-bea9-e5319a26dfe8",
                                                "text": "integrity, fidelity, and other gracious plausibilities"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72cd34ba-b4ac-344d-9cd8-e538ebcbfdcc",
                                        "entry_id": "a4fac28f-d510-3694-a598-4771d7a8da94",
                                        "glosses": [
                                            "The appearance of truth, especially when deceptive; speciousness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61db0587-2281-4459-9435-46809b3ea56e",
                                                "sense_id": "72cd34ba-b4ac-344d-9cd8-e538ebcbfdcc",
                                                "text": "Plausibility, I know, can only be unmasked by shewing the absurdities it glosses over, and the simple truths it involves with specious errors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e27195e-0c70-3a63-be4b-b21cfda5c7c4",
                                        "entry_id": "a4fac28f-d510-3694-a598-4771d7a8da94",
                                        "glosses": [
                                            "A plausible statement, argument etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4190e124-957a-4108-adf9-720796e5b26d",
                                                "sense_id": "9e27195e-0c70-3a63-be4b-b21cfda5c7c4",
                                                "text": "She too must shimmer through the gloom o' the grave, / Come and confront me— […] / Striking me dumb, and helping her to speak, / Tell her own story her own way, and turn / My plausibility to nothingness!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8b7f3e9-2ee3-34d9-ac0a-d04b385d81a6",
                                        "entry_id": "a4fac28f-d510-3694-a598-4771d7a8da94",
                                        "glosses": [
                                            "The fact of being believable; believability, credibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27289e7b-337e-496c-a0a9-1290465c1c74",
                                                "sense_id": "e8b7f3e9-2ee3-34d9-ac0a-d04b385d81a6",
                                                "text": "The question of the plausibility of the counter-factual is seen as key in all three discussions of allohistorical fiction (as it is in Demandt's and Ferguson's examinations of allohistory) (cf. Rodiek 25–26; Ritter 15–16; Helbig 32)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
