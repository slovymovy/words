                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "release",
                                "target_lang_sense_clarification": "album, film, or product"
                            },
                            {
                                "target_lang_word": "publish",
                                "target_lang_sense_clarification": "book or article"
