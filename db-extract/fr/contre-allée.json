                                                "sense_id": "7d92d586-83fc-3607-a137-5287791873c2",
                                                "text": "Er deed zich gisterenmorgen een wegverzakking voor op de ventweg van de Koningin Astridlaan."
                                            },
                                            {
                                                "example_id": "b1ec6698-ad34-4841-8bef-bea7e151689e",
