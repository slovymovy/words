                        "source_entry_id": "9c367934-1769-34f1-a44f-0add2875e3c0",
                        "source_sense_id": "6f18285a-816d-3b9d-841a-644a7b6bf0c3",
                        "target_lang_word": "Graupe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Graupe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fd107d2-959d-3c2a-a058-b959f6668d1f",
                                        "entry_id": "b95c4e9f-078c-3ee6-a539-3859b31235ca",
                                        "glosses": [
                                            "geschältes, poliertes Gersten- oder Weizenkorn von runder bis länglicher Form"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0be0489-6bdc-442a-9bb1-f4b5a57b3dc0",
                                                "sense_id": "4fd107d2-959d-3c2a-a058-b959f6668d1f",
                                                "text": "„An den restlichen Tagen kam das auf den Tisch, was man auf dem Markt ergattern konnte: manchmal Graupen mit Kohl, manchmal Brot mit Schmalz.“"
                                            },
                                            {
                                                "example_id": "3f50527c-2443-4967-bc1f-4921563fe588",
                                                "sense_id": "4fd107d2-959d-3c2a-a058-b959f6668d1f",
                                                "text": "„Sie nippte an dem Braten wie ein Vögelchen und aß ein paar Graupen und trank drei Mundvoll Wein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e420487-ee5b-4ce8-8ed4-c1efa859bd63",
                        "source_entry_id": "9c367934-1769-34f1-a44f-0add2875e3c0",
                        "source_sense_id": "dc040992-125c-3d39-a0b4-9c5fb3a56e6d",
                        "target_lang_word": "Graupel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Graupel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e35e2d11-4ba1-38d4-b6dc-a094e9b63657",
                                        "entry_id": "99b76176-ec55-366c-b3b0-77a0aebc6921",
                                        "glosses": [
                                            "Form von Niederschlag, bei dem Schneekristalle durch angefrorene Wassertröpfchen zu kleinen Kügelchen verklumpt werden"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f4614c8-8ba0-491e-9983-d6458fe647be",
                                                "sense_id": "e35e2d11-4ba1-38d4-b6dc-a094e9b63657",
                                                "text": "„Graupel und Hagelschlag stürzten aus grauen Wolkenbergen. Zuerst dachte er: Wie kann man in diesem schrecklichen Land fotografieren?“"
                                            },
                                            {
                                                "example_id": "83f7993a-7baf-4067-b2f7-f282e128640a",
                                                "sense_id": "e35e2d11-4ba1-38d4-b6dc-a094e9b63657",
                                                "text": "„Er brachte Eis und gefrierende Graupel und machte die Straßen spiegelglatt.“"
                                            },
                                            {
                                                "example_id": "8c22e718-444c-4f7a-8309-759ec63c4566",
                                                "sense_id": "e35e2d11-4ba1-38d4-b6dc-a094e9b63657",
                                                "text": "„Es war ein klarer, kalter Tag, der Boden mit Graupeln bedeckt, die gefroren waren, sodass es schien, als seien all die kahlen Bäume, die Büsche, die Reisighaufen, das Gras und die nackte Erde mit einer Eisschicht überzogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
