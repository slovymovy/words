                    {
                        "sense_id": "e0777b7a-621f-381f-bfc3-22375419129c",
                        "entry_id": "2764aa01-0419-3798-9aa9-2eb32b3ed4c6",
                        "glosses": [
                            "een aardige vriendelijke manier van doen hebbend"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b60976bb-f234-3585-8ad5-4ab4f1ed004d",
                        "entry_id": "2764aa01-0419-3798-9aa9-2eb32b3ed4c6",
                        "glosses": [
                            "een combinatie van alle hierboven genoemde eigenschappen hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "650586cb-bc5c-4c75-812c-37c2c3070ce0",
                                "sense_id": "b60976bb-f234-3585-8ad5-4ab4f1ed004d",
                                "text": "Het lieftallige meisje bood de koningin bloemen aan namens het dankbare volk."
                            },
                            {
                                "example_id": "afb83a97-686b-48e5-b262-0149a413aee5",
                                "sense_id": "b60976bb-f234-3585-8ad5-4ab4f1ed004d",
                                "text": "Niet veel later kwam er hoog bezoek voor Kevin het Glazen Café. Aan de andere kant van de glazen wand stonden zijn lieftallige vrouw Kim met zoonlief Floyd."
                            },
                            {
                                "example_id": "02a17062-363b-4f7d-91f9-fc010d9b4a7a",
                                "sense_id": "b60976bb-f234-3585-8ad5-4ab4f1ed004d",
                                "text": "Trouwen tijdens de Giro, het is eens wat anders. En als de koers onder een heerlijke lentezon dan toch in het land is, kan je er maar beter van profiteren om onder de nodige publieke belangstelling kiekjes te maken. Dit lieftallig koppel gaf elkaar op de finishlijn van de eerste etappe tussen Arnhem en Nijmegen het jawoord."
                            }
                        ]
                    }
