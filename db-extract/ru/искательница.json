                                        "sense_id": "2be1f3be-cd90-3682-864f-858a1a460914",
                                        "entry_id": "b01958bc-2901-3db3-9667-78d8d7339ea0",
                                        "glosses": [
                                            "In Quidditch or Muggle quidditch, the player who is supposed to catch the snitch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20d67b7d-2a23-4e34-8851-5e1879d936e9",
                        "source_entry_id": "e3c1be15-f573-3fb8-9b25-95068018ee5d",
                        "source_sense_id": "7640e5c8-bdce-3875-8732-24619806a650",
                        "target_lang_word": "searcher",
