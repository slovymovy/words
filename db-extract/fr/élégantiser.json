                ],
                "senses": [
                    {
                        "sense_id": "37a7408e-c929-3031-a82b-0c96dc5407a8",
                        "entry_id": "1dbe2205-8c5f-3559-b657-831d7c079fa6",
                        "glosses": [
                            "Faire devenir élégant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e35ef83-8fc4-4b21-ac53-40926820e0d5",
                                "sense_id": "37a7408e-c929-3031-a82b-0c96dc5407a8",
                                "text": "Mounet Sully travailla avec acharnement à élégantiser sa diction, et il y parvint très vite, il n’avait gardé de son accent méridional que le son un peu gras des r ;"
                            },
                            {
                                "example_id": "ef9da0d6-5048-4e56-b70d-9e8f9c505905",
                                "sense_id": "37a7408e-c929-3031-a82b-0c96dc5407a8",
                                "text": "Il doit se distinguer, s'affiner, s’élégantiser de plus en plus pour parvenir au grand talent, et s’il lui arrive de conserver quelque marque de ses origines bourgeoises, ce ne sera, pensent-ils, qu’à son détriment ;"
                            },
                            {
                                "example_id": "87c44ea6-0aaf-4e34-a72a-11880c84027b",
                                "sense_id": "37a7408e-c929-3031-a82b-0c96dc5407a8",
                                "text": "On pourra mettre des fleurs naturelles ou artificielles au corsage pour l’élégantiser."
                            },
                            {
                                "example_id": "6d9013c7-140b-4d4d-b020-703be4475204",
                                "sense_id": "37a7408e-c929-3031-a82b-0c96dc5407a8",
                                "text": "Une fois mort et enterré le glorieux ballet italien, l'Europe commença à styliser les danses sauvages, à élégantiser les danses exotiques et à moderniser les danses anciennes."
                            }
                        ]
                    }
