                ],
                "senses": [
                    {
                        "sense_id": "909019b6-8e5f-3a0a-b69c-e36097d9f7fe",
                        "entry_id": "c6d7e824-1e71-3d4a-8077-f1a8081f64a8",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24d17d61-335f-4ad1-9077-d7d2d8d318c7",
                                "sense_id": "909019b6-8e5f-3a0a-b69c-e36097d9f7fe",
                                "text": "Frau Christel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "30eb9855-4fcc-4ab0-ac26-87cbc298d341",
                                "sense_id": "909019b6-8e5f-3a0a-b69c-e36097d9f7fe",
                                "text": "Herr Christel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "14bafc86-2503-4691-a73d-6d06131ca6c6",
                                "sense_id": "909019b6-8e5f-3a0a-b69c-e36097d9f7fe",
                                "text": "Die Christels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4fae30f6-13e4-439a-90af-5b7dea95642a",
                                "sense_id": "909019b6-8e5f-3a0a-b69c-e36097d9f7fe",
                                "text": "Der Christel trägt nie die Schals, die die Christel ihm strickt."
                            },
                            {
                                "example_id": "107f8f25-030f-488d-ae6a-b48eaa492956",
                                "sense_id": "909019b6-8e5f-3a0a-b69c-e36097d9f7fe",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Christel kommt, geht der Herr Christel.“"
                            },
                            {
                                "example_id": "436892df-430a-4316-9a1b-aff01c687330",
                                "sense_id": "909019b6-8e5f-3a0a-b69c-e36097d9f7fe",
                                "text": "Christel kommt und geht."
                            },
                            {
                                "example_id": "d4151032-32c0-4b69-91f0-36775fdfb79a",
                                "sense_id": "909019b6-8e5f-3a0a-b69c-e36097d9f7fe",
                                "text": "Christels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
