                    "sense_id": "7ccbfbbb-5b1b-34a0-89b2-092f40f9f90d",
                    "sense_definition": "Op die plaats; niet hier.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn ouders wonen <w>daar</w> in dat witte huis.",
                            "target_lang_translations": {
                                "en": "My parents live <w>there</w> in that white house.",
                                "ru": "Мои родители живут <w>там</w>, в том белом доме.",
                                "pl": "Moi rodzice mieszkają <w>tam</w>, w tym białym domu.",
                                "de": "Meine Eltern wohnen <w>dort</w> in dem weißen Haus.",
                                "fr": "Mes parents habitent <w>là-bas</w>, dans cette maison blanche.",
                                "it": "I miei genitori abitano <w>là</w> in quella casa bianca.",
                                "cs": "Mí rodiče bydlí <w>tam</w> v tom bílém domě.",
                                "tr": "Annemler <w>orada</w>, şu beyaz evde yaşıyorlar.",
                                "es": "Mis padres viven <w>allí</w>, en esa casa blanca."
                            }
                        },
                        {
                            "text": "Leg je jas maar <w>daar</w> op de stoel neer.",
                            "target_lang_translations": {
                                "en": "Just put your coat down <w>there</w> on the chair.",
                                "ru": "Положи куртку <w>туда</w> на стул.",
                                "pl": "Połóż swoją kurtkę <w>tam</w> na krześle.",
                                "de": "Leg deinen Mantel einfach <w>da</w> auf den Stuhl.",
                                "fr": "Pose donc ton manteau <w>là</w>, sur la chaise.",
                                "it": "Appoggia pure la tua giacca <w>lì</w> sulla sedia.",
                                "cs": "Polož si kabát klidně <w>tamhle</w> na židli.",
                                "tr": "Ceketini <w>oraya</w>, sandalyenin üzerine bırakıver.",
                                "es": "Deja tu abrigo <w>ahí</w> en la silla."
                            }
                        },
                        {
                            "text": "Kijk, <w>daar</w> komt de bus al aan.",
                            "target_lang_translations": {
                                "en": "Look, <w>there</w> comes the bus already.",
                                "ru": "Смотри, <w>вон</w> уже едет автобус.",
                                "pl": "Patrz, <w>tam</w> już nadjeżdża autobus.",
                                "de": "Schau, <w>da</w> kommt der Bus schon.",
                                "fr": "Regarde, <w>voilà</w> déjà le bus qui arrive.",
                                "it": "Guarda, <w>ecco là</w> che arriva già l'autobus.",
                                "cs": "Podívej, <w>tamhle</w> už jede autobus.",
                                "tr": "Bak, <w>işte</w> otobüs geliyor bile.",
                                "es": "Mira, <w>allá</w> viene ya el autobús."
                            }
                        }
