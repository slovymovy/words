                    {
                        "translation_id": "cda59fcc-9c73-43bb-8ce1-d38578852d1d",
                        "source_entry_id": "c8fe5a24-ef29-34ca-b961-1be5a393004c",
                        "source_sense_id": "d485e7c5-13ce-396a-9160-9951e2774e75",
                        "source_sense_description": "inwoner van Ierland, of iemand afkomstig uit Ierland",
                        "target_lang_word": "Irishman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Irishman",
