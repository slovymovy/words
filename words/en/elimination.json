                },
                {
                    "sense_id": "e6e72c4e-6b07-392b-94c9-185c3de8cb52",
                    "sense_definition": "A mathematical method used to solve a system of equations by removing variables.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher explained how to use the method of <w>elimination</w> to solve for x and y.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил, как использовать метод <w>исключения</w>, чтобы найти x и y.",
                                "zh": "老师讲解了如何使用<w>消元</w>法求解 x 和 y。"
                            }
                        },
                        {
                            "text": "Gaussian <w>elimination</w> is a fundamental algorithm used in linear algebra.",
                            "target_lang_translations": {
                                "ru": "<w>Исключение</w> по Гауссу — это фундаментальный алгоритм, используемый в линейной алгебре.",
                                "zh": "高斯<w>消元法</w>是线性代数中使用的基本算法。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "method of elimination",
                        "Gaussian elimination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Математический метод решения системы уравнений путем удаления переменных.",
                        "zh": "通过消去变量来解方程组的数学方法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исключение",
                                "target_lang_sense_clarification": "переменных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消元",
