                {
                    "sense_id": "b5149c0f-81e8-323d-b655-496ab36d7072",
                    "sense_definition": "Happening or occurring as a direct result of a previous event or action.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "temporal_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ensuing</w> chaos made it impossible for the police to control the crowd.",
                            "target_lang_translations": {
                                "ru": "<w>Последующий</w> хаос сделал невозможным для полиции контроль над толпой."
                            }
                        },
                        {
                            "text": "He apologized for his mistake and the <w>ensuing</w> problems it caused for the team.",
                            "target_lang_translations": {
                                "ru": "Он извинился за свою ошибку и <w>вытекающие</w> проблемы, которые она создала для команды."
