                                                "sense_id": "dff99c7e-66bf-3661-9dda-544cc710d2eb",
                                                "text": "Die anderen Vereinsmitglieder reagierten missgelaunt auf den Vorschlag, auch Bewohner des Nachbardorfes aufzunehmen."
                                            },
                                            {
                                                "example_id": "3018e8e6-9a03-4244-a4f9-f7e2599ddc6f",
                                                "sense_id": "dff99c7e-66bf-3661-9dda-544cc710d2eb",
                                                "text": "Mein pubertierender Sohn ist permanent missgelaunt."
                                            },
                                            {
                                                "example_id": "476eb673-ac1a-48d4-9541-797f5886aa41",
                                                "sense_id": "dff99c7e-66bf-3661-9dda-544cc710d2eb",
                                                "text": "Sie sah ja nicht immer so aus wie Großbritanniens oberste Mamsell, wie eine leicht missgelaunt, schwarzgekleidet herumsitzende Unke."
                                            }
