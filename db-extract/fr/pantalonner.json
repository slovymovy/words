                ],
                "senses": [
                    {
                        "sense_id": "3b73406c-3b7b-3dcd-a7c9-b18b05ab9d99",
                        "entry_id": "ec0a2ec5-c5d5-39f4-81ac-025b5c16deec",
                        "glosses": [
                            "Garnir un fût de cercles d’un bout à l’autre, sans laisser aucun espace vide sur le bouge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f35077f-3bdf-4fd4-afc8-a72f708418c9",
                                "sense_id": "3b73406c-3b7b-3dcd-a7c9-b18b05ab9d99",
                                "text": "Pantalonner un fût, c’est le garnir de cercles d’un bout à l’autre, sans laisser aucun espace vide sur le bouge."
                            }
                        ]
                    },
                    {
                        "sense_id": "df5c688d-5e96-3f65-8d7b-e92f7535904e",
                        "entry_id": "ec0a2ec5-c5d5-39f4-81ac-025b5c16deec",
                        "glosses": [
                            "Mettre un pantalon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54664b1e-98cc-4181-94ce-fe7a84c8e2e0",
                                "sense_id": "df5c688d-5e96-3f65-8d7b-e92f7535904e",
                                "text": "Je ne risque pas de me pantalonner comme toutes ces garçonnes, cacher la paire de ciseaux que mon créateur m’a donnée."
                            }
                        ]
                    },
                    {
                        "sense_id": "41cbe8f3-7f01-3201-b277-7b093e9fbc75",
                        "entry_id": "ec0a2ec5-c5d5-39f4-81ac-025b5c16deec",
                        "glosses": [
                            "Se livrer à des pantalonnades."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c4521a0-63e1-495c-84cd-5ccd2dced0c7",
                                "sense_id": "41cbe8f3-7f01-3201-b277-7b093e9fbc75",
                                "text": "Tu passes tes soirées et tes nuits dans des cafés !\n— Oh ! des cafés !\n— Enfin, dans des restaurants … dans des bars! … à jouer aux dés, à boire du whisky, en pantalonnant pour la joie d'une bande de polissons! …"
                            }
                        ]
                    }
