                                                "sense_id": "1dfc7aad-3016-3aae-90ab-ab153aeff59d",
                                                "text": "Hij spelt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba841cc4-31ee-3776-8d1c-a76db60637a1",
                                        "entry_id": "b46e245e-6a1a-3ff8-b3c6-43871402bb7a",
                                        "glosses": [
                                            "gebiedende wijs meervoud van spellen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fab0d3fe-d9dc-4dec-9713-9262946818f7",
                                                "sense_id": "ba841cc4-31ee-3776-8d1c-a76db60637a1",
                                                "text": "Spelt!"
                                            },
                                            {
                                                "example_id": "4d33aeaf-5221-4653-a3e5-98c99f4a9127",
                                                "sense_id": "ba841cc4-31ee-3776-8d1c-a76db60637a1",
                                                "text": "Hij vertelt dat hij leert lezen in groep 3 en hij kan dat ook laten zien. Hij spelt onderweg reclameborden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5dd4846-a358-46a0-853f-38fb2d9d37ee",
