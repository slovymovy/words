                ],
                "translations": [
                    {
                        "translation_id": "2c0230fb-4e99-43be-b41d-4145cdcca74b",
                        "source_entry_id": "1c2db288-45ba-3d52-b29d-a25aaeb2ed3b",
                        "target_lang_word": "whimsical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whimsical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acc660e1-775b-325a-b533-8068e59124ef",
                                        "entry_id": "3a825a4a-0db3-3fab-b21b-17a19064d00c",
                                        "glosses": [
                                            "Given to whimsy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d41817-3b03-4038-80e8-9e1449ce2c2d",
                                                "sense_id": "acc660e1-775b-325a-b533-8068e59124ef",
                                                "text": "Even the putatively innocuous whimsical shapes and designs of cakes and pastry, notably in Central Europe, retain to this day the phallic concept[.]"
                                            },
                                            {
                                                "example_id": "7f1be125-a60e-4ab3-9aa7-d0f67425a084",
                                                "sense_id": "acc660e1-775b-325a-b533-8068e59124ef",
                                                "text": "There is nothing innocuous, innocent or whimsical in a Totalitarian society, at least in the public sphere."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "579206d6-126c-4cdc-92c8-be1a93ee8468",
                        "source_entry_id": "1c2db288-45ba-3d52-b29d-a25aaeb2ed3b",
                        "target_lang_word": "capricious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capricious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b75416f9-2ae0-3c40-bcb8-79466ede1839",
                                        "entry_id": "523a41c1-9ed8-3f1f-bd74-d5473cd1db43",
                                        "glosses": [
                                            "Impulsive and unpredictable; determined by chance, impulse, or whim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f547e6ac-619c-4ad1-9e0f-5db1a65fcc5c",
                                                "sense_id": "b75416f9-2ae0-3c40-bcb8-79466ede1839",
                                                "text": "I almost died in a capricious winter storm."
                                            },
                                            {
                                                "example_id": "18399f7f-61a1-4504-86f4-011a25d88e85",
                                                "sense_id": "b75416f9-2ae0-3c40-bcb8-79466ede1839",
                                                "text": "Stringent rulers are unlikely to act capriciously."
                                            },
                                            {
                                                "example_id": "91f79306-c73b-46e1-898f-a78553365dad",
                                                "sense_id": "b75416f9-2ae0-3c40-bcb8-79466ede1839",
                                                "text": "I am heere with thee, and thy Goats, as the moſt capricious Poet honeſt Ouid was among Gothes."
                                            },
                                            {
                                                "example_id": "0abd0bf3-5b3c-41d5-be6a-66cc5683db76",
                                                "sense_id": "b75416f9-2ae0-3c40-bcb8-79466ede1839",
                                                "text": "\"Capricious?\" And at this monsieur began to laugh. \"Oh no, I'm not capricious. I am very faithful. I am very constant. Comprenez?\""
                                            },
                                            {
                                                "example_id": "7a509b2c-e74b-4b24-9973-e28bc94120de",
                                                "sense_id": "b75416f9-2ae0-3c40-bcb8-79466ede1839",
                                                "text": "Although much has been learned about lightning and its effects through research and study, many questions are still unanswered and the upper limits of voltage, current and total energy that may be associated with lightning are not conclusively defined. The apparent capricious nature of lightning is evidenced by the range of extremes as well as, in some cases, the unique nature of the damage that results. Thus, to predict in the absence of physical evidence the exact mechanism of ignition in this particular case is not possible. By the same reasoning, in view of the known facts of this accident, there is no logical explanation for ignition of the flammable vapors other than some effect stemming directly from the lightning strike."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
