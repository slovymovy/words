{
    "word_family": [
        "gnaw"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8a72e67-1113-3015-a310-057faafaae39",
                    "sense_definition": "present participle and gerund of <w>gnaw</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog was <w>gnawing</w> on a large bone in the backyard.",
                            "target_lang_translations": {
                                "cs": "Pes na dvoře <w>ohlodával</w> velkou kost.",
                                "nl": "De hond zat in de achtertuin op een groot bot te <w>knagen</w>."
                            }
                        },
                        {
                            "text": "Constant <w>gnawing</w> at the wood caused the chair to break.",
                            "target_lang_translations": {
                                "cs": "Neustálé <w>hlodání</w> do dřeva způsobilo, že se židle rozbila.",
                                "nl": "Door voortdurend <w>geknaag</w> aan het hout brak de stoel."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gnawing on bone",
                        "gnawing at wood"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "přítomné příčestí a gerundium slovesa hlodat nebo ohlodávat",
                        "nl": "tegenwoordig deelwoord en gerundium van knagen; verwijst naar het herhaaldelijk met de tanden bijten of knabbelen"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hlodající",
                                "target_lang_sense_clarification": "vyjadřuje probíhající činnost hlodání"
                            },
                            {
                                "target_lang_word": "ohlodávání",
                                "target_lang_sense_clarification": "podstatné jméno slovesné označující proces"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "knagend",
                                "target_lang_sense_clarification": "tegenwoordig deelwoord: iets al knagend doen"
                            },
                            {
                                "target_lang_word": "het knagen",
                                "target_lang_sense_clarification": "gerundium of zelfstandig gebruikt proceswoord"
                            },
                            {
                                "target_lang_word": "geknaag",
                                "target_lang_sense_clarification": "zelfstandig naamwoord voor het herhaaldelijk knagen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c79f00bb-12c7-3580-9b73-3a1a7db2b32f",
                    "sense_definition": "severe or intense",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a <w>gnawing</w> anxiety about the upcoming exam.",
                            "target_lang_translations": {
                                "cs": "Cítila <w>hlodavou</w> úzkost z nadcházející zkoušky.",
                                "nl": "Ze voelde een <w>knagende</w> angst voor het komende examen."
                            }
                        },
                        {
                            "text": "The prisoner suffered from a <w>gnawing</w> hunger during the long winter.",
                            "target_lang_translations": {
                                "cs": "Vězeň během dlouhé zimy trpěl <w>žíravým</w> hladem.",
                                "nl": "De gevangene leed tijdens de lange winter aan een <w>knagende</w> honger."
                            }
                        }
                    ],
                    "synonyms": [
                        "persistent",
                        "tormenting",
                        "unrelenting"
                    ],
                    "common_phrases": [
                        "gnawing hunger",
                        "gnawing anxiety",
                        "gnawing doubt"
                    ],
                    "target_lang_definitions": {
                        "cs": "intenzivní, trýznivý nebo neustupující pocit",
                        "nl": "zeer intens of aanhoudend, vooral van een pijnlijk, verontrustend of ongemakkelijk gevoel"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žíravý",
                                "target_lang_sense_clarification": "přenesený význam pro intenzivní, nepříjemný pocit"
                            },
                            {
                                "target_lang_word": "trýznivý",
                                "target_lang_sense_clarification": "vyjadřuje intenzivní psychickou nebo fyzickou bolest"
                            },
                            {
                                "target_lang_word": "hlodavý",
                                "target_lang_sense_clarification": "používá se pro pocity, které člověka vnitřně sužují"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "knagend",
                                "target_lang_sense_clarification": "meest gebruikelijk voor een aanhoudend, innerlijk pijnlijk gevoel"
                            },
                            {
                                "target_lang_word": "kwellend",
                                "target_lang_sense_clarification": "sterk pijnigend of mentaal belastend"
                            },
                            {
                                "target_lang_word": "nijpend",
                                "target_lang_sense_clarification": "vooral bij honger, gebrek of nood"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a8e63dd-8238-3fb4-8ada-22045ac373a1",
                    "sense_definition": "a persistent, uncomfortable sensation or feeling",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He could not ignore the <w>gnawings</w> of his conscience after the argument.",
                            "target_lang_translations": {
                                "cs": "Po té hádce nemohl ignorovat <w>výčitky</w> svého svědomí.",
                                "nl": "Na de ruzie kon hij de <w>wroegingen</w> van zijn geweten niet negeren."
                            }
                        },
                        {
                            "text": "The <w>gnawings</w> of starvation made it impossible for them to sleep.",
                            "target_lang_translations": {
                                "cs": "Kvůli <w>svírání</w> hladem nemohli spát.",
                                "nl": "De <w>hongerkrampen</w> maakten het onmogelijk voor hen om te slapen."
                            }
                        }
                    ],
                    "synonyms": [
                        "pang",
                        "ache",
                        "twinge"
                    ],
                    "common_phrases": [
                        "gnawings of conscience",
                        "gnawings of hunger"
                    ],
                    "target_lang_definitions": {
                        "cs": "přetrvávající, nepříjemný vnitřní pocit nebo nutkání",
                        "nl": "een aanhoudend, onaangenaam innerlijk gevoel of een voortdurende fysieke of mentale kwelling"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "výčitky",
                                "target_lang_sense_clarification": "ve spojení s vědomím (svědomím)"
                            },
                            {
                                "target_lang_word": "svírání",
                                "target_lang_sense_clarification": "fyzický pocit úzkosti nebo hladu"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "knaging",
                                "target_lang_sense_clarification": "algemene literaire of formele term voor een innerlijk knagend gevoel"
                            },
                            {
                                "target_lang_word": "wroeging",
                                "target_lang_sense_clarification": "vooral bij schuldgevoel of geweten"
                            },
                            {
                                "target_lang_word": "hongerkramen",
                                "target_lang_sense_clarification": "voor lichamelijk onaangenaam, aanhoudend gevoel zoals honger"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b776b21-e715-3ca2-baaa-a75d1553a9b8",
                    "sense_definition": "the physical process of biting or chewing something repeatedly",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gnawings</w> of the mice left holes in the wooden floorboards.",
                            "target_lang_translations": {
                                "cs": "Po <w>hlodání</w> myší zůstaly v dřevěných podlahových prknech díry.",
                                "nl": "Het <w>geknaag</w> van de muizen liet gaten achter in de houten vloerplanken."
                            }
                        },
                        {
                            "text": "Constant <w>gnawings</w> by the beaver eventually brought the tree down.",
                            "target_lang_translations": {
                                "cs": "Neustálé <w>okusování</w> bobrem nakonec strom porazilo.",
                                "nl": "Voortdurend <w>geknaag</w> door de bever deed de boom uiteindelijk omvallen."
                            }
                        }
                    ],
                    "synonyms": [
                        "chewing",
                        "nibbling"
                    ],
                    "common_phrases": [
                        "gnawings of mice"
                    ],
                    "target_lang_definitions": {
                        "cs": "fyzický proces opakovaného kousání nebo okusování",
                        "nl": "het fysieke proces waarbij iets herhaaldelijk wordt gebeten of gekauwd, zodat er geleidelijk stukjes afgaan"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hlodání",
                                "target_lang_sense_clarification": "obecný proces kousání zuby"
                            },
                            {
                                "target_lang_word": "okusování",
                                "target_lang_sense_clarification": "postupné ukusování malých kousků"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "geknaag",
                                "target_lang_sense_clarification": "algemene term voor het fysieke proces van herhaaldelijk knagen"
                            },
                            {
                                "target_lang_word": "het knagen",
                                "target_lang_sense_clarification": "het proces zelf, meer verbaal geformuleerd"
                            },
                            {
                                "target_lang_word": "afknabbelen",
                                "target_lang_sense_clarification": "wanneer er kleine stukjes worden afgebeten of weggeknaagd"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}