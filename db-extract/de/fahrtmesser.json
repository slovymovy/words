                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "1a6eff31-e745-430f-9e22-e47c2700914e",
                                "sense_id": "764802c9-05ea-31d9-822b-c152b993a5ef",
                                "text": "„In diesem Fachbeitrag erklären wir, wie der Fahrtmesser (Geschwindigkeitsmesser) bei einem Flugzeug funktioniert.“"
                            },
                            {
                                "example_id": "67485b15-3ba3-4e62-9e42-cbf7e28b3500",
                                "sense_id": "764802c9-05ea-31d9-822b-c152b993a5ef",
                                "text": "„Als er mit seinem Düsenjäger vom Typ Me 262 im Sturzflug einem Kameraden zu Hilfe kommen wollte, habe er typische Überschalleffekte gespürt. Bolzen seien aus den Tragflächen geflogen, der Fahrtmesser sei bei 1100 Kilometern pro Stunde stehen geblieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
