                ],
                "senses": [
                    {
                        "sense_id": "eb5c8b14-8e00-3e0c-a1f9-7d8feeedf0b2",
                        "entry_id": "53ade344-38fe-3829-b7ef-5e8e893efa62",
                        "glosses": [
                            "ein über oder hinter dem Altar aufgestellter oder befestigter Aufsatz, der künstlerisch ausgestaltet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0754f25a-72ee-4348-84a5-e2985c0185b9",
                                "sense_id": "eb5c8b14-8e00-3e0c-a1f9-7d8feeedf0b2",
                                "text": "Ein Altarretabel kann entweder direkt auf die Mensa (Tischfläche) des Altars aufgesetzt, auf einem separaten Unterbau hinter dem Altartisch aufgestellt, an der Wand hinter dem Altar befestigt ist oder auch an die Chorwand gemalt sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d549a23e-70c6-4a20-b3c0-f6b7186fe6fe",
                        "source_entry_id": "53ade344-38fe-3829-b7ef-5e8e893efa62",
                        "source_sense_id": "eb5c8b14-8e00-3e0c-a1f9-7d8feeedf0b2",
                        "source_sense_description": "ein über/hinter dem Altar aufgestellter oder befestigter Aufsatz, der künstlerisch ausgestaltet ist",
                        "target_lang_word": "reredos",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reredos",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74191629-f017-339e-bf11-e3446736b15c",
                                        "entry_id": "bdad7e90-a27a-3608-a143-383fd000301b",
                                        "glosses": [
                                            "A screen or decoration behind the altar in a church, usually depicting religious iconography or images, akin to the iconostasis of the Eastern Churches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c89ecc7f-450b-4bde-9a81-edb34cfb73d2",
                                                "sense_id": "74191629-f017-339e-bf11-e3446736b15c",
                                                "text": "A bad reredos will ruin the best church ever designed; and, although a good reredos cannot convert a bad church into a good one, it may do much to lessen the offensiveness of its badness."
                                            },
                                            {
                                                "example_id": "a1052be4-46e2-4ec4-b6c3-69179439c32d",
                                                "sense_id": "74191629-f017-339e-bf11-e3446736b15c",
                                                "text": "Confusion has reigned in scholarly interpretation, however, because the dark-colored leaves have shown through the succeeding coats of paint across the reredos, interfering with the later scenes."
                                            },
                                            {
                                                "example_id": "a0f9e874-3758-4c23-a12c-4c3490c3ea23",
                                                "sense_id": "74191629-f017-339e-bf11-e3446736b15c",
                                                "text": "There seem to be no remains of wooden reredoses of the fourteenth century, though there are a number of examples in stone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52a8ee61-4a45-3d69-9197-1671e45280d7",
                                        "entry_id": "bdad7e90-a27a-3608-a143-383fd000301b",
                                        "glosses": [
                                            "The back of an open fire-hearth, in medieval halls."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
