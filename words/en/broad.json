{
    "word_family": [
        "broaden",
        "broadly",
        "broadness",
        "breadth",
        "broadcast"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4e2034b7-679a-3672-8450-6b437f605b2e",
                    "sense_definition": "Having a large distance from side to side; wide.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_width",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river is very <w>broad</w> at this point, making it difficult to swim across.",
                            "target_lang_translations": {
                                "ru": "Река в этом месте очень <w>широкая</w>, поэтому её трудно переплыть.",
                                "tr": "Nehir bu noktada çok <w>geniş</w>, bu yüzden karşıya yüzmek zor.",
                                "zh": "这条河在这一点非常<w>宽</w>，很难游过去。"
                            }
                        },
                        {
                            "text": "He has <w>broad</w> shoulders from years of swimming and heavy lifting.",
                            "target_lang_translations": {
                                "ru": "У него <w>широкие</w> плечи после многих лет занятий плаванием и тяжелой атлетикой.",
                                "tr": "Yıllarca yüzme ve ağırlık kaldırmadan dolayı <w>geniş</w> omuzları var.",
                                "zh": "经过多年的游泳和举重训练，他的肩膀很<w>宽</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wide"
                    ],
                    "antonyms": [
                        "narrow",
                        "thin"
                    ],
                    "common_phrases": [
                        "broad shoulders",
                        "broad expanse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий большое расстояние от края до края; широкий.",
                        "tr": "Bir taraftan diğer tarafa olan mesafesi büyük olan; geniş.",
                        "zh": "指从一侧到另一侧的距离很大；宽阔的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "широкий",
                                "target_lang_sense_clarification": "о физическом расстоянии"
                            },
                            {
                                "target_lang_word": "обширный",
                                "target_lang_sense_clarification": "о пространстве"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geniş",
                                "target_lang_sense_clarification": "fiziksel mesafe veya en için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宽",
                                "target_lang_sense_clarification": "指物理宽度"
                            },
                            {
                                "target_lang_word": "宽阔",
                                "target_lang_sense_clarification": "形容空间或面积大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64cadea5-ff11-386a-86cb-8d15303c9219",
                    "sense_definition": "Covering a wide range of things; general rather than specific.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two parties are in <w>broad</w> agreement on the main goals of the project.",
                            "target_lang_translations": {
                                "ru": "Стороны достигли <w>общего</w> согласия по основным целям проекта.",
                                "tr": "İki taraf, projenin ana hedefleri konusunda <w>genel</w> bir anlaşma içinde.",
                                "zh": "双方对该项目的主要目标达成了<w>广泛</w>共识。"
                            }
                        },
                        {
                            "text": "She gave a <w>broad</w> outline of the plan without going into too much detail.",
                            "target_lang_translations": {
                                "ru": "Она изложила план в <w>общих</w> чертах, не вдаваясь в подробности.",
                                "tr": "Çok fazla detaya girmeden planın <w>genel</w> bir taslağını sundu.",
                                "zh": "她对计划做了<w>大体</w>概述，没有深入细节。"
                            }
                        }
                    ],
                    "synonyms": [
                        "general",
                        "wide-ranging"
                    ],
                    "antonyms": [
                        "narrow"
                    ],
                    "common_phrases": [
                        "broad agreement",
                        "broad outline",
                        "broad range"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охватывающий широкий круг вещей; общий, а не конкретный.",
                        "tr": "Geniş bir alanı kapsayan; özelden ziyade genel olan.",
                        "zh": "涵盖范围广；指大体上的，而非具体的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общий",
                                "target_lang_sense_clarification": "не детализированный"
                            },
                            {
                                "target_lang_word": "широкий",
                                "target_lang_sense_clarification": "о круге вопросов или согласии"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "genel",
                                "target_lang_sense_clarification": "detaylandırılmamış, genel hatlarıyla"
                            },
                            {
                                "target_lang_word": "geniş",
                                "target_lang_sense_clarification": "kapsam veya uzlaşı için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大体",
                                "target_lang_sense_clarification": "指不详细的"
                            },
                            {
                                "target_lang_word": "广泛",
                                "target_lang_sense_clarification": "指范围或共识"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a35f3ea-dabc-3737-8ecf-b719907207fb",
                    "sense_definition": "Comprehensive or inclusive in scope or content.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university offers a <w>broad</w> curriculum that includes both arts and sciences.",
                            "target_lang_translations": {
                                "ru": "Университет предлагает <w>широкую</w> учебную программу, включающую как гуманитарные, так и естественные науки.",
                                "tr": "Üniversite, hem sanat hem de bilim dallarını içeren <w>kapsamlı</w> bir müfredat sunmaktadır.",
                                "zh": "大学提供<w>广泛</w>的课程，涵盖文科和理科。"
                            }
                        },
                        {
                            "text": "We need to take a <w>broad</w> view of the situation to understand all the factors.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>шире</w> взглянуть на ситуацию, чтобы понять все факторы.",
                                "tr": "Tüm faktörleri anlamak için duruma daha <w>geniş</w> bir açıdan bakmamız gerekiyor.",
                                "zh": "我们需要<w>全面</w>地看待局势，才能理解所有因素。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comprehensive",
                        "all-encompassing",
                        "inclusive"
                    ],
                    "antonyms": [
                        "narrow",
                        "comprehensive"
                    ],
                    "common_phrases": [
                        "broad curriculum",
                        "broad view"
                    ],
                    "target_lang_definitions": {
                        "ru": "Всеобъемлющий или инклюзивный по охвату или содержанию.",
                        "tr": "Kapsam veya içerik bakımından kapsamlı, çok yönlü.",
                        "zh": "在范围或内容上是全面或包容的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "широкий",
                                "target_lang_sense_clarification": "разносторонний"
                            },
                            {
                                "target_lang_word": "всесторонний",
                                "target_lang_sense_clarification": "охватывающий всё"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geniş",
                                "target_lang_sense_clarification": "çeşitlilik içeren, kapsamlı"
                            },
                            {
                                "target_lang_word": "kapsamlı",
                                "target_lang_sense_clarification": "her şeyi içeren"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "广泛",
                                "target_lang_sense_clarification": "指内容多样"
                            },
                            {
                                "target_lang_word": "全面",
                                "target_lang_sense_clarification": "指涵盖所有方面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "644b88e8-0432-3c76-af04-15a3044c4034",
                    "sense_definition": "Relating to a strong or very noticeable regional accent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even after living in London for years, he still speaks with a <w>broad</w> Yorkshire accent.",
                            "target_lang_translations": {
                                "ru": "Даже прожив в Лондоне много лет, он всё ещё говорит с <w>сильным</w> йоркширским акцентом.",
                                "tr": "Yıllarca Londra'da yaşamasına rağmen hâlâ <w>ağır</w> bir Yorkshire aksanıyla konuşuyor.",
                                "zh": "即使在伦敦住了多年，他说话时仍带有<w>浓重</w>的约克郡口音。"
                            }
                        },
                        {
                            "text": "It was hard to understand his <w>broad</w> Scottish dialect at first.",
                            "target_lang_translations": {
                                "ru": "Поначалу было трудно понять его <w>грубый</w> шотландский диалект.",
                                "tr": "İlk başta onun <w>ağır</w> İskoç diyalektini anlamak zordu.",
                                "zh": "起初很难听懂他那<w>浓重</w>的苏格兰方言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strong",
                        "thick"
                    ],
                    "common_phrases": [
                        "broad accent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к сильному или очень заметному региональному акценту.",
                        "tr": "Güçlü veya belirgin bir bölgesel aksanla ilgili.",
                        "zh": "指非常明显或强烈的地区口音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сильный",
                                "target_lang_sense_clarification": "об акценте"
                            },
                            {
                                "target_lang_word": "ярко выраженный",
                                "target_lang_sense_clarification": "о диалекте"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ağır",
                                "target_lang_sense_clarification": "aksan veya şive için"
                            },
                            {
                                "target_lang_word": "belirgin",
                                "target_lang_sense_clarification": "güçlü aksan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浓重",
                                "target_lang_sense_clarification": "形容口音或方言"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51980a26-9c2e-3d9b-ac59-fd2e17986570",
                    "sense_definition": "Very clear, obvious, or easy to see.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave me a <w>broad</w> hint that he wanted to leave the party early.",
                            "target_lang_translations": {
                                "ru": "Он <w>ясно</w> намекнул мне, что хочет уйти с вечеринки пораньше.",
                                "tr": "Partiden erken ayrılmak istediğine dair bana <w>açık</w> bir imada bulundu.",
                                "zh": "他向我<w>明确</w>暗示他想早点离开聚会。"
                            }
                        },
                        {
                            "text": "The robbery took place in <w>broad</w> daylight with many witnesses around.",
                            "target_lang_translations": {
                                "ru": "Ограбление произошло среди <w>бела</w> дня на глазах у множества свидетелей.",
                                "tr": "Soygun, etrafta birçok tanık varken <w>gün</w> ortasında gerçekleşti.",
                                "zh": "抢劫案发生在<w>大白</w>天，周围有许多目击者。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obvious",
                        "plain",
                        "evident"
                    ],
                    "common_phrases": [
                        "broad hint",
                        "broad daylight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень ясный, очевидный или легко заметный.",
                        "tr": "Çok açık, net veya kolayca görülebilir.",
                        "zh": "非常清晰、明显或容易看见。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "явный",
                                "target_lang_sense_clarification": "очевидный"
                            },
                            {
                                "target_lang_word": "белый",
                                "target_lang_sense_clarification": "в выражении 'среди бела дня'"
                            },
                            {
                                "target_lang_word": "прозрачный",
                                "target_lang_sense_clarification": "о намеке"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "açık",
                                "target_lang_sense_clarification": "ima veya üstü kapalı olmayan durumlar için"
                            },
                            {
                                "target_lang_word": "gün",
                                "target_lang_sense_clarification": "'gün ortasında' (broad daylight) kalıbında"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "明确",
                                "target_lang_sense_clarification": "指暗示或意图"
                            },
                            {
                                "target_lang_word": "大白",
                                "target_lang_sense_clarification": "用于“大白天”"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb924b24-99f9-3e23-942c-bea284f9049c",
                    "sense_definition": "Coarse, crude, or lacking in delicacy; often referring to humor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian is known for his <w>broad</w> humor which some people find offensive.",
                            "target_lang_translations": {
                                "ru": "Комик известен своим <w>грубым</w> юмором, который некоторые находят оскорбительным.",
                                "tr": "Komedyen, bazı insanların kırıcı bulduğu <w>kaba</w> mizahıyla tanınır.",
                                "zh": "这位喜剧演员以其<w>粗俗</w>的幽默而闻名，有些人觉得这很冒犯。"
                            }
                        },
                        {
                            "text": "He told a <w>broad</w> joke that made several guests feel uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Он рассказал <w>пошлую</w> шутку, из-за которой некоторые гости почувствовали себя неловко.",
                                "tr": "Birkaç konuğu rahatsız eden <w>açık saçık</w> bir fıkra anlattı.",
                                "zh": "他讲了一个<w>下流</w>的笑话，让几位客人感到不舒服。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coarse",
                        "gross",
                        "vulgar"
                    ],
                    "common_phrases": [
                        "broad humor",
                        "broad joke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубый, вульгарный или лишенный деликатности; часто относится к юмору.",
                        "tr": "Kaba, vulgar veya incelikten yoksun; genellikle mizah için kullanılır.",
                        "zh": "粗俗、粗鲁或缺乏细腻；常指幽默。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грубый",
                                "target_lang_sense_clarification": "о юморе"
                            },
                            {
                                "target_lang_word": "пошлый",
                                "target_lang_sense_clarification": "вульгарный"
                            },
                            {
                                "target_lang_word": "непристойный",
                                "target_lang_sense_clarification": "о шутках"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kaba",
                                "target_lang_sense_clarification": "mizah veya espri için"
                            },
                            {
                                "target_lang_word": "açık saçık",
                                "target_lang_sense_clarification": "müstehcen mizah"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粗俗",
                                "target_lang_sense_clarification": "指幽默或笑话"
                            },
                            {
                                "target_lang_word": "下流",
                                "target_lang_sense_clarification": "指不雅的言语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "595b006c-af96-371e-b6fd-cf05e12dc9ba",
                    "sense_definition": "In phonetics, describing a sound that is velarized rather than palatalized.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Irish phonology, consonants are often categorized as either <w>broad</w> or slender.",
                            "target_lang_translations": {
                                "ru": "В ирландской фонологии согласные часто делятся на <w>твёрдые</w> и мягкие.",
                                "tr": "İrlanda ses bilgisinde ünsüzler genellikle <w>kalın</w> veya ince olarak sınıflandırılır.",
                                "zh": "在爱尔兰语语音学中，辅音通常分为<w>硬</w>辅音或软辅音。"
                            }
                        },
                        {
                            "text": "The <w>broad</w> pronunciation of the consonant changes the meaning of the word.",
                            "target_lang_translations": {
                                "ru": "<w>Твёрдое</w> произношение согласного меняет значение слова.",
                                "tr": "Ünsüzün <w>kalın</w> telaffuzu kelimenin anlamını değiştirir.",
                                "zh": "辅音的<w>硬</w>发音会改变单词的意思。"
                            }
                        }
                    ],
                    "synonyms": [
                        "velarized"
                    ],
                    "antonyms": [
                        "slender"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical linguistic term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В фонетике: описывает звук, который является веляризованным, а не палатализованным (твердым).",
                        "tr": "Ses bilgisinde, damaksıllaşmamış (artdamaksıl) bir sesi tanımlar; kalın.",
                        "zh": "在语音学中，描述一种软腭化而非腭化的发音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "твёрдый",
                                "target_lang_sense_clarification": "о согласном звуке"
                            },
                            {
                                "target_lang_word": "веляризованный",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kalın",
                                "target_lang_sense_clarification": "ünsüz sesler için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "硬",
                                "target_lang_sense_clarification": "指辅音发音"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "92b7fbf6-c802-3dd2-aea6-1586df5b040e",
                    "sense_definition": "A slang term for a woman.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In those old detective movies, they often referred to a woman as a <w>broad</w>.",
                            "target_lang_translations": {
                                "ru": "В тех старых детективных фильмах женщин часто называли <w>бабами</w>.",
                                "tr": "O eski dedektif filmlerinde, bir kadından genellikle <w>karı</w> diye bahsederlerdi.",
                                "zh": "在那些老侦探电影里，他们常把女人称为<w>娘们</w>。"
                            }
                        },
                        {
                            "text": "He told his friends he was going out to meet some <w>broads</w> at the club.",
                            "target_lang_translations": {
                                "ru": "Он сказал друзьям, что идет в клуб познакомиться с какими-нибудь <w>девками</w>.",
                                "tr": "Arkadaşlarına kulüpte birkaç <w>fıstık</w> ile buluşmaya gittiğini söyledi.",
                                "zh": "他告诉朋友们他要去俱乐部见几个<w>娘们</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dame",
                        "chick",
                        "bird"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often considered dated or offensive"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое обозначение женщины.",
                        "tr": "Kadınlar için kullanılan argo bir terim.",
                        "zh": "对女性的俚语称呼。"
                    },
                    "translations": {
                        "ru": [
