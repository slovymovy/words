            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ec54161f-cff6-3821-9b2d-9f2530d403bb",
                    "sense_definition": "bij iemand aan de deur bellen door op de knop van de elektrische deurbel te drukken",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bezoek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je wilt dat iemand de voordeur voor je openmaakt moet je <w>aanbellen</w>.",
                            "target_lang_translations": {
                                "en": "If you want someone to open the front door for you, you have to <w>ring the doorbell</w>."
                            }
                        },
                        {
                            "text": "Ik ga even bij de buren <w>aanbellen</w> om te vragen of ze een pakketje hebben.",
                            "target_lang_translations": {
                                "en": "I'm going to <w>ring</w> at the neighbors' to ask if they have a package."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanschellen",
                        "bellen"
                    ],
                    "common_phrases": [
                        "bij de buren aanbellen",
                        "aan de voordeur aanbellen"
                    ],
                    "target_lang_definitions": {
                        "en": "to ring someone's doorbell by pressing the button of an electric bell"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ring the doorbell",
                                "target_lang_sense_clarification": "to press the button at a door"
                            },
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "to make a bell produce a sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b526e6d-998a-3896-b0f9-b9a67f85d00a",
                    "sense_definition": "aan een mechanische deurbel trekken om deze te laten rinkelen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bezoek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit oude herenhuis moet je nog ouderwets aan een koord <w>aanbellen</w>.",
                            "target_lang_translations": {
                                "en": "In this old mansion, you still have to <w>ring the bell</w> the old-fashioned way by pulling a cord."
                            }
                        },
                        {
                            "text": "Hij <w>belde aan</w> bij de oude boerderij en hoorde een zware metalen bel rinkelen.",
                            "target_lang_translations": {
                                "en": "He <w>rang the bell</w> at the old farmhouse and heard a heavy metal bell ringing."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanschellen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "verwijst naar mechanische belsystemen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to pull a mechanical doorbell to make it ring"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ring the bell",
                                "target_lang_sense_clarification": "to pull or activate a mechanical bell"
                            },
                            {
                                "target_lang_word": "pull the bell",
                                "target_lang_sense_clarification": "specifically for mechanical pull-bells"
                            }
                        ]
                    }
                }
