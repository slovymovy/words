                ],
                "senses": [
                    {
                        "sense_id": "a4e36ea6-c3cc-3494-be87-3b333b2ecae5",
                        "entry_id": "f7e37e41-c257-3681-925d-5ec282bdc855",
                        "glosses": [
                            "To remove a cloak or cover from; to deprive of a cloak or cover; to unmask; to reveal."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "83d648c7-91d8-4f81-8170-61b8c014dd79",
                                "sense_id": "a4e36ea6-c3cc-3494-be87-3b333b2ecae5",
                                "text": "And will none have so much Charity, so much Zeal for publick Concern, as to uncloak this Impostour, and shew the dazled World what it is it thus bows to?"
                            },
                            {
                                "example_id": "dcc7e36a-32b2-494a-9b34-cceab4822e44",
                                "sense_id": "a4e36ea6-c3cc-3494-be87-3b333b2ecae5",
                                "text": "She attended all our guests, most rigorously insisted on uncloaking and unshawling them, whether they would or not; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "5825ad7f-38bc-3591-931e-ce5d63d99086",
                        "entry_id": "f7e37e41-c257-3681-925d-5ec282bdc855",
                        "glosses": [
                            "To remove one's cloak."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dd25a7f1-59d5-4de0-88df-19d20523e6f6",
                                "sense_id": "5825ad7f-38bc-3591-931e-ce5d63d99086",
                                "text": "Nay, but my fireside's not the deck—I am mistress here; so let me uncloak thee.\" She seized his cloak, and, not without a slight resistance on his part, unclasped the collar, and threw it aside."
                            }
                        ]
                    },
                    {
                        "sense_id": "548bcff5-6fad-3012-85fb-e1c32d7dab46",
                        "entry_id": "f7e37e41-c257-3681-925d-5ec282bdc855",
                        "glosses": [
                            "To become visible again by turning off a cloaking device."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2d0d3008-2af0-48ed-8ce3-d40b98ef6a43",
                                "sense_id": "548bcff5-6fad-3012-85fb-e1c32d7dab46",
                                "text": "Don't try to target the Klingons as they uncloak, you won't have time. Just use the phasers to make a nofly zone between us and the Takagi."
                            }
                        ]
                    }
                ],
