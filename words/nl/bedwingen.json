            "senses": [
                {
                    "sense_id": "6c77b91a-b847-3c7f-8510-c480d2fe2ce2",
                    "sense_definition": "onder controle houden van emoties, impulsen of gedrag",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beheersing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met veel moeite kon hij zijn woede <w>bedwingen</w> en rustig blijven.",
                            "target_lang_translations": {
                                "en": "With great effort, he was able to <w>control</w> his anger and remain calm."
                            }
                        },
                        {
                            "text": "Je moet je nieuwsgierigheid <w>bedwingen</w> en niet meteen het cadeau openmaken.",
                            "target_lang_translations": {
                                "en": "You must <w>restrain</w> your curiosity and not open the gift immediately."
                            }
                        }
                    ],
                    "synonyms": [
                        "beheersen",
                        "onderdrukken",
                        "inhouden",
                        "intomen"
                    ],
                    "antonyms": [
