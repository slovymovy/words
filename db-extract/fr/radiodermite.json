                ],
                "senses": [
                    {
                        "sense_id": "ee35c6c2-0e3e-3984-8fd4-9e118c3a352e",
                        "entry_id": "73910c57-aaa8-3630-9b47-7c58d9c6f509",
                        "glosses": [
                            "Lésion de la peau ou atteinte d’une muqueuse due à l’absorption excessive de rayons X ou de radiations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5728ce3-4c3a-4f6f-a61b-3bff8c391a45",
                                "sense_id": "ee35c6c2-0e3e-3984-8fd4-9e118c3a352e",
                                "text": "La radiodermite est une complication due à une irradiation."
                            },
                            {
                                "example_id": "c365b9ae-add5-40b4-acee-b30ebe461689",
                                "sense_id": "ee35c6c2-0e3e-3984-8fd4-9e118c3a352e",
                                "text": "Pour répondre à cette question, les chercheurs ont répété l’expérience précédente avec des souris atteintes de radiodermites, des lésions cutanées engendrées par des radiations excessives."
                            },
                            {
                                "example_id": "16fa6630-494d-4d2a-bf82-ab92e3a57786",
                                "sense_id": "ee35c6c2-0e3e-3984-8fd4-9e118c3a352e",
                                "text": "Si l'irradiation est continue, elle peut avoir des effets irréparables, à manifestation souvent tardive: (...) brûlures de la peau ou radiodermites qui, après un certain nombre d'années, peuvent devenir le siège d'un cancer cutané comme chez les premiers radiologistes"
                            }
                        ]
                    }
                ],
