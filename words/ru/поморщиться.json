{
    "word_family": [
        "морщина",
        "морщить",
        "морщинистый"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6cbaac0e-2727-3b1b-bf98-5c4bd2ccc055",
                    "sense_definition": "Сделать гримасу лицом от неудовольствия, боли или отвращения",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>поморщился</w> от резкого запаха лекарства.",
                            "target_lang_translations": {
                                "it": "Lui <w>ha fatto una smorfia</w> per il forte odore della medicina."
                            }
                        },
                        {
                            "text": "Услышав неприятную новость, она слегка <w>поморщилась</w>.",
                            "target_lang_translations": {
                                "it": "Sentendo la brutta notizia, lei <w>ha storto leggermente il naso</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "сморщиться"
                    ],
                    "common_phrases": [
                        "поморщиться от боли",
                        "поморщиться от отвращения"
                    ],
                    "target_lang_definitions": {
                        "it": "Fare una smorfia con il viso per disappunto, dolore o disgusto."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "fare una smorfia",
                                "target_lang_sense_clarification": "espressione generale di disappunto o dolore"
                            },
                            {
                                "target_lang_word": "storcere il naso",
                                "target_lang_sense_clarification": "mostrare disapprovazione o disgusto"
                            },
                            {
                                "target_lang_word": "contrarsi",
                                "target_lang_sense_clarification": "riferito ai muscoli del viso per dolore"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f33a0bdd-d73d-3c74-9493-a90f98bc3ff7",
                    "sense_definition": "Покрыться складками, стать неровным или съёжиться",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "surface_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От долгого пребывания в воде кожа на пальцах <w>поморщилась</w>.",
                            "target_lang_translations": {
                                "it": "Dopo essere rimasta a lungo nell'acqua, la pelle delle dita si è <w>raggrinzita</w>."
                            }
                        },
                        {
                            "text": "Старая бумага на солнце <w>поморщилась</w> и пожелтела.",
                            "target_lang_translations": {
                                "it": "La vecchia carta al sole si è <w>raggrinzita</w> ed è ingiallita."
                            }
                        }
                    ],
                    "synonyms": [
                        "сморщиться"
                    ],
                    "target_lang_definitions": {
                        "it": "Coprirsi di pieghe, diventare irregolare o raggrinzirsi."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "raggrinzirsi",
                                "target_lang_sense_clarification": "diventare pieno di grinze o pieghe"
                            },
                            {
                                "target_lang_word": "accartocciarsi",
                                "target_lang_sense_clarification": "riferito a carta o materiali sottili"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4bd7fd9-40c0-3dde-a109-269e9773ec3c",
                    "sense_definition": "Совершать действие гримасничанья в течение некоторого времени",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он долго <w>поморщился</w> перед тем, как наконец согласиться на предложение.",
                            "target_lang_translations": {
                                "it": "Lui <w>ha continuato a fare smorfie</w> per un po' prima di accettare finalmente la proposta."
                            }
                        },
                        {
                            "text": "Ребёнок <w>поморщился</w> несколько минут, пока не привык к яркому свету.",
                            "target_lang_translations": {
                                "it": "Il bambino <w>ha fatto smorfie</w> per alcuni minuti finché non si è abituato alla luce intensa."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Continuare a fare smorfie per un certo periodo di tempo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "continuare a fare smorfie",
                                "target_lang_sense_clarification": "azione prolungata di smorfie"
                            },
                            {
                                "target_lang_word": "rimanere imbronciato",
                                "target_lang_sense_clarification": "mantenere un'espressione contrariata"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}