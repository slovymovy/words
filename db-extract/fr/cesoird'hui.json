                "forms": [],
                "senses": [
                    {
                        "sense_id": "b2db07e7-dc22-3186-8011-f7599273d329",
                        "entry_id": "bed18e33-e110-3afc-8ee7-979b7c7a488a",
                        "glosses": [
                            "Ce soir même."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "13c1a408-f050-401f-b28e-129824fa54e5",
                                "sense_id": "b2db07e7-dc22-3186-8011-f7599273d329",
                                "text": "Un tas de points positifs à noter ce soir: les nouvelles épreuves & aventures dynamiques et avec des thèmes excellents (…), et l’alternance qui sera de mise dans la Boyard Académie où Vincent C. a été l’auteur d’une performance assez prometteuse cesoird’hui."
                            },
                            {
                                "example_id": "911cc57f-d456-4c87-aad9-a85a6f04aaaa",
                                "sense_id": "b2db07e7-dc22-3186-8011-f7599273d329",
                                "text": "C’est avec beaucoup de joie et de fierté que je vous présente officiellement cesoird’hui 🥁:\n“Tjenbé’y fò” , 2021, 75x115cm\nSoit en français, “Tiens la fort” ou “Tiens bon”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fc2db48-1d87-4446-85ee-0b0afc44e4f8",
                        "source_entry_id": "bed18e33-e110-3afc-8ee7-979b7c7a488a",
                        "source_sense_id": "b2db07e7-dc22-3186-8011-f7599273d329",
                        "target_lang_word": "tonight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tonight",
