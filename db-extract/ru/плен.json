                        "source_entry_id": "3ae2a1fd-ade7-3127-a1f2-20720460388a",
                        "source_sense_description": "состояние захваченного противником военнослужащего",
                        "target_lang_word": "Gefangenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefangenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30b40233-bf7b-35fa-93ef-d9bf147cde6d",
                                        "entry_id": "d0ba3f84-f808-37c6-9986-39777e04feb8",
                                        "glosses": [
                                            "Zustand, in dem jemand oder etwas gefangen gehalten wird"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d755656c-a87d-4c02-abc4-c29d782dbc12",
                                                "sense_id": "30b40233-bf7b-35fa-93ef-d9bf147cde6d",
                                                "text": "Viele Nutztiere des Menschen leiden unter ihrer Gefangenschaft."
                                            },
                                            {
                                                "example_id": "bb431e27-2252-4faa-b354-96646867ce40",
                                                "sense_id": "30b40233-bf7b-35fa-93ef-d9bf147cde6d",
                                                "text": "„Der Großvater schickte aus der Gefangenschaft regelmäßig Briefe an die Familie, die Durchhalte-Appellen glichen.“"
                                            },
                                            {
                                                "example_id": "70a3af59-e942-491d-b2c7-d111b94b2a6c",
                                                "sense_id": "30b40233-bf7b-35fa-93ef-d9bf147cde6d",
                                                "text": "„Später werde ich erfahren, daß er bei der Infanterie und in französischer Gefangenschaft war, von dort vor fast fünfzig Jahren dann mit dem Fahrrad nach Haus an die Lausitz fuhr.“"
                                            },
                                            {
                                                "example_id": "2f853cb7-800c-4b8f-9cc7-ae5b0552652d",
                                                "sense_id": "30b40233-bf7b-35fa-93ef-d9bf147cde6d",
                                                "text": "„Er ist hier, am vorsorglich verabredeten Ort; bald nach der Kapitulation wurde er aus der Gefangenschaft entlassen.“"
                                            },
                                            {
                                                "example_id": "93dc4b0d-b71b-4659-9af4-f4672a489989",
                                                "sense_id": "30b40233-bf7b-35fa-93ef-d9bf147cde6d",
                                                "text": "„Ich hatte neunzehn Monate in Gefangenschaft verbracht, und das genügte mir vollauf für den Rest meines Lebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3594b1b6-9327-48d7-a581-e3ee57776e18",
                        "source_entry_id": "3ae2a1fd-ade7-3127-a1f2-20720460388a",
                        "source_sense_description": "состояние захваченного противником военнослужащего",
                        "target_lang_word": "captivité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "captivité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3aa2e36-f50e-33e4-9102-3eb3e3a47796",
                                        "entry_id": "837d9a38-29b3-37ff-a97a-a939bd083c0a",
                                        "glosses": [
                                            "Privation de liberté ; esclavage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e3ec3e5-ba51-4816-9b5c-2b5ca9429316",
                                                "sense_id": "b3aa2e36-f50e-33e4-9102-3eb3e3a47796",
                                                "text": "Tenir en captivité ; Vivre dans la captivité."
                                            },
                                            {
                                                "example_id": "870b0960-2c71-4265-b475-3bab931a3c9f",
                                                "sense_id": "b3aa2e36-f50e-33e4-9102-3eb3e3a47796",
                                                "text": "Il est des pays où l'abolitionnisme est loin d'être un combat d'arrière-garde. Dans le vaste Sahara, au pays des Maures, ceux qui se battent pour en finir avec la captivité le payent parfois de leur vie."
                                            },
                                            {
                                                "example_id": "87919b57-aa28-4767-89e6-f8b7dc8d2927",
                                                "sense_id": "b3aa2e36-f50e-33e4-9102-3eb3e3a47796",
                                                "text": "Le sociologue Evan Stark est mort en mars 2024, à l’âge de 82 ans. Il concevait la violence conjugale comme une captivité, qu’il nommait « contrôle coercitif ». Il a œuvré pour la sécurité des enfants covictimes de ces violences en soutenant les droits et l’émancipation de leurs mères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de67cf28-d63c-3a54-ba90-c7be32b0daa8",
                                        "entry_id": "837d9a38-29b3-37ff-a97a-a939bd083c0a",
                                        "glosses": [
                                            "Situation d’un prisonnier de guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14fd2849-a9a1-4b2d-979c-e876957377ba",
                                                "sense_id": "de67cf28-d63c-3a54-ba90-c7be32b0daa8",
                                                "text": "Être en captivité. — La captivité de Napoléon à sainte-Hélène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3abcda0-29de-39f8-b076-059593e349f6",
                                        "entry_id": "837d9a38-29b3-37ff-a97a-a939bd083c0a",
                                        "glosses": [
                                            "État d'une personne subjuguée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc415bfb-cb8b-4184-a858-4eb2b8ab5a6a",
                                                "sense_id": "c3abcda0-29de-39f8-b076-059593e349f6",
                                                "text": "On tourna le dos à l'Hôtel des monnaies, la vainqueresse musardait, feignant de rien deviner de mes émois ni de la captivité dans laquelle, d'un inimitable balancement fessier, elle m'avait jeté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76e1a192-269b-30ac-b0c0-9939258691eb",
                                        "entry_id": "837d9a38-29b3-37ff-a97a-a939bd083c0a",
                                        "glosses": [
                                            "Absence de liberté pour un animal sauvage, notamment dans un zoo."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc17124d-9b87-4b0e-98e6-9adaa28fdd8a",
                        "source_entry_id": "3ae2a1fd-ade7-3127-a1f2-20720460388a",
                        "source_sense_description": "состояние захваченного противником военнослужащего",
                        "target_lang_word": "zajetí",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zajetí",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0d70f304-5876-37dc-abd4-056aa32fb1fe",
                                        "entry_id": "5444d11c-01bb-3315-8ad6-32b97c261483",
                                        "glosses": [
                                            "objektivní stav člověka, který byl omezen na svobodě, zejména svobodě pohybu, především při ozbrojeném konfliktu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e97be2c-6b39-44e5-9a18-00bdf8890995",
                                                "sense_id": "0d70f304-5876-37dc-abd4-056aa32fb1fe",
                                                "text": "Otec tvůj byl ještě mladý orel, když jsme ho při posledním vzteklém outoku pohřešili. Myslili jsme, že padl před hradbami, a potom, že byl od křesťanů do lesních jam uvržen.“ „Otec padl v zajetí a v ruce německých rytířů,“ odpověděl Blum. „Nouze, hlad a bída, jakož i posléz myšlénka, že vlasti a víře otcovské více prospěje, když přijetím nového vyznání život obhájí a později ho snad utiskovaným krajanům v oběť přinese, přinutily jej, že se dal pokřestit.“"
                                            },
                                            {
                                                "example_id": "1e8e65d7-7f38-492f-a9ea-e2aa933c256c",
                                                "sense_id": "0d70f304-5876-37dc-abd4-056aa32fb1fe",
                                                "text": "Je podivuhodné, jak nás minulost (Zeman, Babiš, Klausové) drží v jakémsi myšlenkovém, duchovním zajetí, jak jsme jí fascinováni, připomínajíce králíčky hypnotizované několika kobrami."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77cc1bf7-998e-3b92-943b-5ac02a21d606",
                                        "entry_id": "5444d11c-01bb-3315-8ad6-32b97c261483",
                                        "glosses": [
                                            "stav zvířete žijícího ve vymezeném prostoru pod lidskou kontrolou"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f04ae2d-e0d7-356d-909d-674ccd3a48ea",
