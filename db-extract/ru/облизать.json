                ],
                "translations": [
                    {
                        "translation_id": "7f47c7cc-a910-4d0e-81de-61febaadee64",
                        "source_entry_id": "03ea8874-df07-3135-b03e-70986d4053d1",
                        "target_lang_word": "lécher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lécher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "928751c6-530e-3fc8-9986-50382ad15e5e",
                                        "entry_id": "26e505c5-2c71-351e-92c5-7e0891b5e762",
                                        "glosses": [
                                            "Passer la langue sur quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fd2d41c-2dc3-46d8-bf05-e3f8fb645185",
                                                "sense_id": "928751c6-530e-3fc8-9986-50382ad15e5e",
                                                "text": "Le chien lèche son maître. — Un chat qui se lèche. — Les chiens guérissent leurs plaies en les léchant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74484d5b-64bf-3d0a-8617-66e53fcbbf61",
                                        "entry_id": "26e505c5-2c71-351e-92c5-7e0891b5e762",
                                        "glosses": [
                                            "Le faire par gourmandise ou par caresse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50ed6b75-810b-4e71-a3b8-9c9fde77dc3a",
                                                "sense_id": "74484d5b-64bf-3d0a-8617-66e53fcbbf61",
                                                "text": "Lécher un plat. — Quand les chats ont mangé de quelque chose qu’ils trouvent bon, ils se lèchent les barbes."
                                            },
                                            {
                                                "example_id": "5bd3bbe9-59cb-454f-8ed1-32e4076ea26d",
                                                "sense_id": "74484d5b-64bf-3d0a-8617-66e53fcbbf61",
                                                "text": "S’en lécher les babines."
                                            },
                                            {
                                                "example_id": "d5d30a84-f087-4cc1-a273-abeaed70f4ce",
                                                "sense_id": "74484d5b-64bf-3d0a-8617-66e53fcbbf61",
                                                "text": "Même délire erratique pour Sophie. Elle léchait et se faisait lécher. Elle doigtait et se faisait doigter. Sans trop savoir qui elle astiquait et qui l’astiquait. D’ailleurs elle s’en foutait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df6075d6-38d3-3b48-a34d-24e512fe243e",
                                        "entry_id": "26e505c5-2c71-351e-92c5-7e0891b5e762",
                                        "glosses": [
                                            "Finir un ouvrage avec un soin excessif et minutieux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ef68326-9e6f-4596-9a80-aea59444c161",
                                                "sense_id": "df6075d6-38d3-3b48-a34d-24e512fe243e",
                                                "text": "Ce peintre a le tort de lécher, de trop lécher ses tableaux. — Cet ouvrage est trop léché."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19833fa3-4ecf-377b-bae2-c0e4b3fe997c",
                                        "entry_id": "26e505c5-2c71-351e-92c5-7e0891b5e762",
                                        "glosses": [
                                            "Flatter excessivement, cirer les pompes."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "290b6f77-3f84-3b63-9089-647048a311d8",
                                        "entry_id": "26e505c5-2c71-351e-92c5-7e0891b5e762",
                                        "glosses": [
                                            "Effleurer, en parlant de flammes ou des vagues, souvent comparées à des langues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc6a1033-1018-45a0-b667-597ba9d7d8e5",
                                                "sense_id": "290b6f77-3f84-3b63-9089-647048a311d8",
                                                "text": "Les flammèches montent et lèchent le gril. — Les vagues lèchent le rocher."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lécher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "706ced84-3821-3655-8f1b-4e8ce2372e0c",
                                        "entry_id": "517b5d6b-42fb-33f5-9830-1aa74b9d89a0",
                                        "glosses": [
                                            "Supplément alimentaire que l’on donne aux vaches lors de la traite."
                                        ],
                                        "tags": [
                                            "Franche-Comté"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb192ad6-0f7c-45ed-a2a7-a56b48cf35c5",
                                                "sense_id": "706ced84-3821-3655-8f1b-4e8ce2372e0c",
                                                "text": "Dans les fermes, on en saupoudre le fourrage, ou plus souvent ce qu’on appelle le lécher, c’est-à-dire un composé de racines fourragères, de débris de jardinage, d’herbes, de fenasse, de son, de pommes de terre. Ce mélange, haché et cuit, est servi tiède aux vaches qui en sont très-friandes."
                                            },
                                            {
                                                "example_id": "2365c6e4-7c52-4fbd-b016-72a54df4c408",
                                                "sense_id": "706ced84-3821-3655-8f1b-4e8ce2372e0c",
                                                "text": "[…], et quand elle rentrait dans la chambre surchauffée du poêle où se mariaient des odeurs complexes de tourteaux broyés et de racines cuites pour le lécher des vaches, Finaud la regardait d’un œil mi-interrogateur, mi-narquois, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
