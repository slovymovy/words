    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62e523c3-be93-3504-b645-85c9ae88cc91",
                    "sense_definition": "een netwerk van buizen dat drinkwater naar huizen en gebouwen transporteert",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "infrastructuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit oude huis moet de <w>waterleiding</w> volledig worden vervangen door een loodgieter.",
                            "target_lang_translations": {
                                "en": "In this old house, the <w>water pipes</w> must be completely replaced by a plumber."
                            }
                        },
                        {
                            "text": "Door een breuk in de <w>waterleiding</w> zitten de bewoners van de straat zonder drinkwater.",
                            "target_lang_translations": {
                                "en": "Due to a break in the <w>water main</w>, the residents of the street are without drinking water."
                            }
                        }
                    ],
                    "synonyms": [
                        "waterleidingnet"
                    ],
                    "common_phrases": [
                        "ondergrondse waterleiding",
                        "breuk in de waterleiding"
                    ],
                    "target_lang_definitions": {
                        "en": "a network of pipes that transports drinking water to houses and buildings"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "water supply",
                                "target_lang_sense_clarification": "the system of providing water to a community"
                            },
                            {
                                "target_lang_word": "waterworks",
                                "target_lang_sense_clarification": "the system of reservoirs, pipes, and pumps for a district"
                            },
                            {
                                "target_lang_word": "mains water",
                                "target_lang_sense_clarification": "the public water supply system"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c19780f-45e7-3f47-bc60-a4641d121daa",
                    "sense_definition": "een specifieke buis waar water doorheen stroomt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "infrastructuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De loodgieter repareerde de lekkende <w>waterleiding</w> in de badkamer binnen een uur.",
                            "target_lang_translations": {
                                "en": "The plumber repaired the leaking <w>water pipe</w> in the bathroom within an hour."
                            }
                        },
                        {
                            "text": "Pas op dat je niet boort in de <w>waterleiding</w> die achter deze muur loopt.",
                            "target_lang_translations": {
                                "en": "Be careful not to drill into the <w>water line</w> running behind this wall."
                            }
                        }
                    ],
                    "synonyms": [
                        "waterbuis",
                        "leiding"
                    ],
                    "common_phrases": [
                        "lekkende waterleiding",
                        "waterleiding aanleggen"
                    ],
                    "target_lang_definitions": {
                        "en": "a specific pipe through which water flows"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "water pipe",
                                "target_lang_sense_clarification": "a conduit for conveying water"
                            },
                            {
                                "target_lang_word": "water line",
                                "target_lang_sense_clarification": "a pipe carrying water to a building or fixture"
                            },
                            {
                                "target_lang_word": "main",
                                "target_lang_sense_clarification": "a principal pipe in a system"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0d4213a-8ff0-3d71-8e6b-b7cf89322609",
                    "sense_definition": "een organisatie of bedrijf dat verantwoordelijk is voor de levering van drinkwater",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "organisatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>waterleiding</w> adviseert om tijdens de hittegolf zuinig om te gaan met drinkwater.",
                            "target_lang_translations": {
                                "en": "The <w>water company</w> advises using drinking water sparingly during the heatwave."
                            }
                        },
                        {
                            "text": "Ik moet nog een contract afsluiten bij de lokale <w>waterleiding</w> voor mijn nieuwe woning.",
                            "target_lang_translations": {
                                "en": "I still need to sign a contract with the local <w>water utility</w> for my new home."
                            }
                        }
                    ],
                    "synonyms": [
                        "waterleidingbedrijf",
                        "waterbedrijf"
                    ],
                    "common_phrases": [
                        "bij de waterleiding"
                    ],
                    "target_lang_definitions": {
                        "en": "an organization or company responsible for the supply of drinking water"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "water company",
                                "target_lang_sense_clarification": "the utility provider for water"
                            },
                            {
                                "target_lang_word": "water board",
                                "target_lang_sense_clarification": "a local authority managing water supply"
                            },
                            {
                                "target_lang_word": "water utility",
                                "target_lang_sense_clarification": "the public service organization for water"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8c8d628-175d-3448-acbc-ed7eea3487b1",
                    "sense_definition": "een gegraven of natuurlijke geul voor de afvoer of doorstroming van water",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "waterweg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer groef een extra <w>waterleiding</w> om het overtollige regenwater van het land af te voeren.",
                            "target_lang_translations": {
                                "en": "The farmer dug an extra <w>watercourse</w> to drain the excess rainwater from the land."
                            }
                        },
                        {
                            "text": "Deze historische <w>waterleiding</w> verbond vroeger de verschillende vijvers in het kasteelpark.",
                            "target_lang_translations": {
                                "en": "This historic <w>conduit</w> used to connect the various ponds in the castle park."
                            }
                        }
                    ],
                    "synonyms": [
                        "kanaal",
                        "geul",
                        "watergang"
                    ],
                    "common_phrases": [
                        "gegraven waterleiding"
                    ],
                    "target_lang_definitions": {
                        "en": "a dug or natural channel for the drainage or flow of water"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "watercourse",
                                "target_lang_sense_clarification": "a channel through which water flows"
                            },
                            {
                                "target_lang_word": "conduit",
                                "target_lang_sense_clarification": "a channel for conveying water or other fluid"
                            },
                            {
                                "target_lang_word": "aqueduct",
                                "target_lang_sense_clarification": "an artificial channel for conveying water"
                            }
                        ]
                    }
                }
            ]
        }
    ]
