                        "glosses": [
                            "Action de trier les matières dans l'argot des chiffonniers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8e0bef4-afa6-44f0-a1f4-74ed44c551a6",
                                "sense_id": "c7a29542-6f2f-3da0-a8a8-36abd2ae7d5f",
                                "text": "Il se jeta dans le gosier le verre qu’il avait versé, et se remit au tri de ses chiffons, autrement dit à son « triquage »."
                            },
                            {
                                "example_id": "2448fd7c-c591-4e02-a3c4-6d74a6994e66",
                                "sense_id": "c7a29542-6f2f-3da0-a8a8-36abd2ae7d5f",
                                "text": "Le chiffonnier, son triquage fini, va vendre le produit de son travail. Il n'a point de capital pour attendre, il vit au jour le jour et réalise sa recette aussitôt qu'il le peut, chez le maître-chiffonnier."
                            }
                        ]
                    }
