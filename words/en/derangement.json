{
    "word_family": [
        "derange",
        "deranged"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d1bb442-700f-3295-bfcc-b2000848025c",
                    "sense_definition": "A state of mental disturbance, disorder, or insanity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden outburst revealed the deep mental <w>derangement</w> he had been suffering from for months.",
                            "target_lang_translations": {
                                "ru": "Его внезапная вспышка гнева обнажила глубокое душевное <w>расстройство</w>, от которого он страдал на протяжении месяцев."
                            }
                        },
                        {
                            "text": "The actor delivered an unforgettable performance showing gradual descent into total <w>derangement</w>.",
                            "target_lang_translations": {
                                "ru": "Актёр показал незабываемую игру, продемонстрировав постепенное погружение в полное <w>безумие</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "insanity",
                        "madness",
                        "dementia"
                    ],
                    "antonyms": [
                        "sanity"
                    ],
                    "common_phrases": [
                        "mental derangement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние душевного расстройства, помешательства или безумия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстройство",
                                "target_lang_sense_clarification": "душевное или психическое нарушение"
                            },
                            {
                                "target_lang_word": "помешательство",
                                "target_lang_sense_clarification": "потеря рассудка, безумие"
                            },
                            {
                                "target_lang_word": "безумие",
                                "target_lang_sense_clarification": "состояние сильного помрачения ума"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee910174-6f5a-345f-b9d9-0479c92ae63c",
                    "sense_definition": "The act of disrupting, disarranging, or upsetting an established order or functioning system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden economic crisis caused widespread <w>derangement</w> of international trade systems.",
                            "target_lang_translations": {
                                "ru": "Внезапный экономический кризис вызвал масштабное <w>расстройство</w> систем международной торговли."
                            }
                        },
                        {
                            "text": "A severe mechanical <w>derangement</w> forced the vessel to return to the nearest harbor immediately.",
                            "target_lang_translations": {
                                "ru": "Серьёзная механическая <w>поломка</w> вынудила судно немедленно вернуться в ближайшую гавань."
                            }
                        }
                    ],
                    "synonyms": [
                        "disruption",
                        "disorder",
                        "disarray"
                    ],
                    "antonyms": [
                        "order",
                        "arrangement"
                    ],
                    "common_phrases": [
                        "derangement of affairs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушение порядка, правильного функционирования или нормального хода дел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстройство",
                                "target_lang_sense_clarification": "нарушение работы системы или механизмов"
                            },
                            {
                                "target_lang_word": "дезорганизация",
                                "target_lang_sense_clarification": "разрушение установленного порядка или структуры"
                            },
                            {
                                "target_lang_word": "сбой",
                                "target_lang_sense_clarification": "нарушение нормального хода процесса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aeb96109-18db-312c-96cc-e65c5ac1ed29",
                    "sense_definition": "A permutation of the elements of a set such that no element appears in its original position.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In combinatorics, a <w>derangement</w> is a permutation with no fixed points.",
                            "target_lang_translations": {
                                "ru": "В комбинаторике <w>беспорядок</w> — это перестановка без неподвижных точек."
                            }
                        },
                        {
                            "text": "The professor asked the students to calculate the total number of valid <w>derangements</w>.",
                            "target_lang_translations": {
                                "ru": "Профессор попросил студентов вычислить общее число допустимых <w>беспорядков</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В комбинаторике — перестановка элементов множества, при которой ни один элемент не остаётся на своём исходном месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспорядок",
                                "target_lang_sense_clarification": "математический термин: перестановка без неподвижных точек"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}