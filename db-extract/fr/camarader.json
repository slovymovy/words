                "senses": [
                    {
                        "sense_id": "06160ded-152a-3719-a903-21c44642e2cf",
                        "entry_id": "2e9ed521-f57b-353f-b809-9c23b4a99145",
                        "glosses": [
                            "Avoir des activités de camarades, des rapports de camaraderie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46c01a25-390c-4b54-9868-f169736d77ec",
                                "sense_id": "06160ded-152a-3719-a903-21c44642e2cf",
                                "text": "Gasselin remplaça le cocher de Calyste, tombé malade par ordre, Gasselin put alors camarader avec la cuisinière de Béatrix, et Sabine finit par donner à Calyste la même chère et meilleure, mais elle lui vit faire de nouvelles façons."
                            },
                            {
                                "example_id": "d9b683bb-fba1-4aa4-9c89-3e0bb51f0937",
                                "sense_id": "06160ded-152a-3719-a903-21c44642e2cf",
                                "text": "Nous camaradions, assises à un endroit stratégique d’où nous pouvions surveiller à la fois les deux troupeaux et, tout en tricotant, nous refaisions le monde."
                            },
                            {
                                "example_id": "cc3dc788-76b9-482d-85f6-be14f3bff1a9",
                                "sense_id": "06160ded-152a-3719-a903-21c44642e2cf",
                                "text": "Michelle aime beaucoup mieux camarader avec Suzet, qui n’a rien, qu’avec nous autres, qui avons quelque chose."
                            }
                        ]
                    }
                ],
