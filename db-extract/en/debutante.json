                                                "sense_id": "54808acb-ccdc-33be-8b3a-16b064b79943",
                                                "text": "„Nachdem die Wildgansmutter den wertgeschätzten, mißvergnügten Kunden unter viel Entschuldigungen hinauskomplimentiert hatte, stellte sie erbost die unglückliche Debütantin zur Rede.“"
                                            },
                                            {
                                                "example_id": "2fea3674-7bf5-4c8b-8d3d-8df43208ab8d",
                                                "sense_id": "54808acb-ccdc-33be-8b3a-16b064b79943",
                                                "text": "„Gustav Hartung, Intendant am Hessischen Landestheater Darmstadt, holte sie, nahm die Debütantin unter seine Fuchtel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
