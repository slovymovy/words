                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "90e9aed6-a268-4f3a-be7a-83b3b3c12546",
                                "sense_id": "90488eec-1744-3384-968e-4e39a39844c1",
                                "text": "Im hinteren Wrackteil fand man den Flugdatenschreiber."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
