                "senses": [
                    {
                        "sense_id": "45bdacff-d34e-3481-87be-78727d28721e",
                        "entry_id": "30e940de-63f9-38b8-bb48-32b0c84dc27e",
                        "glosses": [
                            "Ende der Neuzulassung von Verbrennungsmotoren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e4d736b-b5bf-42a0-a75e-47bdee77529f",
                                "sense_id": "45bdacff-d34e-3481-87be-78727d28721e",
                                "text": "„Wenn die FDP beim Verbrenner-Aus auf der Bremse steht, weiß sie die deutsche Mehrheit hinter sich.“"
                            },
                            {
                                "example_id": "b7f3f166-655d-4391-a62c-989c68142af3",
                                "sense_id": "45bdacff-d34e-3481-87be-78727d28721e",
                                "text": "„Die EU will das Verbrenner-Aus ab 2035 – die FDP nicht.“"
                            },
                            {
                                "example_id": "854eb5ee-fcc9-4cca-882c-3ffa4067f05f",
                                "sense_id": "45bdacff-d34e-3481-87be-78727d28721e",
                                "text": "„Die CDU hält das für einen Fehler und will die EU-Wahl auch zu einer Abstimmung über das Verbrenner-Aus machen.“"
                            },
                            {
                                "example_id": "72d1f6e1-2bfe-4627-b7f7-f44d70e2e6b7",
                                "sense_id": "45bdacff-d34e-3481-87be-78727d28721e",
                                "text": "„Und 2035 kommt das endgültige Verbrenner-Aus: In zwölf Jahren dürfen in Europa keine Pkw und Kleintransporter mehr neu zugelassen werden, die mit Benzin betrieben werden und CO2 ausstoßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
