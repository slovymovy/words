                        "glosses": [
                            "Faire perdre son caractère païen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe296bb1-7910-4734-8263-46e5759e0033",
                                "sense_id": "7b93c838-c93a-377b-93ac-2810f62ae4dc",
                                "text": "On a dit simplement qu'avec la meilleure volonté du monde, les Jésuites n'avaient pu dépaganiser l'enseignement."
                            },
                            {
                                "example_id": "3e1bdc27-20e9-4bd7-ae83-f5d2874d9fa6",
                                "sense_id": "7b93c838-c93a-377b-93ac-2810f62ae4dc",
                                "text": "Tous ces prêtres Comtois me plaisent chaque jour davantage : l'abbé Clerc est un homme essentiel pour dépaganiser l'éducation."
                            }
                        ]
                    }
