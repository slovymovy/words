                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fec384b1-5850-417e-9733-dcf9e77816c9",
                                "sense_id": "65cc24ef-0e0c-33a8-b1fd-11a0bb0dd8f1",
                                "text": "Considérons donc le moteur-fusée capable d’atterrir sur la lune ; il doit répondre à des exigences particulières : sa force doit être dosable rapidement et dans de larges limites ; il doit être éteignable et réallumable à volonté ;"
                            },
                            {
                                "example_id": "fb2d29ad-2788-487a-82b6-bc761a12c906",
                                "sense_id": "65cc24ef-0e0c-33a8-b1fd-11a0bb0dd8f1",
                                "text": "O-I a annoncé l'introduction en Allemagne de son petit four révolutionnaire Magma, en métal et non en briques, éteignable à la demande."
                            },
                            {
                                "example_id": "9f453262-0f5d-47e1-974b-833d9d42e2ef",
                                "sense_id": "65cc24ef-0e0c-33a8-b1fd-11a0bb0dd8f1",
                                "text": "Une barrière électrique est installée pour protéger le potager. Elle est éteignable par un simple interrupteur depuis la terrasse."
                            }
                        ]
                    }
