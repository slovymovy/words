                        "entry_id": "0a68e2c1-b941-3fdb-b6de-84515ebf09f0",
                        "glosses": [
                            "The steep artificial slope below a fort's parapet."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9728410b-b4d7-39be-aa11-c8446b9939f2",
                        "entry_id": "0a68e2c1-b941-3fdb-b6de-84515ebf09f0",
                        "glosses": [
                            "A cliff at the edge of a plateau or ridge caused by erosion or faulting; the steeper side of an escarpment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c78664c-50ab-42a1-b68c-cf06bee67849",
                                "sense_id": "9728410b-b4d7-39be-aa11-c8446b9939f2",
                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\nSweating under the sun, we scale the barren eastern scarp of the Great Rift Valley (Area B), edging carefully around controversial, razor-wired Israeli settlements (Area C)."
                            }
                        ]
                    },
                    {
                        "sense_id": "48385b36-f5ea-302b-b162-123ce048d694",
                        "entry_id": "0a68e2c1-b941-3fdb-b6de-84515ebf09f0",
                        "glosses": [
                            "Obsolete spelling of scarpe, scrape."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "43ab8302-abac-473c-a5ff-334e1fdb93e7",
                                "sense_id": "48385b36-f5ea-302b-b162-123ce048d694",
                                "text": "[...] as in the seventh, which is Argent a Scarp Azure."
                            },
                            {
                                "example_id": "3f5b8c86-3b24-4f0e-b5cc-0297517affa3",
                                "sense_id": "48385b36-f5ea-302b-b162-123ce048d694",
                                "text": "He beareth Argent, a Scarp, Azure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "accfe2ec-dee0-49d5-82dd-fbe6fff5180f",
                        "source_entry_id": "0a68e2c1-b941-3fdb-b6de-84515ebf09f0",
                        "source_sense_description": "artificial slope",
                        "target_lang_word": "escarpe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escarpe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20c843f2-ba9f-3da6-a335-ab1a73bc9616",
                                        "entry_id": "a8ce8ceb-2f97-364e-88f9-a7dbda45e526",
                                        "glosses": [
                                            "Talus de terre ou de maçonnerie qui délimite le fossé du côté de la place forte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e2c5313-e0db-40c4-9a52-d4f675f19c2b",
                                                "sense_id": "20c843f2-ba9f-3da6-a335-ab1a73bc9616",
                                                "text": "Toutefois les escarpes de l’enceinte intérieure sont beaucoup plus élevées que celles de l’enceinte extérieure."
                                            },
                                            {
                                                "example_id": "19c8c0f7-73b7-4fc4-ad65-a3769a80ce37",
                                                "sense_id": "20c843f2-ba9f-3da6-a335-ab1a73bc9616",
                                                "text": "Un cri s’éleva du rang des Boers et Samuel jeta son chapeau en l’air. Il se retourna alors vers le jeune Schalk Uys, qui était resté adossé à l'escarpe de terre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "escarpe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cbf8676-9ea7-3ff7-b80a-efba8e6b2567",
                                        "entry_id": "d75a8a0c-4c31-36dc-b932-4a439aa3001d",
                                        "glosses": [
                                            "Voleur ou assassin de profession, qui opère dans les villes ; bandit."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3128eefe-c6d3-428c-94c9-114b5bd6545e",
                                                "sense_id": "4cbf8676-9ea7-3ff7-b80a-efba8e6b2567",
                                                "text": "La T.S.F. les a bien servis, elle qui présente les victimes comme des escarpes et des apaches."
                                            },
                                            {
                                                "example_id": "d71a1bfe-919d-4017-9ff6-a049cf88356b",
                                                "sense_id": "4cbf8676-9ea7-3ff7-b80a-efba8e6b2567",
                                                "text": "Tous ces escarpes n'avaient dû mourir qu'après de longues et horribles tortures."
                                            },
                                            {
                                                "example_id": "e326d115-a637-4959-8dab-7f243c6b34b2",
                                                "sense_id": "4cbf8676-9ea7-3ff7-b80a-efba8e6b2567",
                                                "text": "Le destin tragique de ce potentat disparu empêche-t-il le roi d’Espagne de courir le guilledou dans les lieux de plaisir et le prince de Galles de se déguiser en escarpe dans les bals costumés ?"
                                            },
                                            {
                                                "example_id": "2e42ae47-7924-45a3-8259-e8b9acc18cd9",
                                                "sense_id": "4cbf8676-9ea7-3ff7-b80a-efba8e6b2567",
                                                "text": "[…], un sous-lieutenant de dragons enlace de son bras le buste de sa trop bruyante compagne et laisse voir ainsi au poignet un tatouage d’escarpe…"
                                            },
                                            {
                                                "example_id": "fed3e845-ba0d-453b-905d-72de8ec1b7ef",
                                                "sense_id": "4cbf8676-9ea7-3ff7-b80a-efba8e6b2567",
                                                "text": "La rue de Jérusalem, entendez la police, tient ces garnis à l’œil : hôtes de passage, ouvriers journaliers ou escarpes n'échappent pas à sa surveillance […]."
                                            }
                                        ]
                                    }
                                ]
                            },
