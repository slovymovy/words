                            {
                                "target_lang_word": "обывательский",
                                "target_lang_sense_clarification": "упрощенный, свойственный человеку без специальных знаний"
                            },
                            {
                                "target_lang_word": "популярный",
                                "target_lang_sense_clarification": "широко известный и понятный многим"
