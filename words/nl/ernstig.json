                },
                {
                    "sense_id": "9cdecd05-a22c-3721-9d8c-19aad80030fd",
                    "sense_definition": "met heel vervelende of gevaarlijke gevolgen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gevaar en ernst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij het <w>ernstige</w> ongeluk op de snelweg zijn helaas twee doden gevallen.",
                            "target_lang_translations": {
                                "en": "In the <w>serious</w> accident on the highway, unfortunately, two people were killed.",
                                "ru": "В этой <w>серьёзной</w> аварии на шоссе, к сожалению, погибли два человека."
                            }
                        },
                        {
                            "text": "De dokter zei dat de patiënt <w>ernstig</w> letsel had opgelopen na de val.",
                            "target_lang_translations": {
                                "en": "The doctor said the patient had sustained <w>severe</w> injuries after the fall.",
                                "ru": "Врач сказал, что пациент получил <w>тяжёлые</w> травмы после падения."
                            }
                        }
                    ],
                    "synonyms": [
