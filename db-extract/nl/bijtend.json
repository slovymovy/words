            {
                "entry_id": "1c6ebb18-434d-37cf-b4b9-c64c1a7a0a39",
                "word": "bijtend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "70bc2920-9267-33c1-8405-863361251481",
                        "entry_id": "1c6ebb18-434d-37cf-b4b9-c64c1a7a0a39",
                        "glosses": [
                            "zo scherp dat het pijn doet; zo scherp dat het beschadigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03f08e55-28a2-4161-b7df-a76f0ed777b9",
                                "sense_id": "70bc2920-9267-33c1-8405-863361251481",
                                "text": "De aanval met bijtend zuur op een 3-jarig jongetje in een Engelse supermarkt lijkt een mislukte afrekening te zijn geweest met de moeder van het kind. De vader zou de hoofdverdachte zijn."
                            },
                            {
                                "example_id": "cf72c082-e00f-478b-a77d-62e5a5928dac",
                                "sense_id": "70bc2920-9267-33c1-8405-863361251481",
                                "text": "Twee kinderen zijn afgelopen woensdag gewond geraakt nadat een onbekend persoon een bijtend zuur in een kinderbadje in Bad Bentheim had gegooid. De twee liepen volgens de politie forse irritaties aan oog en huid op."
                            }
                        ]
                    },
                    {
                        "sense_id": "000e5048-3f71-30c9-9ccc-b74c60366a9a",
                        "entry_id": "1c6ebb18-434d-37cf-b4b9-c64c1a7a0a39",
                        "glosses": [
                            "op een onvriendelijke, hatelijke manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5317b5b-b542-4ae7-8176-f0c137431adb",
                                "sense_id": "000e5048-3f71-30c9-9ccc-b74c60366a9a",
                                "text": "Onder de noemer #celestechangeaccepted combineert Barber vervolgens de twee beelden, schrijft er een droog of bijtend tekstje bij en zet ze online."
                            }
                        ]
                    }
                ],
