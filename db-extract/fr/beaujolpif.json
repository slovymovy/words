                "senses": [
                    {
                        "sense_id": "03ff10c1-4422-33cc-a248-2e2a8af1025b",
                        "entry_id": "170d5b2a-e39d-3022-9f2a-ec4232d44956",
                        "glosses": [
                            "Beaujolais (vin)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6384ac30-69ee-4f8e-aa74-741314972314",
                                "sense_id": "03ff10c1-4422-33cc-a248-2e2a8af1025b",
                                "text": "Il déguste un beaujolpif sincère en comptant les chauves-souris de son délirium."
                            },
                            {
                                "example_id": "90ec8f0a-574d-4608-a029-ecd92c339798",
                                "sense_id": "03ff10c1-4422-33cc-a248-2e2a8af1025b",
                                "text": "Qui dit bistrot dit contact. Pas de bistrots aux H.L.M. Quand tu prendras ton verre de beaujolpif à un distributeur automatique, la France sera finie. Nettoyée."
                            },
                            {
                                "example_id": "23b42b6d-550d-4f3e-8ab2-1667d08df608",
                                "sense_id": "03ff10c1-4422-33cc-a248-2e2a8af1025b",
                                "text": "Moins hygiéniques, scotchs, perniflards ou blancs-cass, se succèdent suivant la rotation des tournées apéritives, prélude aux beaujolpifs et rosés du déjeuner, que suivent les grands alcools blancs d’après le caoua."
                            },
                            {
                                "example_id": "fd09fc85-8cee-4198-b9f5-ddbae1cb245a",
                                "sense_id": "03ff10c1-4422-33cc-a248-2e2a8af1025b",
                                "text": "Son cerveau aux circonvolutions spontex, imprégnées de beaujolpif, était peuplé de monstrueux accouplements, de fantastiques fornications dont lui, Marcel, se trouvait injustement exclus."
                            }
                        ]
                    }
