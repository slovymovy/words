                        "sense_id": "a19d199e-77d3-3068-b79c-cf1955cded5e",
                        "entry_id": "c5e5f634-a9a2-3f61-867f-d914128fac0e",
                        "glosses": [
                            "ehemaliges britisch-französisches Passagierflugzeug, das mit Überschallgeschwindigkeit fliegen konnte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "942199fc-1ee0-471b-a1e8-f30337b7e72a",
                                "sense_id": "a19d199e-77d3-3068-b79c-cf1955cded5e",
                                "text": "„Am 26. November 2003 fand der letzte Flug einer Concorde statt.“"
                            },
                            {
                                "example_id": "1c0afab0-371e-49df-85bd-e2b24f0eb961",
                                "sense_id": "a19d199e-77d3-3068-b79c-cf1955cded5e",
                                "text": "„Wenn die beiden Brüder miteinander telefonierten, schilderte Sandy besorgt irgendwelche neuen Symptome, und einmal flog Philip mit einer Concorde von London nach New York, weil Sandy eine Sehstörung für die ersten Anzeichen eines Gehirntumors hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
