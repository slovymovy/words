        "fr-extract.jsonl": [
            {
                "entry_id": "ae0d71d7-7877-3d9f-abfe-f98898984361",
                "word": "légitimement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a86595e4-b3ab-35e8-b7d6-fc084c2a11ab",
                        "entry_id": "ae0d71d7-7877-3d9f-abfe-f98898984361",
                        "glosses": [
                            "D’une manière légitime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f5e511a-7290-4ebd-accf-295ea711fbbc",
                                "sense_id": "a86595e4-b3ab-35e8-b7d6-fc084c2a11ab",
                                "text": "Cette somme lui est due légitimement."
                            },
                            {
                                "example_id": "5def8c55-8d09-459c-905c-98ffd50d4459",
                                "sense_id": "a86595e4-b3ab-35e8-b7d6-fc084c2a11ab",
                                "text": "Ce n'étaient plus un petit bûcheron et une petite pêcheuse, - mais un Sylphe et une Ondine, lesquels, plus tard, furent unis légitimement."
                            }
                        ]
                    },
                    {
                        "sense_id": "487c9450-476e-331d-aa2e-0ce93f4afe8d",
                        "entry_id": "ae0d71d7-7877-3d9f-abfe-f98898984361",
                        "glosses": [
                            "À bon droit, avec raison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1675086-b8d3-4aa2-910c-31d648d34ae9",
                                "sense_id": "487c9450-476e-331d-aa2e-0ce93f4afe8d",
                                "text": "Ceux à qui Dieu a donné la religion par sentiment du cœur sont bien heureux et bien légitimement persuadés."
                            },
                            {
                                "example_id": "1eef5389-264b-4c75-b125-f5f3f2e98a0b",
                                "sense_id": "487c9450-476e-331d-aa2e-0ce93f4afe8d",
                                "text": "Un homme de quatre-vingts ans, qui ne doit espérer que trois ans et sept mois de vie, peut encore espérer tout aussi légitimement trois ans lorsqu'il a atteint quatre-vingt-cinq ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "7aa0c3c5-49bf-3397-b900-d0f487a44331",
                        "entry_id": "ae0d71d7-7877-3d9f-abfe-f98898984361",
                        "glosses": [
                            "D’une façon excusable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0954b7eb-d8c9-41c5-9aa8-a933a906ac42",
                                "sense_id": "7aa0c3c5-49bf-3397-b900-d0f487a44331",
                                "text": "Afin que je sois légitimement ingrat, étant infiniment obligé, ne me laissez pas même des paroles avec lesquelles je puisse vous remercier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f11205bd-4f1f-4864-acde-de5ee9686549",
                        "source_entry_id": "ae0d71d7-7877-3d9f-abfe-f98898984361",
                        "target_lang_word": "legitimately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legitimately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab982b30-b867-3b67-a0d7-570887a5206a",
                                        "entry_id": "a3068e62-9c37-3cbc-8afd-d0b02ef4a7d7",
                                        "glosses": [
                                            "In a legitimate manner, properly, fair and square."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "882329be-aa10-4fad-adac-e6fe05773d72",
                        "source_entry_id": "ae0d71d7-7877-3d9f-abfe-f98898984361",
                        "target_lang_word": "by rights",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "by rights",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fdf4c16e-8551-33a0-8548-6716827cc0cf",
                                        "entry_id": "8df0c980-0ef5-31f1-afed-f0e2abe5f9f3",
                                        "glosses": [
                                            "Alternative form of by right."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60938a67-249e-4fe1-99e7-c32647877775",
                                                "sense_id": "fdf4c16e-8551-33a0-8548-6716827cc0cf",
                                                "text": "Well, whether the gentlemen really do deprive us of any little matters which ought to be ours by rights, I cannot say for certain; but the opinion of the old ones is they do."
                                            },
                                            {
                                                "example_id": "010d3413-2c66-4358-8ce0-aaa17f277643",
                                                "sense_id": "fdf4c16e-8551-33a0-8548-6716827cc0cf",
                                                "text": "He told me not to tell anyone. I suppose that I should not by rights have told you."
                                            },
                                            {
                                                "example_id": "a060d14e-9e2b-45ee-9a42-3fa05516f2ba",
                                                "sense_id": "fdf4c16e-8551-33a0-8548-6716827cc0cf",
                                                "text": "The rest will be speculators, that's men trying to get between you and the oilmen to get some of the money that ought, by rights, come to you."
                                            },
                                            {
                                                "example_id": "f7cfc975-b692-42ae-8623-587c87937ee2",
                                                "sense_id": "fdf4c16e-8551-33a0-8548-6716827cc0cf",
                                                "text": "By rights I ought to have been lolling in bed this morning, but Nancy was ill and I had to goalkeep for the Second."
                                            },
                                            {
                                                "example_id": "5bcded6f-1512-445b-8f6c-c8b0b5683a01",
                                                "sense_id": "fdf4c16e-8551-33a0-8548-6716827cc0cf",
                                                "text": "You Keep Fucking Me is one of the highlights of a new exhibition of her paintings, all of them created since her diagnosis with a cancer that should, by rights, have seen her off."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "231dfd55-3a3c-43d2-a799-472f7338a9bb",
                        "source_entry_id": "ae0d71d7-7877-3d9f-abfe-f98898984361",
