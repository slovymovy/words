        "fr-extract.jsonl": [
            {
                "entry_id": "4b940f08-57ef-36b8-a1ce-81093745e325",
                "word": "prodigieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0a11bc69-b905-3425-b5b8-d9615133023a",
                        "entry_id": "4b940f08-57ef-36b8-a1ce-81093745e325",
                        "glosses": [
                            "D’une manière prodigieuse, en tenant du prodige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c40bdf43-915e-47da-9d2b-2bb5ebe5046d",
                                "sense_id": "0a11bc69-b905-3425-b5b8-d9615133023a",
                                "text": "[Dans la chaire] On parlait latin, et longtemps, devant des femmes et des marguilliers ; on a parlé grec : il fallait savoir prodigieusement pour prêcher si mal."
                            },
                            {
                                "example_id": "847e85b5-9841-4efc-bdf3-3f069a318e6d",
                                "sense_id": "0a11bc69-b905-3425-b5b8-d9615133023a",
                                "text": "Il est vrai que son Alcine [de l’Arioste] est prodigieusement supérieure à la Circé de l’Odyssée ; mais enfin Homère est le premier…."
                            },
                            {
                                "example_id": "0bab311e-de9c-4794-aea8-26d733c84c51",
                                "sense_id": "0a11bc69-b905-3425-b5b8-d9615133023a",
                                "text": "Cela vous amuse donc ? – Prodigieusement ; vous ne sauriez croire combien je trouve de piquant à cette petite guerre."
                            },
                            {
                                "example_id": "ce450866-4bf6-4a54-9482-742a04d05701",
                                "sense_id": "0a11bc69-b905-3425-b5b8-d9615133023a",
                                "text": "Zaheira ne put s'empêcher de penser qu'elle n'avait jamais vu un homme aussi prodigieusement beau."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2e5e220-a8d5-3974-b0f3-d0bed813d9e6",
                        "entry_id": "4b940f08-57ef-36b8-a1ce-81093745e325",
                        "glosses": [
                            "En très grande quantité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a94e6b8-d0b4-4dab-9015-08604110d20f",
                                "sense_id": "c2e5e220-a8d5-3974-b0f3-d0bed813d9e6",
                                "text": "Après avoir laissé derrière nous les Orcades, nous entrâmes en plein Atlantique, et la mer s'enfla prodigieusement."
                            },
                            {
                                "example_id": "72e986ce-44fe-493d-b1c8-b7bcefc1cd2f",
                                "sense_id": "c2e5e220-a8d5-3974-b0f3-d0bed813d9e6",
                                "text": "On a prodigieusement écrit sur l'affaire Dreyfus. Joseph Reinach a consacré je ne sais combien de volumes à en retracer toutes les péripéties."
                            },
                            {
                                "example_id": "e061b935-4330-4ba7-8390-aa13f0f6ea1a",
                                "sense_id": "c2e5e220-a8d5-3974-b0f3-d0bed813d9e6",
                                "text": "Paris est fort bon pour ceux qui ont beaucoup d’ambition, de grandes passions et prodigieusement d’argent,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ad7f5bd-6638-4000-aebe-db932d7ac37d",
                        "source_entry_id": "4b940f08-57ef-36b8-a1ce-81093745e325",
                        "target_lang_word": "fantastically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fantastically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f5cd992-b14e-38c1-8a26-eea597b51231",
                                        "entry_id": "4ebaf7a7-ca1e-3533-a9f0-72fe16baed93",
                                        "glosses": [
                                            "In a fantastic manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19da674d-ca56-4ced-8b87-2a698a01a294",
                                                "sense_id": "8f5cd992-b14e-38c1-8a26-eea597b51231",
                                                "text": "He painted fantastically with everything as if in a dream."
                                            },
                                            {
                                                "example_id": "94aa1268-9398-4504-81f4-baffb22d555b",
                                                "sense_id": "8f5cd992-b14e-38c1-8a26-eea597b51231",
                                                "text": "\"The Chengtu revolutionaries were fantastically colourful in the Szechwanese manner—they costumed themselves as heroes of the stage and their energies were chiefly occupied in tying ropes across the main streets so that when Imperial officials rode by in their litters they would have to get down and crawl under, losing face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3207386e-5933-3ea7-87fb-b1f5a302d166",
                                        "entry_id": "4ebaf7a7-ca1e-3533-a9f0-72fe16baed93",
                                        "glosses": [
                                            "To an extent only in fantasy; outrageously; ridiculously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f946b455-cbe3-4927-a60e-9aef87bc78f7",
                                                "sense_id": "3207386e-5933-3ea7-87fb-b1f5a302d166",
                                                "text": "The provinces of Liaoning, Heilongjiang and Jilin are fantastically cold in winter, indeed one of the major tourist attractions for the hardy is the display of ice-carved figures in public parks (especially in Haerbin, Heilongjiang province). The long winters have average temperatures between — 20°C and — 27°C, although the short summers are hot."
                                            },
                                            {
                                                "example_id": "aa219e9f-73b3-43b7-9945-f362fe30c77b",
                                                "sense_id": "3207386e-5933-3ea7-87fb-b1f5a302d166",
                                                "text": "He was fantastically wealthy."
                                            },
                                            {
                                                "example_id": "9e85a316-329c-44ea-8bfd-2d1c650c55b9",
                                                "sense_id": "3207386e-5933-3ea7-87fb-b1f5a302d166",
                                                "text": "One must be especially careful when using Google to determine frequency as there is a very real risk of fantastically overestimating the frequency and subsequent importance of a term."
                                            },
                                            {
                                                "example_id": "3eb390a2-13b7-45c2-8ef1-93f89088eaa9",
                                                "sense_id": "3207386e-5933-3ea7-87fb-b1f5a302d166",
                                                "text": "Every guest is appalled and fantastically humourless about the experience, even at this distance. You cannot help but wonder at cultural divides and how differently the British might have approached – or at least recalled – such events, at least in the early days. For us, surely, it would be a story for the ages. You could dine out on it for ever, so to speak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3e75043-85ec-4e24-9aeb-40576065b7ca",
                        "source_entry_id": "4b940f08-57ef-36b8-a1ce-81093745e325",
                        "target_lang_word": "incredibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incredibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08384e6d-d973-365e-a83b-77c956cea3e9",
                                        "entry_id": "85ee00f3-0af5-306d-9dd5-29412d478902",
                                        "glosses": [
                                            "In an incredible manner; not to be believed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0449ca0d-b5f5-4cfd-8945-27d18ce1780a",
                                                "sense_id": "08384e6d-d973-365e-a83b-77c956cea3e9",
                                                "text": "With the parental exaggeration which the birth of his various enterprises always induced, O'Sullivan spoke incredibly of eighty-five \"enrolled\" members."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1fd7e3a-bccb-3368-bc44-4e3d155a2083",
                                        "entry_id": "85ee00f3-0af5-306d-9dd5-29412d478902",
                                        "glosses": [
                                            "To a great extent; extremely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41eb9183-b26c-4f1c-824a-3c42e6b563b2",
                                                "sense_id": "d1fd7e3a-bccb-3368-bc44-4e3d155a2083",
                                                "text": "He was incredibly wealthy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f110fe-0639-34f6-8f64-228ddd96437f",
                                        "entry_id": "85ee00f3-0af5-306d-9dd5-29412d478902",
                                        "glosses": [
                                            "Used to note the surprising or hard-to-believe nature of what is being said and suggest that it is nevertheless true."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "851f8f3f-61c4-4c5f-a925-acbebfbb879d",
                                                "sense_id": "09f110fe-0639-34f6-8f64-228ddd96437f",
                                                "text": "Incredibly, when he died they found he had left a million dollars to the Poetry Foundation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cd3c012-78f5-45d6-93b1-6b4665e1652e",
                        "source_entry_id": "4b940f08-57ef-36b8-a1ce-81093745e325",
                        "target_lang_word": "miraculously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miraculously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a29ebce-e93b-39a6-99c5-b86f106b92f5",
                                        "entry_id": "0e80813c-9b97-3cde-b75d-104dcd1ddda2",
                                        "glosses": [
                                            "In a miraculous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff0dcc4b-fc25-4c4a-8115-f2b416bae023",
                                                "sense_id": "4a29ebce-e93b-39a6-99c5-b86f106b92f5",
                                                "text": "When he woke for the second time he saw me, and began to question me as to what had happened, but I had to put him off as best I could till the morrow, when he awoke almost miraculously better."
                                            },
                                            {
                                                "example_id": "7c822698-7fc7-4ed9-b5b6-fcb0085b1f66",
                                                "sense_id": "4a29ebce-e93b-39a6-99c5-b86f106b92f5",
                                                "text": "Almost miraculously, [risk-neutral valuation] finesses the problem that we know hardly anything about the risk aversion of the buyers and sellers of options."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a20ba16-0a8a-4781-a6b9-d9f7b7027782",
                        "source_entry_id": "4b940f08-57ef-36b8-a1ce-81093745e325",
                        "target_lang_word": "prodigiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prodigiously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eba1b598-e414-39ff-b966-8d75deba1d78",
                                        "entry_id": "0be0297e-34ed-3a1d-8994-cd4a4d9d80f2",
                                        "glosses": [
                                            "In a prodigious manner; astonishingly, enormously, impressively, wonderfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7568913e-06ca-430a-ab67-85b17661b0d1",
                                                "sense_id": "eba1b598-e414-39ff-b966-8d75deba1d78",
                                                "text": "[T]he Mercers encreaſing prodigiouſly vvent back into the City; there like Bees unhiv'd they hover about a vvhile, not knovving vvhere to fix; but at laſt, as if they vvould come back to the old Hive in Pater-noſter Rovv, but could not be admitted, the ſvvarm ſettled on Lu[d]gate-hill."
                                            },
                                            {
                                                "example_id": "dff59a76-1a61-4c78-8a76-72404dfd660f",
                                                "sense_id": "eba1b598-e414-39ff-b966-8d75deba1d78",
                                                "text": "The Dashwoods were so prodigiously delighted with the Middletons, that, though not much in the habit of giving any thing, they determined to give them—a dinner; […]"
                                            },
                                            {
                                                "example_id": "bef49b1e-7d6c-4e08-92f7-aedbfe553dee",
                                                "sense_id": "eba1b598-e414-39ff-b966-8d75deba1d78",
                                                "text": "Pendennis the elder, who like a real man of the world had a proper and constant dread of the opinion of his neighbour, was prodigiously annoyed by the absurd little tempest which was blowing in Chatteris, and tossing about Master Pen’s reputation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
