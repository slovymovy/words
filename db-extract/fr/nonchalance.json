        "fr-extract.jsonl": [
            {
                "entry_id": "d8bc8d8f-6e25-3060-b75d-3bac39d230b3",
                "word": "nonchalance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9df72b6f-4134-474c-afe4-108514800962",
                        "entry_id": "d8bc8d8f-6e25-3060-b75d-3bac39d230b3",
                        "tags": [
                            "plural"
                        ],
                        "form": "nonchalances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44642f90-9e93-304f-b746-15a5032e63ee",
                        "entry_id": "d8bc8d8f-6e25-3060-b75d-3bac39d230b3",
                        "glosses": [
                            "Laisser-aller ; négligence ; apathie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf6aa5b0-a2bd-49ae-b99b-46d858c917ab",
                                "sense_id": "44642f90-9e93-304f-b746-15a5032e63ee",
                                "text": "Elle était sobre, très propre et n’ayant d’autre défaut que beaucoup de paresse, la nonchalance régnant dans toutes ses actions et dans toute sa personne, malgré l’air de vivacité que ses yeux annonçaient."
                            },
                            {
                                "example_id": "e5e0f5d5-34c8-4529-9101-4d17d727bb2d",
                                "sense_id": "44642f90-9e93-304f-b746-15a5032e63ee",
                                "text": "Pour le reste, il avait laissé les choses suivre leur cours, et quand le vieux caissier, le vénérable Savourdin, bonhomme à lunettes d’or et à cravate blanche, le priait chaque soir de vérifier la caisse, il s’acquittait de cette besogne avec une nonchalance véritablement inexplicable."
                            },
                            {
                                "example_id": "c8f53ffd-ae70-4937-8fbb-29260681184b",
                                "sense_id": "44642f90-9e93-304f-b746-15a5032e63ee",
                                "text": "Je reconnaissais ce genre de plaisir qui requiert, il est vrai, un certain travail de la pensée sur elle-même, mais à côté duquel les agréments de la nonchalance qui vous fait renoncer à lui, semblent bien médiocres."
                            }
                        ]
                    },
                    {
                        "sense_id": "49e30d0b-23c3-3544-b91e-647e9caa222c",
                        "entry_id": "d8bc8d8f-6e25-3060-b75d-3bac39d230b3",
                        "glosses": [
                            "Mollesse ; langueur ; indolence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f16b0b44-90e2-45e8-888c-e475a56c80cb",
                                "sense_id": "49e30d0b-23c3-3544-b91e-647e9caa222c",
                                "text": "Le soleil des tropiques, en brunissant son visage, ne lui avait point donné cette vivacité de geste et de parole qui s’unit chez les créoles à une nonchalance souvent pleine de grâce."
                            },
                            {
                                "example_id": "d8002e01-cf54-4656-9ac8-57fcfcff7c9e",
                                "sense_id": "49e30d0b-23c3-3544-b91e-647e9caa222c",
                                "text": "Penchés comme en une nonchalance de rêve sur les petits murs terreux, les amandiers pleurent leurs larmes blanches sous la caresse du vent..."
                            },
                            {
                                "example_id": "75264e74-7312-403e-aed6-ec816ad8942a",
                                "sense_id": "49e30d0b-23c3-3544-b91e-647e9caa222c",
                                "text": "C'était un grand Noir filiforme qui semblait plein de nonchalance et de mauvaise volonté, bien qu'il portât une tunique à boutons et des culottes de nègre de maison."
                            }
                        ]
                    },
                    {
                        "sense_id": "4102aca5-643e-313a-89bb-bb0f1348a3ce",
                        "entry_id": "d8bc8d8f-6e25-3060-b75d-3bac39d230b3",
                        "glosses": [
                            "Relâchement, insouciance où l’on se complaît."
                        ],
                        "tags": [
                            "literary",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "060bbfa9-c2dc-4c9e-83bb-3b46b5973f37",
                                "sense_id": "4102aca5-643e-313a-89bb-bb0f1348a3ce",
                                "text": "Ou je me réveillerai, et les lois et les mœurs auront changé, — grâce à son pouvoir magique, — le monde, en restant le même, me laissera à mes désirs, joies, nonchalances."
                            },
                            {
                                "example_id": "b8d02628-372f-4118-9f82-4f1c0f0ab52b",
                                "sense_id": "4102aca5-643e-313a-89bb-bb0f1348a3ce",
                                "text": "Mais non. Ce qu’il voulut, c’est arracher tous ceux\nQui vivaient engourdis, orgueilleux, paresseux,\nÀ l’égoïsme obscur, aux mornes nonchalances,\nPour les jeter, chantants et fiers, parmi les lances,\nIvres de dévouement, épris de mourir loin,\nDans cet oubli de soi dont tous avaient besoin !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfde8a98-e488-49d8-a97c-29c38bc95b56",
                        "source_entry_id": "d8bc8d8f-6e25-3060-b75d-3bac39d230b3",
                        "target_lang_word": "Nonchalance",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nonchalance",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                                        "entry_id": "d62a727f-d13b-34f2-9e33-01ac3eba9328",
                                        "glosses": [
                                            "Haltung/Verhalten, eigene Ideen/Interessen zu verfolgen, ohne sich allzu sehr auf andere Betroffene einzustellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad43779d-e911-4945-9d46-97170d954903",
                                                "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                                                "text": "Seine Nonchalance wirkte auf mich etwas hochnäsig."
                                            },
                                            {
                                                "example_id": "c801cb4c-187b-4b87-bc24-2088903117a2",
                                                "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                                                "text": "„Zur Anmut gehören Beiläufigkeit, Ungekünsteltheit, Nonchalance, Sprezzatura; und wenn sie in Begleitung ihrer Schwester, der Demut, auftritt, ist sie unbesiegbar.“"
                                            },
                                            {
                                                "example_id": "3f8fcf68-3adb-4e89-9fa7-1c95711b81fc",
                                                "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                                                "text": "„Er antwortet mit der Nonchalance eines Amerikaners, der nach dem dritten Wortwechsel nach deinem Einkommen fragt.“"
                                            },
                                            {
                                                "example_id": "efca07d2-3b62-4d40-8db8-bde502d937d8",
                                                "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                                                "text": "„Seine Nonchalance reizte sie.“"
                                            },
                                            {
                                                "example_id": "c8bb0664-313b-4ab3-9f88-486f358b02e2",
                                                "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                                                "text": "„Nonchalance gehörte mit zur Genialität, und so focht er denn, beide Füße weit vorgestreckt und die linke Hand in der Hosentasche, mit seiner rechten in der Luft umher, um durch lebhafte Gestikulationen seinem Kathedervortrage Nachdruck zu geben.“"
                                            },
                                            {
                                                "example_id": "acc94b0c-e182-4910-9794-e0b511954a74",
                                                "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                                                "text": "„Er zuckte mit gespielter Nonchalance mit den Achseln, aber Smithback erkannte, dass er seine Aufregung kaum zügen konnte“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87db634c-9e06-4d9d-8555-2f39518aa38b",
                        "source_entry_id": "d8bc8d8f-6e25-3060-b75d-3bac39d230b3",
                        "target_lang_word": "Lässigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lässigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e818d74b-b899-39aa-a139-9afd58c81a7a",
                                        "entry_id": "48d7661c-312f-3ced-a6e1-e0363af72f2c",
                                        "glosses": [
                                            "Eigenschaft, lässig zu sein/die Dinge leicht zu nehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88c7c0ce-efff-4f7d-951a-566661dc6fe2",
                                                "sense_id": "e818d74b-b899-39aa-a139-9afd58c81a7a",
                                                "text": "„Sie reisen billig, mit jener Lässigkeit und gelegentlichen Ausflügen in den Luxus, die wirklich wohlhabende Menschen sich leisten.“"
                                            },
                                            {
                                                "example_id": "a78e1b08-64b2-4fdb-b028-ac89ab849120",
                                                "sense_id": "e818d74b-b899-39aa-a139-9afd58c81a7a",
                                                "text": "„Mit Kim kehrt ein Spieler zurück, der Mitte der Nullerjahre die Golfwelt im Sturm erobert hatte mit einer wilden Mischung aus Talent, Lässigkeit und Angriffslust.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "997aa600-84ed-48af-ad9d-5e356f2e27c8",
