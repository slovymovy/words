                    "frequency": "Middle",
                    "semantic_group_id": "grammaticale vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De monteur was de oude onderdelen <w>vervangend</w> toen de stroom plotseling uitviel.",
                            "target_lang_translations": {
                                "en": "The mechanic was <w>replacing</w> the old parts when the power suddenly went out."
                            }
                        },
                        {
                            "text": "Al <w>vervangend</w> kwam hij erachter dat de machine eigenlijk niet meer te repareren was.",
                            "target_lang_translations": {
                                "en": "While <w>replacing</w> them, he found out that the machine was actually no longer repairable."
                            }
                        }
                    ],
