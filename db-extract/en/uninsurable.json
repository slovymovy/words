                        "entry_id": "2f83d861-d747-3776-a010-c9ac96de8486",
                        "glosses": [
                            "Not insurable; unable to be insured."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1c666d49-50aa-4601-b70f-b0abf770d284",
                                "sense_id": "ea21ef02-39ba-342d-ad51-576d25b80073",
                                "text": "“We’re not in a crisis yet, but all of the trends are in a bad direction,” said Dave Jones, who is completing his eighth and final year as California’s insurance commissioner. “We’re slowly marching toward a world that’s uninsurable.”"
                            }
                        ]
                    }
