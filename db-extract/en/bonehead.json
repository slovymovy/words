                    {
                        "sense_id": "3a47bb40-26fa-3a7f-97d3-2992307b6fe7",
                        "entry_id": "db6d9d43-274f-3336-b225-af7860e01320",
                        "glosses": [
                            "Someone who is thick-skulled, stupid, or stubborn."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "73f82934-266c-4637-a8b1-04aaa0193e2e",
                                "sense_id": "3a47bb40-26fa-3a7f-97d3-2992307b6fe7",
                                "text": "Near-synonyms: thickhead, numskull; see also Thesaurus:fool, Thesaurus:idiot"
                            },
                            {
                                "example_id": "fdb10814-a759-4147-8e26-e70eebaa4749",
                                "sense_id": "3a47bb40-26fa-3a7f-97d3-2992307b6fe7",
                                "text": "Musical Potterism, for example, is everywhere rampant. It bobs up in music criticisms and peeps forth in daily intercourse. \"Give me good old Mozart,\" cries the classical Potterite, \"and keep your modern kickshaws. Mozart is good enough for me!\" Alas, we think Mozart is too good for this bonehead, who no doubt prefers a Broadway comic opera to The Marriage of Figaro."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1ea3430-3e59-317f-95ab-f34d49afc615",
                        "entry_id": "db6d9d43-274f-3336-b225-af7860e01320",
                        "glosses": [
                            "A member of a neo-Nazi, white supremacist, and antisemitic offshoot of the skinhead subculture."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
