    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3bf2db8-0a9d-31f2-b085-115939a8ee98",
                    "sense_definition": "Endommager, détériorer ou altérer l'état de quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais attention avec ces ciseaux, tu risques d'<w>abîmer</w> la table en bois."
                        },
                        {
                            "text": "La pluie battante a complètement <w>abîmé</w> les fleurs du jardin."
                        }
                    ],
                    "synonyms": [
                        "endommager",
                        "détériorer"
                    ],
                    "common_phrases": [
                        "abîmer les yeux",
                        "abîmer la santé"
                    ]
                },
                {
                    "sense_id": "1169f4f7-3376-3059-ab27-47baca5f8f7d",
                    "sense_definition": "S'engloutir dans l'eau ou disparaître dans les profondeurs marines.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'appareil a soudainement perdu de l'altitude avant de s'<w>abîmer</w> en pleine mer."
                        },
                        {
                            "text": "Le navire pris dans la violente tempête s'est <w>abîmé</w> au large des côtes."
                        }
                    ],
                    "synonyms": [
                        "engloutir"
                    ]
                },
                {
                    "sense_id": "b631b91b-b767-3a89-8a23-a61a0d8677da",
                    "sense_definition": "S'absorber profondément et se perdre dans une pensée ou un sentiment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Assis près de la fenêtre, le poète s'<w>abîmait</w> dans une profonde mélancolie."
                        },
                        {
                            "text": "Elle s'est <w>abîmée</w> dans ses pensées et n'a pas remarqué le temps qui passait."
                        }
                    ]
                }
            ]
        }
    ]
