                "senses": [
                    {
                        "sense_id": "a17e2dc1-22ea-35c8-bdf3-162d6141c95c",
                        "entry_id": "d572d4bd-3d32-3cc0-abd4-877e5ceef94a",
                        "glosses": [
                            "kleine Kapelle für die Andacht des Parkbesitzers im Park, oder für Reisende und Besucher des Parkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fce85ba-faab-4a5e-8c30-e73de3c11abb",
                                "sense_id": "a17e2dc1-22ea-35c8-bdf3-162d6141c95c",
                                "text": "„Am kommenden Sonntag wird eine Kinderkirche zum Thema Ostern im Schlosspark und in der Parkkapelle gefeiert.“"
                            },
                            {
                                "example_id": "37be8bd1-5e06-4322-b1c6-3aca48e05969",
                                "sense_id": "a17e2dc1-22ea-35c8-bdf3-162d6141c95c",
                                "text": "„Dies auch im Blick auf das künstlerisch so hervorragende Werk des sterbenden Kriegers von Professor Albicker in der Parkkapelle, zu dem es ein aufrüttelndes Gegenstück werden muß.“"
                            },
                            {
                                "example_id": "4b4b55f1-40d3-4ce8-a33c-b82c8c6874c1",
                                "sense_id": "a17e2dc1-22ea-35c8-bdf3-162d6141c95c",
                                "text": "„Carlos Sohn, hochgradig exzentrisch, hatte zu viele Schulden, die die Eltern begleichen mussten (sie fanden in der Parkkapelle ihre letzte Ruhe).“"
                            },
                            {
                                "example_id": "95a4e260-d2b6-46a9-a07c-27bff51d1910",
                                "sense_id": "a17e2dc1-22ea-35c8-bdf3-162d6141c95c",
                                "text": "„Als er 1829 – in Folge des Besuchs des Zaren – gebeten wurde, eine ebenfalls dem Heiligen Alexander Newski geweihte Parkkapelle in Peterhof zu entwerfen – greift er erneut auf die Ideen zurück und schafft eine gleichgroße gotische Variante der Potsdamer Kapelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
