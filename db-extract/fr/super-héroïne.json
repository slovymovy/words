                ],
                "senses": [
                    {
                        "sense_id": "20fb5e4b-6985-36ba-a626-734ac5b34f8e",
                        "entry_id": "e3a3d396-cd81-32f7-9575-f6b298d30d33",
                        "glosses": [
                            "Personnage de fiction dotée de super-pouvoirs, et les utilisant pour le bien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5076acfa-921a-46e5-854a-6ddade5cae83",
                                "sense_id": "20fb5e4b-6985-36ba-a626-734ac5b34f8e",
                                "text": "Alors qu’on se demande si Hulk a pu rendre visite à la Veuve Noire dans le monde de l’âme (Endgame), on se demande aussi pourquoi les scénaristes n’ont pas intégré des funérailles pour la super-héroïne à l’intrigue."
                            },
                            {
                                "example_id": "e020da16-c73f-4c80-9a41-6454f2ef3824",
                                "sense_id": "20fb5e4b-6985-36ba-a626-734ac5b34f8e",
                                "text": "Cinéma et super-héroïnes, ce samedi 17 juin, accueil de Laurent Véray et Carole Aurouet à 15h30 à Nuage Vert pour une conférence-projection autour de « Musidora, première super-héroïne de cinéma »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40209d2e-ff7a-41c6-bc8c-3e75de9edac6",
                        "source_entry_id": "e3a3d396-cd81-32f7-9575-f6b298d30d33",
                        "source_sense_id": "20fb5e4b-6985-36ba-a626-734ac5b34f8e",
                        "target_lang_word": "Superheldin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Superheldin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70d3ebfe-127e-376e-8874-549416c5ce9e",
                                        "entry_id": "6552f625-d773-3d95-8155-8e87a6b612c9",
                                        "glosses": [
                                            "Heldin mit besonderen Eigenschaften oder Fähigkeiten, meist mit Superkräften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "519aa910-1e73-403f-8d9c-6536cd7cab91",
                                                "sense_id": "70d3ebfe-127e-376e-8874-549416c5ce9e",
                                                "text": "„Die neue Batwoman hat alles, was die Superheldin von heute braucht: Sie ist schön, stark, blitzschnell, hat eine komplexe Vergangenheit – und sie ist lesbisch“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60e8cd87-ee89-4181-a98b-5211008d3289",
                        "source_entry_id": "e3a3d396-cd81-32f7-9575-f6b298d30d33",
                        "source_sense_id": "20fb5e4b-6985-36ba-a626-734ac5b34f8e",
                        "target_lang_word": "superhero",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superhero",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46dbde19-4ff8-3c37-8bc0-5b4c3935e6bb",
                                        "entry_id": "2831b0c8-5f10-3caa-a877-83b012157313",
                                        "glosses": [
                                            "Any fictional crime-fighting character, often with supernatural powers or equipment, in popular children's and fantasy literature; a fictional hero who does great things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a742330-e4eb-4934-bfbd-85dcc9dbc943",
                                                "sense_id": "46dbde19-4ff8-3c37-8bc0-5b4c3935e6bb",
                                                "text": "Hobbes: Super heroes wear snow pants?\nStupendous Man: When there's snow out, they do!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "686dfc6f-5b9b-3b98-9c06-d46bf8ce6f89",
                                        "entry_id": "2831b0c8-5f10-3caa-a877-83b012157313",
                                        "glosses": [
                                            "A particularly renowned real-world hero, or one who has seemingly impossible abilities."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acff2f6d-d215-4702-8223-3c3fb8a280e1",
                                                "sense_id": "686dfc6f-5b9b-3b98-9c06-d46bf8ce6f89",
                                                "text": "The power is out but you're watching TV? You must be a superhero."
                                            },
                                            {
                                                "example_id": "39f59340-b8db-4bcf-8778-8c3215cdfd0c",
                                                "sense_id": "686dfc6f-5b9b-3b98-9c06-d46bf8ce6f89",
                                                "text": "Thanks for driving out here and towing me out of the ditch. You're a superhero!"
                                            },
                                            {
                                                "example_id": "e88fac8c-6db7-4692-8e7e-5302a559cbca",
                                                "sense_id": "686dfc6f-5b9b-3b98-9c06-d46bf8ce6f89",
                                                "text": "Did you know your community has many invisible superheroes? Each day they perform hundreds of amazing feats that make the community a better place in which to live."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
