                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1f5f3dc-7868-4c0a-b121-ddabb054992d",
                                                "sense_id": "86fd0494-bb75-3ba2-98ac-3c57987203e5",
                                                "text": "He engraved his name."
