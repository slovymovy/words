                "entry_id": "7de40fd4-6da1-3da1-9697-44047a952b5c",
                "word": "millénium",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5ced47e0-ac17-416a-9175-88943f8e24b5",
                        "entry_id": "7de40fd4-6da1-3da1-9697-44047a952b5c",
                        "tags": [
                            "plural"
