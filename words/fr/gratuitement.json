                    "sense_id": "01307790-7803-33af-ac59-24bb7a3bba3b",
                    "sense_definition": "D'une manière gratuite, sans avoir à payer ou sans rétribution.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sans_frais",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous pouvez télécharger cette application <w>gratuitement</w> sur votre téléphone portable.",
                            "target_lang_translations": {
                                "en": "You can download this app <w>free</w> on your mobile phone.",
                                "ru": "Вы можете <w>бесплатно</w> скачать это приложение на свой мобильный телефон.",
                                "de": "Sie können diese App auf Ihrem Handy <w>kostenlos</w> herunterladen.",
                                "es": "Puedes descargar esta aplicación <w>gratis</w> en tu teléfono móvil.",
                                "zh": "你可以在手机上<w>免费</w>下载这款应用。"
                            }
                        },
                        {
                            "text": "Le musée ouvre ses portes <w>gratuitement</w> le premier dimanche de chaque mois.",
                            "target_lang_translations": {
                                "en": "The museum admits visitors <w>free</w> on the first Sunday of every month.",
                                "ru": "В первое воскресенье каждого месяца музей принимает посетителей <w>бесплатно</w>.",
                                "de": "Das Museum öffnet am ersten Sonntag jedes Monats <w>kostenlos</w> seine Türen.",
                                "es": "El museo abre sus puertas <w>gratis</w> el primer domingo de cada mes.",
                                "zh": "博物馆每月第一个星期日<w>免费</w>开放。"
                            }
