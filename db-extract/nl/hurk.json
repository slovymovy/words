                "senses": [
                    {
                        "sense_id": "c147d2d7-2822-3413-b839-5c633382cc2e",
                        "entry_id": "2a385412-c70d-3be5-b0a3-9e28d61d311c",
                        "glosses": [
                            "houding waarbij men met gebogen knieën op de onderbenen rust"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c731ad2c-1b70-474c-bc2f-b6e52f5c7443",
                                "sense_id": "c147d2d7-2822-3413-b839-5c633382cc2e",
                                "text": "Soms is het lastig weer uit een hurk overeind te komen."
                            },
                            {
                                "example_id": "a1dc94cc-7b72-48f9-a116-265260c16612",
                                "sense_id": "c147d2d7-2822-3413-b839-5c633382cc2e",
                                "text": "Eerst hadden we nog een poging gedaan om de boer, die enkel een lendendoek droeg, duidelijk te maken dat hij naar het naaste dorp moest lopen om hulp te halen; maar hij was niet uit de diepe hurk te krijgen waarin hij aanstonds was neergezonken."
                            },
                            {
                                "example_id": "690af162-90e1-4b8a-9e65-41bb5e50917f",
                                "sense_id": "c147d2d7-2822-3413-b839-5c633382cc2e",
                                "text": "⧖ Regt op haar aan treedende, kwam een van haar zonder spiets naa my toe, gaande op de hurk sitten, als voor deesen, ik wenkten hem op te staan, dat hy deed: (…)"
                            }
                        ]
                    },
                    {
                        "sense_id": "90a9c395-aaee-31a9-97d4-aa385a776b49",
                        "entry_id": "2a385412-c70d-3be5-b0a3-9e28d61d311c",
                        "glosses": [
                            "een kind zo klein als iemand die op zijn hurken rust"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c79f4ba1-0f9e-4ffb-8665-65bbd9e6951e",
                                "sense_id": "90a9c395-aaee-31a9-97d4-aa385a776b49",
                                "text": "Hij was nog maar een hurkje."
                            }
                        ]
                    }
                ],
