                "senses": [
                    {
                        "sense_id": "98841ee1-992a-3677-a588-9da466d6c387",
                        "entry_id": "2075722a-2e30-343e-ba42-c8fa74786d09",
                        "glosses": [
                            "Reiter einer Gruppe von Eilboten, die eine Nachricht abschnittsweise wechselnd überbringen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "74cb1d16-2bf5-46d4-861f-51c523ac3652",
                                "sense_id": "98841ee1-992a-3677-a588-9da466d6c387",
                                "text": "„Die Hornsignale kündigten die Ankunft des Postreiters von Weitem an und gaben dem nächsten Stafettenreiter Bescheid, der die Sendungen transportieren sollte.“"
                            },
                            {
                                "example_id": "08a356f5-a176-4109-a004-00c37eeb9df8",
                                "sense_id": "98841ee1-992a-3677-a588-9da466d6c387",
                                "text": "„In Friedberg hielt der Rittmeister einen Stafettenreiter an und forderte ihm mit Hilfe des herbeigerufenen Bürgermeisters einen Brief des Königs von Preußen ab, der an eine Madame Rietz gerichtet war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
