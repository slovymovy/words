                {
                    "sense_id": "5c036027-2f12-3572-9ae5-502f028a5164",
                    "sense_definition": "An idea, opinion, or piece of information produced by thinking, or occurring suddenly in the mind.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mental_content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>thought</w> crossed my mind while I was walking.",
                            "target_lang_translations": {
                                "ru": "Внезапная <w>мысль</w> пришла мне в голову, пока я гулял.",
                                "es": "Un <w>pensamiento</w> repentino cruzó mi mente mientras caminaba.",
                                "nl": "Een plotselinge <w>gedachte</w> schoot door mijn hoofd terwijl ik aan het wandelen was.",
                                "pl": "Podczas spaceru przyszła mi do głowy nagła <w>myśl</w>.",
                                "de": "Ein plötzlicher <w>Gedanke</w> kam mir beim Spazierengehen in den Sinn."
                            }
                        },
                        {
                            "text": "I hate the <w>thought</w> of going back to work on Monday.",
                            "target_lang_translations": {
                                "ru": "Я ненавижу саму <w>мысль</w> о возвращении на работу в понедельник.",
                                "es": "Odio la <w>idea</w> de volver al trabajo el lunes.",
                                "nl": "Ik haat de <w>gedachte</w> dat ik maandag weer aan het werk moet.",
                                "pl": "Nienawidzę samej <w>myśli</w> o powrocie do pracy w poniedziałek.",
                                "de": "Ich hasse den <w>Gedanken</w> daran, am Montag wieder arbeiten zu müssen."
                            }
                        }
                    ],
                    "synonyms": [
                        "reflection",
                        "musing",
                        "idea"
                    ],
                    "common_phrases": [
                        "second thought",
                        "perish the thought",
                        "train of thought"
                    ],
                    "target_lang_definitions": {
