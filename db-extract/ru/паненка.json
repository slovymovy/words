                "senses": [
                    {
                        "sense_id": "557ae6f4-8dc2-38df-a51b-d06ba73bfe1d",
                        "entry_id": "5d61ba8f-3510-363a-a598-0600a47dec94",
                        "glosses": [
                            "устар. то же, что барышня; девица"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a756a22-8fde-451a-a2a4-0f5043eb3e19",
                                "sense_id": "557ae6f4-8dc2-38df-a51b-d06ba73bfe1d",
                                "text": "Пан довудца сегодня даёт бал; а потому в лагерь понаедет много панов и паненок."
                            },
                            {
                                "example_id": "82c312c0-1fc3-4a6c-9d27-9f901b284deb",
                                "sense_id": "557ae6f4-8dc2-38df-a51b-d06ba73bfe1d",
                                "text": "― Прямо глядеть сладко: два красивых паныча и две сличных паненки."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee601165-b651-3a30-995a-dae20f197674",
                        "entry_id": "5d61ba8f-3510-363a-a598-0600a47dec94",
                        "glosses": [
                            "спорт. в Футболе — штрафной удар в ворота с одиннадцатиметровой точки, при котором мяч летит по навесной траектории по центру (назван в честь чехословацкого полузащитника Антонина Паненки)"
                        ],
