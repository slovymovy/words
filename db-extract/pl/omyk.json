                "senses": [
                    {
                        "sense_id": "92dc49b5-4b3e-316c-b698-fa6a9203a2ba",
                        "entry_id": "188df2e9-5bc0-3250-a00f-f445e1ac1d1a",
                        "glosses": [
                            "ogon zająca"
                        ],
                        "tags": [],
