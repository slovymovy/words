{
    "word_family": [
        "somberheid",
        "somberen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "034a9e8c-07f3-3867-9d7b-ef0e8ed0179d",
                    "sense_definition": "in een neerslachtige of verdrietige stemming verkerend",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gemoedstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was in een <w>sombere</w> bui na het slechte nieuws.",
                            "target_lang_translations": {
                                "en": "He was in a <w>gloomy</w> mood after the bad news.",
                                "ru": "Он был в <w>мрачном</w> настроении после плохих новостей."
                            }
                        },
                        {
                            "text": "Zijn stem klinkt <w>somber</w> en uitgeput aan de telefoon.",
                            "target_lang_translations": {
                                "en": "His voice sounds <w>somber</w> and exhausted on the phone.",
                                "ru": "Его голос по телефону звучит <w>уныло</w> и изнеможденно."
                            }
                        }
                    ],
                    "antonyms": [
                        "vrolijk",
                        "opgewekt"
                    ],
                    "common_phrases": [
                        "sombere bui",
                        "sombere gedachten"
                    ],
                    "target_lang_definitions": {
                        "en": "being in a depressed or sad mood",
                        "ru": "находиться в подавленном или грустном настроении"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gloomy",
                                "target_lang_sense_clarification": "feeling sad and without hope"
                            },
                            {
                                "target_lang_word": "somber",
                                "target_lang_sense_clarification": "serious and sad in mood"
                            },
                            {
                                "target_lang_word": "depressed",
                                "target_lang_sense_clarification": "feeling very unhappy and dejected"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "о настроении человека"
                            },
                            {
                                "target_lang_word": "унылый",
                                "target_lang_sense_clarification": "грустный и безрадостный"
                            },
                            {
                                "target_lang_word": "подавленный",
                                "target_lang_sense_clarification": "в состоянии депрессии или сильной грусти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "245c44e4-a940-377c-988b-a2f97ef01325",
                    "sense_definition": "met weinig licht of zonneschijn, vaak grijs en donker",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "omgeving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een <w>somber</w> weer is het vandaag met al die regen.",
                            "target_lang_translations": {
                                "en": "What <w>gloomy</w> weather it is today with all that rain.",
                                "ru": "Какая сегодня <w>пасмурная</w> погода со всем этим дождем."
                            }
                        },
                        {
                            "text": "De kamer zag er erg <w>somber</w> uit zonder ramen.",
                            "target_lang_translations": {
                                "en": "The room looked very <w>dreary</w> without windows.",
                                "ru": "Комната выглядела очень <w>мрачно</w> без окон."
                            }
                        }
                    ],
                    "synonyms": [
                        "zonloos",
                        "donker",
                        "grauw"
                    ],
                    "antonyms": [
                        "zonnig",
                        "licht"
                    ],
                    "common_phrases": [
                        "somber weer",
                        "sombere kamer"
                    ],
                    "target_lang_definitions": {
                        "en": "with little light or sunshine, often gray and dark",
                        "ru": "с малым количеством света или солнечного сияния, часто серый и темный"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gloomy",
                                "target_lang_sense_clarification": "dark or poorly lit in a way that is depressing"
                            },
                            {
                                "target_lang_word": "dreary",
                                "target_lang_sense_clarification": "dull, bleak, and lifeless"
                            },
                            {
                                "target_lang_word": "somber",
                                "target_lang_sense_clarification": "dark or dull in color or tone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пасмурный",
                                "target_lang_sense_clarification": "о погоде или небе"
                            },
                            {
                                "target_lang_word": "хмурый",
                                "target_lang_sense_clarification": "темный и неприветливый (о погоде или комнате)"
                            },
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "темный, лишенный света"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d04f4592-ce79-36d0-9f41-c7d5075bc6cb",
                    "sense_definition": "iets dat een neerslachtige stemming bij anderen oproept",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gemoedstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er kwam toen een <w>sombere</w> mededeling over de toekomst van het bedrijf.",
                            "target_lang_translations": {
                                "en": "Then came a <w>somber</w> announcement about the future of the company.",
                                "ru": "Затем последовало <w>мрачное</w> сообщение о будущем компании."
                            }
                        },
                        {
                            "text": "Zij droeg <w>sombere</w> kleding tijdens de begrafenis van haar oom.",
                            "target_lang_translations": {
                                "en": "She wore <w>somber</w> clothes during her uncle's funeral.",
                                "ru": "Она была в <w>траурной</w> одежде на похоронах своего дяди."
                            }
                        }
                    ],
                    "antonyms": [
                        "hoopvol"
                    ],
                    "common_phrases": [
                        "sombere mededeling",
                        "sombere kleuren"
                    ],
                    "target_lang_definitions": {
                        "en": "something that evokes a depressed mood in others",
                        "ru": "что-то, что вызывает подавленное настроение у других"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "somber",
                                "target_lang_sense_clarification": "grave or even dismal in character"
                            },
                            {
                                "target_lang_word": "depressing",
                                "target_lang_sense_clarification": "causing feelings of hopelessness or sadness"
                            },
                            {
                                "target_lang_word": "grim",
                                "target_lang_sense_clarification": "depressing or worrying to consider"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "серьезный и печальный (о новостях или одежде)"
                            },
                            {
                                "target_lang_word": "невеселый",
                                "target_lang_sense_clarification": "вызывающий грустные мысли"
                            },
                            {
                                "target_lang_word": "траурный",
                                "target_lang_sense_clarification": "соответствующий обстановке похорон"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0f7a03d-0990-3ca9-bd7c-b2d4f9c689f8",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>somberen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>somber</w> vaak als ik alleen thuis ben in de winter.",
                            "target_lang_translations": {
                                "en": "I often <w>mope</w> when I am home alone in the winter.",
                                "ru": "Я часто <w>хандрю</w>, когда зимой остаюсь дома один."
                            }
                        },
                        {
                            "text": "Vandaag <w>somber</w> ik over de resultaten van mijn examen.",
                            "target_lang_translations": {
                                "en": "Today I am <w>brooding</w> over the results of my exam.",
                                "ru": "Сегодня я <w>пребываю в унынии</w> из-за результатов моего экзамена."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present tense of 'to be gloomy' or 'to mope'",
                        "ru": "первое лицо единственного числа настоящего времени глагола 'somberen' (пребывать в унынии)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mope",
                                "target_lang_sense_clarification": "to be dejected and listless"
                            },
                            {
                                "target_lang_word": "brood",
                                "target_lang_sense_clarification": "to think deeply about something that makes one unhappy"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хандрю",
                                "target_lang_sense_clarification": "находиться в унылом состоянии"
                            },
                            {
                                "target_lang_word": "мрачнею",
                                "target_lang_sense_clarification": "становиться грустным или серьезным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c842c5a-511d-3f1c-a04a-c6d1f5025c5c",
                    "sense_definition": "gebiedende wijs van <w>somberen</w>",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Somber</w> niet zo over de toekomst, alles komt goed.",
                            "target_lang_translations": {
                                "en": "Don't <w>be so gloomy</w> about the future, everything will be fine.",
                                "ru": "Не <w>унывай</w> так из-за будущего, всё будет хорошо."
                            }
                        },
                        {
                            "text": "Houd op met dat geklaag en <w>somber</w> ergens anders!",
                            "target_lang_translations": {
                                "en": "Stop that complaining and <w>mope</w> somewhere else!",
                                "ru": "Прекрати эти жалобы и <w>хандри</w> в другом месте!"
                            }
                        }
                    ],
                    "synonyms": [
                        "zonloos"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'to be gloomy' or 'to mope'",
                        "ru": "повелительное наклонение глагола 'somberen' (пребывать в унынии)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mope",
                                "target_lang_sense_clarification": "to act in a dejected or gloomy manner"
                            },
                            {
                                "target_lang_word": "be gloomy",
                                "target_lang_sense_clarification": "to exhibit a dark or sad mood"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хандри",
                                "target_lang_sense_clarification": "форма повелительного наклонения от 'хандрить'"
                            },
                            {
                                "target_lang_word": "унывай",
                                "target_lang_sense_clarification": "форма повелительного наклонения от 'унывать'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
