                ],
                "senses": [
                    {
                        "sense_id": "8d159bc1-1318-35bd-b3f6-fce44e42f42f",
                        "entry_id": "bb4edb00-46c2-3196-91fb-1704845fdfd6",
                        "glosses": [
                            "S'observer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59d7ace0-2c28-45fe-ada4-8fbbc6124f3b",
                                "sense_id": "8d159bc1-1318-35bd-b3f6-fce44e42f42f",
                                "text": "Comme tout système peut s'auto-observer et qu'un autre système peut observer son observation, on évite une position sceptique."
                            },
                            {
                                "example_id": "6c7c5dfc-2b1a-42dc-a19c-bb5ed77388b6",
                                "sense_id": "8d159bc1-1318-35bd-b3f6-fce44e42f42f",
                                "text": "Il devient alors impossible d'atteindre une cohérence interne qui soit capable de s'auto-observer et de s'autosurveiller de façon à s'harmoniser en prenant chaque fois en ligne de compte tous les éléments pertinents."
                            }
                        ]
                    }
                ],
