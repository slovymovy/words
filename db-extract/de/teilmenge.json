                    },
                    {
                        "translation_id": "7f80dbcd-f0b9-4821-bfaa-644151bd9d24",
                        "source_entry_id": "b08705ee-be19-393d-a652-d3626a212d01",
                        "source_sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                        "source_sense_description": "Mathematik, Mengenlehre: eine Menge, die nur Elemente einer anderen Menge enthält",
                        "target_lang_word": "sous-ensemble",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-ensemble",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4940d73b-fd0d-398f-b2f7-cdf37b95d895",
                                        "entry_id": "92835c06-5b0d-3c5f-94f0-5998bf314323",
                                        "glosses": [
                                            "Partie d’un ensemble."
                                        ],
                                        "tags": [
                                            "Théorie des ensembles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e19a2912-5467-48fa-8909-60acd872ae1e",
                                                "sense_id": "4940d73b-fd0d-398f-b2f7-cdf37b95d895",
                                                "text": "En mathématiques, un ensemble A est un sous-ensemble ou une partie d’un ensemble B, ou encore B est un sur-ensemble de A, si tout élément du sous-ensemble A est aussi élément du sur-ensemble B."
                                            },
                                            {
                                                "example_id": "1df5c2ab-529c-4b63-8c70-4866912f806c",
                                                "sense_id": "4940d73b-fd0d-398f-b2f7-cdf37b95d895",
                                                "text": "Un ensemble s est un sous-ensemble de t si tous les éléments de s sont aussi dans t. Par exemple, l’ensemble {1} est un sous-ensemble de {1,2}."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37772bd8-c86a-325f-bf1a-f07a20a1cee9",
                                        "entry_id": "92835c06-5b0d-3c5f-94f0-5998bf314323",
                                        "glosses": [
                                            "Langage de programmation hérité d’un autre langage dont il exclut un nombre plus ou moins important de fonctionnalités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c652d907-166b-4a17-92db-b5a27ed8ce1d",
                                                "sense_id": "37772bd8-c86a-325f-bf1a-f07a20a1cee9",
                                                "text": "Sous-ensemble de Visual Basic utilisé en tant que langage de script d'usage général, VBScript a un champ d’application bien plus large que JavaScript auquel il est pourtant souvent comparé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
