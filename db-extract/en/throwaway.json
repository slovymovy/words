    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3828a23a-6107-3e26-92f3-b89e7117adba",
                "word": "throwaway",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2eee6176-fcbf-3bd0-8423-da40992aa6b4",
                        "entry_id": "3828a23a-6107-3e26-92f3-b89e7117adba",
                        "glosses": [
                            "Disposable; intended for a single use prior to being discarded."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a846afc0-8a1a-4d9a-9c33-958ecfab702b",
                                "sense_id": "2eee6176-fcbf-3bd0-8423-da40992aa6b4",
                                "text": "Water was provided in throwaway plastic bottles, but the more ecologically minded of us refilled our initial bottles from the fountain."
                            },
                            {
                                "example_id": "b82cddd7-83d3-46ec-b27b-11bf07045047",
                                "sense_id": "2eee6176-fcbf-3bd0-8423-da40992aa6b4",
                                "text": "More people means that more synthetic compounds and dangerous throwaway plastics are manufactured, many of which add to the growing toxification of the Earth."
                            }
                        ]
                    },
                    {
                        "sense_id": "50376fd3-7e54-3631-81b5-a1552b5379b9",
                        "entry_id": "3828a23a-6107-3e26-92f3-b89e7117adba",
                        "glosses": [
                            "Extemporaneous; off the cuff."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "acd72f82-2f7a-4b58-84d1-e2200508bf25",
                                "sense_id": "50376fd3-7e54-3631-81b5-a1552b5379b9",
                                "text": "The host made a throwaway remark about the president that was later repeated on the television news."
                            }
                        ]
                    },
                    {
                        "sense_id": "029ff369-4bba-3505-9540-0aa2968def62",
                        "entry_id": "3828a23a-6107-3e26-92f3-b89e7117adba",
                        "glosses": [
                            "Given in a casual manner, either deliberately or unconsciously, with apparent disregard for effect."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "736d2497-ba06-40a9-93e9-6880ad4200b0",
                                "sense_id": "029ff369-4bba-3505-9540-0aa2968def62",
                                "text": "As the film opens, a martial-drum-dominated version of the \"Star Wars\" theme and the inevitable bottom-to-top print crawl inform us that the Clone Wars, a conflict that originated as a throwaway line in the original 1977 film... https://web.archive.org/web/20150911134648/http://www.nysun.com/arts/star-wars-clone-wars-painted-in-the-stars/83922/"
                            },
                            {
                                "example_id": "892b2b37-db0c-4660-9b5f-2999c9078265",
                                "sense_id": "029ff369-4bba-3505-9540-0aa2968def62",
                                "text": "I was intrigued by the exchange in one of the opening scenes where the Warden says to Snake: \"You flew the wing-five over Leningrad, didn't you?\" It turns out to be just a throwaway line, but for a moment it worked like the best SF, where a casual reference can imply a lot. https://web.archive.org/web/20120125090151/http://project.cyberpunk.ru/idb/gibson_interview.html"
                            },
                            {
                                "example_id": "9f33025c-4c2f-464e-ac94-bfb79f302339",
                                "sense_id": "029ff369-4bba-3505-9540-0aa2968def62",
                                "text": "In one throwaway visual gag, the towering filing cabinet behind his desk is shown to have no drawers at all, but several concealed mirrors instead."
                            }
                        ]
                    }
                ],
