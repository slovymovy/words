                                        ]
                                    },
                                    {
                                        "sense_id": "e25de220-1a84-3cde-9c77-da2161fef383",
                                        "entry_id": "aba27808-1399-3898-9bcc-d631832d5373",
                                        "glosses": [
                                            "Closely connected or related."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da819f3-8c15-49a6-a88c-e5b0dce25f0f",
                                                "sense_id": "e25de220-1a84-3cde-9c77-da2161fef383",
                                                "text": "The deceased man had no near relatives."
                                            },
                                            {
                                                "example_id": "5fa36660-6037-4a96-bb86-5117971a28cc",
                                                "sense_id": "e25de220-1a84-3cde-9c77-da2161fef383",
                                                "text": "she is thy fathers neere kinswoman."
