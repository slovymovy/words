{
    "word_family": [
        "belasting",
        "belastbaar",
        "overbelasten",
        "last",
        "lastig"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bccdc7ec-3336-3d05-b3f0-76b8be6c6943",
                    "sense_definition": "fysiek gewicht plaatsen op een object of constructie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysieke druk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jullie hebben de auto te veel <w>belast</w> met al die zware koffers.",
                            "target_lang_translations": {
                                "en": "You have <w>loaded</w> the car too much with all those heavy suitcases."
                            }
                        },
                        {
                            "text": "De houten trap kraakte omdat je de treden te zwaar <w>belastte</w>.",
                            "target_lang_translations": {
                                "en": "The wooden stairs creaked because you <w>put too much weight</w> on the steps."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevrachten",
                        "laden"
                    ],
                    "antonyms": [
                        "ontlasten"
                    ],
                    "common_phrases": [
                        "te zwaar belasten",
                        "maximaal belasten"
                    ],
                    "target_lang_definitions": {
                        "en": "to place physical weight on an object or structure"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "load",
                                "target_lang_sense_clarification": "to put weight on something"
                            },
                            {
                                "target_lang_word": "put a strain on",
                                "target_lang_sense_clarification": "to apply physical pressure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff02ba61-47ac-3bcc-ac4d-8b3d6b842deb",
                    "sense_definition": "een grote inspanning of prestatie vergen van een systeem, lichaam of geest",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "inspanning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De server werd een lange tijd te zwaar <w>belast</w> waardoor hij uiteindelijk uitviel.",
                            "target_lang_translations": {
                                "en": "The server was <w>strained</w> too heavily for a long time, which eventually caused it to fail."
                            }
                        },
                        {
                            "text": "Na de operatie mag de patiënt zijn knie nog niet volledig <w>belasten</w>.",
                            "target_lang_translations": {
                                "en": "After the surgery, the patient is not yet allowed to <w>put full weight</w> on his knee."
                            }
                        }
                    ],
                    "synonyms": [
                        "vergen",
                        "beperken"
                    ],
                    "antonyms": [
                        "ontzien",
                        "rusten"
                    ],
                    "common_phrases": [
                        "het milieu belasten",
                        "de knie belasten"
                    ],
                    "target_lang_definitions": {
                        "en": "to require great effort or performance from a system, body, or mind"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strain",
                                "target_lang_sense_clarification": "to overexert a muscle or system"
                            },
                            {
                                "target_lang_word": "put weight on",
                                "target_lang_sense_clarification": "to use a limb or joint physically"
                            },
                            {
                                "target_lang_word": "burden",
                                "target_lang_sense_clarification": "to stress a system or environment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56c7bc95-509d-3579-a339-3fc0a6d12843",
                    "sense_definition": "het opleggen van financiële verplichtingen zoals belastingen of heffingen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid heeft besloten om luxe goederen zwaarder te <w>belasten</w>.",
                            "target_lang_translations": {
                                "en": "The government has decided to <w>tax</w> luxury goods more heavily."
                            }
                        },
                        {
                            "text": "Dit huis is nog steeds met een hoge hypotheek <w>belast</w>.",
                            "target_lang_translations": {
                                "en": "This house is still <w>encumbered</w> with a high mortgage."
                            }
                        }
                    ],
                    "synonyms": [
                        "beheffen",
                        "aanslaan"
                    ],
                    "common_phrases": [
                        "met belasting belasten",
                        "met hypotheek belast"
                    ],
                    "target_lang_definitions": {
                        "en": "to impose financial obligations such as taxes or levies"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tax",
                                "target_lang_sense_clarification": "to levy a tax on something"
                            },
                            {
                                "target_lang_word": "encumber",
                                "target_lang_sense_clarification": "to burden with a mortgage or debt"
                            },
                            {
                                "target_lang_word": "charge",
                                "target_lang_sense_clarification": "to impose a fee or levy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6d97e04-3106-3ae8-890b-997e19b36877",
                    "sense_definition": "iemand een taak, opdracht of verantwoordelijkheid geven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verantwoordelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur wilde zijn assistent <w>belasten</w> met de organisatie van het feest.",
                            "target_lang_translations": {
                                "en": "The director wanted to <w>burden</w> his assistant with the organization of the party."
                            }
                        },
                        {
                            "text": "<w>Belast</w> die man toch niet met zoveel moeilijke taken tegelijk!",
                            "target_lang_translations": {
                                "en": "Don't <w>saddle</w> that man with so many difficult tasks at once!"
                            }
                        }
                    ],
                    "synonyms": [
                        "opdragen",
                        "toevertrouwen"
                    ],
                    "antonyms": [
                        "vrijstellen"
                    ],
                    "common_phrases": [
                        "met een taak belasten",
                        "iemand belasten met"
                    ],
                    "target_lang_definitions": {
                        "en": "to give someone a task, assignment, or responsibility"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "burden",
                                "target_lang_sense_clarification": "to give someone a difficult task"
                            },
                            {
                                "target_lang_word": "saddle with",
                                "target_lang_sense_clarification": "to give someone an unwanted responsibility"
                            },
                            {
                                "target_lang_word": "task with",
                                "target_lang_sense_clarification": "to assign a specific duty"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "849edb03-79be-3818-b59a-4ba479851ee5",
                    "sense_definition": "bewijs leveren dat iemands schuld of betrokkenheid bij een misdrijf aantoont",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "juridisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De getuigenis van de buurman zal de verdachte ernstig <w>belasten</w>.",
                            "target_lang_translations": {
                                "en": "The neighbor's testimony will seriously <w>incriminate</w> the suspect."
                            }
                        },
                        {
                            "text": "Er werd nieuw bewijsmateriaal gevonden dat hem direct kon <w>belasten</w>.",
                            "target_lang_translations": {
                                "en": "New evidence was found that could directly <w>implicate</w> him."
                            }
                        }
                    ],
                    "synonyms": [
                        "beschuldigen",
                        "incrimineren"
                    ],
                    "antonyms": [
                        "ontlasten",
                        "vrijpleiten"
                    ],
                    "common_phrases": [
                        "belastend bewijs",
                        "een getuige belasten"
                    ],
                    "target_lang_definitions": {
                        "en": "to provide evidence that shows someone's guilt or involvement in a crime"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "incriminate",
                                "target_lang_sense_clarification": "to make someone appear guilty"
                            },
                            {
                                "target_lang_word": "implicate",
                                "target_lang_sense_clarification": "to show involvement in a crime"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}