                    {
                        "translation_id": "8751de15-bbe3-405c-b432-917b51489ef0",
                        "source_entry_id": "1f7945c3-9590-3495-81d4-882e2c6d7caa",
                        "source_sense_id": "6dd41687-129e-3517-b40a-3037019c9628",
                        "target_lang_word": "albinos",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "albinos",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ca944d0-1db3-36eb-94d6-b5943a362cb3",
                                        "entry_id": "8336a413-0b95-37c8-9445-1604b0ccd2f4",
                                        "glosses": [
                                            "Atteint d’albinisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33a0abe5-b3c2-433c-a19e-f8d2d377d1b0",
                                                "sense_id": "7ca944d0-1db3-36eb-94d6-b5943a362cb3",
                                                "text": "Lapin albinos."
                                            },
                                            {
                                                "example_id": "9bc2a3f9-9ae2-4dc9-b3a8-ee6cab701739",
                                                "sense_id": "7ca944d0-1db3-36eb-94d6-b5943a362cb3",
                                                "text": "Chez beaucoup d’espèces la forme albinos est notamment plus colorée que la forme sauvage."
                                            },
                                            {
                                                "example_id": "5e52b129-97f4-4eea-b667-4ccd6aaccafd",
                                                "sense_id": "7ca944d0-1db3-36eb-94d6-b5943a362cb3",
                                                "text": "Il entre aussi, par la porte sans serrure, sans loquet, une femme albinos, à peau translucide, aux yeux rouges, aux lèvres comme rodées."
                                            },
                                            {
                                                "example_id": "f93763a7-5d92-44c1-99a9-23263b6e049b",
                                                "sense_id": "7ca944d0-1db3-36eb-94d6-b5943a362cb3",
                                                "text": "– Sais-tu que les kangourous ne sont pas tous de la couleur rousse que tu connais? Certains sont tout blancs.\n– Ils sont métis comme moi?\n– Pour les kangourous on a un autre mot. On dit qu'ils sont albinos. Je ne crois pas que ça les dérange."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "albinos",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20026eee-8e0d-3d76-8b02-4d70f7adbeeb",
                                        "entry_id": "903777c9-5414-3148-a08c-8be0a1e9efbf",
                                        "glosses": [
                                            "Personne, animal ou plante atteint d’albinisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb2ae796-0385-4079-adf7-bf1c584e792e",
                                                "sense_id": "20026eee-8e0d-3d76-8b02-4d70f7adbeeb",
                                                "text": "Les albinos ont les yeux tellement sensibles qu’il leur est impossible de supporter la lumière du jour."
                                            },
                                            {
                                                "example_id": "4a2cf502-91c7-49b7-97b8-51b3fcb20426",
                                                "sense_id": "20026eee-8e0d-3d76-8b02-4d70f7adbeeb",
                                                "text": "J'aurais tant aimé à aller au lit au moins par une fois avec une albinos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
