                        "entry_id": "85bc8a9b-e0ca-3918-90f6-22cf1ea3a6ca",
                        "glosses": [
                            "een jonge vrouw die niet is geboren in een adellijke of koninklijke familie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebda9e8c-9580-4259-b7b8-e814671f7145",
                                "sense_id": "d1bdd9b5-6ec2-3cc6-bb8b-bd336bf814a6",
                                "text": "Zweedse prins trouwt met een burgermeisje"
                            },
                            {
                                "example_id": "81fc02bf-ae77-455b-8238-34125f0b6094",
                                "sense_id": "d1bdd9b5-6ec2-3cc6-bb8b-bd336bf814a6",
                                "text": "Het Argentijnse burgermeisje en de gewezen bankemployee blijft dankzij haar deskundigheid, intelligentie, ambitie en gretigheid op het wereldtoneel niet onopgemerkt."
                            },
                            {
                                "example_id": "dd970adb-e88f-4f32-847e-c4d37d76bb85",
                                "sense_id": "d1bdd9b5-6ec2-3cc6-bb8b-bd336bf814a6",
                                "text": "Van alle zeven Nederlandse koningen en koninginnen, trouwden er vijf met een Duitse prinses of prins. Alleen Willem II, die in 1816 met de Russische tsarendochter Anna Paulowna trouwde, en Willem-Alexander die in 2002 zijn jawoord gaf aan het Argentijnse burgermeisje Máxima de Zorreguieta kozen een niet-Duitse partner."
                            }
                        ]
                    }
