                ],
                "senses": [
                    {
                        "sense_id": "afc5cb28-5bb2-3d32-a566-f3f287b9ebbe",
                        "entry_id": "0dccac9b-2915-366b-94c7-7fb3e659b361",
                        "glosses": [
                            "spezielle Kleidung, die den Träger oder weitere Personen vor Schaden bewahren soll (beispielsweise vor Infektionskrankheiten, gefährlichen Chemikalien oder Verletzungen bei Unfällen beispielsweise bei Motorradfahrern)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9252eb2c-090c-4c6f-ae14-eec7ae89cae5",
                                "sense_id": "afc5cb28-5bb2-3d32-a566-f3f287b9ebbe",
                                "text": "Legen Sie die komplette Schutzkleidung an, da es zum Waffeneinsatz kommen kann!"
                            },
                            {
                                "example_id": "14949b12-a402-4ea6-9a35-95270b869ab7",
                                "sense_id": "afc5cb28-5bb2-3d32-a566-f3f287b9ebbe",
                                "text": "„Hier also ackerten geflüchtete Tagelöhner ohne Schutzkleidung unter den Plastikbergen und spritzen Fungizide und Insektizide auf die zarten Pflanzen, die dann mit EU-Gütesiegel auf unseren Tellern landeten.“"
                            },
                            {
                                "example_id": "9b9c199e-e5c3-4fdc-9b2c-9564cb7ad2a7",
                                "sense_id": "afc5cb28-5bb2-3d32-a566-f3f287b9ebbe",
                                "text": "„Um dieses Problem zu lösen, entwarfen keltische Handwerker eine neuartige Schutzkleidung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
