                "senses": [
                    {
                        "sense_id": "de61482c-db6e-3b8e-8054-e7a8da3eda6b",
                        "entry_id": "f329e31e-1cc5-33f9-91db-462c35f4ee27",
                        "glosses": [
                            "de poot van een konijn dat door sommige mensen gezien wordt als een geluksteken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03e9420f-6957-4a93-aa99-11683abcea41",
                                "sense_id": "de61482c-db6e-3b8e-8054-e7a8da3eda6b",
                                "text": "Vorige week kroop het tegen Club al door het oog van de naald, deze week had Belhocine zijn konijnenpoot mee naar Limburg. Kortrijk kan ondertussen wel een prima rapport voorleggen met Club Brugge, Gent en Anderlecht al achter de kiezen: 8 op 15 en de top zes in zicht. Sint-Truiden blijft ondertussen achter met 4 op 15. De Standaard 29 AUGUSTUS 2016 OM 03:00 UUR"
                            },
                            {
                                "example_id": "61101913-2024-497b-9cd2-e336fa53e99d",
                                "sense_id": "de61482c-db6e-3b8e-8054-e7a8da3eda6b",
                                "text": "Zelf blijft Maggie De Block er stoïcijns kalm onder – als enige in haar kabinet. ‘Stap voor stap doen we voort, ook met dat dossier. Het gaat misschien traag, maar ik ben gefocust op wat ik wil bereiken. Ik heb een sleutelhanger met daarop de woorden ‘Keep calm Maggie’. Dat is mijn konijnenpoot.’"
                            },
                            {
                                "example_id": "55078f85-c6ed-45d4-ae2c-8143dced7ac6",
                                "sense_id": "de61482c-db6e-3b8e-8054-e7a8da3eda6b",
                                "text": "’lucky’ konijnenpootjes: Een man uit Liverpool met vliegangst nam de konijnenpootjes mee als talisman voor een goede vlucht en een veilige landing."
                            }
                        ]
                    }
