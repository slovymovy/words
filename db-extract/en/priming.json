                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amorce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c242085-5f17-3f32-aea3-5d7fa2af64dd",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Appât fixé à l'hameçon d'une ligne de pêcheur, destiné à faire mordre le poisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "006d8d65-2c1f-4456-90de-c881d94f935e",
                                                "sense_id": "5c242085-5f17-3f32-aea3-5d7fa2af64dd",
                                                "text": "Le blé est une amorce plus résistante que le chènevis."
                                            },
                                            {
                                                "example_id": "de8e1786-93fa-49e8-82d7-767738401dfb",
                                                "sense_id": "5c242085-5f17-3f32-aea3-5d7fa2af64dd",
                                                "text": "— Vois, mon frère, dit-il, les ruses de l’ennemi qui nous dévore ! Voilà les amorces avec lesquelles il pêche les âmes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7508269d-a420-30cb-9d3d-18519005f1a4",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Matière explosive qui sert à enflammer la charge d’un canon, d’un fusil, d’une mine, etc."
                                        ],
                                        "tags": [
                                            "Pyrotechnie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b986293a-94d8-4d35-97b8-46a43856d28a",
                                                "sense_id": "7508269d-a420-30cb-9d3d-18519005f1a4",
                                                "text": "La voix claquait. Le vieux clignota comme si on lui eût tiré des amorces aux oreilles."
                                            },
                                            {
                                                "example_id": "8b239df1-c3a2-4088-a07e-35a103d28540",
                                                "sense_id": "7508269d-a420-30cb-9d3d-18519005f1a4",
                                                "text": "Ce sont, répondit un muletier, nos gens qui battent les buissons à la ronde, et brûlent des amorces pour amuser les brigands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e719e039-a96b-329f-a4c5-f8067a9b291e",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Appât, ce qui attire vers quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0679a8d3-60da-4416-913e-d30b2407581f",
                                                "sense_id": "e719e039-a96b-329f-a4c5-f8067a9b291e",
                                                "text": "La gloire a de puissantes amorces pour les grandes âmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9058f56f-0717-370f-8728-82bf5b85b633",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Oligonucléotide qui, hybridé avec une matrice d'acide nucléique, permet à une polymérase de déclencher la synthèse du brin complémentaire."
                                        ],
                                        "tags": [
                                            "Biologie moléculaire"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1c7362f-0f64-36e7-8c6f-eaf7fe454dce",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Partie de muraille non achevée et qui doit être continuée plus tard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf0b3bdd-eecb-326b-bfd2-2554c30bc57b",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Partie d’une route, d’une rue commencée à l’une de ses extrémités."
                                        ],
                                        "tags": [
                                            "Ponts et chaussées"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ddc3b2a-8dc6-3477-b7cc-c2ad96430bac",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Début d'un espace géographique."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed508c66-b565-4bf7-b27b-35178001b677",
                                                "sense_id": "2ddc3b2a-8dc6-3477-b7cc-c2ad96430bac",
                                                "text": "Tout fut centré sur le Grand Canal, commencé dès 1668, et dont Madeleine de Seudery avait vu l’amorce."
                                            },
                                            {
                                                "example_id": "d1c8c6a1-d050-44d1-a800-55b80ef08b68",
                                                "sense_id": "2ddc3b2a-8dc6-3477-b7cc-c2ad96430bac",
                                                "text": "Deux bois, l'un à son amorce, l'autre au mitan, chevauchent la longue articulation crayeuse qui porte le nom de plateau de Lorette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "031e4c0e-83a8-34c3-b386-a303e1595dc2",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Début d'une action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64977fb0-198d-4726-8a79-3f21bae6ebd6",
                                                "sense_id": "031e4c0e-83a8-34c3-b386-a303e1595dc2",
                                                "text": "La position de la tête est originale puisqu'elle est inclinée vers l'épaule droite, cette amorce de mouvement étant unique dans la statuaire mégalithique corse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31bb7244-161c-34c4-a76b-78eadd47710c",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Programme nécessaire à la mise en marche d'un ordinateur, et exécuté à chaque mise sous tension ou réinitialisation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f85d0f27-3ed2-3a2c-b6c8-3486e62ff12e",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Marque faite avec un poinçon ou un amorçoir sur du bois, du métal, de la pierre, etc. pour repérer l'emplacement où doit se faire un perçage."
                                        ],
