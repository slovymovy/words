                "senses": [
                    {
                        "sense_id": "f072594f-2d04-3e4b-84fb-df827af2ed21",
                        "entry_id": "bc37cd6d-cf22-3799-9bd4-2afc057f3258",
                        "glosses": [
                            "Séparation des éléments d’un mélange à l’aide d’un tamis."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "788362cb-5402-3151-b656-c7001ec820f2",
                        "entry_id": "bc37cd6d-cf22-3799-9bd4-2afc057f3258",
                        "glosses": [
                            "Séparation des grains, farines ou poudres au moyen d’un tamis."
                        ],
                        "tags": [
                            "Agronomie"
                        ],
                        "examples": [
                            {
                                "example_id": "5efe0404-9baf-4ddf-baca-a61f440245c1",
                                "sense_id": "788362cb-5402-3151-b656-c7001ec820f2",
                                "text": "Le tamisage est la méthode la plus fréquente, la plus simple et la moins onéreuse."
                            },
                            {
                                "example_id": "91c29fa7-4d3e-43d3-bcbc-2fdf8e6f4dbd",
                                "sense_id": "788362cb-5402-3151-b656-c7001ec820f2",
                                "text": "Le tamisage du tabac."
                            }
                        ]
                    },
                    {
                        "sense_id": "5687734c-00bc-3b62-866e-865d32f2b934",
                        "entry_id": "bc37cd6d-cf22-3799-9bd4-2afc057f3258",
                        "glosses": [
                            "Opération consistant à trier les terres fouillées afin d’y retrouver des vestiges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "272efc68-a0c5-4c36-9a0c-6304d1639dcf",
                                "sense_id": "5687734c-00bc-3b62-866e-865d32f2b934",
                                "text": "Grâce à la récolte minutieuse du moindre ossement et au tamisage fin des terres, on connaît de plus les habitudes alimentaires de l’époque."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7c2b66e-03de-39e3-af22-57655ab362c9",
                        "entry_id": "bc37cd6d-cf22-3799-9bd4-2afc057f3258",
                        "glosses": [
                            "Opération de séparation mécanique des particules grossières contenues dans les eaux usées."
                        ],
                        "tags": [
                            "Assainissement",
                            "Traitement de l’eau"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c646d4d9-f07c-3d4f-9779-d727bad9c5c4",
                        "entry_id": "bc37cd6d-cf22-3799-9bd4-2afc057f3258",
                        "glosses": [
                            "Effet visuel de filtrage rappelant un tamis."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d24e2adf-11d1-4794-91fb-0d87b2163d9d",
                                "sense_id": "c646d4d9-f07c-3d4f-9779-d727bad9c5c4",
                                "text": "La nature était tranquille et énervée ; une brise tiède passait mollement sur la cime des arbres, et une foule de petits ronds de soleil dansaient gaiement sur nous, multipliés à l’infini par le tamisage léger des goyaviers et des mimosas……"
                            }
                        ]
                    }
