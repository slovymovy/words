                ],
                "senses": [
                    {
                        "sense_id": "3e5ccb4a-1f6c-3cf5-8941-f68b1b2f3883",
                        "entry_id": "b24edf9f-3c6d-3cdc-8170-c6ed08bc09cd",
                        "glosses": [
                            "die Satzklammer wird im Aussagesatz durch die Teile eines komplexen Prädikats gebildet; im Nebensatz durch die Einleitewörter (Relativpronomen, Subjunktionen, …) und das finite Verb"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "243f252d-931c-40f8-87b7-2ef5e6a4fc3a",
                                "sense_id": "3e5ccb4a-1f6c-3cf5-8941-f68b1b2f3883",
                                "text": "In dem Satz „Hans ist gestern zu uns zu Besuch gekommen“ bildet die Verbgruppe „ist…gekommen“ die Satzklammer."
                            },
                            {
                                "example_id": "09f5c864-1f33-4abc-a60c-7fea120089c4",
                                "sense_id": "3e5ccb4a-1f6c-3cf5-8941-f68b1b2f3883",
                                "text": "In dem Nebensatz in „Hans tut fast alles für uns, wenn man ihn darum bittet“ ist „wenn…bittet“ (Subjunktion und finites Verb) die Satzklammer."
                            },
                            {
                                "example_id": "5c169628-4376-4a9b-8a4c-2506005235b0",
                                "sense_id": "3e5ccb4a-1f6c-3cf5-8941-f68b1b2f3883",
                                "text": "Vorfeld, Mittelfeld und Nachfeld werden in Bezug auf die Satzklammer bestimmt."
                            },
                            {
                                "example_id": "65c03f6b-d583-49ba-8ba1-2ca65af601b5",
                                "sense_id": "3e5ccb4a-1f6c-3cf5-8941-f68b1b2f3883",
                                "text": "„Eine Sonderstellung nimmt das Verb auch in der Wortstellung ein: Das verbale Satzglied umschließt die Verbalgruppe, wenn es aus zwei Elementen besteht (verbale Satzklammer)…“"
                            },
                            {
                                "example_id": "c103b0d4-b651-49b0-a460-bc11e11f4a53",
                                "sense_id": "3e5ccb4a-1f6c-3cf5-8941-f68b1b2f3883",
                                "text": "Über den Verbalkomplex: „Sein finiter Teil und seine infiniten Teile bilden sozusagen einen Rahmen oder eine Klammer. Man spricht hier von Satzrahmen oder von Satzklammer.“"
                            },
                            {
                                "example_id": "850167c9-29d3-4e27-b01a-cf3a4f98c27a",
                                "sense_id": "3e5ccb4a-1f6c-3cf5-8941-f68b1b2f3883",
                                "text": "„Die Satzklammer (der Satzrahmen) gehört zu den auffälligsten Erscheinungen des deutschen Satzes, wenn nicht der deutschen Sprache.“"
                            },
                            {
                                "example_id": "a3a95083-7168-426f-a9b2-3b147df99c5a",
                                "sense_id": "3e5ccb4a-1f6c-3cf5-8941-f68b1b2f3883",
                                "text": "„Die Satzklammer fällt weg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
