{
    "word_family": [
        "coldly",
        "coldness",
        "coldish",
        "cold-hearted"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "abeb4bd2-cf36-3dce-ac5f-c8d221611332",
                    "sense_definition": "Having a low temperature.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>cold</w> wind whistled through the trees during the winter storm.",
                            "target_lang_translations": {
                                "ru": "<w>Холодный</w> ветер свистел в деревьях во время зимней бури."
                            }
                        },
                        {
                            "text": "I prefer to drink <w>cold</w> water when I am very thirsty.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю пить <w>холодную</w> воду, когда меня мучает сильная жажда."
                            }
                        }
                    ],
                    "synonyms": [
                        "chilly",
                        "cool",
                        "icy"
                    ],
                    "antonyms": [
                        "hot",
                        "warm"
                    ],
                    "common_phrases": [
                        "cold water",
                        "cold wind",
                        "cold weather"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий низкую температуру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодный",
                                "target_lang_sense_clarification": "о предметах или веществах"
                            },
                            {
                                "target_lang_word": "студёный",
                                "target_lang_sense_clarification": "очень холодный, поэт."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1b96034-7397-312f-b30d-c17c3f918450",
                    "sense_definition": "Causing the air or environment to have a low temperature.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forecast says it will be <w>cold</w> today, so wear a coat.",
                            "target_lang_translations": {
                                "ru": "Прогноз говорит, что сегодня будет <w>холодно</w>, так что надень пальто."
                            }
                        },
                        {
                            "text": "Antarctica is the <w>coldest</w> place on Earth.",
                            "target_lang_translations": {
                                "ru": "Антарктида — самое <w>холодное</w> место на Земле."
                            }
                        }
                    ],
                    "synonyms": [
                        "freezing",
                        "frigid",
                        "wintry"
                    ],
                    "antonyms": [
                        "hot",
                        "warm"
                    ],
                    "common_phrases": [
                        "cold day",
                        "cold climate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся низкой температурой воздуха или окружающей среды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодный",
                                "target_lang_sense_clarification": "о погоде или климате"
                            },
                            {
                                "target_lang_word": "морозный",
                                "target_lang_sense_clarification": "очень холодный, с морозом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6437edfb-f09e-359e-a8af-34a3330e1564",
                    "sense_definition": "Feeling the sensation of low temperature, especially to the point of discomfort.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was so <w>cold</w> she was shivering uncontrollably.",
                            "target_lang_translations": {
                                "ru": "Ей было так <w>холодно</w>, что она неудержимо дрожала."
                            }
                        },
                        {
                            "text": "I am <w>cold</w> because I forgot my jacket at home.",
                            "target_lang_translations": {
                                "ru": "Мне <w>холодно</w>, потому что я забыл куртку дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "chilled",
                        "shivering"
                    ],
                    "antonyms": [
                        "hot",
                        "warm"
                    ],
                    "common_phrases": [
                        "feel cold",
                        "get cold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ощущение низкой температуры, часто доставляющее дискомфорт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодно",
                                "target_lang_sense_clarification": "о состоянии человека (мне холодно)"
                            },
                            {
                                "target_lang_word": "замерзший",
                                "target_lang_sense_clarification": "о человеке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dfca308-704a-37fb-bcb4-720f54f86a94",
                    "sense_definition": "Unfriendly; emotionally distant or unfeeling.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She shot me a <w>cold</w> glance before turning her back on me.",
                            "target_lang_translations": {
                                "ru": "Она бросила на меня <w>холодный</w> взгляд, прежде чем отвернуться."
                            }
                        },
                        {
                            "text": "His reception was <w>cold</w> and made me feel unwelcome.",
                            "target_lang_translations": {
                                "ru": "Его прием был <w>холодным</w>, и я почувствовал, что мне здесь не рады."
                            }
                        }
                    ],
                    "synonyms": [
                        "aloof",
                        "distant",
                        "unfriendly",
                        "standoffish"
                    ],
                    "antonyms": [
                        "friendly",
                        "warm",
                        "amiable"
                    ],
                    "common_phrases": [
                        "cold glance",
                        "cold shoulder",
                        "cold reception"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недружелюбный; эмоционально отстраненный или бесчувственный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодный",
                                "target_lang_sense_clarification": "о приеме или взгляде"
                            },
                            {
                                "target_lang_word": "неприветливый",
                                "target_lang_sense_clarification": "недружелюбный"
                            },
                            {
                                "target_lang_word": "равнодушный",
                                "target_lang_sense_clarification": "безразличный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72d494d0-fc34-345f-933c-362713e5d708",
                    "sense_definition": "Dispassionate; not prejudiced or partisan; based on facts rather than emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cold</w> truth is that we cannot afford this project.",
                            "target_lang_translations": {
                                "ru": "<w>Горькая</w> правда заключается в том, что мы не можем позволить себе этот проект."
                            }
                        },
                        {
                            "text": "Let's look at the <w>cold</w> facts before making a final decision.",
                            "target_lang_translations": {
                                "ru": "Давайте взглянем на <w>сухие</w> факты, прежде чем принимать окончательное решение."
                            }
                        }
                    ],
                    "synonyms": [
                        "objective",
                        "unbiased",
                        "dispassionate"
                    ],
                    "common_phrases": [
                        "cold facts",
                        "cold truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспристрастный; непредвзятый; основанный на фактах, а не на эмоциях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голый",
                                "target_lang_sense_clarification": "о фактах или истине"
                            },
                            {
                                "target_lang_word": "трезвый",
                                "target_lang_sense_clarification": "о расчете или подходе"
                            },
                            {
                                "target_lang_word": "сухой",
                                "target_lang_sense_clarification": "о фактах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17e0e907-6f0e-37f3-b29e-7994e52c9e8b",
                    "sense_definition": "Without compassion; heartless or ruthless.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can't believe she said that; that was a very <w>cold</w> thing to do.",
                            "target_lang_translations": {
                                "ru": "Не верится, что она это сказала; это был очень <w>жестокий</w> поступок."
                            }
                        },
                        {
                            "text": "He is a <w>cold</w> killer with no regard for human life.",
                            "target_lang_translations": {
                                "ru": "Он <w>хладнокровный</w> убийца, ни во что не ставящий человеческую жизнь."
                            }
                        }
                    ],
                    "synonyms": [
                        "heartless",
                        "ruthless",
                        "callous"
                    ],
                    "antonyms": [
                        "friendly",
                        "welcoming"
                    ],
                    "common_phrases": [
                        "cold blooded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный сострадания; бессердечный или безжалостный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хладнокровный",
                                "target_lang_sense_clarification": "о человеке или поступке"
                            },
                            {
                                "target_lang_word": "бессердечный",
                                "target_lang_sense_clarification": "лишенный жалости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "295d0517-6cf6-32b0-a622-5e07f142519b",
                    "sense_definition": "Unconscious or deeply asleep.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer was knocked out <w>cold</w> in the third round.",
                            "target_lang_translations": {
                                "ru": "Боксер был отправлен в <w>глубокий</w> нокаут в третьем раунде."
                            }
                        },
                        {
                            "text": "After a long day of hiking, he passed out <w>cold</w> on the sofa.",
                            "target_lang_translations": {
                                "ru": "После долгого дня в походе он <w>мертвецки</w> заснул на диване."
                            }
                        }
                    ],
                    "synonyms": [
                        "unconscious"
                    ],
                    "common_phrases": [
                        "out cold",
                        "knocked out cold"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the phrase 'out cold'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Без сознания или в состоянии глубокого сна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "без сознания",
                                "target_lang_sense_clarification": "в отключке"
                            },
                            {
                                "target_lang_word": "мертвецки",
                                "target_lang_sense_clarification": "о сне (спать мертвецким сном)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0df4f39-38a9-3a0f-ad10-3abc3da41565",
                    "sense_definition": "Completely unprepared; without prior introduction or contact.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his first week at the job making <w>cold</w> calls to potential clients.",
                            "target_lang_translations": {
                                "ru": "Первую неделю на работе он совершал <w>холодные</w> звонки потенциальным клиентам."
                            }
                        },
                        {
                            "text": "The salesman tried a <w>cold</w> canvass of the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Продавец попытался провести <w>поквартирный</w> обход района без предупреждения."
                            }
                        }
                    ],
                    "synonyms": [
                        "unprepared"
                    ],
                    "antonyms": [
                        "prepared",
                        "ready"
                    ],
                    "common_phrases": [
                        "cold call",
                        "cold canvass"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used in business contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершенно неподготовленный; без предварительного знакомства или контакта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодный",
                                "target_lang_sense_clarification": "о звонках или продажах"
                            },
                            {
                                "target_lang_word": "неподготовленный",
                                "target_lang_sense_clarification": "без подготовки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b83bee5e-eb03-33d5-8e20-36defc0490d6",
                    "sense_definition": "Cool, impressive, or stylish.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That new jacket you bought is so <w>cold</w>.",
                            "target_lang_translations": {
                                "ru": "Твоя новая куртка такая <w>крутая</w>."
                            }
                        },
                        {
                            "text": "He produced one of the <w>coldest</w> photos of the tournament.",
                            "target_lang_translations": {
                                "ru": "Он сделал одно из самых <w>четких</w> фото турнира."
                            }
                        }
                    ],
                    "synonyms": [
                        "cool",
                        "impressive"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Modern youth slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крутой, впечатляющий или стильный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "четкий",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7281857d-8748-3205-b208-879de66b9631",
                    "sense_definition": "A common, usually harmless viral illness with congestion and sneezing.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "illness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I caught a miserable <w>cold</w> and had to stay home for a week.",
                            "target_lang_translations": {
                                "ru": "Я подхватил ужасную <w>простуду</w> и был вынужден остаться дома на неделю."
                            }
                        },
                        {
                            "text": "You should rest and drink fluids to get over your <w>cold</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно отдыхать и пить много жидкости, чтобы вылечить <w>простуду</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "common cold",
                        "head cold"
                    ],
                    "common_phrases": [
                        "catch a cold",
                        "have a cold",
                        "common cold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обычное, как правило, неопасное вирусное заболевание с заложенностью носа и чиханием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простуда",
                                "target_lang_sense_clarification": "заболевание"
                            },
                            {
                                "target_lang_word": "насморк",
                                "target_lang_sense_clarification": "симптом простуды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0beabaf-06a4-3528-9bc7-aca4e4d3092b",
                    "sense_definition": "A condition or environment of low temperature.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please come in out of the <w>cold</w> before you freeze.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, зайди в дом с <w>холода</w>, пока не замерз."
                            }
                        },
                        {
                            "text": "He doesn't seem to mind the <w>cold</w> of the northern winters.",
                            "target_lang_translations": {
                                "ru": "Похоже, его не беспокоит <w>холод</w> северных зим."
                            }
                        }
                    ],
                    "synonyms": [
                        "coldness"
                    ],
                    "antonyms": [
                        "hot"
                    ],
                    "common_phrases": [
                        "in the cold",
                        "out of the cold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или среда с низкой температурой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холод",
                                "target_lang_sense_clarification": "низкая температура"
                            },
                            {
                                "target_lang_word": "стужа",
                                "target_lang_sense_clarification": "сильный холод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05cb5f6a-0e92-33d0-8359-eef8b6aaf8c1",
                    "sense_definition": "A state of being ignored or abandoned.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The former politician was left out in the <w>cold</w> after the scandal.",
                            "target_lang_translations": {
                                "ru": "Бывший политик остался <w>не у дел</w> после скандала."
                            }
                        },
                        {
                            "text": "Don't leave your teammates out in the <w>cold</w> during the project.",
                            "target_lang_translations": {
                                "ru": "Не оставляй своих товарищей по команде <w>за бортом</w> во время работы над проектом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "out in the cold",
                        "left in the cold"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in the idiom 'out in the cold'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние игнорирования или заброшенности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "за бортом",
                                "target_lang_sense_clarification": "быть оставленным без внимания"
                            },
                            {
                                "target_lang_word": "в изоляции",
                                "target_lang_sense_clarification": "быть покинутым"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "53dd7e97-9748-3bc2-955a-4899c923cded",
                    "sense_definition": "At a low temperature.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steel was processed <w>cold</w> to maintain its strength.",
                            "target_lang_translations": {
                                "ru": "Сталь обрабатывали <w>холодным способом</w>, чтобы сохранить ее прочность."
                            }
                        },
                        {
                            "text": "The engine wouldn't start because it was sitting <w>cold</w> for weeks.",
                            "target_lang_translations": {
                                "ru": "Двигатель не заводился, потому что стоял <w>непрогретым</w> несколько недель."
                            }
                        }
                    ],
                    "common_phrases": [
                        "served cold"
                    ],
                    "target_lang_definitions": {
                        "ru": "При низкой температуре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодным способом",
                                "target_lang_sense_clarification": "о техническом процессе"
                            },
                            {
                                "target_lang_word": "в холодном виде",
                                "target_lang_sense_clarification": "о подаче блюд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddd8df52-10ee-34b5-9fde-ec79c4b22864",
                    "sense_definition": "Without preparation or prior experience.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker went in <w>cold</w> and struggled to find a topic.",
                            "target_lang_translations": {
                                "ru": "Спикер начал выступление <w>без подготовки</w> и с трудом подбирал тему."
                            }
                        },
                        {
                            "text": "I had to take the exam <w>cold</w> without any studying.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось сдавать экзамен <w>с ходу</w>, совсем не готовясь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go in cold",
                        "start cold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без подготовки или предварительного опыта."
                    },
                    "translations": {
                        "ru": [
