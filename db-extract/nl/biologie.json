                                    },
                                    {
                                        "sense_id": "2eb43ff7-2028-3361-bd81-ceb495d4edaa",
                                        "entry_id": "8d70220d-6809-37a1-a36e-c037dbe6af34",
                                        "glosses": [
                                            "Mode de vie ou de végétation d'une espèce animale ou végétale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2153cc6d-622c-4981-b2eb-b155fedcbd1f",
                                                "sense_id": "2eb43ff7-2028-3361-bd81-ceb495d4edaa",
                                                "text": "Les éboulis imposent une biologie très spéciale, car de grandes parties souterraines doivent permettre à la plante de se fixer malgré le milieu mouvant."
