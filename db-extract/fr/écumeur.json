                                        "sense_id": "229d5776-87e4-32e3-b51f-8ca49cd7be9e",
                                        "entry_id": "66af35e6-0c11-3120-b322-336d33e6dabb",
                                        "glosses": [
                                            "A sailor in the surface forces, as opposed to a submariner."
                                        ],
