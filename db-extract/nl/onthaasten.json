        "nl-extract.jsonl": [
            {
                "entry_id": "fdffe452-1f7c-3dba-9f24-c7c6e4147834",
                "word": "onthaasten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cf45905a-3a21-39a5-9a1d-8035675c6cff",
                        "entry_id": "fdffe452-1f7c-3dba-9f24-c7c6e4147834",
                        "glosses": [
                            "bewust kiezen voor ontspanning, vrije tijd, als reactie op drukte, stress, werkdruk, het snel nuttigen van maaltijden, enz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ac37159-ab35-4809-85f1-efb1845db662",
                                "sense_id": "cf45905a-3a21-39a5-9a1d-8035675c6cff",
                                "text": "Ondanks alles even ontsnappen, onthaasten, terug naar een fractie natuur die hen rest. Koppig wachten op een beet, de hengel als opgestoken middenvinger op een lome zomerdag."
                            },
                            {
                                "example_id": "357a995d-cd76-42ed-a3ea-c38d1e414d7d",
                                "sense_id": "cf45905a-3a21-39a5-9a1d-8035675c6cff",
                                "text": "Hijzelf is een trouw Ierlandganger. \"Om te onthaasten. Geweldige natuur en cultuur. En Ieren lijken vaak net gewoon Vlamingen.\""
                            },
                            {
                                "example_id": "00f9927e-ade8-48e1-a8b3-b5db308ba567",
                                "sense_id": "cf45905a-3a21-39a5-9a1d-8035675c6cff",
                                "text": "Ook de protestanten, verenigd in PKN, plaatsen zichzelf sinds vorige maand in de markt met posters. Daarop is de kerk niet alleen een plek om te geloven, maar ook om te onthaasten en zelfs om te twijfelen. 'We willen het beeld bijstellen', aldus een woordvoerster."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49fc984e-1bbd-468b-b570-b1fc97941a0e",
                        "source_entry_id": "fdffe452-1f7c-3dba-9f24-c7c6e4147834",
                        "source_sense_id": "cf45905a-3a21-39a5-9a1d-8035675c6cff",
                        "source_sense_description": "bewust kiezen voor ontspanning als reactie op werkdruk",
                        "target_lang_word": "entschleunigen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entschleunigen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0979fa4-3b0a-3425-afbc-e5102af3c892",
                                        "entry_id": "974d78f7-ca76-3846-962c-34d00a6b78e5",
                                        "glosses": [
                                            "langsamer machen, bewusst Hektik entgegenwirken"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59b9d390-4567-42c2-ae4a-6a4a518c6be7",
                                                "sense_id": "f0979fa4-3b0a-3425-afbc-e5102af3c892",
                                                "text": "„Sie kämpfen gegen […] eine Aufmerksamkeitsökonomie, in der Reflexe die Analysen verdrängen und Emotionen die Argumente. Der Shitstorm ist ein Symptom dieser Entwicklung, nicht seine Ursache. Das erste Anliegen ist deshalb, Debatten zu entschleunigen.“"
                                            },
                                            {
                                                "example_id": "d769ba37-b6c3-4444-b992-10d2f799fc56",
                                                "sense_id": "f0979fa4-3b0a-3425-afbc-e5102af3c892",
                                                "text": "Die Straße, die am Ufer langführt, wurde entschleunigt."
                                            },
                                            {
                                                "example_id": "ebd738fa-9ff9-4730-bc99-e8db7d757cd9",
                                                "sense_id": "f0979fa4-3b0a-3425-afbc-e5102af3c892",
                                                "text": "Manche wollen im Urlaub aktiv sein und manchen wollen einfach entschleunigen."
                                            },
                                            {
                                                "example_id": "16a27025-cba8-4f42-acb8-b732dd371eb4",
                                                "sense_id": "f0979fa4-3b0a-3425-afbc-e5102af3c892",
                                                "text": "Ich bin jetzt total entschleunigt!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3863ff16-7f38-4f0e-9958-0de476e9fbb3",
                        "source_entry_id": "fdffe452-1f7c-3dba-9f24-c7c6e4147834",
                        "source_sense_id": "cf45905a-3a21-39a5-9a1d-8035675c6cff",
                        "source_sense_description": "bewust kiezen voor ontspanning als reactie op werkdruk",
                        "target_lang_word": "slow down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slow down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "026aede4-f831-3b58-a49d-2eda9e46ee3b",
                                        "entry_id": "382836f9-b631-3cae-8dda-51757417a994",
                                        "glosses": [
                                            "To decelerate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d2032ab-5003-498c-bacb-2aeb49c55abd",
                                                "sense_id": "026aede4-f831-3b58-a49d-2eda9e46ee3b",
                                                "text": "When approaching a bend in the road, slow down, and speed up after leaving it."
                                            },
                                            {
                                                "example_id": "0e856135-e5c8-485e-aec7-9185ab9e73a2",
                                                "sense_id": "026aede4-f831-3b58-a49d-2eda9e46ee3b",
                                                "text": "Crossing stations on single lines are laid out so that one line has a straight run through, and is signalled in each direction, avoiding the need to slow down to take the turnout into the loop."
                                            },
                                            {
                                                "example_id": "72d56439-c557-4ecb-82f5-abd1ff83cb0a",
                                                "sense_id": "026aede4-f831-3b58-a49d-2eda9e46ee3b",
                                                "text": "When the long, hot journey drew to its end and the train slowed down for the last time, there was a stir in Jessamy’s carriage."
                                            },
                                            {
                                                "example_id": "03e6eff9-64df-4181-8d45-dc3af66eaa12",
                                                "sense_id": "026aede4-f831-3b58-a49d-2eda9e46ee3b",
                                                "text": "Then came the war... and everything slowed down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43bf0935-3eb9-3786-acf9-ed65f03fdc32",
                                        "entry_id": "382836f9-b631-3cae-8dda-51757417a994",
                                        "glosses": [
                                            "To reduce the velocity, speed, or tempo of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce48c866-fe71-447b-8ad6-0727d1e6b83b",
                                                "sense_id": "43bf0935-3eb9-3786-acf9-ed65f03fdc32",
                                                "text": "With a comfortable lead, the football team slowed down the tempo of the game."
                                            },
                                            {
                                                "example_id": "e8c3f4fc-ba1c-49e9-a08a-1f86282263ba",
                                                "sense_id": "43bf0935-3eb9-3786-acf9-ed65f03fdc32",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails.[…]This set-up solves several problems […]. Stopping high-speed trains wastes energy and time, so why not simply slow them down enough for a moving platform to pull alongside?"
                                            },
                                            {
                                                "example_id": "d196c406-4360-4bd7-9f4c-8ada4ca33f11",
                                                "sense_id": "43bf0935-3eb9-3786-acf9-ed65f03fdc32",
                                                "text": "The elimination of vacuum-braked wagons would be slowed down, and the Western Region's flirtation with diesel-hydraulic locomotives was questioned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83778179-143e-3aa9-a1cd-167cdc0fb288",
                                        "entry_id": "382836f9-b631-3cae-8dda-51757417a994",
                                        "glosses": [
                                            "To become less intense, enthusiastic, etc., usually with a positive connotation, implying that one is stripped of exaggerated or unnecessary eagerness."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b4f2653-27a8-4070-ad32-547c847e878c",
                                                "sense_id": "83778179-143e-3aa9-a1cd-167cdc0fb288",
                                                "text": "Whoa, slow down there, bucko. Everyone will get a chance. Be patient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1683b74b-cb63-4f7e-bfda-45d068f5815d",
                        "source_entry_id": "fdffe452-1f7c-3dba-9f24-c7c6e4147834",
                        "source_sense_id": "cf45905a-3a21-39a5-9a1d-8035675c6cff",
                        "source_sense_description": "bewust kiezen voor ontspanning als reactie op werkdruk",
                        "target_lang_word": "ralentir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ralentir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01c57dba-36f8-3a66-bed2-70a8e8024643",
                                        "entry_id": "39bec0c6-b19e-3435-97b3-87d9c288f3b8",
                                        "glosses": [
                                            "Diminuer la vitesse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dcdb4bc-113a-4609-a021-87d4896fef9a",
                                                "sense_id": "01c57dba-36f8-3a66-bed2-70a8e8024643",
                                                "text": "Se souvenant de la fatigue qui l'avait assommée, pour ne point y succomber, elle s’injectait de la volonté. Toutefois, pour s’économiser, elle ralentit l'allure."
                                            },
                                            {
                                                "example_id": "628ffd7f-2eed-4076-93c4-bf9e9a10996f",
                                                "sense_id": "01c57dba-36f8-3a66-bed2-70a8e8024643",
                                                "text": "Les petits coups de freins de Chak et l’épais tapis de neige se conjuguèrent pour ralentir le camion, et ce fut quasiment au pas qu'il s'engagea dans l'ouverture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bdc034f-24d3-3d7e-ba43-05172cba7c7f",
                                        "entry_id": "39bec0c6-b19e-3435-97b3-87d9c288f3b8",
                                        "glosses": [
                                            "Rendre moins intense."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a7ed866-b616-4449-b9c5-ae197643b479",
                                                "sense_id": "9bdc034f-24d3-3d7e-ba43-05172cba7c7f",
                                                "text": "La tempête se calma, les flocons moins denses ralentissaient leur chute."
                                            },
                                            {
                                                "example_id": "aadceff8-79ef-4f82-9368-59e75158564b",
                                                "sense_id": "9bdc034f-24d3-3d7e-ba43-05172cba7c7f",
                                                "text": "Il existe aussi des médicaments (warfarine) dont l'usage est destiné à ralentir la formation du caillot sanguin, à « éclaircir le sang », comme disent certains patients."
                                            },
                                            {
                                                "example_id": "ac5d3167-83da-4159-b248-836f64fe2a12",
                                                "sense_id": "9bdc034f-24d3-3d7e-ba43-05172cba7c7f",
                                                "text": "Le mariage, étape importante de son ascension sociale, ne ralentit pas son ardeur au travail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eef728c-b86f-3384-97b2-8dd52bd58450",
                                        "entry_id": "39bec0c6-b19e-3435-97b3-87d9c288f3b8",
                                        "glosses": [
                                            "Aller plus basse vitesse ; devenir plus lent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e65a8d5-fb82-41e6-ac0b-7370cbde7991",
                                                "sense_id": "3eef728c-b86f-3384-97b2-8dd52bd58450",
                                                "text": "Quelques secondes plus tard, la Renault déglinguée ralentit pour croiser l'ambulance avant de reprendre de la vitesse."
                                            },
                                            {
                                                "example_id": "fa6008fe-f44d-4675-8771-3b455f920191",
                                                "sense_id": "3eef728c-b86f-3384-97b2-8dd52bd58450",
                                                "text": "Selyn longea encore quelques blocs avant d'escalader un des entrepôts et de s'allonger sur son toit pour se reposer. […]. Son pouls ralentit à peine."
                                            },
                                            {
                                                "example_id": "14022fc0-e390-4f4f-92f6-7eba45199002",
                                                "sense_id": "3eef728c-b86f-3384-97b2-8dd52bd58450",
                                                "text": "Son pouls et sa respiration ralentissaient, son cœur se glaçait,sa vue se brouillait, sa température chutait à mesure que la densité de la neige (1 cm ou plus) devenait celle de la glace pure."
                                            },
                                            {
                                                "example_id": "e48e154d-b46a-4886-ac84-ef32a13b83d7",
                                                "sense_id": "3eef728c-b86f-3384-97b2-8dd52bd58450",
                                                "text": "Les économies de carburant, qui peuvent être réalisées en ralentissant, ne requièrent aucun coût direct additionnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddef8016-163b-3c90-855f-3cb035382a8b",
                                        "entry_id": "39bec0c6-b19e-3435-97b3-87d9c288f3b8",
                                        "glosses": [
                                            "Réduire sa vitesse ; être moins actif."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44b4287b-bf4f-4353-99ab-3477b9d6f490",
                                                "sense_id": "ddef8016-163b-3c90-855f-3cb035382a8b",
                                                "text": "Mais de la même manière que vos dépassements ralentissent tous ceux qui vous suivent, les gens qui vous doublent vous ralentissent. En effet, les banlieusards se ralentissent tous les uns les autres sur les routes, même si aucun d'entre eux ne se ralentit lui-même délibérément."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08369263-3f43-4755-93dc-8445ed68bf9b",
                        "source_entry_id": "fdffe452-1f7c-3dba-9f24-c7c6e4147834",
