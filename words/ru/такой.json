{
    "word_family": [
        "таково",
        "таковский"
    ],
    "entries": [
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "53cd510c-f68e-3f9c-9020-b6d0a529d0ed",
                    "sense_definition": "Подобный тому, о котором идёт речь; обладающий определёнными свойствами, о которых говорилось ранее или которые очевидны.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quality_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В <w>таком</w> случае нам лучше остаться дома.",
                            "target_lang_translations": {
                                "en": "In <w>such</w> a case, we'd better stay home.",
                                "zh": "在<w>这种</w>情况下，我们最好待在家里。"
                            }
                        },
                        {
                            "text": "Я никогда не видел <w>такой</w> большой собаки.",
                            "target_lang_translations": {
                                "en": "I have never seen <w>such</w> a big dog.",
                                "zh": "我从来没见过<w>这么</w>大的狗。"
                            }
                        }
                    ],
                    "synonyms": [
                        "подо́бный",
                        "тако́го ро́да"
                    ],
                    "common_phrases": [
                        "в таком случае",
                        "таким образом",
                        "до такой степени"
                    ],
                    "target_lang_definitions": {
                        "en": "Of this kind; similar to the one mentioned or implied by context.",
                        "zh": "指代前文提到或语境中显而易见的某种事物或情况。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "such",
                                "target_lang_sense_clarification": "of this kind"
                            },
                            {
                                "target_lang_word": "like this",
                                "target_lang_sense_clarification": "similar to this"
                            },
                            {
                                "target_lang_word": "like that",
                                "target_lang_sense_clarification": "similar to that"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "这样的",
                                "target_lang_sense_clarification": "指代前文提到的性质或种类"
                            },
                            {
                                "target_lang_word": "那种",
                                "target_lang_sense_clarification": "指代特定种类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a16c044e-f471-36c4-8626-9b6910a3277e",
                    "sense_definition": "В очень высокой степени; настолько (используется для усиления качества прилагательного или наречия).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот фильм <w>такой</w> интересный, что я посмотрел его дважды.",
                            "target_lang_translations": {
                                "en": "This movie is <w>so</w> interesting that I watched it twice.",
                                "zh": "这部电影<w>那么</w>好看，我看了两遍。"
                            }
                        },
                        {
                            "text": "Почему ты сегодня <w>такой</w> грустный?",
                            "target_lang_translations": {
                                "en": "Why are you <w>so</w> sad today?",
                                "zh": "你今天为什么<w>这么</w>难过？"
                            }
                        }
                    ],
                    "synonyms": [
                        "насто́лько",
                        "столь"
                    ],
                    "common_phrases": [
                        "такой же",
                        "не такой уж"
                    ],
                    "target_lang_definitions": {
                        "en": "To a very high degree; used to emphasize a quality.",
                        "zh": "用于形容词或副词前，表示程度很高。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "before adjectives or adverbs"
                            },
                            {
                                "target_lang_word": "such",
                                "target_lang_sense_clarification": "before nouns or noun phrases"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "那么",
                                "target_lang_sense_clarification": "用于形容词前表示程度"
                            },
                            {
                                "target_lang_word": "这么",
                                "target_lang_sense_clarification": "用于形容词前表示程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0389bd1a-3d8f-3ec2-aba8-6b0aaa5a44a3",
                    "sense_definition": "Одинаковый по степени качества с кем-либо или чем-либо (обычно используется в сравнительных оборотах с «как»).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он не <w>такой</w> строгий, как кажется на первый взгляд.",
                            "target_lang_translations": {
                                "en": "He is not <w>so</w> strict as he seems at first glance.",
                                "zh": "他并没有第一眼看上去<w>那么</w>严厉。"
                            }
                        },
                        {
                            "text": "Твой телефон точно <w>такой</w> же, как у меня.",
                            "target_lang_translations": {
                                "en": "Your phone is exactly the <w>same</w> as mine.",
                                "zh": "你的手机跟我的是<w>一样</w>的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "такой же как"
                    ],
                    "target_lang_definitions": {
                        "en": "Identical in degree or quality (used in comparisons).",
                        "zh": "用于比较结构，表示程度或性质相同。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "in negative comparisons (not so... as)"
                            },
                            {
                                "target_lang_word": "the same",
                                "target_lang_sense_clarification": "identical"
                            },
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "comparative structure"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "那么",
                                "target_lang_sense_clarification": "用于否定比较中"
                            },
                            {
                                "target_lang_word": "一样",
                                "target_lang_sense_clarification": "表示完全相同"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5071fd7-9298-3eb3-83c2-6322a374b1c7",
                    "sense_definition": "Некий, какой-то; употребляется для указания на лицо или предмет, который известен говорящему или упоминался, но не называется точно.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "indefinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Там работает <w>такой</w> Иванов, вам нужно к нему обратиться.",
                            "target_lang_translations": {
                                "en": "There is <w>a certain</w> Ivanov working there; you need to contact him.",
                                "zh": "那儿有<w>个</w>叫伊万诺夫的人，你需要联系他。"
                            }
                        },
                        {
                            "text": "Это была <w>такая</w> странная игра, правил которой никто не знал.",
                            "target_lang_translations": {
                                "en": "It was <w>some</w> strange game, the rules of which no one knew.",
                                "zh": "那是<w>一种</w>很奇怪的游戏，没人知道规则。"
                            }
                        }
                    ],
                    "synonyms": [
                        "не́который",
                        "како́й-то",
                        "некий"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в устной речи для выделения объекта"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A certain or specific (but unnamed) person or thing.",
                        "zh": "指代说话人知道但未明确指出的某个人或事物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "a certain",
                                "target_lang_sense_clarification": "specific but unnamed"
                            },
                            {
                                "target_lang_word": "some",
                                "target_lang_sense_clarification": "indefinite"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有个",
                                "target_lang_sense_clarification": "用于引出特定但未详述的人"
                            },
                            {
                                "target_lang_word": "某种",
                                "target_lang_sense_clarification": "用于指代不确定的事物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "bfc4392e-c935-336f-8a94-473e494ca723",
                    "sense_definition": "Употребляется в вопросительных предложениях с местоимением «кто» для выяснения личности, сущности или характера кого-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "identity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Кто ты <w>такой</w>, чтобы указывать нам, что делать?",
                            "target_lang_translations": {
                                "en": "Who <w>are</w> you to tell us what to do?",
                                "zh": "你<w>到底是谁</w>，凭什么告诉我们该做什么？"
                            }
                        },
                        {
                            "text": "Я не знаю, кто <w>такая</w> эта женщина.",
                            "target_lang_translations": {
                                "en": "I don't know who this woman <w>is</w>.",
                                "zh": "我不知道这个女人<w>到底是谁</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "кто такой"
                    ],
                    "target_lang_definitions": {
                        "en": "Used with 'who' to ask about identity or character.",
                        "zh": "与“谁”连用，询问某人的身份或性质。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "(omitted)",
                                "target_lang_sense_clarification": "often not translated directly in English"
                            },
                            {
                                "target_lang_word": "who",
                                "target_lang_sense_clarification": "part of the question phrase"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "到底是谁",
                                "target_lang_sense_clarification": "用于询问身份"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3668fc65-adb9-34e6-8e63-bd2c98b2321f",
                    "sense_definition": "Тот, который обладает упомянутыми свойствами; подобный этому (используется самостоятельно, без существительного).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "substantive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я видел много красивых домов, но <w>такого</w> никогда не встречал.",
                            "target_lang_translations": {
                                "en": "I've seen many beautiful houses, but I've never met <w>one like this</w>.",
                                "zh": "我见过很多漂亮的房子，但从来没见过<w>这样的</w>。"
                            }
                        },
                        {
                            "text": "Среди нас нет <w>таких</w>, кто бы отказался помочь другу.",
                            "target_lang_translations": {
                                "en": "There are no people <w>like that</w> among us who would refuse to help a friend.",
                                "zh": "我们中间没有<w>这样</w>会拒绝帮助朋友的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "тако́в",
                        "подо́бный"
                    ],
                    "target_lang_definitions": {
                        "en": "One of this kind; a person or thing with these properties.",
                        "zh": "指代具有上述特征的人或事物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "one like that",
                                "target_lang_sense_clarification": "substantive"
                            },
                            {
                                "target_lang_word": "such",
                                "target_lang_sense_clarification": "formal substantive"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "这样的",
                                "target_lang_sense_clarification": "指代具有特定属性的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "316e0fad-419e-361c-af2b-fd287302fb5c",
                    "sense_definition": "Употребляется в разговорной речи для передачи чьей-либо реакции, эмоции или действия (в значении «говорит», «подумал» или «сделал так»).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "narrative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "И тут он <w>такой</w>: «Я вообще не понимаю, о чём речь!»",
                            "target_lang_translations": {
                                "en": "And then he's <w>like</w>: \"I don't understand what this is about at all!\"",
                                "zh": "然后他<w>就</w>说：“我根本不知道你在说什么！”"
                            }
                        },
                        {
                            "text": "А она <w>такая</w> смотрит на меня и просто молчит.",
                            "target_lang_translations": {
                                "en": "And she's <w>like</w> looking at me and just staying silent.",
                                "zh": "然后她<w>就</w>看着我，一言不发。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется при пересказе диалогов или событий"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to introduce a quote, reaction, or action (colloquial).",
                        "zh": "口语中用于引出某人的反应、话语或动作。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "like",
                                "target_lang_sense_clarification": "quotative slang"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "就",
                                "target_lang_sense_clarification": "口语中引出动作或话语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cd0ece8c-b888-3057-92a8-6f451e233c80",
                    "sense_definition": "Посредственный, не очень хороший, среднего качества.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Фильм оказался <w>такой</w> себе, я ожидал гораздо большего.",
                            "target_lang_translations": {
                                "en": "The movie turned out to be <w>so-so</w>; I expected much more.",
                                "zh": "电影<w>一般般</w>，我本来期待更高。"
                            }
                        },
                        {
                            "text": "Идея, честно говоря, <w>такая</w> себе, давай придумаем что-то другое.",
                            "target_lang_translations": {
                                "en": "The idea, honestly speaking, is <w>so-so</w>; let's come up with something else.",
                                "zh": "老实说，这个主意<w>不怎么样</w>，我们换个别的吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "посре́дственный",
                        "сре́дненький"
                    ],
                    "common_phrases": [
                        "такое себе",
                        "ну такое"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "выражает сдержанную негативную оценку"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Mediocre; of poor or average quality.",
                        "zh": "表示平庸、质量一般或不太好。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so-so",
                                "target_lang_sense_clarification": "colloquial"
                            },
                            {
                                "target_lang_word": "mediocre",
                                "target_lang_sense_clarification": "average quality"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一般般",
                                "target_lang_sense_clarification": "口语中表示质量平平"
                            },
                            {
                                "target_lang_word": "不怎么样",
                                "target_lang_sense_clarification": "表示评价不高"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}