                    {
                        "sense_id": "8d327cc4-bfb0-3a1f-8ebf-22b3e75e3700",
                        "entry_id": "68625c9e-f364-3f0e-bf4d-6936a0414359",
                        "glosses": [
                            "absolute Herrscherin, die ohne jede Beschränkung regiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf4bf303-2554-48c6-9d81-d7184e5ca57f",
                                "sense_id": "8d327cc4-bfb0-3a1f-8ebf-22b3e75e3700",
                                "text": "Es gibt in jenem Land eine Tyrannin, die tyrannischer, willkürlicher und grausamer ist, als alle Tyrannen der Römer, Türken und Russen zusammen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "21f3aacd-3a6d-3492-b852-d181c5183257",
                        "entry_id": "68625c9e-f364-3f0e-bf4d-6936a0414359",
                        "glosses": [
                            "weibliche Person, die ihre Mitmenschen unterdrückt oder terrorisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99c169c3-fe5c-4abf-a830-32117e43f389",
                                "sense_id": "21f3aacd-3a6d-3492-b852-d181c5183257",
                                "text": "Sie ist eine Hexe und ein Tyrannin, böse und nur bestrebt, rücksichtslos ihren eigenen Willen durchzusetzen."
                            }
                        ],
                        "sense_index_json": "\"2\""
