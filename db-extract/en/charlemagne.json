                                        "glosses": [
                                            "Un des quatre rois dans un jeu de cartes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92ba75fc-47dd-365d-9e3d-42be0ab459a7",
                                        "entry_id": "17dfd1be-242e-349a-a11d-63a47f2a6231",
                                        "glosses": [
                                            "Lycée de Paris, situé dans le 4e arrondissement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8c62dc9-2414-3f89-8599-230423355d5e",
                                        "entry_id": "17dfd1be-242e-349a-a11d-63a47f2a6231",
                                        "glosses": [
                                            "Élève du lycée Charlemagne, à Paris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20439952-ab30-4751-9813-01b73c370a7a",
                                                "sense_id": "e8c62dc9-2414-3f89-8599-230423355d5e",
                                                "text": "Au moment même où l’on nous appelait pour entrer à la Sorbonne, un Charlemagne avait crié, montrant une ombre noire qui montait la rue :\n« Tiens, l’ancien répétiteur de Jauffret ! »"
                                            }
                                        ]
