        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "882fd8cd-b440-33dc-b787-9946420cb3df",
                "word": "napraten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b83975fd-3b2d-38c3-adaa-739c8ea133b9",
                        "entry_id": "882fd8cd-b440-33dc-b787-9946420cb3df",
                        "glosses": [
                            "na een gebeurtenis even met elkaar praten over wat er gebeurd is en andere zaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eadc4a8-36ec-44ff-9e9e-25f9d4f6e240",
                                "sense_id": "b83975fd-3b2d-38c3-adaa-739c8ea133b9",
                                "text": "Na de vergadering was er gelegenheid voor gezellig napraten."
                            },
                            {
                                "example_id": "5a60dfbe-8629-4268-bf5e-dc3c4f5362e6",
                                "sense_id": "b83975fd-3b2d-38c3-adaa-739c8ea133b9",
                                "text": "Wat wil je nog meer? We sliepen allemaal op de vloer bij Trail Angel Shrek, waar we nog lang bleven napraten."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d785b9c-bbbd-360c-9cf0-8aa75236692f",
                        "entry_id": "882fd8cd-b440-33dc-b787-9946420cb3df",
                        "glosses": [
                            "niet al te kritisch in navolging van een ander iets zeggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92681862-4598-4f4b-bcd5-740f705faffa",
                                "sense_id": "0d785b9c-bbbd-360c-9cf0-8aa75236692f",
                                "text": "Waumans oppert dat er niet zozeer méér woede is, maar dat deze vooral zichtbaarder is. „Ik ben ervan overtuigd dat op social media veel mensen elkaar napraten - de retweet is er niet voor niets - en dat het dan ideaal is om je te profileren in een duidelijke richting. Met een roman kan dat niet zo eenvoudig. Woede is niet charmant is voor een roman.”"
                            }
                        ]
                    }
