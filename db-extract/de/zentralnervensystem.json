                "senses": [
                    {
                        "sense_id": "503fa7ec-c26f-3dfa-9144-086f4557f767",
                        "entry_id": "56ca05e5-5b58-3729-be58-3c740a4fe5a7",
                        "glosses": [
                            "der durch Knochen geschützte Teil des Nervensystems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d547c48-f4f9-44c0-bf2d-64629783a3e4",
                                "sense_id": "503fa7ec-c26f-3dfa-9144-086f4557f767",
                                "text": "„Es beginnt mit einem ersten Check - ist der Zustand stabil oder instabil, was ist mit Atmung, Kreislauf und Zentralnervensystem, dann wird der Verunfallte entkleidet, die Ärzte legen Venenzugänge für die Versorgung mit Medikamenten und Flüssigkeit.“"
                            },
                            {
                                "example_id": "17978217-d7f9-4baf-a413-da22ffcb1788",
                                "sense_id": "503fa7ec-c26f-3dfa-9144-086f4557f767",
                                "text": "„Eine Fülle von Untersuchungen stützt zudem die Schlussfolgerung, dass sich auch die Hirnfunktionen des Menschen rapide ändern. Bei einer ganzen Batterie von Erbanlagen mit Bedeutung für Architektur und Funktion des Zentralnervensystems entdecken Biologen die Signatur schneller genetischer Anpassung.“"
                            },
                            {
                                "example_id": "385ff4c9-86ef-4630-bbd7-7974b1acd2ee",
                                "sense_id": "503fa7ec-c26f-3dfa-9144-086f4557f767",
                                "text": "„Das Zentralnervensystem steuert den Tonus der Blutadern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
