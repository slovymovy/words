                        "intéresser les lecteurs"
                    ]
                },
                {
                    "sense_id": "b03fef33-3d1a-37d0-ad8d-d0b132f30529",
                    "sense_definition": "Porter de l'attention, de la curiosité ou du goût pour quelque chose ou quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "curiosite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère aîné commence à s'<w>intéresser</w> à la peinture classique."
                        },
                        {
