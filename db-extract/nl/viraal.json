                    {
                        "sense_id": "d956dba6-da90-34b9-b291-a6453658948d",
                        "entry_id": "ed979fcb-9220-335b-8798-9e06d5b83564",
                        "glosses": [
                            "iets dat via het internet als een lopend vuurtje gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c0ee782-d232-442c-bf25-cb491fea07e8",
                                "sense_id": "d956dba6-da90-34b9-b291-a6453658948d",
                                "text": "De door Böhmermann verspreide video ging viraal en werd ook opgepikt door de grote Duitse media."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84257e9b-c91a-4b6e-a125-d90fa227299b",
                        "source_entry_id": "ed979fcb-9220-335b-8798-9e06d5b83564",
                        "source_sense_id": "44eb0bf1-2709-3d52-94ae-be2c1911f216",
                        "source_sense_description": "door een virus veroorzaakt",
                        "target_lang_word": "viral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51f70771-d670-3492-b095-be0841bbb93c",
                                        "entry_id": "de2d77e5-8667-34c9-929c-7a8faa4cd4cf",
                                        "glosses": [
                                            "Of or relating to a biological virus."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab3e6310-b3d2-437d-b71b-71c4bf744953",
                                                "sense_id": "51f70771-d670-3492-b095-be0841bbb93c",
                                                "text": "viral DNA"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5e27bb2-80eb-3306-a8df-c9c9917a4564",
                                        "entry_id": "de2d77e5-8667-34c9-929c-7a8faa4cd4cf",
                                        "glosses": [
                                            "Caused by a virus."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66f0b689-cc57-40b9-bbe3-4f6313a5d186",
                                                "sense_id": "c5e27bb2-80eb-3306-a8df-c9c9917a4564",
                                                "text": "viral infection"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1352d344-f9de-3f02-a965-66dde58b3ad8",
                                        "entry_id": "de2d77e5-8667-34c9-929c-7a8faa4cd4cf",
                                        "glosses": [
                                            "Of the nature of an informatic virus; able to spread copies of itself to other computers."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0645a7b9-0106-33ff-8d06-61a8859423c2",
                                        "entry_id": "de2d77e5-8667-34c9-929c-7a8faa4cd4cf",
                                        "glosses": [
                                            "Spread by word of mouth with minimal intervention, in order to create buzz and interest."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70ad44dd-1da3-4045-b83b-dcd58db37933",
                                                "sense_id": "0645a7b9-0106-33ff-8d06-61a8859423c2",
                                                "text": "“Efficient way to disseminate information? I don't think.”\n“But it is,” Cayce insists. “The model's viral. ‘Deep niche.’ The venues would be carefully selected—”"
                                            },
                                            {
                                                "example_id": "cf03dcea-2da3-48d5-87ca-19944d9f9ac0",
                                                "sense_id": "0645a7b9-0106-33ff-8d06-61a8859423c2",
                                                "text": "Still, the movie [Ralph Breaks the Internet] manages to locate some gentle satire in our culture's love-hate relationship with the internet. At one point, Ralph must attain a certain level of viral popularity, assisted by the BuzzFeed-esque content guru Yesss (Taraji P. Henson), and the movie is savvy about how accidental spikes in fame can turn into cynical algorithm manipulation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7b51b92-5968-3996-a9eb-9691e78e5023",
                                        "entry_id": "de2d77e5-8667-34c9-929c-7a8faa4cd4cf",
                                        "glosses": [
                                            "Circulated rapidly and widely from one user to another."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "487db26d-36f1-4406-aeef-68daf84d88af",
                                                "sense_id": "e7b51b92-5968-3996-a9eb-9691e78e5023",
                                                "text": "With some minutes to kill, he checks the headlines on his phone. Yet again, something dreadful and new which he doesn't understand is going viral. Today's fad is, you paint a black vertical rectangle on the wall, or on a mirror, or over the top of a picture. And then you chant something."
                                            },
                                            {
                                                "example_id": "1e9033fa-1d72-4f4b-aece-fb2cd9b8927b",
                                                "sense_id": "e7b51b92-5968-3996-a9eb-9691e78e5023",
                                                "text": "The end game of that is the GoFundMe link posted beneath a viral tweet so they can pay for their health care. Being an influencer sounds fun until it’s ‘keep producing viral content to literally stay alive.’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "viral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40d3f0ad-f0d0-313b-8f47-cf137314b33e",
                                        "entry_id": "6e0e2aa7-dee4-3e73-842d-11d56bc1aedd",
                                        "glosses": [
                                            "A video, image or text spread by \\\"word of mouth\\\" on the internet or by e-mail for humorous, political or marketing purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bce102f-28b8-4301-970c-b149d059eb0b",
                                                "sense_id": "40d3f0ad-f0d0-313b-8f47-cf137314b33e",
                                                "text": "2002, Nik Lever, Flash Mx Games: ActionScript for Artists, Focal Press, page 411,\nUsing the Flash ActiveX control in this way allows you as a developer to create desktop characters, email virals and screensavers."
                                            },
                                            {
                                                "example_id": "7204274c-1b70-457e-aa39-d7dafc9450c7",
                                                "sense_id": "40d3f0ad-f0d0-313b-8f47-cf137314b33e",
                                                "text": "2003, Dave Chaffey, Total E-Mail Marketing, Elsevier, page 2,\n[M]ost virals are not seen as profiling and data collection exercises, since that would kill the impulse of forwarding to a friend."
                                            },
                                            {
                                                "example_id": "461271a1-353d-47f3-af61-3ec4390da3f0",
                                                "sense_id": "40d3f0ad-f0d0-313b-8f47-cf137314b33e",
                                                "text": "2005, Russell Evans, Practical DV Filmmaking, Focal Press, page 289,\nMusic company virals are becoming commonplace as costs of promos force labels to reconsider how to target more directly to consumers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56201d81-0031-47ea-9a02-7b801267599b",
                        "source_entry_id": "ed979fcb-9220-335b-8798-9e06d5b83564",
                        "source_sense_id": "44eb0bf1-2709-3d52-94ae-be2c1911f216",
                        "source_sense_description": "door een virus veroorzaakt",
                        "target_lang_word": "viral",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viral",
