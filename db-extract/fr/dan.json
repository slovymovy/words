                                    {
                                        "sense_id": "85c27811-cbbd-332f-abbb-f7bdc1a2a3d7",
                                        "entry_id": "f148f551-1857-3453-bd04-ce94224ab3f6",
                                        "glosses": [
                                            "A title of honour or respect similar to \\\"master\\\" or \\\"Sir\\\", used of historical and legendary figures of the past."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "069103b4-0c30-4268-861d-09ed208db7c4",
                                                "sense_id": "85c27811-cbbd-332f-abbb-f7bdc1a2a3d7",
                                                "text": "Dan Phoebus, he with many a low'ring look / Had her beheld in yore in angry wise."
                                            },
                                            {
                                                "example_id": "b2734dfe-3c14-4a08-a640-0af6ae4bb9d1",
                                                "sense_id": "85c27811-cbbd-332f-abbb-f7bdc1a2a3d7",
                                                "text": "Old Dan Geoffrey, in whose gentle spright / The pure well-head of Poesy did dwell."
                                            },
                                            {
                                                "example_id": "48015d58-a0c9-4a96-be73-cd6a25a9b643",
                                                "sense_id": "85c27811-cbbd-332f-abbb-f7bdc1a2a3d7",
                                                "text": "This senior-junior, giant-dwarf, dan Cupid."
                                            },
                                            {
                                                "example_id": "c98a91ea-af6f-453f-8b8a-aad997e8cdbf",
                                                "sense_id": "85c27811-cbbd-332f-abbb-f7bdc1a2a3d7",
                                                "text": "The patriarchal age, / What time Dan Abraham left the Chaldee land."
                                            },
                                            {
                                                "example_id": "7ed1f282-a847-4812-af37-f0e5ea564279",
                                                "sense_id": "85c27811-cbbd-332f-abbb-f7bdc1a2a3d7",
                                                "text": "He did—and in a moment press'd / The place—in Paradise the best, / As by Dan Moses said."
                                            },
                                            {
                                                "example_id": "3405e6f5-126c-4169-81ec-758377a9053d",
                                                "sense_id": "85c27811-cbbd-332f-abbb-f7bdc1a2a3d7",
                                                "text": "Dan Chaucer, the first warbler, whose sweet breath / Preluded those melodious bursts, that fill / The spacious times of great Elizabeth / With sounds that echo still."
                                            },
                                            {
                                                "example_id": "d2b528b6-9da1-47b7-9537-7cf736fd4e1d",
                                                "sense_id": "85c27811-cbbd-332f-abbb-f7bdc1a2a3d7",
                                                "text": "Dan Neptune says that \"ere a twelvemonth pass, / The Senate shall to Ireland go to grass.\""
                                            },
                                            {
                                                "example_id": "1b722fe5-1831-498e-8a99-37918529df62",
                                                "sense_id": "85c27811-cbbd-332f-abbb-f7bdc1a2a3d7",
                                                "text": "Oh, me' name is Dan Homer, I'm blind, as the Jews, / And I travels around with my head full av news."
                                            }
                                        ]
                                    }
                                ]
