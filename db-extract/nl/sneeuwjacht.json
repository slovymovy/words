                        "examples": [
                            {
                                "example_id": "fd5ec9b9-88c3-43ff-ab35-186e55b9f174",
                                "sense_id": "608ad867-3585-3a70-82c9-81039be97eb8",
                                "text": "Het was 31 december. Sneeuwvlokken, diagonaal gestuurd, dwarrelden voor langs de A-kerk. De sneeuw kwam in rukken en bleef niet of nauwelijks liggen. De hagel- en sneeuwjachten volgden elkaar snel op, kort onderbroken door een haperende zon."
                            },
                            {
                                "example_id": "fd005835-186d-428a-90f1-53df0e0c6215",
                                "sense_id": "608ad867-3585-3a70-82c9-81039be97eb8",
                                "text": "Omdat de wind in de noordelijke provincies is afgenomen, is het gevaar voor sneeuwjacht geweken. Sneeuwjacht is sneeuwval met windstoten boven windkracht 5, waardoor er sneeuwduinen ontstaan en het zicht erg beperkt is."
                            }
                        ]
                    }
