                    "sense_id": "8a770978-7a0d-3463-a58a-d7598f00b7d0",
                    "sense_definition": "een bepaalde tekst of inhoud hebben",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "inhoud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoe <w>luidt</w> uw vraag precies?",
                            "target_lang_translations": {
                                "en": "How exactly does your question <w>read</w>?"
                            }
                        },
                        {
                            "text": "De officiële tekst van de wet <w>luidt</w> als volgt.",
                            "target_lang_translations": {
                                "en": "The official text of the law <w>goes</w> as follows."
                            }
                        }
                    ],
                    "common_phrases": [
                        "als volgt luiden",
                        "de tekst luidt"
                    ],
                    "target_lang_definitions": {
                        "en": "to have a specific text, wording, or content"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "read",
                                "target_lang_sense_clarification": "of a text or sign"
                            },
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "of a story or wording"
                            },
                            {
                                "target_lang_word": "be",
                                "target_lang_sense_clarification": "the content of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a68990fc-b6c5-31f8-8c0d-4ea677e80099",
                    "sense_definition": "een bel of klok laten klinken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koster zal de zware klokken <w>luiden</w> voor de dienst.",
                            "target_lang_translations": {
                                "en": "The sexton will <w>ring</w> the heavy bells before the service."
                            }
                        },
                        {
                            "text": "Deze oude klok wordt zelden <w>geluid</w> vanwege de slechte staat.",
                            "target_lang_translations": {
                                "en": "This old bell is rarely <w>rung</w> because of its poor condition."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de noodklok luiden",
                        "de klokken luiden"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause a bell or clock to sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "to sound a bell"
                            },
                            {
                                "target_lang_word": "toll",
                                "target_lang_sense_clarification": "to ring slowly and solemnly"
                            },
                            {
                                "target_lang_word": "peal",
                                "target_lang_sense_clarification": "to ring loudly or in a series"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91a35e17-58be-3d33-bd76-1afbe6fcbdd9",
                    "sense_definition": "het weerklinken van het geluid van een klok",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kerkklokken <w>luidden</w> toen er een dijkdoorbraak dreigde.",
                            "target_lang_translations": {
                                "en": "The church bells <w>tolled</w> when a dike breach was imminent."
                            }
                        },
                        {
                            "text": "In de verte hoorden we de klokken <w>luiden</w> voor het huwelijk.",
                            "target_lang_translations": {
                                "en": "In the distance, we heard the bells <w>ringing</w> for the wedding."
                            }
                        }
                    ],
                    "common_phrases": [
                        "klokken horen luiden"
                    ],
                    "target_lang_definitions": {
                        "en": "the resounding or echoing sound of a bell"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "the sound of a bell"
                            },
                            {
                                "target_lang_word": "chime",
                                "target_lang_sense_clarification": "a melodic bell sound"
                            },
                            {
                                "target_lang_word": "toll",
                                "target_lang_sense_clarification": "a slow, repetitive bell sound"
                            }
                        ]
                    }
                }
            ]
        },
        {
