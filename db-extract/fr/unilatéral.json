                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1017f352-69ae-3dde-9e2b-ae623a1ec823",
                        "entry_id": "85cdfd04-50f2-3cb9-a809-9afb21a12c95",
                        "glosses": [
                            "Relatif à un seul côté.",
                            "Qui est situé d’un seul côté (droit ou gauche)."
                        ],
                        "tags": [
                            "Médecine vétérinaire"
                        ],
                        "examples": [
                            {
                                "example_id": "6c56e0c3-e0c9-423b-9192-f7edbf92e8ef",
                                "sense_id": "1017f352-69ae-3dde-9e2b-ae623a1ec823",
                                "text": "Douleur fulgurante, unilatérale, en éclairs (décharges électriques), dans le territoire d’une ou plusieurs branches du trijumeau."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc55ea3f-a2d2-315f-81ad-772b6b511c8e",
                        "entry_id": "85cdfd04-50f2-3cb9-a809-9afb21a12c95",
                        "glosses": [
                            "Relatif à un seul côté.",
                            "Qui est situé d’un seul côté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3efb6b6b-1587-4c8b-812a-1191c30010a3",
                                "sense_id": "bc55ea3f-a2d2-315f-81ad-772b6b511c8e",
                                "text": "Les fleurs de la bourrache sont unilatérales."
                            }
                        ]
                    },
                    {
                        "sense_id": "465148ee-ce22-3eb5-862b-c0194314a2e7",
                        "entry_id": "85cdfd04-50f2-3cb9-a809-9afb21a12c95",
                        "glosses": [
                            "Relatif à un seul côté.",
                            "Qui n’engage qu’une des parties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bb387f5-7742-41a6-aae2-2174ad9ebf8f",
                                "sense_id": "465148ee-ce22-3eb5-862b-c0194314a2e7",
                                "text": "Le congé est un acte unilatéral réceptice en ce sens qu'il produit des effets juridiques lorsqu'il est arrivé à la connaissance de celui qui le subit."
                            },
                            {
                                "example_id": "172b4dec-3eff-456f-92a3-389bc6a476d1",
                                "sense_id": "465148ee-ce22-3eb5-862b-c0194314a2e7",
                                "text": "Rappelons ici qu'aussi choquant que cela puisse paraître, la jurisprudence admet la résiliation unilatérale sans indemnisation lorsque l'absence de réparation financière est prévue par le contrat."
                            },
                            {
                                "example_id": "3688247f-a2a2-440c-853f-f6d995fff5d6",
                                "sense_id": "465148ee-ce22-3eb5-862b-c0194314a2e7",
                                "text": "Engagement unilatéral."
                            }
                        ]
                    }
                ],
