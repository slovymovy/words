                "senses": [
                    {
                        "sense_id": "7800a68c-ce73-3622-b9e5-8ccd8c48f5ca",
                        "entry_id": "dd49f085-37e1-383e-8920-f7680740eb4a",
                        "glosses": [
                            "Teil der Bewaffnung, der die Brust gegen Hiebe/Stiche mit Waffen schützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3145abb-2b11-4c2e-9232-6fb84e39a6fd",
                                "sense_id": "7800a68c-ce73-3622-b9e5-8ccd8c48f5ca",
                                "text": "„Aus Leder waren die Schuhe, die Kopfbedeckung, Gürtel, Riemen, das Zaumzeug der Pferde, die Helme und Brustpanzer der einfachen Krieger.“"
                            },
                            {
                                "example_id": "10a81470-76b5-42b0-9613-1721a45e6033",
                                "sense_id": "7800a68c-ce73-3622-b9e5-8ccd8c48f5ca",
                                "text": "„Falls man es sich leisten kann, empfielt sich das Tragen eines Brustpanzers, falls man sich mehr leisten kann, zusätzlich noch eine Rückenplatte, die durch Riemen mit dem Vorderteil verbunden wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
