                "senses": [
                    {
                        "sense_id": "4c2fb62d-4d36-3446-af7f-978e56e79827",
                        "entry_id": "b4d8bd3c-dfe9-3b1a-adfe-26314c1170e3",
                        "glosses": [
                            "Qui permet de décider."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5533462-3d8f-4d44-afee-c48d302c09fa",
                                "sense_id": "4c2fb62d-4d36-3446-af7f-978e56e79827",
                                "text": "Déployer la stratégie exige un système d’information décisionnel cohérent."
                            },
                            {
                                "example_id": "ce720091-ec85-48aa-8a5c-20a759bf2d9d",
                                "sense_id": "4c2fb62d-4d36-3446-af7f-978e56e79827",
                                "text": "Ne surtout pas dépasser ce cadre interroge sur la marge de manœuvre laissée aux travailleurs sociaux dans l’adaptation aux individualités des bénéficiaires, et la place laissée à ces derniers en terme de pouvoir d’agir, et de pouvoir décisionnel sur les actes les concernant directement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6abab959-126f-4b59-8f55-9f23feb8a36b",
                        "source_entry_id": "b4d8bd3c-dfe9-3b1a-adfe-26314c1170e3",
                        "source_sense_id": "4c2fb62d-4d36-3446-af7f-978e56e79827",
                        "target_lang_word": "decision-making",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
