                ],
                "senses": [
                    {
                        "sense_id": "824d13cb-2e0d-385c-8353-677bc6ea120d",
                        "entry_id": "66d72b60-39b5-3590-b8ad-3e8669bdeeb7",
                        "glosses": [
                            "wie in einem Traum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8134f633-7c27-40ab-a154-119953b7d2b7",
                                "sense_id": "824d13cb-2e0d-385c-8353-677bc6ea120d",
                                "text": "„Es war unvermeidlich, dass dieses Abenteuer mitten in dem traumgleichen und schäbigen Nachtleben Nortowns stattfand.“"
                            },
                            {
                                "example_id": "7255595e-f458-4d88-a514-baea548e2bda",
                                "sense_id": "824d13cb-2e0d-385c-8353-677bc6ea120d",
                                "text": "„Hier oben gab es nur dunkle, nackte Felsabstürze und die ersten Ausläufer grob gefurchter Gletscher - doch jene faszinierenden Würfel und Wälle, jene widerhallenden Höhlenöffnungen verliehen der Szenerie etwas drohend Unnatürliches, Fantastisches und Traumgleiches.“"
                            },
                            {
                                "example_id": "e67a8169-9d43-4688-b5ff-cbfd3c36d0ed",
                                "sense_id": "824d13cb-2e0d-385c-8353-677bc6ea120d",
                                "text": "„Dahinter, in der anonymen Ferne, setzte Hundegejaule ein, aber die Tiere waren weit weg, und ihr vom Fluss gedämpftes Kläffen drang ihm verloren und traumgleich ans Ohr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
