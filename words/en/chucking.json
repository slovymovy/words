            "senses": [
                {
                    "sense_id": "127261e7-1ec2-3e14-a711-adbe57a1a644",
                    "sense_definition": "present participle and gerund of <w>chuck</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was casually <w>chucking</w> stones into the lake while waiting for his friends.",
                            "target_lang_translations": {
                                "nl": "Hij was terloops stenen in het meer aan het <w>gooien</w> terwijl hij op zijn vrienden wachtte."
                            }
                        },
                        {
                            "text": "She was tired of <w>chucking</w> away good food that nobody had eaten.",
                            "target_lang_translations": {
                                "nl": "Ze was het beu om goed voedsel <w>weg te gooien</w> dat niemand had gegeten."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chucking away",
                        "chucking out"
                    ],
                    "target_lang_definitions": {
                        "nl": "onvoltooid deelwoord en zelfstandig naamwoord van 'chuck' (gooien, smijten)"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gooien",
                                "target_lang_sense_clarification": "werpen"
                            },
                            {
                                "target_lang_word": "smijten",
                                "target_lang_sense_clarification": "krachtig gooien"
                            },
                            {
                                "target_lang_word": "weggooien",
                                "target_lang_sense_clarification": "afdanken (chucking away/out)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ed9e567-57df-3e22-b9a9-d21bd8b78303",
                    "sense_definition": "The act or process of holding an object securely in a machine chuck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machinist carefully adjusted the workpiece during the second <w>chucking</w> to ensure precise alignment.",
                            "target_lang_translations": {
                                "nl": "De machinist stelde het werkstuk zorgvuldig af tijdens de tweede <w>opspanning</w> om een nauwkeurige uitlijning te garanderen."
                            }
                        },
                        {
                            "text": "Proper <w>chucking</w> prevents the metal piece from vibrating during high-speed rotation on the lathe.",
                            "target_lang_translations": {
                                "nl": "Correct <w>inspannen</w> voorkomt dat het metalen onderdeel trilt tijdens rotatie op hoge snelheid op de draaibank."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het stevig inspannen of klemmen van een werkstuk in een klauwplaat van een machine."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het inspannen",
                                "target_lang_sense_clarification": "in een machineklem of klauwplaat"
                            },
                            {
                                "target_lang_word": "het klemmen",
                                "target_lang_sense_clarification": "van een werkstuk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
