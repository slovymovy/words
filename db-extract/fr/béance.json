                                                "example_id": "31c5c94d-f1d6-4095-bd8d-cf15321d7583",
                                                "sense_id": "9014d0b1-1938-3587-a9d5-752501b9e872",
                                                "text": "Hoe voelt Nederland? Ingehouden, met dichtgeknepen billen. Dat is het eerste wat in me opkomt. Vaak wordt er in de lucht gekust. De Nederlandse huid laat zich niet gemakkelijk strelen. Nederland voelt ongemakkelijk. Er is een afstand, een kleine gaping tussen degene die voelt en het gevoelde; afstand die niet altijd overwonnen kan worden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f5ee478-5de6-3767-9772-75f55a1dd640",
                                        "entry_id": "d74db522-9f20-35ab-a301-2fdd5bcf153a",
                                        "glosses": [
