            "senses": [
                {
                    "sense_id": "a594043c-3c84-3c1c-bcd6-e55e3ed5e11f",
                    "sense_definition": "Poczuć się dotkniętym czyimś zachowaniem lub słowami, okazać niezadowolenie milczeniem lub zerwaniem kontaktu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój brat <obraził> się na mnie, bo zjadłem jego ciastko.",
                            "target_lang_translations": {
                                "ru": "Мой брат <обиделся> на меня, потому что я съел его печенье.",
                                "en": "My brother <got offended> at me because I ate his cookie.",
                                "nl": "Mijn broer <werd boos op> mij omdat ik zijn koekje had opgegeten.",
                                "de": "Mein Bruder war auf mich <beleidigt>, weil ich seinen Keks gegessen habe.",
                                "fr": "Mon frère <s'est vexé> contre moi parce que j'ai mangé son gâteau.",
                                "it": "Mio fratello si è <offeso> con me perché ho mangiato il suo biscotto.",
                                "cs": "Můj bratr se na mě <urazil>, protože jsem mu snědl sušenku.",
                                "tr": "Kardeşim kurabiyesini yedim diye bana <küstü>.",
                                "es": "Mi hermano <se ofendió> conmigo porque me comí su pastel.",
                                "zh": "我哥哥<生>我的<气>了，因为我吃掉了他的蛋糕。"
                            }
                        },
                        {
                            "text": "Nie warto <obrazić> się o taką drobną pomyłkę.",
                            "target_lang_translations": {
                                "ru": "Не стоит <обижаться> из-за такой мелкой ошибки.",
                                "en": "It's not worth <taking offense> over such a minor mistake.",
                                "nl": "Het is het niet waard om <beledigd te zijn> over zo'n kleine vergissing.",
                                "de": "Es lohnt sich nicht, wegen eines so kleinen Fehlers <beleidigt zu sein>.",
                                "fr": "Ça ne vaut pas la peine de <se vexer> pour une si petite erreur.",
                                "it": "Non vale la pena <offendersi> per un errore così piccolo.",
                                "cs": "Nestojí za to se kvůli takové drobné chybě <urazit>.",
                                "tr": "Böyle küçük bir hata yüzünden <alınmaya> değmez.",
                                "es": "No vale la pena <ofenderse> por un error tan pequeño.",
                                "zh": "不值得为这样一个小错误<赌气>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nadąsać się"
                    ],
                    "common_phrases": [
                        "obrazić się na kogoś",
                        "obrazić się o byle co",
                        "śmiertelnie się obrazić"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "czasownik zwrotny używany z \"się\""
