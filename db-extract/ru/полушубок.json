                        "examples": [
                            {
                                "example_id": "42e2b7a5-4ca4-4352-8621-c898d5f92a39",
                                "sense_id": "7bc4f78d-0cb9-3571-809e-2ece9ca877a8",
                                "text": "По двору, в накинутом на плечи полушубке, крестясь и позёвывая, плёлся из сарая в кухню старый приказчик.",
                                "translation": "The old clerk, with a short fur coat thrown over his shoulders, yawning and crossing himself, crept across the yard from the barn to the kitchen.",
