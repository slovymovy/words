                        "entry_id": "50be589c-ea1a-319e-8e96-46715fff9497",
                        "glosses": [
                            "Se dit d’un poisson qui vit en mer mais qui naît et se reproduit en eau douce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99080c5a-aac2-4d12-bd53-6c758fe2c2e7",
                                "sense_id": "388fe010-f553-331c-a904-cd122da71c03",
                                "text": "Le saumon est la plus connue des espèces potamotoques."
