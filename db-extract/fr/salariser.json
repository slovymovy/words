                                "example_id": "b41e2f65-7484-4658-8d41-17ccc5da456c",
                                "sense_id": "fd48ef6b-9a44-32ec-9874-04e0498ef7e3",
                                "text": "Faut-il alors salariser l'exclusion ?"
