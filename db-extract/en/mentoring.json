                        ]
                    },
                    {
                        "translation_id": "edfb2a44-6736-4781-820e-76d0f20c6fe1",
                        "source_entry_id": "dda82ecc-844d-3592-a0b8-0d752478a36d",
                        "source_sense_id": "0519a2ec-5db0-3fe8-975a-ca56d18fc074",
                        "source_sense_description": "one person mentoring another",
                        "target_lang_word": "Betreuung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betreuung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f57f0999-d4f7-3304-a0f5-3bffcdb9d342",
                                        "entry_id": "cd6e522f-b806-371c-89c4-565055758b79",
                                        "glosses": [
                                            "das Aufpassen und Helfen von jemandem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2feb8237-b24a-4953-97cd-5f804f1cf654",
                                                "sense_id": "f57f0999-d4f7-3304-a0f5-3bffcdb9d342",
                                                "text": "[…] in der gesellschaftlichen und politischen Debatte in Deutschland spielen frühkindliche Bildung und Betreuung bislang noch eine untergeordnete Rolle."
                                            },
                                            {
                                                "example_id": "eb3b935f-abd0-4058-83ef-37593caf89f9",
                                                "sense_id": "f57f0999-d4f7-3304-a0f5-3bffcdb9d342",
                                                "text": "„Ziel unserer Betreuung ist, den Schüler in einem überschaubaren Zeitraum aus seiner negativen Lernstruktur zu befreien und ihn so weit zu bringen, daß er imstande ist, selbständig zu lernen.“"
                                            },
                                            {
                                                "example_id": "ae89252e-521c-4075-b3a7-1b81c32c384b",
                                                "sense_id": "f57f0999-d4f7-3304-a0f5-3bffcdb9d342",
                                                "text": "„Bei der Betreuung des wissenschaftlichen Nachwuchses verhielt Einstein sich vorbildlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0414b0c-b907-3a96-b477-a8a03a09208b",
                                        "entry_id": "cd6e522f-b806-371c-89c4-565055758b79",
                                        "glosses": [
                                            "Person, die jemanden betreut (nach [1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4fef0af-8ae7-42af-8ac8-8a856f9a422e",
                                                "sense_id": "e0414b0c-b907-3a96-b477-a8a03a09208b",
                                                "text": "„In Kinderheimen sei die Lage katastrophal, berichteten Helfer und Experten. Viele obdachlose Kinder seien ohne jegliche Betreuung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9ce93180-7211-32c6-a43a-cc1b82d75ab0",
                                        "entry_id": "cd6e522f-b806-371c-89c4-565055758b79",
                                        "glosses": [
                                            "gerichtlich angeordnete Vertretung (insbesondere im Rechtsverkehr) und Hilfe (wie [1]) für jemanden, der „seine Angelegenheiten ganz oder teilweise nicht besorgen“ kann (Deutschland: § 1896 BGB)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a64e358-d067-4033-840e-a3cb8f49999a",
                                                "sense_id": "9ce93180-7211-32c6-a43a-cc1b82d75ab0",
                                                "text": "„Ein Betreuer darf nur für Aufgabenkreise bestellt werden, in denen die Betreuung erforderlich ist.“ (§ 1896 BGB)"
                                            },
                                            {
                                                "example_id": "650bd096-6fce-4c43-ab79-380c685b73b0",
                                                "sense_id": "9ce93180-7211-32c6-a43a-cc1b82d75ab0",
                                                "text": "„Für den Betreuungsrichter bedeutet dies, dass er bestrebt sein sollte, die Betreuungen, die er dem einzelnen Berufsbetreuer überträgt, entsprechend zu ‚mischen‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
