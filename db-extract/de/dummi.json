                                            {
                                                "example_id": "19203c72-c713-41af-aabb-2dafb9dce411",
                                                "sense_id": "a1dafeae-9a6a-3388-a142-34df618a1847",
                                                "text": "The carpenters dummied some props for the rehearsals."
                                            }
                                        ]
