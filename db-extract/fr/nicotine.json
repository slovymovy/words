                                        "glosses": [
                                            "im Tabak enthaltenes Nervengift, ein Neurotransmitter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd9c5b5b-b3a6-4060-b17a-66b207f58a2c",
                                                "sense_id": "6c99fb76-eef9-3f9c-bd8b-2e2f56b0dc2d",
                                                "text": "Das Nikotin hinterlässt einen gelben Film auf der Tapete."
                                            },
                                            {
                                                "example_id": "7e9463d4-efcf-4f27-a35f-907c37986530",
                                                "sense_id": "6c99fb76-eef9-3f9c-bd8b-2e2f56b0dc2d",
                                                "text": "„Jahrelang hat man uns den Spaß an Alkohol und Nikotin verdorben, hat man uns eingeredet, wir seien Manager und daher ganz natürlich zu vorzeitigem Altern verurteilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58ba9009-14ef-4b69-ab76-e5ec393151d4",
