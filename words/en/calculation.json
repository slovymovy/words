{
    "word_family": [
        "calculate",
        "calculator",
        "calculable",
        "incalculable",
        "miscalculate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b2498731-c7d5-38ff-8258-9861b6ef5696",
                    "sense_definition": "The act or process of using numbers to find an amount or result.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to do a quick <w>calculation</w> to see if we can afford the trip.",
                            "target_lang_translations": {
                                "ru": "Мне нужно сделать быстрый <w>расчёт</w>, чтобы понять, можем ли мы позволить себе эту поездку.",
                                "zh": "我需要快速做个<w>计算</w>，看看我们是否负担得起这次旅行。"
                            }
                        },
                        {
                            "text": "The <w>calculation</w> of the total expenses took longer than expected.",
                            "target_lang_translations": {
                                "ru": "<w>Подсчёт</w> общих расходов занял больше времени, чем ожидалось.",
                                "zh": "总费用的<w>核算</w>花费的时间比预期的要长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "computation",
                        "computing",
                        "reckoning",
                        "math",
                        "sum"
                    ],
                    "antonyms": [
                        "miscalculation"
                    ],
                    "common_phrases": [
                        "do a calculation",
                        "make a calculation",
                        "perform a calculation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс использования чисел для нахождения суммы или результата",
                        "zh": "通过数学运算得出结果的过程或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычисление",
                                "target_lang_sense_clarification": "математическое действие"
                            },
                            {
                                "target_lang_word": "расчёт",
                                "target_lang_sense_clarification": "определение размера или стоимости"
                            },
                            {
                                "target_lang_word": "подсчёт",
                                "target_lang_sense_clarification": "подведение итога"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "计算",
                                "target_lang_sense_clarification": "指数学运算的过程"
                            },
                            {
                                "target_lang_word": "核算",
                                "target_lang_sense_clarification": "指对账目或费用的计算"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b00326ab-ab63-3fb9-8338-63f46da34b91",
                    "sense_definition": "The result obtained from a mathematical process.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please check your <w>calculation</w> again to ensure the answer is correct.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте свои <w>вычисления</w> ещё раз, чтобы убедиться в правильности ответа.",
                                "zh": "请再检查一遍你的<w>计算结果</w>，以确保答案正确。"
                            }
                        },
                        {
                            "text": "The final <w>calculation</w> showed that the company made a significant profit.",
                            "target_lang_translations": {
                                "ru": "Окончательный <w>расчёт</w> показал, что компания получила значительную прибыль.",
                                "zh": "最终的<w>计算</w>显示公司获得了可观的利润。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sum"
                    ],
                    "common_phrases": [
                        "check a calculation",
                        "final calculation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат, полученный в ходе математического процесса",
                        "zh": "数学运算后得出的具体数值或结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расчёт",
                                "target_lang_sense_clarification": "полученный результат"
                            },
                            {
                                "target_lang_word": "вычисление",
                                "target_lang_sense_clarification": "результат действий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "计算结果",
                                "target_lang_sense_clarification": "运算得出的最终数值"
                            },
                            {
                                "target_lang_word": "算式",
                                "target_lang_sense_clarification": "指具体的运算过程或结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b084e45a-ed25-3560-82b8-ea9245a0a9d0",
                    "sense_definition": "An estimate, forecast, or assessment based on available information.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By my <w>calculation</w>, we should arrive at the destination by midnight.",
                            "target_lang_translations": {
                                "ru": "По моим <w>расчётам</w>, мы должны прибыть в пункт назначения к полуночи.",
                                "zh": "按我的<w>估算</w>，我们应该会在午夜前到达目的地。"
                            }
                        },
                        {
                            "text": "His political <w>calculation</w> was that the voters would support the new law.",
                            "target_lang_translations": {
                                "ru": "Его политический <w>расчёт</w> заключался в том, что избиратели поддержат новый закон.",
                                "zh": "他的政治<w>盘算</w>是选民会支持这项新法律。"
                            }
                        }
                    ],
                    "synonyms": [
                        "estimate",
                        "reckoning"
                    ],
                    "common_phrases": [
                        "by my calculation",
                        "rough calculation",
                        "cold calculation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оценка, прогноз или суждение, основанные на имеющейся информации",
                        "zh": "基于现有信息所做的预估、预测或判断。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расчёт",
                                "target_lang_sense_clarification": "намерение, план или прогноз"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "估算",
                                "target_lang_sense_clarification": "对数量或情况的推测"
                            },
                            {
                                "target_lang_word": "盘算",
                                "target_lang_sense_clarification": "指对利弊得失的考虑或谋划"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}