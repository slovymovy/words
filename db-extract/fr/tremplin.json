                        "entry_id": "d285dc72-2423-39eb-8741-41adb1aec7d5",
                        "glosses": [
                            "Planche inclinée, élastique, sur laquelle les sauteurs ou les plongeurs bondissent pour s’élancer et faire des sauts ou des plongeons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc57158f-47ef-4f45-b763-3e6a6c27090a",
                                "sense_id": "2be4890f-9a02-34e9-b6df-95bbbcf0bfd1",
                                "text": "Le saut du tremplin."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9ece9d6-8eec-3cc5-a2c7-1d1f0a2564e2",
                        "entry_id": "d285dc72-2423-39eb-8741-41adb1aec7d5",
                        "glosses": [
                            "Circonstance favorable à l'accélération du développement d’une affaire, d’une entreprise."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bb8ab7af-f87f-4d96-98a3-fbcbb8556e07",
                                "sense_id": "d9ece9d6-8eec-3cc5-a2c7-1d1f0a2564e2",
                                "text": "Le mouvement syndical sert de tremplin institutionnel à la fondation de la Caisse populaire de Montmorency en 1937, à la Coopérative de Montmorency en 1940 et au journal Le moulin au pied des Chutes en 1941."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c017e591-ba59-44fc-92b4-3204f9d8e8d0",
                        "source_entry_id": "d285dc72-2423-39eb-8741-41adb1aec7d5",
                        "source_sense_description": "appareil pour le saut",
                        "target_lang_word": "Sprungbrett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprungbrett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98cf1abe-8294-32cc-9f5f-727350a742cc",
                                        "entry_id": "09f6aa07-00b9-309b-bfda-f6f68486ed8a",
                                        "glosses": [
                                            "federndes Brett zum Abspringen, um dadurch eine größere Höhe oder Weite zu erzielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0af76c9e-e6c7-461f-93a3-17795deea336",
                                                "sense_id": "98cf1abe-8294-32cc-9f5f-727350a742cc",
                                                "text": "„Sprungbretter sind zwischen 3,0 und 4,8 Meter lang und auf einem Sprungturm befestigt“."
                                            },
                                            {
                                                "example_id": "47992d63-6272-478d-bc20-39c3c784676b",
                                                "sense_id": "98cf1abe-8294-32cc-9f5f-727350a742cc",
                                                "text": "„Springerin beim Schwungholen auf einem Sprungbrett“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ea09888-8364-3b68-94a5-6a24e9f8aec8",
                                        "entry_id": "09f6aa07-00b9-309b-bfda-f6f68486ed8a",
                                        "glosses": [
                                            "vorteilhafte Ausgangslage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19ec5cda-4081-469c-845c-59e46429fd1e",
                                                "sense_id": "6ea09888-8364-3b68-94a5-6a24e9f8aec8",
                                                "text": "„Zeitarbeit kann Sprungbrett sein“."
                                            },
                                            {
                                                "example_id": "018ad665-99cb-44f1-86d5-c90321bc4c29",
                                                "sense_id": "6ea09888-8364-3b68-94a5-6a24e9f8aec8",
                                                "text": "„Für Arbeitslose vom Westbalkan war die Zeitarbeit dagegen kein Sprungbrett in anderweitige Beschäftigung“."
                                            },
                                            {
                                                "example_id": "61aa8f9c-9a13-4d05-89f5-786f49c68a49",
                                                "sense_id": "6ea09888-8364-3b68-94a5-6a24e9f8aec8",
                                                "text": "„Im Fernen Osten wurde Japans Niederlage das Sprungbrett zu Asiens Sieg.“"
                                            },
                                            {
                                                "example_id": "0ac6f62e-b68b-4c47-a9fb-b72be5176455",
                                                "sense_id": "6ea09888-8364-3b68-94a5-6a24e9f8aec8",
                                                "text": "„Seinen neu gewonnenen Reichtum nutzte er als Sprungbrett für eine politische Karriere, die ihn 1890 auf den Sessel des Premierministers der britischen Kapkolonie führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "376e64eb-f778-43fc-911c-20139ef3511d",
                        "source_entry_id": "d285dc72-2423-39eb-8741-41adb1aec7d5",
                        "source_sense_description": "appareil pour le saut",
                        "target_lang_word": "Sprungschanze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
