            "senses": [
                {
                    "sense_id": "34f65b84-c0bb-3fca-af58-7e6d8ac44e82",
                    "sense_definition": "einen Behälter, eine Tür oder ein Fenster so öffnen, dass das Innere zugänglich oder offen ist",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "öffnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es ist sehr warm im Zimmer, deshalb <w>mache</w> ich das Fenster <w>auf</w>."
                        },
                        {
                            "text": "Kannst du mir bitte helfen und diese feste Dose <w>aufmachen</w>?"
                        }
                    ],
                    "synonyms": [
                        "öffnen"
                    ],
                    "antonyms": [
                        "zumachen",
                        "schließen"
                    ],
                    "common_phrases": [
                        "das Fenster aufmachen",
                        "die Tür aufmachen",
                        "ein Paket aufmachen"
                    ]
                },
                {
                    "sense_id": "7f450dd6-d97f-384b-a25e-e83c8e083da2",
                    "sense_definition": "jemandem, der draußen wartet oder klingelt, die Tür öffnen und Einlass gewähren",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "öffnen",
                    "name_type": "no",
                    "examples": [
