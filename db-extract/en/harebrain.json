                        "examples": [
                            {
                                "example_id": "b6c6f551-39fb-467c-b564-4f728a5d4cea",
                                "sense_id": "6d66ff9e-c393-3466-b368-c6363fc2a42a",
                                "text": "I mean it (saith the king) by that same harebrain, wild-fellow, my subject, the Earl of Suffolk, who is protected in your country, and begins to play the fool, when all others are weary of it.\""
                            },
                            {
                                "example_id": "de0486f7-42e1-4395-9ef8-afedb1f97555",
                                "sense_id": "6d66ff9e-c393-3466-b368-c6363fc2a42a",
                                "text": "\" They commonly call the most harebrain blood-suckers, strongest thieves, the most desperate villains, treacherous rogues, inhuman murderers, rash, cruel and dissolute caitiffs, courageous and generous spirits, heroical and worthy captains, brave men at arms, valiant and renowned soldiers, possessed with a brute persuasion of false honour,\" as Pontus Huter in his Burgundian history complains."
                            },
                            {
                                "example_id": "8fb9cfe0-05b2-4643-b72d-6c3495fe16e8",
                                "sense_id": "6d66ff9e-c393-3466-b368-c6363fc2a42a",
                                "text": "I suppose they also handed on to me a harebrain humour, which it has been my chief delight to indulge."
                            },
                            {
                                "example_id": "990dbe06-480a-47e5-8439-9ce1d95616bb",
                                "sense_id": "6d66ff9e-c393-3466-b368-c6363fc2a42a",
                                "text": "It is a harebrain idea but it could be done."
                            }
                        ]
                    }
                ],
