                ],
                "senses": [
                    {
                        "sense_id": "f8b4e11b-aacf-3e37-8bb0-62a78c13fda5",
                        "entry_id": "c942f025-a0c6-3781-8e73-7284005e90c7",
                        "glosses": [
                            "Geruchswahrnehmung, die von Bier stammt oder diesem ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ec9feb1-ff4f-45b4-aec1-c95b87ee125c",
                                "sense_id": "f8b4e11b-aacf-3e37-8bb0-62a78c13fda5",
                                "text": "„Mit einem Sirupbonbon, hoffte er den Biergeruch zu neutralisieren.“"
                            },
                            {
                                "example_id": "3410c249-2430-42ce-9839-bd0649712e2d",
                                "sense_id": "f8b4e11b-aacf-3e37-8bb0-62a78c13fda5",
                                "text": "„Als der Fahrzeughalter die Wohnung öffnete, nahmen die Polizisten sofort starken Biergeruch wahr.“"
                            },
                            {
                                "example_id": "d7415051-d43c-4f1d-aaa0-d758cdaa50f8",
                                "sense_id": "f8b4e11b-aacf-3e37-8bb0-62a78c13fda5",
                                "text": "„Auch nach der Freigabe der Anschlussstelle waren der Biergeruch sowie die Scherbenreste für die Autofahrer noch deutlich bemerkbar.“"
                            },
                            {
                                "example_id": "70b8572b-df34-4d64-aa9b-b350e27d5794",
                                "sense_id": "f8b4e11b-aacf-3e37-8bb0-62a78c13fda5",
                                "text": "„Spätestens zum Jahresende wird es den typischen Biergeruch über Teilen der Marner Innenstadt, der an geöffnete Kneipen nach durchzechten Nächten erinnert, nicht mehr geben.“"
                            },
                            {
                                "example_id": "875af5d7-07c7-4ae0-bc19-7ef3b1664623",
                                "sense_id": "f8b4e11b-aacf-3e37-8bb0-62a78c13fda5",
                                "text": "„Biergeruch, wiesen japanische Marktforscher nach, animiert demnach Menschen zum Trinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
