{
    "word_family": [
        "kanker",
        "kankeraar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "443d32a1-8e58-3353-852e-ca2568de6199",
                    "sense_definition": "voortdurend klagen of mopperen, vaak op een ietwat geagiteerde of zeurderige toon",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "klagen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zit de hele dag te <w>kankeren</w> over het slechte weer.",
                            "target_lang_translations": {
                                "en": "He is <w>grumbling</w> about the bad weather all day long."
                            }
                        },
                        {
                            "text": "In plaats van te <w>kankeren</w> op de overheid, kunnen we beter zelf actie ondernemen.",
                            "target_lang_translations": {
                                "en": "Instead of <w>griping</w> about the government, we had better take action ourselves."
                            }
                        }
                    ],
                    "synonyms": [
                        "mopperen",
                        "klagen",
                        "zeuren",
                        "vitten"
                    ],
                    "antonyms": [
                        "prijzen",
                        "loof"
                    ],
                    "common_phrases": [
                        "kankeren op",
                        "lopen te kankeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak als informeel of licht plat ervaren vanwege de associatie met de ziekte."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To complain or grumble continuously, often in an agitated, nagging, or bitter tone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grumble",
                                "target_lang_sense_clarification": "to complain in a low, muttering, or bad-tempered way"
                            },
                            {
                                "target_lang_word": "gripe",
                                "target_lang_sense_clarification": "to complain constantly or naggingly about something"
                            },
                            {
                                "target_lang_word": "bitch",
                                "target_lang_sense_clarification": "informal, to complain or grumble about something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2be5195-0f70-3157-a3ba-2e2f950231d5",
                    "sense_definition": "zich onbeheerst of kwaadaardig uitbreiden of woekeren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "woekeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het wantrouwen begon door de hele organisatie te <w>kankeren</w>.",
                            "target_lang_translations": {
                                "en": "The distrust began to <w>fester</w> throughout the entire organization."
                            }
                        },
                        {
                            "text": "Zonder ingrijpen zal dit probleem alleen maar verder <w>kankeren</w>.",
                            "target_lang_translations": {
                                "en": "Without intervention, this problem will only <w>spread like a cancer</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "woekeren",
                        "uitzaaien",
                        "prolifereren"
                    ],
                    "target_lang_definitions": {
                        "en": "To spread uncontrollably, fester, or grow in a malignant, destructive manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fester",
                                "target_lang_sense_clarification": "to grow increasingly virulent, bitter, or destructive over time"
                            },
                            {
                                "target_lang_word": "canker",
                                "target_lang_sense_clarification": "to spread like a malignant sore or corrupting influence"
                            },
                            {
                                "target_lang_word": "spread like a cancer",
                                "target_lang_sense_clarification": "to grow or multiply uncontrollably and destructively"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}