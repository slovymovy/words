                                        "glosses": [
                                            "Cancer of the bile ducts (e.g., common bile duct, cholangioles)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f49726c3-690e-4955-b91a-d59ac4ea270f",
                                                "sense_id": "1b658e1f-21df-3bf8-803a-cd3b59109392",
                                                "text": "Cholangiocarcinoma develops at a significantly younger age (between the ages of 30 and 50) in patients with PSC than in patients without PSC."
                                            },
                                            {
                                                "example_id": "42ca8342-7339-4e8a-aa2e-d961e8b91bf2",
                                                "sense_id": "1b658e1f-21df-3bf8-803a-cd3b59109392",
                                                "text": "2013, J. R. Bhardwaj (editor), Boyd's Textbook of Pathology, Volume 2: Systemic Pathology, 10th Edition, Wolter Kluwer Health, page 1043,\nCholangiocarcinomata arise from the bile ducts. The intrahepatic cholangiocarcinomata are considered here."
                                            },
                                            {
                                                "example_id": "a1d6cffc-c62e-485a-8558-9e04c19dd7ac",
                                                "sense_id": "1b658e1f-21df-3bf8-803a-cd3b59109392",
                                                "text": "Cholangiocarcinoma (cholangiocellular carcinoma) is a primary malignant tumor arising from the bile duct and can be divided into intrahepatic and extrahepatic cholangiocarcinomas. Extrahepatic cholangiocarcinomas are further classified as either hilar or distal bile duct cholangiocarcinomas. Intrahepatic cholangiocarcinoma or peripheral cholangiocarcinoma is the second most common primary liver cancer following hepatocellular carcinoma. However, it represents only 10% of all cholangiocarcinomas."
                                            }
