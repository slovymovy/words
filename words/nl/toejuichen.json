            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b2ab888-4b8f-3616-98d1-8f2f58d80971",
                    "sense_definition": "iemand of iets met luid gejuich of applaus begroeten of aanmoedigen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "begroeten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De aanwezige fans <w>juichten</w> hun winnaar enthousiast <w>toe</w>.",
                            "target_lang_translations": {
                                "en": "The fans present enthusiastically <w>cheered</w> their winner."
                            }
                        },
                        {
                            "text": "Morgen kunnen supporters de spelers <w>toejuichen</w> bij de feestelijke huldiging in de stad.",
                            "target_lang_translations": {
                                "en": "Tomorrow, supporters can <w>cheer</w> the players during the festive tribute in the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "bejubelen"
                    ],
                    "common_phrases": [
                        "een winnaar toejuichen",
                        "het publiek juicht toe"
                    ],
                    "target_lang_definitions": {
                        "en": "To greet or encourage someone or something with loud cheering or applause."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cheer",
                                "target_lang_sense_clarification": "to shout with joy or support"
                            },
                            {
                                "target_lang_word": "applaud",
                                "target_lang_sense_clarification": "to show approval by clapping or cheering"
                            },
                            {
                                "target_lang_word": "acclaim",
                                "target_lang_sense_clarification": "to welcome or praise enthusiastically"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "226340b2-a2f5-3aa0-9859-697ec6beeffb",
                    "sense_definition": "iets met instemming of enthousiasme begroeten; een plan of besluit ondersteunen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ondersteunen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan dit nieuwe voorstel alleen maar <w>toejuichen</w> omdat het de veiligheid verbetert.",
                            "target_lang_translations": {
                                "en": "I can only <w>welcome</w> this new proposal because it improves safety."
                            }
                        },
                        {
                            "text": "De directie zal het <w>toejuichen</w> als we meer gaan samenwerken met andere afdelingen.",
                            "target_lang_translations": {
                                "en": "The management will <w>applaud</w> it if we start collaborating more with other departments."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een besluit toejuichen",
                        "een initiatief toejuichen"
                    ],
                    "target_lang_definitions": {
                        "en": "To welcome something with approval or enthusiasm; to support a plan or decision."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "welcome",
                                "target_lang_sense_clarification": "to receive a decision or idea with pleasure"
                            },
                            {
                                "target_lang_word": "applaud",
                                "target_lang_sense_clarification": "to express strong approval of a policy or action"
                            },
                            {
                                "target_lang_word": "cheer",
                                "target_lang_sense_clarification": "to express enthusiasm for a development"
                            },
                            {
                                "target_lang_word": "hail",
                                "target_lang_sense_clarification": "to praise a new initiative or result"
                            }
                        ]
                    }
                }
            ]
        }
    ]
