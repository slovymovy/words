                                "target_senses": [
                                    {
                                        "sense_id": "dcec3f37-f09d-3432-86d0-e9451a22717b",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
                                        "glosses": [
                                            "Extraordinary capable or knowledgeable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dbe4a80-66d4-4097-a3ad-45546766c13e",
                                                "sense_id": "dcec3f37-f09d-3432-86d0-e9451a22717b",
                                                "text": "I am expert at making a simple situation complex."
                                            },
                                            {
                                                "example_id": "eee8d8f3-3bee-42d3-8827-3ff4f8a3767f",
                                                "sense_id": "dcec3f37-f09d-3432-86d0-e9451a22717b",
                                                "text": "My cousin is an expert pianist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46922c74-8a61-312c-9a63-5189ea922291",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
                                        "glosses": [
                                            "Characteristic of an expert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4400dc18-9d2f-4229-8859-303d3ebe0aeb",
                                                "sense_id": "46922c74-8a61-312c-9a63-5189ea922291",
                                                "text": "This problem requires expert knowledge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d9aa305-7602-3c0a-82df-44e4726b49c1",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
                                        "glosses": [
                                            "Proven, experienced, veteran."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "expert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                        "entry_id": "a1d093ea-8743-35d2-89d4-1c001eaaf287",
                                        "glosses": [
                                            "A person with extensive knowledge or ability in a given subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "885b1c9c-fd0a-432d-a905-72485e899517",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "If an expert says it can't be done, get another expert. - David Ben-Gurion"
                                            },
                                            {
                                                "example_id": "837256c2-464e-4ceb-9acd-28049ca7978d",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "We called in several experts on the subject, but they couldn't reach an agreement."
                                            },
                                            {
                                                "example_id": "7df3c666-9ca6-4377-b295-f5f5a23d16c3",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field."
                                            },
                                            {
                                                "example_id": "10fa2d69-4d43-4bc4-8c13-6a74b71efb35",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "I'm an expert in my field\nUfology, yes, it's all real\nAncient aliens, it's all true\nI'm an expert just like you"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f712187-def4-3f07-87f9-c24dcf1000d4",
                                        "entry_id": "a1d093ea-8743-35d2-89d4-1c001eaaf287",
                                        "glosses": [
                                            "A player ranking just below master."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "expert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76b7736c-b927-3b72-a651-d74bcf7aa0c2",
                                        "entry_id": "9fa13cad-21c2-3a50-8034-e5883a66b45e",
                                        "glosses": [
                                            "To have (something) reviewed or checked by an expert."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36f6348c-29de-4106-a49c-490d8ca46ccb",
                                                "sense_id": "76b7736c-b927-3b72-a651-d74bcf7aa0c2",
                                                "text": "Estimated cost of editorial work on Advanced History […] Estimated cost of experting the Advanced History […]"
                                            },
                                            {
                                                "example_id": "d6009af6-14c9-4c0c-b241-cfa0fd00642d",
                                                "sense_id": "76b7736c-b927-3b72-a651-d74bcf7aa0c2",
                                                "text": "The bill in question was one proposing to appropriate from the public moneys of this State $30,000 to pay an accountant for experting the books of the Southern Pacific Company, in furtherance of litigation then pending."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51359257-ac6c-4e68-b756-1a7f859df5a2",
                        "source_entry_id": "88521b16-102e-3ce9-a943-278c0f789086",
                        "source_sense_id": "1cff4602-77dc-3400-999e-3c766c82c83b",
                        "source_sense_description": "iemand die bijzonder goed bekend is met een bepaald onderwerp",
                        "target_lang_word": "expert",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc669309-936d-3ef2-907f-589ae9f0adf0",
                                        "entry_id": "bb8c0fe8-beff-335e-ab27-9a869e0b80c4",
                                        "glosses": [
                                            "Qui est fort versé en la pratique de quelque art, de quelque connaissance qui s’apprend par expérience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73bf9cee-f3df-4535-9e25-0e92191339b3",
                                                "sense_id": "dc669309-936d-3ef2-907f-589ae9f0adf0",
                                                "text": "Presque rien dans cette banale chambre meublée ne se prêtait hélas ! à sa curiosité mal experte."
                                            },
                                            {
                                                "example_id": "5d46a272-ec5e-4bcc-bf9c-35d73025e5f1",
                                                "sense_id": "dc669309-936d-3ef2-907f-589ae9f0adf0",
                                                "text": "On dit que ces professionnelles ont des charmes secrets, […]; qu'un homme vicieux trouve en elles des partenaires expertes, aux impudeurs extraordinaires, aux habiles jeux de la débauche et de la lubricité."
                                            },
                                            {
                                                "example_id": "8542713b-a510-4e26-8844-5f632c1927b2",
                                                "sense_id": "dc669309-936d-3ef2-907f-589ae9f0adf0",
                                                "text": "Il est expert en matière de finances. — Il n’est pas très expert dans cet art. — Il est expert à lancer la balle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "expert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7d95dbb-de2e-3991-8634-3deb1a0a7b8b",
                                        "entry_id": "a4911985-b74c-33a2-8f57-5b10f5c7a5d8",
                                        "glosses": [
                                            "Personne nommée par autorité de justice, ou choisie par les parties intéressées pour examiner, pour estimer certaines choses et en faire son rapport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "280e89c4-2af8-42d7-8be8-90ca1ef5b9c4",
                                                "sense_id": "f7d95dbb-de2e-3991-8634-3deb1a0a7b8b",
                                                "text": "L’accidentologue, chargé d'étudier l’état de la chaussée, rendra un mémoire d’honoraires de 6 500 euros. L’expert automobile se satisfera de 4 800 euros."
                                            },
                                            {
                                                "example_id": "d73655a7-237e-4994-87db-cadfe7f7034c",
                                                "sense_id": "f7d95dbb-de2e-3991-8634-3deb1a0a7b8b",
                                                "text": "Au travers d'un mien pré certain ânon passa,\nS'y vautra, non sans faire un notable dommage,\nDont je formai ma plainte au juge du village.\nJe fais saisir l'ânon. Un expert est nommé,\nA deux bottes de foin le dégât estimé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bf3d017-c861-3aba-aa75-33c0bfb844d5",
                                        "entry_id": "a4911985-b74c-33a2-8f57-5b10f5c7a5d8",
                                        "glosses": [
                                            "Personne qui a un savoir, une connaissance, reconnus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "697e2f70-8c4b-4575-9cd6-deb3047cce67",
                                                "sense_id": "8bf3d017-c861-3aba-aa75-33c0bfb844d5",
                                                "text": "Un expert, c'est quelqu'un qui a consacré 10.000 heures à sa discipline, Malcolm Gladwell"
                                            },
                                            {
                                                "example_id": "669f25dc-0add-4af5-8d71-aa9e3473d1fe",
                                                "sense_id": "8bf3d017-c861-3aba-aa75-33c0bfb844d5",
                                                "text": "Dans les mains d'un expert, le nunchaku est pareil au tigre déchaîné, et il est impossible de le lui arracher des mains. C'est une arme redoutable."
                                            },
                                            {
                                                "example_id": "669a2820-6ded-4266-92b8-54eb4075afb5",
                                                "sense_id": "8bf3d017-c861-3aba-aa75-33c0bfb844d5",
                                                "text": "J’ai cru comprendre qu’il était « expert ». À présent, tout le monde est expert ou consultant. Expert-comptable, expert immobilier ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b593312d-40ec-3f8a-8742-af2c06acab10",
                                        "entry_id": "a4911985-b74c-33a2-8f57-5b10f5c7a5d8",
                                        "glosses": [
                                            "Officier qui veille à la bonne exécution du rituel."
                                        ],
                                        "tags": [
                                            "Franc-maçonnerie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
