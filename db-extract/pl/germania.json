                "translations": [
                    {
                        "translation_id": "c6c49613-8ebf-4afa-9632-7d61be673f33",
                        "source_entry_id": "da3a2805-2ec6-31ab-ad8d-12098b5377e7",
                        "source_sense_id": "720e897b-aedd-3152-b7f9-c38502505d39",
                        "target_lang_word": "Germania",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Germania",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dcff0a3-d849-311e-ba0a-a8a91c08a77a",
                                        "entry_id": "4d4179b2-15da-3008-aeba-e660458b9cf5",
                                        "glosses": [
                                            "An ancient Roman term for a cultural region describing the lands in Central Europe inhabited by Germanic peoples."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7b50ef6-c403-3c78-8638-4b6d2dc485bc",
                                        "entry_id": "4d4179b2-15da-3008-aeba-e660458b9cf5",
                                        "glosses": [
                                            "A personification of Germany or Germans as a whole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c283757f-bf38-4672-b038-27a63c462445",
                                                "sense_id": "e7b50ef6-c403-3c78-8638-4b6d2dc485bc",
                                                "text": "The City of London standing, wearing a helmet surmounted by a dragon, resting her right hand upon a low throne, on which is seated Germania, and pointing with her left hand to the shipping in the river Thames. On her left, resting against a stone balustrade, is a shield bearing the arms, crest, supporters, and motto of the City of London. Germania holds a sword in her left hand, her right hand resting on a shield bearing the arms of Germany."
                                            },
                                            {
                                                "example_id": "775efa89-a56a-4462-a399-a7207333c2b0",
                                                "sense_id": "e7b50ef6-c403-3c78-8638-4b6d2dc485bc",
                                                "text": "In the evening the Kaiser gave a grand banquet in a large hall constructed in the form of a full-rigged sailing vessel of the 17th century, the stem being adorned by a colossal figure of Germania, wearing a winged helmet."
                                            },
                                            {
                                                "example_id": "06b6f6fb-9e86-485e-90dc-1e4598b2ab1a",
                                                "sense_id": "e7b50ef6-c403-3c78-8638-4b6d2dc485bc",
                                                "text": "Aside from the impressive memories that it awakens, it is an imposing work of art, for the entire monument is more than one hundred feet in height,—the majestic figure of Germania, holding a crown and sword adorned with laurel wreaths, being itself thirty-three feet high."
                                            },
                                            {
                                                "example_id": "3c33219e-53e4-41a0-93ab-3e312163f416",
                                                "sense_id": "e7b50ef6-c403-3c78-8638-4b6d2dc485bc",
                                                "text": "While the reverse retains the same heraldic design of the first Allegories issue, the obverse shows Germania and Columbia grasping each other’s hand and, respectively, the German and American flags."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "404efbe3-1a77-34da-ae6d-8b4ad41f546a",
                                        "entry_id": "4d4179b2-15da-3008-aeba-e660458b9cf5",
                                        "glosses": [
                                            "Germany."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "offensive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27637ce8-d385-474b-8ae7-80842b4333d2",
                                                "sense_id": "404efbe3-1a77-34da-ae6d-8b4ad41f546a",
                                                "text": "Hey, German boy, go back to Germania!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "335873e1-2b87-30dd-bedb-9b4040ca8c89",
                                        "entry_id": "4d4179b2-15da-3008-aeba-e660458b9cf5",
                                        "glosses": [
                                            "A city proposed during the Nazi era to take over from Berlin as the German capital."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d608b299-f3f8-4056-866e-706dec1e6a1d",
                        "source_entry_id": "da3a2805-2ec6-31ab-ad8d-12098b5377e7",
                        "source_sense_id": "720e897b-aedd-3152-b7f9-c38502505d39",
                        "target_lang_word": "Germanie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Germanie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1777d934-fe7e-39f4-91af-be7c6ca34748",
                                        "entry_id": "c95ec539-12c6-3f91-abbb-17bd71cd2210",
                                        "glosses": [
                                            "Région d’Europe qui était occupée par les Germains."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82835464-a13a-410e-9439-f49c045835b9",
                                                "sense_id": "1777d934-fe7e-39f4-91af-be7c6ca34748",
                                                "text": "C’est qu’autrefois cette pierre fut effectivement la première église chrétienne bâtie sur les bords du Rhin par un chef de la Germanie, qui mourut en odeur de sainteté, […]. C’était le temps des grandes migrations barbares."
                                            },
                                            {
                                                "example_id": "e296b664-74f2-4b66-a530-038b88405106",
                                                "sense_id": "1777d934-fe7e-39f4-91af-be7c6ca34748",
                                                "text": "Hilperik, profitant de l’absence de son frère Sighebert, qui guerroyait en Germanie, attaqua Reims à l’improviste, et s’empara de cette ville, ainsi que de plusieurs autres également à sa portée."
                                            },
                                            {
                                                "example_id": "378fb671-f932-4f4a-bcf6-b1c3be3efa7e",
                                                "sense_id": "1777d934-fe7e-39f4-91af-be7c6ca34748",
                                                "text": "Dès l’Antiquité, on s’est tapé la cloche avec cette grosse carotte blanche, l’Empereur romain Tibère la faisant importer de Germanie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5800621-bf51-3386-b109-59bb484c5acc",
                                        "entry_id": "c95ec539-12c6-3f91-abbb-17bd71cd2210",
                                        "glosses": [
                                            "Allemagne."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07682b14-ea47-4440-a75a-11b4a52d7113",
                                                "sense_id": "f5800621-bf51-3386-b109-59bb484c5acc",
                                                "text": "Il offrait le type des enfants de cette pure et noble Germanie, si fertile en caractères honorables, et dont les paisibles mœurs ne se sont jamais démenties, même après sept invasions."
                                            },
                                            {
                                                "example_id": "e148c5b3-feed-483b-975b-ec5301f00a95",
                                                "sense_id": "f5800621-bf51-3386-b109-59bb484c5acc",
                                                "text": "Madame Théodora-Marguerite-Wilhemine Adolphus (de la maison Adolphus et compagnie de Mannheim), veuve du baron d’Aldriger, n’était pas une bonne grosse Allemande, compacte et réfléchie, blanche à visage doré comme la mousse d’un pot de bière, enrichie de toutes les vertus patriarcales que la Germanie possède, romancièrement parlant."
                                            },
                                            {
                                                "example_id": "412a966f-b46e-460d-8d0e-1440c74ae953",
                                                "sense_id": "f5800621-bf51-3386-b109-59bb484c5acc",
                                                "text": "Tout comme ses autres copains mon père\nS’en revenait de Germanie\nQuand on leur a dit les p’tits pères\nFaut nous faire d’la démographie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
