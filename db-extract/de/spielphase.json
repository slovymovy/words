                "senses": [
                    {
                        "sense_id": "7707c1ed-e24a-3bd8-9b60-625aa9a70152",
                        "entry_id": "24f38b69-6ecf-384b-bce3-faae70d136aa",
                        "glosses": [
                            "zeitlicher und organisatorischer Abschnitt im Rahmen eines Spiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc116e55-f8d2-4d07-b9d1-8daa07ca5f02",
                                "sense_id": "7707c1ed-e24a-3bd8-9b60-625aa9a70152",
                                "text": "„Erstaunlicherweise sind zum Beispiel eingespielte Sportgruppen in Freizeitsituationen am Strand oder auf Spielwiesen manchmal nur unter großen Schwierigkeiten dazu imstande, eine längere Spielphase gemeinsam zu gestalten, ohne daß ein Leiter eingreift.“"
                            },
                            {
                                "example_id": "abcb0c23-7d2e-4746-ab9d-a33974e9e6d4",
                                "sense_id": "7707c1ed-e24a-3bd8-9b60-625aa9a70152",
                                "text": "„Bei Wettspielen werden über Regeln Begrenzungen eingeführt, die eine Spielphase nach einer bestimmten Zeit (wie beim Fußball), nach Erreichen einer bestimmten Punktzahl (wie beim Tennis) oder nach Erfüllen des Spielgedankens (wie beim Schach) beenden.“"
                            },
                            {
                                "example_id": "b6fcd0cc-79bf-4bad-b3b9-d57377bb349a",
                                "sense_id": "7707c1ed-e24a-3bd8-9b60-625aa9a70152",
                                "text": "„Beim SV Werder Bremen nutzt Trainer Otto Rehagel virtuos die Möglichkeit, Auswechselspieler als Joker einzusetzen, um den Gegner in der entscheidenden Spielphase zu verwirren.“"
                            },
                            {
                                "example_id": "e055175f-2960-4fdd-9e98-41702ec3e68c",
                                "sense_id": "7707c1ed-e24a-3bd8-9b60-625aa9a70152",
                                "text": "„Bundestrainer Joachim Löw hat sich in der Hosen-Affäre selbstkritisch gezeigt und will künftig auch in stressigen Spielphasen noch bewusster auf sein Verhalten am Spielfeldrand achten.“"
                            },
                            {
                                "example_id": "86c1e945-0f27-454a-888c-7e997a89145e",
                                "sense_id": "7707c1ed-e24a-3bd8-9b60-625aa9a70152",
                                "text": "„Für Fernandes kommt es in erster Linie darauf an, die richtige Balance zwischen jenen Spielphasen zu finden, in denen wir das Heft in die Hand nehmen und solchen, in denen wir abwartender agieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
