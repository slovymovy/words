                    ]
                },
                {
                    "sense_id": "e7f51d7e-ae6c-3e11-9580-3bea15b0272a",
                    "sense_definition": "Réprimander quelqu'un avec virulence ou lui infliger des coups violents.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le patron l'a copieusement <w>assaisonné</w> après avoir découvert les nombreuses erreurs dans son rapport."
                        },
                        {
                            "text": "Si tu continues tes bêtises, tes parents vont t'<w>assaisonner</w> en rentrant à la maison."
