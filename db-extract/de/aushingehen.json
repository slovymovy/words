                        ],
                        "examples": [
                            {
                                "example_id": "a421bc64-c034-425e-b9dc-091a2e4e5d9e",
                                "sense_id": "c85d6541-7646-30bb-bd58-2f5a21850638",
                                "text": "„Do hockens den ganzn Dog am Computer und daan Mord & Totschlag spieln, anstatt dass amol an de frische Luft aussegeh daadn!“"
                            },
                            {
                                "example_id": "e30c8131-5aeb-4d83-b288-a8f4ca841028",
                                "sense_id": "c85d6541-7646-30bb-bd58-2f5a21850638",
                                "text": "„Und in anan Dog hand d'Leit in d' Kircha kemma und da Pforra hot predigt und wia d'Kircha ausgwen is, hand d'Leit owei net aus da Kircha auseganga, und dem Mesna is as Soacha scho so nout gwen.“"
                            },
                            {
                                "example_id": "cc050a31-6e44-423d-9e92-874b3c6297b9",
                                "sense_id": "c85d6541-7646-30bb-bd58-2f5a21850638",
                                "text": "„Ganz leise muaß i aussegeh’ – schlaf guat, mein Kind, und tram’ recht sche!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
