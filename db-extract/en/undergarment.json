                    {
                        "translation_id": "3e59abff-d672-468e-a838-5b8d9ca2f650",
                        "source_entry_id": "1191b56b-be2b-36d9-a09b-9a35f71457ae",
                        "source_sense_description": "any garment worn underneath others",
                        "target_lang_word": "sous-vêtement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-vêtement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8277075c-9f46-3695-88f6-d3153814c0a0",
                                        "entry_id": "d753501a-e658-3f4e-b1e4-a2e559bafef1",
                                        "glosses": [
                                            "Linge couvrant du buste aux cuisses et se portant à même la peau sous les vêtements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac7606fe-1e0b-4f96-bfcc-8ea39e6ceae2",
                                                "sense_id": "8277075c-9f46-3695-88f6-d3153814c0a0",
                                                "text": "Vanessa ignorait ce qu'était un string en V ou un tanga. Elle achetait ses sous-vêtements en coton Hanes Her Way et ses marcels chez Rite Aid et n'avait jamais mis un pied dans une boutique Victoria's Secret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c258fe0-2f52-4329-9641-f50f96c32ada",
                        "source_entry_id": "1191b56b-be2b-36d9-a09b-9a35f71457ae",
                        "source_sense_description": "any garment worn underneath others",
                        "target_lang_word": "Unterwäsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterwäsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec078b89-21a0-3204-9229-94f01a4cf24c",
                                        "entry_id": "81a1fc31-4e2a-39b4-bd9e-7e03e87b4ef7",
                                        "glosses": [
                                            "Wäsche, die unter der Oberbekleidung direkt auf der Haut getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c075d5a-0b4b-4062-b1f4-5074dc320987",
                                                "sense_id": "ec078b89-21a0-3204-9229-94f01a4cf24c",
                                                "text": "Sie half ihm schweigend wie eine Kameradin seine Sachen zusammenpacken, achtete darauf, daß er genügend warme Unterwäsche mitnahm, und als er sich marschbereit zur Tür wandte, ohne ihr die Hand zu reichen, mit einem Kopfnicken bloß, lächelte sie mit brüchigen Lippen."
                                            },
                                            {
                                                "example_id": "6f404c81-f84e-4071-8b59-fc28642a57d7",
                                                "sense_id": "ec078b89-21a0-3204-9229-94f01a4cf24c",
                                                "text": "Seine Mutter sei empört über eine Werbekampagne, die ihn in knapper Unterwäsche zeigt, gestand David Beckham in einer amerikanischen Talk-Show."
                                            },
                                            {
                                                "example_id": "b2eee47c-4b41-4f11-b752-de224b3fb9db",
                                                "sense_id": "ec078b89-21a0-3204-9229-94f01a4cf24c",
                                                "text": "„Ich habe mir sagen lassen, dass im Grunde nur dann die Reizwäsche drunter getragen wird, wenn sich im Vorfeld schon erahnen lässt, dass man am Abend nicht die einzige Person sein könnte, die die eigene Unterwäsche sieht.“"
                                            },
                                            {
                                                "example_id": "022b67e6-6bd2-4b73-a68a-e7060b9bf4c6",
                                                "sense_id": "ec078b89-21a0-3204-9229-94f01a4cf24c",
                                                "text": "„Sie lehnten es ab, Unterwäsche zu tragen, angeblich weil die sie einengte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d704d8b-98a2-48d6-8b8c-1bca7fa98709",
