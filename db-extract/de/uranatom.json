                "senses": [
                    {
                        "sense_id": "27b53dd8-0102-3199-8111-ce4e49014432",
                        "entry_id": "b6e3c9ab-f70c-306b-825e-bad21fe0c2ab",
                        "glosses": [
                            "Atome d’uranium."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "1fe5d0f9-ae1e-4849-8d14-af1fea3751dd",
                                "sense_id": "27b53dd8-0102-3199-8111-ce4e49014432",
                                "text": "Das Uranatom hat im Kern 92 Protonen und 143 Neutronen.",
                                "translation": "L’atome d’uranium a en son noyau 92 protons et 143 neutrons."
                            },
                            {
                                "example_id": "53a1fcd2-9d61-4f2d-abee-c66534ac0d87",
                                "sense_id": "27b53dd8-0102-3199-8111-ce4e49014432",
                                "text": "Durch die Untersuchungen von Otto Hahn und seinen Mitarbeitern ist festgestellt worden, daß ein Uranatom, welches von einem Neutron beschossen wird, sich in mehrere Stücke spaltet.",
                                "translation": "Il a été découvert, grâce aux expériences d’Otto Hahn et de ses collaborateurs, qu’un atome d’uranium bombardé par un neutron se scinde en plusieurs morceaux."
                            },
                            {
                                "example_id": "070a5039-3494-44d9-bea2-b15a5c2a4c8f",
                                "sense_id": "27b53dd8-0102-3199-8111-ce4e49014432",
                                "text": "Uranatome sind instabil und emittieren Partikel, die sich mit einem Geigerzähler nachweisen lassen.",
                                "translation": "Les atomes d’uranium sont instables et émettent des particules qui sont détectables par un compteur Geiger."
                            }
                        ]
                    }
                ],
