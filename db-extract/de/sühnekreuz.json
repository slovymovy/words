                ],
                "senses": [
                    {
                        "sense_id": "6fd4b801-0ded-30e8-9950-093619154606",
                        "entry_id": "774dd3f3-6985-3499-9c55-ba297e0d0d65",
                        "glosses": [
                            "inschriftloses Steinkreuz, das im Rahmen mittelalterlicher Rechtssprechung von einem Mörder zum Gedenken an den Getöteten aufgestellt werden musste; oft mit Abbildung der Mordwaffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34a4e71f-a95f-4923-9dfd-a480e08602b8",
                                "sense_id": "6fd4b801-0ded-30e8-9950-093619154606",
                                "text": "„Die Sühnekreuze sind mehrheitlich in Kreuzform gestaltet.“"
                            },
                            {
                                "example_id": "51ed6b6c-61f9-4df0-9e7f-53a65a71dd40",
                                "sense_id": "6fd4b801-0ded-30e8-9950-093619154606",
                                "text": "„Der überwiegende Teil der Sühnekreuze ist in Kreuzform gestaltet, oftmals ist die Mordwaffe bzw. ein berufstypisches Gerät des Entleibten in den Stein gehauen.“"
                            },
                            {
                                "example_id": "405d4fa4-cdc6-471c-9ad9-55f601db99ef",
                                "sense_id": "6fd4b801-0ded-30e8-9950-093619154606",
                                "text": "„Häufig wurde die Mordwaffe auf dem Kreuz dargestellt oder etwas berufstypisches des Getöteten, so unter anderem ein Zimmermannsbeil auf dem Sühnekreuz von Rödermark-Urberach, Häfnerplatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8d5927c7-5f98-3de3-882d-c0ee22e3c7d0",
                        "entry_id": "774dd3f3-6985-3499-9c55-ba297e0d0d65",
                        "glosses": [
                            "zum Andenken an durch Unglücksfälle zu Tode Gekommene errichtetes Kreuz aus Stein"
                        ],
