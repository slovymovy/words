{
    "word_family": [
        "notabilité",
        "notablement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ec53a76c-ddf8-3473-8cc4-bf149123e548",
                    "sense_definition": "Qui est digne d'être remarqué ou qui présente une importance quantitative ou qualitative certaine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis plusieurs semaines, nous constatons une amélioration <w>notable</w> de la situation financière de l'entreprise."
                        },
                        {
                            "text": "Le vote a été unanime, à l'exception <w>notable</w> du représentant de l'opposition."
                        }
                    ],
                    "synonyms": [
                        "remarquable",
                        "sensible",
                        "appréciable",
                        "important"
                    ],
                    "antonyms": [
                        "négligeable",
                        "insignifiant"
                    ],
                    "common_phrases": [
                        "différence notable",
                        "progrès notable",
                        "exception notable"
                    ]
                },
                {
                    "sense_id": "45d9efc2-5cdf-3156-bd93-1496f9437c56",
                    "sense_definition": "Qui se distingue par son rang social, son influence ou son autorité au sein d'une collectivité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs familles <w>notables</w> de la région finançaient autrefois les œuvres de charité communales."
                        },
                        {
                            "text": "Ce magistrat appartenait à une lignée <w>notable</w> très respectée dans toute la province."
                        }
                    ],
                    "synonyms": [
                        "influent",
                        "éminent"
                    ],
                    "antonyms": [
                        "obscur"
                    ],
                    "common_phrases": [
                        "famille notable",
                        "citoyens notables"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "131e4726-cc9f-38a9-868d-e65b1da39e00",
                    "sense_definition": "Personne qui jouit d'une situation sociale éminente et d'une influence reconnue dans un groupe ou une localité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maire a convié tous les <w>notables</w> du village pour discuter du projet d'aménagement."
                        },
                        {
                            "text": "Au XIXe siècle, les <w>notables</w> locaux exerçaient un pouvoir décisif sur la politique du département."
                        }
                    ],
                    "synonyms": [
                        "dignitaire",
                        "personnalité"
                    ],
                    "common_phrases": [
                        "notables locaux",
                        "notables du village",
                        "assemblée des notables"
                    ]
                }
            ]
        }
    ]
}