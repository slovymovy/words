                ],
                "senses": [
                    {
                        "sense_id": "cb26676a-be6e-32f6-be89-7151a39fcbaa",
                        "entry_id": "5cb94a8f-ebc3-3db6-8fef-9f8fbd055a0c",
                        "glosses": [
                            "Reinigungsverfahren, um Rohprodukte und -präparate durch Auflösen und anschließendes Wiederauskristallisieren in reinere Endprodukte zu überführen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b8b00cc-7207-4fcf-ad36-205d4593ee18",
                                "sense_id": "cb26676a-be6e-32f6-be89-7151a39fcbaa",
                                "text": "„Die Wahl des Lösungsmittels bestimmt durch die Löslichkeit der Zielverbindung sowie der Verunreinigungen den Grad der Reinigung, sodass die Umkristallisation ggf. mehrfach durchgeführt werden muss.“"
                            },
                            {
                                "example_id": "3f581e37-4aef-4241-9569-0e7728231b6a",
                                "sense_id": "cb26676a-be6e-32f6-be89-7151a39fcbaa",
                                "text": "„Bei besonders problematischen Umkristallisationen ist es ratsam, die Trichter vorzuwärmen bzw. sich heizbarer Trichter oder Nutschen zu bedienen.“"
                            },
                            {
                                "example_id": "e7cf97b3-cf76-4d9a-9d4b-53c7adeee6eb",
                                "sense_id": "cb26676a-be6e-32f6-be89-7151a39fcbaa",
                                "text": "„Ist die Mischung bei der Umkristallisation zu heiß, kann sie nur in flüssiger Form ausfallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d26c8295-ba18-37ff-8ba4-6bff87ce402c",
                        "entry_id": "5cb94a8f-ebc3-3db6-8fef-9f8fbd055a0c",
                        "glosses": [
                            "Änderung der Kristallstruktur durch äußere Faktoren wie Druck und Temperatur"
                        ],
                        "tags": [
