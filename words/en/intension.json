                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The natural volume of the storm altered with the <w>intension</w> of the wind."
                        },
                        {
                            "text": "Scholars noted a gradual <w>intension</w> of feeling as the speech progressed."
                        }
                    ],
                    "synonyms": [
