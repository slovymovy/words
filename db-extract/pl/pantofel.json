                                                "example_id": "b206d347-3dd9-4c9a-bdc2-ceac0af35287",
                                                "sense_id": "ee0d4f59-16c0-3fb0-bb7e-59ce8cff4bf6",
                                                "text": "O! trustless state of earthly things, and slipper hope / Of mortal men."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slipper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cb9f8d4-0d0a-3837-ad9f-b661b4bd9d3e",
                                        "entry_id": "d593b330-65e1-3af7-9ace-4cce1aadf896",
                                        "glosses": [
                                            "To spank with a plimsoll as corporal punishment."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ee4c48-b7fe-43cb-ba38-6d34573af834",
                                                "sense_id": "0cb9f8d4-0d0a-3837-ad9f-b661b4bd9d3e",
                                                "text": "1981, Andrew Loudon, Staffroom mole leaks secret of his school's beatings book, Daily Mail and General Trust, World Corporal Punishment Research\n\"One boy was slippered five times in four days for offences such as missing detention, fooling about and being out of bounds.\""
                                            }
                                        ]
