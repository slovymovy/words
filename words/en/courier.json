                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, происходящая от названия профессии.",
                        "zh": "源于职业名称的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Курье",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "库里耶",
