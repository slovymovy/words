                                        "glosses": [
                                            "Of property: able to pass by descent; inheritable by heirs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38f272ca-afe1-41fb-b2fc-84c7bb9b43c8",
                                                "sense_id": "6b1a6147-a06b-3507-9dac-49f64c36eafa",
                                                "text": "The rights of men in ſociety, are neither deviſeable, nor transferable, nor annihilable, but are deſcendable only; and it is not in the power of any generation to intercept finally, and cut off the deſcent."
                                            }
                                        ]
