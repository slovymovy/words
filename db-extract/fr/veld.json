            {
                "entry_id": "67125d1c-55f6-35ff-81fa-2556c9673fe4",
                "word": "veld",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "195bd541-fca3-3cc4-a929-2fd64ac5c2ec",
                        "entry_id": "67125d1c-55f6-35ff-81fa-2556c9673fe4",
                        "glosses": [
                            "Veld"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc669795-e59e-4938-a036-2ad6d34630a3",
                        "source_entry_id": "67125d1c-55f6-35ff-81fa-2556c9673fe4",
                        "source_sense_id": "195bd541-fca3-3cc4-a929-2fd64ac5c2ec",
                        "source_sense_description": "Geografie: Veld",
                        "target_lang_word": "Veld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Veld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                        "entry_id": "95a97b98-59f7-3003-9c03-112cc8d96532",
                                        "glosses": [
                                            "sich weit erstreckende, naturbelassene (da zumeist nicht kultivierbare), überschaubare steppenartige Landschaft"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b64ba9a-21a4-4e2c-85f9-8dfccadf8ddd",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„Manch einsamer Grabstein steht aus jener Zeit im schattigen Rivier, unter steilen Felsen, im stillen Veld.“"
                                            },
                                            {
                                                "example_id": "f6da2742-1583-4857-9dfb-a7735fbebe58",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„Die Wolken nahmen immer neuen Ablauf. Leicht wie Meerschaum rollten ihre Schatten übers Veld.“"
                                            },
                                            {
                                                "example_id": "00ec811c-6c33-4b0a-bf52-2cc4d4e0202c",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„Andere wiederum konnten es sich leisten, teure Velden innerhalb des Diamanten-Sperrgebietes anzumieten.“"
                                            },
                                            {
                                                "example_id": "d7bcf922-99af-44fc-9abc-6018b3ad1e95",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„Für die Kunsthistoriker[i]n sind 42 Äpfel in sechs Reihen ‚offenbar eine Reminiszenz an Angola‘, denn hier auf dem Veld, so heißt auf afrikaans nicht kultivierbares Land, wachsen bloß Dornenbüsche und Akazien.“"
                                            },
                                            {
                                                "example_id": "15b7d31a-582a-4ab7-bb4a-548bde5d7e8e",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„Worcester ist ein Ort im Veld, der Grassteppe, zirka 140 Kilometer von Kapstadt entfernt.“"
                                            },
                                            {
                                                "example_id": "8dd996d3-ac6b-468e-98f5-13cdfa47f158",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„Über so ein grenzenloses Veld ist Nico als Junge mit Feuereifer und Steinschleuder gelaufen, wenn er bei seinem Großvater in Natal zu Besuch war.“"
                                            },
                                            {
                                                "example_id": "276ff125-f89b-40dd-aeb6-58075272517a",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„Theron: ‚Wenige Tage nach unserer Ankunft nahmen uns Wildhüter auf eine Nachttour über das Veld, die südafrikanische Savanne, mit.[…]‘“"
                                            },
                                            {
                                                "example_id": "92c1749d-bedf-4326-b89c-d3cbe7d166b1",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„Sie bauen Hütten aus Ästen und Gras zu ihrem Schutz, gehen auf die Jagd, sammeln die nahrhaften Früchte des Veldes und leben in Harmonie mit der Natur.“"
                                            },
                                            {
                                                "example_id": "f683688a-1a6f-414d-9dc5-8c6cc97ae869",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„Nachdem der Elefant auf die Jagd gegangen war, fanden sich nach und nach die restlichen Bewohner des Veldes ein: Giraffe, Gnu, Eland, Gemsbock, Springbock, Ducker, Hase sowie all die anderen Tiere.“"
                                            },
                                            {
                                                "example_id": "83af6c48-a0c9-42b7-84cb-c61312470d85",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„Auf verschiedenen Farmen seien im Veld zahlreiche Wertsachen vergraben worden, welches die Verbrecher zu einem späteren Zeitpunkt holen wollten.“"
                                            },
                                            {
                                                "example_id": "4bf4ea7d-9880-4cdd-8cc1-0c435cddd208",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„‚Ich bin fasziniert von der Natur. Ich fühle mich da draußen zu Hause‘, sagt er. ‚Ich habe 80 Prozent meiner Kindheit im Veld verbracht.‘ […] Wie viel Deon Meyer weiß über Geographie, Geschichte, Politik und Natur, merkt man im ‚Veld‘ genauso, wie wenn er 1500 Kilometer südlich von Moholoholo am Ende des Kontinents auf dem Tafelberg steht und zeigt, auf welchem Hügel welche Schlachten stattfanden, um sogleich Klima und Geologie zu erläutern.“"
                                            },
                                            {
                                                "example_id": "dba730f8-0eb8-4980-a1c2-fe052e93891a",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„Wenn man im südafrikanischen Veld einem Weißen begegnet, und dieser Weiße trägt Strümpfe in seinen Veldskoens, dann kann es sich nur um einen Engländer handeln.“"
                                            },
                                            {
                                                "example_id": "2665eacf-423c-41d8-a546-61fd27cb54a3",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„Wie hatte er ihr vorgeschwärmt von den gelben Savannen und der roten Erde des Velds, von den grünen Hügeln, in deren Mopanewäldern er Elefanten und die seltenen Weißschwanzgnus ansiedeln wollte, mit welchen Worten hatte er ihr den Sonnenuntergang am Stausee geschildert, in dem er in seinen Vorstellungen schon Krokodile und Flusspferde schwimmen sah.“"
                                            },
                                            {
                                                "example_id": "476475b3-17f7-42dc-a3b7-4ac933038dde",
                                                "sense_id": "15507a7b-0fb6-37f1-bdff-175431c227e5",
                                                "text": "„Kaum das es ein wenig geregnet hat, verwandeln sich die sonst so trockenen Velder in einen grünen Teppich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
