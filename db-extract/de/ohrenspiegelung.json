                "senses": [
                    {
                        "sense_id": "f300f063-c92f-30da-88df-10ad1942bcf7",
                        "entry_id": "be5dd2a7-38a2-3b4b-92f3-36010bb2665d",
                        "glosses": [
                            "„Betrachtung des äußeren Gehörganges und des Trommelfells“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46edf32a-67c7-474c-80ef-9d2a0fafd846",
                                "sense_id": "f300f063-c92f-30da-88df-10ad1942bcf7",
                                "text": "„Ich werde bei Ihrer Tochter zunächst eine Otoskopie, eine Ohrenspiegelung, vornehmen.“"
                            },
                            {
                                "example_id": "375744d9-a851-4180-8935-997882fac37b",
                                "sense_id": "f300f063-c92f-30da-88df-10ad1942bcf7",
                                "text": "„Bei der Ohrenspiegelung kann man davon nur das Trommelfell und den durchscheinenden Hammergriff sehen.“"
                            },
                            {
                                "example_id": "4949cc0b-04b0-4972-88a5-c9f2b1839366",
                                "sense_id": "f300f063-c92f-30da-88df-10ad1942bcf7",
                                "text": "„Mit dem Stethoskop horchte er auf Herztöne und Lungengeräusche, nahm eine Ohrenspiegelung und eine gründliche Inspektion des Mundes und des Rachens vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
