                        "source_sense_id": "b61482da-427c-391b-83a7-1e503b1ec08e",
                        "source_sense_description": "een doorgaans dunne speld waarmee het haar kan worden opgestoken.",
                        "target_lang_word": "Haarnadel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haarnadel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6f22a9c-a253-32f9-992c-ef794baed8c7",
                                        "entry_id": "1a1979e8-105c-3aee-b578-0b2fc57b6c30",
                                        "glosses": [
                                            "meist metallener, gebogener Gegenstand zum Feststecken von Haarfrisuren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3428297d-9d4f-4f66-957d-ff1adb607c72",
                                                "sense_id": "b6f22a9c-a253-32f9-992c-ef794baed8c7",
                                                "text": "„So werde die Haarnadel zum Dolche!“"
                                            },
                                            {
                                                "example_id": "ac7dbf4a-6eb6-46f0-b5e3-c5f845311add",
                                                "sense_id": "b6f22a9c-a253-32f9-992c-ef794baed8c7",
                                                "text": "„Max sammelte die hinuntergefallenen Haarnadeln auf.“"
                                            },
                                            {
                                                "example_id": "fbd65e6d-4eca-4dff-8b27-dfd20d35750a",
                                                "sense_id": "b6f22a9c-a253-32f9-992c-ef794baed8c7",
                                                "text": "„Er fuchtelte mit den Haarnadeln seiner Frau vor dem Gesicht der Stationsschwester herum, gelblicher Schaum stand in seinen Mundwinkeln.“"
                                            },
                                            {
                                                "example_id": "155c7372-5f81-4bb5-b4e2-13f80e6c7131",
                                                "sense_id": "b6f22a9c-a253-32f9-992c-ef794baed8c7",
                                                "text": "„Schließlich riß er ihn mit einer vergessenen Haarnadel, die neben ihm auf einem Sessel gelegen hatte, auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "339ff361-5e08-3abb-ae27-53254ff0fdce",
                                        "entry_id": "1a1979e8-105c-3aee-b578-0b2fc57b6c30",
                                        "glosses": [
                                            "Torkombination im Slalom"
                                        ],
                                        "tags": [
                                            "Schisport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f80e100-8b45-4557-8cd5-30a80984c485",
                                                "sense_id": "339ff361-5e08-3abb-ae27-53254ff0fdce",
                                                "text": "Um Zeit zu sparen, fuhr er die Haarnadel verkehrt ein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
