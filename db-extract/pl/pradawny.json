                        "examples": [
                            {
                                "example_id": "bd6bc302-24b4-4bc6-a90d-5ebd478bf9fa",
                                "sense_id": "44e94851-300d-3df1-a332-7d81f113f703",
                                "text": "Chodziło, jak wyjaśniła dziewczyna, o pradawny pogański obrzęd wywoływania duchów, potępiony przez głowę katolickiego kościoła i ścigany przez Święte Oficjum"
                            }
