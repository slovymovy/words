                        "entry_id": "44493dd9-0c2b-3e7d-a5b1-c82873b62c5f",
                        "glosses": [
                            "Qui représente une personne à cheval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3949612-e0de-4429-9f38-c1f5840c6527",
                                "sense_id": "6075b9aa-cd78-31ef-912f-b0acd7f5d17b",
                                "text": "Mais on peut diviser commodément les statues antiques en pédestres , équestres , & curules, c'est à dire, à pié, à cheval, & en char."
                            },
                            {
                                "example_id": "7c4c4b5b-35da-470f-8a33-a307441e4a6c",
                                "sense_id": "6075b9aa-cd78-31ef-912f-b0acd7f5d17b",
                                "text": "Je cherchai vainement au-dessus de son portail la statue équestre de Louis XII."
                            }
                        ]
                    },
                    {
                        "sense_id": "c779e6fa-58c4-3668-840b-f1f04f55cff2",
                        "entry_id": "44493dd9-0c2b-3e7d-a5b1-c82873b62c5f",
                        "glosses": [
                            "Qui concerne l’ordre des chevaliers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46555df2-7e91-4b31-827a-b91d29f350b1",
                                "sense_id": "c779e6fa-58c4-3668-840b-f1f04f55cff2",
                                "text": "L’ordre équestre de Rome, de Pologne."
                            }
                        ]
                    },
                    {
                        "sense_id": "70c52ebb-3a75-3d6b-9376-c36a645d4f17",
