{
    "word_family": [
        "demande",
        "demandeur",
        "demandeuse",
        "redemander"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "447a2174-c75f-36f7-95bb-4ef7a5ab3fd9",
                    "sense_definition": "Chercher à obtenir une information ou une réponse en interrogeant quelqu'un.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interroger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le touriste s'arrête pour <w>demander</w> son chemin à un passant."
                        },
                        {
                            "text": "L'enfant lève la main pour <w>demander</w> l'heure exacte au professeur."
                        }
                    ],
                    "synonyms": [
                        "interroger",
                        "questionner"
                    ],
                    "antonyms": [
                        "répondre"
                    ],
                    "common_phrases": [
                        "demander son chemin",
                        "demander des nouvelles"
                    ]
                },
                {
                    "sense_id": "45468b5f-67de-31e7-8734-ee5646f8c115",
                    "sense_definition": "Exprimer à quelqu'un le souhait d'obtenir un objet, un service ou une action.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "solliciter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'hésite jamais à <w>demander</w> de l'aide quand un exercice est trop difficile."
                        },
                        {
                            "text": "Les clients <w>demandent</w> l'addition avant de quitter la table du restaurant."
                        }
                    ],
                    "synonyms": [
                        "prier",
                        "réclamer",
                        "solliciter"
                    ],
                    "antonyms": [
                        "donner",
                        "offrir",
                        "refuser"
                    ],
                    "common_phrases": [
                        "demander pardon",
                        "demander la permission"
                    ]
                },
                {
                    "sense_id": "75fc3667-bd07-33bf-b8ed-2e496ed6dc98",
                    "sense_definition": "S'interroger intérieurement sur quelque chose, douter ou réfléchir à un sujet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reflexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me <w>demande</w> souvent si nous avons pris la bonne décision."
                        },
                        {
                            "text": "Elle regarde le ciel gris et se <w>demande</w> s'il va pleuvoir aujourd'hui."
                        }
                    ],
                    "synonyms": [
                        "hésiter",
                        "s'interroger"
                    ],
                    "common_phrases": [
                        "se demander pourquoi",
                        "se demander si"
                    ]
                },
                {
                    "sense_id": "b490cab5-7ee3-3b26-a174-1ac2f688960a",
                    "sense_definition": "Chercher à joindre une personne ou vouloir lui parler.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chercher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La secrétaire annonce à son collègue qu'un client le <w>demande</w> au téléphone."
                        },
                        {
                            "text": "Une personne patiente à l'entrée et <w>demande</w> à voir le responsable du magasin."
                        }
                    ],
                    "synonyms": [
                        "chercher",
                        "réclamer"
                    ],
                    "common_phrases": [
                        "demander au téléphone",
                        "demander à voir"
                    ]
                },
                {
                    "sense_id": "e182f99a-6231-3207-ae6a-2f22a15deffe",
                    "sense_definition": "Avoir besoin de quelque chose, exiger des ressources ou des efforts particuliers.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exiger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'apprentissage d'une langue étrangère <w>demande</w> du temps et une pratique régulière."
                        },
                        {
                            "text": "Ce projet complexe <w>demandera</w> une grande rigueur de la part de toute l'équipe."
                        }
                    ],
                    "synonyms": [
                        "exiger",
                        "nécessiter",
                        "requérir"
                    ],
                    "common_phrases": [
                        "demander du temps",
                        "demander des efforts"
                    ]
                },
                {
                    "sense_id": "7e7ac707-30a0-3217-bdf8-83c9d4bafa77",
                    "sense_definition": "Proposer à quelqu'un de s'unir par les liens du mariage.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "mariage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a profité de ce voyage romantique pour la <w>demander</w> en mariage."
                        },
                        {
                            "text": "Dans les traditions anciennes, le prétendant devait <w>demander</w> sa main au père de la mariée."
                        }
                    ],
                    "common_phrases": [
                        "demander en mariage",
                        "demander sa main"
                    ]
                }
            ]
        }
    ]
}