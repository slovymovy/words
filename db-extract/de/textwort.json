                "senses": [
                    {
                        "sense_id": "629d0f08-faf0-3799-a408-c8ce02581dee",
                        "entry_id": "f75eef79-2965-3aaf-8af1-9fe293bfe418",
                        "glosses": [
                            "Wort im Text"
                        ],
                        "tags": [
                            "vorwiegend Plural 1"
                        ],
                        "examples": [
                            {
                                "example_id": "1fcaafe1-6267-47f4-b485-2c4f523cc07c",
                                "sense_id": "629d0f08-faf0-3799-a408-c8ce02581dee",
                                "text": "„Bei »Wort« soll immer ein Wort im Text verstanden werden, weshalb dafür auch Textwort gesagt wird.“"
                            },
                            {
                                "example_id": "1fa966ec-20b3-46b7-9be4-1c96472a04d7",
                                "sense_id": "629d0f08-faf0-3799-a408-c8ce02581dee",
                                "text": "„Es ist festzulegen, ob das Wort als Textwort oder als Element des Systems definiert werden soll.“"
                            },
                            {
                                "example_id": "d428b025-396a-4ac8-8b8d-d37dee12742f",
                                "sense_id": "629d0f08-faf0-3799-a408-c8ce02581dee",
                                "text": "„Wörter existieren als System- und Textwort.“"
                            },
                            {
                                "example_id": "eaaa4a37-0bcc-4bc9-8177-6bd4760621ff",
                                "sense_id": "629d0f08-faf0-3799-a408-c8ce02581dee",
                                "text": "„Der zweite wichtige Faktor, den man bei der Korpuszusammenstellung berücksichtigen muss, ist das Anwachsen der Lexemzahl mit zunehmender Anzahl von Textwörtern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "307ac6a8-5928-3af3-80d7-88b358413177",
                        "entry_id": "f75eef79-2965-3aaf-8af1-9fe293bfe418",
                        "glosses": [
                            "Stelle in der Bibel"
                        ],
                        "tags": [
                            "Theologie",
                            "vorwiegend Plural 2"
                        ],
                        "examples": [
                            {
                                "example_id": "80349454-0949-4a03-8a12-a213d4ec952a",
                                "sense_id": "307ac6a8-5928-3af3-80d7-88b358413177",
                                "text": "„‚Denn alles, was von Gott geboren ist, überwindet die Welt; und unser Glaube ist der Sieg, der die Welt überwunden hat‘ (1. Johannes 5, 4). Mit diesem Textwort diente Bischof Michael Eberle am Mittwoch, dem 08. Juni 2009, den Geschwistern in der Gemeinde Bad Eilsen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
