                "senses": [
                    {
                        "sense_id": "5f2d3af9-9cc0-3dbf-b8e2-4cb2bf7199c4",
                        "entry_id": "6da25ede-939a-3f58-a79f-566d99cccde5",
                        "glosses": [
                            "eine Burg, die speziell für Ritter gebaut wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc0d4e16-1ece-4964-ad23-9f939d6c49d9",
                                "sense_id": "5f2d3af9-9cc0-3dbf-b8e2-4cb2bf7199c4",
                                "text": "Die Familie lebte auf einer mittelalterlichen Ritterburg."
                            },
                            {
                                "example_id": "53c9e962-d324-4150-90ab-12de59c8b658",
                                "sense_id": "5f2d3af9-9cc0-3dbf-b8e2-4cb2bf7199c4",
                                "text": "„Da hat er gesagt, dass der Hunger schon noch kommen werde, und damit er auch richtig komme, wollten wir vor dem Abendessen noch auf die Höhe gehen, denn oberhalb von Kobern-Gondorf gebe es eine Ritterburg, die wir uns anschauen sollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
