                "senses": [
                    {
                        "sense_id": "cb3d9c9c-8ad4-3c2f-8ac9-19b2ac8181ec",
                        "entry_id": "68a06b8a-2aae-3b38-82b9-283cd834286e",
                        "glosses": [
                            "vor allem aus west- und zentralnorwegischen Dialekten konstruierte Sprachvarietät der norwegischen Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b24a4c7d-8c67-4b1d-a47b-a3ed7e7484a1",
                                "sense_id": "cb3d9c9c-8ad4-3c2f-8ac9-19b2ac8181ec",
                                "text": "Vor allem im Südwesten Norwegens ist Neunorwegisch verbreitet."
                            },
                            {
                                "example_id": "7468cf21-1dc9-435c-818d-5c3cf5c646c2",
                                "sense_id": "cb3d9c9c-8ad4-3c2f-8ac9-19b2ac8181ec",
                                "text": "„Ein Viertel der Beiträge in Radio und Fernsehen werden in Neunorwegisch abgefasst und es gibt manchmal Streit darüber, welche Sendungen in welcher Sprache produziert werden sollen.“"
                            },
                            {
                                "example_id": "6d15ff83-de3f-41af-adbf-b41ebcc814e8",
                                "sense_id": "cb3d9c9c-8ad4-3c2f-8ac9-19b2ac8181ec",
                                "text": "„Lieder auf ‚Bokmal‘ (Buchsprache) und ‚Neunorwegisch‘ vereinen sich in diesem Buch; nur selten steht darin ein Text in beiden Formen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
