                            },
                            {
                                "target_lang_word": "несвежий",
                                "target_lang_sense_clarification": "о состоянии желудка или самочувствии"
                            },
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "о еде или состоянии, внушающем опасение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20288f0d-7b14-3db3-9e30-8337674ad2fb",
                    "sense_definition": "Socially unacceptable, deviant, or weird in a creepy way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighbors complained about the <w>dodgy</w> man who was always hanging around the playground.",
                            "target_lang_translations": {
                                "ru": "Соседи жаловались на <w>подозрительного</w> типа, который постоянно ошивался возле детской площадки."
                            }
                        },
                        {
                            "text": "He has some <w>dodgy</w> habits that make his colleagues feel very uncomfortable in the office.",
                            "target_lang_translations": {
                                "ru": "У него есть кое-какие <w>странные</w> привычки, из-за которых коллеги чувствуют себя в офисе очень неуютно."
                            }
                        }
                    ],
                    "antonyms": [
                        "normal",
                        "conventional"
                    ],
                    "common_phrases": [
