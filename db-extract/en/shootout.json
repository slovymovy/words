                        "entry_id": "cb758b77-00b4-3cbc-b32e-91f6bf103e26",
                        "glosses": [
                            "A multitable poker tournament in which only the last player on a table goes on to the next."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f199d6de-b665-4f5e-b8fd-a34af963cb56",
                                "sense_id": "e759e4d9-b723-3269-b6fb-7791f8473e33",
                                "text": "64 players entered the shooutout tournament, and were divided into eight tables of eight players each. The winner in each table went on to the final table, also consisting of eight players."
                            }
                        ]
                    },
                    {
                        "sense_id": "34f2c9e4-d10b-3413-96cb-5d5a14ccddcf",
