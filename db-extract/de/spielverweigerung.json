                "senses": [
                    {
                        "sense_id": "b6d938bb-1403-346d-89bb-af65c78bc287",
                        "entry_id": "52a2fa39-5280-33c8-a9fd-5a3d4f0d6b03",
                        "glosses": [
                            "Ablehnung einer Spielteilnahme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf539b3-3354-41c5-be34-f2cf6aca5702",
                                "sense_id": "b6d938bb-1403-346d-89bb-af65c78bc287",
                                "text": "„Hämespiele führen, vor allem, wenn sie häufiger gespielt werden, leicht zu Spielverdruss und Spielverweigerung.“"
                            },
                            {
                                "example_id": "cc551037-2f36-44c0-8d87-ad47f3a3e97a",
                                "sense_id": "b6d938bb-1403-346d-89bb-af65c78bc287",
                                "text": "„Tatsächlich war das, was der Deutsche Meister fast eine Hälfte lang bot, nichts anderes als Spielverweigerung.“"
                            },
                            {
                                "example_id": "2e19acc2-4b44-4828-a4a6-5275f9a4390a",
                                "sense_id": "b6d938bb-1403-346d-89bb-af65c78bc287",
                                "text": "„So wie auch die Spielverweigerung nachvollziehbar ist.“"
                            },
                            {
                                "example_id": "cafabee6-1ac7-4893-808b-c9dd0939ae2f",
                                "sense_id": "b6d938bb-1403-346d-89bb-af65c78bc287",
                                "text": "„Der frühere Nationalspieler Lewis Holtby hat seine Spielverweigerung beim Fußball-Zweitligisten Hamburger SV als Kurzschlussreaktion im Affekt entschuldigt.“"
                            },
                            {
                                "example_id": "9b310eaf-cd59-4175-aec5-a193e8c0a58a",
                                "sense_id": "b6d938bb-1403-346d-89bb-af65c78bc287",
                                "text": "„Im Regelwerk der Europäischen Fußball-Union (UEFA) sind die Bestimmungen für eine Spielabsage und/oder Spielverweigerung unter den Artikeln 26 und 27 der Wettkampfordnung für die Champions League zusammengefasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
