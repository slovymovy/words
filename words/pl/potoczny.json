                            },
                            {
                                "target_lang_word": "обиходный",
                                "target_lang_sense_clarification": "используемый в быту, повседневный"
                            },
                            {
                                "target_lang_word": "неформальный",
                                "target_lang_sense_clarification": "неофициальный, свободный от строгих правил"
