                        "cross_references": [
                            {
                                "target_word": "Borgesian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46c9495a-ad0b-30b9-829b-b4fc8a77d2e5",
                                        "entry_id": "0bccf926-962a-3a61-b7c9-8bd6594703cf",
                                        "glosses": [
                                            "Of, pertaining to, or characteristic of Jorge Luis Borges or his writings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b0e8d26-94db-43ce-aba2-aeaf64662fcf",
                                                "sense_id": "46c9495a-ad0b-30b9-829b-b4fc8a77d2e5",
                                                "text": "Stories now tend to be either Chekhovian or Borgesian; only rarely are they both."
                                            },
                                            {
                                                "example_id": "1d4bc5e6-4bd3-45c3-971c-94b68a6d6e8e",
                                                "sense_id": "46c9495a-ad0b-30b9-829b-b4fc8a77d2e5",
                                                "text": "The Borgesian revelation of understanding has not and will not — and, we submit, cannot — occur if machine learning programs like ChatGPT continue to dominate the field of A.I."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
