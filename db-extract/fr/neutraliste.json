                                    {
                                        "sense_id": "880dd86b-8dc3-3de2-bf11-9c1fc7a6e491",
                                        "entry_id": "76d43ef1-64c4-374b-8b2b-cb0f5e55aec2",
                                        "glosses": [
                                            "A nonaligned state, or a member of such a state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0bd9483-82b0-3ac4-8c42-d3bb50d388b7",
                                        "entry_id": "76d43ef1-64c4-374b-8b2b-cb0f5e55aec2",
                                        "glosses": [
                                            "A person who takes no side in a dispute."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95fed4b8-4662-4f6f-b8dc-cb48330c6928",
                                                "sense_id": "e0bd9483-82b0-3ac4-8c42-d3bb50d388b7",
                                                "text": "They say in Harlan County\n There are no neutrals there\n You'll either be a union man\n Or a thug for J.H. Blair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f191837e-d265-363e-b407-58e29184651e",
                                        "entry_id": "76d43ef1-64c4-374b-8b2b-cb0f5e55aec2",
                                        "glosses": [
                                            "An individual or entity serving as an arbitrator or adjudicator."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "048af6e4-7621-3559-956c-b1277d89c334",
                                        "entry_id": "76d43ef1-64c4-374b-8b2b-cb0f5e55aec2",
                                        "glosses": [
                                            "A neutral hue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc33809c-e0d8-382b-8712-fc7356acc4cb",
                                        "entry_id": "76d43ef1-64c4-374b-8b2b-cb0f5e55aec2",
                                        "glosses": [
                                            "The position of a set of gears in which power cannot be transmitted to the drive mechanism."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "564394e0-6682-486e-9e3f-cb311cabfa7e",
                                                "sense_id": "dc33809c-e0d8-382b-8712-fc7356acc4cb",
                                                "text": "Near-synonym: angel gear (humorous)"
                                            },
                                            {
                                                "example_id": "57977dc3-ec52-423a-9b4d-c3f15b3b035a",
                                                "sense_id": "dc33809c-e0d8-382b-8712-fc7356acc4cb",
                                                "text": "Put it in neutral, and we'll push it out of the garage."
                                            },
                                            {
                                                "example_id": "1305a71e-34e6-4e0c-a7c2-7130e258191f",
                                                "sense_id": "dc33809c-e0d8-382b-8712-fc7356acc4cb",
                                                "text": "He shoved the tractor into neutral, and, leaving the engine running, jumped down[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20464e64-1b7c-3d23-9f7b-e494e7f65b1e",
                                        "entry_id": "76d43ef1-64c4-374b-8b2b-cb0f5e55aec2",
                                        "glosses": [
                                            "An electrical terminal or conductor which has zero or close to zero voltage with respect to the ground."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
