                        "form_id": "86960958-e1db-4783-bfd5-acc7383c6fa0",
                        "entry_id": "f00c35de-99c7-3adf-ba7c-b57108f37172",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "bosseuses"
