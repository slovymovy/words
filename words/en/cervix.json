{
    "word_family": [
        "cervical"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a30039cf-10af-3e34-b8a8-c897d18829ea",
                    "sense_definition": "The lower, narrow part of the uterus that connects to the vagina.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor examined the patient's <w>cervix</w> during the routine health check.",
                            "target_lang_translations": {
                                "zh": "医生在常规体检中检查了患者的<w>宫颈</w>。"
                            }
                        },
                        {
                            "text": "During labour, the <w>cervix</w> gradually opens to allow the baby to pass through.",
                            "target_lang_translations": {
                                "zh": "分娩期间，<w>子宫颈</w>逐渐扩张，使胎儿能够通过。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cervix dilates",
                        "cervix uteri"
                    ],
                    "target_lang_definitions": {
                        "zh": "子宫颈，子宫与阴道相连的狭窄下端部位。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "子宫颈",
                                "target_lang_sense_clarification": "解剖学全称"
                            },
                            {
                                "target_lang_word": "宫颈",
                                "target_lang_sense_clarification": "医学和日常简称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a6a09c5-027c-3a1d-a2f2-3d625c217352",
                    "sense_definition": "A necklike narrow constriction or portion of any anatomical organ or structure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The anatomical textbook described the narrow <w>cervix</w> of the bladder.",
                            "target_lang_translations": {
                                "zh": "这本解剖学教科书描述了膀胱狭窄的<w>颈部</w>。"
                            }
                        },
                        {
                            "text": "The surgeon carefully identified the <w>cervix</w> of the organ before making an incision.",
                            "target_lang_translations": {
                                "zh": "外科医生在切开前仔细辨认了该器官的<w>颈部</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（人体解剖器官或结构的）颈部，狭窄缩窄部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "颈",
                                "target_lang_sense_clarification": "器官的颈部结构"
                            },
                            {
                                "target_lang_word": "颈部",
                                "target_lang_sense_clarification": "器官较狭窄的部位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8d33e99-3c1a-3667-8fca-2dc926894df5",
                    "sense_definition": "The neck, especially the back part of the neck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He placed his hand gently on the back of her <w>cervix</w>.",
                            "target_lang_translations": {
                                "zh": "他将手轻轻地放在她的<w>后颈</w>上。"
                            }
                        },
                        {
                            "text": "Ancient medical treatises frequently used the Latin term <w>cervix</w> to refer to the neck.",
                            "target_lang_translations": {
                                "zh": "古代医学论著常使用拉丁语词汇“<w>cervix</w>”来指代颈部。"
                            }
                        }
                    ],
                    "synonyms": [
                        "neck"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically or in technical anatomy for the neck"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "颈，颈项，尤指后颈部（多见于解剖学术语或古旧用法）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "颈",
                                "target_lang_sense_clarification": "身体部位"
                            },
                            {
                                "target_lang_word": "颈部",
                                "target_lang_sense_clarification": "脖子部位"
                            },
                            {
                                "target_lang_word": "后颈",
                                "target_lang_sense_clarification": "颈项后方"
                            }
                        ]
                    }
                }
            ]
        }
    ]
