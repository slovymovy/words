                    {
                        "sense_id": "dcbf0715-c9b2-39aa-991c-98fbfe76e1fa",
                        "entry_id": "dee6be1d-98e7-39c3-a587-93465f9cabf2",
                        "glosses": [
                            "(hohe) Rangstufe der Klassifizierung von Lebewesen (zwischen Reich und Stamm)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59ac22d3-2566-41fa-bb7c-05190fc8ab9e",
                                "sense_id": "dcbf0715-c9b2-39aa-991c-98fbfe76e1fa",
                                "text": "„Die Niederen Eukaryoten (Schleimpilze, Pilze i.e.S., Flechten, eukaryotische Algen) sind untereinander und mit den Protozoa eng verknüpft und können zum Unterreich der Protobionta zusammengefaßt werden.“"
                            },
                            {
                                "example_id": "3f8a5bff-5e56-4d9d-889a-b6bfeb3c0fe2",
                                "sense_id": "dcbf0715-c9b2-39aa-991c-98fbfe76e1fa",
                                "text": "„Wäre ich statt von dem Hummer von einem Schwamme ausgegangen, so würden wir ihn durch ähnliche Beziehungen mit einer grossen Menge anderer Thiere zu dem Unterreich der Protozoen vereinigt gefunden haben […].“ (1879)"
                            }
                        ],
