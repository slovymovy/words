        "fr-extract.jsonl": [
            {
                "entry_id": "fc231d96-79fb-3b19-91c8-6a923430e83f",
                "word": "pacifisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "08dbeda4-842e-4e57-b3f8-d5c66b8f9360",
                        "entry_id": "fc231d96-79fb-3b19-91c8-6a923430e83f",
                        "tags": [
                            "plural"
                        ],
                        "form": "pacifismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93f1e4f5-2fdb-3f87-bb39-41984c04c978",
                        "entry_id": "fc231d96-79fb-3b19-91c8-6a923430e83f",
                        "glosses": [
                            "Doctrine de ceux qui croient à la possibilité d’établir la paix universelle et qui s’efforcent d’en préparer l’avènement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38ad9f2e-50fa-420f-81ec-e3f4f79df142",
                                "sense_id": "93f1e4f5-2fdb-3f87-bb39-41984c04c978",
                                "text": "Le pacifisme est passif et expectant par essence : il est plein d’espoir et d’attente, mais sans programme d’action."
                            },
                            {
                                "example_id": "5cefed58-5603-4a1d-bde4-2bc164e92c0f",
                                "sense_id": "93f1e4f5-2fdb-3f87-bb39-41984c04c978",
                                "text": "Le pacifisme absolu conduit inévitablement à la guerre totale."
                            },
                            {
                                "example_id": "5d043e1b-4f98-40ca-bbb8-d1c7d5e436f6",
                                "sense_id": "93f1e4f5-2fdb-3f87-bb39-41984c04c978",
                                "text": "Ses amies le disent, elle l'affirme elle-même, et c'est la vérité, encore que le pacifisme révolutionnaire n'y trouve pas son compte en un procès retentissant qui eût pu favoriser davantage la propagande zimmerwaldiste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6af1dc5-952d-4ce8-9602-040eef896ada",
                        "source_entry_id": "fc231d96-79fb-3b19-91c8-6a923430e83f",
                        "source_sense_id": "93f1e4f5-2fdb-3f87-bb39-41984c04c978",
                        "target_lang_word": "Pazifismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pazifismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85c9ab73-2d4e-3a49-963a-a99d45ca768a",
                                        "entry_id": "9c5f87e9-140c-33ad-a8a2-ad8082440fe7",
                                        "glosses": [
                                            "die Ideologie, die sich für den Frieden einsetzt und den Krieg und die Gewalt ablehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df0f34cf-b1e2-4a7e-bacd-e9f166bf15de",
                                                "sense_id": "85c9ab73-2d4e-3a49-963a-a99d45ca768a",
                                                "text": "„Wir müssen unsere Kinder gegen Militarismus impfen, indem wir sie im Geiste des Pazifismus erziehen.“"
                                            },
                                            {
                                                "example_id": "c50f5309-cfb5-4b21-ad6c-026bcadd184b",
                                                "sense_id": "85c9ab73-2d4e-3a49-963a-a99d45ca768a",
                                                "text": "„In Zürich hat Einstein bei einem Freund des Vaters, Gustav Maier, Unterstützung für seinen frühentwickelten Pazifismus gefunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e35694b8-6dbc-473d-b087-79da8fa0932c",
                        "source_entry_id": "fc231d96-79fb-3b19-91c8-6a923430e83f",
                        "source_sense_id": "93f1e4f5-2fdb-3f87-bb39-41984c04c978",
                        "target_lang_word": "pacifism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pacifism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea6f57ee-c60d-315c-9baa-a2ff7a2aeecf",
                                        "entry_id": "4d393c1b-307f-386c-ba3a-11057f5d8b5f",
                                        "glosses": [
                                            "The support of peace, specifically:",
                                            "The conviction that it is morally wrong to settle disputes (especially between countries) by war or other violent means."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2d5e573-77bf-4494-a334-26ab1169f9d3",
                                                "sense_id": "ea6f57ee-c60d-315c-9baa-a2ff7a2aeecf",
                                                "text": "I am not only a pacifist but a militant pacifist. I am willing to fight for peace. Nothing will end war unless the people themselves refuse to go to war."
                                            },
                                            {
                                                "example_id": "375068b4-2c02-4697-a88d-430e00fd1c16",
                                                "sense_id": "ea6f57ee-c60d-315c-9baa-a2ff7a2aeecf",
                                                "text": "The individual pacifist (who may or may not follow a particular religion) can for example support voluntary euthanasia while at the same time retaining a consistent view about how to approach issues surrounding violent conflict and the common good. Although such issues raise complex ethical dilemmas, for some, pacifism can accomodate^([sic]) the possibility of killing in certain circumstances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae963eaa-4ff3-32c9-ad77-1788fad8087d",
                                        "entry_id": "4d393c1b-307f-386c-ba3a-11057f5d8b5f",
                                        "glosses": [
                                            "The support of peace, specifically:",
                                            "The ethical avoidance of inflicting harm on others in one's daily life."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "448f19f5-4985-44ed-8dc8-bbddb221f85c",
                                                "sense_id": "ae963eaa-4ff3-32c9-ad77-1788fad8087d",
                                                "text": "Pacifism forbids us from killing would-be murderers in self-defense, but terrorism permits us to slit the throat of a 17-year-old working a night shift at the zoo.[…]Pacifism also has the modal implication that no possible wrongful aggressor can be permissibly harmed, even in possible worlds where doing so is the only feasible means of saving oneself or others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3ca01c9-04b5-30de-aa0e-933a27db58f9",
                                        "entry_id": "4d393c1b-307f-386c-ba3a-11057f5d8b5f",
                                        "glosses": [
                                            "The support of peace, specifically:",
                                            "The combination of the above two philosophical viewpoints."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92cf161f-8be7-364c-92eb-6c64d1f7db8d",
                                        "entry_id": "4d393c1b-307f-386c-ba3a-11057f5d8b5f",
                                        "glosses": [
                                            "The additional challenge of winning a game without harming any enemy characters."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
