                        "examples": [
                            {
                                "example_id": "d4290d88-cda6-42b7-bd1c-916f09af7fbb",
                                "sense_id": "79405a66-d5fb-3fa8-a0f4-13fb627391e8",
                                "text": "„Die mittlere jährliche Abflussmenge in Wolgograd beträgt 264 Milliarden Kubikmeter.“"
                            },
                            {
                                "example_id": "d96b4515-0fa4-4048-b6a8-a6936a11b84e",
                                "sense_id": "79405a66-d5fb-3fa8-a0f4-13fb627391e8",
                                "text": "„Verringert sich dieser Einfluss, dürfte sich die Tiefenwasserbildung in der Grönlandsee verstärken: Hier stürzen in jeder Sekunde bis zu 17 Millionen Kubikmeter Wasser in die Tiefe – das 20-Fache der Abflussmenge aller Flüsse weltweit.“"
                            }
                        ],
