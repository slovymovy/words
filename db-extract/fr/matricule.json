            {
                "entry_id": "2505eee4-d317-31f7-8874-df0866874fc0",
                "word": "matricule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d3c2039c-c28c-468c-959d-ecf1bfaeaffb",
                        "entry_id": "2505eee4-d317-31f7-8874-df0866874fc0",
                        "tags": [
