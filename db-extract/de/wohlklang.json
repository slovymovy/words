                "senses": [
                    {
                        "sense_id": "af4d9e15-9e2b-3ee8-984d-bac286a032f3",
                        "entry_id": "8ea1dd2f-e254-36a0-a540-0c9aa1764ebb",
                        "glosses": [
                            "Klang oder Ton, der als angenehm empfunden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e6f89ef-5381-4451-8ff3-240269f2a273",
                                "sense_id": "af4d9e15-9e2b-3ee8-984d-bac286a032f3",
                                "text": "Ich telefoniere gerne mit der Sekretärin meines Onkologen, denn ihre Stimme ist ein wahrer Wohlklang."
                            },
                            {
                                "example_id": "6cf139e9-c8a4-4ec3-bd9d-b3df49f969ae",
                                "sense_id": "af4d9e15-9e2b-3ee8-984d-bac286a032f3",
                                "text": "„Die Instrumentation des Streichquartetts ist übrigens in Beziehung auf den Wohlklang am leichtesten mit zu erwerben, wegen der Klangverwandtschaft dieser Instrumente[.]“"
                            },
                            {
                                "example_id": "579be139-828f-45f4-b315-659849545f91",
                                "sense_id": "af4d9e15-9e2b-3ee8-984d-bac286a032f3",
                                "text": "„Er entdeckte, in unserer Sprechweise, daß Wohlklang und Mißklang eines Akkords davon abhängen, in welchem Verhältnis die Schwingungszahlen der Töne zueinander stehen.“"
                            },
                            {
                                "example_id": "0766b7d7-8113-4f03-b778-a598ac831d28",
                                "sense_id": "af4d9e15-9e2b-3ee8-984d-bac286a032f3",
                                "text": "„Mittels der Funktionswerte können dann Intervalle hinsichtlich ihres Wohlklangs verglichen werden: je kleiner der Funktionswert, desto ausgeprägter der Wohlklang.“"
                            },
                            {
                                "example_id": "caccef05-b97c-4c9e-ad35-d162b09a3537",
                                "sense_id": "af4d9e15-9e2b-3ee8-984d-bac286a032f3",
                                "text": "„Noch gab es nur reinen Wohlklang, die drei Os rollten wie die Bassstimmen eines Männerchors.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
