                "senses": [
                    {
                        "sense_id": "a898f6d3-2b74-3400-83eb-026395fe49f8",
                        "entry_id": "744dbe07-0a27-3b72-bce2-40d4a4434cdd",
                        "glosses": [
                            "nie mający dokumentu rodowodu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91f032e9-51ba-4d1c-a021-0f0e280e5819",
                                "sense_id": "a898f6d3-2b74-3400-83eb-026395fe49f8",
                                "text": "Niestety, polskie prawo nie zabrania rozmnażania nierodowodowych zwierząt dla zysku. Jedynym sposobem powstrzymania pseudohodowców jest zmniejszenie popytu na ich działalność"
                            },
                            {
                                "example_id": "c2c9a180-cf92-47cc-86dc-b3b1e1415789",
                                "sense_id": "a898f6d3-2b74-3400-83eb-026395fe49f8",
                                "text": "Pies nierodowodowy jest psem w typie rasy, lecz nigdy psem rasowym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
