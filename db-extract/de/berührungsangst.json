                "senses": [
                    {
                        "sense_id": "7a6d2558-f8c5-3d88-b6e8-f16a8fa61c36",
                        "entry_id": "2fa859b0-a0f1-3b08-b30c-59e44a9393c6",
                        "glosses": [
                            "Angst/Furcht vor körperlichen Berührungen oder sozialen Kontakten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4131ad95-3aa6-45ee-95db-545bde3b4d06",
                                "sense_id": "7a6d2558-f8c5-3d88-b6e8-f16a8fa61c36",
                                "text": "„Und es wird klar, was das Asperger-Syndrom, an dem sie seit Geburt leidet, im Alltag und für ihre Familie bedeutet. Im Guten: die starke Konzentration auf ihre Ziele. An schlechten Tagen: Depressionen und soziale Berührungsängste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c03092e6-2605-35cd-ad2b-deb59a419106",
                        "entry_id": "2fa859b0-a0f1-3b08-b30c-59e44a9393c6",
                        "glosses": [
                            "Furcht vor/Problem mit bestimmten Themen (oft Themen, die als neu, abweichend von einer Norm oder einer Mehrheitsmeinung angesehen werden)"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "2b22afcf-7267-4550-8e8d-ecc1a3e0dc14",
                                "sense_id": "c03092e6-2605-35cd-ad2b-deb59a419106",
                                "text": "„Helfrich hat keine Berührungsängste mit der neuen 3D-Technologie.“"
                            },
                            {
                                "example_id": "90d35272-1e3a-4c9a-9c54-1dc9ece15481",
                                "sense_id": "c03092e6-2605-35cd-ad2b-deb59a419106",
                                "text": "[…] „Amerika hat keine Berührungsängste damit, einen Frieden mitunter auch militärisch \"herzustellen\".“"
                            },
                            {
                                "example_id": "1613cba9-fd89-4e57-81b3-84edf7611b30",
                                "sense_id": "c03092e6-2605-35cd-ad2b-deb59a419106",
                                "text": "[Über die Fürstenfamilie des Fürstentums Liechtenstein] „Dennoch gibt es zwischen Fürstenhaus und den etwa 35.000 Untertanen keine Berührungsängste.“"
                            },
                            {
                                "example_id": "d4e9c308-9b24-45d8-ad9f-a282399e31c4",
                                "sense_id": "c03092e6-2605-35cd-ad2b-deb59a419106",
                                "text": "„Berührungsängste mit militanten Rechtsextremisten haben sie nicht.“"
                            },
                            {
                                "example_id": "6069b980-74cd-4748-8c62-3352f8f32226",
                                "sense_id": "c03092e6-2605-35cd-ad2b-deb59a419106",
                                "text": "[Die Grünenpolitikerin] „Baerbock hat wie Habeck wenig Berührungsängste auch mit konservativen Politikern.“"
                            },
                            {
                                "example_id": "ed057291-ec0b-4462-bbff-aa366553d3aa",
                                "sense_id": "c03092e6-2605-35cd-ad2b-deb59a419106",
                                "text": "[Über den SPD-Politiker Jochen Vogel:] „Berührungsängste zur CDU fehlten Vogel schon aus familiären Gründen: Sein Bruder Bernhard, lange Ministerpräsident von Rheinland-Pfalz und später von Thüringen, ist Christdemokrat.“"
                            },
                            {
                                "example_id": "2d59cbc7-e3e3-45fa-b23b-fc87b0b460f5",
                                "sense_id": "c03092e6-2605-35cd-ad2b-deb59a419106",
                                "text": "[Über den Saxophonisten Klaus Doldinger:] „Berührungsängste zwischen Kunst und Kommerz hatte Doldinger nie.“"
                            },
                            {
                                "example_id": "42613ba5-7cd9-4d86-9d21-34ce008251d7",
                                "sense_id": "c03092e6-2605-35cd-ad2b-deb59a419106",
                                "text": "„Chris Barber lebte für die Musik. Vor allem der Jazz aus New Orleans und der Blues lagen ihm im Blut. Er hatte aber auch keine Berührungsängste zur Rockmusik und scherte sich auch sonst wenig darum, was andere von seinen musikalischen Experimenten hielten.“"
                            },
                            {
                                "example_id": "b93cd381-c011-48cd-87e9-1296aa2d8116",
                                "sense_id": "c03092e6-2605-35cd-ad2b-deb59a419106",
                                "text": "„Pavarotti kannte keine Berührungsängste. Er scheute sich nicht davor, mit seiner Ausnahmestimme auch Pop-Produktionen, etwa mit Sting, Elton John oder Bon Jovi, zu veredeln.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
