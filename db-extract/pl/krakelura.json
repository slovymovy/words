                    {
                        "sense_id": "559e16c2-c9b2-3f63-9c0b-a4033b350b40",
                        "entry_id": "ffeb43b7-65c8-3652-9354-0b042679b2f9",
                        "glosses": [
                            "siateczka spękań, która tworzy się z czasem na powierzchni obrazów olejnych, fresków, szkliwionej ceramiki"
                        ],
                        "tags": [],
                        "examples": [],
