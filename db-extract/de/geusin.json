                ],
                "senses": [
                    {
                        "sense_id": "1cc8ed2d-b93c-3e23-80ad-56df5da6eca2",
                        "entry_id": "a75ae9f9-e8f1-3c91-925c-df30a5285e7f",
                        "glosses": [
                            "niederländische Aufständische im Achtzigjährigen Krieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07f09330-00ac-4b02-96f5-7852471600bf",
                                "sense_id": "1cc8ed2d-b93c-3e23-80ad-56df5da6eca2",
                                "text": "„Im Namen der Rache, im Namen des Sieges, so komm in meine Arme, Du wilde Geusin, so komm und sei mein, du holde Ketzerin.“"
                            },
                            {
                                "example_id": "f9b5db92-0082-4e6c-ba1f-976a0c8c03a6",
                                "sense_id": "1cc8ed2d-b93c-3e23-80ad-56df5da6eca2",
                                "text": "„Ich schwör’s Euch, Geusin, schwör’s Euch bei meinem höchsten Gut.“"
                            },
                            {
                                "example_id": "7dd1acf9-79de-4ae2-888b-5a2718290a1c",
                                "sense_id": "1cc8ed2d-b93c-3e23-80ad-56df5da6eca2",
                                "text": "„Einmal Geusin, immer Geusin, genau das strahlte sie aus.“"
                            },
                            {
                                "example_id": "40e3f645-15ff-4511-bb82-12beaa49ca53",
                                "sense_id": "1cc8ed2d-b93c-3e23-80ad-56df5da6eca2",
                                "text": "„Versucht es einmal, weil ihr den Geusen und Geusinnen noch mächtig seyd; denn ihr kennet sie nun, welche Geusen oder Geusinnen sind, dieweil sie sich selber durch diese teuflischen Heckenpredigten geoffenbart und bekannt gemacht haben.“"
                            },
                            {
                                "example_id": "60db23a5-6ae5-4d04-9315-d5804c66ecc8",
                                "sense_id": "1cc8ed2d-b93c-3e23-80ad-56df5da6eca2",
                                "text": "„Sind das nicht schöne Prädikanten, denen ihr haufenweise zulauft, um den Lügen zu lauschen, die sie ausspeien, diese Prädikanten, zu deren Andacht die Mädchen in der Nacht rennen, ja, auf daß nach neun Monaten die Stadt voll sei von kleinen Geusen und Geusinnen?“"
                            },
                            {
                                "example_id": "83eba02e-cd2b-4146-85dd-8b38ceecb428",
                                "sense_id": "1cc8ed2d-b93c-3e23-80ad-56df5da6eca2",
                                "text": "„Offenbar hat Johann Eisenhut für den Maysteter, den Bruder der Geusin, gebürgt und muß deshalb die Hausmiete von 28 fl dem Hucker bezahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
