                "senses": [
                    {
                        "sense_id": "aaa40390-6f1f-34df-89b3-88c297abf765",
                        "entry_id": "29f23fce-dd32-304b-bcbf-647e6187cd41",
                        "glosses": [
                            "Damenstrumpf, der aus einer glänzenden, reißfesten Chemiefaser (Nylon) gefertigt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0052cf9f-4fc3-49c7-9989-3e1d4f25d26e",
                                "sense_id": "aaa40390-6f1f-34df-89b3-88c297abf765",
                                "text": "„Überall standen Gäste im Alter des Jubilars, Männer in Schlips und Kragen, Frauen in schönen Blusen und Nylonstrümpfen, mit eleganten Handtaschen an Schulterriemen und diskretem Schmuck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c3e9d38-b9c4-402a-87a2-198084615f81",
                        "source_entry_id": "29f23fce-dd32-304b-bcbf-647e6187cd41",
                        "source_sense_id": "aaa40390-6f1f-34df-89b3-88c297abf765",
                        "source_sense_description": "Damenstrumpf, der aus einer glänzenden, reißfesten Chemiefaser (Nylon) gefertigt wurde",
