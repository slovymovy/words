                "senses": [
                    {
                        "sense_id": "32371bee-162b-378f-859c-36f29960dc59",
                        "entry_id": "3ad520ae-54cc-3e59-9dae-e0fda81e2c90",
                        "glosses": [
                            "Qui rend insensible à la douleur par l’anesthésie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f579ee53-72a4-4f7c-82fc-21b9448a3f56",
                                "sense_id": "32371bee-162b-378f-859c-36f29960dc59",
                                "text": "Le produit anesthésiant est injecté au niveau des vertèbres lombaires sur une patiente assise au bord de la table."
                            }
                        ]
                    },
                    {
                        "sense_id": "c570aa24-a3e8-3be0-b16e-6b841876de7c",
                        "entry_id": "3ad520ae-54cc-3e59-9dae-e0fda81e2c90",
                        "glosses": [
                            "Qui endort, qui diminue la vigilance."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1a918a4e-135d-41b4-ae2f-d3a81bf77645",
                                "sense_id": "c570aa24-a3e8-3be0-b16e-6b841876de7c",
                                "text": "Sans que ma volonté s’efforçât de dompter mes nerfs, une sorte de torpeur anesthésiante endormit mon cerveau trop las."
                            },
                            {
                                "example_id": "dc928ca5-16e1-42ce-a6da-a8be52fe4e3b",
                                "sense_id": "c570aa24-a3e8-3be0-b16e-6b841876de7c",
                                "text": "Il flottait dans la grande ville un sentiment anesthésiant de sécurité."
                            }
                        ]
                    }
                ],
