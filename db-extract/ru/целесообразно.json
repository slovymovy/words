                                "target_senses": [
                                    {
                                        "sense_id": "c9b899b2-ed14-3d5a-a927-c78b740bb44d",
                                        "entry_id": "4ad96522-52d8-387c-91ae-e1f7348c64e2",
                                        "glosses": [
                                            "D’une manière utile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff1362e1-07e7-48f5-99fd-250697cf3a6b",
                                                "sense_id": "c9b899b2-ed14-3d5a-a927-c78b740bb44d",
                                                "text": "Il a travaillé utilement pour lui et pour les siens. Employer le temps utilement. Il a très utilement servi l’état."
                                            }
