                        "sense_id": "e1c31b03-72f6-302e-bad1-2d12217e22c6",
                        "entry_id": "ab38fd56-20e4-369a-abf1-0a034dcde9f6",
                        "glosses": [
                            "lijkend op een spons"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0028c3d-cf44-4fa3-a966-5593f1d458f5",
                                "sense_id": "e1c31b03-72f6-302e-bad1-2d12217e22c6",
                                "text": "Er lopen minstens 81 koeien in de VS rond die net als de koe die vorige week besmet bleek met de gekkekoeienziekte veevoer gegeten hebben dat hen mogelijk blootstelde aan besmetting met bse (bovine spongiform encephalopathie)."
                            },
                            {
                                "example_id": "abbe51a8-b789-4126-8241-da3b7ccf55e3",
                                "sense_id": "e1c31b03-72f6-302e-bad1-2d12217e22c6",
                                "text": "Boviene Spongiforme Encefalopathie (BSE) dook voor het eerst op in Groot-Brittannië in 1986. De ziekte tast het centrale zenuwstelsel van het besmette dier aan, wat tot de dood kan leiden. Sinds 2001 worden in Nederland alle runderen bij de slacht gecontroleerd op BSE."
                            }
                        ]
                    }
