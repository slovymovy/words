                            {
                                "target_lang_word": "Кью",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "Cue",
                                "target_lang_sense_clarification": "příjmení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f7d4f8d-ae32-3f52-9a50-e0feb7c9ab24",
                    "sense_definition": "A small town and local government area in the Mid West region of Western Australia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They traveled through the outback to visit the town of <w>Cue</w>.",
                            "target_lang_translations": {
                                "ru": "Они путешествовали по малонаселённой местности, чтобы посетить город <w>Кью</w>.",
                                "cs": "Cestovali vnitrozemím, aby navštívili město <w>Cue</w>."
                            }
                        },
                        {
                            "text": "The Shire of <w>Cue</w> is known for its historic gold mining heritage.",
                            "target_lang_translations": {
                                "ru": "Графство <w>Кью</w> известно своим историческим наследием золотодобычи.",
                                "cs": "Oblast <w>Cue</w> je známá svým historickým dědictvím těžby zlata."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой город и район местного самоуправления в регионе Средний Запад Западной Австралии",
                        "cs": "Malé město a oblast místní správy v regionu Mid West v Západní Austrálii."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кью",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "Cue",
