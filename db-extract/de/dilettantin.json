                        "entry_id": "ae68bf41-e242-3bfe-9ccc-23e6d3fb0528",
                        "glosses": [
                            "Liebhaberin von etwas ohne professionelle Kenntnisse (heute meist abwertend gebraucht)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3beb41be-b4eb-44b4-ba16-010101c7b814",
                                "sense_id": "bc035c42-cf00-3d74-b621-c7908f767116",
                                "text": "Sie ist auf diesem Gebiet eine Dilettantin."
                            },
                            {
                                "example_id": "4a4697ee-48c0-4162-9016-ea2386ac15a2",
                                "sense_id": "bc035c42-cf00-3d74-b621-c7908f767116",
                                "text": "„Sie ist keine Dilettantin, noch jung, zweiundzwanzig oder dreiundzwanzig, bestimmt unberührt – und diese Tatsache flößt mir Angst ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be6387b2-6876-4811-bc34-5c0f433dac3e",
