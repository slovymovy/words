                        "form": "more dark-hearted"
                    },
                    {
                        "form_id": "9339be0a-d5e0-4bfb-8f9c-09f876df01d3",
                        "entry_id": "c58581e3-3503-3362-bb1b-2121ae1ab5c5",
                        "tags": [
                            "comparative"
                        ],
