{
    "word_family": [
        "fortify",
        "fortification",
        "fort"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d9746e7-f0b4-3bd3-88ab-0f1959a18f3c",
                    "sense_definition": "Mental or emotional strength that enables courage in the face of adversity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She showed great <w>fortitude</w> while dealing with the difficult news about her health.",
                            "target_lang_translations": {
                                "ru": "Она проявила великую <w>силу духа</w>, справляясь с тяжелыми новостями о своем здоровье."
                            }
                        },
                        {
                            "text": "It takes immense <w>fortitude</w> to remain calm when everything around you is falling apart.",
                            "target_lang_translations": {
                                "ru": "Требуется огромная <w>стойкость</w>, чтобы сохранять спокойствие, когда вокруг тебя все рушится."
                            }
                        }
                    ],
                    "synonyms": [
                        "inner strength",
                        "moxie",
                        "mettle",
                        "resolve",
                        "toughness"
                    ],
                    "common_phrases": [
                        "show great fortitude",
                        "require real fortitude",
                        "intestinal fortitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Душевная или моральная стойкость, позволяющая сохранять мужество перед лицом трудностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сила духа",
                                "target_lang_sense_clarification": "внутренняя стойкость перед лицом невзгод"
                            },
                            {
                                "target_lang_word": "стойкость",
                                "target_lang_sense_clarification": "способность противостоять трудностям"
                            },
                            {
                                "target_lang_word": "мужество",
                                "target_lang_sense_clarification": "душевная твердость и смелость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf7d253d-d4a0-353f-9d5d-85438bacc39c",
                    "sense_definition": "Physical strength.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient castle relied on the <w>fortitude</w> of its stone walls to withstand the heavy siege.",
                            "target_lang_translations": {
                                "ru": "Древний замок полагался на <w>прочность</w> своих каменных стен, чтобы выдержать тяжелую осаду."
                            }
                        },
                        {
                            "text": "The soldiers tested the <w>fortitude</w> of the defensive structure before the enemy arrived.",
                            "target_lang_translations": {
                                "ru": "Солдаты проверили <w>крепость</w> оборонительного сооружения до прихода врага."
                            }
                        }
                    ],
                    "synonyms": [
                        "toughness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая сила или прочность (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прочность",
                                "target_lang_sense_clarification": "о конструкциях или стенах"
                            },
                            {
                                "target_lang_word": "крепость",
                                "target_lang_sense_clarification": "физическая стойкость или надежность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
