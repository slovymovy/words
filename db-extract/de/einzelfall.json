                        ],
                        "form": "den Einzelfall"
                    },
                    {
                        "form_id": "aacde2b1-921e-4dc6-9836-8cefd7083078",
                        "entry_id": "cf49dc40-8cc9-3aea-bd0d-233a6aeebf97",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Einzelfälle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b08bc72f-815c-386f-a59c-3eeceb5f1ed7",
                        "entry_id": "cf49dc40-8cc9-3aea-bd0d-233a6aeebf97",
                        "glosses": [
                            "einmaliges Ereignis, einmalige Erscheinung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a804fb0-4e2d-41fd-aa98-e9d999ea5dc5",
                                "sense_id": "b08bc72f-815c-386f-a59c-3eeceb5f1ed7",
                                "text": "„Das war kein Einzelfall, sondern vielerorts die Regel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "357846e1-9d6e-3e69-a2c1-6941088e0b18",
                        "entry_id": "cf49dc40-8cc9-3aea-bd0d-233a6aeebf97",
                        "glosses": [
                            "konkreter, individueller Fall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04f1e74-7a6d-4548-a51d-3345acbcc8c8",
                                "sense_id": "357846e1-9d6e-3e69-a2c1-6941088e0b18",
                                "text": "Bei der Analyse der Einzelfälle ergaben sich viele Überschreitungen der zugelassenen Höchstwerte."
                            },
                            {
                                "example_id": "0e33e0e1-5d01-48f1-a566-21285739b2c7",
                                "sense_id": "357846e1-9d6e-3e69-a2c1-6941088e0b18",
                                "text": "„In Ländern mit freier Presse geistern spektakuläre Einzelfälle wochenlang durch die Medien und hinterlassen den Eindruck, man lebe in einem Land voller Massenmörder.“"
                            },
                            {
                                "example_id": "fe142df3-e5cd-4321-86db-22f8a4997aed",
                                "sense_id": "357846e1-9d6e-3e69-a2c1-6941088e0b18",
                                "text": "„Manchmal kann man nur aus dem Gesamtinhalt erschließen, um welche Bedeutung es sich im Einzelfall handelt.“"
                            },
                            {
                                "example_id": "730edc42-b37b-44ac-bfb1-2f9268481f6f",
                                "sense_id": "357846e1-9d6e-3e69-a2c1-6941088e0b18",
                                "text": "„Die Rechtsprechung muss Einzelfälle interpretieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
