                        "target_lang_word": "stretch mark",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stretch mark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25776b9c-152b-378b-b57c-22416e8ca37c",
                                        "entry_id": "80db9631-0a27-3164-95df-40b364712d9b",
                                        "glosses": [
                                            "Any of a series of red (or purple or faded), irregular stripes on the surface of the skin caused by rapid growth of the tissues lying just underneath. They may appear as a result of pregnancy, puberty, obesity, rapid muscle growth or family history."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "224e3d45-7a80-4dc9-a8e2-5f299a155c73",
                                                "sense_id": "25776b9c-152b-378b-b57c-22416e8ca37c",
                                                "text": "Nobody in Cameron's family has stretch marks, and he thinks it's because their tissues grow slowly enough for the skin to catch up."
                                            },
                                            {
                                                "example_id": "ba966e26-de68-41ce-8855-4d90b9d2d78e",
                                                "sense_id": "25776b9c-152b-378b-b57c-22416e8ca37c",
                                                "text": "She hadn't even looked pregnant, especially with her clothes on. She'd gotten only one stretch mark. A thin, jagged line on her left booty cheek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
