                "senses": [
                    {
                        "sense_id": "fdc305a2-bca0-3d0d-9279-0d5031b9a429",
                        "entry_id": "58c090c0-4c7f-3ad0-a6e2-f4b53852d7db",
                        "glosses": [
                            "Joie intense."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "f37d8f5e-b076-41d3-a6fd-48fd1a54fd71",
                                "sense_id": "fdc305a2-bca0-3d0d-9279-0d5031b9a429",
                                "text": "Un grand merci à Stanislas Dehaene, Maître, Collègue et Ami (MCA) qui m’a initié à la recherche en neurosciences cognitives dans une atmosphère amicale d’exultation intellectuelle partagée. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 455)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d4f04ce-5d44-4ccb-8d75-52a49d482ed9",
                        "source_entry_id": "58c090c0-4c7f-3ad0-a6e2-f4b53852d7db",
                        "source_sense_id": "fdc305a2-bca0-3d0d-9279-0d5031b9a429",
                        "target_lang_word": "Frohlocken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frohlocken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf4b10ef-0701-3dd1-8e3c-a1a058b8d74c",
                                        "entry_id": "e696c992-88aa-370e-aa1b-0fdf81f11cef",
                                        "glosses": [
                                            "Äußerung großer Freude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8574ba73-e1ce-4460-9ef4-ac1e2ba85032",
                                                "sense_id": "cf4b10ef-0701-3dd1-8e3c-a1a058b8d74c",
                                                "text": "„Kein Jubel, kein Frohlocken war jedoch unter der versammelten, größtenteils aus Frauen und Kindern bestehenden Menge zu hören.“"
                                            },
                                            {
                                                "example_id": "61f131fd-80fb-41d1-b030-fce953bdb664",
                                                "sense_id": "cf4b10ef-0701-3dd1-8e3c-a1a058b8d74c",
                                                "text": "„Es war ein Schreien, zuerst erstickt und abgebrochen wie das Weinen eines Kindes, dann aber schwoll es an zu einem ununterbrochenen, durchdringenden und unheimlichen Gekreisch, das keiner menschlichen Stimme mehr zu vergleichen war – zu einem bald jammervoll klagenden, bald höhnisch johlenden Geheul, wie es nur aus der Hölle kommt, wenn das Wehklagen der zu ewiger Todespein Verdammten sich mit dem Frohlocken der Höllengeister zu einem Schall vereint.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "911e98f2-0bab-4a4c-bbda-3b335884f96e",
                        "source_entry_id": "58c090c0-4c7f-3ad0-a6e2-f4b53852d7db",
                        "source_sense_id": "fdc305a2-bca0-3d0d-9279-0d5031b9a429",
                        "target_lang_word": "Jauchzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "98a636f3-1b0e-403a-941b-9d87506f313b",
                        "source_entry_id": "58c090c0-4c7f-3ad0-a6e2-f4b53852d7db",
                        "source_sense_id": "fdc305a2-bca0-3d0d-9279-0d5031b9a429",
                        "target_lang_word": "Jubel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jubel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "751c2269-719f-30db-b7a6-1d3ae71cd4b0",
                                        "entry_id": "dc74b7ba-f329-30be-a0c5-dea69499a9d9",
                                        "glosses": [
                                            "Offenbarung großer Freude durch entsprechendes Verhalten in Gestik, Mimik, Stimme, Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f16a0b-9eb2-4319-a072-cccee4ee961d",
                                                "sense_id": "751c2269-719f-30db-b7a6-1d3ae71cd4b0",
                                                "text": "Der Jubel über den Sieg wollte kein Ende nehmen."
                                            },
                                            {
                                                "example_id": "88850e93-e4cd-484d-a416-0324741739f3",
                                                "sense_id": "751c2269-719f-30db-b7a6-1d3ae71cd4b0",
                                                "text": "„Trotzdem gab es regelmäßig Jubel, wenn Soldatenkolonnen in Uniform ihre Kasernen verließen und sich auf den Weg zu den Bahnhöfen machten.“"
                                            },
                                            {
                                                "example_id": "6640fdac-12a4-4adc-ac4a-3d2066832209",
                                                "sense_id": "751c2269-719f-30db-b7a6-1d3ae71cd4b0",
                                                "text": "„Kein Jubel, kein Frohlocken war jedoch unter der versammelten, größtenteils aus Frauen und Kindern bestehenden Menge zu hören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fff1fae-6bb5-4d39-97ee-6188b5df7b6f",
                        "source_entry_id": "58c090c0-4c7f-3ad0-a6e2-f4b53852d7db",
                        "source_sense_id": "fdc305a2-bca0-3d0d-9279-0d5031b9a429",
