                        "glosses": [
                            "Aluminum oxide, especially when used in mining, material sciences or ceramics, a refractory solid compound."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1bd938e9-feda-4c96-9e24-b80494ae6cb9",
                                "sense_id": "271686ff-894f-3271-99a5-89ed38fed6b6",
                                "text": "The apocrenates of iron and manganese are slightly soluble; those of lime, magnesia and alumina are insoluble."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c119982d-164c-43fd-9710-fadc34598932",
