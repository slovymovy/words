                "senses": [
                    {
                        "sense_id": "de58110e-6163-395f-acca-925dfeb0c049",
                        "entry_id": "d95514f2-3212-31bb-90f9-6b0253d085a0",
                        "glosses": [
                            "in Bruchformeln (meist gekürzt nur für eine Kieferseite) angegebene Anzahl von Zähnen und deren Stellung im Gebiss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d00ee8b-0282-47b9-a98b-14db91afb57e",
                                "sense_id": "de58110e-6163-395f-acca-925dfeb0c049",
                                "text": "Die Zahnformel gibt im Zähler die Zähne des Ober-, im Nenner die des Unterkiefers, von der Mitte zur Seite hin also in der Reihenfolge Schneide-, Eck-, Backen- und Mahlzähne an."
                            },
                            {
                                "example_id": "67077175-9bbb-415e-897f-b01a2bddbdae",
                                "sense_id": "de58110e-6163-395f-acca-925dfeb0c049",
                                "text": "Die Zahnformeln von Rind und Hund differieren vor allem hinsichtlich des Oberkiefers."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
