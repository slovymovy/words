                ],
                "senses": [
                    {
                        "sense_id": "5fda7c73-8faa-317e-8dcb-69ad1dd2a535",
                        "entry_id": "2a3760a1-e85e-3827-87ef-7f373fb8aad4",
                        "glosses": [
                            "Gelände, in dem sich die Verkehrsteilnehmer bewegen (können)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2504f3e1-cfce-49de-bf75-218030dde317",
                                "sense_id": "5fda7c73-8faa-317e-8dcb-69ad1dd2a535",
                                "text": "„Dass das größte Land Nordrhein-Westfalen mit einem der dichtesten Verkehrsräume in Europa in zehn Jahren auf ein Viertel der Mittel für Straßenbau heruntergefahren worden ist, das geht auf Dauer nicht, so der Minister.“"
                            },
                            {
                                "example_id": "545e8e19-f163-42e3-a304-4b1718afe705",
                                "sense_id": "5fda7c73-8faa-317e-8dcb-69ad1dd2a535",
                                "text": "„Der Verkehrsraum bleibt beschränkt, wir werden also auch weiterhin Staus haben.“"
                            },
                            {
                                "example_id": "452570c5-f6b0-422e-b91e-5772a782c677",
                                "sense_id": "5fda7c73-8faa-317e-8dcb-69ad1dd2a535",
                                "text": "„Spätestens mit dem Besuch des Kindergartens sollte dann auch der engere Verkehrsraum um die Wohnung als Fußgänger verfügbar sein.“"
                            },
                            {
                                "example_id": "7220f075-c649-49f0-afb2-8c2ded7f19d8",
                                "sense_id": "5fda7c73-8faa-317e-8dcb-69ad1dd2a535",
                                "text": "„Gilt ein Betriebsgelände als öffentlicher Verkehrsraum, ergeben sich an die Fahrer und die dort betriebenen Fahrzeuge, insbesondere Bagger, Radlader und Flurförderfahrzeuge, besondere rechtliche Anforderungen.“"
                            },
                            {
                                "example_id": "8aa47485-ba32-4985-83fc-dc123bcf750a",
                                "sense_id": "5fda7c73-8faa-317e-8dcb-69ad1dd2a535",
                                "text": "„Die Devise lautet: Weniger Verkehrsraum, mehr Lebensraum.“"
                            },
                            {
                                "example_id": "df7742d0-bec3-455f-b42f-172d19c34f88",
                                "sense_id": "5fda7c73-8faa-317e-8dcb-69ad1dd2a535",
                                "text": "„Die Roller sind leicht zu bedienen, günstig im Unterhalt und benötigen nur minimalen Park- und Verkehrsraum, was sie leicht an jedem Stau vorbeihuschen lässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
