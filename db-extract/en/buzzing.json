                        "target_lang_word": "vrombissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vrombissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbb376cc-a4ee-374d-8cc3-bea7e8204d4f",
                                        "entry_id": "779f1266-2cc3-3f22-8e77-1647c73cc1bb",
                                        "glosses": [
                                            "Action de vrombir."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b2ded29-d9c1-4633-96ef-5e04b55e2283",
                                                "sense_id": "fbb376cc-a4ee-374d-8cc3-bea7e8204d4f",
                                                "text": "[…], mais à ce moment nous entendîmes distinctement le vrombissement de plusieurs moteurs d'avion et le crépitement de rafales de mitrailleuses. Le vrombissement était par moment plus intense, comme lorsque les avions descendent en piqué."
                                            },
                                            {
                                                "example_id": "59c42cb1-ff3f-4afc-9df9-9ad55fbf5e87",
                                                "sense_id": "fbb376cc-a4ee-374d-8cc3-bea7e8204d4f",
                                                "text": "C’est mythique, comme le vrombissement d’une Harley Davidson."
                                            },
                                            {
                                                "example_id": "9dd5e401-1c54-4cf1-bf39-57415889c419",
                                                "sense_id": "fbb376cc-a4ee-374d-8cc3-bea7e8204d4f",
                                                "text": "Ou, peut-être, crispées parce que par la porte du cabinet on entendait le vrombissement de la fraise dentaire. Il ressemblait au bruit d’une scie à bois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
