                ],
                "senses": [
                    {
                        "sense_id": "dc1180d2-ff25-3771-b3c2-a58e5fb44a43",
                        "entry_id": "0326675d-0fd3-3877-9698-7fc1e93fcc8b",
                        "glosses": [
                            "Qui a quitté son pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45c04aae-9143-4efd-b536-208ed7fd9971",
                                "sense_id": "dc1180d2-ff25-3771-b3c2-a58e5fb44a43",
                                "text": "Comment parler des odyssées souvent anonymes de ces Chinois émigrés en Asie du Sud, de Java aux Philippines, tant ils furent nombreux et précoces ? Dès le début du XVᵉ siècle, la flotte de Zheng He en rencontre dans les îles de Java, de Sumatra et ailleurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e296bb76-39a4-4818-9c21-499fbaf2aafa",
                        "source_entry_id": "0326675d-0fd3-3877-9698-7fc1e93fcc8b",
                        "source_sense_id": "dc1180d2-ff25-3771-b3c2-a58e5fb44a43",
                        "source_sense_description": "Qui a quitté son pays",
                        "target_lang_word": "Auswanderer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auswanderer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9783a15-9883-38fd-bf38-1f30d3baaaad",
                                        "entry_id": "997a6d2e-3f5d-3be1-a423-bb8acabb0d61",
                                        "glosses": [
                                            "Person, die ihr Land aus wirtschaftlichen und/oder persönlichen Gründen freiwillig verlässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b181b8b4-6fca-4385-b2f8-66d4a4021456",
                                                "sense_id": "a9783a15-9883-38fd-bf38-1f30d3baaaad",
                                                "text": "Auswanderer freuen sich, ihr altes Zuhause hinter sich zu lassen und erwarten eine bessere Zukunft."
                                            },
                                            {
                                                "example_id": "8632782e-fd1e-4a9c-a537-117df0342330",
                                                "sense_id": "a9783a15-9883-38fd-bf38-1f30d3baaaad",
                                                "text": "„Die Auswanderer wissen nur ungefähr, wo sich das verheißungsvolle Eiland befindet, denn Kompass und Seekarten kennen sie nicht.“"
                                            },
                                            {
                                                "example_id": "b8e73047-83fc-4ce6-b05e-9e0604bd29f1",
                                                "sense_id": "a9783a15-9883-38fd-bf38-1f30d3baaaad",
                                                "text": "„Ich frage mich, ob die Auswanderer bei ihrem Tausch nicht den Kürzeren gezogen haben.“"
                                            },
                                            {
                                                "example_id": "cc15c8c2-7aed-4d11-a3ef-a5878576e2c8",
                                                "sense_id": "a9783a15-9883-38fd-bf38-1f30d3baaaad",
                                                "text": "„Nachdem die Ernte in Irland zum wiederholten Mal von der Kartoffelfäule vernichtet wurde, stieg die Zahl der Auswanderer beträchtlich.“"
                                            },
                                            {
                                                "example_id": "7dd52443-a879-4a57-af2a-2c56747d535c",
                                                "sense_id": "a9783a15-9883-38fd-bf38-1f30d3baaaad",
                                                "text": "„In der neuen Heimat gaben die Auswanderer ihre zumeist westjiddischen Dialekte in kurzer Zeit zugunsten des Deutschen oder Englischen auf, auch wenn sie untereinander weiterhin jiddische Ausdrücke benutzten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87384ba1-73ac-4905-8219-15d41ba69b3d",
                        "source_entry_id": "0326675d-0fd3-3877-9698-7fc1e93fcc8b",
                        "source_sense_id": "dc1180d2-ff25-3771-b3c2-a58e5fb44a43",
                        "source_sense_description": "Qui a quitté son pays",
                        "target_lang_word": "Emigrant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emigrant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35aa6d54-e98f-384e-bed3-f2a35712a272",
                                        "entry_id": "9513bb93-4192-320c-b415-0c09496ae3a1",
                                        "glosses": [
                                            "Auswanderer, besonders aus politischen oder religiösen Gründen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9995fd1c-b081-4acd-8cb7-d3c8ae283f13",
                                                "sense_id": "35aa6d54-e98f-384e-bed3-f2a35712a272",
                                                "text": "Viele Emigranten verlassen jedes Jahr Deutschland."
                                            },
                                            {
                                                "example_id": "2e20fa8c-e02d-4fb2-b742-346a3342e58e",
                                                "sense_id": "35aa6d54-e98f-384e-bed3-f2a35712a272",
                                                "text": "„Noch kann sie nicht nachempfinden, was es heißt, Emigrant zu sein, ein Heimatloser unter lauter Inländern.“"
                                            },
                                            {
                                                "example_id": "d0152abf-288b-4dc3-9ad5-057641bb53bd",
                                                "sense_id": "35aa6d54-e98f-384e-bed3-f2a35712a272",
                                                "text": "„Aber wir sind Emigranten, und für Emigranten sind alle Länder gefährlich, viele Minister halten Reden gegen uns, und niemand will uns haben, dabei tun wir gar nichts Böses und sind genau wie alle anderen Menschen.“"
                                            },
                                            {
                                                "example_id": "e954d028-7535-4e6d-a984-4cb8f5e48af1",
                                                "sense_id": "35aa6d54-e98f-384e-bed3-f2a35712a272",
                                                "text": "„Emigranten hatten allerlei Geschichten über den Blutsonntag mitgebracht, über die Bombe, die Boruch Schulman auf die Polizisten geschleudert hatte, über die Demonstrationen, die Streiks, die Massenverhaftungen.“"
                                            },
                                            {
                                                "example_id": "5ba4316d-90ef-4080-9090-a835e1340662",
                                                "sense_id": "35aa6d54-e98f-384e-bed3-f2a35712a272",
                                                "text": "„Einen tiefen Eindruck machen auf ihn russische Emigranten, wie die Autoren Leo Schestow und Iwan Bunin.“"
                                            },
                                            {
                                                "example_id": "11b3be9a-fa8b-4e25-8a96-871121301d76",
                                                "sense_id": "35aa6d54-e98f-384e-bed3-f2a35712a272",
                                                "text": "„Biddle, mit dem ich über die den >enemy aliens<, besonders den deutschen Emigranten, auferlegten Einschränkungen korrespondiert hatte, gab mir seine Absicht kund, diese Beengungen baldigst aufzuheben. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
