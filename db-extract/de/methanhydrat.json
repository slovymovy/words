                "senses": [
                    {
                        "sense_id": "9b5a044e-907b-301c-ba9b-7246d0660140",
                        "entry_id": "a024c1cf-be43-3fe3-85cd-6d2db356e29a",
                        "glosses": [
                            "in gefrorenes Wasser eingelagertes Methan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2556a19f-5965-4240-9430-758aad65a427",
                                "sense_id": "9b5a044e-907b-301c-ba9b-7246d0660140",
                                "text": "„Als verheißungsvolle Energiequelle, vor allem aber als Klimafaktor ersten Ranges haben Geowissenschaftler das Methanhydrat zunehmend ins Visier genommen.“"
                            },
                            {
                                "example_id": "607fa61a-bf4e-4d87-a6fe-b89950c80145",
                                "sense_id": "9b5a044e-907b-301c-ba9b-7246d0660140",
                                "text": "„Häufig sind Methanhydrate, die aufgrund ihrer physikalischen Stabilitätsbedingungen prinzipiell in Meeressedimenten sowie in Permafrostböden der polaren Regionen vorkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
