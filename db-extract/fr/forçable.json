                "senses": [
                    {
                        "sense_id": "17977c5f-0d19-3d59-bc88-0d023846bd1f",
                        "entry_id": "ebc7857c-6c6f-397c-9004-5428ea39b961",
                        "glosses": [
                            "Qui peut être forcé, pris ou ouvert par force."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50210e07-c7fa-46f2-a067-33c699878ab4",
                                "sense_id": "17977c5f-0d19-3d59-bc88-0d023846bd1f",
                                "text": "Neantmoins les dites forces qu’il avoit, il rendit la ville qui n’estoit forçable."
                            },
                            {
                                "example_id": "08b0c5f3-bb75-4555-af71-cb4f02da20f7",
                                "sense_id": "17977c5f-0d19-3d59-bc88-0d023846bd1f",
                                "text": "Cependant, il s’agit d’un rangement d’appoint dans lequel il vaut mieux éviter de laisser des objets de valeur car il est facilement forçable... dommage!"
                            },
                            {
                                "example_id": "8555a475-08d3-48ff-98ea-fd96bd5c0a06",
                                "sense_id": "17977c5f-0d19-3d59-bc88-0d023846bd1f",
                                "text": "On donne quatre conseils aux cyclistes. Le premier c'est d’attacher son vélo avec un antivol en U, parce que c’est le seul qui est difficilement forçable, c’est le plus efficace."
                            }
                        ]
                    },
                    {
                        "sense_id": "03748d2b-0e33-32ba-ac3a-18aadea4d64d",
                        "entry_id": "ebc7857c-6c6f-397c-9004-5428ea39b961",
                        "glosses": [
                            "Dont on peut forcer la croissance."
                        ],
                        "tags": [],
                        "examples": [
                            {
