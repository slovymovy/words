                "senses": [
                    {
                        "sense_id": "796ba964-ee84-3ce2-819e-52606fcde4cf",
                        "entry_id": "4747bd91-20ad-3168-b1dd-fcb1bb26d56c",
                        "glosses": [
                            "ein Lehrer, der Geschichte unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f63cd521-1092-461e-a5b7-52ffd7dfe7ca",
                                "sense_id": "796ba964-ee84-3ce2-819e-52606fcde4cf",
                                "text": "Um sich die Reise zu finanzieren, arbeitet er als Geschichtslehrer an einer Nachhilfeschule."
                            },
                            {
                                "example_id": "bec86f7b-3ad9-4a89-9857-edb0a8ceb54a",
                                "sense_id": "796ba964-ee84-3ce2-819e-52606fcde4cf",
                                "text": "„Mein Geschichtslehrer erklärte eines Tages, dass Bulgarien im 10. Jahrhundert das größte Königreich auf dem Balkan gewesen war.“"
                            },
                            {
                                "example_id": "9f96b2ea-f838-4163-a280-4b001d3b94f4",
                                "sense_id": "796ba964-ee84-3ce2-819e-52606fcde4cf",
                                "text": "„Der neue Geschichtslehrer hatte den Krieg mitgemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
