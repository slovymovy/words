                            },
                            {
                                "target_lang_word": "大腿后侧肌肉",
                                "target_lang_sense_clarification": "强调后侧肌肉部位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "293ce882-eb7d-3d79-a9c2-544238d198c5",
                    "sense_definition": "Electronic mail that is desired by the recipient, as opposed to spam.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The filter is designed to distinguish between spam and <w>ham</w> messages.",
                            "target_lang_translations": {
                                "ru": "Фильтр предназначен для того, чтобы отличать спам от <w>полезных писем</w>.",
                                "zh": "这个过滤器是用来区分垃圾邮件和<w>正常邮件</w>的。"
                            }
                        },
                        {
                            "text": "We need to ensure that legitimate <w>ham</w> does not get blocked by the firewall.",
                            "target_lang_translations": {
                                "ru": "Нам нужно убедиться, что легитимная <w>почта</w> не блокируется брандмауэром.",
                                "zh": "我们得确保合法的<w>非垃圾邮件</w>不会被防火墙拦截。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ham e-mail"
                    ],
                    "antonyms": [
                        "spam",
                        "junk mail"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "technical jargon in computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронная почта, желаемая получателем, в отличие от спама.",
                        "zh": "收件人希望收到的电子邮件，与垃圾邮件相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хам",
                                "target_lang_sense_clarification": "технический термин для полезной почты"
                            },
                            {
                                "target_lang_word": "легитимное письмо",
                                "target_lang_sense_clarification": "не спам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正常邮件",
                                "target_lang_sense_clarification": "与垃圾邮件相对的正常电子邮件"
                            },
                            {
                                "target_lang_word": "非垃圾邮件",
                                "target_lang_sense_clarification": "技术语境中指不是垃圾邮件的邮件"
                            },
                            {
                                "target_lang_word": "有效邮件",
                                "target_lang_sense_clarification": "强调收件人希望收到的合法邮件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
