                    {
                        "translation_id": "aec05bd1-40e3-4efc-a18d-52c7137a02e7",
                        "source_entry_id": "b6ecda6b-4e04-30ec-b4c7-5aaff5d65273",
                        "source_sense_id": "218301af-8b71-3d3a-a8e9-d50f2bcb843a",
