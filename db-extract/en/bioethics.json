    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "83321800-5fd3-35e3-8f12-b01d99116b9a",
                "word": "bioethics",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3b495e28-d479-3cf3-b4d9-7f4a55dd3b45",
                        "entry_id": "83321800-5fd3-35e3-8f12-b01d99116b9a",
                        "glosses": [
                            "The branch of ethics that studies the implications of biological and biomedical advances."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a12b7018-83de-4a14-944a-c0d184a11633",
                                "sense_id": "3b495e28-d479-3cf3-b4d9-7f4a55dd3b45",
                                "text": "This graded appreciation of the developing moral status of human life, especially during its prenatal stages, is deeply relevant to some of the most important bioethics debates of our day."
                            },
                            {
                                "example_id": "a2b1f99d-652a-4f0a-9432-98382b261ebc",
                                "sense_id": "3b495e28-d479-3cf3-b4d9-7f4a55dd3b45",
                                "text": "2006, Florencia Luna, Arleen L. F. Salles, One: Latin American Bioethics: Some Reflections, Florencia Luna (editor), Bioethics and Vulnerability: A Latin American View, page 9,\nBioethics has been defined as the critical and systematic reflection on ethical issues in healthcare, biological and medical research, and public health. […] In the United States, the emergence of modern bioethics has been characterized by a shift away from the religious and medical considerations that initially dominated the discourse to more philosophical and legal concepts."
                            },
                            {
                                "example_id": "db9b8c52-7a91-4984-9be6-513e447bf505",
                                "sense_id": "3b495e28-d479-3cf3-b4d9-7f4a55dd3b45",
                                "text": "Despite the enormous breadth of bioethics, which ranges from interpersonal conflicts in medical practice, to ethical issues in animal and human subjects research, to policy formation in health care and the sciences, the bioethics field may be united by two common characteristics.\nFirst, bioethics is by nature a highly interdisciplinary activity.[…]Secondly, biothics tends to be practiced today along the main modalities of the ethics of modernity."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b723a5ff-53c6-456b-bcf2-f1d10a6392ae",
                        "source_entry_id": "83321800-5fd3-35e3-8f12-b01d99116b9a",
                        "source_sense_id": "3b495e28-d479-3cf3-b4d9-7f4a55dd3b45",
                        "source_sense_description": "branch of ethics",
                        "target_lang_word": "bio-ethiek",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bio-ethiek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "70ec77f2-9e3e-3fc3-8d71-63d57fdfa157",
                                        "entry_id": "d08d8dce-1f73-340d-b6d7-af548871c173",
                                        "glosses": [
                                            "een tak van de moraalwetenschap, die zich bezighoudt met de ethische aspecten van menselijke ingrepen in het menselijk leven en het leven van dieren en planten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e23b5045-cbb4-4e81-8ae3-6a5b2502c8a1",
                                                "sense_id": "70ec77f2-9e3e-3fc3-8d71-63d57fdfa157",
                                                "text": "Claire studeerde internationale communicatiewetenschappen en werkte aan een proefschrift over bio-ethiek toen het stel trouwde, in september vorig jaar. In januari werd bekend dat ze in verwachting was."
                                            },
                                            {
                                                "example_id": "2de10a79-eb38-4a48-9921-ada41f0c3f41",
                                                "sense_id": "70ec77f2-9e3e-3fc3-8d71-63d57fdfa157",
                                                "text": "Al die runderen, kippen en varkens verbranden levend, stikken in de rook of overlijden aan verwondingen. \"Ze creperen en sterven een ontzettend pijnlijke dood\", zegt hoogleraar bio-ethiek Bart Gremmen (WUR)."
                                            },
                                            {
                                                "example_id": "c5f28f1d-bc52-476f-8590-95cd439c75ae",
                                                "sense_id": "70ec77f2-9e3e-3fc3-8d71-63d57fdfa157",
                                                "text": "Vanuit de biologie en vanuit de technologie is dit een doorbraak, vindt Ellen ter Gast, docent bio-ethiek aan de universiteit Leiden. Belangrijk aan het onderzoek is dat er volgens haar er 'op een hele nette manier' is geknipt en geplakt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3720ba93-ee3c-4ec6-ac64-051efcb952cf",
                        "source_entry_id": "83321800-5fd3-35e3-8f12-b01d99116b9a",
                        "source_sense_id": "3b495e28-d479-3cf3-b4d9-7f4a55dd3b45",
                        "source_sense_description": "branch of ethics",
                        "target_lang_word": "Bioethik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bioethik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3101bdf7-7b10-38b4-a557-1a1ebd64ccef",
                                        "entry_id": "cd54e5c2-dc2e-333c-8a9b-8218f85a6b1b",
                                        "glosses": [
                                            "am Autonomiebegriff des Individuums oder am Begriff des Lebens orientierte Ethik, die Zweckbestimmungen unseres Handelns in Bezug auf das Leben zu liefern versucht"
                                        ],
                                        "tags": [
                                            "Praktische Philosophie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acf30b4a-8634-4667-808f-ced8962591f3",
                                                "sense_id": "3101bdf7-7b10-38b4-a557-1a1ebd64ccef",
                                                "text": "„Auch in der Bioethik zählt das Autonomieprinzip zu den tragenden Säulen ethischer Orientierung. Man kann sogar sagen, daß das Bedürfnis der „Autonomie“ eines der entscheidenden Motive bei der Entstehung der Bioethik in der Mitte des 20. Jahrhunderts war: ging es hier doch nicht zuletzt darum, „heteronome“ Verhältnisse, sei es im Sinne eines medizinischen Paternalismus, sei es im Sinne eines blinden Szientismus und einer daraus abgeleiteten gesamtgesellschaftlichen rein utilitaristischen Praxis im Umgang mit den Menschen, aufzubrechen […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
