                                "sense_id": "8b4d60bd-53a1-3e3b-a048-38b2a1cb7b1f",
                                "text": "The understage being only 9 feet (5 braccia) high, the mountain had to rise in telescoping stages"
                            },
                            {
                                "example_id": "4c4baf39-061d-41a6-a214-1d85685f6b73",
                                "sense_id": "8b4d60bd-53a1-3e3b-a048-38b2a1cb7b1f",
                                "text": "dozens of strapping stage-hands in the understage manipulating warships, cannons dispatching balls of fire, blue smoke."
                            }
                        ]
