{
    "word_family": [
        "clinic",
        "clinician",
        "clinically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c7bde463-0481-39b8-8534-2e241063d19f",
                    "sense_definition": "Relating to the examination and treatment of patients rather than theoretical studies or research.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "medical_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor has extensive <w>clinical</w> experience in treating this disease.",
                            "target_lang_translations": {
                                "ru": "У врача есть обширный <w>клинический</w> опыт лечения этого заболевания.",
                                "zh": "这位医生在治疗这种疾病方面拥有丰富的<w>临床</w>经验。"
                            }
                        },
                        {
                            "text": "She is a <w>clinical</w> psychologist who helps people manage their anxiety.",
                            "target_lang_translations": {
                                "ru": "Она <w>клинический</w> психолог, который помогает людям справляться с тревожностью.",
                                "zh": "她是一位<w>临床</w>心理学家，致力于帮助人们缓解焦虑。"
                            }
                        }
                    ],
                    "antonyms": [
                        "nonclinical"
                    ],
                    "common_phrases": [
                        "clinical trial",
                        "clinical practice",
                        "clinical research",
                        "clinical psychology",
                        "clinical depression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к обследованию и лечению пациентов, а не к теоретическим исследованиям.",
                        "zh": "与病人的检查和治疗有关，而非理论研究或学术探讨。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клинический",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "临床",
                                "target_lang_sense_clarification": "医学领域中与病人诊疗相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "035c434d-f7c6-374f-be45-04040dd57dcc",
                    "sense_definition": "Showing no emotion or sympathy; cold, objective, and detached.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He described the accident with <w>clinical</w> detachment, showing no sign of sadness.",
                            "target_lang_translations": {
                                "ru": "Он описал аварию с <w>холодной</w> отстраненностью, не выказывая признаков печали.",
                                "zh": "他以一种<w>冷漠</w>的超然态度描述了那场事故，没有流露出任何悲伤。"
                            }
                        },
                        {
                            "text": "Her assessment of the situation was cold and <w>clinical</w>.",
                            "target_lang_translations": {
                                "ru": "Её оценка ситуации была холодной и <w>бесстрастной</w>.",
                                "zh": "她对局势的评估既冷酷又<w>客观</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unemotional",
                        "detached",
                        "dispassionate",
                        "emotionless",
                        "cold-blooded",
                        "unsentimental",
                        "unfeeling"
                    ],
                    "common_phrases": [
                        "clinical detachment",
                        "clinical coolness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не проявляющий эмоций или сочувствия; холодный, объективный и отстраненный.",
                        "zh": "不带感情或同情心；冷漠、客观且疏离。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бесстрастный",
                                "target_lang_sense_clarification": "лишенный эмоций"
                            },
                            {
                                "target_lang_word": "холодный",
                                "target_lang_sense_clarification": "об отношении или взгляде"
                            },
                            {
                                "target_lang_word": "сухой",
                                "target_lang_sense_clarification": "сдержанный, безэмоциональный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冷漠",
                                "target_lang_sense_clarification": "形容态度冷淡、不带感情"
                            },
                            {
                                "target_lang_word": "客观",
                                "target_lang_sense_clarification": "形容不带个人情感的评价"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80072345-21a7-376a-87ca-3ef3af1cace4",
                    "sense_definition": "Very efficient, accurate, and effective, often without making mistakes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team produced a <w>clinical</w> performance to win the championship match.",
                            "target_lang_translations": {
                                "ru": "Команда показала <w>безупречную</w> игру и выиграла финальный матч.",
                                "zh": "该队表现<w>完美</w>，赢得了冠军赛。"
                            }
                        },
                        {
                            "text": "She executed the project plan with <w>clinical</w> precision.",
                            "target_lang_translations": {
                                "ru": "Она выполнила план проекта с <w>хирургической</w> точностью.",
                                "zh": "她以<w>精准</w>的执行力完成了项目计划。"
                            }
                        }
                    ],
                    "synonyms": [
                        "accurate",
                        "exact"
                    ],
                    "common_phrases": [
                        "clinical finish",
                        "clinical precision",
                        "clinical execution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень эффективный, точный и результативный, часто безошибочный.",
                        "zh": "非常高效、准确且有效，通常指表现完美无瑕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безупречный",
                                "target_lang_sense_clarification": "об исполнении или качестве"
                            },
                            {
                                "target_lang_word": "точный",
                                "target_lang_sense_clarification": "аккуратный, выверенный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精准",
                                "target_lang_sense_clarification": "形容动作或执行非常准确"
                            },
                            {
                                "target_lang_word": "完美",
                                "target_lang_sense_clarification": "形容表现无懈可击"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "343b5b2c-271a-36c0-986c-8c4a98ded2c6",
                    "sense_definition": "A period of practical training in a hospital for medical students.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_training",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Medical students often find their first <w>clinicals</w> very stressful but rewarding.",
                            "target_lang_translations": {
                                "ru": "Студенты-медики часто находят свою первую <w>клиническую практику</w> очень напряженной, но полезной.",
                                "zh": "医学生通常觉得第一次<w>临床实习</w>压力很大，但收获颇丰。"
                            }
                        },
                        {
                            "text": "He is currently doing his <w>clinicals</w> in the surgery department.",
                            "target_lang_translations": {
                                "ru": "В настоящее время он проходит <w>клиническую практику</w> в хирургическом отделении.",
                                "zh": "他目前正在外科部门进行<w>临床实习</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "do clinicals",
                        "start clinicals"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Период практического обучения студентов-медиков в больнице.",
                        "zh": "医学生在医院进行的临床实习阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клиническая практика",
                                "target_lang_sense_clarification": "учебная практика в больнице"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "临床实习",
                                "target_lang_sense_clarification": "医学生的医院实践训练"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}