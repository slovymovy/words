                "senses": [
                    {
                        "sense_id": "848481d6-2675-311f-aa3c-0463e70cfb6b",
                        "entry_id": "dcf99e20-6a9c-3066-a1e5-c1c931767529",
                        "glosses": [
                            "op een voet van gelijkheid, zonder afstand mensen benaderen of benaderd worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "513b4e06-50f8-45d9-a470-abe3c1281414",
                                "sense_id": "848481d6-2675-311f-aa3c-0463e70cfb6b",
                                "text": "Duys bedacht ook het archaïsch aandoende pseudoniem Drs. P - tot genoegen van de betrokkene, die liever niet als populair artiest op de schouders wilde worden geslagen of gehesen en ook niet voor iedereen gemeenzaam Heinz wenste te heten: „Het pseudoniem schept afstand. Daarbij had het voorvoegsel doctorandus iets komieks waarin ik mij zeer goed kon vinden.”"
                            },
                            {
                                "example_id": "7fc95812-ae05-4877-bf64-ad6d1780efcc",
                                "sense_id": "848481d6-2675-311f-aa3c-0463e70cfb6b",
                                "text": "Albert Heijn, de beste supermarkt van Nederland, is een reus. In sommige kringen wordt gemeenzaam gesproken van boodschappen doen bij 'Appie', maar winkelen bij deze reus geeft status."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6839c5a9-f2fb-46ef-b563-d0b6021fe9ea",
                        "source_entry_id": "dcf99e20-6a9c-3066-a1e5-c1c931767529",
                        "source_sense_id": "848481d6-2675-311f-aa3c-0463e70cfb6b",
                        "source_sense_description": "op een voet van gelijkheid, zonder afstand",
                        "target_lang_word": "familiar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "familiar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5889e5b-fd3d-30c5-a943-300a70e47d10",
                                        "entry_id": "61707c59-7fe6-3fc9-b805-cc25bc7205d0",
                                        "glosses": [
                                            "Known to one, or generally known; commonplace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea61d5be-f9be-487d-9565-1ab679e9ad9b",
                                                "sense_id": "b5889e5b-fd3d-30c5-a943-300a70e47d10",
                                                "text": "There’s a familiar face; that tune sounds familiar."
                                            },
                                            {
                                                "example_id": "9b8c136c-a2e8-4300-85ac-dc2c9e3f6166",
                                                "sense_id": "b5889e5b-fd3d-30c5-a943-300a70e47d10",
                                                "text": "The story struck the depressingly familiar note with which true stories ring in the tried ears of experienced policemen. No one queried it. It was in the classic pattern of human weakness, mean and embarrassing and sad."
                                            },
                                            {
                                                "example_id": "43f5b669-b924-4321-88f5-ec556c5bb4e7",
                                                "sense_id": "b5889e5b-fd3d-30c5-a943-300a70e47d10",
                                                "text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9381e1c-8ae4-30c4-9373-59d782d7f448",
                                        "entry_id": "61707c59-7fe6-3fc9-b805-cc25bc7205d0",
                                        "glosses": [
                                            "Acquainted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7358f58-cb78-4b2c-a834-ecc571906571",
                                                "sense_id": "b9381e1c-8ae4-30c4-9373-59d782d7f448",
                                                "text": "I'm quite familiar with this system; she's not familiar with manual gears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4a8f5ff-c7d7-3bf2-9425-0d8f700482ca",
                                        "entry_id": "61707c59-7fe6-3fc9-b805-cc25bc7205d0",
                                        "glosses": [
                                            "Intimate or friendly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c650cc-ae1a-46a5-a032-7d14049f2eea",
                                                "sense_id": "e4a8f5ff-c7d7-3bf2-9425-0d8f700482ca",
                                                "text": "We are on familiar terms now; our neighbour is not familiar"
                                            },
                                            {
                                                "example_id": "3b7a238d-4729-459b-bc93-78d5b0b2bb4b",
                                                "sense_id": "e4a8f5ff-c7d7-3bf2-9425-0d8f700482ca",
                                                "text": "Don’t be familiar with me, boy!"
                                            },
                                            {
                                                "example_id": "b89131d1-1c71-4c66-b6ba-b1a9aefe22f3",
                                                "sense_id": "e4a8f5ff-c7d7-3bf2-9425-0d8f700482ca",
                                                "text": "Be thou familiar; but by no meanes vulgar:[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03854025-e6b5-37cf-bc60-5573d3cb9ae4",
                                        "entry_id": "61707c59-7fe6-3fc9-b805-cc25bc7205d0",
                                        "glosses": [
                                            "Of or pertaining to a family; familial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f43461-5d88-4199-825f-4fa1aae2c7b0",
                                                "sense_id": "03854025-e6b5-37cf-bc60-5573d3cb9ae4",
                                                "text": "1822, Lord Byron, Werner\nfamiliar feuds"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "familiar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1233320-cf04-3ece-bffc-5156181fed63",
                                        "entry_id": "712cd33e-0e4e-337a-b9fa-3dc38c823c23",
                                        "glosses": [
                                            "An attendant spirit, often in animal or demon form."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa87ac3a-9bd4-428a-b18e-ef2437040230",
                                                "sense_id": "d1233320-cf04-3ece-bffc-5156181fed63",
                                                "text": "The witch’s familiar was a black cat."
                                            },
                                            {
                                                "example_id": "08e390de-932a-4d1a-97f7-726b36841c5a",
                                                "sense_id": "d1233320-cf04-3ece-bffc-5156181fed63",
                                                "text": "The familiars of the magicians, on the other hand, were not in all cases evil, and often may have approximated the \"guides\" with whom present-day spiritualists are well acquainted."
                                            },
                                            {
                                                "example_id": "c602072e-1d42-48ef-8038-44527a882244",
                                                "sense_id": "d1233320-cf04-3ece-bffc-5156181fed63",
                                                "text": "\"What power hath gold?\" Catweazle wondered as he picked up his familiar and put him in his special pocket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eca9de30-dc3f-383e-b3e8-36914bd3ecec",
                                        "entry_id": "712cd33e-0e4e-337a-b9fa-3dc38c823c23",
                                        "glosses": [
                                            "A member of one's family or household."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f7509c3-77f9-3bce-841c-20e5a0f60e8b",
                                        "entry_id": "712cd33e-0e4e-337a-b9fa-3dc38c823c23",
                                        "glosses": [
                                            "A member of a pope's or bishop's household."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d710bc53-f47c-3175-986e-8baa678020de",
                                        "entry_id": "712cd33e-0e4e-337a-b9fa-3dc38c823c23",
                                        "glosses": [
                                            "A close friend."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "220a3b48-1e7f-42b4-8495-88abbff76ec1",
                                                "sense_id": "d710bc53-f47c-3175-986e-8baa678020de",
                                                "text": "[A] friend of mine, that finding a Receipt in Braſsivola, would needs take Hellebor in ſubſtance, & try it on his own perſon; but had not ſome of his familiars come to viſite him by chance, he had by his indiſcretion hazarded himſelfe; many ſuch I have obſerued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2480aa6b-3e30-3aca-946a-128d59af04c8",
