                        "examples": [
                            {
                                "example_id": "6aa5a9f1-4448-45ba-8f0f-383ce8f779f8",
                                "sense_id": "786804e8-ce49-3fd8-b967-10f0a9077972",
                                "text": "\"De zomerwei, des ochtends vroeg ...\" is een boek van Vasalis."
                            },
                            {
                                "example_id": "ff29dbf8-eb7c-4eb7-ac5f-b167da6831f2",
                                "sense_id": "786804e8-ce49-3fd8-b967-10f0a9077972",
                                "text": "Ik zette er flink de pas in en na een tijdje begon ik bijna te rennen want ik kon de hamburgers al ruiken! ’s Ochtends om tien over negen viel ik het beroemde café binnen en zette met een zucht mijn rugzak op de grond."
                            },
                            {
                                "example_id": "d9f0841a-7a20-429d-ad3a-323232bf849b",
                                "sense_id": "786804e8-ce49-3fd8-b967-10f0a9077972",
                                "text": "Ze laat de dikke, eikenhouten deur van haar slaapkamer op een kiertje staan en hangt haar sleutel ernaast, maar als ze 's ochtends wakker wordt, is die onaangeraakt, net als zij."
                            }
                        ]
                    }
