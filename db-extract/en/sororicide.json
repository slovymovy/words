                        "entry_id": "ad37c2f0-a80c-3822-a842-015ea45bb2ce",
                        "glosses": [
                            "The killing of one's sister."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "50bcf29f-0399-4af7-bad2-e8d6fe949f1d",
                                "sense_id": "a822bbf1-54d7-3ba7-b2af-ac6017cff917",
                                "text": "Terms related to familicide include filicide (the killing of one's child or children), uxoricide (the killing of one's wife), fratricide or sororicide (the killing of one's brother or sister), avunculicide (the killing of one's uncle), and nepoticide (the killing of one's nephew)."
                            }
                        ]
                    }
                ],
