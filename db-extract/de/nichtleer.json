                "senses": [
                    {
                        "sense_id": "4321e0a1-15d4-3809-9982-e0b64f6a6d49",
                        "entry_id": "544d0495-ce2c-3370-899c-18e7d11beb20",
                        "glosses": [
                            "ungleich leer, zum Beispiel ungleich der leeren Menge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59ffc96e-d96d-4b9d-898a-c3f66b92d855",
                                "sense_id": "4321e0a1-15d4-3809-9982-e0b64f6a6d49",
                                "text": "Jede nichtleere, nach oben beschränkte Teilmenge von ℝ hat ein Supremum in ℝ."
                            },
                            {
                                "example_id": "208b4f59-8f6d-4033-852e-be6226d56731",
                                "sense_id": "4321e0a1-15d4-3809-9982-e0b64f6a6d49",
                                "text": "„In der Topologie und Analysis bezeichnet der Begriff Gebiet eine offene, nichtleere und zusammenhängende Teilmenge eines topologischen Raumes.“"
                            },
                            {
                                "example_id": "00946096-ab3a-4a78-9491-487769bd4730",
                                "sense_id": "4321e0a1-15d4-3809-9982-e0b64f6a6d49",
                                "text": "„Eine Dezimalzahl wird als nichtleeres Wort von Dezimalziffern beschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
