                                "target_senses": [
                                    {
                                        "sense_id": "c10a364e-1f4c-34eb-b26f-678913fdae61",
                                        "entry_id": "a1dd2acc-65f0-3237-8d6e-6fb97a9fd867",
                                        "glosses": [
                                            "Action de disperser, de se disperser ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6965417-b1ab-4bc0-9152-e1da9bd93cda",
                                                "sense_id": "c10a364e-1f4c-34eb-b26f-678913fdae61",
                                                "text": "– Et quelle nouvelle apportes-tu d’York, brave comte ? demanda Ivanhoé ; les rebelles nous y attendront-ils ?\n– Pas plus que la neige de décembre n’attend le soleil de juillet, dit le comte ; ils sont en pleine dispersion."
                                            },
                                            {
                                                "example_id": "f94c6be5-8f7c-4d75-a3ff-eab1de2651af",
                                                "sense_id": "c10a364e-1f4c-34eb-b26f-678913fdae61",
                                                "text": "Que le rural soit plus confiant et qu'il utilise, de plus en plus, l'électricité dans l'exécution de ses travaux, alors les inconvénients que représente la dispersion des abonnés disparaîtront."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1137a423-cfb3-4490-98ca-3766af09828d",
                        "source_entry_id": "ea8db300-dc7b-3cfc-9ce7-a68bdfebd518",
                        "source_sense_description": "state",
                        "target_lang_word": "Verteilung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verteilung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9a6ef78-3df4-343e-8661-82987daed958",
                                        "entry_id": "5512200e-b3d2-3b54-b73f-237fa8c0d558",
                                        "glosses": [
                                            "Vorgang des Verteilens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca128ffb-d91d-4b45-93ed-967387b9a0ac",
                                                "sense_id": "c9a6ef78-3df4-343e-8661-82987daed958",
                                                "text": "Es wird langsam Zeit für die Verteilung der Prospekte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dae9c0a5-1066-3193-a92e-adf5812b0d57",
                                        "entry_id": "5512200e-b3d2-3b54-b73f-237fa8c0d558",
                                        "glosses": [
                                            "Ergebnis des Verteilens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f726782a-ad1b-4c97-936b-b7c673cf1978",
                                                "sense_id": "dae9c0a5-1066-3193-a92e-adf5812b0d57",
                                                "text": "In der Bundesrepublik gibt es eine sehr ungleiche Verteilung der Vermögen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9560fcbd-7068-3fe3-b3ea-823adb7f2099",
                                        "entry_id": "5512200e-b3d2-3b54-b73f-237fa8c0d558",
                                        "glosses": [
                                            "Anordnung der Gegenstände eines Gegenstandsbereichs entsprechend einem bestimmten Prinzip"
                                        ],
                                        "tags": [
                                            "Statistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4171a011-9239-40cf-8524-21cdc6e77ef1",
                                                "sense_id": "9560fcbd-7068-3fe3-b3ea-823adb7f2099",
                                                "text": "„Eine weitere Größe einer jeden Verteilung ist die sogenannte Streuung.“"
                                            },
                                            {
                                                "example_id": "cc6c36f0-0432-4985-904d-f4fba6988288",
                                                "sense_id": "9560fcbd-7068-3fe3-b3ea-823adb7f2099",
                                                "text": "„Im vorhergehenden Abschnitt wurde dargestellt, daß ein Überblick über eine Verteilung durch den Mittelwert und die Streuung erhalten werden kann.“"
                                            },
                                            {
                                                "example_id": "947c0479-52b2-4cea-adde-246cfbe2c5d6",
                                                "sense_id": "9560fcbd-7068-3fe3-b3ea-823adb7f2099",
                                                "text": "„Man kann Verteilungen nicht nur für rhythmische Erscheinungen aufstellen, sondern für alles, was variabel ist, und daher ergibt sich hier ein breites Forschungsfeld.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4db737f-d64b-4c88-9a02-49678fcd4806",
                        "source_entry_id": "ea8db300-dc7b-3cfc-9ce7-a68bdfebd518",
