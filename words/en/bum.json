                    "sense_definition": "Unfair, unpleasant, or of poor quality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "quality_bad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We got a <w>bum</w> deal from that salesman and lost a lot of money.",
                            "target_lang_translations": {
                                "ru": "Мы получили <w>паршивую</w> сделку от этого продавца и потеряли кучу денег.",
                                "zh": "那个推销员给了我们一笔<w>糟糕</w>的交易，我们损失了很多钱。"
                            }
                        },
                        {
