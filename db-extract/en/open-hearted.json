                        "entry_id": "85335822-442f-30a5-bfb5-bc300965c8d4",
                        "glosses": [
                            "Frank and candidly straightforward"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93f77642-0dc6-4c56-b4b5-a2c4ed3bc0fa",
                                "sense_id": "b0001dc4-7235-3423-9a88-5582f7a89d0e",
                                "text": "I myself consider the interviews to be of good quality, most of them even very extensive and openhearted. Openhearted, yes, but not on everything. It is a positivist naivete to take what people say as simple truth."
                            }
                        ]
                    },
                    {
                        "sense_id": "420f4ee9-b971-35ad-8cef-5c7e01b7fd14",
                        "entry_id": "85335822-442f-30a5-bfb5-bc300965c8d4",
                        "glosses": [
                            "Generous and kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94e6eda4-1faf-4e92-8058-5f5577198d1c",
                                "sense_id": "420f4ee9-b971-35ad-8cef-5c7e01b7fd14",
                                "text": "Sally was generous and open-hearted to the point of foolishness, but that was her experience."
                            }
                        ]
                    },
                    {
                        "sense_id": "ade8cb79-1ac7-3860-91f5-b21ef8c84fe7",
                        "entry_id": "85335822-442f-30a5-bfb5-bc300965c8d4",
                        "glosses": [
                            "Emotionally receptive"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdb5ef22-871b-4e93-88e8-33ae5b13e526",
                                "sense_id": "ade8cb79-1ac7-3860-91f5-b21ef8c84fe7",
                                "text": "Whether or not you feel that open-hearted love toward your newborn from the very beginning, one of the best ways to cultivate it and further deepen it is simply by paying attention."
                            },
                            {
                                "example_id": "178d3a56-7b81-4bdd-981a-7b88621fc2d6",
                                "sense_id": "ade8cb79-1ac7-3860-91f5-b21ef8c84fe7",
                                "text": "Mindfulness is a practice that enables us to be in an open-hearted relationship with the present moment, recognizing that the world with which we are entangled is always uncertain and changing."
                            }
                        ]
                    }
