                                "sense_id": "9fcce496-4d76-3ad4-b3cb-40c53b67c7b3",
                                "text": "In het Frans zijn er veel woorden met neusklanken die worden uitgesproken door lucht door de neus te laten gaan.",
                                "translation": "In French, there are many words with nasals that are pronounced by letting air pass through the nose.",
                                "english": "In French, there are many words with nasals that are pronounced by letting air pass through the nose."
                            },
                            {
                                "example_id": "4c96b2eb-a155-4c39-9b93-228dd9502d34",
                                "sense_id": "9fcce496-4d76-3ad4-b3cb-40c53b67c7b3",
                                "text": "Het woord \"mijn\" heeft een neusklank omdat de \"n\" wordt uitgesproken met lucht door de neus.",
                                "translation": "The word \"mijn\" (mine) has a nasal because the \"n\" is pronounced with air through the nose.",
                                "english": "The word \"mijn\" (mine) has a nasal because the \"n\" is pronounced with air through the nose."
                            },
                            {
                                "example_id": "86d883fd-2ba8-43b0-873e-099e8c694ca6",
                                "sense_id": "9fcce496-4d76-3ad4-b3cb-40c53b67c7b3",
                                "text": "De neusklanken zijn een kenmerkend kenmerk van sommige talen.",
                                "translation": "Nasals are a distinctive feature of some languages.",
                                "english": "Nasals are a distinctive feature of some languages."
                            }
                        ]
