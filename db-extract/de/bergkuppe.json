                        "examples": [
                            {
                                "example_id": "620efb1f-8a2a-4e2b-8749-a5bafd8de91c",
                                "sense_id": "15b8e88f-8df0-3931-a3cb-1d8ff1604fbd",
                                "text": "„Der Weg stieg jetzt steil bis zu einer Bergkuppe an, von wo aus wir, wie Vanderbrecken sagte, die Farm der Huysmans im Tal liegen sehen würden.“"
                            },
                            {
                                "example_id": "985e4169-c745-4a8b-8154-601fa18c012b",
                                "sense_id": "15b8e88f-8df0-3931-a3cb-1d8ff1604fbd",
                                "text": "„Auf einer Bergkuppe über Leinfelden-Echterdingen, ganz nahe beim Flughafen von Stuttgart, bemerkten die Menschen schon seit Langem Gräben und Wälle.“"
                            }
                        ],
