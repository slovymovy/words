                        "translation_id": "2214d183-b70b-40c2-b227-4d73a15818d3",
                        "source_entry_id": "7fb814b8-d764-35e7-b986-3268eaa5b3d8",
                        "source_sense_id": "b6cca168-a165-340e-a763-b4231db62ed0",
                        "source_sense_description": "gucken",
                        "target_lang_word": "gucken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gucken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f92674d5-fb74-3412-8f97-e5e363f04c5d",
                                        "entry_id": "e5394106-c8ed-3eb3-b299-bc56fff2e4d0",
                                        "glosses": [
                                            "seine Augen auf etwas richten"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4bb29a8-3e62-47a5-adf7-0920c5171931",
                                                "sense_id": "f92674d5-fb74-3412-8f97-e5e363f04c5d",
                                                "text": "Guck mal, was ich hier habe!"
                                            },
                                            {
                                                "example_id": "d249b60c-e2d6-462f-91f0-fff136f199c7",
                                                "sense_id": "f92674d5-fb74-3412-8f97-e5e363f04c5d",
                                                "text": "In der Zeitung guck ich immer am liebsten nach Bildern von Stars und Sternchen."
                                            },
                                            {
                                                "example_id": "0388d918-d431-4747-abf9-f966aadf40fe",
                                                "sense_id": "f92674d5-fb74-3412-8f97-e5e363f04c5d",
                                                "text": "Du sollst ihr nicht unter den Rock gucken!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eeac6780-9f1e-3f8c-afa4-bc61311ae59d",
                                        "entry_id": "e5394106-c8ed-3eb3-b299-bc56fff2e4d0",
                                        "glosses": [
                                            "ein bestimmtes Gesicht machen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c87e1ce7-1b24-408d-8f76-59b89228e1bf",
                                                "sense_id": "eeac6780-9f1e-3f8c-afa4-bc61311ae59d",
                                                "text": "Warum guckst du heute so traurig?"
                                            },
                                            {
                                                "example_id": "22f37588-c2a1-4331-ace2-84258ac65d73",
                                                "sense_id": "eeac6780-9f1e-3f8c-afa4-bc61311ae59d",
                                                "text": "Guck nicht so blöd!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "142d5342-82e9-3e22-a7e4-ee3ee846fd2f",
                                        "entry_id": "e5394106-c8ed-3eb3-b299-bc56fff2e4d0",
                                        "glosses": [
                                            "sich etwas ansehen, zum Beispiel eine Fernsehsendung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aedb1d7-d709-4554-9ba0-cd30724d5620",
                                                "sense_id": "142d5342-82e9-3e22-a7e4-ee3ee846fd2f",
                                                "text": "Ich gucke immer „Reich und schön“."
                                            },
                                            {
                                                "example_id": "54d44ccb-f3be-454c-8e68-87d212c44dbc",
                                                "sense_id": "142d5342-82e9-3e22-a7e4-ee3ee846fd2f",
                                                "text": "„Ich warte auf eine Kontaktanzeige, in der eine Frau einen maulfaulen Stubenhocker sucht, der weder tanzt noch wandert, aber gerne die Sopranos guckt und dabei Pralinen futtert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
