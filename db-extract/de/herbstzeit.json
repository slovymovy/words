                        "entry_id": "5b9c1a78-9499-3311-a29d-102e94e4a398",
                        "glosses": [
                            "Jahreszeit nach dem Sommer; die Zeit des Herbstes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e7c82c-4e46-46ea-9442-50256d887bee",
                                "sense_id": "ad7852c4-ca0d-3795-a7af-5d086a9e6af7",
                                "text": "„In der Herbstzeit gibts die besten Winde.“"
                            },
                            {
                                "example_id": "f60d77fa-6096-4b08-b296-4bd6ab0064f6",
                                "sense_id": "ad7852c4-ca0d-3795-a7af-5d086a9e6af7",
                                "text": "„Ueber allen Dingen, in der Ferne und in der Nähe, lag jener zauberische Kristallglanz, den es nur in dieser Herbstzeit gibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
