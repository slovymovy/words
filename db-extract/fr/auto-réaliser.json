                ],
                "senses": [
                    {
                        "sense_id": "8fd19c2b-a945-3ce0-9a4a-8319834f9104",
                        "entry_id": "63e9503f-13a5-31f6-9000-de5e7f4e0adb",
                        "glosses": [
                            "Réaliser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b81996-8fa8-4935-af39-b42f71b30aa3",
                                "sense_id": "8fd19c2b-a945-3ce0-9a4a-8319834f9104",
                                "text": "L'ensemble des choix du Premier Festival Les Saisons Parisiennes à St.Pétersbourg 2012 affirme l'intention de donner la possibilité d'une visibilité supplémentaire à toute expression cinématographique de la jeunesse parisienne, que ce soit des artistes confirmés, dotés d'un budget, autant que aux réalisateurs débutants qui auto-réalisent leurs premiers films."
                            }
                        ]
                    },
                    {
                        "sense_id": "f801e712-4bc1-31d7-a4dc-f1aaec426462",
                        "entry_id": "63e9503f-13a5-31f6-9000-de5e7f4e0adb",
                        "glosses": [
                            "Se produire parce que ça a été prédit."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "f76c0839-58cc-4f61-99c3-00f1fa610767",
                                "sense_id": "f801e712-4bc1-31d7-a4dc-f1aaec426462",
                                "text": "Et naturellement ce sera l'une de ces nombreuses prophéties faciles qui s'auto-réalisent car il est évident que les Albanais sont en difficulté."
                            },
                            {
                                "example_id": "a9d47419-536d-4ea6-b757-98d31723c53c",
                                "sense_id": "f801e712-4bc1-31d7-a4dc-f1aaec426462",
                                "text": "Ils représentent un système de prophéties qui s'auto-réalisent."
                            }
                        ]
                    }
