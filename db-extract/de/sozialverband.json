                "senses": [
                    {
                        "sense_id": "3f903407-73cd-3aa3-94ce-68d18f5d6d54",
                        "entry_id": "7117002f-0657-3f02-9973-9f88441980fd",
                        "glosses": [
                            "Interessenverband, welcher beispielsweise die Interessen von Rentnern, Arbeitslosen, Sozialhilfeempfängern, Krankenkassenversicherten, Behinderten vertritt"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e239a98a-e6fa-32df-9c07-2d36c51e50d0",
                        "entry_id": "7117002f-0657-3f02-9973-9f88441980fd",
                        "glosses": [
                            "Gruppe von Tieren, die sozial miteinander leben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "986fadf8-4dfd-4abe-8c62-d63b0d650372",
                                "sense_id": "e239a98a-e6fa-32df-9c07-2d36c51e50d0",
                                "text": "„Bei stets im Sozialverband lebenden Tieren geht man davon aus, daß die hierfür zuständige innere Instanz ohne Unterbrechung aktiv ist, während sie bei Tieren, in deren Lebenszyklus solitäre und soziale Phasen einander ablösen, ihren Aktivitätszustand wechseln.“"
                            },
                            {
                                "example_id": "da951638-eb6c-4be4-a42e-e06db32bd5b5",
                                "sense_id": "e239a98a-e6fa-32df-9c07-2d36c51e50d0",
                                "text": "„Unsere Vorfahren lebten in Gruppen von anfänglich 30 bis 40 Individuen pro Sozietät, später von maximal 100 bis 150 im geschlossenen Sozialverband.“"
                            },
                            {
                                "example_id": "6dabfb5d-2b10-4087-b25c-2b25f0f6089d",
                                "sense_id": "e239a98a-e6fa-32df-9c07-2d36c51e50d0",
                                "text": "„Wandernde Huftiere wie Gnus, Zebras oder Antilopen, Heuschrecken und Vögel bilden dagegen offene, anonyme Verbände, in denen sich die einzelnen Individuen nicht kennen. Einem solchen Sozialverband können sich Tiere jederzeit anschließen oder sich aus ihm verabschieden.“"
                            },
                            {
                                "example_id": "e31ecaf0-4308-45a4-84a9-7e3359ddd86d",
                                "sense_id": "e239a98a-e6fa-32df-9c07-2d36c51e50d0",
                                "text": "„Meist sind es lockere Jagdgemeinschaften (z. B. in der Vogelwelt gemeinsam tauchende Säger), jedoch kann auch ein fester Sozialverband vorliegen (z. B. bei Hyänenhunden).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
