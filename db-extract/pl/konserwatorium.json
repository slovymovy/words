                                "target_senses": [
                                    {
                                        "sense_id": "f5ddbb79-57d1-3388-a42a-37aa077642a9",
                                        "entry_id": "d024e1ac-73b6-3f11-bb31-8d447761d2f1",
                                        "glosses": [
                                            "Verwahr- und Pflegeanstalten in Italien für musikalisch begabte Waisenkinder, die über eine musikalische Ausbildung in den Stand versetzt werden sollten, für ihr eigenes Auskommen zu sorgen"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "639d2c58-aab6-3496-b646-bd6f40de99fd",
                                        "entry_id": "d024e1ac-73b6-3f11-bb31-8d447761d2f1",
                                        "glosses": [
                                            "Institute (im Rang von Hochschulen) für die Ausbildung von Musikern"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3dc2667-53b9-4707-8aa3-c732fcb29b82",
                                                "sense_id": "639d2c58-aab6-3496-b646-bd6f40de99fd",
                                                "text": "„Damals, als er im Konservatorium aufgehört hatte, war doch auch die Sache mit den Notstandsgesetzen gewesen, dachte er, als er im Dunkeln lag und dem immer noch regen Verkehr lauschte.“"
                                            },
                                            {
                                                "example_id": "28b5477e-0312-418d-9317-e68b53a3f586",
                                                "sense_id": "639d2c58-aab6-3496-b646-bd6f40de99fd",
                                                "text": "„Neben meiner Professur am Konservatorium Klagenfurt habe ich etwa mit meinem Jazzquartett, der Organ Band, und im Duo mit Matthias Bublath verschiedene Projekte am Laufen.“"
                                            },
                                            {
                                                "example_id": "672877d3-3214-4d5b-8423-bc27ebd27224",
                                                "sense_id": "639d2c58-aab6-3496-b646-bd6f40de99fd",
                                                "text": "„Almuth begann im Alter von drei Jahren Klavier zu spielen, trat in der Schule und bei Konzerten begabter Kinder öffentlich auf und besuchte auf Rügen ein Konservatorium.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
