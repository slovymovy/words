                "senses": [
                    {
                        "sense_id": "32473611-82db-3042-bd49-bb4d02b3d546",
                        "entry_id": "1a5dfc27-a3d1-3804-aecf-bdf384a3e0c1",
                        "glosses": [
                            "разг. женск. к медик"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "903bf8c8-266d-4227-9fdd-12930ba72dfb",
                                "sense_id": "32473611-82db-3042-bd49-bb4d02b3d546",
                                "text": "Настоящего врача у нас не было ― только молоденькая медичка из пионерского лагеря."
                            }
                        ]
                    },
                    {
                        "sense_id": "da3fed65-00a5-3f4c-b40a-295e6bb734cb",
                        "entry_id": "1a5dfc27-a3d1-3804-aecf-bdf384a3e0c1",
                        "glosses": [
                            "разг. студентка медицинского учебного заведения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc93b41c-b88e-402c-bcd7-997842d9ef84",
                                "sense_id": "da3fed65-00a5-3f4c-b40a-295e6bb734cb",
                                "text": "Студенту она очень обрадовалась и сообщила, что она тоже студентка-медичка из Москвы, мобилизована."
                            },
                            {
                                "example_id": "33795b84-8239-4c3e-89a5-24452adfd8d9",
                                "sense_id": "da3fed65-00a5-3f4c-b40a-295e6bb734cb",
                                "text": "Марина Воропаева, медичка-одногруппница, ее зазвала после уроков в гости на камешки взглянуть."
                            }
                        ]
                    }
