                    "frequency": "VeryLow",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce mouvement d'adagio, le violoncelle <w>chante</w> avec une grande émotion."
                        },
