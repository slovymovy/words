                    {
                        "translation_id": "ef35cfa7-638b-4fdd-bb0a-50438e8f766a",
                        "source_entry_id": "413c2e79-60c4-3c58-9580-4b1b25a45916",
                        "source_sense_id": "ad0fb71a-7717-3014-aa16-ffab613480e8",
                        "source_sense_description": "native or inhabitant of Taranto",
                        "target_lang_word": "Tarentiner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tarentiner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0eb29cbf-abb0-35e2-8768-00ffc1976780",
                                        "entry_id": "dad328f9-d63f-3716-adb5-1e797e74f32e",
                                        "glosses": [
                                            "zu Tarent gehörig, aus Tarent stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf603da-713d-46f3-a0f0-895dd5008af5",
                                                "sense_id": "0eb29cbf-abb0-35e2-8768-00ffc1976780",
                                                "text": "Orecchiette sind eine Tarentiner Spezialität."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tarentiner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "762b5a03-e437-3f77-bf4b-23a4bf16d111",
                                        "entry_id": "212d5f08-d0ad-3c1e-bb77-2be2b1176a19",
                                        "glosses": [
                                            "Einwohner von Tarent (männlich oder unbestimmten Geschlechts)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53100d4d-fef7-4368-b1f3-d1612e93635e",
                                                "sense_id": "762b5a03-e437-3f77-bf4b-23a4bf16d111",
                                                "text": "Er ist Tarentiner, seine Frau ist Neapolitanerin."
                                            },
                                            {
                                                "example_id": "58f5ed5b-2945-427e-9593-07988fcb479a",
                                                "sense_id": "762b5a03-e437-3f77-bf4b-23a4bf16d111",
                                                "text": "„Der Tragweite dieser Verfehlung waren sie sich schwerlich bewußt; denn in aller Arglosigkeit ließen sie die kleine Flottille sogar vor dem tarentinischen Hafen Anker werfen und waren deshalb sehr erstaunt, als die Tarentiner mit einem äußerst starken Akt der Selbsthilfe antworteten und eine Anzahl Schiffe kurzerhand versenkten.“"
                                            },
                                            {
                                                "example_id": "00ac6a4a-9969-46f2-ba28-bf8b8c111879",
                                                "sense_id": "762b5a03-e437-3f77-bf4b-23a4bf16d111",
                                                "text": "„Riemann zählt den Tarentiner zusammen mit Aristides Quintilianus und Ptolemaios zu den »bedeutendsten und wichtigsten antiken Musiktheoretikern«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "36681c01-f5cc-38f2-aba6-cb8381df4393",
                                        "entry_id": "212d5f08-d0ad-3c1e-bb77-2be2b1176a19",
                                        "glosses": [
                                            "berühmter Wein, der in der Gegend des antiken Tarentum, dem heutigen Tarent wuchs; Kurzform für Tarentiner Wein"
                                        ],
                                        "tags": [
                                            "römische Antike"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2d035d5-1d80-4730-bed0-22af4b84da0d",
                                                "sense_id": "36681c01-f5cc-38f2-aba6-cb8381df4393",
                                                "text": "„[…] die edelsten Weinsorten waren: 1) Der berühmte vielbesungene Falerner, […]; 2) der Cäcuber, am See von Fundi […] gewonnen; 3) der Setiner aus Setia […] 7) der Surrentiner; 8) der Tarentiner; […]"
                                            },
                                            {
                                                "example_id": "a779f555-0f97-47c8-a103-8c3dc2656162",
                                                "sense_id": "36681c01-f5cc-38f2-aba6-cb8381df4393",
                                                "text": "„Es waren dies vor allem die verschiedenen Arten des hochgepriesenen Falerner aus Kampanien, aber auch die süßen Weißweine aus Alba und Velletri, der Caecuber sowie noch eine ganze Reihe von Weinen aus Etrurien (Toskana) und Magna Graecia, darunter der Tarentiner und der Cirö“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
