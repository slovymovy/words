                "senses": [
                    {
                        "sense_id": "031b00a3-a5dc-3090-bf15-afbff88a01fc",
                        "entry_id": "f15e462e-9f87-3bcd-b8aa-3e8670592920",
                        "glosses": [
                            "An instance or process of loss of strength."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4c9d0095-1d09-47e5-a165-935b89cc03bd",
                                "sense_id": "031b00a3-a5dc-3090-bf15-afbff88a01fc",
                                "text": "That immortal creature had gone over the proofs with great pains — had of course taken out the stiflings — hard-plungings, lungeings, and other convulsions — and had also taken out her weakenings and damagings of her own effects."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d7fa50c-b52b-3f79-8851-e3de4229c03e",
                        "entry_id": "f15e462e-9f87-3bcd-b8aa-3e8670592920",
                        "glosses": [
                            "A structural principle of mathematical logic that states that the hypotheses of any derived fact may be freely extended with additional assumptions."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa5aa5d1-1263-46e1-8151-0581133f07ce",
                        "source_entry_id": "f15e462e-9f87-3bcd-b8aa-3e8670592920",
                        "source_sense_description": "loss of strength",
                        "target_lang_word": "verzwakking",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verzwakking",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2b07295e-c6d0-3262-a74f-07b598ab0243",
                                        "entry_id": "4400767c-d9c3-3e0d-ba2f-4e1745833195",
                                        "glosses": [
                                            "verlies van kracht, vermindering van intensiteit, proces van zwakker worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27a567d1-235e-4e92-849c-2357154b3971",
                                                "sense_id": "2b07295e-c6d0-3262-a74f-07b598ab0243",
                                                "text": "Zes dagen later toont die opstand nog geen tekenen van verzwakking, ook niet nadat premier Saad Hariri maandag een reeks maatregelen aankondigde."
                                            },
                                            {
                                                "example_id": "3f548700-e9d3-45f6-81d7-5caa77fa2dbe",
                                                "sense_id": "2b07295e-c6d0-3262-a74f-07b598ab0243",
                                                "text": "De Amerikaanse dollar daalt ten aanzien van de euro, van 1,06 dollar per euro in maart vorig jaar naar 1,22 dollar nu. Dat is een verzwakking van 15 procent en brengt de dollar naar zijn laagste eurokoers in bijna drie jaar."
                                            },
                                            {
                                                "example_id": "1a49cd85-9f71-4cff-bfd7-6176e37bc92d",
                                                "sense_id": "2b07295e-c6d0-3262-a74f-07b598ab0243",
                                                "text": "Een aorta met een zwakke plek (aneurysma) is levensbedreigend als het aneurysma barst. (…) Niemand kent de oorzaak van zo'n plaatselijke verzwakking in de wand van de aorta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b3c952e-4f44-3a2c-91b9-1d974f6c7e4f",
                                        "entry_id": "4400767c-d9c3-3e0d-ba2f-4e1745833195",
                                        "glosses": [
                                            "ingreep om kracht of intensiteit te verminderen, handeling om zwakker te maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9053f20-1f8a-4457-b6fa-8a8e41eaa406",
                                                "sense_id": "5b3c952e-4f44-3a2c-91b9-1d974f6c7e4f",
                                                "text": "De VS (…) lijken hun doel naar beneden bijgesteld te hebben tot een strategie van ‘verzwakking’: niet met grondsoldaten, maar met zo’n 800 special forces en drones zorgen dat de terroristen niet te brutaal worden en te ver opdringen."
                                            },
                                            {
                                                "example_id": "4fca52f5-df60-4ed7-b62a-3de0140edbcb",
                                                "sense_id": "5b3c952e-4f44-3a2c-91b9-1d974f6c7e4f",
                                                "text": "Met deze lokale verzwakkingen kan een grotere scheur voorgevormd worden, ongeveer zoals kleuters met een prikpen in karton prikken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3373137-c2f0-4fec-91dd-2a9830c447ae",
                        "source_entry_id": "f15e462e-9f87-3bcd-b8aa-3e8670592920",
                        "source_sense_description": "loss of strength",
                        "target_lang_word": "affaiblissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affaiblissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1dd8c665-3d35-376d-93d5-aa19d7e194c6",
                                        "entry_id": "78190d47-cfb1-3782-8f69-655c91a55cb2",
                                        "glosses": [
                                            "État de ce qui est affaibli."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "041bfe0d-4bd2-432e-800b-bfa776fe482b",
                                                "sense_id": "1dd8c665-3d35-376d-93d5-aa19d7e194c6",
                                                "text": "Le défaut d'exercice, le confinement dans une atmosphère très-limitée, sont des causes d’affaiblissement de l’organisme, et par suite des causes prédisposantes de la tuberculose."
                                            },
                                            {
                                                "example_id": "e97bd1d8-9d18-488b-a648-066e910eed44",
                                                "sense_id": "1dd8c665-3d35-376d-93d5-aa19d7e194c6",
                                                "text": "Quant au comté de Flandre, sa dépendance politique envers la France l’entraîna, malgré lui et contre ses intérêts traditionnels, dans les conséquences de l’affaiblissement de la monnaie royale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa8295fd-c8c1-34bd-a1be-8c81dfb3259e",
                                        "entry_id": "78190d47-cfb1-3782-8f69-655c91a55cb2",
                                        "glosses": [
                                            "Diminution d’une puissance électrique, acoustique ou électromagnétique entre deux points."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c7916c5-4467-33d9-a58b-ecbc0ee6f342",
                                        "entry_id": "78190d47-cfb1-3782-8f69-655c91a55cb2",
                                        "glosses": [
                                            "Expression quantitative de cette diminution par le rapport, généralement en décibels, de la valeur en deux points d’une puissance ou d’une grandeur qui est liée à la puissance par une relation bien définie."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ec4e32-3414-4f61-8db2-4c5d9e7681ce",
                                                "sense_id": "5c7916c5-4467-33d9-a58b-ecbc0ee6f342",
                                                "text": "L'ARCEP a dans un premier temps ouvert le Re-ADSL2 aux lignes dont l'affaiblissement est inférieur à 75 dB et a défini un mode de calcul de cette valeur théorique d'affaiblissement de la ligne. En décembre 2005, la valeur maximale d'affaiblissement validant l'éligibilité aux offres commerciales Re-ADSL2 a été repoussée à 78 dB."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7e6190a-e516-425d-81ec-1a2aa887a961",
                        "source_entry_id": "f15e462e-9f87-3bcd-b8aa-3e8670592920",
                        "source_sense_description": "loss of strength",
