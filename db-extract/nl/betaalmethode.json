                            {
                                "example_id": "de8bbb3d-d73d-4939-9d2b-257c58129c0b",
                                "sense_id": "0dabe6a1-f1b1-3a33-a582-e0f1f2105a30",
                                "text": "\"IDeal is met afstand de meestgebruikte betaalmethode in Nederland. Bij ons wordt de helft van de betalingen uitgevoerd met iDEAL. Iedere minuut dat iDEAL niet werkt, is heel vervelend.\" Het systeem moet volgens Bol.com net zo betrouwbaar zijn als pinbetalingen."
                            },
                            {
                                "example_id": "1b47349e-1f1d-45bd-a455-c7fa5f655fdd",
                                "sense_id": "0dabe6a1-f1b1-3a33-a582-e0f1f2105a30",
                                "text": "Op de site van de prijsvechter staat dat bij de ticketprijzen alle kosten zijn inbegrepen, maar in de praktijk blijkt dat niet het geval. Zo moet er voor bagage extra worden betaald. Ook komen er bovenop alle prijzen nog extra betaalkosten bij, ongeacht betaalmethode. Volgens de Reclame Code Commissie is dat misleiding."
                            }
                        ]
