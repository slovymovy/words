    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a41f95f-a288-33c1-922e-da95dd514fec",
                    "sense_definition": "Personne dont la profession est d'interpréter un rôle au théâtre, au cinéma ou à la télévision.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "théâtre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune <w>comédien</w> a obtenu le rôle principal dans une nouvelle pièce.",
                            "target_lang_translations": {
                                "en": "This young <w>actor</w> won the lead role in a new play.",
                                "ru": "Этот молодой <w>актёр</w> получил главную роль в новой пьесе.",
                                "de": "Dieser junge <w>Schauspieler</w> hat die Hauptrolle in einem neuen Stück erhalten.",
                                "es": "Este joven <w>actor</w> ha obtenido el papel principal en una nueva obra.",
                                "zh": "这位年轻的<w>演员</w>在一部新剧里获得了主角。"
                            }
                        },
                        {
                            "text": "Le metteur en scène répète tous les soirs avec les <w>comédiens</w>.",
                            "target_lang_translations": {
                                "en": "The director rehearses with the <w>actors</w> every evening.",
                                "ru": "Режиссёр каждый вечер репетирует с <w>актёрами</w>.",
                                "de": "Der Regisseur probt jeden Abend mit den <w>Schauspielern</w>.",
                                "es": "El director de escena ensaya todas las noches con los <w>actores</w>.",
                                "zh": "导演每天晚上都和<w>演员</w>排练。"
                            }
                        }
                    ],
                    "synonyms": [
                        "acteur"
                    ],
                    "common_phrases": [
                        "troupe de comédiens"
                    ],
                    "target_lang_definitions": {
                        "en": "A person whose profession is performing roles in theatre, film or television.",
                        "ru": "Человек, профессия которого — исполнять роли в театре, кино или на телевидении.",
                        "de": "Person, die beruflich in Theater, Film oder Fernsehen Rollen spielt.",
                        "es": "Persona cuya profesión es interpretar papeles en el teatro, el cine o la televisión.",
                        "zh": "以表演为职业，在戏剧、电影或电视中扮演角色的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "actor",
                                "target_lang_sense_clarification": "theatre, film or television"
                            }
                        ],
