                ],
                "senses": [
                    {
                        "sense_id": "d95f9420-5734-3c6b-a94f-c69e616a587b",
                        "entry_id": "4851d504-ead4-3a99-bdf7-292d575b00ea",
                        "glosses": [
                            "Descendre des alpages."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "15a9f284-049d-4f09-9656-1a7028f03136",
                                "sense_id": "d95f9420-5734-3c6b-a94f-c69e616a587b",
                                "text": "Ces migrations pastorales permettaient aux moutons des plaines de bord de mer de fuir la chaleur et, sous la direction des bergers, de monter vers les pâturages d’altitude pour y trouver herbe et fraîcheur pendant trois ou quatre mois d’été, avant de « démontagner » à l’automne, en prévision des premières neiges, afin que les brebis retournent mettre bas leurs agneaux dans les bergeries de la plaine originelle."
                            },
                            {
                                "example_id": "e844a390-860b-44fc-ae3a-74f07b9be99d",
                                "sense_id": "d95f9420-5734-3c6b-a94f-c69e616a587b",
                                "text": "« Il faudra bien démontagner, malheureusement », sourit Myriam."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7c8a2aa-9c33-3f19-baa3-cf0a50c45cc4",
                        "entry_id": "4851d504-ead4-3a99-bdf7-292d575b00ea",
                        "glosses": [
                            "Descendre de la montagne."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5d3db243-f2f3-4513-a694-4ab5e2c1341f",
                                "sense_id": "f7c8a2aa-9c33-3f19-baa3-cf0a50c45cc4",
                                "text": "Les paysans s’occupent une partie de l’hiver à ‘ démontagner ’ les bois, c’est-à-dire à faire glisser les troncs du lieu d’abattage au chemin le plus proche, et à les transporter jusqu’à la scierie."
                            }
                        ]
                    }
