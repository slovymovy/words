    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a65c04c0-d50d-352d-96a5-f8791550724d",
                    "sense_definition": "The present participle and gerund of <w>pester</w>, meaning to annoy someone with frequent or persistent requests or interruptions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>pestering</w> your brother while he is trying to finish his homework.",
                            "target_lang_translations": {
                                "cs": "Přestaň <w>obtěžovat</w> svého bratra, zatímco se snaží dokončit domácí úkol."
                            }
                        },
                        {
                            "text": "The constant <w>pestering</w> from telemarketers is very frustrating during dinner.",
                            "target_lang_translations": {
                                "cs": "Neustálé <w>obtěžování</w> od telemarketérů je během večeře velmi frustrující."
                            }
                        }
                    ],
                    "synonyms": [
                        "bothering",
                        "harassing",
                        "annoying"
                    ],
                    "common_phrases": [
                        "constant pestering",
                        "stop pestering"
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost spočívající v obtěžování někoho častými nebo neodbytnými žádostmi či vyrušováním."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "obtěžování",
                                "target_lang_sense_clarification": "obecný výraz pro vyrušování nebo znepokojování někoho"
                            },
                            {
                                "target_lang_word": "dorážení",
                                "target_lang_sense_clarification": "vyjadřuje neodbytné naléhání nebo vyptávání"
                            },
                            {
                                "target_lang_word": "otravování",
                                "target_lang_sense_clarification": "neformální výraz pro vyvolávání nepříjemných pocitů u druhých"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6e9d271-f641-3ef5-b95d-54d27e7785d8",
                    "sense_definition": "An act or instance of annoying someone persistently.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He finally gave in to the constant <w>pesterings</w> of his children to buy a puppy.",
                            "target_lang_translations": {
                                "cs": "Nakonec podlehl neustálému <w>naléhání</w> svých dětí, aby jim koupil štěně."
                            }
                        },
                        {
                            "text": "She ignored the <w>pesterings</w> of the reporters waiting outside her office.",
                            "target_lang_translations": {
                                "cs": "Ignorovala <w>dotírání</w> reportérů čekajících před její kanceláří."
                            }
                        }
                    ],
                    "synonyms": [
                        "harassment",
                        "bother"
                    ],
                    "common_phrases": [
                        "constant pesterings"
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt nebo případ vytrvalého obtěžování někoho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "neodbytné naléhání",
                                "target_lang_sense_clarification": "opakované a vytrvalé prosby"
                            },
                            {
                                "target_lang_word": "obtěžování",
                                "target_lang_sense_clarification": "opakovaný akt vyrušování"
                            }
                        ]
                    }
                }
            ]
        }
    ]
