                "senses": [
                    {
                        "sense_id": "7d75259d-d174-356d-93be-193032af90ce",
                        "entry_id": "fe4dc002-8da7-3b6d-b395-d99369131301",
                        "glosses": [
                            "weibliche Person, die stets nach günstigen Angeboten (Schnäppchen) Ausschau hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aac2a25-3693-494d-9d99-5bf2d4e21161",
                                "sense_id": "7d75259d-d174-356d-93be-193032af90ce",
                                "text": "Nachdem in der Zeitung der Räumungsverkauf angekündigt worden war, stürmten Schnäppchenjägerinnen das Möbelgeschäft."
                            },
                            {
                                "example_id": "ad9229ee-ec78-40a7-b2cd-658e560fc6e3",
                                "sense_id": "7d75259d-d174-356d-93be-193032af90ce",
                                "text": "„Und diesmal war ich auch nicht als Schnäppchenjägerin im Haus eines anderen unterwegs, sondern musste den Dengelmanns dieser Welt selbst die Türe in mein Refugium öffnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
