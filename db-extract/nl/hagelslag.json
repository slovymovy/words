                        "source_entry_id": "eb78971f-1baf-3d59-b9e8-c2e46540c9c8",
                        "source_sense_id": "4f7a530d-b47c-347a-82e3-4c9e549e5f6f",
                        "source_sense_description": "het met kracht neervallen van de hagel",
                        "target_lang_word": "Hagelschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hagelschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9d2b205-4587-335d-b95a-6da0a3a8544f",
                                        "entry_id": "bc42c727-510f-3e81-9b3e-bd8747929964",
                                        "glosses": [
                                            "starker Hagel, der mit großen Schäden einhergeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeddb42e-6bcc-4721-8b3a-6e063d43ac0d",
                                                "sense_id": "e9d2b205-4587-335d-b95a-6da0a3a8544f",
                                                "text": "„Bei Schäden an geparkten oder stehenden Autos greift die Teilkaskoversicherung. Das gilt etwa für Beulen, die durch umstürzende Bäume oder Hagelschlag entstehen.“"
                                            },
                                            {
                                                "example_id": "0e101a4f-f5ca-4802-a2f5-e834294c55fc",
                                                "sense_id": "e9d2b205-4587-335d-b95a-6da0a3a8544f",
                                                "text": "„So ging der Sommer mit Blitz und Donner, großer Hitze und Hagelschlägen seinen Weg.“"
                                            },
                                            {
                                                "example_id": "1ff8d3dd-6170-43ac-87d6-57d8d37f5bfb",
                                                "sense_id": "e9d2b205-4587-335d-b95a-6da0a3a8544f",
                                                "text": "„Am Abend zuvor, als es schon auf die Nacht ging, war ein gewaltiger Sturm mit Regengüssen und Hagelschlag ausgebrochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
