                                    {
                                        "sense_id": "8588a062-dc2c-3bbc-a2eb-e918a1eaf1d3",
                                        "entry_id": "acee67fe-ec5d-3153-9fa3-fb035fc14b8a",
                                        "glosses": [
                                            "A wise judge, like the biblical Daniel who ingeniously saved a woman from false accusations of adultery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a7b850b-8eca-4484-9d8d-14f443a632e8",
                                                "sense_id": "8588a062-dc2c-3bbc-a2eb-e918a1eaf1d3",
                                                "text": "A Daniel come to judgment! yea, a Daniel! / O wise young judge, how I do honour thee!"
                                            }
