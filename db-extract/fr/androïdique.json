                                "example_id": "862ae8c0-3956-4c42-9715-cae2c83eb4d1",
                                "sense_id": "91a115e8-cc0c-3c0d-85ca-07ae286b78f8",
                                "text": "[…] je suis sûr que tu fais une étude de marché pour voir si tu te lances dans la prostitution androïdique."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ccf7e14-6bd3-37a0-8786-dd065e954efe",
                        "entry_id": "3a333044-db06-3304-aab3-bd003e49511b",
