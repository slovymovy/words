                ],
                "senses": [
                    {
                        "sense_id": "3671c94b-6cde-3ff3-ac06-ddf282fdd119",
                        "entry_id": "15867893-4df6-3dd3-9d20-e4ca91c1952d",
                        "glosses": [
                            "Abend im Winter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80e6864b-c21c-4d92-bf2e-f4a606ea5c77",
                                "sense_id": "3671c94b-6cde-3ff3-ac06-ddf282fdd119",
                                "text": "An diesem Winterabend lag ein Spanngurt mitten auf der Autobahn."
                            },
                            {
                                "example_id": "4fa27cf6-65ae-4b3d-9ed5-ead65a7c4b42",
                                "sense_id": "3671c94b-6cde-3ff3-ac06-ddf282fdd119",
                                "text": "„An Winterabenden kommen nicht viele Gäste, und sie sitzen allein in dem langen Raum mit seinen Spiegeln und unterhalten sich leise.“"
                            },
                            {
                                "example_id": "81900336-4cbb-43a8-946b-bfd77932e34a",
                                "sense_id": "3671c94b-6cde-3ff3-ac06-ddf282fdd119",
                                "text": "„Sie war gestrandet im Halbdunkel eines Winterabends.“"
                            },
                            {
                                "example_id": "b4f12013-6f14-4805-ac24-3f18c5c45645",
                                "sense_id": "3671c94b-6cde-3ff3-ac06-ddf282fdd119",
                                "text": "„Die Siedler machten sich an den langen Winterabenden Gedanken darüber, wie sie sich mit der Umwelt in Verbindung setzen könnten.“"
                            },
                            {
                                "example_id": "e971b93c-7cf0-4476-95f6-6d092b7a494a",
                                "sense_id": "3671c94b-6cde-3ff3-ac06-ddf282fdd119",
                                "text": "„Der Winterabend war tintenschwarz, und es hatte angefangen zu schneien – dicke, weiße Flocken, die im Schein der Straßenlaternen glitzernd zu Boden rieselten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
