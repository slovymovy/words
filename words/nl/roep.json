                    "sense_definition": "Gebiedende wijs van <w>roepen</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Roep</w> de dokter, want er is een ongeluk gebeurd!",
                            "target_lang_translations": {
                                "ru": "<w>Позови</w> врача, так как произошел несчастный случай!",
                                "en": "<w>Call</w> the doctor, because an accident has happened!",
                                "fr": "<w>Appelle</w> le médecin, car un accident s'est produit !"
