                    "sense_id": "0b55dc85-5f66-365a-979a-fdc0cb44f4a1",
                    "sense_definition": "Een verschil maken of van belang zijn; eruit doen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "matter_differ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kan me echt niets <w>schelen</w> wat anderen daarvan denken.",
                            "target_lang_translations": {
                                "ru": "Меня совершенно не <w>волнует</w>, что об этом думают другие.",
                                "en": "I really don't <w>care</w> what others think about that.",
                                "pl": "Naprawdę nic mnie nie <w>obchodzi</w>, co inni o tym myślą.",
                                "de": "Es kann mir wirklich nichts <w>ausmachen</w>, was andere darüber denken.",
                                "fr": "Cela ne me <w>fait</w> vraiment rien de ce que les autres en pensent.",
                                "it": "Non mi <w>importa</w> davvero nulla di ciò che gli altri pensano al riguardo.",
                                "cs": "Vůbec mě <w>nezajímá</w>, co si o tom myslí ostatní.",
                                "tr": "Başkalarının bu konuda ne düşündüğü beni gerçekten hiç <w>ilgilendirmiyor</w>.",
                                "es": "Realmente no me <w>importa</w> nada lo que otros piensen de eso.",
                                "zh": "别人怎么想，我真的<w>不在乎</w>。"
                            }
                        },
                        {
                            "text": "Dat <w>scheelt</w> een hoop tijd als we de trein nemen.",
                            "target_lang_translations": {
                                "ru": "Это <w>сэкономит</w> кучу времени, если мы поедем на поезде.",
                                "en": "It <w>saves</w> a lot of time if we take the train.",
                                "pl": "To <w>oszczędzi</w> mnóstwo czasu, jeśli pojedziemy pociągiem.",
                                "de": "Das <w>spart</w> eine Menge Zeit, wenn wir den Zug nehmen.",
                                "fr": "Cela nous <w>fait gagner</w> beaucoup de temps si nous prenons le train.",
                                "it": "Ci <w>risparmia</w> un sacco di tempo se prendiamo il treno.",
                                "cs": "To nám <w>ušetří</w> spoustu času, když pojedeme vlakem.",
                                "tr": "Eğer trene binersek bu bize çok zaman <w>kazandırır</w>.",
                                "es": "Eso nos <w>ahorra</w> mucho tiempo si tomamos el tren.",
                                "zh": "如果我们坐火车，能<w>节省</w>很多时间。"
                            }
                        },
                        {
                            "text": "Dat <w>scheelt</w> een slok op een borrel.",
                            "target_lang_translations": {
                                "ru": "Это существенно <w>меняет</w> дело.",
                                "en": "That <w>makes a</w> big <w>difference</w>.",
                                "pl": "To <w>robi</w> wielką <w>różnicę</w>.",
                                "de": "Das <w>macht</w> einen großen <w>Unterschied</w>.",
                                "fr": "Cela <w>fait</w> une grande <w>différence</w>.",
                                "it": "Questo <w>fa</w> una grande <w>differenza</w>.",
                                "cs": "To <w>dělá</w> velký <w>rozdíl</w>.",
                                "tr": "Bu çok büyük bir <w>fark yaratıyor</w>.",
                                "es": "Eso <w>marca una gran diferencia</w>.",
                                "zh": "那确实<w>有很大区别</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "uitmaken",
                        "verschillen"
