                                            {
                                                "example_id": "6b5da736-18ff-4637-91d3-b3a8c2aa699b",
                                                "sense_id": "07f6c44b-c7b7-33bf-b588-6aace5e607ea",
                                                "text": "She accepted unquestioningly the dictum that a woman's place is in the home."
