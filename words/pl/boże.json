                {
                    "sense_id": "accdfc55-6fa2-3f14-b020-0c792ad1a13c",
                    "sense_definition": "Wykrzyknienie wyrażające silne emocje, takie jak zdenerwowanie, zdziwienie, przerażenie lub zachwyt.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "emotions_exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Boże</w>! Ależ on schudł!",
                            "target_lang_translations": {
                                "ru": "<w>Боже</w>! Как же он похудел!",
                                "nl": "<w>Mijn God</w>! Wat is hij afgevallen!",
                                "en": "<w>My God</w>! He has lost so much weight!",
                                "de": "<w>Mein Gott</w>! Wie sehr er abgenommen hat!",
                                "fr": "<w>Mon Dieu</w> ! Comme il a maigri !",
                                "it": "<w>Oddio</w>! Com'è dimagrito!",
                                "cs": "<w>Bože</w>! Ten ale zhubl!",
                                "tr": "<w>Tanrım</w>! Ne kadar da zayıflamış!",
                                "es": "¡<w>Dios mío</w>! ¡Cómo ha adelgazado!",
                                "zh": "<w>天哪</w>！他瘦了这么多！"
                            }
                        },
                        {
                            "text": "O <w>Boże</w>, zupełnie zapomniałem o twoich urodzinach.",
                            "target_lang_translations": {
                                "ru": "О <w>Боже</w>, я совсем забыл про твой день рождения.",
                                "nl": "O <w>God</w>, ik ben je verjaardag helemaal vergeten.",
                                "en": "Oh <w>God</w>, I completely forgot about your birthday.",
                                "de": "O <w>Gott</w>, ich habe deinen Geburtstag völlig vergessen.",
                                "fr": "Oh <w>mon Dieu</w>, j'ai complètement oublié ton anniversaire.",
                                "it": "Oh <w>Dio</w>, mi sono dimenticato completamente del tuo compleanno.",
                                "cs": "O <w>Bože</w>, úplně jsem zapomněl na tvoje narozeniny.",
                                "tr": "Aman <w>Tanrım</w>, doğum gününü tamamen unutmuşum.",
                                "es": "¡Oh, <w>Dios</w>!, se me olvidó por completo tu cumpleaños.",
                                "zh": "哦<w>上帝啊</w>，我完全忘了你的生日。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Jezu",
                        "Jezus Maria",
                        "Matko Boska",
                        "rany",
                        "olaboga."
                    ],
                    "common_phrases": [
                        "o mój Boże",
                        "Boże drogi",
                        "daj Boże",
                        "broń Boże",
                        "szczęść Boże"
