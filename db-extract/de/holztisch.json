                ],
                "senses": [
                    {
                        "sense_id": "e302f306-f5d3-3495-94f9-16e440ded66d",
                        "entry_id": "120e7de3-95bd-3e37-864b-eb6be7df8f86",
                        "glosses": [
                            "Tisch, hergestellt aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "407cf39a-d0bb-4a26-be37-b81c8e52e818",
                                "sense_id": "e302f306-f5d3-3495-94f9-16e440ded66d",
                                "text": "Gemeinsam trugen wir den schweren Holztisch in die Wohnung."
                            },
                            {
                                "example_id": "94a16686-c5e6-4121-90f1-9ea73053b759",
                                "sense_id": "e302f306-f5d3-3495-94f9-16e440ded66d",
                                "text": "„Vom niedrigen Holztisch bröckelte die Farbe und das Zimmer roch streng nach dem Bewohner, der vor mir das Bett belegt hatte.“"
                            },
                            {
                                "example_id": "d3035eec-0ae6-46a4-bac2-37f862882579",
                                "sense_id": "e302f306-f5d3-3495-94f9-16e440ded66d",
                                "text": "„In der Mitte des Zimmers stand ein schwerer Holztisch, an den beiden Längsseiten je ein Stuhl.“"
                            },
                            {
                                "example_id": "bd5059bb-4925-4ecb-95f3-62e0e6b586c8",
                                "sense_id": "e302f306-f5d3-3495-94f9-16e440ded66d",
                                "text": "„Sophie saß an dem großen weißen Holztisch in der Küche.“"
                            },
                            {
                                "example_id": "73c7f874-c63a-4cf9-8a11-6158dc49c192",
                                "sense_id": "e302f306-f5d3-3495-94f9-16e440ded66d",
                                "text": "„Er stützte sich mit beiden Händen auf den Holztisch und starrte das Gespenst an, das vorgab, sein Vater zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
