                "senses": [
                    {
                        "sense_id": "906b854f-42a4-37e4-a122-948eb6a391b0",
                        "entry_id": "0f1300ac-f3fb-3b61-aad3-160057e0fc52",
                        "glosses": [
                            "Enlever sa cocarde à (un taureau, en particulier)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a992fefd-ea6d-419e-9f91-cab3295d124b",
                                "sense_id": "906b854f-42a4-37e4-a122-948eb6a391b0",
                                "text": "Le taureau ne refusa aucune tentative des hommes acharnés à le décocarder."
                            },
                            {
                                "example_id": "21bd0c4a-de5c-48ef-8814-757b6631958c",
                                "sense_id": "906b854f-42a4-37e4-a122-948eb6a391b0",
                                "text": "Oui, en deux mille ans d’Histoire, le seul grand homme issu du berceau de Beaucaire-Ugernum que les Beaucairois aient cru bon de statufier en pied, et avec des cornes mahousses, c’est ce taureau qualifié de légendaire, parce qu’aucun razeteur n’a jamais réussi à le décocarder."
                            }
                        ]
                    }
