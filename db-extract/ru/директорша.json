                    },
                    {
                        "sense_id": "67123d3b-975b-3fc1-b560-64eb2d84176f",
                        "entry_id": "97ea8a70-cc1a-3e58-9bc6-3d6d3b4aa627",
                        "glosses": [
                            "head's wife"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e436e19-13a6-4dda-b9ce-07b95ad22145",
                                "sense_id": "67123d3b-975b-3fc1-b560-64eb2d84176f",
                                "text": "Дире́кторша, инспе́кторша и все на́ши гимнази́ческие да́мы о́жили, да́же похороше́ли, то́чно вдруг уви́дели цель жи́зни.",
                                "translation": "The Head’s wife, the inspector’s wife and all the mistresses who taught at the high school suddenly brightened up, looked prettier even, as if they had discovered a purpose in life.",
                                "english": "The Head’s wife, the inspector’s wife and all the mistresses who taught at the high school suddenly brightened up, looked prettier even, as if they had discovered a purpose in life."
                            }
                        ]
                    }
