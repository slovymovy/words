                ],
                "senses": [
                    {
                        "sense_id": "496e751e-3fc7-3a3b-9e53-47ca77d1634e",
                        "entry_id": "59bad402-2620-3187-b2e1-1a4609eccaa6",
                        "glosses": [
                            "Parteiflügel, welcher Gewerkschaften nahe steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "937e4bbd-d2a1-4492-88b9-ee8516f71239",
                                "sense_id": "496e751e-3fc7-3a3b-9e53-47ca77d1634e",
                                "text": "„Der SPD-Streit war am Dienstag auf Druck des Gewerkschaftsflügels durch eine Kompromissklausel entschärft worden, die ins Gesetz eingefügt werden soll.“"
                            },
                            {
                                "example_id": "fa59afc1-9c64-4c5b-a3ab-b58fab1adb1a",
                                "sense_id": "496e751e-3fc7-3a3b-9e53-47ca77d1634e",
                                "text": "„[Pieter de Crem] steht für einen stramm rechten Kurs, was dem Gewerkschaftsflügel der Christdemokraten Sorgen bereitet.“"
                            },
                            {
                                "example_id": "2389e102-4c57-4193-9d40-bbd016c6f4f6",
                                "sense_id": "496e751e-3fc7-3a3b-9e53-47ca77d1634e",
                                "text": "„Der langjährige, beliebte und über alle Maßen pflichtbewusste Grazer Bürgermeister [Alfred Stingl], der die linken Jungen und den rechten Gewerkschaftsflügel versöhnen konnte, ließ zu spät los.“"
                            },
                            {
                                "example_id": "4838cdae-e86c-46c8-9a03-974c119e42a0",
                                "sense_id": "496e751e-3fc7-3a3b-9e53-47ca77d1634e",
                                "text": "„In der SP, deren Gewerkschaftsflügel mitschuldig am Scheitern des institutionellen Abkommens mit der EU ist, hat seine Stimme inzwischen markant mehr Gewicht.“"
                            },
                            {
                                "example_id": "e2ed0ddd-82ad-490f-aa41-b5e68235cea3",
                                "sense_id": "496e751e-3fc7-3a3b-9e53-47ca77d1634e",
                                "text": "„Bei den Demokraten finden sich der traditionelle Gewerkschaftsflügel, die Schwarzen und die Hispanics, seit einiger Zeit aber auch eine Gruppe moderater neoliberaler Reformer, für die Bill Clinton stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "faa50b87-2a14-37ca-a8e5-adc6515c124a",
                        "entry_id": "59bad402-2620-3187-b2e1-1a4609eccaa6",
                        "glosses": [
                            "Gruppierung innerhalb einer Gewerkschaft oder der Gewerkschaftsbewegung, welche eine bestimmte Richtung vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d156345d-49ee-4b39-ab1e-263e9f2920fc",
                                "sense_id": "faa50b87-2a14-37ca-a8e5-adc6515c124a",
                                "text": "„Will Günter Döding, Vorsitzender der Gewerkschaft Nahrung-Genuß-Gaststätten und auch dem gemäßigten Gewerkschaftsflügel zugerechnet, in letzter Minute Brücken bauen oder spekuliert er auf Zeitgewinn?“"
                            },
                            {
                                "example_id": "e3228053-df7e-4761-ad2c-2a857b303067",
                                "sense_id": "faa50b87-2a14-37ca-a8e5-adc6515c124a",
                                "text": "„‚Der rechte Gewerkschaftsflügel wollte damals keinen Streik‘, erinnert sich Brunner, ‚und dem linken Flügel war Streik als Kampfmittel zu heilig, um ihn mit einem »Hausfrauenstreik« zu entwerten.‘“"
                            },
                            {
                                "example_id": "e55607f1-f349-4385-8318-f0265d80f1ff",
                                "sense_id": "faa50b87-2a14-37ca-a8e5-adc6515c124a",
                                "text": "„Konkret will sich der SPÖ-dominierte Gewerkschaftsflügel im Parlament für eine ‚Sozialmilliarde‘ einsetzen, um bessere Arbeitsbedingungen zu gewährleisten.“"
                            },
                            {
                                "example_id": "45e4f803-700e-4c4a-bec2-337ca87fa0c5",
                                "sense_id": "faa50b87-2a14-37ca-a8e5-adc6515c124a",
                                "text": "„[Heinz-Werner Meyer] galt als Vertreter des rechten Gewerkschaftsflügels.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
