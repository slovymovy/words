                "senses": [
                    {
                        "sense_id": "c75858a2-9fa2-3fdc-b7ed-5f4b3619e515",
                        "entry_id": "a210a11c-9c97-35ef-9c26-ed43bb51ca6d",
                        "glosses": [
                            "Ziel, zu dem ein Läufer läuft (Endpunkt seiner Laufstrecke)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa8fa26-a2ec-4f8b-ab3a-a79a409b681f",
                                "sense_id": "c75858a2-9fa2-3fdc-b7ed-5f4b3619e515",
                                "text": "„Das Wander- und Laufziel wurde in den vergangenen Jahren mehrfach beschädigt und wieder saniert.“"
                            },
                            {
                                "example_id": "b048e4eb-0fd4-438f-a5f7-db71f69ad4f4",
                                "sense_id": "c75858a2-9fa2-3fdc-b7ed-5f4b3619e515",
                                "text": "„‚Wir haben mit der Kolonie, der Zeche und der Halde einzigartige attraktive Laufziele‘‚ so Huerkamp, ‚die für Läufer*innen [sic] aus der ganzen Region spannend sind‘.“"
                            },
                            {
                                "example_id": "240481e9-523e-42a9-aa0b-2fd985482949",
                                "sense_id": "c75858a2-9fa2-3fdc-b7ed-5f4b3619e515",
                                "text": "„Großes Laufziel wär da z. B. eine Dachsteinumrundung …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8b197f8e-5a1f-3135-93c1-ca17f5f4d2d7",
                        "entry_id": "a210a11c-9c97-35ef-9c26-ed43bb51ca6d",
                        "glosses": [
                            "spezifisches Ziel, das sich ein Läufer setzt (zum Beispiel ein bestimmtes Tempo zu erreichen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b59ce4fa-643a-4978-94fb-76a0051358fc",
                                "sense_id": "8b197f8e-5a1f-3135-93c1-ca17f5f4d2d7",
                                "text": "„29 Tage vor dem Jahresende habe ich mein Laufziel erreicht.“"
                            },
                            {
                                "example_id": "62159d7f-48de-4f0b-892a-282d28d543ff",
                                "sense_id": "8b197f8e-5a1f-3135-93c1-ca17f5f4d2d7",
                                "text": "Allerdings habe ich es ganz gut geschafft gleichmäßig zu laufen und die letzte Runde sogar nochmal anzuziehen um mein Laufziel von unter 2 Stunden tatsächlich zu erreichen.“"
                            },
                            {
                                "example_id": "8ccc1fe2-e078-452b-bff4-893e261514cb",
                                "sense_id": "8b197f8e-5a1f-3135-93c1-ca17f5f4d2d7",
                                "text": "„Eine Tempotabelle oder Pace Tabelle kann dabei helfen, das Training zu optimieren und das Laufziel innerhalb deiner Zielzeit zu erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
