                    {
                        "translation_id": "8f206767-14da-414c-b3e7-6035430dae2c",
                        "source_entry_id": "68ea6e86-77ca-348f-819e-340631c972db",
                        "source_sense_description": "qui ne craint pas le péril et l’affronte volontiers",
                        "target_lang_word": "onvervaard",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onvervaard",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f2907c7c-0902-3418-a6fb-11c5e566fb23",
                                        "entry_id": "cbcd0a22-1e96-3fc3-9205-998a95ec4ad9",
                                        "glosses": [
                                            "zonder vrees, met veel moed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9206775c-6f2c-4017-8d1f-d95acd8983b9",
                                                "sense_id": "f2907c7c-0902-3418-a6fb-11c5e566fb23",
                                                "text": "Terwijl de Saoedi’s twijfelden of er in Brussel nog wel plaats was voor een vijfsterrenhotel, mikken de Maltezen onvervaard nog hoger: op een luxepaleis. Zo hebben ze er ondertussen elf, in metropolen als Londen, Praag, Budapest en Lissabon. Steeds in historische gebouwen in het centrum."
                                            },
                                            {
                                                "example_id": "4afd2c83-5d12-40ef-85d8-38c6f5c50c05",
                                                "sense_id": "f2907c7c-0902-3418-a6fb-11c5e566fb23",
                                                "text": "Als je mensen macht geeft - zelfs als dat op volstrekt willekeurige basis gebeurt - worden ze doel- en actiegerichter, ze voelen zich minder geremd. Ze zien vooral positieve resultaten, zijn minder bang voor mislukking en gaan onvervaard op hun doel af. Wat ze in hun hoofd hebben, doen ze. Ze eten meer, flirten meer, zeggen meer wat ze denken en doen wat ze denken. En ze denken meer aan seks. Met name bij mannen is macht onbewust geassocieerd met seks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
