                ],
                "senses": [
                    {
                        "sense_id": "d9b590e1-1c6c-3239-a9ba-80599e9a749f",
                        "entry_id": "5a81e017-8391-33f8-9b50-c0cfc8dbb9e4",
                        "glosses": [
                            "Qui émoustille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92059742-46ea-43c2-bce0-88b70d58a0ea",
                                "sense_id": "d9b590e1-1c6c-3239-a9ba-80599e9a749f",
                                "text": "Avec ça, je m’exhibe dans les boîtes de nuit et les grands restaurants la plus superbe poule qui se puisse rêver, ma dactylo, Suzanne, une enfant de dix-huit ans, fraîche, brune, émoustillante en diable, avec des yeux spirituels, dans une frimousse d’ingénue."
                            },
                            {
                                "example_id": "80a8cbdc-9fdc-4468-8c8b-6f6232a89a3c",
                                "sense_id": "d9b590e1-1c6c-3239-a9ba-80599e9a749f",
                                "text": "Toutes sortes de firmes, par le moyen de leurs succursales, lancent vers lui, ou plutôt vers son escarcelle, leurs tentacules émoustillants, titillants et aspirants."
                            },
                            {
                                "example_id": "f5c6cd80-d680-441d-baf2-14cfd99a06d6",
                                "sense_id": "d9b590e1-1c6c-3239-a9ba-80599e9a749f",
                                "text": "Un peu pète-sec mais les serveuses sont ravissantes, enfin du moins si vous appréciez les grandes duduches blondes aux lèvres turlupinées de rouge à lèvres, aux seins en service minimum, à l’arrière-train ferronné dans une minijupe noire émoustillante mais faussement prometteuse."
                            }
                        ]
                    }
                ],
