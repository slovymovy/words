                "senses": [
                    {
                        "sense_id": "d4d21888-7f43-33b7-8e43-ba080457ca58",
                        "entry_id": "46b665bf-591d-336f-a1b0-4b92100bd4f6",
                        "glosses": [
                            "im gesamten Bundesstaat gleich; regional keine Unterschiedene aufweisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "279e895c-986f-4ea4-a934-c5d9fb3524a0",
                                "sense_id": "d4d21888-7f43-33b7-8e43-ba080457ca58",
                                "text": "„Dräger moniert, dass der Entwurf keine bundeseinheitlichen Standards definiere.“"
                            },
                            {
                                "example_id": "d07a7280-c477-4950-8f65-4816d2755759",
                                "sense_id": "d4d21888-7f43-33b7-8e43-ba080457ca58",
                                "text": "„Bundeseinheitliche Tarifreglungen zu Ausbildungsvergütungen gibt es nur in wenigen Branchen, etwa bei Banken und Versicherungen, dem öffentlichen Dienst oder der Druckindustrie.“"
                            },
                            {
                                "example_id": "78d96c85-1013-4418-b942-eef44203d401",
                                "sense_id": "d4d21888-7f43-33b7-8e43-ba080457ca58",
                                "text": "„Für die Geltendmachung des Anspruches ist das hiefür bundeseinheitlich aufgelegte Antragsformular zu verwenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
