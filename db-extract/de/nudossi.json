                        "glosses": [
                            "eine herstellerspezifische Bezeichnung für dessen Variante von Nuss-Nugat-Creme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d83dc0dc-b891-46f4-9b8b-55e3b3d5f51c",
                                "sense_id": "b99517d6-f3a8-3a67-9533-a754ab429c55",
                                "text": "„Kann ich bitte die (das, den) Nudossi haben?\""
                            },
                            {
                                "example_id": "f01c718f-482d-458a-aea9-2515ee98c8b1",
                                "sense_id": "b99517d6-f3a8-3a67-9533-a754ab429c55",
                                "text": "„Dank der offiziellen Zuteilung Nudossis als ein Produkt, das nicht als Grundnahrungsmittel in den ‚normalen‘ Kaufhallen zu erwerben war, sondern nur über die Delikat-Läden, weckte der Brotaufstrich Interesse.“"
                            }
                        ],
