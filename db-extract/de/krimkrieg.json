                        "glosses": [
                            "Krieg von 1853 bis 1856 im Schwarzmeerraum zwischen dem Russischen Reich und dem Osmanischen Reich und seinen Verbündeten Großbritannien, Frankreich und Sardinien"
                        ],
                        "tags": [],
                        "examples": [
