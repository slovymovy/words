                                        "sense_id": "f08ed315-b236-3fc5-8d00-74b41afdba51",
                                        "entry_id": "ef21607c-930c-3f78-8144-9649108ca9ce",
                                        "glosses": [
                                            "der weibliche Hirsch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e2b5027-b6be-4ebf-9687-73362e7628e5",
                                                "sense_id": "f08ed315-b236-3fc5-8d00-74b41afdba51",
                                                "text": "Die Hirschkuh stand zusammen mit dem Hirsch in der Weide."
                                            },
                                            {
                                                "example_id": "7cdab3f3-6e8b-47ae-af51-8892a636595b",
                                                "sense_id": "f08ed315-b236-3fc5-8d00-74b41afdba51",
                                                "text": "„Über einem breiten Bett im übelsten Jugendststil hing in einem massigen Goldrahmen eine Waldlandschaft mit einem röhrenden Hirsch, ein paar Hirschkühen und einer Quelle im Vordergrunde.“"
                                            },
                                            {
                                                "example_id": "e7e7d082-5081-4b64-90df-605b12bbd5b3",
                                                "sense_id": "f08ed315-b236-3fc5-8d00-74b41afdba51",
                                                "text": "„Vorsichtig den schönen Kopf erhebend, schritt leise eine Hirschkuh mit dem jungen Kalbe über den Weg, blieb einen Augenblick, die breite Straße hinauf- und hinabschauend, stehen und verschwand dann langsam im Dickicht, als ob sie wisse, es drohe ihr von den Nahenden keine Gefahr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
