                    "frequency": "High",
                    "semantic_group_id": "peau_animale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai la <w>peau</w> très sèche en hiver, alors j'utilise une crème."
                        },
                        {
                            "text": "Le soleil est dangereux pour la <w>peau</w> des enfants."
                        },
                        {
                            "text": "Elle a la <w>peau</w> grasse et utilise un nettoyant doux."
                        }
