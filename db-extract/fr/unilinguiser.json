                        "glosses": [
                            "Donner un caractère unilingue à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a55d5fa6-a04f-4fdf-80bb-67400e6ca2e1",
                                "sense_id": "2b6f6014-0ec9-3e9e-b4d2-67188ef9ef15",
                                "text": "La volonté des néerlandophones d’Anvers d’unilinguiser la Flandre se heurtera en effet à d’autres impératifs conditionnant également le développement de la Gemeinschaft flamande."
                            },
                            {
                                "example_id": "7369a937-b5ba-4467-be8a-50bc1129c853",
                                "sense_id": "2b6f6014-0ec9-3e9e-b4d2-67188ef9ef15",
                                "text": "Cette double politique n'a rien ralenti d'une trajectoire défavorable au français au Canada et contribue à unilinguiser toujours davantage sa population."
                            },
                            {
                                "example_id": "bc905e02-925b-4b75-ade5-c8a44eeab70a",
                                "sense_id": "2b6f6014-0ec9-3e9e-b4d2-67188ef9ef15",
                                "text": "Les communautés ont une tendance naturelle à s’unilinguiser."
                            }
                        ]
                    }
