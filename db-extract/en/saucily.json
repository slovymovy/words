                        "glosses": [
                            "In a saucy manner; impudently or impertinently."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69209985-8528-476f-94b2-1c0d87dcd90b",
                                "sense_id": "a9146855-b595-3302-9b89-1acd3b326263",
                                "text": "She walked off saucily and I watched, entranced, until she turned the corner; then I ran after her to ask her for a date."
                            },
                            {
                                "example_id": "615146f2-3180-4ec5-a265-bbdeb7f68ccf",
                                "sense_id": "a9146855-b595-3302-9b89-1acd3b326263",
                                "text": "The Clown put his hands in his pockets, and after puffing out his cheeks and nodding his head at them saucily he said, “My lady fair, / Why do you stare / At poor old Mr. Joker? / You’re quite as stiff / And prim as if / You’d eaten up a poker!”"
                            },
                            {
                                "example_id": "b1411269-1287-41aa-b48e-9fa8ff917054",
                                "sense_id": "a9146855-b595-3302-9b89-1acd3b326263",
                                "text": "'What do you want?' she called saucily from the top of the stairs."
                            }
                        ]
                    }
