                "senses": [
                    {
                        "sense_id": "54753a3e-4180-337f-9933-df12e30da2b1",
                        "entry_id": "1cb0bfff-7e19-30b2-8495-e468bb7e2203",
                        "glosses": [
                            "związany z Innsbruckiem, dotyczący Innsbrucka, pochodzący z Innsbrucka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "022c38c5-4d51-43ea-965a-cf3a7b8a4c4b",
                                "sense_id": "54753a3e-4180-337f-9933-df12e30da2b1",
                                "text": "Nasze źródła w policji twierdzą, że głowa i nogi Ludwiga zostały znalezione na jednym z innsbruckich cmentarzy"
                            },
                            {
                                "example_id": "f0fd0496-feb0-4d71-8274-bbf754b5d752",
                                "sense_id": "54753a3e-4180-337f-9933-df12e30da2b1",
                                "text": "W tym czasie w Mühlen pod Innsbruckiem podjęto prace nad odlaniem pierwszych wielkich figur przodków cesarza Maksymiliana do jego mauzoleum w innsbruckim kościele dworskim"
                            }
                        ],
