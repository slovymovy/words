                    },
                    {
                        "form_id": "8e098335-8029-42b1-b009-3d27e8f68adf",
                        "entry_id": "4f2ada87-51e5-38ff-9fd9-1625d51a86c3",
                        "tags": [],
                        "form": "gable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "09b4c974-9da4-3882-8b1d-43d04b4ee4a3",
                        "entry_id": "4f2ada87-51e5-38ff-9fd9-1625d51a86c3",
                        "glosses": [
                            "Ensemble ornemental triangulaire, qui dans l’architecture gothique, surmonte l’arc d'une baie, l’archivolte d’un portail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da44dcac-b4f8-41b5-8ad0-31840503fb46",
                                "sense_id": "09b4c974-9da4-3882-8b1d-43d04b4ee4a3",
                                "text": "Le foisonnement de flèches, de gâbles, de pinacles qui la couronnent, dresse vers le ciel comme une ville de rêve, et dans cette idéale cité de Dieu le paysage urbain se trouve magnifié."
                            },
                            {
                                "example_id": "bbd59b96-d786-472a-9fae-4123c40888ad",
                                "sense_id": "09b4c974-9da4-3882-8b1d-43d04b4ee4a3",
                                "text": "La châsse se présente sous la forme d’une chapelle miniature en bois doré, de style gothique flamboyant, avec ses gâbles, ses pinacles, ses fleurons, ses entrelacs, et une décoration peinte."
                            },
                            {
                                "example_id": "f0ad417b-2ed3-454b-946a-e80b2c05e0ce",
                                "sense_id": "09b4c974-9da4-3882-8b1d-43d04b4ee4a3",
                                "text": "L’autre commande, qui n’est pas documentée, dut être passée au doyen des peintres florentins, Lorenzo Monaco, dont les petits tableaux occupent toujours les trois gâbles de la Déposition de croix de Fra Angelico sous sa forme actuelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aac97859-deb9-40e6-a8f3-078148cef52a",
                        "source_entry_id": "4f2ada87-51e5-38ff-9fd9-1625d51a86c3",
                        "source_sense_id": "09b4c974-9da4-3882-8b1d-43d04b4ee4a3",
                        "target_lang_word": "Wimperg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wimperg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4a88c26-5c30-30e6-89c1-60ddfc8e8e0c",
                                        "entry_id": "d1a93d5a-cf96-38bf-a276-94a32fa7430f",
                                        "glosses": [
                                            "Giebelhafte Verkleidung eines Portals oder eines Fensters in der gotischen Architektur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc716bf8-e874-4ed6-9fc9-c7dadb7608aa",
                                                "sense_id": "f4a88c26-5c30-30e6-89c1-60ddfc8e8e0c",
                                                "text": "Die Mönche entströmten der Kirche im Trauerzug aus dem Wimperg."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ed3198f-6b4a-4df2-8a99-2c19004dfc8f",
                        "source_entry_id": "4f2ada87-51e5-38ff-9fd9-1625d51a86c3",
                        "source_sense_id": "09b4c974-9da4-3882-8b1d-43d04b4ee4a3",
                        "target_lang_word": "gable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a42a7ec-af6a-33de-9e43-6e7d21baf543",
                                        "entry_id": "955dfdb8-f6b4-3c6c-afa2-c1472657c9f9",
                                        "glosses": [
                                            "The triangular area at the peak of an external wall adjacent to, and terminating, two sloped roof surfaces (pitches)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7437eb0-83e9-4210-9a54-1b2ed58d4622",
                                                "sense_id": "8a42a7ec-af6a-33de-9e43-6e7d21baf543",
                                                "text": "It was a queer sort of place—a gable-ended old house, one side palsied as it were, and leaning over sadly."
                                            },
                                            {
                                                "example_id": "0a166f3c-3bd9-4996-9236-20c653e0dd2d",
                                                "sense_id": "8a42a7ec-af6a-33de-9e43-6e7d21baf543",
                                                "text": "Although there were important developments in the internal organization of Cape houses during this period, their most obvious element is the gable. End-gables were common in medieval northern European and particularly Dutch buildings, but central gables set into the long side of roofs were more unusual and became the quintessential feature of the Cape Dutch style."
                                            },
                                            {
                                                "example_id": "97301e7e-3a82-4c68-b81d-2c127d21d1f7",
                                                "sense_id": "8a42a7ec-af6a-33de-9e43-6e7d21baf543",
                                                "text": "Qionglin Village in Kinhu with its well-preserved ancestral halls, arches, and old Fujian-style houses with interesting gables is famous for having more shrines than any other village on Kinmen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70a51b81-77df-326c-8b32-587f3ff23060",
                                        "entry_id": "37a8c679-3fff-301c-8611-bde95140eed7",
                                        "glosses": [
                                            "A cable."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f8454b9-be57-4207-a26f-683bb0874381",
                                                "sense_id": "70a51b81-77df-326c-8b32-587f3ff23060",
                                                "text": "First, striking sail, their tacklings then they loosed.\nAnd (with their gables stoop'd) their mast imposed\nInto the mast-room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
