                                    {
                                        "sense_id": "e9e7d86c-5848-36d6-bcb9-674b652cc2ae",
                                        "entry_id": "fc9ad750-43f6-3ba9-839f-596c19489f86",
                                        "glosses": [
                                            "An individual who receives an income, usually interest, rent, dividends, capital gains, or profits from his or her assets and investments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03f59d8e-dadf-4a8f-ac11-65d4cb336258",
                                                "sense_id": "e9e7d86c-5848-36d6-bcb9-674b652cc2ae",
                                                "text": "If today’s capitalists are mere lazy rentiers who contribute nothing to the production process, don’t they deserve to be downgraded to the status of feudal landlords?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
