    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d2ce7f87-97b5-35b3-b30d-656f97a8c823",
                    "sense_definition": "A flaw, fault, or blemish that makes something less than perfect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imperfection_concrete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jeweler noticed a slight <w>imperfection</w> deep inside the diamond.",
                            "target_lang_translations": {
                                "fr": "Le bijoutier a remarqué une légère <w>imperfection</w> au cœur du diamant.",
                                "zh": "珠宝商注意到这颗钻石深处有一处微小的<w>瑕疵</w>。"
                            }
                        },
                        {
                            "text": "She loved him completely despite every minor <w>imperfection</w> in his character.",
                            "target_lang_translations": {
                                "fr": "Elle l'aimait totalement malgré chaque petit <w>défaut</w> de son caractère.",
                                "zh": "尽管他性格中有种种微小的<w>缺点</w>，她依然全心全意地爱着他。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fault",
                        "flaw",
                        "weakness"
                    ],
                    "common_phrases": [
                        "minor imperfection",
                        "slight imperfection",
                        "surface imperfection"
                    ],
                    "target_lang_definitions": {
                        "fr": "Défaut, anomalie ou petite marque qui empêche quelque chose d'être parfait.",
                        "zh": "使某物不够完美的缺点、瑕疵或缺陷。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "imperfection",
                                "target_lang_sense_clarification": "défaut ou bémol, physique ou moral"
                            },
                            {
                                "target_lang_word": "défaut",
                                "target_lang_sense_clarification": "manquement, anomalie ou trait négatif"
                            },
                            {
                                "target_lang_word": "défaut de fabrication",
                                "target_lang_sense_clarification": "vice ou anomalie matérielle"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瑕疵",
                                "target_lang_sense_clarification": "指物品、容貌或性格上的微小缺点"
                            },
                            {
                                "target_lang_word": "缺点",
                                "target_lang_sense_clarification": "指性格、品质或表现上的不足之处"
                            },
                            {
                                "target_lang_word": "缺陷",
                                "target_lang_sense_clarification": "指事物不够完备或有欠缺的地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43f2ad4b-864b-39a0-a708-02d214067359",
                    "sense_definition": "The state, condition, or quality of being imperfect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imperfection_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Living happily requires learning to accept human <w>imperfection</w> without constant frustration.",
                            "target_lang_translations": {
                                "fr": "Vivre heureux exige d'apprendre à accepter l'<w>imperfection</w> humaine sans frustration constante.",
                                "zh": "要想生活得幸福，就需要学会接纳人类的<w>不完美</w>，而不必总是感到沮丧。"
                            }
                        },
                        {
                            "text": "The artist embraced <w>imperfection</w> as a natural part of the creative process.",
                            "target_lang_translations": {
                                "fr": "L'artiste a accepté l'<w>imperfection</w> comme faisant naturellement partie du processus de création.",
                                "zh": "这位艺术家将<w>不完美</w>视为创作过程中自然而然的一部分。"
                            }
                        }
                    ],
                    "antonyms": [
                        "flawlessness",
                        "perfection"
                    ],
                    "common_phrases": [
                        "human imperfection",
                        "state of imperfection",
                        "accept imperfection"
                    ],
                    "target_lang_definitions": {
                        "fr": "État, condition ou caractère de ce qui n'est pas parfait.",
                        "zh": "不完美的状态、性质或属性。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "imperfection",
                                "target_lang_sense_clarification": "état de ce qui est imparfait"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不完美",
                                "target_lang_sense_clarification": "抽象概念，指事物或人达不到完美的状态"
                            },
                            {
                                "target_lang_word": "残缺",
                                "target_lang_sense_clarification": "指不完备、有缺损的状态或特质"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}