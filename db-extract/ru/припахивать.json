                                "example_id": "e6f24a56-ff45-46bb-bc8a-a1cca7fabd35",
                                "sense_id": "f19e8b9a-0df2-3bfd-832a-4fa2defd6ff7",
                                "text": "Вино было теплым, кислым и припахивало нефтью."
                            }
                        ]
                    },
                    {
                        "sense_id": "86f20ff0-f319-33dd-a0cd-337d98f20af9",
                        "entry_id": "b76aad7a-3a95-3d11-9047-4f9186e49b90",
                        "glosses": [
                            "разг., издавать дурной, гнилостный запах (об испорченных продуктах)"
                        ],
                        "tags": [
                            "без дополнения"
                        ],
                        "examples": [
                            {
                                "example_id": "514a9775-0b40-4ce7-a3ab-9f7c25bbe804",
                                "sense_id": "86f20ff0-f319-33dd-a0cd-337d98f20af9",
                                "text": "Правда, тинный карась уже припахивает, всегда лучше карась из глубокой воды ― нежнее, на цвет красивее."
                            }
                        ]
                    },
                    {
                        "sense_id": "f385f078-07d8-30f5-b239-18c79cc7213c",
                        "entry_id": "b76aad7a-3a95-3d11-9047-4f9186e49b90",
                        "glosses": [
                            "перен., разг. слегка походить на что-либо, напоминать о чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bcd44d6-613c-4899-bacf-20ae4d7c5216",
                                "sense_id": "f385f078-07d8-30f5-b239-18c79cc7213c",
                                "text": "Комплимент был сомнительный, от него припахивало мертвецкой: свежий труп, богатый материал."
                            }
                        ]
                    }
