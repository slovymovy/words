                    {
                        "sense_id": "f4f3f6fc-3592-3385-a86d-baa330e23fc9",
                        "entry_id": "668c1085-9ee8-30b4-bd6f-22d67e21100f",
                        "glosses": [
                            "Titel der Gattin des Thronerben des Königs von Frankreich"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ffb4b245-6e8c-47ea-811c-bcac33de1b8c",
                                "sense_id": "f4f3f6fc-3592-3385-a86d-baa330e23fc9",
                                "text": "„Baletti hatte es eilig, nach Paris zu kommen, wo in Erwartung der Geburt eines Herzogs von Burgund prachtvolle Feste in Vorbereitung waren; denn die Frau Dauphine sah ihrer Niederkunft entgegen.“"
                            },
                            {
                                "example_id": "5ebeb6d9-7dca-4b89-b1cd-a886df8cc82c",
                                "sense_id": "f4f3f6fc-3592-3385-a86d-baa330e23fc9",
                                "text": "„[…] [I]ch fragte den Kellner, ob es etwas Neues gäbe; er antwortete, die Dauphine sei mit einem Prinzen niedergekommen. Ein Abbé, der dicht nebenan an einem Tische saß, sagte zu ihm: »Unsinn! sie hat eine Prinzessin zur Welt gebracht.« Ein Dritter trat heran und sagte: »Ich komme eben von Versailles; die Dauphine hat weder einen Prinzen noch eine Prinzessin geboren.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2437947-f7d2-41f2-b68e-567325133cdf",
                        "source_entry_id": "668c1085-9ee8-30b4-bd6f-22d67e21100f",
                        "source_sense_id": "f4f3f6fc-3592-3385-a86d-baa330e23fc9",
