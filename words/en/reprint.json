{
    "word_family": [
        "printer",
        "printing",
        "printable",
        "misprint",
        "overprint",
        "blueprint",
        "fingerprint",
        "footprint",
        "newsprint"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a2177de-d791-3393-99be-0d9cae382e79",
                    "sense_definition": "To print something again, especially a book or article that has already been published.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "publishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The publisher decided to <w>reprint</w> the classic novel due to high demand from readers.",
                            "target_lang_translations": {
                                "ru": "Издатель решил <w>переиздать</w> классический роман из-за высокого спроса со стороны читателей."
                            }
                        },
                        {
                            "text": "They will <w>reprint</w> the article in next month's issue of the magazine.",
                            "target_lang_translations": {
                                "ru": "Они <w>перепечатают</w> статью в следующем номере журнала."
                            }
                        }
                    ],
                    "synonyms": [
                        "reissue",
                        "republish"
                    ],
                    "common_phrases": [
                        "reprint the article",
                        "reprint a book"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напечатать что-либо повторно, особенно книгу или статью, которая уже была опубликована."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перепечатывать",
                                "target_lang_sense_clarification": "повторно печатать текст"
                            },
                            {
                                "target_lang_word": "переиздавать",
                                "target_lang_sense_clarification": "выпускать новое издание книги или статьи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea623e80-06ee-39bf-a981-bd55f1055006",
                    "sense_definition": "To restore or renew an impression, image, or quality upon something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that education serves to <w>reprint</w> moral values upon the young mind.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что образование служит для того, чтобы вновь <w>запечатлеть</w> моральные ценности в сознании молодежи."
                            }
                        },
                        {
                            "text": "The spiritual journey was intended to <w>reprint</w> a sense of peace within his soul.",
                            "target_lang_translations": {
                                "ru": "Духовное путешествие было призвано <w>восстановить</w> чувство покоя в его душе."
                            }
                        }
                    ],
                    "synonyms": [
                        "restore",
                        "impress"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in a figurative or spiritual sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстановить или заново запечатлеть образ, впечатление или качество на чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запечатлевать",
                                "target_lang_sense_clarification": "в переносном смысле, оставлять след в сознании"
                            },
                            {
                                "target_lang_word": "восстанавливать",
                                "target_lang_sense_clarification": "возвращать прежнее состояние или образ"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4a50692-dfa8-36e0-81cd-1fc06e7e389d",
                    "sense_definition": "A new printing of a book, pamphlet, or other material that has been published before.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "publishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reprint</w> is much less expensive than a rare first edition of the book.",
                            "target_lang_translations": {
                                "ru": "Это <w>переиздание</w> стоит гораздо дешевле, чем редкое первое издание книги."
                            }
                        },
                        {
                            "text": "I bought a cheap <w>reprint</w> of the textbook because the original was out of stock.",
                            "target_lang_translations": {
                                "ru": "Я купил дешевую <w>перепечатку</w> учебника, так как оригинала не было в наличии."
                            }
                        }
                    ],
                    "synonyms": [
                        "reissue",
                        "new edition"
                    ],
                    "antonyms": [
                        "original",
                        "first edition"
                    ],
                    "common_phrases": [
                        "cheap reprint",
                        "paperback reprint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новый тираж книги, брошюры или другого материала, который уже издавался ранее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переиздание",
                                "target_lang_sense_clarification": "повторный выпуск печатного издания"
                            },
                            {
                                "target_lang_word": "репринт",
                                "target_lang_sense_clarification": "точное воспроизведение старого издания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}