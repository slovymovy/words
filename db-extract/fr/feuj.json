                "translations": [
                    {
                        "translation_id": "2d6f5a27-c982-426c-bbd3-e9a6c1ade00c",
                        "source_entry_id": "14ecf025-1e85-38d1-8dee-7aedea336293",
                        "source_sense_id": "d0454265-eccb-30db-9611-16a498167563",
                        "source_sense_description": "umgangssprachlich, Religion: Jüdin",
                        "target_lang_word": "Jüdin",
