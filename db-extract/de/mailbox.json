                "senses": [
                    {
                        "sense_id": "ea4e8277-475b-34a4-b8d8-601a0898ecdf",
                        "entry_id": "88d2cf2a-c3d8-3530-9e11-6b47038217bf",
                        "glosses": [
                            "Speicherplatz für eingehende E-Mails oder Telefonate"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2badbd13-3ca8-44c8-af84-5a23399dfbb5",
                                "sense_id": "ea4e8277-475b-34a4-b8d8-601a0898ecdf",
                                "text": "„Am nächsten Morgen fand ich ihre Antwort in meiner Mailbox, getippt von der Journalistin.“"
                            },
                            {
                                "example_id": "90238fae-5413-416d-847d-4da02995b7f3",
                                "sense_id": "ea4e8277-475b-34a4-b8d8-601a0898ecdf",
                                "text": "„Kaum eine Mailbox ist davor sicher, von solchen Sendungen heimgesucht zu werden.“"
                            },
                            {
                                "example_id": "3a086afb-10e4-4e23-8477-ad2227cdc44f",
                                "sense_id": "ea4e8277-475b-34a4-b8d8-601a0898ecdf",
                                "text": "„Ich legte auf, bevor die Mailbox drangehen konnte, und wählte Milenas Nummer erneut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
