                        "examples": [
                            {
                                "example_id": "8bca8bc4-02ec-43d7-b4e9-a5da40afc581",
                                "sense_id": "fe6dce8f-d50c-3268-adfb-844b63557c31",
                                "text": "Geen krijgsmacht in vredestijd heeft er de afgelopen jaren zoveel geld bij gekregen als het Volksbevrijdingsleger, zoals de officiële naam luidt van de strijdkrachten van Peking: elk jaar meer dan 10 procent. De marine profiteert daar sterk van, zoals is te zien bij de badplaats Sanya op Hainan. Hoewel de Chinese strijdkrachten graag de deuren voor pottenkijkers gesloten houden, bieden sommige hoge toeristenhotels bij de baai van Sanya een illustratief zicht op de vlootbasis."
                            },
                            {
                                "example_id": "996eaa27-aca2-4d3c-8ec3-bef1eab2fcab",
                                "sense_id": "fe6dce8f-d50c-3268-adfb-844b63557c31",
                                "text": "De vlootbasis Moermansk is vergeven van wegrottend en lekkend nucleair materiaal. Volgens de IAEA is dat een bedreiging voor mens en milieu tot ver buiten Rusland."
                            }
                        ]
                    }
