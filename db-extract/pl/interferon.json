                ],
                "senses": [
                    {
                        "sense_id": "88fef6f3-3cc3-3d9a-a135-9090725ba8ef",
                        "entry_id": "73ab4f7c-3808-3b69-8e0d-661fdca4d84d",
                        "glosses": [
                            "interferon (any of a group of glycoproteins, that prevent viral replication in infected cells)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "4b2394be-b835-48c6-ad35-6e5bc2d57250",
                                "sense_id": "88fef6f3-3cc3-3d9a-a135-9090725ba8ef",
                                "text": "interferon alfa",
                                "translation": "interferon-alpha",
                                "english": "interferon-alpha"
                            },
                            {
                                "example_id": "c3f643ac-ea9a-4a99-908b-8e27a39f5dc4",
                                "sense_id": "88fef6f3-3cc3-3d9a-a135-9090725ba8ef",
                                "text": "Działanie immunosupresyjne glikokortykosteroidów wiąże się m.in. z hamowaniem uwalniania interleukin IL-1, IL-2, IL-3, IL-4, IL-6, czynnika nekrozy nowotworu (TNF-a), interferonu g.",
                                "translation": "The immunosuppressive effect of glucocorticosteroids is associated with, among others, the inhibition of the release of interleukins IL-1, IL-2, IL-3, IL-4, IL-6, tumor necrosis factor (TNF-a), and interferon g.",
                                "english": "The immunosuppressive effect of glucocorticosteroids is associated with, among others, the inhibition of the release of interleukins IL-1, IL-2, IL-3, IL-4, IL-6, tumor necrosis factor (TNF-a), and interferon g."
                            },
                            {
                                "example_id": "35835c92-a77f-4719-a8e4-6eff230f5c8f",
                                "sense_id": "88fef6f3-3cc3-3d9a-a135-9090725ba8ef",
                                "text": "Do walki wkraczają przeciwciała, limfocyty, i interferony, mające zdolność hamowania replikacji (namnażania) wirusów.",
                                "translation": "Antibodies, lymphocytes, and interferons, which have the ability to inhibit the replication (multiplication) of viruses, enter the fray.",
                                "english": "Antibodies, lymphocytes, and interferons, which have the ability to inhibit the replication (multiplication) of viruses, enter the fray."
                            },
                            {
                                "example_id": "83ed45e7-f494-467f-8e6b-ee933ddb2a19",
                                "sense_id": "88fef6f3-3cc3-3d9a-a135-9090725ba8ef",
                                "text": "Stymulowane interferonem makrofagi nie tylko skuteczniej fagocytują mikroorganizmy, ale przede wszystkim stają się cytotoksyczne wobec, na przykład, komórek nowotworowych.",
                                "translation": "Interferon-stimulated macrophages not only phagocytose microorganisms more effectively, but most importantly become cytotoxic against, for example, cancer cells.",
                                "english": "Interferon-stimulated macrophages not only phagocytose microorganisms more effectively, but most importantly become cytotoxic against, for example, cancer cells."
                            }
                        ]
                    }
                ],
