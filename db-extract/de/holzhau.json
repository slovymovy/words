                "senses": [
                    {
                        "sense_id": "96fd8311-47e4-35f2-878e-6cedfd037d19",
                        "entry_id": "eb20510a-94ad-3f77-be3c-47de9c1fbe4a",
                        "glosses": [
                            "Ort im Landkreis Mittelsachsen des Freistaates Sachsen in Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0cdd44-ec35-479a-83b6-f599e39b09b5",
                                "sense_id": "96fd8311-47e4-35f2-878e-6cedfd037d19",
                                "text": "„1994 gab die bis dahin selbständige Gemeinde Holzhau ihre Selbständigkeit auf und wurde nach Rechenberg-Bienenmühle eingemeindet.“"
                            },
                            {
                                "example_id": "72a44180-5f17-4eec-9f26-2f44dc6872c5",
                                "sense_id": "96fd8311-47e4-35f2-878e-6cedfd037d19",
                                "text": "„‚Es gibt diesen Spruch: Wer in Holzhau Skifahren gelernt hat, der kann es überall.‘“"
                            },
                            {
                                "example_id": "76f6682b-9dfc-42ae-bfba-a370e2006cd2",
                                "sense_id": "96fd8311-47e4-35f2-878e-6cedfd037d19",
                                "text": "„Zwischen dem vogtländischen Bad Elster und dem osterzgebirgischen Holzhau erstreckt sich auf einer Fläche von etwa 1.500 qkm der 1991 eingerichtete Naturpark Erzgebirge-Vogtland.“"
                            },
                            {
                                "example_id": "a45031a6-103d-467d-a085-c34d7ab0dbb6",
                                "sense_id": "96fd8311-47e4-35f2-878e-6cedfd037d19",
                                "text": "„Im Fiſcherwalde lieſſen ſich, als man 1540 Floͤßholz faͤllte, viel Holzhauer nieder, woraus das kleine D. [Dorf] Holzhau entſtand. Doch erhielt das Dorf den Namen nicht von den Anſiedlern. Sondern Holzhau heißt eigentlich ieder Platz im Walde, wo die Baͤume ſeit langen Zeiten niedergehauen ſind. Dergleichen Holzhaue findet man bei Altenberg und auf dem Zinnwalde ſehr haͤufig.“ [1804]"
                            }
                        ],
