        "fr-extract.jsonl": [
            {
                "entry_id": "7f9a2af9-4bc4-3fd5-930e-66731d1bcae7",
                "word": "chiptune",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "84ad3fb5-28f8-33ca-831e-0eb5f746e75a",
                        "entry_id": "7f9a2af9-4bc4-3fd5-930e-66731d1bcae7",
                        "glosses": [
                            "Genre musical caractérisé la production de sons au moyen d’une puce audio."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "182e59b4-99e3-4835-9a2b-09d62af6fa92",
                                "sense_id": "84ad3fb5-28f8-33ca-831e-0eb5f746e75a",
                                "text": "Pour faire court si je n’avais pas découvert ce morceau, jamais je ne me serais lancé dans la chiptune sur GameBoy."
                            },
                            {
                                "example_id": "b08cea89-e9eb-44a3-a53e-61aed281b147",
                                "sense_id": "84ad3fb5-28f8-33ca-831e-0eb5f746e75a",
                                "text": "D'ailleurs, la structure anglaise n'avait pas hésité a miser un beau paquet de billets sur la chiptune (comprendre la musique 8bit/16bit) en sortant des disques de Zomby, Joker ou encore Quarta 330 — qui avait d'ailleurs offert un remix très « boss de fin » au « 9 Samurai » de Kode9."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c95ebb69-da14-4140-a08a-004cd099a736",
                        "source_entry_id": "7f9a2af9-4bc4-3fd5-930e-66731d1bcae7",
                        "source_sense_id": "84ad3fb5-28f8-33ca-831e-0eb5f746e75a",
                        "target_lang_word": "chiptune",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiptune",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c268fc3c-80f7-3007-87f8-0af8539d4d45",
                                        "entry_id": "b0d6ee0d-737f-3d99-9a46-6847222486d1",
                                        "glosses": [
                                            "A piece of computer music in which the sounds are generated and mixed in realtime, common before the advent of mass storage for prerecorded sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9307f3e1-1e43-45ef-929d-53e2ed893bed",
                                                "sense_id": "c268fc3c-80f7-3007-87f8-0af8539d4d45",
                                                "text": "Composers of chiptune and demoscene music practice the art of game music in vitro, with no particular commercial endeavor."
                                            },
                                            {
                                                "example_id": "e84804c9-26fe-4aca-a3ce-5366d71a26de",
                                                "sense_id": "c268fc3c-80f7-3007-87f8-0af8539d4d45",
                                                "text": "[…] it has been so popular with chiptune musicians […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40f6aa41-681b-3b04-b6bb-07df045ecd05",
                                        "entry_id": "b0d6ee0d-737f-3d99-9a46-6847222486d1",
                                        "glosses": [
                                            "A style of music that samples or emulates the audio capabilities of older sound chips, but ignores certain hardware or software limitations inherent to them; especially (demoscene) a tracker module simulating the sound of early 8-bit computers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
