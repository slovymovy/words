                "senses": [
                    {
                        "sense_id": "7f20ebbd-8e25-3da2-a5a9-345f0025f522",
                        "entry_id": "35b21983-4d44-33c8-86a3-c5f3a149e24e",
                        "glosses": [
                            "een schriftteken van het Oud-Germaanse alfabet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bec96f8-b8ca-473e-8c99-428965c5295c",
                                "sense_id": "7f20ebbd-8e25-3da2-a5a9-345f0025f522",
                                "text": "Hij kende alle runen uit zijn hoofd en kon er ook mee schrijven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee194bd3-4103-4eb9-83ef-8ec0a591cc10",
                        "source_entry_id": "35b21983-4d44-33c8-86a3-c5f3a149e24e",
                        "source_sense_id": "7f20ebbd-8e25-3da2-a5a9-345f0025f522",
                        "source_sense_description": "een schriftteken van het Oud-Germaanse alfabet",
                        "target_lang_word": "Rune",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rune",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ed450c2-8df4-32ce-96ad-72113c51fe9d",
                                        "entry_id": "13eca059-b53f-30db-bed7-d46b591d8d92",
                                        "glosses": [
                                            "älteste Schriftzeichen der Germanen"
                                        ],
                                        "tags": [
                                            "Germanistik",
                                            "Skandinavistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db098541-77ca-4760-abba-e7a0c79c65d8",
                                                "sense_id": "2ed450c2-8df4-32ce-96ad-72113c51fe9d",
                                                "text": "In Skandinavien wurden Runen teilweise bis ins 19. Jahrhundert verwendet."
                                            },
                                            {
                                                "example_id": "6642c8dc-f1d3-4409-9f4b-94c8c2a9f7ab",
                                                "sense_id": "2ed450c2-8df4-32ce-96ad-72113c51fe9d",
                                                "text": "„Unter Runen versteht die Forschung die einheimischen Schriftzeichen, deren sich die germanischen Stämme vor und teilweise neben dem Gebrauch der lateinischen Schrift bedienten.“"
                                            },
                                            {
                                                "example_id": "dbc0bc9e-5985-4935-9b6e-21ec452103ed",
                                                "sense_id": "2ed450c2-8df4-32ce-96ad-72113c51fe9d",
                                                "text": "„Die Runen dienten vor allem kultischen Zwecken…“"
                                            },
                                            {
                                                "example_id": "a85250ff-6b12-46c9-aaf5-a5a4323cb0d7",
                                                "sense_id": "2ed450c2-8df4-32ce-96ad-72113c51fe9d",
                                                "text": "„Eine nicht ferne Zeit hat im deutschsprachigen Raum auch versucht, das Interesse an den Runen wieder künstlich zu wecken, ohne freilich deren Kenntnis wirklich zu fördern.“"
                                            },
                                            {
                                                "example_id": "1c98993a-8a39-499b-b86f-20a972428375",
                                                "sense_id": "2ed450c2-8df4-32ce-96ad-72113c51fe9d",
                                                "text": "„Die Runen dienten, schon seit den ältesten Zeiten, großenteils magischen Zwecken, und diese Verwendung ist auch in Island noch lange bezeugt.“"
                                            },
                                            {
                                                "example_id": "a72352d0-0da1-48f8-8987-0b33ba3f1ada",
                                                "sense_id": "2ed450c2-8df4-32ce-96ad-72113c51fe9d",
                                                "text": "„Was von ihm bleibt, sind die Runen auf dem Kamm, nur 1,4 Zentimeter hoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a3c7660-24e5-3e71-bbf3-83124f8ee506",
                                        "entry_id": "13eca059-b53f-30db-bed7-d46b591d8d92",
                                        "glosses": [
                                            "älteres finnisches Lied"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e9b0d3f-7786-4456-bda7-24579b562018",
                                                "sense_id": "2a3c7660-24e5-3e71-bbf3-83124f8ee506",
                                                "text": "Die große Masse der finnischen Lieder oder Runen, die man das Kalevalaepos zu nennen pflegt, sind ursprünglich Einzelgedichte und behandeln Episoden, die später zu größeren Zyklen zusammengeschlossen wurden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04c37e12-3118-40a2-b5fd-100e20d1075d",
                        "source_entry_id": "35b21983-4d44-33c8-86a3-c5f3a149e24e",
                        "source_sense_id": "7f20ebbd-8e25-3da2-a5a9-345f0025f522",
                        "source_sense_description": "een schriftteken van het Oud-Germaanse alfabet",
                        "target_lang_word": "rune",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rune",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6158ac5-90b3-356c-8d13-ba4a21eb2684",
                                        "entry_id": "eb884c32-2fea-3120-b880-e221c3d81df4",
                                        "glosses": [
                                            "A letter, or character, used in the written language of various ancient Germanic peoples, especially the Scandinavians and the Anglo-Saxons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a954e5cf-e034-47f8-8fc9-be72fd31ca41",
                                                "sense_id": "a6158ac5-90b3-356c-8d13-ba4a21eb2684",
                                                "text": "Yet they made for man those mystic swords of superhuman workmanship engraved with magic runes and dipped when red hot in blood or in a broth of poisonous herbs and twigs."
                                            },
                                            {
                                                "example_id": "ea947bfe-3150-4ee8-a846-292a4b2fcd79",
                                                "sense_id": "a6158ac5-90b3-356c-8d13-ba4a21eb2684",
                                                "text": "Runes were the letters of an ancient Germanic alphabet, ultimately derived from the Mediterranean alphabets, which was used for carving on wood or stone and which to some extent survived the introduction of writing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8d8f304-46db-3fbc-9dad-841b0f5dcc3e",
                                        "entry_id": "eb884c32-2fea-3120-b880-e221c3d81df4",
                                        "glosses": [
                                            "Any visually similar script, such as Hungarian runes (the Old Hungarian script) or Turkic runes (the Old Turkic script)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa1dcd4e-edfd-3b8c-9c93-5b78125c7f18",
                                        "entry_id": "eb884c32-2fea-3120-b880-e221c3d81df4",
                                        "glosses": [
                                            "A Finnic or Scandinavian epic poem, or a division of one, especially a division of the Kalevala."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd9990de-02ca-3c1d-917f-287206efa4af",
                                        "entry_id": "eb884c32-2fea-3120-b880-e221c3d81df4",
                                        "glosses": [
                                            "A letter or mark used as a mystical or magic symbol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "846e3142-ad0e-4d40-b2d4-1acb8a4bc73b",
                                                "sense_id": "fd9990de-02ca-3c1d-917f-287206efa4af",
                                                "text": "And the sword that had visited Earth from so far away smote like the falling of thunderbolts [...] and the runes in Alveric’s far-travelled sword exulted, and roared at the elf-knight; until in the dark of the wood, amongst branches severed from disenchanted trees, with a blow like that of a thunderbolt riving an oak-tree, Alveric slew him."
                                            },
                                            {
                                                "example_id": "cae5ee61-dd2b-401e-84ac-3202fddecbcf",
                                                "sense_id": "fd9990de-02ca-3c1d-917f-287206efa4af",
                                                "text": "\"Finding you somewhere to live isn't going to be easy,\" he said. \"We must cast the runes,\" said Catweazle. \"They will tell us.\""
                                            },
                                            {
                                                "example_id": "5986471f-163d-40a4-901c-94398697773f",
                                                "sense_id": "fd9990de-02ca-3c1d-917f-287206efa4af",
                                                "text": "\"Are the, um, eldritch runes supposed to glow like that?\" \"Dunno. I asked the distributor about 'em and he started shaking really fast like in a Tool video.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53681dbc-e932-33d5-b73f-419938bc0e2d",
                                        "entry_id": "eb884c32-2fea-3120-b880-e221c3d81df4",
                                        "glosses": [
                                            "A verse or song, especially one with mystical or mysterious overtones; a spell or an incantation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e22a01d-6155-442b-b374-92771ee869ec",
                                                "sense_id": "53681dbc-e932-33d5-b73f-419938bc0e2d",
                                                "text": "Where the daylight peeps thro' like the glint of the Moon, / And the branches are rustling a murmurous rune, / The Owls sit in council like prophets of Fate, / Discussing grave questions of Kingdom and State."
                                            },
                                            {
                                                "example_id": "1e9be870-1b0d-4154-bca7-f4a6309eb907",
                                                "sense_id": "53681dbc-e932-33d5-b73f-419938bc0e2d",
                                                "text": "the fiddle sang and sang as ceaselessly as the chanting cicada without, and the frogs intoning their sylvan runes by the waterside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c178409c-5670-3149-87ce-9ece9ee0413a",
                                        "entry_id": "eb884c32-2fea-3120-b880-e221c3d81df4",
                                        "glosses": [
                                            "Alternative form of roun (“secret or mystery”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d8018b0-2251-385a-8122-922b89cbb300",
                                        "entry_id": "eb884c32-2fea-3120-b880-e221c3d81df4",
                                        "glosses": [
                                            "A Unicode code point."
                                        ],
                                        "tags": [
                                            "in the Go programming language"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e26f51c8-d1c7-4828-b888-60d636f89c40",
                                                "sense_id": "6d8018b0-2251-385a-8122-922b89cbb300",
                                                "text": "Go language defines the type rune as an alias for the type int32 to represent a Unicode code point. A string in Go is a sequence of runes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f454e08d-c7de-4a02-bb2c-63707fd891ef",
                        "source_entry_id": "35b21983-4d44-33c8-86a3-c5f3a149e24e",
                        "source_sense_id": "7f20ebbd-8e25-3da2-a5a9-345f0025f522",
                        "source_sense_description": "een schriftteken van het Oud-Germaanse alfabet",
                        "target_lang_word": "rune",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rune",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfa5d1e6-804b-3eab-9967-3c7f0ebeab9c",
                                        "entry_id": "c6ee7c15-a7e1-39ca-af8e-b4f1246a0a5c",
                                        "glosses": [
                                            "Caractère de l’ancienne écriture scandinave, ou même proto-germanique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c4a1fb9-360f-43b8-8889-3a30fb5da761",
                                                "sense_id": "bfa5d1e6-804b-3eab-9967-3c7f0ebeab9c",
                                                "text": "Tu n’ignores pas la vertu des runes\n Ni le pouvoir des signes tracés sur les lames"
                                            },
                                            {
                                                "example_id": "b12ae175-87a6-4218-b08c-a442a1e2cbbd",
                                                "sense_id": "bfa5d1e6-804b-3eab-9967-3c7f0ebeab9c",
                                                "text": "il entend la parole étrange,\nle dire, les chants chamarrés,\nles runes mieux chantées, parées\ndans les prés de Väinölä,\nles landes du Kalevala."
                                            },
                                            {
                                                "example_id": "2e76b34e-101d-463c-b4c7-185f66b697c6",
                                                "sense_id": "bfa5d1e6-804b-3eab-9967-3c7f0ebeab9c",
                                                "text": "Les runes n’ont point seulement une valeur graphique : comme les surates du Koran ou comme le carmen, elles ont un pouvoir mystérieux. Tout cède à l’influence de leur vertu magique : elles dissipent l’orage, domptent les flammes, guérissent les maladies, raniment les morts..., et miracle plus grand, inspirent une tendresse nouvelle au cœur qui ne voulait plus aimer."
                                            },
                                            {
                                                "example_id": "6f4c1d90-9810-4293-9fa7-d8736f0f8b12",
                                                "sense_id": "bfa5d1e6-804b-3eab-9967-3c7f0ebeab9c",
                                                "text": "De nombreuses inscriptions, difficiles à déchiffrer, se prêtent d’ailleurs à une interprétation relevant d’un usage magique des runes. Certaines laissent entrevoir une caste de prêtres-magiciens, capables de conférer un pouvoir magique aux objets par le simple fait d’y graver leur nom. Ces maîtres des runes se désignent quelques fois sous le nom d’erilaR, terme dont la signification demeure incertaine, parfois rapproché du nom d’un peuple, les Hérules, parfois apparenté au titre scandinave jarl, mais interprété comme désignant un magicien, un prêtre, ou les deux à la fois. Les runologues contemporains mettent toutefois en garde contre la tentation d’attribuer une signification magique à toute inscription obscure, soulignant que la valeur magique des runes n’est attestée que de façon marginale, même si les runes peuvent, comme tout système d’écriture, être utilisées pour écrire des formules magiques. Les inscriptions indéchiffrables peuvent tout aussi bien être attribuées à des artisans insuffisamment lettrés. ."
                                            },
                                            {
                                                "example_id": "7facbdba-09f6-4a70-813d-878f293c2405",
                                                "sense_id": "bfa5d1e6-804b-3eab-9967-3c7f0ebeab9c",
                                                "text": "Gravées à l'intérieur de la partie incurvée du bracelet, les runes résistaient à l'interprétation en raison d'une abréviation inconnue et… d'une faute d'orthographe. On y lit «DIS IS ЇIGNA ˑFˑ», or le mot «ïignaf» ne se retrouve dans aucune langue parlée en Grande-Bretagne ou en Irlande au début du Moyen-Âge."
                                            }
                                        ]
                                    }
                                ]
                            },
