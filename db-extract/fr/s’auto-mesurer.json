                "senses": [
                    {
                        "sense_id": "c634130b-dfba-3f78-bf92-4399bd25f497",
                        "entry_id": "63ea30a9-a003-3ca0-9820-40440b7c78b3",
                        "glosses": [
                            "Mesurer soi-même quelque chose qui nous concerne soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae21d1f3-b1bb-4415-8098-e17664ab3a5e",
                                "sense_id": "c634130b-dfba-3f78-bf92-4399bd25f497",
                                "text": "Enfin, le rapport craint que la santé connectée ne devienne à l’avenir une norme, à savoir qu’il serait suspect, notamment vis-à-vis des compagnies d’assurances, de ne pas s’auto-mesurer en permanence."
                            },
                            {
                                "example_id": "84f1eb96-d986-4673-b044-916817d5c62a",
                                "sense_id": "c634130b-dfba-3f78-bf92-4399bd25f497",
                                "text": "La norme n'est pas la loi qui dicte l'autorisé et l'interdit de l'extérieur; la norme est une régulation interne qui permet aux individus de s'auto-mesurer."
                            }
                        ]
                    }
                ],
