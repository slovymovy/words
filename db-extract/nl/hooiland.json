                            {
                                "example_id": "cc531603-738e-45f1-aeda-cda2b7a47dc2",
                                "sense_id": "c96d3b89-8c8a-3435-bf2d-0b82c7c9554e",
                                "text": "Konstantin Levin, die naar het ploegen en naar het hooiland wilde gaan kijken, bood zijn broer aan, hem er in de cabriolet naartoe te brengen."
                            },
                            {
                                "example_id": "19a862da-054f-4c39-872a-e82b9605b6d2",
                                "sense_id": "c96d3b89-8c8a-3435-bf2d-0b82c7c9554e",
                                "text": "Buiten de wintermaanden gebruiken honderden boeren langs de Maas de grond voor de verbouw van bijvoorbeeld aardappelen en maïs en voor gras- en hooiland. De boeren betogen dat er geen onderscheid gemaakt moet worden tussen schade binnen en buiten de dijk."
                            }
                        ]
                    }
