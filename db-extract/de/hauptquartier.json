                        "form": "das Hauptquartier"
                    },
                    {
                        "form_id": "387322d4-d074-4b55-97b7-ca909b62f424",
                        "entry_id": "33c782f5-ecf7-34ca-98a8-606dc9189215",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hauptquartiere"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8295e9f-75c0-3bc9-9f74-10a6516d6fca",
                        "entry_id": "33c782f5-ecf7-34ca-98a8-606dc9189215",
                        "glosses": [
                            "sicherer, strategisch günstig gelegener Ort, an dem sich der Oberbefehlshaber/die Leitung eines Teils der Streitkräfte befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a21f89c0-7bb9-4832-81b7-8a7e4389e47f",
                                "sense_id": "d8295e9f-75c0-3bc9-9f74-10a6516d6fca",
                                "text": "Die militärischen Befehlshaber trafen sich wegen eines Präzedenzfalles im Hauptquartier."
                            },
                            {
                                "example_id": "cac7a3a1-e5b2-47db-a041-66ddbf037c46",
                                "sense_id": "d8295e9f-75c0-3bc9-9f74-10a6516d6fca",
                                "text": "„Marc Aurel konnte sein Hauptquartier im Jahr 171 nach Carnuntum verlegen, ein großes Militärlager an der Donau zwischen dem heutigen Wien und Bratislava.“"
                            },
                            {
                                "example_id": "48a9bce0-c75b-49eb-b1bf-8d11cd3962fb",
                                "sense_id": "d8295e9f-75c0-3bc9-9f74-10a6516d6fca",
                                "text": "„Zum ersten Mal seit Kriegsbeginn befand sich das Hauptquartier in Berlin.“"
                            },
                            {
                                "example_id": "85ee31f5-a3f6-4f80-b7d2-23861d181b5b",
                                "sense_id": "d8295e9f-75c0-3bc9-9f74-10a6516d6fca",
                                "text": "„Der Generalstab der 7. Flotte hatte mittlerweile sein Hauptquartier in La Baule bezogen.“"
                            },
                            {
                                "example_id": "7a1999ba-9afe-425f-bea0-f6b370106e69",
                                "sense_id": "d8295e9f-75c0-3bc9-9f74-10a6516d6fca",
                                "text": "„Murat schickte einen reitenden Boten ins Hauptquartier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3be7f2e3-a68b-354d-a3ea-035f5b180120",
                        "entry_id": "33c782f5-ecf7-34ca-98a8-606dc9189215",
                        "glosses": [
                            "zentrale Schaltstelle einer Institution/Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5fa4f06-8a6e-4908-a497-ccafa254e55c",
                                "sense_id": "3be7f2e3-a68b-354d-a3ea-035f5b180120",
                                "text": "„Der drahtige 31-Jährige mit rasiertem Schädel ist gekommen, um vom Hauptquartier der Demokraten aus die Jagd auf Donald Trump anzuführen.“"
                            },
                            {
                                "example_id": "8e0205a5-409e-4539-8d60-8d35614e55cd",
                                "sense_id": "3be7f2e3-a68b-354d-a3ea-035f5b180120",
                                "text": "„Als die neue Geheimdienstzentrale am nordwestlichen Stadtrand Moskaus 2006 eingeweiht wurde, landete Putin mit einem Hubschrauber auf einem Heliport, der das Dach des Hauptquartiers krönt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
