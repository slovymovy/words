                        "glosses": [
                            "Kot eines Vogels"
                        ],
                        "tags": [
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "945acccd-2dd6-48be-a6e2-c35a74f3c610",
                                "sense_id": "2c4f109a-63fd-3730-928b-95e807f16119",
                                "text": "„Nur einmal wurde diese friedvolle Einträchtigkeit unter den Schaulustigen von etwas wirklich Trivialem empfindlich gestört: von einem dicken Vogelschiss direkt auf den Fernseher.“"
                            },
                            {
                                "example_id": "7696536c-5a3d-40ca-b5fc-5eca1e7d3bf3",
                                "sense_id": "2c4f109a-63fd-3730-928b-95e807f16119",
                                "text": "„Er wischte mit dem Taschentuch einen Vogelschiss von seinem Stein und setzte sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
