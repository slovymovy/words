                {
                    "sense_id": "f675eab9-0731-3e2e-9a30-21e66792f960",
                    "sense_definition": "o głosie lub dźwięku: mający niską tonację",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dzwiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W słuchawce nagle odezwał się nieznajomy, <w>gruby</w> głos.",
