                "senses": [
                    {
                        "sense_id": "f9c0d81d-f42c-3f71-a774-f3edf8ab0892",
                        "entry_id": "e61b38f4-d992-365b-8052-95e54a24fcd0",
                        "glosses": [
                            "поклониться друг другу при встрече или расставании"
                        ],
                        "tags": [
                            "с кем-чем"
                        ],
                        "examples": [
                            {
                                "example_id": "9a798aef-0370-4a64-a96d-ad4b13b0992c",
                                "sense_id": "f9c0d81d-f42c-3f71-a774-f3edf8ab0892",
                                "text": "С мужчинами со всех сторон // Раскланялся, потом на сцену."
                            }
                        ]
                    },
                    {
                        "sense_id": "015f762d-66ce-3a8d-8fe8-c0c69f0a567b",
                        "entry_id": "e61b38f4-d992-365b-8052-95e54a24fcd0",
                        "glosses": [
                            "перен., разг., ирон. навсегда распрощаться"
                        ],
                        "tags": [
                            "с кем-чем"
                        ],
                        "examples": [
                            {
                                "example_id": "3a457f0f-7539-4d1c-a73c-ce1e2b449a8f",
                                "sense_id": "015f762d-66ce-3a8d-8fe8-c0c69f0a567b",
                                "text": "Мне стало стыдно её чистого взора, я не хотел лгать в её присутствии и тотчас же окончательно и навсегда раскланялся с моим прежним предметом."
                            }
                        ]
                    }
