                                    {
                                        "sense_id": "33638268-24a3-3ef1-82a5-325e22fc7c8f",
                                        "entry_id": "6b11f29a-69e3-3f76-9070-a419de742723",
                                        "glosses": [
                                            "Money which is sent to someone, typically to someone in another country."
                                        ],
