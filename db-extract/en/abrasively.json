                "translations": [
                    {
                        "translation_id": "582cd5b9-0a41-4417-958a-81c0536c5db6",
                        "source_entry_id": "76f85508-75b4-3ad0-8427-bb7ba221d460",
                        "source_sense_description": "in an abrasive manner",
                        "target_lang_word": "brusquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brusquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d42d4f0c-ee46-3840-8140-d1cd6fbd2e19",
                                        "entry_id": "82c0c783-c8f1-33f2-936c-a1fc6db995fc",
                                        "glosses": [
                                            "D’une manière brusque, inattendue ou soudaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "371e672b-b57b-4d75-9bfa-33dc15450ce6",
                                                "sense_id": "d42d4f0c-ee46-3840-8140-d1cd6fbd2e19",
                                                "text": "Nous en profitons pour bifurquer brusquement et nous arrivons enfin en zigzaguant à nous mettre hors de la portée de notre intrus."
                                            },
                                            {
                                                "example_id": "03e2df45-a321-4a0c-be3b-7c6c8824974e",
                                                "sense_id": "d42d4f0c-ee46-3840-8140-d1cd6fbd2e19",
                                                "text": "Il agit donc sur la tirette, le rideau se releva brusquement, et alors, à la stupéfaction générale, on vit saint Jean-Baptiste, en pyjama bleu de ciel, […]"
                                            },
                                            {
                                                "example_id": "dcddf69d-92c0-49fa-84af-f82f920fa0b6",
                                                "sense_id": "d42d4f0c-ee46-3840-8140-d1cd6fbd2e19",
                                                "text": "Comme ils franchissaient le seuil, des formes invisibles surgirent, brusquement, de l'ombre. C'était les slouguis qui se précipitaient, menaçants. Mᵐᵉ Durelle poussa un cri."
                                            },
                                            {
                                                "example_id": "8a453ece-0e37-4a9b-93cc-dd79ef22cd65",
                                                "sense_id": "d42d4f0c-ee46-3840-8140-d1cd6fbd2e19",
                                                "text": "La vie, après de longs mois d'hivernage, avait été arrêtée brusquement par l'arrivée de navire de la délivrance."
                                            },
                                            {
                                                "example_id": "1507e152-8e90-46d8-9477-4064bd2c1d70",
                                                "sense_id": "d42d4f0c-ee46-3840-8140-d1cd6fbd2e19",
                                                "text": "Cette assimilation au statut « d’homme », ce nivellement, cette rapidité de communication profonde avec les gens de notre âge, cet univers quotidien brusquement peuplé de gens de quarante ans finissent par être si évident à Berthoux qu’il hyper-simplifie et se met à inclure dans sa quarantaine tout individu qui recoupe son orbite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94014141-1299-460c-954a-44993f9618a8",
                        "source_entry_id": "76f85508-75b4-3ad0-8427-bb7ba221d460",
