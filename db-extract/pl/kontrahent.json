                                    {
                                        "sense_id": "c3ba5657-629f-38e4-96a7-fee30b8847ec",
                                        "entry_id": "be4f329d-0b35-3dcb-a614-d264a8ebef9f",
                                        "glosses": [
                                            "A person or company that builds or improves buildings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7727ba8-9c90-3879-a0de-067b5167ba4a",
                                        "entry_id": "be4f329d-0b35-3dcb-a614-d264a8ebef9f",
                                        "glosses": [
                                            "A person or company that performs specific tasks like electrical or plumbing work in construction projects."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3a5e6fb-f083-30f6-b183-d39db89a7af7",
                                        "entry_id": "be4f329d-0b35-3dcb-a614-d264a8ebef9f",
                                        "glosses": [
                                            "A person or company hired to maintain existing facilities like air conditioning systems, groundskeeping, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6402a05c-b0a7-3bc2-bc33-8d8ec5a25c58",
                                        "entry_id": "be4f329d-0b35-3dcb-a614-d264a8ebef9f",
                                        "glosses": [
                                            "A person hired to do a job on a business contract, as opposed to a permanent employee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fa1a6da-3aef-4283-a440-cbaef5d8b8dc",
                                                "sense_id": "6402a05c-b0a7-3bc2-bc33-8d8ec5a25c58",
                                                "text": "It looks like you're off to a three-hour staff meeting that doesn't apply to me. I'm glad I'm a highly-paid contractor. I'll be increasing my skills while you fight to get oxygen to your brains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "518d9e58-5dbc-4ab2-ab27-3dceee1dbe78",
                        "source_entry_id": "7f1153fb-f71d-3adb-becf-9adf9b6d483b",
                        "source_sense_id": "b5277f93-d4e8-32de-baf5-68a65ddead8a",
                        "target_lang_word": "transactor",
