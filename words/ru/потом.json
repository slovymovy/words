{
    "word_family": [
        "потомок",
        "потомство",
        "потомственный",
        "пот",
        "потный",
        "потеть",
        "вспотеть"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d4b38596-57ea-3a47-9fb9-db653876f96a",
                    "sense_definition": "Затем, после этого; следующее действие или событие в последовательности.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сначала мы пообедали, а <потом> пошли гулять в парк.",
                            "target_lang_translations": {
                                "en": "First we had lunch, and <w>then</w> we went for a walk in the park.",
                                "zh": "我们先吃了午饭，<w>然后</w>去公园散步了。"
                            }
                        },
                        {
                            "text": "Он внимательно прочитал письмо, <потом> положил его на стол.",
                            "target_lang_translations": {
                                "en": "He read the letter carefully, <w>then</w> put it on the table.",
                                "zh": "他仔细读了信，<w>接着</w>把它放在了桌子上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "затем",
                        "после",
                        "далее"
                    ],
                    "antonyms": [
                        "сначала",
                        "сперва",
                        "прежде"
                    ],
                    "common_phrases": [
                        "а потом",
                        "и потом"
                    ],
                    "target_lang_definitions": {
                        "en": "Then, after that; the next action or event in a sequence.",
                        "zh": "表示动作或事件发生的先后顺序，意为“然后”、“接着”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "next in a sequence"
                            },
                            {
                                "target_lang_word": "afterwards",
                                "target_lang_sense_clarification": "following an event"
                            },
                            {
                                "target_lang_word": "after that",
                                "target_lang_sense_clarification": "subsequently"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "然后",
                                "target_lang_sense_clarification": "表示动作的先后顺序"
                            },
                            {
                                "target_lang_word": "接着",
                                "target_lang_sense_clarification": "紧接着上一个动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e587a3d1-71ac-36b4-afdc-a067c9b785b7",
                    "sense_definition": "Позже, спустя некоторое время; не сейчас, а в будущем.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я сделаю это <потом>, потому что сейчас я очень занят.",
                            "target_lang_translations": {
                                "en": "I will do it <w>later</w> because I am very busy right now.",
                                "zh": "我<w>以后</w>再做这件事，因为我现在很忙。"
                            }
                        },
                        {
                            "text": "Не откладывай на <потом> то, что можно сделать сегодня.",
                            "target_lang_translations": {
                                "en": "Don't put off until <w>later</w> what can be done today.",
                                "zh": "今天能做的事不要拖到<w>以后</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "позже",
                        "впоследствии"
                    ],
                    "antonyms": [
                        "сейчас",
                        "теперь",
                        "сразу",
                        "немедленно"
                    ],
                    "common_phrases": [
                        "на потом",
                        "как-нибудь потом"
                    ],
                    "target_lang_definitions": {
                        "en": "Later, after some time; not now, but in the future.",
                        "zh": "表示在未来的某个时间，意为“以后”、“晚些时候”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "later",
                                "target_lang_sense_clarification": "at a future time"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "以后",
                                "target_lang_sense_clarification": "指未来的时间"
                            },
                            {
                                "target_lang_word": "晚些时候",
                                "target_lang_sense_clarification": "指稍后的时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc3219ea-a742-3f19-8689-b563db6ce246",
                    "sense_definition": "Кроме того, к тому же; используется для добавления нового довода или обстоятельства в разговоре.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне не нравится этот фильм, и <потом>, он идёт слишком долго.",
                            "target_lang_translations": {
                                "en": "I don't like this film, and <w>besides</w>, it's too long.",
                                "zh": "我不喜欢这部电影，<w>再说</w>它也太长了。"
                            }
                        },
                        {
                            "text": "Там очень дорого, и <потом>, у нас совсем нет времени.",
                            "target_lang_translations": {
                                "en": "It's very expensive there, and <w>besides</w>, we have absolutely no time.",
                                "zh": "那里太贵了，<w>况且</w>我们根本没时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "далее"
                    ],
                    "common_phrases": [
                        "и потом"
                    ],
                    "target_lang_definitions": {
                        "en": "Besides, moreover; used to add a new argument or circumstance.",
                        "zh": "用于补充说明，表示“况且”、“再说”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "besides",
                                "target_lang_sense_clarification": "in addition to that"
                            },
                            {
                                "target_lang_word": "what's more",
                                "target_lang_sense_clarification": "furthermore"
                            },
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "used to add a further point"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "再说",
                                "target_lang_sense_clarification": "用于补充理由"
                            },
                            {
                                "target_lang_word": "况且",
                                "target_lang_sense_clarification": "用于进一步说明情况"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "073c4760-8051-3eb3-b6b1-330b9dc6f83d",
                    "sense_definition": "Форма творительного падежа единственного числа существительного <w>пот</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После долгого бега его лицо покрылось крупным <потом>.",
                            "target_lang_translations": {
                                "en": "After a long run, his face was covered in heavy <w>sweat</w>.",
                                "zh": "长跑过后，他的脸上布满了大颗的<w>汗</w>珠。"
                            }
                        },
                        {
                            "text": "Эта победа досталась спортсмену кровью и <потом>.",
                            "target_lang_translations": {
                                "en": "This victory cost the athlete blood and <w>sweat</w>.",
                                "zh": "这位运动员是靠着血和<w>汗</w>才赢得了这场胜利。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "обливаться потом",
                        "покрыться потом"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "instrumental singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Instrumental case form of the noun 'sweat'.",
                        "zh": "名词“汗”的工具格形式，指从皮肤排出的液体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweat",
                                "target_lang_sense_clarification": "perspiration"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "汗",
                                "target_lang_sense_clarification": "指汗水"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}