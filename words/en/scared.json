    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6fdc8ed9-d2cb-34ff-9a01-1b2633c33a6e",
                    "sense_definition": "Feeling fear; afraid, frightened.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young child was <w>scared</w> of the dark and always slept with a light on.",
                            "target_lang_translations": {
                                "ru": "Маленький ребенок <w>боялся</w> темноты и всегда спал с включенным светом."
                            }
                        },
                        {
                            "text": "I am <w>scared</w> I will miss the train if we do not leave right now.",
                            "target_lang_translations": {
                                "ru": "Я <w>боюсь</w>, что опоздаю на поезд, если мы не выйдем прямо сейчас."
                            }
                        },
                        {
                            "text": "She felt <w>really</w> <w>scared</w> when she heard a strange noise in the basement.",
                            "target_lang_translations": {
                                "ru": "Ей стало <w>очень</w> <w>страшно</w>, когда она услышала странный шум в подвале."
                            }
                        }
                    ],
                    "synonyms": [
                        "afraid"
                    ],
                    "antonyms": [
                        "brave",
                        "confident",
                        "unafraid"
                    ],
                    "common_phrases": [
                        "really scared",
                        "get scared",
                        "scared of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий страх; испуганный или боящийся чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испуганный",
                                "target_lang_sense_clarification": "находящийся в состоянии страха"
                            },
                            {
                                "target_lang_word": "напуганный",
                                "target_lang_sense_clarification": "ставший жертвой испуга"
                            },
                            {
                                "target_lang_word": "боящийся",
                                "target_lang_sense_clarification": "испытывающий страх перед чем-то"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "691665b4-b650-3191-9227-c59ed67dbe5c",
                    "sense_definition": "simple past and past participle of <w>scare</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loud noise <w>scared</w> the birds away from the garden.",
                            "target_lang_translations": {
                                "ru": "Внезапный громкий шум <w>спугнул</w> птиц из сада."
                            }
                        },
                        {
                            "text": "He <w>scared</w> his little sister by jumping out from behind the door.",
                            "target_lang_translations": {
                                "ru": "Он <w>напугал</w> свою младшую сестру, выскочив из-за двери."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «пугать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напугал",
                                "target_lang_sense_clarification": "заставил почувствовать страх"
                            },
                            {
                                "target_lang_word": "испугал",
                                "target_lang_sense_clarification": "вызвал внезапный страх"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}