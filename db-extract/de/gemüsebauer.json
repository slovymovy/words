                "senses": [
                    {
                        "sense_id": "2a01d090-5233-32ef-8ce2-0ca9a5e90993",
                        "entry_id": "3788c044-9848-3b83-9106-b67cbc6878f7",
                        "glosses": [
                            "Landwirt, der seinen Schwerpunkt auf den Gemüse von Getreide gelegt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f004ad06-1f6c-4d5e-afe3-80388d4d1050",
                                "sense_id": "2a01d090-5233-32ef-8ce2-0ca9a5e90993",
                                "text": "„An der Oberräder Wasserhofstraße sitzt der Gemüsebauer im Anbau eines Wohnhauses.“"
                            },
                            {
                                "example_id": "87a94100-ce16-4c8d-8a06-2b1e0c9ab6d3",
                                "sense_id": "2a01d090-5233-32ef-8ce2-0ca9a5e90993",
                                "text": "„Offenbar muß ein Gemüsebauer auf der Insel Reichenau heute genausoviel von Marketing verstehen wie von Veredelungsschnitten.“"
                            },
                            {
                                "example_id": "fbb33c4e-aba4-4dff-9c54-fede9b5fe5ef",
                                "sense_id": "2a01d090-5233-32ef-8ce2-0ca9a5e90993",
                                "text": "„Unterhalb der Werkgalerie Hochwart, der höchsten Erhebung der Insel, von der aus man einen fantastischen Blick auf den Bodensee hat, fährt ein Gemüsebauer vier rumänische Erntehelfer zum Feld.“"
                            },
                            {
                                "example_id": "cb6790f7-aec5-4b81-93ae-3140b2e232cc",
                                "sense_id": "2a01d090-5233-32ef-8ce2-0ca9a5e90993",
                                "text": "„Rainer Schecker blickt kurz ins Gewächshaus und hebt fast beschwörend die Hände: ‚Wir brauchen Wärme und Sonne‘, seufzt der Gemüsebauer.“"
                            },
                            {
                                "example_id": "fd0d65fd-444e-4d42-9e8f-61fcfde3160e",
                                "sense_id": "2a01d090-5233-32ef-8ce2-0ca9a5e90993",
                                "text": "„Gemüsebauer Jürgen Heilmann aus Albertshofen im fränkischen Landkreis Kitzingen schickt seine Erntehelfer deshalb schon früh morgens auf die Felder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
