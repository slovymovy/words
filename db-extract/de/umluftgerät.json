                "senses": [
                    {
                        "sense_id": "10a45495-72ab-3a25-b7db-c939e8e604b0",
                        "entry_id": "d1502c2b-8b72-302a-b8b7-8156c77a51f3",
                        "glosses": [
                            "Lüftungsgerät, welches zu einem Großteil Raumluft ansaugt, aufbereitet (filtern, erwärmen oder kühlen) und je nach Jahreszeit und Erfordernis mit Außenluft anreichert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e5d0094-ac2c-4028-9fff-660e8b8eab1c",
                                "sense_id": "10a45495-72ab-3a25-b7db-c939e8e604b0",
                                "text": "Das Umluftgerät im Hotelzimmer hat nicht genügend Kälteleistung und der Sommerurlaub war dauerhaft unerträglich heiß"
                            },
                            {
                                "example_id": "ebb4f6e8-de6d-4b09-93f9-3e1f27077fd8",
                                "sense_id": "10a45495-72ab-3a25-b7db-c939e8e604b0",
                                "text": "„Um Events wie Konzerte oder Kabaretts in angemessenem Rahmen und unter behaglichen Bedingungen für das Publikum zu realisieren, ist die Temperierung der Räume, vor allem in den Wintermonaten, unumgänglich. Hierfür wurde im “Laboratorium” bisher ein Zuluft- / Umluftgerät mit Nacherhitzer verwendet, welches unter der Decke des Veranstaltungsraumes installiert war.“"
                            },
                            {
                                "example_id": "0a8e1cf1-6651-47ec-ba70-1aaaa7618817",
                                "sense_id": "10a45495-72ab-3a25-b7db-c939e8e604b0",
                                "text": "„Erst wenn die Raumnutzung feststehe, würden die Gehäuse mit Wärme- und Schalldämmboxen oder mit Funktionsboxen für die Lüftung und Raumkonditionierung bestückt. Zu den eingeschobenen bzw. ausziehbaren Funktionsboxen gehören kombinierte Zu- und Abluftgeräte sowie Umluftgeräte, die außer Lüftungsaufgaben auch die Heizung oder Kühlung der außenliegenden Räume übernehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
