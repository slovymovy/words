                                    },
                                    {
                                        "sense_id": "c3bd1ad6-1aa4-3403-85ab-62bd149ef8b8",
                                        "entry_id": "90e45312-5ed2-37ee-822b-20757d4e419f",
                                        "glosses": [
                                            "A long object used to make a physical connection.",
                                            "An assembly of two or more cable-laid ropes."
                                        ],
                                        "tags": [
                                            "material"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "783f8e7a-9d19-3633-bc53-f4aab3fa37c3",
                                        "entry_id": "90e45312-5ed2-37ee-822b-20757d4e419f",
                                        "glosses": [
                                            "A long object used to make a physical connection.",
                                            "An assembly of two or more wires, used for electrical power or data circuits; one or more and/or the whole may be insulated."
                                        ],
                                        "tags": [
                                            "material"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c7844ea-789d-3de5-9369-863babadf65b",
                                        "entry_id": "90e45312-5ed2-37ee-822b-20757d4e419f",
                                        "glosses": [
                                            "A long object used to make a physical connection.",
                                            "A strong rope or chain used to moor or anchor a ship."
                                        ],
                                        "tags": [
                                            "material"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "409daf69-eb7b-401c-b261-1fec64620831",
                                                "sense_id": "7c7844ea-789d-3de5-9369-863babadf65b",
                                                "text": "“And now the time of tide has come; the ship casts off her cables; and from the deserted wharf the uncheered ship for Tarshish, all careening, glides to sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d11fb6b-6008-3cc2-bdfe-dded14945902",
                                        "entry_id": "90e45312-5ed2-37ee-822b-20757d4e419f",
                                        "glosses": [
                                            "A system for transmitting television or Internet services over a network of coaxial or fibreoptic cables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5e11737-29a0-4b54-bb5e-544c7a741246",
                                                "sense_id": "9d11fb6b-6008-3cc2-bdfe-dded14945902",
                                                "text": "I tried to watch the movie last night but my cable was out."
                                            },
                                            {
                                                "example_id": "852b2cd5-901c-4f58-b5bd-1eb1062c2efa",
                                                "sense_id": "9d11fb6b-6008-3cc2-bdfe-dded14945902",
                                                "text": "If the takeover is approved, Comcast would control 20 of the top 25 cable markets, […]. Antitrust officials will need to consider Comcast’s status as a monopsony (a buyer with disproportionate power), when it comes to negotiations with programmers, whose channels it pays to carry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a897e6b-c868-3c38-89f5-1f3a5b11a1ff",
                                        "entry_id": "90e45312-5ed2-37ee-822b-20757d4e419f",
                                        "glosses": [
                                            "A system for transmitting television or Internet services over a network of coaxial or fibreoptic cables.",
                                            "Ellipsis of cable television, broadcast over the above network, not by antenna."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6865785a-da6d-3612-a637-f1c5fb006006",
                                        "entry_id": "90e45312-5ed2-37ee-822b-20757d4e419f",
                                        "glosses": [
                                            "A telegram, notably when sent by (submarine) telegraph cable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
