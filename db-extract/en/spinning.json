                    }
                ],
                "translations": [
                    {
                        "translation_id": "f295de6f-b66e-4144-af9e-fd5d08168ba3",
                        "source_entry_id": "c6131581-9229-36c6-bf14-e589a3837294",
                        "source_sense_description": "process of converting fibres into yarn or thread",
                        "target_lang_word": "filer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "filer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fe47f6c-cc43-3a1d-bfb9-693244e6940f",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Tordre ensemble plusieurs brins de chanvre, de lin, de soie, de laine, etc., pour qu’ils forment un fil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6622433e-d9a4-48ab-a508-67e08b23fa51",
                                                "sense_id": "2fe47f6c-cc43-3a1d-bfb9-693244e6940f",
                                                "text": "Les fileuses prenaient place autour de la table carrée et aussitôt commençaient à filer. C’était à qui filerait le plus de fil mince, ferme, égal."
                                            },
                                            {
                                                "example_id": "4f9b799b-cf1d-4f8c-996e-c6611e924ba1",
                                                "sense_id": "2fe47f6c-cc43-3a1d-bfb9-693244e6940f",
                                                "text": "Les femmes, qui sont de taille moyenne et plutôt trapues, portent une robe en vadmel, sorte de flanelle tissée avec la laine qu’elles-mêmes ont cardée et filée."
                                            },
                                            {
                                                "example_id": "0dad2893-6295-4bd0-9a1e-d065133a56f5",
                                                "sense_id": "2fe47f6c-cc43-3a1d-bfb9-693244e6940f",
                                                "text": "Cette industrie du drap est en effet l'une des plus complexes, et le nombre des opérations nécessaires pour transformer la laine brute en produit fini est très élevé. Il fallait trier la laine, la teindre, la mélanger, la carder, la filer, la tisser, dégraisser le tissu, le fouler, le lainer, le tondre, l'épinceter, et enfin lui donner de l'éclat en le pressant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a25a3bd9-20e8-3e55-b9ba-cce49c4688a4",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Tirer un fil de son corps, en parlant des insectes ou des araignées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d633b1eb-050a-4ddb-8a78-855a4cf8c829",
                                                "sense_id": "a25a3bd9-20e8-3e55-b9ba-cce49c4688a4",
                                                "text": "Une araignée qui file sa toile."
                                            },
                                            {
                                                "example_id": "25872a09-0fc3-445b-85f0-24ba9bb1c438",
                                                "sense_id": "a25a3bd9-20e8-3e55-b9ba-cce49c4688a4",
                                                "text": "Les chenilles, les vers à soie filent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b53c8bf9-7a1d-3fc7-8443-1efbd317c218",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Conduire, développer progressivement et avec art."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af237c4b-6657-4bc0-90d7-a55a022dfe52",
                                                "sense_id": "b53c8bf9-7a1d-3fc7-8443-1efbd317c218",
                                                "text": "Il s’éveillait, m’enlevait dans ses bras, nous filions notre grande scène d’amour."
                                            },
                                            {
                                                "example_id": "21f1d712-e543-4f5a-aee4-86739be85fe7",
                                                "sense_id": "b53c8bf9-7a1d-3fc7-8443-1efbd317c218",
                                                "text": "Son équipe de campagne file volontiers la métaphore judiciaire, face à un rival condamné au pénal et poursuivi dans plusieurs affaires, notamment liées à son refus de reconnaître sa défaite en 2020."
                                            },
                                            {
                                                "example_id": "c2885970-a8fa-4491-8fee-f91751917599",
                                                "sense_id": "b53c8bf9-7a1d-3fc7-8443-1efbd317c218",
                                                "text": "Filer une intrigue, une scène, un couplet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eb23e2d-16f4-33e6-a858-e06aebe6bfac",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Tirer de l’or, de l’argent en les passant à la filière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a64ebb42-0d61-483d-924b-eeaf46eb20ea",
                                                "sense_id": "4eb23e2d-16f4-33e6-a858-e06aebe6bfac",
                                                "text": "Filer de l’or, de l’argent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78f93a3f-7105-3c8f-a79d-592603129721",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Couvrir d’un fil d’or ou d’autre métal, un fil de soie, de chanvre, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a6fd8bc-5f62-4283-9561-550dcb25a3eb",
                                                "sense_id": "78f93a3f-7105-3c8f-a79d-592603129721",
                                                "text": "Filer sur soie, sur fil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5904614f-a6e4-3f11-adf5-2ce215b0de54",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Larguer, lâcher, relâcher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9d30d36-3ed2-4cc5-91d6-a09ac203d569",
                                                "sense_id": "5904614f-a6e4-3f11-adf5-2ce215b0de54",
                                                "text": "Si vous avez deux focquiers, le moins fort des deux sera préposé à filer l’écoute sous le vent et l’autre se préparera à border la nouvelle écoute à la fin de la manœuvre, avec l’aide du premier pour tourner la manivelle du winch et border l’écoute plus rapidement."
                                            },
                                            {
                                                "example_id": "a910372e-da32-49b7-ac22-735d0e764cab",
                                                "sense_id": "5904614f-a6e4-3f11-adf5-2ce215b0de54",
                                                "text": "Filer la ligne de sonde, l’ancre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caf1d4ad-440a-3e47-b94f-4fc92907354f",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Prolonger l’exécution d’un son, d’une mesure, en commençant piano, pour augmenter jusqu’au forte et finir ensuite comme on a commencé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65971b5e-daaf-4108-90c6-15c6f6621629",
                                                "sense_id": "caf1d4ad-440a-3e47-b94f-4fc92907354f",
                                                "text": "Des sons bien filés."
                                            },
                                            {
                                                "example_id": "e0785178-e046-491d-904a-503be9951f79",
                                                "sense_id": "caf1d4ad-440a-3e47-b94f-4fc92907354f",
                                                "text": "L’eau, qu’on ne voyait plus, filait sans fin sa note de flûte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e37cd5a9-f01a-3a90-bdaf-d3f6b9ab8b91",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Suivre quelqu’un et le surveiller discrètement ; pister."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5fb67ad-3f37-46bd-bfc4-c9db2fa75e55",
                                                "sense_id": "e37cd5a9-f01a-3a90-bdaf-d3f6b9ab8b91",
                                                "text": "Il ne se permit qu’une seule question, à savoir : « s’il faudrait venir chercher M. le vicomte quand la dame à filer serait enfermée avec celui qu’elle allait voir. »"
                                            },
                                            {
                                                "example_id": "472007ef-dcfd-4b8a-8fd1-c622a882f08a",
                                                "sense_id": "e37cd5a9-f01a-3a90-bdaf-d3f6b9ab8b91",
                                                "text": "Ce maquignon se trouve partout où il y a un mauvais cheval à vendre ; il opère de haut et de loin, file un cheval comme un agent filerait un malfaiteur ; il a ses dépêches, son contrôle, ses espions."
                                            },
                                            {
                                                "example_id": "32e5af8e-9178-4ffc-8d64-279a866a0a78",
                                                "sense_id": "e37cd5a9-f01a-3a90-bdaf-d3f6b9ab8b91",
                                                "text": "Je suis un imbécile de prendre tant de précautions, c’est évident, personne ne me file."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a48b0a30-759a-31c6-acd4-1e77f9a38aa2",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Aller de suite, l’un après l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82e48878-51c1-44ec-929e-0c22908fbe75",
                                                "sense_id": "a48b0a30-759a-31c6-acd4-1e77f9a38aa2",
                                                "text": "Faire filer les troupes sur un point."
                                            },
                                            {
                                                "example_id": "06066357-1775-4866-8af5-7bceae1373dc",
                                                "sense_id": "a48b0a30-759a-31c6-acd4-1e77f9a38aa2",
                                                "text": "Faire filer le bagage."
                                            },
                                            {
                                                "example_id": "0bef9ac0-03a6-490a-8a94-4501bd5e6352",
                                                "sense_id": "a48b0a30-759a-31c6-acd4-1e77f9a38aa2",
                                                "text": "À droite et à gauche, filant de l’avant-scène au fond, des lits accolés deux à deux, et garnis de leurs couvre-pieds réglementaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be417ed3-7a54-3b93-b649-5f120048261b",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Donner."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd091686-3bef-4bdc-bf7b-4c9ace488e55",
                                                "sense_id": "be417ed3-7a54-3b93-b649-5f120048261b",
                                                "text": "Jopique et Dumortier étendaient sous leur matelas leur pantalon de drap rude, copieusement arrosé, pour lui « filer » le pli."
                                            },
                                            {
                                                "example_id": "82023d4d-b160-4172-ae79-7f2e6cc50251",
                                                "sense_id": "be417ed3-7a54-3b93-b649-5f120048261b",
                                                "text": "Tous les potes de la compagnie ont la cliche à cause de l'eau croupie qu'on nous file à boire."
                                            },
                                            {
                                                "example_id": "0821574b-4de2-40f2-a599-f281a7122cd9",
                                                "sense_id": "be417ed3-7a54-3b93-b649-5f120048261b",
                                                "text": "Rien d'autre, dans la communauté virtuelle, que le désolant spectacle des bogosses autoproclamés qui filaient des rancards débiles à des filles qui ne l'étaient pas moins, à grand renfort de Ase soiiiiiiiir, jte kiff ou de G troooooop hâte d'y eeeeetre. Non, je ne les enviais pas."
                                            },
                                            {
                                                "example_id": "9ae99d49-7103-4e62-83e2-9d1462e4ec33",
                                                "sense_id": "be417ed3-7a54-3b93-b649-5f120048261b",
                                                "text": "Je te filerai toujours du boulot. - Je n'en attendais pas moins !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be8b79b8-b148-374c-8db2-e6f1da417ac6",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "S’allonger en filets, en parlant d’une matière molle et tenace."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b036844c-d2a1-4d78-8fad-b67ccc5a480f",
                                                "sense_id": "be8b79b8-b148-374c-8db2-e6f1da417ac6",
                                                "text": "La glu file aisément."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cecc927-d263-342e-969c-3b43c8201139",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Couler doucement et sans se diviser en gouttes, en parlant d’un liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7db145f1-1acd-4de7-baf2-c38882f4b6d7",
                                                "sense_id": "6cecc927-d263-342e-969c-3b43c8201139",
                                                "text": "Ce sirop, cette liqueur file."
                                            },
                                            {
                                                "example_id": "ff21cda6-276f-4134-b3ab-68f5b162d99b",
                                                "sense_id": "6cecc927-d263-342e-969c-3b43c8201139",
                                                "text": "Ce vin tourne à la graisse, il file."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41579a6d-33c3-3af5-bac5-b532fd36073e",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Monter et donner de la fumée, en parlant de la flamme, de la lumière d'une lampe, d'une bougie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b51d904-a7df-406c-b59c-9b61a5571f24",
                                                "sense_id": "41579a6d-33c3-3af5-bac5-b532fd36073e",
                                                "text": "Cette lampe file."
                                            },
                                            {
                                                "example_id": "1bb85d52-758a-4c57-b134-d602facdb0c9",
                                                "sense_id": "41579a6d-33c3-3af5-bac5-b532fd36073e",
                                                "text": "[…] la vue des lavabos recouverts de serviettes, des lits transformés en vestiaires, sur le couvre-pied desquels s’entassaient les pardessus et les chapeaux lui donnait la même sensation d’étouffement que peut causer aujourd’hui à des gens habitués à vingt ans d’électricité l’odeur d’une lampe qui charbonne ou d’une veilleuse qui file."
                                            },
                                            {
                                                "example_id": "2ebbed6c-48fa-4c63-a57f-c20eee185110",
                                                "sense_id": "41579a6d-33c3-3af5-bac5-b532fd36073e",
                                                "text": "Marie, qui détesterait d’être prise en flagrant délit d’avarice, remonte la lampe de telle façon que celle-ci se met à filer."
                                            },
                                            {
                                                "example_id": "4d483e1f-8889-459a-83e1-53ed2c41279f",
                                                "sense_id": "41579a6d-33c3-3af5-bac5-b532fd36073e",
                                                "text": "Nous étions assis face à face sous la suspension dont la lampe filait, sentait le pétrole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6754af4c-b90e-3a4e-9caf-217ddd98d740",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Avancer rapidement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a767ed4-707e-462a-b8d0-6b51772b4a39",
                                                "sense_id": "6754af4c-b90e-3a4e-9caf-217ddd98d740",
                                                "text": "Filer un nœud, deux nœuds, trois nœuds, etc. se dit d’un navire qui, dans l’espace de trente secondes, parcourt une fois, deux fois, trois fois, etc., la distance qui sépare deux nœuds consécutifs de la ligne de loch."
                                            },
                                            {
                                                "example_id": "a6baf2f2-41cd-4364-b8df-93dfc93c07d5",
                                                "sense_id": "6754af4c-b90e-3a4e-9caf-217ddd98d740",
                                                "text": "…et l’on voyait déjà quelques embarcations filer doucement sur l’eau que battaient les grands avirons, pareils à des vols de goélands lents et bas."
                                            },
                                            {
                                                "example_id": "3ca7157c-7065-4429-98b1-9f858becb3a5",
                                                "sense_id": "6754af4c-b90e-3a4e-9caf-217ddd98d740",
                                                "text": "Le vol était monotone. Nous filions vers la terre américaine, ce n’était pas douteux, et nous attendions que les kilomètres s’ajoutent aux kilomètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a51d6d3e-5779-3bf6-9477-d8cde2168b0c",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "S’en aller ; se retirer."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ba66ec7-d8b4-46b4-812c-71987acd818c",
                                                "sense_id": "a51d6d3e-5779-3bf6-9477-d8cde2168b0c",
                                                "text": "Il nous revient que le forban qui dirige la Banque Corland et Cⁱᵉ serait à la veille de mettre les clefs sous la porte et de filer vers des cieux plus hospitaliers."
                                            },
                                            {
                                                "example_id": "427469c2-045c-4278-9a07-db9144942cd1",
                                                "sense_id": "a51d6d3e-5779-3bf6-9477-d8cde2168b0c",
                                                "text": "Le motard découvrit ce qu’il cherchait dans l’une des poches pratiquées dans le capitonnage des portières et, sans se donner la peine de procéder à une vérification, il dégonfla les pneus de la traction de quatre coups de poinçon, ramassa le couteau, réenfourcha sa machine et fila."
                                            },
                                            {
                                                "example_id": "fe34f4f5-7cce-4832-a86f-cc1d72861389",
                                                "sense_id": "a51d6d3e-5779-3bf6-9477-d8cde2168b0c",
                                                "text": "À chaque escale à Amsterdam, je filais au marché aux fleurs du Singel ou chez un vieil horticulteur de Schoorl pour lui rapporter des oignons de jonquilles, de jacinthes, de muscaris, d'amaryllis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b34d7ba8-7767-361e-a2d6-1ea1a173ee60",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Se bagarrer."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7a1fe10-74d0-44a1-9683-9def4552df74",
                                                "sense_id": "b34d7ba8-7767-361e-a2d6-1ea1a173ee60",
                                                "text": "Viens avec moi, on va se filer, tête à tête, je vais te fumer derrière le cyprès"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44cd764b-85ae-3eab-a0b4-c4410c41a002",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "S’allonger exagérément, généralement en devenant fragile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4abfe038-5e67-48b0-a3e8-4f204804eb0f",
                                                "sense_id": "44cd764b-85ae-3eab-a0b4-c4410c41a002",
                                                "text": "Le chêne rouge a tendance à plier sous le poids de ses feuilles durant les premières années, en raison d'un manque de rigidité de la tige et d'une propension à filer vers la lumière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "affea0b9-7e03-3868-b256-bb9fd77fe69d",
                                        "entry_id": "1d2108a7-ac91-3d60-8fdf-2c79865877b4",
                                        "glosses": [
                                            "Se sentir. (Le plus souvent utilisé sous une forme négative)"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3cf6bc1-2a32-4b2d-92be-9a3a5ec40a97",
                                                "sense_id": "affea0b9-7e03-3868-b256-bb9fd77fe69d",
                                                "text": "— Pis ? Comment tu files à'matin ?\n— Ça file pas pantoute. J'ai l'impression qu'on essaie de me soulever en me tirant par les cheveux!"
                                            }
                                        ]
                                    }
                                ]
                            },
