                        ]
                    },
                    {
                        "translation_id": "1066de2b-a161-4f61-979b-832426b9c48d",
                        "source_entry_id": "cdf98a89-62cc-3153-bb26-1a3139d37f40",
                        "source_sense_id": "dc64c4a9-dd78-3cce-9655-9559de81a1e0",
                        "target_lang_word": "Pfälzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfälzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68b43eb2-8f6b-34ce-b371-e7c96f106463",
                                        "entry_id": "5a7445bf-c4c7-3b21-9a2d-e4a04a95207b",
                                        "glosses": [
                                            "Person, die aus der Pfalz stammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fcd4173-4c43-42e5-bfa0-a8dd6e2c7753",
                                                "sense_id": "68b43eb2-8f6b-34ce-b371-e7c96f106463",
                                                "text": "Ein Bekannter von mir ist Pfälzer."
                                            },
                                            {
                                                "example_id": "bbb0c9cc-2618-4a87-ade4-293c29789cba",
                                                "sense_id": "68b43eb2-8f6b-34ce-b371-e7c96f106463",
                                                "text": "„Ein Pfälzer Dorfbäcker trat mit seinem Team beim Wettbacken im Fernsehen auf.“"
                                            },
                                            {
                                                "example_id": "192d6c35-f19d-4bec-8737-963ae93f7a4f",
                                                "sense_id": "68b43eb2-8f6b-34ce-b371-e7c96f106463",
                                                "text": "„Der 51 Jahre alte Pfälzer ist nicht nur Bauer, sondern Aufsichtsratschef der ‚Pfalzmarkt Obst und Gemüse Genossenschaft‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb3999dd-b4df-3195-8d98-56503467d4e5",
                                        "entry_id": "5a7445bf-c4c7-3b21-9a2d-e4a04a95207b",
                                        "glosses": [
                                            "Wein aus dem südwestdeutschen Weinbaugebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c9d2f2-7222-49b2-84cf-124b218c832c",
                                                "sense_id": "cb3999dd-b4df-3195-8d98-56503467d4e5",
                                                "text": "An seinem Geburtstag trank er einen Pfälzer, seinen Lieblingswein."
                                            },
                                            {
                                                "example_id": "096e1462-55cb-4a91-94b9-d92270901582",
                                                "sense_id": "cb3999dd-b4df-3195-8d98-56503467d4e5",
                                                "text": "„Echte Pfälzer mit Patenonkeln aus der Loire und Südafrika sind hingegen die Sauvignons Blancs, die bis zu achtzehn Monate auf der Hefe liegen und zwei Jahre lang in der Flasche reifen, ein kommerzielles Kamikaze, das jeden Weinfanatiker adelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "50932e43-4c58-3e43-88a0-c36a571ca512",
                                        "entry_id": "5a7445bf-c4c7-3b21-9a2d-e4a04a95207b",
                                        "glosses": [
                                            "mit etwas Majoran gefülltes Würstchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15395fa3-fc49-463b-931b-92f6c122ae46",
                                                "sense_id": "50932e43-4c58-3e43-88a0-c36a571ca512",
                                                "text": "Sie bestellte zwei Pfälzer an der Wurstbude."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pfälzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f87819e-9933-3bb3-8a3b-82532533f8bd",
                                        "entry_id": "cb9600a5-c136-30a6-a340-ae2c4d570b3d",
                                        "glosses": [
                                            "aus der Pfalz stammend, zu ihr gehörend, sie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3dd9972-6e12-4a37-8c30-ba82da061b38",
                                                "sense_id": "7f87819e-9933-3bb3-8a3b-82532533f8bd",
                                                "text": "„Susanne Winterling strampelt die Pfälzer Weinorte mit dem Fahrrad ab - Deidesheim, Forst, Wachenheim.“"
                                            },
                                            {
                                                "example_id": "89c14766-9c8b-4a03-a97b-58d46ff4f1ab",
                                                "sense_id": "7f87819e-9933-3bb3-8a3b-82532533f8bd",
                                                "text": "„Der Betrachter wird angeregt vor den Pfälzer Landschaften mit ihren weiten Blicken ins Land über Höhen und Täler, über Weinberge, Wälderund Wiesen, mit ihren großgespannten Himmeln, einen Vers zu zitieren.“"
                                            },
                                            {
                                                "example_id": "d014ea8a-026c-4f51-a2f8-05df938bcf79",
                                                "sense_id": "7f87819e-9933-3bb3-8a3b-82532533f8bd",
                                                "text": "„Nach dem Krisenjahr 1770 erreichten die Pfälzer Städte ihr Ziel, den gesamten Getreidehandel in den Städten zu zentralisieren[.]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "011cf0e8-9762-4148-b658-74cad747c999",
                        "source_entry_id": "cdf98a89-62cc-3153-bb26-1a3139d37f40",
