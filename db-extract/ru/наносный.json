                            "feminine",
                            "short-form"
                        ],
                        "form": "нано́сна"
                    },
                    {
                        "form_id": "d65f8981-b694-4d04-b2a0-30bd32e98ac4",
                        "entry_id": "8c7f42f1-b5fd-32c7-841e-f65a29919b82",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "нано́сны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba31ac58-ae88-36f4-aa8f-053befdba0b8",
                        "entry_id": "8c7f42f1-b5fd-32c7-841e-f65a29919b82",
                        "glosses": [
                            "нанесённый течением воды, движением льда, ветром"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a85ee64-0f03-4bf9-b6d2-ac89b430ae6a",
                                "sense_id": "ba31ac58-ae88-36f4-aa8f-053befdba0b8",
                                "text": "По широкой лагуне, отделяющей Венецию от узкой полосы наносного морского песку, называемой Лидо, скользила острогрудая гондола, мерно покачиваясь при каждом толчке падавшего на длинное весло гондольера."
                            },
                            {
                                "example_id": "879429e7-e148-4251-9056-fbeabbd08881",
                                "sense_id": "ba31ac58-ae88-36f4-aa8f-053befdba0b8",
                                "text": "Почва состоит из глины, наносного ила, железняка и гранита."
                            },
                            {
                                "example_id": "da6f1975-77eb-4acd-9117-8d1abc8c3ac6",
                                "sense_id": "ba31ac58-ae88-36f4-aa8f-053befdba0b8",
                                "text": "Вода сбыла, оставя кое-где мокрые следы и небольшие гривы наносной земли с черноземных полей."
                            },
                            {
                                "example_id": "303bc05d-df99-4e38-b3db-2fb91b3c984f",
                                "sense_id": "ba31ac58-ae88-36f4-aa8f-053befdba0b8",
                                "text": "Но глубоко и тяжело завален клад дрянью, наносным сором."
                            }
                        ]
                    },
                    {
                        "sense_id": "0709c4d9-00a5-3829-a952-67208750d4ff",
                        "entry_id": "8c7f42f1-b5fd-32c7-841e-f65a29919b82",
                        "glosses": [
                            "перен. привнесённый извне, заимствованный со стороны, не свойственный кому-либо или чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c955f9c6-3103-416d-be50-1338dbad0b53",
                                "sense_id": "0709c4d9-00a5-3829-a952-67208750d4ff",
                                "text": "Голос живой природы берет верх над наносными культурными привычками."
                            },
                            {
                                "example_id": "c5137f09-9227-4fe1-93ad-930f2536fbd0",
                                "sense_id": "0709c4d9-00a5-3829-a952-67208750d4ff",
                                "text": "Но он человек надорванный, порченый, и бездна в нем привитого, наносного варварства."
                            },
                            {
                                "example_id": "5296e9aa-9852-4894-a1c0-57a16e3947a0",
                                "sense_id": "0709c4d9-00a5-3829-a952-67208750d4ff",
                                "text": "Желание очиститься от наносных слов было бы достигнуто, а вместе с тем и патриотическое чувство нашло бы себе правильный и не голословный исход."
                            }
                        ]
                    },
                    {
                        "sense_id": "c92ad868-9e7f-3e98-8a16-bc5f65cfcba0",
                        "entry_id": "8c7f42f1-b5fd-32c7-841e-f65a29919b82",
                        "glosses": [
                            "устар. клеветнический, лживый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bceb0b4-9143-46b2-9f43-59310c76201b",
                                "sense_id": "c92ad868-9e7f-3e98-8a16-bc5f65cfcba0",
                                "text": "Он сам никогда не бездельничает, а потому требует и от тех, которые к нему обращаются, чтоб они высказывали ему свое дело прямо и кратко, без подмеси пустых и наносных речей."
                            },
                            {
                                "example_id": "a732ce9f-a5ba-41ca-b6ab-c290bb3f2ac7",
                                "sense_id": "c92ad868-9e7f-3e98-8a16-bc5f65cfcba0",
                                "text": "— Не верьте, Марко Данилыч, пустым наносным речам."
                            }
                        ]
                    }
                ],
                "translations": [],
