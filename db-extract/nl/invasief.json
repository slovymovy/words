                "translations": [
                    {
                        "translation_id": "4d62fb38-4a61-4449-a81b-98b802fbf697",
                        "source_entry_id": "c0d1255d-dedd-3913-a30e-cfb7f339c2e8",
                        "source_sense_id": "b251bdc0-b0fb-35fc-8e6c-e2695d9272f8",
