{
    "word_family": [
        "rap",
        "rappen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1c52e5b-a4a9-3b75-9a3a-44668b13a0e8",
                    "sense_definition": "Iemand die ritmisch teksten voordraagt op muziek, meestal hiphop.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "muziek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op het feest zijn verschillende dj's, bandjes en <w>rappers</w>.",
                            "target_lang_translations": {
                                "fr": "Il y a différents DJ, groupes et <w>rappeurs</w> à la fête."
                            }
                        },
                        {
                            "text": "Verschillende sterren hebben honend gereageerd op de actie van de <w>rapper</w>.",
                            "target_lang_translations": {
                                "fr": "Plusieurs stars ont réagi avec mépris à l'action du <w>rappeur</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hiphopper"
                    ],
                    "common_phrases": [
                        "bekende rapper"
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne qui déclame des textes de manière rythmique sur de la musique, généralement du hip-hop."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "rappeur",
                                "target_lang_sense_clarification": "Artiste pratiquant le rap"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8632266b-545b-32f4-8e32-aac866810e6b",
                    "sense_definition": "De vergrotende trap van <w>rap</w> (sneller).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "snelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het gaat daar wat <w>rapper</w> bergop dan hier in de hei.",
                            "target_lang_translations": {
                                "fr": "Ça monte un peu <w>plus vite</w> là-bas qu'ici dans la lande."
                            }
                        },
                        {
                            "text": "Je moet wat <w>rapper</w> doorlopen als we de trein nog willen halen.",
                            "target_lang_translations": {
                                "fr": "Tu dois marcher un peu <w>plus vite</w> si nous voulons encore attraper le train."
                            }
                        }
                    ],
                    "synonyms": [
                        "sneller"
                    ],
                    "antonyms": [
                        "langzamer"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vergrotende trap"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Forme comparative de rapide, signifiant plus vite."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "plus vite",
                                "target_lang_sense_clarification": "Indique une vitesse supérieure"
                            },
                            {
                                "target_lang_word": "plus rapidement",
                                "target_lang_sense_clarification": "Indique une manière plus prompte"
                            }
                        ]
                    }
                }
            ]
        }
    ]
