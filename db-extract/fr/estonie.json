                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Estonia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cca7b529-6ccc-35e4-b463-f149fbd370f9",
                                        "entry_id": "5c3b3b6b-ad7b-38b5-bacc-bc2bac8f0ee1",
                                        "glosses": [
                                            "A country in northeastern Europe, on the southeastern coast of the Baltic Sea. Official name: Republic of Estonia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e01b529-6ff5-4aa9-95e1-e087ef79c338",
                                                "sense_id": "cca7b529-6ccc-35e4-b463-f149fbd370f9",
                                                "text": "“In the late 1930s, the Western democracies hesitated in the face of danger,” Prime Minister Siim Kallas of Estonia, a former Soviet republic, told me. “As a consequence, we fell under dictatorships and many people lost their lives. Action is sometimes necessary.”"
                                            },
                                            {
                                                "example_id": "31155039-f92b-4a6d-bc62-1059c9dd035e",
                                                "sense_id": "cca7b529-6ccc-35e4-b463-f149fbd370f9",
                                                "text": "While there is less income inequality in Estonia than in the United States—and, with 1.3 million people, the country is significantly smaller—the Baltic nation also has its share of cultural diversity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
