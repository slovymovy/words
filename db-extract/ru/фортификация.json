                "senses": [
                    {
                        "sense_id": "3fd96491-4c9d-370c-b9e3-a4d4bbd19748",
                        "entry_id": "cd0c5c04-4b0b-3e51-9886-5cee614d6734",
                        "glosses": [
                            "воен. действие по значению гл. фортифицировать"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "37451a7d-cefc-37e2-b214-939f44c25b46",
                        "entry_id": "cd0c5c04-4b0b-3e51-9886-5cee614d6734",
                        "glosses": [
                            "воен. результат такого действия; военно-инженерные сооружения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5613c84f-2b6a-43fd-a138-f666fc82bc6b",
                                "sense_id": "37451a7d-cefc-37e2-b214-939f44c25b46",
                                "text": "Полевая фортификация."
                            },
                            {
                                "example_id": "d980fde6-52ac-4b4e-8331-66c5406208fa",
                                "sense_id": "37451a7d-cefc-37e2-b214-939f44c25b46",
                                "text": "Долговременная фортификация."
                            }
                        ]
                    },
                    {
                        "sense_id": "e17f70c9-c194-37c9-b071-f804a9d920dc",
                        "entry_id": "cd0c5c04-4b0b-3e51-9886-5cee614d6734",
                        "glosses": [
                            "воен. военно-инженерная наука об укреплении местности для ведения боя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92f498ff-8746-4d29-84db-5e05c774bf74",
                                "sense_id": "e17f70c9-c194-37c9-b071-f804a9d920dc",
                                "text": "Иноземцы, приставленные также к царевичу: Лефорт и Тимерман, учили его геометрии и фортификации."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3251e1b6-6b5f-4b0d-b243-1c4f0dbfe379",
                        "source_entry_id": "cd0c5c04-4b0b-3e51-9886-5cee614d6734",
                        "source_sense_description": "действие",
                        "target_lang_word": "fortification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d877a63-f1d4-3d8f-a366-44ed9c8940b9",
                                        "entry_id": "496457a4-6820-3e90-a404-fdfdf4fb5749",
                                        "glosses": [
                                            "Action de fortifier une ville, une place, de la munir d’ouvrages de défense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b3a5ec3-bb70-4b61-9755-a4dd0f21d549",
                                                "sense_id": "4d877a63-f1d4-3d8f-a366-44ed9c8940b9",
                                                "text": "On travaille à la fortification de la place. - Projet, plan de fortification de tel point de la frontière. - Cours de fortification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "445cbfb3-044e-3ef9-83fb-6d9dda96c89b",
                                        "entry_id": "496457a4-6820-3e90-a404-fdfdf4fb5749",
                                        "glosses": [
                                            "Cet ouvrage de défense lui-même."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af549183-ad34-4950-b23b-bc4ab91899ca",
                                                "sense_id": "445cbfb3-044e-3ef9-83fb-6d9dda96c89b",
                                                "text": "Il examina cette place avec tout le soin possible, pour tâcher de trouver des traces de fortifications en pierres ou en bois, mais ne put rien découvrir."
                                            },
                                            {
                                                "example_id": "05694cbb-b8bb-494e-9ed0-cb079ca59b95",
                                                "sense_id": "445cbfb3-044e-3ef9-83fb-6d9dda96c89b",
                                                "text": "Après avoir suivi l’avenue des Champs-Élysées et franchi les fortifications à la porte Maillot, on s’était mis à regarder la contrée."
                                            },
                                            {
                                                "example_id": "c7959956-73e8-4f85-862d-6199307dfcf0",
                                                "sense_id": "445cbfb3-044e-3ef9-83fb-6d9dda96c89b",
                                                "text": "Après le « mur murant » de 1786, les fortifications de 1840 ont été démolies pierre par pierre, et la terre de leurs glacis à servi à combler les fossés de défense dont on l'avait tirée."
                                            },
                                            {
                                                "example_id": "2d49c751-ea49-49f7-b169-d89ee63fc932",
                                                "sense_id": "445cbfb3-044e-3ef9-83fb-6d9dda96c89b",
                                                "text": "A partir du 16 septembre, le fort de la Pompelle, un des forts de la ceinture de Reims édifié dans le cadre de la deuxième ligne de fortifications de Séré de Rivières, est désigné comme cible aux soldats français qui le prennent d'assaut le 23 septembre au prix d'innombrables vies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fc12f6b-f228-3a07-b68f-e62dc1a22e41",
                                        "entry_id": "496457a4-6820-3e90-a404-fdfdf4fb5749",
                                        "glosses": [
                                            "Zone des anciennes fortifications de Paris après leur démolition."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ddbe5ff-5c70-404d-b98a-2b0817f9975d",
                                                "sense_id": "0fc12f6b-f228-3a07-b68f-e62dc1a22e41",
                                                "text": "Plutôt que d'acquérir les quelques connaissances ouvrant la porte du certificat d’études, il préférait voyouter sur les fortifications. Ces restes de l’ancienne zone qui persistaient à peu de distance de sa maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cfd8ef5-4835-30f8-ad77-4531af6de8de",
                                        "entry_id": "496457a4-6820-3e90-a404-fdfdf4fb5749",
                                        "glosses": [
                                            "Produit ou remède fortifiant."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da761225-3d83-40b1-958f-9e5ff99de13c",
                                                "sense_id": "4cfd8ef5-4835-30f8-ad77-4531af6de8de",
                                                "text": "L’une d’entre elles émit cette remarque qu’Olympe était faible et avait besoin de prendre des fortifications. Une fille à tout faire lui monta donc un potage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "121ff577-c486-4a42-94ff-0911c5c5cb8a",
                        "source_entry_id": "cd0c5c04-4b0b-3e51-9886-5cee614d6734",
                        "source_sense_description": "действие",
                        "target_lang_word": "renforcement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renforcement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                        "entry_id": "02f99498-2216-367a-b7b9-2b6427e88d3c",
                                        "glosses": [
                                            "Action de renforcer, résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82d82387-15c5-4665-ae83-717fcd089458",
                                                "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                                "text": "Le manche est en bois ; on en colle le talon au bout de la caisse sur le renforcement ou épaulement de la table : il est terminé en volute, et creusé d'un large sillon ou mortaise ; c'est le sommier."
                                            },
                                            {
                                                "example_id": "7bb6157e-8fb9-447c-9eb2-59501f46ef32",
                                                "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                                "text": "Et c'est cette politique aussi qui favorisa le renforcement du ritualisme juif, lequel semble avoir été assez modéré jusqu'au XVᵉ siècle."
                                            },
                                            {
                                                "example_id": "5a674259-bfad-4f4b-986f-2ea9c199d115",
                                                "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                                "text": "Les résultats de l’étude permettent de savoir comment on peut réduire l’épaisseur d'un renforcement en utilisant des enrobés moins fatigables qui n’ornièreront pas plus pour autant."
                                            },
                                            {
                                                "example_id": "cd6cfbb9-c9a2-46cf-8ebc-4da1fa22825e",
                                                "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                                "text": "Le renforcement des alizés depuis vingt ans y a créé un énorme réservoir de chaleur, « les eaux chaudes y forment une couche plus épaisse », explique Cazenave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5795b4b4-a589-4675-9ee6-a6bc2161bc17",
                        "source_entry_id": "cd0c5c04-4b0b-3e51-9886-5cee614d6734",
                        "source_sense_description": "укрепления, сооружения",
                        "target_lang_word": "fortification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9d25f4d-0cc1-3b3c-ad2d-99456cf943e7",
                                        "entry_id": "8f35ce72-a97b-3687-971e-5bdc09145ca3",
                                        "glosses": [
                                            "The act of fortifying; the art or science of fortifying places to strengthen defence against an enemy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96c48faf-f8c6-3fae-8ef9-cd772548b131",
                                        "entry_id": "8f35ce72-a97b-3687-971e-5bdc09145ca3",
                                        "glosses": [
                                            "That which fortifies; especially, a work or works erected to defend a place against attack; a fortified place; a fortress; a fort; a castle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71e9c0b2-663a-41cc-9d42-2f0c1e2c2c57",
                                                "sense_id": "96c48faf-f8c6-3fae-8ef9-cd772548b131",
                                                "text": "Kenett states that the military works still known by the name of Tadmarten Camp and Hook-Norton Barrow were cast up at this time ; the former, large and round, is judged to be a fortification of the Danes, and the latter, being smaller and rather a quinquangle than a square, of the Saxons."
                                            },
                                            {
                                                "example_id": "462477ea-73d5-4a3b-8d85-3e34d5ebffee",
                                                "sense_id": "96c48faf-f8c6-3fae-8ef9-cd772548b131",
                                                "text": "“[…] We are engaged in a great work, a treatise on our river fortifications, perhaps? But since when did army officers afford the luxury of amanuenses in this simple republic?[…]”"
                                            },
                                            {
                                                "example_id": "4c7693b6-8c66-49f8-965f-9f40a9ce0494",
                                                "sense_id": "96c48faf-f8c6-3fae-8ef9-cd772548b131",
                                                "text": "As Edwin Clark [...] wrote in 1850: \"[...] The lofty towers of the castle overhang the western approach to the Bridge, and the line passes into Conway through an opening pierced in the embattled wall, which entirely surrounds the town. These fortifications are in good preservation, and rank among the most perfect examples of the strongholds of the 13th century.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb9f5aa1-023e-3520-bcc6-332a922219d1",
                                        "entry_id": "8f35ce72-a97b-3687-971e-5bdc09145ca3",
                                        "glosses": [
                                            "An increase in effectiveness, as by adding ingredients."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e9ada0e-ac89-41ce-a63c-5ea10cf9ed35",
                                                "sense_id": "eb9f5aa1-023e-3520-bcc6-332a922219d1",
                                                "text": "Compare the nutrition information label of a regular ready-to-eat fortified cereal with that of a presweetened brand and you'll note that, although the sweetened one's sugar content is higher, the fortification is virtually identical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21f63af4-3d92-33ed-af7a-3e01df4ed71c",
                                        "entry_id": "8f35ce72-a97b-3687-971e-5bdc09145ca3",
                                        "glosses": [
                                            "A jagged pattern sometimes seen during an attack of migraine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
