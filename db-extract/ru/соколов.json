                                    },
                                    {
                                        "sense_id": "50c53dd6-e25b-3275-8230-8196d226663a",
                                        "entry_id": "77bec561-a673-3586-a941-8d6261ae3a0b",
                                        "glosses": [
                                            "A transliteration of the Russian surname Соколов (Sokolov)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42e078b9-08b5-47ec-9e73-0f0003a8a99a",
                                                "sense_id": "50c53dd6-e25b-3275-8230-8196d226663a",
                                                "text": "When Mikhail Sokolov signed up to work for the FSB security services, he never imagined his journey would end here: in a crowded refugee camp on the outskirts of a sleepy town in the rural Netherlands."
                                            }
