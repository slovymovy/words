                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80861898-1dbe-4a36-ad29-5670d8e609bc",
                                "sense_id": "efa888b4-db7b-3c6b-9340-bd48a1a83f9a",
                                "text": "Uit angst voor ontslag lopen mensen langer door met kwaaltjes. Tegelijkertijd blijkt reorganisatie-stress een echte ziekmaker."
                            },
                            {
                                "example_id": "7e7c42a3-7fc2-44ce-8f9f-57e3ca64dad9",
                                "sense_id": "efa888b4-db7b-3c6b-9340-bd48a1a83f9a",
                                "text": "De onderzoekers weten nog steeds niet waar de bacterie vandaan komt, maar op geen enkele groente uit Europa is de ziekmaker aangetroffen."
                            },
                            {
                                "example_id": "4d5e5006-e598-45d0-825e-431febcfa31b",
                                "sense_id": "efa888b4-db7b-3c6b-9340-bd48a1a83f9a",
                                "text": "\"Roken staat met stip op één als grootste ziekmaker. Rokers zijn anderhalf keer zo vaak en zo lang ziek als niet-rokers. Een op de vier sterft zelfs al voor zijn pensioenleeftijd aan de gevolgen van roken,\" zegt longarts Pauline Dekker van het Rode Kruis Ziekenhuis in Beverwijk."
                            }
                        ]
                    }
