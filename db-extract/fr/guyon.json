                "forms": [],
                "senses": [
                    {
                        "sense_id": "f6b4c995-dd7f-3c9f-896c-6ddca48285f3",
                        "entry_id": "86d87ba3-84a3-3af4-883c-b670754d35a4",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19cbc9a6-cb48-496f-8d25-a645b0aaebe0",
                                "sense_id": "f6b4c995-dd7f-3c9f-896c-6ddca48285f3",
                                "text": "Nils Guyon, très performant en Catalogne comme lors de tous les tournois estivaux de 2021, est encore de la fête."
                            },
                            {
                                "example_id": "8d58e9b1-f223-4387-a137-bd8773bee67e",
                                "sense_id": "f6b4c995-dd7f-3c9f-896c-6ddca48285f3",
                                "text": "Ce représentant de Christophe Ferland bénéficie de la monte de Maxime Guyon et a démontré qu’il pouvait lutter pour les premières places en valeur 40, pris à ce poids il est en effet monté sur le podium 3 fois en 4 sorties."
                            },
                            {
                                "example_id": "ff6f9421-5ebd-4353-bb77-092a57677f99",
                                "sense_id": "f6b4c995-dd7f-3c9f-896c-6ddca48285f3",
                                "text": "C’est dur de finir les sept chapitres de ma discipline, abonde Benoît Guyon, coprésident de l’Association des professeurs de sciences économiques et sociales (Apses)."
                            }
                        ]
                    }
                ],
