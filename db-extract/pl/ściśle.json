                                "target_senses": [
                                    {
                                        "sense_id": "c8f779f3-042b-3c8c-8a84-f7aa27532555",
                                        "entry_id": "3b1ad299-bb7f-3ae8-9943-2b27a578df99",
                                        "glosses": [
                                            "In a strict manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c3b9127-af51-42e0-acb5-611358fcaab0",
                                                "sense_id": "c8f779f3-042b-3c8c-8a84-f7aa27532555",
                                                "text": "He adhered strictly to the diet his doctor prescribed."
                                            },
                                            {
                                                "example_id": "ae2d1577-fea4-46e7-85f1-7dc8b51a24be",
                                                "sense_id": "c8f779f3-042b-3c8c-8a84-f7aa27532555",
                                                "text": "“If any pupil considers it acceptable to bring a pet into this school, let me tell you it is forbidden. Strictly forbidden!” pronounced the headmaster from the front of the class."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf9e95a-64b6-3780-8627-b0cd7337bff5",
                                        "entry_id": "3b1ad299-bb7f-3ae8-9943-2b27a578df99",
                                        "glosses": [
                                            "In a limited manner; only"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a601a792-dabd-47f7-995a-cad001a0a2c3",
                                                "sense_id": "9bf9e95a-64b6-3780-8627-b0cd7337bff5",
                                                "text": "This work was strictly voluntary, but any animal who absented himself from it would have his rations reduced by half."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3dd0491-17df-3ec4-90dd-43fd28e1dabc",
                                        "entry_id": "3b1ad299-bb7f-3ae8-9943-2b27a578df99",
                                        "glosses": [
                                            "In a narrow or limited sense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6d6684a-a654-4fb4-b920-64b4cd16b35c",
                                                "sense_id": "d3dd0491-17df-3ec4-90dd-43fd28e1dabc",
                                                "text": "That term refers strictly to smaller birds."
                                            },
                                            {
                                                "example_id": "8564fea6-411e-48b2-adb1-d308c4dbea1f",
                                                "sense_id": "d3dd0491-17df-3ec4-90dd-43fd28e1dabc",
                                                "text": "Scientific naming conventions are such that technically, ammonites are ammonoidean, ammonitidan, and sometimes strictly ammonitinan cephalopods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fad483e-cf3d-39fe-b0d4-39c68159c172",
                                        "entry_id": "3b1ad299-bb7f-3ae8-9943-2b27a578df99",
                                        "glosses": [
                                            "In a manner that applies to every member of a set or every interval of a function"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76c7f200-bd02-46ad-8031-3f9651ee04e5",
                        "source_entry_id": "6beef00a-da97-3b60-a46a-de04b2ebccab",
                        "source_sense_id": "a6bb6676-fc9f-3e95-a529-f9bb7c22f81e",
                        "target_lang_word": "precisely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precisely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ac5f36b-c751-3b16-90fe-51133b965647",
                                        "entry_id": "9bcdd99b-5809-39cd-926f-f8a8fff3c482",
                                        "glosses": [
                                            "In a precise manner; exactly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c36aac5-8a39-4269-b5a9-de5bd21b5f9b",
                                                "sense_id": "9ac5f36b-c751-3b16-90fe-51133b965647",
                                                "text": "I always try to express myself precisely."
                                            },
                                            {
                                                "example_id": "e11efab0-9e89-46ee-86f1-edf1d3e317c7",
                                                "sense_id": "9ac5f36b-c751-3b16-90fe-51133b965647",
                                                "text": "He says he will vote against Donald Trump “precisely because I’m conservative.”"
                                            },
                                            {
                                                "example_id": "0403bcf7-9a25-4d46-a326-5f0100bf6908",
                                                "sense_id": "9ac5f36b-c751-3b16-90fe-51133b965647",
                                                "text": "Thus, “[t]he number of people who detransition or discontinue gender treatments is not precisely known.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d83d433-3660-38c9-a16f-64a52d0759bd",
                                        "entry_id": "9bcdd99b-5809-39cd-926f-f8a8fff3c482",
                                        "glosses": [
                                            "Used to provide emphasis."
                                        ],
                                        "tags": [
                                            "focus"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b96d610a-85d0-45c7-b1d3-511bb767c0cd",
                        "source_entry_id": "6beef00a-da97-3b60-a46a-de04b2ebccab",
                        "source_sense_id": "a6bb6676-fc9f-3e95-a529-f9bb7c22f81e",
                        "target_lang_word": "à la lettre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à la lettre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f645d5a-06e7-34fa-bb18-977b06594e03",
                                        "entry_id": "cdc4e5ba-8524-35c2-b012-fada4a750696",
                                        "glosses": [
                                            "Dans son sens littéral ; précisément comme il est écrit, sans interpréter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75b36528-8ba2-4cad-9877-fc755ea9a6e3",
                                                "sense_id": "8f645d5a-06e7-34fa-bb18-977b06594e03",
                                                "text": "Il arriva qu’un hiver fut rude. Jean n’eut pas d’ouvrage. La famille n'eut pas de pain. Pas de pain. A la lettre. Sept enfants."
                                            },
                                            {
                                                "example_id": "445de3e2-6545-4fe8-a73d-882f4fb42972",
                                                "sense_id": "8f645d5a-06e7-34fa-bb18-977b06594e03",
                                                "text": "La prescription des directions est donc une invitation non déguisée au massacre de ces soldats, invitation qui a d’ailleurs été suivie à la lettre par la troupe."
                                            },
                                            {
                                                "example_id": "fdf4092c-6842-4e52-bd56-f52a2f3276e1",
                                                "sense_id": "8f645d5a-06e7-34fa-bb18-977b06594e03",
                                                "text": "L’Astara est à la lettre bondé de marchandises. La cale n’a pas suffi, et une bonne part de la cargaison a reflué sur le pont."
                                            },
                                            {
                                                "example_id": "2b6e15d7-e1dd-4950-a7a1-c810bc5d9e29",
                                                "sense_id": "8f645d5a-06e7-34fa-bb18-977b06594e03",
                                                "text": "Dès les premiers beaux jours, « je repris le dessus », comme disait ma mère. À la lettre, je ressuscitai. J’élargis, je me fortifiai."
                                            },
                                            {
                                                "example_id": "ee49547b-e0bb-4f34-b3f6-c02c950c70d8",
                                                "sense_id": "8f645d5a-06e7-34fa-bb18-977b06594e03",
                                                "text": "S’il dit que les traces se perdaient dans les nuages, c’est que, à la lettre, elles se perdaient dans les nuages, c’est-à-dire dans ces nuages qui couvraient la montagne."
                                            },
                                            {
                                                "example_id": "79c57fa8-9556-4d65-b586-ae33312a13f4",
                                                "sense_id": "8f645d5a-06e7-34fa-bb18-977b06594e03",
                                                "text": "Alex s'était laissé fabriquer comme un cave à plusieurs reprises par des merdailleurs frais émoulus de centrouse qui avaient appliqué à la lettre ses directives, usé de son matériel, et pris le large sans lui donner de leurs nouvelles, une fois le coup exécuté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62089c1f-0dbd-4003-a014-d7475d4771d2",
                        "source_entry_id": "6beef00a-da97-3b60-a46a-de04b2ebccab",
                        "source_sense_id": "a6bb6676-fc9f-3e95-a529-f9bb7c22f81e",
                        "target_lang_word": "étroitement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étroitement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92a4638c-d01f-3fc8-819f-c8c45e05837b",
                                        "entry_id": "650db27b-71f1-358d-baf9-24d018a57acf",
                                        "glosses": [
                                            "À l’étroit, dans un espace resserré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eea62530-d106-4ffb-80cc-78fddb6bb84f",
                                                "sense_id": "92a4638c-d01f-3fc8-819f-c8c45e05837b",
                                                "text": "Vous êtes logé bien étroitement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5858371-8232-32d1-8186-e8e953717208",
                                        "entry_id": "650db27b-71f1-358d-baf9-24d018a57acf",
                                        "glosses": [
                                            "D’une manière étroite, serrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0859b5a1-5683-489f-9258-9e9b92178ef5",
                                                "sense_id": "a5858371-8232-32d1-8186-e8e953717208",
                                                "text": "Ils se tenaient embrassés étroitement."
                                            },
                                            {
                                                "example_id": "34842d03-80f8-4e72-995c-d0c1cb9d100a",
                                                "sense_id": "a5858371-8232-32d1-8186-e8e953717208",
                                                "text": "Ils sont étroitement liés."
                                            },
                                            {
                                                "example_id": "22a67a61-409a-475d-8480-0bcda835dccd",
                                                "sense_id": "a5858371-8232-32d1-8186-e8e953717208",
                                                "text": "C’est dans cette sainte maison qu’elles venaient s’unir par la foi et par la charité plus étroitement qu’elles n’étaient unies par le sang et par la nature […]"
                                            },
                                            {
                                                "example_id": "5e5718d2-cbaf-4e02-a22f-b74023ba1409",
                                                "sense_id": "a5858371-8232-32d1-8186-e8e953717208",
                                                "text": "Dans son voyage d’Italie, il se lia étroitement avec le cardinal Corsini, qui fut depuis Clément XII […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb009a78-004c-3f81-8bb1-a90b90eaa250",
                                        "entry_id": "650db27b-71f1-358d-baf9-24d018a57acf",
                                        "glosses": [
                                            "Rigoureusement, avec rigueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c22c720-3b9f-40e6-9712-54e2b84455ab",
                                                "sense_id": "bb009a78-004c-3f81-8bb1-a90b90eaa250",
                                                "text": "Observer étroitement le carême."
                                            },
                                            {
                                                "example_id": "96a5788f-3e93-4880-b8ed-9134593cee24",
                                                "sense_id": "bb009a78-004c-3f81-8bb1-a90b90eaa250",
                                                "text": "[…] de sorte qu’il oblige étroitement tous les Français […] de reconnaître et de confesser qu’ils n’ont plus ces saintes reliques."
                                            },
                                            {
                                                "example_id": "ba0faa17-6d4a-4103-bf85-57139b307a68",
                                                "sense_id": "bb009a78-004c-3f81-8bb1-a90b90eaa250",
                                                "text": "Il faut étroitement observer le silence,\nOu faire d’un secret l’entière confidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc5842a0-2dfd-3490-9366-f3ef8aada4d9",
                                        "entry_id": "650db27b-71f1-358d-baf9-24d018a57acf",
                                        "glosses": [
                                            "Avec une grande surveillance, parce que plus on est dans un lieu étroit, plus la surveillance est facile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57962bc3-4127-4fb6-85b3-f29bb2a0d682",
                                                "sense_id": "fc5842a0-2dfd-3490-9366-f3ef8aada4d9",
                                                "text": "M. le juge d’instruction Guillot demande, avec raison, que l’on enferme aussi étroitement ces candidats à la folie, ces demi-fous, demi-criminels, demi-responsables dont l’acquittement est arraché à la faiblesse et à la crédulité des jurys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f4c807-3aa5-319e-ac17-21d9a0dc109d",
                                        "entry_id": "650db27b-71f1-358d-baf9-24d018a57acf",
                                        "glosses": [
                                            "En vertu d’une obligation étroite, sur toutes choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "015f98de-6d47-48e9-bf18-ef9839b5436d",
                                                "sense_id": "b3f4c807-3aa5-319e-ac17-21d9a0dc109d",
                                                "text": "[…] scandale qu’il vous est d’autant plus expressément et plus étroitement ordonné de prévenir et d’éviter […]"
                                            },
                                            {
                                                "example_id": "b428630c-56ae-44e0-90cc-a0cdb0cc2094",
                                                "sense_id": "b3f4c807-3aa5-319e-ac17-21d9a0dc109d",
                                                "text": "On lui a étroitement défendu de parler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41a988c0-3a87-40b2-9002-6c2c00a676c2",
                        "source_entry_id": "6beef00a-da97-3b60-a46a-de04b2ebccab",
                        "source_sense_id": "a6bb6676-fc9f-3e95-a529-f9bb7c22f81e",
                        "target_lang_word": "exactement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exactement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                        "entry_id": "01566817-f387-3b39-af91-16e1865f2c14",
                                        "glosses": [
                                            "D’une manière exacte, correctement précise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f971e597-a2cc-4203-b07c-7c571055cd29",
                                                "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                                "text": "Comme toutes les réformes monétaires, la stabilisation de la monnaie allemande a provoqué une crise économique, ou plus exactement, elle n'a pas suffi à en préserver le Reich."
                                            },
                                            {
                                                "example_id": "0344f036-230e-40be-a83b-4145a656978f",
                                                "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                                "text": "Par contre nous nous sommes attaché à représenter l’orographie et l’hydrographie de la région aussi exactement qu'il nous a été possible de le faire."
                                            },
                                            {
                                                "example_id": "5c190caa-5cc0-45cb-839a-c49f7835f7a6",
                                                "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                                "text": "Elle ne sait pas exactement ce qu’elle veut, mais elle sait très bien ce qu’elle refuse : retourner à Aix et devenir la parfaite épouse d’un pinardier."
                                            },
                                            {
                                                "example_id": "d19daa0a-0d3f-4630-824f-9944d355baf9",
                                                "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                                "text": "Pour moi, monseigneur, qui vous connais jusque dans l’âme, et qui sais combien exactement vous vous acquittez de tous les devoirs de toutes sortes d’amitiés."
                                            }
