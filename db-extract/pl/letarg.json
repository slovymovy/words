                "senses": [
                    {
                        "sense_id": "b777aca3-8e6f-3ee6-b2b0-8dba6d719937",
                        "entry_id": "7116bfe7-3b31-3dc0-8680-4bcdead566c1",
                        "glosses": [
                            "stan pozornej śmierci, polegający na głębokim śnie, w którym zanikają reakcje na bodźce"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c939f2ce-a722-436f-a424-48ba51917a67",
                                "sense_id": "b777aca3-8e6f-3ee6-b2b0-8dba6d719937",
                                "text": "Uszkodzenie ośrodka oddechowego, np. na skutek apopleksji, może powodować objawy podobne do letargu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a0e86697-5ede-37e3-a8bb-4defcd380732",
                        "entry_id": "7116bfe7-3b31-3dc0-8680-4bcdead566c1",
                        "glosses": [
                            "apatia, bezwład"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b72348a5-738c-4e7f-a7e1-a3c127960530",
                        "source_entry_id": "7116bfe7-3b31-3dc0-8680-4bcdead566c1",
                        "source_sense_id": "b777aca3-8e6f-3ee6-b2b0-8dba6d719937",
                        "target_lang_word": "lethargy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lethargy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1669a976-17a4-3177-8afd-78720796edad",
                                        "entry_id": "83a913a1-ea0c-3ca8-b51f-94bcecfc1e37",
                                        "glosses": [
                                            "A state of extreme torpor, sopor or apathy, especially with lack of emotion, energy or enthusiasm; (loosely) sluggishness, laziness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09847e9d-5310-4c32-be3c-998f46402335",
                                                "sense_id": "1669a976-17a4-3177-8afd-78720796edad",
                                                "text": "Europe lay then under a deep lethargy."
                                            },
                                            {
                                                "example_id": "0bddc281-e7dd-4bdd-b135-0939f5bad8bd",
                                                "sense_id": "1669a976-17a4-3177-8afd-78720796edad",
                                                "text": "Gradually the darkened room seems to emerge from its shadows; familiar objects strike upon the senses—and memory is never so terribly distinct as on its first reviving from such momentary lethargy."
                                            },
                                            {
                                                "example_id": "d5a92cf5-106f-47c5-a3be-33801b2f6c57",
                                                "sense_id": "1669a976-17a4-3177-8afd-78720796edad",
                                                "text": "As already indicated, timekeeping is very poor. Point-to-point times are not kept, even with a clear road, and whilst fast running has never been a feature of the route because of the large number of junctions and speed restrictions, this Sunday night lethargy is hard to explain."
                                            },
                                            {
                                                "example_id": "7913f083-46c4-4c3c-87a7-74e2190b5416",
                                                "sense_id": "1669a976-17a4-3177-8afd-78720796edad",
                                                "text": "Yakovlev, one of the architects of the reforms put in place by Mikhail Gorbachev, says he too is \"amazed\" at the government's lethargy."
                                            },
                                            {
                                                "example_id": "8d9caa7d-d7df-41a5-8803-aad50f016181",
                                                "sense_id": "1669a976-17a4-3177-8afd-78720796edad",
                                                "text": "The increase in mining stocks helped the FTSE 100 shake off some earlier lethargy and close 9.8 points higher at 6270.8, despite the disappointment of unchanged UK interest rates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b890b37-b7aa-3c1b-a515-e4697c477c12",
                                        "entry_id": "83a913a1-ea0c-3ca8-b51f-94bcecfc1e37",
                                        "glosses": [
                                            "A condition characterized by extreme fatigue or drowsiness, deep unresponsiveness, or prolonged sleep patterns."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebb0b3d7-68bf-43a2-b6a5-84bc605dafb6",
                                                "sense_id": "1b890b37-b7aa-3c1b-a515-e4697c477c12",
                                                "text": "This Apoplexie is (as I take it) a kind of Lethargie, a sleeping of the blood, a horson Tingling."
                                            },
                                            {
                                                "example_id": "9a5e6113-f4d7-4ab4-b56c-0e6d87525d01",
                                                "sense_id": "1b890b37-b7aa-3c1b-a515-e4697c477c12",
                                                "text": "So in order to avoid unpleasant side effects like lethargy and sexual dysfunction, most recent trials also gave men testosterone supplements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c952a11a-a27d-41e6-bf4c-c93538d5a847",
                        "source_entry_id": "7116bfe7-3b31-3dc0-8680-4bcdead566c1",
                        "source_sense_id": "b777aca3-8e6f-3ee6-b2b0-8dba6d719937",
                        "target_lang_word": "léthargie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "léthargie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0933cb9-8cce-30a4-9952-b98e2558125e",
                                        "entry_id": "2624d3d7-d723-3bdb-a09e-4c297f6c784e",
                                        "glosses": [
                                            "Sommeil profond et continu qui donne au malade une apparence d’insensibilité complète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a1c51c8-8d12-4df9-9989-56664d3c65e1",
                                                "sense_id": "e0933cb9-8cce-30a4-9952-b98e2558125e",
                                                "text": "Être, tomber en léthargie. — On le croyait mort, il n’était qu’en léthargie."
                                            },
                                            {
                                                "example_id": "ca7203b5-3a7a-4a87-998d-c0c8f2df266e",
                                                "sense_id": "e0933cb9-8cce-30a4-9952-b98e2558125e",
                                                "text": "Et ce médecin qui ne venait point, ce médecin des morts, comme le nommait madame Gabin ! Lui, verrait bien tout de suite que j’étais simplement en léthargie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5edd02b1-cf8d-31d4-903e-bf796b080cc6",
                                        "entry_id": "2624d3d7-d723-3bdb-a09e-4c297f6c784e",
                                        "glosses": [
                                            "Grande insensibilité, extrême nonchalance anormales et inquiétantes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61363e7c-0817-4484-84ce-4c8235eb6a23",
                                                "sense_id": "5edd02b1-cf8d-31d4-903e-bf796b080cc6",
                                                "text": "Depuis notre séparation, il ne pleurait plus, et même si j’en étais réduite à une léthargie de survie, c’est-à-dire à ne même pas rêver de reprendre notre lien comme on reprend un accroc, à l’intérieur de moi l’instinct s'inquiétait pour cette petite âme si peu armée pour la suite et qui manifestait, si jeune, des dispositions aussi bizarres."
                                            },
                                            {
                                                "example_id": "4fda1f06-de3e-477b-abd0-b35065804bd6",
                                                "sense_id": "5edd02b1-cf8d-31d4-903e-bf796b080cc6",
                                                "text": "Sortir d’une profonde léthargie. — Tirer quelqu’un de sa léthargie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e697286-9d79-3567-b272-acdbfd322701",
                                        "entry_id": "2624d3d7-d723-3bdb-a09e-4c297f6c784e",
                                        "glosses": [
                                            "Assoupissement ; torpeur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b30f5002-f4c5-4a70-b5e7-cfdf56210332",
                                                "sense_id": "5e697286-9d79-3567-b272-acdbfd322701",
                                                "text": "D’autre part, la crise très sérieuse que le Maroc traverse en ce moment, crise amenée précisément par les tendances réformatrices de Mouley Abd-El-Aziz, démontre à l’évidence que le Maghrib, plongé depuis des siècles dans une léthargie profonde, ne se relèvera jamais de ses propres forces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
