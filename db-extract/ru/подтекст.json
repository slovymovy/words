                        "cross_references": [
                            {
                                "target_word": "non-dit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5abc52e3-6ea8-376c-bf17-af5fd940268a",
                                        "entry_id": "123b049c-3f95-30f5-9f87-d35fa2be97ff",
                                        "glosses": [
                                            "Chose qui ne se dit pas, trop évidente ou taboue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd1267ae-d034-468a-8d16-157bfef06480",
                                                "sense_id": "5abc52e3-6ea8-376c-bf17-af5fd940268a",
                                                "text": "Il faut pourtant voir de quoi il s’agit : est-ce d’une absence de politique linguistique ou d’une stratégie de non-dit ?"
                                            },
                                            {
                                                "example_id": "d0c8d016-2a51-4ed3-8ac6-1ea9f9115562",
                                                "sense_id": "5abc52e3-6ea8-376c-bf17-af5fd940268a",
                                                "text": "Mais pour l'heure, tout le monde fait comme si le problème n'existait pas. Ce non-dit est dangereux."
                                            },
                                            {
                                                "example_id": "6926aac0-eaa5-47a7-a9a2-65fcecd1374a",
                                                "sense_id": "5abc52e3-6ea8-376c-bf17-af5fd940268a",
                                                "text": "Tout livre, pour trouver grâce à ses yeux, doit savoir préserver son lot de non-dits, de secrets, et faire confiance au lecteur. Tout dévoiler, c'est priver celui-ci de sa propre découverte."
                                            },
                                            {
                                                "example_id": "57d9eccf-f207-4013-9767-0834b33d01c3",
                                                "sense_id": "5abc52e3-6ea8-376c-bf17-af5fd940268a",
                                                "text": "Le corsetage un peu plat de la justesse figurative gagne un volume captivant en débouchant sur le non-dit, le non-peint, les insondables possibilités de rêver sur les choses qui s’échappent, les fascinantes vies qui ne sont pas finies."
                                            },
                                            {
                                                "example_id": "7f4fd14d-96c2-46fc-b02d-c36f618f1630",
                                                "sense_id": "5abc52e3-6ea8-376c-bf17-af5fd940268a",
                                                "text": "Il y avait un non-dit, un sous-texte invisible dans ce dialogue, se dit-elle..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
