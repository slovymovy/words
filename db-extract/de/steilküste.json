                "senses": [
                    {
                        "sense_id": "51847a50-2189-3e37-ab1c-5d482d78f5d2",
                        "entry_id": "269dcca3-7c9f-31f8-8a2f-fe907df38fce",
                        "glosses": [
                            "Küstenabschnitt, bei dem das Meer unvermittelt auf das steil in die Höhe ragende Festland trifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7445878d-84c5-4d60-95ca-26a3aa52bb19",
                                "sense_id": "51847a50-2189-3e37-ab1c-5d482d78f5d2",
                                "text": "Auf der Insel mit der markanten Steilküste befindet sich ein Leuchtturm."
                            },
                            {
                                "example_id": "329ac7f4-ef25-4a30-b279-2cfe5e45e0a0",
                                "sense_id": "51847a50-2189-3e37-ab1c-5d482d78f5d2",
                                "text": "„Das Vergessen, das wie eine Flutwelle von unbekannten Ausmaßen am Ende einer von hoher Steilküste umgebenen Bucht ansteigt, erfüllt ihn nicht einmal mit Schrecken.“"
                            },
                            {
                                "example_id": "a249987f-5811-4d43-8c47-c46b59f9ad87",
                                "sense_id": "51847a50-2189-3e37-ab1c-5d482d78f5d2",
                                "text": "„Staithes liegt in einer Felsspalte in der Steilküste verborgen, sodass Roger und ich die kleine Stadt erst sahen, als wir die steil abfallende Straße vom Kliff hinabfuhren.“"
                            },
                            {
                                "example_id": "bf25f279-245d-4473-aa99-34c25b13b050",
                                "sense_id": "51847a50-2189-3e37-ab1c-5d482d78f5d2",
                                "text": "„Die kurvenreiche Uferstraße, unterhalb der Steilküste, bot laufend wechselnde Ausblicke.“"
                            },
                            {
                                "example_id": "050db818-975f-4f6a-8a6e-c3929619d793",
                                "sense_id": "51847a50-2189-3e37-ab1c-5d482d78f5d2",
                                "text": "„Gegen 23 Uhr kamen die Siedler an der Steilküste an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
