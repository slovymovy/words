                        "tags": [
                            "naturwissenschaftlich"
                        ],
                        "examples": [
                            {
                                "example_id": "ba1c6698-abd6-47ef-920b-deafc6873abc",
                                "sense_id": "6ae9cf62-5f11-367e-9aa9-bc0ccbaf49ab",
                                "text": "„Es stellte sich heraus, daß fluorochromierte Chromosomen besonders deutlich und hell lumineszieren (Strugger, 1940b).“"
                            },
                            {
                                "example_id": "e001d9da-0b3e-4fb8-a808-6d6fe05e8c46",
                                "sense_id": "6ae9cf62-5f11-367e-9aa9-bc0ccbaf49ab",
                                "text": "Zinksulfat mit einer Spur Mangansulfat luminesziert rot, Schwefel strahlend weiß."
                            }
                        ],
