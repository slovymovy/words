                "senses": [
                    {
                        "sense_id": "09f158dd-9659-3c28-9ba6-99d2501056aa",
                        "entry_id": "9f1efc31-096c-366d-80a5-e4c9ff357ec7",
                        "glosses": [
                            "taki, który ma rzekomo moc odpędzania złych mocy, duchów, diabłów"
                        ],
