                "senses": [
                    {
                        "sense_id": "d4270ba4-65cd-340c-9332-f299c28cc383",
                        "entry_id": "144dbf63-88dd-3a6b-be2f-8aa4a4cb69f0",
                        "glosses": [
                            "To hit or place in the exact center."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63cc8ce7-aa45-4f81-b520-b329000da561",
                                "sense_id": "d4270ba4-65cd-340c-9332-f299c28cc383",
                                "text": "All four of you are assuming that I've dead-centered the target . I thought probably I was right, but since I couldn't find any Eich traces, I expected a lot of argument."
                            },
                            {
                                "example_id": "ccfe00b5-7b40-473b-b5b9-acde3e7dc215",
                                "sense_id": "d4270ba4-65cd-340c-9332-f299c28cc383",
                                "text": "At over a hundred knots, Archie slid the Hawk forward and dead-centered the basket with the probe on his first try."
                            },
                            {
                                "example_id": "d12d5552-34eb-4386-9cd8-4985d494ecd1",
                                "sense_id": "d4270ba4-65cd-340c-9332-f299c28cc383",
                                "text": "He had looked backward longer than he realized and neatly dead-centered the lone but firm sapling."
                            },
                            {
                                "example_id": "11887029-814f-4a53-8d23-787e16841c89",
                                "sense_id": "d4270ba4-65cd-340c-9332-f299c28cc383",
                                "text": "Sometimes I'd like to half-brain the old buzzard, but everything he has said so far has dead-centered the beam."
                            }
                        ]
                    }
