                "senses": [
                    {
                        "sense_id": "80cd01c4-fecd-376b-87ec-2985e6b29dda",
                        "entry_id": "bc7ccb5a-f957-36f4-87e9-b9a23bdb8a76",
                        "glosses": [
                            "S’interrompre soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "324c70db-991d-43e4-9d14-fd4b18bdb7d4",
                                "sense_id": "80cd01c4-fecd-376b-87ec-2985e6b29dda",
                                "text": "Il est pourtant contraint de s'auto-interrompre et c'est Ségolène Royal qui poursuit son tour."
                            },
                            {
                                "example_id": "91438e3a-bd70-47e1-a70f-d10ab8f417d6",
                                "sense_id": "80cd01c4-fecd-376b-87ec-2985e6b29dda",
                                "text": "Voilà c'est ça de s'auto-interrompre à tout bout de champ on ne sait même plus de quoi on parlait quelques secondes plus tôt."
                            },
                            {
                                "example_id": "d4f8a754-e93c-4982-8671-11f58fa19e0e",
                                "sense_id": "80cd01c4-fecd-376b-87ec-2985e6b29dda",
                                "text": "Car ils ont la capacité de s'auto-interrompre et de s'auto-déconcentrer à loisir : messagerie instantanée (MSN), email, SMS, téléphone…"
                            }
                        ]
                    }
