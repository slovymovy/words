                "senses": [
                    {
                        "sense_id": "81ba45b0-2d7e-3e77-b39b-d0cb629ee828",
                        "entry_id": "faf8db4a-4d0e-3526-8c3d-0d66c0c76784",
                        "glosses": [
                            "Dans les mines de charbon, faire tomber le charbon du trémis dans le chariot."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1f22f234-5a64-499d-be2e-f40180ca52e6",
                                "sense_id": "81ba45b0-2d7e-3e77-b39b-d0cb629ee828",
                                "text": "« Dams, te li monstrera un’miette pour robiner » […] Toute la journée je « robine » et je « charge ». Car si le charbon de Louis descend par le couloir, celui d’Olivier tombe directement dans le bouveau, et il faut le charger à l’escoupe (pelle). Travail de terrassier. En robinant, poussières, au point d’être obligé de cesser parfois, pour pouvoir distinguer son chariot."
                            }
                        ]
                    }
