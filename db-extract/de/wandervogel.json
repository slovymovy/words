                "senses": [
                    {
                        "sense_id": "b82ea250-ba56-3f46-8275-86eefe0d4ba7",
                        "entry_id": "da1ebcdf-bc1a-3188-b632-9f7a92ae415a",
                        "glosses": [
                            "Biologie, veraltet: Vogel, der die kalte Jahreszeit in warmen, meist südlichen Regionen verbringt, in die er im Herbst zieht"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ea986232-2087-3912-9437-6e90ec4d6209",
                        "entry_id": "da1ebcdf-bc1a-3188-b632-9f7a92ae415a",
                        "glosses": [
                            "Person, die gerne wandert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1917354a-5a15-4fa3-91bc-60e52e2a7645",
                                "sense_id": "ea986232-2087-3912-9437-6e90ec4d6209",
                                "text": "„Görsbachs \"Wandervögel\" treffen sich diesen Sonntag um 9.30 Uhr am örtlichen Sport- und Freizeitzentrum.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9a67472c-df7c-377d-b72b-6df8a14b09ff",
                        "entry_id": "da1ebcdf-bc1a-3188-b632-9f7a92ae415a",
                        "glosses": [
                            "ohne Plural: „1896 gegründeter, 1933 aufgelöster deutscher Jugendbund“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be29f383-b692-40b2-bc29-952ff9cc75ec",
                                "sense_id": "9a67472c-df7c-377d-b72b-6df8a14b09ff",
                                "text": "„In diesen Jahren vor dem Kriege lebte in der Romantik des Wandervogels die Begeisterung für eine neue, freie Zukunft, die dann in den Schützengräben noch eine Zeit lang loderte und 1917 im Grauen der Materialschlachten zusammenbrach.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "3aa74013-ea19-3dbe-995c-f4e24182d2d7",
                        "entry_id": "da1ebcdf-bc1a-3188-b632-9f7a92ae415a",
                        "glosses": [
                            "Person, die sich im Wandervogel [3] engagiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14912939-c449-4fc7-9106-c90de73459c6",
                                "sense_id": "3aa74013-ea19-3dbe-995c-f4e24182d2d7",
                                "text": "„Es werden Wandervögel sein, die an diesem silbern verhangenen Tag mit Lauten und Bändern ihre erste Wanderung machen.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
