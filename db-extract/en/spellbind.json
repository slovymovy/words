                    },
                    {
                        "translation_id": "8fda2215-f8c3-4be4-9365-3ac38f228bef",
                        "source_entry_id": "7b7c91d5-3c29-33c4-b7db-199d247b2af3",
                        "source_sense_id": "62f98652-6213-3edd-9f3b-20da272af777",
                        "target_lang_word": "蠱惑",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "蠱惑",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "c853dcab-0ab2-3bf0-ac32-2c2f6e0b79ea",
                                        "entry_id": "d1eb1cb1-efab-39b8-9b21-e2ca23f29fe0",
                                        "glosses": [
                                            "迷亂；惑亂。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492df302-4451-4d6d-b0e3-b4b69f4a6667",
                                                "sense_id": "c853dcab-0ab2-3bf0-ac32-2c2f6e0b79ea",
                                                "text": "漢·王符《潛夫論‧潛嘆》：“末世則不然，徒信貴人驕妒之議，獨用苟媚蠱惑之言。”"
                                            },
                                            {
                                                "example_id": "d3db642b-ebef-435e-b7d7-b5be1d8ce282",
                                                "sense_id": "c853dcab-0ab2-3bf0-ac32-2c2f6e0b79ea",
                                                "text": "唐·白居易《古冢狐》詩：“何況褒姒之色善蠱惑，能喪人家覆人國。”"
                                            },
                                            {
                                                "example_id": "cddf2b7a-c1fa-4c0b-af3d-d948a558b1fe",
                                                "sense_id": "c853dcab-0ab2-3bf0-ac32-2c2f6e0b79ea",
                                                "text": "《明史‧毛玉傳》：“玉即抗疏歷敘武宗時事，勸帝戒嗜欲，杜請託，以破僥倖之門，塞蠱惑之隙。”"
                                            },
                                            {
                                                "example_id": "ca783ad9-d6a1-40c1-914b-de6d8b397205",
                                                "sense_id": "c853dcab-0ab2-3bf0-ac32-2c2f6e0b79ea",
                                                "text": "章炳麟《駁康有為論革命書》：“尊稱聖人，自謂教主，而猶為是妄言，在己則脂韋突梯，以佞滿人已耳；而天下受其蠱惑者，乃較諸出于賤儒元惡之口為尤甚。”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb8a6797-080d-3f2c-94b4-bda309e4ad9d",
                                        "entry_id": "d1eb1cb1-efab-39b8-9b21-e2ca23f29fe0",
                                        "glosses": [
                                            "迷惑；誘惑。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b05b1e7a-c9ed-43c0-9345-5983c2c8f01f",
                                                "sense_id": "fb8a6797-080d-3f2c-94b4-bda309e4ad9d",
                                                "text": "南朝·梁·劉勰《滅惑論》：“糜費產業，蠱惑士女。運迍則蠍國，世平則蠹民。”"
                                            },
                                            {
                                                "example_id": "da1e0b88-bfe7-4b1e-88e8-cde2b815dee0",
                                                "sense_id": "fb8a6797-080d-3f2c-94b4-bda309e4ad9d",
                                                "text": "宋《燕翼詒謀錄》卷三：“上散青苗錢于設廳，而置酒肆于譙門；民持錢而出者，誘之使飲，十費其二三矣。又恐其不顧也，則命娼女坐肆作樂以蠱惑之。”"
                                            },
                                            {
                                                "example_id": "53b22568-e7a9-4bef-839c-701c38cf93e3",
                                                "sense_id": "fb8a6797-080d-3f2c-94b4-bda309e4ad9d",
                                                "text": "清·李漁《玉搔頭‧情試》：“只因這兩個小人在側，終朝蠱惑宸聰，以致如此。”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
