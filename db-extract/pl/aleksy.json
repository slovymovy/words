                "senses": [
                    {
                        "sense_id": "58f53fb1-140b-3b15-8797-12e1b87b8db8",
                        "entry_id": "bf047999-96d2-3dcf-9480-56107cc97aa6",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d57f99b0-b4a2-48cb-bf9a-1dcfc7679536",
                                "sense_id": "58f53fb1-140b-3b15-8797-12e1b87b8db8",
                                "text": "Aleksja to żeński odpowiednik imienia Aleksy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d2df556-a851-463c-a89b-8c1364afa22e",
                        "source_entry_id": "bf047999-96d2-3dcf-9480-56107cc97aa6",
                        "source_sense_id": "58f53fb1-140b-3b15-8797-12e1b87b8db8",
                        "target_lang_word": "Alexis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alexis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bc7cf37-a1fa-3c64-96a0-eb2922af9c05",
                                        "entry_id": "d052c8db-45b2-3cfa-97d1-e37127406134",
                                        "glosses": [
                                            "A male given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af61f29-90b4-4996-a331-fea1278becb1",
                                                "sense_id": "7bc7cf37-a1fa-3c64-96a0-eb2922af9c05",
                                                "text": "To the maid of his choice, / With a heart palpitating, / Comes Alexis the brave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0453c18-6869-3766-bd00-183f26ba5dc4",
                                        "entry_id": "d052c8db-45b2-3cfa-97d1-e37127406134",
                                        "glosses": [
                                            "A female given name from Ancient Greek, transferred from the male name and used since the 1940s."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4abe471-ebcb-4941-b6bc-a8361b3df7e9",
                                                "sense_id": "b0453c18-6869-3766-bd00-183f26ba5dc4",
                                                "text": "He wondered how parents who had named their daughter Alexis could possibly have known she'd turn out to be such a beauty."
                                            },
                                            {
                                                "example_id": "e425cef0-c90b-4f1d-9dfd-bec93f42cb24",
                                                "sense_id": "b0453c18-6869-3766-bd00-183f26ba5dc4",
                                                "text": "\"It's almost too realistic, too digital and computery,\" complains Alexis Vogel, a veteran celebrity makeup artist who recently worked on \"Stacked,\" a high-def show starring Pamela Anderson."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7cc85d5-0b27-46f9-93c7-531b6dbc977c",
                        "source_entry_id": "bf047999-96d2-3dcf-9480-56107cc97aa6",
                        "source_sense_id": "58f53fb1-140b-3b15-8797-12e1b87b8db8",
                        "target_lang_word": "Alexis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alexis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be2c337f-8272-3306-9a12-29a6e4de3133",
                                        "entry_id": "ed2ba000-24a8-3f6b-b6a0-81e693a27ee2",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e98b5838-1179-4be2-af49-8e49e7895166",
                                                "sense_id": "be2c337f-8272-3306-9a12-29a6e4de3133",
                                                "text": "— Le prince Alexis répéta M. Temple, un des affiliés qui se rassemblait chez votre maîtresse ?"
                                            },
                                            {
                                                "example_id": "31884ed2-f051-4386-9426-fba3cff57654",
                                                "sense_id": "be2c337f-8272-3306-9a12-29a6e4de3133",
                                                "text": "Quand éclata la masse, Alexis était debout sur la falaise, et, riant, montrait le bois qui se culbutait dans la rivière comme les glaces dans le bouscueil du printemps."
                                            },
                                            {
                                                "example_id": "588a9e8f-f7b4-4380-bfb5-dc4146c54648",
                                                "sense_id": "be2c337f-8272-3306-9a12-29a6e4de3133",
                                                "text": "Parmi les manques, celui des accompagnants d’élève en situation de handicap (AESH) pèse lourd. « Dans l’académie d’Amiens (dans la Somme), il manque 17 AESH à cette rentrée », rapporte Alexis Trochet, secrétaire général du Sgen-CFDT."
                                            },
                                            {
                                                "example_id": "bf6b03e0-f405-4062-93c7-b8d8e643f465",
                                                "sense_id": "be2c337f-8272-3306-9a12-29a6e4de3133",
                                                "text": "Signe que le nouveau centre d’excellence attire, plusieurs navigateurs se sont entraînés sous la houlette du Vendéen Étienne Saïz, l’ancien coach de Xavier Macaire. L’Allemand Jörg Riechers, la Vendéenne Charlotte Yven, l’Irlandais Kenneth Rumball, et des Rochelais : Alexis Thomas (26 ans, « Ma chance moi aussi », Robin Marais (35 ans, « Charente-Maritime ») et un petit nouveau, Romen Richard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f04dd1c5-a11a-470a-bff6-e0da8c7c086f",
                        "source_entry_id": "bf047999-96d2-3dcf-9480-56107cc97aa6",
                        "source_sense_id": "58f53fb1-140b-3b15-8797-12e1b87b8db8",
                        "target_lang_word": "Alexius",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alexius",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f4156b2-56b8-363a-b746-4be7f0df5585",
                                        "entry_id": "49eb0bed-6e4b-3157-a4bc-4f8755ac5b23",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29446ab4-1467-4441-96eb-36ecbafbb4e5",
                                                "sense_id": "7f4156b2-56b8-363a-b746-4be7f0df5585",
                                                "text": "Seit ihm vor vielen Jahren ein Kellner eine Terrine mit heißer Suppe in den Schoß hat fallen lassen, macht Alexius um Restaurants einen großen Bogen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54027301-3403-4313-91ad-6a353525c80f",
                        "source_entry_id": "bf047999-96d2-3dcf-9480-56107cc97aa6",
                        "source_sense_id": "58f53fb1-140b-3b15-8797-12e1b87b8db8",
                        "target_lang_word": "Алексий",
