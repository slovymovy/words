                        "source_entry_id": "9e822e05-e02e-3f6f-9dee-a83d07497fe3",
                        "source_sense_id": "f4e9f8cf-3d48-327b-b865-790ae3e1e37b",
                        "source_sense_description": "Land in Südamerika",
                        "target_lang_word": "Uruguay",
