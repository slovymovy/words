                    },
                    {
                        "sense_id": "c31b0f4a-7876-33cc-8920-ced2b0af7320",
                        "entry_id": "498317bf-3145-3d18-9d4d-f14091d49ac7",
                        "glosses": [
                            "odchylane części wejściowe dużego namiotu"
