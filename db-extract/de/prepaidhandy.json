                "senses": [
                    {
                        "sense_id": "2960a57d-6e70-3424-aff6-98dce250b8d4",
                        "entry_id": "5ba4e5b4-b8b3-33ca-acfa-d89b9a0659c4",
                        "glosses": [
                            "Mobiltelefon, das mit einer Guthabenkarte betrieben wird"
                        ],
                        "tags": [
                            "Telekommunikation"
                        ],
                        "examples": [
                            {
                                "example_id": "c7a701d3-e5c1-4e81-9a17-6c6b999590f6",
                                "sense_id": "2960a57d-6e70-3424-aff6-98dce250b8d4",
                                "text": "Karl hat seiner Schwester ein Prepaidhandy zum Geburtstag geschenkt."
                            },
                            {
                                "example_id": "206417ea-c67d-4890-923a-26278ae3e307",
                                "sense_id": "2960a57d-6e70-3424-aff6-98dce250b8d4",
                                "text": "„Die SIM-Karte Ihres Handys gegen einen chilenischen Prepaidchip auszutauschen ist möglich und ähnlich preiswert wie sich vor Ort ein Prepaidhandy mit Gesprächsguthaben zu kaufen.“"
                            },
                            {
                                "example_id": "eff12ae8-1c82-4fd5-8efb-75eadb48decf",
                                "sense_id": "2960a57d-6e70-3424-aff6-98dce250b8d4",
                                "text": "„Im Kampf gegen den Terror legt die Bundesregierung nach: Prepaidhandys können nur noch mit Ausweis gekauft werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
