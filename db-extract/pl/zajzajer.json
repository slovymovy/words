                    },
                    {
                        "sense_id": "674abcbf-7d04-3364-ab54-3e30528928dd",
                        "entry_id": "d61d76de-2fe6-3e93-8d91-aa6595315f2e",
                        "glosses": [
                            "tanie, kiepskie wino owocowe"
                        ],
                        "tags": [
