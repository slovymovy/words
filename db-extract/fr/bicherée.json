                        ],
                        "examples": [
                            {
                                "example_id": "7dfa3b95-d88a-4da2-94c7-8996ade3cc3a",
                                "sense_id": "1f41e331-f92e-346d-80d7-5278f70e1cf9",
                                "text": "BICHERÉE. Mesure agraire anciennement usitée à Lyon. La bicherée de terre valait 3 hommées de vignes = 196 toises carrées = 11025 pieds carrés de Lyon = 12256.38 pieds carrés de Paris = 12.933 ares = 1546.83 yards carrés."
                            },
                            {
                                "example_id": "50edd84c-a4c4-43d9-91c8-93f4afca05d1",
                                "sense_id": "1f41e331-f92e-346d-80d7-5278f70e1cf9",
                                "text": "Il serait nécessaire de fixer la contenue du clos à quatre ou six bicherées de terre."
                            }
