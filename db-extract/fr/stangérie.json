                        "sense_id": "3bb0b76e-63f6-32f4-a221-61fd7326cd21",
                        "entry_id": "dc7c0b2a-2482-3a70-9676-98182ac10ed8",
                        "glosses": [
                            "Genre de préphanérogames de l’ordre des cycadales poussant en Afrique du Sud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1323395a-f1d2-4acb-b2c9-524d4317fe7f",
                                "sense_id": "3bb0b76e-63f6-32f4-a221-61fd7326cd21",
                                "text": "Genre de végétaux de la famille des cycadées, dont l’espèce-type croît à Port-Natal [aujourd’hui Durban] : La STANGÉRIE paradoxale."
                            },
                            {
                                "example_id": "e06dd4f5-84f3-4b14-b701-7abcb6efdc90",
                                "sense_id": "3bb0b76e-63f6-32f4-a221-61fd7326cd21",
                                "text": "STANGÉRIE (jé ri — de Stanger, n. angl.) n. f. Bot. Genre de cycadacées, comprenant plusieurs espèces de l’Afrique du Sud. (On cultive fréquemment dans les serres la stangérie paradoxale.)"
                            },
                            {
                                "example_id": "6eed1b30-0995-4945-9e08-4a00cc7330ea",
                                "sense_id": "3bb0b76e-63f6-32f4-a221-61fd7326cd21",
                                "text": "La feuille a aussi de pareils canaux dans l’écorce de son pétiole ; ils se prolongent quelquefois dans le limbe des folioles, soit sur le méristèle (Dion), soit à la fois au-dessus et au-dessous (Stangérie), soit latéralement entre les méristèles (Encéphalarie) : le plus souvent les folioles en sont dépourvues."
                            }
                        ]
                    }
