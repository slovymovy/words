                                    {
                                        "sense_id": "0ce1855c-159b-32d2-9eda-b717a122d799",
                                        "entry_id": "b586d569-5f9b-3fdf-ba97-34eb3f9dda29",
                                        "glosses": [
                                            "Action de façonner les pensées ou le comportement d’une personne ou d’un groupe de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
