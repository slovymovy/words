                        "coûter une fortune",
                        "petite fortune"
                    ]
                },
                {
                    "sense_id": "21552020-8b73-34d9-adee-03a5462e18d4",
                    "sense_definition": "Hasard ou sort qui détermine le cours des événements de façon heureuse ou malheureuse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "destin",
                    "name_type": "no",
                    "examples": [
