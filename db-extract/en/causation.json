                    },
                    {
                        "sense_id": "610668e8-c189-3142-a605-f942dd2aff72",
                        "entry_id": "ec03711c-db96-31b5-807c-897e18b9d501",
                        "glosses": [
                            "The act or agency by which an effect is produced."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "028ebb39-f662-4921-8f1b-7ee8ae7d37bb",
                                "sense_id": "610668e8-c189-3142-a605-f942dd2aff72",
                                "text": "Aristotle's views led him to try to describe the kind of causation by which vision is produced, instead of the laws by which it is exercised; and the attempt consisted, as in other subjects, of indistinct principles, and ill-combined facts."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e65beda-b8fd-3c4d-b3ed-3b7afab18014",
                        "entry_id": "ec03711c-db96-31b5-807c-897e18b9d501",
                        "glosses": [
                            "Cause and effect, considered as a system."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9986a745-b2dd-40a8-a656-a341c6f4def4",
