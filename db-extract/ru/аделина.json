                                "target_senses": [
                                    {
                                        "sense_id": "e989f3cb-cdbf-3ddb-bf1d-59e49890f7ab",
                                        "entry_id": "5e53e0ca-21c8-31a1-b2b1-485242333280",
                                        "glosses": [
                                            "Prénom féminin français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5cc2606-6f15-4f98-b261-f5004dc3c850",
                                                "sense_id": "e989f3cb-cdbf-3ddb-bf1d-59e49890f7ab",
                                                "text": "Aline, sa mère, me sort du « brigadier » long comme le bras."
                                            },
                                            {
                                                "example_id": "96687938-3a71-4566-bf5d-06e7f3c560ba",
                                                "sense_id": "e989f3cb-cdbf-3ddb-bf1d-59e49890f7ab",
                                                "text": "Et j'ai crié, crié\n Aline\n pour qu'elle revienne\n et j'ai pleuré, pleuré\n oh j'avais trop de peine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
