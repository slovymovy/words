                    {
                        "sense_id": "0dcd2d0c-4177-3805-8922-4f84b86a25cf",
                        "entry_id": "4f41e128-f071-385c-9637-1165dcadbebb",
                        "glosses": [
                            "tylny odcinek ciała stawonogów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09a813ab-4d1f-4b39-95b7-dd9ab7e0668d",
                                "sense_id": "0dcd2d0c-4177-3805-8922-4f84b86a25cf",
                                "text": "Osę łatwo poznać po żółto-czarnych pasach na tułowiu i odwłoku."
                            },
                            {
                                "example_id": "178b5ff2-339d-49c2-93d5-f10abd8f3151",
                                "sense_id": "0dcd2d0c-4177-3805-8922-4f84b86a25cf",
                                "text": "Granica pomiędzy głowotułowiem a odwłokiem jest niewyraźna, co nadaje ciału owalny kształt."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
