                        "target_lang_word": "out of touch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "out of touch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce8691e2-ddda-3e50-abf4-67f5d60c52e7",
                                        "entry_id": "aebc4fac-2f14-30b4-bb6f-bc4130a0a672",
                                        "glosses": [
                                            "No longer maintaining contact or communications."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0e00394-a780-4b3b-b9d6-54890e210b95",
                                                "sense_id": "ce8691e2-ddda-3e50-abf4-67f5d60c52e7",
                                                "text": "I had been out of touch with my old friend for a long time when she called."
                                            },
                                            {
                                                "example_id": "959ad7dc-40cc-4fd1-9ec2-c8091c038e1a",
                                                "sense_id": "ce8691e2-ddda-3e50-abf4-67f5d60c52e7",
                                                "text": "I don't feel a single thing / Have the pills done too much / Haven't caught up with my friends in weeks / And now we're outta touch"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2a43d88-65e7-329f-81ba-aec22bb35df9",
                                        "entry_id": "aebc4fac-2f14-30b4-bb6f-bc4130a0a672",
                                        "glosses": [
                                            "No longer conversant with something, especially facts, reality, or the world; not aware or realistic."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "999b3357-c713-4fec-90e4-ed1fe13bc08c",
                                                "sense_id": "c2a43d88-65e7-329f-81ba-aec22bb35df9",
                                                "text": "Did his answer strike you as out of touch with reality?"
                                            },
                                            {
                                                "example_id": "824b2fbe-cf54-4a14-99ad-581cba243ab9",
                                                "sense_id": "c2a43d88-65e7-329f-81ba-aec22bb35df9",
                                                "text": "Bought a ticket for a runaway train / Like a madman laughing at the rain / A little out of touch, a little insane"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "997bf7a1-0281-35cd-9a25-9af058f5a725",
                                        "entry_id": "aebc4fac-2f14-30b4-bb6f-bc4130a0a672",
                                        "glosses": [
                                            "Disconnected or insulated from the everyday experiences and concerns of ordinary people."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f3f63a1-21e8-4dc7-b279-053228d19e97",
                                                "sense_id": "997bf7a1-0281-35cd-9a25-9af058f5a725",
                                                "text": "They're so out of touch that all they can do all day is compare yacht sizes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
