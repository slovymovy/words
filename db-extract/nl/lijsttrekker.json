                    {
                        "sense_id": "c8196074-8faa-340d-9a21-23bd5ee08a36",
                        "entry_id": "0d5d9366-332b-3e91-8175-b092d90a5187",
                        "glosses": [
                            "iemand op de eerste plaats staat van de kandidatenlijst van een partij in een verkiezing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc1f6092-e493-4300-8d6d-fcc761d68acd",
                                "sense_id": "c8196074-8faa-340d-9a21-23bd5ee08a36",
                                "text": "De lijsttrekker van een partij is gewoonlijk ook de nieuwe fractievoorzitter."
                            },
                            {
                                "example_id": "403d757f-5519-471b-8f25-46693642eeac",
                                "sense_id": "c8196074-8faa-340d-9a21-23bd5ee08a36",
                                "text": "Met Terlouw als lijsttrekker herstelde D66 zich en ging de partij in 1977 van zes naar acht zetels. In een tijd van onverzoenlijke tegenstellingen tussen links en rechts voerde ideale schoonzoon Terlouw met succes campagne."
                            }
                        ]
                    }
                ],
