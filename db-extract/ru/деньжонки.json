                "senses": [
                    {
                        "sense_id": "24c6212d-3b58-369f-ae8a-c812c1ae3a7d",
                        "entry_id": "5ae544fd-8d49-37a8-bb32-14dd214857a0",
                        "glosses": [
                            "уничиж. деньги"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeaa2de9-c41d-4ffb-bcc0-d1376dfd127d",
                                "sense_id": "24c6212d-3b58-369f-ae8a-c812c1ae3a7d",
                                "text": "Ты богат, а я беден: пособи мне деньжонками, чтобы я мог позвать ворожею〈…〉"
                            },
                            {
                                "example_id": "9f3ab72e-95bc-47e2-be39-5bc427156a6c",
                                "sense_id": "24c6212d-3b58-369f-ae8a-c812c1ae3a7d",
                                "text": "Народ ехал в этом счастливом эшелоне богатый, с имуществом и деньжонками."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55935942-599d-4b06-9659-cc2a7b689da2",
                        "source_entry_id": "5ae544fd-8d49-37a8-bb32-14dd214857a0",
                        "source_sense_id": "24c6212d-3b58-369f-ae8a-c812c1ae3a7d",
                        "target_lang_word": "money",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "money",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ff97bcd-e432-3e02-8caa-ddb857c8c828",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
                                            "A generally accepted means of exchange."
                                        ],
                                        "tags": [
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "850bc283-ef77-4610-9ff5-10633698a3f7",
                                                "sense_id": "0ff97bcd-e432-3e02-8caa-ddb857c8c828",
                                                "text": "I cannot take money that I did not work for."
                                            },
                                            {
                                                "example_id": "4d17fda8-b17c-4bba-a9b0-4cf82873b6da",
                                                "sense_id": "0ff97bcd-e432-3e02-8caa-ddb857c8c828",
                                                "text": "Before colonial times cowry shells imported from Mauritius were used as money in Western Africa."
                                            },
                                            {
                                                "example_id": "58545015-35cc-4da3-9499-5cb5afebb39a",
                                                "sense_id": "0ff97bcd-e432-3e02-8caa-ddb857c8c828",
                                                "text": "She used to spend money every day on makeup."
                                            },
                                            {
                                                "example_id": "6248d875-a7e4-4f9f-959f-c0e62667ef8a",
                                                "sense_id": "0ff97bcd-e432-3e02-8caa-ddb857c8c828",
                                                "text": "Then there came a reg'lar terror of a sou'wester same as you don't get one summer in a thousand, and blowed the shanty flat and ripped about half of the weir poles out of the sand. We spent consider'ble money getting 'em reset, and then a swordfish got into the pound and tore the nets all to slathers, right in the middle of the squiteague season."
                                            },
                                            {
                                                "example_id": "a72907e5-f312-4d14-a4fb-ba3672ae4f8a",
                                                "sense_id": "0ff97bcd-e432-3e02-8caa-ddb857c8c828",
                                                "text": "At the same time, it is pouring money into cleaning up the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea86fb1e-30cf-313b-84cd-05eee61718e5",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
                                            "A currency maintained by a state or other entity which can guarantee its value (such as a monetary union)."
                                        ],
                                        "tags": [
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52152269-6b74-4d08-b2e1-37b062adb1d0",
                                                "sense_id": "ea86fb1e-30cf-313b-84cd-05eee61718e5",
                                                "text": "money supply; money market"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f943cbc-1db6-3edf-bc86-43b96fe56b61",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
                                            "Hard cash in the form of banknotes and coins, as opposed to cheques/checks, credit cards, or credit more generally."
                                        ],
                                        "tags": [
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a5dfd41-7f8c-3a05-b1e9-812e0d09b771",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
                                            "The total value of liquid assets available for an individual or other economic unit, such as cash and bank deposits."
                                        ],
                                        "tags": [
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "434223f5-ec86-3daf-955d-7e1c19bffe4c",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
                                            "Wealth."
                                        ],
                                        "tags": [
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "591b5c74-8a27-41a2-a1dd-6a2c7a11350a",
                                                "sense_id": "434223f5-ec86-3daf-955d-7e1c19bffe4c",
                                                "text": "He was born with money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e244a68-96ec-36e2-a162-5ef6c28a2b80",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
                                            "A person, family or class that possesses wealth."
                                        ],
                                        "tags": [
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faa7f122-28ed-4e13-a987-15de5365a330",
                                                "sense_id": "0e244a68-96ec-36e2-a162-5ef6c28a2b80",
                                                "text": "He married money."
                                            },
                                            {
                                                "example_id": "20accec8-5110-4441-90e2-41075c3af62e",
                                                "sense_id": "0e244a68-96ec-36e2-a162-5ef6c28a2b80",
                                                "text": "He was born into money."
                                            },
                                            {
                                                "example_id": "e3c93962-66cd-45db-b38c-af71c83cb79f",
                                                "sense_id": "0e244a68-96ec-36e2-a162-5ef6c28a2b80",
                                                "text": "I grew up in Ballybeg, neither of my working-class parents came from money or went to university, so I was part of a working-class family, I assumed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "164bf40a-eecc-3ab1-a3f2-2feffa890926",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
                                            "An item of value between two or more parties used for the exchange of goods or services."
                                        ],
                                        "tags": [
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4849fdb6-9cbf-3004-b484-d88362ec8d73",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
                                            "A person who funds an operation."
                                        ],
                                        "tags": [
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "money",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d497beee-5882-3f48-a8e3-e02df1264676",
                                        "entry_id": "a2fd5c68-c59e-3d1b-b5fd-23bcc4db8265",
                                        "glosses": [
                                            "Cool; excellent."
                                        ],
                                        "tags": [
                                            "US",
                                            "plural",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28369dca-87a1-43d5-87c4-633937f6463a",
                                                "sense_id": "d497beee-5882-3f48-a8e3-e02df1264676",
                                                "text": "But Schilling was great again today. As my younger son would no doubt say, he's so money he doesn't know he's money. Two more like him and never mind the World Series; the Red Sox would be ready for the Super Bowl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b6734a4-2cb0-4e53-b237-4d29434368e2",
                        "source_entry_id": "5ae544fd-8d49-37a8-bb32-14dd214857a0",
                        "source_sense_id": "24c6212d-3b58-369f-ae8a-c812c1ae3a7d",
                        "target_lang_word": "cash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf509c89-d5ef-30ff-a102-ef2cde2835b1",
                                        "entry_id": "c22bfa5b-0241-3ecb-b356-835909005b17",
                                        "glosses": [
                                            "Money in the form of notes or bills and coins, as opposed to checks, credit or electronic transactions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53ce9bd5-7cc7-4cfe-9c87-f31704424d5d",
                                                "sense_id": "bf509c89-d5ef-30ff-a102-ef2cde2835b1",
                                                "text": "After you bounced those checks last time, they want to be paid in cash."
                                            },
                                            {
                                                "example_id": "2b485162-fc5e-4cb5-acb9-1ba7f9ff1f82",
                                                "sense_id": "bf509c89-d5ef-30ff-a102-ef2cde2835b1",
                                                "text": "When a man bargains for the price of maintaining such or such principles, or of endeavouring to make out such or such a case, without believing in the soundness of the principles or the truth of the case; such a man, whether he touch the cash (or paper-money) before or after the performance of his work, and whether he work with his tongue or his pen, may, I think be fairly charged with seeking after \"base lucre;\" […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c884e8ec-3e3e-3946-998a-7c19d88a22ca",
                                        "entry_id": "c22bfa5b-0241-3ecb-b356-835909005b17",
                                        "glosses": [
                                            "Liquid assets, money that can be traded quickly, as distinct from assets that are invested and cannot be easily exchanged."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ab7437c-0ca8-47e3-a020-b2e47183c20d",
                                                "sense_id": "c884e8ec-3e3e-3946-998a-7c19d88a22ca",
                                                "text": "Cash offers a return of virtually zero in many developed countries […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6927e4b-b599-30f5-91f7-93cfd4b7cd24",
                                        "entry_id": "c22bfa5b-0241-3ecb-b356-835909005b17",
                                        "glosses": [
                                            "Money."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc9b6a96-8112-4e3d-bcb7-ec483293ff20",
                                                "sense_id": "d6927e4b-b599-30f5-91f7-93cfd4b7cd24",
                                                "text": "Paying yourself first also implies that you have some understanding of your cash flow, which means that, yes, you must set a budget."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b5b4d82-e342-31d1-bfed-10d040417f8f",
                                        "entry_id": "c22bfa5b-0241-3ecb-b356-835909005b17",
                                        "glosses": [
                                            "Cash register, or the counter in a business where the cash register is located."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f4a8a7e-b580-4025-aa84-b86894a4f4b3",
                                                "sense_id": "6b5b4d82-e342-31d1-bfed-10d040417f8f",
                                                "text": "Let me just bring these to the cash for you."
                                            },
                                            {
                                                "example_id": "29e62b0b-eddd-47cd-9d24-925e8787fd3b",
                                                "sense_id": "6b5b4d82-e342-31d1-bfed-10d040417f8f",
                                                "text": "Visit Apple’s jam-packed stores and you won’t see lines at the cash — because every sales clerk is also your cashier, using cellphone card-readers to zip you through."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9497c02-ca1a-341d-948a-6c9cd5a9e54f",
                                        "entry_id": "c22bfa5b-0241-3ecb-b356-835909005b17",
                                        "glosses": [
                                            "An instance of winning a cash prize."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a33b0255-0612-4e4c-9120-5f57090e261c",
                                                "sense_id": "a9497c02-ca1a-341d-948a-6c9cd5a9e54f",
                                                "text": "In the WSOP, I have played around 150 tournaments with one final table, 11 cashes, and a -70 percent ROI."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0673e726-99bd-3dc6-a5f0-90bd2fd7d422",
                                        "entry_id": "c22bfa5b-0241-3ecb-b356-835909005b17",
                                        "glosses": [
                                            "A place where money is kept, or where it is deposited and paid out; a money box."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c0e6255-2827-4dfc-8512-d4019284db74",
                                                "sense_id": "0673e726-99bd-3dc6-a5f0-90bd2fd7d422",
                                                "text": "This bank[…] is properly a general cash, where every man lodges his money,"
                                            },
                                            {
                                                "example_id": "51517ee8-9fe5-4147-b9f5-5c84845a0f2c",
                                                "sense_id": "0673e726-99bd-3dc6-a5f0-90bd2fd7d422",
                                                "text": "She was said to have amassed a great sum of money for ill use ; 20,000l. are known to be in her cash ;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80bd0778-4b5f-3845-abac-96eb94497ab7",
                                        "entry_id": "9dd6aca3-f1f4-3c1e-b553-2c627ef8097d",
                                        "glosses": [
                                            "To exchange (a check/cheque) for money in the form of notes/bills."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97096190-c2ca-48fe-9cd6-d749af154c28",
                                                "sense_id": "80bd0778-4b5f-3845-abac-96eb94497ab7",
                                                "text": "My single \"Lick and Move\" had made it to number four on the Top Ten charts, and I had gotten a nice check from Ruthless Rap. I cashed that shit and took Muddah shopping in Midtown and told her to get any damn thing she wanted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5f6af4a-9c35-3673-9d84-d6868c7d108c",
                                        "entry_id": "9dd6aca3-f1f4-3c1e-b553-2c627ef8097d",
