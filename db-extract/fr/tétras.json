                                            {
                                                "example_id": "6e7840a7-c5fa-41d4-aed5-23336e5a6913",
                                                "sense_id": "34fe6f66-8c4c-3aaf-95b7-dfe4d5f58046",
                                                "text": "„Du bist dümmer als dieser ausgestopfte Birkhahn.“"
                                            }
