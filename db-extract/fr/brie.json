                    {
                        "sense_id": "4f802c48-10c7-3d6a-902b-cc7f5587fb8f",
                        "entry_id": "546faf3f-73a4-3933-b6f2-aaee97f505e2",
                        "glosses": [
                            "Région naturelle française située à l’est de Paris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05792580-6789-429c-b32e-34355773ef02",
                                "sense_id": "4f802c48-10c7-3d6a-902b-cc7f5587fb8f",
                                "text": "Les fêtes de roses qui se multipliaient, surtout autour de Paris, à Brie-Comte-Robert ou Grisy-Suisnes, en Brie, à Fontenay-aux-Roses, et ailleurs, étaient plus proches de la kermesse que de la mondanité."
                            }
                        ]
                    }
                ],
