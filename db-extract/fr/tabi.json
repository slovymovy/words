                "senses": [
                    {
                        "sense_id": "670390c6-071c-333c-82e4-9d07ff77dd21",
                        "entry_id": "7ebf12fe-3f5a-30fa-b82e-31fa3fc9f0cb",
                        "glosses": [
                            "Chaussette japonaise. Elles séparent le gros orteil des autres orteils pour porter des tongs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61d65a84-94cb-4bdd-9209-22689f9f58eb",
                                "sense_id": "670390c6-071c-333c-82e4-9d07ff77dd21",
                                "text": "Elle se lève du sofa où elle abandonne momentanément l'ouvrage et glisse ses pieds aux ongles rétractiles dans ses tabi [sic] de soie bleue."
                            },
                            {
                                "example_id": "fa18c5db-d048-43e3-9999-b1d9d9f088e5",
                                "sense_id": "670390c6-071c-333c-82e4-9d07ff77dd21",
                                "text": "Il dut enlever ses chaussures et enfiler des tabis, ces chaussettes à pouce détaché, blanches pour les hommes et bleues pour les femmes."
                            },
                            {
                                "example_id": "08878811-c3ba-4be7-8021-881a1f0ccfe2",
                                "sense_id": "670390c6-071c-333c-82e4-9d07ff77dd21",
                                "text": "Le tabi est un brodequin d’étoffe blanche dans lequel l’orteil est séparé des autres doigts, pour laisser passer les attaches des sandales de paille ou des guétas de bois."
                            }
                        ]
                    }
                ],
