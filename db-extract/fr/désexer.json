                "senses": [
                    {
                        "sense_id": "5d6eeba8-9251-3e36-bfd7-6a9378a89727",
                        "entry_id": "de780836-8a1b-36d5-8c29-f00cc95fd22c",
                        "glosses": [
                            "Faire perdre à (quelqu’un) son caractère d’appartenance à un certain sexe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bc5a921-f3eb-4cc4-bc8f-2a16ec7bbf4c",
                                "sense_id": "5d6eeba8-9251-3e36-bfd7-6a9378a89727",
                                "text": "M. Richepin s’est contenté de désexer, comme dit lady Macbeth, le principal personnage."
                            },
                            {
                                "example_id": "1c55ceb6-caea-4672-9579-d8b421833912",
                                "sense_id": "5d6eeba8-9251-3e36-bfd7-6a9378a89727",
                                "text": "Il y avait eu, il y a quelque quinze ans, un scandale causé par de beaux jeunes gens de nobles maisons qui faisaient aux femmes cette suprême injure de s’habiller comme elles, de singer leurs allures, de se « désexer », — comme le fait dire énergiquement Shakespeare à Lady Macbeth."
                            },
                            {
                                "example_id": "5d378e76-83b8-4226-b161-34044ddeafed",
                                "sense_id": "5d6eeba8-9251-3e36-bfd7-6a9378a89727",
                                "text": "Il n’est pas besoin, comme on paraît le croire, de faire scandale, de mettre son portrait en frontispice, de fumer, de se désexer, ou même de se déclasser en aucune façon pour faire un bon roman."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab63b7e3-313e-3f1b-8bd4-9d9ca58e3d9c",
                        "entry_id": "de780836-8a1b-36d5-8c29-f00cc95fd22c",
                        "glosses": [
                            "Stériliser (un animal)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc939504-6475-4ce3-b13c-07dd42c2c80a",
                                "sense_id": "ab63b7e3-313e-3f1b-8bd4-9d9ca58e3d9c",
                                "text": "La PeTA propose de \"désexer\" les animaux de compagnie, c'est à dire de les stériliser, pour éviter que des chiots se retrouvent abandonnés et donc condamnés à mort."
                            }
                        ]
                    }
                ],
