{
    "word_family": [
        "re-revenue"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e07a826-5dcf-3ebe-9aa7-bc8476d9a9d2",
                    "sense_definition": "The total amount of money received by a company from its sales of goods or services.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "business income",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported a significant increase in annual <w>revenue</w> after launching the new product.",
                            "target_lang_translations": {
                                "ru": "Компания сообщила о значительном росте годовой <w>выручки</w> после запуска нового продукта.",
                                "zh": "公司在推出新产品后，年度<w>营业额</w>显著增长。"
                            }
                        },
                        {
                            "text": "Most of our total <w>revenue</w> comes from online subscriptions rather than physical sales.",
                            "target_lang_translations": {
                                "ru": "Большая часть нашей общей <w>выручки</w> поступает от онлайн-подписок, а не от физических продаж.",
                                "zh": "我们大部分的总<w>收入</w>来自在线订阅，而非实体销售。"
                            }
                        }
                    ],
                    "synonyms": [
                        "turnover"
                    ],
                    "common_phrases": [
                        "total revenue",
                        "annual revenue",
                        "generate revenue"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общая сумма денег, полученная компанией от продажи товаров или услуг.",
                        "zh": "公司通过销售商品或服务所获得的全部资金。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выручка",
                                "target_lang_sense_clarification": "деньги от продаж"
                            },
                            {
                                "target_lang_word": "доход",
                                "target_lang_sense_clarification": "общая сумма поступлений"
                            },
                            {
                                "target_lang_word": "оборот",
                                "target_lang_sense_clarification": "товарооборот"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "营业额",
                                "target_lang_sense_clarification": "公司销售总额"
                            },
                            {
                                "target_lang_word": "收入",
                                "target_lang_sense_clarification": "总收入"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88c87768-530c-3ea1-9eb5-6534047890d4",
                    "sense_definition": "The total income received by a government from taxes and other sources to pay for public spending.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "public finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is looking for new ways to increase tax <w>revenue</w> to fund the healthcare system.",
                            "target_lang_translations": {
                                "ru": "Правительство ищет новые способы увеличения налоговых <w>поступлений</w> для финансирования системы здравоохранения.",
                                "zh": "政府正在寻找增加<w>税收</w>的新途径，以资助医疗系统。"
                            }
                        },
                        {
                            "text": "A drop in government <w>revenue</w> could lead to cuts in public services next year.",
                            "target_lang_translations": {
                                "ru": "Снижение государственных <w>доходов</w> может привести к сокращению государственных услуг в следующем году.",
                                "zh": "政府<w>财政收入</w>的下降可能导致明年公共服务的削减。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tax revenue",
                        "government revenue",
                        "public revenue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общий доход государства от налогов и других источников для финансирования государственных расходов.",
                        "zh": "政府通过税收及其他来源获得的用于支付公共开支的总收入。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "государственные доходы",
                                "target_lang_sense_clarification": "бюджетные поступления"
                            },
                            {
                                "target_lang_word": "налоговые поступления",
                                "target_lang_sense_clarification": "деньги от налогов"
                            },
                            {
                                "target_lang_word": "доход",
                                "target_lang_sense_clarification": "в контексте бюджета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "财政收入",
                                "target_lang_sense_clarification": "政府收入"
                            },
                            {
                                "target_lang_word": "税收",
                                "target_lang_sense_clarification": "税收收入"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f87020ce-7f32-31e7-a1ba-2893116deeb4",
                    "sense_definition": "The income from normal business operations after deducting returns and discounts.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "business income",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The financial report highlights the net <w>revenue</w> after accounting for all customer returns.",
                            "target_lang_translations": {
                                "ru": "В финансовом отчете выделена чистая <w>выручка</w> после учета всех возвратов от клиентов.",
                                "zh": "财务报告强调了在计入所有客户退货后的<w>净收入</w>。"
                            }
                        },
                        {
                            "text": "Investors often look at net <w>revenue</w> to understand the true health of a retail business.",
                            "target_lang_translations": {
                                "ru": "Инвесторы часто смотрят на чистую <w>выручку</w>, чтобы понять истинное состояние розничного бизнеса.",
                                "zh": "投资者通常通过查看<w>净收入</w>来了解零售企业的真实经营状况。"
                            }
                        }
                    ],
                    "synonyms": [
                        "net sales"
                    ],
                    "common_phrases": [
                        "net revenue"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "accounting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доход от обычной деятельности предприятия после вычета возвратов и скидок.",
                        "zh": "企业在扣除退货和折扣后的正常经营所得。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистая выручка",
                                "target_lang_sense_clarification": "за вычетом возвратов"
                            },
                            {
                                "target_lang_word": "чистый доход",
                                "target_lang_sense_clarification": "бухгалтерский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "净收入",
                                "target_lang_sense_clarification": "扣除后的收入"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae50c025-7ee6-3cb3-b42d-c69984affa77",
                    "sense_definition": "The profit or income yielded by an investment or property.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "investment income",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rental property provides a steady <w>revenue</w> stream for the retired couple.",
                            "target_lang_translations": {
                                "ru": "Арендная недвижимость обеспечивает стабильный поток <w>дохода</w> для пожилой пары.",
                                "zh": "这处出租房产为这对退休夫妇提供了稳定的<w>收益</w>来源。"
                            }
                        },
                        {
                            "text": "The phone votes brought in more than five million pounds in <w>revenue</w> for the show.",
                            "target_lang_translations": {
                                "ru": "Телефонное голосование принесло шоу более пяти миллионов фунтов <w>дохода</w>.",
                                "zh": "电话投票为该节目带来了超过五百万英镑的<w>收入</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "revenue stream",
                        "investment revenue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прибыль или доход, приносимый инвестициями или собственностью.",
                        "zh": "投资或财产所产生的利润或收益。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доход",
                                "target_lang_sense_clarification": "от инвестиций или аренды"
                            },
                            {
                                "target_lang_word": "поступления",
                                "target_lang_sense_clarification": "денежные средства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收益",
                                "target_lang_sense_clarification": "投资回报"
                            },
                            {
                                "target_lang_word": "收入",
                                "target_lang_sense_clarification": "财产所得"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd9e63ee-54ee-35eb-b06d-7d6c09184643",
                    "sense_definition": "A return or something paid back, often used in a figurative or spiritual sense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "return",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet spoke of a <w>revenue</w> of praise offered to the creator.",
                            "target_lang_translations": {
                                "ru": "Поэт говорил о <w>дани</w> хвалы, возносимой творцу.",
                                "zh": "诗人谈到了献给造物主的赞美<w>回报</w>。"
                            }
                        },
                        {
                            "text": "He expected some <w>revenue</w> of gratitude for his many years of service.",
                            "target_lang_translations": {
                                "ru": "Он ожидал некоего <w>воздаяния</w> в виде благодарности за свои долгие годы службы.",
                                "zh": "他期待多年服务能换来一些感激的<w>回报</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдача или нечто возвращенное, часто в переносном или духовном смысле.",
                        "zh": "回报或回馈，常用于比喻或精神层面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздаяние",
                                "target_lang_sense_clarification": "литературно"
                            },
                            {
                                "target_lang_word": "дань",
                                "target_lang_sense_clarification": "в переносном смысле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "回报",
                                "target_lang_sense_clarification": "精神或抽象的回馈"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "828cd72a-bb37-3fb2-856f-8dc47f22d0eb",
                    "sense_definition": "A former British government department responsible for collecting taxes, now part of HMRC.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>Revenue</w> does not treat a Scottish partnership as a body corporate.",
                            "target_lang_translations": {
                                "ru": "<w>Налоговое управление</w> не рассматривает шотландское партнерство как юридическое лицо.",
                                "zh": "<w>税务局</w>不将苏格兰合伙企业视为法人团体。"
                            }
                        },
                        {
                            "text": "Before the merger, the <w>Revenue</w> was responsible for managing national insurance contributions.",
                            "target_lang_translations": {
                                "ru": "До слияния <w>Налоговое ведомство</w> отвечало за управление взносами на национальное страхование.",
                                "zh": "在合并之前，<w>税务局</w>负责管理国民保险缴款。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Revenue"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United Kingdom"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "dissolved in 2005"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бывшее ведомство британского правительства, отвечавшее за сбор налогов.",
                        "zh": "英国政府曾负责征税的部门，现已并入英国税务海关总署。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Налоговое управление",
                                "target_lang_sense_clarification": "государственный орган"
                            },
                            {
                                "target_lang_word": "департамент доходов",
                                "target_lang_sense_clarification": "официальное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "税务局",
                                "target_lang_sense_clarification": "政府税务机构"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ed98844-0044-3141-80f5-7a2f32d19f16",
                    "sense_definition": "To produce or generate income.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "generate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new strategy was designed to help <w>revenue</w> the struggling department.",
                            "target_lang_translations": {
                                "ru": "Новая стратегия была разработана, чтобы помочь <w>приносить доход</w> испытывающему трудности отделу.",
                                "zh": "新战略旨在帮助这个陷入困境的部门<w>创收</w>。"
                            }
                        },
                        {
                            "text": "They are looking for ways of <w>revenuing</w> the project through private sponsorships.",
                            "target_lang_translations": {
                                "ru": "Они ищут способы <w>получения дохода</w> от проекта через частное спонсорство.",
                                "zh": "他们正在寻找通过私人赞助使该项目<w>盈利</w>的方法。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Производить или генерировать доход.",
                        "zh": "产生或创造收入。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приносить доход",
                                "target_lang_sense_clarification": "генерировать прибыль"
                            },
                            {
                                "target_lang_word": "монетизировать",
                                "target_lang_sense_clarification": "извлекать выгоду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创收",
                                "target_lang_sense_clarification": "创造收入"
                            },
                            {
                                "target_lang_word": "盈利",
                                "target_lang_sense_clarification": "产生利润"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}