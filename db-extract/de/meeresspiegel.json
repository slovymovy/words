                "senses": [
                    {
                        "sense_id": "72d2bf99-f4b2-3d3c-98f8-e844d381b70e",
                        "entry_id": "3e9f7e53-688b-35de-90e8-a6f17cdd3f67",
                        "glosses": [
                            "Niveau de la mer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb20e556-149e-4e1c-a7b1-1a9978bf8e78",
                                "sense_id": "72d2bf99-f4b2-3d3c-98f8-e844d381b70e",
                                "text": "Lange sank dort der Boden jedes Jahr um bis zu 20 Zentimeter, weil Grundwasser abgepumpt wird und der Meeresspiegel steigt."
                            },
                            {
                                "example_id": "8c5fff82-737e-426e-9306-5e21fae52711",
                                "sense_id": "72d2bf99-f4b2-3d3c-98f8-e844d381b70e",
                                "text": "Allein innerhalb der vergangenen 20 Jahre ist der Meeresspiegel wegen tauenden Eises in Grönland weltweit durchschnittlich um 1,2 Zentimeter angestiegen."
                            }
                        ]
                    }
                ],
