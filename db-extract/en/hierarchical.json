                    {
                        "translation_id": "17ca3e64-da42-464a-90fb-1aa1f4737f3d",
                        "source_entry_id": "c87a01c6-3064-305b-a211-aa91bb8b7748",
                        "source_sense_description": "pertaining to a hierarchy",
                        "target_lang_word": "hiérarchique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hiérarchique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc332c87-021a-39b0-8d5e-50fbcfa25901",
                                        "entry_id": "63a3a554-83f5-3933-a8fd-fcc40f47d1fe",
                                        "glosses": [
                                            "Qui est de la hiérarchie, qui appartient à la hiérarchie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "423997db-c37f-4794-9229-66249dbd80c3",
                                                "sense_id": "dc332c87-021a-39b0-8d5e-50fbcfa25901",
                                                "text": "A. Comte avait fabriqué une caricature du catholicisme, dans laquelle il n'avait conservé que la défroque administrative, policière et hiérarchique de cette Église."
                                            },
                                            {
                                                "example_id": "b3020352-0823-4ca6-97d3-2b882ba55f88",
                                                "sense_id": "dc332c87-021a-39b0-8d5e-50fbcfa25901",
                                                "text": "Ayant travaillé pendant de longues années dans les bureaux du Département de l’Intérieur, M. Montas mettra toutes ses connaissances administratives acquises et son activité à justifier la confiance du Chef de l’État et de ses Chefs hiérarchiques."
                                            },
                                            {
                                                "example_id": "200afb41-ae1b-44e6-be91-514b1f58d4a5",
                                                "sense_id": "dc332c87-021a-39b0-8d5e-50fbcfa25901",
                                                "text": "Le harcèlement moral n’est pas nécessairement exercé par un supérieur hiérarchique sur un salarié subordonné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd95a27b-c397-431f-823f-a83fd9e2bef7",
                        "source_entry_id": "c87a01c6-3064-305b-a211-aa91bb8b7748",
                        "source_sense_description": "pertaining to a hierarchy",
                        "target_lang_word": "hierarchisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hierarchisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3163466-fd6b-31da-ab98-b753bfda7c75",
                                        "entry_id": "37f67527-3dbf-3b32-a51c-04c82c1463c3",
                                        "glosses": [
                                            "der Hierarchie entsprechend; die Hierarchie betreffend, zu ihr gehörig, auf ihr beruhend; streng gegliedert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c986edec-afa4-48dc-9f44-b8db6f2cdc8c",
                                                "sense_id": "e3163466-fd6b-31da-ab98-b753bfda7c75",
                                                "text": "Die katholische Kirche ist hierarchisch strukturiert; unter „Hierarchie“ versteht man dabei die feste Struktur, gemäß der die Kirche durch geweihte Amtsträger geführt wird."
                                            },
                                            {
                                                "example_id": "aafbe2e0-1681-4442-a14b-6596aa4d359e",
                                                "sense_id": "e3163466-fd6b-31da-ab98-b753bfda7c75",
                                                "text": "Obwohl sie streng hierarchisch organisiert sind, leben die Jesuiten nicht in Klöstern, sondern in offenen Häusern und Kollegien."
                                            },
                                            {
                                                "example_id": "61cd3126-a443-46e7-9d17-3db6c7c966fc",
                                                "sense_id": "e3163466-fd6b-31da-ab98-b753bfda7c75",
                                                "text": "Aber patriarchalische Gesellschaften sind hierarchisch geformte Gesellschaften, die ständig Gewaltopfer produzieren, männliche wie weibliche."
                                            },
                                            {
                                                "example_id": "8edada1b-baba-41ba-aa88-19bf2782f951",
                                                "sense_id": "e3163466-fd6b-31da-ab98-b753bfda7c75",
                                                "text": "Sie habe die Machtverhältnisse als Kausalbeziehungen gedacht und diese wiederum hierarchisch, in der Form einer Pyramide von oben nach unten angeordnet."
                                            },
                                            {
                                                "example_id": "19ffcb56-bc5c-4ae5-ba07-80d654abc34b",
                                                "sense_id": "e3163466-fd6b-31da-ab98-b753bfda7c75",
                                                "text": "Die Aufbauorganisation bildet das – meistens hierarchische – Gerüst einer Organisation (z. B. einer Behörde oder eines Unternehmens)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
