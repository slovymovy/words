                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5290ed7a-667a-4510-b9c5-6d0bc9a0056d",
                                                "sense_id": "6bffa83a-cc5d-36cb-87b1-83ce431d48e7",
                                                "text": "Die Brote sind schon fertig geschmiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "735cf200-d31e-3fbe-be57-a837f36dabec",
                                        "entry_id": "14465706-daa6-331d-a83a-4a7cafeb25d4",
                                        "glosses": [
                                            "bewegliche Teile mit einer Substanz benetzen, die die mechanische Reibung reduziert"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eebca59-d133-45a1-aa07-0cc976a002fc",
                                                "sense_id": "735cf200-d31e-3fbe-be57-a837f36dabec",
                                                "text": "An Maschinen muss man ab und zu die Lager schmieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "01c26c1e-c5ff-3707-a01b-4b5b83d3eabc",
                                        "entry_id": "14465706-daa6-331d-a83a-4a7cafeb25d4",
                                        "glosses": [
                                            "unleserlich schreiben"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b725508a-5c78-4307-8e49-f3253215baee",
                                                "sense_id": "01c26c1e-c5ff-3707-a01b-4b5b83d3eabc",
                                                "text": "Du schmierst ja nicht schlecht!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "39fca46f-ce7b-33e9-8026-eef4d3b1b271",
                                        "entry_id": "14465706-daa6-331d-a83a-4a7cafeb25d4",
                                        "glosses": [
                                            "jemanden mit Geld oder anderen Gütern bestechen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd01822b-bd3c-4668-a30b-03deb1b2597f",
                                                "sense_id": "39fca46f-ce7b-33e9-8026-eef4d3b1b271",
                                                "text": "Die Beamten sollen Jahre lang geschmiert worden sein."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "046fb0ff-a3a6-4208-aacb-5333fd6349cc",
                        "source_entry_id": "1398e423-ada6-3c52-8fb3-8fa79af98224",
                        "source_sense_description": "дать взятку",
                        "target_lang_word": "bribe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bribe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42af7552-308f-35c6-a5d1-1c4cd1e4c6cb",
                                        "entry_id": "64816b9b-8379-3242-8e49-7b74120396ed",
                                        "glosses": [
                                            "Something (usually money) given in exchange for influence or as an inducement to breaking the law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02251403-2eae-40c9-824a-ba0cf73da04d",
                                                "sense_id": "42af7552-308f-35c6-a5d1-1c4cd1e4c6cb",
                                                "text": "c. 1613-1625, Henry Hobart, Yardly v. Ellill\nUndue reward for anything against justice is a bribe."
                                            },
                                            {
                                                "example_id": "1ed4c9e0-f4fe-4808-aedb-9e78a34a213f",
                                                "sense_id": "42af7552-308f-35c6-a5d1-1c4cd1e4c6cb",
                                                "text": "The bribes I took did not influence me to become evil. I was evil from the beginning and the bribes were merely a bonus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a492d11-6887-3a1b-b140-7f567d6b9673",
                                        "entry_id": "64816b9b-8379-3242-8e49-7b74120396ed",
                                        "glosses": [
                                            "The act of offering or paying such a payment: an act of bribery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a80b36db-c047-3b6f-90c7-b82587204e81",
                                        "entry_id": "64816b9b-8379-3242-8e49-7b74120396ed",
                                        "glosses": [
                                            "That which seduces; seduction; allurement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d2cb683-98cf-4030-abfb-9a9b9694d858",
                                                "sense_id": "a80b36db-c047-3b6f-90c7-b82587204e81",
                                                "text": "Not the bribes of sordid wealth can seduce to leave these everblooming sweets."
                                            },
                                            {
                                                "example_id": "06c09dfd-73e1-4db3-8c91-2b9e13cbbbb9",
                                                "sense_id": "a80b36db-c047-3b6f-90c7-b82587204e81",
                                                "text": "Remy, this was a bribe! Our whole marriage has been nothing but a series of bribes!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bribe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4439b9c0-4d4f-3333-a79e-044edcc98a24",
                                        "entry_id": "d20e98d6-68f4-31e8-9478-060f3dc73b5b",
                                        "glosses": [
                                            "To give a bribe to; specifically, to ask a person to do something against their original will, in exchange for some type of reward or relief from potential trouble."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cf6b863-1035-478c-a832-c0a015ed47ee",
                                                "sense_id": "4439b9c0-4d4f-3333-a79e-044edcc98a24",
                                                "text": "She was accused of trying to bribe the jury into making false statements."
                                            },
                                            {
                                                "example_id": "17606924-b82a-4a3a-87cb-a7379bc2d17c",
                                                "sense_id": "4439b9c0-4d4f-3333-a79e-044edcc98a24",
                                                "text": "October 23, 1848, Frederick William Robertson, an address delivered at the Opening of The Working Men's Institute\nNeither is he worthy who bribes a man to vote against his conscience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11d09284-a10e-344a-a522-5214e7b4b8e0",
                                        "entry_id": "d20e98d6-68f4-31e8-9478-060f3dc73b5b",
                                        "glosses": [
                                            "To gain by a bribe; to induce as by a bribe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd8dae8c-0f9f-4b0e-a841-3e6c8104bb8d",
                                                "sense_id": "11d09284-a10e-344a-a522-5214e7b4b8e0",
                                                "text": "to bribe somebody's compliance"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
