                                "target_senses": [
                                    {
                                        "sense_id": "29d9ab3d-d3f5-3052-b209-098ed9d0ae41",
                                        "entry_id": "ca57c154-585d-3f9b-9f9b-d32bcae441ea",
                                        "glosses": [
                                            "A divine entity in Yoruba religion that possesses the supernatural capability of reflecting some of the manifestations of Olódùmarè"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45ca4a45-6515-437c-863f-6772e3504346",
                                                "sense_id": "29d9ab3d-d3f5-3052-b209-098ed9d0ae41",
                                                "text": "I guess that is a good way to remember you. To rememeber you as a metaphor, but not to forget the text, to embrace all the humanity of your life... like an orisha — a flesh-and-blood hero. That sounds like a good African way to remember you."
                                            },
                                            {
                                                "example_id": "277eab1a-5e21-4cd8-8d91-891569b165d3",
                                                "sense_id": "29d9ab3d-d3f5-3052-b209-098ed9d0ae41",
                                                "text": "Under the command of Olorun were also orishas, intermediaries in the Yorubic religion said to be connected between man and the supernatural."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
