                    {
                        "sense_id": "eccba41b-0aa4-314c-acbe-15fed807e7b9",
                        "entry_id": "7632770f-e025-3967-8f38-febd5793d78c",
                        "glosses": [
                            "signaalrode wagen voorzien van een sirene waarmee de brandweer uitrukt om hulp te leveren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0a3592f-ec0b-42ee-9b50-4da0558b41e4",
                                "sense_id": "eccba41b-0aa4-314c-acbe-15fed807e7b9",
                                "text": "Terwijl ik een tweede blikje opentrok zag ik opeens in de verte een zwarte rookpluim. Binnen een paar minuten reden er een aantal brandweerauto’s langs de camping."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c4649a4-814d-3b22-8c90-0d758a277cb7",
                        "entry_id": "7632770f-e025-3967-8f38-febd5793d78c",
                        "glosses": [
                            "speelgoed in de vorm van een brandweerauto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e626441-bd97-4ec2-8dd7-1e2f4f0edf44",
                                "sense_id": "5c4649a4-814d-3b22-8c90-0d758a277cb7",
                                "text": "Mijn broertje speelde een eindje verderop met een brandweerauto alsof er niets was gebeurd."
                            }
                        ]
                    }
                ],
