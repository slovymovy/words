    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43642e30-84ce-3842-bc72-49dde91b09b2",
                    "sense_definition": "Avoir le visage qui prend une couleur rouge sous l'effet d'une vive émotion comme la timidité ou la gêne.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'on lui fait un compliment sincère, il ne peut s'empêcher de <w>rougir</w>."
                        },
                        {
                            "text": "Elle a <w>rougi</w> immédiatement lorsque son professeur l'a interrogée devant toute la classe."
                        }
                    ],
                    "synonyms": [
                        "empourprer",
                        "piquer un fard",
                        "piquer un soleil"
                    ],
                    "common_phrases": [
                        "faire rougir",
                        "rougir de plaisir",
                        "se sentir rougir"
                    ]
                },
                {
                    "sense_id": "7dccc522-e2da-3f54-be38-318e22ba86fe",
                    "sense_definition": "Prendre une teinte ou une couleur rouge en parlant d'une chose vivante ou d'un élément naturel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les tomates commencent enfin à <w>rougir</w> dans le jardin avec les fortes chaleurs estivales."
                        },
                        {
                            "text": "Le ciel <w>rougit</w> lentement au-dessus des collines quand le soleil commence à se coucher."
                        }
                    ],
                    "common_phrases": [
                        "commencer à rougir"
                    ]
                },
                {
                    "sense_id": "ffd26c38-484b-37f3-b76a-f7b05d3b8823",
                    "sense_definition": "Éprouver de la honte, de la confusion ou des remords au sujet de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as donné le meilleur de toi-même, tu n'as pas à <w>rougir</w> de tes résultats."
                        },
                        {
                            "text": "Il n'a jamais <w>rougi</w> de son passé difficile malgré les critiques de ses adversaires."
                        }
                    ],
                    "common_phrases": [
                        "rougir de honte",
                        "avoir à rougir",
                        "ne pas avoir à rougir"
                    ]
                },
                {
                    "sense_id": "a60e49b5-e6e1-3023-be34-7b3b60b0863c",
                    "sense_definition": "Rendre rouge quelque chose en le teignant, en le colorant ou en le couvrant de rouge.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En automne, la baisse des températures <w>rougit</w> les feuilles des grands arbres de la forêt."
                        },
                        {
                            "text": "Le sang des combattants blessés a tragiquement <w>rougi</w> les eaux calmes du ruisseau."
                        }
                    ]
                }
            ]
        }
    ]
