                "entry_id": "083d8fff-4925-318b-a49d-77b048f2d944",
                "word": "lombricien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7d04bdb5-12fb-4ffb-852b-0cb5fa0af43c",
                        "entry_id": "083d8fff-4925-318b-a49d-77b048f2d944",
                        "tags": [
                            "plural"
                        ],
                        "form": "lombriciens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7bda947-c006-30ac-b387-9cd88c0b7c31",
                        "entry_id": "083d8fff-4925-318b-a49d-77b048f2d944",
                        "glosses": [
                            "Ver de terre dont il existe de très nombreuses espèces (140 pour la France)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83ca9e5d-5633-41ae-95c4-8bb41674df6e",
                                "sense_id": "f7bda947-c006-30ac-b387-9cd88c0b7c31",
                                "text": "Les lombriciens sont, avec les plantes et les micro-organismes, les trois principaux acteurs biologiques des écosystèmes émergés, Aristote les appelait les « intestins de la terre »."
                            },
                            {
                                "example_id": "d1b7e723-1bb3-4084-b93c-dc8faa894525",
                                "sense_id": "f7bda947-c006-30ac-b387-9cd88c0b7c31",
                                "text": "Le lombricien digère la matière organique et transforme l’énergie biochimique en énergie calorique et mécanique."
                            },
                            {
                                "example_id": "53bef876-7d3a-4e96-90d6-062e9ec1add8",
                                "sense_id": "f7bda947-c006-30ac-b387-9cd88c0b7c31",
                                "text": "L’Homme ignore souverainement la première masse animale de nos milieux et n’a ni perception sensible ni intelligence des relations entre les humains et les lombriciens … ils subissent les conséquences des actes humains dans les écosystèmes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f356b72-d9a4-4f95-9178-06bc40324f68",
                        "source_entry_id": "083d8fff-4925-318b-a49d-77b048f2d944",
                        "source_sense_id": "f7bda947-c006-30ac-b387-9cd88c0b7c31",
                        "target_lang_word": "Regenwurm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regenwurm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87f467c1-9860-3d0d-9f36-a220df8fae9f",
                                        "entry_id": "06976b1a-8c19-33d8-b07d-82cf78cda885",
                                        "glosses": [
                                            "im Boden lebender Wurm (zoologisch ein Ringelwurm aus der Ordnung der Wenigborster)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f93d7206-c275-467b-812f-725215966420",
                                                "sense_id": "87f467c1-9860-3d0d-9f36-a220df8fae9f",
                                                "text": "Nach dem Regen beobachten die Kinder die Regenwürmer, die aus der Erde kriechen."
                                            },
                                            {
                                                "example_id": "9ed65d54-af2b-4952-a495-15c53d6d2cdb",
                                                "sense_id": "87f467c1-9860-3d0d-9f36-a220df8fae9f",
                                                "text": "„Regenwürmer leben im Boden, wo sie helfen, totes Pflanzenmaterial zu recyceln.“"
                                            },
                                            {
                                                "example_id": "c1330f06-7870-4758-9ea8-552055903adf",
                                                "sense_id": "87f467c1-9860-3d0d-9f36-a220df8fae9f",
                                                "text": "„Schon 1881 beschrieb Charles Darwin die Tatsache, dass Regenwürmer beständig die aus den tieferen Schichten des Bodens stammende Erde durch ihren Darm hindurch an die Erdoberfläche befördern und dadurch zur Auflockerung und Belüftung der Böden beitragen“"
                                            },
                                            {
                                                "example_id": "eec7a739-ce47-4035-884d-f1710fa8faea",
                                                "sense_id": "87f467c1-9860-3d0d-9f36-a220df8fae9f",
                                                "text": "„Die ersten Regenwürmer kriechen verliebt ans Tageslicht.“"
                                            },
                                            {
                                                "example_id": "34814273-3f31-4ac3-998a-92a17ac6067c",
                                                "sense_id": "87f467c1-9860-3d0d-9f36-a220df8fae9f",
                                                "text": "„Ein neutraler Köder, zum Beispiel ein Regenwurm, ist für beide Fischarten gleichermaßen (un)attraktiv.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5db6557-3124-452a-9aa9-5bb052eb889e",
                        "source_entry_id": "083d8fff-4925-318b-a49d-77b048f2d944",
