                ],
                "senses": [
                    {
                        "sense_id": "fade9dee-63ff-301e-b9ee-c25d728f1199",
                        "entry_id": "050914c4-17d5-31c8-8836-b53eb7d8ddb3",
                        "glosses": [
                            "die Fähigkeit eines lebenden Systems, sich selbst innerhalb gewisser Grenzen in einem stabilen Zustand des Gleichgewichtes zu halten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76d94570-2b6c-442b-a80a-56eeae9ec2e6",
                                "sense_id": "fade9dee-63ff-301e-b9ee-c25d728f1199",
                                "text": "„Homöostasis: Eigenschaft von Organismen, physiologische Funktionen durch Selbstregulierung im Gleichgewicht zu halten.“"
                            },
                            {
                                "example_id": "4ddfab46-fbe2-4816-b060-bf46ff9455e4",
                                "sense_id": "fade9dee-63ff-301e-b9ee-c25d728f1199",
                                "text": "„Homöostasis beinhaltet demnach die koordinierten physiologischen Prozesse, welche die meisten der Gleichgewichtszustände eines lebenden Organismus gewährleisten.“"
                            },
                            {
                                "example_id": "cb960ade-23e1-4bcf-b693-b69f976a7a92",
                                "sense_id": "fade9dee-63ff-301e-b9ee-c25d728f1199",
                                "text": "„Der Begriff der Homöostasis bezeichnet in dieser Auslegung nichts anderes als die Tendenz zum Gleichgewicht i.S. von Schwankungen um ein temporär stabiles ideales Gleichgewicht.“"
                            },
                            {
                                "example_id": "d30b9733-163d-48df-b511-e2a1b14cd361",
                                "sense_id": "fade9dee-63ff-301e-b9ee-c25d728f1199",
                                "text": "„Im biologischen Sektor sind Selbstregulationsvorgänge unter dem Namen Homöostasis bekannt“"
                            },
                            {
                                "example_id": "40f08ccd-a5f4-4e1e-863b-66809b3c02c5",
                                "sense_id": "fade9dee-63ff-301e-b9ee-c25d728f1199",
                                "text": "„Den Namen Homöostasis hat der amerikanische Physiologe W.B.Cannon für jenes Gleichgewichtsprinzip im lebenden Organismus geprägt, welches für die Konstanthaltung gewisser Größen sorgt …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd80cfdb-b932-4444-8e0c-0aa236580c39",
                        "source_entry_id": "050914c4-17d5-31c8-8836-b53eb7d8ddb3",
                        "source_sense_id": "fade9dee-63ff-301e-b9ee-c25d728f1199",
                        "target_lang_word": "homeostasis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homeostasis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5fc2513-0abc-35fb-bf77-9febb5b93885",
                                        "entry_id": "32159d56-4a9a-30f2-bef7-39877dfa4bfc",
                                        "glosses": [
                                            "The ability of a system or living organism to adjust its internal environment to maintain a state of dynamic constancy; such as the ability of warm-blooded animals to maintain a stable temperature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a87313a-6f70-43a2-9b00-42be9dbdd88a",
                                                "sense_id": "f5fc2513-0abc-35fb-bf77-9febb5b93885",
                                                "text": "His most important work concentrated on the complexities of chemical neurotransmission (for which Otto Loewi received a Nobel Prize in 1936) and on “homeostasis” (a term coined by Cannon in 1926), the maintenance of steady states in the body and the physiological processes through which they are regulated."
                                            },
                                            {
                                                "example_id": "27af30af-a9f1-4080-a108-a9e18267b4f4",
                                                "sense_id": "f5fc2513-0abc-35fb-bf77-9febb5b93885",
                                                "text": "When homeostasis is disrupted by an external stressor - such as injury, lack of nutrients, or invasion by parasites or other organisms - illness may occur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c2918ed-f235-3a00-94aa-caee3a42a92c",
                                        "entry_id": "32159d56-4a9a-30f2-bef7-39877dfa4bfc",
                                        "glosses": [
                                            "Such a dynamic equilibrium or balance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96d82d09-4147-4792-9c8a-baa52f6db726",
                        "source_entry_id": "050914c4-17d5-31c8-8836-b53eb7d8ddb3",
                        "source_sense_id": "fade9dee-63ff-301e-b9ee-c25d728f1199",
                        "target_lang_word": "homéostasie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homéostasie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7cb33549-6a8c-38e7-bb16-8ff40850b0ab",
                                        "entry_id": "9adbffe4-9f44-3284-bb24-aaff9cb69354",
                                        "glosses": [
                                            "Capacité d’un organisme à maintenir son équilibre physiologique interne malgré les contraintes extérieures."
                                        ],
                                        "tags": [
                                            "Sciences de la vie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fd438e0-f2d6-4146-9ff3-be34325588a9",
                                                "sense_id": "7cb33549-6a8c-38e7-bb16-8ff40850b0ab",
                                                "text": "De la même manière que les processus physiologiques sont accumulés pour aboutir à l’homéostasie (situation stable), les processus de développement sont régulés pour donner lieu à l’homéorhésie (flux stable)."
                                            },
                                            {
                                                "example_id": "2ce987bf-c1f9-4007-9302-eda16cfdab59",
                                                "sense_id": "7cb33549-6a8c-38e7-bb16-8ff40850b0ab",
                                                "text": "Et les sentiments nous informent sur ce qui se passe dans notre corps. Ils servent à savoir si nous éprouvons du plaisir ou de la souffrance et, grâce à cela, de maintenir notre homéostasie [en biologie, capacité pour un système à maintenir l’équilibre de son milieu intérieur, quelles que soient les contraintes externes, NDLR]. Ces sentiments sont les moteurs de nos actions et même de nos inventions culturelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
