                        ],
                        "form": "die Kolonialmächte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6f88b28-97be-3280-ae7a-05f1bc0a9f35",
                        "entry_id": "2786389e-37ff-39ae-ab3b-8fe0d86045a4",
                        "glosses": [
                            "Staat, der Kolonien beherrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5a45faf-1411-4886-8b50-fe1dd3799a88",
                                "sense_id": "d6f88b28-97be-3280-ae7a-05f1bc0a9f35",
                                "text": "„Die Kolonialmacht Dänemark traute den Inuit keine Verwaltung und keine Verantwortung zu.“"
                            },
                            {
                                "example_id": "f3a96c2d-9a3f-4d21-a8f0-769b08d23dfe",
                                "sense_id": "d6f88b28-97be-3280-ae7a-05f1bc0a9f35",
                                "text": "„Letzteres ist freilich nur ein Beispiel für den Konkurrenzkampf der Kolonialmächte.“"
                            },
                            {
                                "example_id": "40899bf9-73e6-4950-bc51-11949adb4d84",
                                "sense_id": "d6f88b28-97be-3280-ae7a-05f1bc0a9f35",
                                "text": "„Das ungeheure Verbrechen, Fundament des Reichtums der europäischen Kolonialmächte, dauerte bis weit ins 19. Jahrhundert.“"
                            },
                            {
                                "example_id": "108b8f4f-2dd1-4b80-87e9-500f059f0c7d",
                                "sense_id": "d6f88b28-97be-3280-ae7a-05f1bc0a9f35",
                                "text": "„1905 erregte er massiv das Misstrauen der Kolonialmacht und galt fortan als Grundübel, das ausgeschaltet werden musste.“"
                            },
                            {
                                "example_id": "a8ad72e1-f125-4ac0-a17f-881915deb1dd",
                                "sense_id": "d6f88b28-97be-3280-ae7a-05f1bc0a9f35",
                                "text": "„Hier versammelten sich die Vertreter von Nationen, die erst jüngst ihre Unabhängigkeit von den westlichen Kolonialmächten errungen hatten und sich dafür einsetzten, dass auch den noch verbleibenden Kolonien die Unabhängigkeit gewährt werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
