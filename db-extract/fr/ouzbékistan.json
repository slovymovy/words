            {
                "entry_id": "07cb2756-4a3c-3e7e-819a-055edaf1265e",
                "word": "Ouzbékistan",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4caf6f2a-921c-371f-a550-9605ba3f45bc",
                        "entry_id": "07cb2756-4a3c-3e7e-819a-055edaf1265e",
                        "glosses": [
                            "Pays d’Asie, entouré par le Kazakhstan, le Kirghizstan, le Tadjikistan, l’Afghanistan et le Turkménistan, dont la capitale est Tachkent."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "17b9692b-ee64-43cd-bd05-1cf623b5eff2",
                                "sense_id": "4caf6f2a-921c-371f-a550-9605ba3f45bc",
                                "text": "Les incidents au Kazakhstan, en Ouzbékistan, au Tadjikistan, au Turkménistan ou au Kirghizstan se sont produits à l'échelle locale, dans les installations nucléaires des pays en question."
                            },
                            {
                                "example_id": "f5dc7d21-3341-47f4-9429-4ac3f81a5ec2",
                                "sense_id": "4caf6f2a-921c-371f-a550-9605ba3f45bc",
                                "text": "Première journée difficile pour l’équipe de France lors des Mondiaux de judo de Tachkent (Ouzbékistan), où Shirine Boukli (photo), nᵒ 1 mondiale dans la catégorie des moins de 48 kg, a été éliminée dès le 3ᵉ tour."
                            },
                            {
                                "example_id": "66f10ebc-e08c-41f2-a021-52f7b8c802d2",
                                "sense_id": "4caf6f2a-921c-371f-a550-9605ba3f45bc",
                                "text": "Alors que l’Ouzbékistan devient très répressif pendant les années 1990 et que son économie devient un mélange d’étatisme et pratiques ultracorrompues, le Kazakhstan privatise à tour de bras ses vieux mastodontes de l’industrie minière — avec certes quelques ratés — et semble emprunter la voie libérale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32603a66-7029-4f25-aea4-4ed166650b1e",
                        "source_entry_id": "07cb2756-4a3c-3e7e-819a-055edaf1265e",
                        "source_sense_id": "4caf6f2a-921c-371f-a550-9605ba3f45bc",
                        "target_lang_word": "Usbekistan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Usbekistan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c9214bd-959c-343d-875c-547e0e52e5ff",
                                        "entry_id": "a40ef367-75e8-3a8a-8444-37f1ac8d332a",
                                        "glosses": [
                                            "Staat in Zentralasien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "085abd68-20d0-4e2a-9143-97c0ddb23b15",
                                                "sense_id": "7c9214bd-959c-343d-875c-547e0e52e5ff",
                                                "text": "Morgen fahren wir nach Usbekistan."
                                            },
                                            {
                                                "example_id": "6f767891-3caa-4d1f-b8e3-df42db30e0b4",
                                                "sense_id": "7c9214bd-959c-343d-875c-547e0e52e5ff",
                                                "text": "In seinen Schilderungen findet man das Usbekistan der 90er Jahre wieder."
                                            },
                                            {
                                                "example_id": "a87efd0a-4474-4798-829f-e7d33b5f86db",
                                                "sense_id": "7c9214bd-959c-343d-875c-547e0e52e5ff",
                                                "text": "Taschkent ist die Hauptstadt von Usbekistan."
                                            },
                                            {
                                                "example_id": "925e12e2-6852-4511-bc1d-70a41efb9c80",
                                                "sense_id": "7c9214bd-959c-343d-875c-547e0e52e5ff",
                                                "text": "„Durch Usbekistan fließen die zwei wichtigsten Zuflüsse des Aralsees und größten Ströme Zentralasiens, der Amudarja (usbek. Amudaryo) mit 2.539 km Länge und der Syrdarja (usbek. Sirdaryo) mit 2.212 km Länge.“"
                                            },
                                            {
                                                "example_id": "79c19714-941f-4c53-b49b-5feb7f5cc00c",
                                                "sense_id": "7c9214bd-959c-343d-875c-547e0e52e5ff",
                                                "text": "„Usbekistan gliedert sich in elf Gebiete und die Karakalpakische Autonome Republik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86687b9f-3ac9-4929-af17-222824ca392f",
                        "source_entry_id": "07cb2756-4a3c-3e7e-819a-055edaf1265e",
