                ],
                "translations": [
                    {
                        "translation_id": "45035e8c-ccd1-4e29-b9b0-d3f260ddfa8b",
                        "source_entry_id": "5987fb86-f110-3560-ba5a-14b9759def3e",
                        "target_lang_word": "erwachen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erwachen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61be2d11-6573-3fed-be6c-49a7da7aed3c",
                                        "entry_id": "2367f407-a6f8-3ace-bf65-1f9b7a4a59aa",
                                        "glosses": [
                                            "aufhören zu schlafen; wach werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac0e2c49-20d0-426c-a869-b0c47b42dc66",
                                                "sense_id": "61be2d11-6573-3fed-be6c-49a7da7aed3c",
                                                "text": "Am frühen Morgen blinzelte sie in das Sonnenlicht und erwachte langsam."
                                            },
                                            {
                                                "example_id": "fe6b81f5-f126-40af-8e2e-bc8c1583bbe0",
                                                "sense_id": "61be2d11-6573-3fed-be6c-49a7da7aed3c",
                                                "text": "„Als Gregor Samsa eines Morgens aus unruhigen Träumen erwachte, fand er sich in seinem Bett zu einem ungeheuren Ungeziefer verwandelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3ba253a6-ed2e-3bc5-aea0-4d6adadbdbfc",
                                        "entry_id": "2367f407-a6f8-3ace-bf65-1f9b7a4a59aa",
                                        "glosses": [
                                            "sich in jemandem zu entwickeln beginnen (ein Interesse, eine Leidenschaft für etwas)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b96a2d-6fc5-4b80-84a3-771926c376db",
                                                "sense_id": "3ba253a6-ed2e-3bc5-aea0-4d6adadbdbfc",
                                                "text": "Er sah dieses schöne Mädchen und sein Interesse war erwacht."
                                            },
                                            {
                                                "example_id": "17bc8bfb-73ec-4094-a289-f23d1e26421f",
                                                "sense_id": "3ba253a6-ed2e-3bc5-aea0-4d6adadbdbfc",
                                                "text": "„Seine [des kenianischen Redakteurs der Deutschen Welle, Chrispin Mwakideu,] Leidenschaft für das Puppenspiel erwachte Mitte der neunziger Jahre, als das traditionelle Puppenspiel in Afrika wieder auflebte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6e48ce61-951f-34c8-b620-5d2f6e1754c8",
                                        "entry_id": "2367f407-a6f8-3ace-bf65-1f9b7a4a59aa",
                                        "glosses": [
                                            "ins Dasein treten, anfangen sich zu entwickeln"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d663b24d-5a36-4dd9-8e23-bf6e3318f443",
                                                "sense_id": "6e48ce61-951f-34c8-b620-5d2f6e1754c8",
                                                "text": "„Im Wardeinschen Anwesen erwachte das Leben, eine Stalltür knarrte, nackte Füße stapften die Holzstufen am Hause auf und ab.“"
                                            },
                                            {
                                                "example_id": "f1c80af1-ccb3-49ea-b1d8-d96a884035c8",
                                                "sense_id": "6e48ce61-951f-34c8-b620-5d2f6e1754c8",
                                                "text": "„Die Nacht erstarb. Und der Tag erwachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6568387f-a9bf-3583-9d50-1115a150f6d4",
                                        "entry_id": "2367f407-a6f8-3ace-bf65-1f9b7a4a59aa",
                                        "glosses": [
                                            "in anderen, meist fortgeschrittenen Zustand kommen, zu Bewusstsein/Erkenntnis kommen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "753cf776-e3be-407d-8863-f027cf624996",
                                                "sense_id": "6568387f-a9bf-3583-9d50-1115a150f6d4",
                                                "text": "„1800 ward er nach Walch’s Ableben Vorstand der lateinischen Gesellschaft, die unter seiner rührigen Leitung zu neuem Leben erwachte;“"
                                            },
                                            {
                                                "example_id": "07a631a2-ca2f-4729-8571-24e5adb49457",
                                                "sense_id": "6568387f-a9bf-3583-9d50-1115a150f6d4",
                                                "text": "„Dieses Gefühl [der Nationalität] regte sich nur dunkel […]. Es erwachte zu vollem Bewußtsein erst mit dem Aufschwunge der Literatur durch den Einfluss der Schriftsteller und Dichter.“"
                                            },
                                            {
                                                "example_id": "7bb2c2e3-8337-4c19-b329-ae39460334d2",
                                                "sense_id": "6568387f-a9bf-3583-9d50-1115a150f6d4",
                                                "text": "„Er erwacht zu seinem subjektiven Ich, zu seinem persönlichen Schicksal, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47bcceb6-89d6-4552-91d7-343c3087b9b2",
                        "source_entry_id": "5987fb86-f110-3560-ba5a-14b9759def3e",
                        "target_lang_word": "aufwachen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufwachen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "055d4c9e-6258-3f66-9a96-74922dc20c73",
                                        "entry_id": "cba1f259-77f9-32b0-993f-9b6a1171ae71",
                                        "glosses": [
                                            "den Schlaf, die Ruhe beenden"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22c9e7b5-03ea-446c-86d8-96378d7004e1",
                                                "sense_id": "055d4c9e-6258-3f66-9a96-74922dc20c73",
                                                "text": "Ich bin aufgewacht, als meine Mutter morgens ins Zimmer kam."
                                            },
                                            {
                                                "example_id": "5d198c2e-3a74-4157-b259-200429a27428",
                                                "sense_id": "055d4c9e-6258-3f66-9a96-74922dc20c73",
                                                "text": "Ich wachte auf, als der Wecker klingelte."
                                            },
                                            {
                                                "example_id": "e668dda5-ff9d-4804-b47b-6fc5b881b72e",
                                                "sense_id": "055d4c9e-6258-3f66-9a96-74922dc20c73",
                                                "text": "Wenn ich aufwache, bin ich immer noch ein bisschen schläfrig."
                                            },
                                            {
                                                "example_id": "a038e4d1-20a3-4206-b993-b96f8fa46ac6",
                                                "sense_id": "055d4c9e-6258-3f66-9a96-74922dc20c73",
                                                "text": "Bei Schlafstörungen wacht man nachts immer wieder auf."
                                            },
                                            {
                                                "example_id": "137ed495-9b7a-406b-aaa6-350de6f25fd5",
                                                "sense_id": "055d4c9e-6258-3f66-9a96-74922dc20c73",
                                                "text": "[Russischer Krieg in der Ukraine:] „Doch es kann auch passieren, dass ich nachts aufwache, weil die Sirenen heulen.“"
                                            },
                                            {
                                                "example_id": "5e48a564-3a2c-4b24-8392-d54b77bcfc9a",
                                                "sense_id": "055d4c9e-6258-3f66-9a96-74922dc20c73",
                                                "text": "„Um fünf Uhr wachte ich auf, zerschlagen durch Erschöpfung und Aufregung.“"
                                            },
                                            {
                                                "example_id": "777f8696-8c19-4e18-99c9-a483e871602a",
                                                "sense_id": "055d4c9e-6258-3f66-9a96-74922dc20c73",
                                                "text": "„Der Grund, warum das Schlafen im gleichen Raum vor plötzlichem Kindstod schützt, ist nicht bekannt, es könnte jedoch damit zusammenhängen, dass Säuglinge im Raum der Eltern häufiger kurzzeitig aufwachen.“"
                                            },
                                            {
                                                "example_id": "2c9618f6-0a85-45ed-b98a-a449228229e0",
                                                "sense_id": "055d4c9e-6258-3f66-9a96-74922dc20c73",
                                                "text": "„Nach nordamerikanischer Tradition ist der Murmeltiertag, der am 2. Februar gefeiert wird, der Tag, an dem Murmeltiere beobachtet werden, die aus dem Winterschlaf aufwachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b107902e-4e36-3c59-8816-b84300f1c496",
                                        "entry_id": "cba1f259-77f9-32b0-993f-9b6a1171ae71",
                                        "glosses": [
                                            "eine Entwicklung, die bis dahin von jemandem nicht wahrgenommen wurde, erkennen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a0a48e6-7ade-4ca5-ab22-32bdcb2e89c8",
                                                "sense_id": "b107902e-4e36-3c59-8816-b84300f1c496",
                                                "text": "„Wacht auf, Verdammte dieser Erde, die stets man noch zum Hungern zwingt!“ (Die Internationale)"
                                            },
                                            {
                                                "example_id": "661d9f4c-fe55-488d-81f1-101e864793da",
                                                "sense_id": "b107902e-4e36-3c59-8816-b84300f1c496",
                                                "text": "[Ole von Uexküll:] „»Auch hier wird wirklich hauptsächlich geredet und man fragt sich, was noch passieren muss, damit die Politik aufwacht.«“( Audio⁽ᴵⁿᶠᵒ⁾)"
                                            },
                                            {
                                                "example_id": "6033addd-ba52-484b-a155-d66b8ae64046",
                                                "sense_id": "b107902e-4e36-3c59-8816-b84300f1c496",
                                                "text": "[UNEP-Exekutivdirektorin Inger Andersen:] „»Wir sollten nicht verzweifeln. Aber die Welt muss aufwachen und sich der drohenden Gefahr bewusst werden, der wir als Spezies ausgesetzt sind. Wir müssen entschlossen handeln. Wir müssen schnell handeln. Und wir müssen es jetzt tun.«“"
                                            },
                                            {
                                                "example_id": "700f2f13-f6eb-463b-96be-996fd2081d3a",
                                                "sense_id": "b107902e-4e36-3c59-8816-b84300f1c496",
                                                "text": "[Russischer Krieg in der Ukraine:] „Wladimir Kaminer: Ich habe bis zuletzt gehofft, dass die russische Gesellschaft diesen Aggressor-Krieg nicht unterstützt. Aber anscheinend sind meine Landsleute in eine Lethargie verfallen. Ich weiß nicht, was passieren soll, damit sie wieder aufwachen.“"
                                            },
                                            {
                                                "example_id": "48aa40ea-e5af-4ef7-b488-2da00e63d10f",
                                                "sense_id": "b107902e-4e36-3c59-8816-b84300f1c496",
                                                "text": "„Frankreichs älteste AKW sollen länger laufen – Während die Atomaufsicht den Daumen hebt, warnen Umweltschützer vor schwersten Sicherheitsrisiken. Auch die Nachbarländer müssten endlich aufwachen, heißt es.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
