                "senses": [
                    {
                        "sense_id": "d7183450-3b04-31a8-ba39-aa3b251f2ef7",
                        "entry_id": "c8122b56-5065-3ec8-83a1-fd9d063ab2d5",
                        "glosses": [
                            "Ei, das von einem Kiebitz stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e54b8a5-233c-42a9-9ea3-69c0a6634c7c",
                                "sense_id": "d7183450-3b04-31a8-ba39-aa3b251f2ef7",
                                "text": "„›Ich wurde in grausam jungem Alter zur Waise. Am Morgen fand ich sie - die Leiche meiner Mutter lag zerschmettert am Fuß einer hohen Klippe, auf der sie wohl Kiebitzeier gesammelt hatte.‹“"
                            },
                            {
                                "example_id": "e012c9fc-14bb-45e6-b184-eddfaf2b5ddc",
                                "sense_id": "d7183450-3b04-31a8-ba39-aa3b251f2ef7",
                                "text": "„Stangen benutzte auch mein Großonkel, wenn er mit seinem jüngeren Bruder Didi nach Kiebitzeiern suchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
