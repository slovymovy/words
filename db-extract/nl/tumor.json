                                "target_senses": [
                                    {
                                        "sense_id": "452d09f2-d887-349d-93f3-47678d8af68b",
                                        "entry_id": "9d996a01-3de5-3d9a-9a4b-cae7b47b89d4",
                                        "glosses": [
                                            "Wucherung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e114c3-d380-4ce3-a234-f29ab6b4acf2",
                                                "sense_id": "452d09f2-d887-349d-93f3-47678d8af68b",
                                                "text": "„Nur etwa fünf Prozent der Tumore sind erblich bedingt, die übergroße Mehrheit entsteht spontan.“"
                                            },
                                            {
                                                "example_id": "893d076f-7172-4f6d-aee8-3d814ed123fd",
                                                "sense_id": "452d09f2-d887-349d-93f3-47678d8af68b",
                                                "text": "„Weil durch das Kernspinntomogramm die Art des Tumors nicht zu ermitteln war, musste Herman im Juni 1988 eine schmerzhafte Biopsie über sich ergehen lassen, bei der ein Loch in die Schädeldecke gebohrt und eine Probe des Tumorgewebes entnommen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99c3177c-4e66-3877-ac9b-93961bd5d0ad",
                                        "entry_id": "9d996a01-3de5-3d9a-9a4b-cae7b47b89d4",
                                        "glosses": [
                                            "Schwellung (unklarer Ursache)"
                                        ],
                                        "tags": [
                                            "seltener allgemeiner"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
