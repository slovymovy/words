                                        "sense_id": "9080ae56-c0bb-3dea-847f-087544698289",
                                        "entry_id": "b4f883c8-c1d8-3868-859c-068ab9fe41ba",
                                        "glosses": [
                                            "Fußbodenbelag, nach bestimmten Verlegemustern zusammengefügt aus kleinen Holzteilen"
                                        ],
                                        "tags": [],
