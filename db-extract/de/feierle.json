                ],
                "senses": [
                    {
                        "sense_id": "99138dc0-b319-3a16-a2ef-dc2e0f29d996",
                        "entry_id": "5be16c10-aac2-3b9f-86ff-1c81e3d55a22",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdf9a0a0-650b-4053-ba4a-0ddd457cddd5",
                                "sense_id": "99138dc0-b319-3a16-a2ef-dc2e0f29d996",
                                "text": "Frau Feierle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "473043a6-a3ed-46ac-84cd-965fc554e203",
                                "sense_id": "99138dc0-b319-3a16-a2ef-dc2e0f29d996",
                                "text": "Herr Feierle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "791bf297-f0d2-41bb-aacb-87d76af44938",
                                "sense_id": "99138dc0-b319-3a16-a2ef-dc2e0f29d996",
                                "text": "Die Feierles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "8e9ae367-3630-4e0a-97c9-505b177f4b6c",
                                "sense_id": "99138dc0-b319-3a16-a2ef-dc2e0f29d996",
                                "text": "Der Feierle trägt nie die Pullover, die die Feierle ihm strickt."
                            },
                            {
                                "example_id": "6cca889f-014b-40ae-a57b-097db82b121c",
                                "sense_id": "99138dc0-b319-3a16-a2ef-dc2e0f29d996",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Feierle kommt, geht der Herr Feierle.“"
                            },
                            {
                                "example_id": "ff45088f-b05f-40ae-a038-5c0047103082",
                                "sense_id": "99138dc0-b319-3a16-a2ef-dc2e0f29d996",
                                "text": "Feierle kommt und geht."
                            },
                            {
                                "example_id": "aa63591b-28f2-4a56-bbe0-61829f179d94",
                                "sense_id": "99138dc0-b319-3a16-a2ef-dc2e0f29d996",
                                "text": "Feierles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
