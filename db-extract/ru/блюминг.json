                        "sense_id": "6f16ecc6-f256-3184-8f8e-42fda4b7cba7",
                        "entry_id": "e9c0b54b-7319-3aca-af01-fdcdf639b467",
                        "glosses": [
                            "металл. высокопроизводительный мощный прокатный стан для обжима стальных слитков в заготовки квадратного сечения (блюмы)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61759c2b-4df1-4cce-920c-fada8f10cd8c",
                                "sense_id": "6f16ecc6-f256-3184-8f8e-42fda4b7cba7",
                                "text": "Мы прошли следующий зал, где тоже всё скрежетало, и на эскалаторе поднялись на второй этаж, где ряды блюмингов поглощали сыпавшийся из воронок мелкий, уже бесформенный лом."
                            }
                        ]
                    }
