                "senses": [
                    {
                        "sense_id": "e0ad1144-634e-3fc8-8719-f9180566a434",
                        "entry_id": "79d154dc-11e3-36a2-8fca-2d4cc357fd41",
                        "glosses": [
                            "One who rents property or other goods from another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e31efb28-a512-404d-b1ff-49ae745260f1",
                                "sense_id": "e0ad1144-634e-3fc8-8719-f9180566a434",
                                "text": "Create an input form that enables you to enter the data for new videos without seeing the information on whether the video is rented. Save this form with the name New video. Then create a form for entering the name of a renter […]"
                            },
                            {
                                "example_id": "19eff2ff-ea67-46b4-8e36-199882e3a60a",
                                "sense_id": "e0ad1144-634e-3fc8-8719-f9180566a434",
                                "text": "Nearly half of all renter households in the US were cost-burdened in 2023, meaning they paid more than 30% of their income towards housing costs, according to new government data."
                            },
                            {
                                "example_id": "c34cd073-3bac-4706-8354-d67f6474198e",
                                "sense_id": "e0ad1144-634e-3fc8-8719-f9180566a434",
                                "text": "A recent report from the Aspen Institute highlights the gaping wealth chasm that has formed between homeowners and renters in America."
                            }
                        ]
                    },
                    {
                        "sense_id": "a34d4bd4-0f82-30ff-9782-cb70b9d583cb",
                        "entry_id": "79d154dc-11e3-36a2-8fca-2d4cc357fd41",
                        "glosses": [
                            "One who owns or controls property and rents that property to another."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "62fe2698-e151-3620-9274-7c0f651b19e3",
                        "entry_id": "79d154dc-11e3-36a2-8fca-2d4cc357fd41",
                        "glosses": [
                            "(Synonym of rent boy) Male prostitute."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "de288949-6a33-48d5-a471-42b0bdc0d9b1",
                                "sense_id": "62fe2698-e151-3620-9274-7c0f651b19e3",
                                "text": "It was Sweet Alice who introduced me to the various renter types, and explained to me their costumes, and their habits, and their skills."
                            }
                        ]
                    },
                    {
                        "sense_id": "b810de85-e9a6-3f68-9b56-dcebb55f862f",
                        "entry_id": "79d154dc-11e3-36a2-8fca-2d4cc357fd41",
                        "glosses": [
                            "A film worth renting, but not possibly worth visiting a cinema to see."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    }
