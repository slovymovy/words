                    },
                    {
                        "translation_id": "75bb054d-9313-4a27-8bb5-b54557830f60",
                        "source_entry_id": "8cea430c-9ab0-3b9c-8486-d4433f409d38",
                        "source_sense_id": "ea86aac5-8f99-3606-b07d-3ec620796fef",
                        "target_lang_word": "accepteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accepteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4413aea0-2b3a-3b90-b8fa-1026b96a6d03",
                                        "entry_id": "a1aa00e6-dd97-3470-a44c-7008190712f5",
                                        "glosses": [
                                            "Celui qui accepte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "134787e9-a5a6-46bc-a522-f0d8b69a4d58",
                                                "sense_id": "4413aea0-2b3a-3b90-b8fa-1026b96a6d03",
                                                "text": "L’accepteur d’une lettre de change devient personnellement débiteur de la somme."
                                            },
                                            {
                                                "example_id": "b6e149ac-31e9-47bd-b2b7-26e4ccc7671b",
                                                "sense_id": "4413aea0-2b3a-3b90-b8fa-1026b96a6d03",
                                                "text": "C'est pourquoi l'on autorise le tiré accepteur à opposer toutes les exceptions au tireur porteur."
                                            },
                                            {
                                                "example_id": "5d5bf785-cf80-46d2-90cf-20167f1eaf9d",
                                                "sense_id": "4413aea0-2b3a-3b90-b8fa-1026b96a6d03",
                                                "text": "Par l’examen des variations des effets Δ-iso, avec la nature du noyau décoalescé i (fig. 6), nous mettons en évidence un transfert électronique vers l’accepteur, plus important dans un des deux isomères présents, quand la densité électronique du système π s’accroît."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accepteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "878ac3d4-533b-3713-a9fe-cd1c6d7f32a3",
                                        "entry_id": "23d5d31b-2192-30ca-825a-c79a08c796ae",
                                        "glosses": [
                                            "Qui accepte."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6178d330-89bc-421a-9d29-113738214cf2",
                                                "sense_id": "878ac3d4-533b-3713-a9fe-cd1c6d7f32a3",
                                                "text": "Tout médicament introduit dans un organisme peut être considéré comme une molécule étrangère qui va réagir avec l'organisme accepteur."
                                            },
                                            {
                                                "example_id": "950fd567-f7ac-495f-ae73-2137e0ef65d7",
                                                "sense_id": "878ac3d4-533b-3713-a9fe-cd1c6d7f32a3",
                                                "text": "Les acides aminés se fixent à l'extrémité –OH monocaténaire libre de la tige accepteuse."
                                            },
                                            {
                                                "example_id": "736b472e-09ef-4cfb-a4d8-1cdaed21b476",
                                                "sense_id": "878ac3d4-533b-3713-a9fe-cd1c6d7f32a3",
                                                "text": "Il avait les deux bras tendus vers une assistance qui était tout ouïe, tout aux aguets, accepteuse de bonnes paroles galvanisantes !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
