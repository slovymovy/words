                "senses": [
                    {
                        "sense_id": "beade649-9f47-3c2b-a92f-b2f484491b45",
                        "entry_id": "293971f8-4f27-3e09-adf7-c8958473c8f5",
                        "glosses": [
                            "Lappen, als Teil eines Organs"
                        ],
                        "tags": [
                            "Plural Lobi"
                        ],
                        "examples": [
                            {
                                "example_id": "9ab76c5a-cb75-419e-9976-346b9e0c94cc",
                                "sense_id": "beade649-9f47-3c2b-a92f-b2f484491b45",
                                "text": "Durch einige besonders tiefe Sulci wird der Cortex in 4 Lobi unterteilt."
                            },
                            {
                                "example_id": "00a19f1f-98a4-4bc1-97e5-592479b96bfb",
                                "sense_id": "beade649-9f47-3c2b-a92f-b2f484491b45",
                                "text": "Der Lobus caudalis ist für die Kontrolle der motorischen Funktionen zuständig."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "053335bd-c44c-3017-934e-4cbc6a3d75a2",
                        "entry_id": "293971f8-4f27-3e09-adf7-c8958473c8f5",
                        "glosses": [
                            "Zunge/Strom aus Eis"
                        ],
                        "tags": [
                            "Plural Loben",
                            "Gletscher, Inlandseis"
                        ],
                        "examples": [
                            {
                                "example_id": "66b448f1-e6f9-4cf8-997f-bdcf9c67317a",
                                "sense_id": "053335bd-c44c-3017-934e-4cbc6a3d75a2",
                                "text": "„Es sind Zonen, die zwischen Eismassen lagern, die sich mit verschiedener Geschwindigkeit bewegten, wo das Eis des einen Stroms (oder Lobus) vom Eis des anderen blockiert wurde.“"
                            },
                            {
                                "example_id": "e837bc9b-c678-410c-891d-34c562ecd9de",
                                "sense_id": "053335bd-c44c-3017-934e-4cbc6a3d75a2",
                                "text": "„Wie weit westlich der Einfluß des Lobus im Gebiet von Degerhamn reichte, ist noch nicht geklärt.“"
                            },
                            {
                                "example_id": "797652d6-d8fb-401d-a335-b02939abd02a",
                                "sense_id": "053335bd-c44c-3017-934e-4cbc6a3d75a2",
                                "text": "„Die südlichen Loben der letzten Vereisung in Nordamerika erreichten ihre größte Ausdehnung zu verschiedenen Zeiten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91629db7-64f5-441c-aef3-ee3048989ee3",
                        "source_entry_id": "293971f8-4f27-3e09-adf7-c8958473c8f5",
                        "source_sense_id": "beade649-9f47-3c2b-a92f-b2f484491b45",
                        "source_sense_description": "Medizin, Anatomie, Plural Lobi: Lappen, als Teil eines Organs",
                        "target_lang_word": "lobe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lobe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e1157d9-e6ed-3ef9-8127-dc8ccce0ac29",
                                        "entry_id": "760a91c9-d9da-3a3d-8986-c84fb260fb4f",
                                        "glosses": [
                                            "Any projection or division, especially one of a somewhat rounded form."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a48cc7d0-1692-45be-8bf9-1f5a0da9fbdc",
                                                "sense_id": "4e1157d9-e6ed-3ef9-8127-dc8ccce0ac29",
                                                "text": "A lobe of lava was crawling down the side of the volcano."
                                            },
                                            {
                                                "example_id": "08a164bb-9ce3-4303-b7a4-46007d10be9e",
                                                "sense_id": "4e1157d9-e6ed-3ef9-8127-dc8ccce0ac29",
                                                "text": "He then broke the kola nut and threw one of the lobes on the ground for the ancestors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cfc1660-2871-3663-9698-2ce93993dfb1",
                                        "entry_id": "760a91c9-d9da-3a3d-8986-c84fb260fb4f",
                                        "glosses": [
                                            "A clear division of an organ that can be determined at the gross anatomy level, especially one of the parts of the brain, liver or lung."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01e9a5d5-fbfa-4e1d-bee5-0bc94fd52e73",
                                                "sense_id": "8cfc1660-2871-3663-9698-2ce93993dfb1",
                                                "text": "The yawning gap in neuroscientists’ understanding of their topic is in the intermediate scale of the brain’s anatomy. Science has a passable knowledge of how individual nerve cells, known as neurons, work. It also knows which visible lobes and ganglia of the brain do what. But how the neurons are organised in these lobes and ganglia remains obscure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2ec11e2-40a6-3444-bce8-91299a1a3d77",
                                        "entry_id": "760a91c9-d9da-3a3d-8986-c84fb260fb4f",
                                        "glosses": [
                                            "A semicircular pattern left on the ice as the skater travels across it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
