            {
                "entry_id": "647fdf7e-eacc-3f4f-876f-0e37f8cd5ef1",
                "word": "cagna",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c3191253-4df4-41a3-a747-d5139ef52f22",
                        "entry_id": "647fdf7e-eacc-3f4f-876f-0e37f8cd5ef1",
                        "tags": [
                            "plural"
                        ],
                        "form": "cagnas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5455856f-d939-3020-b645-60d3884042e1",
                        "entry_id": "647fdf7e-eacc-3f4f-876f-0e37f8cd5ef1",
                        "glosses": [
                            "Soleil particulièrement chaud."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c4ba77a9-9a75-48c3-98a5-9b219a3a4ff5",
                                "sense_id": "5455856f-d939-3020-b645-60d3884042e1",
                                "text": "Les gars, là, ils leur font faire des pompes, là, en plein cagna et au milieu du djebel, en plus de ça tous groupés, avec des montagnes de chaque côté !"
                            },
                            {
                                "example_id": "96a37d8b-661c-404c-a8a4-5d91b151c79b",
                                "sense_id": "5455856f-d939-3020-b645-60d3884042e1",
                                "text": "Ils n’avaient nullement l’intention de poireauter encore des heures sous ce cagna, et encore moins de prendre racine à cet endroit !"
                            },
                            {
                                "example_id": "e289c3a3-895f-4b13-8207-3a719d2620dc",
                                "sense_id": "5455856f-d939-3020-b645-60d3884042e1",
                                "text": "Faut-il être malade pour pédaler en plein cagna !"
                            }
                        ]
                    }
                ],
