                        "examples": [
                            {
                                "example_id": "06cbd640-835f-4776-be17-d05b83af8c20",
                                "sense_id": "5129d697-b39b-3aca-8cbe-4c1c33d677fa",
                                "text": "Un peu leaubiche, le gonze ! Les coups de sabords que lui balancent les trotteuses, lors des ralentissements et des arrêts, sont sur ce point significatifs."
                            },
                            {
                                "example_id": "a75e13fc-5d2a-4060-83b7-c0d089a5bc00",
                                "sense_id": "5129d697-b39b-3aca-8cbe-4c1c33d677fa",
                                "text": "Elle ne l’aimait guère, mais cet amour filial qui la basculait dans les plus folles entreprises l’amenait à rambiner et passer l’éponge sur les aspects moins leaubiches du personnage."
                            },
                            {
                                "example_id": "baedfe4e-4e6b-4ae7-95cd-41130afb2f2a",
                                "sense_id": "5129d697-b39b-3aca-8cbe-4c1c33d677fa",
                                "text": "C’est pas leaubiche à regarder ces tronches mal rasées, sales, ces yeux ahuris de fatigue, ces bouches tordues, ces lèvres gercées de douleur, ce raisiné qui coule…"
                            }
                        ]
                    }
