{
    "word_family": [
        "vibrate",
        "vibration",
        "vibrant",
        "vibrancy",
        "vibrator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef7b35d0-23fb-31e3-ba2a-a1fb8920cbc8",
                    "sense_definition": "An atmosphere or feeling communicated by a person, place, or thing.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I get good <w>vibes</w> from the new manager.",
                            "target_lang_translations": {
                                "ru": "От нового менеджера исходит хорошая <w>энергетика</w>.",
                                "zh": "新经理给我一种很<w>好的感觉</w>。"
                            }
                        },
                        {
                            "text": "This old house gives me a creepy <w>vibe</w>.",
                            "target_lang_translations": {
                                "ru": "От этого старого дома веет жуткой <w>атмосферой</w>.",
                                "zh": "这栋老房子给我一种阴森的<w>感觉</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "good vibes",
                        "bad vibes",
                        "catch a vibe"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "very common in spoken English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Атмосфера или ощущение, исходящее от человека, места или предмета.",
                        "zh": "人、地方或事物传达出来的一种氛围或感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атмосфера",
                                "target_lang_sense_clarification": "обстановка"
                            },
                            {
                                "target_lang_word": "энергетика",
                                "target_lang_sense_clarification": "ощущение от человека или места"
                            },
                            {
                                "target_lang_word": "аура",
                                "target_lang_sense_clarification": "особое поле или ощущение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感觉",
                                "target_lang_sense_clarification": "人、地方或事物给人的整体感受"
                            },
                            {
                                "target_lang_word": "氛围",
                                "target_lang_sense_clarification": "环境或场合传达出的气息"
                            },
                            {
                                "target_lang_word": "气场",
                                "target_lang_sense_clarification": "人身上散发出的感觉，较口语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d2f4cd9-3cae-3be5-becd-cfe558016329",
                    "sense_definition": "A distinctive emotional atmosphere; something considered trendy, pleasant, or stylish.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her whole outfit is such a <w>vibe</w>.",
                            "target_lang_translations": {
                                "ru": "Её наряд — это просто <w>вайб</w>.",
                                "zh": "她这一身穿搭太有<w>氛围感</w>了。"
                            }
                        },
                        {
                            "text": "The party was fun, but the music was not the <w>vibe</w> we wanted.",
                            "target_lang_translations": {
                                "ru": "Вечеринка была веселой, но музыка — совсем не тот <w>вайб</w>, который мы хотели.",
                                "zh": "派对很好玩，但音乐不是我们想要的那种<w>氛围</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "it's a vibe",
                        "whole vibe"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особая эмоциональная атмосфера; что-то модное, приятное или стильное.",
                        "zh": "一种鲜明的情绪氛围；也可指时髦、舒服或很有风格的感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вайб",
                                "target_lang_sense_clarification": "сленг: настроение, стиль"
                            },
                            {
                                "target_lang_word": "настроение",
                                "target_lang_sense_clarification": "эмоциональное состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "氛围感",
                                "target_lang_sense_clarification": "网络和口语中常指特别有感觉、有格调的气质或氛围"
                            },
                            {
                                "target_lang_word": "风格",
                                "target_lang_sense_clarification": "指风格、调性，尤其是时髦或讨喜的感觉"
                            },
                            {
                                "target_lang_word": "感觉",
                                "target_lang_sense_clarification": "较泛，指想要的那种感觉或调调"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99267c2a-a75d-3158-ada5-990a23bdb346",
                    "sense_definition": "Short for a <w>vibraphone</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He plays the <w>vibes</w> in a local jazz band.",
                            "target_lang_translations": {
                                "ru": "Он играет на <w>вибрафоне</w> в местном джаз-банде.",
                                "zh": "他在当地一支爵士乐队里演奏<w>电颤琴</w>。"
                            }
                        },
                        {
                            "text": "The soft sound of the <w>vibes</w> filled the room.",
                            "target_lang_translations": {
                                "ru": "Мягкий звук <w>вибрафона</w> наполнил комнату.",
                                "zh": "<w>电颤琴</w>柔和的声音充满了房间。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "shortening"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от слова «вибрафон».",
                        "zh": "vibraphone（电颤琴）的简称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вибрафон",
                                "target_lang_sense_clarification": "музыкальный инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电颤琴",
                                "target_lang_sense_clarification": "乐器名，vibraphone 的简称所指"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a279150-0889-3f2d-98ef-8d002d2cbc4f",
                    "sense_definition": "To relax and enjoy oneself, often while listening to music.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "relax",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were just <w>vibing</w> to the music in the car.",
                            "target_lang_translations": {
                                "ru": "Мы просто <w>кайфовали</w> под музыку в машине.",
                                "zh": "我们只是在车里听着音乐<w>放松</w>。"
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>vibing</w> on the beach.",
                            "target_lang_translations": {
                                "ru": "Он провел день, <w>расслабляясь</w> на пляже.",
                                "zh": "他整个下午都在海滩上<w>放松</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "just vibing",
                        "vibe out"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расслабляться и получать удовольствие, часто под музыку.",
                        "zh": "放松并享受当下，常指伴着音乐轻松地待着。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кайфовать",
                                "target_lang_sense_clarification": "получать удовольствие"
                            },
                            {
                                "target_lang_word": "расслабляться",
                                "target_lang_sense_clarification": "отдыхать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放松",
                                "target_lang_sense_clarification": "处于轻松享受的状态，常伴随听音乐"
                            },
                            {
                                "target_lang_word": "享受",
                                "target_lang_sense_clarification": "享受当下、感觉很舒服，较口语"
                            },
                            {
                                "target_lang_word": "沉浸其中",
                                "target_lang_sense_clarification": "随音乐进入状态，较口语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bef8e0f0-af28-3481-93e7-708f08971655",
                    "sense_definition": "To get along well with someone or be in agreement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "agree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I really <w>vibe</w> with my new classmates.",
                            "target_lang_translations": {
                                "ru": "Я действительно <w>на одной волне</w> с моими новыми одноклассниками.",
                                "zh": "我真的跟新同学很<w>合得来</w>。"
                            }
                        },
                        {
                            "text": "His story didn't really <w>vibe</w> with the facts.",
                            "target_lang_translations": {
                                "ru": "Его история не особо <w>вязалась</w> с фактами.",
                                "zh": "他的说法和事实并不<w>吻合</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jibe"
                    ],
                    "common_phrases": [
                        "vibe with"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хорошо ладить с кем-то или быть в согласии.",
                        "zh": "与某人很合得来，或与某事相一致、相符。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть на одной волне",
                                "target_lang_sense_clarification": "хорошо понимать друг друга"
                            },
                            {
                                "target_lang_word": "ладить",
                                "target_lang_sense_clarification": "находить общий язык"
                            },
                            {
                                "target_lang_word": "вязаться",
                                "target_lang_sense_clarification": "соответствовать фактам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "合得来",
                                "target_lang_sense_clarification": "指人与人之间很投缘、相处融洽"
                            },
                            {
                                "target_lang_word": "合拍",
                                "target_lang_sense_clarification": "指彼此节奏或感觉一致，也可用于事物风格相配"
                            },
                            {
                                "target_lang_word": "吻合",
                                "target_lang_sense_clarification": "指说法或情况与事实一致"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}