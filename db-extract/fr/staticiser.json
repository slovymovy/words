                "senses": [
                    {
                        "sense_id": "8041cddd-b4cf-306a-8428-4d4119994ab9",
                        "entry_id": "ed0f21c2-49b1-3401-b250-db0b995aaa0e",
                        "glosses": [
                            "Donner un caractère statique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9593a100-8ae6-4a86-855f-d987ec1a4380",
                                "sense_id": "8041cddd-b4cf-306a-8428-4d4119994ab9",
                                "text": "Les appareils d’induction permettent, si je puis m’exprimer ainsi, de staticiser l’électricité fournie par la pile, ou, si vous aimez mieux, de transformer le courant de quantité, fourni par une pile, en courant de tension."
                            },
                            {
                                "example_id": "37d792b7-93b8-4e20-99da-3f854c06c48d",
                                "sense_id": "8041cddd-b4cf-306a-8428-4d4119994ab9",
                                "text": "Partant de l’idée qu’un itérateur pouvant être staticisé, nous avons proposé d’étendre cette traduction au monde statique à plusieurs autres modèles de conception."
                            }
                        ]
                    }
