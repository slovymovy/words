                "senses": [
                    {
                        "sense_id": "9802965f-e2f3-33cb-8fde-5b4234c2b8b9",
                        "entry_id": "97fe326b-31f2-3aaf-ab40-156f1e85e2b9",
                        "glosses": [
                            "niepanujący nad sobą; niepowściągliwy, gwałtowny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59cdd067-30dc-4f47-80ac-b015675809aa",
                                "sense_id": "9802965f-e2f3-33cb-8fde-5b4234c2b8b9",
                                "text": "Większość ludzi ryczała, rechotała, zanosiła się wielkim, nieopanowanym śmiechem"
                            },
                            {
                                "example_id": "d75adcec-da38-4ffd-be45-988b1d28c891",
                                "sense_id": "9802965f-e2f3-33cb-8fde-5b4234c2b8b9",
                                "text": "Mógł unikać rozmów, które kończyły się wybuchami nieopanowanego gniewu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f8f85d93-fc59-37f0-9895-e3757bf0599f",
                        "entry_id": "97fe326b-31f2-3aaf-ab40-156f1e85e2b9",
                        "glosses": [
                            "taki, nad którym ktoś nie panuje; niezależny od czyjej woli"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8b24d4e-f200-427d-be13-2a6dd60e0398",
                                "sense_id": "f8f85d93-fc59-37f0-9895-e3757bf0599f",
                                "text": "Uczyniła jakiś nieopanowany ruch ręką i zawadziła o talerz, zrzucając go na podłogę"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
