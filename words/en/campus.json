{
    "word_family": [
        "intercampus",
        "off-campus",
        "on-campus"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee1aa986-9a69-322c-a546-f1dc3358f3a6",
                    "sense_definition": "The grounds and buildings of a university, college, school, or large organization.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most first-year students choose to live on <w>campus</w>.",
                            "target_lang_translations": {
                                "ru": "Большинство первокурсников предпочитают жить в <w>кампусе</w>.",
                                "zh": "大多数一年级学生选择住在<w>校园</w>里。"
                            }
                        },
                        {
                            "text": "The university <w>campus</w> includes a library, a gym, and several dormitories.",
                            "target_lang_translations": {
                                "ru": "Университетский <w>кампус</w> включает в себя библиотеку, спортзал и несколько общежитий.",
                                "zh": "大学<w>校园</w>内设有图书馆、健身房和几栋宿舍楼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grounds",
                        "premises",
                        "site"
                    ],
                    "common_phrases": [
                        "on campus",
                        "off campus",
                        "college campus",
                        "university campus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория и здания университета, колледжа или школы.",
                        "zh": "大学、学院、学校或大型机构的场地和建筑物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ка́мпус",
                                "target_lang_sense_clarification": "территория университета"
                            },
                            {
                                "target_lang_word": "студгородо́к",
                                "target_lang_sense_clarification": "студенческий городок"
                            },
                            {
                                "target_lang_word": "террито́рия университе́та",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "校园",
                                "target_lang_sense_clarification": "指学校的场地和建筑"
                            },
                            {
                                "target_lang_word": "校区",
                                "target_lang_sense_clarification": "指大学的特定区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "935f54ae-d389-345f-a09a-f6a0a40b5e23",
                    "sense_definition": "A university or college considered as an educational institution and its social environment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Political protests spread across almost every <w>campus</w> in the country.",
                            "target_lang_translations": {
                                "ru": "Политические протесты охватили почти каждый <w>университетский городок</w> в стране.",
                                "zh": "政治抗议活动蔓延到了全国几乎每一个<w>校园</w>。"
                            }
                        },
                        {
                            "text": "She enjoyed the vibrant <w>campus</w> life during her years at college.",
                            "target_lang_translations": {
                                "ru": "Ей нравилась оживленная жизнь <w>кампуса</w> в студенческие годы.",
                                "zh": "她在大学期间很享受那充满活力的<w>校园</w>生活。"
                            }
                        }
                    ],
                    "synonyms": [
                        "university",
                        "college",
                        "school"
                    ],
                    "common_phrases": [
                        "campus life",
                        "campus politics"
                    ],
                    "target_lang_definitions": {
                        "ru": "Университет или колледж как образовательное учреждение и социальная среда.",
                        "zh": "作为教育机构及其社会环境的大学或学院。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "университе́т",
                                "target_lang_sense_clarification": "учебное заведение"
                            },
                            {
                                "target_lang_word": "ка́мпус",
                                "target_lang_sense_clarification": "социальная среда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "校园",
                                "target_lang_sense_clarification": "指学校的社会环境和氛围"
                            },
                            {
                                "target_lang_word": "大学",
                                "target_lang_sense_clarification": "指教育机构本身"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30a3e733-4176-3543-9365-ce5c36c415b3",
                    "sense_definition": "To punish a student by forbidding them from leaving the school grounds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The headmaster <w>campused</w> the student for breaking the curfew rules.",
                            "target_lang_translations": {
                                "ru": "Директор <w>запретил</w> студенту <w>покидать территорию</w> за нарушение комендантского часа.",
                                "zh": "校长因为学生违反宵禁规定而对他进行了<w>禁足</w>处罚。"
                            }
                        },
                        {
                            "text": "He was <w>campused</w> for the weekend and could not go to the cinema.",
                            "target_lang_translations": {
                                "ru": "Ему <w>запретили выходить с территории</w> на выходные, и он не смог пойти в кино.",
                                "zh": "他周末被<w>禁足</w>了，没法去看电影。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confine",
                        "restrict"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used in the context of boarding schools or older university traditions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наказывать студента запретом покидать территорию учебного заведения.",
                        "zh": "通过禁止学生离开学校场地来惩罚学生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запреща́ть вы́ход",
                                "target_lang_sense_clarification": "с территории"
                            },
                            {
                                "target_lang_word": "лиша́ть увольни́тельной",
                                "target_lang_sense_clarification": "устаревшее/военное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "禁足",
                                "target_lang_sense_clarification": "禁止离开学校"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a251cf4-e628-38db-917d-1f50a3602ad5",
                    "sense_definition": "To climb a route using only the hands and arms, without using the feet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "climbing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>campused</w> up the steep wall to build his upper body strength.",
                            "target_lang_translations": {
                                "ru": "Он <w>закампусил</w> крутую стену, чтобы укрепить верхнюю часть тела.",
                                "zh": "他通过在陡峭的墙壁上<w>手攀</w>来增强上肢力量。"
                            }
                        },
                        {
                            "text": "The climber <w>campused</w> the overhang because there were no footholds.",
                            "target_lang_translations": {
                                "ru": "Скалолаз <w>прошел на руках</w> нависание, потому что там не было опор для ног.",
                                "zh": "由于没有落脚点，攀岩者在悬垂岩壁上采用了<w>手攀</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "climbing jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лезть по маршруту, используя только руки, без помощи ног.",
                        "zh": "攀岩术语，指仅用手和手臂攀爬，不使用脚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кампуси́ть",
                                "target_lang_sense_clarification": "сленг скалолазов"
                            },
                            {
                                "target_lang_word": "ле́зть на рука́х",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手攀",
                                "target_lang_sense_clarification": "攀岩术语，仅用手攀爬"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}