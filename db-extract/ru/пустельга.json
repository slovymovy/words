                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fcd1173-6e31-3f5e-9da6-85ef0e9d48a3",
                        "entry_id": "59daad79-0766-3aa2-ad67-a3fdfea2f83a",
                        "glosses": [
                            "орнитол. хищная птица семейства соколиных, питающаяся грызунами и насекомыми (Falco tinnunculus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a1e128a-07ec-4510-8586-fab63eb06d83",
                                "sense_id": "1fcd1173-6e31-3f5e-9da6-85ef0e9d48a3",
                                "text": ".. ястреба, кобчики, пустельги со свистом носились над неподвижными верхушками [деревьев] .."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf8c3499-4997-329c-a327-b96bd6e32a12",
                        "entry_id": "59daad79-0766-3aa2-ad67-a3fdfea2f83a",
                        "glosses": [
                            "разг., пренебр. несерьёзный, пустой, легкомысленный человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1429a1c0-2673-46ca-b63d-a7ee7360fa75",
                                "sense_id": "cf8c3499-4997-329c-a327-b96bd6e32a12",
                                "text": "А ты смотри, дура, — сказал он сердито Манюшке, — за добро плати добром, не будь пустельгой."
                            }
                        ]
                    },
                    {
                        "sense_id": "62704812-a383-3169-be8f-2a456a2fda5a",
                        "entry_id": "59daad79-0766-3aa2-ad67-a3fdfea2f83a",
                        "glosses": [
                            "перен., разг. пустячок (по созвучию), вещица — о художественном произведении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8812278-ec9b-4358-a461-d48399d6a5d2",
                                "sense_id": "62704812-a383-3169-be8f-2a456a2fda5a",
                                "text": "Театральная пиеска имела двойное название; первого не помню, а второе было: «Драматическая пустельга»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41938c05-b04b-45ef-9c37-af171874207d",
                        "source_entry_id": "59daad79-0766-3aa2-ad67-a3fdfea2f83a",
                        "source_sense_description": "птица",
                        "target_lang_word": "kestrel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kestrel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a318fe4-8116-3642-8e2a-d8217547f15f",
                                        "entry_id": "657af29d-6ebe-3def-8312-ceb210ec49bf",
                                        "glosses": [
                                            "Any of various small falcons of the genus Falco that hover while hunting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b54a0d2d-ac97-4a65-bf69-4ee92903da7b",
                                                "sense_id": "5a318fe4-8116-3642-8e2a-d8217547f15f",
                                                "text": "When she was musing she was a kestrel, which hangs in the air by an invisible motion of its wings."
                                            },
                                            {
                                                "example_id": "5ca074eb-56b0-4533-910a-ba79cb460365",
                                                "sense_id": "5a318fe4-8116-3642-8e2a-d8217547f15f",
                                                "text": "Up on the downs the red-eyed kestrels hover,\nEyeing the grass.\nThe field mouse flits like a shadow into cover\nAs their shadows pass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3adeddf-dc2f-3d9c-9bee-93916b675e61",
                                        "entry_id": "657af29d-6ebe-3def-8312-ceb210ec49bf",
                                        "glosses": [
                                            "A common kestrel (Falco tinnunculus)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b28dda95-2a04-4f15-832d-8d7dc9f0c01d",
                        "source_entry_id": "59daad79-0766-3aa2-ad67-a3fdfea2f83a",
                        "source_sense_description": "птица",
