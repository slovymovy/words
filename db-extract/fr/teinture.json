                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a8fd2df-e832-4527-ba80-fc9758087c20",
                                                "sense_id": "175b6eb6-78b7-367a-958f-eb70d88b21ac",
                                                "text": "Ninety per cent of the dyeings on silk, 72 per cent of the dyeings on rayon, 70 per cent of the dyeings on cotton showed no color change."
                                            },
                                            {
                                                "example_id": "39f6fe90-bdad-4ce6-81d1-178a6302c686",
                                                "sense_id": "175b6eb6-78b7-367a-958f-eb70d88b21ac",
                                                "text": "In the traditional workshops of Surakarta, where the best quality batik tulis textiles are still created, low-paid women and girls use melted wax to meticulously hand-draw patterns before subsequent dyeings and rewaxings, […]"
                                            }
                                        ]
