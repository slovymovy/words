    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9e63376c-13e6-31c4-8a44-79290bd9f999",
                    "sense_definition": "Causing immense fear; extremely scary",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The idea of speaking in front of such a large audience was <w>petrifying</w>.",
                            "target_lang_translations": {
                                "nl": "Het idee om voor zo'n groot publiek te spreken was <w>doodeng</w>."
                            }
                        },
                        {
                            "text": "Walking alone through the dark forest at night was a <w>petrifying</w> experience.",
                            "target_lang_translations": {
                                "nl": "Alleen door het donkere bos lopen 's nachts was een <w>angstaanjagende</w> ervaring."
                            }
                        }
                    ],
                    "synonyms": [
                        "frightening",
                        "terrifying"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets dat enorme angst inboezemt; extreem beangstigend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "doodeng",
                                "target_lang_sense_clarification": "zeer beangstigend, informeel"
                            },
                            {
                                "target_lang_word": "angstaanjagend",
                                "target_lang_sense_clarification": "formeel, veroorzaakt grote angst"
                            },
                            {
                                "target_lang_word": "huiveringwekkend",
                                "target_lang_sense_clarification": "doet rillingen bezorgen van angst"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e28b4eb7-028f-3955-b345-1741a85adeef",
                    "sense_definition": "Present participle and gerund of <w>petrify</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant pressure of the water is <w>petrifying</w> the wood into stone.",
                            "target_lang_translations": {
                                "nl": "De constante druk van het water is het hout aan het <w>verstenen</w> tot steen."
                            }
                        },
                        {
                            "text": "He was <w>petrifying</w> his audience with a cold and unmoving stare.",
                            "target_lang_translations": {
                                "nl": "Hij was zijn publiek aan het <w>verstijven</w> met een koude en onbeweeglijke blik."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het proces waarbij iets in steen verandert, of iemand verstijfd van angst achterlaten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verstenend",
                                "target_lang_sense_clarification": "het proces van verandering in steen"
                            },
                            {
                                "target_lang_word": "verstijvend",
                                "target_lang_sense_clarification": "iemand onbeweeglijk maken door angst"
                            }
                        ]
                    }
                }
            ]
        }
    ]
