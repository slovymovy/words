                ],
                "translations": [
                    {
                        "translation_id": "87c9f4cd-4a1e-4b53-8232-26d0ee49f744",
                        "source_entry_id": "8096b4ae-092d-33f8-ad40-f6726e535647",
                        "source_sense_id": "d37dceaf-86d6-375c-aa77-a28860286e64",
                        "target_lang_word": "analytička",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "db14bb25-8e5a-432c-9c8e-53b3d0503afe",
                        "source_entry_id": "8096b4ae-092d-33f8-ad40-f6726e535647",
                        "source_sense_id": "d37dceaf-86d6-375c-aa77-a28860286e64",
                        "target_lang_word": "Analytikerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Analytikerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "694e82ab-942f-3873-93b6-46d400b6480b",
                                        "entry_id": "70f228a7-c80a-3814-aab4-051b329b6c66",
                                        "glosses": [
                                            "weibliche Person, die einen komplexen Sachverhalt im Detail untersucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4330fdbe-1a5f-424f-82cb-4e134298d09e",
                                                "sense_id": "694e82ab-942f-3873-93b6-46d400b6480b",
                                                "text": "„Allerdings hat Heidegger 1933 auch eine Verbeugung vor Hitler gemacht, die bis heute unvergessen ist. Aber wenn ihm seine jüdische Geliebte Hannah Arendt, die Analytikerin des Totalitarismus, verziehen hat, dürfen wir das auch.“"
                                            },
                                            {
                                                "example_id": "03f14e39-7553-4fb2-adfe-82fe311666ab",
                                                "sense_id": "694e82ab-942f-3873-93b6-46d400b6480b",
                                                "text": "„Als Hauptgründe für die Entscheidung der Zentralbank nannte die Analytikerin der Raiffeisenbank Helena Horska das hektische Wachstum der Industrieproduktion sowie der Exporte und die erneute Bereitschaft der Haushalte Geld auszugeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cab200ae-aa67-3791-9452-617910305041",
                                        "entry_id": "70f228a7-c80a-3814-aab4-051b329b6c66",
                                        "glosses": [
                                            "weibliche Person, die die Analytik (Schluss- und Beweislehre in der Logik) beherrscht"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0bedd13-219d-4d17-840d-20e7b5c856a2",
                                                "sense_id": "cab200ae-aa67-3791-9452-617910305041",
                                                "text": "Die Aufgabe der Analytikerin umfasst die Lösung technischer, wissenschaftlicher oder kommerzieller Aufgaben mit Hilfe der elektronischen Datenverarbeitung (EDV)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "070c263e-4406-3113-9c65-37802ff2b35f",
                                        "entry_id": "70f228a7-c80a-3814-aab4-051b329b6c66",
                                        "glosses": [
                                            "weibliche Person, die in der Lage ist, eine Psychoanalyse durchzuführen"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Psychoanalyse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d30967-1f5a-47be-92ce-bfe94e3e6fe3",
                                                "sense_id": "070c263e-4406-3113-9c65-37802ff2b35f",
                                                "text": "„Durch diese Einfälle und mit der Hilfe der Analytikerin lernt er langsam eine innere Welt kennen, die er zuvor nicht oder nicht in dieser Weise gekannt hat. Gelingt es, die Schwierigkeiten bei ihrer Erforschung zu überwinden, so erschließen sich die innersten Wünsche und Sehnsüchte ebenso wie diejenigen seelischen Kräfte, die die Befriedigung dieser Wünsche verhindern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
