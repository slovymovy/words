                ],
                "senses": [
                    {
                        "sense_id": "a67b32de-a5b3-3580-9a0a-676a50c2a06a",
                        "entry_id": "ca39a238-b157-3657-9eda-3da78b669375",
                        "glosses": [
                            "unerwünschter, kurzer elektrischer Impuls, der zu Fehlfunktionen in Geräten führen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8de559fb-7b1e-498d-abc9-d9a354ab8d7e",
                                "sense_id": "a67b32de-a5b3-3580-9a0a-676a50c2a06a",
                                "text": "„Im ZF-Verstärker werden kurzzeitige Störimpulse detektiert und das ZF-Signal für die Dauer der Störung komplett ausgetastet.“"
                            },
                            {
                                "example_id": "c7eedfd7-72a8-4507-8736-93709a4c6945",
                                "sense_id": "a67b32de-a5b3-3580-9a0a-676a50c2a06a",
                                "text": "„Das Ausschalten führt insbesondere bei induktiven Lasten zu einem Störimpuls, der sich auf den Netzleitungen ausbreitet und andere Verbraucher stört.“"
                            },
                            {
                                "example_id": "e95a226b-ef82-43b3-84ee-2cb2a241b6fe",
                                "sense_id": "a67b32de-a5b3-3580-9a0a-676a50c2a06a",
                                "text": "„Auf den Leiter I wird von einem Sender (Ausgang eines Schaltgliedes) eine positive Impulsflanke geschaltet, dadurch entsteht auf dem benachbarten Leiter II ein Störimpuls.“"
                            },
                            {
                                "example_id": "1b0ad66d-5cc2-40a7-873b-2f215961f39c",
                                "sense_id": "a67b32de-a5b3-3580-9a0a-676a50c2a06a",
                                "text": "„Ist die Breite des Störimpulses größer als die Gatterdurchlaufzeit, so ist der statische Störspannungsabstand (Bild 3.2) maßgebend, ansonsten der dynamische (Bild 3.3).“"
                            },
                            {
                                "example_id": "14d67106-e5a0-4d69-95e7-103e512e12c7",
                                "sense_id": "a67b32de-a5b3-3580-9a0a-676a50c2a06a",
                                "text": "„Im Fahrzeugbordnetz können Störimpulse in erheblichem Maße auftreten und Funktionsstörungen oder sogar Elektronikausfälle hervorrufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03cf0cf4-b485-4426-aaee-dd930b6f8480",
                        "source_entry_id": "ca39a238-b157-3657-9eda-3da78b669375",
                        "source_sense_id": "a67b32de-a5b3-3580-9a0a-676a50c2a06a",
                        "source_sense_description": "Elektrotechnik: unerwünschter, kurzer elektrischer Impuls, der zu Fehlfunktionen in Geräten führen kann",
                        "target_lang_word": "glitch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glitch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f6f8041-1f93-33bd-9678-9de6fd1af234",
                                        "entry_id": "5d577945-d1e7-375a-ab02-7aaefb53d5fd",
                                        "glosses": [
                                            "A problem affecting function."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01b83109-8cbd-4261-b43d-26013a39f1b4",
                                                "sense_id": "6f6f8041-1f93-33bd-9678-9de6fd1af234",
                                                "text": "They are still trying to work out all the glitches."
                                            },
                                            {
                                                "example_id": "ef22eb22-3bda-484a-8dc7-c1b51f8b9cac",
                                                "sense_id": "6f6f8041-1f93-33bd-9678-9de6fd1af234",
                                                "text": "Glitches—a spaceman’s word for irritating disturbances."
                                            },
                                            {
                                                "example_id": "e9524435-902e-4d94-8ee0-57a84b370f48",
                                                "sense_id": "6f6f8041-1f93-33bd-9678-9de6fd1af234",
                                                "text": "A déjà vu is usually a glitch in the Matrix. It happens when they change something."
                                            },
                                            {
                                                "example_id": "015724d0-b5c7-4887-a43a-44cbdef652fc",
                                                "sense_id": "6f6f8041-1f93-33bd-9678-9de6fd1af234",
                                                "text": "Some claimed on Monday that Foodpanda's account deletion system reported being under maintenance and could not process their request. It is unclear if the flock of requests had created a system failure, or Foodpanda had cut access on purpose, or the timing was merely a coincidence. The glitch only added fuel to online sympathizers' outrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f0bd1c2-4b35-347c-9451-4aeb02db8e1e",
                                        "entry_id": "5d577945-d1e7-375a-ab02-7aaefb53d5fd",
                                        "glosses": [
                                            "An unexpected behavior in an electrical signal, especially if the signal spontaneously returns to expected behavior after a period of time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15fb129e-14b0-4200-8245-216e8826a24f",
                                                "sense_id": "7f0bd1c2-4b35-347c-9451-4aeb02db8e1e",
                                                "text": "Another term we adopted to describe some of our problems was \"glitch.\" Literally, a glitch is a spike or change in voltage in an electrical circuit which takes place when the circuit suddenly has a new load put on it. You have probably noticed a dimming of lights in your home when you turn a switch or start the dryer or the television set."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "762650ad-54c5-3606-ba4d-964d0de64343",
                                        "entry_id": "5d577945-d1e7-375a-ab02-7aaefb53d5fd",
                                        "glosses": [
                                            "A bug or an exploit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba1adb4b-9ae7-4d3e-aac4-ef9684602a3a",
                                                "sense_id": "762650ad-54c5-3606-ba4d-964d0de64343",
                                                "text": "Performing this glitch gives you extra lives."
                                            },
                                            {
                                                "example_id": "36ddbd00-14ad-4c8d-ae48-abd4f681b5ee",
                                                "sense_id": "762650ad-54c5-3606-ba4d-964d0de64343",
                                                "text": "How to reach 8.555 ー The glitch\nYou need to have Wrex alive and sabotage the cure. Without the glitch, Wrex will discover the lie and try to kill you after Priority: Citadel II when you try to go back to the Normandy. Triggering this scene will remove Wrex and the Clan Urdnot in the war assets list\nThe glitch is easy, when you want to leave the Citadel, simply go to a fast travel shuttle, then in a DLC area (Dr. Bryson's Lab or Silversun Strip)\nThen again the shuttle, and go back to the Normandy from here"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b3efbe3-3749-32d7-847a-aa06a7537263",
                                        "entry_id": "5d577945-d1e7-375a-ab02-7aaefb53d5fd",
                                        "glosses": [
                                            "A genre of experimental electronic music since the 1990s, characterized by a deliberate use of sonic artifacts that would normally be viewed as unwanted noise."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1462e94-2cc0-42a0-a4b9-73e50db0dc2e",
                                                "sense_id": "0b3efbe3-3749-32d7-847a-aa06a7537263",
                                                "text": "You can hear this in the contemporary genre of ‘glitch’, where artists like Oval and Fennesz make radically beautiful music using the snaps, crackles and pops emitted by damaged CDs, malfunctioning software, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb2dfb54-97c4-37d6-b3d3-03998c4adff5",
                                        "entry_id": "5d577945-d1e7-375a-ab02-7aaefb53d5fd",
                                        "glosses": [
                                            "A sudden increase in the rotational frequency of a pulsar."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "glitch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b3e3de-9c7a-3190-888b-60a7e3dcf831",
                                        "entry_id": "53e59919-17ee-3956-ae7a-95d79f424252",
                                        "glosses": [
                                            "To experience an unexpected, typically intermittent malfunction."
                                        ],
                                        "tags": [
                                            "especially",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b0f862e-409b-4981-a01b-3ce0adf4361f",
                                                "sense_id": "a4b3e3de-9c7a-3190-888b-60a7e3dcf831",
                                                "text": "My computer keeps glitching; every couple of hours it just reboots without warning."
                                            },
                                            {
                                                "example_id": "326c59d9-c840-4165-ba2d-497872cbcdfb",
                                                "sense_id": "a4b3e3de-9c7a-3190-888b-60a7e3dcf831",
                                                "text": "Jake’s parents, played unnervingly well by Colette and Thewlis, are like alien robots who have been programmed to behave like human beings, but keep glitching."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f7e7853-bf3f-386d-bef8-1359e70cf9be",
                                        "entry_id": "53e59919-17ee-3956-ae7a-95d79f424252",
                                        "glosses": [
                                            "To perform an exploit or recreate a bug while playing a video game."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8add4286-1b00-4ea6-bd6d-75cf3bcfabca",
                                                "sense_id": "6f7e7853-bf3f-386d-bef8-1359e70cf9be",
                                                "text": "His character will glitch into the wall and out of the level."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
