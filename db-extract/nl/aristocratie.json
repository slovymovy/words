                "senses": [
                    {
                        "sense_id": "c7471d0e-d97e-3dea-9cff-4a9ca2ad8ce5",
                        "entry_id": "7a573010-8df4-3116-b2b0-34964a3f5155",
                        "glosses": [
                            "aristocracy (nobility, or the hereditary ruling class.)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "314e3bb3-b075-4efc-be75-12780f53b276",
                                "sense_id": "c7471d0e-d97e-3dea-9cff-4a9ca2ad8ce5",
                                "text": "In vele samenlevingen speelde de aristocratie een dominante rol in de politiek.",
                                "translation": "In many societies, the aristocracy played a dominant role in politics.",
                                "english": "In many societies, the aristocracy played a dominant role in politics."
                            },
                            {
                                "example_id": "1b0b2d3a-cfc9-4faf-8ed1-c81f6d48817c",
                                "sense_id": "c7471d0e-d97e-3dea-9cff-4a9ca2ad8ce5",
                                "text": "Het kasteel werd vroeger bewoond door leden van de aristocratie.",
                                "translation": "The castle was formerly inhabited by members of the aristocracy.",
                                "english": "The castle was formerly inhabited by members of the aristocracy."
                            },
                            {
                                "example_id": "538ffeba-fa7f-4d98-88c8-baae6d4c96fb",
                                "sense_id": "c7471d0e-d97e-3dea-9cff-4a9ca2ad8ce5",
                                "text": "De aristocratie had veel land en rijkdom in haar bezit.",
                                "translation": "The aristocracy held much land and wealth.",
                                "english": "The aristocracy held much land and wealth."
                            }
                        ]
                    },
                    {
                        "sense_id": "8689c9c9-20d5-3acc-b1b4-992b4b120148",
                        "entry_id": "7a573010-8df4-3116-b2b0-34964a3f5155",
                        "glosses": [
                            "aristocracy (government by an aristocratic class)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "ee1eda90-3041-4124-b0bc-10db5ca6d17c",
                                "sense_id": "8689c9c9-20d5-3acc-b1b4-992b4b120148",
                                "text": "Tijdens die periode werd het land geregeerd door een aristocratie.",
                                "translation": "During that period, the country was governed by an aristocracy.",
                                "english": "During that period, the country was governed by an aristocracy."
                            },
                            {
                                "example_id": "e6d6d614-abe6-4755-91b4-c2afdcc1c562",
                                "sense_id": "8689c9c9-20d5-3acc-b1b4-992b4b120148",
                                "text": "Critici beweerden dat de aristocratie niet in het belang van het volk handelde.",
                                "translation": "Critics claimed that the aristocracy did not act in the interest of the people.",
                                "english": "Critics claimed that the aristocracy did not act in the interest of the people."
                            },
                            {
                                "example_id": "9acb386c-24be-4740-a7d9-4f43dde1e9fa",
                                "sense_id": "8689c9c9-20d5-3acc-b1b4-992b4b120148",
                                "text": "Veel landen zijn geëvolueerd van aristocratie naar democratie.",
                                "translation": "Many countries evolved from aristocracy to democracy.",
                                "english": "Many countries evolved from aristocracy to democracy."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2f7d286-d68c-3389-90b3-e4048bd34433",
                        "entry_id": "7a573010-8df4-3116-b2b0-34964a3f5155",
                        "glosses": [
                            "aristocracy, nobility (upper crust, top people)"
                        ],
                        "tags": [
                            "feminine",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d8eb8f36-6f81-4d68-bbd2-7d9d4aa6fdfe",
                                "sense_id": "b2f7d286-d68c-3389-90b3-e4048bd34433",
                                "text": "Ze werd beschouwd als deel van de culturele aristocratie.",
                                "translation": "She was considered part of the cultural aristocracy.",
                                "english": "She was considered part of the cultural aristocracy."
                            },
                            {
                                "example_id": "6fd68dfa-d9bd-44a5-b567-4a20873a0fed",
                                "sense_id": "b2f7d286-d68c-3389-90b3-e4048bd34433",
                                "text": "In de mode-industrie behoren bepaalde designers tot de aristocratie.",
                                "translation": "In the fashion industry, certain designers belong to the aristocracy.",
                                "english": "In the fashion industry, certain designers belong to the aristocracy."
                            },
                            {
                                "example_id": "85b4525d-f132-441b-969b-e21575415392",
                                "sense_id": "b2f7d286-d68c-3389-90b3-e4048bd34433",
                                "text": "De literaire aristocratie van het land kwam bijeen voor het festival.",
                                "translation": "The literary aristocracy of the country gathered for the festival.",
                                "english": "The literary aristocracy of the country gathered for the festival."
                            }
                        ]
                    }
