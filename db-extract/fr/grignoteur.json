                "senses": [
                    {
                        "sense_id": "98723931-6318-37f5-9246-73fb3adc7436",
                        "entry_id": "f219d79e-04b0-3cad-a5ba-2971c240af15",
                        "glosses": [
                            "Personne qui grignote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84a2cffc-25d9-4868-ae67-ad0e8dc41eac",
                                "sense_id": "98723931-6318-37f5-9246-73fb3adc7436",
                                "text": "Et pour peu que notre mondain se double d’un gastronome, on comprend qu’il soit vexé d’être comparé à un grignoteur de croûtons de pain quand on est habitué aux homards grillés et au salmis de bécasses."
                            }
                        ]
                    },
                    {
                        "sense_id": "c66aad01-62c9-34c9-bcbe-7b85340191ac",
                        "entry_id": "f219d79e-04b0-3cad-a5ba-2971c240af15",
                        "glosses": [
                            "Objet permettant aux bébés de grignoter des aliments sans s'étouffer."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55317414-074b-484a-ab61-ed6e4b2735b0",
                        "source_entry_id": "f219d79e-04b0-3cad-a5ba-2971c240af15",
                        "target_lang_word": "nibbler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nibbler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d065c7e-6cc7-33a2-9b71-73cd8c65693a",
                                        "entry_id": "77d29868-bb46-356c-a70a-b4122540db86",
                                        "glosses": [
                                            "Someone who nibbles (in various senses)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c47f3af1-93bd-4af9-b9ba-fc3640f04f29",
                                                "sense_id": "1d065c7e-6cc7-33a2-9b71-73cd8c65693a",
                                                "text": "But whether unripe years did want conceit, / Or he refused to take her figured proffer, / The tender nibbler would not touch the bait, / But smile and jest at every gentle offer:"
                                            },
                                            {
                                                "example_id": "f2184580-cb7f-448e-ae00-71fe40bc4c67",
                                                "sense_id": "1d065c7e-6cc7-33a2-9b71-73cd8c65693a",
                                                "text": "The dog's lean, powerful body dashed down the hill. When the dust of his violence cleared, a sea of dirty white backs was wobbling up the hill, a black-and-white quickness darting now here, now there, straightening the line, hurrying a nibbler, urging a straggler."
                                            },
                                            {
                                                "example_id": "de3381af-4da5-46b6-9352-4a62d5ad4e92",
                                                "sense_id": "1d065c7e-6cc7-33a2-9b71-73cd8c65693a",
                                                "text": "1949, Guiding Family Spending, U.S. Department of Agriculture Miscellaneous Publication No. 661, p. 10, https://books.google.ca/books?id=wxsuAAAAYAAJ&printsec=frontcover#v=onepage&q&f=false\nIn carrying out a spending plan, accounts are usually most important for controlling small recurring expenditures as for newspapers, magazines, tobacco, movies, soft drinks, ice cream, and meals eaten out. Many families look upon these as incidentals and may treat them as unimportant. But they may be nibblers, eating away day by day money that is wanted for other things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4de4aa7-584a-3f1c-9b9d-bc738bbc4663",
                                        "entry_id": "77d29868-bb46-356c-a70a-b4122540db86",
                                        "glosses": [
                                            "A tool for cutting sheet metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1783631a-9ba1-3765-962b-79a4bf2fac54",
                                        "entry_id": "77d29868-bb46-356c-a70a-b4122540db86",
                                        "glosses": [
                                            "A fish of the sea chub subfamily Girellinae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb64281b-3822-3160-964e-8f2a3cc0b5c5",
                                        "entry_id": "77d29868-bb46-356c-a70a-b4122540db86",
                                        "glosses": [
                                            "A program for copying floppy disks at a low level (typically one bit at a time) to circumvent protection systems."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94174404-758a-4d5d-8aef-459c314ea727",
                                                "sense_id": "fb64281b-3822-3160-964e-8f2a3cc0b5c5",
                                                "text": "A-Copier. MegaSoft, Ltd. Full Featured Nibbler."
                                            },
                                            {
                                                "example_id": "fd70fd35-206d-4791-a747-8defd2d76fe5",
                                                "sense_id": "fb64281b-3822-3160-964e-8f2a3cc0b5c5",
                                                "text": "We used a program call Fast Hack 'Em. It had what was called a 'Nibbler'. It had the copy protection schemes for various games stored on one of the program disks, and you would load that up before copying the game. It then 'nibbled' away the protection from the data as it was copied."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
