                    {
                        "sense_id": "189594f8-423b-3519-90b9-00d159099919",
                        "entry_id": "057518a3-20bc-3de8-a4fa-731b0d6fe40e",
                        "glosses": [
                            "vrouw die door de rechter is aangewezen om het beheer te voeren over de bezittingen van een natuurlijk persoon of van een rechtspersoon"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "48fdc61e-6ec1-4f22-af91-2dced37457fc",
                                "sense_id": "189594f8-423b-3519-90b9-00d159099919",
                                "text": "Voor de failliet met een persoonsgebonden onderneming is een faillissement een trieste aangelegenheid. Van de ene dag op de ander wordt je als een imbeciel behandeld. Je moet overal van afblijven. Een curator of curatrice met de levenservaring van een schaap regelt je zaken."
                            }
                        ]
                    },
                    {
                        "sense_id": "96c109f5-6dcd-356a-aafe-64ca643701a5",
                        "entry_id": "057518a3-20bc-3de8-a4fa-731b0d6fe40e",
                        "glosses": [
                            "vrouwelijk lid van de raad van toezicht over een instelling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b10e0774-fc7f-418f-84a2-dbca925a70a1",
                                "sense_id": "96c109f5-6dcd-356a-aafe-64ca643701a5",
                                "text": "Zij was mede-oprichtster van de Stichting Gaudeamus die dit jaar 25 jaar bestaat. Tot vorig jaar was ze curatrice van de stichting."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb05baa0-cf64-347e-ae5e-639db8ccf041",
                        "entry_id": "057518a3-20bc-3de8-a4fa-731b0d6fe40e",
                        "glosses": [
                            "vrouw die verantwoordelijk draagt voor het samenstellen van van een collectie of tentoonstelling"
                        ],
                        "tags": [
                            "beroep",
                            "cultuur"
                        ],
                        "examples": [
                            {
                                "example_id": "1dbab4cc-d686-4f19-a12e-ae46e5083c92",
                                "sense_id": "eb05baa0-cf64-347e-ae5e-639db8ccf041",
                                "text": "De voorzitter is Mhr. H. Blauvelt, de curatrice van het Museum der Vereeniging is Mvr. F.A. Westervelt, aan wier trouwe en jarenlange zorgen het Museum zijn oorsprong en groei te danken heeft."
                            }
                        ]
                    }
