                        "glosses": [
                            "verpersoonlijking van een bepaalde stad als een vrouwelijke figuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e20e4cc2-bfcd-4fa1-b804-307986725874",
                                "sense_id": "2d2bd01e-95d2-364e-bce0-a33960bdf8da",
                                "text": "Ook Nederlandse steden kenden in de Renaissance stedenmaagden, verpersoonlijkingen van een stad in de gedaante van een maagd. Een voorbeeld is de stedenmaagd van Amsterdam, die in het verleden met haar verschijning titelpagina's van boeken opluisterde."
                            },
                            {
                                "example_id": "fdca399f-6028-4104-9864-2ebadf94c277",
                                "sense_id": "2d2bd01e-95d2-364e-bce0-a33960bdf8da",
                                "text": "Industrie was er in de vroege negentiende eeuw nog maar weinig. Niet de machine, maar de bijenkorf, engelen met vleugels en de stedenmaagd waren er een symbool voor de economie."
                            }
                        ]
                    }
