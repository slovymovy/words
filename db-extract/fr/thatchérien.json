                        "glosses": [
                            "Qui est propre à Margaret Thatcher, se rapporte à son action, à sa doctrine, à ses politiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d510c7b-a9e1-4db7-8081-a5be66c09add",
                                "sense_id": "bdcb7786-f3d8-30ed-b1d9-705e89dd887d",
                                "text": "La télésérie The New Statesman qui connut un succès considérable en Grande-Bretagne, est une critique très acide de la politique thatchérienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "111111db-2ebf-3c15-a568-4f8f3c64ce81",
                        "entry_id": "5f4d3aa7-d7e6-34bc-8b9c-62ccb5821412",
                        "glosses": [
                            "Qui évoque ou rappelle l’action, la doctrine, les politiques de Margaret Thatcher; qui s’en réclame ou s’en inspire."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3d5d3001-8cfe-48dd-9160-a94a6efd4327",
                                "sense_id": "111111db-2ebf-3c15-a568-4f8f3c64ce81",
                                "text": "Il avait anticipé la radicalisation des projets pour conquérir l’électorat à gauche, avec Benoît Hamon, mais aussi à droite avec François Fillon, plébiscité en promettant un programme très thatchérien."
                            }
                        ]
                    },
