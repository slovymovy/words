                                "target_senses": [
                                    {
                                        "sense_id": "458ed3a1-d008-3509-9878-7d6d23761bee",
                                        "entry_id": "85bcdcc1-4680-3d63-907f-91192b3d4c32",
                                        "glosses": [
                                            "To swing the back of a vehicle (originally an aircraft) from side to side."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a660b15-3af3-4c11-9828-bc064b1ed562",
                                                "sense_id": "458ed3a1-d008-3509-9878-7d6d23761bee",
                                                "text": "As we approached the runway, the pilot fishtailed slightly to reduce landing speed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "886f8767-1063-3604-bc23-865946458bea",
                                        "entry_id": "85bcdcc1-4680-3d63-907f-91192b3d4c32",
                                        "glosses": [
                                            "To cause the back of (a vehicle) to swing from side to side."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c0eae9e-8ff4-46fd-85be-e6a66b9f00b7",
                                                "sense_id": "886f8767-1063-3604-bc23-865946458bea",
                                                "text": "But Bruce wasn't done baiting the jocks. He fishtailed the car; it swerved and reversed direction, heading straight for the three jocks who were chasing them on foot. It looked like he was going to run the car over the three men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef967088-411c-3780-a09d-04893e412c57",
                                        "entry_id": "85bcdcc1-4680-3d63-907f-91192b3d4c32",
                                        "glosses": [
                                            "To move with the tail swinging from side to side in this way."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e7de874-9787-406b-8a90-adaf74318384",
                                                "sense_id": "ef967088-411c-3780-a09d-04893e412c57",
                                                "text": "A large black and gold butterfly fish-tailed in and landed on a hydrangea bush almost at my elbow, moved its wings slowly up and down a few times, then took off heavily […]"
                                            },
                                            {
                                                "example_id": "c398f5c4-9189-48c9-995c-d7c8088a797b",
                                                "sense_id": "ef967088-411c-3780-a09d-04893e412c57",
                                                "text": "She'd sprinted away like Betty Cuthbert and the blue F.J. Holden was fishtailing up the street as fast as it could go."
                                            },
                                            {
                                                "example_id": "1c666e0a-fd58-44ed-821c-455cf837fae9",
                                                "sense_id": "ef967088-411c-3780-a09d-04893e412c57",
                                                "text": "Having reversed at Eastbourne, I am in the trailing car, which leaps and fishtails around so much on our way to Bexhill that I have trouble writing coherent notes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c776d88f-be40-4ddf-ab4f-2b7f3856a14a",
