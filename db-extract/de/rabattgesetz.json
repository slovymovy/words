                "senses": [
                    {
                        "sense_id": "468bafc7-7a63-3382-89ea-e5749592a1d9",
                        "entry_id": "04d2c1cb-5f90-3683-90f7-a40c3258fbff",
                        "glosses": [
                            "Gesetz, das die Gewährung von Preisnachlässen auf Waren oder Dienstleistungen regelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c11bcf-dab9-438a-a6cd-6cbf89432bee",
                                "sense_id": "468bafc7-7a63-3382-89ea-e5749592a1d9",
                                "text": "„Das Rabattgesetz war ein deutsches Gesetz auf dem Gebiet des Wettbewerbsrechts. Es galt vom 1. Januar 1934 bis zum 25. Juli 2001.“"
                            },
                            {
                                "example_id": "c62bfb57-38da-482e-8987-a42a7d5b22bc",
                                "sense_id": "468bafc7-7a63-3382-89ea-e5749592a1d9",
                                "text": "„Verdi will sich daher bei der Regierung für schärfere Rabattgesetze stark machen.“"
                            },
                            {
                                "example_id": "db49dd55-9ff7-4753-a3fa-e7955f6e4942",
                                "sense_id": "468bafc7-7a63-3382-89ea-e5749592a1d9",
                                "text": "„Insgesamt sind die Rabattgesetze in Belgien weniger streng als in Deutschland, ihre Kontrolle auf Einhaltung ist eher lax.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
