                "senses": [
                    {
                        "sense_id": "a7d594f1-82e0-3194-9a69-c9852290edb2",
                        "entry_id": "40e21875-cf2b-3d91-ba85-30f5128b33f5",
                        "glosses": [
                            "Faire perdre son caractère de citoyen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "503c31d4-cbca-4049-aa81-801acddccbf3",
                                "sense_id": "a7d594f1-82e0-3194-9a69-c9852290edb2",
                                "text": "En conférant ainsi aux droits positifs, aux droits du citoyen, un tel privilège sur les droits de l’homme, elle pourrait nous faire oublier que ses propres droits de citoyenne allemande ne l’ont pourtant pas protégée et que tout État peut \"décitoyenniser\" - dénaturaliser - certains de ses membres comme le fit l’Allemagne nazie, et d’autres pays dans une moindre mesure."
                            },
                            {
                                "example_id": "2b0f826d-e129-4d1b-b41b-ba9087fbae52",
                                "sense_id": "a7d594f1-82e0-3194-9a69-c9852290edb2",
                                "text": "La jeune Amérique, avide de se décitoyenniser."
                            },
                            {
                                "example_id": "e7d681b9-cfc0-4978-afdd-caaf9d23e97a",
                                "sense_id": "a7d594f1-82e0-3194-9a69-c9852290edb2",
                                "text": "Se solidariser avec F.L.N., n’est-ce pas risquer de se « décitoyenniser »."
                            }
                        ]
                    }
                ],
