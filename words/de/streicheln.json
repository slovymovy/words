                    "frequency": "Middle",
                    "semantic_group_id": "beruehren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er kuschelte sich an sie und <w>streichelte</w> sanft über ihre Wange."
                        },
                        {
                            "text": "Sie <w>streichelte</w> ihren Partner liebevoll über das Haar, um ihn zu beruhigen."
