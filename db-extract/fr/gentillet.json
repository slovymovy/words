                "senses": [
                    {
                        "sense_id": "f3aa877c-d363-3ab2-8ed7-9da349f9afa5",
                        "entry_id": "3e07c743-1b29-378f-9d2b-aea481a1984c",
                        "glosses": [
                            "Qui est assez gentil, assez agréable, mais sans plus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e721d24-b49b-4eee-a283-084a3098e9ff",
                                "sense_id": "f3aa877c-d363-3ab2-8ed7-9da349f9afa5",
                                "text": "Les conseils gentillets du genre « servez-vous des coupons », « courez plusieurs épiceries selon les spéciaux », tombent à plat."
                            },
                            {
                                "example_id": "6d6fc785-b890-4344-920f-19c03634ca87",
                                "sense_id": "f3aa877c-d363-3ab2-8ed7-9da349f9afa5",
                                "text": "Une chanson gentillette."
                            },
                            {
                                "example_id": "f6a26377-8977-4971-abd4-77980629f6a8",
                                "sense_id": "f3aa877c-d363-3ab2-8ed7-9da349f9afa5",
                                "text": "Certes, on ne doute pas que ces dames n’aiment leur troupeau : la directrice, notamment, se désole de son union stérile et elle adopte, du cœur, tous les bambins gentillets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7ba201e-8343-47b9-8084-1914f7eb515b",
                        "source_entry_id": "3e07c743-1b29-378f-9d2b-aea481a1984c",
                        "source_sense_id": "f3aa877c-d363-3ab2-8ed7-9da349f9afa5",
