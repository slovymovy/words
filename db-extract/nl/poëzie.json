            {
                "entry_id": "db7409f5-d40e-3ac8-826b-8ce8a7c69608",
                "word": "poëzie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "11fa4f0b-7bb1-3d71-a277-5d41f2ee5a08",
                        "entry_id": "db7409f5-d40e-3ac8-826b-8ce8a7c69608",
                        "glosses": [
                            "het in een min of meer strakke structuur van ritme, maat en klank verwoorden van een gedachte of een verhaal"
                        ],
                        "tags": [
                            "cultuur"
                        ],
                        "examples": [
                            {
                                "example_id": "17f453ab-57aa-4252-8968-e9f013c1f32c",
                                "sense_id": "11fa4f0b-7bb1-3d71-a277-5d41f2ee5a08",
                                "text": "De indeling in verzen valt bij schriftelijke weergave van poëzie meestal meteen op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ba95efd-9f20-4193-90dd-1aa9486a8a53",
                        "source_entry_id": "db7409f5-d40e-3ac8-826b-8ce8a7c69608",
                        "source_sense_id": "11fa4f0b-7bb1-3d71-a277-5d41f2ee5a08",
                        "source_sense_description": "in ritme, maat en klank verwoorden",
                        "target_lang_word": "Poesie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Poesie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b5826ce-304a-323e-8823-960e28c7426c",
                                        "entry_id": "0f8cc504-458c-3c95-8393-74b390e498c8",
                                        "glosses": [
                                            "Dichtung, Dichtkunst"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "706c6fb9-148a-4881-aa23-9a7b42492cf8",
                                                "sense_id": "1b5826ce-304a-323e-8823-960e28c7426c",
                                                "text": "„Die Poesie als Dienerin der Beredsamkeit: dies war auch der didaktische Grundsatz von Christian Weise, der als Rektor des Gymnasiums zu Zittau und als Verfasser von Schauspielen, Romanen und zahlreichen Lehrbüchern gleichzeitig mit Thomasius und vielleicht wirkungsvoller noch als dieser der deutschen Stilbildung im 18. Jahrhundert den Weg gewiesen hat.“"
                                            },
                                            {
                                                "example_id": "0d55812b-7578-44e1-a4f9-fa728f6d2048",
                                                "sense_id": "1b5826ce-304a-323e-8823-960e28c7426c",
                                                "text": "„Poesie liegt in der Beschränkung auf das Notwendigste an Worten, dachte John.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2d34a1cf-595e-3d1e-9905-4cfaa0c23d61",
                                        "entry_id": "0f8cc504-458c-3c95-8393-74b390e498c8",
                                        "glosses": [
                                            "das Erzeugnis von [1], das Dichten in Versen oder gebundener Rede"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbef2876-fc79-44d4-a0cc-ed89f15fafee",
                                                "sense_id": "2d34a1cf-595e-3d1e-9905-4cfaa0c23d61",
                                                "text": "„Nach Jakobson tritt in der Poesie vor allem die Form in den Vordergrund, die hauptsächlich den Rhythmus und die Phonik umfasst.“"
                                            },
                                            {
                                                "example_id": "74047986-cc8c-427c-96c3-981433c643ef",
                                                "sense_id": "2d34a1cf-595e-3d1e-9905-4cfaa0c23d61",
                                                "text": "Eichendorff schuf vollendete Poesie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ec123f89-dd9e-3752-aa27-a0a5f9085d54",
                                        "entry_id": "0f8cc504-458c-3c95-8393-74b390e498c8",
                                        "glosses": [
                                            "poetische Stimmung; Stimmungszauber"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73a19a97-e33f-4ea7-8d8f-da3f73038fe1",
                                                "sense_id": "ec123f89-dd9e-3752-aa27-a0a5f9085d54",
                                                "text": "„Einer Mundart kann man unterstellen, sie sei politisch unkorrekt - oder man kann sie als höhere Sprachkunst bewundern, denn was Witz, Poesie und Lautmalerei angeht, kann Hochdeutsch mit einer Mundart nicht mithalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "415d02f7-263c-4905-a8e6-f22b8b1c5f66",
                        "source_entry_id": "db7409f5-d40e-3ac8-826b-8ce8a7c69608",
                        "source_sense_id": "11fa4f0b-7bb1-3d71-a277-5d41f2ee5a08",
                        "source_sense_description": "in ritme, maat en klank verwoorden",
                        "target_lang_word": "poetry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poetry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43c7343a-6b7e-3c87-aa50-ce16fb77b8dd",
                                        "entry_id": "bafd4713-2bb7-3849-abed-d897962ba265",
                                        "glosses": [
                                            "Literature composed in verse or language exhibiting conscious attention to patterns and rhythm."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9505f5e6-c6f2-4400-8250-ecd7e5fea4bd",
                                                "sense_id": "43c7343a-6b7e-3c87-aa50-ce16fb77b8dd",
                                                "text": "More people write poetry than read it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c580704-8401-348a-aa8e-0e4d7cada3e9",
                                        "entry_id": "bafd4713-2bb7-3849-abed-d897962ba265",
                                        "glosses": [
                                            "A poet's literary production."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc9c1dd6-c1d0-30cc-8910-f83ab379a366",
                                        "entry_id": "bafd4713-2bb7-3849-abed-d897962ba265",
                                        "glosses": [
                                            "An artistic quality that appeals to or evokes the emotions, in any medium; something having such a quality."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5f11f50-e7cf-4112-81c6-82212f157208",
                                                "sense_id": "cc9c1dd6-c1d0-30cc-8910-f83ab379a366",
                                                "text": "That 'Swan Lake' choreography is poetry in motion, fitting the musical poetry of Tchaikovski's divine score well beyond the literary inspiration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cb7abd5-f113-4eca-b058-f45e21d066d8",
                        "source_entry_id": "db7409f5-d40e-3ac8-826b-8ce8a7c69608",
                        "source_sense_id": "11fa4f0b-7bb1-3d71-a277-5d41f2ee5a08",
                        "source_sense_description": "in ritme, maat en klank verwoorden",
                        "target_lang_word": "poésie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poésie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "edd663ed-c26d-3a7a-89b8-441d4f0776c5",
                                        "entry_id": "af4de1fa-9975-36fc-a15d-928e55d49246",
                                        "glosses": [
                                            "(Traditionnellement) Art de faire des ouvrages en vers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebfa8d63-77ab-4129-9d74-bbdf6d2645c7",
                                                "sense_id": "edd663ed-c26d-3a7a-89b8-441d4f0776c5",
                                                "text": "La poésie de la renaissance ne peut pas se contenter de cette simplicité biblique, et, pour célébrer cette nuit de réparation, elle appelle la Joie, personnage allégorique…"
                                            },
                                            {
                                                "example_id": "46f55b7b-90e1-4de4-b779-10e9f0dea932",
                                                "sense_id": "edd663ed-c26d-3a7a-89b8-441d4f0776c5",
                                                "text": "Ce cabinet était la demeure favorite du roi; c’était là qu’il prenait ses leçons d’escrime avec Pompée, et ses leçons de poésie avec Ronsard."
                                            },
                                            {
                                                "example_id": "85075aca-20fb-4fc5-8037-e68be9100e50",
                                                "sense_id": "edd663ed-c26d-3a7a-89b8-441d4f0776c5",
                                                "text": "Mais il était poète aussi et la poésie, à cette époque d’absolutisme et de barbarie, était chose dangereuse lorsqu’on avait l’esprit aussi caustique que Thierrat; […]."
                                            },
                                            {
                                                "example_id": "fdd49224-7310-43be-8a67-135360cd4c84",
                                                "sense_id": "edd663ed-c26d-3a7a-89b8-441d4f0776c5",
                                                "text": "La poésie du Divan et la poésie populaire, issues de classes sociales différentes, ont su parfois puiser aux mêmes sources d’inspiration : mais ce qui forme entre elles cloison étanche, c’est la forme de la langue : la poésie du Divan emploie le vers métrique, la poésie populaire le vers syllabique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "852b36ca-508a-3b87-996f-e5477b6e91b1",
                                        "entry_id": "af4de1fa-9975-36fc-a15d-928e55d49246",
                                        "glosses": [
                                            "À l’époque moderne, genre littéraire qui se caractérise par une exploration poussée des formes du langage et des potentialités du texte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edf66e28-1af1-4d63-8768-725150835a1f",
                                                "sense_id": "852b36ca-508a-3b87-996f-e5477b6e91b1",
                                                "text": "La poésie : quelle voie austère, quel sacerdoce! Un livre de recettes peut vous amener loin et même jusqu'à la télé, et un écrivain de polars peut sans doute espérer vendre un millier d'exemplaires s'il maîtrise un tant soit peu les codes du genre. Mais un poète!"
                                            },
                                            {
                                                "example_id": "f869f551-a092-40d6-bbf8-7c01e86e1f60",
                                                "sense_id": "852b36ca-508a-3b87-996f-e5477b6e91b1",
                                                "text": "La poésie est une insurrection contre la société."
                                            },
                                            {
                                                "example_id": "4ad366a9-ec2a-4a6c-b85d-b05acb4f7734",
                                                "sense_id": "852b36ca-508a-3b87-996f-e5477b6e91b1",
                                                "text": "On dit souvent que la poésie est la forme d'écriture la plus libre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69845f65-0dbf-3857-b5d0-e60e43465fa6",
                                        "entry_id": "af4de1fa-9975-36fc-a15d-928e55d49246",
                                        "glosses": [
                                            "Corpus d’œuvres poétiques partageant une caractéristique thématique, géographique, historique, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce4d55c-a4ec-4921-9e57-6f265e0703e1",
                                                "sense_id": "69845f65-0dbf-3857-b5d0-e60e43465fa6",
                                                "text": "Poésie sacrée."
                                            },
                                            {
                                                "example_id": "77730c60-21b6-4e42-8256-661a98561443",
                                                "sense_id": "69845f65-0dbf-3857-b5d0-e60e43465fa6",
                                                "text": "Mais le seul nom qui ait été sauvé de l’oubli, dans la poésie profane, est celui de ce médiocre rimeur de Mathieu-le-Juif, d’Arras, qui vivait au XIIIᵉ siècle […]."
                                            },
                                            {
                                                "example_id": "9b9f3a33-918c-48af-b0b3-45d8d2da993e",
                                                "sense_id": "69845f65-0dbf-3857-b5d0-e60e43465fa6",
                                                "text": "Poésie noble, élevée, poésie burlesque."
                                            },
                                            {
                                                "example_id": "6ba4ce4e-1e1d-4b62-9d42-500ac7ebdea7",
                                                "sense_id": "69845f65-0dbf-3857-b5d0-e60e43465fa6",
                                                "text": "Poésie familière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "921d1ea0-9973-3642-8b48-4a10cea7567f",
                                        "entry_id": "af4de1fa-9975-36fc-a15d-928e55d49246",
                                        "glosses": [
                                            "Art et manière de faire des vers, de la simple versification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c36ae47b-7eb7-47f9-8007-84cb99bb9a93",
                                                "sense_id": "921d1ea0-9973-3642-8b48-4a10cea7567f",
                                                "text": "Il a choisi un genre de poésie convenable à son sujet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ad71fe8-e7ab-3335-bcca-2309e8736ed3",
                                        "entry_id": "af4de1fa-9975-36fc-a15d-928e55d49246",
                                        "glosses": [
                                            "Qualités essentielles au genre poétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1842be6c-9627-476a-bcb4-06b7e4909338",
                                                "sense_id": "7ad71fe8-e7ab-3335-bcca-2309e8736ed3",
                                                "text": "La poésie est une clameur, elle doit être entendue comme la musique. Toute poésie destinée à n’être que lue, est enfermée dans sa typographie n’est pas finie, elle ne prend son sexe qu’avec la corde vocale tout comme le violon prend le sien avec l’archet qui le touche."
                                            },
                                            {
                                                "example_id": "714a6f29-582e-41b3-bb6a-360a1795b57f",
                                                "sense_id": "7ad71fe8-e7ab-3335-bcca-2309e8736ed3",
                                                "text": "La poésie est pour moi une quête. C’est un voyage qu’on fait dans le noir, à la lumière du langage, et au cours duquel on ne peut que suivre son intuition, guidé par une émotion et les mots qu’elle porte en elle, vers un lieu inconnu qui est le poème."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed6a798c-50f7-37e2-a0c3-8be782ab74f7",
                                        "entry_id": "af4de1fa-9975-36fc-a15d-928e55d49246",
                                        "glosses": [
                                            "Dimension poétique (qui fait appel à un sens de l’esthétique et à des formes figurées) d’un ouvrage en prose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d99e179-60a8-40d0-b728-99c41b630c4b",
                                                "sense_id": "ed6a798c-50f7-37e2-a0c3-8be782ab74f7",
                                                "text": "Il y a de la poésie dans Pascal, dans Bossuet."
                                            },
                                            {
                                                "example_id": "c09ee6c0-2a48-497f-a667-0f44886f2510",
                                                "sense_id": "ed6a798c-50f7-37e2-a0c3-8be782ab74f7",
                                                "text": "Les écrits de Platon sont pleins de poésie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2f5daaf-5417-3a6b-a151-56c6a25bfb5d",
                                        "entry_id": "af4de1fa-9975-36fc-a15d-928e55d49246",
                                        "glosses": [
                                            "Liberté, richesse particulière aux pensées, aux expressions, aux tours que l’on emploie dans la poésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c188b69b-27fd-4f28-8df0-66957f6a0d26",
                                                "sense_id": "b2f5daaf-5417-3a6b-a151-56c6a25bfb5d",
                                                "text": "La poésie du style"
                                            },
                                            {
                                                "example_id": "2f654dbc-e402-458f-9ebd-ffb2f8d8d46a",
                                                "sense_id": "b2f5daaf-5417-3a6b-a151-56c6a25bfb5d",
                                                "text": "C’est la poésie du style qui a fait le succès de l’œuvre de Chateaubriand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac9e5473-9c29-3205-981b-6920eb860ca3",
                                        "entry_id": "af4de1fa-9975-36fc-a15d-928e55d49246",
                                        "glosses": [
                                            "Ce qu’il y a d’élevé, de touchant dans une œuvre, dans le caractère ou la beauté d’une personne, dans les aspects de la nature ou dans une situation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5c472ac-efc9-429d-a55c-f33db730b012",
                                                "sense_id": "ac9e5473-9c29-3205-981b-6920eb860ca3",
                                                "text": "Il y a de la poésie dans ses regards, dans sa manière de s’exprimer. — La poésie d’un paysage, d’un tableau."
                                            },
                                            {
                                                "example_id": "dcd2ee34-f1c0-4a9b-b8b6-83a78263fe06",
                                                "sense_id": "ac9e5473-9c29-3205-981b-6920eb860ca3",
                                                "text": "Un peu de poésie est introduite par le biais du soleil couchant."
                                            },
                                            {
                                                "example_id": "8376dfe3-b927-4759-82b4-4c4bba92f577",
                                                "sense_id": "ac9e5473-9c29-3205-981b-6920eb860ca3",
                                                "text": "Voilà comment vous vient la poésie : vous errez dans un terrain vague recouvert d’immondices, sous un ciel effondré. Vous vous demandez par où viendra la brèche, le ciel bleu, l’arc-en-ciel d’odeurs de paradis. Vous désespérez, vous maudissez votre urgence de la route qui vous a fait quitter votre Éden à vous pour une ville défaite. Vous passez la tête dans un abri sale, froid, aux morceaux disjoints. Et c’est là qu’elle vous attend, sans même briller dans la pénombre pour vous en avertir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b612c0f-0ea0-3451-92ec-468e3859eeeb",
                                        "entry_id": "af4de1fa-9975-36fc-a15d-928e55d49246",
                                        "glosses": [
                                            "Ensemble des ouvrages en vers composés dans une langue, ou selon leurs caractères communs les plus généraux, ou des traits auxquels se reconnaît la manière d’un poète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9616fa7-f542-49bd-8f16-c126bf47bc7c",
                                                "sense_id": "1b612c0f-0ea0-3451-92ec-468e3859eeeb",
                                                "text": "Si les pièces qu’on y insère n’ont pas toutes le même mérite, au moins est-on sûr de n’y jamais rencontrer de ces fades et plattes rimailles qui, tant de fois on servi de prétexte à calomnier la Poésie."
                                            },
                                            {
                                                "example_id": "7d68fca1-461c-4102-9c20-5b6744049c2f",
                                                "sense_id": "1b612c0f-0ea0-3451-92ec-468e3859eeeb",
                                                "text": "La poésie française."
                                            },
                                            {
                                                "example_id": "425bf085-0ee6-4b96-850c-de4b746b6359",
                                                "sense_id": "1b612c0f-0ea0-3451-92ec-468e3859eeeb",
                                                "text": "La poésie anglaise."
                                            },
                                            {
                                                "example_id": "ce81c6e8-71c2-443a-b4e2-22d5e4b1c39c",
                                                "sense_id": "1b612c0f-0ea0-3451-92ec-468e3859eeeb",
                                                "text": "La poésie de Victor Hugo, de Lamartine."
                                            },
                                            {
                                                "example_id": "6d639e13-98b2-48d8-9f57-b6ff23d6b604",
                                                "sense_id": "1b612c0f-0ea0-3451-92ec-468e3859eeeb",
                                                "text": "La poésie grecque nous charme par son naturel."
                                            },
                                            {
                                                "example_id": "cf90268f-0e13-4187-ab7d-179bea2d89c5",
                                                "sense_id": "1b612c0f-0ea0-3451-92ec-468e3859eeeb",
                                                "text": "Tableau de la poésie française au XVIᵉ siècle, par Sainte-Beuve."
                                            },
                                            {
                                                "example_id": "4a8b49fa-99e3-40f4-8140-ed7fec6c0930",
                                                "sense_id": "1b612c0f-0ea0-3451-92ec-468e3859eeeb",
                                                "text": "Une histoire de la poésie anglaise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bc10d1c-d743-3b7f-be0a-d0612c0c1d88",
                                        "entry_id": "af4de1fa-9975-36fc-a15d-928e55d49246",
                                        "glosses": [
                                            "Ouvrage en vers ; il ne se dit guère que des ouvrages de peu d’étendue et s’emploie surtout en parlant des modernes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f2b7f8-b11d-415e-8135-9333957a6916",
                                                "sense_id": "2bc10d1c-d743-3b7f-be0a-d0612c0c1d88",
                                                "text": "Les poésies de Malherbe, de Racan."
                                            },
                                            {
                                                "example_id": "1d36c56a-41b6-438e-bcff-4c7c66402eac",
                                                "sense_id": "2bc10d1c-d743-3b7f-be0a-d0612c0c1d88",
                                                "text": "Recueil de poésies satiriques, de poésies morales, de poésies fugitives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39b84242-8c10-3992-81d9-941a0dce6661",
                                        "entry_id": "af4de1fa-9975-36fc-a15d-928e55d49246",
                                        "glosses": [
                                            "Classe de cinquième secondaire, équivalente à la première française, où l’on enseigne la poésie."
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Plus rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
