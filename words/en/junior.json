                    "target_lang_definitions": {
                        "ru": "Относящийся к начальной школе для детей примерно от 7 до 11 лет (в Великобритании).",
                        "zh": "指英国教育体系中针对7至11岁儿童的初级阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "младший",
                                "target_lang_sense_clarification": "о школьных классах"
