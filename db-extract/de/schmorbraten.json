                        "glosses": [
                            "geschmorter, meist aus Rindfleisch bestehender Braten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b9117c0-12a6-4d35-8626-b2d296cf3dbd",
                                "sense_id": "5d05d3e2-2102-3f0b-bf57-4e9a9d37d262",
                                "text": "„Während hungrige Lebende alles versuchen, unser Gespräch zu beenden und mir erklären, ihr Schmorbraten werde kalt, denke ich nach, frage mich, ob meine Mutter sich anders verhalten hätte, wenn ihr klar gewesen wäre, dass ich keine achtundvierzig Stunden mehr zu leben hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
