                "senses": [
                    {
                        "sense_id": "6e2cf5ac-aa81-31c9-b961-52c908d9e7e2",
                        "entry_id": "fdcd041a-0f61-39a3-9b82-d9d6a8cb5c5d",
                        "glosses": [
                            "Esquisse d’une histoire en manga, étape précédant le crayonné de la planche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f67f898a-abea-42fc-b1ff-8781efdd882c",
                                "sense_id": "6e2cf5ac-aa81-31c9-b961-52c908d9e7e2",
                                "text": "TAKAGI. — … on dirait du manga crayonné.\nMORITAKA. — Il faut commencer par dessiner ça. On l’envoie ensuite à son éditeur. S’il donne son accord, on peut commencer à dessiner. Mais avant de donner son accord, il peut demander plusieurs fois de refaire les dessins. Pour que l’éditeur puisse se contenter de voir les nemus, il faut déjà être un mangaka confirmé."
                            },
                            {
                                "example_id": "d05d2786-21af-4a83-8c97-d8f431c7359b",
                                "sense_id": "6e2cf5ac-aa81-31c9-b961-52c908d9e7e2",
                                "text": "Le storyboard ou nemu en japonais est une étape primordiale dans la réalisation d’un manga. Bien qu’il s’agisse de dessins assez rapidement exécutés, cette phase prend beaucoup de temps. Mlle Nanajima veille à ne pas mettre trop de dialogues, au risque de rendre la lecture désagréable. Elle pense aussi à l’équilibre des tailles des personnages en intégrant un protagoniste grand et un autre plus petit. Aussi, lorsqu’il y a une scène importante, elle fait en sorte que l’arrière-plan ainsi que le héros soient grands."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "108941e5-fe76-4325-8ccd-9f6f8d72039b",
                        "source_entry_id": "fdcd041a-0f61-39a3-9b82-d9d6a8cb5c5d",
                        "source_sense_id": "6e2cf5ac-aa81-31c9-b961-52c908d9e7e2",
                        "target_lang_word": "storyboard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "storyboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3feb2225-da66-3146-a143-8dadbe7ea5c2",
                                        "entry_id": "410d1a24-bd03-3165-91ab-bc875cd8ed80",
                                        "glosses": [
                                            "A series of drawings that lay out the sequence of scenes in a film or series, especially an animated one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0460fcf3-c835-4f85-9cec-4142ece82744",
                                                "sense_id": "3feb2225-da66-3146-a143-8dadbe7ea5c2",
                                                "text": "The storyboard process helps promote brainstorming, highlights missing tasks, and allows the team to incorporate changes prior to traveling too far down a particular path. — By Cheryl A. Malloy & William Cooley, NASA & SAIC here"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95bd985e-9096-3d45-a920-cf5aad8e684f",
                                        "entry_id": "410d1a24-bd03-3165-91ab-bc875cd8ed80",
                                        "glosses": [
                                            "Any sequence of drawings or diagrams which illustrate a sequence of events, e.g. in an accident or as a flowsheet for computer programming."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "storyboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb6112d8-ceff-3cce-8663-774e9ccc8a03",
                                        "entry_id": "8e34c51b-132e-3d75-8434-4fad036d4562",
                                        "glosses": [
                                            "To create and arrange storyboard drawings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7adb6ec-64ee-4ffa-819c-ea6f2957bc7e",
                                                "sense_id": "bb6112d8-ceff-3cce-8663-774e9ccc8a03",
                                                "text": "Storyboarding allows students to work together as they generate ideas and eliminates the territorial defensiveness that often occurs when new ideas are suggested. — \"Using Storyboarding to Determine components of Dellness for University Students\" J Am Coll Health. 1996 Jan;44(4):180-3 Abstract"
                                            }
                                        ]
                                    }
                                ]
