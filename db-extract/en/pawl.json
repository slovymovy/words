                                        "entry_id": "6b5f21a5-8c64-337c-a347-f451ebcef7cf",
                                        "glosses": [
                                            "Hebel zum Öffnen einer Tür durch Verschieben eines Riegels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83abf42c-616c-45da-b829-f02a9396a160",
                                                "sense_id": "c7d5781c-4c96-3de3-9b85-c7e073d5a37d",
                                                "text": "Sie drückte vorsichtig die Klinke herunter."
                                            },
                                            {
                                                "example_id": "376cc51a-1240-4cab-97e1-3c4d2f313bb4",
                                                "sense_id": "c7d5781c-4c96-3de3-9b85-c7e073d5a37d",
                                                "text": "„Er drückte die Klinke mit der rechten Hand nach unten, legte seine linke Hand unterstützend darauf und zog ruckartig.“"
                                            },
                                            {
                                                "example_id": "c590dc8d-b17c-442a-a505-564cf165dec7",
                                                "sense_id": "c7d5781c-4c96-3de3-9b85-c7e073d5a37d",
                                                "text": "„Und kaum hatte der Offizier die Klinke wieder losgelassen, als Mawra Kusminitschna kehrt machte und mit ihren schnellen Greisinnenschritten über den Hof zu dem weiter hinten liegenden Nebenhause ging, in dem sie ihr Zimmer hatte.“"
                                            },
                                            {
                                                "example_id": "1010f638-1790-44db-a8a2-d09a5aee1268",
                                                "sense_id": "c7d5781c-4c96-3de3-9b85-c7e073d5a37d",
                                                "text": "„Ich drücke die Klinke des Ladens nieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c045b93-339b-3986-95ad-0264e66514b7",
                                        "entry_id": "6b5f21a5-8c64-337c-a347-f451ebcef7cf",
                                        "glosses": [
