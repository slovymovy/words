                        "entry_id": "b93f8e68-09a4-399b-a16f-77235c0e3748",
                        "glosses": [
                            "ein kirchlich-rechtlicher Verband, der mehrere Diözesen umfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c496d87f-e9a9-4d99-a020-8f8da9a4e672",
                                "sense_id": "20d78ad6-cfc0-3303-bb3d-aaba2081c807",
                                "text": "An der Spitze einer Kirchenprovinz steht ein Erzbischof."
                            },
                            {
                                "example_id": "663023d2-cb55-4bed-b424-952180cd411a",
                                "sense_id": "20d78ad6-cfc0-3303-bb3d-aaba2081c807",
                                "text": "„Da Rimini zu einer anderen Kirchenprovinz gehörte, war es nicht wie in Ancona verboten, Frauen auf der Bühne auftreten zu lassen.“"
                            }
                        ],
