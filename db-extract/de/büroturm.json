                "senses": [
                    {
                        "sense_id": "d3cac54c-f3d4-3504-b9b6-cf8c0282da93",
                        "entry_id": "d2c97dc2-d66a-3957-a4f0-326d1797e432",
                        "glosses": [
                            "Hochhaus, in dem sich überwiegend Räumlichkeiten für verschiedene schriftliche oder verwaltungstechnische Arbeiten befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "436057d8-c1e8-43ce-a570-950749ce2a9c",
                                "sense_id": "d3cac54c-f3d4-3504-b9b6-cf8c0282da93",
                                "text": "„Gützkow fühlt sich dort aber als Pionier. Denn der 69 Meter hohe Büroturm steht am Hauptbahnhof einsam da, in einem Niemandsland.“"
                            },
                            {
                                "example_id": "783a919e-ef74-4eed-bcad-c856b23be890",
                                "sense_id": "d3cac54c-f3d4-3504-b9b6-cf8c0282da93",
                                "text": "„Larroque hat seinen Sitz in einem modernen Büroturm an einem Golfplatz, Symbol für den Aufstieg der Transitstadt Tijuana.“"
                            },
                            {
                                "example_id": "d5779a35-90c8-44a6-8dba-e3269e08dbf8",
                                "sense_id": "d3cac54c-f3d4-3504-b9b6-cf8c0282da93",
                                "text": "„Auf dem anderen Ufer ragten uns Baukräne und weitere gläserne Bürotürme entgegen, direkt vor uns ein rotes Backsteingebäude, das wie die moderne Version einer alten Fabrikhalle mit hohem Schornstein aussah.“"
                            }
                        ],
