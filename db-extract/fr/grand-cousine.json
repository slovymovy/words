                                        "sense_id": "9922d746-4e11-3fc4-a79f-4348fcd12eef",
                                        "entry_id": "67389ce7-3bec-3fc0-9384-f9264299a298",
                                        "glosses": [
                                            "Female first cousin of one's parent; one's female first cousin once removed in a higher generation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "502a2613-1e2a-4e66-aa06-539fb05414a1",
                                                "sense_id": "9922d746-4e11-3fc4-a79f-4348fcd12eef",
                                                "text": "Mary is my mother's first cousin. That makes Mary my cousin-aunt. Judy is my dad's first cousin, so for me she is another cousin-aunt."
                                            },
                                            {
                                                "example_id": "e8b37016-bc15-4ebc-b3ad-33beb530bbc1",
                                                "sense_id": "9922d746-4e11-3fc4-a79f-4348fcd12eef",
                                                "text": "For quotations using this term, see Citations:cousin-aunt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "325f41a0-2fb6-463d-8aed-d52ec9bea8f2",
