                "entry_id": "9bd1e755-3603-38b8-81b1-bf5a7465a4f8",
                "word": "almandyn",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "39b2252d-6c07-32e4-bec5-ceecb75da42f",
                        "entry_id": "9bd1e755-3603-38b8-81b1-bf5a7465a4f8",
                        "glosses": [
                            "minerał, granat o czerwonym kolorze, także z odcieniem niebieskawym, wykorzystywany w jubilerstwie, o składzie chemicznym: Fe₃Al₂(SiO₄)₃"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "253bc410-979f-4fb4-8c57-fc0fd68bb292",
                                "sense_id": "39b2252d-6c07-32e4-bec5-ceecb75da42f",
                                "text": "Był to klejnot prosty w zamyśle, a przez to niesłychanie elegancki, złota plecionka o kształcie zbliżonym do trójkąta, zdobiona emalią, wysokości 11,5 cm, wysadzana opalami i czerwonawymi almandynami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c2adb89-0bae-4b45-9709-2575e85d4c99",
                        "source_entry_id": "9bd1e755-3603-38b8-81b1-bf5a7465a4f8",
                        "source_sense_id": "39b2252d-6c07-32e4-bec5-ceecb75da42f",
                        "target_lang_word": "almandine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
