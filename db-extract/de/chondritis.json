                        "examples": [
                            {
                                "example_id": "c88ed510-9db8-4528-99b5-b4b8f394b813",
                                "sense_id": "50c96f82-13d6-3e12-8549-fe210c850f16",
                                "text": "Bei einer Chondritis können schmerzstillende Salbe und regelmäßiges Kühlen lindernd wirken."
                            }
                        ],
