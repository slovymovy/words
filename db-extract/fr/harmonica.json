        "fr-extract.jsonl": [
            {
                "entry_id": "38d46854-9f80-353d-88ad-2556aafc94e2",
                "word": "harmonica",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "209ee249-f275-4431-8810-b06ed6e00c90",
                        "entry_id": "38d46854-9f80-353d-88ad-2556aafc94e2",
                        "tags": [
                            "plural"
                        ],
                        "form": "harmonicas"
                    },
                    {
                        "form_id": "1344b93d-d4c8-47e1-9440-99f0526527c4",
                        "entry_id": "38d46854-9f80-353d-88ad-2556aafc94e2",
                        "tags": [
                            "singular",
                            "plural"
                        ],
                        "form": "^((h muet))\\aʁ.mɔ.ni.ka\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "89349563-4fe8-37fe-b060-06c706f7f61a",
                        "entry_id": "38d46854-9f80-353d-88ad-2556aafc94e2",
                        "glosses": [
                            "Instrument de musique composé de cloches ou de verres, de différents timbres, qu’on fait résonner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd6e3918-5751-4ddd-969f-6e12b57b104f",
                                "sense_id": "89349563-4fe8-37fe-b060-06c706f7f61a",
                                "text": "Tout préparer pour votre coucher, maman, répondit Modeste d’une voix aussi pure que le son d’un harmonica."
                            },
                            {
                                "example_id": "2f2258c8-270d-4aac-94b7-ea34fd1c069c",
                                "sense_id": "89349563-4fe8-37fe-b060-06c706f7f61a",
                                "text": "Nous entendions tinter dans le lointain, comme des notes d’harmonica, les sonnettes des ânes partis en avant avec nos bagages, ou quelque mozo de mulas chanter des couplets d’amour avec ce son guttural et ces portements de voix toujours si poétiques, la nuit, dans les montagnes."
                            }
                        ]
                    },
                    {
                        "sense_id": "53467116-83d6-35b5-8b93-db5017f4f165",
                        "entry_id": "38d46854-9f80-353d-88ad-2556aafc94e2",
                        "glosses": [
                            "Instrument à touches où le verre remplace les cordes de métal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aee532c-3a7e-42b7-97b3-3dbb14398a1b",
                                "sense_id": "53467116-83d6-35b5-8b93-db5017f4f165",
                                "text": "L’harmonica est composé de plusieurs verres larges qui sont enfilés sur un axe commun, et que l'on touche avec le doigt mouillé. Cet instrument, extrêmement doux, est néanmoins le plus touchant qui existe; il pénètre jusqu'à l’âme."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d3cbcf5-9699-336b-818d-2c43c8d8ad3b",
                        "entry_id": "38d46854-9f80-353d-88ad-2556aafc94e2",
                        "glosses": [
                            "Instrument de musique à bouche comportant des anches métalliques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df3e9b30-7715-4670-a34b-360a58aab916",
                                "sense_id": "3d3cbcf5-9699-336b-818d-2c43c8d8ad3b",
                                "text": "Pour la première fois, Vincent Bucher n’enregistre plus seul les parties d’harmonica mais accompagne les musiciens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1b1e04d-8e7b-4b20-8219-658b5487cf03",
                        "source_entry_id": "38d46854-9f80-353d-88ad-2556aafc94e2",
                        "target_lang_word": "Mundharmonika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mundharmonika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40dd736d-1004-33bd-9236-dbfa32a0d8af",
                                        "entry_id": "111fd766-3f8c-3fea-948b-25130931f5fe",
                                        "glosses": [
                                            "volkstümliches Musikinstrument, das durch Blasen bzw. Saugen und gleichzeitiges Hin- und Herbewegen vor dem Mund gespielt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef487d58-47ae-4d8e-b994-9c96bb007131",
                                                "sense_id": "40dd736d-1004-33bd-9236-dbfa32a0d8af",
                                                "text": "In den frühen 1820er Jahren tauchen Mundharmonikas erstmals auf und verbreiteten sich dann im deutschen Sprachraum."
                                            },
                                            {
                                                "example_id": "284fb52f-d86f-4012-b749-2f507806e2c8",
                                                "sense_id": "40dd736d-1004-33bd-9236-dbfa32a0d8af",
                                                "text": "Bob Dylan hat sehr viele Lieder mit einer Mundharmonika aufgenommen."
                                            },
                                            {
                                                "example_id": "5a1d5e66-7d58-4069-9b85-1ee943dc6f01",
                                                "sense_id": "40dd736d-1004-33bd-9236-dbfa32a0d8af",
                                                "text": "„Sie hatten eine bessere Mundharmonika aufgetrieben und Schlump versprochen, ihm die Zeche zu bezahlen, wenn er spielte.“"
                                            },
                                            {
                                                "example_id": "7513c327-eb68-4232-bc45-d219ba5020d0",
                                                "sense_id": "40dd736d-1004-33bd-9236-dbfa32a0d8af",
                                                "text": "„Und ein paar junge Burschen spielen Mundharmonika.“"
                                            },
                                            {
                                                "example_id": "ce629127-47ec-4e32-9eaa-15e391aa4509",
                                                "sense_id": "40dd736d-1004-33bd-9236-dbfa32a0d8af",
                                                "text": "„Man höre weder Militärkapellen noch Tanzmusik, keine Leierkastenwalze und keine Mundharmonika, keinen schmetternden Gesang, keinen schrill gepfiffenen Schlager.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
