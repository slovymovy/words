                "senses": [
                    {
                        "sense_id": "009f07f0-2439-3dc6-a060-b5e49166005d",
                        "entry_id": "855917e4-7de0-3c66-bd3f-787ae2ba0862",
                        "glosses": [
                            "Any plant such as a conifer whose seeds are not enclosed in an ovary."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75903692-d632-482f-8251-89f017f6f50d",
                                "sense_id": "009f07f0-2439-3dc6-a060-b5e49166005d",
                                "text": "Like cycads — their gymnosperm relatives — and ferns, the ginkgo produces motile sperm."
                            },
                            {
                                "example_id": "6074763b-8687-44be-9fe1-a1fcde8db89e",
                                "sense_id": "009f07f0-2439-3dc6-a060-b5e49166005d",
                                "text": "The palynoassemblage is rich in angiosperm taxa (45.63%) followed by gymnosperms (0.45%), pteridophytes (18.49%) and fungal remains (23.88%)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6418693-5afa-4607-b5fe-e5ceceff277b",
                        "source_entry_id": "855917e4-7de0-3c66-bd3f-787ae2ba0862",
                        "source_sense_id": "009f07f0-2439-3dc6-a060-b5e49166005d",
                        "source_sense_description": "plant whose seeds are not in an ovary",
                        "target_lang_word": "naaktzadige",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naaktzadige",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4d8874de-25ca-322e-ab2c-a3f283a13d5d",
                                        "entry_id": "86ee24e9-f779-3c8c-a361-b818005c7f0a",
                                        "glosses": [
                                            "plant met onbedekte zaadknoppen, zodat stuifmeel door de kiemopening naar binnen kan; benaming voor planten uit de (infra-)klasse Gymnospermae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eba127a9-681a-4744-aee2-d3359bd90bbd",
                                                "sense_id": "4d8874de-25ca-322e-ab2c-a3f283a13d5d",
                                                "text": "De lariks is een naaldboom en dus een naaktzadige. Dat wil zeggen dat de zaadknoppen, de toekomstige zaden, niet in een vruchtbeginsel zitten opgesloten."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "naaktzadige",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4dcd8e66-3249-30e7-93f1-a77521f42958",
                                        "entry_id": "ec31cf14-58dd-3501-8c04-84e9979fa04d",
                                        "glosses": [
                                            "verbogen vorm van de stellende trap van naaktzadig"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1a5ac8d-98f7-4f79-bbf5-9beaa2055935",
                                                "sense_id": "4dcd8e66-3249-30e7-93f1-a77521f42958",
                                                "text": "De Afrikaanse baobab (Adansonia digitata), ook wel apenbroodboom, is een van de negen baobabsoorten ter wereld. De boom groeit op de savanne in het midden en zuiden van Afrika en kan een houtvolume tot 500 kubieke meter bereiken. Nog niet zo groot als bijvoorbeeld sequoia’s of Nieuw-Zeelandse kauri’s, maar dat zijn allemaal naaktzadige bomen."
                                            }
                                        ]
                                    }
                                ]
                            }
