                            {
                                "example_id": "000a25de-4015-4a73-9741-04ed04e0fcb5",
                                "sense_id": "eb46be8f-414f-39f1-973b-8da0d9645875",
                                "text": "Of het altijd even effectief is, is echter de vraag. Miljoenen vergapen zich intussen wel aan hun acties. Bewondering gaat over in heldenverering. De beste spelers kunnen echt alles met een bal."
                            },
                            {
                                "example_id": "e11456ed-0da9-49a9-86d9-f8dc3c32f2b3",
                                "sense_id": "eb46be8f-414f-39f1-973b-8da0d9645875",
                                "text": "Het is de vraag of Keizer daarvan wakker heeft gelegen. Waarschijnlijk niet. De voetballer was wars van heldenverering en aandacht. Hij verscheen ook zelden op televisie, daar had hij helemaal geen zin in."
                            }
                        ]
