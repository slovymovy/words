                    {
                        "sense_id": "95ba880e-97d3-327c-80f9-66cd99cfec4d",
                        "entry_id": "7564585c-37ab-314b-b17f-75fcc44fcd87",
                        "glosses": [
                            "Se dit du fond du terrier où les chiens poussent les renards, les blaireaux et autres animaux qui se terrent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e21141f4-7dc5-4b15-b558-3b80819294c3",
                                "sense_id": "95ba880e-97d3-327c-80f9-66cd99cfec4d",
                                "text": "Quand on voit que le renard est à l’accul…"
                            },
                            {
                                "example_id": "aabb291d-5f4d-4e36-8632-3d1f8d2f27a2",
                                "sense_id": "95ba880e-97d3-327c-80f9-66cd99cfec4d",
                                "text": "Avant que de lâcher les bassets, il faut savoir où sont les acculs."
                            }
                        ]
                    },
