                "senses": [
                    {
                        "sense_id": "fe2e0825-5e6b-3ec0-8f2f-0758514657d0",
                        "entry_id": "fb5f370b-5fc3-3904-9b9d-5c2f6dbe0eed",
                        "glosses": [
                            "dienstältester Diplomat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baa4b2fc-c316-4bd0-aad4-987fdfcfcb94",
                                "sense_id": "fe2e0825-5e6b-3ec0-8f2f-0758514657d0",
                                "text": "Es sprach der von allen anerkannte Doyen des diplomatischen Korps."
                            },
                            {
                                "example_id": "c9a35123-6317-476a-ad8b-89c63142e98d",
                                "sense_id": "fe2e0825-5e6b-3ec0-8f2f-0758514657d0",
                                "text": "„Die südamerikanische Gesandtschaft protestierte prompt beim Doyen des Diplomatischen Corps, dem schwedischen Generalkonsul Nordling.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9e453aea-aab8-342f-b2d8-d9b33c1d865f",
                        "entry_id": "fb5f370b-5fc3-3904-9b9d-5c2f6dbe0eed",
                        "glosses": [
                            "Person, die einen bestimmten Bereich geprägt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc9c1001-9692-4976-9c07-065226488543",
                                "sense_id": "9e453aea-aab8-342f-b2d8-d9b33c1d865f",
                                "text": "„Freiligraths Mentor Gustav Schwab, der Doyen der sogenannten Schwäbischen Dichterschule, empfahl ihm deshalb, sich »vor Manier zu hüten«.“"
                            },
                            {
                                "example_id": "4e370962-29be-49f7-b601-49ca6bf9bab5",
                                "sense_id": "9e453aea-aab8-342f-b2d8-d9b33c1d865f",
                                "text": "„Du bist der Doyen aller britischer Naturforscher, mein alter Freund.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "123ffaca-69a5-4359-91fd-12b743b9e57e",
                        "source_entry_id": "fb5f370b-5fc3-3904-9b9d-5c2f6dbe0eed",
                        "source_sense_id": "fe2e0825-5e6b-3ec0-8f2f-0758514657d0",
                        "source_sense_description": "dienstältester Diplomat",
                        "target_lang_word": "doyen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doyen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60688136-07bc-389f-a92b-33a9d8b8eabe",
                                        "entry_id": "b00b7d32-17d7-3059-bc2c-974b29a34384",
                                        "glosses": [
                                            "A commander in charge of ten men."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c3194b2-f654-3383-b446-3d5cc2345edb",
                                        "entry_id": "b00b7d32-17d7-3059-bc2c-974b29a34384",
                                        "glosses": [
                                            "The senior, or eldest male member of a group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42cb923b-4c64-4b61-93d0-009f2f533418",
                                                "sense_id": "9c3194b2-f654-3383-b446-3d5cc2345edb",
                                                "text": "At every turn, Collyers's aggressive new management in London was out-maneuvering and out promoting the double doyens of the rarefied art auction world. Old-timers at Collyers referred to Christie's and Sotheby's as “the Cow and the Sow,” lumping them together in frequent attitudes of disdain, in an attempt to make up for decades of being the brunt of bad jokes."
                                            },
                                            {
                                                "example_id": "84232c8e-053e-4975-ae29-81edc82e781e",
                                                "sense_id": "9c3194b2-f654-3383-b446-3d5cc2345edb",
                                                "text": "Conant's sense of science's world-historic mission did not especially endear him to Harvard's doyens, most of whom still operated with a liberal arts college model of the university in which the humanities reigned supreme and even the natural sciences were treated more as teaching than research subjects."
                                            },
                                            {
                                                "example_id": "51c60498-4493-491d-98c5-12bca0906bcd",
                                                "sense_id": "9c3194b2-f654-3383-b446-3d5cc2345edb",
                                                "text": "On the domain level, two doyens, called “Lords of the Land” were entitled to some further specific prerogatives, including the right to lead rituals on behalf of all the villages of the domain (i.e. the domain of the clan of the doyen and, therefore, the clan considered the founder of the oldest village)."
                                            },
                                            {
                                                "example_id": "dce73ec0-14ea-495e-aa64-c71b2e8ce75f",
                                                "sense_id": "9c3194b2-f654-3383-b446-3d5cc2345edb",
                                                "text": "Every prison has its doyen, and for us politicals it was Denis Goldberg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffb2670f-5854-34b7-8c4f-1e51eea7eace",
                                        "entry_id": "b00b7d32-17d7-3059-bc2c-974b29a34384",
                                        "glosses": [
                                            "A leading light, or exemplar of a particular practice or movement."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da2b7c97-66af-4cb0-b3f0-a51a959a71ec",
                                                "sense_id": "ffb2670f-5854-34b7-8c4f-1e51eea7eace",
                                                "text": "Unlike the latter, however, Shifu's seriousness allowed no compromise; his criticism of Zhang ji even brought him into conflict with Wu Zhihui, one of the doyens of anarchism in China."
                                            },
                                            {
                                                "example_id": "bf3c34c2-82bb-4e09-bad4-8b9281f7b28e",
                                                "sense_id": "ffb2670f-5854-34b7-8c4f-1e51eea7eace",
                                                "text": "2008 July 3, Amanda Schaffer, “The Sex Difference Evangelists”, part 3: “Mars, Venus, Babies, and Hormones”, in Slate,\nIn an interview, even Simon Baron-Cohen, another doyen of sex-difference claims, offered up some caution."
                                            },
                                            {
                                                "example_id": "42290399-bb1f-4e82-a454-253c49271c04",
                                                "sense_id": "ffb2670f-5854-34b7-8c4f-1e51eea7eace",
                                                "text": "For these doyens of the field, the Burmese conceptual landscape was a sophisticated and complex array of beliefs, exhibiting the ability of communities to adapt, appropriate, and reshape external influences throughout history."
                                            },
                                            {
                                                "example_id": "a1c3ed47-b413-487f-9338-a7cb86d2c181",
                                                "sense_id": "ffb2670f-5854-34b7-8c4f-1e51eea7eace",
                                                "text": "Prof Sir John Curtice, the doyen of British political pollsters, has also noted that MRPs suggest Labour would lose proportionally more votes in seats it currently holds – and more again in seats it holds where Reform came second in 2024."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d79c16ed-236c-4d89-b1a5-09c2a73504b0",
                        "source_entry_id": "fb5f370b-5fc3-3904-9b9d-5c2f6dbe0eed",
                        "source_sense_id": "fe2e0825-5e6b-3ec0-8f2f-0758514657d0",
