                    }
                ],
                "senses": [
                    {
                        "sense_id": "ecfa5371-2a5b-3d66-81b0-adb78697a6b2",
                        "entry_id": "beae77af-4da1-3f15-9be5-5d153106ce62",
                        "glosses": [
                            "wesz łonowa, mendoweszka"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "43e30b32-350c-4ad5-b7f5-8e0a60ca57ae",
                                "sense_id": "ecfa5371-2a5b-3d66-81b0-adb78697a6b2",
                                "text": "Gdy zauważyłam, że w pościeli są mendy, to musiałam ją wygotować, żeby poginęły."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d72d1b49-00c3-3e60-9c09-03747eab9e9c",
                        "entry_id": "beae77af-4da1-3f15-9be5-5d153106ce62",
                        "glosses": [
                            "człowiek podły"
                        ],
                        "tags": [
                            "colloquial",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "dad1ccc3-3032-41fb-b8aa-78c728df3119",
                                "sense_id": "d72d1b49-00c3-3e60-9c09-03747eab9e9c",
                                "text": "Ta dyrektorska menda obcięła mi pensję!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "659be1b4-61c9-3c5c-b1d6-f65ebb0488cc",
                        "entry_id": "beae77af-4da1-3f15-9be5-5d153106ce62",
                        "glosses": [
                            "człowiek głupi, niezdarny"
                        ],
                        "tags": [
                            "colloquial",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "ebf8bb0c-b729-4893-88c3-01b831a2e7ac",
                                "sense_id": "659be1b4-61c9-3c5c-b1d6-f65ebb0488cc",
                                "text": "Co za menda, pożyczyłem mu rower, a ten na pierwszym zakręcie wywalił się i jeszcze kierownicę mi skrzywił."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "ddefd3ba-6b3f-32b3-be4a-e58473586e2c",
                        "entry_id": "beae77af-4da1-3f15-9be5-5d153106ce62",
                        "glosses": [
                            "policjant"
                        ],
                        "tags": [
                            "metaphoric",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "7075a0f9-e552-4bb5-a0e9-0f62d570933e",
                                "sense_id": "ddefd3ba-6b3f-32b3-be4a-e58473586e2c",
                                "text": "Wałęsa się i szwenda, pierdolona menda"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
