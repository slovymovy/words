                    {
                        "sense_id": "b2d50ceb-1810-3476-99ae-9db70c665640",
                        "entry_id": "b0a85208-bd26-3c99-a65c-f4c7370f5dce",
                        "glosses": [
                            "Tatsache, dass Energie immer erhalten bleibt und folglich nicht verschwinden kann"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "90e6542c-5e0e-43a3-921e-0a8cba510578",
                                "sense_id": "b2d50ceb-1810-3476-99ae-9db70c665640",
                                "text": "„Energieerhaltung ist ein Fundament der Physik.“"
                            },
                            {
                                "example_id": "445d71a8-8261-43f3-b4db-95d52b2b3fce",
                                "sense_id": "b2d50ceb-1810-3476-99ae-9db70c665640",
                                "text": "„Emmy Noether formulierte 1918 ein nach ihr benanntes Theorem, mit dessen Hilfe die Energieerhaltung in geschlossenen symmetrischen Systemen nachgewiesen werden kann.“"
                            },
                            {
                                "example_id": "3bb05df9-461d-45b9-b640-e47cdf130c62",
                                "sense_id": "b2d50ceb-1810-3476-99ae-9db70c665640",
                                "text": "„Joule erkannte, dass sich mechanische Arbeit und Wärme nach festen Regeln ineinander umwandeln lassen. Es war der erste Schritt zum Formulieren eines der wichtigsten Sätze der Physik, der Energieerhaltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb21eff4-38db-4e2b-ab7a-5a4232f84030",
                        "source_entry_id": "b0a85208-bd26-3c99-a65c-f4c7370f5dce",
                        "source_sense_id": "b2d50ceb-1810-3476-99ae-9db70c665640",
                        "source_sense_description": "Physik: Tatsache, dass Energie immer erhalten bleibt und folglich nicht verschwinden kann",
                        "target_lang_word": "conservation of energy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conservation of energy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e03fabf8-aa14-3783-9681-b85de2068a06",
                                        "entry_id": "42a7b52b-15ed-3de5-a657-df2cf57ba811",
                                        "glosses": [
                                            "a principle stating that energy may not be created or destroyed"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e57209ea-23e9-4df2-88dd-43b3114a7676",
                                                "sense_id": "e03fabf8-aa14-3783-9681-b85de2068a06",
                                                "text": "Robert Mayer is well known as one of the several codiscoverers of the principle of the conservation of energy, the formulation of which was arguably the most important single development in physics during the ..."
                                            },
                                            {
                                                "example_id": "c1e6d334-d0a3-4362-b80c-7ee0550fd045",
                                                "sense_id": "e03fabf8-aa14-3783-9681-b85de2068a06",
                                                "text": "Like the concept of conservation of mass, the idea of conservation of energy is also applicable to all chemical reactions."
                                            },
                                            {
                                                "example_id": "e713d147-54e8-4259-97df-05d2d7db776f",
                                                "sense_id": "e03fabf8-aa14-3783-9681-b85de2068a06",
                                                "text": "Temperatures decrease with altitude due to adiabatic cooling (a rising parcel of air expands, and must therefore cool due to conservation of energy)."
                                            },
                                            {
                                                "example_id": "2f96e29e-8d22-4a8d-9f35-0f606fbc7472",
                                                "sense_id": "e03fabf8-aa14-3783-9681-b85de2068a06",
                                                "text": "This contribution reduces with increasing distance p from the emitting surface element dA, due to conservation of energy, as the wave energy distributed across the spherical wave front remains constant, while the radius increases during ..."
                                            },
                                            {
                                                "example_id": "a978e529-5366-4c61-8982-47b3dd711241",
                                                "sense_id": "e03fabf8-aa14-3783-9681-b85de2068a06",
                                                "text": "The net result is the black hole loses mass (due to conservation of energy)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
