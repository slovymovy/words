{
    "word_family": [
        "defiance",
        "defiant",
        "defiantly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b5a215c-d3d7-3529-a88a-c76e111f4303",
                    "sense_definition": "To openly refuse to obey a person, a law, or a rule.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disobedience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>defy</w> your teacher you may end up in detention after school.",
                            "target_lang_translations": {
                                "ru": "Если ты будешь <w>перечить</w> учителю, ты можешь остаться в школе после уроков."
                            }
                        },
                        {
                            "text": "The protesters chose to <w>defy</w> the ban on public gatherings to make their voices heard.",
                            "target_lang_translations": {
                                "ru": "Протестующие решили <w>нарушить</w> запрет на общественные собрания, чтобы их голоса были услышаны."
                            }
                        }
                    ],
                    "synonyms": [
                        "disobey",
                        "flout",
                        "rebel"
                    ],
                    "antonyms": [
                        "obey",
                        "comply",
                        "submit"
                    ],
                    "common_phrases": [
                        "defy an order",
                        "defy authority",
                        "defy the law"
                    ],
                    "target_lang_definitions": {
                        "ru": "Открыто отказываться подчиняться человеку, закону или правилу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игнорировать",
                                "target_lang_sense_clarification": "открыто не подчиняться правилам"
                            },
                            {
                                "target_lang_word": "бросать вызов",
                                "target_lang_sense_clarification": "проявлять неповиновение власти или закону"
                            },
                            {
                                "target_lang_word": "пренебрегать",
                                "target_lang_sense_clarification": "не соблюдать установленные нормы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9c1bf3d-edf1-36f3-92a0-5756742264f2",
                    "sense_definition": "To be impossible or almost impossible to believe, explain, or describe; to not follow expected patterns.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "non-conformity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete's incredible performance seemed to <w>defy</w> the odds after his recent injury.",
                            "target_lang_translations": {
                                "ru": "Невероятное выступление атлета, казалось, <w>шло вразрез</w> со всеми прогнозами после его недавней травмы."
                            }
                        },
                        {
                            "text": "The beauty of the mountain range was so great that it would <w>defy</w> description.",
                            "target_lang_translations": {
                                "ru": "Красота горного хребта была настолько велика, что <w>не поддавалась</w> описанию."
                            }
                        }
                    ],
                    "synonyms": [
                        "elude",
                        "resist",
                        "withstand"
                    ],
                    "antonyms": [
                        "conform",
                        "follow"
                    ],
                    "common_phrases": [
                        "defy description",
                        "defy the odds",
                        "defy gravity",
                        "defy logic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть невозможным или почти невозможным для веры, объяснения или описания; не следовать ожидаемым закономерностям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не поддаваться",
                                "target_lang_sense_clarification": "описанию или объяснению"
                            },
                            {
                                "target_lang_word": "идти вразрез",
                                "target_lang_sense_clarification": "с логикой или ожиданиями"
                            },
                            {
                                "target_lang_word": "опровергать",
                                "target_lang_sense_clarification": "законы или предсказания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "124b5633-08c3-3587-aabc-500fb9c05bc3",
                    "sense_definition": "To challenge someone to do something that you believe they cannot do.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "challenge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>defy</w> you to find a better deal than the one we are offering today.",
                            "target_lang_translations": {
                                "ru": "Я <w>бросаю вам вызов</w> найти предложение лучше того, что мы предлагаем сегодня."
                            }
                        },
                        {
                            "text": "The driver would <w>defy</w> anyone to prove that his car was not the fastest in town.",
                            "target_lang_translations": {
                                "ru": "Водитель <w>вызывал</w> любого доказать, что его машина не самая быстрая в городе."
                            }
                        }
                    ],
                    "synonyms": [
                        "challenge",
                        "dare"
                    ],
                    "common_phrases": [
                        "defy someone to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать кого-либо сделать что-то, что, по вашему мнению, он не сможет сделать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать вызов",
                                "target_lang_sense_clarification": "предлагать кому-то доказать обратное"
                            },
                            {
                                "target_lang_word": "подстрекать",
                                "target_lang_sense_clarification": "вызывать на спор или действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f540442b-e517-3745-949b-b677f925cfef",
                    "sense_definition": "To renounce or reject a bond, faith, or obligation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old play, the character would <w>defy</w> his former mistress to seek a new life.",
                            "target_lang_translations": {
                                "ru": "В старой пьесе герой <w>отрекается</w> от своей прежней госпожи, чтобы начать новую жизнь."
                            }
                        },
                        {
                            "text": "He chose to <w>defy</w> all his previous loyalties to join the opposing side.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>пренебречь</w> всеми своими прежними привязанностями, чтобы перейти на сторону противника."
                            }
                        }
                    ],
                    "synonyms": [
                        "renounce",
                        "reject",
                        "repudiate"
                    ],
                    "antonyms": [
                        "embrace",
                        "accept"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отрекаться или отвергать узы, веру или обязательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попирать",
                                "target_lang_sense_clarification": "грубо нарушать обязательства или верность"
                            },
                            {
                                "target_lang_word": "отрекаться",
                                "target_lang_sense_clarification": "отвергать прежние связи или веру"
                            },
                            {
                                "target_lang_word": "пренебрегать",
                                "target_lang_sense_clarification": "относиться с презрением к долгу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97c01e9d-b68f-3baf-bafd-5d6ebba9bb6f",
                    "sense_definition": "An act of challenging or a provocation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "challenge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight threw down his glove as a <w>defy</w> to his opponent.",
                            "target_lang_translations": {
                                "ru": "Рыцарь бросил перчатку в качестве <w>вызова</w> своему противнику."
                            }
                        },
                        {
                            "text": "Her silent stare was a clear <w>defy</w> against his unfair demands.",
                            "target_lang_translations": {
                                "ru": "Ее молчаливый взгляд был явным <w>протестом</w> против его несправедливых требований."
                            }
                        }
                    ],
                    "synonyms": [
                        "challenge",
                        "provocation"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт вызова или провокация."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызов",
                                "target_lang_sense_clarification": "акт открытого неповиновения"
                            },
                            {
                                "target_lang_word": "провокация",
                                "target_lang_sense_clarification": "подстрекательство к действию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}