{
    "word_family": [
        "medicine",
        "medical",
        "medically",
        "medicate",
        "medication",
        "medicinally"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fda9d94b-4b1e-3680-97be-270fb0b1cf22",
                    "sense_definition": "Having healing properties or used to treat disease and relieve pain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "healing_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many cultures use native herbs for their powerful <w>medicinal</w> properties.",
                            "target_lang_translations": {
                                "it": "Molte culture usano le erbe autoctone per le loro potenti proprietà <w>medicinali</w>."
                            }
                        },
                        {
                            "text": "The natural spring was renowned for its soothing and <w>medicinal</w> waters.",
                            "target_lang_translations": {
                                "it": "La sorgente naturale era rinomata per le sue acque lenitive e <w>medicamentose</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "therapeutic",
                        "curative",
                        "healing"
                    ],
                    "antonyms": [
                        "harmful",
                        "toxic"
                    ],
                    "common_phrases": [
                        "medicinal purposes",
                        "medicinal properties",
                        "medicinal herbs",
                        "medicinal plants"
                    ],
                    "target_lang_definitions": {
                        "it": "Che possiede proprietà curative o terapeutiche, usato per curare malattie o alleviare dolori."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "medicinale",
                                "target_lang_sense_clarification": "dotato di proprietà curative o terapeutiche"
                            },
                            {
                                "target_lang_word": "medicamentoso",
                                "target_lang_sense_clarification": "che ha proprietà o virtù curative"
                            },
                            {
                                "target_lang_word": "curativo",
                                "target_lang_sense_clarification": "che giova alla guarigione"
                            },
                            {
                                "target_lang_word": "terapeutico",
                                "target_lang_sense_clarification": "volto alla terapia o cura"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3aeafd0b-7a4f-32ae-9906-5b08b67d1e28",
                    "sense_definition": "Relating to or connected with medicine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "healing_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She conducted extensive research into the <w>medicinal</w> value of various forest plants.",
                            "target_lang_translations": {
                                "it": "Ha condotto ricerche approfondite sul valore <w>medicinale</w> di varie piante della foresta."
                            }
                        },
                        {
                            "text": "The hospital is responsible for maintaining the safety of its <w>medicinal</w> supplies.",
                            "target_lang_translations": {
                                "it": "L'ospedale è responsabile del mantenimento della sicurezza delle proprie scorte <w>farmaceutiche</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "medical"
                    ],
                    "common_phrases": [
                        "medicinal use",
                        "medicinal value"
                    ],
                    "target_lang_definitions": {
                        "it": "Relativo alla medicina, ai farmaci o al loro impiego."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "medicinale",
                                "target_lang_sense_clarification": "relativo all'uso medico o farmaceutico"
                            },
                            {
                                "target_lang_word": "medico",
                                "target_lang_sense_clarification": "attinente alla medicina o alla sanità"
                            },
                            {
                                "target_lang_word": "farmaceutico",
                                "target_lang_sense_clarification": "attinente ai farmaci e alle preparazioni mediche"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ff44bcb-b944-3419-913e-195d9e26876c",
                    "sense_definition": "Having an unpleasant taste or aroma resembling medicine, such as artificial sweet, bitter, or chemical notes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "taste_or_smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He disliked the cough syrup because of its strong and harsh <w>medicinal</w> taste.",
                            "target_lang_translations": {
                                "it": "Non gli piaceva lo sciroppo per la tosse a causa del suo sapore forte e aspro <w>di medicinale</w>."
                            }
                        },
                        {
                            "text": "The tea had an unpleasantly <w>medicinal</w> flavor that reminded her of hospital antiseptics.",
                            "target_lang_translations": {
                                "it": "Il tè aveva uno sgradevole sapore <w>medicamentoso</w> che le ricordava i disinfettanti ospedalieri."
                            }
                        }
                    ],
                    "common_phrases": [
                        "medicinal taste",
                        "medicinal smell",
                        "medicinal flavor"
                    ],
                    "target_lang_definitions": {
                        "it": "Che ha un sapore o un odore sgradevole, chimico o amaro, che ricorda i farmaci."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "di medicinale",
                                "target_lang_sense_clarification": "riferito a gusto o odore chimico o farmaceutico"
                            },
                            {
                                "target_lang_word": "medicamentoso",
                                "target_lang_sense_clarification": "con aroma o sapore tipico dei farmaci"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe219242-7b19-3994-a466-289f3287c007",
                    "sense_definition": "A plant, herb, or substance cultivated or harvested for its therapeutic properties.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "healing_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Local healers gathered traditional <w>medicinals</w> in the mountains every spring.",
                            "target_lang_translations": {
                                "it": "I guaritori locali raccoglievano <w>piante medicinali</w> tradizionali sulle montagne ogni primavera."
                            }
                        },
                        {
                            "text": "The botanical garden maintains a special section dedicated entirely to rare <w>medicinals</w>.",
                            "target_lang_translations": {
                                "it": "Il giardino botanico conserva una sezione speciale dedicata interamente a rari <w>esemplari medicinali</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Pianta, erba o sostanza naturale raccolta o coltivata per le sue virtù terapeutiche."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "pianta medicinale",
                                "target_lang_sense_clarification": "erba o vegetale con virtù curative"
                            },
                            {
                                "target_lang_word": "erba medicinale",
                                "target_lang_sense_clarification": "erba usata a scopi terapeutici"
                            },
                            {
                                "target_lang_word": "medicinale",
                                "target_lang_sense_clarification": "rimedio o sostanza curativa"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}