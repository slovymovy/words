                ],
                "senses": [
                    {
                        "sense_id": "b660e152-a626-3884-8349-75c5c155a45d",
                        "entry_id": "79c0d716-0b41-368c-987f-b934262b0b95",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5062fd6b-5e61-483d-b155-908e5d46b59c",
                                "sense_id": "b660e152-a626-3884-8349-75c5c155a45d",
                                "text": "Der Gayger trägt nie die Schals, die die Gayger ihm strickt."
                            },
                            {
                                "example_id": "dd570205-198d-44d1-a2e2-d945a29b3c5e",
                                "sense_id": "b660e152-a626-3884-8349-75c5c155a45d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gayger kommt, geht der Herr Ullrich.“"
                            },
                            {
                                "example_id": "31a452e2-9174-43df-b9e7-5c0733954f9f",
                                "sense_id": "b660e152-a626-3884-8349-75c5c155a45d",
                                "text": "Gayger kommt und geht."
                            },
                            {
                                "example_id": "bf45f377-4e26-4a1b-bf08-99f28c244be4",
                                "sense_id": "b660e152-a626-3884-8349-75c5c155a45d",
                                "text": "Gaygers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "102525d2-3845-4d74-9af3-b7dfa078cc92",
                                "sense_id": "b660e152-a626-3884-8349-75c5c155a45d",
                                "text": "Frau Gayger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "00b4b085-2482-45b2-9680-a7151b05baed",
                                "sense_id": "b660e152-a626-3884-8349-75c5c155a45d",
                                "text": "Herr Gayger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "45be9c97-0fef-4800-aaf1-9a1fbda4c24b",
                                "sense_id": "b660e152-a626-3884-8349-75c5c155a45d",
                                "text": "Die Gaygers fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
