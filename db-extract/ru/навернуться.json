                        ]
                    },
                    {
                        "sense_id": "bb9730ce-45fd-37ec-b9fd-33133c33d5af",
                        "entry_id": "09785e79-086d-3005-95af-c13264156082",
                        "glosses": [
                            "(о слезах) появиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3834bb98-5621-4230-8aa4-6e34d90d4463",
                                "sense_id": "bb9730ce-45fd-37ec-b9fd-33133c33d5af",
                                "text": "Казалось, что слёзы готовы были навернуться на глазах его."
                            },
                            {
                                "example_id": "e33a48c0-70a7-4f94-a950-776621b2db6b",
                                "sense_id": "bb9730ce-45fd-37ec-b9fd-33133c33d5af",
                                "text": "Там, на севере, дозрела смородина, / Там июльские блещут грозы… / Ах, от глупого слова «родина» / На глаза навернулись слёзы."
                            }
                        ]
                    }
