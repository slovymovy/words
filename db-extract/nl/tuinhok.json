                        "examples": [
                            {
                                "example_id": "968b4642-1598-448a-82e3-7eb355fa7214",
                                "sense_id": "47991095-0ed1-3e37-b88d-8ddaf07da10e",
                                "text": "Ik was best opgelucht dat mijn man dit deel van de taak voor z’n rekening wilde nemen. Het afmaken verliep snel en heel rustig. We hingen de levenloze haan bij z’n poten aan een haak in ons tuinhok op."
                            },
                            {
                                "example_id": "3b2c20ab-ee89-478b-92a8-8a1d2079491a",
                                "sense_id": "47991095-0ed1-3e37-b88d-8ddaf07da10e",
                                "text": "Toen een man eens aan hem vroeg wat hij toch met zijn zoon moest die niet wilde deugen, antwoordde Marc Schaaf: 'Geef hem een pak op z'n sodemieter en zet hem in het tuinhok.'"
                            }
                        ]
