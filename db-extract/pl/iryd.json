                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iridium",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bedcdb2e-f60f-3b40-9eab-33c8611d51f8",
                                        "entry_id": "0c8963f0-7c4b-3bf5-8527-6580ffbf4267",
                                        "glosses": [
                                            "een scheikundig element met symbool Ir en atoomnummer 77. Het is een zilvergrijs overgangsmetaal"
                                        ],
                                        "tags": [
                                            "element"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac0491c1-905f-49db-b0c0-0f90f8754523",
                                                "sense_id": "bedcdb2e-f60f-3b40-9eab-33c8611d51f8",
                                                "text": "Het flinterdunne iridiumrijke laagje dat geologen wereldwijd in aardlagen terugvinden werd bekend als de karakteristieke grens tussen de geologische tijdperken Krijt en Tertiair. Het heeft een buitenaardse oorsprong, ontstaan na de verwoestende inslag van de Chicxulub-meteoriet, 66 miljoen jaar geleden. De klap was zo groot dat 85 procent van het leven op aarde uitstierf, inclusief de dinosauriërs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "975f7b87-33f6-40e7-8b14-8df4439e0097",
                        "source_entry_id": "b9ffc440-e14b-3818-b919-2c678283835a",
                        "source_sense_id": "f82aff64-7dbc-38ff-8e3f-dd605180498f",
