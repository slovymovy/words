                "senses": [
                    {
                        "sense_id": "45c5950e-85bb-32d0-943f-553cf7b55281",
                        "entry_id": "0a73363b-221d-3606-b70d-3ea04fbdf79e",
                        "glosses": [
                            "Calculateur à très forte capacité et conçu pour réaliser des calculs complexes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a32c0ab5-1aa8-45fc-8127-c286e20ea539",
                                "sense_id": "45c5950e-85bb-32d0-943f-553cf7b55281",
                                "text": "Vient ensuite la Chine qui, avec 32 points, a fait des progrès dans plusieurs domaines et comptait, l'an passé, 214 des 500 plus puissants supercalculateurs du monde, soit plus que n'importe quel autre pays – 113 pour les États-Unis et 91 pour l'Union européenne (UE)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "801ff0b3-29b2-48f7-81a0-bed281c43e62",
                        "source_entry_id": "0a73363b-221d-3606-b70d-3ea04fbdf79e",
                        "source_sense_id": "45c5950e-85bb-32d0-943f-553cf7b55281",
                        "target_lang_word": "supercomputer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supercomputer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec357029-c876-3e12-86bd-e1425fd698f2",
                                        "entry_id": "3ecddbbf-c8d1-3025-9656-75c4098ae011",
                                        "glosses": [
                                            "Any computer that has a far greater processing power than others of its generation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89b15c5b-7fab-4f50-8fb0-d88546b90759",
                                                "sense_id": "ec357029-c876-3e12-86bd-e1425fd698f2",
                                                "text": "The gigaflop supercomputers of today are almost useless. What is needed is a teraflop machine..."
                                            },
                                            {
                                                "example_id": "f253588e-6623-4e60-8213-a79f5918ba46",
                                                "sense_id": "ec357029-c876-3e12-86bd-e1425fd698f2",
                                                "text": "But at the microlevel it consists of an unimaginable number of atoms connected by springy chemical bonds, all jiggling around at a rate that even our fastest supercomputer might envy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc2629d1-3b1d-4851-aeb0-3becdb246bd9",
                        "source_entry_id": "0a73363b-221d-3606-b70d-3ea04fbdf79e",
