                        "profondément ennuyé"
                    ]
                },
                {
                    "sense_id": "259f96f2-8ba3-3041-88f6-8d60d668e9d7",
                    "sense_definition": "Qui ressent de l'ennui, qui se lasse du manque d'intérêt ou d'occupation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lassitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves gardaient un regard <w>ennuyé</w> pendant cette longue présentation théorique."
                        },
                        {
                            "text": "Assis dans la salle d'attente sans lecture, il semblait particulièrement <w>ennuyé</w>."
                        }
                    ],
                    "synonyms": [
                        "blasé",
                        "désœuvré"
                    ],
                    "antonyms": [
                        "intéressé",
                        "captivé",
                        "amusé"
                    ],
                    "common_phrases": [
                        "visage ennuyé",
                        "regard ennuyé"
                    ]
                }
            ]
        },
