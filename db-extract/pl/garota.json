                    },
                    {
                        "translation_id": "c4450905-e8d0-4729-982f-3158b8d087c0",
                        "source_entry_id": "a4e023f0-c599-380e-a6fa-34b40402584f",
                        "source_sense_id": "fbf833f8-7763-3e5d-8be9-dfecb8b03c69",
                        "target_lang_word": "Garrotte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Garrotte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f78a780-8ab0-3547-ba84-07474991d392",
                                        "entry_id": "580f4800-d983-3898-a690-7fa9bbe47528",
                                        "glosses": [
                                            "Hinrichtungs- und Folterinstrument, bei dem das Opfer durch Zuziehen einer Schlinge, später eines Halseisens erdrosselt oder gefoltert wurde, in Spanien bis 1974, den ehemaligen spanischen Kolonien und früher auch in Portugal für die Vollstreckung der Todesstrafe in Verwendung"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "564a6e0b-5579-4835-a36b-b4976a117cfc",
                                                "sense_id": "5f78a780-8ab0-3547-ba84-07474991d392",
                                                "text": "Er wurde mit der Garrotte hingerichtet."
                                            },
                                            {
                                                "example_id": "654efcb8-c82b-4683-a6e9-4bfa367d4371",
                                                "sense_id": "5f78a780-8ab0-3547-ba84-07474991d392",
                                                "text": "Der alte Anzani wurde vor seinem großen Kassenschrank von den Nationalgarden ermordet. Für ebendieses Verbrechen wurde der Abgeordnete Gamacho, der Kommandant der Nationalen, ein blutdürstiges, rohes Vieh, öffentlich durch Garrotte hingerichtet, auf den Spruch eines Kriegsgerichtes, das Barrios angeordnet hatte."
                                            },
                                            {
                                                "example_id": "93bc609f-6742-46ab-aabf-d44cd1f5d9ec",
                                                "sense_id": "5f78a780-8ab0-3547-ba84-07474991d392",
                                                "text": "Historische Todesarten wie Tod durch Guillotine, Lanze, Garrotte, Kreuzigung oder Schwert haben in diesem Buch ebenso Platz wie die widerwärtigsten Folter- und Hinrichtungsmethoden, das Gießen von flüssigem Blei in den Mund eines Angeklagten zum Beispiel."
                                            },
                                            {
                                                "example_id": "c2620666-151b-4774-8863-6a772c60fc58",
                                                "sense_id": "5f78a780-8ab0-3547-ba84-07474991d392",
                                                "text": "Cesares Spezialität war übrigens nicht die legendäre \"Cantarella\", das Borgia-Gift, sondern, da er Schrecken verbreiten wollte, die spanische Garrotte."
                                            },
                                            {
                                                "example_id": "f656fdb0-bbc9-4c2d-859f-b54aa34923a2",
                                                "sense_id": "5f78a780-8ab0-3547-ba84-07474991d392",
                                                "text": "Neulich stand ein junger Mann vor dem Polizeigerichtshofe von Bowstreet, der Mitwirkung bei einer Garrotte-Räuberei verdächtig."
                                            },
                                            {
                                                "example_id": "3a7293dd-b064-4bd0-93c2-5f635c3d9587",
                                                "sense_id": "5f78a780-8ab0-3547-ba84-07474991d392",
                                                "text": "Die rot-weiß-rote Garrotte lässt vier Umdrehungen zu, und mit jeder wird die Luft für den unglücklichen Erfolgreichen dünner."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34f6ab06-2025-49dc-8adc-340be69eeb77",
                        "source_entry_id": "a4e023f0-c599-380e-a6fa-34b40402584f",
                        "source_sense_id": "fbf833f8-7763-3e5d-8be9-dfecb8b03c69",
                        "target_lang_word": "Garotte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Garotte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36643ca7-8321-39c1-b75e-00b74361b798",
                                        "entry_id": "23fa1560-a737-36e8-bac8-afc86f2c2ead",
                                        "glosses": [
                                            "Hinrichtungs- und Folterinstrument, bei dem das Opfer durch Zuziehen einer Schlinge, später eines Halseisens erdrosselt oder gefoltert wurde"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bce02c4-ed2e-487f-a820-67590624a1f9",
                                                "sense_id": "36643ca7-8321-39c1-b75e-00b74361b798",
                                                "text": "„Clemenza, der Caporegime, nahm Sonnys Ausbildung in die Hand und lehrte ihn den Umgang mit Schußwaffen und mit der Garotte.“"
                                            },
                                            {
                                                "example_id": "0cf52824-21aa-43d5-b6b7-65752a578df5",
                                                "sense_id": "36643ca7-8321-39c1-b75e-00b74361b798",
                                                "text": "„Das haben die Nazis jedenfalls schlau gemacht: die Soldaten mit ihrer eigenen Ethik zu knebeln und ihnen aus den traditionellen Idealen eine Garotte zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
