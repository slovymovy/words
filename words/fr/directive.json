                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le parlement examine la transposition de cette nouvelle <w>directive</w> sur la protection des données."
                        },
                        {
                            "text": "Chaque pays membre doit appliquer la <w>directive</w> avant la date limite fixée par Bruxelles."
                        }
                    ],
                    "common_phrases": [
                        "directive européenne",
                        "transposition d'une directive"
                    ]
                },
                {
                    "sense_id": "b0c251d1-5fed-3e1f-8237-1442e25b1176",
                    "sense_definition": "En informatique, instruction spéciale donnée au préprocesseur avant la compilation d'un programme.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette <w>directive</w> de compilation permet d'inclure des fichiers d'en-tête externes."
                        },
                        {
                            "text": "Le développeur a oublié une <w>directive</w> essentielle au début du code source."
                        }
                    ],
                    "common_phrases": [
                        "directive de compilation"
                    ]
                }
            ]
        },
