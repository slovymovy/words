            {
                "entry_id": "45eea88b-4ee2-3fc6-912a-511ea17b67a1",
                "word": "brieven",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f30480f9-2424-348e-8fc8-11c03c766e82",
                        "entry_id": "45eea88b-4ee2-3fc6-912a-511ea17b67a1",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord brief"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1d10e4b5-38da-4c46-be23-6ffe756cd23a",
                                "sense_id": "f30480f9-2424-348e-8fc8-11c03c766e82",
                                "text": "'Handelslieden bij wie je inkopen doet, kunnen die brieven op het stadhuis inwisselen."
                            },
                            {
                                "example_id": "84694622-4e8c-44a5-bcef-9be5962783ad",
                                "sense_id": "f30480f9-2424-348e-8fc8-11c03c766e82",
                                "text": "Uit het boek haalt ze een bundeltje brieven, dat ze van de zenuwen bijna uit haar hand laat vallen."
                            },
                            {
                                "example_id": "26fd87b5-ecc5-4552-9ef4-bd44a22836c9",
                                "sense_id": "f30480f9-2424-348e-8fc8-11c03c766e82",
                                "text": "De krant Indian Express ontdekte dat zestien van de dertig nationale sportbonden geen interne klachtencommissie voor seksueel misbruik hebben, iets dat wel moet volgens de wet. De Nationale Mensenrechtencommissie NHRC stuurde hierover brieven naar de bonden en naar het ministerie van Sport."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
