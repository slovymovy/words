                "translations": [
                    {
                        "translation_id": "adf98436-8b38-4b72-aa0b-a50fbc87a0c1",
                        "source_entry_id": "cbc6c6d9-207b-3781-a6a6-bdc1d7a3fa7b",
                        "source_sense_description": "день, предшествующий какому-либо празднику",
                        "target_lang_word": "eve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9ec5b66-61a1-3018-b40e-9bef788a510e",
                                        "entry_id": "71c57c7c-a74f-39f4-9078-b3580ebc77fc",
                                        "glosses": [
                                            "The day or night before, usually used for holidays, such as Christmas Eve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21d9d19f-c5ef-39dc-b1d9-1e0ac1dc71dd",
                                        "entry_id": "71c57c7c-a74f-39f4-9078-b3580ebc77fc",
                                        "glosses": [
                                            "Evening, night."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9434680-fedc-4ba7-8e7e-e0dfecb12d59",
                                                "sense_id": "21d9d19f-c5ef-39dc-b1d9-1e0ac1dc71dd",
                                                "text": "I love to see the shaking twig / Dance till the shut of eve"
                                            },
                                            {
                                                "example_id": "0d093a89-8c82-470e-9aa7-e1ca7dd5c65d",
                                                "sense_id": "21d9d19f-c5ef-39dc-b1d9-1e0ac1dc71dd",
                                                "text": "And has she tired of weeping / As she lies down at eve."
                                            },
                                            {
                                                "example_id": "6cfab162-a49d-4519-8796-264b9791e65d",
                                                "sense_id": "21d9d19f-c5ef-39dc-b1d9-1e0ac1dc71dd",
                                                "text": "Sitting on the dockside at Oban, watching the to-ing and fro-ing in the harbour on a perfect summer's eve, I reflect on a trip which has taken me through our busiest cities to traverse the country's main lines, as well as explore some of the furthest extremities that were literally out on a limb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "677d713e-aa8a-3a7e-9b4d-43b38c3a7f6b",
                                        "entry_id": "71c57c7c-a74f-39f4-9078-b3580ebc77fc",
                                        "glosses": [
                                            "The period of time when something is just about to happen or to be introduced"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3d95421-7a27-4de0-8a0b-769b995527af",
                                                "sense_id": "677d713e-aa8a-3a7e-9b4d-43b38c3a7f6b",
                                                "text": "the eve of a scientific discovery"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12d0a359-daed-4d83-a23c-f64745da5811",
                        "source_entry_id": "cbc6c6d9-207b-3781-a6a6-bdc1d7a3fa7b",
                        "source_sense_description": "день, предшествующий какому-либо празднику",
                        "target_lang_word": "Vorabend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorabend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18873283-b8aa-333e-a80e-938be60a4015",
                                        "entry_id": "23bda73c-74be-3fda-8fc5-7cebd39de303",
                                        "glosses": [
                                            "der Abend oder Tag vor einem Feiertag oder besonderen Ereignis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fbe368e-9499-4aac-b1f4-1130c46f9252",
                                                "sense_id": "18873283-b8aa-333e-a80e-938be60a4015",
                                                "text": "Heiligabend ist der Vorabend von Weihnachten."
                                            },
                                            {
                                                "example_id": "0f6778d9-5244-4b89-bb10-0c590497400b",
                                                "sense_id": "18873283-b8aa-333e-a80e-938be60a4015",
                                                "text": "„Am Vorabend war eine Schwester oder Cousine von ihnen gestorben, aber sie hatten trotzdem gegessen, und zwar, so viel sie konnten…“"
                                            },
                                            {
                                                "example_id": "de95863b-1901-4376-85bc-569b2e213543",
                                                "sense_id": "18873283-b8aa-333e-a80e-938be60a4015",
                                                "text": "„Der Mann erschien, der am Vorabend mit Jottpee zusammen gewesen war.“"
                                            },
                                            {
                                                "example_id": "9b13c54d-79e6-40ad-a31e-eb3f2b7efdd3",
                                                "sense_id": "18873283-b8aa-333e-a80e-938be60a4015",
                                                "text": "„Ich sagte nur, ich würde ihn gern am Sonntagabend bei Momolo zum Essen sehen; das war der Vorabend seiner Hochzeit.“"
                                            },
                                            {
                                                "example_id": "5ec701d1-ed4d-47ca-903e-a120f086cc78",
                                                "sense_id": "18873283-b8aa-333e-a80e-938be60a4015",
                                                "text": "„Sie hatten den Arbeitstag früh begonnen, obwohl sie nach dem Leichenfund am Vorabend bis spät in die Nacht gearbeitet hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5766da2d-4259-33f4-a4fe-648bf921a35d",
                                        "entry_id": "23bda73c-74be-3fda-8fc5-7cebd39de303",
                                        "glosses": [
                                            "ein (längerer) Zeitraum, der einem historisch bedeutsamen Ereignis unmittelbar vorausgeht"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d3c395b-ba47-43e0-8fc5-3cc4138f6a41",
                                                "sense_id": "5766da2d-4259-33f4-a4fe-648bf921a35d",
                                                "text": "„Drei Revolutionen hat Etienne Cabet erlebt. Seine Kinderjahre fallen in den Aufbruch des bürgerlichen Zeitalters. Am Vorabend der Französischen Revolution wird er 1788 in Dijon als vierter Sohn eines Böttchermeisters geboren.“"
                                            },
                                            {
                                                "example_id": "5842fc1d-743c-4653-9b7c-8d0473a28fc5",
                                                "sense_id": "5766da2d-4259-33f4-a4fe-648bf921a35d",
                                                "text": "[Über das Abschneiden der NSDAP bei den Landtagswahlen 1932 in Thüringen:] „1932, am Vorabend der Machtergreifung, bekam sie hier gut 43 Prozent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dd628bd1-e6c1-3e24-baeb-130cf0787878",
                                        "entry_id": "23bda73c-74be-3fda-8fc5-7cebd39de303",
                                        "glosses": [
                                            "Zeit zwischen dem Nachmittag und Abend (etwa von 18 bis 20 Uhr)"
                                        ],
                                        "tags": [
                                            "Medien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c07957f5-36be-4523-9a5c-ea1bf338d2ae",
                                                "sense_id": "dd628bd1-e6c1-3e24-baeb-130cf0787878",
                                                "text": "„Obwohl sich bei kabel eins streng genommen gar nicht so viel am Vorabend getan hat, kann sich der Sender zu den Gewinnern der letzten Monate zählen.“"
                                            },
                                            {
                                                "example_id": "671865be-1096-4c4d-917b-2a68433e7369",
                                                "sense_id": "dd628bd1-e6c1-3e24-baeb-130cf0787878",
                                                "text": "„Im Rahmen einer Wissensoffensive am Vorabend zeigt der Kölner Familiensender jetzt 20 neue Folgen des erfolgreichen Magazins mit den Moderatoren Vanessa Meisinger und Mark Schepp und das zur besten Sendezeit um 19.45 Uhr.“"
                                            },
                                            {
                                                "example_id": "80d4975d-5573-432c-aee3-11ef17d9c516",
                                                "sense_id": "dd628bd1-e6c1-3e24-baeb-130cf0787878",
                                                "text": "„Die Zuschauer von 'Familie Dr. Kleist' werden sich allerdings an den neuen Termin am Vorabend gewöhnen müssen.“"
                                            },
                                            {
                                                "example_id": "d3bb89f1-68d6-4e83-a141-5d9d7396c455",
                                                "sense_id": "dd628bd1-e6c1-3e24-baeb-130cf0787878",
                                                "text": "„\"Gefragt – Gejagt\" läuft bereits seit 2012 im NDR Fernsehen. In diesem Sommer ist der Sprung in den Vorabend des Ersten gelungen.“"
                                            },
                                            {
                                                "example_id": "4aca9421-a9f5-4048-b0b4-977e3ad2ae21",
                                                "sense_id": "dd628bd1-e6c1-3e24-baeb-130cf0787878",
                                                "text": "„Am Vorabend sendet RTL II werktäglich die Soaps Köln 50667 und Berlin – Tag & Nacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
