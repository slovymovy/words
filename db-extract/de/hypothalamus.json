                "senses": [
                    {
                        "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                        "entry_id": "670944db-33a0-333b-b6ae-462e31e4c64a",
                        "glosses": [
                            "Teil des Zwischenhirns zur Steuerung der vegetativen Funktionen des Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd494726-8356-4833-b67b-68b7fc927b9a",
                                "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                "text": "„Bislang gingen Forscher davon aus, dass eine spezialisierte Gehirnregion im so genannten Hypothalamus je nach Tageszeit bestimmte Gene ein- oder ausschaltet.“"
                            },
                            {
                                "example_id": "a610f6d5-fd16-4030-9a65-1f1068635028",
                                "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                "text": "„Verspielte Katzen verwandelten sie von einem Augenblick zum andern durch Stimulierung ihres lateralen Hypothalamus in wilde Tiger und dann ebenso plötzlich wieder in schnurrende Kätzchen.“"
                            },
                            {
                                "example_id": "0090e9ec-c9f1-4bb5-b76d-db4af28704d7",
                                "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                "text": "„Sie legten den Tieren Elektroden an den Hypothalamus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdf27130-e97f-49e1-82e6-d4d27fe53281",
