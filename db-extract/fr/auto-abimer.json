                    {
                        "sense_id": "1311b095-8421-39bc-8fd5-b7a985ac7b71",
                        "entry_id": "87909030-4bde-308a-b2c2-e6c1e6715f14",
                        "glosses": [
                            "S’abimer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f03848d1-a131-4a7e-80aa-cc39c611def0",
                                "sense_id": "1311b095-8421-39bc-8fd5-b7a985ac7b71",
                                "text": "Ca m'a toujours arraché le cœur de voir de si beaux engins s'auto-abimer."
                            },
                            {
                                "example_id": "b321cd58-1497-4281-98c6-b55267059d8f",
                                "sense_id": "1311b095-8421-39bc-8fd5-b7a985ac7b71",
                                "text": "Je sais que je ne devrais pas prendre autant de plaisir à me battre, ou au moins, le faire de façon raisonnable, pour éviter de m’auto-abimer."
                            },
                            {
                                "example_id": "182f5492-5dc7-4d0e-83f8-5e1a8a0c174a",
                                "sense_id": "1311b095-8421-39bc-8fd5-b7a985ac7b71",
                                "text": "Au final, on sort de l’autoroute, et je dépasse même plus les 50km/h avec un bruit de tracteur… on en déduit que la voiture a une sécu, et qu’elle s’est limitée électroniquement pour éviter de s’auto-abimer."
                            }
                        ]
                    }
