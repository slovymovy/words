                ],
                "senses": [
                    {
                        "sense_id": "3270f806-32e0-3850-8c62-51412d63f161",
                        "entry_id": "b5435b1a-2ac4-3d3a-a98e-02793421500b",
                        "glosses": [
                            "heel rustig, kalm en plechtig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b666d20-4f16-47b4-8222-fa38bb41c7db",
                                "sense_id": "3270f806-32e0-3850-8c62-51412d63f161",
                                "text": "De bulk aan informatie schept onrust, stuurt en verstoort de kijkervaring. Zoals de scheidsrechter geen sereen oordeel meer kan vellen, kunnen wij geen enkele match meer onbevangen op ons af laten komen. De onstuitbare drang om alles op te lijsten legt onvoorspelbaarheid en kijkgenot aan banden. Trainers vermoeden dat ze met al die gegevens hun ploeg beter doen voetballen."
                            },
                            {
                                "example_id": "bf17fc5d-f006-44ab-b026-c16621ff98bd",
                                "sense_id": "3270f806-32e0-3850-8c62-51412d63f161",
                                "text": ",,Het is géén show, het is geen kermisattractie. We werken niet met lichteffecten of achtergrondmuziek, we zetten de lichamen niet op een fiets\", reageert tourmanager Eddy Mareco van Primetime Exhibition Las Vegas. ,,De uitvoering is heel 'droog', de sfeer sereen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77ea3a4d-36b8-42f2-ae86-485d2e4e21d6",
                        "source_entry_id": "b5435b1a-2ac4-3d3a-a98e-02793421500b",
                        "source_sense_id": "3270f806-32e0-3850-8c62-51412d63f161",
                        "source_sense_description": "vredig en kalm",
                        "target_lang_word": "peaceful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peaceful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27b57084-c18c-3f56-8bb8-8372106d714b",
                                        "entry_id": "7cd374bc-67dc-3f73-87e7-9a573fa45d9e",
                                        "glosses": [
                                            "Not at war; not disturbed by strife or turmoil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "605fb710-7b04-4bc8-82fe-34ebcee2587e",
                                                "sense_id": "27b57084-c18c-3f56-8bb8-8372106d714b",
                                                "text": "peaceful protest"
                                            },
                                            {
                                                "example_id": "1b92183a-9cdc-4b87-88d5-61493c8a093e",
                                                "sense_id": "27b57084-c18c-3f56-8bb8-8372106d714b",
                                                "text": "Whether modern, industrial man is less or more warlike than his hunter-gatherer ancestors is impossible to determine.[…]One thing that is true, though, is that murder rates have fallen over the centuries, as policing has spread and the routine carrying of weapons has diminished. Modern society may not have done anything about war. But peace is a lot more peaceful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e177aee6-2a84-32cd-9d05-a3878e908545",
                                        "entry_id": "7cd374bc-67dc-3f73-87e7-9a573fa45d9e",
                                        "glosses": [
                                            "Inclined to peace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79377993-f785-36f5-ba0c-ce61255f44dd",
                                        "entry_id": "7cd374bc-67dc-3f73-87e7-9a573fa45d9e",
                                        "glosses": [
                                            "Motionless and calm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "238af3b9-cb40-4f59-aa64-d6f41469ed5a",
                                                "sense_id": "79377993-f785-36f5-ba0c-ce61255f44dd",
                                                "text": "Attractive cottages look out on a scene so peaceful that lapping wavelets, stirred by the breeze, are often the loudest sound to be heard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peaceful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e38cfff-57dc-3de1-89cf-953357e619c5",
                                        "entry_id": "b15a3866-45f0-32df-848e-bb02723f4579",
                                        "glosses": [
                                            "a Muslim; especially a violent member of a radical Islamist group."
                                        ],
                                        "tags": [
                                            "India",
                                            "Internet",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7439b0c-bdbc-4ad0-bd80-32ac1091ea00",
                                                "sense_id": "0e38cfff-57dc-3de1-89cf-953357e619c5",
                                                "text": "They only have to use a bit of code to name those people; nowadays they call them “peacefuls”. A smirking euphemism is all it takes to sail through Twitter’s filter, and keep the hate-speech flowing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cd1a3cd-93a9-4b5e-8fbf-52d9e5053e13",
                        "source_entry_id": "b5435b1a-2ac4-3d3a-a98e-02793421500b",
                        "source_sense_id": "3270f806-32e0-3850-8c62-51412d63f161",
                        "source_sense_description": "vredig en kalm",
                        "target_lang_word": "serene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1032d61f-5e7d-3ec9-87a7-8a0ddf360623",
                                        "entry_id": "96a46ec2-34ef-35aa-a480-377a7ac0fdc1",
                                        "glosses": [
                                            "Calm, peaceful, unruffled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12afc976-093e-4f6c-9aed-45253f5bbc9f",
                                                "sense_id": "1032d61f-5e7d-3ec9-87a7-8a0ddf360623",
                                                "text": "She looked at her students with joviality and a serene mentality."
                                            },
                                            {
                                                "example_id": "222f4ba9-03ce-44cc-ba31-469c55825231",
                                                "sense_id": "1032d61f-5e7d-3ec9-87a7-8a0ddf360623",
                                                "text": "Serene, smiling, enigmatic, she faced him with no fear whatever showing in her dark eyes. The clear light of the bright autumn morning had no terrors for youth and health like hers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "417e46d4-82c6-3861-af8c-cd18c7063df1",
                                        "entry_id": "96a46ec2-34ef-35aa-a480-377a7ac0fdc1",
                                        "glosses": [
                                            "Without worry or anxiety; unaffected by disturbance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54d5c2eb-856e-49f4-9d14-a4783d3db95f",
                                                "sense_id": "417e46d4-82c6-3861-af8c-cd18c7063df1",
                                                "text": "I took train and reached Wichita, where my active partner was awaiting me. He had just returned from the Medicine River, and reported everything serene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "329b9777-026e-372a-869f-49c15a986968",
                                        "entry_id": "96a46ec2-34ef-35aa-a480-377a7ac0fdc1",
                                        "glosses": [
                                            "Fair and unclouded (as of the sky); clear; unobscured."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68065bb2-8193-4933-9507-7c1e3df32733",
                                                "sense_id": "329b9777-026e-372a-869f-49c15a986968",
                                                "text": "Now ſleeping flocks on their ſoft fleeces lie, / The moon, ſerene in glory, mounts the sky, […]"
                                            },
                                            {
                                                "example_id": "65c27bbe-4eb6-4a93-ab13-b489750def3b",
                                                "sense_id": "329b9777-026e-372a-869f-49c15a986968",
                                                "text": "Full many a gem of pureſt ray ſerene / The dark unfathom'd caves of ocean bear: […]"
                                            },
                                            {
                                                "example_id": "444960ae-f231-4ba0-8d06-e0d3095d5bb5",
                                                "sense_id": "329b9777-026e-372a-869f-49c15a986968",
                                                "text": "A serene sky and verdant fields filled me with ecstasy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcf9d1c8-2425-3987-9421-75c08badb11a",
                                        "entry_id": "96a46ec2-34ef-35aa-a480-377a7ac0fdc1",
                                        "glosses": [
                                            "Used as part of certain titles, originally to indicate sovereignty or independence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc924f40-f9e9-408b-9786-dd30c1222533",
                                                "sense_id": "fcf9d1c8-2425-3987-9421-75c08badb11a",
                                                "text": "Her Serene Highness"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "serene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe8f9d25-65df-3d13-94d7-bf3c08aa095e",
                                        "entry_id": "46fd23b8-f8dc-33f1-9d0d-55e7f03c4443",
                                        "glosses": [
                                            "To make serene."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63546c2d-c6c6-4145-94e0-e55801e2161e",
                                                "sense_id": "fe8f9d25-65df-3d13-94d7-bf3c08aa095e",
                                                "text": "The Hoary Froſts, and Northern Blaſts take care / Thy muddy Bev'rage to ſerene, and drive / Præcipitant the baſer, ropy Lees."
                                            },
                                            {
                                                "example_id": "e52a9e0a-616b-4680-8eab-70d72fe4cc8c",
                                                "sense_id": "fe8f9d25-65df-3d13-94d7-bf3c08aa095e",
                                                "text": "When heaven and earth, as if contending, vye / To raiſe his being, and ſerene his ſoul."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "serene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a5069a6-3537-3625-8e60-1a8b54c11c5a",
                                        "entry_id": "aa2d805e-8f3a-36d6-93b4-ad156f1b9b48",
                                        "glosses": [
                                            "Serenity; clearness; calmness."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a930c53-73a0-4237-ae1b-272400d4c4a8",
                                                "sense_id": "8a5069a6-3537-3625-8e60-1a8b54c11c5a",
                                                "text": "the serene of heaven"
                                            },
                                            {
                                                "example_id": "b29b5315-f006-49e1-a34e-3eadd1642e2d",
                                                "sense_id": "8a5069a6-3537-3625-8e60-1a8b54c11c5a",
                                                "text": "To their master is denied / To share their sweet serene."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "serene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9797d1d0-0827-32c1-9abd-311ca8b706c9",
                                        "entry_id": "88a7fafa-d463-3852-8eab-2ad5ffceeb6f",
                                        "glosses": [
                                            "A fine rain from a cloudless sky after sunset."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84e3d7cc-11e7-4f03-8a6a-cfa78ab05beb",
                                                "sense_id": "9797d1d0-0827-32c1-9abd-311ca8b706c9",
                                                "text": "Some ſerene blaſt me, or dire lightning ſtrike / This my offending face."
                                            },
                                            {
                                                "example_id": "69e73ca6-08a0-4f7f-9bf2-fc94d87cd911",
                                                "sense_id": "9797d1d0-0827-32c1-9abd-311ca8b706c9",
                                                "text": "... Nor unwholesome serene shall From the moon's moist influence fall."
                                            },
                                            {
                                                "example_id": "6fd20b25-ddb9-4201-8eee-3bd9d9de2c0c",
                                                "sense_id": "9797d1d0-0827-32c1-9abd-311ca8b706c9",
                                                "text": "... to preserve the Brain from the Serenes that fall in hot Countries, and other Injuries of the Air, especially in the Night, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
