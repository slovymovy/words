                    {
                        "form_id": "f9d8821f-c796-44e4-819e-4740e89f0689",
                        "entry_id": "80089c4e-fcfd-377b-a4c8-ac70f45ad703",
                        "tags": [
                            "depreciative",
                            "nominative",
                            "vocative",
                            "plural"
                        ],
                        "form": "Zbigniewy"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d62dc529-e3e4-3dd3-8f9b-c44054fd0f85",
                        "entry_id": "80089c4e-fcfd-377b-a4c8-ac70f45ad703",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "723957e7-f798-4398-874a-52e5decd8f29",
                                "sense_id": "d62dc529-e3e4-3dd3-8f9b-c44054fd0f85",
                                "text": "Zbigniew jest moim bratem."
                            },
                            {
                                "example_id": "0deeb4ce-96cb-4c0a-b33c-927e7f805e9e",
                                "sense_id": "d62dc529-e3e4-3dd3-8f9b-c44054fd0f85",
                                "text": "Zbigniewa lepiej nie pytaj, czy słówka w programie do nauki języków obcych można na specjalne zamówienie poukładać tematycznie."
                            },
                            {
                                "example_id": "7878c232-589a-4d59-bf36-b76d298c1972",
                                "sense_id": "d62dc529-e3e4-3dd3-8f9b-c44054fd0f85",
                                "text": "Kobieta podała rękę Zbigniewowi wysiadając z zabytkowego samochodu."
                            },
                            {
                                "example_id": "312613a6-a26b-4236-8d9b-a97252cd2cf3",
                                "sense_id": "d62dc529-e3e4-3dd3-8f9b-c44054fd0f85",
                                "text": "Wśród polityków jest kilku naukowców, jak Władysław Grabski, Ignacy Mościcki, Gabriel Narutowicz, Leszek Balcerowicz czy Zbigniew Brzeziński, ludzi z tytułami profesorskimi znajdujemy w niemal każdej grupie."
                            },
                            {
                                "example_id": "f87793fd-7420-4390-a0b5-6dd41de0a5c5",
                                "sense_id": "d62dc529-e3e4-3dd3-8f9b-c44054fd0f85",
                                "text": "O palmę pierwszeństwa rywalizowały piosenki w wykonaniu Krystyny Prońko, Krzysztofa Krawczyka, Bogusława Meca, Zbigniewa Wodeckiego i…"
                            },
                            {
                                "example_id": "af77be36-a97e-4172-8d79-288cc696dbed",
                                "sense_id": "d62dc529-e3e4-3dd3-8f9b-c44054fd0f85",
                                "text": "Kaśka nawet nie próbowała mamić się mrzonkami, że Zbigniew na wieść o dziecku odejdzie od żony."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96867db5-28e6-434e-b6be-3b27ab56f8a2",
                        "source_entry_id": "80089c4e-fcfd-377b-a4c8-ac70f45ad703",
                        "source_sense_id": "d62dc529-e3e4-3dd3-8f9b-c44054fd0f85",
                        "target_lang_word": "茲比格涅夫",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "135c64da-79e9-40b3-ac58-11a368b92492",
                        "source_entry_id": "80089c4e-fcfd-377b-a4c8-ac70f45ad703",
                        "source_sense_id": "d62dc529-e3e4-3dd3-8f9b-c44054fd0f85",
                        "target_lang_word": "Збигнев",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Збигнев",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e4e0b9cb-c7db-32e7-89f1-607c08ed6246",
                                        "entry_id": "c09af199-c7c1-3a11-a7e9-a7292fa62d0e",
                                        "glosses": [
                                            "мужское имя славянского происхождения, распространённое главным образом среди поляков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f44b6531-4d14-47a7-97b3-12ef540bd981",
                                                "sense_id": "e4e0b9cb-c7db-32e7-89f1-607c08ed6246",
                                                "text": "Его победу в финале над поляком Збигневом Петшиковским я уже не видел ― срок пребывания нашей туристической группы в Риме к тому моменту истёк."
                                            },
                                            {
                                                "example_id": "a067eabe-4348-4aef-9320-3bb18139db8c",
                                                "sense_id": "e4e0b9cb-c7db-32e7-89f1-607c08ed6246",
                                                "text": "У Збигнева поезд на Варшаву как раз около полуночи."
                                            },
                                            {
                                                "example_id": "d1ac70be-8f00-427f-83d8-1d7172205380",
                                                "sense_id": "e4e0b9cb-c7db-32e7-89f1-607c08ed6246",
                                                "text": "На обратной дороге ― что-то напутали с билетами ― она попала в купе с поляками. Двое из них почти всю дорогу просидели в ресторане, а того, кто с нею остался, звали Збигнев."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
