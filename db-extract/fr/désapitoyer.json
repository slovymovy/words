                "senses": [
                    {
                        "sense_id": "b49f5e7b-dc95-37a3-a867-063b221e8d86",
                        "entry_id": "535e94fd-8615-382b-83e2-3050c8ea03c8",
                        "glosses": [
                            "Cesser d’apitoyer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbb6c5ad-20db-4d2d-9a4c-5edbe5108f33",
                                "sense_id": "b49f5e7b-dc95-37a3-a867-063b221e8d86",
                                "text": "Je crois, on me l’assure, Que, douce, une pitié Te prit, non sans mesure, Puis désapitoyé, Ton cœur cria : c’est bien lui qu’il faut qu’on torture!"
                            },
                            {
                                "example_id": "e62a0f84-c8f2-474a-a6cd-4bc9a7332681",
                                "sense_id": "b49f5e7b-dc95-37a3-a867-063b221e8d86",
                                "text": "Durant les événements bulgares, ils s’attendrissaient aux larmes sur le prince Alexandre, croyant plaire à M. de Bismarck. Or, M. de Bismarck ayant lâché ledit prince brusquement, il a fallu brusquement aussi se désapitoyer sur son sort."
                            }
                        ]
                    }
