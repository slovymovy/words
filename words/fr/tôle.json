                    "semantic_group_id": "prison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voleur a été arrêté par les gendarmes et envoyé directement en <w>tôle</w>.",
                            "target_lang_translations": {
                                "en": "The thief was arrested by the gendarmes and sent straight to the <w>clink</w>.",
                                "ru": "Вора арестовали жандармы и сразу отправили в <w>кичман</w>.",
                                "de": "Der Dieb wurde von den Gendarmen festgenommen und direkt in den <w>Knast</w> geschickt.",
                                "es": "El ladrón fue detenido por los guardias y enviado directamente a <w>chirona</w>.",
                                "zh": "小偷被宪兵抓住，直接送进了<w>监狱</w>。"
                            }
                        },
                        {
                            "text": "Après cinq années passées en <w>tôle</w>, il a enfin retrouvé sa liberté.",
                            "target_lang_translations": {
                                "en": "After five years in <w>stir</w>, he finally got his freedom back.",
                                "ru": "После пяти лет в <w>кичмане</w> он наконец вновь обрёл свободу.",
                                "de": "Nach fünf Jahren im <w>Knast</w> hat er endlich wieder die Freiheit erlangt.",
                                "es": "Tras cinco años en <w>chirona</w>, por fin recuperó su libertad.",
                                "zh": "他在<w>监狱</w>里服刑五年，终于重获自由。"
                            }
                        }
