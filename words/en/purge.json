{
    "word_family": [
        "purgation",
        "purgative",
        "purgatory",
        "expurge",
        "unpurged"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3747af89-dcb0-3311-95c7-37dba9921000",
                    "sense_definition": "To forcibly remove people from an organization, party, or place, often for political reasons.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "political removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator decided to <w>purge</w> his rivals from the government to consolidate power.",
                            "target_lang_translations": {
                                "ru": "Диктатор решил <w>вычистить</w> своих соперников из правительства, чтобы укрепить власть."
                            }
                        },
                        {
                            "text": "After the failed coup, the military began to <w>purge</w> disloyal officers from its ranks.",
                            "target_lang_translations": {
                                "ru": "После неудавшегося переворота военные начали <w>чистку</w> нелояльных офицеров в своих рядах."
                            }
                        }
                    ],
                    "synonyms": [
                        "weep"
                    ],
                    "common_phrases": [
                        "purge political rivals",
                        "purge the ranks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принудительно удалять людей из организации, партии или места, часто по политическим мотивам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистить",
                                "target_lang_sense_clarification": "удалять нежелательных лиц из рядов"
                            },
                            {
                                "target_lang_word": "проводить чистку",
                                "target_lang_sense_clarification": "осуществлять политическое устранение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "413f29c9-f512-33a3-b9fe-7b100b78fc53",
                    "sense_definition": "To clean something thoroughly by removing impurities or unwanted elements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cleansing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>purge</w> the system of old files to free up disk space.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>очистить</w> систему от старых файлов, чтобы освободить место на диске."
                            }
                        },
                        {
                            "text": "The technician had to <w>purge</w> the air from the pipes before starting the machine.",
                            "target_lang_translations": {
                                "ru": "Технику пришлось <w>удалить</w> воздух из труб перед запуском машины."
                            }
                        }
                    ],
                    "synonyms": [
                        "weep"
                    ],
                    "common_phrases": [
                        "purge the system",
                        "purge impurities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно очищать что-либо, удаляя примеси или нежелательные элементы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "удалять загрязнения или лишнее"
                            },
                            {
                                "target_lang_word": "продувать",
                                "target_lang_sense_clarification": "удалять воздух или газ из системы"
                            },
                            {
                                "target_lang_word": "чистить",
                                "target_lang_sense_clarification": "освобождать от ненужных файлов или данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9ee4032-e0ef-353b-81d5-aa3f924c572d",
                    "sense_definition": "To free someone or something from sin, guilt, or a spiritual burden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spiritual cleansing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest prayed to <w>purge</w> away our sins for the sake of the community.",
                            "target_lang_translations": {
                                "ru": "Священник молился, чтобы <w>очистить</w> нас от грехов ради блага общины."
                            }
                        },
                        {
                            "text": "He sought a way to <w>purge</w> his conscience after the tragic accident.",
                            "target_lang_translations": {
                                "ru": "Он искал способ <w>облегчить</w> свою совесть после трагического случая."
                            }
                        }
                    ],
                    "synonyms": [
                        "weep"
                    ],
                    "common_phrases": [
                        "purge away sins",
                        "purge the soul"
                    ],
                    "target_lang_definitions": {
                        "ru": "Освобождать кого-либо или что-либо от греха, вины или духовного бремени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "освобождать душу или совесть"
                            },
                            {
                                "target_lang_word": "искупать",
                                "target_lang_sense_clarification": "освобождаться от вины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "129e3bf1-0083-3a12-a050-35ab9ac6a205",
                    "sense_definition": "To empty the stomach or bowels, often by vomiting or using a laxative, sometimes as a medical treatment or due to an eating disorder.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biological evacuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was advised to <w>purge</w> his bowels before the surgical procedure.",
                            "target_lang_translations": {
                                "ru": "Пациенту посоветовали <w>очистить</w> кишечник перед хирургической процедурой."
                            }
                        },
                        {
                            "text": "In some ancient medical practices, doctors would <w>purge</w> patients to balance their humors.",
                            "target_lang_translations": {
                                "ru": "В некоторых древних медицинских практиках врачи <w>давали слабительное</w> пациентам, чтобы сбалансировать их жизненные соки."
                            }
                        }
                    ],
                    "synonyms": [
                        "weep"
                    ],
                    "common_phrases": [
                        "purge the bowels",
                        "purge the stomach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опорожнять желудок или кишечник, часто путем рвоты или использования слабительного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "опорожнять кишечник или желудок"
                            },
                            {
                                "target_lang_word": "промывать",
                                "target_lang_sense_clarification": "медицинская процедура очистки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a03c0a7-f656-3735-87d9-cccd75e33e7a",
                    "sense_definition": "The act of forcibly removing a group of people from a position of power or an organization.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "political removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political <w>purge</w> resulted in dozens of officials being sent into exile.",
                            "target_lang_translations": {
                                "ru": "Политическая <w>чистка</w> привела к тому, что десятки чиновников были отправлены в изгнание."
                            }
                        },
                        {
                            "text": "Historians often study the Great <w>Purge</w> to understand the era of Stalinism.",
                            "target_lang_translations": {
                                "ru": "Историки часто изучают Большой <w>террор</w> (Великую чистку), чтобы понять эпоху сталинизма."
                            }
                        }
                    ],
                    "synonyms": [
                        "weep"
                    ],
                    "common_phrases": [
                        "political purge",
                        "mass purge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт принудительного удаления группы людей из властных структур или организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистка",
                                "target_lang_sense_clarification": "политическое устранение лиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fec5fc00-cc6a-354d-9830-913c3648ca0e",
                    "sense_definition": "The general act or process of cleaning or ridding something of unwanted parts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cleansing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company underwent a data <w>purge</w> to comply with new privacy regulations.",
                            "target_lang_translations": {
                                "ru": "Компания провела <w>очистку</w> данных, чтобы соответствовать новым правилам конфиденциальности."
                            }
                        },
                        {
                            "text": "A seasonal <w>purge</w> of your closet can help you stay organized.",
                            "target_lang_translations": {
                                "ru": "Сезонная <w>чистка</w> гардероба поможет вам поддерживать порядок."
                            }
                        }
                    ],
                    "synonyms": [
                        "weep"
                    ],
                    "common_phrases": [
                        "data purge",
                        "annual purge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общий акт или процесс очистки или избавления чего-либо от нежелательных частей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очистка",
                                "target_lang_sense_clarification": "удаление ненужных элементов или данных"
                            },
                            {
                                "target_lang_word": "чистка",
                                "target_lang_sense_clarification": "наведение порядка, избавление от лишнего"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edd391ac-439b-3f45-b53f-5944e9f6f24b",
                    "sense_definition": "A substance, such as a medicine, that causes the evacuation of the intestines.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biological evacuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The apothecary prepared a strong <w>purge</w> to treat the patient's digestive issues.",
                            "target_lang_translations": {
                                "ru": "Аптекарь приготовил сильное <w>слабительное</w>, чтобы вылечить проблемы пациента с пищеварением."
                            }
                        },
                        {
                            "text": "He felt much better after the <w>purge</w> had finished its work.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал себя гораздо лучше после того, как <w>очищение</w> закончилось."
                            }
                        }
                    ],
                    "synonyms": [
                        "weep"
                    ],
                    "common_phrases": [
                        "medical purge",
                        "strong purge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, например лекарство, вызывающее опорожнение кишечника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабительное",
                                "target_lang_sense_clarification": "средство для очистки кишечника"
                            },
                            {
                                "target_lang_word": "очистительное средство",
                                "target_lang_sense_clarification": "препарат для эвакуации содержимого кишечника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ce6f212-08fe-3789-b96e-cce08867f1b1",
                    "sense_definition": "The reddish liquid that leaks out from raw meat, consisting of water and proteins.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meat juice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure to drain the <w>purge</w> from the meat packaging before cooking.",
                            "target_lang_translations": {
                                "ru": "Обязательно слейте <w>мясной сок</w> из упаковки перед приготовлением."
                            }
                        },
                        {
                            "text": "The presence of excessive <w>purge</w> in the tray might indicate the meat was previously frozen.",
                            "target_lang_translations": {
                                "ru": "Наличие избыточной <w>жидкости</w> в лотке может указывать на то, что мясо ранее подвергалось заморозке."
                            }
                        }
                    ],
                    "synonyms": [
                        "weep"
                    ],
                    "common_phrases": [
                        "meat purge"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical term in food science"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Красноватая жидкость, вытекающая из сырого мяса, состоящая из воды и белков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мясной сок",
                                "target_lang_sense_clarification": "жидкость, выделяющаяся из мяса"
                            },
                            {
                                "target_lang_word": "экссудат",
                                "target_lang_sense_clarification": "технический термин для выделяющейся жидкости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}