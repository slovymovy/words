                    },
                    {
                        "form_id": "6932c004-01db-44c4-b06d-f1c10b3f43eb",
                        "entry_id": "ac04e907-c8e8-3458-884d-31d322fcf8a0",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind umwohnend"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c505e71b-ae5a-3795-9ada-213092e3e25f",
                        "entry_id": "ac04e907-c8e8-3458-884d-31d322fcf8a0",
                        "glosses": [
                            "im Umkreis, in der Umgebung (von jemandem oder etwas) wohnend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c06018bd-f271-41e5-a03d-ae329c33de24",
                                "sense_id": "c505e71b-ae5a-3795-9ada-213092e3e25f",
                                "text": "„Private Universitäten sind gut, staatliche schlecht […] Wie kommen die privaten zu Geld? Zunächst einmal sind sie der Stolz der umwohnenden Bevölkerung, wie bei uns etwa lokale Fußballvereine.“"
                            },
                            {
                                "example_id": "e7cb0f39-1918-4f77-a768-e54fc8a6b185",
                                "sense_id": "c505e71b-ae5a-3795-9ada-213092e3e25f",
                                "text": "„[…] und wie oft in diesem gemischten Südviertel Westberlins die kleinen Läden, machte sie [scil. die Kneipe] ihren Anteil an der umwohnenden Kundschaft aus mit ebenso schwachbrüstigen Schankbetrieben, die ihr gegenüber oder nicht weit in den Wohnstraßen ein Schild aus der Bauflucht streckten […]“"
                            },
                            {
                                "example_id": "ae8e9917-aafc-43ce-9595-2814c5ed457d",
                                "sense_id": "c505e71b-ae5a-3795-9ada-213092e3e25f",
                                "text": "„Nach einem zwei Jahrzehnte währenden Kampf gegen die umwohnenden DDR-Kommunisten mußte die Berliner Sozialdemokratie erleben, daß scheinbar Ähnliches, in Wahrheit Prinzipientreues im eigenen Lager gewachsen war.“"
                            },
                            {
                                "example_id": "9f53a6d1-b590-4a21-b2da-6c88174093a7",
                                "sense_id": "c505e71b-ae5a-3795-9ada-213092e3e25f",
                                "text": "„Die Azteken, zuvor ein nomadisierendes Volk, hatten sich hier um 1325 niedergelassen und die umwohnenden Stämme nach und nach unterworfen […]“"
                            },
                            {
