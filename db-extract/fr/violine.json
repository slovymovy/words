            {
                "entry_id": "e107f622-618e-3d03-bdeb-44bcd2703024",
                "word": "violine",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a862e007-0dab-41c3-9930-003c58ac62ef",
                        "entry_id": "e107f622-618e-3d03-bdeb-44bcd2703024",
                        "tags": [
                            "plural"
                        ],
                        "form": "violines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d598a01a-90d4-3fc8-8da5-e4097783ac56",
                        "entry_id": "e107f622-618e-3d03-bdeb-44bcd2703024",
                        "glosses": [
                            "D’une couleur violet pourpre. #A10684"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f486a6d7-13f7-4b10-9172-8e2ed6fe1a4b",
                                "sense_id": "d598a01a-90d4-3fc8-8da5-e4097783ac56",
                                "text": "13 décembre 44 – Il a une bouche violine comme certains bruns, mais il ne l’ouvre que pour manger. Je me demande pourquoi il a pris la peine de nous inviter."
                            },
                            {
                                "example_id": "63b42f5c-b9b4-4de0-8fc6-b54d537c68c5",
                                "sense_id": "d598a01a-90d4-3fc8-8da5-e4097783ac56",
                                "text": "Le ciel est de fer entre deux cheminées\nJe l'aurais aimé violine\nOu même en arc-en-ciel comme les fumées\nDe Chine."
                            },
                            {
                                "example_id": "56499e0b-ed68-4e0d-b3bb-4a92d9b2f26e",
                                "sense_id": "d598a01a-90d4-3fc8-8da5-e4097783ac56",
                                "text": "Vêtue d’un tailleur violine qui aurait pu passer pour un vêtement de deuil, elle arborait, en dépit des cernes qui lui ombraient le visage, une expression des plus déterminées."
                            },
                            {
                                "example_id": "59b432af-3078-4811-acb9-ae9480c0c2b3",
                                "sense_id": "d598a01a-90d4-3fc8-8da5-e4097783ac56",
                                "text": "Elle était comme d’habitude impitoyablement maquillée, presque peinte, le rouge à lèvres écarlate et l’ombre à paupières violine soulignaient son teint pâle, sa peau « de porcelaine » comme on dit dans les romans d’Yves Simon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "684cc860-747a-4a81-aeba-c00dbb4a63e6",
                        "source_entry_id": "e107f622-618e-3d03-bdeb-44bcd2703024",
                        "source_sense_id": "d598a01a-90d4-3fc8-8da5-e4097783ac56",
