                    "frequency": "Low",
                    "semantic_group_id": "vieillerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refuse de changer son vieux téléphone en affirmant que cette <w>antiquité</w> fonctionne encore."
                        },
                        {
                            "text": "Sa voiture est une véritable <w>antiquité</w> qui tombe en panne presque toutes les semaines."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                }
