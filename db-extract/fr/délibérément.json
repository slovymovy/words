        "fr-extract.jsonl": [
            {
                "entry_id": "cedc834b-2783-31bf-8730-248b55baab03",
                "word": "délibérément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6a312c48-be0e-3bce-997b-7904cdf91234",
                        "entry_id": "cedc834b-2783-31bf-8730-248b55baab03",
                        "glosses": [
                            "D’une manière délibérée, hardiment, avec résolution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74a86077-cf9e-4a8d-b512-4e18b315e0b9",
                                "sense_id": "6a312c48-be0e-3bce-997b-7904cdf91234",
                                "text": "On se permet délibérément toutes les infidélités qu’on ne croit pas dignes d’une peine éternelle."
                            },
                            {
                                "example_id": "67a12d1e-6361-4b47-a61c-8afdc2731e6c",
                                "sense_id": "6a312c48-be0e-3bce-997b-7904cdf91234",
                                "text": "Je n’ai jamais permis qu’on chassât sur mes terres, et jamais, jamais je n’ai chassé, car cette idée que j’aurais pu, délibérément et de sang froid, arracher la vie à un être quelconque, me semblait impossible et monstrueuse."
                            },
                            {
                                "example_id": "33230675-1b3d-4059-a801-55743593744f",
                                "sense_id": "6a312c48-be0e-3bce-997b-7904cdf91234",
                                "text": "Le 27 août 1964, dans une petite salle de la banlieue de Florence, le mythe de l'Ouest prend du plomb dans l'aile. Une poignée de spectateurs découvrent un bon petit western rital, maquillé en série B made in USA, qui écorne délibérément la légende imprimée par John Ford."
                            },
                            {
                                "example_id": "d08f5d59-1db5-4149-920b-7a14a8ed210c",
                                "sense_id": "6a312c48-be0e-3bce-997b-7904cdf91234",
                                "text": "Il importe peu que l’auteur du harcèlement n’ait pas délibérément cherché à nuire au salarié."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52a6a1df-759a-4788-95a2-c68f49065528",
                        "source_entry_id": "cedc834b-2783-31bf-8730-248b55baab03",
                        "source_sense_id": "6a312c48-be0e-3bce-997b-7904cdf91234",
                        "target_lang_word": "deliberately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deliberately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff81719-195f-35a4-bea9-171f464aba58",
                                        "entry_id": "42cfed69-0936-3a52-820c-dc009339b4db",
                                        "glosses": [
                                            "Intentionally, or after deliberation; not accidentally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab75e1f-1903-43d3-a918-c83055f70cee",
                                                "sense_id": "3ff81719-195f-35a4-bea9-171f464aba58",
                                                "text": "He deliberately broke that, didn't he?"
                                            },
                                            {
                                                "example_id": "fed1fd58-a2d6-4855-972a-93f84ff009f0",
                                                "sense_id": "3ff81719-195f-35a4-bea9-171f464aba58",
                                                "text": "Major funding for this book was made possible by deliberately starving a family of four in Tennessee."
                                            },
                                            {
                                                "example_id": "3c4bf725-812b-4daf-a095-03ece4419ba7",
                                                "sense_id": "3ff81719-195f-35a4-bea9-171f464aba58",
                                                "text": "“As a result, OCR found that the district’s pattern of inconsistent responses to reports it received of sexual harassment – infrequently responding under Title IX or not responding at all – rose to the level that the district’s response to some families’ sexual harassment reports was deliberately indifferent to students’ civil rights,” a news release from DOE reads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9793113-f44f-33ad-a757-951c6e41f58c",
                                        "entry_id": "42cfed69-0936-3a52-820c-dc009339b4db",
                                        "glosses": [
                                            "Taking one's time, slowly and carefully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12512be0-345b-4ad3-91eb-9079027ca084",
                                                "sense_id": "f9793113-f44f-33ad-a757-951c6e41f58c",
                                                "text": "After being called upon, he strode deliberately up to the blackboard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39894883-64f0-4a64-b318-8fe0ceb726ec",
                        "source_entry_id": "cedc834b-2783-31bf-8730-248b55baab03",
                        "source_sense_id": "6a312c48-be0e-3bce-997b-7904cdf91234",
                        "target_lang_word": "intentionally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intentionally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9c181ba-b156-3315-adf9-4df1c7a0bd34",
                                        "entry_id": "07f02f10-84c3-31b9-ba34-7f54e20936a2",
                                        "glosses": [
                                            "In an intentional manner; on purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "703a1b9d-5c09-4014-9e97-aff3e2cf8dca",
                                                "sense_id": "f9c181ba-b156-3315-adf9-4df1c7a0bd34",
                                                "text": "The body design has been carried out to the requirements of the B.T.C. Design Panel in association with the Design Research Unit and its lines are described as \"intentionally unelaborate\"."
                                            },
                                            {
                                                "example_id": "50e12eae-f2ec-4837-858b-fbe7be541c68",
                                                "sense_id": "f9c181ba-b156-3315-adf9-4df1c7a0bd34",
                                                "text": "Today, no one would intentionally smear radioactive materials on their face, but in 1933, the dangers of radioactivity were not yet fully understood."
                                            },
                                            {
                                                "example_id": "dcd31949-fbea-4ff1-a20e-e97a1b2c0efa",
                                                "sense_id": "f9c181ba-b156-3315-adf9-4df1c7a0bd34",
                                                "text": "Astrotourism has the potential to catalyze positive change and reduce light pollution globally, but it must be pursued intentionally with utmost concern for local communities and the natural environment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85ca608f-ae56-446b-b72d-a45af57d4f10",
                        "source_entry_id": "cedc834b-2783-31bf-8730-248b55baab03",
                        "source_sense_id": "6a312c48-be0e-3bce-997b-7904cdf91234",
                        "target_lang_word": "on purpose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on purpose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e676f615-a2c3-357d-afa6-04f4ffba1ae0",
                                        "entry_id": "9fc1d1c9-0b49-388f-b475-8ce0dafb8704",
                                        "glosses": [
                                            "By design, as opposed to by accident; intentionally; deliberately."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "405a7f72-1050-4c93-8e5f-721d3ef53e29",
                                                "sense_id": "e676f615-a2c3-357d-afa6-04f4ffba1ae0",
                                                "text": "That wasn't an accident! You did it on purpose!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c4105b8-fc20-3d96-b691-0af3f86339c8",
                                        "entry_id": "9fc1d1c9-0b49-388f-b475-8ce0dafb8704",
                                        "glosses": [
                                            "In order to (do something); with the objective that."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02868d43-ccf0-4fba-b2e6-be1c205c857d",
                                                "sense_id": "2c4105b8-fc20-3d96-b691-0af3f86339c8",
                                                "text": "Blifil bowed and stammered, and looked like a fool; but Western, without giving him time to form a speech for the purpose, answered, “Well, well, I am to blame, if you will, I always am, certainly; but come, let the girl be fetched back again, or let Mr Blifil go to her.——He’s come up on purpose, and there is no time to be lost.”"
                                            },
                                            {
                                                "example_id": "36609401-b216-4dbf-be4e-1d07ce344a18",
                                                "sense_id": "2c4105b8-fc20-3d96-b691-0af3f86339c8",
                                                "text": "I send this to the town, on purpose to have it reach you by the earliest post […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c22d2a0-696e-43b6-8f6b-82a574322603",
                        "source_entry_id": "cedc834b-2783-31bf-8730-248b55baab03",
