                "senses": [
                    {
                        "sense_id": "90970658-0333-318f-aee4-898d7e9c5349",
                        "entry_id": "aa4bd965-5edf-398d-adb2-20b79c53f5ef",
                        "glosses": [
                            "moeilijk te beschrijven; moeilijk te duiden; moeilijk te onderscheiden van andere zaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f8fd5d2-6f31-43b9-b8da-a07663fdc7f1",
                                "sense_id": "90970658-0333-318f-aee4-898d7e9c5349",
                                "text": "Rockstart, een Amsterdamse startup-hub die beginnende ondernemingen op weg helpt, gaat verhuizen. Het momumentale [sic!] pand in de grachtengordel wordt ingeruild voor een nogal non-descript pand op de Rigakade."
                            },
                            {
                                "example_id": "b3455afd-511d-4de4-a03c-3da3b07df8b1",
                                "sense_id": "90970658-0333-318f-aee4-898d7e9c5349",
                                "text": "Ondanks alle vernieuwings- en opknapdrang zal de stad altijd rijk zijn aan non-descripte ruimte. En gelukkig maar, want juist die schijnbaar nutteloze vierkante meters geven de stad extra karakter mee."
                            },
                            {
                                "example_id": "4d0c6520-bdeb-4d10-adfe-8ddea7e34e7d",
                                "sense_id": "90970658-0333-318f-aee4-898d7e9c5349",
                                "text": "Ge gluurt schuinsweg in eene onderverdieping, en helaas ja! daar staat ze, de gevierde gastvrouw van den winter, in een nondescript toilet en met verwarde haren — zij die altoos als door een ringetje te halen was! — en kibbelt met de meiden of jakkert de schoonmaakster af."
                            }
                        ]
                    }
