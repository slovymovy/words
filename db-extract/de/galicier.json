                ],
                "senses": [
                    {
                        "sense_id": "fdd8cdbf-f908-37e5-887c-056a2bb31dd3",
                        "entry_id": "25999528-5fa6-33df-acac-f7d1ca58563c",
                        "glosses": [
                            "Person aus der spanischen Region Galicien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b77aa03-9e1d-4a06-bd93-b42f680b657f",
                                "sense_id": "fdd8cdbf-f908-37e5-887c-056a2bb31dd3",
                                "text": "Ein Bekannter von mir ist geborener Galicier."
                            },
                            {
                                "example_id": "8de0cd05-1098-4701-8360-02ee41205f08",
                                "sense_id": "fdd8cdbf-f908-37e5-887c-056a2bb31dd3",
                                "text": "„Drei Millionen Galicier leben heute noch in Südamerika, auf einem fernen, fremden Kontinent.“"
                            },
                            {
                                "example_id": "1538f1ea-5090-4bdc-91d6-a0fcbffbfea0",
                                "sense_id": "fdd8cdbf-f908-37e5-887c-056a2bb31dd3",
                                "text": "„Viele Basken, Galicier und Katalanen wollen die spanische Nationalmannschaft seit Jahren nicht in ihren Stadien spielen sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
