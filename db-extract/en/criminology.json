                                    {
                                        "sense_id": "cd19a7d3-db1a-368e-a0c6-412e27f4b8f7",
                                        "entry_id": "b6c0d3cb-9c3b-3149-9838-148bc75855ff",
                                        "glosses": [
                                            "sociologie van misdaad en misdadigheid"
