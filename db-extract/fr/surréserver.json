                "senses": [
                    {
                        "sense_id": "05b1743b-e3cc-37b4-a5ef-6ff4b8844640",
                        "entry_id": "0b19f85a-0cff-3985-9c28-b63e70f1370e",
                        "glosses": [
                            "Réserver plus que les places disponibles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "766f2771-aecc-40bc-b040-add128049719",
                                "sense_id": "05b1743b-e3cc-37b4-a5ef-6ff4b8844640",
                                "text": "Mr. Pratte: Donc, en fait, nous devons surréserver bien que nous n'aimions pas le faire."
                            },
                            {
                                "example_id": "564232af-5456-4d92-a9df-cba2b5a70421",
                                "sense_id": "05b1743b-e3cc-37b4-a5ef-6ff4b8844640",
                                "text": "On aura donc intérêt à surréserver : - tant que le gain marginal est supérieur à la somme des pertes ; - ou tant que le gain net (valeur des recettes additionnelles - valeur des pénalités à supporter) est positif."
                            }
                        ]
                    }
