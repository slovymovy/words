                                        "sense_id": "b0c097cd-901b-3677-a94d-b79f25018f3e",
                                        "entry_id": "ccb53f31-350d-395f-a9b2-29d0587e9871",
                                        "glosses": [
                                            "het geloof dat er verband bestaat tussen gebeurtenissen op aarde en de stand van de hemellichamen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e32f476-703c-4ba5-993d-94e0dc0a82a8",
                                                "sense_id": "b0c097cd-901b-3677-a94d-b79f25018f3e",
                                                "text": "Astrologen vinden het woord sterrenwichelarij vaak een denigrerende benaming."
