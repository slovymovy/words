                ],
                "senses": [
                    {
                        "sense_id": "5cc1bde6-f23c-3c60-a66c-bdc1b7cd02c3",
                        "entry_id": "31247163-94a7-3df6-9261-628e74871a17",
                        "glosses": [
                            "восторженно-радостный, торжествующий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab2d1b84-cedb-43d6-8122-52d2d1d26831",
                                "sense_id": "5cc1bde6-f23c-3c60-a66c-bdc1b7cd02c3",
                                "text": "Ликующая толпа."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9377472b-9c0a-45c9-81ba-75d711cfd959",
                        "source_entry_id": "31247163-94a7-3df6-9261-628e74871a17",
                        "source_sense_id": "5cc1bde6-f23c-3c60-a66c-bdc1b7cd02c3",
                        "target_lang_word": "en liesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en liesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50a2479b-45a9-34a2-8296-8e26cfd64eca",
                                        "entry_id": "a7ae34ea-acf6-36fd-8822-0b4e70ee73d1",
                                        "glosses": [
                                            "Dans une grande joie délirante et collective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a7a0e14-a16d-4b1e-8086-06664e5636d3",
                                                "sense_id": "50a2479b-45a9-34a2-8296-8e26cfd64eca",
                                                "text": "Beaumont entier était en liesse pour le mariage de la petite brodeuse, que tous les cœurs épousaient."
                                            },
                                            {
                                                "example_id": "5972e1f0-af51-480c-85c7-3395d18180b9",
                                                "sense_id": "50a2479b-45a9-34a2-8296-8e26cfd64eca",
                                                "text": "Cheikh Gaafar se montra généreux pour la dot et les cadeaux. Il fit célébrer de belles fêtes pour le mariage. […]. Le village entier fut en liesse."
                                            },
                                            {
                                                "example_id": "d76e5b59-cb36-41dd-b4c4-085c0ded1ffd",
                                                "sense_id": "50a2479b-45a9-34a2-8296-8e26cfd64eca",
                                                "text": "Le président Cotaloz ne reçoit personne aujourd'hui, mais il accueillera la foule en liesse demain matin!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d083feb9-ab04-4cb2-b7de-e5817f308c05",
                        "source_entry_id": "31247163-94a7-3df6-9261-628e74871a17",
                        "source_sense_id": "5cc1bde6-f23c-3c60-a66c-bdc1b7cd02c3",
                        "target_lang_word": "enthousiaste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enthousiaste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89f963e7-bf25-3647-8792-ca0204ec61ea",
                                        "entry_id": "c2b44bf4-23da-3bbb-92ab-afbf8be80864",
                                        "glosses": [
                                            "Qui exprime ou qui dégage l’enthousiasme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb7bb6ee-7f6b-4d19-930d-e06cadb2c714",
                                                "sense_id": "89f963e7-bf25-3647-8792-ca0204ec61ea",
                                                "text": "Et, vivement impressionné par la noblesse réelle du spectacle, je ne pus m’empêcher de mêler ma voix aux acclamations enthousiastes des croyants prosternés."
                                            },
                                            {
                                                "example_id": "910c739b-d1f6-4d88-bbb1-28045d1e88ca",
                                                "sense_id": "89f963e7-bf25-3647-8792-ca0204ec61ea",
                                                "text": "Et, de plus, il travaille pour la patrie, avec le consentement enthousiaste de tout ce que la France contient de repopulateurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enthousiaste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34ba3c54-5e2b-35c1-ab5b-14f3add365c3",
                                        "entry_id": "cf5cac5e-76e5-3643-8009-8f1f3a97aea2",
                                        "glosses": [
                                            "Celui, celle qui a une admiration excessive, une sorte d’engouement pour quelqu’un ou pour quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f213f65e-d041-484c-9514-366bada9656f",
                                                "sense_id": "34ba3c54-5e2b-35c1-ab5b-14f3add365c3",
                                                "text": "Si donc, dans le principe, ces célèbres enthousiastes qui ont tant prôné les courses, avaient plus connu le fond de l’institution que la superficie, ils n’auraient pas concouru au développement d’un prétendu moyen d’amélioration si peu en rapport avec nos usages et nos besoins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cfaf922-384f-3f3a-92c7-05c8e4f7e32a",
                                        "entry_id": "cf5cac5e-76e5-3643-8009-8f1f3a97aea2",
                                        "glosses": [
                                            "Quiconque est sujet à s’engouer, à s’enthousiasmer."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90f546ee-c92f-4238-908c-7afbff387c2c",
                                                "sense_id": "3cfaf922-384f-3f3a-92c7-05c8e4f7e32a",
                                                "text": "Mr Balfour écrivait jadis: « Il est regrettable que seuls les enthousiastes puissent émouvoir les peuples, car les enthousiastes sont presque toujours des imbéciles. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
