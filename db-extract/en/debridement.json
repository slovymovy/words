                                "target_senses": [
                                    {
                                        "sense_id": "565df460-9212-3dac-b170-30558f273930",
                                        "entry_id": "cb52f9bb-afaf-3fd7-8d6e-faeb0b941d72",
                                        "glosses": [
                                            "Endroit, espace de mer où navigue un bateau."
                                        ],
