                                        "sense_id": "f31922a2-c418-32d6-a533-499ab0ee8426",
                                        "entry_id": "8803af36-04f7-330c-9ded-b7094abcd047",
                                        "glosses": [
                                            "The act or process of transferring someone or something to another, of sending by reference, or referring."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69f00bf5-1bd9-409e-bb66-fe356a4d2be1",
                                                "sense_id": "f31922a2-c418-32d6-a533-499ab0ee8426",
                                                "text": "The insurance company insists I get a referral from my regular doctor. I can't just go to the specialist; a GP has got to refer me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a66b6544-5957-3318-8264-e81d03d61fba",
                                        "entry_id": "8803af36-04f7-330c-9ded-b7094abcd047",
                                        "glosses": [
                                            "A document used by schools detailing some form of a student's misbehavior and listing the actions taken before and after the student's receipt of the referral."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da1b7b57-a432-4a1b-aa83-331ebf84c569",
                                                "sense_id": "a66b6544-5957-3318-8264-e81d03d61fba",
                                                "text": "After misbehaving in class, George was given a referral for disrupting class and sent to the office."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
