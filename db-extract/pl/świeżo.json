                                "target_senses": [
                                    {
                                        "sense_id": "5b6776aa-b70f-3549-aeb8-dac17340fb14",
                                        "entry_id": "ed6049b0-0af5-351f-8487-063ee4096a07",
                                        "glosses": [
                                            "neu, gerade eben erst, kürzlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1305c2db-f553-4fa3-b4e7-8955c4dad087",
                                                "sense_id": "5b6776aa-b70f-3549-aeb8-dac17340fb14",
                                                "text": "Am liebsten koche ich mit frischem Gemüse."
                                            },
                                            {
                                                "example_id": "e768a4f1-8bde-4a77-9d7e-b5e90c84e7d4",
                                                "sense_id": "5b6776aa-b70f-3549-aeb8-dac17340fb14",
                                                "text": "„Für Gerichte mit rohen Eiern verwenden Sie am besten möglichst frische Eier.“"
                                            },
                                            {
                                                "example_id": "e8b0dbd1-0bbe-4999-b6ac-6125bf3027b6",
                                                "sense_id": "5b6776aa-b70f-3549-aeb8-dac17340fb14",
                                                "text": "„Gegen drei Uhr am Nachmittag landeten wir am rechten Ufer bei einer Hütte, vor der wir im morastigen Boden viele frische Fußspuren entdeckten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2429590e-9f66-3414-91f7-3ce6fcd1de63",
                                        "entry_id": "ed6049b0-0af5-351f-8487-063ee4096a07",
                                        "glosses": [
                                            "(oft in angenehmer Weise) kühl"
                                        ],
                                        "tags": [],
                                        "examples": [
