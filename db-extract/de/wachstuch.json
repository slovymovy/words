                "senses": [
                    {
                        "sense_id": "dfd756c0-093c-3bf3-96a0-604e966bd530",
                        "entry_id": "59348813-70d5-32bf-b054-9d13ddcd71a3",
                        "glosses": [
                            "клеёнка (материал)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d30cb24-ae3c-4a4f-bfa8-c862f39116dc",
                                "sense_id": "dfd756c0-093c-3bf3-96a0-604e966bd530",
                                "text": "Er trug zum Kochen eine Schürze aus Wachstuch.",
                                "translation": "Во время приготовления пищи он надел фартук из клеёнки."
                            }
                        ]
                    },
                    {
                        "sense_id": "96dc8b0e-2920-308f-aa25-172c772f74ed",
                        "entry_id": "59348813-70d5-32bf-b054-9d13ddcd71a3",
                        "glosses": [
                            "клеёнка (на столе), клеёнчатая скатерть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01330d11-4e2f-4f75-b294-ab96704e03b7",
                                "sense_id": "96dc8b0e-2920-308f-aa25-172c772f74ed",
                                "text": "Auf dem Küchentisch lag ein buntes Wachstuch.",
                                "translation": "Кухонный стол накрывала разноцветная клеёнка."
                            }
                        ]
                    }
