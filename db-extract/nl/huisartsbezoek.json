                        "glosses": [
                            "consultatie van de huisarts door een patiënt; de keer dat men naar het spreekuur van een huisarts gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ea99a40-df47-4201-aac0-96235469eaec",
                                "sense_id": "b84ba939-7921-3540-b8f5-3edb9bcaea16",
                                "text": "Patiënten gaan minder vaak naar de huisarts, omdat ze het eigen risico van hun ziektekostenverzekering niet willen betalen. Dit resultaat van een Nivel-enquête is opmerkelijk, omdat het eigen risico helemaal niet geldt voor een huisartsbezoek."
                            },
                            {
                                "example_id": "c66ba118-3fe5-4a54-b214-52b0283ee7e7",
                                "sense_id": "b84ba939-7921-3540-b8f5-3edb9bcaea16",
                                "text": "De PVV verhoogt het eigen risico niet, net als de SP die het op termijn wil afschaffen. D66 wil het eigen risico vervangen door een eigen bijdrage van tien procent van elke zorgrekening met uitzondering van die voor huisartsbezoek."
                            }
                        ]
                    }
