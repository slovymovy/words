    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "adf2c950-7f05-314f-a88d-9f5fa8d71530",
                    "sense_definition": "The state of being unable to do something due to a lack of skill, knowledge, or physical capacity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lack of capacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>inability</w> to speak French made it difficult for him to communicate during his trip to Paris.",
                            "target_lang_translations": {
                                "ru": "Его <w>неспособность</w> говорить по-французски затрудняла общение во время поездки в Париж."
                            }
                        },
                        {
                            "text": "The team lost the game because of their <w>inability</w> to score in the final minutes.",
                            "target_lang_translations": {
                                "ru": "Команда проиграла матч из-за <w>неумения</w> забить гол на последних минутах."
                            }
                        }
                    ],
                    "synonyms": [
                        "unability"
                    ],
                    "antonyms": [
                        "ability",
                        "capability",
                        "capacity"
                    ],
                    "common_phrases": [
                        "inability to score",
                        "physical inability",
                        "total inability"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, при котором человек не может что-либо сделать из-за отсутствия навыков, знаний или физических возможностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неспособность",
                                "target_lang_sense_clarification": "отсутствие способностей или сил"
                            },
                            {
                                "target_lang_word": "неумение",
                                "target_lang_sense_clarification": "отсутствие навыка или мастерства"
                            },
                            {
                                "target_lang_word": "невозможность",
                                "target_lang_sense_clarification": "отсутствие физической возможности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cc2ec0a-a741-3fc6-b4cf-71ed58294977",
                    "sense_definition": "The lack of power, resources, or the legal option to perform a specific action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lack of capacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee expressed frustration at their <w>inability</w> to change the existing laws.",
                            "target_lang_translations": {
                                "ru": "Комитет выразил разочарование в связи со своей <w>невозможностью</w> изменить существующие законы."
                            }
                        },
                        {
                            "text": "Financial <w>inability</w> to pay the debt led the company toward bankruptcy.",
                            "target_lang_translations": {
                                "ru": "Финансовая <w>неспособность</w> выплатить долг привела компанию к банкротству."
                            }
                        }
                    ],
                    "synonyms": [
                        "unability"
                    ],
                    "antonyms": [
                        "power",
                        "authority"
                    ],
                    "common_phrases": [
                        "financial inability",
                        "legal inability",
                        "inability to pay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие полномочий, ресурсов или законных оснований для совершения определенного действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неспособность",
                                "target_lang_sense_clarification": "отсутствие ресурсов или сил"
                            },
                            {
                                "target_lang_word": "невозможность",
                                "target_lang_sense_clarification": "отсутствие условий или прав"
                            },
                            {
                                "target_lang_word": "бессилие",
                                "target_lang_sense_clarification": "отсутствие власти или влияния"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}