                                                "sense_id": "2ed49cec-c5a8-3e2d-99dc-7967a5eaf0e8",
                                                "text": "This anonymization site is supposed to keep emails from being tracked back to you."
                                            },
                                            {
                                                "example_id": "7f0dd1f4-5044-412e-971d-9b12b82a1a66",
                                                "sense_id": "2ed49cec-c5a8-3e2d-99dc-7967a5eaf0e8",
                                                "text": "This institutional and research caution is partly due to the fact that oral data is harder to anonymise than written data, and partly in recognition of the fact that in the future anonymisation will become increasingly harder as the application of AI to speech recognition continues to improve."
                                            }
                                        ]
