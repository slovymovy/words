                        ],
                        "form": "das Viadukt"
                    },
                    {
                        "form_id": "f42441d2-e55f-4d34-8733-bb42c011f04a",
                        "entry_id": "ce4ad6e1-0ffc-3615-abae-f44c2f9319d0",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Viadukte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44cca6d9-3f0d-38ef-8225-4372a976a88a",
                        "entry_id": "ce4ad6e1-0ffc-3615-abae-f44c2f9319d0",
                        "glosses": [
                            "eine mehr oder minder hohe, meist sehr lange Brücke, die als Träger für eine Straße oder eine Eisenbahnlinie dient, um ein Tal oder eine Senke steigungsarm zu überwinden."
                        ],
                        "tags": [
                            "Verkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "7ca2905d-59da-4679-9dcf-bdd2069ede81",
                                "sense_id": "44cca6d9-3f0d-38ef-8225-4372a976a88a",
                                "text": "In den Mittelgebirgen werden viele Viadukte benötigt."
                            },
                            {
                                "example_id": "f7ed178e-c501-40a9-b3ad-efa5cc5b1b87",
                                "sense_id": "44cca6d9-3f0d-38ef-8225-4372a976a88a",
                                "text": "„Er ging den Dammweg entlang und durchschritt den alten Viadukt.“"
                            },
                            {
                                "example_id": "107b6a8e-03f1-4808-b370-dcca999af172",
                                "sense_id": "44cca6d9-3f0d-38ef-8225-4372a976a88a",
                                "text": "„Das Viadukt soll nun abgerissen und durch einen Tunnel ersetzt werden.“"
                            },
                            {
                                "example_id": "2941b895-969d-4013-b934-4db3c816f495",
                                "sense_id": "44cca6d9-3f0d-38ef-8225-4372a976a88a",
                                "text": "„Bevor der nächste Standort erreicht wird, quert der Weg die Nette über ein Viadukt und führt durch zwei Tunnel.“"
                            },
                            {
                                "example_id": "c9f03091-0f17-4577-9e66-2e197a726eb3",
                                "sense_id": "44cca6d9-3f0d-38ef-8225-4372a976a88a",
                                "text": "„Die Berliner Stadtbahn ist ein Viadukt auf zahllosen gemauerten Bögen von elf Kilometer Länge, sie durchstößt in viergleisiger Spur den Kern der Stadt von Osten nach Westen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bc6c63f-4963-47fb-8051-33854d641dcd",
                        "source_entry_id": "ce4ad6e1-0ffc-3615-abae-f44c2f9319d0",
                        "source_sense_id": "44cca6d9-3f0d-38ef-8225-4372a976a88a",
                        "target_lang_word": "viaduct",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viaduct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13311ae3-eb9e-389b-a486-9efb693b3855",
                                        "entry_id": "c4e97e4f-4bc8-3d7c-8fa2-9175c15c2cec",
                                        "glosses": [
                                            "A bridge with several spans that carries rail or road traffic over a valley or other obstacles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "875d4a63-24b3-49ef-a937-687729c52bfc",
                                                "sense_id": "13311ae3-eb9e-389b-a486-9efb693b3855",
                                                "text": "[…] St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London. Close-packed, crushed by the buttressed height of the railway viaduct, rendered airless by huge walls of factories, it at once banished lively interest from a stranger's mind and left only a dull oppression of the spirit."
                                            },
                                            {
                                                "example_id": "bce2db10-9ed7-4754-9a59-395451d853f0",
                                                "sense_id": "13311ae3-eb9e-389b-a486-9efb693b3855",
                                                "text": "The L.C.C. [London County Council] considers viaducts in London objectionable and a hindrance to town planning and would like to abolish all the Southern Railway lines on viaducts in South London. [Nothing much happened, they still exist.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e48e506f-0eb0-449c-9fb2-aacdfc62bcf5",
                        "source_entry_id": "ce4ad6e1-0ffc-3615-abae-f44c2f9319d0",
                        "source_sense_id": "44cca6d9-3f0d-38ef-8225-4372a976a88a",
                        "target_lang_word": "viaduc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viaduc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7eb8fc2-2852-3ae2-a9ec-6a1e2f9f00fd",
                                        "entry_id": "24dd4ddf-24b7-3ece-992b-455cdb258138",
                                        "glosses": [
                                            "Pont haut et long construit pour le passage d’un chemin de fer ou d’une route au dessus d’une vallée ou d’un bras de mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "151431b8-ee89-4fc8-93e1-1415ee06579d",
                                                "sense_id": "f7eb8fc2-2852-3ae2-a9ec-6a1e2f9f00fd",
                                                "text": "En 1865 nous avons dessiné un pont d’acier à modillons, d’une travée de 300 mètres, pour un viaduc que l’on projetait d’établir sur le Severn, près du lieu où passe actuellement le tunnel."
                                            },
                                            {
                                                "example_id": "7f0841f7-3143-4407-ac01-d85537647cc4",
                                                "sense_id": "f7eb8fc2-2852-3ae2-a9ec-6a1e2f9f00fd",
                                                "text": "Son regard s’oriente vers la fenêtre, les saules qui masquent la rivière, la courbe du grand viaduc qui disparaît dans les nuages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92464a22-c37c-3819-9f70-513d4366296a",
                                        "entry_id": "24dd4ddf-24b7-3ece-992b-455cdb258138",
                                        "glosses": [
                                            "Pont routier ou ferroviaire qui enjambe spécifiquement une autre voie de circulation, plutôt qu’un obstacle naturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "101bb8ce-7b27-41d4-89ef-ec427db0b100",
                                                "sense_id": "92464a22-c37c-3819-9f70-513d4366296a",
                                                "text": "Ces contrats touchent la construction de routes et de viaducs à Montréal, Laval ainsi que dans la région de Lanaudière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a4c1c45-e9a2-37bb-a18d-67c1da8ef14e",
                                        "entry_id": "24dd4ddf-24b7-3ece-992b-455cdb258138",
                                        "glosses": [
                                            "Suite de plusieurs jours non travaillés englobant plus d’un jour férié associé à des congés payés."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4a61d5c-1a50-4858-8002-fccec00656e8",
                                                "sense_id": "0a4c1c45-e9a2-37bb-a18d-67c1da8ef14e",
                                                "text": "2018 sera marquée par trois ponts, la fête du Travail (mardi 1ᵉʳ mai), la Toussaint (jeudi 1ᵉʳ novembre) et Noël (mardi 25 décembre), mais surtout par ce que l’on pourrait appeler un viaduc, avec une semaine entrecoupée par deux fériés : le mardi 8 mai (Victoire 1945) et le jeudi 10 mai (Ascension)."
                                            },
                                            {
                                                "example_id": "c7eb640a-bd66-4c9f-8d55-2bb68acf1fca",
                                                "sense_id": "0a4c1c45-e9a2-37bb-a18d-67c1da8ef14e",
                                                "text": "Donc pour en revenir à nos ponts du mois de mai, si vous voulez donner raison à Fred de la compta, lorsqu’il appelle vos ponts des viaducs, il vous faut prendre les deux jours autour de l’ascension, c’est à dire le mercredi qui précède et le vendredi qui succède."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "505cbcc9-79c8-43b7-9cc8-d1e70b01e28c",
                        "source_entry_id": "ce4ad6e1-0ffc-3615-abae-f44c2f9319d0",
