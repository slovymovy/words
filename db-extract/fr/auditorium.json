                                        "entry_id": "dded2e53-28ef-3f78-8cfa-0fbe92b777db",
                                        "glosses": [
                                            "собир. слушатели; те, к кому обращается оратор, средство массовой информации и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
