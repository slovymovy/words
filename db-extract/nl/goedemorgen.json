                                            {
                                                "example_id": "375907fc-3e16-451e-ac46-5f930b8600dc",
                                                "sense_id": "e04ef7d6-4030-3c65-aa8a-814db893dd3c",
                                                "text": "Ich wünsche Dir einen wunderschönen guten Morgen."
                                            },
                                            {
                                                "example_id": "524b1a03-cad4-40d4-b4e7-01b878fa8f38",
                                                "sense_id": "e04ef7d6-4030-3c65-aa8a-814db893dd3c",
                                                "text": "„Guten Morgen“ sagt der Bauer, wenn er in die Stadt kommt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2265760-d230-3888-82c4-93279c481c1b",
                                        "entry_id": "941b6416-ac15-387d-9d3b-96d6e2b5e371",
                                        "glosses": [
                                            "Ruf des Staunens, auch der bedenklichen Verwunderung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed5a487b-0bbe-418d-9361-cee38dddb9d6",
                                                "sense_id": "f2265760-d230-3888-82c4-93279c481c1b",
                                                "text": "Ich habe mich an der Universität angemeldet. Kommentar: Na, guten Morgen!"
                                            }
                                        ],
