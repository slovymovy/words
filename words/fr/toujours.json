    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d3c09118-ffab-3e87-8c18-fc7336b31f0b",
                    "sense_definition": "En tout temps, sans interruption ou sans fin.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "permanence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je promets de t'aimer pour <w>toujours</w> quoi qu'il arrive dans notre vie."
                        },
                        {
                            "text": "Le soleil se lève <w>toujours</w> à l'est et se couche à l'ouest."
                        }
                    ],
                    "synonyms": [
                        "continuellement",
                        "éternellement",
                        "perpétuellement"
                    ],
                    "antonyms": [
                        "jamais"
                    ],
                    "common_phrases": [
                        "pour toujours",
                        "à toujours"
                    ]
                },
                {
                    "sense_id": "41a99d80-08d7-3967-87fe-df42a7dd3c16",
                    "sense_definition": "À l'heure actuelle comme auparavant, sans avoir cessé.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "continuite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est midi et mon frère dort <w>toujours</w> dans sa chambre."
                        },
                        {
                            "text": "Nous attendons son appel, mais elle n'a <w>toujours</w> pas téléphoné ce matin."
                        }
                    ],
                    "synonyms": [
                        "encore"
                    ],
                    "common_phrases": [
                        "toujours pas",
                        "toujours là"
                    ]
                },
                {
                    "sense_id": "dd05f5f8-5a80-3c3b-98b6-d6b73e074024",
                    "sense_definition": "De manière habituelle ou dans la majorité des cas.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "frequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme <w>toujours</w>, il arrive avec dix minutes d'avance à notre rendez-vous."
                        },
                        {
                            "text": "Le dimanche soir, nous mangeons <w>toujours</w> une soupe légère en famille."
                        }
                    ],
                    "synonyms": [
                        "habituellement"
                    ],
                    "antonyms": [
                        "parfois",
                        "exceptionnellement"
                    ],
                    "common_phrases": [
                        "comme toujours"
                    ]
                },
                {
                    "sense_id": "8865dbc7-2fe9-354b-b849-558514c8e763",
                    "sense_definition": "En tout cas, de toute façon, à tout le moins.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce n'est pas parfait, mais c'est <w>toujours</w> ça de gagné pour aujourd'hui."
                        },
                        {
                            "text": "Prends un parapluie avec toi, cela peut <w>toujours</w> servir en cas d'averse."
                        }
                    ],
                    "common_phrases": [
                        "c'est toujours ça",
                        "toujours est-il"
                    ]
                },
                {
                    "sense_id": "4e30541b-0a5a-3c96-9223-d344859ed663",
                    "sense_definition": "En attendant, provisoirement ou par précaution.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Commencez <w>toujours</w> à préparer le repas, je vous rejoindrai dès que possible."
                        },
                        {
                            "text": "Prenez <w>toujours</w> cette somme en avance en attendant le virement complet."
                        }
                    ]
                }
            ]
        }
    ]
}