                    "sense_id": "c97fb078-60c1-3b8f-ae67-f8eb893154c2",
                    "sense_definition": "Лишённый света или освещения.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В <w>тёмной</w> комнате ничего не было видно.",
                            "target_lang_translations": {
                                "en": "Nothing could be seen in the <w>dark</w> room."
                            }
                        },
                        {
                            "text": "На улице стало <w>тёмно</w> из-за туч.",
                            "target_lang_translations": {
                                "en": "It became <w>dark</w> outside because of the clouds."
                            }
                        }
