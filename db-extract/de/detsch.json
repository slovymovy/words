                        "entry_id": "f0fb465e-497d-3acd-b1f2-5de464e819e4",
                        "glosses": [
                            "nicht recht bei Verstand seiend, nicht ganz bei Sinnen seiend oder eine Macke habend; ungeschickt"
                        ],
