                                        "sense_id": "cf61b4e1-e68c-3ed4-9d04-ffee1f878411",
                                        "entry_id": "b00640fd-0429-3e49-8d23-54f86b53e6f3",
                                        "glosses": [
                                            "A nebula composed of ionized gases which produce visible light (as distinct from a reflection nebula, which reflects the light produced by neighboring stars)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76973ff-aa69-460c-886d-4265f6407b6b",
                                                "sense_id": "cf61b4e1-e68c-3ed4-9d04-ffee1f878411",
                                                "text": "The Orion nebula is an emission nebula—it glows with its own light."
                                            },
                                            {
                                                "example_id": "3f782ef4-00e2-43a4-bd52-74507b8268f5",
                                                "sense_id": "cf61b4e1-e68c-3ed4-9d04-ffee1f878411",
                                                "text": "Kitt Peak National Observatory, in Arizona, 56 miles southwest of Tucson, offers a rare opportunity to spend an entire night looking through powerful telescopes at galaxies, planetary emission nebulae and star clusters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
