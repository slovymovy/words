                "senses": [
                    {
                        "sense_id": "48cf2082-d34a-3e51-a7b4-83453d28bcaf",
                        "entry_id": "6ca46110-c56a-3451-be90-54ed27a7bb03",
                        "glosses": [
                            "Délocaliser pour corriger la trop grande importance d’une métropole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bfeef65-1e9c-41e5-8d31-2ab5ce5fafb6",
                                "sense_id": "48cf2082-d34a-3e51-a7b4-83453d28bcaf",
                                "text": "la DGFIP va aussi « démétropoliser » ses services : bien-sûr, on y croît … la direction locale de la DDFIP 34 installée à Ganges, par exemple !"
                            },
                            {
                                "example_id": "0dfd5d41-aa6a-4f2c-89c7-8b0cf852d040",
                                "sense_id": "48cf2082-d34a-3e51-a7b4-83453d28bcaf",
                                "text": "\"Démétropoliser\" le pays ?"
                            },
                            {
                                "example_id": "20995772-da5d-421e-bf7f-373cd16e9141",
                                "sense_id": "48cf2082-d34a-3e51-a7b4-83453d28bcaf",
                                "text": "Même si le mot est barbare, «démétropoliser» consiste, professe l'élu, à réduire les déséquilibres territoriaux en mettant en place une grande politique d’aménagement, déclinant le «localisme» cher au parti de Marine Le Pen."
                            }
                        ]
                    }
