                "senses": [
                    {
                        "sense_id": "5f8dc8e5-2ae6-34da-b1eb-d5c6dc68a173",
                        "entry_id": "a197faff-baad-3df6-aecc-f1e7012b7360",
                        "glosses": [
                            "наречие к бесплатный; не получая или не давая ничего взамен"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "4f5c53b5-ab7b-4e41-ae3c-200adc9be99d",
                                "sense_id": "5f8dc8e5-2ae6-34da-b1eb-d5c6dc68a173",
                                "text": "Моим учителям не нужно гонорара, они все учат бесплатно и даже, напротив, они же благодарят меня за внимание."
                            },
                            {
                                "example_id": "78ecf282-a119-446e-9ce2-15e1bb288e58",
                                "sense_id": "5f8dc8e5-2ae6-34da-b1eb-d5c6dc68a173",
                                "text": "Столяр смотрел-смотрел на своего квартиранта и начал его кормить бесплатно со своего стола."
                            }
                        ]
                    }
                ],
                "translations": [
