                    {
                        "sense_id": "50af4a1c-cb5a-3333-826b-efd6352d45dd",
                        "entry_id": "7a54e565-ec7b-337f-a2a0-53fb2f184c15",
                        "glosses": [
                            "Qui contient de la silice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5491c508-7b76-432c-8785-e508e56b5f82",
                                "sense_id": "50af4a1c-cb5a-3333-826b-efd6352d45dd",
                                "text": "Lorsque dans un terrain siliceux avec un sous-sol de micaschiste qui ne produit presque rien, on élève une race de petits chevaux, que faut-il faire pour leur donner plus de taille, des formes plus régulières […]."
                            },
                            {
                                "example_id": "1e23e20a-7fcb-44d0-b0ea-dbc48773f699",
                                "sense_id": "50af4a1c-cb5a-3333-826b-efd6352d45dd",
                                "text": "Les landes siliceuses connaissent souvent une grande abondance de Fougères : au Pays basque la Fougère-aigle constitue d’importants pâturages qui rougeoient à l’automne."
                            }
                        ]
                    },
                    {
                        "sense_id": "57cfd50e-92c9-3e74-9259-e46be01397e2",
                        "entry_id": "7a54e565-ec7b-337f-a2a0-53fb2f184c15",
                        "glosses": [
                            "Silicicole."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ee44b014-096d-4def-8948-41a37c7fcf00",
                                "sense_id": "57cfd50e-92c9-3e74-9259-e46be01397e2",
                                "text": "Le spectre biologique de l’association des moissons siliceuses accuse une proportion très élevée de Thérophytes[…]"
                            }
                        ]
                    }
