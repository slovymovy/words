                                "example_id": "155d399c-ba8f-4a23-8a8e-28e8ffc3bec6",
                                "sense_id": "a1fb9af6-220a-3b3c-a75b-991f0cf42f5b",
                                "text": "The cropping of the Quincy ore-bearing bed, the equivalent of the Daly West bed, is stated to have been found at the east end of the present mine and just below the present wagon road."
                            }
