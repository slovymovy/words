                "senses": [
                    {
                        "sense_id": "967dff5a-b301-3a88-86ed-d9ccc8204992",
                        "entry_id": "b005f6e8-27cb-33d9-bdca-1baed08b581c",
                        "glosses": [
                            "Pratique d’affinage des huîtres qui consiste à les remonter progressivement sur l’estran, de façon à allonger les périodes d’émersion et à habituer les huîtres à tenir leur coquille fermée en gardant leur eau."
                        ],
                        "tags": [
                            "Ostréiculture"
                        ],
                        "examples": [
                            {
                                "example_id": "02e1e244-a0a8-4822-8ccf-050153bb346e",
                                "sense_id": "967dff5a-b301-3a88-86ed-d9ccc8204992",
                                "text": "Elles [les huîtres] y subissent ce que l’on appelle l’opération du trompage. Les ostréiculteurs les placent un peu plus haut sur les parcs où le niveau d’eau est contrôlé."
                            },
                            {
                                "example_id": "2546e393-c329-455a-812e-2191c34ee75b",
                                "sense_id": "967dff5a-b301-3a88-86ed-d9ccc8204992",
                                "text": "Réalisé en collaboration avec le Comité régional de la conchyliculture Normandie-Mer du Nord, ce projet a pour objectif de permettre aux professionnels normands de faire reconnaitre la pratique du « trompage » (placer des huîtres haut sur estran) comme pratique d’affinage."
                            }
                        ]
                    }
