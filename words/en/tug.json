                },
                {
                    "sense_id": "25b6d3bc-0567-31fb-94f3-c0a22dac738e",
                    "sense_definition": "A small, powerful boat used for maneuvering larger vessels; a tugboat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small <w>tug</w> guided the massive cargo ship into the busy port.",
                            "target_lang_translations": {
                                "ru": "Небольшой <w>буксир</w> провел массивное грузовое судно в оживленный порт.",
                                "zh": "那艘小型<w>拖船</w>引导着巨大的货轮进入繁忙的港口。",
                                "pl": "Mały <w>holownik</w> wprowadził ogromny statek towarowy do ruchliwego portu.",
                                "cs": "Malý <w>remorkér</w> navedl obrovskou nákladní loď do rušného přístavu."
                            }
                        },
                        {
                            "text": "We watched the harbor <w>tug</w> pull the cruise liner away from the dock.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как портовый <w>буксир</w> оттягивает круизный лайнер от причала.",
                                "zh": "我们看着港口<w>拖船</w>将游轮从码头拉开。",
                                "pl": "Obserwowaliśmy, jak portowy <w>holownik</w> odciąga wycieczkowiec od nabrzeża.",
                                "cs": "Sledovali jsme, jak přístavní <w>remorkér</w> odtahuje výletní loď od mola."
                            }
                        }
                    ],
                    "synonyms": [
                        "tugboat"
                    ],
                    "common_phrases": [
                        "harbor tug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое мощное судно, используемое для маневрирования и перемещения крупных судов; буксир.",
                        "zh": "用于牵引大型船只的小型强力船；拖船。",
                        "pl": "Mała, silna jednostka pływająca używana do manewrowania większymi statkami; holownik.",
                        "cs": "Malá, výkonná loď používaná k manévrování s většími plavidly; remorkér."
                    },
