                ],
                "senses": [
                    {
                        "sense_id": "91a03592-b65d-3dcd-8ee1-23c4886529dc",
                        "entry_id": "f7debeb7-d9eb-31c2-94ce-7c7fe81f1d68",
                        "glosses": [
                            "großes Unternehmen der Energiebranche, dessen Aufgabe in der Förderung von Öl, Erdgas oder Kohle, in der Weiterverarbeitung von Erdöl (beispielsweise zu Benzin, Kerosin, Heizöl), in der Erzeugung von elektrischem Strom in Kraftwerken und/oder Wärme und der Verteilung (beispielsweise mit Stromnetzen, Pipelines) von Strom, Gas und Fernwärme besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ccdc4d7-f086-4eb0-950c-7325c8124c6f",
                                "sense_id": "91a03592-b65d-3dcd-8ee1-23c4886529dc",
                                "text": "„Der Energiekonzern Vattenfall will die Rotoren seiner Windräder künftig recyceln und wiederverwenden.“"
                            },
                            {
                                "example_id": "083f349c-8642-4a7f-ae6a-c501560bfe97",
                                "sense_id": "91a03592-b65d-3dcd-8ee1-23c4886529dc",
                                "text": "„Die Rohrleitung, die allein dem russischen Energiekonzern Gazprom gehört, hat eine Leistung von knapp 33 Milliarden Kubikmetern Gas jährlich.“"
                            },
                            {
                                "example_id": "4ab2135b-c8ac-4f35-b5c1-f6a345c97c0e",
                                "sense_id": "91a03592-b65d-3dcd-8ee1-23c4886529dc",
                                "text": "„In Turow wird seit 1904 Kohle abgebaut. Der polnische Energiekonzern PGE, mehrheitlich im Staatsbesitz, will den Abbau bis 2044 verlängern.“"
                            },
                            {
                                "example_id": "d53f284a-5a96-4974-99de-a1b8668afcd6",
                                "sense_id": "91a03592-b65d-3dcd-8ee1-23c4886529dc",
                                "text": "„Der dänische Energiekonzern Ørsted ist eigenen Angaben zufolge \"Marktführer im Bereich Offshore-Windenergie\" […].“"
                            },
                            {
                                "example_id": "b7fbbb56-136a-402a-88ad-56e94c4fea58",
                                "sense_id": "91a03592-b65d-3dcd-8ee1-23c4886529dc",
                                "text": "„Wegen der angespannten Sicherheitslage im Norden Mosambiks zieht der französische Energiekonzern Total seine Mitarbeiter aus einem milliardenschweren Flüssiggasprojekt komplett ab.“"
                            },
                            {
                                "example_id": "337627e1-d218-4d08-90ef-47fa389bec9c",
                                "sense_id": "91a03592-b65d-3dcd-8ee1-23c4886529dc",
                                "text": "„Am Mittwoch hat der deutsche Energiekonzern RWE in Dänemark einen großen Auftrag zum Bau eines Offshore-Windparks an Land gezogen.“"
                            },
                            {
                                "example_id": "a3dfa7ee-8ebb-4d29-b8b6-78129f7446ac",
                                "sense_id": "91a03592-b65d-3dcd-8ee1-23c4886529dc",
                                "text": "„Der Energiekonzern Eon hat mit seiner Atomklage gegen den Bund und zwei Länder eine Schlappe erlitten.“"
                            },
                            {
                                "example_id": "119bacbf-0527-484c-93c2-6166140f14a3",
                                "sense_id": "91a03592-b65d-3dcd-8ee1-23c4886529dc",
                                "text": "„Strom wird teurer. Der Aargauer Energiekonzern AEW erhöht den Strompreis für das kommende Jahr.“"
                            },
                            {
                                "example_id": "444b5be6-6f66-4854-b265-607818a8a8a5",
                                "sense_id": "91a03592-b65d-3dcd-8ee1-23c4886529dc",
                                "text": "„Die Restrukturierung bei Alpiq trägt erste Früchte: Der Energiekonzern hat im ersten Halbjahr 2016 seinen Reinverlust deutlich auf 2 Millionen Franken verringert.“"
                            },
                            {
                                "example_id": "90ee473d-53d6-431b-afc5-231634852224",
                                "sense_id": "91a03592-b65d-3dcd-8ee1-23c4886529dc",
                                "text": "„Die Verträge mit dem Energiekonzern, der das Walchenseekraftwerk betreibt, laufen 2030 aus und werden bereits neu verhandelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
