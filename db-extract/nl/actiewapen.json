                        "examples": [
                            {
                                "example_id": "944ad8d3-6528-41fc-bef9-0a6e73cb59d6",
                                "sense_id": "29ff55ca-45e8-3ff0-b3ce-a4a22a20371a",
                                "text": "\"De bonden hebben zich dit jaar een onbetrouwbare partner getoond, zijn weggelopen van de onderhandelingstafel en hebben direct gegrepen naar het actiewapen. Toen hebben wij - samen met de ondernemingsraad - een avr (arbeidsvoorwaardenregeling) opgesteld. Inmiddels heeft 80 procent van de medewerkers die avr getekend. Die is dus gekomen in plaats van een cao. Dat zit de FNV blijkbaar erg dwars. Deze rechtszaak wordt duidelijk aangegrepen om weer voor onrust te zorgen.\""
                            }
