                        "target_lang_word": "Waiblinger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waiblinger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a360973-c268-31f5-8016-d5dd9f7b8cad",
                                        "entry_id": "2c17c112-f9fa-34c6-b80d-ff5ac94f3171",
                                        "glosses": [
                                            "Einwohner, Bewohner der Stadt Waiblingen, eine in Waiblingen geborene Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "460f8ce7-5193-4f71-b9fd-231528f73a21",
                                                "sense_id": "2a360973-c268-31f5-8016-d5dd9f7b8cad",
                                                "text": "Er ist gebürtiger Waiblinger."
                                            },
                                            {
                                                "example_id": "f9c3cbd8-6115-44a9-ae4d-5ccfee56d704",
                                                "sense_id": "2a360973-c268-31f5-8016-d5dd9f7b8cad",
                                                "text": "„Ich sehe mich selbst schon als Waiblinger!“"
                                            },
                                            {
                                                "example_id": "e87161f0-cc5f-45ef-abeb-d128a94c30f5",
                                                "sense_id": "2a360973-c268-31f5-8016-d5dd9f7b8cad",
                                                "text": "„Schlotterbeck ist gebürtiger Waiblinger.“"
                                            },
                                            {
                                                "example_id": "7a2404ec-e713-468f-bc98-7a18e4299d7a",
                                                "sense_id": "2a360973-c268-31f5-8016-d5dd9f7b8cad",
                                                "text": "„Schließlich war Georg Hartzesser, der Dekan der Tübinger Uni gegen Ende des 15. Jahrhunderts, ein gebürtiger Waiblinger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Waiblinger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7381b1d-e1ec-3cb5-84d8-27da7fb21443",
                                        "entry_id": "9cf99022-4afd-31bc-91eb-1fd1b7e5ce8f",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea6b40cf-7aab-4a07-af32-ce06f6857937",
                                                "sense_id": "e7381b1d-e1ec-3cb5-84d8-27da7fb21443",
                                                "text": "Frau Waiblinger ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "b6694f9e-9f5d-49a9-87fd-72a8a0e611c5",
                                                "sense_id": "e7381b1d-e1ec-3cb5-84d8-27da7fb21443",
                                                "text": "Herr Waiblinger wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "f3b1d70c-a5e1-4a41-b084-90fb7b9d276b",
                                                "sense_id": "e7381b1d-e1ec-3cb5-84d8-27da7fb21443",
                                                "text": "Die Waiblingers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "0a62f796-a5eb-44a2-93dc-8d4c8779423f",
                                                "sense_id": "e7381b1d-e1ec-3cb5-84d8-27da7fb21443",
                                                "text": "Der Waiblinger trägt nie die Schals, die die Waiblinger ihm strickt."
                                            },
                                            {
                                                "example_id": "3b971aac-65b1-4193-92e2-8154e0613fab",
                                                "sense_id": "e7381b1d-e1ec-3cb5-84d8-27da7fb21443",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Waiblinger kommt, geht der Herr Waiblinger.“"
                                            },
                                            {
                                                "example_id": "1500a30b-0f45-43bb-af44-bbe3661bd286",
                                                "sense_id": "e7381b1d-e1ec-3cb5-84d8-27da7fb21443",
                                                "text": "Waiblinger kommt und geht."
                                            },
                                            {
                                                "example_id": "6fcc87f5-7d46-42a6-9339-9643033bd678",
                                                "sense_id": "e7381b1d-e1ec-3cb5-84d8-27da7fb21443",
                                                "text": "Waiblingers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Waiblinger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6ebb52d-ceb3-3aa2-b4e7-5106a7c9a9b3",
                                        "entry_id": "5971c86e-e57c-38e6-8a0c-0bcbaed43a34",
                                        "glosses": [
                                            "sich auf Waiblingen beziehend, in der Art und Weise dieser Stadt, aus Waiblingen kommend, stammend, Waiblingen betreffend, zu Waiblingen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f5eeb6-8bfc-47d3-abd8-2770f312badb",
                                                "sense_id": "c6ebb52d-ceb3-3aa2-b4e7-5106a7c9a9b3",
                                                "text": "Ein typisches Beispiel für mehrfache Waiblinger Straßennamen ist „Waiblinger Straße“."
                                            },
                                            {
                                                "example_id": "5f5dfb9a-feed-4313-8820-34f7743178bc",
                                                "sense_id": "c6ebb52d-ceb3-3aa2-b4e7-5106a7c9a9b3",
                                                "text": "„Bereits im Endersbacher Markt ist die Waiblinger Familienbäckerei präsent.“"
                                            },
                                            {
                                                "example_id": "c9df578d-a632-4478-abcd-07f8f448df2f",
                                                "sense_id": "c6ebb52d-ceb3-3aa2-b4e7-5106a7c9a9b3",
                                                "text": "„Sonnig ist es jedenfalls – und auch der Waiblinger Schultes freut sich, dass bislang alles reibungslos über die Bühne geht und die Stimmung stimmt.“"
                                            },
                                            {
                                                "example_id": "59c4fe74-4bb5-46e7-b715-9374e76d75a8",
                                                "sense_id": "c6ebb52d-ceb3-3aa2-b4e7-5106a7c9a9b3",
                                                "text": "„Die beiden sollen mit Sturmhauben maskiert einen 36 Jahre alten Mann in einer Waiblinger Sackgasse getroffen haben.“"
                                            },
                                            {
                                                "example_id": "1367b9d3-1ce2-4d54-a067-91a58d548382",
                                                "sense_id": "c6ebb52d-ceb3-3aa2-b4e7-5106a7c9a9b3",
                                                "text": "„Später habe sie dann auch das Waiblinger Amtsgericht ins Visier genommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
