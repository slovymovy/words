                "senses": [
                    {
                        "sense_id": "15ff3ca0-7a5b-3250-9de4-3dc345955d31",
                        "entry_id": "943cc394-73d0-37a6-9dd9-3876ea6c5cfe",
                        "glosses": [
                            "Apporter le bonheur."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f10dc708-871f-4791-bd16-3d9b74fb3cf2",
                                "sense_id": "15ff3ca0-7a5b-3250-9de4-3dc345955d31",
                                "text": "Il entend, Denis, qu’on parle d’un écrivain à succès ayant vendu 450 000 exemplaires d’un livre policé, qui bonheurise à petites doses, sans drame, sans idée, tout en odeurs et saveurs, et qui fait de sa vie individuelle un théâtre de la singularité béate, à l’abri des cruautés sociales."
                            }
                        ]
                    },
                    {
                        "sense_id": "d361af78-af24-38b9-99ff-056862d7c553",
                        "entry_id": "943cc394-73d0-37a6-9dd9-3876ea6c5cfe",
                        "glosses": [
                            "Faire son bonheur."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c4f72c6b-4cb8-4713-b16f-29b97b891a55",
                                "sense_id": "d361af78-af24-38b9-99ff-056862d7c553",
                                "text": "Quand le sieur, libéral, vous parle du droit, libéral, qu’a chacun de rechercher son bonheur, soyez sûr que ce pacha rusé bonheurise sur le dos d’autrui."
                            }
                        ]
                    }
                ],
