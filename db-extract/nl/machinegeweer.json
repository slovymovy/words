                        "entry_id": "74f95eb9-8111-30e9-86cd-9e9632d3f7a4",
                        "glosses": [
                            "geweer waarmee kort na elkaar meerdere schoten kunnen worden afgevuurd, zonder dat men tussendoor de trekker moet loslaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b512eca7-7da4-4b4d-bd65-139fec561996",
                                "sense_id": "2da201d1-689e-3d08-9800-0efc99331c3a",
                                "text": "Met een machinegeweer het vuur openen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac889ba1-a60d-49fb-a263-17040d27edab",
                        "source_entry_id": "74f95eb9-8111-30e9-86cd-9e9632d3f7a4",
                        "source_sense_id": "2da201d1-689e-3d08-9800-0efc99331c3a",
                        "source_sense_description": "geweer waarmee kort na elkaar meerdere schoten kunnen worden afgevuurd, ...",
                        "target_lang_word": "Maschinengewehr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maschinengewehr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3aaaaa5-320a-3489-a924-29a231246a5b",
                                        "entry_id": "9ade7398-0dde-3794-885d-71f652926c2d",
                                        "glosses": [
                                            "auf einem Stativ montierte Schnellschusswaffe, die selbstständig nachlädt und schießt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae05bd5-9071-4976-8ea6-3dad83baf889",
                                                "sense_id": "f3aaaaa5-320a-3489-a924-29a231246a5b",
                                                "text": "„Das Knarren der Maschinengewehre wird eine ununterbrochene Kette.“"
                                            },
                                            {
                                                "example_id": "705118b2-aa85-4898-a573-f95b206ddccf",
                                                "sense_id": "f3aaaaa5-320a-3489-a924-29a231246a5b",
                                                "text": "„Zudem konnte schon bald jeder von uns die an Bord mitgeführten Handfeuerwaffen wie Maschinengewehre oder Maschinenpistolen fast schon mit verbundenen Augen zerlegen und pflegen.“"
                                            },
                                            {
                                                "example_id": "3510e4da-1b6d-4cc4-973e-3cb026984f54",
                                                "sense_id": "f3aaaaa5-320a-3489-a924-29a231246a5b",
                                                "text": "„Vor Aufregung schießt der Mann am Maschinengewehr auf den Turm, schwer rollt das Echo zurück.“"
                                            },
                                            {
                                                "example_id": "e47ab159-84b7-405a-bd70-a171416353f3",
                                                "sense_id": "f3aaaaa5-320a-3489-a924-29a231246a5b",
                                                "text": "„Allein bei der Vorstellung, bald mit einem Maschinengewehr auf jemanden oder etwas schießen zu müssen, wurde ihm schlecht.“"
                                            },
                                            {
                                                "example_id": "7d0072bd-89ee-42ee-953d-c0593f4a82bd",
                                                "sense_id": "f3aaaaa5-320a-3489-a924-29a231246a5b",
                                                "text": "„Ein sehr alter Lehrer, ein Nazi, beschaffte sich ein Maschinengewehr und ballerte auf sie los, dafür steckten sie eine Straße in Brand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ea83a75-0999-41d3-865c-82c52dea818a",
                        "source_entry_id": "74f95eb9-8111-30e9-86cd-9e9632d3f7a4",
                        "source_sense_id": "2da201d1-689e-3d08-9800-0efc99331c3a",
                        "source_sense_description": "geweer waarmee kort na elkaar meerdere schoten kunnen worden afgevuurd, ...",
                        "target_lang_word": "machine gun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machine gun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afe1722b-5308-31a7-9c76-f598afade415",
                                        "entry_id": "f1d2110c-384c-3cc4-a797-0d41e721a225",
                                        "glosses": [
                                            "A type of fully automatic firearm that fires bullets in rapid succession by a single action of the trigger and is capable of sustained fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13290460-33de-4b1b-9dbb-4d2372b744a5",
                                                "sense_id": "afe1722b-5308-31a7-9c76-f598afade415",
                                                "text": "I'm gonna get you, baby / Like a machine gun, I'm gonna… Tak-Tak-Tak-Tak-Tak"
                                            },
                                            {
                                                "example_id": "b262e93e-da9d-4cbf-920c-58d1adfa16b0",
                                                "sense_id": "afe1722b-5308-31a7-9c76-f598afade415",
                                                "text": "Whether modern, industrial man is less or more warlike than his hunter-gatherer ancestors is impossible to determine. The machine gun is so much more lethal than the bow and arrow that comparisons are meaningless."
                                            },
                                            {
                                                "example_id": "c94c8e55-a561-4b40-b7d4-8ab22cfec23a",
                                                "sense_id": "afe1722b-5308-31a7-9c76-f598afade415",
                                                "text": "Brigadier John K. Lawson's bunker on the west side of Wong Nai Chung Gap that the West Brigade used as headquarters. Brigadier Lawson and three of his men were hit by machine-gun fire escaping from the bunker on Dec. 19, 1941."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc4e0717-291e-4ae9-af86-1c26819dd6d4",
                        "source_entry_id": "74f95eb9-8111-30e9-86cd-9e9632d3f7a4",
                        "source_sense_id": "2da201d1-689e-3d08-9800-0efc99331c3a",
                        "source_sense_description": "geweer waarmee kort na elkaar meerdere schoten kunnen worden afgevuurd, ...",
                        "target_lang_word": "mitrailleuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitrailleuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aacdb0ef-7855-320d-8634-535d21470dfc",
                                        "entry_id": "f09a625e-54a3-3fd1-bffb-f9d62f68ff49",
                                        "glosses": [
                                            "Arme à feu automatique, disposée de manière à envoyer des balles avec une très grande rapidité."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e45a911-84fa-4e4a-bf6e-dbf2a005f4bd",
                                                "sense_id": "aacdb0ef-7855-320d-8634-535d21470dfc",
                                                "text": "Le feu des fusils Mauser commença ; ce fut un vacarme épouvantable dans lequel on percevait le ronflement des obus à la lydite, le crépitement des fusils Metford, les éclats des mitrailleuses boers et les sifflements des Mauser."
                                            },
                                            {
                                                "example_id": "b2c39f89-9e2b-4c8c-b6d9-a2bbd11a9be4",
                                                "sense_id": "aacdb0ef-7855-320d-8634-535d21470dfc",
                                                "text": "En outre, des bandes de mitrailleuses furent trouvées, entièrement ou partiellement garnies de balles explosibles"
                                            },
                                            {
                                                "example_id": "90d59b4e-f318-4535-a42e-36f762d6df4e",
                                                "sense_id": "aacdb0ef-7855-320d-8634-535d21470dfc",
                                                "text": "Partout les canons et les mitrailleuses se forgent, […], marchandise ignoble qui circule sous tous les pavillons, en attendant de frapper, sous tous les drapeaux, des foules crédules."
                                            },
                                            {
                                                "example_id": "d2327a2e-8f23-4163-a719-9105f5e2e5a4",
                                                "sense_id": "aacdb0ef-7855-320d-8634-535d21470dfc",
                                                "text": "La police attend avec des mitrailleuses et des gaz les grévistes noirs de Pennsylvanie."
                                            },
                                            {
                                                "example_id": "af959967-686d-4d56-abe4-0d61bdb8a87d",
                                                "sense_id": "aacdb0ef-7855-320d-8634-535d21470dfc",
                                                "text": "Le pont était couvert de soldats. Il devait y en avoir aussi dans les cales, tassés dans l’obscurité étouffante. C’était une chance d’être arrivés les derniers. Ils passèrent à côté d’une mitrailleuse jumelée montée sur pivot, et dont les canons, dépouillés de leur gaine, étaient pointés vers le ciel. Il devait y en avoir une autre à l’avant."
                                            },
                                            {
                                                "example_id": "1a28b4dd-6f78-427e-a7b5-671dfc510b78",
                                                "sense_id": "aacdb0ef-7855-320d-8634-535d21470dfc",
                                                "text": "Un adolescent est retiré de la file. Juste avant qu’une forte détonation venue d’une tour militaire l’envoie bouler sur l’asphalte, la tête broyée par une balle de mitrailleuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b74a7de-9c04-3fd7-b197-39012d9e3f4e",
                                        "entry_id": "f09a625e-54a3-3fd1-bffb-f9d62f68ff49",
                                        "glosses": [
                                            "Soldate qui utilise cette arme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd7d1de-c47c-4bfe-be10-c318e6ebd97c",
                                                "sense_id": "0b74a7de-9c04-3fd7-b197-39012d9e3f4e",
                                                "text": "Dans le parc, une statue de deux héroïnes locales de la Seconde Guerre mondiale, la mitrailleuse Manchouk Mametova et la tireuse d’élite Alia Moldagoulova, a remplacé celle de Lénine après l’indépendance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
