                        "glosses": [
                            "Personne originaire de l’Afrique du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05b4875c-1687-4672-83f6-e9da4093a5fd",
                                "sense_id": "54157f6a-b6e9-3267-914f-eaf66ece1fdf",
                                "text": "Présents dans la capitale dès le début du XIXᵉ siècle, les Nord-Africains arrivent en masse avec les deux guerres mondiales : ils sont 100 000 après la première, 1 million suite à la seconde."
                            }
                        ]
                    }
