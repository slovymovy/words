                        "examples": [
                            {
                                "example_id": "2ad0807d-77fb-4783-8e1a-599eb695a797",
                                "sense_id": "971d8c59-9c2b-3713-83e7-fe73c5b52056",
                                "text": "„In dem von ihr geschaffenen politischen Klima hatten friedlicher Protest und Gesprächsbereitschaft keine Chance gegen Prügel und Benzinbomben.“"
                            },
                            {
                                "example_id": "506f2185-0835-45ff-8c86-f41132804c1d",
                                "sense_id": "971d8c59-9c2b-3713-83e7-fe73c5b52056",
                                "text": "„Maschinengewehrsalven wurden über dem Seidenbrokatfluss abgefeuert, Panzer rollten über die Boulevards, Benzinbomben kullerten von den reich verzierten Balkonen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
