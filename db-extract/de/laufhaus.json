                "senses": [
                    {
                        "sense_id": "1b675d59-cd6a-3328-b3c5-508c5cb478b0",
                        "entry_id": "9edfed09-a04a-34a2-aa13-2f8e41acabdb",
                        "glosses": [
                            "Gebäude, in dem verschiedene Prostituierte Zimmer gemietet haben, vor oder in denen sie sich vorbeikommenden Freiern präsentieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfefee79-41b3-464a-81a9-6f601be1dd77",
                                "sense_id": "1b675d59-cd6a-3328-b3c5-508c5cb478b0",
                                "text": "„Laufhäuser sind vor allem in so genannten Rotlichtvierteln von Metropolen oder in Industriegebieten an der urbanen Peripherie zu finden.“"
                            },
                            {
                                "example_id": "52ba22f9-fd36-45d7-b15b-ce66f0386e5e",
                                "sense_id": "1b675d59-cd6a-3328-b3c5-508c5cb478b0",
                                "text": "„Die Logik eines Laufhauses liegt darin, dass der Kunde weitergeht, bloß nicht stehen bleibt, die Frauen im Vorbeigehen sichtet und vergleicht und aus der zügigen Bewegung heraus eine Kaufentscheidung trifft: hammerhartes Business.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e441002-2d32-439c-a761-dcd573f689e2",
                        "source_entry_id": "9edfed09-a04a-34a2-aa13-2f8e41acabdb",
                        "source_sense_id": "1b675d59-cd6a-3328-b3c5-508c5cb478b0",
                        "target_lang_word": "brothel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brothel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86f6099f-9758-37a2-a209-99cf3e525f76",
                                        "entry_id": "b87ac7eb-e3f8-3831-a413-2cfd40d3a5a6",
                                        "glosses": [
                                            "A house of prostitution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b7209e-1e03-412c-ab87-131039bffbee",
                                                "sense_id": "86f6099f-9758-37a2-a209-99cf3e525f76",
                                                "text": "Thus, during the last four years, I have visited brothels about every ten days or two weeks. Only seldom does coitus fail; for I have learned my peculiarities, and in the choice of a prostitute know immediately whether she will excite me or have no effect."
                                            },
                                            {
                                                "example_id": "b1f3fe98-f74e-46eb-a319-dc47e8385fde",
                                                "sense_id": "86f6099f-9758-37a2-a209-99cf3e525f76",
                                                "text": "Only women already existing in the social margins became actresses.²⁶ For example, celebrated tragedienne Elizabeth Barry was an orphan, Nell Gwynn a barmaid raised in a brothel, Moll Davis the illegitimate daughter of a Colonel. Other actresses were the wives and daughters of male actors, as for example Mary Saunderson (Mrs Betterton) and (in a later period) Mrses Kean, Kemble and Siddons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brothel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5560f590-e403-3695-8a0b-f13abb35e638",
                                        "entry_id": "ca4ae1aa-3957-3d94-95b6-95afcda48b13",
                                        "glosses": [
                                            "A wretch; a depraved or lewd person."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "961bb493-e719-471d-9854-fb3c5b073628",
                        "source_entry_id": "9edfed09-a04a-34a2-aa13-2f8e41acabdb",
                        "source_sense_id": "1b675d59-cd6a-3328-b3c5-508c5cb478b0",
                        "target_lang_word": "maison close",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maison close",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "142f35c6-ab11-324f-9c1c-4d0e6cb89198",
                                        "entry_id": "c439476d-6cb5-367a-bba5-c08fc73fd2c0",
                                        "glosses": [
                                            "Établissement où se pratique la prostitution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58cc06fe-736b-4e36-adc2-5bed3e4c4d9a",
                                                "sense_id": "142f35c6-ab11-324f-9c1c-4d0e6cb89198",
                                                "text": "Cet homme, c’est le grand, l’unique Pelletier, ancien tenancier de maisons closes, ancien organisateur de partouzes, ancien marchand de viande […]"
                                            },
                                            {
                                                "example_id": "e063a475-d104-4fb9-bf7f-0644ff1260af",
                                                "sense_id": "142f35c6-ab11-324f-9c1c-4d0e6cb89198",
                                                "text": "Gabriel ne pouvait s’empêcher de songer à l’histoire du puritain, désolé de loger en face d’une maison close et qui, pour la mettre en faillite, avait dressé son perroquet à crier dès qu’en approchait un chaland furtif : « Il y va, l’vilain ! Il y va ! »"
                                            },
                                            {
                                                "example_id": "d997a495-57f5-443b-9963-7f0d736ba361",
                                                "sense_id": "142f35c6-ab11-324f-9c1c-4d0e6cb89198",
                                                "text": "Les maisons closes, qui ne furent, bien évidemment, rien d'autre souvent que d'effroyables et indignes «bouclards», présentaient au moins le mérite d'être fichées donc surveillées de près par la police et les « filles » qui y travaillaient d'être soumises à d'obligatoires et fréquentes visites médicales qui permettaient de déceler à temps les maux dont elles pouvaient être frappées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59047c4b-96bd-487d-acd8-54f2fe3db512",
                        "source_entry_id": "9edfed09-a04a-34a2-aa13-2f8e41acabdb",
                        "source_sense_id": "1b675d59-cd6a-3328-b3c5-508c5cb478b0",
                        "target_lang_word": "bordel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bordel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2572b3c4-9dd5-3daf-a7c5-7b0fe8cef1eb",
                                        "entry_id": "d2158c66-e967-367d-9eb5-3710e24ac3b9",
                                        "glosses": [
                                            "Établissement où se pratique la prostitution."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d01e66e6-7966-4ba2-955b-bd24b88af599",
                                                "sense_id": "2572b3c4-9dd5-3daf-a7c5-7b0fe8cef1eb",
                                                "text": "Monsieur l’curé a une fontaine\nAu bord d’elle, il va s’asseoir.\nAu bord d’el– papa\nAu bord d’el– maman\nAu bord d’elle il va s’asseoir."
                                            },
                                            {
                                                "example_id": "14024f05-40fb-4eba-ac07-139d0465279e",
                                                "sense_id": "2572b3c4-9dd5-3daf-a7c5-7b0fe8cef1eb",
                                                "text": "Il paroît qu’alors chaque bordel étoit régi immédiatement par une hôtesse, (Maquerelle Abbesse,) ou par un débauché affilié en titre, avec une fille de joie, qu’on appeloit hourier du mot allemand hour, qui signifie débauché ; hourière femme débauchée […]"
                                            },
                                            {
                                                "example_id": "2541fc6f-9c5e-468c-8136-cbc4eaa35dc1",
                                                "sense_id": "2572b3c4-9dd5-3daf-a7c5-7b0fe8cef1eb",
                                                "text": "Ne demandez jamais à une tragédienne où elle a passé ses années de bordel. Renseignez-vous auprès de ses amies."
                                            },
                                            {
                                                "example_id": "e422fef1-dc70-40aa-97ea-bc26f9ba5284",
                                                "sense_id": "2572b3c4-9dd5-3daf-a7c5-7b0fe8cef1eb",
                                                "text": "Le bordel, c’est le sein même de l’anonymat."
                                            },
                                            {
                                                "example_id": "793d4516-6ff5-419a-a90e-4d3c6855baa3",
                                                "sense_id": "2572b3c4-9dd5-3daf-a7c5-7b0fe8cef1eb",
                                                "text": "Le bordel militaire de campagne ou réservé à la clientèle militaire existe dans les colonies, mais n’a pas droit de cité en France métropolitaine, où il demeure un commerce privé."
                                            },
                                            {
                                                "example_id": "33de553f-69ab-4efa-a979-e6bdb311cb0e",
                                                "sense_id": "2572b3c4-9dd5-3daf-a7c5-7b0fe8cef1eb",
                                                "text": "Je ne sais pas pourquoi les bordels sont si souvent situés dans des rues aux noms aussi œcuméniques… L’hommage du vice à la vertu, sans doute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e82267-dbb1-350e-8485-6bc995140078",
                                        "entry_id": "d2158c66-e967-367d-9eb5-3710e24ac3b9",
                                        "glosses": [
                                            "Situation chaotique, grand désordre."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01418d55-0fbe-4a34-af25-399c7387f12f",
                                                "sense_id": "d8e82267-dbb1-350e-8485-6bc995140078",
                                                "text": "On dit qu’un pays est le bordel au simple quand des bandits de grand chemin se partagent le pays, comme au Liberia."
                                            },
                                            {
                                                "example_id": "b317dc18-4499-4f1f-a6ce-db9c5a395df1",
                                                "sense_id": "d8e82267-dbb1-350e-8485-6bc995140078",
                                                "text": "Peu à peu, notre pavillon fut envahi d’un bordel joyeux et incalculable, à l’image de notre mode de vie, dont les rares interdictions relevaient davantage de la météo ou de l’humeur que du savoir-vivre."
                                            },
                                            {
                                                "example_id": "9dc8387a-2422-41fe-976e-2fefeba52328",
                                                "sense_id": "d8e82267-dbb1-350e-8485-6bc995140078",
                                                "text": "Certains, au lieu de foutre le bordel, feraient mieux d’aller regarder s’ils ne peuvent pas avoir des postes là-bas."
                                            },
                                            {
                                                "example_id": "1c9910cb-5e7d-40fb-b46b-68084927bf26",
                                                "sense_id": "d8e82267-dbb1-350e-8485-6bc995140078",
                                                "text": "Tout cela, à l'échelle du Québec, voire de la francophonie, donne, disons-le, un beau gros bordel."
                                            },
                                            {
                                                "example_id": "2ab5a6eb-620e-4e5b-99c4-68316732161f",
                                                "sense_id": "d8e82267-dbb1-350e-8485-6bc995140078",
                                                "text": "Quel bordel ici ! Range-moi tout ça immédiatement…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f418f71-d2c4-3892-a457-0da5ef1777c0",
                                        "entry_id": "d2158c66-e967-367d-9eb5-3710e24ac3b9",
                                        "glosses": [
                                            "Terme générique pour désigner un ensemble d’objets, souvent agaçant."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "290fcb83-ffdd-44cc-bd83-4047ff96d3ef",
                                                "sense_id": "0f418f71-d2c4-3892-a457-0da5ef1777c0",
                                                "text": "– Et dans un tiroir quelconque, un pétard ou deux. Vous en avez bien un, ici. Et peut-être même un fusil de chasse à la panoplie, de la mort aux rats dans le grenier et tout un bordel tudatif éparpillé aux quatre coins ?"
                                            },
                                            {
                                                "example_id": "de84865c-144d-47bf-b2f2-4dfee1686e25",
                                                "sense_id": "0f418f71-d2c4-3892-a457-0da5ef1777c0",
                                                "text": "Qu’est-ce qui lui prend encore, au bordel-là, à faire un tel boucan ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bordel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "001e7bd7-132a-31a2-996e-da08e0388237",
                                        "entry_id": "cfcb49b1-ca9c-3f33-b065-451e05e0c8a4",
                                        "glosses": [
                                            "Interjection qui exprime la colère, le dépit, l'exaspération, etc."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a41658f4-2251-4705-a9b6-09e9df137c36",
                                                "sense_id": "001e7bd7-132a-31a2-996e-da08e0388237",
                                                "text": "Le moustachu m'empoigna par l'avant-bras : « Qu'est-ce que tu fous? C'est à toi, bordel ! »"
                                            },
                                            {
                                                "example_id": "3f881450-cbe4-4ae6-a47a-c87a37f39dca",
                                                "sense_id": "001e7bd7-132a-31a2-996e-da08e0388237",
                                                "text": "Manque l'odeur, quand même. Manque l'odeur. Une bonne odeur de chatte mouillée. Bordel de bordel de bordel, une bonne odeur de chatte baveuse et chaude que tu lappes comme un chat lappe son lait. J'en rebande, tiens, preuve en main."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
