                "senses": [
                    {
                        "sense_id": "fd82de64-c90a-3c57-9c46-4f07bf4a1cae",
                        "entry_id": "c1ea4f66-de70-34ac-8d41-3b86ea84956d",
                        "glosses": [
                            "loodrecht naar boven of naar beneden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a83fad37-364b-4175-8de0-b4a4ce6c1bde",
                                "sense_id": "fd82de64-c90a-3c57-9c46-4f07bf4a1cae",
                                "text": "Een ballistisch mes is een mes waarvan het lemmet, al dan niet tezamen met het heft, door middel van lucht-, gas- of veerdruk rechtstandig uit een geleidingscilinder wordt gedreven."
                            },
                            {
                                "example_id": "d3116349-f072-422e-ba4a-683669ecfd3a",
                                "sense_id": "fd82de64-c90a-3c57-9c46-4f07bf4a1cae",
                                "text": "Driemaal is scheepsrecht: commercieel ruimtetoerisme is een flinke stap dichterbij gekomen nu het Blue Origin is gelukt een raket drie keer naar de ruimte te laten vliegen en weer veilig rechtstandig te laten landen op de plaats van vertrek. Ook dit keer kwam de stinkzwamvormige New Shepard iets hoger dan 100 kilometer, de 'officiële' grens waar de ruimte begint."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12760fc8-0b23-454c-8419-c505ed642684",
                        "source_entry_id": "c1ea4f66-de70-34ac-8d41-3b86ea84956d",
                        "source_sense_id": "fd82de64-c90a-3c57-9c46-4f07bf4a1cae",
                        "source_sense_description": "loodrecht omhoog staand",
                        "target_lang_word": "upright",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "upright",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7491d7c-f953-3221-8dd2-49c6d4fedc80",
                                        "entry_id": "ae8baea6-5f62-3be0-8ced-cad4e4ecc33c",
                                        "glosses": [
                                            "Vertical; erect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc5626ce-6467-47a4-bbcc-d8dd01fd6a93",
                                                "sense_id": "c7491d7c-f953-3221-8dd2-49c6d4fedc80",
                                                "text": "Supported by pillows, ſhe ſat almoſt upright."
                                            },
                                            {
                                                "example_id": "ad142c02-e142-4f49-93dc-11ec68c123a8",
                                                "sense_id": "c7491d7c-f953-3221-8dd2-49c6d4fedc80",
                                                "text": "Fab[ell]: What meanes the tolling of this fatall chime, // O what a trembling horror ſtrikes my hart! // My ſtiffned haire ſtands vpright on my head, // As doe the briſtles of a porcupine."
                                            },
                                            {
                                                "example_id": "82b38e25-70c3-4ef6-bbd0-e6009a7e7c89",
                                                "sense_id": "c7491d7c-f953-3221-8dd2-49c6d4fedc80",
                                                "text": "Another feature new to British Railways is the provision of two-position adjustable seats in the first class compartments. In this design, the seat squab can be pulled out some six inches, the seat back being attached to the seat to give a less upright sitting position."
                                            },
                                            {
                                                "example_id": "a5e834e4-2e17-42a4-a385-038b39c48316",
                                                "sense_id": "c7491d7c-f953-3221-8dd2-49c6d4fedc80",
                                                "text": "Upright posture evolved well before an enlarged brain in hominids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88b43fe1-9de1-3957-952e-e4339acbec09",
                                        "entry_id": "ae8baea6-5f62-3be0-8ced-cad4e4ecc33c",
                                        "glosses": [
                                            "In its proper orientation; not overturned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7be43546-a3e1-49ab-97dc-47d88d2e95ce",
                                                "sense_id": "88b43fe1-9de1-3957-952e-e4339acbec09",
                                                "text": "My brother didn't get angry when his son knocked over the lamp; he simply called the boy over and helped him set it upright again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aa641f6-b5e4-36d8-aaa5-77e5d6b00cae",
                                        "entry_id": "ae8baea6-5f62-3be0-8ced-cad4e4ecc33c",
                                        "glosses": [
                                            "Greater in height than breadth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc487124-fbeb-30a5-9bd4-c57a75e62020",
                                        "entry_id": "ae8baea6-5f62-3be0-8ced-cad4e4ecc33c",
                                        "glosses": [
                                            "Of good morals; practicing ethical values."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "688e07ed-c81a-41c3-8198-63ed9a0d41ca",
                                                "sense_id": "bc487124-fbeb-30a5-9bd4-c57a75e62020",
                                                "text": "There was a man in the land of Uz, whose name was Job; and that man was perfect and upright, and one that feared God, and eschewed evil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "566996d9-bb8a-38f1-b68b-c119e0d60a71",
                                        "entry_id": "ae8baea6-5f62-3be0-8ced-cad4e4ecc33c",
                                        "glosses": [
                                            "Having the head approximately at a right angle with the shaft."
                                        ],
                                        "tags": [
                                            "of a golf club"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "upright",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98a4fe15-be79-3481-9c10-f103908da99d",
                                        "entry_id": "861d3be5-7608-32df-b38a-9c16fdab4cd4",
                                        "glosses": [
                                            "In or into an upright position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30840297-b378-4c03-9732-8bc95e9ebaea",
                                                "sense_id": "98a4fe15-be79-3481-9c10-f103908da99d",
                                                "text": "I was standing upright, waiting for my orders."
                                            },
                                            {
                                                "example_id": "28f275a3-a4de-42e8-b1f4-11bd390488f7",
                                                "sense_id": "98a4fe15-be79-3481-9c10-f103908da99d",
                                                "text": "Human locomotion had been presumed unique because we walk upright with two legs. When investigators led by Nadia Dominici analyzed the electrical activities produced by walking toddlers, preschoolers, and adults as well as newborns that were held upright and prodded to walk along a surface, however, they saw that we essentially follow the same chain of motor commands as several other animals, including rats, cats, monkeys, and guinea fowl."
                                            },
                                            {
                                                "example_id": "d970c015-701f-4b67-b071-a2c5212ce4c1",
                                                "sense_id": "98a4fe15-be79-3481-9c10-f103908da99d",
                                                "text": "Those up for the ride stand upright on a small platform which shoots a powerful jet of water downwards, sending the attached board – which has in the past carried the likes of Leonardo DiCaprio – up into the air."
                                            },
                                            {
                                                "example_id": "36f465c3-6553-49c0-8163-ed2938fd5eef",
                                                "sense_id": "98a4fe15-be79-3481-9c10-f103908da99d",
                                                "text": "For instance, parents were strongly encouraged to delay the introduction of complementary foods to six months when infants were able to sit upright and feed themselves safely."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "upright",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0be9974e-0a28-3a2e-ad7a-3baa9dc805d0",
                                        "entry_id": "170a53bd-aec4-3037-8ef7-d4c1c1af1f70",
                                        "glosses": [
                                            "Any vertical part of a structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "513779be-2a3e-4725-ab4c-3dde5e1ccf00",
                                                "sense_id": "0be9974e-0a28-3a2e-ad7a-3baa9dc805d0",
                                                "text": "On the change in architectural forms from the pyramidal to the obeliscar, the fires were transferred from the altars, or cubes, to the summits of the typical uprights, or towers; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faadfee0-ceab-33aa-be68-96aa58684b64",
                                        "entry_id": "170a53bd-aec4-3037-8ef7-d4c1c1af1f70",
                                        "glosses": [
                                            "Any vertical part of a structure.",
                                            "A goal post."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d83f15d-109c-4bf7-a0fd-bc09fc578379",
                                                "sense_id": "faadfee0-ceab-33aa-be68-96aa58684b64",
                                                "text": "Chelsea improved, with Salomon Kalou denied by goalkeeper Wayne Hennessey and Didier Drogba hitting the upright."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22f7ff05-269f-367e-a4cc-e032013ddcbc",
                                        "entry_id": "170a53bd-aec4-3037-8ef7-d4c1c1af1f70",
                                        "glosses": [
                                            "Any vertical part of a structure.",
                                            "A leg."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c394ca37-2cb5-3d6d-bb89-92fe0d67fb70",
                                        "entry_id": "170a53bd-aec4-3037-8ef7-d4c1c1af1f70",
                                        "glosses": [
                                            "A word clued by the successive initial, middle, or final letters of the cross-lights in a double acrostic or triple acrostic."
                                        ],
                                        "tags": [],
