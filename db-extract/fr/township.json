                                        "sense_id": "501a4f1f-087f-3260-8a3d-c2ebaba25a39",
                                        "entry_id": "fa2cedfb-1aec-3544-b074-bf495525acfe",
                                        "glosses": [
                                            "städtische Siedlung im südlichen Afrika, welche vorwiegend von ärmeren, nichtweißen Bevölkerungsgruppen bewohnt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75da2964-10be-46e8-ad1c-c1719283c2c1",
                                                "sense_id": "501a4f1f-087f-3260-8a3d-c2ebaba25a39",
                                                "text": "„Nach der Spaltung eskalierte die Gewalt in den Townships von Salisbury, aber auch in anderen Städten in einem für die gesamte Region des südlichen Afrika außergewöhnlichen Ausmaß.“"
                                            },
                                            {
                                                "example_id": "b0490ed3-e2a3-4f8b-871b-4721c125b548",
                                                "sense_id": "501a4f1f-087f-3260-8a3d-c2ebaba25a39",
                                                "text": "„Als er das Elternschlafzimmer erreichte, hatte er beeindruckt über die Größe des Raumes gepfiffen. Denn er kannte bloß ein winziges Vier-Zimmer-Haus in den Townships der Cape Flats.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
