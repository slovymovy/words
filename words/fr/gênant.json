                                "target_lang_sense_clarification": "给人带来不便或困扰"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea52cc56-d401-37ce-86a6-4a1d5722e126",
                    "sense_definition": "Participe présent de <w>gêner</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>gênant</w> le passage des piétons, ces travaux ont provoqué de vives protestations dans le quartier.",
                            "target_lang_translations": {
                                "en": "By <w>obstructing</w> the pedestrian walkway, these roadworks sparked strong protests in the neighbourhood.",
                                "ru": "Эти дорожные работы, <w>препятствуя</w> проходу пешеходов, вызвали бурные протесты в районе.",
                                "de": "Indem diese Bauarbeiten den Fußgängerverkehr <w>behinderten</w>, lösten sie heftige Proteste im Viertel aus.",
                                "es": "Al <w>estorbar</w> el paso de los peatones, estas obras provocaron fuertes protestas en el barrio.",
                                "zh": "这些施工<w>妨碍</w>了行人通行，在这一带引起了强烈抗议。"
                            }
                        },
                        {
                            "text": "Elle a quitté la salle sans bruit, ne <w>gênant</w> personne pendant la conférence.",
                            "target_lang_translations": {
                                "en": "She left the room quietly, not <w>bothering</w> anyone during the conference.",
                                "ru": "Она тихо вышла из зала, никому не <w>мешая</w> во время конференции.",
                                "de": "Sie verließ den Saal leise und <w>störte</w> während der Konferenz niemanden.",
                                "es": "Salió de la sala sin hacer ruido, sin <w>molestar</w> a nadie durante la conferencia.",
                                "zh": "她悄悄离开了会议室，会议期间没有<w>打扰</w>任何人。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Present participle of gêner, meaning to hinder, obstruct or bother.",
                        "ru": "Причастие настоящего времени глагола «gêner».",
                        "de": "Partizip Präsens des französischen Verbs „gêner“ im Sinne von behindern oder stören.",
                        "es": "Forma de participio presente del verbo gêner, que significa estorbar o molestar.",
                        "zh": "动词gêner的现在分词。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hinder",
                                "target_lang_sense_clarification": "getting in the way, slowing progress"
                            },
                            {
                                "target_lang_word": "obstruct",
                                "target_lang_sense_clarification": "blocking a road or passage"
                            },
                            {
                                "target_lang_word": "bother",
                                "target_lang_sense_clarification": "inconveniencing or annoying someone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мешать",
                                "target_lang_sense_clarification": "создавать помехи, препятствия"
                            },
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "блокировать дорогу, проход"
                            },
                            {
                                "target_lang_word": "беспокоить",
                                "target_lang_sense_clarification": "отвлекать, досаждать кому-либо"
                            }
                        ],
                        "de": [
