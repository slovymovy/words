                "senses": [
                    {
                        "sense_id": "e6d0b6c5-dc82-3ddf-a560-538655527d64",
                        "entry_id": "33e15af8-2100-32b9-8ad1-2a381dec9720",
                        "glosses": [
                            "Celui qui prend part à un tournoi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94a38a87-ec72-4cfd-bc86-92e357181220",
                                "sense_id": "e6d0b6c5-dc82-3ddf-a560-538655527d64",
                                "text": "Tornoieur, vos, que atendeiz, Qui la terre ne deffendeiz, Qui est à vostre creatour ?"
                            },
                            {
                                "example_id": "ec6f7050-9f47-462f-8116-947e2594a8e2",
                                "sense_id": "e6d0b6c5-dc82-3ddf-a560-538655527d64",
                                "text": "Ains est si très bons chevaliers, Si membrez et si porveans, Si tornoierres, si jostans."
                            },
                            {
                                "example_id": "03909ae1-c37f-4fc2-90d5-fb543361957b",
                                "sense_id": "e6d0b6c5-dc82-3ddf-a560-538655527d64",
                                "text": "Il a en France un tel proverbe : De bon tourneeur couart guerrier."
                            },
                            {
                                "example_id": "086a9fbb-d0e8-4706-9972-386e6dd6023c",
                                "sense_id": "e6d0b6c5-dc82-3ddf-a560-538655527d64",
                                "text": "Si quelque chevalier avait mal parlé des dames, les autres tournoyeurs le battaient de leurs épées."
                            }
                        ]
                    }
                ],
