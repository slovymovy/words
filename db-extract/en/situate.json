                "senses": [
                    {
                        "sense_id": "22191ea3-6b59-3143-99e0-c555cc12bba6",
                        "entry_id": "117a6d0b-1650-36ab-925d-f755a9468997",
                        "glosses": [
                            "To place on or into a physical location."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c82625d7-3756-4ec1-917a-d643f4552f95",
                                "sense_id": "22191ea3-6b59-3143-99e0-c555cc12bba6",
                                "text": "The statue is situated in a corner hardly visible to the public, except through a window from an outside maintenance area situated behind the building."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5aa643b-57d1-39b5-bebc-208fd238b5da",
                        "entry_id": "117a6d0b-1650-36ab-925d-f755a9468997",
                        "glosses": [
                            "To place or put into an intangible place or position, such as social, ethical, fictional, etc."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e9f64e65-fed1-41f7-8913-72675691c868",
                                "sense_id": "f5aa643b-57d1-39b5-bebc-208fd238b5da",
                                "text": "The mayor is situated between probable censure and possible recall."
                            },
                            {
                                "example_id": "c73836c3-bc22-48b4-9725-912b6d7a932d",
                                "sense_id": "f5aa643b-57d1-39b5-bebc-208fd238b5da",
                                "text": "Other critiques have not focussed on the lexicography but rather have situated Hobson-Jobson within a larger postcolonialist critique of the British imperial project."
                            },
                            {
                                "example_id": "4bd1f5ba-15ba-44b5-bedf-d82896e1656c",
                                "sense_id": "f5aa643b-57d1-39b5-bebc-208fd238b5da",
                                "text": "In the following sections, I situate my work more explicitly within several contemporary contexts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72e02fd2-89bb-42aa-bec8-636ea2be38ef",
                        "source_entry_id": "117a6d0b-1650-36ab-925d-f755a9468997",
                        "source_sense_description": "place on or into a physical location — see also locate, place, put",
                        "target_lang_word": "situer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "situer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6e914ca-49c2-314b-9450-bfb2b2fd3409",
                                        "entry_id": "88e7cc90-11da-3e9a-bd1e-c02f37f78f1e",
                                        "glosses": [
                                            "Placer, poser en certain endroit par rapport à l’exposition, à l’aspect, au voisinage, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f0f43ad-cb55-4525-85bb-2ec83d33dfee",
                                                "sense_id": "e6e914ca-49c2-314b-9450-bfb2b2fd3409",
                                                "text": "Le duc de Guise reconduisit sa belle-sœur, la duchesse de Nevers, en son hôtel qui était situé rue du Chaume, en face de la rue de Brac, […]."
                                            },
                                            {
                                                "example_id": "b36c7205-1d6f-407a-9590-55a5825624b2",
                                                "sense_id": "e6e914ca-49c2-314b-9450-bfb2b2fd3409",
                                                "text": "Avant l'arrivée des Magyars, les Slaves méridionaux occupaient toute la plaine danubienne et le noyau de leur puissance était situé entre le Rab, le Danube et la Drave."
                                            },
                                            {
                                                "example_id": "d5f2b88d-8b89-4f17-ac56-936ba8627894",
                                                "sense_id": "e6e914ca-49c2-314b-9450-bfb2b2fd3409",
                                                "text": "Cette histoire se situe au milieu du siècle des lumières."
                                            },
                                            {
                                                "example_id": "dff778d7-7558-4c65-ad5c-5feed934ddbf",
                                                "sense_id": "e6e914ca-49c2-314b-9450-bfb2b2fd3409",
                                                "text": "La ville de Toulouse se situe en France."
                                            },
                                            {
                                                "example_id": "3f506559-5c44-4808-856c-fe56161b54d1",
                                                "sense_id": "e6e914ca-49c2-314b-9450-bfb2b2fd3409",
                                                "text": "Je situe cette ville dans ce pays."
                                            },
                                            {
                                                "example_id": "103bbc62-315f-4250-8e6c-41e5a469f310",
                                                "sense_id": "e6e914ca-49c2-314b-9450-bfb2b2fd3409",
                                                "text": "On a mal situé ce château, il fallait le situer sur le bord de la rivière."
                                            },
                                            {
                                                "example_id": "9ff6098a-202f-4bca-afc8-7eab47020894",
                                                "sense_id": "e6e914ca-49c2-314b-9450-bfb2b2fd3409",
                                                "text": "Cette maison est située à mi-côte, est située dans un vallon."
                                            },
                                            {
                                                "example_id": "d992b6a3-2295-4e96-8542-c139641c5044",
                                                "sense_id": "e6e914ca-49c2-314b-9450-bfb2b2fd3409",
                                                "text": "Cette ville est avantageusement située pour le commerce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "931ce586-1c06-359b-84fa-d5682e1d623c",
                                        "entry_id": "88e7cc90-11da-3e9a-bd1e-c02f37f78f1e",
                                        "glosses": [
                                            "Assigner une place en imagination, dans son esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33dd08b1-678e-4037-a45a-87912148c4f7",
                                                "sense_id": "931ce586-1c06-359b-84fa-d5682e1d623c",
                                                "text": "Quelque caillou qu'on lui présentât, il en situait toujours et sans erreur l'emplacement exact : […]."
                                            },
                                            {
                                                "example_id": "89bb14b3-7d67-44d2-b573-adaa463396d7",
                                                "sense_id": "931ce586-1c06-359b-84fa-d5682e1d623c",
                                                "text": "Situer un personnage."
                                            },
                                            {
                                                "example_id": "18254ff5-3d1a-4d6b-ab6d-7510f2c0af7b",
                                                "sense_id": "931ce586-1c06-359b-84fa-d5682e1d623c",
                                                "text": "Je ne situe pas bien sa maison, sa propriété."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2e82db5-9664-39f7-918a-e617fc2b7ab4",
                                        "entry_id": "88e7cc90-11da-3e9a-bd1e-c02f37f78f1e",
                                        "glosses": [
                                            "Avoir sa place, dans l'espace ou dans le temps."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6d397ab-a538-4252-9b3c-d3764c750cc7",
                                                "sense_id": "a2e82db5-9664-39f7-918a-e617fc2b7ab4",
                                                "text": "La commune de La Chapelle-Heulin se situe au cœur du vignoble nantais, au sud-est du département de la Loire-Atlantique."
                                            },
                                            {
                                                "example_id": "d44b4ecd-f31c-4274-86ed-0423d72202dc",
                                                "sense_id": "a2e82db5-9664-39f7-918a-e617fc2b7ab4",
                                                "text": "Pays qui se situe au douzième rang de la production de pétrole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
