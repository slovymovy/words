                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05a1b96b-1e19-3917-bc2f-bc33eac1e49e",
                                        "entry_id": "c59b94f2-1b05-3d98-9c2b-12ec893815ac",
                                        "glosses": [
                                            "To discard, to throw away."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8c230a3-83a0-4753-8ea4-54ac444bd5e7",
                                                "sense_id": "05a1b96b-1e19-3917-bc2f-bc33eac1e49e",
                                                "text": "This food's gone off - you'd better chuck it."
                                            },
                                            {
                                                "example_id": "dbb803ff-dfc2-403b-b36e-c9d6120140e1",
                                                "sense_id": "05a1b96b-1e19-3917-bc2f-bc33eac1e49e",
                                                "text": "When Dangerfield put the little roll in his hand, Irons looked suspicious and frightened, and balanced it in his palm, as if he had thoughts of chucking it from him, as though it were literally a satanic douceur. But it is hard to part with money, and Irons, though he still looked cowed and unhappy, put the money into his breeches' pocket, and he made a queer bow […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd6aca86-5eb3-3300-aaa5-30d5b1f72da9",
                                        "entry_id": "c59b94f2-1b05-3d98-9c2b-12ec893815ac",
                                        "glosses": [
                                            "To jilt; to dump."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45bd4222-f02f-4dbf-89e4-620708d64d06",
                                                "sense_id": "dd6aca86-5eb3-3300-aaa5-30d5b1f72da9",
                                                "text": "She's chucked me for another man!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3030293b-cf3d-354d-b1f5-2aa90f73a2f3",
                                        "entry_id": "c59b94f2-1b05-3d98-9c2b-12ec893815ac",
                                        "glosses": [
                                            "To give up; to stop doing; to quit."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c30b65bd-6641-484d-aad2-8102598b1ef5",
                                                "sense_id": "3030293b-cf3d-354d-b1f5-2aa90f73a2f3",
                                                "text": "\"When he got religion old Joe stuck every penny away in the Savings Bank, and when he chucked religion he'd draw out the lot and go on a bender that landed him in the horrors, like as not.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd51e27b-e4a9-3638-970e-2594b33607a4",
                                        "entry_id": "c59b94f2-1b05-3d98-9c2b-12ec893815ac",
