                                        "entry_id": "5ae19b12-5dfb-316d-b62d-7f66c71716d2",
                                        "glosses": [
                                            "Capacité à se connecter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46e67fd0-b8ab-4153-a0ca-131e8bef21d9",
                                                "sense_id": "0e46745a-dc4a-3fe5-92fb-db45151c8545",
                                                "text": "À cette limitation s'ajoutent le non support de Flash et une connectivité limitée (pas de port USB ni SD)."
                                            },
                                            {
                                                "example_id": "436c20ae-cdb2-4520-af20-2a683debf832",
                                                "sense_id": "0e46745a-dc4a-3fe5-92fb-db45151c8545",
                                                "text": "Ottawa a annoncé, lundi, une entente de 600 millions $ avec l’opérateur de satellites Télésat pour assurer plus de connectivité dans le Grand Nord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20fffa2c-604a-418f-9e80-5132f9428609",
                        "source_entry_id": "787ea26d-e78a-373a-94df-af9583fa11a8",
                        "source_sense_description": "state of being connected",
                        "target_lang_word": "Konnektivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konnektivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2ae2085-5506-37c3-8edd-2b1b5aa54089",
                                        "entry_id": "39d1525b-acf0-3c5d-bc72-133f5f5183d4",
                                        "glosses": [
                                            "Eigenschaft als Programm/System, Verbindungen zu anderen Systemen herstellen (konnektieren) zu können"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2ded53d-d9f3-41d6-b090-12343813b07b",
                                                "sense_id": "b2ae2085-5506-37c3-8edd-2b1b5aa54089",
                                                "text": "„Allerdings ist eine Besonderheit des Cloud Computing die zur Nutzung der betreffenden Dienste erforderliche Konnektivität: ohne Konnektivität keine Cloud. Konnektivität wiederum erfordert einen Telekommunikationsdienst.“"
                                            },
                                            {
                                                "example_id": "2d7deefa-de56-4287-af8f-6d7abdfbff0a",
                                                "sense_id": "b2ae2085-5506-37c3-8edd-2b1b5aa54089",
                                                "text": "„Wir entdeckten, dass die Netzwerke – die Welt der Konnektivität – fantastisch geeignet sind für unser mit Arbeit und Terminen vollgestopftes, durch die Netzwerke erst möglich gewordenes Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
