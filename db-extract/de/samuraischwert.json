                                        "sense_id": "b7653201-108b-35b0-a1ff-48395d38a0cf",
                                        "entry_id": "64306e01-c08b-3d08-82ba-c0564d93ef5c",
                                        "glosses": [
                                            "zwaard van een Japanse edelman"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dabe343-0037-4e5f-bb38-92fe97f91eda",
                                                "sense_id": "b7653201-108b-35b0-a1ff-48395d38a0cf",
                                                "text": "Ze was toen elf of twaalf jaar oud geweest, nu was ze ongeveer zeventien en het leven dat ze in Zweden had geleid, had ervoor gezorgd dat ze zich alleen veilig voelde met het samoeraizwaard in haar handen."
                                            },
                                            {
                                                "example_id": "b9bc38ae-49af-486a-ae3e-4a459c372e7d",
                                                "sense_id": "b7653201-108b-35b0-a1ff-48395d38a0cf",
                                                "text": "Een Japanse acteur is in een ziekenhuis in Tokio overleden nadat hij bij een repetitie een samoeraizwaard in zijn buik had gekregen. De politie onderzoekt of het een ongeluk is of dat er opzet in het spel is."
                                            }
