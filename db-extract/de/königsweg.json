                "senses": [
                    {
                        "sense_id": "b086385e-8103-38bb-8269-003361703676",
                        "entry_id": "e86f89a6-e5ce-3ff2-8099-eb1132fc536d",
                        "glosses": [
                            "besonders guter Zugang, ein erstrebtes Ziel zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbbcc8d9-503e-408a-aec6-04d08b40a76b",
                                "sense_id": "b086385e-8103-38bb-8269-003361703676",
                                "text": "„Mit dem Traum war es Freud gelungen, den Königsweg zum Unbewussten zu finden, aber beim Witz ist er weniger erfolgreich gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
