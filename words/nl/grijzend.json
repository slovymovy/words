                    "sense_id": "a7b62ec4-12c1-3855-8e12-8a9705e9cb2e",
                    "sense_definition": "grijs wordend van haarkleur, meestal door ouderdom",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>grijzende</w> man keek tevreden terug op zijn lange en succesvolle loopbaan.",
                            "target_lang_translations": {
                                "de": "Der <w>ergrauende</w> Mann blickte zufrieden auf seine lange und erfolgreiche Karriere zurück."
                            }
                        },
                        {
                            "text": "Zij begon zich zorgen te maken toen ze haar eerste <w>grijzende</w> lokken zag.",
                            "target_lang_translations": {
                                "de": "Sie begann sich Sorgen zu machen, als sie ihre ersten <w>ergrauenden</w> Strähnen sah."
                            }
                        }
                    ],
                    "synonyms": [
                        "vergrijzend"
                    ],
                    "common_phrases": [
                        "grijzende slapen",
                        "grijzende haren"
                    ],
