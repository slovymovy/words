                ],
                "senses": [
                    {
                        "sense_id": "3ea288d9-b601-3c60-8913-47903092bfdb",
                        "entry_id": "4a72fdf5-c1d2-36d6-8ef0-7f228e7831e6",
                        "glosses": [
                            "elk van beide spiegelbeeldige haakvormige leestekens waarmee een bepaald deel van een tekst kan worden gemarkeerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0678a077-98b6-494f-b427-ce7da162dd09",
                                "sense_id": "3ea288d9-b601-3c60-8913-47903092bfdb",
                                "text": "De heading van een klasse begint met het sleutelwoord 'class' en geeft de naam van de klasse aan, gevolgd door een accolade."
                            },
                            {
                                "example_id": "733b5d84-32ce-4695-9016-446fe2189ae8",
                                "sense_id": "3ea288d9-b601-3c60-8913-47903092bfdb",
                                "text": "We kennen de vierkante haakjes [ ] en de rondere accolades { }. Bij het lezen en maken van broncode van een programma hebben beiden meestal een heel andere betekenis."
                            },
                            {
                                "example_id": "c3d6d299-8007-468a-9973-49814c011174",
                                "sense_id": "3ea288d9-b601-3c60-8913-47903092bfdb",
                                "text": "‘De teloorgang van Neêrlands onderwijs houd ik niet meer tegen.” Mijn collega zet een accolade om de scores van de examinator en noteert: idem. titel=Voilà"
                            }
                        ]
                    },
                    {
                        "sense_id": "7168606b-79ec-3679-9aa9-995973d840e5",
                        "entry_id": "4a72fdf5-c1d2-36d6-8ef0-7f228e7831e6",
                        "glosses": [
                            "symbolische zwaardslag waarmee tot de ridderorde of adel werd toegelaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21ba6bdb-a9ce-4933-a306-f256f438b5a9",
                                "sense_id": "7168606b-79ec-3679-9aa9-995973d840e5",
                                "text": "Met deze woorden stapt Du Frêne op zijn vriend toe, hangt hem de bruine mantel om van de schildknaap en geeft hem de accolade en de broederkus."
                            },
                            {
                                "example_id": "1b3172be-3d7c-4c6a-a20e-52af39aae6b5",
                                "sense_id": "7168606b-79ec-3679-9aa9-995973d840e5",
                                "text": "De accolade bij de toekenning van de Willemsorde is vervangen door een ferme slag met de hand van de koning op de schouder van de gedecoreerde."
                            }
                        ]
                    },
                    {
                        "sense_id": "49e8bc64-5bbc-3d22-9b47-73e2696db4de",
                        "entry_id": "4a72fdf5-c1d2-36d6-8ef0-7f228e7831e6",
                        "glosses": [
                            "blijk van grote waardering"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "985bb0bd-49f9-46a6-be2e-368811b77e97",
                                "sense_id": "49e8bc64-5bbc-3d22-9b47-73e2696db4de",
                                "text": "Na zestien jaar zal er geen accolade meer zijn voor het beste literaire en/of journalistieke reisboek dat jaarlijks in het Nederlandse taalgebied is verschenen. Het afschaffen van de Bob den Uyl-prijs is een betreurenswaardige zaak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6087e81-8d6c-4975-9c9b-1e5f7ff7c950",
                        "source_entry_id": "4a72fdf5-c1d2-36d6-8ef0-7f228e7831e6",
                        "target_lang_word": "accolade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accolade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ac3fc0f-2962-379c-b2c6-d693922a0b0d",
                                        "entry_id": "e0fe7c18-74e3-38d5-8390-6e315481d00d",
                                        "glosses": [
                                            "Action d’embrasser en mettant les bras autour du cou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbe95c31-d04d-458e-86cd-d8202e201caa",
                                                "sense_id": "9ac3fc0f-2962-379c-b2c6-d693922a0b0d",
                                                "text": "Donner l’accolade à un officier après l’avoir fait reconnaître."
                                            },
                                            {
                                                "example_id": "1aa7d7a8-76c3-4237-8765-ea7b6fd80c17",
                                                "sense_id": "9ac3fc0f-2962-379c-b2c6-d693922a0b0d",
                                                "text": "Une accolade fraternelle."
                                            },
                                            {
                                                "example_id": "1984913d-5b3d-4c6b-b6ad-5696e5445ab0",
                                                "sense_id": "9ac3fc0f-2962-379c-b2c6-d693922a0b0d",
                                                "text": "Comme pour beaucoup de maladies, notamment les virus saisonniers, la Covid-19 peut se transmettre lors d’un contact direct avec une personne infectée, à savoir : une poignée de main, une bise ou encore une accolade."
                                            },
                                            {
                                                "example_id": "95541ab3-a9bb-4e8e-9934-1bbd6651bf6e",
                                                "sense_id": "9ac3fc0f-2962-379c-b2c6-d693922a0b0d",
                                                "text": "Nous nous sommes jetés dans les bras l’un de l’autre et nous nous tenons enlacés.\nNous sommes enlacés.\nJe n’ose pas lâcher le premier, de peur de paraître trop peu ému, et j’attends qu’il commence. Nous sommes comme deux lutteurs qui se tâtent — lutte de sensibilité dans laquelle Matoussaint l’emporte sur Vingtras. Matoussaint connaît mieux que moi les traditions et sait combien de temps doivent durer les accolades ; quand il faut se relever, quand il faut se reprendre. Il y a longtemps que je crois avoir été assez ému, et Matoussaint me tient encore très serré.\nÀ la fin, il me rend ma liberté : nous nous repeignons, et il me demande en deux mots mon histoire."
                                            },
                                            {
                                                "example_id": "2a7d3a76-fa0d-4277-bc25-026f8f21f83f",
                                                "sense_id": "9ac3fc0f-2962-379c-b2c6-d693922a0b0d",
                                                "text": "Il paraît, bien que nous ne l'ayons jamais vu faire, que l'accolade est remplacée [en Chine], comme marque de respect, par un reniflement sur la main de la personne que l'on veut honorer."
                                            },
                                            {
                                                "example_id": "a35a5ca8-9bb0-4041-8248-3a951cb126a0",
                                                "sense_id": "9ac3fc0f-2962-379c-b2c6-d693922a0b0d",
                                                "text": "Aussitôt Arlette a senti que Telcide est son ennemie. Pas un mot de bienvenue ! pas une phrase gentille ! Rien qu’un baiser, plus froid que la plus banale des accolades."
                                            },
                                            {
                                                "example_id": "0efb3b60-c4f7-46e0-8645-5e229ef584bf",
                                                "sense_id": "9ac3fc0f-2962-379c-b2c6-d693922a0b0d",
                                                "text": "Crosby lui donna l’accolade exactement comme le font des généraux qui remettent une décoration à un officier."
                                            },
                                            {
                                                "example_id": "93ecc071-df64-4f42-ba04-612ea1427cc8",
                                                "sense_id": "9ac3fc0f-2962-379c-b2c6-d693922a0b0d",
                                                "text": "De G8 en G20, il a multiplié accolades, embrassades, bourrades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c5e1efc-52b5-31dd-878c-5bbdffea4611",
                                        "entry_id": "e0fe7c18-74e3-38d5-8390-6e315481d00d",
                                        "glosses": [
                                            "Cérémonies observées dans la réception d’un chevalier, et qui consistait ordinairement à donner trois coups du plat de l’épée sur l’épaule ou sur le cou de celui qu’on armait chevalier, après quoi on l’embrassait."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9325d895-9cb9-4dd6-8857-e82d14321f79",
                                                "sense_id": "7c5e1efc-52b5-31dd-878c-5bbdffea4611",
                                                "text": "Donner, recevoir l’accolade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2397ba5-0423-34bd-b738-a16eed3590b9",
                                        "entry_id": "e0fe7c18-74e3-38d5-8390-6e315481d00d",
                                        "glosses": [
                                            "Symbole typographique { ou }, qui servent à rassembler plusieurs objets, soit pour en former un tout, soit pour montrer ce qu’ils ont de commun ou d’analogue entre eux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b8c3a07-a144-453c-b843-6ec7fd30ee9b",
                                                "sense_id": "e2397ba5-0423-34bd-b738-a16eed3590b9",
                                                "text": "L’accolade s’emploie souvent dans les comptes, dans la formation des tableaux, etc., et se place, suivant le besoin, horizontalement ou verticalement."
                                            },
                                            {
                                                "example_id": "6283f9c1-aa43-4c50-ba98-7096e049ea34",
                                                "sense_id": "e2397ba5-0423-34bd-b738-a16eed3590b9",
                                                "text": "Réunir plusieurs articles, plusieurs colonnes par une accolade."
                                            },
                                            {
                                                "example_id": "7d19d659-d0ee-4edc-a0df-d6d558ae4d48",
                                                "sense_id": "e2397ba5-0423-34bd-b738-a16eed3590b9",
                                                "text": "On joint par une accolade les portées de toutes les différentes parties d’une pièce de musique."
                                            },
                                            {
                                                "example_id": "3bcc0eba-56a3-4647-8712-bc623a8c0867",
                                                "sense_id": "e2397ba5-0423-34bd-b738-a16eed3590b9",
                                                "text": "Une accolade ouvrante."
                                            },
                                            {
                                                "example_id": "6f65ef78-2b18-4c52-a7b4-6d3078e6a7c6",
                                                "sense_id": "e2397ba5-0423-34bd-b738-a16eed3590b9",
                                                "text": "Il y a dans ma chambre, pendu au mur gelé, un « Règlement » où toutes les accolades ont la forme de ta lèvre supérieure : c’est le seul objet d’art qui pare la nudité de la pièce…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3c4a414-d35f-363a-b588-65f039672d2d",
                                        "entry_id": "e0fe7c18-74e3-38d5-8390-6e315481d00d",
                                        "glosses": [
                                            "Élément architectural ornemental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ead58b0c-b996-4546-96d6-92c4ea2926dd",
                                                "sense_id": "b3c4a414-d35f-363a-b588-65f039672d2d",
                                                "text": "Les accolades sont, à leur origine, à peine apparentes ; plus tard, elles se dégagent, sont plus accentuées […]"
                                            }
                                        ]
                                    }
                                ]
                            },
