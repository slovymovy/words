                        "entry_id": "4cbad20b-3bd2-398b-9ecf-e470e35c8238",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "manillaatjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5cca2287-f06f-3ad3-a058-9132be160e34",
                        "entry_id": "4cbad20b-3bd2-398b-9ecf-e470e35c8238",
                        "glosses": [
                            "geurig soort tabak die op de Filipijnen wordt verbouwd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e486b8e2-d6f6-4b19-bfce-85447c03095e",
                                "sense_id": "5cca2287-f06f-3ad3-a058-9132be160e34",
                                "text": "Men rookt portorico, cuba, havanna, manilla, braziel: een minder fijne tabaksoort is amersfoort (amersfoorder), uit Klaasje Zevenster bekend."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e6b01b8-2677-3b0d-b66d-5c8d5b81813f",
                        "entry_id": "4cbad20b-3bd2-398b-9ecf-e470e35c8238",
                        "glosses": [
                            "sigaar gemaakt uit een geurig soort tabak die op de Filipijnen wordt verbouwd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db8c5d34-04d9-4e70-b374-ec91b77edc91",
                                "sense_id": "9e6b01b8-2677-3b0d-b66d-5c8d5b81813f",
                                "text": "Maar zegt u eens, wilt u roken? Een lichte manilla?"
                            },
                            {
                                "example_id": "92db499b-cad0-4603-9fd4-0297df6264e0",
                                "sense_id": "9e6b01b8-2677-3b0d-b66d-5c8d5b81813f",
                                "text": "'t Rimpelend water spiegelt haar week:\nMet haar voetjes in de ondiepe beek\nVoeren de golfjes guerilla.\n Op een steen zit haar echtgenoot,\nZiet haar spelen, ergert zich dood\nEn zuigt op zijn manilla."
                            },
                            {
                                "example_id": "38cb396c-5e83-428a-8157-9de2b139fa09",
                                "sense_id": "9e6b01b8-2677-3b0d-b66d-5c8d5b81813f",
                                "text": "In gewone omstandigheden overrompel ik dat bediendenvolkje met een sigaar. (…) Krikkel en kort aangebonden, verzuimde ik ditmaal mijn gebruikelijke politiek van de manilla: de muts stond mij te verkeerd!"
                            }
                        ]
                    }
                ],
