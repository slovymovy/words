                "senses": [
                    {
                        "sense_id": "5e5f0fff-fdcf-3d14-89d3-e0616f11907a",
                        "entry_id": "f9d8a28a-2e53-3f7e-9fec-9479aa0a94a1",
                        "glosses": [
                            "bovenste laag van een bodem waar veel plantenresten in zitten die de grond vruchtbaar maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bced6de6-f72a-4b59-ba96-d9ff160fcb07",
                                "sense_id": "5e5f0fff-fdcf-3d14-89d3-e0616f11907a",
                                "text": "De brandweer is tot gisteravond bezig geweest met nablussen in natuurgebied de Chaamse Bossen. Daar ontstond zondag een brand die gisteren weer oplaaide door een nasmeulende humuslaag."
                            }
                        ]
                    },
                    {
                        "sense_id": "1979534e-e7bf-319c-8de5-0741456204a3",
                        "entry_id": "f9d8a28a-2e53-3f7e-9fec-9479aa0a94a1",
                        "glosses": [
                            "het gezonde fundament waarop mensen en zaken kunnen gedijen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2468741e-58d2-47dd-966b-52fe6a7ff526",
                                "sense_id": "1979534e-e7bf-319c-8de5-0741456204a3",
                                "text": "Binnen het onderwijs hebben we een uitgelezen kans om deze vorm van het dikke ik en het horizontale en maakbare denken te ontmaskeren. Goed om te spreken en actie te ondernemen op thema’s rondom economie, energie en ecologie. Bovengenoemde dimensie van duurzaamheid geeft daarbij de fundamentele humuslaag voor een nieuwe generatie."
                            },
                            {
                                "example_id": "965c0b92-c305-4df3-9135-670674430a3a",
                                "sense_id": "1979534e-e7bf-319c-8de5-0741456204a3",
                                "text": "\"Ze vormen de humuslaag van het Nederlandse orkestenlandschap, waarvan het KCO internationaal het boegbeeld is.\""
                            }
                        ]
                    }
