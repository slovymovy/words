                "senses": [
                    {
                        "sense_id": "6d2bf111-8ab2-3416-ba2c-7a38acaaabc8",
                        "entry_id": "89a1b20a-48b5-37b1-af0b-feba9da111f1",
                        "glosses": [
                            "een schema waarmee een overheid een aantal als essentieel beoordeelde vaccinaties aanbeveelt of verplicht stelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "992e9238-53f9-4aee-b073-42f45a03e191",
                                "sense_id": "6d2bf111-8ab2-3416-ba2c-7a38acaaabc8",
                                "text": "Goed nieuws deze week: Pfizer ontwikkelde een vaccin tegen corona dat voor 90 procent effectief is. Maar veel vragen moeten de komende tijd nog beantwoord worden. Zoals: wie krijgt het vaccin eerst, welke groep krijgt welk vaccin en hoe organiseren we het vaccinatieprogramma?"
                            },
                            {
                                "example_id": "a41b30d5-3c98-4e08-be22-bb3dd362fe05",
                                "sense_id": "6d2bf111-8ab2-3416-ba2c-7a38acaaabc8",
                                "text": "Van der Weide leidde in 2009 het vaccinatieprogramma tegen de Mexicaanse griep. Het ministerie van Volksgezondheid loopt achter de feiten aan, zegt hij in een gesprek met platform voor onderzoeksjournalistiek Investico."
                            },
                            {
                                "example_id": "859d78f6-c43a-46c3-bcfc-f7f0703c9125",
                                "sense_id": "6d2bf111-8ab2-3416-ba2c-7a38acaaabc8",
                                "text": "De technologie die de ebolavaccins dagenlang gekoeld hield tot -80 graden op plekken waar geen elektriciteit is, zou volgens de Wereldgezondheidsorganisatie (WHO) ook gebruikt kunnen worden voor een vaccinatieprogramma tegen het coronavirus."
                            }
                        ]
                    }
