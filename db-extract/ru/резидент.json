                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a23bede-ee7c-3b1d-8a20-8d1b6285525f",
                                        "entry_id": "a41cefbe-4b74-3871-acd2-4edb6467950f",
                                        "glosses": [
                                            "A physician receiving specialized medical training."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
