                    {
                        "translation_id": "915d96e2-0dd4-465d-9ed0-21652b397c70",
                        "source_entry_id": "1d4298ae-a975-384e-9c48-39e8224c153f",
                        "source_sense_description": "self-confidence",
                        "target_lang_word": "Souveränität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Souveränität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "293769d9-541a-38d1-8a96-2a6b93900493",
                                        "entry_id": "42c8a7dd-a65d-3ef7-875e-d4773f942d3f",
                                        "glosses": [
                                            "selbstsichere Haltung einer Person gegenüber anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64b39e49-e3ca-4b76-89a0-6972897a038c",
                                                "sense_id": "293769d9-541a-38d1-8a96-2a6b93900493",
                                                "text": "„Das Beherrschen des Kletterns und des Fliegens, die Kontrolle über die Wand oder das Fluggerät, die Souveränität auch bei unvorhersehbaren Überraschungen, wird ständig messbar und erlebbar.“"
                                            },
                                            {
                                                "example_id": "3b3e664c-388f-460a-b603-1f903f029a8f",
                                                "sense_id": "293769d9-541a-38d1-8a96-2a6b93900493",
                                                "text": "Ihr Auftreten war von überzeugender Souveränität geprägt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b39af69c-04d3-31df-80ef-72fe59fd1d98",
                                        "entry_id": "42c8a7dd-a65d-3ef7-875e-d4773f942d3f",
                                        "glosses": [
                                            "von anderen Staaten unabhängige Selbstständigkeit eines Staates in seinem eigenen Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21455e84-97f5-4514-a517-b9c96a77ce57",
                                                "sense_id": "b39af69c-04d3-31df-80ef-72fe59fd1d98",
                                                "text": "Die Kolonien erhielten nach und nach fast alle ihre Souveränität."
                                            },
                                            {
                                                "example_id": "42a39b76-b7e9-4e3e-8ae2-eb48de3e9863",
                                                "sense_id": "b39af69c-04d3-31df-80ef-72fe59fd1d98",
                                                "text": "„Der hatte 1884 mit anderen politischen Anführern die Souveränität Kameruns dem Kaiserreich übertragen – es war die Geburtsstunde der deutschen Kolonie Kamerun gewesen.“"
                                            },
                                            {
                                                "example_id": "fc90d521-88cb-4287-b90a-f284df8ce74a",
                                                "sense_id": "b39af69c-04d3-31df-80ef-72fe59fd1d98",
                                                "text": "„EU-Kritiker behaupten gerne, dass diese Idee Utopie bleiben wird, da keine Nation willens sein werde, ihre Souveränität aufzugeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "54ae6a72-1a3a-38e0-8a80-e11d4a85eca3",
                                        "entry_id": "42c8a7dd-a65d-3ef7-875e-d4773f942d3f",
                                        "glosses": [
                                            "höchste, überlegene Verfügung über die Machtmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "041f6cdf-9a01-4373-bdfc-b6f1ec49cad1",
                                                "sense_id": "54ae6a72-1a3a-38e0-8a80-e11d4a85eca3",
                                                "text": "„Das Beherrschen des Kletterns und des Fliegens, die Kontrolle über die Wand oder das Fluggerät, die Souveränität auch bei unvorhersehbaren Überraschungen, wird ständig messbar und erlebbar.“"
                                            },
                                            {
                                                "example_id": "e6b3dd9d-0a2c-48ff-8319-d91679ceccc5",
                                                "sense_id": "54ae6a72-1a3a-38e0-8a80-e11d4a85eca3",
                                                "text": "Die Souveränität des Regimes ist noch ungebrochen."
                                            },
                                            {
                                                "example_id": "9579bc38-75f0-4fc7-ad05-44a81abbda12",
                                                "sense_id": "54ae6a72-1a3a-38e0-8a80-e11d4a85eca3",
                                                "text": "„Dass ein afrikanischer Herrscher seine Souveränität abgibt, ist schließlich im vorangegangenen Jahrzehnt der Normalfall gewesen.“"
                                            },
                                            {
                                                "example_id": "8b890f79-06b4-4a7f-b8ea-09bd1d170cef",
                                                "sense_id": "54ae6a72-1a3a-38e0-8a80-e11d4a85eca3",
                                                "text": "„Die auf Kommandostab und Helm aufgelegten Hände dienen als Symbol fürstlicher Souveränität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9da6cc7-8491-468c-88b5-694db7aa3107",
                        "source_entry_id": "1d4298ae-a975-384e-9c48-39e8224c153f",
                        "source_sense_description": "self-confidence",
                        "target_lang_word": "Aplomb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aplomb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4830d87b-8b35-3168-aa55-982b67a8654c",
                                        "entry_id": "035eb64c-c339-3464-9c79-15d2cc680a64",
                                        "glosses": [
                                            "eine gerade, sichere Haltung; ein selbstsicheres Auftreten, Nachdrücklichkeit in der Rede"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09ab579f-dedc-414e-b57a-80611b120194",
                                                "sense_id": "4830d87b-8b35-3168-aa55-982b67a8654c",
                                                "text": "„Und nun erwartete man, zum Auftakt der Darlegung des Falles durch die Verteidigung, Dr. Davies, der den Gerichtssaal mit charakteristischem Aplomb und einer tiefen Verbeugung vor Richter Harrigan beginnen würde.“"
                                            },
                                            {
                                                "example_id": "8882c2c1-9162-4c51-a1d1-37adcfe9935d",
                                                "sense_id": "4830d87b-8b35-3168-aa55-982b67a8654c",
                                                "text": "„Aber der Weltmeister ließ – ich hatte nach den Erzählungen meines Freundes derlei schon geahnt – gute zehn Minuten auf sich warten, wodurch allerdings sein Erscheinen dann erhöhten Aplomb erhielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d6722b10-2543-3900-ac34-661dcfaee66a",
                                        "entry_id": "035eb64c-c339-3464-9c79-15d2cc680a64",
                                        "glosses": [
                                            "Forschheit, Dreistigkeit"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b43afe0-7fc3-4f73-bac1-6da77f6e9aa3",
                                                "sense_id": "d6722b10-2543-3900-ac34-661dcfaee66a",
                                                "text": "„Aber der Weltmeister ließ – ich hatte nach den Erzählungen meines Freundes derlei schon geahnt – gute zehn Minuten auf sich warten, wodurch allerdings sein Erscheinen dann erhöhten Aplomb erhielt.“"
                                            },
                                            {
                                                "example_id": "fd8ba8ff-3262-4881-bebe-6ecb812bf6b2",
                                                "sense_id": "d6722b10-2543-3900-ac34-661dcfaee66a",
                                                "text": "„Ich habe noch nicht den Aplomb, der mir wachsen wird, weil er nötig ist, wenn man […] mit den Herren der Welt verkehren will.“"
                                            },
                                            {
                                                "example_id": "ccd76f2b-698d-4e78-8235-d0fc763b2846",
                                                "sense_id": "d6722b10-2543-3900-ac34-661dcfaee66a",
                                                "text": "„Neusner war Anfang Vierzig, specknackig, rotblond – daß er Jude war, merkte man nur an seinen schläfrigen Augenlidern –, und trat mit dem Aplomb gewollter und betonter Mittelmäßigkeit auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bcec5a81-06c5-3519-ab70-36212865147c",
                                        "entry_id": "035eb64c-c339-3464-9c79-15d2cc680a64",
                                        "glosses": [
                                            "die Fähigkeit zum Abfangen einer Bewegung, die Balance"
                                        ],
                                        "tags": [
                                            "Ballett"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c3352c6-eba6-4878-9e02-5bcb817d4c00",
                                                "sense_id": "bcec5a81-06c5-3519-ab70-36212865147c",
                                                "text": "„Der Aplomb des Tänzers, wenn er ihn zulassen kann, ist der Ausdruck der Bewegung zur Erdmitte hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9eba90c0-a6a8-45d1-b359-f5d982e1f1ed",
