                                        "examples": [
                                            {
                                                "example_id": "5889745a-779b-49b1-819c-6624f7cb0a15",
                                                "sense_id": "568037cb-8d0e-3585-ab7c-39e36c52d406",
                                                "text": "Le 26 janvier 1699 fut enfin signée la fameuse paix de Karlowitz, a laquelle avait pris tant de part le fameux dragoman de la Porte, Alexandre Maurocordate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df32344d-00fa-400a-9630-24c4713862cb",
                        "source_entry_id": "af8d21f3-fb10-3520-904a-cfcab4a5cb93",
                        "source_sense_id": "06f1e8d4-a684-3020-895f-6cee291161d2",
