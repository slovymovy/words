    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b0af8a53-fefd-3939-818c-4c1aa1060771",
                    "sense_definition": "Femelle du <w>mulet</w>, grand équidé hybride et stérile issu de l'accouplement d'un âne et d'une jument.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le paysan avance lentement sur le sentier escarpé avec sa <w>mule</w> lourdement chargée."
                        },
                        {
                            "text": "Dans ce village de montagne, chaque famille possède au moins une <w>mule</w> pour transporter le bois."
                        }
                    ],
                    "common_phrases": [
                        "conducteur de mules"
                    ]
                },
                {
                    "sense_id": "8bd6aed0-d2a9-3a9e-b9c4-634440da0ad3",
                    "sense_definition": "Chaussure légère d'intérieur ou d'été qui laisse le talon découvert.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chaussure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'elle rentre chez elle le soir, elle enfile une <w>mule</w> confortable."
                        },
                        {
                            "text": "Elle a acheté une nouvelle paire de <w>mules</w> légères pour la belle saison."
                        }
                    ],
                    "common_phrases": [
                        "paire de mules",
                        "mules d'intérieur",
                        "mules à talons"
                    ]
                },
                {
                    "sense_id": "b8351831-ec2e-33d2-9735-51b595d89a14",
                    "sense_definition": "Personne extrêmement têtue, butée et obstinée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refuse d'écouter les conseils de ses collègues car c'est une vraie <w>mule</w>."
                        },
                        {
                            "text": "Mon frère s'entête dans son projet et se montre têtu comme une <w>mule</w>."
                        }
                    ],
                    "common_phrases": [
                        "tête de mule",
                        "têtu comme une mule"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "47376d17-59b5-34aa-9d7f-17e6f4d67e14",
                    "sense_definition": "Personne rémunérée pour transporter clandestinement des drogues ou des produits illicites d'un pays à un autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police des frontières a arrêté une <w>mule</w> transportant des stupéfiants dans ses bagages."
                        },
                        {
                            "text": "Ce jeune homme a accepté de servir de <w>mule</w> en échange d'une forte somme d'argent."
                        }
                    ],
                    "synonyms": [
                        "bouletteux"
                    ],
                    "common_phrases": [
                        "servir de mule"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "terme du milieu criminel"
                        }
                    ]
                },
                {
                    "sense_id": "6f97054f-e9c3-39d1-8162-ae22a75748eb",
                    "sense_definition": "Locomotive ou tracteur électrique se déplaçant sur des rails le long d'une écluse pour guider et remorquer les navires.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cargo franchit le canal lentement, tracté par une puissante <w>mule</w> électrique."
                        },
                        {
                            "text": "Les installations du canal utilisent une <w>mule</w> sur berge pour guider les embarcations."
                        }
                    ]
                },
                {
                    "sense_id": "f442cd41-4162-30bc-b109-9736f9f1e429",
                    "sense_definition": "Autre nom régional ou familier donné au muge ou au <w>mulet</w>, un poisson de mer comestible.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au marché local, le marchand propose une belle <w>mule</w> fraîchement pêchée."
                        },
                        {
                            "text": "Ce pêcheur a capturé une grosse <w>mule</w> près de l'embouchure de la rivière."
