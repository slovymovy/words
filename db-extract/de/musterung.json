                "senses": [
                    {
                        "sense_id": "9e5b92c1-8df4-3c63-86a7-6481516f24f3",
                        "entry_id": "5339b31f-b6a1-31fa-979e-6bbe69f359c7",
                        "glosses": [
                            "prüfende Betrachtung, Untersuchung von etwas"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1011b063-265a-3b9b-9565-6a9094721afb",
                        "entry_id": "5339b31f-b6a1-31fa-979e-6bbe69f359c7",
                        "glosses": [
                            "Ausstatten, Verzieren von etwas mit Mustern"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3f7840c9-56e0-3049-bc46-6ddf6859ef7a",
                        "entry_id": "5339b31f-b6a1-31fa-979e-6bbe69f359c7",
                        "glosses": [
                            "gleichbleibende Struktur, die einer sich wiederholenden Sache zu Grunde liegt; Muster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc13f0e7-5e57-48ad-a898-96f809ae9332",
                                "sense_id": "3f7840c9-56e0-3049-bc46-6ddf6859ef7a",
                                "text": "„Und das Material hat viele Vorteile, lässt sich einfach bearbeiten und leicht färben - bis heute reicht kaum ein anderer Kunststoff in Brillanz, Farbenvielfalt und Musterung an das Zelluloid heran.“"
                            },
                            {
                                "example_id": "cd606730-6588-497b-8a22-41977e3812a0",
                                "sense_id": "3f7840c9-56e0-3049-bc46-6ddf6859ef7a",
                                "text": "„Formal entschieden und kraftvoll zupackend schneidet sich Ersan Mondtag den antiken Stoff zurecht - bis höchstens noch das grobe Gewebe, nicht jedoch die Musterung, Feinzeichnung und die Textur erkennbar sind.“"
                            },
                            {
                                "example_id": "3b31beb0-892b-4282-a584-e79c639f8aff",
                                "sense_id": "3f7840c9-56e0-3049-bc46-6ddf6859ef7a",
                                "text": "„Die Musterung ergibt sich also auf einer mesoskopischen räumlichen Skala: Die einfarbigen Schuppen als Einheiten des Musters sind größer als einzelne Zellen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "4e58be86-6422-3a8b-a581-6a52d66ba45b",
                        "entry_id": "5339b31f-b6a1-31fa-979e-6bbe69f359c7",
                        "glosses": [
                            "Untersuchung der Wehrpflichtigen auf ihre körperliche und geistige Eignung für den Wehrdienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "139e7d77-a53c-4666-9fa4-ae5007410a41",
                                "sense_id": "4e58be86-6422-3a8b-a581-6a52d66ba45b",
                                "text": "„Den Grundwehrdienstleistenden wurde bei der Musterung nicht gesagt, dass sie an die Grenze müssten.“"
                            },
                            {
                                "example_id": "39e0bbed-0e2c-450f-8d81-03ec4b2d6c8f",
                                "sense_id": "4e58be86-6422-3a8b-a581-6a52d66ba45b",
                                "text": "„Zur Musterung gehörte schon damals in Schweden eine ausführliche Erhebung des körperlichen und psychischen Zustands der jungen Männer.“"
                            },
                            {
                                "example_id": "f1a7d3e9-9cc7-4444-b8b7-012a5307ecea",
                                "sense_id": "4e58be86-6422-3a8b-a581-6a52d66ba45b",
                                "text": "„Der Magistrat der Stadt Frankfurt ruft zur Musterung auf und verweist auf das Gesetz der Wehrordnung hin.“"
                            },
                            {
                                "example_id": "c4dba044-2a9d-467a-90b2-f0fd80ff9bd2",
                                "sense_id": "4e58be86-6422-3a8b-a581-6a52d66ba45b",
                                "text": "„Als er das Bürgerrecht der Stadt Zürich erhielt, mußte er zur Musterung für den Militärdienst antreten.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
