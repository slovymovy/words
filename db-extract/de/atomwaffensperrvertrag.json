                "senses": [
                    {
                        "sense_id": "0807cb7e-94ae-3c30-868e-42948fab3352",
                        "entry_id": "205f5274-da00-3f8c-9988-cf918e08d1e8",
                        "glosses": [
                            "im Jahr 1968 unterzeichneter internationaler Vertrag, der die Verbreitung von Kernwaffen und die „friedliche Nutzung“ der Kernenergie regelt"
                        ],
                        "tags": [
                            "Völkerrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "67b606cf-6cf6-4acf-94f9-19abb46ecd54",
                                "sense_id": "0807cb7e-94ae-3c30-868e-42948fab3352",
                                "text": "„Die letzten japanischen Überlebenden des US-Atombombenabwurfs auf Hiroshima waren zur UNO-Konferenz über den Atomwaffensperrvertrag gekommen.“"
                            },
                            {
                                "example_id": "651c88d6-7f26-46a8-974b-4c57df49e5c8",
                                "sense_id": "0807cb7e-94ae-3c30-868e-42948fab3352",
                                "text": "„Obwohl Indien den Atomwaffensperrvertrag nicht unterzeichnet hat und bekanntermassen wie Pakistan seit Jahrzehnten über Nuklearsprengköpfe verfügt, ist das Land nicht mehr vom Handel mit Gütern ausgeschlossen, die zur zivilen Nutzung der Atomtechnologie notwendig sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
