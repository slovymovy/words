{
    "word_family": [
        "débat",
        "débatteur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4343244e-8bb1-3749-9f32-ea195c94e0dd",
                    "sense_definition": "Discuter contradictoirement d'une question ou d'un sujet en exposant différents points de vue.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discussion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les députés vont <w>débattre</w> de ce projet de loi toute la soirée."
                        },
                        {
                            "text": "Nous avons longuement <w>débattu</w> de cette question sans réussir à trouver un accord."
                        }
                    ],
                    "synonyms": [
                        "discuter",
                        "délibérer"
                    ],
                    "common_phrases": [
                        "débattre d'une question",
                        "débattre d'un sujet"
                    ]
                },
                {
                    "sense_id": "c3aafb9f-b65f-35e0-9d84-f3cf6c5c40cb",
                    "sense_definition": "Faire de violents mouvements pour se libérer ou lutter pour surmonter une situation pénible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lutte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'oiseau blessé a tenté de se <w>débattre</w> pour échapper au filet."
                        },
                        {
                            "text": "Cette petite entreprise se <w>débat</w> contre des difficultés économiques majeures depuis un an."
                        }
                    ],
                    "synonyms": [
                        "lutter",
                        "se démener"
                    ],
                    "common_phrases": [
                        "se débattre en vain",
                        "se débattre contre"
                    ]
                },
                {
                    "sense_id": "86f9a538-d6df-39fc-87f3-a300fbda1e66",
                    "sense_definition": "Discuter les conditions d'un accord ou négocier la valeur marchande d'un bien.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "negociation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les acheteurs ont passé une heure à <w>débattre</w> le prix de la marchandise."
                        },
                        {
                            "text": "Le montant du loyer reste encore à <w>débattre</w> avec le propriétaire."
                        }
                    ],
                    "synonyms": [
                        "négocier",
                        "marchander"
                    ],
                    "common_phrases": [
                        "débattre le prix",
                        "prix à débattre"
                    ]
                }
            ]
        }
    ]
}