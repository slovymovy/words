                                    {
                                        "sense_id": "7e48abec-5eea-3602-ac08-5c3634f9043a",
                                        "entry_id": "f5eab117-4f77-3fcf-a142-9928d7200193",
                                        "glosses": [
                                            "A person who makes shoes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b14cb67a-6435-4e55-9568-b3dbae0b528a",
                                                "sense_id": "7e48abec-5eea-3602-ac08-5c3634f9043a",
                                                "text": "He especially recommended the only shoemaker who, to his mind, had an idea of making a shoe; and Lucy had at least half-a-dozen pair made, fitted, and descanted upon, before he was satisfied that they did justice to the shape of her foot, which proved extremely good when it was properly chaussé."
                                            },
                                            {
                                                "example_id": "883caf44-b762-41ad-ad16-07b237189643",
                                                "sense_id": "7e48abec-5eea-3602-ac08-5c3634f9043a",
                                                "text": "The diseases of shoemakers receive attention as well as the toxicology of shoepolish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7625fc8-506f-3986-b941-514fe57435b4",
                                        "entry_id": "f5eab117-4f77-3fcf-a142-9928d7200193",
