{
    "word_family": [
        "carbonate",
        "carbonic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6de3928e-067a-30fb-b5b7-16c9a2fbb192",
                    "sense_definition": "Sodium bicarbonate used as a mild antacid or baking ingredient.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chemical_compound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She added a pinch of <w>bicarbonate</w> to the dough to help it rise.",
                            "target_lang_translations": {
                                "zh": "她在面团里加了一点<w>小苏打</w>来帮助发酵。"
                            }
                        },
                        {
                            "text": "Many people use <w>bicarbonate</w> of soda to soothe an upset stomach.",
                            "target_lang_translations": {
                                "zh": "许多人使用<w>小苏打</w>来缓解胃部不适。"
                            }
                        }
                    ],
                    "synonyms": [
                        "baking soda"
                    ],
                    "common_phrases": [
                        "bicarbonate of soda"
                    ],
                    "target_lang_definitions": {
                        "zh": "碳酸氢钠，常作为温和的抗酸剂或烘焙配料使用。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小苏打",
                                "target_lang_sense_clarification": "指碳酸氢钠，常用于烹饪或家庭清洁。"
                            },
                            {
                                "target_lang_word": "碳酸氢钠",
                                "target_lang_sense_clarification": "化学名称，常用于医药或食品工业。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a98c43f3-cb03-366e-a034-289d78bfe10b",
                    "sense_definition": "The univalent anion HCO₃⁻ or any salt of carbonic acid where only one hydrogen atom is replaced.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemical_compound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blood maintains a stable pH level through a complex <w>bicarbonate</w> buffer system.",
                            "target_lang_translations": {
                                "zh": "血液通过复杂的<w>碳酸氢盐</w>缓冲系统来维持稳定的pH值。"
                            }
                        },
                        {
                            "text": "Chemical analysis confirmed the presence of a dissolved <w>bicarbonate</w> in the water sample.",
                            "target_lang_translations": {
                                "zh": "化学分析证实水样中存在溶解的<w>碳酸氢盐</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "化学中的碳酸氢根离子（HCO₃⁻）或碳酸氢盐。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "碳酸氢盐",
                                "target_lang_sense_clarification": "指碳酸中一个氢原子被取代后形成的盐类。"
                            },
                            {
                                "target_lang_word": "碳酸氢根",
                                "target_lang_sense_clarification": "指化学中的阴离子 HCO₃⁻。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}