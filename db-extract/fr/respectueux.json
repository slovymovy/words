                                        "entry_id": "7ca7a165-647f-3bf4-8d55-19e6fa56757d",
                                        "glosses": [
                                            "Marked or characterized by respect"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d914d67-3464-4fde-8132-984b6392dbb9",
                                                "sense_id": "71aa3ba7-822e-394d-a9d1-7b8f091b77ea",
                                                "text": "1907, Marshall Broomhall (Editor), The Chinese Empire. A General & Missionary Survey/The Province of Kansu\nOn the whole, indifference rather than open hostility has been the attitude of the people towards the Gospel, but since 1900 there has been a more eager and respectful attention to the things taught."
                                            },
                                            {
                                                "example_id": "34b6a6a2-de61-4e2e-a6e0-77e02096643b",
                                                "sense_id": "71aa3ba7-822e-394d-a9d1-7b8f091b77ea",
                                                "text": "It is of great importance that you act in a respectful manner towards the duke and duchess."
                                            },
                                            {
                                                "example_id": "34c700e1-59a8-486e-a4c7-0f771d9f28aa",
                                                "sense_id": "71aa3ba7-822e-394d-a9d1-7b8f091b77ea",
                                                "text": "They used highly respectful language when conversing with the elders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f03ded3-0097-427e-acdf-646978a23c70",
