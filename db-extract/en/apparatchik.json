                "entry_id": "47ccc7cb-18c1-33ef-8663-4ae52e6dfe92",
                "word": "apparatchik",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "739aaf44-ea72-4369-b86f-1ed308fc81f9",
                        "entry_id": "47ccc7cb-18c1-33ef-8663-4ae52e6dfe92",
                        "tags": [
                            "plural"
                        ],
                        "form": "apparatchiks"
                    },
                    {
                        "form_id": "6948fda7-107f-43b1-9479-0e26704ec169",
                        "entry_id": "47ccc7cb-18c1-33ef-8663-4ae52e6dfe92",
                        "tags": [
                            "plural"
                        ],
                        "form": "apparatchiki"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c95dad9-aee9-311d-9d8b-f788b197312e",
                        "entry_id": "47ccc7cb-18c1-33ef-8663-4ae52e6dfe92",
                        "glosses": [
                            "A member of the Soviet apparat; a Communist bureaucrat or agent."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ad1e5b12-6fb4-483f-9dc4-d2301b017b0f",
                                "sense_id": "5c95dad9-aee9-311d-9d8b-f788b197312e",
                                "text": "Whether conservatively toeing their Marx or boldly advocating such heretical Western-style reforms as the primacy of profits, every important planner, apparatchik and economist in Russia is caught up in Communism's greatest debate since Stalin set backward Russia on its cruel-but successful-forced march into the 20th century industrial world."
                            },
                            {
                                "example_id": "0cd56b05-c3a2-4c45-a3d9-f666f084a5de",
                                "sense_id": "5c95dad9-aee9-311d-9d8b-f788b197312e",
                                "text": "In these dire conditions the ambitious Serbo-Croatian Communist Party apparatchik Slobodan Milošević played the national card in Kosovo."
                            }
                        ]
                    },
                    {
                        "sense_id": "45240870-21d8-3580-80be-74cb22c02eb2",
                        "entry_id": "47ccc7cb-18c1-33ef-8663-4ae52e6dfe92",
                        "glosses": [
                            "A blindly loyal bureaucrat."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "21c13699-b246-48ef-a97e-cfe90473648e",
                                "sense_id": "45240870-21d8-3580-80be-74cb22c02eb2",
                                "text": "Mr. Gonzales came across as a dull-witted apparatchik incapable of running one of the most important departments in the executive branch. […] He delegated responsibility for purging their ranks to an inexperienced and incompetent assistant who, if that’s possible, was even more of a plodding apparatchik."
                            },
                            {
                                "example_id": "2a0e0b18-96df-410e-b124-4c3122010684",
                                "sense_id": "45240870-21d8-3580-80be-74cb22c02eb2",
                                "text": "He's so outspoken, so little the Labour apparatchik, that Prime Minister Brown decides he can't send this voluble critic of Iraq invasion to sit at a UN occasion alongside George W Bush."
                            },
                            {
                                "example_id": "d18e026f-c8fb-469b-bf84-ef1601dad40c",
                                "sense_id": "45240870-21d8-3580-80be-74cb22c02eb2",
                                "text": "“Does France, a founder member of the EU, really want to be the country that sends the biggest battalion of far-right apparatchiks to the European parliament?” [Gabriel] Attal asked."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fdaa328-319a-4357-affe-7e2a5db59c24",
                        "source_entry_id": "47ccc7cb-18c1-33ef-8663-4ae52e6dfe92",
                        "source_sense_description": "member of a Communist apparat",
                        "target_lang_word": "apparatsjik",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apparatsjik",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b23a6315-84b3-33d0-a96f-6db9a1469cd5",
                                        "entry_id": "d7702b50-099d-3f3b-a2c5-38f2b279eeb6",
                                        "glosses": [
                                            "iemand die ten tijde van het Sovjet-tijdperk werkte bij de Communistische Partij of de Russische overheid"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c940ee6-0e7a-4d03-ad90-7526cd36ad0e",
                                                "sense_id": "b23a6315-84b3-33d0-a96f-6db9a1469cd5",
                                                "text": "Michail Gorbatsjov was een brave communistische apparatsjik."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0893a22-e384-3065-bf9d-010d163ccbfc",
                                        "entry_id": "d7702b50-099d-3f3b-a2c5-38f2b279eeb6",
                                        "glosses": [
                                            "ambtenaar die door zijn bureaucratische werkwijze onnodige barrières opwerpt"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66d69943-1ad7-4483-9459-c0f454448553",
                                                "sense_id": "d0893a22-e384-3065-bf9d-010d163ccbfc",
                                                "text": "En als het onheil niet uit Kansas komt, is er wel een Chinese kredietindicator opgesteld door een apparatsjik in Peking die beleggers uit hun slaap houdt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2223466-4c86-48c9-b636-77e2aaed6899",
                        "source_entry_id": "47ccc7cb-18c1-33ef-8663-4ae52e6dfe92",
                        "source_sense_description": "member of a Communist apparat",
                        "target_lang_word": "apparatchik",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apparatchik",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b43d5fc-c7b3-3a14-b17c-a612ff5a2de8",
                                        "entry_id": "7b313ffa-30e3-3072-8351-01d86d0b3c35",
                                        "glosses": [
                                            "Dignitaire du parti communiste soviétique en Russie ou ailleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "060ff1dd-5feb-408a-96a9-254a02b50dd6",
                                                "sense_id": "7b43d5fc-c7b3-3a14-b17c-a612ff5a2de8",
                                                "text": "Un apparatchik chinois exécuté pour pots-de-vin. Pour apaiser le mécontentement général, le Premier ministre fustige la corruption."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3c5f069-188c-3ea0-bef9-75394fe68a73",
                                        "entry_id": "7b313ffa-30e3-3072-8351-01d86d0b3c35",
                                        "glosses": [
                                            "Dignitaire, cadre, d'une bureaucratie administrative, d'un parti politique."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "277fbbc5-a92e-47d3-988e-1cbba8ae4c8f",
                                                "sense_id": "b3c5f069-188c-3ea0-bef9-75394fe68a73",
                                                "text": "Bertrand Plouvier vise, sans la nommer, la candidate tête de liste à Rennes pour le PS : la député Nathalie Appéré : « On a ici à Rennes de nombreux exemples, de personnes du sérail, au parcours typique d’apparatchik, directement sorties de Sciences Po qui après avoir été chargées de mission au sein de collectivités locales ou d’établissements publics sont devenues adjoint au maire, voire plus… Cette mesure d’interdiction d’exercer une profession et le non-cumul avec un mandat local, François Hollande va transformer la représentation nationale en une assemblée de professionnels de la politique, coupé du terrain et de toute réalité »."
                                            },
                                            {
                                                "example_id": "4c7818a2-c48c-411f-8c63-f924896df076",
                                                "sense_id": "b3c5f069-188c-3ea0-bef9-75394fe68a73",
                                                "text": "Les apparatchiks de Twitter, massivement démocrates, partageaient la même crainte."
                                            },
                                            {
                                                "example_id": "458a43da-b6c3-4d39-8531-02a88ef33a1e",
                                                "sense_id": "b3c5f069-188c-3ea0-bef9-75394fe68a73",
                                                "text": "Le ministère public se tient debout devant un parterre d’apparatchiks du Rassemblement national (RN), renvoyés devant le tribunal correctionnel pour détournement de fonds publics."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apparatchik",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "714756ba-d72e-39f3-86b9-27d4e6bb71b1",
                                        "entry_id": "f572ece4-8bab-3fdf-a591-26983da5bef1",
                                        "glosses": [
                                            "Relatif aux apparatchiks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad0eaa42-0cf1-4cfc-ac14-ed3caea4d2d5",
                                                "sense_id": "714756ba-d72e-39f3-86b9-27d4e6bb71b1",
                                                "text": "Il y a dans la direction une volonté de ne pas entrer dans un vrai débat politique et de faire reposer la désignation du candidat des Écologistes sur un noyau toujours plus restreint d'adhérents. C'est l'antithèse d'une primaire, qui suppose au contraire d'ouvrir et de se laisser déborder par un élan citoyen. Au lieu de cela, Marine Tondelier et ses proches s'enferment dans des réflexes apparatchiks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5bcedcb-9b8a-4639-877a-b94a7f89b7cd",
                        "source_entry_id": "47ccc7cb-18c1-33ef-8663-4ae52e6dfe92",
                        "source_sense_description": "member of a Communist apparat",
                        "target_lang_word": "Apparatschik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apparatschik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4aff4889-c841-3244-82c9-3138435d7b24",
                                        "entry_id": "67c4992f-7628-3a47-9976-40fb3f8837e9",
                                        "glosses": [
                                            "ein Befehlsempfänger in einem politischen System, der seinerseits unbeirrt Maßnahmen durchdrückt, die systemkonform sind"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b64899e0-5163-49c5-911e-32fa6a9b6681",
                                                "sense_id": "4aff4889-c841-3244-82c9-3138435d7b24",
                                                "text": "„Der Kollege Marx lächelt bereits, er ist nämlich auch so ein Apparatschik Ihrer Definition nach. – Und sie meinen damit wahrscheinlich auch die vielen Vertreter im Bereich der Landwirtschaft, die in den vielen landwirtschaftlichen Genossenschaften sitzen und dort mitarbeiten. Und wenn ich hinüberschaue, sehe ich bei Ihnen eigentlich sehr, sehr viele solcher Apparatschiks, wie der Kollege Rauchwarter sie einzustufen pflegt, sitzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
