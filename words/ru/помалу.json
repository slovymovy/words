    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c93f3f04-c36e-3a10-b4bb-5c725b0e3b55",
                    "sense_definition": "понемногу, постепенно, небольшими частями",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gradual_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Снег <w>помалу</w> таял под лучами весеннего солнца.",
                            "target_lang_translations": {
                                "en": "The snow was <w>gradually</w> melting under the rays of the spring sun."
                            }
                        },
                        {
                            "text": "Мы <w>помалу</w> привыкали к новому месту жительства.",
                            "target_lang_translations": {
                                "en": "We were <w>little by little</w> getting used to our new place of residence."
                            }
                        }
                    ],
                    "synonyms": [
                        "постепенно",
                        "понемногу"
                    ],
                    "antonyms": [
                        "сразу",
                        "быстро"
                    ],
                    "common_phrases": [
                        "двигаться помалу"
                    ],
                    "target_lang_definitions": {
                        "en": "little by little, gradually, in small parts"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gradually",
                                "target_lang_sense_clarification": "happening or changing slowly over a period of time"
                            },
                            {
                                "target_lang_word": "little by little",
                                "target_lang_sense_clarification": "in small amounts or stages"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4f6dc5c-ef1f-31c3-a1c2-0ec5b21b4e95",
                    "sense_definition": "не торопясь, медленно",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slow_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старик <w>помалу</w> шёл по тропинке к лесу.",
                            "target_lang_translations": {
                                "en": "The old man was <w>slowly</w> walking along the path toward the forest."
                            }
                        },
                        {
                            "text": "Лошадь <w>помалу</w> тянула тяжёлую телегу в гору.",
                            "target_lang_translations": {
                                "en": "The horse was <w>slowly</w> pulling the heavy cart uphill."
                            }
                        }
                    ],
                    "synonyms": [
                        "медленно"
                    ],
                    "antonyms": [
                        "быстро"
                    ],
                    "common_phrases": [
                        "идти помалу"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "without rushing, slowly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slowly",
                                "target_lang_sense_clarification": "at a low speed"
                            },
                            {
                                "target_lang_word": "leisurely",
                                "target_lang_sense_clarification": "in an unhurried or relaxed manner"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d169913-542c-3e14-8c8d-f0d14a09351c",
                    "sense_definition": "терпимо, сносно, удовлетворительно",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Жизнь течёт <w>помалу</w>, жаловаться не на что.",
                            "target_lang_translations": {
                                "en": "Life is going <w>tolerably</w> well, there is nothing to complain about."
                            }
                        },
                        {
                            "text": "Дела идут <w>помалу</w>, работа продвигается.",
                            "target_lang_translations": {
                                "en": "Things are going <w>passably</w>, the work is moving forward."
                            }
                        }
                    ],
                    "synonyms": [
                        "сносно"
                    ],
                    "antonyms": [
                        "невыносимо"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "tolerably, passably, satisfactorily"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tolerably",
                                "target_lang_sense_clarification": "in a way that is acceptable or satisfactory"
                            },
                            {
                                "target_lang_word": "passably",
                                "target_lang_sense_clarification": "good enough to be acceptable"
                            }
                        ]
                    }
                }
            ]
        }
