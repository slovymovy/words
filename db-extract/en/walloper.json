                        "entry_id": "107c504b-5229-3640-9766-254f4ec3b279",
                        "glosses": [
                            "A police officer."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "efee37ac-e0ff-4013-9e3b-66476cd1d131",
                                "sense_id": "5b0d01f4-dac4-3ccd-a81b-13e2beb55a17",
                                "text": "Police! Everyone out! The bloody wallopers are on their way!"
                            },
                            {
                                "example_id": "18c9401d-81b3-4c9b-bd98-e5080ccc4624",
                                "sense_id": "5b0d01f4-dac4-3ccd-a81b-13e2beb55a17",
                                "text": "Two days later we were picked up by the wallopers on Clucas' information."
                            },
                            {
                                "example_id": "0f586e45-ba7e-48a9-91ef-c7ca0f87906c",
                                "sense_id": "5b0d01f4-dac4-3ccd-a81b-13e2beb55a17",
                                "text": "Understandably the wallopers were called, and they cleared everybody out."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d68134c-38dc-3551-a1da-1114612c31e6",
                        "entry_id": "107c504b-5229-3640-9766-254f4ec3b279",
                        "glosses": [
                            "Something big; a whopper."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8c2156c8-65a4-40b0-950f-0005c012d8f8",
                                "sense_id": "5d68134c-38dc-3551-a1da-1114612c31e6",
                                "text": "I'd had some wonderful fishing, but I hadn't landed a real walloper."
                            }
                        ]
