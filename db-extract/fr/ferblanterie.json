                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3fb5822-e75d-3cc8-b328-81b89c2847ff",
                        "entry_id": "1b8485cd-11d4-3209-beea-bf7903ec7706",
                        "glosses": [
                            "Industrie, commerce du ferblantier, assortiment d’objets de fer-blanc."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "b823b833-c5ae-4d40-9ead-9046e1deb3a3",
                                "sense_id": "f3fb5822-e75d-3cc8-b328-81b89c2847ff",
                                "text": "Dans un second temps, la construction d’un atelier de ferblanterie a permis d’explorer la partie nord du site, marquée par un arasement important des vestiges."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ab5e870-821b-3629-bfa7-296d53af50a1",
                        "entry_id": "1b8485cd-11d4-3209-beea-bf7903ec7706",
                        "glosses": [
                            "Ensemble de choses clinquantes et sans grande valeur."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "aa6e9029-399c-499d-ae9b-30df8d0db1a4",
                                "sense_id": "3ab5e870-821b-3629-bfa7-296d53af50a1",
                                "text": "Ils avaient débuté tous les deux dans Gaspardo le Pêcheur, un des plus beaux morceaux de la ferblanterie mélodramatique."
                            },
                            {
                                "example_id": "0fac499d-46be-499e-be59-3f711e6424cb",
                                "sense_id": "3ab5e870-821b-3629-bfa7-296d53af50a1",
                                "text": "Directrice d’un journal de mode, elle mesurait près de six pieds, était toujours vêtue en noir, affectait un monocle, une canne et toute une ferblanterie brimbalante de bijoux mexicains."
                            }
                        ]
                    }
                ],
