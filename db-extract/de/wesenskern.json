                        "examples": [
                            {
                                "example_id": "184b5677-c6c8-495f-995a-53bcc8a5e55d",
                                "sense_id": "3ec76377-667b-3a5d-a83e-32d3df9edf7f",
                                "text": "„Wenn der Mensch ein Tier sterben sieht, so befällt ihn ein Gefühl des Grauens; das, was ihn selbst ausmacht und seinen eigenen Wesenskern bildet, das wird hier vor seinen Augen vernichtet, es hört auf zu sein.“"
                            },
                            {
                                "example_id": "7298ac55-5472-414e-b88f-736a72a692ad",
                                "sense_id": "3ec76377-667b-3a5d-a83e-32d3df9edf7f",
                                "text": "„Jeder wird mit einem Wesenskern geboren.“"
                            }
                        ],
