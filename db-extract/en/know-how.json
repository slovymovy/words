    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5460d9d1-fbbc-3e37-b89f-a3e71b6b1ff1",
                "word": "know-how",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ab414e38-1311-387a-b67f-dc5124cacc0f",
                        "entry_id": "5460d9d1-fbbc-3e37-b89f-a3e71b6b1ff1",
                        "glosses": [
                            "The knowledge and skill to be able to (do something correctly)."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2448b225-e70b-4c58-aaff-c02f9d6c5c1e",
                                "sense_id": "ab414e38-1311-387a-b67f-dc5124cacc0f",
                                "text": "Marlo has the know-how to fix your computer."
                            },
                            {
                                "example_id": "ba1bfe9b-a482-4ec0-a722-dd72b5d5ab1f",
                                "sense_id": "ab414e38-1311-387a-b67f-dc5124cacc0f",
                                "text": "American innovators — with their world-class strengths in product design, marketing and finance — may have a historic opportunity to convert the scientific know-how from abroad into market gains and profits. Mr. Hill views the transition to “the postscientific society” as an unrecognized bonus for American creators of new products and services."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67ec4916-dff2-4ce6-8aa5-88f2971ba98c",
                        "source_entry_id": "5460d9d1-fbbc-3e37-b89f-a3e71b6b1ff1",
                        "source_sense_id": "ab414e38-1311-387a-b67f-dc5124cacc0f",
                        "source_sense_description": "the knowledge and skill to be able to do something correctly",
                        "target_lang_word": "savoir-faire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "savoir-faire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                                        "entry_id": "b2a1c941-4e48-361f-84bf-36fc3912e5e6",
                                        "glosses": [
                                            "Connaissance pratique d'un domaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a57a7f4-e8bd-48b2-a92e-18da359fdb7e",
                                                "sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                                                "text": "La célèbre mirabelle de Lorraine est le fruit d’un savoir-faire ancestral qui respecte le rythme des saisons."
                                            },
                                            {
                                                "example_id": "9605518d-e757-4666-8cf8-167d59b5f461",
                                                "sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                                                "text": "Voilà un bel exemple du fait que le savoir-faire peut très bien précéder le savoir. C'est ainsi que l'on a inventé le levier bien avant qu'Archimède n'en explique le principe."
                                            },
                                            {
                                                "example_id": "64e662b1-7a1e-41d6-aecc-27d1ea9ae76f",
                                                "sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                                                "text": "Il n’a pas de véritable talent, il n’a que du savoir-faire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48548348-387d-494e-96e2-80d90c40964f",
                        "source_entry_id": "5460d9d1-fbbc-3e37-b89f-a3e71b6b1ff1",
                        "source_sense_id": "ab414e38-1311-387a-b67f-dc5124cacc0f",
                        "source_sense_description": "the knowledge and skill to be able to do something correctly",
                        "target_lang_word": "Fachwissen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fachwissen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cef642e5-9795-324e-9548-e4fc6f193436",
                                        "entry_id": "e741ef39-40f3-3da2-95e2-d23f2668786a",
                                        "glosses": [
                                            "das Wissen, das jemand von seinem Fach hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4db59f9-5b98-4f49-947f-eef97323f107",
                                                "sense_id": "cef642e5-9795-324e-9548-e4fc6f193436",
                                                "text": "„Der Kunde hat vielleicht die finanzielle Hoheit, aber leider hat die Firma das überlegene Fachwissen.“"
                                            },
                                            {
                                                "example_id": "c415964c-dfa1-46a1-bf33-5a3242a79491",
                                                "sense_id": "cef642e5-9795-324e-9548-e4fc6f193436",
                                                "text": "„Die Linguistik sollte dies als Chance begreifen und sich in den entsprechenden öffentlichen Diskursen mit ihrem Fachwissen vernehmlich zu Wort melden.“"
                                            },
                                            {
                                                "example_id": "31e118b4-fd0d-4be0-95e9-7c32ed65af3c",
                                                "sense_id": "cef642e5-9795-324e-9548-e4fc6f193436",
                                                "text": "„Sein Fachwissen hat sich Stang über Jahre hinweg angeeignet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7be7e59-4099-4572-9b3b-5cc9ea0c0e25",
                        "source_entry_id": "5460d9d1-fbbc-3e37-b89f-a3e71b6b1ff1",
                        "source_sense_id": "ab414e38-1311-387a-b67f-dc5124cacc0f",
                        "source_sense_description": "the knowledge and skill to be able to do something correctly",
                        "target_lang_word": "Sachkenntnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sachkenntnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                        "entry_id": "f023fbc0-238d-356b-a403-0a5330f89777",
                                        "glosses": [
                                            "Wissen eines Experten in einem Fachgebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb86a063-dce1-4ffb-a589-ebdd4db80f09",
                                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                                "text": "Jäger müssen ihre Sachkenntnis in Deutschland mit dem Bestehen einer Prüfung belegen."
                                            },
                                            {
                                                "example_id": "dd10277e-64d2-4f3e-8a4e-289f4f45e682",
                                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                                "text": "„Auch wenn es von der Bundesregierung heiße, junge arbeitsfähige Männer könnten sich in den sicheren Landesteilen [von Afghanistan] eine neue Existenz aufbauen, zeuge dies von erstaunlich wenig Sachkenntnis, sagt Ramin Mohabat entschieden.“"
                                            },
                                            {
                                                "example_id": "dcbdb0f4-4bda-44f3-b16e-5447d8a3c74b",
                                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                                "text": "„Selbst die Grünen im Europaparlament lobten [Günther Oettinger] schon wenige Monate nach Amtsantritt für seine Sachkenntnis und Ausdauer.“"
                                            },
                                            {
                                                "example_id": "0fdfb9f5-913c-4ecc-8966-fd289ed45cd6",
                                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                                "text": "„‚[Der Journalist Karl-Heinz] Harenberg hatte einen scharfen Verstand, verfügte über gute Sachkenntnis und seine Art zu (hinter)fragen war nachgerade penetrant. […]‘“"
                                            },
                                            {
                                                "example_id": "69a08723-081c-4bb3-948a-8bc3cd8b1331",
                                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                                "text": "„[…] Goran Tvrdić […] setzt sich mit großer Leidenschaft und Sachkenntnis auch für die Bienen ein.“"
                                            },
                                            {
                                                "example_id": "635ea76c-5a1c-4b56-9304-aaacfd875a08",
                                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                                "text": "„Als Vize-Fraktionschefin Beatrix von Storch kürzlich im Bundestag den Migrationspakt verurteilte, konterte der Christdemokrat [Stephan Harbarth] und warf der Juristin Storch fehlende Sachkenntnis vor […]“"
                                            },
                                            {
                                                "example_id": "730f055b-3247-485c-8443-cde49350cc46",
                                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                                "text": "„Simonetta Sommaruga ist bekannt als ruhige Politikerin, die weniger durch markige Statements als durch Sachkenntnis und Hartnäckigkeit auffällt.“"
                                            },
                                            {
                                                "example_id": "c3c31ea9-9610-4436-aacd-6dbbdec15bea",
                                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                                "text": "„Am Ende allerdings überraschte mich einer der [amerikanischen] Gefangenen mit seiner Sachkenntnis bezüglich unseres Landes [der Schweiz].“"
                                            },
                                            {
                                                "example_id": "f3696841-e651-46b3-b00f-7aaaf6a0ba1e",
                                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                                "text": "[…] warum die Welt dieser Drohung [mit Atomwaffen und Raketen] so hilflos gegenübersteht und wie Nordkorea und seine Führung ticken, beschreibt Matthias Naß in seinem Buch „Countdown in Korea“ mit hoher Sachkenntnis, kühlem analytischen Kopf und klarer Sprache."
                                            },
                                            {
                                                "example_id": "a9879df2-21f7-4cdc-849c-fba8e9515f11",
                                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                                "text": "„Mit Engelsgeduld und viel Sachkenntnis verwenden die beiden jede freie Minute darauf, das geschichtsträchtige Gebäude wieder herzurichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb32ec99-a982-4738-8f0f-ec44778a22ad",
                        "source_entry_id": "5460d9d1-fbbc-3e37-b89f-a3e71b6b1ff1",
