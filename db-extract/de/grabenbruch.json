                ],
                "senses": [
                    {
                        "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                        "entry_id": "c81bca54-829a-32fb-a66e-1471a576f9b2",
                        "glosses": [
                            "Verwerfung/Absenkung in der Erdkruste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28aa25ac-923c-4871-96f8-113ad6fea010",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "„Was aber ermöglicht dennoch die Ausbildung von Grabenbrüchen und die Trennung von Kontinenten?“"
                            },
                            {
                                "example_id": "fa9511e6-22f4-4957-8c5b-fe53452c2e96",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "„Grabenbrüche entstehen dann, wenn die kontinentale Erdkruste durch verschiedene Ursachen gedehnt wird.“"
                            },
                            {
                                "example_id": "a26e681f-150d-459e-b600-3ddd47b4e612",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "„Grabenbrüche sind Risse in der äußeren Erdschicht, die anwachsen und schließlich neue Ozeane formen können.“"
                            },
                            {
                                "example_id": "09cd6c8b-1452-433f-9221-0cfcc8c553e2",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "„Ein riesiger Grabenbruch hätte vor rund einer Milliarde Jahren nahezu den nordamerikanischen Kontinent entzweit. Doch er blieb stecken.“"
                            },
                            {
                                "example_id": "28d2b12a-4808-4fb2-b60c-b65085a5e961",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "„Der Grabenbruch liegt mehrheitlich unter dicken Sedimenten verborgen, was seine Erforschung erschwert.“"
                            },
                            {
                                "example_id": "b1ee4737-ce7d-4de7-a45e-785238cd773f",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "„Tektonische Seen wie der Vansee entstanden durch Dehnung der Erdkruste und dadurch auftretende Risse und Grabenbrüche, z. B. der Baikalsee.“"
                            },
                            {
                                "example_id": "bff08d24-f1e6-4980-88c8-88714ccb5f60",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "[Kenia:] „»Hier am afrikanischen Grabenbruch sind die Bedingungen für die Geothermie optimal«, sagt Langat.“"
                            },
                            {
                                "example_id": "80899672-c396-4ed5-a92b-621be8dcc869",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "[Kenia:] „Die Lage des Landes entlang des ostafrikanischen Grabenbruchs, der durch die Abspaltung der arabischen Erdplatte von der afrikanischen entstand, und die vulkanische Aktivität der Region bieten gute Bedingungen für die Nutzung von Erdwärme.“"
                            },
                            {
                                "example_id": "c24bf9ce-bfec-469e-acdc-11bb1478d102",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "„Der isländische Silfra-Grabenbruch gehört zu den klarsten Gewässern der Welt.“"
                            },
                            {
                                "example_id": "a22e39ba-3441-4d52-9f80-9c83b77af7bf",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "„Die Olkaria-Erdwärmekraftwerke in Kenia liegen im Rift Valley, einem langen Grabenbruch in der Erdkruste, der vom Libanon bis Mosambik reicht.“"
                            },
                            {
                                "example_id": "c0456de9-9510-436c-b87f-5cf75ffa383f",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "„Das Arava-Tal, dass sich im syrisch-afrikanischen Grabenbruch ungefähr vom Toten Meer bis zum Roten Meer erstreckt, ist eine reine Wüstenlandschaft.“"
                            },
                            {
                                "example_id": "ff11c3cb-db93-4f4d-848e-69c3b57dedbe",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "„In der ersten Phase bildet sich durch Dehnung der Kruste ein Grabenbruch, vergleichbar jenem in Ostafrika, der sich mit einer Rate von unter einem Zentimeter pro Jahr weitet.“"
                            },
                            {
                                "example_id": "f886ef94-4100-47f7-b467-8514529cb122",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "„Das Jordantal ist eine der ältesten Kulturregionen der Welt und es ist geologisch einmalig: Vor 20 Millionen Jahren begannen sich zwei gewaltige Erdkrustenschollen voneinander zu lösen, es entstand der tiefste Grabenbruch der Erde. Der Spiegel des Toten Meeres, in das der Jordan mündet, ist mit rund 416 Metern die tiefstgelegene Stelle der Erdoberfläche.“"
                            },
                            {
                                "example_id": "ba21b3b1-40f2-4d9c-8c71-f8f028082ca2",
                                "sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                                "text": "„Zudem ist die Mondkruste an vielen Stellen zertrümmert, eine Folge der vielen Einschläge. Im Ozean der Stürme gibt es gewaltige Grabenbrüche in der Kruste, durch die viel Lava aus dem Mondinnern an die Oberfläche gestiegen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d826ee78-0253-4d89-b096-283c4920997d",
                        "source_entry_id": "c81bca54-829a-32fb-a66e-1471a576f9b2",
                        "source_sense_id": "a7724af9-55ca-3038-9f44-2e21b052c351",
                        "source_sense_description": "Verwerfung/Absenkung in der Erdkruste",
                        "target_lang_word": "rift",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85760595-bd17-3bc3-a3b5-fd16d9e03a61",
                                        "entry_id": "12fa97f1-fd17-386f-8c3a-b786b6c21ff5",
                                        "glosses": [
                                            "A chasm or fissure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8edc8ba-737b-4257-8f32-eb71efcc061d",
                                                "sense_id": "85760595-bd17-3bc3-a3b5-fd16d9e03a61",
                                                "text": "The Grand Canyon is a rift in the Earth's surface, but is smaller than some of the undersea ones."
                                            },
                                            {
                                                "example_id": "ae6de87b-9acc-44df-8b9a-8c279ceb3b65",
                                                "sense_id": "85760595-bd17-3bc3-a3b5-fd16d9e03a61",
                                                "text": "Where ashes are heaped in drifts / Over vineyard and field and town, / Whenever he starts and lifts / His head through the blackened rifts / Of the crags that keep him down"
                                            },
                                            {
                                                "example_id": "8052be95-846e-4659-92f7-6809e1319447",
                                                "sense_id": "85760595-bd17-3bc3-a3b5-fd16d9e03a61",
                                                "text": "As far as the eye can reach is a sea of green tree tops, with occasionally a deep rift where there is a chasm. Here and there are silver threads where the rivers wind in deep gorges through the forests."
                                            },
                                            {
                                                "example_id": "ff997cd1-508e-4878-82fe-6183d004f51d",
                                                "sense_id": "85760595-bd17-3bc3-a3b5-fd16d9e03a61",
                                                "text": "Far back in the dim geologic ages, when the sediments of the old seas were being gathered and outspread in smooth sheets like leaves of a book, and when these sediments became dry land, and were baked and crumbled into the sky as mountain ranges; when the lava-floods of the Fire Period were being lavishly poured forth from innumerable rifts and craters;[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0322d811-f3c8-3628-8fbe-6f4a1eae1442",
                                        "entry_id": "12fa97f1-fd17-386f-8c3a-b786b6c21ff5",
                                        "glosses": [
                                            "A lack of cohesion; a state of conflict, incompatibility, or emotional distance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f8293a1-aec0-4c38-bf8c-7c198ee6d70b",
                                                "sense_id": "0322d811-f3c8-3628-8fbe-6f4a1eae1442",
                                                "text": "My marriage is in trouble: the fight created a rift between us and we can't reconnect."
                                            },
                                            {
                                                "example_id": "4e21ffb5-21dd-4137-91d1-c093730278a0",
                                                "sense_id": "0322d811-f3c8-3628-8fbe-6f4a1eae1442",
                                                "text": "Elon Musk, the billionaire tech entrepreneur, has opened a new rift with Donald Trump by denouncing the US president’s tax and spending bill as a “disgusting abomination”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34e0bd05-c2c8-3c44-baca-6c3fea347065",
                                        "entry_id": "12fa97f1-fd17-386f-8c3a-b786b6c21ff5",
                                        "glosses": [
                                            "A break in the clouds, fog, mist etc., which allows light through."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f195dbb-be1e-4d0b-93ea-2c7523b208d6",
                                                "sense_id": "34e0bd05-c2c8-3c44-baca-6c3fea347065",
                                                "text": "I have but one rift in the darkness, that is that I have injured no one save myself by my folly, and that the extent of that folly you will never learn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1025082-0b20-34e8-b3f7-4e2fd76fdb96",
                                        "entry_id": "12fa97f1-fd17-386f-8c3a-b786b6c21ff5",
                                        "glosses": [
                                            "A shallow place in a stream; a ford."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b135dc6d-16b0-3fa5-9df5-36620c7c31fb",
