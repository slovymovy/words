                "senses": [
                    {
                        "sense_id": "7321eafa-9508-3a75-9c06-f4f349ed0df9",
                        "entry_id": "45858e8a-602a-3b4c-b4b7-417cefd41f50",
                        "glosses": [
                            "platte stop waarmee het bomgat midden op op de bolle kant van een vat wordt afgesloten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71b7809c-7598-4961-8241-3f430c93fb37",
                                "sense_id": "7321eafa-9508-3a75-9c06-f4f349ed0df9",
                                "text": "⧖ Den Wijn zijn schuim en vuur uit de vaten geworpen hebbende, vullen ze dezelve agt dagen daarna weer op, en dekken ze met een Wijngaard-blad, 't welk ze over het Bomgat uitspreiden. En opdat de dampen van den Wijn dit blad niet uit zijne plaats zouden beweegen, leggen ze 'er een klein steentje op, om het neer te houden, omdat, indien ze 'er een Stop of Deutel opstaken, de Wijn, geen lugt hebbende, den bodem van de vaten zou uitwerpen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e88b94a5-7e74-3a69-9a64-60796cc94db5",
                        "entry_id": "45858e8a-602a-3b4c-b4b7-417cefd41f50",
                        "glosses": [
                            "spits, vierkant pennetje van eikenhout dat in een houten pen wordt geslagen, zodat die vast komt te zitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cf6329e-02f6-4148-81fb-533d49b1546d",
                                "sense_id": "e88b94a5-7e74-3a69-9a64-60796cc94db5",
                                "text": "Weet je wat een \"deutel\" is vroeg zij een timmerman."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bb34f2b-26d9-3214-bd50-f75cc4b93c67",
                        "entry_id": "45858e8a-602a-3b4c-b4b7-417cefd41f50",
                        "glosses": [
                            "houten nagel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f1c80bc-0ea6-40e6-b47e-be7210d2d21b",
                                "sense_id": "8bb34f2b-26d9-3214-bd50-f75cc4b93c67",
                                "text": "Een deutel was een spits toelopende houten pen, achtkant en ongeveer vijftien centimeter lang. Ze werden door het hout van de romp in de kromhouten gedreven en in de kop van de deutel joeg men nog weer een houten pen om de kop stevig in het kromhout te persen."
                            }
                        ]
                    }
                ],
