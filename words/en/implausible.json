            "senses": [
                {
                    "sense_id": "733b6a18-383c-3e20-9959-0761c1c7f24e",
                    "sense_definition": "Not seeming reasonable or probable; difficult to believe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unlikely",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness gave an <w>implausible</w> explanation for why he was at the scene of the crime.",
                            "target_lang_translations": {
                                "ru": "Свидетель дал <w>неправдоподобное</w> объяснение того, почему он находился на месте преступления."
                            }
                        },
                        {
                            "text": "It seems highly <w>implausible</w> that the small company could win such a massive international contract.",
                            "target_lang_translations": {
                                "ru": "Кажется крайне <w>маловероятным</w>, что маленькая компания смогла бы выиграть такой масштабный международный контракт."
                            }
                        }
                    ],
                    "synonyms": [
                        "unplausible"
                    ],
                    "antonyms": [
                        "plausible"
                    ],
                    "common_phrases": [
                        "highly implausible",
                        "seem implausible",
                        "implausible explanation",
                        "implausible scenario"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не кажущийся разумным или вероятным; такой, в который трудно поверить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неправдоподобный",
