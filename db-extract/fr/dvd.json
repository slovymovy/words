                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "a69fe120-ee48-4743-98de-ee90cfcfa033",
                                "sense_id": "5b3ec16b-4e90-3953-bc91-13f32750560c",
                                "text": "Je pris mon café et me lovai dans mon canapé pour regarder un DVD."
                            },
                            {
                                "example_id": "fbce6f02-a7dc-4b02-94ba-b15fac45ba16",
                                "sense_id": "5b3ec16b-4e90-3953-bc91-13f32750560c",
                                "text": "Elle était assise sur le canapé de son salon, son fils à ses côtés, et ils étaient plongés dans un DVD que j'avais du mal à identifier, probablement Le Roi Lion, […]."
                            }
                        ]
                    }
