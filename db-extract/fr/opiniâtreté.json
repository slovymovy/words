                                        "sense_id": "ada8c73e-4b78-3a49-a97a-2bf4f50a59d7",
                                        "entry_id": "5a1fdd51-2805-36ea-afe4-04eb329b09d7",
                                        "glosses": [
                                            "The condition of being relentless."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b4cb5d4-d4e9-4a4c-91e0-76437b4a8abd",
                                                "sense_id": "ada8c73e-4b78-3a49-a97a-2bf4f50a59d7",
                                                "text": "The more I learned about transkids, the more I grilled you, every day. I'm ashamed of my relentlessness, but I had to know.\n“Why do you want to be a boy?”\n“I don't know.”"
                                            }
                                        ]
                                    }
                                ]
