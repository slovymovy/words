                                "target_senses": [
                                    {
                                        "sense_id": "c7348f7d-6dfb-3650-8bed-9f6e0c5896d2",
                                        "entry_id": "637e6e9c-ead2-3127-8111-25ee6165b998",
                                        "glosses": [
                                            "A maker of wooden furniture or fittings."
                                        ],
                                        "tags": [],
