                                        "glosses": [
                                            "Sitzmöbelteil, an den man sich anlehnen oder auf den man sich stützen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12074fcf-cfc3-4ec2-8339-2d0a6c040897",
                                                "sense_id": "8ca84eb1-7da2-3ce1-a6a2-00fab57e906b",
                                                "text": "Die Lehne eines Fahrersitzes kann man in der Regel verstellen."
                                            },
                                            {
                                                "example_id": "96dcd4a0-f94c-46d1-87b4-4d354f2d44c5",
                                                "sense_id": "8ca84eb1-7da2-3ce1-a6a2-00fab57e906b",
                                                "text": "„Über der hohen Lehne des Bürostuhls leuchtete im Halbdunkel ihr helles Haar.“"
                                            },
                                            {
                                                "example_id": "fbe7a59d-0970-4933-ac84-6fce0aaa2bf9",
                                                "sense_id": "8ca84eb1-7da2-3ce1-a6a2-00fab57e906b",
                                                "text": "„Schliesslich setzte der Reisende sich in einem abgetragenen, mit Nanking überzogenen Schafspelz, Filzstiefel an den mageren, knochigen Beinen, auf den Diwan, legte seinen sehr grossen, an den Schläfen auffallend breiten, kurzgeschorenen Kopf gegen die Lehne und sah jetzt Besuchow an.“"
                                            }
                                        ],
