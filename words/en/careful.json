    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "948a181f-5d71-3030-904d-f3ff638bc0eb",
                    "sense_definition": "Taking care and being attentive to potential danger, error, or harm.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cautious behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a slow and <w>careful</w> driver who never exceeded the speed limit.",
                            "target_lang_translations": {
                                "ru": "Он был медленным и <w>осторожным</w> водителем, который никогда не превышал скорость."
                            }
                        },
                        {
                            "text": "Please be <w>careful</w> with that glass vase because it is very fragile.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, будь <w>осторожен</w> с этой стеклянной вазой, потому что она очень хрупкая."
                            }
                        }
                    ],
                    "antonyms": [
                        "careless"
                    ],
                    "common_phrases": [
                        "be careful",
                        "careful driver",
                        "careful consideration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий осторожность и внимание к потенциальной опасности, ошибкам или вреду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осторожный",
                                "target_lang_sense_clarification": "избегающий опасности"
                            },
                            {
                                "target_lang_word": "внимательный",
                                "target_lang_sense_clarification": "сосредоточенный на деталях"
                            },
                            {
                                "target_lang_word": "аккуратный",
                                "target_lang_sense_clarification": "действующий с осторожностью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4053de15-ad97-3153-838c-d8cce94f09fd",
                    "sense_definition": "Showing great attention to detail; thorough and meticulous in one's work or thoughts.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "thoroughness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police made a <w>careful</w> search of the room to find any hidden evidence.",
                            "target_lang_translations": {
                                "ru": "Полиция провела <w>тщательный</w> обыск комнаты, чтобы найти любые скрытые улики."
                            }
                        },
                        {
                            "text": "After a <w>careful</w> analysis of the data, the scientists published their findings.",
                            "target_lang_translations": {
                                "ru": "После <w>тщательного</w> анализа данных ученые опубликовали свои результаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "deliberate",
                        "thorough",
                        "detailed"
                    ],
                    "antonyms": [
                        "careless"
                    ],
                    "common_phrases": [
                        "careful analysis",
                        "careful planning",
                        "careful study"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий большое внимание к деталям; тщательный и дотошный в работе или мыслях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тщательный",
                                "target_lang_sense_clarification": "очень детальный"
                            },
                            {
                                "target_lang_word": "аккуратный",
                                "target_lang_sense_clarification": "опрятный и точный"
                            },
                            {
                                "target_lang_word": "старательный",
                                "target_lang_sense_clarification": "прикладывающий усилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a34876b7-9720-35d3-80a9-886b140dbba3",
                    "sense_definition": "Full of cares, anxiety, or worry; troubled in mind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotional state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man had a <w>careful</w> look on his face as he contemplated the future.",
                            "target_lang_translations": {
                                "ru": "У старика был <w>озабоченный</w> вид, когда он размышлял о будущем."
                            }
                        },
                        {
                            "text": "She spent many <w>careful</w> nights worrying about the safety of her family.",
                            "target_lang_translations": {
                                "ru": "Она провела много <w>тревожных</w> ночей, беспокоясь о безопасности своей семьи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean full of anxiety"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный забот, тревоги или беспокойства; встревоженный (архаичное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озабоченный",
                                "target_lang_sense_clarification": "полный тревоги"
                            },
                            {
                                "target_lang_word": "встревоженный",
                                "target_lang_sense_clarification": "беспокойный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c3f5b5c-0245-3a6b-8a41-221f1512b687",
                    "sense_definition": "Full of grief or sorrow; feeling sad.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotional state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet described the <w>careful</w> soul of the widow mourning her lost husband.",
                            "target_lang_translations": {
                                "ru": "Поэт описал <w>скорбную</w> душу вдовы, оплакивающей своего потерянного мужа."
                            }
                        },
                        {
                            "text": "His <w>careful</w> heart could find no joy in the festivities around him.",
                            "target_lang_translations": {
                                "ru": "Его <w>печальное</w> сердце не могло найти радости в окружающих его празднествах."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historically used to describe a state of sorrow"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный горя или печали; чувствующий грусть (архаичное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "печальный",
                                "target_lang_sense_clarification": "полный скорби"
                            },
                            {
                                "target_lang_word": "скорбный",
                                "target_lang_sense_clarification": "выражающий горе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
