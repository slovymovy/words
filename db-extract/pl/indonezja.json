                    {
                        "translation_id": "24a59cf4-85b4-4579-a203-56e5017149f3",
                        "source_entry_id": "3d6c47bf-259d-3f72-a06d-7ef300e445c0",
                        "source_sense_id": "5a81fad2-d494-300c-92f6-406496f2c542",
                        "target_lang_word": "Indonésie",
