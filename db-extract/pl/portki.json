                                "example_id": "75e5d315-91c0-4105-90b7-5b1a80f5414d",
                                "sense_id": "8bcb8df5-30bc-3803-8ad8-ae4000eba98d",
                                "text": "Ubieraj portki i wyłaź stąd w końcu!"
                            }
                        ],
