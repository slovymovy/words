                ],
                "senses": [
                    {
                        "sense_id": "f6f3465d-4de6-39a3-ba1a-7a045ba09f79",
                        "entry_id": "39dc3deb-ef05-380a-871c-160204798b71",
                        "glosses": [
                            "einfach gestaltetes Haus oder abgeteilter Bereich in einem Gotteshaus, der für die zeremonielle Aufbahrung von Leichen genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ed382a-92a2-41ea-bdbf-e7b1e6b8d7a6",
                                "sense_id": "f6f3465d-4de6-39a3-ba1a-7a045ba09f79",
                                "text": "„Der Friedhof mit neuer Leichenkapelle auf der Nordseite der Kirche.“"
                            },
                            {
                                "example_id": "f827741d-77c6-450f-86f5-3f9f6d42cdda",
                                "sense_id": "f6f3465d-4de6-39a3-ba1a-7a045ba09f79",
                                "text": "„Die Träger holen das Kreuz und die Fahne nach der Kommunion in der Leichenkapelle und stellen sich im Kreuzgang auf.“"
                            },
                            {
                                "example_id": "ffc2a6ad-6707-46b4-bc73-3fe2323b75e1",
                                "sense_id": "f6f3465d-4de6-39a3-ba1a-7a045ba09f79",
                                "text": "„Über den Bau einer neuen Kirche und einer Leichenkapelle sowie über die Erweiterung des Friedhofs wird in der Gemeinde Plaus schon seit Jahren diskutiert.“"
                            },
                            {
                                "example_id": "36269d34-d212-48f8-80be-66ba46c936cc",
                                "sense_id": "f6f3465d-4de6-39a3-ba1a-7a045ba09f79",
                                "text": "„Letzterer hat besonders dazu beigetragen, Einheimischen wie Besuchern christliches Gedanken- und Kulturgut durch die künstlerische Gestaltung z. B. des Rosenkranzweges, der Leichenkapelle, verschiedener Grabstätten zu vermitteln.“"
                            },
                            {
                                "example_id": "b6720411-c03e-45c5-b941-5ff544476e06",
                                "sense_id": "f6f3465d-4de6-39a3-ba1a-7a045ba09f79",
                                "text": "„Als Leichenkapelle dient die Sebastianskapelle auf dem alten Friedhof.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
