                                        "sense_id": "e9bccb18-f5c2-3ba8-821f-4da9261f32de",
                                        "entry_id": "e7b141ad-7b10-3fcc-98c6-ed83a4210233",
                                        "glosses": [
                                            "A large backside, especially a woman's."
                                        ],
                                        "tags": [
