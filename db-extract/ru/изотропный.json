                    },
                    {
                        "translation_id": "34fde761-bb88-4451-8c59-12d0a636767b",
                        "source_entry_id": "a4bc95bf-57ea-32c4-8599-779c9309c32f",
                        "source_sense_id": "6880ba70-1511-3529-bf12-90e1a4272212",
                        "target_lang_word": "isotrop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isotrop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ca9264d-9c25-3527-98aa-f4167282c863",
                                        "entry_id": "8a850d03-9f6c-3efd-b439-97f6c00badde",
                                        "glosses": [
                                            "in alle Richtungen gleiche Eigenschaften besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "570ef123-d3b6-49b7-aa83-b2ac641159f1",
                                                "sense_id": "1ca9264d-9c25-3527-98aa-f4167282c863",
                                                "text": "„In der Physik ist Materie auf atomarer Ebene grundsätzlich nicht isotrop.“"
                                            },
                                            {
                                                "example_id": "9e945684-3d0a-496d-8405-cc18de1b6cfa",
                                                "sense_id": "1ca9264d-9c25-3527-98aa-f4167282c863",
                                                "text": "„Warum also ist das Universum so homogen und isotrop auf großen Skalen und hat dennoch lokale Irregularitäten wie Galaxien und Sterne?“"
                                            },
                                            {
                                                "example_id": "e470c7e6-4d20-4075-9155-fa647b9b2b5a",
                                                "sense_id": "1ca9264d-9c25-3527-98aa-f4167282c863",
                                                "text": "„Angenommen, das Universum ist homogen und isotrop, also überall und in alle Richtungen gleichförmig, so gilt diese Aussage auch unabhängig von der Wahl eines gegebenen Zeitpunktes und Ortes.“"
                                            },
                                            {
                                                "example_id": "4e8484c4-fb75-4332-81a9-496b49cfd0cc",
                                                "sense_id": "1ca9264d-9c25-3527-98aa-f4167282c863",
                                                "text": "„Die so hergestellte Faser erwies sich im Gegensatz zu normalen Kunstfasern als vollkommen isotrop, sie gleicht in dieser Beziehung also einem Zellulosefilm.“"
                                            },
                                            {
                                                "example_id": "0b2e17f7-7241-4dbc-8706-3c6010249c16",
                                                "sense_id": "1ca9264d-9c25-3527-98aa-f4167282c863",
                                                "text": "„Die Zellwände können also aus zwei verschiedenen Gründen in bestimmten Richtungen isotrop erscheinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
