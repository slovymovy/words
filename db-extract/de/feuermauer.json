                "senses": [
                    {
                        "sense_id": "9c15fd0c-0def-3d5c-a687-6289c1061310",
                        "entry_id": "967a42f5-3644-35c9-9237-6f175e24dba9",
                        "glosses": [
                            "feuerfeste Schutzmauer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fe923fd-427d-4e56-9cdb-fcaf94fa7143",
                                "sense_id": "9c15fd0c-0def-3d5c-a687-6289c1061310",
                                "text": "„In einem gemauerten Gebäude mit einer Länge von mindestens 25 Meter ist der Dachboden mittels einer Feuermauer zu teilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7020c4eb-6976-316b-bfb5-d0c167a5569a",
                        "entry_id": "967a42f5-3644-35c9-9237-6f175e24dba9",
                        "glosses": [
                            "Schornstein oder Schlot"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6d80de0a-534e-495f-a0cd-694213c7d018",
                                "sense_id": "7020c4eb-6976-316b-bfb5-d0c167a5569a",
                                "text": "„Die Feuermauern sollten auf den Dörfern, wo wegen des Viehes stark gefeuert werden muß, und wo keine Ziegeldächer gehalten werden können, alle von Grund aus gemauert seyn, und auch hoch über die Fürsten hinaus geführet werden.“ (1802)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
