                                            {
                                                "example_id": "16fed58e-9275-4966-bc91-f686a044cf8f",
                                                "sense_id": "b293d302-d6fd-3479-9920-47fd4cd64ffd",
                                                "text": "Końca dobiegła piąta kadencja samorządu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
                                        "sense_id": "9d3988eb-de50-3242-9d99-1b21960d1e13",
                                        "entry_id": "1392cfca-41d9-3cd0-b2a7-5b27fd73f56a",
                                        "glosses": [
                                            "o człowieku: osiągnąć jakiś wiek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c7931f-30ca-4ec8-a8b2-3cce8c18ee68",
                                                "sense_id": "9d3988eb-de50-3242-9d99-1b21960d1e13",
                                                "text": "Gdy dobiegł czterdziestki, był już ministrem, potem dyrektorem koncernu, wreszcie mianowano go lordem."
