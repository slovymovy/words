                                "target_senses": [
                                    {
                                        "sense_id": "95fb9e75-7bf3-3d50-a2b6-2151934ca9a6",
                                        "entry_id": "a00cc6dc-e347-37aa-8170-3b12cfb19ff5",
                                        "glosses": [
                                            "A medicine which preserves or defends against disease; a preventive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10df3ed3-0449-3dc5-8694-78d5e1a2a5cf",
                                        "entry_id": "a00cc6dc-e347-37aa-8170-3b12cfb19ff5",
                                        "glosses": [
                                            "A medicine which preserves or defends against disease; a preventive.",
                                            "A prophylactic condom."
                                        ],
                                        "tags": [
                                            "US",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec09ff8a-57b4-4102-8a82-43a899158a2c",
                                                "sense_id": "10df3ed3-0449-3dc5-8694-78d5e1a2a5cf",
                                                "text": "It is not clear whether such education is to be directed to homosexuals (for whom prophylactics are not a contraceptive) or to heterosexuals as well (for whom prophylactics are a contraceptive)."
                                            },
                                            {
                                                "example_id": "c6eb1f46-f0ab-4182-a35a-4b4d5813c520",
                                                "sense_id": "10df3ed3-0449-3dc5-8694-78d5e1a2a5cf",
                                                "text": "Given the widespread use of coitus interruptus and male prophylactics as contraceptive practices in France […]"
                                            },
                                            {
                                                "example_id": "394e7242-d460-4525-815b-8baa2f663fc3",
                                                "sense_id": "10df3ed3-0449-3dc5-8694-78d5e1a2a5cf",
                                                "text": "Some men put the prophylactic on just the tip of the penis: this is a mistake, because the prophylactic will come off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae5be3cc-6a48-358f-b97e-196379fd5a37",
                                        "entry_id": "a00cc6dc-e347-37aa-8170-3b12cfb19ff5",
                                        "glosses": [
                                            "Any device or mechanism intended to prevent harmful consequences."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc7544f9-3079-440e-b16f-3f3f22efb4b3",
                                                "sense_id": "ae5be3cc-6a48-358f-b97e-196379fd5a37",
                                                "text": "The securities laws are a prophylactic against stock fraud."
                                            },
                                            {
                                                "example_id": "6d34789a-bd79-4dd5-89ee-9b0f2062c1ab",
                                                "sense_id": "ae5be3cc-6a48-358f-b97e-196379fd5a37",
                                                "text": "Since tere are increasingly powerful anti-free speech tendencies in the left in general and in the Lesbian and Gay movements in particular in the form of the antiporn movement and other tendencies, I will quote extensively from the second chapter of On Liberty, \"On The Liberty Of Thought And Discussion,\" as a valuable and much needed prophylactic to these trends."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prophylactic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
