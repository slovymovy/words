                                        "sense_id": "be5eaed2-ed5d-3639-990e-2995cd613f4f",
                                        "entry_id": "3cf4674f-5868-3425-b643-355a3b1d03b7",
                                        "glosses": [
                                            "Fête chrétienne qui commémore l’entrée de Jésus-Christ à Jérusalem sur un âne, peu avant sa mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5325044f-05ea-4689-ac00-1e8f469de75e",
                                                "sense_id": "be5eaed2-ed5d-3639-990e-2995cd613f4f",
                                                "text": "Au temps où il combattit pour le pouvoir, le bourgeois se passa de son âme : […]. Le 14 Juillet n’est pour lui qu’un symbole du temps, comme Pâques, comme la Nativité, le dimanche des Rameaux. Le commencement des vacances."
                                            },
                                            {
                                                "example_id": "fedc6035-95b6-43a3-ace1-e713e1e062ab",
                                                "sense_id": "be5eaed2-ed5d-3639-990e-2995cd613f4f",
                                                "text": "Là, tous les ans, au dimanche des Rameaux, l’évêque montait en chaire et il haranguait les fidèles rassemblés dans la Cathédrale."
                                            }
                                        ]
                                    }
                                ]
                            }
