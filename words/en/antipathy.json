{
    "word_family": [
        "antipathetic",
        "antipathetically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c08a70e8-fbf0-32eb-9a71-d44a7e2b135b",
                    "sense_definition": "A strong, often irrational feeling of dislike, aversion, or hostility toward someone or something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dislike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a deep <w>antipathy</w> toward his new manager from the very first day.",
                            "target_lang_translations": {
                                "zh": "从第一天起，他就对新经理产生了深深的<w>反感</w>。"
                            }
                        },
                        {
                            "text": "Despite their shared goals, a personal <w>antipathy</w> prevented them from working together effectively.",
                            "target_lang_translations": {
                                "zh": "尽管目标一致，但个人的<w>厌恶</w>情绪使他们无法有效地合作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hatred",
                        "ill feeling",
                        "ill will",
                        "opposition"
                    ],
                    "antonyms": [
                        "sympathy"
                    ],
                    "common_phrases": [
                        "deep antipathy",
                        "natural antipathy"
                    ],
                    "target_lang_definitions": {
                        "zh": "对某人或某事强烈的、通常是不理性的厌恶、反感或敌意。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "反感",
                                "target_lang_sense_clarification": "指对人或事产生的不满或厌恶情绪。"
                            },
                            {
                                "target_lang_word": "厌恶",
                                "target_lang_sense_clarification": "指极度不喜欢，带有强烈的排斥感。"
                            },
                            {
                                "target_lang_word": "敌意",
                                "target_lang_sense_clarification": "指怀有敌对的态度或心理。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efd15b90-ec9a-3d16-9f18-38e0beb90d21",
                    "sense_definition": "A natural incompatibility or opposition between two things that causes them to negatively affect each other.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "incompatibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemical <w>antipathy</w> between these two substances causes them to react violently when mixed.",
                            "target_lang_translations": {
                                "zh": "这两种物质之间存在化学上的<w>不相容</w>，混合时会发生剧烈反应。"
                            }
                        },
                        {
                            "text": "There is a fundamental <w>antipathy</w> between the two materials that makes them impossible to bond.",
                            "target_lang_translations": {
                                "zh": "这两种材料之间存在根本性的<w>对立</w>，导致它们无法粘合在一起。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contrariety",
                        "opposition"
                    ],
                    "common_phrases": [
                        "natural antipathy"
                    ],
                    "target_lang_definitions": {
                        "zh": "两种事物之间天然的不相容或对立，导致它们相互产生负面影响。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不相容",
                                "target_lang_sense_clarification": "指事物之间无法共存或相互排斥。"
                            },
                            {
                                "target_lang_word": "对立",
                                "target_lang_sense_clarification": "指两种事物性质相反，处于冲突状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3ca1edd-ff0f-3845-92df-f5be5f14bf94",
                    "sense_definition": "A person or thing that is the object of intense dislike or repugnance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "dislike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Public speaking was one of his greatest <w>antipathies</w> during his time at university.",
                            "target_lang_translations": {
                                "zh": "大学期间，公开演讲是他最<w>厌恶</w>的事情之一。"
                            }
                        },
                        {
                            "text": "The loud noise from the construction site became one of her main <w>antipathies</w>.",
                            "target_lang_translations": {
                                "zh": "建筑工地的巨大噪音成了她最<w>厌恶</w>的东西之一。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disgust"
                    ],
                    "target_lang_definitions": {
                        "zh": "被强烈厌恶或反感的人或事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "厌恶之物",
                                "target_lang_sense_clarification": "指引起强烈反感的事物。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}