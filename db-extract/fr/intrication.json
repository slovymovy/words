                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ca806db-e197-4819-a9d9-1c58840a947e",
                                                "sense_id": "fad75319-5f15-3de5-a26c-e59880f53166",
                                                "text": "In his article, Bell demonstrated that quantum theory requires entanglement; the strange connectedness is an inescapable feature of the equations."
                                            }
