                                        "entry_id": "42c9de7d-8b7e-3052-86d9-3ce81e003766",
                                        "glosses": [
                                            "Runenzeichen auf Buchenstäbchen einritzen (später auch schreiben, zeichnen)"
                                        ],
                                        "tags": [
                                            "ursprünglich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e73ea0cb-33a5-48c0-84d8-e14e3ec2516d",
                                                "sense_id": "a563d60d-0cef-35ef-a407-27d461269975",
