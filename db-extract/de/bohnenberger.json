                "senses": [
                    {
                        "sense_id": "aa747dcb-f19e-3299-9143-5540758cbabb",
                        "entry_id": "3c22969e-b838-3997-924c-db0a7120b4d5",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ebbae0d-e0d9-4365-8afb-90c588b9bd47",
                                "sense_id": "aa747dcb-f19e-3299-9143-5540758cbabb",
                                "text": "Frau Bohnenberger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "423372d1-2b2c-4861-a719-71821ee7a11b",
                                "sense_id": "aa747dcb-f19e-3299-9143-5540758cbabb",
                                "text": "Herr Bohnenberger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b47fe386-b218-467a-931e-a331ea6cb282",
                                "sense_id": "aa747dcb-f19e-3299-9143-5540758cbabb",
                                "text": "Die Bohnenbergers fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "a69e7a90-8ca4-4314-be9c-93d0bb15917e",
                                "sense_id": "aa747dcb-f19e-3299-9143-5540758cbabb",
                                "text": "Der Bohnenberger trägt nie die Pullover, die die Bohnenberger ihm strickt."
                            },
                            {
                                "example_id": "117ce6d6-8be7-4a5d-902e-297c766030c2",
                                "sense_id": "aa747dcb-f19e-3299-9143-5540758cbabb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bohnenberger kommt, geht der Herr Bohnenberger.“"
                            },
                            {
                                "example_id": "3c2286d0-4cca-4956-965e-0867c7d7509d",
                                "sense_id": "aa747dcb-f19e-3299-9143-5540758cbabb",
                                "text": "Bohnenberger kommt und geht."
                            },
                            {
                                "example_id": "974489c6-52a9-4d3a-8b36-69cbcd27e0c5",
                                "sense_id": "aa747dcb-f19e-3299-9143-5540758cbabb",
                                "text": "Bohnenbergers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
