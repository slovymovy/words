                "senses": [
                    {
                        "sense_id": "f2185b60-6f67-3e8a-9a94-cacfd2fb4d29",
                        "entry_id": "219e6400-408c-30c3-97f0-d93c426ba7b6",
                        "glosses": [
                            "Behörde, deren Aufgabe es ist, gewisse Ordnungswidrigkeiten zu verfolgen, die keine Straftat sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1559432-9de9-4334-9d4f-436538dedca1",
                                "sense_id": "f2185b60-6f67-3e8a-9a94-cacfd2fb4d29",
                                "text": "„Die Verfolgungsbehörden kennen die umständlich formulierte Kategorie \"Gewalttaten mit extremistischem Hintergrund aus dem Bereich ›Politisch motivierte Kriminalität – rechts‹\". Seit Jahren liegen dort die Ostländer an der Spitze.“"
                            },
                            {
                                "example_id": "6e3e0ebf-9050-4cfd-b8e6-533d83694555",
                                "sense_id": "f2185b60-6f67-3e8a-9a94-cacfd2fb4d29",
                                "text": "„Für den Sprecher der Verfolgungsbehörde steht jedoch außer Frage, dass in diesem Fall ein Tötungsdelikt vorliegt: „Sonst wäre die Leiche nicht mit so viel Aufwand verpackt und dann verscharrt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
