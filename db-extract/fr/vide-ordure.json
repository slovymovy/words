                "senses": [
                    {
                        "sense_id": "a6ee4388-f2c4-3032-811e-91cfa4579d0e",
                        "entry_id": "d5254fba-f0ed-3590-b47d-02adbdf69c14",
                        "glosses": [
                            "Dispositif pour évacuer les déchets ménagers dans un conduit vertical qui débouche sur une benne à ordures centrale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aa8e3d6-0a29-419a-95b0-eaaaed02fea0",
                                "sense_id": "a6ee4388-f2c4-3032-811e-91cfa4579d0e",
                                "text": "Et tout ça, zou! Çs file au vide-ordure…"
                            },
                            {
                                "example_id": "fdfd18ff-e93f-4acf-abb7-4bc2090411f5",
                                "sense_id": "a6ee4388-f2c4-3032-811e-91cfa4579d0e",
                                "text": "Il prit dans son sac une bouteille de lait en plastique et ouvrit le vide-ordure pour l’y jeter. A ce moment s’échappa de l’orifice, comme amplifiée par un haut-parleur, la voix de Maria Callas dans un air de l’Alceste de Gluck, Divinité du Styx."
                            },
                            {
                                "example_id": "a97fdb3b-48f0-43c3-b3e0-c14e2be01247",
                                "sense_id": "a6ee4388-f2c4-3032-811e-91cfa4579d0e",
                                "text": "Bien des gens finissent par manger à côté du vide-ordure en tirant régulièrement sur la porte pour balancer ce qui serait susceptible de rester dans leurs assiettes. L’erreur est parfois fatale puisque des objets indispensables échouent dans les poubelles en émettant d’ailleurs des bruits qui préviennent les habitants des lieux. Car le vide-ordure est, pour ainsi dire, un instrument de communication-évacuation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fba2818-8026-4216-a370-ade8acd4db04",
                        "source_entry_id": "d5254fba-f0ed-3590-b47d-02adbdf69c14",
                        "source_sense_id": "a6ee4388-f2c4-3032-811e-91cfa4579d0e",
                        "target_lang_word": "Müllschlucker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Müllschlucker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b8dc543-bd49-3123-b5a8-862ab3808d6b",
                                        "entry_id": "af7db425-76b3-3664-971c-06151bc517de",
                                        "glosses": [
                                            "Mülleinwurf in einer Gebäudeetage an einem senkrechten Müllabwurfschacht, mit Klappe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f14c1872-1033-4474-b11d-3ea892176d39",
                                                "sense_id": "4b8dc543-bd49-3123-b5a8-862ab3808d6b",
                                                "text": "Gerade in Hochhäusern gibt es oftmals, direkt neben dem Fahrstuhl, einen Müllschluckerraum mit einem Müllschlucker in den man wahllos seinen Hausmüll einwerfen konnte."
                                            },
                                            {
                                                "example_id": "e4c5e3bb-2ae4-4a03-8b24-642ff5bc51a1",
                                                "sense_id": "4b8dc543-bd49-3123-b5a8-862ab3808d6b",
                                                "text": "„Für die damalige Zeit sei es eine sehr moderne und gut ausgestattete Wohnung gewesen, mit einer Sprechanlage und mit einem Müllschlucker.“"
                                            },
                                            {
                                                "example_id": "941bc45f-4852-43d6-899b-28062b1aa493",
                                                "sense_id": "4b8dc543-bd49-3123-b5a8-862ab3808d6b",
                                                "text": "„Während Elenas Landsleute absurde EU-Verordnungen fein säuberlich abheften, um sie dann in den Müllschlucker zu werfen, werden sie bei uns rigoros befolgt.“"
                                            },
                                            {
                                                "example_id": "44c80eb3-26ed-41f3-b617-0e78791f6304",
                                                "sense_id": "4b8dc543-bd49-3123-b5a8-862ab3808d6b",
                                                "text": "„Schließlich schnitt er ihr den Kehlkopf heraus und warf diesen in den Müllschlucker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
