    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cbdffaa1-2587-327d-8179-cd9cc6f8798f",
                    "sense_definition": "Bijou ou ornement que l'on porte autour du poignet ou du bras.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bijou",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a reçu un magnifique <w>bracelet</w> en argent pour son anniversaire."
                        },
                        {
                            "text": "Il préfère porter un <w>bracelet</w> en cuir fin à son poignet gauche."
                        }
                    ],
                    "synonyms": [
                        "gourmette",
                        "jonc"
                    ],
                    "common_phrases": [
                        "bracelet en argent",
                        "bracelet en or",
                        "porter un bracelet"
                    ]
                },
                {
                    "sense_id": "5d9887c3-272a-349a-a358-05411e838738",
                    "sense_definition": "Bande attachée au poignet pour permettre l'identification, l'accès ou la surveillance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dispositif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'entrée du festival, les organisateurs ont vérifié mon <w>bracelet</w> d'accès."
                        },
                        {
                            "text": "Le patient hospitalisé doit garder son <w>bracelet</w> d'identification jusqu'à sa sortie."
                        }
                    ],
                    "common_phrases": [
                        "bracelet électronique",
                        "bracelet d'identification"
                    ]
                },
                {
                    "sense_id": "39dc2d39-bd2b-33d3-8a4c-a775277f90ac",
                    "sense_definition": "Bandeau élastique ou anneau de matière souple servant à maintenir plusieurs objets ensemble.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attache",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a regroupé les enveloppes avec un <w>bracelet</w> en caoutchouc pour ne rien égarer."
                        },
                        {
                            "text": "Le facteur maintient les lettres grâce à un large <w>bracelet</w> élastique."
                        }
                    ],
                    "synonyms": [
                        "élastique"
                    ],
                    "common_phrases": [
                        "bracelet en caoutchouc",
                        "bracelet élastique"
                    ]
                },
                {
                    "sense_id": "51d71ba3-c7c6-3aa5-9679-4df6c0d863e0",
                    "sense_definition": "Paire d'anneaux métalliques fixés aux poignets d'une personne arrêtée pour l'entraver.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "entrave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les policiers ont fini par lui passer les <w>bracelets</w> avant de l'emmener au poste."
                        },
                        {
                            "text": "Le suspect a été conduit devant le juge avec les <w>bracelets</w> aux mains."
