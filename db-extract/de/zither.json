                    {
                        "form_id": "2e5b8a4a-36be-4cf5-8c53-d5f1ca6d6852",
                        "entry_id": "d0e0b02f-f3e6-3644-b3f3-e830d47b3c2f",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Zither"
                    },
                    {
                        "form_id": "7386fa81-8aea-42eb-bc42-55418af0ee1c",
                        "entry_id": "d0e0b02f-f3e6-3644-b3f3-e830d47b3c2f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zithern"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                        "entry_id": "d0e0b02f-f3e6-3644-b3f3-e830d47b3c2f",
                        "glosses": [
                            "Saiteninstrument, dessen Saiten mit beiden Händen gezupft werden"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "2c50f298-ef18-4698-b9aa-9e751ed64515",
                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                "text": "In der alpenländischen Volksmusik wird oft die Zither gespielt."
                            },
                            {
                                "example_id": "dec7a981-6130-4004-b379-398949becddb",
                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                "text": "„Meine Mutter wachte über das Wohlergehen der Zither strenger als über das Wohlergehen ihrer Nähmaschine.“"
                            },
                            {
                                "example_id": "96c0fdd0-4e40-452e-be33-dd5a0159d6cd",
                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                "text": "„Als die Truppe abgetreten war, spielten und sangen die beiden Musiker Li Ming und Wu Hwe, der eine zur Zither, der andere zur Laute.“"
                            },
                            {
                                "example_id": "ecb0ac50-fd31-45aa-8f57-c2544584047a",
                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                "text": "„Ein Mädchen spielte Zither darauf, und ein Jäger beugte sich über sie.“"
                            },
                            {
                                "example_id": "3e8d6689-91a9-4d5c-b126-0e04d3670009",
                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                "text": "„In einem kleinen Café, in dem eine alte Frau Zither spielte, bestellten wir Wein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7d47633-b228-4042-b91c-e5d2eb1d0be8",
                        "source_entry_id": "d0e0b02f-f3e6-3644-b3f3-e830d47b3c2f",
                        "source_sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                        "source_sense_description": "Musik: Saiteninstrument, dessen Saiten mit beiden Händen gezupft werden",
                        "target_lang_word": "zither",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bb0b23f-0700-379a-a0a9-ec5d87e4a524",
                                        "entry_id": "29290c43-bf78-3efe-b520-516897567b28",
                                        "glosses": [
                                            "A musical instrument consisting of a flat sounding box with numerous strings placed on a horizontal surface, played with a plectrum or fingertips."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb1fdaa9-119c-3fc2-bb78-3e5eb82e59c4",
                                        "entry_id": "29290c43-bf78-3efe-b520-516897567b28",
                                        "glosses": [
                                            "Related or similar instruments in other cultures, such as the Chinese guqin or Norwegian harpeleik; especially any chordophone without a neck, and with strings that pass over the body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "zither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "962f95ed-ef30-3a4a-8327-a7108f5cc9d9",
                                        "entry_id": "bc50e7c5-e121-3750-a40e-e0c6eda7a328",
                                        "glosses": [
                                            "To play a zither."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ba09dca-a89e-490a-b591-f5cf0dafc832",
                                                "sense_id": "962f95ed-ef30-3a4a-8327-a7108f5cc9d9",
                                                "text": "[…] the fluting began again. Not alone this time, but, to Rosalie’s infinite surprise, accompanied on a zither. […] At this moment the fluting and zithering began again."
                                            },
                                            {
                                                "example_id": "a1490452-bfbc-47f8-97cd-b42784d50a53",
                                                "sense_id": "962f95ed-ef30-3a4a-8327-a7108f5cc9d9",
                                                "text": "We wandered and fiddled and zithered and tambourined through France till the chills and rains of autumn rendered our vagabondage less merry."
                                            },
                                            {
                                                "example_id": "ae7b8fee-3d82-4286-b130-f845f730148d",
                                                "sense_id": "962f95ed-ef30-3a4a-8327-a7108f5cc9d9",
                                                "text": "1999, Richard Hacken (translator), “Mary in Misery” by Peter Rosegger in Into the Sunset: Anthology of Nineteenth-Century Austrian Prose, Riverside, CA: Ariadne Press, pp. 413-414,\nWe traveled far and wide: he played the zither while I sang an accompaniment. […] He keeps zithering, and I sing like before, and before long we’ve put together a pretty good pile of money . . ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06073616-c2ea-371e-b21e-f79c26721ba1",
                                        "entry_id": "bc50e7c5-e121-3750-a40e-e0c6eda7a328",
                                        "glosses": [
                                            "To make a sound similar to that made by a zither; to move while making such a sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b4e7e04-8d89-4168-9fe2-f3572755bfb4",
                                                "sense_id": "06073616-c2ea-371e-b21e-f79c26721ba1",
                                                "text": "c. 1890, May Ostlere, Dead! London: Trischler, Chapter 3, p. 76,\nNow [the wind] swithered through the badly-fixed windows, making zithering sounds as of an army of cold and frozen-out mosquitoes […]"
                                            },
                                            {
                                                "example_id": "a051fac1-4ad6-40b3-8ad7-8c91b3a188d6",
                                                "sense_id": "06073616-c2ea-371e-b21e-f79c26721ba1",
                                                "text": "The olives seemed weighed down under the weight of their fruit, smooth drops of green jade among which the choirs of cicadas zithered."
                                            },
                                            {
                                                "example_id": "af4be5b5-0f25-4c88-a2bc-19e1cd453763",
                                                "sense_id": "06073616-c2ea-371e-b21e-f79c26721ba1",
                                                "text": "Once I owned a bike […] It had no fenders and one gear only, and on the forks, both fore and aft, I clipped some plastic playing cards to zither loudly through the spokes."
                                            },
                                            {
                                                "example_id": "a2965477-6d63-42bc-a9a1-1345d080ca3e",
                                                "sense_id": "06073616-c2ea-371e-b21e-f79c26721ba1",
                                                "text": "‘Look at that!’ she shouted, already backing up the Jeep, its tyres zithering on the crusty surface."
                                            },
                                            {
                                                "example_id": "7885bfc3-52c1-4c2d-a891-82b4693748b5",
                                                "sense_id": "06073616-c2ea-371e-b21e-f79c26721ba1",
                                                "text": "The other men opened fire with pistols, slugs zithering past him with a dull whine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fae4984-dad9-45c0-8cef-8ca66881cf01",
                        "source_entry_id": "d0e0b02f-f3e6-3644-b3f3-e830d47b3c2f",
                        "source_sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                        "source_sense_description": "Musik: Saiteninstrument, dessen Saiten mit beiden Händen gezupft werden",
                        "target_lang_word": "cithare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cithare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "534da412-3325-31f5-9d0e-0cc2831c0e33",
                                        "entry_id": "c3bab1fb-087c-346a-9d2f-aa4e6e677847",
                                        "glosses": [
                                            "Instrument à corde pincées qui vibrent à vide, dérivé de la lyre."
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10f229b1-e544-4d5b-b5b1-67a95ba5a4f7",
                                                "sense_id": "534da412-3325-31f5-9d0e-0cc2831c0e33",
                                                "text": "La cithare est un des instruments les plus pauvres, les moins expressifs qu’on puisse imaginer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2fa321-50c0-3f4e-9d00-3f7eeabf25a6",
                                        "entry_id": "c3bab1fb-087c-346a-9d2f-aa4e6e677847",
                                        "glosses": [
                                            "(sens moderne) Instrument de musique fort usité dans l’Antiquité, composé d’une sorte de caisse sur la face antérieure de laquelle sont fixées des cordes rattachées au sommet."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3096973-e0b7-44fa-a981-caaa095da3ec",
                                                "sense_id": "ca2fa321-50c0-3f4e-9d00-3f7eeabf25a6",
                                                "text": "A côté de ces pseudolyres, de ces cithares, si l'on préfère les désigner sous ce nom, qui rappelle mieux leur origine, il existait encore dans les Gaules des harpes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c096d5b-782c-3346-a00f-3ad5a887e49c",
                                        "entry_id": "c3bab1fb-087c-346a-9d2f-aa4e6e677847",
                                        "glosses": [
                                            "Instrument de musique traditionnel chinois à cordes pincées, appelé qin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0da04f1f-8126-4b19-b3c2-85e4f5ab920e",
                                                "sense_id": "7c096d5b-782c-3346-a00f-3ad5a887e49c",
                                                "text": "Le maître de musique Kuang en jouant de la cithare horizontale à sept cordes suscitait les vents et les tonnerres et évoquait les dragons et les seize grues noires qui avaient chacune deux mille ans d’âge."
                                            },
                                            {
                                                "example_id": "41290bef-2675-40ab-a9a3-cfb0aebb449b",
                                                "sense_id": "7c096d5b-782c-3346-a00f-3ad5a887e49c",
                                                "text": "Le nom de la cithare horizontale à sept cordes (qin) se prononce comme un des mots qui désignent génériquement les tabous. D’après les institutions des Anciens, c’est originellement l’instrument dont on use pour entretenir l’essence énergique qui est propre à la vie. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d4d2b8e-e90b-3df0-9bb5-82594ed9454c",
                                        "entry_id": "c3bab1fb-087c-346a-9d2f-aa4e6e677847",
                                        "glosses": [
                                            "Synonyme de fausse limande (poisson)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
