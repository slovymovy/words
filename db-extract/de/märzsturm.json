                ],
                "senses": [
                    {
                        "sense_id": "2f35e4cc-56f9-3d62-a50a-1b0176acfa26",
                        "entry_id": "a830f5b1-1e40-32f5-b31d-47c5d358197d",
                        "glosses": [
                            "im Monat März wehender, kräftiger Sturm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738edf7e-6fb8-475f-a31d-136b7fec1787",
                                "sense_id": "2f35e4cc-56f9-3d62-a50a-1b0176acfa26",
                                "text": "„Er mußte lange draußen im Märzsturm stehen, bis das Mädchen herunterkam und ihm öffnete.“"
                            },
                            {
                                "example_id": "4bc9db95-7ad7-4cb5-b76a-e53234bd2edb",
                                "sense_id": "2f35e4cc-56f9-3d62-a50a-1b0176acfa26",
                                "text": "„Draussen, vor der düster in der Nacht verschwimmenden Riesenhalle, stöhnte der Märzsturm über die weite, stockfinstere märkische Ebene.“"
                            },
                            {
                                "example_id": "3d5d95e0-4536-4de2-91be-228fe4bd8fbf",
                                "sense_id": "2f35e4cc-56f9-3d62-a50a-1b0176acfa26",
                                "text": "„Mochte uns der Märzsturm da droben auf der Höhe packen und zausen, wir schrieen seinem Geheule kräftigst entgegen […].“"
                            },
                            {
                                "example_id": "9a91117e-b56e-4ef3-8aeb-72c9fcfbe94d",
                                "sense_id": "2f35e4cc-56f9-3d62-a50a-1b0176acfa26",
                                "text": "„Die Nacht war sehr unruhig, heulend fuhr der Märzsturm durch die fahlen Bäume, rüttelte an den Ziegeldächern und warf klirrend einige Dachpfannen auf die Straße.“"
                            },
                            {
                                "example_id": "0e5f3faa-70ef-48fa-a704-73407a14cc51",
                                "sense_id": "2f35e4cc-56f9-3d62-a50a-1b0176acfa26",
                                "text": "„Es konnte neun Uhr abends sein, Sonntag, und draußen ein bitterkalter Märzsturm wüten – Alma sprang trotzdem vom Schoß ihres Vaters und rannte los.“"
                            },
                            {
                                "example_id": "d0fa57ed-3980-4d77-ab85-631ccbc36eb6",
                                "sense_id": "2f35e4cc-56f9-3d62-a50a-1b0176acfa26",
                                "text": "„Ein wütender Märzsturm heult um die Balkone des Hotels und drückt gegen die Fenster.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "300abd03-06b2-34c7-9b52-2cfa44b475ee",
                        "entry_id": "a830f5b1-1e40-32f5-b31d-47c5d358197d",
                        "glosses": [
                            "revolutionäre Ereignisse 1848/1849; Märzrevolution"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7efd5fb-254a-4fc7-a052-32f77ab9d606",
                                "sense_id": "300abd03-06b2-34c7-9b52-2cfa44b475ee",
                                "text": "„Die Forderung eines deutschen Parlamentes war daher einer der ersten Wünsche, die das Volk erhob, als der Märzsturm die deutschen Lande durchzog.“"
                            },
                            {
                                "example_id": "f6630ee0-29c0-4ef0-96ef-0b5b3ff4cb7c",
                                "sense_id": "300abd03-06b2-34c7-9b52-2cfa44b475ee",
                                "text": "„Als damals der Märzsturm losbrach, gab es nur zwei große Parteien: eine regierungsfreundliche oder konservative und eine regierungsgegnerische oder liberale, auch oppositionelle oder konstitutionelle genannt.“"
                            },
                            {
                                "example_id": "5362e46b-3e6d-43cb-8b2e-33352ec9b36f",
                                "sense_id": "300abd03-06b2-34c7-9b52-2cfa44b475ee",
                                "text": "„Dies geschieht im Jahre 1848, dessen Märzsturm diese geistlichen Herren und ihr ganzes Erziehungs- und Unterrichtswesen im tiefsten Grunde zittern und wanken gemacht hat.“"
                            },
                            {
                                "example_id": "be40bb33-8cf8-46ac-a6d4-8ceea0b238c0",
                                "sense_id": "300abd03-06b2-34c7-9b52-2cfa44b475ee",
                                "text": "„Der Märzsturm war keineswegs wirkungslos über die südslavischen Völkerstämme hingegangen.“"
                            },
                            {
                                "example_id": "60bd12fe-bd3c-437d-961c-596229693c41",
                                "sense_id": "300abd03-06b2-34c7-9b52-2cfa44b475ee",
                                "text": "„Den Bundestag in Frankfurt, der im Märzsturm 1848 aufgeflogen war, wieder zu beschicken, hatte die preußische Regierung in Olmütz den Oesterreichern zugestanden.“"
                            },
                            {
                                "example_id": "2768439c-84de-4538-8f88-ebdfa0ebe5a8",
                                "sense_id": "300abd03-06b2-34c7-9b52-2cfa44b475ee",
                                "text": "„Vierzehn Tage nach dem Märzsturme antwortete das ‚Volksblatt für Stadt und Land‘ der glaubenslosen Revolution mit einem ‚Aufruf zum Gebet:‘ ‚Mit Gott für König und Vaterland! […]‘“"
                            },
                            {
                                "example_id": "78427921-c574-4c2c-886e-3d381e4f7121",
                                "sense_id": "300abd03-06b2-34c7-9b52-2cfa44b475ee",
                                "text": "„Vielen kamen die Märzstürme überhaupt unerwartet; sie hatten so wenig Fühlung mit dem Drängen und Eilen ihrer Zeit gehabt, daß ihnen die ‚Dämonen‘ gleichsam aus dem Unbekannten herauszusteigen schienen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
