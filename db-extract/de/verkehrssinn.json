                "senses": [
                    {
                        "sense_id": "b099ba05-36cf-396a-82ff-f8eac4e0617b",
                        "entry_id": "c478c660-75e5-3cda-ba01-77665a0d0c9a",
                        "glosses": [
                            "Fähigkeit, noch nicht eingetretene Ereignisse im Verkehrsleben instinktmäßig wahrzunehmen; Gespür für das Verhalten anderer Verkehrsteilnehmer und die aus bestimmten Konstellationen erwachsenden Gefahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27ad23b8-40b6-41ca-a58a-ee3a721ee31b",
                                "sense_id": "b099ba05-36cf-396a-82ff-f8eac4e0617b",
                                "text": "„Erziehung zum handelnden Verkehrspartner fordert Entwicklung des Verkehrssinnes.“"
                            },
                            {
                                "example_id": "5810af68-0445-4c2e-975d-6eb73b479ace",
                                "sense_id": "b099ba05-36cf-396a-82ff-f8eac4e0617b",
                                "text": "„Nicht Paragraphen sind jetzt das Ziel, es gilt, den Verkehrssinn zu schärfen.“"
                            },
                            {
                                "example_id": "a6b2a606-cda6-4c7f-bcef-ae3be3efe26c",
                                "sense_id": "b099ba05-36cf-396a-82ff-f8eac4e0617b",
                                "text": "„Der Lernzielkomplex ergibt sich aus den Komponenten Verkehrsgefühl, Verkehrssinn oder Verkehrsinstinkt, Verkehrsintelligenz und Verkehrsverhalten.“"
                            },
                            {
                                "example_id": "ef61dbc7-dc59-4375-8c76-1ba41bfb5677",
                                "sense_id": "b099ba05-36cf-396a-82ff-f8eac4e0617b",
                                "text": "„Vorausgesetzt wird eine flüssige, routinierte Fahrweise mit ausgeprägtem Verkehrssinn.“"
                            },
                            {
                                "example_id": "9f63e6e0-2f4f-4025-8dbb-feaa1ba62ddc",
                                "sense_id": "b099ba05-36cf-396a-82ff-f8eac4e0617b",
                                "text": "„Es schickt sich nicht mehr, die Menschen anzuprangern, deren mangelhaft entwickelter Verkehrssinn und geringe Intelligenz die am häufigsten erkannten Unfallursachen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
