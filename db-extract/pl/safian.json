                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saffian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80828a35-736b-36f8-8ef6-e5fe7fe1c0ee",
                                        "entry_id": "8a8991f6-dc2c-3638-93b3-e89a0f28ecd8",
                                        "glosses": [
                                            "A leather made from goatskins or sheepskins which is tanned with sumac and then brightly dyed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe3ac3a2-ec61-46e7-83d8-daf5e5a8be16",
                                                "sense_id": "80828a35-736b-36f8-8ef6-e5fe7fe1c0ee",
                                                "text": "One of the three volumes Cyby had brought was as large as the top of a small table […]; from the arms impressed upon its saffian cover, I supposed it to be the history of some old noble family."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06b5819f-581c-42c9-ba5e-3ecf94d0ee61",
                        "source_entry_id": "51d7ea6e-1135-3300-9baf-0871e405e6ae",
                        "source_sense_id": "5e713e98-753f-3036-822f-4f7dda257fd9",
