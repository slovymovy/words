                                    }
                                ]
                            },
                            {
                                "target_word": "ventilatore",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "ccde5639-a088-343c-af97-63c8dd85ad4b",
                                        "entry_id": "e0f6bf70-3dd0-328e-aa78-0a31ad8bd873",
                                        "glosses": [
                                            "apparecchio, solitamente meccanico, che serve a creare un flusso d'aria"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39f571a8-c5c0-4f56-b38a-259faf7e5301",
                                                "sense_id": "ccde5639-a088-343c-af97-63c8dd85ad4b",
                                                "text": "Luigi possiede un ventilatore da appoggio, mentre Marco ne ha uno da soffitto"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02b560a7-7c99-4015-ac12-164127e077ba",
                        "source_entry_id": "e925216d-47b1-36a1-b735-6b2ab194a8c5",
                        "target_lang_word": "Ventilator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ventilator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79f49dc8-94f3-30bc-812a-4af787e533c6",
                                        "entry_id": "3319cf9a-0123-39f1-9405-fd6cbc6a40c8",
                                        "glosses": [
                                            "Gerät, welches umgebende Luft durch Drehung eines Laufrades mit Schaufeln fördert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16e553a4-fb16-428b-86e3-5c306e77a0c0",
                                                "sense_id": "79f49dc8-94f3-30bc-812a-4af787e533c6",
                                                "text": "„Unter Ventilatoren versteht man Strömungsmaschinen zur Förderung von Luft oder anderen Gasen bis zu einem Druckverhältnis von p Ein / p Aus = 1,3.“"
                                            },
                                            {
                                                "example_id": "104b7103-24c8-464d-ab48-5ccc76bd4b94",
                                                "sense_id": "79f49dc8-94f3-30bc-812a-4af787e533c6",
                                                "text": "„Der Ventilator ist eine Vorrichtung, durch welche aus eingeschlossenen Räumen (z. B. Zimmern, Hospitälern, auf Schiffen etc.) die verdorbene Luft hinweggeschafft, und dagegen frische hereingebracht wird.“"
                                            },
                                            {
                                                "example_id": "c93ba583-9851-48a2-83c5-a6bf6764c7fa",
                                                "sense_id": "79f49dc8-94f3-30bc-812a-4af787e533c6",
                                                "text": "„Das Wort Ventilator (lat. \"Windt(über)träger\") bezeichnet ein Gerät welches dazu verwendet wird die es umgebende Luft in Bewegung zu versetzen ohne jedoch dabei zum Antrieb eines Gegenstandes (z. B. einem Flugzeug ) zu dienen.“"
                                            },
                                            {
                                                "example_id": "35bde483-08fd-4e26-8ec1-fefa25488198",
                                                "sense_id": "79f49dc8-94f3-30bc-812a-4af787e533c6",
                                                "text": "„Nel bleibt dabei, dass in der Mehrfachsteckdose kein Platz für einen weiteren Ventilator gewesen sei.“"
                                            },
                                            {
                                                "example_id": "6d79db7c-f61d-49a9-b5c6-0e82c80afca9",
                                                "sense_id": "79f49dc8-94f3-30bc-812a-4af787e533c6",
                                                "text": "„Roux verteidigt Pistorius, dass er sich bei einigen Fragen auf sein schlechtes Gedächtnis berief: etwa bei der Frage, wo genau die Decke lag, wie die Ventilatoren standen.“"
                                            },
                                            {
                                                "example_id": "8802a256-6b06-47e2-b2d2-46be1f68db4b",
                                                "sense_id": "79f49dc8-94f3-30bc-812a-4af787e533c6",
                                                "text": "„Dass Pistorius einen zweiten Ventilator erfunden haben soll, um begründen zu können, dass er Reevas Toilettengang nicht bemerkte, sei Unsinn, so Roux.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
