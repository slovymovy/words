                ],
                "senses": [
                    {
                        "sense_id": "13be2a0e-bde3-3f09-982e-ff42e0abbd73",
                        "entry_id": "bdac6c2f-47d4-33ab-8b43-af2e441adca1",
                        "glosses": [
                            "weibliche Person, die auf einer der Balearischen Inseln lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "539d53b2-f4bd-4aa5-a740-9395fe986c16",
                                "sense_id": "13be2a0e-bde3-3f09-982e-ff42e0abbd73",
                                "text": "„Die Autorin, selbst Wahl-Balearin, hat viel zu erzählen und bringt uns Mensch und Land ganz nahe.“"
                            },
                            {
                                "example_id": "2826a9b3-f11f-4272-8f2e-c8070d28ca2f",
                                "sense_id": "13be2a0e-bde3-3f09-982e-ff42e0abbd73",
                                "text": "„Lorena Roig beendet ihre Karriere als Spielerin […]. Roig ist von Kindesbeinen an Balearin […].“"
                            },
                            {
                                "example_id": "93863ebc-4e9c-421d-9642-a782a93740bb",
                                "sense_id": "13be2a0e-bde3-3f09-982e-ff42e0abbd73",
                                "text": "„Im Zuge der Folklorisierung regionaler Differenz bezeichnet es [die Tänzerinnen] dabei nicht nur als Spanierinnen, sondern auch als Katalaninnen, […]; als ‚die Kleinen‘ aus Badajoz oder ‚die feingliedrigen Balearinnen‘ mit den ‚großen Augen‘ werden sie ethnisiert.“"
                            },
                            {
                                "example_id": "dae4a86b-9a0d-4538-8bb4-7195397da0ed",
                                "sense_id": "13be2a0e-bde3-3f09-982e-ff42e0abbd73",
                                "text": "„Die Weiber dagegen sind namentlich an dem zierlich um das Haupt gewundenen Kopftuch kenntlich und zeichnen sich, besonders was die Balearinnen anlangt, häufig durch grosse Schönheit aus.“"
                            },
                            {
                                "example_id": "e0d4a1f3-6b70-4b92-b83c-a65adb4fa12f",
                                "sense_id": "13be2a0e-bde3-3f09-982e-ff42e0abbd73",
                                "text": "„Es gab aber auch ‚echte‘ asiatische Tanzkunst zu bewundern. Sang Ayu Dewi und Kadek Suciani, beides Balearinnen, die in Berlin leben, zeigten traditionelle Tänze aus ihrer Heimat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
