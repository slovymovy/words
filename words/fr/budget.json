                    "frequency": "High",
                    "semantic_group_id": "somme_argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons choisir un hôtel qui correspond à notre <w>budget</w> pour les vacances."
                        },
                        {
                            "text": "Avec un <w>budget</w> limité, ils ont réussi à rénover entièrement la cuisine."
                        }
                    ],
                    "common_phrases": [
