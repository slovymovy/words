                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sergent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "935422ba-f7c0-3692-a094-4c713b6225a8",
                                        "entry_id": "16aa08c6-0016-3759-9f8b-0d89bc6c685c",
                                        "glosses": [
                                            "Poisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76ba1c2-76c0-420c-b468-29afe48dd22e",
                                                "sense_id": "935422ba-f7c0-3692-a094-4c713b6225a8",
                                                "text": "Les poissons, plus prudents encore, se risquaient à sortir de leurs retraites vaseuses. D’abord, de très petits, tout blancs, que, dans les Landes, on appelle aubours, puis d’autres, plus ventrus, et qu’on nomme sergents parce qu’ils ont des nageoires vermeilles, les tanches enfin, avec leurs belles écailles de cuivre rouge."
                                            }
                                        ]
                                    }
                                ]
                            },
