                    {
                        "form_id": "77c99b1f-badd-488f-bb6f-535ea796e9fd",
                        "entry_id": "d0ab69dc-a0c1-3bb5-a31b-1e7318f54c6d",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "рукопа́шных"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "47f6c75b-dead-3125-8092-eb102e9ffdbd",
                        "entry_id": "d0ab69dc-a0c1-3bb5-a31b-1e7318f54c6d",
                        "glosses": [
                            "разг. схватка, осуществляемая без оружия или с использованием холодного оружия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91d8a931-4790-4b66-9cb3-d5cc87e6966c",
                                "sense_id": "47f6c75b-dead-3125-8092-eb102e9ffdbd",
                                "text": "Кипит рукопашная… Не одними кулаками молодцы работают, бьются ногами и коленками, колотят зря по чём ни попало, лежачего только тронуть не смеют — таков закон на кулачных боях."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdc58f54-fd55-4ec5-a492-cfd434739cd2",
                        "source_entry_id": "d0ab69dc-a0c1-3bb5-a31b-1e7318f54c6d",
                        "source_sense_id": "47f6c75b-dead-3125-8092-eb102e9ffdbd",
                        "target_lang_word": "Handgemenge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handgemenge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "122405c6-5189-31af-82bc-4817b92b9c0a",
                                        "entry_id": "bf62ab7d-2989-355f-a2c8-d4ffa8ad04d8",
                                        "glosses": [
                                            "handgreifliche Auseinandersetzung mehrerer Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "278c5fce-b056-4bc3-a50e-c61745d461ee",
                                                "sense_id": "122405c6-5189-31af-82bc-4817b92b9c0a",
                                                "text": "„Von der anderen Seite der Tür hörte man die Geräusche eines heftigen Handgemenges - Rufe, Flüche und Faustschläge.“"
                                            },
                                            {
                                                "example_id": "3f1bd585-0cf3-4e55-aca1-0a2da8fbc865",
                                                "sense_id": "122405c6-5189-31af-82bc-4817b92b9c0a",
                                                "text": "„Du liebe Zeit, Passagiere und Waren werden da unter Geschrei, Lamento und Handgemenge auf einen wahrhaftigen Seelenverkäufer bugsiert.“"
                                            },
                                            {
                                                "example_id": "9cdc0ade-82d4-4781-a85e-5064b1694888",
                                                "sense_id": "122405c6-5189-31af-82bc-4817b92b9c0a",
                                                "text": "„Württemberger Dragoner trieben die Angreifer zurück, bevor es zu einem Handgemenge kommen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "367d7551-5bc8-4652-aaeb-8d0a130aa5b5",
                        "source_entry_id": "d0ab69dc-a0c1-3bb5-a31b-1e7318f54c6d",
                        "source_sense_id": "47f6c75b-dead-3125-8092-eb102e9ffdbd",
                        "target_lang_word": "Prügelei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prügelei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19ee81e9-4bca-303e-b4c6-ed1de190b5c7",
                                        "entry_id": "0f0b7356-1bfb-3276-b3a6-1178f874687d",
                                        "glosses": [
                                            "Ereignis, bei dem sich mehrere Personen meist gegenseitig schlagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07c70a99-f34a-4589-9c26-06f6db4ec8a6",
                                                "sense_id": "19ee81e9-4bca-303e-b4c6-ed1de190b5c7",
                                                "text": "Vor der Kneipe gibt es jedes Wochenende Prügeleien."
                                            },
                                            {
                                                "example_id": "cf784b51-bd1d-4edc-9547-17d271e8fbc0",
                                                "sense_id": "19ee81e9-4bca-303e-b4c6-ed1de190b5c7",
                                                "text": "„Jedes Wort von uns hätte unweigerlich eine Prügelei provoziert, die mit Sicherheit in eine Massenkeilerei mit den älteren Schülern ausgeartet wäre.“"
                                            },
                                            {
                                                "example_id": "d1de858e-dfdd-4e3b-90b7-d1b49628bfd9",
                                                "sense_id": "19ee81e9-4bca-303e-b4c6-ed1de190b5c7",
                                                "text": "„Es kam zu einer Prügelei, bei der sowohl Seeleute als auch Inselbewohner verletzt wurden.“"
                                            },
                                            {
                                                "example_id": "96960878-7122-4484-9647-e9400b1df5fb",
                                                "sense_id": "19ee81e9-4bca-303e-b4c6-ed1de190b5c7",
                                                "text": "„Er scheute sich nicht vor einer Prügelei mit dem längsten Laban des Dorfes.“"
                                            },
                                            {
                                                "example_id": "c192225e-9472-455e-b1e5-20c9fb583f21",
                                                "sense_id": "19ee81e9-4bca-303e-b4c6-ed1de190b5c7",
                                                "text": "„Ein paar Tage später gab es Prügeleien zwischen den Parlamentariern, die sogar in Messerstechereien ausarteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9cc13017-1e26-36bd-882b-6d1a2b7571d8",
                                        "entry_id": "0f0b7356-1bfb-3276-b3a6-1178f874687d",
                                        "glosses": [
                                            "Handlung, jemanden intensiv/wiederholt zu schlagen"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e03c5e0e-554c-4931-b7e7-92d90615eaed",
                                                "sense_id": "9cc13017-1e26-36bd-882b-6d1a2b7571d8",
                                                "text": "Sie konnte seine Prügelei nicht mehr ertragen und verließ ihn."
                                            },
                                            {
                                                "example_id": "21a77a08-28b4-45d9-8ad6-a7ec476a6d7f",
                                                "sense_id": "9cc13017-1e26-36bd-882b-6d1a2b7571d8",
                                                "text": "„Dieser vermeintliche Angriff des Vierjährigen war in den Augen der Mutter und Großmutter eine größere Sünde als die häuslichen Prügeleien, die mittlerweile ein völlig normaler Bestandteil des Alltags waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30983358-c6e6-4668-956b-b2c55fd38ad7",
                        "source_entry_id": "d0ab69dc-a0c1-3bb5-a31b-1e7318f54c6d",
                        "source_sense_id": "47f6c75b-dead-3125-8092-eb102e9ffdbd",
                        "target_lang_word": "Nahkampf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nahkampf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9ea0239-684f-3ef8-bc50-f289c14afdc1",
                                        "entry_id": "0d7b8e19-918d-3af6-ab4d-6477502d789a",
                                        "glosses": [
                                            "direkte Kampfhandlung über kurze/kürzeste Distanz, zum Beispiel zwischen zwei Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f12863a5-32e5-41bb-8932-33caf0d3cf05",
                                                "sense_id": "a9ea0239-684f-3ef8-bc50-f289c14afdc1",
                                                "text": "Soldaten werden auch im Nahkampf ausgebildet."
                                            },
                                            {
                                                "example_id": "d64b551d-3861-47e1-9cfe-65df807129fd",
                                                "sense_id": "a9ea0239-684f-3ef8-bc50-f289c14afdc1",
                                                "text": "„Er aber fragt mich, ob ich auch einen Nahkampf mitgemacht hätte.“"
                                            },
                                            {
                                                "example_id": "300166f2-2d46-4149-9fce-900f7fc8d0b3",
                                                "sense_id": "a9ea0239-684f-3ef8-bc50-f289c14afdc1",
                                                "text": "„Im Nahkampf kennt er sich bestens aus und setzt auch da eine Menge Treffer.“"
                                            },
                                            {
                                                "example_id": "ea8722a9-2465-4cb8-9c99-c8698f791dd2",
                                                "sense_id": "a9ea0239-684f-3ef8-bc50-f289c14afdc1",
                                                "text": "„Carl Damm, Jahrgang 1927, hat noch die letzten Nahkämpfe in den Straßen Berlins mitgemacht.“"
                                            },
                                            {
                                                "example_id": "10f0cbcc-52f0-4731-9e8f-a271eec9e8ca",
                                                "sense_id": "a9ea0239-684f-3ef8-bc50-f289c14afdc1",
                                                "text": "„Diese Elite der Athletischsten und Gesündesten unter ihnen wurde ausgewählt und in ein Trainingslager in Mitischtschi nördlich von Moskau geschickt, wo man sie in Nahkampf, Waffenkunde, Fallschirmsprüngen aus niedriger Höhe und den Umgang mit Sprengstoff unterrichtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ab50294-837f-4176-ba40-53a4fe9ffaef",
                        "source_entry_id": "d0ab69dc-a0c1-3bb5-a31b-1e7318f54c6d",
                        "source_sense_id": "47f6c75b-dead-3125-8092-eb102e9ffdbd",
                        "target_lang_word": "corps à corps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corps à corps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c74e931-f997-3248-8109-a275624b8f17",
                                        "entry_id": "b038b258-22d9-32e0-bf58-19897e6117cc",
                                        "glosses": [
                                            "De manière à ce que les corps des protagonistes se touchent ou presque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d37f3ecc-6681-4f54-a6cb-4411e3217fee",
                                                "sense_id": "9c74e931-f997-3248-8109-a275624b8f17",
                                                "text": "Se battre, lutter, combattre corps à corps."
                                            },
                                            {
                                                "example_id": "c1fb95d8-5057-4daf-a738-d69e4da6b2d8",
                                                "sense_id": "9c74e931-f997-3248-8109-a275624b8f17",
                                                "text": "Se saisir corps à corps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corps à corps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d177b1c-461e-35d4-8a2e-0a47a3a1eb0a",
                                        "entry_id": "442f3bf8-2e07-3a26-a07e-1036e0b81202",
                                        "glosses": [
                                            "Corps contre corps, de très près."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aa9acf6-2355-4da4-b2f4-cb7553559a48",
                                                "sense_id": "8d177b1c-461e-35d4-8a2e-0a47a3a1eb0a",
                                                "text": "Certes, une attaque corps à corps avec ces carnassiers était extrêmement périlleuse ; […]."
                                            },
                                            {
                                                "example_id": "217f5a32-7fb7-4111-a216-820847cd0abb",
                                                "sense_id": "8d177b1c-461e-35d4-8a2e-0a47a3a1eb0a",
                                                "text": "Leur guerre à eux n'est pas celle qui nous plaît tant des combinaisons sur l'échiquier stratégique, mais pièges, embuscades, luttes corps à corps, actions individuelles. Ce n'est pas le meurtre en masse, mais la tuerie en détail, […]."
                                            },
                                            {
                                                "example_id": "c7b4cb92-ae3e-4516-a891-8884ac210318",
                                                "sense_id": "8d177b1c-461e-35d4-8a2e-0a47a3a1eb0a",
                                                "text": "Mais dans les régions que des reliefs du sol rendaient mal praticables, […], le hallebardier, l’homme d’épée pour le combat corps à corps, l’archer même purent affirmer leur supériorité ; […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corps à corps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5064fd74-381d-3488-9028-7e4c2b13dbc9",
                                        "entry_id": "2c18a426-6451-303f-9e69-01f85611c3ea",
                                        "glosses": [
                                            "Mode de combat dans lequel les combattants peuvent se saisir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "219e2d12-ee77-416e-bcbd-d00cbe9288fd",
                                                "sense_id": "5064fd74-381d-3488-9028-7e4c2b13dbc9",
                                                "text": "Surpris, les Français tournèrent bride, mais reprenant l'offensive ils engagèrent avec les cosaques, qu'ils mirent en fuite, un sanglant corps à corps jusque dans les rues du hameau de Jacqueville, puis tranquillement reprirent la route de Fontainebleau."
                                            },
                                            {
                                                "example_id": "58d27ee6-d6e5-4888-8a89-f437d1d5ba6f",
                                                "sense_id": "5064fd74-381d-3488-9028-7e4c2b13dbc9",
                                                "text": "All Blacks et autres springbocks ne tiendraient pas une mi-temps dans la mêlée farouche d’une gare parisienne un jour de fin juillet-début août. Alors qu’enfants et femmes et chats et chiens et canaris français parviennent à grimper dans leur train après des corps à corps qui ne sont pas sans rappeler au monde les fortes heures de Verdun."
                                            },
                                            {
                                                "example_id": "f5306e3a-a8a5-4818-8897-6d852bec058f",
                                                "sense_id": "5064fd74-381d-3488-9028-7e4c2b13dbc9",
                                                "text": "Mais les vieux grognards de son régiment lui avaient décrit ces barbares par le menu, leurs cris au moment de charger, leurs costumes bigarrés, leurs yeux rougis de haine pendant le corps à corps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
