                    "common_phrases": [
                        "solid line"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывный и не прерывающийся промежутками, точками или тире.",
                        "tr": "Boşluk, nokta veya kesik çizgilerle bölünmemiş, kesintisiz.",
