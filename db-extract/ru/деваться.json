                "senses": [
                    {
                        "sense_id": "77d4beaf-9921-3152-8f21-25bdc03432ff",
                        "entry_id": "4bf568a5-10fb-3c6b-bafe-71b9a68b4ff5",
                        "glosses": [
                            "to disappear, to get (to another place)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f2af2ff3-0d4d-4b37-a6f7-d005adb6147e",
                                "sense_id": "77d4beaf-9921-3152-8f21-25bdc03432ff",
                                "text": "Куда́ дева́ются мои́ ве́щи?",
                                "translation": "Where do my things disappear?",
                                "english": "Where do my things disappear?"
                            }
                        ]
                    },
                    {
                        "sense_id": "94e5aa6c-df98-3438-a076-9ae544059c6a",
                        "entry_id": "4bf568a5-10fb-3c6b-bafe-71b9a68b4ff5",
                        "glosses": [
                            "to put oneself, to go away"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4f051d15-2673-4d60-a47e-98ed0aa616c0",
                                "sense_id": "94e5aa6c-df98-3438-a076-9ae544059c6a",
                                "text": "Она́ не зна́ла, куда́ дева́ться от стыда́.",
                                "translation": "She did not know where to put herself for embarrassment.",
                                "english": "She did not know where to put herself for embarrassment."
                            },
                            {
                                "example_id": "e78552a9-1314-4ec7-829d-52ccaf0d8164",
                                "sense_id": "94e5aa6c-df98-3438-a076-9ae544059c6a",
                                "text": "Мне не́куда дева́ться.",
                                "translation": "I have no place to go / to hide.",
                                "english": "I have no place to go / to hide."
                            }
                        ]
                    },
                    {
                        "sense_id": "c91da5f1-65b6-33d5-a5d8-c4920039d8d1",
                        "entry_id": "4bf568a5-10fb-3c6b-bafe-71b9a68b4ff5",
