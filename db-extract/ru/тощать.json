                "translations": [
                    {
                        "translation_id": "2b550bae-5c21-43c0-9f9f-facc5e2ca97a",
                        "source_entry_id": "1a560ffc-e8d4-33e6-b303-0ecc506fdea4",
                        "source_sense_id": "c08d0369-17f4-35d7-b39d-2d9ab4a9f899",
                        "target_lang_word": "maigrir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maigrir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ead92983-547c-3260-9d8d-0d0d6a140d78",
                                        "entry_id": "7da66df9-fd96-3b55-ba4e-bd087872cf09",
                                        "glosses": [
                                            "Devenir maigre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6987d954-ade8-4afb-a3a2-25bf89b1d9e5",
                                                "sense_id": "ead92983-547c-3260-9d8d-0d0d6a140d78",
                                                "text": "Elle me parût pâle et maigrie, en soupant."
                                            },
                                            {
                                                "example_id": "f81ce680-691d-4723-8fdf-96fc79ba38f3",
                                                "sense_id": "ead92983-547c-3260-9d8d-0d0d6a140d78",
                                                "text": "Tu maigris à vue d’œil, tu ne te nourris plus assez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a8bab2a-e1d7-321a-976e-e3b0e305bc19",
                                        "entry_id": "7da66df9-fd96-3b55-ba4e-bd087872cf09",
                                        "glosses": [
                                            "Faire paraître maigre."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2e30704-c13d-4bc3-99a0-860db84ce178",
                                                "sense_id": "1a8bab2a-e1d7-321a-976e-e3b0e305bc19",
                                                "text": "Ce costume et cette coiffure vous maigrissent."
                                            },
                                            {
                                                "example_id": "1c6a9c3d-48d7-4ec9-ab67-ec76bb2b2711",
                                                "sense_id": "1a8bab2a-e1d7-321a-976e-e3b0e305bc19",
                                                "text": "Je l’ai trouvé bien maigri à la suite de cette maladie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89481aa8-e9f2-34a2-859d-72c0d03c49fc",
                                        "entry_id": "7da66df9-fd96-3b55-ba4e-bd087872cf09",
                                        "glosses": [
                                            "Faire maigrir."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de9a0df0-4215-4126-ad4d-4d09138ab631",
                                                "sense_id": "89481aa8-e9f2-34a2-859d-72c0d03c49fc",
                                                "text": "Et pourquoi la maigrissez-vous ?"
                                            },
                                            {
                                                "example_id": "4af650fa-b253-45db-89a1-ee6b28a63e4c",
                                                "sense_id": "89481aa8-e9f2-34a2-859d-72c0d03c49fc",
                                                "text": "De trop fortes pluies pourrissaient les semences, des coups de grêle hachaient le blé en herbe, un vent de foudre versait les tiges, deux mois de sécheresse maigrissaient les épis ; et c’étaient encore les insectes qui rongent, les froids qui tuent, des maladies sur le bétail, des lèpres de mauvaises plantes mangeant le sol : tout devenait une cause de ruine, la lutte restait quotidienne, au hasard de l’ignorance, en continuelle alerte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
