                ],
                "senses": [
                    {
                        "sense_id": "81f869c5-0c2b-3fa6-b60e-b00e29798143",
                        "entry_id": "220eb231-1813-3d75-afed-424f8a5e41d2",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a58655f-ec2a-4ce3-8722-c7866e661757",
                                "sense_id": "81f869c5-0c2b-3fa6-b60e-b00e29798143",
                                "text": "Frau Örthle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e2aad32f-0cc0-4801-9a91-73f9c60f6553",
                                "sense_id": "81f869c5-0c2b-3fa6-b60e-b00e29798143",
                                "text": "Herr Örthle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fa24c50a-75cd-427f-b870-b1b651a9a6cd",
                                "sense_id": "81f869c5-0c2b-3fa6-b60e-b00e29798143",
                                "text": "Die Örthles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "302a72cd-8c31-4d11-95e5-10c1ce2d5458",
                                "sense_id": "81f869c5-0c2b-3fa6-b60e-b00e29798143",
                                "text": "Der Örthle trägt nie die Pullover, die die Örthle ihm strickt."
                            },
                            {
                                "example_id": "7d3ff80e-ee30-46df-ab16-b048db8e8938",
                                "sense_id": "81f869c5-0c2b-3fa6-b60e-b00e29798143",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Örthle kommt, geht der Herr Örthle.“"
                            },
                            {
                                "example_id": "d53d5225-ddab-4bec-a558-cbc1f792c4e2",
                                "sense_id": "81f869c5-0c2b-3fa6-b60e-b00e29798143",
                                "text": "Örthle kommt und geht."
                            },
                            {
                                "example_id": "977965ca-dbf0-408a-9dca-eccb1dce4688",
                                "sense_id": "81f869c5-0c2b-3fa6-b60e-b00e29798143",
                                "text": "Örthles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
