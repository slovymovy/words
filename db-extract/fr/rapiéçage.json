        "fr-extract.jsonl": [
            {
                "entry_id": "40fb86f1-d0ae-399d-af4a-cda8928f06fe",
                "word": "rapiéçage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "86956f6c-29b0-471b-9a56-bcc089d5c027",
                        "entry_id": "40fb86f1-d0ae-399d-af4a-cda8928f06fe",
                        "tags": [
                            "plural"
                        ],
                        "form": "rapiéçages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b80a4fb-6a52-3f10-9b18-aef0461e8db6",
                        "entry_id": "40fb86f1-d0ae-399d-af4a-cda8928f06fe",
                        "glosses": [
                            "Action de rapiécer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3304931-ee67-4d1a-8695-f2fb6c36b4d3",
                                "sense_id": "8b80a4fb-6a52-3f10-9b18-aef0461e8db6",
                                "text": "Le rapiéçage d’un drap."
                            },
                            {
                                "example_id": "e016e68d-d448-4e39-a132-c4bbcb2e9062",
                                "sense_id": "8b80a4fb-6a52-3f10-9b18-aef0461e8db6",
                                "text": "Le lendemain elle ne changea ni de coiffure, ni de corsage ; assise près de son père sur un banc devant la maison, elle reprit l’ouvrage de couture, de rapiéçage plutôt qui l’avait occupée déjà dans la soirée."
                            }
                        ]
                    },
                    {
                        "sense_id": "212a0084-1114-3a01-a8fc-14b0a0fe8121",
                        "entry_id": "40fb86f1-d0ae-399d-af4a-cda8928f06fe",
                        "glosses": [
                            "Le résultat de cette action."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d34e869b-8eb7-4859-a9e6-9e4358c1a5b7",
                                "sense_id": "212a0084-1114-3a01-a8fc-14b0a0fe8121",
                                "text": "On sentait bien que c’était pas riche, à voir le bois des portes et le rapiéçage du toit."
                            },
                            {
                                "example_id": "8da12036-0882-45b0-b7e4-82ae1f68b556",
                                "sense_id": "212a0084-1114-3a01-a8fc-14b0a0fe8121",
                                "text": "Plus loin, fellahs et bédouins s'abritaient sous de pauvres étoffes, bariolées de rapiéçages, soutenues par quelques bâtons."
                            }
                        ]
                    }
                ],
