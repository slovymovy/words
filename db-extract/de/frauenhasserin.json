                ],
                "senses": [
                    {
                        "sense_id": "339fb884-2b00-3b43-b323-b4f51ee42747",
                        "entry_id": "f15b8baf-56f4-349a-b3b1-7f721801d610",
                        "glosses": [
                            "weibliche Person, die eine sehr starke Abneigung gegen Frauen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "456cf7bd-4e82-4179-8ee3-a59d50051c12",
                                "sense_id": "339fb884-2b00-3b43-b323-b4f51ee42747",
                                "text": "„Er ist ein Widerling. Sie ist eine ungebildete Frauenhasserin. Das war’s.“"
                            },
                            {
                                "example_id": "1ecf5251-7676-499e-92e8-15ca6f3eaf46",
                                "sense_id": "339fb884-2b00-3b43-b323-b4f51ee42747",
                                "text": "„Hätte sie sich nicht so bildreich darüber aufgeregt, wie elendig schlecht es Mädchen geht, die ihre Tage bekommen und nicht verstehen, was mit ihrem Körper los ist, hätte man sie vielleicht nicht so schnell eine Frauenhasserin genannt.“"
                            },
                            {
                                "example_id": "01ef391f-47eb-4571-bf02-8b46fa24d084",
                                "sense_id": "339fb884-2b00-3b43-b323-b4f51ee42747",
                                "text": "„Patrizia Carrano und Ellen Willis sehen Lina Wertmüller gar als Frauenhasserin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
