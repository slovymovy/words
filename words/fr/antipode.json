            "senses": [
                {
                    "sense_id": "247ab008-9774-3fb6-977b-424bf74dbdc8",
                    "sense_definition": "Chose, personne ou idée qui se trouve en opposition complète et diamétrale avec une autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leurs opinions politiques sont aux <w>antipodes</w> les unes des autres."
                        },
                        {
                            "text": "Cette nouvelle proposition est le parfait <w>antipode</w> de ce qui avait été convenu hier."
                        }
                    ],
                    "common_phrases": [
                        "aux antipodes",
                        "exact antipode",
                        "être aux antipodes"
                    ]
                },
                {
                    "sense_id": "665c4f8a-32a5-3f61-9a25-1310ad888b6a",
                    "sense_definition": "Lieu de la surface terrestre diamétralement opposé à un autre par rapport au centre du globe.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La Nouvelle-Zélande se trouve presque aux <w>antipodes</w> de la France métropolitaine."
                        },
                        {
                            "text": "Il a décidé de partir vivre aux <w>antipodes</w> pour changer complètement de vie."
                        }
                    ],
                    "common_phrases": [
                        "partir aux antipodes",
                        "vivre aux antipodes"
                    ]
                },
                {
                    "sense_id": "7106ba78-6072-364e-a63f-fb92c4ef0501",
                    "sense_definition": "Personne qui habite dans un lieu de la Terre diamétralement opposé à un lieu donné.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les marins se demandaient comment vivaient les <w>antipodes</w> de l'autre côté du monde."
                        },
                        {
                            "text": "Selon les croyances médiévales, nos <w>antipodes</w> marchaient la tête en bas."
