                                "target_lang_word": "мнимый",
                                "target_lang_sense_clarification": "воображаемый"
                            },
                            {
                                "target_lang_word": "надуманный",
                                "target_lang_sense_clarification": "нереальный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "göstermelik",
