                ],
                "senses": [
                    {
                        "sense_id": "6c2172a4-fc05-3bd9-8dba-d35912c13f21",
                        "entry_id": "446c08c8-b12c-3ee1-b3ba-31e0bdea66d1",
                        "glosses": [
                            "Abfolge schneller Trommelschläge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b9edca-1e37-40c0-8bab-749064267b29",
                                "sense_id": "6c2172a4-fc05-3bd9-8dba-d35912c13f21",
                                "text": "„Unter Trommelwirbel erschien gegen 21 Uhr eine Patrouille des 79. Infanterieregiments auf dem Marktplatz.“"
                            },
                            {
                                "example_id": "4561f69d-4cd0-4716-9cf8-a3dd8a77b6e0",
                                "sense_id": "6c2172a4-fc05-3bd9-8dba-d35912c13f21",
                                "text": "„Die Truppen werden wieder aufgestellt, aber nur, um ein Manöver auszuführen: unter Musik und Trommelwirbel zieht das Fußvolk sich zurück und macht den viertausend Mann Reiterei Platz.“"
                            },
                            {
                                "example_id": "b9ecd488-c6b4-468e-a9b5-c2fa404fd863",
                                "sense_id": "6c2172a4-fc05-3bd9-8dba-d35912c13f21",
                                "text": "„Trommelwirbel ertönte, ein silbernes Kreuz tauchte auf; dann erschienen zwei Leuchter, von Kantoren getragen, sowie der Herr Pfarrer mit Stola, Chorhemd, Chormantel und Barett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
