        "fr-extract.jsonl": [
            {
                "entry_id": "7ee032f5-47f5-3b1c-9bd1-24656407b96c",
                "word": "mélodieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "01390c45-d152-32a1-9d04-ab27c659eb70",
                        "entry_id": "7ee032f5-47f5-3b1c-9bd1-24656407b96c",
                        "glosses": [
                            "D’une manière mélodieuse."
                        ],
                        "tags": [
                            "Mélioratif"
                        ],
                        "examples": [
                            {
                                "example_id": "ea4bf45b-b850-4464-ad55-a2ba7866815d",
                                "sense_id": "01390c45-d152-32a1-9d04-ab27c659eb70",
                                "text": "S'il est vrai, ce que dit Pausanias, que les rossignols qui étaient vers le tombeau d’Orphée chantaient plus mélodieusement que les autres."
                            },
                            {
                                "example_id": "1100acec-23eb-411c-9b0a-6e0220d065bd",
                                "sense_id": "01390c45-d152-32a1-9d04-ab27c659eb70",
                                "text": "Avouons plutôt que par le moyen de cette périphrase, mélodieusement répandue dans le discours, d’une diction toute simple il a fait une espèce de concert et d’harmonie."
                            },
                            {
                                "example_id": "a27c5111-da86-45ea-bc7b-f1e007057401",
                                "sense_id": "01390c45-d152-32a1-9d04-ab27c659eb70",
                                "text": "[Le rossignol] commence son chant, fait retentir le bocage, et rompt mélodieusement le silence et les ténèbres de la nuit."
                            },
                            {
                                "example_id": "81e1081f-2da0-4066-82b2-d0f393a0e81c",
                                "sense_id": "01390c45-d152-32a1-9d04-ab27c659eb70",
                                "text": "…, il me semblait ouïr les anges descendre du ciel mélodieusement."
                            }
                        ]
                    }
                ],
