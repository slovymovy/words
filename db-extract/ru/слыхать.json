                "senses": [
                    {
                        "sense_id": "5b3c0881-a1be-38d4-ac21-9927b430fed3",
                        "entry_id": "ca8ec702-f5be-3635-95fb-fb137f7e0d2c",
                        "glosses": [
                            "to hear of, to hear from"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f9123658-65d9-4ee5-8905-d9f53075a4e1",
                                "sense_id": "5b3c0881-a1be-38d4-ac21-9927b430fed3",
                                "text": "Князь Андре́й никогда́ не слыха́л сме́ха Спера́нского, и э́тот зво́нкий, то́нкий смех госуда́рственного челове́ка стра́нно порази́л его́.",
                                "translation": "Prince Andrew had never before heard Speránski's famous laugh, and this ringing, highpitched laughter from a statesman made a strange impression on him.",
                                "english": "Prince Andrew had never before heard Speránski's famous laugh, and this ringing, highpitched laughter from a statesman made a strange impression on him."
                            }
                        ]
                    }
                ],
