                "senses": [
                    {
                        "sense_id": "5b5691f9-2d55-3bad-9b04-ec9a964c859e",
                        "entry_id": "1b8cc589-4f21-3df8-9e28-a8f1047980d5",
                        "glosses": [
                            "das feierlich begangene Hinaufbringen/Hinauftreiben der Kühe im Frühjahr auf die Hochgebirgsweiden"
                        ],
                        "tags": [
                            "Austrian German",
                            "South-German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "be4e851d-332a-4d8a-bbc2-3c663f8a2abe",
                                "sense_id": "5b5691f9-2d55-3bad-9b04-ec9a964c859e",
                                "text": "„Bei Interesse können Sie als unsere Urlaubsgäste gerne am Alpauftrieb / Alpabtrieb teilnehmen, wenn es sich terminlich ergibt.“"
                            },
                            {
                                "example_id": "4ee2a58e-2888-48b6-a389-72cdca781691",
                                "sense_id": "5b5691f9-2d55-3bad-9b04-ec9a964c859e",
                                "text": "„Trotzdem hat der im Monat Mai stattfindende Alpauftrieb immer noch den Charakter eines Ritus.“"
                            },
                            {
                                "example_id": "97c7e782-dea9-4ed7-84a6-68f8c1909652",
                                "sense_id": "5b5691f9-2d55-3bad-9b04-ec9a964c859e",
                                "text": "„Bei zum Alpauftrieb vorgesehenen Rindern, die meist älter sind, hat sich die zweite Vakzinierung zum Zeitpunkt der Zusammenstellung der Almgruppen bewährt.“"
                            },
                            {
                                "example_id": "4fd5c733-cddb-498b-b187-ba630a204957",
                                "sense_id": "5b5691f9-2d55-3bad-9b04-ec9a964c859e",
                                "text": "„Der Alpauftrieb geschieht gewöhnlich im Juni.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
