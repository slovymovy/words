                    {
                        "form_id": "df5abfbc-e8b0-4091-b706-ac8dfc4ed1b6",
                        "entry_id": "2c6ec179-624b-39a5-82fb-d94026d20a46",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Freitagabende"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8880423-b26c-3d88-9dc3-456c950e1fb2",
                        "entry_id": "2c6ec179-624b-39a5-82fb-d94026d20a46",
                        "glosses": [
                            "der Abend eines Freitages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af8aeb1-305b-4c46-84f4-823f8b58037f",
                                "sense_id": "f8880423-b26c-3d88-9dc3-456c950e1fb2",
                                "text": "Freitagabend gehen wir in die Disko."
                            },
                            {
                                "example_id": "e568fede-e52a-4b56-bfc9-692a77f24f07",
                                "sense_id": "f8880423-b26c-3d88-9dc3-456c950e1fb2",
                                "text": "Es gibt nicht viele Freitagabende, an denen ich nicht arbeiten muss."
                            },
                            {
                                "example_id": "a385b002-5096-480f-8b5b-457e568ae77a",
                                "sense_id": "f8880423-b26c-3d88-9dc3-456c950e1fb2",
                                "text": "„Am Freitagabend kam Carolyn geradewegs vom Flughafen zu mir, und am Samstagmorgen saß ich bereits am Frühstückstisch, als sie in meinem Frotteebademantel aus dem Badezimmer in die Küche marschiert kam und in der ausgestreckten Hand einen halb in Toilettenpapier gewickelten blutigen Tampon hielt.“"
                            },
                            {
                                "example_id": "69f53c9c-4257-4323-abed-2850d1b4d46f",
                                "sense_id": "f8880423-b26c-3d88-9dc3-456c950e1fb2",
                                "text": "„An einem Freitagabend nach dem Gottesdienst nahm ein Mann, als er das Bethaus verließ, auf seinem Heimweg einen Sabbatgast mit sich.“"
                            },
                            {
                                "example_id": "6bed1600-5f6b-460c-a2ba-0f7c0d63dd8c",
                                "sense_id": "f8880423-b26c-3d88-9dc3-456c950e1fb2",
                                "text": "„An diesem Freitagabend schlafe ich in der Arbeit an meinem Schreibtisch ein.“"
                            },
                            {
                                "example_id": "6b58b3fe-a6e3-4f10-80eb-1bfb2541ad95",
                                "sense_id": "f8880423-b26c-3d88-9dc3-456c950e1fb2",
                                "text": "„An diesem Freitagabend war das beliebteste Restaurant im Ort gut besucht, es gab schließlich in Akranes auch nicht viel Konkurrenz.“"
                            },
                            {
                                "example_id": "024fdc5f-3897-480a-bdcd-0d2c5cf324a4",
                                "sense_id": "f8880423-b26c-3d88-9dc3-456c950e1fb2",
                                "text": "„Bei einer Messerattacke in Hamburg sind am Freitagabend mehrere Menschen schwer verletzt worden. Die Polizei gab später erste Informationen zur mutmaßlichen Täterin bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
