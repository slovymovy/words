                    ]
                },
                {
                    "sense_id": "a1c966d4-4e49-3dde-b03f-1180e89dad7c",
                    "sense_definition": "S'élever harmonieusement ou avec force vers le haut.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les flèches de la cathédrale gothique s'<w>élancent</w> fièrement vers le ciel nuageux."
                        },
                        {
                            "text": "Au bord du canal, une rangée de hauts peupliers s'<w>élance</w> droit vers les nuages."
