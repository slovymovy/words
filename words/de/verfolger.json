                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Radrennfahrer verteidigte seinen Vorsprung und hielt alle <w>Verfolger</w> auf Distanz."
                        },
                        {
                            "text": "In der Tabelle baute die Mannschaft ihren Vorsprung auf den schärfsten <w>Verfolger</w> aus."
                        }
                    ],
                    "synonyms": [
                        "Konkurrent",
                        "Herausforderer"
                    ],
                    "antonyms": [
