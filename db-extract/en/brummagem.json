    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c2d5170b-5a68-3da5-907d-3243c0c42d1a",
                "word": "brummagem",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "014e9c11-cdfd-3d7a-8cd2-763517be7791",
                        "entry_id": "c2d5170b-5a68-3da5-907d-3243c0c42d1a",
                        "glosses": [
                            "Cheap and showy; meretricious."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "50258f63-1521-4265-bcc4-f785b00367b6",
                                "sense_id": "014e9c11-cdfd-3d7a-8cd2-763517be7791",
                                "text": "The unhappy man (who had cheated the sailors), innocent of danger, is seated on a grating with his combs, spy-glasses, necklaces, ribbons, and all the rest of his \"Brummagem\" trumpery, spread out before him."
                            },
                            {
                                "example_id": "8ae1d52f-b897-47a0-b244-0cfce2b5c7ae",
                                "sense_id": "014e9c11-cdfd-3d7a-8cd2-763517be7791",
                                "text": "\"My, my, my, my, my,\" said a voice from behind them, and the Baudelaire orphans turned to find Stephano standing there,...a look of brummagem surprise on his face. \"Brummagem\" is such a rare word for \"fake\" that even Klaus didn't know what it meant, but the children did not have to be told that Stephano was pretending to be surprised."
                            },
                            {
                                "example_id": "f9f5e92a-9170-4704-a197-ff06bbe89e97",
                                "sense_id": "014e9c11-cdfd-3d7a-8cd2-763517be7791",
                                "text": "The colloquial form of the city’s name thus entered the language as a contemptuous epithet. In 1861 the word was used to describe “The vulgar dandy, strutting along, with his Brummajem jewellry”; to “Birminhamize” was “to artificialize.”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
