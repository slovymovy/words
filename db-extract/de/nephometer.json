                "senses": [
                    {
                        "sense_id": "7d28e736-84f5-3a2c-becb-8a2cf8653ab4",
                        "entry_id": "c1a5f42a-5626-306b-b285-a6506f5e81e4",
                        "glosses": [
                            "Instrument zur Bestimmung einiger Eigenschaften von Wolken (zum Beispiel Geschwindigkeit, Dichte, Zugrichtung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3e8ebe9-91d7-4155-b925-190f5ae5d6e7",
                                "sense_id": "7d28e736-84f5-3a2c-becb-8a2cf8653ab4",
                                "text": "„Unentbehrlich für genaue Wolkenmessungen aller Art ist das neue Nephometer nach Dr. Stüve.“"
                            },
                            {
                                "example_id": "cdfd400c-c59a-4550-837c-3ca25007c787",
                                "sense_id": "7d28e736-84f5-3a2c-becb-8a2cf8653ab4",
                                "text": "„Verf. glaubt, daß man das Nephometer auch benutzen kann, um Lokaleinflüsse auf die Wolkenmenge (z. B. die Wirkung einer Wasserfläche) festzustellen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
