                        ],
                        "form": "die Behelfe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cae95775-50f2-3cd0-ac2b-f7d6c96ce805",
                        "entry_id": "e3d26721-7d38-3945-93e2-181e1c57117a",
                        "glosses": [
                            "etwas, das man notgedrungen anstelle von etwas anderem, Besseren verwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e037ae14-10de-4550-9158-b107e53a07b6",
                                "sense_id": "cae95775-50f2-3cd0-ac2b-f7d6c96ce805",
                                "text": "Das Auto ist nur ein vorübergehender Behelf, weil unser Wagen in der Werkstatt ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f7e650ac-fdeb-3701-b6a9-b2bf0fa57376",
                        "entry_id": "e3d26721-7d38-3945-93e2-181e1c57117a",
                        "glosses": [
                            "Mittel, Werkzeug zur Arbeitserleichterung, Zielerreichung"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "c574ffbb-9579-4b06-a3d1-568175ade50c",
                                "sense_id": "f7e650ac-fdeb-3701-b6a9-b2bf0fa57376",
                                "text": "„Ein Laufbahnvergleich kann sich in der Regel nur auf wirklich festgestellte Laufbahnen beziehen und nicht auf Beförderungsrichtlinien, die sich die Stelle, die über Beförderungen zu entscheiden hat, als interner Behelf gegeben hat, ohne daß die Einhaltung dieser Richtlinien durchsetzbar wäre.“"
                            },
                            {
                                "example_id": "e19dbe87-00ad-4ad4-ac45-91f169cc61f7",
                                "sense_id": "f7e650ac-fdeb-3701-b6a9-b2bf0fa57376",
                                "text": "„Es muss sich also nicht unbedingt um Sachen handeln, die aus rein medizinischer Sicht als Behelf für einen Körperbehinderten geschaffen und verwendet werden […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ff33159-7e29-487c-9af3-cfcfbc6a262b",
                        "source_entry_id": "e3d26721-7d38-3945-93e2-181e1c57117a",
                        "source_sense_id": "cae95775-50f2-3cd0-ac2b-f7d6c96ce805",
                        "source_sense_description": "etwas, das man notgedrungen anstelle von etwas anderem, Besseren verwendet",
                        "target_lang_word": "means",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "means",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f89bd52-bb07-3e85-b049-8ef2d7511796",
                                        "entry_id": "b01da313-677e-3826-8dd8-48926fa068d3",
                                        "glosses": [
                                            "plural of mean"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "means",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03ef80df-e79f-316a-b58e-5c5ee64e3ef3",
                                        "entry_id": "ecc149bf-fa62-350e-83d1-95ced317109c",
                                        "glosses": [
                                            "An instrument or condition to achieve a result."
                                        ],
                                        "tags": [
                                            "countable",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cddf525-f0c3-4d90-931e-da2133ec2f85",
                                                "sense_id": "03ef80df-e79f-316a-b58e-5c5ee64e3ef3",
                                                "text": "She treated him as a means to an end."
                                            },
                                            {
                                                "example_id": "99a9bc7f-96fa-409e-8a6a-6ce12494afb5",
                                                "sense_id": "03ef80df-e79f-316a-b58e-5c5ee64e3ef3",
                                                "text": "A car is a means of transport."
                                            },
                                            {
                                                "example_id": "3ce41fee-5de4-4535-b611-68c13ea9ff79",
                                                "sense_id": "03ef80df-e79f-316a-b58e-5c5ee64e3ef3",
                                                "text": "And by this means also he had them the more at vantage, being tired and harassed with a long march; and more at mercy, being cut off far from their country, and therefore not able by any sudden flight to get to retreat, and to renew their troubles."
                                            },
                                            {
                                                "example_id": "8d76289f-f581-46ea-a30d-4193970ec976",
                                                "sense_id": "03ef80df-e79f-316a-b58e-5c5ee64e3ef3",
                                                "text": "Our hope in him is dead: let us return,\nAnd strain what other means is left unto us\nIn our dear peril."
                                            },
                                            {
                                                "example_id": "9f852618-422a-4c6d-b4ef-0d71dca83fcc",
                                                "sense_id": "03ef80df-e79f-316a-b58e-5c5ee64e3ef3",
                                                "text": "In his submission to the UN, [Christof] Heyns points to the experience of drones. Unmanned aerial vehicles were intended initially only for surveillance, and their use for offensive purposes was prohibited, yet once strategists realised their perceived advantages as a means of carrying out targeted killings, all objections were swept out of the way."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "means",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37fa6213-b6be-32d5-bd6a-c1f40aa318c8",
                                        "entry_id": "dc91fbff-827a-3d12-8e90-7fbbe42666cb",
                                        "glosses": [
                                            "Financial resources; wealth."
                                        ],
                                        "tags": [
                                            "often",
                                            "plural",
                                            "plural-only",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a238211-a484-49cf-bac8-c22a63ec5b0c",
                                                "sense_id": "37fa6213-b6be-32d5-bd6a-c1f40aa318c8",
                                                "text": "a person of means; independent means"
                                            },
                                            {
                                                "example_id": "b78e4e7c-8a23-4b2d-8ffa-69a442f7102d",
                                                "sense_id": "37fa6213-b6be-32d5-bd6a-c1f40aa318c8",
                                                "text": "He was living beyond his means."
                                            },
                                            {
                                                "example_id": "60ef6b0e-9f2f-4f9d-a674-0c59a87f405c",
                                                "sense_id": "37fa6213-b6be-32d5-bd6a-c1f40aa318c8",
                                                "text": "Where there is much means to be used, and conditions yet to be performed, for the continuation and Consummation of our Justification, there it is not yet continued or consummate."
                                            },
                                            {
                                                "example_id": "d4b603bc-8e6b-40d9-8c4a-b0d73147d139",
                                                "sense_id": "37fa6213-b6be-32d5-bd6a-c1f40aa318c8",
                                                "text": "Because there is too much civilisation, too much means of subsistence, too much industry, too much commerce"
                                            },
                                            {
                                                "example_id": "4276dbc3-56ac-472b-9aeb-b2c8493040ab",
                                                "sense_id": "37fa6213-b6be-32d5-bd6a-c1f40aa318c8",
                                                "text": "Then the other 12 packers […] were men without much means, who lived in Fresno"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0305b717-e5bb-3bf4-999e-e0e9138efed0",
                                        "entry_id": "dc91fbff-827a-3d12-8e90-7fbbe42666cb",
                                        "glosses": [
                                            "Financial resources; wealth.",
                                            "Substantial wealth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "often",
                                            "plural",
                                            "plural-only",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "088dd882-25b4-4e0e-a86d-aad35ceda562",
                                                "sense_id": "0305b717-e5bb-3bf4-999e-e0e9138efed0",
                                                "text": "She is a woman of means."
                                            },
                                            {
                                                "example_id": "0666a5f5-df91-46c2-9783-3085bb305ad0",
                                                "sense_id": "0305b717-e5bb-3bf4-999e-e0e9138efed0",
                                                "text": "Hotels that are so priced that only people of means can stay."
                                            },
                                            {
                                                "example_id": "373f441c-e387-41a6-8747-de8e3f9ff00b",
                                                "sense_id": "0305b717-e5bb-3bf4-999e-e0e9138efed0",
                                                "text": "Some kind of writer. He didn't have to make a living; he had means."
                                            }
                                        ]
                                    }
                                ]
                            },
