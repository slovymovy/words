                        "sense_id": "dfc3ab14-0dc1-3319-a678-c9ec6cdbd5be",
                        "entry_id": "7b597b1d-e73b-39cd-8f34-d1bee7c5ce45",
                        "glosses": [
                            "dat ergens vloeistof vanaf druppelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91eacfd8-2eed-4e04-8284-822395bc0329",
                                "sense_id": "dfc3ab14-0dc1-3319-a678-c9ec6cdbd5be",
                                "text": "In de kerk zag men grote kandelaars met kaarsvet van de druipende kaarsen."
                            },
                            {
                                "example_id": "24e2581e-d9af-4673-a696-23be8bcf334f",
                                "sense_id": "dfc3ab14-0dc1-3319-a678-c9ec6cdbd5be",
                                "text": "March zocht naar de Orpoagenten en zag hen schuilen bij het meer onder een druipende berk."
                            },
                            {
                                "example_id": "1eefe0db-e33b-4006-8032-9af386e486d4",
                                "sense_id": "dfc3ab14-0dc1-3319-a678-c9ec6cdbd5be",
                                "text": "Wat een deceptie toen ik druipend de oever opklom en ontdekte dat er zich een familiecamping naast het meer bevond: dit was niet de wildernis die ik had verwacht."
                            }
                        ]
                    }
