                        "examples": [
                            {
                                "example_id": "0f93dd6d-c0d3-4ad8-b201-a7c7a9f49fec",
                                "sense_id": "0b5aea4a-cfd1-3a61-8222-b0ea9d883afc",
                                "text": "Madison Bycroft est interprète, scénographe, dessinateurice industriel·le, sculpteurice, écrivain·e, joueureuse de tours, auteurice de limericks, orchestrateurice de medleys et instigateurice de rencontres, entre autres talents."
                            },
                            {
                                "example_id": "f70365ec-9a98-4bcc-ab20-79026f0c7213",
                                "sense_id": "0b5aea4a-cfd1-3a61-8222-b0ea9d883afc",
                                "text": "Sinon j'ai 29 ans, officiellement je suis rigger 3D dans le cinéma d'animation, officieusement on peut ajouter auteurice, illustrateurice et sculpteurice 3D à mes skills xD"
                            }
                        ]
                    },
                    {
                        "sense_id": "36887063-b6ff-3261-83b7-3c2a8c7a5f95",
                        "entry_id": "fb22521b-6e23-3f85-ad90-6b2add381b4c",
                        "glosses": [
                            "Artiste sans détermination de genre qui sculpte."
                        ],
                        "tags": [
