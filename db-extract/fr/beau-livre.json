                        "sense_id": "db6c4bec-6fe0-3720-9cc7-f74bb807d02e",
                        "entry_id": "5b4219c8-9040-36a0-96da-108bf6fd813e",
                        "glosses": [
                            "Livre, généralement de grand format, comportant des illustrations de grande taille imprimées avec soin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "333222d6-bc1e-4386-a59c-e106a97858c7",
                                "sense_id": "db6c4bec-6fe0-3720-9cc7-f74bb807d02e",
                                "text": "Il y a des livres. Il y a de bons livres. Des mauvais, aussi, peu importe. Et puis il y a les «beaux-livres», qu’on entoure de guillemets comme ils sont emmaillotés de plastique. On cale volontiers un trait d’union entre les deux mots, afin de bien montrer ce dont on parle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e6f7566-ba76-484e-a746-d7d25b564bde",
                        "source_entry_id": "5b4219c8-9040-36a0-96da-108bf6fd813e",
                        "source_sense_id": "db6c4bec-6fe0-3720-9cc7-f74bb807d02e",
                        "target_lang_word": "coffee table book",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coffee table book",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5de8f281-641b-35cb-b678-ed7e77491fa9",
                                        "entry_id": "88d3b5e6-b2dd-3f1e-961f-16f122b96c22",
                                        "glosses": [
                                            "A large book, usually with lavish illustrations, typically displayed on a coffee table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77a56b28-7e3b-42df-832f-347d6bf83771",
                                                "sense_id": "5de8f281-641b-35cb-b678-ed7e77491fa9",
                                                "text": "Nonbooks are of several kinds; but their differences notwithstanding, they all share two common features: they tend to be written for market rather than for intellectual reasons, and they are all means rather than ends. [...] Of all nonbooks, the most conspicuous example is the ‘coffee-table book’. The latter usually find their market by virtue of their decorative assets rather than from any literary or intellectual merit, or for that matter – since such works are often art books – by significantly serving important aesthetic or historical purposes."
                                            },
                                            {
                                                "example_id": "5918ad27-1363-445e-ac71-fabe45a76dcb",
                                                "sense_id": "5de8f281-641b-35cb-b678-ed7e77491fa9",
                                                "text": "The Family Book of Black America (Crown, $20), a photographic coffee table book, by Michael H. Cottman and Deborah Willis."
                                            },
                                            {
                                                "example_id": "a5972ae1-75b1-48d7-bf80-7c698b41ad73",
                                                "sense_id": "5de8f281-641b-35cb-b678-ed7e77491fa9",
                                                "text": "I am leery of coffee table books. They are often pretty but have little substance once you get under the surface."
                                            },
                                            {
                                                "example_id": "1186fd99-90f8-4d64-ad52-bd72e86bf33b",
                                                "sense_id": "5de8f281-641b-35cb-b678-ed7e77491fa9",
                                                "text": "Mukulika Banerjee and Daniel Miller serenade the garment [the sari] in their remarkable coffee-table book The Sari. [...] Photographs build the warp and weft of coffee-table books. Words seldom rule and even if written by well-known writers, they have to take second place to the camera's five-colour dominance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
