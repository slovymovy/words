                "senses": [
                    {
                        "sense_id": "8294af7d-11ba-3a74-bc45-d662c7ee6191",
                        "entry_id": "e61dcdd9-26ca-3d42-976b-b7336b06e0a2",
                        "glosses": [
                            "Unterrichtserteilung im eigenen Zuhause, oft durch die Eltern/Erziehungsberechtigten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1b03645-7d5b-4118-aa76-ac19ba8304dd",
                                "sense_id": "8294af7d-11ba-3a74-bc45-d662c7ee6191",
                                "text": "„Seit Wochen müssen viele Eltern neben dem \"Homeoffice\" auch das \"Homeschooling\" stemmen.“"
                            },
                            {
                                "example_id": "1546ce00-ac00-47da-b328-6d5717ea7e30",
                                "sense_id": "8294af7d-11ba-3a74-bc45-d662c7ee6191",
                                "text": "„Im Primarbereich ist Homeschooling in 24 von 30 OECD-Ländern eine gesetzlich zugelassene Möglichkeit zur Erfüllung der Schulpflicht.“"
                            },
                            {
                                "example_id": "3fe9b6eb-5f82-440b-b372-674c3017b292",
                                "sense_id": "8294af7d-11ba-3a74-bc45-d662c7ee6191",
                                "text": "„Der Autor untersucht, ob sich das in Deutschland geltende Verbot von Homeschooling verfassungsrechtlich halten lasst.“"
                            },
                            {
                                "example_id": "f0d67557-a074-4350-b5fc-5e9b29fadb9b",
                                "sense_id": "8294af7d-11ba-3a74-bc45-d662c7ee6191",
                                "text": "„Probleme beim Anmelden oder Videokonferenzen, die abstürzen - für viele Schüler und Lehrer in Schleswig-Holstein verlief auch der zweite Tag Homeschooling in diesem Jahr nicht reibungslos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
