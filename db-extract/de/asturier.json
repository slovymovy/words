                                        "sense_id": "09659b78-5a68-3805-9b7d-a210bc554d27",
                                        "entry_id": "3076de4d-b01c-3804-8c47-1fd79e0cedc2",
                                        "glosses": [
                                            "Of, from or relating to Asturias, Spain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "286bd356-a76a-4b70-8040-781e8f2969e1",
                                                "sense_id": "09659b78-5a68-3805-9b7d-a210bc554d27",
                                                "text": "This gave time to many families to escape; and Bermudo even carried away the bodies of his predecessors to the old refuge in the Asturian hills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63fbe51-b3b6-3827-8f19-86913742153c",
                                        "entry_id": "3076de4d-b01c-3804-8c47-1fd79e0cedc2",
                                        "glosses": [
                                            "Of or pertaining to the Asturian language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc99c23c-2b51-4b1c-bcfd-bc9bf27738ab",
                                                "sense_id": "a63fbe51-b3b6-3827-8f19-86913742153c",
                                                "text": "The winning entry was a poem written in Asturian, one of the first such in Asturian literature."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
