                        "zh": [
                            {
                                "target_lang_word": "伸出",
                                "target_lang_sense_clarification": "从里面往外探出、伸到外面"
                            },
                            {
                                "target_lang_word": "露出",
                                "target_lang_sense_clarification": "从遮挡物后面显露出来"
                            },
                            {
                                "target_lang_word": "突出",
                                "target_lang_sense_clarification": "向外突出来"
                            }
