                        "glosses": [
                            "Volume d'un quart de la pièce (225 litres) soit environ cinquante-sept litres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17d8d0ee-54bc-4d2a-bd66-acf32f44780d",
                                "sense_id": "bffefcab-46a3-3b67-a80a-32bb704bb949",
                                "text": "Ainsi l’on racontait dans le Morvan, qu’un jour il avait porté sur son dos une pauvre femme, son âne et son sac au marché, qu’il avait mangé tout un bœuf et bu tout un quartaut de vin dans une journée, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "54d8298d-dc9e-3f63-86bd-ca64c972f9cc",
                        "entry_id": "30ddd88c-81dd-38c6-8408-f3517f3a5ce1",
                        "glosses": [
                            "Baril, petit tonneau de cette contenance."
