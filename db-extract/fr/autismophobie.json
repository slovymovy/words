                "senses": [
                    {
                        "sense_id": "332133b0-13b1-37db-abf4-7acec001951e",
                        "entry_id": "983205ce-c125-37d3-a7c0-e3a4ea7afb63",
                        "glosses": [
                            "Exclusion ou discrimination à l’encontre des personnes perçues ou connues comme autistes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "165b4a66-dfee-4fe6-b9d0-76039be94c16",
                                "sense_id": "332133b0-13b1-37db-abf4-7acec001951e",
                                "text": "En lançant aujourd’hui une campagne contre l’autismophobie en France, Olivia Cattan n’a pas peur d’inventer un mot, même un peu imprononçable."
                            },
                            {
                                "example_id": "1a16e0f6-8274-43f1-b621-473356e67f56",
                                "sense_id": "332133b0-13b1-37db-abf4-7acec001951e",
                                "text": "Car faut-il le rappeler, “autiste” n’est pas un adjectif qualifiant un comportement dans l’absolu. Être autiste, c’est avoir un réel handicap. Employer ce terme à tort et à travers relève donc de l’autismophobie, une forme de capacitisme, autrement dit un préjugé envers les personnes vivant un handicap."
                            },
                            {
                                "example_id": "123d0773-94ed-4fbe-a8ff-4310c5bb4643",
                                "sense_id": "332133b0-13b1-37db-abf4-7acec001951e",
                                "text": "Un courant prend actuellement de l’ampleur. Le combat contre l’autismophobie voudrait se séparer ou tout du moins prendre le dessus sur celui contre la psychophobie."
                            }
                        ]
                    }
