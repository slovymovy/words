                "senses": [
                    {
                        "sense_id": "bbdb8e62-1699-3ce0-8622-b54224caad1e",
                        "entry_id": "188348ec-3de2-3b49-a3d3-bfcfbc001623",
                        "glosses": [
                            "Exprime le dépit, un désarroi intense. Ce mot a un sens similaire à l’expression familière et vulgaire « Et merde ! »."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a4ba4126-47be-4b47-ac34-49bb64e4b2ec",
                                "sense_id": "bbdb8e62-1699-3ce0-8622-b54224caad1e",
                                "text": "Groumpf !! Mes images n’ont pas marché !! Bouhouhou !! Que je suis malheureuse !!"
                            },
                            {
                                "example_id": "ee25547a-45b7-457a-8f61-4d562322553d",
                                "sense_id": "bbdb8e62-1699-3ce0-8622-b54224caad1e",
                                "text": "Groumpf, si le plat était raté c'est peut-être qu'il y avait trop de sel…"
                            }
                        ]
                    },
                    {
                        "sense_id": "7450722d-8566-3788-8635-bd8ea8143564",
                        "entry_id": "188348ec-3de2-3b49-a3d3-bfcfbc001623",
                        "glosses": [
                            "Exprime une grande lassitude, un spleen."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "58e77493-52c6-4c24-a716-96b9b08e0c9d",
                                "sense_id": "7450722d-8566-3788-8635-bd8ea8143564",
                                "text": "Groumpf. Grosse crève, pas le moral, je me traîne…"
                            },
                            {
                                "example_id": "0005d3e8-4d0e-476c-8b8a-db818af4e98a",
                                "sense_id": "7450722d-8566-3788-8635-bd8ea8143564",
                                "text": "Non moi pas ragnouf… juste groumpf des fois le matin… parce que je hais le matin."
                            },
                            {
                                "example_id": "d8b202e5-8864-46a6-8bee-362003d919bd",
                                "sense_id": "7450722d-8566-3788-8635-bd8ea8143564",
                                "text": "Quelle journée pourrie, j’aurais mieux fait de ne pas me lever ce matin, groumpf."
                            }
                        ]
                    },
                    {
                        "sense_id": "07fced87-27b4-3e37-a3f7-d2b225ad0707",
                        "entry_id": "188348ec-3de2-3b49-a3d3-bfcfbc001623",
                        "glosses": [
                            "Onomatopée imitant le bruit d’un ogre ou d’un gros animal qui mange goulûment, d’une seule énorme bouchée."
                        ],
