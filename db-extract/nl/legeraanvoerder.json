                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6df6a87-c81c-3b5e-b8a7-6ab3e502bb1f",
                                        "entry_id": "6f538cef-37ce-3ec3-8ef1-93ab1b4081e7",
                                        "glosses": [
                                            "A general servant; a maid-of-all-work."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce5f54c3-8fdb-4e53-8f2f-12fd5ab9668e",
                                                "sense_id": "c6df6a87-c81c-3b5e-b8a7-6ab3e502bb1f",
                                                "text": "Then the servants left and there was only one, a General. A great deal of your comfort and happiness depends on having a good General."
                                            },
                                            {
                                                "example_id": "017feceb-a748-4ac4-b154-9d6884603e46",
                                                "sense_id": "c6df6a87-c81c-3b5e-b8a7-6ab3e502bb1f",
                                                "text": "My general is sister to your second housemaid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf53c45-72c6-3265-b1cc-087cbe5f052c",
                                        "entry_id": "6f538cef-37ce-3ec3-8ef1-93ab1b4081e7",
                                        "glosses": [
