                "senses": [
                    {
                        "sense_id": "45ea215a-9ca2-3c0f-bf73-8da256a126b7",
                        "entry_id": "bb096893-b299-3ed0-b782-cce59e930360",
                        "glosses": [
                            "Éteindre encore une fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3ccd832-eefd-4b0b-9f08-9c9ac8db1b8a",
                                "sense_id": "45ea215a-9ca2-3c0f-bf73-8da256a126b7",
                                "text": "’'Il écrit, éteint, se couche, réfléchit, rallume, ré-écrit, ré-éteint, se re-couche, re-pense. — (Jean-Louis Cluzel, d’Ici, Ailleurs !, 2020)"
                            },
                            {
                                "example_id": "0a24c3bc-e510-464a-85d2-765bc3072116",
                                "sense_id": "45ea215a-9ca2-3c0f-bf73-8da256a126b7",
                                "text": "'Arrêt pour manger, on rentre réceptionner le fioul (on chauffe au fioul une maison qui n’est pas isolée! pff) et premiers messages aux copines, je relance la chaudière et la voilà qui fume ! je ré-éteins tout d’urgence et appelle l’entreprise, le type m’engueule !!!!!!! — (Melly V., Ma vie chez un crustacé pas comme les autres, 2012, page 19)"
                            },
                            {
                                "example_id": "b47558b6-ceaf-4bdf-a707-c7773c0e71c4",
                                "sense_id": "45ea215a-9ca2-3c0f-bf73-8da256a126b7",
                                "text": "'Mais il finit par se remettre à se ré-éteindre comme décrit plus haut... — (site forums.macg.co, 19 juillet 2020)"
                            }
                        ]
                    }
