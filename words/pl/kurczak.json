                {
                    "sense_id": "fa9075ff-1cad-3332-aeff-3dee19e66f43",
                    "sense_definition": "Młody ptak, pisklę kury domowej.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "drób",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mały, żółty <w>kurczak</w> biegał po podwórku za swoją matką.",
                            "target_lang_translations": {
                                "ru": "Маленький жёлтый <w>цыплёнок</w> бегал по двору за своей матерью.",
                                "en": "A small, yellow <w>chick</w> was running around the yard after its mother."
                            }
                        },
                        {
                            "text": "Na wiosnę w gospodarstwie wykluł się niejeden młody <w>kurczak</w>.",
                            "target_lang_translations": {
                                "ru": "Весной в хозяйстве вылупился не один молодой <w>цыплёнок</w>.",
                                "en": "In the spring, more than one young <w>chicken</w> hatched on the farm."
                            }
                        }
                    ],
                    "synonyms": [
                        "kurczę",
                        "kurak",
                        "kogucik"
                    ],
                    "common_phrases": [
                        "młody kurczak",
                        "żółty kurczak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодая птица, птенец домашней курицы.",
                        "en": "A young bird, a chick of a domestic hen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цыплёнок",
                                "target_lang_sense_clarification": "птенец курицы"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "chicken",
                                "target_lang_sense_clarification": "young bird"
                            },
                            {
                                "target_lang_word": "chick",
                                "target_lang_sense_clarification": "baby bird"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4d72258-f484-33eb-9a7d-109deb40b428",
                    "sense_definition": "Mięso z kurczaka lub potrawa przygotowana z tego mięsa.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na dzisiejszy obiad mama przygotowała pyszny pieczony <w>kurczak</w> z ziemniakami.",
                            "target_lang_translations": {
                                "ru": "На сегодняшний обед мама приготовила вкусную жареную <w>курицу</w> с картофелем.",
                                "en": "For today's dinner, mom prepared a delicious roasted <w>chicken</w> with potatoes."
                            }
                        },
                        {
                            "text": "W tej restauracji podają doskonały <w>kurczak</w> z rożna.",
                            "target_lang_translations": {
                                "ru": "В этом ресторане подают отличную <w>курицу</w> гриль.",
                                "en": "They serve excellent rotisserie <w>chicken</w> in this restaurant."
                            }
                        }
                    ],
                    "synonyms": [
                        "kurak"
                    ],
                    "common_phrases": [
                        "pieczony kurczak",
                        "kurczak z rożna",
                        "pierś z kurczaka"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мясо цыплёнка или курицы, а также блюдо, приготовленное из этого мяса.",
                        "en": "Chicken meat or a dish prepared from this meat."
                    },
                    "translations": {
