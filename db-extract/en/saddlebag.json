                    {
                        "translation_id": "4a8baf3e-9972-4e8e-95b1-d3446e8d4b01",
                        "source_entry_id": "70fbbf1e-79da-3033-a626-fd81262deb4a",
                        "source_sense_description": "covered pouch",
                        "target_lang_word": "sacoche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacoche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3e9f3bb-4101-3440-81f9-1740ee19a27f",
                                        "entry_id": "d8aec5f9-693a-3376-86ff-602db0514ff6",
                                        "glosses": [
                                            "Grosse bourse de cuir ordinairement retenue par une courroie et qui se porte au côté ou dans le dos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9494aaf1-4b71-4a09-b4b1-a0ea8d2f2816",
                                                "sense_id": "f3e9f3bb-4101-3440-81f9-1740ee19a27f",
                                                "text": "Voici encore, ajouta maître Jacques en fouillant de nouveau dans sa sacoche, ce que nous avons trouvé chez Marc Cenaine."
                                            },
                                            {
                                                "example_id": "9ac69595-d202-4f7f-a6fd-0a045223a4f0",
                                                "sense_id": "f3e9f3bb-4101-3440-81f9-1740ee19a27f",
                                                "text": "Cet étranger matinal avait un chapeau à trois cornes, sur le dos une sacoche, et à la main un grand portefeuille."
                                            },
                                            {
                                                "example_id": "5a9c0744-c821-48b0-bb5a-d795ec355a9a",
                                                "sense_id": "f3e9f3bb-4101-3440-81f9-1740ee19a27f",
                                                "text": "Je lui eusse offert un de ces londrès de choix dont ma sacoche est largement approvisionnée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99907829-7527-32f3-894d-92241d15e4b6",
                                        "entry_id": "d8aec5f9-693a-3376-86ff-602db0514ff6",
                                        "glosses": [
                                            "Sac de toile forte ou de peau, dans lequel les encaisseurs des maisons de banque et de commerce mettaient les espèces qu’ils étaient chargés de donner ou de recevoir en paiement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f08eb047-a6c6-4bd0-b1be-164bc2533516",
                                                "sense_id": "99907829-7527-32f3-894d-92241d15e4b6",
                                                "text": "Malgré les précautions prises par le notaire, qui vint au-devant de la carriole, il se trouva des témoins, et l’on vit descendre les porte-manteaux et les sacoches qui contenaient l’argent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74c0f0a3-2329-3bb9-a704-ea6a5f7e5bd5",
                                        "entry_id": "d8aec5f9-693a-3376-86ff-602db0514ff6",
                                        "glosses": [
                                            "Sac à main."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c53c4ba-0356-3993-81c8-4e54a1269c99",
                                        "entry_id": "d8aec5f9-693a-3376-86ff-602db0514ff6",
                                        "glosses": [
                                            "Sac à main pour homme dépourvu de courroie mais parfois équipé d’une dragonne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dfe5dd1-9083-3713-9565-038f3f7c1b5e",
                                        "entry_id": "d8aec5f9-693a-3376-86ff-602db0514ff6",
                                        "glosses": [
                                            "Sac accroché sur le porte-bagages, le guidon ou le réservoir d'une bicyclette ou d'une moto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14f8fc38-8480-451e-a9f1-29fb3ad54c66",
                                                "sense_id": "9dfe5dd1-9083-3713-9565-038f3f7c1b5e",
                                                "text": "À la première chute, je n'ai décroché qu'un cale-pied que j'ai ramassé pour le remonter moi-même peu après ; à la deuxième chute, j'ai largué une sacoche, qu'il allait falloir faire réparer avant de la réinstaller ; à la troisième, j'ai perdu ma pompe à vélo, que je ne pourrais remplacer que moyennant finances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "820b5050-a19b-327a-8dfe-02455dc447d0",
                                        "entry_id": "d8aec5f9-693a-3376-86ff-602db0514ff6",
                                        "glosses": [
                                            "Sac qui voyage - ou voyageait avant la dématérialisation totale- entre les bureaux de poste et les centres de chèques postaux. On y mettait, entre autre, les chèques et leurs bordereaux de remise."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85ca82ad-96c3-4bce-8b9e-3abfaacb7b80",
                        "source_entry_id": "70fbbf1e-79da-3033-a626-fd81262deb4a",
                        "source_sense_description": "covered pouch",
                        "target_lang_word": "Satteltasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Satteltasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                        "entry_id": "d01e5179-6c33-3f8c-9dae-99bdc866f7b7",
                                        "glosses": [
                                            "Tasche, die man am Sattel eines Fahrrades/Motorrades oder Reittiers befestigen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9bde212-7b45-48f6-8c5a-b54cf21147ce",
                                                "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                                "text": "„Aber ebenso wie ich den Mini-Sprachführer für Portugiesisch ganz unten in meinen Satteltaschen vergraben hatte, verdrängte ich diese Gedanken, ich würde mich später darum kümmern.“"
                                            },
                                            {
                                                "example_id": "d47efdc0-a392-4598-98f6-157dc800bde6",
                                                "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                                "text": "„Er wollte bei Einbruch der Nacht ganz allein und was das Pferd laufen könne die Stadt verlassen und sich nach Livorno begeben, ohne mehr als das Allernötigste in einer Satteltasche mitzunehmen, insbesondere sein liebes blaues Band.“"
                                            },
                                            {
                                                "example_id": "0365e699-cf2c-4979-b071-aa8aaa7c58ae",
                                                "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                                "text": "„Mit diesen Worten zahlte er an der Bar seine Rechnung, ließ sich die Satteltasche geben, legte sie über den Sattel seines ungeduldig scharrenden Braunen, stieg auf und trabte die Elmstreet hinab in den das Städtchen begrenzenden Wald.“"
                                            },
                                            {
                                                "example_id": "d508ef63-26d6-4e0c-b29a-f1b3aff94809",
                                                "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                                "text": "„Als am Nachmittag des 26. Januars der Reiter mit dem ungeöffneten Brief in der Satteltasche nach Götzlack zurückkehrte, wähnte Else ihren Schwiegervater und die Schwägerin mit dem Treck auf dem Weg gen Westen und konzentrierte sich nun auf die eigene Flucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
