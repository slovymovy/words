    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1a43ecd7-d9f5-3c97-bf06-34ace230048a",
                    "sense_definition": "Having a small distance from one end or edge to another, either horizontally or vertically.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>short</w> path leads directly to the park entrance.",
                            "target_lang_translations": {
                                "ru": "<w>Короткая</w> тропинка ведет прямо к входу в парк."
                            }
                        },
                        {
                            "text": "She decided to wear a <w>short</w> skirt for the summer party.",
                            "target_lang_translations": {
                                "ru": "Она решила надеть <w>короткую</w> юбку на летнюю вечеринку."
                            }
                        }
                    ],
                    "synonyms": [
                        "low",
                        "narrow",
                        "slim",
                        "shallow"
                    ],
                    "antonyms": [
                        "long",
                        "wide",
                        "broad",
                        "deep"
                    ],
                    "common_phrases": [
                        "short distance",
                        "short walk",
                        "short hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий небольшое расстояние от одного конца или края до другого, по горизонтали или вертикали."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "короткий",
                                "target_lang_sense_clarification": "о длине или расстоянии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "519bef4b-9fa5-3fec-b062-dbabf87306fd",
                    "sense_definition": "Of comparatively small height.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was the <w>shortest</w> member of staff in the entire office.",
                            "target_lang_translations": {
                                "ru": "Он был самым <w>низким</w> сотрудником во всем офисе."
                            }
                        },
                        {
                            "text": "Even though he is <w>short</w>, he is a very fast runner.",
                            "target_lang_translations": {
                                "ru": "Несмотря на то, что он <w>невысокого</w> роста, он очень быстро бегает."
                            }
                        }
                    ],
                    "synonyms": [
                        "little",
                        "petite"
                    ],
                    "antonyms": [
                        "tall",
                        "high"
                    ],
                    "common_phrases": [
                        "short person",
                        "short stature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительно небольшой высоты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "низкий",
                                "target_lang_sense_clarification": "о росте"
                            },
                            {
                                "target_lang_word": "невысокий",
                                "target_lang_sense_clarification": "о росте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "884bc1c6-d8a8-363f-8435-10973e82b1b8",
                    "sense_definition": "Having little duration.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our meeting was a <w>short</w> six minutes today.",
                            "target_lang_translations": {
                                "ru": "Наша встреча сегодня длилась всего <w>короткие</w> шесть минут."
                            }
                        },
                        {
                            "text": "The teacher gave us a <w>short</w> break between the two lessons.",
                            "target_lang_translations": {
                                "ru": "Учитель дал нам <w>короткий</w> перерыв между двумя уроками."
                            }
                        }
                    ],
                    "synonyms": [
                        "brief",
                        "concise"
                    ],
                    "antonyms": [
                        "long"
                    ],
                    "common_phrases": [
                        "short time",
                        "short break",
                        "short story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий малую продолжительность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "короткий",
                                "target_lang_sense_clarification": "о времени"
                            },
                            {
                                "target_lang_word": "краткий",
                                "target_lang_sense_clarification": "о длительности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a3b0a8d-b38d-34fe-851e-305981846749",
                    "sense_definition": "Of a word or phrase, constituting an abbreviation for another or a <w>shortened</w> form of another.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The name Alex is <w>short</w> for Alexander or Alexandra.",
                            "target_lang_translations": {
                                "ru": "Имя Алекс — это <w>сокращение</w> от Александра или Александры."
                            }
                        },
                        {
                            "text": "Phone is <w>short</w> for telephone and is used more often now.",
                            "target_lang_translations": {
                                "ru": "Phone — это <w>краткая форма</w> слова telephone, и сейчас она используется чаще."
                            }
                        }
                    ],
                    "synonyms": [
                        "an abbreviation of",
                        "a short form of"
                    ],
                    "common_phrases": [
                        "short for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Являющийся сокращением или сокращенной формой другого слова или фразы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокращение",
                                "target_lang_sense_clarification": "от какого-либо имени или слова"
                            },
                            {
                                "target_lang_word": "краткая форма",
                                "target_lang_sense_clarification": "лингвистика"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8de7820f-0a76-3588-8ed8-7d86bf79df63",
                    "sense_definition": "Limited in quantity; inadequate; insufficient; scanty.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital is currently in <w>short</w> supply of emergency medicine.",
                            "target_lang_translations": {
                                "ru": "В больнице сейчас <w>дефицит</w> лекарств для оказания экстренной помощи."
                            }
                        },
                        {
                            "text": "Water became <w>short</w> during the long summer drought.",
                            "target_lang_translations": {
                                "ru": "Воды стало <w>не хватать</w> во время долгой летней засухи."
                            }
                        }
                    ],
                    "synonyms": [
                        "scrimp"
                    ],
                    "common_phrases": [
                        "short supply",
                        "short notice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограниченный в количестве; недостаточный; скудный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дефицитный",
                                "target_lang_sense_clarification": "о запасах"
                            },
                            {
                                "target_lang_word": "недостаточный",
                                "target_lang_sense_clarification": "о количестве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3877d2f-2c13-338f-8ac4-ffeacc9d33d9",
                    "sense_definition": "Insufficiently provided; inadequately supplied, especially with money; lacking.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would lend you the cash but I am a little <w>short</w> at present.",
                            "target_lang_translations": {
                                "ru": "Я бы одолжил тебе наличных, но сейчас мне самому немного <w>не хватает</w>."
                            }
                        },
                        {
                            "text": "The cashier came up <w>short</w> ten dollars on his morning shift.",
                            "target_lang_translations": {
                                "ru": "У кассира в утреннюю смену <w>не хватило</w> десяти долларов."
                            }
                        }
                    ],
                    "synonyms": [
                        "lacking",
                        "short on"
                    ],
                    "common_phrases": [
                        "short of money",
                        "run short",
                        "come up short"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недостаточно обеспеченный чем-либо, особенно деньгами; испытывающий нехватку."
