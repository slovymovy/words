                ],
                "senses": [
                    {
                        "sense_id": "737f6b38-6f09-3b49-b854-fbccdea68106",
                        "entry_id": "703f20f7-c566-3d36-a315-6877c57a4895",
                        "glosses": [
                            "психол. имеющий отношение к чувственному восприятию, перцепции"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f166764-be39-4fd3-9921-0cd3595975e8",
                                "sense_id": "737f6b38-6f09-3b49-b854-fbccdea68106",
                                "text": "В одних случаях в сенсорике в той или иной мере преобладает аффективный, в другой перцептивный характер, первый по преимуществу в тех видах чувствительности, которые служат главным образом для регулирования внутренних взаимоотношений организма; второй — в тех, которые по преимуществу регулируют его взаимоотношения с окружающей средой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a25ced93-332a-4d69-b29b-e8ebd42846db",
                        "source_entry_id": "703f20f7-c566-3d36-a315-6877c57a4895",
                        "source_sense_id": "737f6b38-6f09-3b49-b854-fbccdea68106",
                        "target_lang_word": "perceptive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perceptive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7bc8ef6-6fd5-332d-b984-d5bfa9206a9e",
                                        "entry_id": "1de9bf7a-fda2-3aff-8be6-419149b2c83b",
                                        "glosses": [
                                            "Having or showing keenness or sharpness of perception, insight, understanding, or intuition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb1d3b42-9de5-48a8-97ac-0c76e3c9c10f",
                                                "sense_id": "f7bc8ef6-6fd5-332d-b984-d5bfa9206a9e",
                                                "text": "He is so perceptive when it comes to other people's feelings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a6fd1eb-f514-46d9-b484-c0f4ee00db26",
                        "source_entry_id": "703f20f7-c566-3d36-a315-6877c57a4895",
                        "source_sense_id": "737f6b38-6f09-3b49-b854-fbccdea68106",
                        "target_lang_word": "perceptual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perceptual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bef1d174-0b57-3ac4-93a8-62e7964ac56d",
                                        "entry_id": "85c62ec5-8d5f-3dd7-ac56-855edf239507",
                                        "glosses": [
                                            "Relating to perception."
                                        ],
                                        "tags": [],
