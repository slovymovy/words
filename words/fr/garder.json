{
    "word_family": [
        "garde",
        "gardien",
        "garderie",
        "sauvegarder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "11e27cda-b3d1-3fd2-94ae-f32f052da743",
                    "sense_definition": "Conserver quelque chose en sa possession, ne pas s'en défaire.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous pouvez <w>garder</w> la monnaie, c'est pour vous."
                        },
                        {
                            "text": "Il m'a demandé de <w>garder</w> ce secret précieusement."
                        }
                    ],
                    "antonyms": [
                        "abandonner",
                        "laisser"
                    ],
                    "common_phrases": [
                        "garder la monnaie",
                        "garder un secret",
                        "garder le silence"
                    ]
                },
                {
                    "sense_id": "f0e124fc-a1e9-3763-bb9e-3cc0993e9a3d",
                    "sense_definition": "Surveiller attentivement une personne ou un lieu pour en assurer la sécurité ou le bien-être.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mes voisins viennent <w>garder</w> les enfants pendant notre absence ce soir."
                        },
                        {
                            "text": "Un chien fidèle <w>garde</w> l'entrée de la maison toute la journée."
                        }
                    ],
                    "antonyms": [
                        "abandonner"
                    ],
                    "common_phrases": [
                        "garder les enfants",
                        "garder la maison"
                    ]
                },
                {
                    "sense_id": "54131f0e-ef99-3349-994e-4d4659d4e70d",
                    "sense_definition": "Mettre de côté ou réserver pour un usage futur.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "reserve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>gardons</w> un peu d'argent pour nos prochaines vacances d'été."
                        },
                        {
                            "text": "Elle a décidé de <w>garder</w> les restes du repas au réfrigérateur."
                        }
                    ],
                    "antonyms": [
                        "laisser"
                    ],
                    "common_phrases": [
                        "garder de l'argent",
                        "garder pour plus tard"
                    ]
                },
                {
                    "sense_id": "fbb66c55-0a1d-31e6-9f5c-72bcd37fca49",
                    "sense_definition": "Rester dans un endroit ou continuer de porter un vêtement sans l'enlever.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "maintien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme il fait très froid, je préfère <w>garder</w> mon manteau dans la pièce."
                        },
                        {
                            "text": "Le médecin lui a formellement conseillé de <w>garder</w> le lit pendant trois jours."
                        }
                    ],
                    "antonyms": [
                        "changer"
                    ],
                    "common_phrases": [
                        "garder le lit",
                        "garder son manteau"
                    ]
                },
                {
                    "sense_id": "18dcaf02-48cc-3cfb-b5ec-a3ed9a4e7cea",
                    "sense_definition": "Retenir une personne auprès de soi pour un moment, un repas ou un emploi.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "retention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise a décidé de <w>garder</w> tous ses employés malgré la crise."
                        },
                        {
                            "text": "Ils ont insisté pour nous <w>garder</w> à dîner ce samedi soir."
                        }
                    ],
                    "antonyms": [
                        "laisser"
                    ],
                    "common_phrases": [
                        "garder a diner"
                    ]
                },
                {
                    "sense_id": "69a4ea90-4a4c-36d5-be38-8bf0791bbd04",
                    "sense_definition": "Prendre garde, s'abstenir soigneusement de faire quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "precaution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il se <w>garde</w> bien d'exprimer son avis devant ses collègues."
                        },
                        {
                            "text": "Elle s'est <w>gardée</w> de faire tout commentaire lors de cette réunion importante."
                        }
                    ],
                    "common_phrases": [
                        "se garder de"
                    ]
                }
            ]
        }
    ]
}