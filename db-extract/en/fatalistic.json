                        "translation_id": "941b5a21-860b-4b9b-9802-ce73622f9a53",
                        "source_entry_id": "2649835e-122b-3d41-850f-8134dfb857da",
                        "source_sense_description": "of or pertaining to fatalism",
                        "target_lang_word": "fatalistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
