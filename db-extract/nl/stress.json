                "senses": [
                    {
                        "sense_id": "f92a24c9-4cd7-3c15-a253-ac3d7ff5b028",
                        "entry_id": "3cda6661-eac3-3839-a83b-08f6dc2cefcb",
                        "glosses": [
                            "zware spanning, geestelijke druk (uit de omgeving)"
                        ],
                        "tags": [
                            "psychische"
                        ],
                        "examples": [
                            {
                                "example_id": "c531f48d-10c4-4681-9b81-3a3509e85d0f",
                                "sense_id": "f92a24c9-4cd7-3c15-a253-ac3d7ff5b028",
                                "text": "\"Veel stress op werk even schadelijk als passief roken\""
                            },
                            {
                                "example_id": "73b45395-cdf8-4a31-aa54-5cbc2fc5248b",
                                "sense_id": "f92a24c9-4cd7-3c15-a253-ac3d7ff5b028",
                                "text": "Verpleegkundigen neonatologie en obstetrie van ZGT Almelo volgen een speciale cursus om stress bij te vroeg geboren kinderen te herkennen en te reduceren. Het moet leiden tot een prestigieus keurmerk."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbd99869-049e-3c16-be63-2d1dff7a32fe",
                        "entry_id": "3cda6661-eac3-3839-a83b-08f6dc2cefcb",
                        "glosses": [
                            "paniek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f43e1b96-b622-4cc8-a3c8-1180380b4f4a",
                                "sense_id": "dbd99869-049e-3c16-be63-2d1dff7a32fe",
                                "text": "Ik schoot in de stress, ik moest en zou mijn dochter spreken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f0cfc88-a390-4abe-ad89-1ae01aec28f4",
                        "source_entry_id": "3cda6661-eac3-3839-a83b-08f6dc2cefcb",
                        "source_sense_id": "f92a24c9-4cd7-3c15-a253-ac3d7ff5b028",
                        "source_sense_description": "spanning, geestelijke druk.",
                        "target_lang_word": "Stress",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stress",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5314363-183e-3dfd-84d0-3e9bf9284817",
                                        "entry_id": "6d080b37-f7d4-3419-9220-baa9517b1d1a",
                                        "glosses": [
                                            "anhaltende geistige, seelische oder körperliche Anspannung durch Überbeanspruchung oder schädliche Reize; seelischer Druck"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdbcc412-a9b1-499f-b427-9e7aacecd220",
                                                "sense_id": "d5314363-183e-3dfd-84d0-3e9bf9284817",
                                                "text": "Als Manager einer Firma steht er ständig unter Stress, was natürlich seiner Gesundheit schadet!"
                                            },
                                            {
                                                "example_id": "24d5bca9-5e1b-4b13-8a90-dd73a108d6db",
                                                "sense_id": "d5314363-183e-3dfd-84d0-3e9bf9284817",
                                                "text": "„So lässt sich ein wohltuenderer Umgang mit Stress erlernen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a96f740d-fc12-3489-a0b7-4dd008fcdf06",
                                        "entry_id": "6d080b37-f7d4-3419-9220-baa9517b1d1a",
                                        "glosses": [
                                            "Ärger, Druck"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "619a8ddf-fd46-4919-b8ba-ba9f435ddba0",
                                                "sense_id": "a96f740d-fc12-3489-a0b7-4dd008fcdf06",
                                                "text": "Mach mir bloß keinen Stress!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b4a43a23-8ddf-3a59-9966-f446ec5190c7",
                                        "entry_id": "6d080b37-f7d4-3419-9220-baa9517b1d1a",
                                        "glosses": [
                                            "einseitig gerichteter Druck, zum Beispiel bei Gesteinsumwandlung"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfd3397a-396b-4dad-a634-ab6444b63ea2",
                                                "sense_id": "b4a43a23-8ddf-3a59-9966-f446ec5190c7",
                                                "text": "Stress spielt bei tektonischen Vorgängen eine große Rolle."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "dd642708-c522-341e-ba2b-82bf1295b39f",
                                        "entry_id": "6d080b37-f7d4-3419-9220-baa9517b1d1a",
                                        "glosses": [
                                            "Reaktion eines Organismus auf die Einwirkung übermäßiger oder widersprechender Reize chemischer, physikalischer oder auch sozialer Art"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bac6531-da05-4003-923b-243f40a34094",
                                                "sense_id": "dd642708-c522-341e-ba2b-82bf1295b39f",
                                                "text": "In der ersten Phase ist Stress eine Alarmreaktion des Körpers, Adrenalin wird ausgeschüttet, die Blutzufuhr zu Hirn und Muskeln steigt."
                                            },
                                            {
                                                "example_id": "654e662a-5610-4792-b175-8db69da93186",
                                                "sense_id": "dd642708-c522-341e-ba2b-82bf1295b39f",
                                                "text": "„Jahresringe deuten schon auf länger anhaltenden Stress der Bäume durch Trockenheit, Krankheit und Schädlinge hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "765a4959-4818-4ef8-9b90-12f4321b86c5",
                        "source_entry_id": "3cda6661-eac3-3839-a83b-08f6dc2cefcb",
