                "senses": [
                    {
                        "sense_id": "ea8163e9-f436-3784-af2d-54aa119354ce",
                        "entry_id": "98edb5d2-68c2-320e-934a-be231b57331b",
                        "glosses": [
                            "Eigenschaft, auf das Notwendige reduzierte (minimale) Ausprägungen zu zeigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c442f5ab-da92-475d-9d1b-46256d1e55f9",
                                "sense_id": "ea8163e9-f436-3784-af2d-54aa119354ce",
                                "text": "„Demzufolge gehört auch zur Minimalität, daß keine Informationsobjekte und Beziehungen modelliert werden dürfen, die für die Anforderungen nicht erforderlich sind.“"
                            },
                            {
                                "example_id": "dc480626-ed5c-4752-892d-2dc6d4e39ea0",
                                "sense_id": "ea8163e9-f436-3784-af2d-54aa119354ce",
                                "text": "„Die Forderung nach Minimalität eines Datenbankschemas soll nun helfen, global Redundanz zu vermeiden.“"
                            },
                            {
                                "example_id": "06d815a4-bf76-44f1-8bb5-d5854da50de8",
                                "sense_id": "ea8163e9-f436-3784-af2d-54aa119354ce",
                                "text": "„Dies kann auch als Forderung nach Minimalität interpretiert werden. Hierzu zählt ebenfalls die Verwendung von methodischen Konstrukten mit minimaler, aber hinreichender semantischer Mächtigkeit.“"
                            },
                            {
                                "example_id": "c0da30d5-716f-4d21-9a90-deb8af9c9791",
                                "sense_id": "ea8163e9-f436-3784-af2d-54aa119354ce",
                                "text": "„Mit den beiden Forderungen nach Eindeutigkeit und Minimalität ist ein Schlüssel vollständig charakterisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
