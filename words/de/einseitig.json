                        {
                            "text": "Wer sich zu <w>einseitig</w> ernährt, riskiert langfristig schwere Probleme mit der Gesundheit."
                        }
                    ],
                    "synonyms": [
                        "monoton",
                        "unausgewogen"
                    ],
                    "antonyms": [
