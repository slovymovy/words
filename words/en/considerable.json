                    "sense_definition": "A thing that must be considered or taken into account.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The safety of the passengers is the first <w>considerable</w> in this plan.",
                            "target_lang_translations": {
                                "ru": "Безопасность пассажиров — это первое <w>обстоятельство</w> в этом плане.",
