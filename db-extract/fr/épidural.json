                        "sense_id": "3e50a136-6fae-3bc7-838b-a3ecdf322209",
                        "entry_id": "567d5e3d-5b73-354c-b6fa-689534580b33",
                        "glosses": [
                            "Relatif à la zone qui entoure la dure-mère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c9cdb56-4856-4045-a9d9-879c87400626",
                                "sense_id": "3e50a136-6fae-3bc7-838b-a3ecdf322209",
                                "text": "Un hématome épidural consiste en une accumulation de sang entre l’os crânien et le premier feuillet des méninges, la dure-mère."
                            },
                            {
                                "example_id": "7ca7c29a-76d6-46b3-9ea5-e3724b314b4d",
                                "sense_id": "3e50a136-6fae-3bc7-838b-a3ecdf322209",
                                "text": "L’espace épidural spinal contient un tissu adipeux aréolaire, des lymphatiques et des plexus veineux."
                            }
                        ]
                    }
                ],
