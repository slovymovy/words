                "senses": [
                    {
                        "sense_id": "ba66bff2-d9e1-369d-9f83-41adda79304c",
                        "entry_id": "479d3a6d-d2ba-39a9-b7a5-b53ed0cacf84",
                        "glosses": [
                            "Fahrt, um zu hamstern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fda75d2f-c290-4f49-98c3-9327485a661f",
                                "sense_id": "ba66bff2-d9e1-369d-9f83-41adda79304c",
                                "text": "„Wenn zum Beispiel Kölner zu Hamsterfahrten nach Gießen oder ins Oldenbuger-Land aufbrachen, weil es dort Butter gab, waren sie womöglich erst drei Tage später zurück.“"
                            },
                            {
                                "example_id": "6a0c0bf9-855e-4cab-94b2-e5d6ab557efa",
                                "sense_id": "ba66bff2-d9e1-369d-9f83-41adda79304c",
                                "text": "„Christel Scheffler, genannt Kitty, ist 1947 bei ihrer ersten Hamsterfahrt mit einer Bekannten der Mutter in Litauen zurückgeblieben.“"
                            },
                            {
                                "example_id": "980a2eaa-16ca-44b5-afc2-f783fca7bb82",
                                "sense_id": "ba66bff2-d9e1-369d-9f83-41adda79304c",
                                "text": "„Jeder, fast jeder hatte Butter auf Schleichwegen gekauft, sich Kartoffeln auf Hamsterfahrten besorgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
