                "senses": [
                    {
                        "sense_id": "593eceba-6048-3059-8ccb-1f6a48bfbc88",
                        "entry_id": "e1250fb5-437e-3811-a86e-79310192fba9",
                        "glosses": [
                            "diminutive of блю́дце (bljúdce): small saucer, small jam dish"
                        ],
                        "tags": [
                            "diminutive",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "49560713-0e62-49db-9bfe-847e8833cb37",
                                "sense_id": "593eceba-6048-3059-8ccb-1f6a48bfbc88",
                                "text": "поднести́ на блю́дечке, поднести́ на блю́дечке с голубо́й каёмочкой",
                                "translation": "to hand on a silver platter",
                                "english": "to hand on a silver platter"
                            },
                            {
                                "example_id": "b6ff8c00-3ac6-4076-b759-b741e8eb0259",
                                "sense_id": "593eceba-6048-3059-8ccb-1f6a48bfbc88",
                                "text": "Он держал на пяти пальцах правой руки блюдечко и пил чай, причём так громко кусал сахар, что Гришину спину подирал мороз.",
                                "translation": "He was balancing a saucer on the five fingers of his right hand and drinking tea out of it, and crunching sugar so loudly that it sent a shiver down Grisha's back.",
                                "english": "He was balancing a saucer on the five fingers of his right hand and drinking tea out of it, and crunching sugar so loudly that it sent a shiver down Grisha's back."
                            }
                        ]
                    }
                ],
