                            },
                            {
                                "target_lang_word": "proud vody",
                                "target_lang_sense_clarification": "krátký proud vody"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fışkırma",
                                "target_lang_sense_clarification": "ani ve kısa süreli su çıkışı"
                            },
                            {
                                "target_lang_word": "püskürme",
                                "target_lang_sense_clarification": "sıvının kısa bir süre havaya savrulması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "923b33db-d7b4-3649-97d5-55338f87c64e",
                    "sense_definition": "A dollar.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
