                        "entry_id": "ef9a0ab8-cb6d-343b-939b-0f2e427bfba3",
                        "glosses": [
                            "ступив, приблизиться вплотную; подойти к подступам"
                        ],
                        "tags": [
                            "о войсках"
                        ],
