                                        "glosses": [
                                            "die ganze (und je nach Definition natürliche) Zahl vor der Eins; die Kardinalität der leeren Menge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d111029-34ab-4521-8efc-468e1779cb03",
                                                "sense_id": "e226c16d-6c09-3bb3-a7a9-6eac0ddcb934",
                                                "text": "Nach der Null folgt die Eins."
                                            },
                                            {
                                                "example_id": "a77ac67f-a5ec-41d8-ab1e-b2194fa79685",
                                                "sense_id": "e226c16d-6c09-3bb3-a7a9-6eac0ddcb934",
                                                "text": "Die Null ist gerade und sie ist weder positiv noch negativ."
                                            },
                                            {
                                                "example_id": "bc3a96f6-3a39-4e43-a0fb-5e4ed5936ea4",
                                                "sense_id": "e226c16d-6c09-3bb3-a7a9-6eac0ddcb934",
                                                "text": "„In Indien wurde unsere Null erfunden, die zusammen mit den anderen neun Ziffern die Grundlage für das Dezimalsystem bildet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "20cb8c34-d37f-320c-bc47-6776dc74be8f",
                                        "entry_id": "0a005ebe-1dfc-38a3-9c1d-0a50fbfb6ad2",
                                        "glosses": [
                                            "die Ziffer Null (0 – in Fremdsprachen auch: ٠, 零, 〇)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41438bdb-5a6a-4339-9805-7eb5c59bf8de",
                                                "sense_id": "20cb8c34-d37f-320c-bc47-6776dc74be8f",
                                                "text": "Die Zahl 1000 hat drei Nullen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9f60f702-0c69-30a0-81b0-3106906fa87c",
                                        "entry_id": "0a005ebe-1dfc-38a3-9c1d-0a50fbfb6ad2",
                                        "glosses": [
                                            "kurz für Nullpunkt (etwa bei einem Thermometer)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e015116-4256-440f-a77e-7ce38f27cf66",
                                                "sense_id": "9f60f702-0c69-30a0-81b0-3106906fa87c",
                                                "text": "Es ist 6 Grad unter Null."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "faca8041-03c6-3db5-ba47-7181c020ee39",
                                        "entry_id": "0a005ebe-1dfc-38a3-9c1d-0a50fbfb6ad2",
                                        "glosses": [
                                            "eine inkompetente Person"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f21b8d0-5e8c-4146-9e70-dbd5b5c26f5c",
                                                "sense_id": "faca8041-03c6-3db5-ba47-7181c020ee39",
                                                "text": "Der Spieler hat schon wieder kein Tor geschossen, was für eine Null!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Null",
