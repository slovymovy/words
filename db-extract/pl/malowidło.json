                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f982646c-c91d-4a42-be1b-86a174dc39e9",
                                "sense_id": "f2f94596-0e67-385f-aefd-32a8da69d3ce",
                                "text": "Na ścianach kościoła pozostały widoczne jeszcze malowidła w stylu bizantyjskim."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d15ce1e6-1d62-3c8a-a2ad-6ed77f8d9b3d",
                        "entry_id": "d56b1563-e7ab-36c0-b5f0-2470a5e00209",
                        "glosses": [
                            "obraz bez wartości"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "4aa9679c-ac37-4ce7-bd6f-34761f4a6939",
                                "sense_id": "d15ce1e6-1d62-3c8a-a2ad-6ed77f8d9b3d",
                                "text": "W urodzinowym prezencie dostałem od cioci malowidło jakiegoś domorosłego artysty."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "854a7804-6722-3669-971b-ff4ed082279e",
                        "entry_id": "d56b1563-e7ab-36c0-b5f0-2470a5e00209",
                        "glosses": [
                            "farba, coś nadającego kolor"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c30bed38-f526-4293-81bb-5c95a6e390c8",
                                "sense_id": "854a7804-6722-3669-971b-ff4ed082279e",
                                "text": "Kobieta zawsze nosi w torebce kosmetyki i malowidła."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
