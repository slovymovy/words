                "senses": [
                    {
                        "sense_id": "2028f0dd-6e64-3264-977e-d296fead92c5",
                        "entry_id": "03a61c39-d4d3-3f72-b9bc-6bf920534a72",
                        "glosses": [
                            "van iets (m.n. een mobiele telefoon) dat je het kunt gebruiken zonder dat je daarvoor je handen nodig hebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4629f330-68d7-48b7-a5f6-f9cf9218c739",
                                "sense_id": "2028f0dd-6e64-3264-977e-d296fead92c5",
                                "text": "Ik hang op,' zei ze, 'want ik bel niet handsfree. Dag.' Ze drukte het gesprek weg, legde het mobieltje op de passagiersstoel en begon de lange rij vrachtauto's voor haar in te halen."
                            },
                            {
                                "example_id": "fd014ac0-9345-48f6-93ba-c511b1d2e11b",
                                "sense_id": "2028f0dd-6e64-3264-977e-d296fead92c5",
                                "text": "Hij stak de handsfree set in de telefoon en vroeg me gehaast welk nummer er gedraaid moest worden. Ik gaf het nummer van Amber door. De telefoon ging over, twee keer, daarna hing de journalist op. Ik wist dat Amber, indien ze het Marokkaanse nummer — beginnend met +212 - in haar schermpje zag oplichten, direct zou terugbellen. We keken beiden gespannen naar de telefoon. Nog geen dertig seconden later belde ze. Ik deed de oordopjes snel in."
                            }
                        ]
                    }
