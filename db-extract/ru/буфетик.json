                "senses": [
                    {
                        "sense_id": "6a1bd8b0-b3bd-39bc-b761-5743751e59df",
                        "entry_id": "48513473-a228-3a64-805d-778040ea074f",
                        "glosses": [
                            "разг. уменьш.-ласк. к буфет (шкаф)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a198dd73-4309-4cd2-8a12-496f0b0e25a7",
                                "sense_id": "6a1bd8b0-b3bd-39bc-b761-5743751e59df",
                                "text": "А жена порх к буфетику и уже рюмочками там звенит."
                            },
                            {
                                "example_id": "94a00176-6448-46d2-ac73-9eb5cbd1acee",
                                "sense_id": "6a1bd8b0-b3bd-39bc-b761-5743751e59df",
                                "text": "Даже в стоящем в простенке между двумя окнами буфетике с застеклённым верхом чашки не стояли, а висели на крючках по стенкам буфета."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a77e3ed-cb7e-3a9d-9c1c-383fb559f7eb",
                        "entry_id": "48513473-a228-3a64-805d-778040ea074f",
                        "glosses": [
                            "разг. уменьш.-ласк. к буфет (закусочная)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dda37140-a745-44bf-8758-59063853a158",
                                "sense_id": "2a77e3ed-cb7e-3a9d-9c1c-383fb559f7eb",
                                "text": "Магазины, частные квартиры, лавчонки и даже буфетики снесены до основания."
                            },
                            {
                                "example_id": "dabb0bcc-9acb-42db-8d89-ea07a7679a84",
                                "sense_id": "2a77e3ed-cb7e-3a9d-9c1c-383fb559f7eb",
                                "text": "…Если хотите, можете скоротать время в крохотном буфетике, взяв стакан чая и бутерброд с селёдкой…"
                            }
                        ]
                    }
                ],
