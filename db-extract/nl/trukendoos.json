                        "glosses": [
                            "hoeveelheid trucjes, vaardigheden waarover iemand beschikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f0e454e-5b3c-4bd7-9034-d5539385def5",
                                "sense_id": "724380e0-fa8c-3481-9b98-4400fe572dd6",
                                "text": "De gitarist trok de gebruikelijke trukendoos open, van het met één hand spelen tot het bespelen van de gitaar met zijn tanden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0888387c-b8f9-4f39-960c-2ace720a8681",
                        "source_entry_id": "a7719a14-5d59-3598-9c2d-3ae71d9a4342",
                        "source_sense_id": "724380e0-fa8c-3481-9b98-4400fe572dd6",
                        "source_sense_description": "hoeveelheid trucjes, vaardigheden waarover iemand beschikt",
                        "target_lang_word": "bag of tricks",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bag of tricks",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e6abdd1-0dfb-3882-9e38-91c1f3ab7e4e",
                                        "entry_id": "f554cd94-a473-398b-a45b-cab931721b8d",
                                        "glosses": [
                                            "A set of skills, techniques, items of information, or other resources used to help achieve professional or personal goals."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d244a4e0-7d01-4e43-9a53-9048871f81c9",
                                                "sense_id": "6e6abdd1-0dfb-3882-9e38-91c1f3ab7e4e",
                                                "text": "\"When the time comes I'll go down in the little bag of tricks and dig up anything you need, from a jig dance to a jimmy and a bottle of soup.\""
                                            },
                                            {
                                                "example_id": "4e0f74e1-61eb-484d-877c-69621088b009",
                                                "sense_id": "6e6abdd1-0dfb-3882-9e38-91c1f3ab7e4e",
                                                "text": "I was expecting the tearful ticking off, the girlish recriminations and all the rest of the bag of tricks along those lines."
                                            },
                                            {
                                                "example_id": "42071d1a-1bb0-48a8-956a-44f9e993e1d9",
                                                "sense_id": "6e6abdd1-0dfb-3882-9e38-91c1f3ab7e4e",
                                                "text": "Daly went to his bag of tricks and found, what else, a way to win."
                                            },
                                            {
                                                "example_id": "21dc634b-ae7a-4f14-b0af-b878bae21b37",
                                                "sense_id": "6e6abdd1-0dfb-3882-9e38-91c1f3ab7e4e",
                                                "text": "But investigators have a hefty bag of tricks to expose them—powder, chemicals, lasers and lights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7610be14-9ba9-3f3e-9044-2f72658f4cd8",
                                        "entry_id": "f554cd94-a473-398b-a45b-cab931721b8d",
                                        "glosses": [
                                            "A collection of items, especially as constituting a very complete set of such items."
                                        ],
                                        "tags": [
                                            "dated",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5cdaf1c-79c6-4003-8889-68a7daecfa0e",
                                                "sense_id": "7610be14-9ba9-3f3e-9044-2f72658f4cd8",
                                                "text": "Instead of to the credit side of my account he had put the whole bag of tricks to my debit."
                                            },
                                            {
                                                "example_id": "d5fb0459-81df-4f5f-8254-4e39ca1303d0",
                                                "sense_id": "7610be14-9ba9-3f3e-9044-2f72658f4cd8",
                                                "text": "When it was built fifteen years ago it was considered a model—six bathrooms, its own electric light plant, steam heating, and independent boiler for hot water, the whole bag of tricks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
