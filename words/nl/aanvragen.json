                {
                    "sense_id": "e37fddd6-097a-35f3-ba87-b9fffc2aef2f",
                    "sense_definition": "iets officieel of formeel verzoeken, zoals een document, lidmaatschap of vergunning",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verzoeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zou graag deze brochure willen <w>aanvragen</w> via de website.",
                            "target_lang_translations": {
                                "en": "I would like to <w>request</w> this brochure via the website.",
                                "ru": "Я хотел бы <w>запросить</w> эту брошюру через веб-сайт."
                            }
                        },
                        {
                            "text": "Je moet op tijd een nieuw paspoort <w>aanvragen</w> bij de gemeente.",
                            "target_lang_translations": {
                                "en": "You must <w>apply for</w> a new passport at the municipality on time.",
                                "ru": "Вы должны вовремя <w>подать заявление</w> на новый паспорт в муниципалитет."
                            }
                        },
                        {
                            "text": "De vluchtelingen <w>vroegen</w> direct na aankomst asiel <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "The refugees <w>applied for</w> asylum immediately after arrival.",
                                "ru": "Беженцы <w>попросили</w> убежища сразу после прибытия."
                            }
                        }
                    ],
                    "synonyms": [
                        "verzoeken"
                    ],
                    "common_phrases": [
                        "paspoort aanvragen",
                        "vergunning aanvragen",
                        "subsidie aanvragen",
                        "asiel aanvragen"
                    ],
                    "target_lang_definitions": {
                        "en": "to request something officially or formally, such as a document, membership, or permit",
