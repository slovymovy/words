                "senses": [
                    {
                        "sense_id": "64209ade-3ac2-3691-9043-82131668dd5f",
                        "entry_id": "eece0fa0-df33-3ad8-812a-13af65b48702",
                        "glosses": [
                            "Fülle verschiedener Ausprägungen (Stoffe, Objekte), die einen Geruch abgeben und Geruchswahrnehmungen auslösen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54d4cc3c-bd08-4ca5-9821-a55891b29389",
                                "sense_id": "64209ade-3ac2-3691-9043-82131668dd5f",
                                "text": "„Kaum ein anderes Getränk kann eine solche Geschmacks- und Geruchsvielfalt vorweisen wie das Bier.“"
                            },
                            {
                                "example_id": "c294a49c-b319-4a31-afc8-024a094deceb",
                                "sense_id": "64209ade-3ac2-3691-9043-82131668dd5f",
                                "text": "„Es ist auch wichtig, dass die Sektgläser richtig gefüllt werden, nämlich nur bis zu etwa 2/3, damit sich die Geruchsvielfalt voll entfalten kann.“"
                            },
                            {
                                "example_id": "7fbe008a-ed06-4d2d-b542-a42aed91b7cc",
                                "sense_id": "64209ade-3ac2-3691-9043-82131668dd5f",
                                "text": "„Die Farben- und Geruchsvielfalt kann man hier schwer darstellen, aber zumindest einen kleinen Überblick über typisch orientalische Gewürze.“"
                            },
                            {
                                "example_id": "0470fc5c-db66-4c2a-900a-b65b140fcb02",
                                "sense_id": "64209ade-3ac2-3691-9043-82131668dd5f",
                                "text": "„Die Sortenvielfalt, der Geschmack, der Boden, die Gärung, die Verarbeitung, die geographische Lage, die Mystik und die Geruchsvielfalt sind nur einige Attribute, welche die beiden Produkte so faszinierend machen.“"
                            },
                            {
                                "example_id": "7678b038-44ef-4f27-8378-ef90cf143cc3",
                                "sense_id": "64209ade-3ac2-3691-9043-82131668dd5f",
                                "text": "„Läuft man durch die Stadt, merkt man sehr schnell, dass sich unsere europäischen Nasen erstmal an die Geruchsvielfalt und vor allem das Geruchsniveau gewöhnen müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
