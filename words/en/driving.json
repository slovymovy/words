{
    "word_family": [
        "drive",
        "driver",
        "driveway",
        "overdrive",
        "screwdriver",
        "drivetrain"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99bd675b-11f7-35e7-ba26-87e1e9bf96e5",
                    "sense_definition": "Present participle and gerund of <w>drive</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>driving</w> to the supermarket to buy some groceries.",
                            "target_lang_translations": {
                                "ru": "Я <w>еду</w> в супермаркет, чтобы купить продукты.",
                                "de": "Ich <w>fahre</w> zum Supermarkt, um Lebensmittel einzukaufen."
                            }
                        },
                        {
                            "text": "She was <w>driving</w> carefully because of the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Она <w>вела машину</w> осторожно из-за сильного дождя.",
                                "de": "Sie <w>fuhr</w> wegen des starken Regens vorsichtig."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола <w>drive</w>.",
                        "de": "Partizip Präsens und Gerundium des Verbs 'drive' (fahren, steuern)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести машину",
                                "target_lang_sense_clarification": "управлять автомобилем"
                            },
                            {
                                "target_lang_word": "ехать",
                                "target_lang_sense_clarification": "передвигаться за рулем"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fahrend",
                                "target_lang_sense_clarification": "Partizip Präsens von fahren"
                            },
                            {
                                "target_lang_word": "das Fahren",
                                "target_lang_sense_clarification": "Gerundium, die Tätigkeit des Fahrens"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "158ea2c7-0fa5-327c-b88f-f10d30282403",
                    "sense_definition": "The activity of operating and controlling a motor vehicle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "noun_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was arrested for reckless <w>driving</w> after the accident.",
                            "target_lang_translations": {
                                "ru": "Его арестовали за неосторожное <w>вождение</w> после аварии.",
                                "de": "Er wurde nach dem Unfall wegen rücksichtslosen <w>Fahrens</w> festgenommen."
                            }
                        },
                        {
                            "text": "My father thinks that night <w>driving</w> is too dangerous for me.",
                            "target_lang_translations": {
                                "ru": "Мой отец считает, что ночное <w>вождение</w> слишком опасно для меня.",
                                "de": "Mein Vater hält das <w>Autofahren</w> bei Nacht für zu gefährlich für mich."
                            }
                        }
                    ],
                    "synonyms": [
                        "motoring"
                    ],
                    "common_phrases": [
                        "driving license",
                        "drunk driving",
                        "reckless driving",
                        "safe driving"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность по управлению и контролю автотранспортным средством.",
                        "de": "Die Tätigkeit des Bedienens und Steuerns eines Kraftfahrzeugs."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вождение",
                                "target_lang_sense_clarification": "управление транспортным средством"
                            },
                            {
                                "target_lang_word": "езда",
                                "target_lang_sense_clarification": "процесс перемещения на транспорте"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Fahren",
                                "target_lang_sense_clarification": "allgemeine Tätigkeit des Lenkens eines Fahrzeugs"
                            },
                            {
                                "target_lang_word": "Autofahren",
                                "target_lang_sense_clarification": "spezifisch das Fahren eines Autos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "baa792d9-84c3-32b4-b119-fc3ba7de600b",
                    "sense_definition": "The act of hitting a golf ball a long distance, usually from the tee.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>driving</w> has improved significantly since he bought new clubs.",
                            "target_lang_translations": {
                                "ru": "Его <w>драйв</w> значительно улучшился с тех пор, как он купил новые клюшки.",
                                "de": "Sein <w>Drive</w> hat sich deutlich verbessert, seit er neue Schläger gekauft hat."
                            }
                        },
                        {
                            "text": "We spent the afternoon practicing our <w>driving</w> at the range.",
                            "target_lang_translations": {
                                "ru": "Мы провели день, отрабатывая <w>драйв</w> на тренировочном поле.",
                                "de": "Wir haben den Nachmittag damit verbracht, unsere <w>Drives</w> auf der Driving Range zu üben."
                            }
                        }
                    ],
                    "common_phrases": [
                        "driving range"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный удар по мячу в гольфе на дальнюю дистанцию, обычно первый с подставки (ти).",
                        "de": "Der Schlag beim Golf, um den Ball über eine weite Distanz zu befördern, meist vom Abschlag."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драйв",
                                "target_lang_sense_clarification": "термин в гольфе"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Drive",
                                "target_lang_sense_clarification": "Fachbegriff im Golfsport für den weiten Abschlag"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3765765b-fd30-300e-8403-8da6c800e55b",
                    "sense_definition": "Used to describe rain, snow, or wind that is falling or blowing with great force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adj_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could hardly see the road through the <w>driving</w> rain.",
                            "target_lang_translations": {
                                "ru": "Мы с трудом видели дорогу сквозь <w>хлещущий</w> дождь.",
                                "de": "Wir konnten die Straße durch den <w>peitschenden</w> Regen kaum sehen."
                            }
                        },
                        {
                            "text": "The <w>driving</w> wind made it difficult to walk upright.",
                            "target_lang_translations": {
                                "ru": "<w>Сильный</w> ветер мешал идти прямо.",
                                "de": "Der <w>stürmische</w> Wind machte es schwierig, aufrecht zu gehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "violent",
                        "forceful",
                        "strong"
                    ],
                    "antonyms": [
                        "calm",
                        "gentle"
                    ],
                    "common_phrases": [
                        "driving rain",
                        "driving snow",
                        "driving wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для описания дождя, снега или ветра, падающего или дующего с огромной силой.",
                        "de": "Wird verwendet, um Regen, Schnee oder Wind zu beschreiben, der mit großer Kraft auftrifft."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлещущий",
                                "target_lang_sense_clarification": "о сильном дожде или ветре"
                            },
                            {
                                "target_lang_word": "сильный",
                                "target_lang_sense_clarification": "обладающий большой силой"
                            },
                            {
                                "target_lang_word": "проливной",
                                "target_lang_sense_clarification": "очень сильный (о дожде)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "peitschend",
                                "target_lang_sense_clarification": "sehr starker, schlagender Regen oder Wind"
                            },
                            {
                                "target_lang_word": "stürmisch",
                                "target_lang_sense_clarification": "von großer Kraft begleitet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac6178b1-d302-394c-90e1-b21bd5471f68",
                    "sense_definition": "Having the power to make things happen or to influence a situation strongly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adj_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ambition was the <w>driving</w> force behind his rapid success.",
                            "target_lang_translations": {
                                "ru": "Амбиции были <w>движущей</w> силой его быстрого успеха.",
                                "de": "Ehrgeiz war die <w>treibende</w> Kraft hinter seinem schnellen Erfolg."
                            }
                        },
                        {
                            "text": "She played a <w>driving</w> role in organizing the charity event.",
                            "target_lang_translations": {
                                "ru": "Она сыграла <w>ведущую</w> роль в организации благотворительного мероприятия.",
                                "de": "Sie spielte eine <w>maßgebliche</w> Rolle bei der Organisation der Wohltätigkeitsveranstaltung."
                            }
                        }
                    ],
                    "synonyms": [
                        "propelling",
                        "motivating",
                        "dynamic"
                    ],
                    "antonyms": [
                        "passive"
                    ],
                    "common_phrases": [
                        "driving force",
                        "driving ambition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий силой, способной привести что-либо в движение или сильно повлиять на ситуацию.",
                        "de": "Die Kraft besitzend, Dinge in Bewegung zu setzen oder eine Situation maßgeblich zu beeinflussen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "движущий",
                                "target_lang_sense_clarification": "побуждающий к действию"
                            },
                            {
                                "target_lang_word": "ведущий",
                                "target_lang_sense_clarification": "главный, направляющий"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "treibend",
                                "target_lang_sense_clarification": "etwas voranbringend oder motivierend"
                            },
                            {
                                "target_lang_word": "maßgeblich",
                                "target_lang_sense_clarification": "einen entscheidenden Einfluss ausübend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}