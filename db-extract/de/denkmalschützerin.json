                "senses": [
                    {
                        "sense_id": "d5dd26af-9bb5-3675-ab23-dffe29158edc",
                        "entry_id": "410b98e9-ad4c-3eef-8648-38a5aa8fdfe0",
                        "glosses": [
                            "weibliche Person, die sich dem Erhalt und der Sicherung von (Kultur-)Denkmalen widmet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fdc9bbd-2751-4a61-bca2-bc1edac31bed",
                                "sense_id": "d5dd26af-9bb5-3675-ab23-dffe29158edc",
                                "text": "„Zu diesem äußersten Mittel griff die Denkmalschützerin, weil Behörde und Messe-Management noch keine Einigung gefunden hatten, wie die 30 Tonnen schwere künstliche Fassade mit ihren 12.000 Stahlträgern am Dach des Baudenkmals befestigt werden sollten, das einige Meter über das Flugfeld hinausragt.“"
                            },
                            {
                                "example_id": "9ea79e4c-dbbe-4618-84d7-154deb737d63",
                                "sense_id": "d5dd26af-9bb5-3675-ab23-dffe29158edc",
                                "text": "„Sollte sie Beschädigungen an der Kirche feststellen, werde sie die Staatsanwaltschaft einschalten, kündigte dem gegenüber die oberste Denkmalschützerin der Wojwodschaft Posen an.“"
                            },
                            {
                                "example_id": "82fc127a-32f6-4f35-9fe1-37dbb6c572c8",
                                "sense_id": "d5dd26af-9bb5-3675-ab23-dffe29158edc",
                                "text": "„Die florentinische Chefrestauratorin meldete plötzlich Bedenken an und schmiss ihren Job, die Kulturvereinigung Italia Nostra erstattete Anzeige wegen Vandalismus gegen Bürgermeister Matteo Renzi und die oberste Denkmalschützerin Cristina Acidini, und zahlreiche in- und ausländische Experten forderten empört, die Untersuchung sofort zu stoppen und erst einmal eine weitere Expertenkommission einzusetzen.“"
                            },
                            {
                                "example_id": "2be08a16-1179-4ea6-a5f3-b232968ff8b9",
                                "sense_id": "d5dd26af-9bb5-3675-ab23-dffe29158edc",
                                "text": "„Auch Kreisbaumeisterin Reinlinde Leitz kennt in ihrer Funktion als oberste staatliche Denkmalschützerin im Landkreis das Gebäude.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
