    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ad959dae-7974-3278-8f87-cbd7e95e2144",
                "word": "moxie",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "402fc2a4-0cc5-3f1b-a84e-5fbe3054d32f",
                        "entry_id": "ad959dae-7974-3278-8f87-cbd7e95e2144",
                        "glosses": [
                            "Nerve, spunk, strength of character."
                        ],
                        "tags": [
                            "US",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f0160518-96b1-4db3-a8c9-6a6f892886e6",
                                "sense_id": "402fc2a4-0cc5-3f1b-a84e-5fbe3054d32f",
                                "text": "“Most definitely not!” replied Ms. Summers, who quickly added that she admired the woman’s moxie and, anyway, the day was hot."
                            },
                            {
                                "example_id": "7a9a0c62-8095-44c7-a9d2-9468cae96f92",
                                "sense_id": "402fc2a4-0cc5-3f1b-a84e-5fbe3054d32f",
                                "text": "Aline Brosh McKenna, one of the creators of The CW TV series Crazy Ex-Girlfriend, told a reporter in 2020: “I often say, ‘Lord, give me the moxie of a post-menopausal women^([sic]) who gives absolutely no fucks.’”"
                            }
                        ]
                    },
                    {
                        "sense_id": "9d593b13-6b61-385e-90c9-18e0ff2942c0",
                        "entry_id": "ad959dae-7974-3278-8f87-cbd7e95e2144",
                        "glosses": [
                            "Verve."
                        ],
                        "tags": [
                            "US",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b934227-c91d-46f2-8259-c010798bb788",
                                "sense_id": "9d593b13-6b61-385e-90c9-18e0ff2942c0",
                                "text": "As a girl she had speed and a knock-kneed moxie at athletics, and might have done more with it if she hadn't harvested all the glory already."
                            },
                            {
                                "example_id": "e14c77d5-944d-49f2-875f-82c6f59d5406",
                                "sense_id": "9d593b13-6b61-385e-90c9-18e0ff2942c0",
                                "text": "Yes it's true! / That you seem a little young to do the things that you do, / even with all that moxie you've got."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5d4a885-97b3-34aa-a5cc-646738675acb",
                        "entry_id": "ad959dae-7974-3278-8f87-cbd7e95e2144",
                        "glosses": [
                            "Wit, smarts, skill."
                        ],
                        "tags": [
                            "US",
                            "informal",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
