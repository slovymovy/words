                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "152633aa-d510-414f-9a65-e66c9c715783",
                                                "sense_id": "b1d2d7a0-7c25-34e0-a241-e3b26fae681c",
                                                "text": "The insertive partner or the receptive one?"
                                            },
                                            {
                                                "example_id": "6925e5f9-058b-460d-8c0b-fb8668ca3b49",
                                                "sense_id": "b1d2d7a0-7c25-34e0-a241-e3b26fae681c",
                                                "text": "It is possible that a larger proportion of infections may be attributable to insertive anal intercourse at this time compared to earlier in the epidemic."
                                            },
                                            {
                                                "example_id": "866eb75e-bdc5-420c-b20f-b1a9a1973910",
                                                "sense_id": "b1d2d7a0-7c25-34e0-a241-e3b26fae681c",
                                                "text": "Insertive interdisciplinary applications are an important element in the development and longevity of a school of thought, a fact that PKE seems to have missed."
                                            },
                                            {
                                                "example_id": "0d1b0fe1-c5e6-4874-b4d3-3c1424793edb",
                                                "sense_id": "b1d2d7a0-7c25-34e0-a241-e3b26fae681c",
                                                "text": "The Ln-N s-bond insertive mechanism prevails for the examined intramolecular hydroamination of (4E,6)-heptadienylamine 1t by [Cp*(2)La-CH(TMS)(2)] starting material 2."
