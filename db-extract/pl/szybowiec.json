                        ]
                    },
                    {
                        "translation_id": "248e69b7-8cd7-47c7-b7ae-288bb8853e15",
                        "source_entry_id": "e3655838-4488-3c6b-8524-668460c1cd20",
                        "source_sense_id": "e8ffc195-350e-30d2-8a42-ceb55dbd99bc",
                        "target_lang_word": "Segelflugzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Segelflugzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                        "entry_id": "bbddc179-ac28-3de6-8bbd-0354c9a3a0a4",
                                        "glosses": [
                                            "ein für den Segelflug konstruiertes Luftfahrzeug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78e87749-b936-4ea9-aa0f-768ee2805bf1",
                                                "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                                "text": "„Der erfahrene Pilot besteigt sein Segelflugzeug mit nicht mehr Angst als der Autofahrer sein Auto.“"
                                            },
                                            {
                                                "example_id": "2e3c22fc-b291-4f92-b997-3fcfd6336684",
                                                "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                                "text": "„Die Erlaubnis für Außenlandungen von Motorseglern und Segelflugzeugen, die sich auf einem Überlandflug befinden, gilt als erteilt.“"
                                            },
                                            {
                                                "example_id": "203a9dcc-37b8-406a-a819-6b372da1e15a",
                                                "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                                "text": "Ein Segelflugzeug hat keinen eigenen Motor, aber sehr lange Tragflächen."
                                            },
                                            {
                                                "example_id": "afa443ee-21bd-4afd-b6b4-a798a93f058f",
                                                "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                                "text": "Bereits nach dem ersten Weltkrieg entstanden die ersten Akaflieg-Gruppen; mit Segelflugzeugen konnten Flieger das Versailler Flugverbot umgehen."
                                            },
                                            {
                                                "example_id": "bc106b42-ab59-4bee-ab36-c3243cd93c10",
                                                "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                                "text": "„Papa bastelte im Keller ein großes Segelflugzeug aus Holz.“"
                                            },
                                            {
                                                "example_id": "0d9a9b95-a66d-47be-ac81-49e4bd6acb84",
                                                "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                                "text": "„Die besten Hängegleiter erzielen heute Flugleistungen, die an die früher Segelflugzeuge anknüpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
