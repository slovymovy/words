                "senses": [
                    {
                        "sense_id": "fcf1f7a0-ea73-3b96-a1f5-03866470f5ad",
                        "entry_id": "07300516-ff46-389f-b950-78ddd392fc5d",
                        "glosses": [
                            "sponsor offering financial support in sports, arts or cultural actions in exchange for notoriety"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "3167961d-7346-4107-9c8f-ba0f96a00665",
                                "sense_id": "fcf1f7a0-ea73-3b96-a1f5-03866470f5ad",
                                "text": "Pour mieux trouver le commettant, ou le « sponsor » qui financera les travaux, le chercheur définit un programme, chiffré en temps et en argent. (L'Expansion, févr. 1972, p. 30, col. 2)"
                            }
                        ]
                    },
                    {
                        "sense_id": "66b9f446-df13-3d04-912c-a362f8c882e7",
                        "entry_id": "07300516-ff46-389f-b950-78ddd392fc5d",
                        "glosses": [
                            "sponsor cashing on foreign investors"
                        ],
                        "tags": [
                            "East",
                            "Middle",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "beb4e4c2-fe94-4071-81fc-76eab0877063",
                                "sense_id": "66b9f446-df13-3d04-912c-a362f8c882e7",
                                "text": "Vous voulez faire des affaires au Koweit ? Il faut d'abord trouver un sponsor, koweitien, savoir qu'il vous prendra un honnête pourcentage (13 à 15 %) mais refusera d'endosser le moindre risque et disparaîtra au premier accrochage. (Le Nouvel Observateur, 4 févr. 1974, p. 29, col. 2)"
                            }
                        ]
                    }
                ],
