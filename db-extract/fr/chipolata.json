                                "target_senses": [
                                    {
                                        "sense_id": "d7eed339-b8b4-3184-8240-a33f1a248179",
                                        "entry_id": "a8deb751-7fc0-3b2d-926e-36cd2ddb3e02",
                                        "glosses": [
                                            "een klein (vers) worstje dat oorspronkelijk uit Frankrijk komt en gemaakt is van varkensvlees"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49629c21-b789-49aa-8a7c-85630f26f8b7",
                                                "sense_id": "d7eed339-b8b4-3184-8240-a33f1a248179",
                                                "text": "Knakworst, chipolata, merguez, bockworst, frankfurter. Deze worstjes worden bij voorkeur verpakt in schapendarm, het beste omhulsel voor worst met een kleine diameter. Schapendarm is zacht, maar sterk genoeg om vullen, koken en roken te doorstaan."
                                            },
                                            {
                                                "example_id": "7cb385e7-e58a-4e75-8f8b-4ad423d17b2b",
                                                "sense_id": "d7eed339-b8b4-3184-8240-a33f1a248179",
                                                "text": "Als ik met ouder worden iets verloren ben, dan mijn hang naar absolute consequentie. Je zal me niet snel een steak zien bestellen op restaurant, maar evenmin haal ik de parmaham uit de risotto die je me voorzet. Waardoor ik, eerlijk is eerlijk, geen al te best parcours aan het lopen ben met mijn Dagen zonder Vlees. Een rest chipolata hier, een stukje overgebleven kip of tonijnsla daar, en dan nog een sushi-traktatie van een vriendin, en voor je het weet, heb je maar twee vleesloze dagen van de zeven."
                                            },
                                            {
                                                "example_id": "cec96c31-e6d6-4b46-b926-a8fc4dff8e5c",
                                                "sense_id": "d7eed339-b8b4-3184-8240-a33f1a248179",
                                                "text": "Vrijdagmiddag rodepoonfilet met spinazie en aardappelen natuur, vrijdagavond chipolata met lookboter en aardappel in de pel. Er is altijd een saladbar, brood en charcuterie. En dan heb ik het nog niet over het vieruurtje – waarover later meer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e887fb84-3e18-3445-b68b-e46a291224d6",
                                        "entry_id": "a8deb751-7fc0-3b2d-926e-36cd2ddb3e02",
                                        "glosses": [
                                            "pudding bereid met biscuits, rozijnen en likeur"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
