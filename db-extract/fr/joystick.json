                                "target_senses": [
                                    {
                                        "sense_id": "707b02ae-84b2-3b27-beb1-8ca1238ebd99",
                                        "entry_id": "54709cce-98dc-3b70-b92f-49bc7d4abe9c",
                                        "glosses": [
                                            "Name eines Eingabegerätes für Spiele in Form eines Hebels und meist mehrerer Knöpfe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8a9882-a102-4a33-ab52-f55b6d62c385",
                                                "sense_id": "707b02ae-84b2-3b27-beb1-8ca1238ebd99",
                                                "text": "Heutzutage werden kaum noch Joysticks benutzt."
                                            },
                                            {
                                                "example_id": "22a4d5c9-5e76-471b-939d-fbec39ce298b",
                                                "sense_id": "707b02ae-84b2-3b27-beb1-8ca1238ebd99",
                                                "text": "„Bedient wird der Boxmover über eine Funkfernsteuerung, wobei man angesichts konventioneller Kransteuerungen mit mehreren Joysticks erst Erfahrungen sammeln musste.“"
                                            },
                                            {
                                                "example_id": "5cdcd3da-c333-45f1-8051-d2fd0dd31791",
                                                "sense_id": "707b02ae-84b2-3b27-beb1-8ca1238ebd99",
                                                "text": "„Immer waren irgendwelche Jungs da, um mit meinen Brüdern zu spielen, sie lungerten mit ihren Joysticks auf dem Wasserbett herum, während wir, die Mädchen aus meiner Klasse und ich, uns auf dem Boden zusammendrängten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
