                        "glosses": [
                            "In great quantity or abundance; in a profuse manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb549aea-8184-4e35-bd50-52374259609e",
                                "sense_id": "288be8f8-4a7e-3acd-a018-0d560777af26",
                                "text": "The run left him sweating profusely."
                            },
                            {
                                "example_id": "7eda0cae-e0c9-43ae-9935-ad4de5541d23",
                                "sense_id": "288be8f8-4a7e-3acd-a018-0d560777af26",
                                "text": "\"Oh, I say! By Jove! What!\" was his oration, after which he resumed his seat and perspired profusely."
                            },
                            {
                                "example_id": "42cb2eef-8485-43aa-869c-f3111b232d7b",
                                "sense_id": "288be8f8-4a7e-3acd-a018-0d560777af26",
                                "text": "A shrubby species suitable for beefarming, as it flowers profusely from November-January, and yields both pollen and nectar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
