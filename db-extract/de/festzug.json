                    },
                    {
                        "form_id": "14adc501-8b35-49a0-a828-d00c523be24f",
                        "entry_id": "7476f59a-36f5-37d8-8576-922c128fa7b4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Festzüge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00f2a0f8-9552-3f9b-8ef9-2ae0fe72f17f",
                        "entry_id": "7476f59a-36f5-37d8-8576-922c128fa7b4",
                        "glosses": [
                            "Umzug durch eine Stadt oder eine Gemeinde anlässlich eines großen Festes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f05e1e8-2749-4b71-9859-c8f5563db985",
                                "sense_id": "00f2a0f8-9552-3f9b-8ef9-2ae0fe72f17f",
                                "text": "„Die ‚Lade‘ ursprünglich als Schreibtruhe verwendet, in der Amtssiegel, Formulare und Gemeindekasse verwahrt wurden, wird dabei vom Haus des Altbürgermeisters im Rahmen eines Festzuges zum neuen Bürgermeister gebracht.“"
                            },
                            {
                                "example_id": "1d1d1e52-b727-4129-b62a-81c8ddb152a4",
                                "sense_id": "00f2a0f8-9552-3f9b-8ef9-2ae0fe72f17f",
                                "text": "„Das pharaonische Gegenstück zu dieser Szene ist der im Tempel zu Luxor dargestellte Festzug der heiligen Barke, die von Militärmusikern begleitet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32b46eda-7e48-4134-9fa4-4a2f9e7f2223",
                        "source_entry_id": "7476f59a-36f5-37d8-8576-922c128fa7b4",
                        "source_sense_id": "00f2a0f8-9552-3f9b-8ef9-2ae0fe72f17f",
                        "source_sense_description": "Umzug durch eine Stadt oder eine Gemeinde anlässlich eines großen Festes",
                        "target_lang_word": "cortège",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cortège",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a65dd52-0d2c-3a88-8d10-478482272801",
                                        "entry_id": "4ea942bc-d3d2-33f2-a140-f6048b183533",
                                        "glosses": [
                                            "Suite de personnes qui en accompagnent une autre avec cérémonie et pour lui faire honneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29fd486f-f679-4fe1-ad98-e1c72abf951a",
                                                "sense_id": "0a65dd52-0d2c-3a88-8d10-478482272801",
                                                "text": "Les souverains, pendant tout leur séjour, furent accompagnées d’un imposant cortège."
                                            },
                                            {
                                                "example_id": "954dd9a9-b597-49a3-bc99-334cbceab5d1",
                                                "sense_id": "0a65dd52-0d2c-3a88-8d10-478482272801",
                                                "text": "Grossir le cortège."
                                            },
                                            {
                                                "example_id": "717e5d0d-898b-4d34-86bf-143c9b9c51bd",
                                                "sense_id": "0a65dd52-0d2c-3a88-8d10-478482272801",
                                                "text": "Le cortège se mit en marche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2634870-e0bb-3773-b7eb-146fcfcc4442",
                                        "entry_id": "4ea942bc-d3d2-33f2-a140-f6048b183533",
                                        "glosses": [
                                            "Groupe qui défile dans les rues d'un village en signe de protestation, de revendication ou de solidarité."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e08f0804-632f-4abc-b2bd-ee9ad1d9dd44",
                                                "sense_id": "c2634870-e0bb-3773-b7eb-146fcfcc4442",
                                                "text": "La tête du cortège, c’était nous, c’est-à-dire Germinal, la jeunesse syndicaliste derrière son drapeau noir. C’est ici qu’étaient groupés les éléments les plus ardemment révolutionnaires de la jeunesse du pays."
                                            },
                                            {
                                                "example_id": "3277a1d2-f3f5-4f7b-8d3b-b4bea7bd9636",
                                                "sense_id": "c2634870-e0bb-3773-b7eb-146fcfcc4442",
                                                "text": "Le garde champêtre, armé d’un fusil que lui avait confié le maire, et suivi d’un cortège nombreux, s’avança jusqu’à dix pas du chien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "824ba8c6-035b-3881-b30a-9ff55cc046de",
                                        "entry_id": "4ea942bc-d3d2-33f2-a140-f6048b183533",
                                        "glosses": [
                                            "Suite, série, accompagnement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aeae15c-f590-4e0d-8266-a25536d94734",
                                                "sense_id": "824ba8c6-035b-3881-b30a-9ff55cc046de",
                                                "text": "Le prêtre Gauchelin, du diocèse de Lisieux, assiste, durant une nuit de janvier 1092, au défilé de la Chevauchée infernale, cortège d’âmes captives entraînées par le démon en punition de leurs péchés ; parmi elles, il en reconnaît quelques-unes avec lesquelles il s’entretient."
                                            },
                                            {
                                                "example_id": "bb5c6958-c2da-4c60-a015-ee7e4bf567aa",
                                                "sense_id": "824ba8c6-035b-3881-b30a-9ff55cc046de",
                                                "text": "De temps en temps, un requin paraissait à la surface avec son cortège habituel de rémoras parasites et de poissons-pilotes."
                                            },
                                            {
                                                "example_id": "855b3bfa-cdea-4cd3-a14e-f8cd91384a76",
                                                "sense_id": "824ba8c6-035b-3881-b30a-9ff55cc046de",
                                                "text": "Le bateau s’enfonce dans l’obscurité. Le projecteur fixé au-dessus du chalut éclaire les eaux vertes et écumantes qu’accompagne le cortège des mouettes."
                                            },
                                            {
                                                "example_id": "58830809-b22b-4aca-a174-cf32254e2f02",
                                                "sense_id": "824ba8c6-035b-3881-b30a-9ff55cc046de",
                                                "text": "La Pauvreté, ah ! la garce ! Elle va dans un cortège d’humiliations, de basses rancunes, de fangeuses abdications. Elle traîne, derrière elle, se sœur la Misère, au rire édenté, aux orbites desséchées, aux doigts mous."
                                            },
                                            {
                                                "example_id": "db743c64-abc4-42b9-9a2e-28a9e3fe012d",
                                                "sense_id": "824ba8c6-035b-3881-b30a-9ff55cc046de",
                                                "text": "Malgré les soins culturaux, le cortège floristique des cultures sarclées diffère assez peu de celui de nos moissons siliceuses."
                                            },
                                            {
                                                "example_id": "035d0157-6bb8-46e6-b597-1c898d9541bb",
                                                "sense_id": "824ba8c6-035b-3881-b30a-9ff55cc046de",
                                                "text": "La calotte glaciaire de l’Europe s’est réfugiée en Scandinavie avec son cortège de plantes boréales."
                                            },
                                            {
                                                "example_id": "482fc0c1-b30a-4377-a083-40888459c951",
                                                "sense_id": "824ba8c6-035b-3881-b30a-9ff55cc046de",
                                                "text": "Et puis on découvrit — ce dont on aurait pu se douter à l’avance — que le rétablissement de la royauté, à la Henri V, c’est-à-dire avec son cortège d’idées désuètes et de principes périmés, était un anachronisme que la France de 1873 ne supporterait pas un instant."
                                            },
                                            {
                                                "example_id": "7bb8a5ea-1952-44c3-be13-6f68e42855fc",
                                                "sense_id": "824ba8c6-035b-3881-b30a-9ff55cc046de",
                                                "text": "En tout premier lieu sont les « crises », politiques principalement, mais aussi environnementales, toutes porteuses de leur cortège de désastres humains et génératrices de flux de réfugiés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c59b3041-77cc-3fec-953d-8e097d75a391",
                                        "entry_id": "4ea942bc-d3d2-33f2-a140-f6048b183533",
                                        "glosses": [
                                            "Cortège électronique : Ensemble des électrons qui gravitent autour du noyau d'un atome"
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
