                },
                {
                    "sense_id": "75a309b2-3df0-3688-83da-fc7a498fc1c4",
                    "sense_definition": "somber of neerslachtig van aard",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gemoedstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had vaak last van <w>donkere</w> gedachten tijdens de herfst.",
                            "target_lang_translations": {
