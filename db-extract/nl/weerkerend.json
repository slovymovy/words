                        "examples": [
                            {
                                "example_id": "4b0b26c4-6c77-4b53-991d-38f54d10313d",
                                "sense_id": "29a88095-d1b1-37f7-9580-997290b7a61c",
                                "text": "Niet alleen verschilt de belastingdruk, ook de samenstelling van de belastingen 'varieert sterk tussen de verschillende landen'. Wel is er één steeds weerkerende trend: 'Op de lange termijn is de belasting op toegevoegde waarde (btw) in veel landen sterk toegenomen.'"
                            },
                            {
                                "example_id": "aabce13f-03cf-42ea-bc7e-03767bcba16d",
                                "sense_id": "29a88095-d1b1-37f7-9580-997290b7a61c",
                                "text": "Wij doen ook niets onder voor u daarbuiten in het klagen en steunen over de televisie, de jengelende kinderen en de regering. Ik noem maar even een paar weerkerende klachten bij de koffiemachine. Daar halen we vaak zelfs de onderwerpen uit voor onze coververhalen. Wat ons ergert of aanstaat, zal u ongetwijfeld ook raken. HP de Tijd 03/02"
                            }
                        ]
                    }
