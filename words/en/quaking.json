{
    "word_family": [
        "quake",
        "quaker"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "107798c8-8911-3896-9361-3a3614226abd",
                    "sense_definition": "Shaking uncontrollably, especially due to fear or awe; trembling or shivering.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>quaking</w> child hid behind his mother when the loud thunder crashed.",
                            "target_lang_translations": {
                                "nl": "Het <w>bevende</w> kind verstopte zich achter zijn moeder toen de harde donderslag klonk."
                            }
                        },
                        {
                            "text": "She stood there <w>quaking</w> with fear as the dark figure approached her.",
                            "target_lang_translations": {
                                "nl": "Ze stond daar te <w>beven</w> van angst terwijl de donkere gestalte haar naderde."
                            }
                        }
                    ],
                    "synonyms": [
                        "quivering",
                        "trembling"
                    ],
                    "common_phrases": [
                        "quaking with fear"
                    ],
                    "target_lang_definitions": {
                        "nl": "Ongecontroleerd schudden, vooral door angst of ontzag; trillend of bevend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bevend",
                                "target_lang_sense_clarification": "trillend door emotie of angst"
                            },
                            {
                                "target_lang_word": "trillend",
                                "target_lang_sense_clarification": "algemene term voor schudden of beven"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95409e30-7886-3134-aa2c-6dc18504527d",
                    "sense_definition": "The act or state of shaking or trembling.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>quaking</w> of the ground signaled that the earthquake was beginning.",
                            "target_lang_translations": {
                                "nl": "Het <w>beven</w> van de grond gaf aan dat de aardbeving begon."
                            }
                        },
                        {
                            "text": "He could not hide the <w>quaking</w> in his hands as he held the letter.",
                            "target_lang_translations": {
                                "nl": "Hij kon het <w>getril</w> in zijn handen niet verbergen terwijl hij de brief vasthield."
                            }
                        }
                    ],
                    "synonyms": [
                        "tremor"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling of toestand van het schudden of trillen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "beving",
                                "target_lang_sense_clarification": "het proces van trillen of schudden"
                            },
                            {
                                "target_lang_word": "getril",
                                "target_lang_sense_clarification": "het aanhoudend trillen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af72f334-859d-398f-9b6b-82aaf6430a96",
                    "sense_definition": "Present participle and gerund of <w>quake</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire building was <w>quaking</w> during the powerful explosion nearby.",
                            "target_lang_translations": {
                                "nl": "Het hele gebouw stond te <w>trillen</w> tijdens de krachtige explosie in de buurt."
                            }
                        },
                        {
                            "text": "I could feel the floor <w>quaking</w> beneath my feet as the heavy truck passed.",
                            "target_lang_translations": {
                                "nl": "Ik kon de vloer onder mijn voeten voelen <w>trillen</w> toen de zware vrachtwagen voorbijreed."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb quake."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tegenwoordig deelwoord en gerundium van beven."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bevend",
                                "target_lang_sense_clarification": "vorm van het werkwoord beven"
                            },
                            {
                                "target_lang_word": "trillend",
                                "target_lang_sense_clarification": "vorm van het werkwoord trillen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}