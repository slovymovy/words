                "word": "overgo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "39e7424b-0857-4ef3-a6a8-2921309175b7",
                        "entry_id": "7bd89c5d-62f7-30ae-b8e7-84bf8e92a9a9",
                        "tags": [
                            "plural"
                        ],
                        "form": "overgoes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "773fa59a-2715-3e69-a49e-c9e8e4e8edc5",
                        "entry_id": "7bd89c5d-62f7-30ae-b8e7-84bf8e92a9a9",
                        "glosses": [
                            "A sequence of overlapping oligonucleotides, used to design hybridization."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "434a8ded-ce42-4826-96f4-520b99d8834e",
                                "sense_id": "773fa59a-2715-3e69-a49e-c9e8e4e8edc5",
                                "text": "Mixtures of such specific \"overgo\" probes can be used to screen arrayed library filters by DNA-DNA hybridization [...]."
                            },
                            {
                                "example_id": "d3dfd3aa-d813-4641-a54e-0c3d331a9f21",
                                "sense_id": "773fa59a-2715-3e69-a49e-c9e8e4e8edc5",
                                "text": "Hybridization of multiple overgoes produces many clones, perhaps 40 clones at a time."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                "word": "overgo",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2e1b5319-9312-4eb3-a306-89517ba610d2",
                        "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "overgoes"
                    },
                    {
                        "form_id": "614cbf20-45a0-4647-a0e5-8f944a4fa9c9",
                        "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "overgoing"
                    },
                    {
                        "form_id": "4ae6b258-b723-4a73-acd9-8aba436211a1",
                        "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                        "tags": [
                            "past"
                        ],
                        "form": "overwent"
                    },
                    {
                        "form_id": "47929a8f-18e4-4a10-9d91-116dc7659e2e",
                        "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "overgone"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "535318dc-9ae6-3db6-95c3-e22f8b806d6c",
                        "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                        "glosses": [
                            "To cross, go over (a barrier etc.); to surmount."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "94c7e22c-01c3-3918-b8c5-1b5abfd8501d",
                        "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                        "glosses": [
                            "To pass (a figurative barrier); to transgress."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0ee16b21-3f4b-4fe6-bea5-f45c85168210",
                                "sense_id": "94c7e22c-01c3-3918-b8c5-1b5abfd8501d",
                                "text": "How many an one in its vanities hath gloried and taken pride, / Till froward and arrogant thus he grew and did all bounds o'ergo!"
                            }
                        ]
                    },
                    {
                        "sense_id": "87d0a173-fa34-3fe6-909b-b45311b182f2",
                        "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                        "glosses": [
                            "To pass by, pass away; often, to go unnoticed."
                        ],
                        "tags": [
                            "UK",
                            "dialectal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "891ce572-6550-4128-bb6d-9e3c753dc5ca",
                                "sense_id": "87d0a173-fa34-3fe6-909b-b45311b182f2",
                                "text": "He did not rave, he did not stare aghast, / For all those visions were o'ergone, and past […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "7903f000-3c91-3144-a98f-32259aed9f60",
                        "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                        "glosses": [
                            "To spread across (something); to overrun."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f3a84f43-d6f3-37fc-ad78-369208e7828c",
                        "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                        "glosses": [
                            "To go over, move over the top of, travel across the surface of; to traverse, travel through."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57df48c7-08da-4f4a-8918-e544c06abb6c",
                                "sense_id": "f3a84f43-d6f3-37fc-ad78-369208e7828c",
                                "text": "forward rode, and kept her readie way / Along the strond, which as she ouer-went, / She saw bestrowed all with rich aray / Of pearles and pretious stones of great assay […]"
                            },
                            {
                                "example_id": "76ae3547-4eb9-42f1-9f94-8510637332fe",
                                "sense_id": "f3a84f43-d6f3-37fc-ad78-369208e7828c",
                                "text": "The fixed stars overgo Saturn, and so in them and all the rest, all is but one motion, and the nearer the earth the slower – a motion also whereof air and water do participate, though much interrupted."
                            }
                        ]
                    },
                    {
                        "sense_id": "47a01eab-605d-3dfc-b929-a3e7c8b24bfb",
                        "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                        "glosses": [
                            "To go beyond; to exceed, surpass."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a229f7a-f467-4065-8a9a-59f268477de5",
                                "sense_id": "47a01eab-605d-3dfc-b929-a3e7c8b24bfb",
                                "text": "O, what cause have I, / Thine being but a moiety of my grief, / To overgo thy plaints and drown thy cries!"
                            },
                            {
                                "example_id": "046d022f-3906-40aa-8a02-4fdfb189cbbc",
                                "sense_id": "47a01eab-605d-3dfc-b929-a3e7c8b24bfb",
                                "text": "He seeks to persuade the queen not merely to emulate the Amazons' vigilant territoriality but to overgo them by emulating the Spaniards' rampant invasiveness."
                            }
                        ]
                    },
                    {
                        "sense_id": "657f17e0-4c3f-3da0-ae79-16170a3faaff",
                        "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                        "glosses": [
                            "To get the better of; to overcome, overpower."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "062efaa9-6a4f-4167-a9cb-429fae3458a3",
                                "sense_id": "657f17e0-4c3f-3da0-ae79-16170a3faaff",
                                "text": "Both barking Scilla, and the ſounding Rocks, / The Cyclops ſhelues, and grim Ceranias ſeat, / Have you ore gone, and yet remaine aliue?"
                            }
                        ]
                    },
                    {
                        "sense_id": "ae8c1013-43d6-3ef3-a9c0-4cf1047b360f",
                        "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                        "glosses": [
                            "To overtake, go faster than."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "99ea38fd-f144-46df-839a-4ec865191f47",
                                "sense_id": "ae8c1013-43d6-3ef3-a9c0-4cf1047b360f",
                                "text": "If it chance, that we be overgone / By his more swiftness, urge him still to run upon our fleet, / And (lest he 'scape us to the town) still let thy javelin meet / With all his offers of retreat."
                            }
                        ]
                    },
                    {
                        "sense_id": "f958e380-c7f7-3430-a512-8eae33deca2f",
                        "entry_id": "0f9fe16b-2862-34b5-a1b8-66e0cccc5065",
                        "glosses": [
                            "To cover."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "22a37d7b-9f82-4071-ac4b-2aa096145ea2",
                                "sense_id": "f958e380-c7f7-3430-a512-8eae33deca2f",
                                "text": "All which, my thoughts say, they shall never do, But rather, that the earth shall overgo Some one at least."
                            }
                        ]
                    }
                ],
