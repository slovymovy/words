                                "target_senses": [
                                    {
                                        "sense_id": "5a49a883-8d7c-324a-b6bf-c559b9d3919b",
                                        "entry_id": "3a65e757-8f91-35e8-b0de-57c2faa8fb3f",
                                        "glosses": [
                                            "die Szene, die Bühne betreffend, in der Art und Weise einer Szene, einer Bühne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f814b76-102b-4600-834e-07ee187512b5",
                                                "sense_id": "5a49a883-8d7c-324a-b6bf-c559b9d3919b",
                                                "text": "Bei dem diesjährigen Fotowettbewerb wurden gestellte oder ungestellte Straßenszenen bzw. Streetaufnahmen mit szenischem Charakter verwendet."
                                            },
                                            {
                                                "example_id": "8751b6d8-fdec-441e-a83a-f02fca03f323",
                                                "sense_id": "5a49a883-8d7c-324a-b6bf-c559b9d3919b",
                                                "text": "Das alles sieht sehr szenisch aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
