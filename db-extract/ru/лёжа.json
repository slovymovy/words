                                        "sense_id": "43cd9194-4560-3a74-b05f-75daec3f4de7",
                                        "entry_id": "e5702b80-5bfe-360f-b9e5-119d9e0bfcd3",
                                        "glosses": [
                                            "An act or telling a lie or falsehood; the practice of telling lies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed69a84-74c7-4580-9b4d-6a52275f9fba",
                                                "sense_id": "43cd9194-4560-3a74-b05f-75daec3f4de7",
                                                "text": "[W]hether a man would fain be pleased with sin, or be quiet and fearless when he hath sinned, or continue in it, or persuade others to it, he must do it by false propositions, by lyings, and such weak discourses as none can believe but such as are born fools, or such as have made themselves so, or are made so by others."
                                            },
                                            {
                                                "example_id": "67ec19b6-44ee-4cff-85af-36000283a8ee",
                                                "sense_id": "43cd9194-4560-3a74-b05f-75daec3f4de7",
                                                "text": "Trump’s lying is no less constant or blatant than in 2016, but by now it feels familiar, already priced in. What more is there to say about the “war on truth” a decade into Trump’s political career?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lying",
                                "target_lang_code": "en",
