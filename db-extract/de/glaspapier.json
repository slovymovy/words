                        "entry_id": "e723cede-35ce-333b-af67-93339b470822",
                        "glosses": [
                            "Papier de verre, papier abrasif utilisant de la poudre de verre comme abrasif."
                        ],
                        "tags": [],
                        "note": "En allemand comme en français, utilisé aussi de manière générique pour désigner toute sorte de papier abrasif",
                        "examples": [
                            {
                                "example_id": "b556ca36-3bb8-4de1-a13f-7b413d3a4300",
                                "sense_id": "e7ce777d-4885-3a67-b8df-8d875346d37a",
                                "text": "Glaspapier wird üblicherweise aus zermahltem Altglas (Glaspulver) produziert.",
                                "translation": "Le papier de verre est couramment produit à partir de verre usagé broyé (poudre de verre)."
                            }
                        ]
                    }
