                "senses": [
                    {
                        "sense_id": "e21a61a2-ffba-3c8b-8da0-cc4b5d53b27b",
                        "entry_id": "652b931c-26ce-3bf9-9135-9c9c64c5ba5e",
                        "glosses": [
                            "A baby monotreme (echidna or platypus)."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "2e1bff7a-afc7-4dce-8b2f-0b897caabd98",
                                "sense_id": "e21a61a2-ffba-3c8b-8da0-cc4b5d53b27b",
                                "text": "Larger furred/spined puggles can be held in a wooden box with shredded paper."
                            },
                            {
                                "example_id": "1d392d13-48af-448f-82ba-8c4f33bb116d",
                                "sense_id": "e21a61a2-ffba-3c8b-8da0-cc4b5d53b27b",
                                "text": "2003, Robert Burton, The International Wildlife Encyclopedia, 3rd Edition, Volume 18: SOL-SWA, page 2488,\nThe puggle, which grows rapidly, remains in the pouch until its spines are sufficiently developed that the mother must eject it."
                            },
                            {
                                "example_id": "006dfa4c-83c4-40fe-970a-410cfe51406b",
                                "sense_id": "e21a61a2-ffba-3c8b-8da0-cc4b5d53b27b",
                                "text": "Hatching takes 10 days; the young echidna, called a puggle, then sucks milk from the pores of two milk patches and remains in the pouch for 45 to 55 days, at which time the spines develop. The mother digs a nursery burrow and deposits the puggle, returning every 5 days to suckle it until it is weaned at 7 months."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "44c5ac92-149e-3aac-9cfa-b6265d39f4e9",
                "word": "puggle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b33a686e-3272-4963-84e2-e4e2e0af894f",
                        "entry_id": "44c5ac92-149e-3aac-9cfa-b6265d39f4e9",
                        "tags": [
                            "plural"
