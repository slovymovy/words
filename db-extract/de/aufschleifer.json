                "senses": [
                    {
                        "sense_id": "9d45eb04-a3a7-3296-83a4-ba2222b716a1",
                        "entry_id": "4ac3ddb1-cdda-3114-9afa-09dd282e0717",
                        "glosses": [
                            "meist schleifenförmige Zufahrtsstraße von einer Straße zu einer anderen"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "bc51d958-1aac-4bfd-ad4d-bf57dbae6139",
                                "sense_id": "9d45eb04-a3a7-3296-83a4-ba2222b716a1",
                                "text": "„Bis zum Nachmittag ist der Aufschleifer zur B304 komplett gesperrt.“"
                            },
                            {
                                "example_id": "492b1d23-6f6d-4e5f-a9e3-58afa9c137c1",
                                "sense_id": "9d45eb04-a3a7-3296-83a4-ba2222b716a1",
                                "text": "„Im Feierabendverkehr ereignete sich am Donnerstag kurz vor der Äußeren Lohe am Aufschleifer der B304 ein Verkehrsunfall.“"
                            },
                            {
                                "example_id": "1d443e33-8253-484a-b83b-64e907a842e3",
                                "sense_id": "9d45eb04-a3a7-3296-83a4-ba2222b716a1",
                                "text": "„Am Aufschleifer von Piding nach Marzoll überholte ein dunkler Pkw zwei haltende Autos und kam aufgrund der Kurve und der hohen Geschwindigkeit auf die Fahrbahn von der entgegenkommenden Mercedesfahrerin.“"
                            },
                            {
                                "example_id": "68760c4e-b03a-4d62-ba68-a5bc42efa2b2",
                                "sense_id": "9d45eb04-a3a7-3296-83a4-ba2222b716a1",
                                "text": "„Am 06.10.2017, gegen 05:30 Uhr, befuhr ein 38jähriger aus Emmerting mit seinem Krad Kawasaki den Overfly und bog auf den Aufschleifer zur B20 Richtung Burghausen ab.“"
                            },
                            {
                                "example_id": "36ee22b1-38a6-40cc-b1a1-7277238fc2d7",
                                "sense_id": "9d45eb04-a3a7-3296-83a4-ba2222b716a1",
                                "text": "„Er touchierte den vorausfahrenden Biker und fuhr geradeaus über den Aufschleifer drüber, bis er mit der gegenüberliegenden Leitplanke kollidierte und darüber geschleudert wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
