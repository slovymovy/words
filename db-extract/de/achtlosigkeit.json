                                "sense_id": "99083b7e-80f7-3d39-abe9-9c87009d594a",
                                "text": "Durch Ihre Achtlosigkeit ist der Schaden innerhalb der vergangenen Woche deutlich größer geworden."
                            },
                            {
                                "example_id": "76b8503a-1c61-41ab-acbd-d2fba6cc1d40",
                                "sense_id": "99083b7e-80f7-3d39-abe9-9c87009d594a",
                                "text": "Lieblosigkeit, nicht gehaltene Versprechen und andere Achtlosigkeiten gehörten zum Alltag."
                            }
                        ],
