{
    "word": "superhero",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2831b0c8-5f10-3caa-a877-83b012157313",
                "word": "superhero",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8b537307-ab61-4016-b8ff-6912a84e1bf5",
                        "entry_id": "2831b0c8-5f10-3caa-a877-83b012157313",
                        "tags": [
                            "plural"
                        ],
                        "form": "superheroes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46dbde19-4ff8-3c37-8bc0-5b4c3935e6bb",
                        "entry_id": "2831b0c8-5f10-3caa-a877-83b012157313",
                        "glosses": [
                            "Any fictional crime-fighting character, often with supernatural powers or equipment, in popular children's and fantasy literature; a fictional hero who does great things."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a742330-e4eb-4934-bfbd-85dcc9dbc943",
                                "sense_id": "46dbde19-4ff8-3c37-8bc0-5b4c3935e6bb",
                                "text": "Hobbes: Super heroes wear snow pants?\nStupendous Man: When there's snow out, they do!"
                            }
                        ]
                    },
                    {
                        "sense_id": "686dfc6f-5b9b-3b98-9c06-d46bf8ce6f89",
                        "entry_id": "2831b0c8-5f10-3caa-a877-83b012157313",
                        "glosses": [
                            "A particularly renowned real-world hero, or one who has seemingly impossible abilities."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "acff2f6d-d215-4702-8223-3c3fb8a280e1",
                                "sense_id": "686dfc6f-5b9b-3b98-9c06-d46bf8ce6f89",
                                "text": "The power is out but you're watching TV? You must be a superhero."
                            },
                            {
                                "example_id": "39f59340-b8db-4bcf-8778-8c3215cdfd0c",
                                "sense_id": "686dfc6f-5b9b-3b98-9c06-d46bf8ce6f89",
                                "text": "Thanks for driving out here and towing me out of the ditch. You're a superhero!"
                            },
                            {
                                "example_id": "e88fac8c-6db7-4692-8e7e-5302a559cbca",
                                "sense_id": "686dfc6f-5b9b-3b98-9c06-d46bf8ce6f89",
                                "text": "Did you know your community has many invisible superheroes? Each day they perform hundreds of amazing feats that make the community a better place in which to live."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c71df5a-dda8-40f4-a34a-4fe4ae7b6af0",
                        "source_entry_id": "2831b0c8-5f10-3caa-a877-83b012157313",
                        "source_sense_description": "a fictional crime-fighting character with superpowers",
                        "target_lang_word": "superhrdina",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e8984b26-23ac-402c-9a9e-e765562b548b",
                        "source_entry_id": "2831b0c8-5f10-3caa-a877-83b012157313",
                        "source_sense_description": "a fictional crime-fighting character with superpowers",
                        "target_lang_word": "superheld",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superheld",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e0baf289-51c7-347a-a945-ef2b8bcc3480",
                                        "entry_id": "510fb1f1-78ad-3df5-9e57-65cd50179c24",
                                        "glosses": [
                                            "fictieve figuur uit een stripverhaal of een film die over bovenmenselijke krachten beschikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b353d9ad-e06e-45b4-94d7-a457a53f9b57",
                                                "sense_id": "e0baf289-51c7-347a-a945-ef2b8bcc3480",
                                                "text": "Welke superheld komt als eerste uit het lab? „Geen twijfel mogelijk: dat wordt Hawkeye van The Avengers.” Een boogschutter met één unieke superkracht: roofvogel-visie. Hawkeye kan inzoomen op twee, drie kilometer en focussen op twee objecten tegelijk. Alfabet Inc. - Google - en Ocumetics brengen binnenkort bionische lenzen op de markt, voor mensen met staar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "704240e7-8747-4834-ac61-dea0b283325c",
                        "source_entry_id": "2831b0c8-5f10-3caa-a877-83b012157313",
                        "source_sense_description": "a fictional crime-fighting character with superpowers",
                        "target_lang_word": "super-héros",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "super-héros",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e202687-4434-3f70-b812-aa9c3d8010ef",
                                        "entry_id": "46d82e1a-dc8a-37b9-8ea6-0a5b7f840fc2",
                                        "glosses": [
                                            "Personnage de fiction doté de super-pouvoirs, et les utilisant pour le bien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cc03b0a-5a30-48a8-996d-737d860f6094",
                                                "sense_id": "0e202687-4434-3f70-b812-aa9c3d8010ef",
                                                "text": "« Impossible ! Pourquoi ?\n— Parce que tu ne connais pas la loi de la droite vers la gauche !\n— La loi de la droite vers la gauche ?\n— Les super-héros japonais ont hérité du théâtre classique japonais. La plupart d’entre eux lancent leurs super-attaques de la droite en se déplaçant vers la gauche ! »"
                                            },
                                            {
                                                "example_id": "2d1dab94-ec70-42b5-a826-13b5d75b0d1b",
                                                "sense_id": "0e202687-4434-3f70-b812-aa9c3d8010ef",
                                                "text": "« Kéké » ne revêtira donc pas sa cape de super-héros pour sauver une nouvelle fois une équipe de France en détresse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "746567b1-57cc-4706-bd6b-7eaff5183ce6",
                        "source_entry_id": "2831b0c8-5f10-3caa-a877-83b012157313",
                        "source_sense_description": "a fictional crime-fighting character with superpowers",
                        "target_lang_word": "superhéros",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superhéros",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b3ae546-7f13-3202-89f2-587bda00b154",
                                        "entry_id": "dbf95cb8-54a7-3fc1-9999-072f6a092bf3",
                                        "glosses": [
                                            "Personnage doté de superpouvoirs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "766c3e5d-1727-422b-abd1-1dbf073cdd21",
                                                "sense_id": "8b3ae546-7f13-3202-89f2-587bda00b154",
                                                "text": "On peut imaginer que Todd Phillips cherche ici à saper les fondements du business de la franchise, en envoyant promener l’interminable palimpseste cinématographique des superhéros, après avoir signé l’un des films les plus surprenants du genre."
                                            },
                                            {
                                                "example_id": "a06aa226-b5f0-4192-9fb8-861bece1e261",
                                                "sense_id": "8b3ae546-7f13-3202-89f2-587bda00b154",
                                                "text": "C’est bien connu : les superhéros déboulent, quand on a besoin d’eux, pour sauver le monde."
                                            },
                                            {
                                                "example_id": "11dd61a3-01a1-4a43-9e44-4ad242592490",
                                                "sense_id": "8b3ae546-7f13-3202-89f2-587bda00b154",
                                                "text": "Les superhéros m’ennuient. J’aime me sentir proche d’un personnage. Quand j’incarne un héros."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6d533f6-35a5-4dbd-b157-31e3042336df",
                        "source_entry_id": "2831b0c8-5f10-3caa-a877-83b012157313",
                        "source_sense_description": "a fictional crime-fighting character with superpowers",
                        "target_lang_word": "Superheld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Superheld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54467cb5-136d-348e-a351-f4062d01f1a7",
                                        "entry_id": "248aa4f1-4f0b-3923-a07d-428be8970cd4",
                                        "glosses": [
                                            "Held mit besonderen Eigenschaften oder Fähigkeiten, meist mit Superkräften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee96f53d-6081-4aba-9d74-b5130bf59a3f",
                                                "sense_id": "54467cb5-136d-348e-a351-f4062d01f1a7",
                                                "text": "„Er kann fliegen, ist unverwundbar und eine bis zu den Zähnen bewaffnete Kampfmaschine: Iron Man, der Superheld aus der gleichnamigen Comic-Serie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
