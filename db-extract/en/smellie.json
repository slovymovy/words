                        "examples": [
                            {
                                "example_id": "1c404ea5-4a3e-48de-bd72-d4402706f4b1",
                                "sense_id": "60673617-acdc-3780-aa56-79d608323d18",
                                "text": "Once Robert Smellie found her in a ruinous kirk on the Lang Muir, where of old the idolatrous rites of Rome were practiced."
                            },
                            {
                                "example_id": "35d0129a-c123-488d-b89b-6513d5e5c3c9",
                                "sense_id": "60673617-acdc-3780-aa56-79d608323d18",
                                "text": "Poor Mhairi Smellie. Her first name, a Scots Gaelic name, was pronounced \"vary\", which sounded close to very. The name Smellie was common enough in Scotland, but to be called something which sounded like \"very smelly\" was a singular misfortune, and indicative, surely, of a lack of parental foresight."
                            }
                        ]
                    }
