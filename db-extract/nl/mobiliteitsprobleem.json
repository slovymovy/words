                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7ca0ebf-7cbc-4021-b291-80a426724763",
                                "sense_id": "3a080e32-4694-329d-91db-8fd320f6b3e8",
                                "text": "Het terughalen van honderden deelfietsen uit de stad blijkt veel lastiger dan verwacht. Volgens deelfietsbedrijf oBike het bewijs dat Amsterdam kampt met ernstige mobiliteitsproblemen."
                            },
                            {
                                "example_id": "c2c39739-c66d-4161-9f33-735e92d9174a",
                                "sense_id": "3a080e32-4694-329d-91db-8fd320f6b3e8",
                                "text": "it een studie blijkt dat de bouw van een brug tussen Sluisbuurt en het Oostelijk Havengebied nauwelijks zoden aan de dijk zet bij de mobiliteitsproblemen rond het Zeeburgereiland en IJburg."
                            }
                        ]
                    },
