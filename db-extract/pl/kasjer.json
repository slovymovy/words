                                        "entry_id": "ae6b042b-bc9d-3569-a24c-970178c870fe",
                                        "glosses": [
                                            "Personne qui tient la caisse chez un banquier, chez un négociant, ou dans une administration, dans un établissement public, dans un supermarché ^([1 & 2])."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d328b888-337e-4b32-9f39-ccfa2570aa1c",
                                                "sense_id": "29ea498b-16f3-3edd-86ee-ab5663d944e2",
                                                "text": "Untel est le caissier de cette banque. Un caissier du Trésor."
                                            },
                                            {
                                                "example_id": "d7baa17a-d00f-4b6c-a3ac-cd253c08f815",
                                                "sense_id": "29ea498b-16f3-3edd-86ee-ab5663d944e2",
                                                "text": "Parallèlement au DEA à Paris 7 (aujourd'hui on dirait Master 2), j'occupais à mi-temps le travail de caissier en hypermarché"
                                            },
                                            {
                                                "example_id": "41bcf38e-0fed-4ccd-9ca1-3dcb7e6e48ed",
                                                "sense_id": "29ea498b-16f3-3edd-86ee-ab5663d944e2",
                                                "text": "Il faut noter que l’article 14 de la loi de 1895 exige que toute opération inscrite au livret soit certifiée par la signature du caissier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fc5f3c7-07e4-3992-a0d4-63bfc1a0cbdf",
                                        "entry_id": "ae6b042b-bc9d-3569-a24c-970178c870fe",
                                        "glosses": [
                                            "Personne qui fabrique des caisses ^([2])."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
