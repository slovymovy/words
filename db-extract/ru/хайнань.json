                "senses": [
                    {
                        "sense_id": "9190c616-2d0f-3fd7-ae47-cba13a5fdd58",
                        "entry_id": "a6b9f912-af1b-379c-8d54-cc743d04569f",
                        "glosses": [
                            "остров на юго-востоке Китая, омываемый Южно-Китайским морем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68e82dc7-90f9-4839-a1f5-b07defe7e403",
                                "sense_id": "9190c616-2d0f-3fd7-ae47-cba13a5fdd58",
                                "text": "В конце 1938 года Япония захватила Кантон, а в начале 1939 года ― остров Хайнань."
                            }
                        ]
                    },
                    {
                        "sense_id": "01f44df1-c507-36a0-8bb2-a9fa84cc9935",
                        "entry_id": "a6b9f912-af1b-379c-8d54-cc743d04569f",
                        "glosses": [
                            "провинция на юге Китая, включающая в себя остров Хайнань [1] и ряд малых островов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddb06312-0dbe-4c43-bd77-5f768f9d0b6b",
                                "sense_id": "01f44df1-c507-36a0-8bb2-a9fa84cc9935",
                                "text": "В северо-восточной части острова Хайнань, на южном берегу Цюнчжоуского пролива в устье реки Наньдуцзян расположен г. Хайкоу — «морские ворота» Хайнаня…"
                            }
                        ]
                    }
