                ],
                "senses": [
                    {
                        "sense_id": "2cef78a8-bdd8-34ca-9645-83021f7bd138",
                        "entry_id": "8493ca13-f090-381f-97c9-20cc15c4deb1",
                        "glosses": [
                            "Qui unit, qui est propre à unir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a1d370b-d4be-4e75-9e51-3e58d7f785d6",
                                "sense_id": "2cef78a8-bdd8-34ca-9645-83021f7bd138",
                                "text": "Dans la tradition du pseudo Denys, qui est celle de l’Occident, l’amour mystique est unitif et extatique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee96adcb-3e41-4424-a57e-c4f53b94df38",
                        "source_entry_id": "8493ca13-f090-381f-97c9-20cc15c4deb1",
                        "source_sense_id": "2cef78a8-bdd8-34ca-9645-83021f7bd138",
                        "target_lang_word": "unitive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20ccda5c-1abe-38e1-89d6-fdb6856d69cb",
                                        "entry_id": "807dbe4f-e2e6-3306-8b3f-df7b39ab65f7",
                                        "glosses": [
                                            "Of, causing, or involving unity or union."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "862a2d66-5700-4ce4-8e04-3ed61a50300b",
                                                "sense_id": "20ccda5c-1abe-38e1-89d6-fdb6856d69cb",
                                                "text": "The mystics' fundamental vision was unitive: all things, including sinful creatures, are united with God."
                                            },
                                            {
                                                "example_id": "2200d594-7202-425e-8755-25e98f01de69",
                                                "sense_id": "20ccda5c-1abe-38e1-89d6-fdb6856d69cb",
                                                "text": "Starting with this principle, established by God, namely that sex must always be the expression of a love that is unitive (till death) and procreative (opened to life), we can arrive at a simple Sexual Ethics primer."
                                            },
                                            {
                                                "example_id": "bc7d6801-cc86-4c11-a3af-9ece52d6830e",
                                                "sense_id": "20ccda5c-1abe-38e1-89d6-fdb6856d69cb",
                                                "text": "It was unitive in that it directly asked each person to go beyond that which separates him or her from other people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
