{
    "word_family": [
        "postponement",
        "postponer",
        "postponable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e7f3e3a-b829-32fe-9eb5-22ec0f707edd",
                    "sense_definition": "To delay or put off an event, appointment, or action until a later time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>postpone</w> the meeting until next Friday due to the bad weather.",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>отложить</w> собрание до следующей пятницы из-за плохой погоды."
                            }
                        },
                        {
                            "text": "We had to <w>postpone</w> the wedding because several family members were unable to travel.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>отложить</w> свадьбу, так как несколько членов семьи не смогли приехать."
                            }
                        }
                    ],
                    "synonyms": [
                        "delay",
                        "put off",
                        "defer",
                        "suspend",
                        "hold off"
                    ],
                    "antonyms": [
                        "advance",
                        "hasten",
                        "bring forward",
                        "expedite"
                    ],
                    "common_phrases": [
                        "postpone the meeting",
                        "postpone the decision",
                        "postpone until later",
                        "postpone indefinitely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перенести или отложить событие, встречу или действие на более позднее время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отложить",
                                "target_lang_sense_clarification": "перенести на более поздний срок"
                            },
                            {
                                "target_lang_word": "откладывать",
                                "target_lang_sense_clarification": "процесс переноса на потом"
                            },
                            {
                                "target_lang_word": "отсрочить",
                                "target_lang_sense_clarification": "дать отсрочку, перенести исполнение"
                            },
                            {
                                "target_lang_word": "перенести",
                                "target_lang_sense_clarification": "изменить время на более позднее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9b9ef25-ee15-3621-9b9f-0e36ab15daab",
                    "sense_definition": "To place something after another in order of importance or priority; to consider less important.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "priority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his philosophy, personal desires are often <w>postponed</w> to the needs of the community.",
                            "target_lang_translations": {
                                "ru": "В его философии личные желания часто <w>отодвигаются на второй план</w> ради нужд общества."
                            }
                        },
                        {
                            "text": "The author chose to <w>postpone</w> the secondary plot to the main narrative arc.",
                            "target_lang_translations": {
                                "ru": "Автор решил <w>подчинить</w> второстепенный сюжет основной повествовательной линии."
                            }
                        }
                    ],
                    "synonyms": [
                        "defer"
                    ],
                    "common_phrases": [
                        "postpone to another"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поставить что-либо после другого в порядке важности или приоритета; считать менее важным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отодвинуть на второй план",
                                "target_lang_sense_clarification": "сделать менее приоритетным"
                            },
                            {
                                "target_lang_word": "подчинить",
                                "target_lang_sense_clarification": "поставить в зависимость от более важного"
                            },
                            {
                                "target_lang_word": "отложить",
                                "target_lang_sense_clarification": "в значении повременить с реализацией ради чего-то другого"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}