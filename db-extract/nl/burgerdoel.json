                        "examples": [
                            {
                                "example_id": "715577df-6618-4196-9222-bf54641792fd",
                                "sense_id": "a3e7b147-8c98-315f-beda-e768b17d5220",
                                "text": "Rutte: ongekende agressie Rusland richt zich steeds meer op burgerdoelen."
                            },
                            {
                                "example_id": "36db4b93-5592-48ef-8b34-fd7f346a8972",
                                "sense_id": "a3e7b147-8c98-315f-beda-e768b17d5220",
                                "text": "De Syrië-tactiek: Russische troepen verwoesten, tegen alle oorlogsregels in, voortdurend burgerdoelen met raketten. Het lijkt een doelbewuste strategie; in Syrië deden de Russen precies hetzelfde, maar op nog veel grotere schaal."
                            },
                            {
                                "example_id": "cb3dcc8d-1b74-461b-b5a4-d34072781615",
                                "sense_id": "a3e7b147-8c98-315f-beda-e768b17d5220",
                                "text": "En deze generositeit werd dus door de Engelsen beantwoord met massale bombardementen op burgerdoelen."
                            }
                        ]
                    }
