                "senses": [
                    {
                        "sense_id": "3e0d5e27-27ae-306a-b3d2-bdceeb2d2e61",
                        "entry_id": "47b3ce84-db48-390c-a61d-384b7ba24d56",
                        "glosses": [
                            "Russe fasciste, surnom donné aux soldats qui ont envahi l’Ukraine en 2022 et aux russes qui soutiennent la guerre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af5d2ae-e1f4-4bbc-a72b-e6daae6fd7a8",
                                "sense_id": "3e0d5e27-27ae-306a-b3d2-bdceeb2d2e61",
                                "text": "Je vais effacer ce message après te l’avoir envoyé (le mot « rachiste » est bien sûr interdit… « Je t’aime » l’est peut-être aussi)."
                            },
                            {
                                "example_id": "525a4a91-0d86-4893-b301-fdbf28fee314",
                                "sense_id": "3e0d5e27-27ae-306a-b3d2-bdceeb2d2e61",
                                "text": "Dehors, les rachistes (contraction de Russes et fascistes) comme les surnomment désormais les Ukrainiens, tentaient de s’emparer du pays."
                            },
                            {
                                "example_id": "8870873f-ed4e-4140-bce6-098dcbcfbd90",
                                "sense_id": "3e0d5e27-27ae-306a-b3d2-bdceeb2d2e61",
                                "text": "Ils ont même volé des culottes : comment les rachistes fuyaient la banlieue de Kyiv."
                            },
                            {
                                "example_id": "3b4a9b4b-772a-47fe-ab19-5fd1e26fcbba",
                                "sense_id": "3e0d5e27-27ae-306a-b3d2-bdceeb2d2e61",
                                "text": "Les rachistes y sont entrés du côté du bois."
                            },
                            {
                                "example_id": "502aff13-79d4-4e59-84bf-1280432def54",
                                "sense_id": "3e0d5e27-27ae-306a-b3d2-bdceeb2d2e61",
                                "text": "Je n’ai pas entendu les sirènes depuis le début du mois. Ça me rend nerveuse, car j’ai la sensation que les rachistes préparent une attaque."
                            }
                        ]
                    }
                ],
