                        "glosses": [
                            "Demi-lune, mur à angle saillant, destiné à protéger les angles des bastions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9cdaec8-9104-4613-9b87-d20aaeba8711",
                                "sense_id": "de08d8fe-ea1a-3e4a-b6cf-7fa256c70f5b",
                                "text": "Il [Charles XII] s'arrêta le 21 jusqu'à minuit sur un petit ravelin tout ruiné par les bombes et par le canon."
                            },
                            {
                                "example_id": "6e621656-fe50-4a3a-aeac-9d9985caabab",
                                "sense_id": "de08d8fe-ea1a-3e4a-b6cf-7fa256c70f5b",
                                "text": "Pour se défendre de l'offensive ottomane, les Viennois avaient monté plus de trois cents canons sur les ravelins et les bastions."
                            }
                        ]
                    }
                ],
