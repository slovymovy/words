                    },
                    {
                        "translation_id": "adef30c0-d708-42f3-89fc-aef3507e2f4e",
                        "source_entry_id": "bc9a69c0-2cbe-3df7-a0f8-c68c6a5e8133",
                        "source_sense_id": "a3de0341-7df4-31e2-96c8-779ba6b590c0",
                        "target_lang_word": "fool",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fool",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93ee616d-9962-393f-bd26-7e2274b1b40c",
                                        "entry_id": "12784ed2-fb4c-3e12-bc1d-c10fe76bfcaf",
                                        "glosses": [
                                            "A person with poor judgment or little intelligence."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "463e14e2-e13c-4e0a-817a-aa0045b1e003",
                                                "sense_id": "93ee616d-9962-393f-bd26-7e2274b1b40c",
                                                "text": "You were a fool to cross that busy road without looking."
                                            },
                                            {
                                                "example_id": "74d54b61-f104-4210-95ba-2094cad0940d",
                                                "sense_id": "93ee616d-9962-393f-bd26-7e2274b1b40c",
                                                "text": "The village fool threw his own shoes down the well."
                                            },
                                            {
                                                "example_id": "ff330fe8-d909-4194-8743-f2b7012ed605",
                                                "sense_id": "93ee616d-9962-393f-bd26-7e2274b1b40c",
                                                "text": "Erasmus, [...] saide wiselie that experience is the common scholehouse of foles, and ill men: Men of witte and honestie, be otherwise instructed."
                                            },
                                            {
                                                "example_id": "2b261411-33e1-4fee-bd54-6b861f599580",
                                                "sense_id": "93ee616d-9962-393f-bd26-7e2274b1b40c",
                                                "text": "No man is always a fool, every man is sometimes."
                                            },
                                            {
                                                "example_id": "9122613e-2112-4b0d-b677-e42014920883",
                                                "sense_id": "93ee616d-9962-393f-bd26-7e2274b1b40c",
                                                "text": "'If I coloured at all, Mr Edward,' said Joe, 'which I didn't know I did, it was to think I should have been such a fool as ever to have any hope of her. She’s as far out of my reach as—as Heaven is.'"
                                            },
                                            {
                                                "example_id": "257eff7b-c1db-4520-b720-a8f1c36a028c",
                                                "sense_id": "93ee616d-9962-393f-bd26-7e2274b1b40c",
                                                "text": "If you can bear to hear the truth you've spoken\n⁠Twisted by knaves to make a trap for fools"
                                            },
                                            {
                                                "example_id": "3de7d689-05a8-4737-aea6-8fbb9305d657",
                                                "sense_id": "93ee616d-9962-393f-bd26-7e2274b1b40c",
                                                "text": "You're just a poor misguided fool\nWho thinks they know what I should do\nA line for me and a line for you\nI lose my right to a point of view."
                                            },
                                            {
                                                "example_id": "99d9f247-6971-42e5-a407-2c8ba0579e84",
                                                "sense_id": "93ee616d-9962-393f-bd26-7e2274b1b40c",
                                                "text": "And every time I'm meant to be acting sensible\nYou drift into my head\nAnd turn me into a crumbling fool."
                                            },
                                            {
                                                "example_id": "151b615a-0271-4564-ad47-34d6041c8aea",
                                                "sense_id": "93ee616d-9962-393f-bd26-7e2274b1b40c",
                                                "text": "I like that you're broken\nBroken like me\nMaybe that makes me a fool"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "803924b6-6ead-315f-b2df-ef5afb08357c",
                                        "entry_id": "12784ed2-fb4c-3e12-bc1d-c10fe76bfcaf",
                                        "glosses": [
                                            "A jester; a person whose role was to entertain a sovereign and the court (or lower personages)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dd7bfab-8031-497d-9936-260b8e17cae8",
                                                "sense_id": "803924b6-6ead-315f-b2df-ef5afb08357c",
                                                "text": "1896, Frederick Peterson IN Popular Science Monthly Volume 50 December 1896 , Idiots Savants\nThis court fool could say bright things on occasion, but his main use to the ladies and lords of the palace was to serve as victim to practical jokes, cruel, coarse, and vulgar enough to be appreciated perhaps in the Bowery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a391243c-a599-3bc3-b082-96c058affcb7",
                                        "entry_id": "12784ed2-fb4c-3e12-bc1d-c10fe76bfcaf",
                                        "glosses": [
                                            "A stock character typified by unintelligence, naïveté or lucklessness, usually as a form of comic relief; often used as a source of insight or pathos for the audience, as such characters are generally less bound by social expectations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25b5eeed-96b2-33fa-8440-e51a65f897d0",
                                        "entry_id": "12784ed2-fb4c-3e12-bc1d-c10fe76bfcaf",
                                        "glosses": [
                                            "Someone who has been made a fool of or tricked; dupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "586dff33-ea8d-4c9f-a7a3-1d0452e0529f",
                                                "sense_id": "25b5eeed-96b2-33fa-8440-e51a65f897d0",
                                                "text": "Such clouds of nameless trouble cross\n⁠All night below the darken’d eyes;\n⁠With morning wakes the will, and cries,\n‘Thou shalt not be the fool of loss.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca0a445d-442e-3fc6-a28b-79ac2eae6c35",
                                        "entry_id": "12784ed2-fb4c-3e12-bc1d-c10fe76bfcaf",
                                        "glosses": [
                                            "Someone who derives pleasure from something specified."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58e66626-340c-43a8-a56c-de46be4cda21",
                                                "sense_id": "ca0a445d-442e-3fc6-a28b-79ac2eae6c35",
                                                "text": "Can they think me […] their fool or jester?"
                                            },
                                            {
                                                "example_id": "d458d0df-5b11-4ebf-b03d-5337b09cb31d",
                                                "sense_id": "ca0a445d-442e-3fc6-a28b-79ac2eae6c35",
                                                "text": "I'm a fool for the city."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f5fa970-8173-39c7-aa17-f34ec9a9d3a6",
                                        "entry_id": "12784ed2-fb4c-3e12-bc1d-c10fe76bfcaf",
                                        "glosses": [
                                            "An informal greeting akin to buddy, dude, or man."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ac01497-073f-49bf-9f9a-13b0b9e2eaa5",
                                                "sense_id": "1f5fa970-8173-39c7-aa17-f34ec9a9d3a6",
                                                "text": "Upon opening the door, Trech was suddenly drawn aback by the shocking presence of the armed goon standing directly in front of him. “Yo, what up fool? […]”"
                                            },
                                            {
                                                "example_id": "a10e1078-9dd3-4311-a172-b777e184074b",
                                                "sense_id": "1f5fa970-8173-39c7-aa17-f34ec9a9d3a6",
                                                "text": "“What up, fool?” he finally responded. “Not too much; fell asleep watching your boys get their asses kicked,” I told him, referring to the Carolina Cougars, the last team he played for before he got sick."
                                            },
                                            {
                                                "example_id": "fae81b11-32bd-4c8a-8bc0-9ed3e1fbdfb1",
                                                "sense_id": "1f5fa970-8173-39c7-aa17-f34ec9a9d3a6",
                                                "text": "Fame leaves out the house and walks to the BP gas station on Alabama Avenue. On the way there he sees his man Mark posted up at the rec center and walks over to holla at him. “What’s up fool?” Mark says while dapping Fame up."
                                            },
                                            {
                                                "example_id": "220c362a-854f-4f59-8595-febe0b501638",
                                                "sense_id": "1f5fa970-8173-39c7-aa17-f34ec9a9d3a6",
                                                "text": "“What up fool?” Lil Slim said noticing the seriousness in Lil Kilo’s voice. “You ain’t switched up on us have you.” Lil Fresh looked at Lil Kilo like where that come from. “Nigga I’ll neva switch up.” Lil Slim said feeling a little offended."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfba47ac-8301-39a5-a229-f80cae01349b",
                                        "entry_id": "12784ed2-fb4c-3e12-bc1d-c10fe76bfcaf",
                                        "glosses": [
                                            "A particular card in a tarot deck, representing a jester."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fool",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7804c8cb-1b7a-3b18-bcf1-52de1851d53d",
                                        "entry_id": "947b040b-de1c-3645-b14d-3c6463681f11",
                                        "glosses": [
                                            "To trick; to deceive."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d49736e-99f3-4cda-ae1a-f58826d62da6",
                                                "sense_id": "7804c8cb-1b7a-3b18-bcf1-52de1851d53d",
                                                "text": "She bit it gently and found that it resembled a worm in no way whatsoever as to taste although because it was long and slender, a Little Red Hen might easily be fooled by its appearance."
                                            },
                                            {
                                                "example_id": "4187e785-6f56-42c2-b5f3-5cf5683d8b6e",
                                                "sense_id": "7804c8cb-1b7a-3b18-bcf1-52de1851d53d",
                                                "text": "There appears to be no process of gradually fooling oneself while degrading standards so characteristic of the Solid Rocket Booster or Space Shuttle Main Engine safety systems."
                                            },
                                            {
                                                "example_id": "fe40ce6a-130e-40f7-9423-23d11cd6aea8",
                                                "sense_id": "7804c8cb-1b7a-3b18-bcf1-52de1851d53d",
                                                "text": "Liara: Do not be fooled by these civilized surroundings. This is a place of secrets and lies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23557d14-a923-33d3-b0a2-50519c4ca380",
                                        "entry_id": "947b040b-de1c-3645-b14d-3c6463681f11",
                                        "glosses": [
                                            "To act in an idiotic manner; to act foolishly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94a5e410-f407-4544-85d0-a4ab88c9c162",
                                                "sense_id": "23557d14-a923-33d3-b0a2-50519c4ca380",
                                                "text": "1681/1682, John Dryden, The Spanish Fryar\nIs this a time for fooling?"
                                            },
                                            {
                                                "example_id": "6ab49f00-2a7d-4b1e-a97e-0801bd8cb7a0",
                                                "sense_id": "23557d14-a923-33d3-b0a2-50519c4ca380",
                                                "text": "She's always complaining that she got stuck with the worst possible committee. And that me and Jimmy fool more than we work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75c19b89-991f-3856-96eb-fa1b87094dbb",
                                        "entry_id": "947b040b-de1c-3645-b14d-3c6463681f11",
                                        "glosses": [
                                            "To make a fool of; to make act the fool."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "667a7c7a-d085-4ba9-806b-7d6a053bf2dc",
                                                "sense_id": "75c19b89-991f-3856-96eb-fa1b87094dbb",
                                                "text": "They fool me to the top of my bent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fool",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24d51c41-3048-3994-9021-32d7ce00dadf",
                                        "entry_id": "e83e9b53-6bc7-3723-8e4c-11cb6e2b3864",
                                        "glosses": [
                                            "Foolish."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e36d22ae-602b-4568-9a5b-6805f4b54198",
                                                "sense_id": "24d51c41-3048-3994-9021-32d7ce00dadf",
                                                "text": "Of all the fool, fruitless jobs, making anything of a creature that begins by deceiving her, is the foolest a sane woman ever undertook."
                                            },
                                            {
                                                "example_id": "0b6f7752-68d1-42fb-97ec-9135dfc7ce91",
                                                "sense_id": "24d51c41-3048-3994-9021-32d7ce00dadf",
                                                "text": "That was a fool thing to do. You could have gotten yourself shot"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fool",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37a79a02-b11b-3a1e-a543-fd0c95bac287",
                                        "entry_id": "811fd12b-3836-3f2a-b573-4ec8ca8b20e0",
                                        "glosses": [
                                            "A type of dessert made of puréed fruit and custard or cream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "547146b6-3849-4e81-957d-fb22dda9907f",
                                                "sense_id": "37a79a02-b11b-3a1e-a543-fd0c95bac287",
                                                "text": "an apricot fool; a gooseberry fool"
                                            },
                                            {
                                                "example_id": "774a1f9c-c996-44eb-b54b-4d779dd64b4f",
                                                "sense_id": "37a79a02-b11b-3a1e-a543-fd0c95bac287",
                                                "text": "Eton is renowned for its \"messes,\" and \"strawberry mess\" is Empress of them all, with raspberry mess as a very good second. It does not at all convey the joys of a \"mess\" to say that it consists of iced fruit and cream, and somewhat resembles a \"fool.\" It is a thing apart, and should be approached with bated breath and unimpaired capacity."
                                            },
                                            {
                                                "example_id": "678ba498-3b96-48aa-9255-28a67379c9eb",
                                                "sense_id": "37a79a02-b11b-3a1e-a543-fd0c95bac287",
                                                "text": "Pellaprat [...] invented the dish [of Eton mess] when a load of over-ripe strawberries needed eating up. His disguise was a fluff of whipped cream and the fool was served with sponge fingers. Somewhere along the line, someone else had the idea of stirring chunks of meringue into the fool at the last moment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a50c400c-2849-4e1c-b941-f0bbcac9ec45",
                        "source_entry_id": "bc9a69c0-2cbe-3df7-a0f8-c68c6a5e8133",
                        "source_sense_id": "a3de0341-7df4-31e2-96c8-779ba6b590c0",
                        "target_lang_word": "lunatic",
