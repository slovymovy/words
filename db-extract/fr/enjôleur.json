                    },
                    {
                        "form_id": "edfb0f6a-d034-40c4-84ec-cf3dff9514b8",
                        "entry_id": "0986da54-7f36-315f-ac5d-40bc64e6f800",
                        "tags": [
                            "feminine"
                        ],
                        "form": "enjôleuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44eed1f1-26cb-3a2d-adbe-648e1339aac6",
                        "entry_id": "0986da54-7f36-315f-ac5d-40bc64e6f800",
                        "glosses": [
                            "Celui qui enjôle, qui cherche à séduire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15136d3d-5a43-44dc-b55d-4fd5d6de2494",
                                "sense_id": "44eed1f1-26cb-3a2d-adbe-648e1339aac6",
                                "text": "Vous êtes un enjôleur. Je lis dans votre jeu, je vois bien que vous voulez m’endormir."
                            },
                            {
                                "example_id": "dd1d92bd-fc05-43a3-9754-6dc740f39f0d",
                                "sense_id": "44eed1f1-26cb-3a2d-adbe-648e1339aac6",
                                "text": "Comme ils pèsent sur moi ces courtisans infâmes,\nCes hobereaux sucrés, ces enjoleurs de femmes\nQui font de grands saluts et qui ne veulent pas\nQu’on leur dise tout haut ce qu’on pense tout bas !"
                            },
                            {
                                "example_id": "fa936a25-6031-4633-a3fe-13dcdbf68b05",
                                "sense_id": "44eed1f1-26cb-3a2d-adbe-648e1339aac6",
                                "text": "– Pour sûr, dit Seconde, que c’est un enjôleur, quand il veut. Ah ! il sait prendre son monde…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b356bb4-0f56-4f59-8c39-cd24a843b6c0",
                        "source_entry_id": "0986da54-7f36-315f-ac5d-40bc64e6f800",
