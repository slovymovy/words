                ],
                "senses": [
                    {
                        "sense_id": "943c932e-6878-39f0-ac8e-0376ca2fb7bb",
                        "entry_id": "fb330586-c596-33af-9738-b382ca1753a3",
                        "glosses": [
                            "dem eigentlichen Verb vorangestelltes Element, das formal Adverb, Nomen oder Präposition ist, jedoch die Bedeutung des Verbs direkt verändert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ed361cc-cffe-4a96-89f4-0f47eec6c335",
                                "sense_id": "943c932e-6878-39f0-ac8e-0376ca2fb7bb",
                                "text": "Präverbien treten vor allem in den indoeuropäischen Sprachen sowie in den drei kaukasischen Sprachfamilien und in einigen Sprachfamilien Nordamerikas auf."
                            },
                            {
                                "example_id": "9a06f98d-82bb-44a6-b882-cee9a15df8f3",
                                "sense_id": "943c932e-6878-39f0-ac8e-0376ca2fb7bb",
                                "text": "Im Deutschen sind die Präverbien abtrennbare Präfixe, die in Sätzen, wo das Verb an die erste oder zweite Stelle im Satz rückt, am Satzende stehen bleiben, z. B. „Die Sonne geht auf“."
                            },
                            {
                                "example_id": "f07b97ba-5f5c-49bb-9832-1afa37327e8a",
                                "sense_id": "943c932e-6878-39f0-ac8e-0376ca2fb7bb",
                                "text": "„Daneben finden sich Bezeichnungen wie Halbpräfix, unfestes Präfix, trennbares Präfix, Verbzusatz, Kompositionspartikel und Präverb […]“"
                            },
                            {
                                "example_id": "76f7f63f-b0b5-4a21-be97-27e2f76aa5af",
                                "sense_id": "943c932e-6878-39f0-ac8e-0376ca2fb7bb",
                                "text": "„Präfixe und Partikeln: Wegen der oft ähnlichen syntaktisch-semantischen Funktion werden zu den Präfixen oft auch die trennbaren Verbpartikeln […] gerechnet, die auch Paraverbien/Praeverbien/präfixartige Bestimmungsglieder/Präfixoide/Verbzusätze genannt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
