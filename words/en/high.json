                    "frequency": "Low",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meat had been left out too long and was starting to smell <w>high</w>.",
                            "target_lang_translations": {
                                "ru": "Мясо слишком долго лежало не в холодильнике и начало пахнуть <w>с душком</w>."
                            }
