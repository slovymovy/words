                                        "entry_id": "d0f189d0-1f94-3a22-8cc3-98672790618c",
                                        "glosses": [
                                            "Theft or pilferage, typically of a small item; shoplifting."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b0b2709-a72f-453b-a6a9-6f4d42e51aca",
                                                "sense_id": "fbd7d1ee-3470-3538-bad8-10c8f62aa8cf",
                                                "text": "I was a burglary detective for three years before I joined the Speaker's Bureau, and you might say I managed to acquire a few things at a five-finger discount, if you catch my drift."
                                            },
                                            {
                                                "example_id": "9690622d-6c9d-4482-acd1-079c7b7a43b2",
                                                "sense_id": "fbd7d1ee-3470-3538-bad8-10c8f62aa8cf",
                                                "text": "- Hey, guys. Where'd you get all that great stuff?\n- Five-finger discount, man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
