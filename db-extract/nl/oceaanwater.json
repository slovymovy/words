                        "glosses": [
                            "het water van de grote zeeën"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36de1451-0710-4abc-93bb-cdeaa067c02c",
                                "sense_id": "27712ca4-ab9f-388a-b60e-eaea47f7a948",
                                "text": "El Niño is een natuurfenomeen dat zich om de drie tot zeven jaar voordoet. Warm oceaanwater uit de Stille Oceaan stroomt naar het oosten en zorgt voor hevige regenval in Zuid-Amerika, maar ook voor extreme droogte op het Afrikaans continent."
                            },
                            {
                                "example_id": "829050de-3c3b-4c47-b5d4-c395b11e6a67",
                                "sense_id": "27712ca4-ab9f-388a-b60e-eaea47f7a948",
                                "text": "De vis is in zeewater gevonden bij de Verenigde Staten, Australië en andere landen. Door zijn warme bloed heeft de vis een voordeel in het koude oceaanwater in zulke dieptes."
                            }
                        ]
