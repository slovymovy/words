                "senses": [
                    {
                        "sense_id": "ea63692b-dc64-3d84-bd24-801348681db2",
                        "entry_id": "ed42c177-43aa-3f04-a649-0edc1dd21396",
                        "glosses": [
                            "Télédiffuser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d112f5a-6ab3-4b80-bd11-bcab7d752dd0",
                                "sense_id": "ea63692b-dc64-3d84-bd24-801348681db2",
                                "text": "Franchement, quand je revois La grenouille, que Télé-Québec se plaît à retélédiffuser à l'occasion durant la période des Fêtes afin qu'une nouvelle génération découvre ce beau film pour toute la famille, je ressens les mêmes émotions qu'au premier visionnement quand j'étais gamin."
                            },
                            {
                                "example_id": "eb5acfb4-00f0-46a3-96ec-c8a6fad33096",
                                "sense_id": "ea63692b-dc64-3d84-bd24-801348681db2",
                                "text": "(Mal)heureusement, je travaillais hier soir, et même s'il est retélédiffusé, je ne crois pas le regarder..."
                            },
                            {
                                "example_id": "bd85f76c-dad5-466e-945a-1382d59591f3",
                                "sense_id": "ea63692b-dc64-3d84-bd24-801348681db2",
                                "text": "Pour les intéressés: le grandiose spectacle présenté sur les Plaines d'Abraham, le 23 juin 2008, de la Fête Nationale du Québec, qui sera retélédiffusé sur TV5, demain, le 26 juin 2008, de 9h30 à 11h"
                            }
                        ]
                    }
