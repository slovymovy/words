                "senses": [
                    {
                        "sense_id": "3023f646-c95c-356f-a97e-687f2a8f00a7",
                        "entry_id": "c671d6d4-65a0-3501-8b8c-5fc4c91960b0",
                        "glosses": [
                            "Remuscler, redonner un caractère athlétique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18b41784-d9c8-4a21-b623-44fb4f3f537f",
                                "sense_id": "3023f646-c95c-356f-a97e-687f2a8f00a7",
                                "text": "Julien Pinot précise que son travail est de « réathlétiser le coureur » avant le début de la saison."
                            },
                            {
                                "example_id": "252a5cf2-5197-4b50-9b13-e6960348e4fb",
                                "sense_id": "3023f646-c95c-356f-a97e-687f2a8f00a7",
                                "text": "Mon rôle sera de développer les capacités physiques de vos joueurs ainsi que de les réathlétiser suite à une longue blessure."
                            },
                            {
                                "example_id": "57eeb57e-2d20-4d2c-ad33-b6afe0bbcb68",
                                "sense_id": "3023f646-c95c-356f-a97e-687f2a8f00a7",
                                "text": "Le champion du monde de pentathlon moderne par équipes doit se réathlétiser.’' — (journal 20 minutes, 4 juin 2020, page 15)"
                            },
                            {
                                "example_id": "c835c67f-4654-4844-afee-3bf19bf0cf87",
                                "sense_id": "3023f646-c95c-356f-a97e-687f2a8f00a7",
                                "text": "La bonne manière de faire est de se réathlétiser."
                            }
                        ]
                    }
