                "translations": [
                    {
                        "translation_id": "a2ee8055-92ad-477a-a692-b15d3c979221",
                        "source_entry_id": "961ada1c-7ce9-3695-8be1-087b2b460984",
                        "source_sense_id": "c4e5f13b-9bee-3d34-b30f-324576f9e97c",
                        "target_lang_word": "occultist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occultist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff6805b-b230-396f-b444-9239cd41b717",
                                        "entry_id": "651501de-d21b-305b-9bde-177bb28ff1b0",
                                        "glosses": [
                                            "A person who practises or studies occultism; a practitioner of, or person learned in, the occult."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a49e8a3-9f2f-4702-aee7-27213cf801cb",
                                                "sense_id": "3ff6805b-b230-396f-b444-9239cd41b717",
                                                "text": "Albertus Magnus, the thirteenth century philosopher and occultist, states that coriander, valerian, and violet are love producing herbs."
                                            },
                                            {
                                                "example_id": "860c63db-1995-4a88-8f17-38b23247a727",
                                                "sense_id": "3ff6805b-b230-396f-b444-9239cd41b717",
                                                "text": "In the early 1930s, he fell under the spell of a wife-beating, alcoholic, Austrian occultist called Karl Maria Wiligut and a Dutch prehistorian called Herman Wirth, whose views further fed his fantastical illusions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bda132e2-e8b1-4e39-8672-f08967a5ef4b",
                        "source_entry_id": "961ada1c-7ce9-3695-8be1-087b2b460984",
                        "source_sense_id": "c4e5f13b-9bee-3d34-b30f-324576f9e97c",
                        "target_lang_word": "occultiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occultiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf2a620e-ca8f-3c33-8166-d1b190eb49bd",
                                        "entry_id": "6b3ef847-56dd-3c41-aa45-294a86b3d800",
                                        "glosses": [
                                            "Adepte de l'occultisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53feb273-a771-4d67-aaa3-3f2e22514a01",
                                                "sense_id": "cf2a620e-ca8f-3c33-8166-d1b190eb49bd",
                                                "text": "Un occultiste aura plutôt tendance à désirer devenir lui-même la source de son idéal, soit pour se démarquer de toutes les autres, soit pour s’inscrire dans une lignée spirituelle reconnue et certifiée."
                                            },
                                            {
                                                "example_id": "a1abd130-6fd3-4fd2-930a-f28468ac4252",
                                                "sense_id": "cf2a620e-ca8f-3c33-8166-d1b190eb49bd",
                                                "text": "Si la plupart des occultistes se revendiquent des enseignements mystiques d’Hermès Trismégiste ou de la tradition des kabbalistes, certains subirent l’influence de la pensée orientale, popularisée par la Société théosophique, d'autres encore s'inspirèrent de la religion chrétienne, de la gnose, ou de la mythologie égyptienne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "occultiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d30ebb13-dd4a-3b27-8633-cb556cc39afd",
                                        "entry_id": "2a46f6b2-6314-3fb9-b747-5c5340b81860",
                                        "glosses": [
                                            "Relatif à l'occultisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27fc969c-fabd-4d04-9cc0-4af4ab5ef69c",
                                                "sense_id": "d30ebb13-dd4a-3b27-8633-cb556cc39afd",
                                                "text": "En l’Angleterre, fleurirent de nombreux ordres occultistes (la plus célèbre étant le rosicrucien Ordre hermétique de la Golden Dawn) ayant pour objectif d'explorer la tradition antique de laquelle le mouvement se réclamait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60764f0a-58c9-43b2-b1ad-2e2d1283db75",
                        "source_entry_id": "961ada1c-7ce9-3695-8be1-087b2b460984",
                        "source_sense_id": "c4e5f13b-9bee-3d34-b30f-324576f9e97c",
                        "target_lang_word": "Okkultist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Okkultist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e52b7a1a-319d-30c3-a27b-720dc2218f8d",
                                        "entry_id": "a5dfba90-f3c2-32a5-b562-2137195a247a",
                                        "glosses": [
                                            "Anhänger des Okkultismus, der Lehre von außer- oder übersinnlichen Kräften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3595c1dc-15b3-4bbd-9e24-e39bf712624a",
                                                "sense_id": "e52b7a1a-319d-30c3-a27b-720dc2218f8d",
                                                "text": "„Zu allen Zeiten beschäftigten sich Philosophen, Mystiker und Okkultisten mit dem inneren Aufbau der sichtbaren Welt, ihrer Abstufung und Beschaffenheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
