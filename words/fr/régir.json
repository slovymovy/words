            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9abd3bba-d1bb-3529-8535-bf38ac5710bb",
                    "sense_definition": "Gouverner, diriger ou déterminer les règles et le fonctionnement de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gouverner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les lois votées par le parlement <w>régissent</w> la vie quotidienne de tous les citoyens."
                        },
                        {
                            "text": "Plusieurs principes fondamentaux <w>régissent</w> le fonctionnement de notre organisation interne."
                        }
                    ],
                    "synonyms": [
                        "gouverner",
                        "diriger",
                        "commander"
                    ],
                    "antonyms": [
                        "obéir",
                        "subir"
                    ],
                    "common_phrases": [
                        "régir le monde",
                        "régir la société"
                    ]
                },
                {
                    "sense_id": "5b4a52da-5561-3230-89f3-448a4015de6a",
                    "sense_definition": "Administrer ou gérer des biens, des affaires ou un domaine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "administrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce notaire a été officiellement chargé de <w>régir</w> les biens du défunt jusqu'au partage."
                        },
                        {
                            "text": "Il a confié à un gestionnaire compétent le soin de <w>régir</w> l'ensemble de ses terres."
                        }
                    ],
                    "synonyms": [
                        "administrer",
                        "gérer"
                    ],
                    "common_phrases": [
