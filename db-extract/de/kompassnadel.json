                "senses": [
                    {
                        "sense_id": "f491bc2e-ff3e-314c-b5c3-67b1933a7696",
                        "entry_id": "aa9d279d-2bc6-327c-8841-4e498e7c09e4",
                        "glosses": [
                            "sich zum magnetischen Nordpol ausrichtende eiserne Nadel eines Kompasses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2471c591-49d0-4dbe-827e-c39a0380e41a",
                                "sense_id": "f491bc2e-ff3e-314c-b5c3-67b1933a7696",
                                "text": "„Dieser Effekt wird zum Beispiel beim magnetischen Kompass ausgenutzt, bei dem sich die Kompassnadel, ein magnetischer Dipol, nach dem Erdmagnetfeld ausrichtet.“"
                            },
                            {
                                "example_id": "04851876-c51c-469c-ba45-46e5b4f7385b",
                                "sense_id": "f491bc2e-ff3e-314c-b5c3-67b1933a7696",
                                "text": "„Nach Überlieferungen soll der Chinese Huang Di 2634 v. Chr. den ersten Kompass verwendet haben. Ein Stück Magneteisenstein, das auf einem Bambusbrettchen in einer Wasserschale schwamm und sich in die Nord-Süd-Richtung ausrichtete, diente als Kompassnadel.“"
                            },
                            {
                                "example_id": "4d7923a1-0512-41ff-8f4e-fa3295e012d0",
                                "sense_id": "f491bc2e-ff3e-314c-b5c3-67b1933a7696",
                                "text": "„Stets wird unsere biographische Kompassnadel abgelenkt, von magnetischen Ereignissen gestört.“"
                            },
                            {
                                "example_id": "b886c0a4-536a-4c1b-bfc2-c62e17ad4515",
                                "sense_id": "f491bc2e-ff3e-314c-b5c3-67b1933a7696",
                                "text": "„Aber ich war damals so verliebt in das Leben und fand es selbstverständlich, dass ich dieser Kompassnadel folgen sollte – alles andere wäre Verrat an mir selbst und am Leben gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
