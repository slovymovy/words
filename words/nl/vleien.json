{
    "word_family": [
        "vleier",
        "vleierij",
        "vleiend",
        "gevlei"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "598c6c30-6e2e-3074-a9ce-56380d1229fb",
                    "sense_definition": "iemand overdreven of onoprecht prijzen, vaak om iets gedaan te krijgen of in de gunst te komen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "prijzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het heeft geen zin om de directeur te <w>vleien</w> voor een salarisverhoging.",
                            "target_lang_translations": {
                                "en": "There is no point in <w>flattering</w> the director for a pay raise."
                            }
                        },
                        {
                            "text": "Hij probeerde haar te <w>vleien</w> met mooie woorden over haar nieuwe kapsel.",
                            "target_lang_translations": {
                                "en": "He tried to <w>flatter</w> her with beautiful words about her new haircut."
                            }
                        }
                    ],
                    "synonyms": [
                        "flemen"
                    ],
                    "antonyms": [
                        "beledigen",
                        "bekritiseren"
                    ],
                    "target_lang_definitions": {
                        "en": "To praise someone excessively or insincerely, often to get something done or to gain favor."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flatter",
                                "target_lang_sense_clarification": "to praise insincerely to win favor"
                            },
                            {
                                "target_lang_word": "butter up",
                                "target_lang_sense_clarification": "to be very nice to someone to get a favor"
                            },
                            {
                                "target_lang_word": "sweet-talk",
                                "target_lang_sense_clarification": "to use charming words to persuade"
                            }
                        ]
                    },
                    "common_phrases": [
                        "iemand vleien",
                        "zich gevleid voelen"
                    ]
                },
                {
                    "sense_id": "57f9f197-d663-3eb6-a2b2-ee0c4ce8dd72",
                    "sense_definition": "liefdevol aanraken, aaien of strelen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aanraken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij zat zachtjes de kat te <w>vleien</w> terwijl ze een boek las.",
                            "target_lang_translations": {
                                "en": "She sat quietly <w>petting</w> the cat while she read a book."
                            }
                        },
                        {
                            "text": "De moeder bleef haar kind <w>vleien</w> tot het eindelijk in slaap viel.",
                            "target_lang_translations": {
                                "en": "The mother kept <w>caressing</w> her child until it finally fell asleep."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "in deze betekenis minder gebruikelijk in modern Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To touch lovingly, pet, or stroke."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "caress",
                                "target_lang_sense_clarification": "to touch or stroke gently and lovingly"
                            },
                            {
                                "target_lang_word": "pet",
                                "target_lang_sense_clarification": "to stroke an animal or person affectionately"
                            },
                            {
                                "target_lang_word": "fondle",
                                "target_lang_sense_clarification": "to handle or stroke in a loving way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a910b3a-1907-3949-b4c2-cf861a8ce162",
                    "sense_definition": "een platte steen zo over het water gooien dat deze herhaaldelijk stuitert",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen probeerden steentjes te <w>vleien</w> op het gladde oppervlak van het meer.",
                            "target_lang_translations": {
                                "en": "The children tried to <w>skip</w> stones on the smooth surface of the lake."
                            }
                        },
                        {
                            "text": "Hij kon een kiezelsteen wel zes keer laten <w>vleien</w> over de rivier.",
                            "target_lang_translations": {
                                "en": "He could make a pebble <w>skip</w> across the river as many as six times."
                            }
                        }
                    ],
                    "synonyms": [
                        "keilen"
                    ],
                    "common_phrases": [
                        "steentjes vleien"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in bepaalde dialecten gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To throw a flat stone over water so that it bounces repeatedly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "skip",
                                "target_lang_sense_clarification": "to throw a stone so it bounces on water"
                            },
                            {
                                "target_lang_word": "skim",
                                "target_lang_sense_clarification": "to throw a stone across a surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe013025-411b-371d-98af-60bada77fe0d",
                    "sense_definition": "een verouderde spelling of variant van <w>vlijen</w>, wat neerleggen of schikken betekent",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "leggen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de oude tekst stond beschreven hoe zij zich tegen hem aan kwam <w>vleien</w>.",
                            "target_lang_translations": {
                                "en": "In the old text it was described how she came to <w>nestle</w> against him."
                            }
                        },
                        {
                            "text": "Men zag hem de kussens voorzichtig op de bank <w>vleien</w>.",
                            "target_lang_translations": {
                                "en": "He was seen carefully <w>laying</w> the cushions on the sofa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "tegenwoordig gespeld als vlijen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An archaic spelling or variant of 'vlijen', meaning to lay down or arrange."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lay down",
                                "target_lang_sense_clarification": "to place something or oneself in a resting position"
                            },
                            {
                                "target_lang_word": "snuggle",
                                "target_lang_sense_clarification": "to settle or move into a warm, comfortable position"
                            },
                            {
                                "target_lang_word": "nestle",
                                "target_lang_sense_clarification": "to settle oneself comfortably against something"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0feeb199-d85a-3fc4-9393-d980c0c2e1c0",
                    "sense_definition": "het meervoud van <w>vlei</w>, een term voor een vallei of een moerassig gebied",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De uitgestrekte <w>vleien</w> in Zuid-Afrika stonden na de regenval volledig onder water.",
                            "target_lang_translations": {
                                "en": "The vast <w>vleis</w> in South Africa were completely submerged after the rainfall."
                            }
                        },
                        {
                            "text": "Tijdens hun trektocht doorkruisten ze verschillende droge <w>vleien</w>.",
                            "target_lang_translations": {
                                "en": "During their trek, they crossed several dry <w>marshes</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in Zuid-Afrikaans Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The plural of 'vlei', a term for a valley or a marshy area."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vleis",
                                "target_lang_sense_clarification": "shallow seasonal lakes or wetlands (South African English)"
                            },
                            {
                                "target_lang_word": "marshes",
                                "target_lang_sense_clarification": "low-lying land that is flooded in wet seasons"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
