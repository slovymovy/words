{
    "word_family": [
        "tomb",
        "stone",
        "tombstoning"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1408d1d0-53f7-3ad1-b42f-693c14d9fb5d",
                    "sense_definition": "A stone slab or marker placed at a grave to identify the person buried there.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "burial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>tombstone</w> was covered in moss, making it difficult to read the dates.",
                            "target_lang_translations": {
                                "ru": "Старое <w>надгробие</w> поросло мхом, из-за чего было трудно разобрать даты."
                            }
                        },
                        {
                            "text": "They decided to place a <w>granite</w> <w>tombstone</w> at the head of the grave.",
                            "target_lang_translations": {
                                "ru": "Они решили установить гранитную <w>надгробную плиту</w> в изголовье могилы."
                            }
                        }
                    ],
                    "synonyms": [
                        "headstone",
                        "gravestone",
                        "grave marker"
                    ],
                    "common_phrases": [
                        "granite tombstone",
                        "weathered tombstone",
                        "tombstone inscription"
                    ],
                    "target_lang_definitions": {
                        "ru": "Каменная плита или памятник, устанавливаемый на могиле для идентификации похороненного там человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надгробие",
                                "target_lang_sense_clarification": "общее название памятника"
                            },
                            {
                                "target_lang_word": "надгробная плита",
                                "target_lang_sense_clarification": "горизонтальная или вертикальная плита"
                            },
                            {
                                "target_lang_word": "могильный камень",
                                "target_lang_sense_clarification": "каменная метка на могиле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a413ed17-5d68-33e5-8ffb-49b1d28519f8",
                    "sense_definition": "A simple, text-based advertisement in a publication, often enclosed in a plain box.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "advertising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank published a <w>tombstone</w> advertisement to announce the successful merger.",
                            "target_lang_translations": {
                                "ru": "Банк опубликовал <w>краткое объявление</w> в рамке, чтобы сообщить об успешном слиянии."
                            }
                        },
                        {
                            "text": "Financial firms often use a <w>tombstone</w> ad to list the participants in a large deal.",
                            "target_lang_translations": {
                                "ru": "Финансовые фирмы часто используют <w>томбстоун</w>, чтобы перечислить участников крупной сделки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tombstone advertisement",
                        "tombstone ad"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in finance and publishing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Простое текстовое объявление в издании, обычно заключенное в рамку, часто используемое в финансах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "томбстоун",
                                "target_lang_sense_clarification": "профессиональный жаргон в финансах"
                            },
                            {
                                "target_lang_word": "краткое объявление",
                                "target_lang_sense_clarification": "в рамке, без графики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d67c9e09-8d4b-3915-9e5e-a1ce6d355da5",
                    "sense_definition": "A small plaque in a museum that provides information about an exhibit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "museum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I stopped to read the <w>tombstone</w> next to the painting to learn about the artist.",
                            "target_lang_translations": {
                                "ru": "Я остановился, чтобы прочитать <w>табличку</w> рядом с картиной и узнать об авторе."
                            }
                        },
                        {
                            "text": "The museum <w>tombstone</w> included the accession number and the date of the work.",
                            "target_lang_translations": {
                                "ru": "Музейная <w>этикетка</w> содержала инвентарный номер и дату создания работы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "museum tombstone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая табличка в музее с информацией об экспонате."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "музейная этикетка",
                                "target_lang_sense_clarification": "информационная табличка"
                            },
                            {
                                "target_lang_word": "экспликация",
                                "target_lang_sense_clarification": "текст с описанием экспоната"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f17a75b8-6e59-30f1-9d84-ac21c9833cdd",
                    "sense_definition": "A record used in computing to mark that an item has been deleted from a database.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system uses a <w>tombstone</w> to ensure the deletion is synchronized across all servers.",
                            "target_lang_translations": {
                                "ru": "Система использует <w>маркер удаления</w>, чтобы обеспечить синхронизацию удаления на всех серверах."
                            }
                        },
                        {
                            "text": "If the <w>tombstone</w> lifetime expires, the deleted object might reappear during replication.",
                            "target_lang_translations": {
                                "ru": "Если срок жизни <w>записи об удалении</w> истечет, удаленный объект может снова появиться во время репликации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tombstone lifetime",
                        "tombstone record"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Technical jargon in database management"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запись в базе данных, помечающая объект как удаленный без его физического удаления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надгробная плита",
                                "target_lang_sense_clarification": "калька с английского в ИТ"
                            },
                            {
                                "target_lang_word": "маркер удаления",
                                "target_lang_sense_clarification": "техническое описание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b28fdf7-e5d7-361f-8fa3-e748eecd529a",
                    "sense_definition": "The symbol used in mathematics to indicate the end of a proof.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student finished the complex derivation and drew a small <w>tombstone</w> at the bottom.",
                            "target_lang_translations": {
                                "ru": "Студент закончил сложный вывод и нарисовал внизу маленький <w>квадратик</w>."
                            }
                        },
                        {
                            "text": "In many modern textbooks, the <w>tombstone</w> has replaced the traditional Q.E.D. notation.",
                            "target_lang_translations": {
                                "ru": "Во многих современных учебниках <w>символ Халмоша</w> заменил традиционное обозначение Q.E.D."
                            }
                        }
                    ],
                    "synonyms": [
                        "halmos"
                    ],
                    "target_lang_definitions": {
                        "ru": "Математический символ (обычно закрашенный квадрат), обозначающий конец доказательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "символ Халмоша",
                                "target_lang_sense_clarification": "математический термин"
                            },
                            {
                                "target_lang_word": "квадрат",
                                "target_lang_sense_clarification": "конец доказательства"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7dbfbaf9-d4a2-3f82-973d-9fd707782376",
                    "sense_definition": "To jump into water from a high point, such as a cliff, while keeping the body vertical.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "diving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenagers were warned not to <w>tombstone</w> from the pier because of the shallow water.",
                            "target_lang_translations": {
                                "ru": "Подростков предупредили, чтобы они не <w>прыгали солдатиком</w> с пирса из-за мелководья."
                            }
                        },
                        {
                            "text": "He decided to <w>tombstone</w> into the sea, entering the water perfectly straight.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>прыгнуть солдатиком</w> в море, войдя в воду идеально ровно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tombstone from a cliff"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in the UK for this activity"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прыгать в воду с большой высоты (например, со скалы), сохраняя тело в строго вертикальном положении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыгать солдатиком",
                                "target_lang_sense_clarification": "прыжок в воду вертикально"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf08022e-f056-383c-9954-063e4cceafd3",
                    "sense_definition": "To mark a piece of data as deleted in a system using a specific marker.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The administrator had to <w>tombstone</w> the corrupted records to prevent them from syncing.",
                            "target_lang_translations": {
                                "ru": "Администратору пришлось <w>пометить на удаление</w> поврежденные записи, чтобы предотвратить их синхронизацию."
                            }
                        },
                        {
                            "text": "When you delete a user, the system will <w>tombstone</w> the account rather than removing it immediately.",
                            "target_lang_translations": {
                                "ru": "При удалении пользователя система <w>пометит</w> аккаунт <w>как удаленный</w>, а не удалит его немедленно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tombstone records"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Technical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Помечать данные как удаленные в системе с помощью специального маркера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помечать на удаление",
                                "target_lang_sense_clarification": "в контексте баз данных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b829afe1-ee71-3f22-b757-c56e893d76a0",
                    "sense_definition": "A historic city located in the southeastern part of Arizona, USA.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cities",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Many tourists visit <w>Tombstone</w> to see the site of the famous gunfight at the O.K. Corral.",
                            "target_lang_translations": {
                                "ru": "Многие туристы посещают <w>Тумстон</w>, чтобы увидеть место знаменитой перестрелки у корраля О-Кей."
                            }
                        },
                        {
                            "text": "The town of <w>Tombstone</w> is known for its well-preserved Wild West history.",
                            "target_lang_translations": {
                                "ru": "Город <w>Тумстон</w> известен своей хорошо сохранившейся историей Дикого Запада."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исторический город в штате Аризона, США, известный событиями времен Дикого Запада."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тумстон",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}