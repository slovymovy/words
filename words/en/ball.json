                            {
                                "target_lang_word": "欢乐",
                                "target_lang_sense_clarification": "非常愉快的时光"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c740be6-ef9f-345c-927e-bcfe3da002d0",
                    "sense_definition": "The rounded, fleshy part of the human foot between the toes and the arch.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should try to land on the <w>ball</w> of your foot when running.",
                            "target_lang_translations": {
                                "ru": "При беге старайтесь приземляться на <w>подушечку</w> стопы.",
                                "zh": "跑步时，你应该尽量用脚的<w>前脚掌</w>着地。"
                            }
                        },
                        {
                            "text": "She stood on the <w>balls</w> of her feet to reach the top shelf.",
                            "target_lang_translations": {
                                "ru": "Она встала на <w>носочки</w>, чтобы дотянуться до верхней полки.",
                                "zh": "她踮起<w>前脚掌</w>去够最上面的架子。"
                            }
