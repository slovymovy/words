                                    },
                                    {
                                        "sense_id": "d9067a9a-80a4-36e5-b3ee-8aa850ac4a07",
                                        "entry_id": "b88c5138-a181-38ac-94e5-488f147fdf9f",
                                        "glosses": [
                                            "A mafia: a group that engages in organized crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5924869a-e57d-4569-9625-c73393362bbd",
                                                "sense_id": "d9067a9a-80a4-36e5-b3ee-8aa850ac4a07",
                                                "text": "What if it is a mob killing? They can’t hurt me, but …"
                                            },
                                            {
                                                "example_id": "f9649ab0-33f6-40a2-96f7-442b1698e1e8",
                                                "sense_id": "d9067a9a-80a4-36e5-b3ee-8aa850ac4a07",
                                                "text": "See also: Mob, Mafia (proper noun senses for specific ones)"
                                            },
                                            {
                                                "example_id": "c2d52d90-fcb0-44e1-8cf9-222d9ee32ae4",
                                                "sense_id": "d9067a9a-80a4-36e5-b3ee-8aa850ac4a07",
                                                "text": "The Bat—they called him the Bat.[…]. He'd never been in stir, the bulls had never mugged him, he didn't run with a mob, he played a lone hand, and fenced his stuff so that even the fence couldn't swear he knew his face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b426801-3554-3d77-b8e7-0076b86d28b1",
                                        "entry_id": "b88c5138-a181-38ac-94e5-488f147fdf9f",
                                        "glosses": [
                                            "A group of Aboriginal people associated with an extended family group, clan group or wider community group, from a particular place or country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fadeb94-0036-46e1-9ee6-6c76f5eddaa4",
                                                "sense_id": "8b426801-3554-3d77-b8e7-0076b86d28b1",
                                                "text": "There’s nothing like local knowledge and after thousands of years living here the Noongar mob understand this land better than anyone, so it makes sense for them to tap into the lucrative tourism industry."
                                            },
                                            {
                                                "example_id": "1ac4debf-7265-457e-b8f4-c472db4e00f8",
                                                "sense_id": "8b426801-3554-3d77-b8e7-0076b86d28b1",
                                                "text": "There’s a saying among blak mob, ‘It doesn’t matter how much milk you put in tea, it’s still tea.’ I am a descendant of genocide survivors, a child of the oldest living culture on Earth. Nothing, no amount of milk, can change that."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
