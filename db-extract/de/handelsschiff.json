                                "target_senses": [
                                    {
                                        "sense_id": "98ad1633-65e5-3a8c-a624-e5eb457821d3",
                                        "entry_id": "fbe827c1-4adc-3c85-be46-259b552a9e48",
                                        "glosses": [
                                            "A ship that is principally or (usually) entirely civilian, engaged in trade, which carries cargo, passengers, or both."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a74ebbeb-6410-4b67-aa44-99517e9aed9c",
                                                "sense_id": "98ad1633-65e5-3a8c-a624-e5eb457821d3",
                                                "text": "Old pirates, yes, they rob I\nSold I to the merchant ships\nMinutes after they took I\nFrom the bottomless pit."
                                            }
                                        ]
                                    }
                                ]
