                            {
                                "example_id": "2beee5a0-80b1-4b03-93b0-50bc7ee17e5f",
                                "sense_id": "579882fb-eea0-30fe-86b9-6e083af3491a",
                                "text": "„Melancholische Todesgedanken, Sinnzweifel, sie sind nicht zu verjagen durch Alkohol oder die Suche nach menschlicher Nähe.“"
                            },
                            {
                                "example_id": "8e1d736f-3c5d-446a-a5d1-253b20b2212e",
                                "sense_id": "579882fb-eea0-30fe-86b9-6e083af3491a",
                                "text": "„Sinnlosigkeitsgefühle und Sinnzweifel können den Menschen über Jahre begleiten oder auch plötzlich zur Frage werden - wozu?“"
                            }
                        ],
