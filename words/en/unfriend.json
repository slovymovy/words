{
    "word_family": [
        "friend",
        "befriend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f11506d-a673-366f-82e7-7b5b3b17fadf",
                    "sense_definition": "To remove someone from a list of friends on a social networking website.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>unfriend</w> him after they had an argument online.",
                            "target_lang_translations": {
                                "nl": "Ze besloot hem te <w>ontvrienden</w> nadat ze online ruzie hadden gehad."
                            }
                        },
                        {
                            "text": "Why did you <w>unfriend</w> me on social media yesterday?",
                            "target_lang_translations": {
                                "nl": "Waarom heb je me gisteren op sociale media <w>ontvriend</w>?"
                            }
                        }
                    ],
                    "synonyms": [
                        "defriend"
                    ],
                    "antonyms": [
                        "befriend"
                    ],
                    "common_phrases": [
                        "unfriend someone on social media"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand verwijderen uit een lijst van vrienden op een sociaal netwerk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ontvrienden",
                                "target_lang_sense_clarification": "op sociale media"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42d903db-3348-3c0d-b249-4c5945509d26",
                    "sense_definition": "To end a friendship; to sever ties as friends.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were mutually <w>unfriended</w> after the bitter disagreement over family property.",
                            "target_lang_translations": {
                                "nl": "Ze <w>verbraken wederzijds de vriendschap</w> na het bittere meningsverschil over familiebezit."
                            }
                        },
                        {
                            "text": "A petty dispute should not cause you to <w>unfriend</w> a companion of many years.",
                            "target_lang_translations": {
                                "nl": "Een futiel geschil zou er niet toe moeten leiden dat je <w>breekt met</w> een metgezel van vele jaren."
                            }
                        }
                    ],
                    "antonyms": [
                        "befriend"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historic or literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een vriendschap beëindigen; de banden met een vriend verbreken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "de vriendschap verbreken met",
                                "target_lang_sense_clarification": "niet meer bevriend zijn"
                            },
                            {
                                "target_lang_word": "breken met",
                                "target_lang_sense_clarification": "de banden verbreken"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "77230c74-d6cf-393b-91d7-fec1124060bd",
                    "sense_definition": "A person who is not a friend; an adversary or enemy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh conditions of winter proved to be an <w>unfriend</w> to the travelers.",
                            "target_lang_translations": {
                                "nl": "De barre omstandigheden van de winter bleken een <w>vijand</w> te zijn voor de reizigers."
                            }
                        },
                        {
                            "text": "They parted as bitter <w>unfriends</w> after many years of companionship.",
                            "target_lang_translations": {
                                "nl": "Ze gingen na vele jaren van gezelschap uit elkaar als bittere <w>vijanden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonfriend",
                        "non-friend"
                    ],
                    "antonyms": [
                        "friend"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historic or literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die geen vriend is; een tegenstander of vijand."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vijand",
                                "target_lang_sense_clarification": "tegenstander"
                            },
                            {
                                "target_lang_word": "onvriend",
                                "target_lang_sense_clarification": "verouderd of archaïsch"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}