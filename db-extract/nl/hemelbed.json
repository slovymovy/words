                "senses": [
                    {
                        "sense_id": "4c60c200-b2ef-3d9b-acc9-4b9c5d78a316",
                        "entry_id": "8584b41c-d679-3081-9244-e749138e67d3",
                        "glosses": [
                            "bed [1] met overkapping (\\\"hemel\\\") en gordijnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea2d42c-6745-48ae-9ab5-15a112e38127",
                                "sense_id": "4c60c200-b2ef-3d9b-acc9-4b9c5d78a316",
                                "text": "De achterkamer werd gedomineerd door een monsterlijk, ondateerbaar hemelbed met vier vergulde zuilen in Egyptische stijl waarop een baldakijn rustte van donkerrood fluweel, met geborduurde sterren van gouddraad. Wie zou in staat zijn te bevroeden hoeveel zuchten en gefluisterde geheimen er onder die sterrenstof waren blijven hangen?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ab74f76-285d-42ee-b223-d050ed5db35f",
                        "source_entry_id": "8584b41c-d679-3081-9244-e749138e67d3",
                        "source_sense_id": "4c60c200-b2ef-3d9b-acc9-4b9c5d78a316",
                        "target_lang_word": "Himmelbett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Himmelbett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df583c3f-8728-329d-b3fb-e3188d620df4",
                                        "entry_id": "e78ae3b2-6fdb-38e1-92b2-7c2cd33b320c",
                                        "glosses": [
                                            "ein Bett, das über der Liegefläche durch den sogenannten „Himmel“ nach oben abgeschlossen ist, der meist von vier Säulen an den Ecken getragen ist und an dem oft Vorhänge befestigt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3727687a-0043-4a50-bc3c-f8a9fdeb4881",
                                                "sense_id": "df583c3f-8728-329d-b3fb-e3188d620df4",
                                                "text": "Himmelbetten halten durch den Himmel und die seitlichen Vorhänge den so umschlossenen Innenraum recht warm."
                                            },
                                            {
                                                "example_id": "3c0415df-2cf5-4e96-bd11-1b632648ef88",
                                                "sense_id": "df583c3f-8728-329d-b3fb-e3188d620df4",
                                                "text": "„Dieses mit einem Baldachin überspannte Himmelbett ist mehr als ein kostbares Möbelstück und ein pompöses Ruhelager.“"
                                            },
                                            {
                                                "example_id": "dc3c7881-1cec-4351-b6ef-0210cef0d485",
                                                "sense_id": "df583c3f-8728-329d-b3fb-e3188d620df4",
                                                "text": "„Ich trat ein und wurde von einer rundlichen Wirtin empfangen, die mir ein Zimmer anwies, in dem ein mächtiges Himmelbett stand.“"
                                            },
                                            {
                                                "example_id": "2b68e71d-e01d-4d5c-a664-7f6388a8ff50",
                                                "sense_id": "df583c3f-8728-329d-b3fb-e3188d620df4",
                                                "text": "Statt auf dem Boden liegen die Camper in Himmelbetten, haben eigene Toiletten und Küchen im Zelt, selbst die Frühstücksbrötchen bekommen sie geliefert."
                                            },
                                            {
                                                "example_id": "0b426c2e-9855-463b-aa8f-2fe0144a9c1f",
                                                "sense_id": "df583c3f-8728-329d-b3fb-e3188d620df4",
                                                "text": "In einem der Zimmer fand er das träumende Fürstenpaar von und zu Liechtenstein in einem Himmelbett liegen."
                                            },
                                            {
                                                "example_id": "249d5cb7-b5e0-4f15-b69d-637e72b8b7b2",
                                                "sense_id": "df583c3f-8728-329d-b3fb-e3188d620df4",
                                                "text": "Abla Fahita räkelt sich in einem dünnen Nachthemd auf ihrem Himmelbett, bis zwei gut gebaute Kerle im Bild auftauchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8a3e406-24ad-43d0-8f77-ae9017aeef07",
                        "source_entry_id": "8584b41c-d679-3081-9244-e749138e67d3",
