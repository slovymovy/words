                    {
                        "translation_id": "95b55d11-f29d-4fb8-9e99-49ca362890c9",
                        "source_entry_id": "4c28c512-fad0-399a-88fd-a9e7fcdf3351",
                        "source_sense_id": "6ec34c30-ffc3-3900-a8ab-24b5cb15c9f6",
                        "source_sense_description": "relating to geology",
                        "target_lang_word": "géologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cd8176a-a474-36d8-9843-24ae04b14420",
                                        "entry_id": "f4986968-239b-3caa-be68-4fb783ba33d5",
                                        "glosses": [
                                            "Qui concerne la géologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e8293ab-8919-4fc4-8f29-3a296ef0e8f8",
                                                "sense_id": "6cd8176a-a474-36d8-9843-24ae04b14420",
                                                "text": "[…], le sol, on le voit, s’était absolument modifié. Il était évident que quelque convulsion géologique y avait semé ces blocs énormes."
                                            },
                                            {
                                                "example_id": "0e7eb154-5134-4c68-aefe-0f3ed635ed7e",
                                                "sense_id": "6cd8176a-a474-36d8-9843-24ae04b14420",
                                                "text": "Nous avons vu que le squelette géologique de Chausey était entièrement granitique, …."
                                            },
                                            {
                                                "example_id": "46340fbc-b208-4259-8602-fa0f65abb8ea",
                                                "sense_id": "6cd8176a-a474-36d8-9843-24ae04b14420",
                                                "text": "Ces montagnes, en raison de leur constitution géologique, sont plus que n’importe quelles autres soumises à l’influence de l’érosion."
                                            },
                                            {
                                                "example_id": "0ca93911-27a7-45fa-98da-758c89ee16c8",
                                                "sense_id": "6cd8176a-a474-36d8-9843-24ae04b14420",
                                                "text": "Il avait établi le catalogue des champignons de toute la région, par aires géologiques préférentielles."
                                            },
                                            {
                                                "example_id": "3e60485c-0dac-4a46-b915-ced7ca3d7d78",
                                                "sense_id": "6cd8176a-a474-36d8-9843-24ae04b14420",
                                                "text": "Depuis 1968, le BRGM s’est vu confier la mission de réaliser les cartes géologiques de la France. Trois échelles sont disponibles et chacune possède sa propre utilité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba1d2cdf-67be-4a58-94ca-b2466d8f9a16",
                        "source_entry_id": "4c28c512-fad0-399a-88fd-a9e7fcdf3351",
                        "source_sense_id": "6ec34c30-ffc3-3900-a8ab-24b5cb15c9f6",
                        "source_sense_description": "relating to geology",
                        "target_lang_word": "geologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf136a5f-e1bb-3d9f-b183-131b2c85542f",
                                        "entry_id": "92615952-d102-3f4c-ab1e-3d39d15dbf97",
                                        "glosses": [
                                            "auf die Geologie bezogen, die Geologie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c9c49a3-037f-4fd0-b28c-375c9f98189c",
                                                "sense_id": "bf136a5f-e1bb-3d9f-b183-131b2c85542f",
                                                "text": "Das geologische Alter der Erde beträgt über 4 Milliarden Jahre."
                                            },
                                            {
                                                "example_id": "1ed94680-dfbb-4580-82e1-2ccc7dc21a92",
                                                "sense_id": "bf136a5f-e1bb-3d9f-b183-131b2c85542f",
                                                "text": "Die geologischen Lager sind so groß wie Belgien, dehnen sich auf eine Fläche von 30.000 Quadratkilometern und reichen bis 300 Kilometer hinaus aufs offene Meer."
                                            },
                                            {
                                                "example_id": "cdf0d7d7-48b9-4117-9e05-6db5c28baa12",
                                                "sense_id": "bf136a5f-e1bb-3d9f-b183-131b2c85542f",
                                                "text": "Weniger dagegen werden Umweltschutzgründe genannt oder der Denkmalschutz oder geologische Gefahren des Tunnelbaus."
                                            },
                                            {
                                                "example_id": "795367b7-b43a-490c-aea4-30b6f25b1402",
                                                "sense_id": "bf136a5f-e1bb-3d9f-b183-131b2c85542f",
                                                "text": "„Die moderne Paläoanthropologie basiert auf der Evolutionstheorie und bewegt sich innerhalb der Grenzen der biologischen und geologischen Wissenschaften.“"
                                            },
                                            {
                                                "example_id": "55a045f2-4da3-4963-8dd7-fe8b139d6dca",
                                                "sense_id": "bf136a5f-e1bb-3d9f-b183-131b2c85542f",
                                                "text": "„Neben die Gebirgsbildungen tritt ein weiteres wichtiges geologisches Ereignis, das Eiszeitalter, in dem Nordeuropa mehrfach von einer mächtigen Inlandeisdecke überdeckt war, die sich bis nach England, nach Mitteleuropa und in das Osteuropäische Flachland hinein erstreckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
