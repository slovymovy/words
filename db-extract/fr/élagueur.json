                "senses": [
                    {
                        "sense_id": "8a5d1bd9-e5db-380d-b336-20e3ca7fa4dd",
                        "entry_id": "ad395f24-e04e-37c6-875c-22d32da70621",
                        "glosses": [
                            "Celui qui fait métier d’élaguer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "081e6379-1db4-4acc-a6d9-b8889927be96",
                                "sense_id": "8a5d1bd9-e5db-380d-b336-20e3ca7fa4dd",
                                "text": "Il lui sembla que Gédéon serait un outil parfait pour cette mauvaise besogne et il se mit à le préparer, à le fourbir, à l’affûter comme une serpe d’élagueur."
                            },
                            {
                                "example_id": "6eec9290-4cc9-4594-9918-f60698c450d9",
                                "sense_id": "8a5d1bd9-e5db-380d-b336-20e3ca7fa4dd",
                                "text": "Durant ce travail, une branche tombe sur un câble d'alimentation électrique sous tension : un arc électrique se crée entre le câble, la branche et l'élagueur et ce dernier est mortellement électrocuté."
                            }
                        ]
                    }
                ],
