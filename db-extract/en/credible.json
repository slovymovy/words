                                        "entry_id": "91b1edee-3806-35e1-af0f-26f17133f66e",
                                        "glosses": [
                                            "so dargestellt, dass es für wahr gehalten werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "805f3b4f-791d-4767-af6f-d112b5af9b5c",
                                                "sense_id": "45d4debe-41a7-3a0f-aa8e-0d3c3219d77f",
                                                "text": "Er konnte mir glaubhaft versichern, dass er die Wahrheit sagt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
