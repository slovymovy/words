                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "secondary",
                                "target_lang_sense_clarification": "of less than primary importance"
                            },
                            {
                                "target_lang_word": "subordinate",
                                "target_lang_sense_clarification": "lower in importance or rank"
                            },
                            {
                                "target_lang_word": "minor",
                                "target_lang_sense_clarification": "lesser in importance or seriousness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c525b96-0456-3f44-b483-0760436ae3cb",
                    "sense_definition": "met een lagere rang of positie en daardoor afhankelijk van een meerdere",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "hiërarchie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De officier gaf een bevel aan zijn <w>ondergeschikte</w> militairen.",
                            "target_lang_translations": {
                                "en": "The officer gave an order to his <w>subordinate</w> soldiers."
                            }
                        },
                        {
                            "text": "In een hiërarchische organisatie is de ene afdeling vaak <w>ondergeschikt</w> aan de andere.",
                            "target_lang_translations": {
                                "en": "In a hierarchical organization, one department is often <w>subordinate</w> to another."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderdanig",
                        "subaltern"
