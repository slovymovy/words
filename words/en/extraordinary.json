{
    "word_family": [
        "extraordinarily",
        "extraordinariness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "db0dfa86-7831-3744-b30e-0fbb136bd2d0",
                    "sense_definition": "Not ordinary; exceptional or unusual in a way that attracts attention.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quality_unusual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police took <w>extraordinary</w> measures to ensure safety during the parade.",
                            "target_lang_translations": {
                                "ru": "Полиция приняла <w>чрезвычайные</w> меры для обеспечения безопасности во время парада.",
                                "zh": "警方在游行期间采取了<w>异常</w>措施，以确保安全。"
                            }
                        },
                        {
                            "text": "It is quite <w>extraordinary</w> that they managed to finish the project so quickly.",
                            "target_lang_translations": {
                                "ru": "Довольно <w>необычно</w>, что им удалось закончить проект так быстро.",
                                "zh": "他们竟然能这么快完成这个项目，实在<w>非同寻常</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exceptional",
                        "noteworthy",
                        "unusual",
                        "remarkable"
                    ],
                    "antonyms": [
                        "ordinary",
                        "normal",
                        "usual",
                        "everyday",
                        "regular"
                    ],
                    "common_phrases": [
                        "extraordinary circumstances",
                        "extraordinary meeting",
                        "extraordinary measures",
                        "extraordinary event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не обычный; исключительный или необычный, привлекающий внимание.",
                        "zh": "不普通的；以引人注意的方式表现得特殊或不同寻常。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "необычный",
                                "target_lang_sense_clarification": "общий смысл; отличающийся от привычного"
                            },
                            {
                                "target_lang_word": "чрезвычайный",
                                "target_lang_sense_clarification": "используется с мерами, обстоятельствами или событиями"
                            },
                            {
                                "target_lang_word": "экстраординарный",
                                "target_lang_sense_clarification": "книжное/формальное; выходящий из ряда вон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不寻常",
                                "target_lang_sense_clarification": "一般指不同于平常、引人注意"
                            },
                            {
                                "target_lang_word": "非同寻常",
                                "target_lang_sense_clarification": "强调格外特别、超出常态"
                            },
                            {
                                "target_lang_word": "异常",
                                "target_lang_sense_clarification": "常用于措施、情况等偏正式语境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebe60052-77bd-3bf0-be8d-9875eade65fc",
                    "sense_definition": "Remarkably good or impressive.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "quality_good",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is an <w>extraordinary</w> musician who plays three instruments perfectly.",
                            "target_lang_translations": {
                                "ru": "Она <w>выдающийся</w> музыкант, который безупречно играет на трех инструментах.",
                                "zh": "她是一位<w>杰出</w>的音乐家，三种乐器都演奏得十分完美。"
                            }
                        },
                        {
                            "text": "The view from the top of the mountain was truly <w>extraordinary</w>.",
                            "target_lang_translations": {
                                "ru": "Вид с вершины горы был поистине <w>необыкновенным</w>.",
                                "zh": "山顶的景色真是<w>非凡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outstanding",
                        "exceptional",
                        "unparalleled"
                    ],
                    "antonyms": [
                        "ordinary"
                    ],
                    "common_phrases": [
                        "extraordinary talent",
                        "extraordinary achievement",
                        "extraordinary beauty",
                        "extraordinary success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удивительно хороший или впечатляющий.",
                        "zh": "好得惊人或令人印象深刻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдающийся",
                                "target_lang_sense_clarification": "о таланте, способностях или людях"
                            },
                            {
                                "target_lang_word": "необыкновенный",
                                "target_lang_sense_clarification": "поразительный, впечатляющий"
                            },
                            {
                                "target_lang_word": "исключительный",
                                "target_lang_sense_clarification": "превосходный, единственный в своем роде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杰出",
                                "target_lang_sense_clarification": "形容人、才能、成就等特别优秀"
                            },
                            {
                                "target_lang_word": "非凡",
                                "target_lang_sense_clarification": "强调非常出色、令人赞叹"
                            },
                            {
                                "target_lang_word": "卓越",
                                "target_lang_sense_clarification": "较正式，指品质或表现极为优秀"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50a46237-3aa8-397b-8762-5528fa9ec369",
                    "sense_definition": "Specially employed for a specific purpose or occasion, often used in official titles.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "title_special",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was appointed as an envoy <w>extraordinary</w> to handle the peace treaty.",
                            "target_lang_translations": {
                                "ru": "Он был назначен <w>чрезвычайным</w> посланником для работы над мирным договором.",
                                "zh": "他被任命为处理这项和平条约的<w>特命</w>使节。"
                            }
                        },
                        {
                            "text": "The royal household includes a physician <w>extraordinary</w> for special consultations.",
                            "target_lang_translations": {
                                "ru": "В штат королевского двора входит <w>внештатный</w> врач для особых консультаций.",
                                "zh": "王室还设有一位负责特殊会诊的<w>特聘</w>医生。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ambassador extraordinary",
                        "envoy extraordinary",
                        "physician extraordinary"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often postpositive in titles"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специально назначенный для конкретной цели или случая, часто используется в официальных титулах.",
                        "zh": "为某一特定目的或场合专门任用的，常见于正式头衔中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чрезвычайный",
                                "target_lang_sense_clarification": "в дипломатических и официальных титулах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特命",
                                "target_lang_sense_clarification": "多用于外交或正式头衔，如特命使节"
                            },
                            {
                                "target_lang_word": "特聘",
                                "target_lang_sense_clarification": "指为特定目的或场合专门聘任"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68715755-cdf5-3fa5-ad8d-4946a439c4f6",
                    "sense_definition": "Anything that goes beyond what is ordinary, often referring to unexpected expenses or items.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The annual budget report listed the <w>extraordinaries</w> in a separate column.",
                            "target_lang_translations": {
                                "ru": "В ежегодном бюджетном отчете <w>непредвиденные расходы</w> были указаны в отдельной колонке.",
                                "zh": "年度预算报告把<w>额外开支</w>单独列在一栏。"
                            }
                        },
                        {
                            "text": "He was fascinated by the <w>extraordinaries</w> of nature found in the deep jungle.",
                            "target_lang_translations": {
                                "ru": "Он был очарован <w>диковинами</w> природы, найденными в глубоких джунглях.",
                                "zh": "他对丛林深处发现的大自然<w>奇观</w>十分着迷。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used in historical or financial contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Всё, что выходит за рамки обычного; часто относится к непредвиденным расходам или предметам.",
                        "zh": "超出通常范围的事物；常指意外支出或特殊项目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непредвиденные расходы",
                                "target_lang_sense_clarification": "финансовый термин"
                            },
                            {
                                "target_lang_word": "нечто необычайное",
                                "target_lang_sense_clarification": "о предметах или явлениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "额外开支",
                                "target_lang_sense_clarification": "财务语境，指预算外或意外的支出项目"
                            },
                            {
                                "target_lang_word": "奇观",
                                "target_lang_sense_clarification": "指不同寻常的事物或自然现象"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}