                        "sense_id": "39c83d65-04a5-3d7c-8148-caabf3dd5a88",
                        "entry_id": "18926c5d-a161-3f3b-9a28-e63b9ee1bba9",
                        "glosses": [
                            "any of a number of wading birds. (Note that this does not always directly correspond to English wading bird.)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": []
                    }
