                "senses": [
                    {
                        "sense_id": "7aed6e7f-40f2-3313-a83c-2dfb3d0ae70b",
                        "entry_id": "63380649-bcc9-32c1-a3e3-b52a5a2ac543",
                        "glosses": [
                            "Ablehnung/Negierung, dass die Klimakatastrophe stattfindet oder dass sie menschengemacht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e13f9bb6-04ec-46c8-ac51-8007c0a5f666",
                                "sense_id": "7aed6e7f-40f2-3313-a83c-2dfb3d0ae70b",
                                "text": "„Tatsächliche Klimawandelleugnung ist in Österreich, anders als in Amerika, relativ selten.“"
                            },
                            {
                                "example_id": "de925ce6-5431-4220-8a60-8f2c974c2567",
                                "sense_id": "7aed6e7f-40f2-3313-a83c-2dfb3d0ae70b",
                                "text": "„Der Grad der Klimawandelleugnung nimmt zu, je weiter rechts eine Partei steht.“"
                            },
                            {
                                "example_id": "af217df4-78eb-43af-8815-24272f080168",
                                "sense_id": "7aed6e7f-40f2-3313-a83c-2dfb3d0ae70b",
                                "text": "[AfD:] „Klimawandelleugnung findet sich seit 2016 im Grundsatzprogramm der Partei.“"
                            },
                            {
                                "example_id": "8b9b7319-6857-4f19-811f-a63b7a8c5780",
                                "sense_id": "7aed6e7f-40f2-3313-a83c-2dfb3d0ae70b",
                                "text": "„In Deutschland beginnt der Prozess der Klimawandelleugnung, den Vorträgen nach zu schließen, häufig mit dem Thema Windkraft und ihren angeblich schrecklichen Gefahren,“ […]."
                            },
                            {
                                "example_id": "69cdca9e-f993-407b-9458-0e565da16ec9",
                                "sense_id": "7aed6e7f-40f2-3313-a83c-2dfb3d0ae70b",
                                "text": "„Einflussreiche professionelle Organisationen, die Klimawandelleugnung betreiben, gibt es im Gegensatz zu den USA in Deutschland nicht.“"
                            },
                            {
                                "example_id": "64e5dd8d-3995-4bae-a89b-431481899e9f",
                                "sense_id": "7aed6e7f-40f2-3313-a83c-2dfb3d0ae70b",
                                "text": "„Die USA sind die globale Führungsmacht der Klimawandelleugnung.“"
                            },
                            {
                                "example_id": "ac755c80-298e-4cac-a93f-b107592ecffc",
                                "sense_id": "7aed6e7f-40f2-3313-a83c-2dfb3d0ae70b",
                                "text": "„Krause legt allerdings Wert auf die Feststellung, dass es in beiden Gruppen \"nur wenig Potenzial für radikale Klimawandelleugnung\" gebe.“"
                            },
                            {
                                "example_id": "0de6af4d-757e-4443-a257-c0398b2abf0c",
                                "sense_id": "7aed6e7f-40f2-3313-a83c-2dfb3d0ae70b",
                                "text": "„Eine wichtige Frontorganisation der organisierten Klimawandelleugnung war die Global Climate Coalition, die von 1989 bis 2002 gezielt Zweifel an den wissenschaftlichen Erkenntnissen zur globalen Erwärmung säte und Klimaskeptiker in öffentlichen medialen Diskussionen platzierte.“"
                            },
                            {
                                "example_id": "3d5c4714-3209-42a4-820b-20eaed164b08",
                                "sense_id": "7aed6e7f-40f2-3313-a83c-2dfb3d0ae70b",
                                "text": "„EIKE ist unter anderem durch das Committee for a Constructive Tomorrow mit dem Lobbyismus für die Klimawandelleugnung in den USA verbunden.“"
                            },
                            {
                                "example_id": "d6e72193-6b69-4f26-bf27-d217058cbc94",
                                "sense_id": "7aed6e7f-40f2-3313-a83c-2dfb3d0ae70b",
                                "text": "„Moranos Mission ist, die Klimawandelleugnung mithilfe von Methoden zu verkaufen, die er als Hausierer gelernt hat.“"
                            },
                            {
                                "example_id": "6dfcf71e-5f68-4315-a7bb-7f01e50c4606",
                                "sense_id": "7aed6e7f-40f2-3313-a83c-2dfb3d0ae70b",
                                "text": "[Schlagzeile:] „Braunkohlefans in Brandenburg – Staatliche Förderung für Klimawandelleugnung“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
