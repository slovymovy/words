                "senses": [
                    {
                        "sense_id": "336b0426-891c-35db-99c7-331564a68074",
                        "entry_id": "37c9162e-7964-39d2-a6d3-cdbd40761edb",
                        "glosses": [
                            "Gewebefalte im Kehlkopf, die mit Schleimhaut bedeckt ist und zur Stimmbildung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18ba9cc5-f21c-481f-81f4-b70f6f9c525a",
                                "sense_id": "336b0426-891c-35db-99c7-331564a68074",
                                "text": "„Die menschliche Stimme ist der durch die Stimmlippen eines Menschen erzeugte und in den Mund-, Rachen- und Nasenhöhlen modulierte Schall.“"
                            },
                            {
                                "example_id": "9670b9af-5cee-4d91-b5e4-d2aa6fa239f9",
                                "sense_id": "336b0426-891c-35db-99c7-331564a68074",
                                "text": "„Der Kehlkopf und die Stimmlippen sind sehr empfindlich und sollten daher – besonders von Menschen in Berufen, die auf eine funktionstüchtige, belastbare Stimme angewiesen sind – »gepflegt« werden.“"
                            },
                            {
                                "example_id": "7025ab27-8dd5-4e93-a63f-641e73894bfe",
                                "sense_id": "336b0426-891c-35db-99c7-331564a68074",
                                "text": "„Vokale sind Laute, bei denen die Stimmlippen im Kehlkopf schwingen und die Atemluft ungehindert durch den Mund ausströmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
