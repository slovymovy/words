                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Płaszczyzna <w>ogniskowa</w> soczewki została dokładnie zmierzona podczas doświadczenia w laboratorium.",
                            "target_lang_translations": {
                                "ru": "<w>Фокальная</w> плоскость линзы была точно измерена во время эксперимента в лаборатории."
                            }
                        },
                        {
                            "text": "Ta wesoła piosenka <w>ogniskowa</w> była śpiewana przez wszystkich harcerzy przy wspólnym ogniu.",
                            "target_lang_translations": {
                                "ru": "Эту весёлую <w>костровую</w> песню пели все харцеры у общего огня."
                            }
                        }
                    ],
                    "common_phrases": [
