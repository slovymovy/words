    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "49e67053-60dd-3450-849f-14c170fe8db5",
                    "sense_definition": "To roam about for pleasure without any definite plan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "roaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>gallivant</w> around the city all day instead of working.",
                            "target_lang_translations": {
                                "ru": "Вместо работы она решила целый день <w>слоняться</w> по городу."
                            }
                        },
                        {
                            "text": "He spent his summer <w>gallivanting</w> across Europe with no specific destination in mind.",
                            "target_lang_translations": {
                                "ru": "Он провёл лето, <w>разъезжая</w> по Европе без какого-либо определённого маршрута."
                            }
                        }
                    ],
                    "synonyms": [
                        "gad"
                    ],
                    "common_phrases": [
                        "gallivant about",
                        "gallivant around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бродить, разъезжать или слоняться без определённого плана в поисках удовольствий и развлечений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слоняться",
                                "target_lang_sense_clarification": "бродить без дела ради удовольствия"
                            },
                            {
                                "target_lang_word": "шляться",
                                "target_lang_sense_clarification": "разговорное, бродить или разъезжать без цели"
                            },
                            {
                                "target_lang_word": "гулять",
                                "target_lang_sense_clarification": "проводить время на прогулке, отдыхать"
                            },
                            {
                                "target_lang_word": "шататься",
                                "target_lang_sense_clarification": "бесцельно ходить или бродить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f510c1a-7f94-3ddb-88fa-e3095b22a8b2",
                    "sense_definition": "To flirt or engage in romantic activities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flirting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known to <w>gallivant</w> with various partners at the local dance hall.",
                            "target_lang_translations": {
                                "ru": "Было известно, что в местном танцевальном зале он <w>флиртовал</w> с разными партнершами."
                            }
                        },
                        {
                            "text": "They spent the evening <w>gallivanting</w> at the party, clearly enjoying each other's company.",
                            "target_lang_translations": {
                                "ru": "Они провели вечер на вечеринке, <w>флиртуя</w> друг с другом и явно наслаждаясь общением."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is considered old-fashioned."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Флиртовать, заводить романтические интрижки или волочиться за кем-либо (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флиртовать",
                                "target_lang_sense_clarification": "кокетничать, вести любовную игру"
                            },
                            {
                                "target_lang_word": "гулять",
                                "target_lang_sense_clarification": "встречаться, крутить романы"
                            },
                            {
                                "target_lang_word": "волочиться",
                                "target_lang_sense_clarification": "устаревшее, ухаживать, бегать за кем-либо"
