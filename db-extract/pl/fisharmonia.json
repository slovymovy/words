                                "target_senses": [
                                    {
                                        "sense_id": "309ca470-f8e5-3b53-be9b-4ab980e0ba0c",
                                        "entry_id": "d02d236c-4df4-38d9-a162-eb74b56ceb0d",
                                        "glosses": [
                                            "přenosný klávesový hudební nástroj, jehož zvuk vzniká chvěním jazýčkových píšťal"
                                        ],
                                        "tags": [],
