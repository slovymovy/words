                                        "examples": [
                                            {
                                                "example_id": "ebbd34b0-3c26-4031-b954-ed0b697fd95c",
                                                "sense_id": "da2cda48-53ac-35b4-bca6-8ab5eb5fa9ad",
                                                "text": "Ik boog."
                                            },
                                            {
                                                "example_id": "a5c70e8c-3981-4d28-9650-c9ccb99bd3ad",
                                                "sense_id": "da2cda48-53ac-35b4-bca6-8ab5eb5fa9ad",
                                                "text": "Jij boog."
                                            },
                                            {
                                                "example_id": "908d13b8-0864-4f0a-a499-47a5129367f0",
                                                "sense_id": "da2cda48-53ac-35b4-bca6-8ab5eb5fa9ad",
                                                "text": "Hij, zij, het boog."
                                            },
                                            {
                                                "example_id": "74142be2-b919-4384-a3fb-13e2dec202b0",
                                                "sense_id": "da2cda48-53ac-35b4-bca6-8ab5eb5fa9ad",
                                                "text": "Langzaam boog hij voorover en hij rechtte daarna met veel moeite zijn rug."
                                            },
                                            {
                                                "example_id": "bffb699f-fccb-49a3-9c72-2f6dfd5f3358",
                                                "sense_id": "da2cda48-53ac-35b4-bca6-8ab5eb5fa9ad",
                                                "text": "'Hoe kan het dat je de controle verloor?' Toen boog ik me voorover en legde ik mijn wang op de stenen grafplaat."
                                            },
                                            {
                                                "example_id": "d4f35ffd-7c95-4d09-8530-80b16276803c",
                                                "sense_id": "da2cda48-53ac-35b4-bca6-8ab5eb5fa9ad",
                                                "text": "Ik boog me naar hem toe en knikte."
                                            },
                                            {
                                                "example_id": "efce5476-237d-4a68-ac15-bcf85ec82e67",
                                                "sense_id": "da2cda48-53ac-35b4-bca6-8ab5eb5fa9ad",
                                                "text": "Ik boog me naar hem toe en knikte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64c93c60-83b5-4a91-a519-a0533177c9e5",
