                    "sense_definition": "To subject to violence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The text describes how the population was <w>violenced</w> during the war.",
                            "target_lang_translations": {
                                "ru": "В тексте описывается, как население <w>подвергалось насилию</w> во время войны.",
                                "zh": "文中描述了战争期间民众是如何遭受<w>暴力对待</w>的。"
                            }
                        },
                        {
                            "text": "He claimed that he had been <w>violenced</w> by the security guards.",
                            "target_lang_translations": {
                                "ru": "Он утверждал, что охранники <w>применили к нему силу</w>.",
                                "zh": "他声称自己遭到了保安的<w>施暴</w>。"
                            }
