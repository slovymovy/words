                "forms": [
                    {
                        "form_id": "8a76273f-2dfb-487a-baed-5e528664c376",
                        "entry_id": "289c217a-5264-31ec-9e77-c170f8557a2c",
                        "tags": [
                            "plural"
                        ],
                        "form": "préfabriqués"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a159e03d-afb1-3217-94e0-65ce1d124469",
                        "entry_id": "289c217a-5264-31ec-9e77-c170f8557a2c",
                        "glosses": [
                            "Bâtiment constitué d'éléments fabriqués en usine avant d’avoir été assemblés sur place."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7cfed5f-5aeb-42f2-8696-c0951d57553b",
                                "sense_id": "a159e03d-afb1-3217-94e0-65ce1d124469",
                                "text": "Mais encore il faut savoir se mêler à la fadeur du quotidien, dans les « algecos », ces préfabriqués qui servent de bureaux aux inspecteurs, dans l'usure sans relief, dans la patine du temps, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "68cedd27-5c9e-3996-b819-4e3e27f71181",
                        "entry_id": "289c217a-5264-31ec-9e77-c170f8557a2c",
                        "glosses": [
                            "Quelque chose d’artificiel, préparé à l'avance, prêt à l’emploi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fae75b7a-5cdc-4676-a359-27c52ef8c140",
                                "sense_id": "68cedd27-5c9e-3996-b819-4e3e27f71181",
                                "text": "– Ne te fâche pas, mais ne crois-tu pas que là, avec ces roucoulements, ces pépiements, tu n’as pas pu t’empêcher de placer un petit morceau de préfabriqué… c’est si tentant… tu as fait une joli petit raccord, tout à fait en accord…"
                            }
                        ]
                    }
                ],
