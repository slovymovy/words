                        ],
                        "examples": [
                            {
                                "example_id": "c4a0ea3c-d299-4316-90c9-65e7f1388e3a",
                                "sense_id": "98af09c2-0770-385f-bc5c-9ec5fe794668",
                                "text": "Ik was afwasser bij een eetcafé bij mijn middelbare school om de hoek."
