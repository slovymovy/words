                "senses": [
                    {
                        "sense_id": "adcfc950-ddf7-35b9-bb9d-66a1a558f653",
                        "entry_id": "47e4f874-cc3b-34ff-8df3-515a2a993752",
                        "glosses": [
                            "Handlung, sich auf einen späteren, noch nicht vorhandenen Zustand einzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5a81500-9a36-4c4e-b855-2d625f091177",
                                "sense_id": "adcfc950-ddf7-35b9-bb9d-66a1a558f653",
                                "text": "„Das ist schon eine prophetische Vorwegnahme des Warschauer Pakts.“"
                            }
