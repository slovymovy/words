                        "target_lang_word": "Müllhalde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Müllhalde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75d8f3ab-7314-3574-b47d-0006abf53514",
                                        "entry_id": "1aeeaa06-70b1-309c-8c7e-be3e57505113",
                                        "glosses": [
                                            "Ort, an dem (oberirdisch) der Müll/Unrat gesammelt und aufbewahrt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5568e000-4e3e-4341-ac00-445dcacb242f",
                                                "sense_id": "75d8f3ab-7314-3574-b47d-0006abf53514",
                                                "text": "Die Müllhalden erzeugen mit ihrem Verrottungsprozess Umweltgifte, die in das Erdreich und Grundwasser gelangen."
                                            },
                                            {
                                                "example_id": "c204a850-5c79-460d-a386-b342cd225e1d",
                                                "sense_id": "75d8f3ab-7314-3574-b47d-0006abf53514",
                                                "text": "Der Betreiber dieser illegalen Müllhalde wird ein saftiges Bußgeld erhalten."
                                            },
                                            {
                                                "example_id": "93b1530d-5e6b-4dc0-b5da-f99d4a5b10a2",
                                                "sense_id": "75d8f3ab-7314-3574-b47d-0006abf53514",
                                                "text": "„Die Frau suchte in verfallenen Hütten östlich des Hauses und auf den Müllhalden, die sich hinter dem Haus befanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
