{
    "word_family": [
        "excitability",
        "excite",
        "excited",
        "excitedly",
        "excitement",
        "exciting",
        "inexcitable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7ef8ad3a-70e0-3ba0-8239-6398a9653107",
                    "sense_definition": "Easily becoming enthusiastic, agitated, or emotionally aroused.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>excitable</w> puppy jumped all over the guests when they arrived.",
                            "target_lang_translations": {
                                "ru": "<w>Легковозбудимый</w> щенок прыгал на гостей, как только они вошли."
                            }
                        },
                        {
                            "text": "He is an <w>excitable</w> child who often struggles to sit quietly.",
                            "target_lang_translations": {
                                "ru": "Он <w>легковозбудимый</w> ребёнок, которому часто трудно усидеть на месте спокойно."
                            }
                        }
                    ],
                    "synonyms": [
                        "temperamental",
                        "nervous",
                        "agitable"
                    ],
                    "antonyms": [
                        "calm",
                        "composed",
                        "unflappable"
                    ],
                    "common_phrases": [
                        "an excitable child",
                        "an excitable dog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко приходящий в состояние восторга, волнения или эмоционального возбуждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возбудимый",
                                "target_lang_sense_clarification": "легко поддающийся эмоциям или раздражению"
                            },
                            {
                                "target_lang_word": "легковозбудимый",
                                "target_lang_sense_clarification": "очень чутко реагирующий на эмоции"
                            },
                            {
                                "target_lang_word": "темпераментный",
                                "target_lang_sense_clarification": "эмоционально подвижный и пылкий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2c3003e-7d54-3c42-8800-9cdaad119c3e",
                    "sense_definition": "Capable of responding to electrical, chemical, or mechanical stimuli.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Neurons and muscle cells are classic examples of <w>excitable</w> tissue.",
                            "target_lang_translations": {
                                "ru": "Нейроны и мышечные клетки — классические примеры <w>возбудимой</w> ткани."
                            }
                        },
                        {
                            "text": "Damage to these <w>excitable</w> membranes can disrupt normal cardiac function.",
                            "target_lang_translations": {
                                "ru": "Повреждение этих <w>возбудимых</w> мембран может нарушить нормальную работу сердца."
                            }
                        }
                    ],
                    "synonyms": [
                        "responsive",
                        "sensitive"
                    ],
                    "antonyms": [
                        "inexcitable"
                    ],
                    "common_phrases": [
                        "excitable tissue",
                        "excitable cells",
                        "excitable membranes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный реагировать на электрические, химические или механические раздражители (в биологии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возбудимый",
                                "target_lang_sense_clarification": "о биологических тканях, клетках или мембранах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc61e100-4234-390e-bfbc-75f97703e163",
                    "sense_definition": "Able to be transitioned into a higher energy state.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laser beam interacts with the <w>excitable</w> atoms in the gas chamber.",
                            "target_lang_translations": {
                                "ru": "Лазерный луч взаимодействует с <w>возбудимыми</w> атомами в газовой камере."
                            }
                        },
                        {
                            "text": "An incoming photon can easily raise an <w>excitable</w> molecule to a higher orbital.",
                            "target_lang_translations": {
                                "ru": "Попадающий фотон может легко перевести <w>возбудимую</w> молекулу на более высокую орбиталь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "excitable medium",
                        "excitable state"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный переходить в состояние с более высоким уровнем энергии (в физике и химии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возбудимый",
                                "target_lang_sense_clarification": "способный переходить в возбуждённое состояние (об атомах, молекулах)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}