                        "examples": [
                            {
                                "example_id": "2451d631-8d54-4f63-baa0-95c5c2429b71",
                                "sense_id": "3994a953-a120-3cd3-a28e-ad8942c77e86",
                                "text": "Au moment de réapprocher du but les sentinelles allemandes, distinguant peut-être notre groupe noir, nous saluent."
                            },
                            {
                                "example_id": "77793010-55d1-41e8-8188-26e68b0bdb0d",
                                "sense_id": "3994a953-a120-3cd3-a28e-ad8942c77e86",
                                "text": "Il lui faudra passer par sa propre mise en scène pour réapprocher non plus le mythe (comme pour les déguisements du début du film), mais la femme."
                            }
                        ]
