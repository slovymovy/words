                "senses": [
                    {
                        "sense_id": "b1c1c301-986d-3c7c-9388-40c5073eb1df",
                        "entry_id": "14af49c1-6096-3b6c-893e-fc8a1e192ac4",
                        "glosses": [
                            "(Grad der) Beherrschung der englischen Sprache, Wissen über die Anwendung derselben"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "be1d888d-819a-411c-875e-e96edb29ef47",
                                "sense_id": "b1c1c301-986d-3c7c-9388-40c5073eb1df",
                                "text": "„Wer international arbeiten will, braucht sehr gute Englischkenntnisse.“"
                            },
                            {
                                "example_id": "bae92031-edf0-4336-bac5-637ca953898f",
                                "sense_id": "b1c1c301-986d-3c7c-9388-40c5073eb1df",
                                "text": "„War ich beim ersten Gang durch die Stadt in meinen Englischkenntnissen etwa fünf bis sechs Jahre alt gewesen, so war ich eine Woche später bereits auf der Stude eines Achtjährigen.“"
                            },
                            {
                                "example_id": "0a6af190-1d0c-43e8-84d9-e1c44b5059a6",
                                "sense_id": "b1c1c301-986d-3c7c-9388-40c5073eb1df",
                                "text": "„Die Repräsentanten der linken Szene sind oftmals Männer, die vor allem aus dem urbanen Raum kommen, in den 1970er Jahren an den Hochschulen ausgebildet wurden und aufgrund ihrer Englischkenntnisse den Anschluss an die internationale linke Bewegung gefunden haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
