                "forms": [],
                "senses": [
                    {
                        "sense_id": "89f307ee-a36f-3d52-971e-018b31901f9f",
                        "entry_id": "5ea95f7b-4712-33b8-bd77-aaabd39e62de",
                        "glosses": [
                            "Indique l’utilisation ou les spécificités de munition MURAT."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "dbb39b7c-54c0-4197-acb8-d301a7b4f0af",
                                "sense_id": "89f307ee-a36f-3d52-971e-018b31901f9f",
                                "text": "Pour les munitions en service comme pour les nouvelles acquisitions, l'évaluation MURAT doit permettre d'apprécier la qualité de la démonstration apportée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e9930a4-de45-4d72-a77b-a434177eaf8e",
                        "source_entry_id": "5ea95f7b-4712-33b8-bd77-aaabd39e62de",
                        "source_sense_id": "89f307ee-a36f-3d52-971e-018b31901f9f",
                        "target_lang_word": "IM",
                        "target_lang_code": "en",
