                    {
                        "sense_id": "c1d625ce-7180-32ba-ae13-553354746e94",
                        "entry_id": "3849e21d-d9f8-3cf2-a575-f44834bac042",
                        "glosses": [
                            "streven naar een betere wereld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eed21ef8-2378-4e25-8a19-fa7eb8f69685",
                                "sense_id": "c1d625ce-7180-32ba-ae13-553354746e94",
                                "text": "Uit idealisme een jaar vrijwilligerswerk doen in een ontwikkelingsland."
                            },
                            {
                                "example_id": "9d4b08ea-0007-441c-a5dc-99440d3c0f59",
                                "sense_id": "c1d625ce-7180-32ba-ae13-553354746e94",
                                "text": "Zijn grote mond, iets te harde stem, irritante enthousiasme en overdreven positiviteit waren herkenbaar maar ook zijn ongepolijste bravoure, idealisme en romantische dromen om de wereld te verbeteren."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a2fe52e-bf24-34c7-9342-272e4643ee22",
                        "entry_id": "3849e21d-d9f8-3cf2-a575-f44834bac042",
                        "glosses": [
                            "systeem waarin de ideeën of grondbegrippen belangrijker dan de werkelijkheid worden beschouwd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "957c9c80-9827-4302-a973-f6afb1e6544b",
                                "sense_id": "8a2fe52e-bf24-34c7-9342-272e4643ee22",
                                "text": "In hun idealisme ontkennen de pacifisten het gevaar van de autoritaire agressie."
                            }
                        ]
                    }
