                                            {
                                                "example_id": "382177d9-2a78-45e1-aebd-8641081bdcb9",
                                                "sense_id": "66896c4a-5c09-36fb-95c1-aff8b96762bf",
                                                "text": "„Dennoch steht die Aktualität des Werks außer Frage.“"
                                            }
                                        ],
