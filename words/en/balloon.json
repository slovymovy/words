{
    "word_family": [
        "balloonist",
        "ballooning",
        "balloon-like"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "545072c2-f987-3072-9595-b243c23d7ef4",
                    "sense_definition": "A small, flexible bag filled with air or gas, used as a toy or for party decorations.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inflatable_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were happy to see a colorful <w>balloon</w> at the birthday party.",
                            "target_lang_translations": {
                                "ru": "Дети были рады увидеть разноцветный воздушный <w>шарик</w> на праздновании дня рождения."
                            }
                        },
                        {
                            "text": "We need to blow up a <w>balloon</w> for every guest coming to the celebration.",
                            "target_lang_translations": {
                                "ru": "Нам нужно надуть по <w>шарику</w> для каждого гостя, приглашенного на праздник."
                            }
                        }
                    ],
                    "synonyms": [
                        "toy balloon"
                    ],
                    "common_phrases": [
                        "blow up a balloon",
                        "party balloon",
                        "helium balloon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой эластичный мешочек, наполняемый воздухом или газом, используемый в качестве игрушки или украшения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздушный шар",
                                "target_lang_sense_clarification": "надувная игрушка"
                            },
                            {
                                "target_lang_word": "шарик",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0c411cf-a79f-305b-afa6-010feeb47fed",
                    "sense_definition": "A large aircraft consisting of a bag filled with hot air or gas, with a basket for carrying passengers.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "inflatable_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They took a hot air <w>balloon</w> ride over the valley at sunrise.",
                            "target_lang_translations": {
                                "ru": "На рассвете они совершили полет на <w>воздушном</w> <w>шаре</w> над долиной."
                            }
                        },
                        {
                            "text": "The pilot controlled the <w>balloon</w> by heating the air inside the large envelope.",
                            "target_lang_translations": {
                                "ru": "Пилот управлял <w>аэростатом</w>, нагревая воздух внутри огромной оболочки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hot air balloon",
                        "balloon ride",
                        "weather balloon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Летательный аппарат, состоящий из оболочки, наполненной горячим воздухом или газом, и корзины для пассажиров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздушный шар",
                                "target_lang_sense_clarification": "летательный аппарат"
                            },
                            {
                                "target_lang_word": "аэростат",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "монгольфьер",
                                "target_lang_sense_clarification": "тепловой аэростат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d98424a-c899-3047-b5a2-4605cfa7aae6",
                    "sense_definition": "A rounded shape in a comic strip that contains the words spoken by a character.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "graphic_element",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist drew a speech <w>balloon</w> above the hero's head to show his thoughts.",
                            "target_lang_translations": {
                                "ru": "Художник нарисовал <w>облачко</w> с речью над головой героя, чтобы показать его мысли."
                            }
                        },
                        {
                            "text": "It is difficult to fit all the text into a single <w>balloon</w> on this page.",
                            "target_lang_translations": {
                                "ru": "Трудно уместить весь текст в один <w>баббл</w> на этой странице."
                            }
                        }
                    ],
                    "synonyms": [
                        "speech bubble",
                        "thought bubble"
                    ],
                    "common_phrases": [
                        "speech balloon",
                        "thought balloon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Округлая область в комиксах, в которой размещаются слова персонажа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "баббл",
                                "target_lang_sense_clarification": "сленг в комиксах"
                            },
                            {
                                "target_lang_word": "облачко",
                                "target_lang_sense_clarification": "с текстом в комиксах"
                            },
                            {
                                "target_lang_word": "филактер",
                                "target_lang_sense_clarification": "редкий термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce168f79-a4d2-3a84-ad6b-f02ca652f511",
                    "sense_definition": "A large, round wine glass with a short stem, typically used for serving brandy or cognac.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He swirled the expensive cognac in a crystal <w>balloon</w> to release its aroma.",
                            "target_lang_translations": {
                                "ru": "Он покрутил дорогой коньяк в хрустальном <w>бокале-баллоне</w>, чтобы раскрыть его аромат."
                            }
                        },
                        {
                            "text": "The waiter brought a brandy <w>balloon</w> to the table after dinner.",
                            "target_lang_translations": {
                                "ru": "Официант принес к столу <w>снифтер</w> для бренди после ужина."
                            }
                        }
                    ],
                    "synonyms": [
                        "snifter"
                    ],
                    "common_phrases": [
                        "brandy balloon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой округлый бокал для вина на короткой ножке, обычно используемый для бренди или коньяка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снифтер",
                                "target_lang_sense_clarification": "бокал для коньяка"
                            },
                            {
                                "target_lang_word": "баллон",
                                "target_lang_sense_clarification": "тип бокала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f09666f-5dd6-37a2-8245-41968c89a1ee",
                    "sense_definition": "A small inflatable sac used in medical procedures to clear or open a blocked vessel or organ.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon used a <w>balloon</w> catheter to open the patient's blocked artery.",
                            "target_lang_translations": {
                                "ru": "Хирург использовал <w>баллонный</w> катетер, чтобы расширить заблокированную артерию пациента."
                            }
                        },
                        {
                            "text": "During the angioplasty, the <w>balloon</w> is inflated to widen the narrow passage.",
                            "target_lang_translations": {
                                "ru": "Во время ангиопластики <w>баллон</w> надувается, чтобы расширить узкий проход."
                            }
                        }
                    ],
                    "common_phrases": [
                        "balloon angioplasty",
                        "balloon catheter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой надувной мешочек, используемый в медицине для очистки или расширения заблокированного сосуда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "баллон",
                                "target_lang_sense_clarification": "медицинский катетер"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb328ece-aad6-3bb1-98f3-52e50262313e",
                    "sense_definition": "A woman's breast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The slang term <w>balloons</w> is sometimes used to refer to breasts in informal speech.",
                            "target_lang_translations": {
                                "ru": "Сленговое слово <w>шары</w> иногда используется для обозначения груди в неформальной речи."
                            }
                        },
                        {
                            "text": "He made a crude joke about her <w>balloons</w> which made everyone uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Он отпустил грубую шутку про её <w>буфера</w>, отчего всем стало неловко."
                            }
                        }
                    ],
                    "synonyms": [
                        "boobs",
                        "jugs",
                        "melons"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal and potentially offensive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женская грудь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буфера",
                                "target_lang_sense_clarification": "грубый сленг"
                            },
                            {
                                "target_lang_word": "шары",
                                "target_lang_sense_clarification": "вульгарно"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "edce02fd-d4d5-3549-94b5-f4edd59197c4",
                    "sense_definition": "To increase or expand very quickly in size, amount, or importance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The national debt began to <w>balloon</w> after the government increased spending.",
                            "target_lang_translations": {
                                "ru": "Государственный долг начал стремительно <w>раздуваться</w> после того, как правительство увеличило расходы."
                            }
                        },
                        {
                            "text": "Her medical expenses <w>ballooned</w> rapidly following the unexpected surgery.",
                            "target_lang_translations": {
                                "ru": "Её медицинские расходы <w>выросли</w> <w>как</w> <w>на</w> <w>дрожжах</w> после неожиданной операции."
                            }
                        }
                    ],
                    "synonyms": [
                        "mushroom",
                        "escalate",
                        "snowball"
                    ],
                    "antonyms": [
                        "shrink",
                        "decrease"
                    ],
                    "common_phrases": [
                        "balloon rapidly",
                        "balloon out of control"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стремительно расти или расширяться в размере, количестве или значимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздуваться",
                                "target_lang_sense_clarification": "о суммах или долгах"
                            },
                            {
                                "target_lang_word": "расти как на дрожжах",
                                "target_lang_sense_clarification": "идиома"
                            },
                            {
                                "target_lang_word": "стремительно увеличиваться",
                                "target_lang_sense_clarification": "о количестве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81e20150-b802-339e-aa3b-bf86398f0816",
                    "sense_definition": "To swell or puff out like a balloon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The curtains <w>ballooned</w> in the wind when she opened the window.",
                            "target_lang_translations": {
                                "ru": "Шторы <w>раздулись</w> от ветра, когда она открыла окно."
                            }
                        },
                        {
                            "text": "His cheeks <w>ballooned</w> as he tried to hold his breath underwater.",
                            "target_lang_translations": {
                                "ru": "Его щеки <w>раздулись</w>, когда он попытался задержать дыхание под водой."
                            }
                        }
                    ],
                    "synonyms": [
                        "billow",
                        "puff"
                    ],
                    "common_phrases": [
                        "balloon in the wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надуваться или выпячиваться подобно воздушному шару."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздуваться",
                                "target_lang_sense_clarification": "от ветра или воздуха"
                            },
                            {
                                "target_lang_word": "надуваться",
                                "target_lang_sense_clarification": "о щеках или парусах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "365b3cdb-5300-34f2-9e97-a9fe023cba2f",
                    "sense_definition": "To hit or kick a ball so that it travels high into the air.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker <w>ballooned</w> the ball over the crossbar from only five yards out.",
                            "target_lang_translations": {
                                "ru": "Нападающий <w>запустил</w> мяч выше перекладины всего с пяти ярдов."
                            }
                        },
                        {
                            "text": "He tried to score but managed to <w>balloon</w> the ball into the stands.",
                            "target_lang_translations": {
                                "ru": "Он пытался забить, но умудрился <w>запулить</w> мяч прямо на трибуны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "balloon the ball"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить по мячу так, чтобы он взлетел высоко в воздух."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запустить свечу",
                                "target_lang_sense_clarification": "в спорте"
                            },
                            {
                                "target_lang_word": "запулить",
                                "target_lang_sense_clarification": "разговорно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}