                        "form": "den Meteorologen"
                    },
                    {
                        "form_id": "096ead34-42be-4227-b598-57653f9b4871",
                        "entry_id": "f55dc01d-2448-327c-ba4b-386d5e6b84fe",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Meteorologen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                        "entry_id": "f55dc01d-2448-327c-ba4b-386d5e6b84fe",
                        "glosses": [
                            "Person, die in der Meteorologie ausgebildet und bewandert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "559f58be-dd03-48e6-9ec9-6e7d9350d0bb",
                                "sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                                "text": "„Heute Abend warnte der Meteorologe vor einem drohenden Unwetter im Norden.“"
                            },
                            {
                                "example_id": "f8936054-8c18-45d9-aae6-d7bb475a83bd",
                                "sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                                "text": "„Kreuzwinde, Sturm, Hagel, Seitenwinde, was Meteorologen lieben, Piloten spannend finden und Touristen hassen: All das gibt es hier, im minütlichen Wechsel.“"
                            },
                            {
                                "example_id": "9fab8369-b9d8-44b7-bf1d-4e09db824e26",
                                "sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                                "text": "„Und als richtigen Eistag, an dem die Temperatur nicht über null Grad steigt, haben die Meteorologen nur einen einzigen Tag zu bieten, den 30. Januar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a759164-910c-49de-8247-3d714ab020a8",
                        "source_entry_id": "f55dc01d-2448-327c-ba4b-386d5e6b84fe",
                        "source_sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                        "source_sense_description": "Person, die in der Meteorologie ausgebildet und bewandert ist",
                        "target_lang_word": "meteorologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meteorologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f443d6ce-8a94-3e0b-bbe7-ee2d9b0587a6",
                                        "entry_id": "ff887586-1413-3325-8d8f-e9ba7434a9fe",
                                        "glosses": [
                                            "A person who studies meteorology."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6447a7b9-4ca5-35d6-a1cd-d0efc64d3b7b",
                                        "entry_id": "ff887586-1413-3325-8d8f-e9ba7434a9fe",
                                        "glosses": [
                                            "A weather forecaster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "881edaa6-a62f-403c-be49-c6d59a78af2b",
                                                "sense_id": "6447a7b9-4ca5-35d6-a1cd-d0efc64d3b7b",
                                                "text": "For a micromoon and Friday the 13th full moon to occur together is extraordinarily rare. The last time it happened was in 1832 and it won't happen again for more than 500 years according to Tony Rice, a meteorologist and engineer at NASA."
                                            },
                                            {
                                                "example_id": "e6490c0b-1384-4e75-bd2d-7ef1c5dab400",
                                                "sense_id": "6447a7b9-4ca5-35d6-a1cd-d0efc64d3b7b",
                                                "text": "Rees-Mogg has claimed that “climate alarmism” is responsible for high energy prices and that it is unrealistic for scientists to project future changes to the climate because meteorologists struggle to correctly predict the weather."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d86188bf-7043-4bce-b1d8-273b634e9eb8",
                        "source_entry_id": "f55dc01d-2448-327c-ba4b-386d5e6b84fe",
                        "source_sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                        "source_sense_description": "Person, die in der Meteorologie ausgebildet und bewandert ist",
                        "target_lang_word": "météorologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "météorologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd644530-689e-3971-a7c4-a84c7b750125",
                                        "entry_id": "17008024-9dc1-371d-97a7-490243b1026c",
                                        "glosses": [
                                            "Celui, celle qui s’occupe de météorologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfe5e301-9cc3-4976-a648-0bcbea443979",
                                                "sense_id": "fd644530-689e-3971-a7c4-a84c7b750125",
                                                "text": "Ces phénomènes de parasélènes étaient un symptôme auquel un météorologiste n’aurait pu se méprendre."
                                            },
                                            {
                                                "example_id": "06de374e-eb50-496d-85bf-c057d1b00a4b",
                                                "sense_id": "fd644530-689e-3971-a7c4-a84c7b750125",
                                                "text": "Ayant offert au gouvernement norvégien de venir en aide aux météorologistes de Jan-Mayen, je me chargeai pour eux de dix caisses de vivres et de matériel."
                                            },
                                            {
                                                "example_id": "2ad64610-db0b-4f48-9627-e300249b2f27",
                                                "sense_id": "fd644530-689e-3971-a7c4-a84c7b750125",
                                                "text": "— Une attention qu’il ne me paroît pas qu’aient eu les physiciens météorologistes est celle de tenir compte de l’eau qui reste attachée aux parois intérieures de l’ombromètre après l’avoir vidé dans le vase destiné à mesurer l’eau de pluie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17c5a844-10a7-3399-aeed-f486c7723204",
                                        "entry_id": "17008024-9dc1-371d-97a7-490243b1026c",
                                        "glosses": [
                                            "Celui, celle qui prédit le temps."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
