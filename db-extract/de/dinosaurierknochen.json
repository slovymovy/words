                "senses": [
                    {
                        "sense_id": "6d60e514-0357-35fa-ab96-677b2945bbc9",
                        "entry_id": "f4d8692b-e2ba-33a4-a1a0-c8e15cfd7a0c",
                        "glosses": [
                            "Knochen eines Dinosauriers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d03b920-8a3e-43f2-877e-3a24deb429c6",
                                "sense_id": "6d60e514-0357-35fa-ab96-677b2945bbc9",
                                "text": "„Die dunklen Mächte des Bösen haben diese Dinosaurierknochen und falschen Fossilien also doch im Boden vergraben, um die Menschheit in die Irre zu führen.“"
                            },
                            {
                                "example_id": "f8db3c01-cdcf-4c5d-8481-2d5e071d0c24",
                                "sense_id": "6d60e514-0357-35fa-ab96-677b2945bbc9",
                                "text": "„Papier kann man anzünden, und es verschwindet für immer, im Gegensatz zu digitalen Daten, die das Alter von Dinosaurierknochen erreichen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
