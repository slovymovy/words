                    {
                        "translation_id": "76a7951f-ae2c-4e29-8436-854833246fb9",
                        "source_entry_id": "1e4e0c79-ea4b-3729-8f92-0540f42b0ad5",
                        "source_sense_description": "без усилий, без труда; легко",
                        "target_lang_word": "easily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "easily",
