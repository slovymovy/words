                    {
                        "form_id": "2de32188-8dbe-4a26-bbd4-6967c8827a2c",
                        "entry_id": "9d9e48df-5467-3d87-a8d2-d305d25e57ab",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Steinzeit"
