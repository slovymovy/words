                ],
                "senses": [
                    {
                        "sense_id": "a973ab51-a0ef-3242-aa62-1d690a56e519",
                        "entry_id": "761df462-5960-3362-b2ce-502d211094a8",
                        "glosses": [
                            "Menschen, die willkürlich jemandem preisgegeben sind; Menschen, die schutzlos sind"
                        ],
                        "tags": [
                            "metaphorisch"
                        ],
                        "examples": [
                            {
                                "example_id": "800574ad-d943-4a44-b828-13bf5c7c9ca8",
                                "sense_id": "a973ab51-a0ef-3242-aa62-1d690a56e519",
                                "text": "„Jede Kritik jedoch muß verstummen, solange Studenten unter den Augen der Polizei wie Freiwild gejagt werden können.“"
                            },
                            {
                                "example_id": "b8884dd7-58c6-40a7-b3c3-298801563d5c",
                                "sense_id": "a973ab51-a0ef-3242-aa62-1d690a56e519",
                                "text": "„Danach war ich erst recht Freiwild für die anderen.“"
                            },
                            {
                                "example_id": "6c6d608b-0702-4e0b-aa01-235830836785",
                                "sense_id": "a973ab51-a0ef-3242-aa62-1d690a56e519",
                                "text": "„Besonders empörte die Herero, dass viele deutsche Männer die schwarzen Frauen als Freiwild betrachteten.“"
                            },
                            {
                                "example_id": "29db8351-f782-4aef-b956-03fc0b2e34b1",
                                "sense_id": "a973ab51-a0ef-3242-aa62-1d690a56e519",
                                "text": "„Ohne Zweifel jedoch hat die sowjetische Heeresführung mit ihren aufwiegelnden Appellen viel dazu beigetragen, dass die Deutschen im russisch besetzten Gebiet zum Freiwild wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a278b380-55a4-4405-a8d8-499cd20923da",
                        "source_entry_id": "761df462-5960-3362-b2ce-502d211094a8",
                        "source_sense_id": "a973ab51-a0ef-3242-aa62-1d690a56e519",
                        "source_sense_description": "metaphorisch: Menschen, die willkürlich jemandem preisgegeben sind; Menschen, die schutzlos sind",
                        "target_lang_word": "fair game",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fair game",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8db419f6-fac1-35f1-9c66-69f19ce4fc4b",
                                        "entry_id": "c3f44ddc-9ce7-3adc-a8ba-90636eb9a8cc",
                                        "glosses": [
                                            "Actions permissible by the rules."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6403b53-3249-447f-959f-af42f5a6c5c9",
                                                "sense_id": "8db419f6-fac1-35f1-9c66-69f19ce4fc4b",
                                                "text": "Pretending to be slow is fair game. Pretending to be injured is not."
                                            },
                                            {
                                                "example_id": "6e5ece05-d495-4c12-8e8a-87b304a87ed8",
                                                "sense_id": "8db419f6-fac1-35f1-9c66-69f19ce4fc4b",
                                                "text": "The referee ruled the unprecedented play fair game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "653c4826-1514-3f47-9c16-52cace2992b7",
                                        "entry_id": "c3f44ddc-9ce7-3adc-a8ba-90636eb9a8cc",
                                        "glosses": [
                                            "A goal or an object that may legitimately be sought."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96ed689c-c505-4dc0-a8d8-3c8b9513d545",
                                                "sense_id": "653c4826-1514-3f47-9c16-52cace2992b7",
                                                "text": "After the middle sister's call from a friend's house, her slice of cake was fair game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83ce148b-ab11-35c9-a2c4-91d695912d8d",
                                        "entry_id": "c3f44ddc-9ce7-3adc-a8ba-90636eb9a8cc",
                                        "glosses": [
                                            "An acceptable subject or target for criticism, scrutiny, mockery, or attack."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dc15d63-557e-43d4-8f9f-906958580b06",
                                                "sense_id": "83ce148b-ab11-35c9-a2c4-91d695912d8d",
                                                "text": "Anyone running for office is fair game for criticism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db993688-7ecb-3c28-9306-0944052c356b",
                                        "entry_id": "c3f44ddc-9ce7-3adc-a8ba-90636eb9a8cc",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see fair, game.: a game that is fair, that does not involve cheating, etc."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b712efe9-754a-4656-8352-bd52ce07031d",
                        "source_entry_id": "761df462-5960-3362-b2ce-502d211094a8",
                        "source_sense_id": "a973ab51-a0ef-3242-aa62-1d690a56e519",
                        "source_sense_description": "metaphorisch: Menschen, die willkürlich jemandem preisgegeben sind; Menschen, die schutzlos sind",
                        "target_lang_word": "proie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d9240e9-15a4-3459-8780-d5641755de05",
                                        "entry_id": "e99a50cd-6e58-33d6-b118-86579e560d96",
                                        "glosses": [
                                            "Animal vivant qu’un animal carnassier ravit pour le manger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da6d75d1-97ff-4aaa-9434-6046d7fc9660",
                                                "sense_id": "6d9240e9-15a4-3459-8780-d5641755de05",
                                                "text": "Tout vit de proie. La nature va se dévorant elle même […]"
                                            },
                                            {
                                                "example_id": "c54cb9f5-f930-4b8d-82ec-5c3ba38870fa",
                                                "sense_id": "6d9240e9-15a4-3459-8780-d5641755de05",
                                                "text": "A de grandes altitudes planaient les frégates et les phaétons, qui tombaient souvent avec une rapidité vertigineuse pour arracher en l'air leur proie aux oiseaux de mer plongeurs."
                                            },
                                            {
                                                "example_id": "5265ef23-006c-45b1-9abe-1411bea133a5",
                                                "sense_id": "6d9240e9-15a4-3459-8780-d5641755de05",
                                                "text": "Cet animal s'oriente dans l’espace par écholocation : il émet des sons de très haute fréquence et utilise l’écho renvoyé par les obstacles ou les proies pour les localiser."
                                            },
                                            {
                                                "example_id": "0810e58f-f25d-49b7-ae72-58cd4b1dbb0a",
                                                "sense_id": "6d9240e9-15a4-3459-8780-d5641755de05",
                                                "text": "Le loup emporta sa proie dans le bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f695f343-4149-3e47-b60a-87613b4fe4fa",
                                        "entry_id": "e99a50cd-6e58-33d6-b118-86579e560d96",
                                        "glosses": [
                                            "Ce dont on s’empare pour s’en nourrir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cd6f3a8-801d-4887-b413-433d67e64c24",
                                                "sense_id": "f695f343-4149-3e47-b60a-87613b4fe4fa",
                                                "text": "À ces mots le corbeau ne se sent pas de joie ;\n Et, pour montrer sa belle voix,\n Il ouvre un large bec, laisse tomber sa proie."
                                            },
                                            {
                                                "example_id": "59c49bba-ef51-45aa-84a0-51cfd7b384e3",
                                                "sense_id": "f695f343-4149-3e47-b60a-87613b4fe4fa",
                                                "text": "Vérifiez que les liens et les descriptions de catégorie décrivent explicitement ce que les utilisateurs trouveront au bout du chemin. Face à plusieurs options de navigation, il vaut mieux qu’ils puissent clairement identifier le chemin vers leur proie et voir que les autres sont exempts de biens comestibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dfec67d-a526-3786-8994-45b5fbb1cf6a",
                                        "entry_id": "e99a50cd-6e58-33d6-b118-86579e560d96",
                                        "glosses": [
                                            "Butin fait à la guerre, et généralement, toute chose dont on s’empare avec violence, avec une sorte de rapacité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a65e186-03bf-4473-912a-94271884f64c",
                                                "sense_id": "5dfec67d-a526-3786-8994-45b5fbb1cf6a",
                                                "text": "[…] videz vos poches, maîtres coquins, et rendez à ces dames ce que vous leur avez enlevé. Sans hésiter les voleurs débâillonnèrent la duègne, et restituèrent la riche proie qu’un instant ils avaient cru pouvoir s’approprier."
                                            },
                                            {
                                                "example_id": "d4dc612a-0adb-40b6-8d7d-c2066019f554",
                                                "sense_id": "5dfec67d-a526-3786-8994-45b5fbb1cf6a",
                                                "text": "Aussi rien n'est-il plus naturel que de voir des policiers […] prendre, pour ne pas effaroucher leur proie, l'apparence des gars qu'ils ont la mission d'appréhender."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34241a37-e23e-3171-8991-737c7ed63edc",
                                        "entry_id": "e99a50cd-6e58-33d6-b118-86579e560d96",
                                        "glosses": [
                                            "Personne qui a beaucoup à souffrir des passions des autres ou de sa propre passion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0756357a-9783-4745-8c2f-54628e560fa2",
                                                "sense_id": "34241a37-e23e-3171-8991-737c7ed63edc",
                                                "text": "Être en proie à l’avidité, à la cupidité des usuriers."
                                            },
                                            {
                                                "example_id": "86d71fde-aabc-43b6-b8c2-f9776c230999",
                                                "sense_id": "34241a37-e23e-3171-8991-737c7ed63edc",
                                                "text": "Il est en proie à la rapacité de son entourage."
                                            },
                                            {
                                                "example_id": "e8c9449e-a5fb-4401-91f4-9938f1ded567",
                                                "sense_id": "34241a37-e23e-3171-8991-737c7ed63edc",
                                                "text": "Cet honnête homme a été la proie des aigrefins."
                                            },
                                            {
                                                "example_id": "056215d4-21bd-42d2-83a3-cb5657c9bc3b",
                                                "sense_id": "34241a37-e23e-3171-8991-737c7ed63edc",
                                                "text": "Il est en proie à la calomnie, à la médisance."
                                            },
                                            {
                                                "example_id": "2da38f4b-6b54-46c3-9ade-eb2ec7a9699e",
                                                "sense_id": "34241a37-e23e-3171-8991-737c7ed63edc",
                                                "text": "Dénué de tous ses appuis, il demeura, il resta en proie à la vengeance."
                                            },
                                            {
                                                "example_id": "3f2d0480-59d6-4d1d-bb7e-2ac4093542f9",
                                                "sense_id": "34241a37-e23e-3171-8991-737c7ed63edc",
                                                "text": "Il est en proie à ses passions, à sa douleur, à la tristesse."
                                            },
                                            {
                                                "example_id": "0fb0043f-3f2d-4f97-9440-825b5e7a83b5",
                                                "sense_id": "34241a37-e23e-3171-8991-737c7ed63edc",
                                                "text": "J’avais reculé pour m’adosser au tronc de l’épineux. Ce n’était point lâcheté, j’en suis certain ; si j’en avais été la proie, je n’aurais aucun scrupule à le dire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b7b06c5-0a01-3e2f-a1eb-ee87f8b36b94",
                                        "entry_id": "e99a50cd-6e58-33d6-b118-86579e560d96",
                                        "glosses": [
                                            "Action d'être soumis au ravage ou à la destruction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0335d27-a221-48a5-801d-6e2f86623ed0",
                                                "sense_id": "0b7b06c5-0a01-3e2f-a1eb-ee87f8b36b94",
                                                "text": "A la suite du terrible massacre des juifs de la péninsule ibérique, en 1391, le Call de Perpignan fut envahi, en 1392, et devint la proie du meurtre et du pillage."
                                            },
                                            {
                                                "example_id": "b883c603-8d77-4a06-aa3e-62d091cf6ed7",
                                                "sense_id": "0b7b06c5-0a01-3e2f-a1eb-ee87f8b36b94",
                                                "text": "Paul tourna la tête vers Notre-Dame en proie aux flammes. Le spectacle était effroyable et fascinant à la fois : mille ans de foi, d’art et d’histoire se consumaient sous les yeux de la foule rassemblée sur le parvis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
