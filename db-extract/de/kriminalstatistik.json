                        "examples": [
                            {
                                "example_id": "6b7ad114-5528-485a-a525-9bf1f79b3442",
                                "sense_id": "15bae8d1-7efd-39c8-9d0c-1dd98a6a12aa",
                                "text": "„Sportler ließen die Kriminalstatistik nicht ansteigen.“"
                            },
                            {
                                "example_id": "fce73a70-67e2-49d1-bc18-735f1bb4eb40",
                                "sense_id": "15bae8d1-7efd-39c8-9d0c-1dd98a6a12aa",
                                "text": "„Diese Unzufriedenen waren die Aggressoren in den Townships, die Züge mit Steinen bewarfen, Autos stahlen und die Gegend mit dreisten Raubzügen terrorisierten, die die Zahlen der Kriminalstatistik in die Höhe trieben.“"
                            },
                            {
                                "example_id": "ddec2f42-3ab4-403d-a38e-2684b5bda83d",
                                "sense_id": "15bae8d1-7efd-39c8-9d0c-1dd98a6a12aa",
                                "text": "„Thomas wälzt daraufhin erst einmal Bücher über Eichen und Kriminalstatistiken über ganz normale Gartenbesitzer.“"
                            }
                        ],
