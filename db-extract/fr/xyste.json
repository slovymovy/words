                "senses": [
                    {
                        "sense_id": "fc7db3c1-46c0-3d46-9377-ac78ea1604ee",
                        "entry_id": "cec3ba57-3aba-3fe6-80bc-d5dc968ede5d",
                        "glosses": [
                            "Piste couverte d'un gymnase ; gymnase."
                        ],
                        "tags": [
                            "Ancient",
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "a87552fc-6763-49fc-9b26-2d024669e3de",
                                "sense_id": "fc7db3c1-46c0-3d46-9377-ac78ea1604ee",
                                "text": "La vie grecque se composait de quelques pièces essentielles (…) une éphébie, pour la jeunesse (…) un gymnase et un xyste pour les exercices du corps."
                            },
                            {
                                "example_id": "fcdfc3ca-62ce-4627-bf1b-1175a9b0f761",
                                "sense_id": "fc7db3c1-46c0-3d46-9377-ac78ea1604ee",
                                "text": "Par derrière régnait un grand xyste circulaire pour les jeux de toute espèce."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9424195-f463-3e38-ac90-9fca4a9dc69f",
                        "entry_id": "cec3ba57-3aba-3fe6-80bc-d5dc968ede5d",
                        "glosses": [
                            "Association d'athlètes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1f299e4c-bf85-3529-82ce-13976e9cbee8",
                        "entry_id": "cec3ba57-3aba-3fe6-80bc-d5dc968ede5d",
                        "glosses": [
                            "Allée couverte dans un jardin, pergola."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "d68e9279-4447-469b-b58a-b1356ca0adee",
                                "sense_id": "1f299e4c-bf85-3529-82ce-13976e9cbee8",
                                "text": "Un xyste ou lieu d'exercice tout parfumé de violettes est au devant de cette galerie, qui sert par sa réverbération à y augmenter l'ardeur du soleil."
                            }
                        ]
                    }
