                                    {
                                        "sense_id": "7b982d05-69cf-3be1-8126-07d7160287b3",
                                        "entry_id": "8bd8e21e-176e-35c9-8074-ff489f6bc513",
                                        "glosses": [
                                            "Retirer à (quelque chose) son caractère matériel, physique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "224fa1e8-735c-43ad-babd-76d05a58385d",
                                                "sense_id": "7b982d05-69cf-3be1-8126-07d7160287b3",
                                                "text": "Ainsi, à partir de janvier 2026, Euro NCAP assure dégrader la note accordée aux modèles qui dématérialiseraient des commandes dites “basiques”, dont la liste comprendrait essuie-glaces, clignotants, avertisseurs, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a502552-abdd-3023-856c-96db3f5246d5",
                                        "entry_id": "8bd8e21e-176e-35c9-8074-ff489f6bc513",
                                        "glosses": [
                                            "Numériser, remplacer un support donné par un support numérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5dc01c9-c132-4b39-9ae4-3f2f6e55e2c9",
                                                "sense_id": "1a502552-abdd-3023-856c-96db3f5246d5",
                                                "text": "Leur intention était de dématérialiser la monnaie."
                                            },
                                            {
                                                "example_id": "9c3059b9-cb84-4e0a-926d-7a5983586948",
                                                "sense_id": "1a502552-abdd-3023-856c-96db3f5246d5",
                                                "text": "On va dématérialiser le cahier de texte papier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ba5ea85-b414-3c0a-932b-4d600c77b4dc",
                                        "entry_id": "8bd8e21e-176e-35c9-8074-ff489f6bc513",
                                        "glosses": [
                                            "Perdre son caractère matériel, physique."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c2ab129-9086-4a49-b675-bdc0ca01a243",
                                                "sense_id": "2ba5ea85-b414-3c0a-932b-4d600c77b4dc",
                                                "text": "Il peut se dématérialiser, en se transformant intégralement en radiations."
                                            },
                                            {
                                                "example_id": "194291a3-f846-4a59-9959-f004f0775200",
                                                "sense_id": "2ba5ea85-b414-3c0a-932b-4d600c77b4dc",
                                                "text": "Ainsi il se détache du monde et de la société, il se construit un univers qui se suffit à lui-même et qui, à force de se déconcrétiser et de se dématérialiser, se fige, se pétrifie pour n’être plus qu’une image, qu’une ombre idéalisée, une illusion, une chimère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
