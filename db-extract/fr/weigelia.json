                        "sense_id": "bc9f95c8-1ae9-3720-a076-9b20788c0da8",
                        "entry_id": "247055f8-a2e9-36d2-ba66-fb3b8ec2348d",
                        "glosses": [
                            "Genre de plante (de nom scientifique Weigela) de la famille des caprifoliacées, comprenant 12 espèces d’arbustes caducs, au port étalé ou érigé, poussant dans les broussailles et en lisière de forêt dans l’est de l’Asie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d83bb69-2bb6-4dcb-82ef-813f530cc39f",
                                "sense_id": "bc9f95c8-1ae9-3720-a076-9b20788c0da8",
                                "text": "Elle était au fond du jardin. Je m’acheminai vers ce rond-point, étroitement entouré de buissons, à cette époque de l’année tout en fleurs, lilas, sorbiers, cytises, weigelias."
                            },
                            {
                                "example_id": "edf0ffc9-d58d-4210-b013-177de4deb8b2",
                                "sense_id": "bc9f95c8-1ae9-3720-a076-9b20788c0da8",
                                "text": "Un weigelia vous surprend, tout droit sorti d’un laurier du Caucase, tandis que Ghislaine de Feligonde, de ses tons chamoisés, dégringole d’un intense berberis."
                            }
                        ]
                    }
