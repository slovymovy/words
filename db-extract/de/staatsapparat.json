                "senses": [
                    {
                        "sense_id": "f5a783c3-8700-3c2c-a94e-e1aaa388373e",
                        "entry_id": "a49b099b-684a-390f-acd3-2fcd1ece0348",
                        "glosses": [
                            "Gesamtheit der Institutionen und Personen, die für die Ausführung der Staatsgewalt existieren beziehungsweise zu einem Staat gehören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef75f9a-71d5-4930-ac17-6df39f738889",
                                "sense_id": "f5a783c3-8700-3c2c-a94e-e1aaa388373e",
                                "text": "„Eine vom Volk gebilligte neue Verfassung räumte der islamischen Geistlichkeit eine führende Stellung im Staatsapparat ein, wobei Chomeini die aus der schiitischen Lehre abgeleitete Position als Vali-e-Faghik („der herrschende Gottesgelehrte“) eingeräumt wurde, dem in allen politischen und religiösen Fragen eine letzte Entscheidungsbefugnis zusteht.“"
                            },
                            {
                                "example_id": "7d9dfdcf-65fd-4e5a-942b-16e6d3e5a548",
                                "sense_id": "f5a783c3-8700-3c2c-a94e-e1aaa388373e",
                                "text": "„Zwar gibt es gesetzliche Regelungen dazu, wie die Öleinnahmen auf den verschiedenen Verwaltungsebenen verteilt werden sollen, doch letztlich versickert ein Großteil des Geldes im Staatsapparat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
