    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d63f3027-76ed-3314-94f7-f023a45e95a3",
                    "sense_definition": "życzliwość, przychylność lub wyświadczona przysługa",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dobroczynnosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Należy umieć zarobić na swoje utrzymanie, a nie tylko liczyć na <w>łaskę</w> innych ludzi.",
                            "target_lang_translations": {
                                "en": "One should be able to earn one's own living rather than just relying on the <w>charity</w> of other people."
                            }
                        },
                        {
                            "text": "Zrób mi tę <w>łaskę</w> i zamknij za sobą drzwi, kiedy będziesz wychodzić.",
                            "target_lang_translations": {
                                "en": "Do me a <w>favor</w> and close the door behind you when you leave."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zrobić łaskę",
                        "z łaski swojej",
                        "być na czyjejś łasce"
                    ],
                    "target_lang_definitions": {
                        "en": "kindness, goodwill, or an act of favor"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "favor",
                                "target_lang_sense_clarification": "an act of kindness or goodwill"
                            },
                            {
                                "target_lang_word": "mercy",
                                "target_lang_sense_clarification": "as in being dependent on someone's goodwill"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4da063ea-1465-3ce0-8e3d-b286b5577dab",
                    "sense_definition": "darowanie winy lub złagodzenie kary przez osobę mającą władzę",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prawo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Urzędnik przyłapany na szpiegostwie błagał króla o <w>łaskę</w>.",
                            "target_lang_translations": {
                                "en": "The official caught spying begged the king for <w>mercy</w>."
                            }
                        },
                        {
                            "text": "Skazany złożył do prezydenta oficjalny wniosek o prawo <w>łaski</w>.",
                            "target_lang_translations": {
                                "en": "The convict submitted an official request to the president for <w>clemency</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "błagać o łaskę",
                        "prawo łaski"
                    ],
                    "target_lang_definitions": {
                        "en": "remission of guilt, clemency, or reduction of punishment granted by an authority"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mercy",
                                "target_lang_sense_clarification": "clemency or leniency toward an offender"
                            },
                            {
                                "target_lang_word": "pardon",
                                "target_lang_sense_clarification": "legal remission of a penalty or crime"
                            },
                            {
                                "target_lang_word": "clemency",
                                "target_lang_sense_clarification": "mercy shown by an authority"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "416148ec-f61d-3eb3-9046-f9f5c8f37882",
                    "sense_definition": "w teologii chrześcijańskiej: bezinteresowny dar boży udzielany człowiekowi",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wierni modlili się w kościele, prosząc o potrzebne <w>łaski</w> dla swoich rodzin.",
                            "target_lang_translations": {
                                "en": "The faithful prayed in church, asking for the necessary <w>graces</w> for their families."
                            }
                        },
                        {
                            "text": "Według doktryny chrześcijańskiej nikt nie osiągnie zbawienia bez <w>łaski</w> boskiej.",
                            "target_lang_translations": {
                                "en": "According to Christian doctrine, no one can attain salvation without divine <w>grace</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "łaska Boża",
                        "stan łaski"
                    ],
                    "target_lang_definitions": {
                        "en": "in Christian theology, the unmerited favor and divine assistance given by God to humans"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grace",
                                "target_lang_sense_clarification": "unmerited divine assistance or favor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84370a7d-14ee-36b6-acdb-9f50f5a59569",
                    "sense_definition": "niewielki drapieżny ssak z rodziny łasicowatych; łasica",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "zwierzeta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W starym spichlerzu schowała się zwinna <w>łaska</w>, polująca na myszy.",
                            "target_lang_translations": {
                                "en": "An agile <w>weasel</w> hunting for mice hid in the old granary."
                            }
                        },
                        {
                            "text": "Na leśnej ścieżce mignęła ruda <w>łaska</w> i natychmiast zniknęła w zaroślach.",
                            "target_lang_translations": {
                                "en": "A reddish <w>weasel</w> flashed across the forest path and immediately vanished into the bushes."
                            }
                        }
                    ],
                    "synonyms": [
                        "łasica",
                        "łasica pospolita"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "rzadkie lub regionalne określenie łasicy"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a small carnivorous mammal belonging to the mustelid family; a weasel"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "weasel",
                                "target_lang_sense_clarification": "small carnivorous mammal (least weasel)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}