                "senses": [
                    {
                        "sense_id": "4403a840-876a-30ff-9037-e79273767263",
                        "entry_id": "8f82a707-6cd6-3e9d-81e1-d2fdaf3a7311",
                        "glosses": [
                            "Übermittlung von Informationen über Funkwellen mit der Absicht, eine große Anzahl von Empfängern zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c482cfe-11b0-4fb1-b110-888d518ea2d6",
                                "sense_id": "4403a840-876a-30ff-9037-e79273767263",
                                "text": "„Am Abend hörte Emendörfer die Rundfunkübertragung des Kampfes, der nur knapp zwei Minuten dauerte.“"
                            },
                            {
                                "example_id": "4bd71a87-3471-4f53-8c86-92a0ba4f7285",
                                "sense_id": "4403a840-876a-30ff-9037-e79273767263",
                                "text": "„Zahlreiche Formationen der NSDAP wohnen der Rundfunkübertragung von den Beisetzungsfeierlichkeiten für den verstorbenen Reichspräsidenten von Hindenburg bei.“"
                            },
                            {
                                "example_id": "c7c762cf-7b82-4ab1-ac5e-ba28f524eee2",
                                "sense_id": "4403a840-876a-30ff-9037-e79273767263",
                                "text": "„Eine Fernseh- oder Rundfunkübertragung war nicht vereinbart worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
