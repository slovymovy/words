                                        "tags": [
                                            "dříve"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f6c1e2f-b929-4f5b-b218-031a15fe14d1",
                                                "sense_id": "9c2bfc83-ab1d-3e5c-84ff-629949e47344",
                                                "text": "Polní kurát Otto Katz byl přece jen roztomilý člověk. Jeho kázání byla neobyčejně poutavá, legrační, osvěžující tu nudu garnizónu."
                                            },
                                            {
                                                "example_id": "e4eaa2f6-2494-43be-87d8-ddfd6dab1440",
                                                "sense_id": "9c2bfc83-ab1d-3e5c-84ff-629949e47344",
                                                "text": "Ku cti pana polního kuráta budiž řečeno, že do kasáren netelefonoval, poněvadž neměl doma telefonu a mluvil do stojanu na žárovku."
                                            }
                                        ]
                                    }
                                ]
                            }
