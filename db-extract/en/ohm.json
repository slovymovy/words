                                    {
                                        "sense_id": "ffb0a0a7-e3c4-3314-8ad0-a2f4d22a2e78",
                                        "entry_id": "bffaadb1-6734-3d8a-b53b-e09dfd9cf676",
                                        "glosses": [
                                            "Maßeinheit des elektrischen Widerstands"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86cf1c26-736a-45d9-9ceb-2ad527fbf185",
                                                "sense_id": "ffb0a0a7-e3c4-3314-8ad0-a2f4d22a2e78",
                                                "text": "An einem Widerstand von 1 Ohm fällt bei einem Strom von 1 Ampere eine Spannung von 1 Volt ab."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ohm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9644cbde-82cc-30ff-b9e5-66424942e27d",
                                        "entry_id": "3ec47153-db42-39ae-8d1a-7783a3f19db4",
                                        "glosses": [
                                            "ein Hohlmaß von etwa anderthalb Hektoliter"
                                        ],
                                        "tags": [
                                            "früheres Flüssigkeitsmaß",
                                            "besonders für Wein"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b519e38d-616c-4d87-976b-f70c80f2cf0b",
                                                "sense_id": "9644cbde-82cc-30ff-b9e5-66424942e27d",
                                                "text": "Die Maßkette für das Ohm war regional unterschiedlich."
                                            },
                                            {
                                                "example_id": "c754cb4e-bf75-4242-a8c3-e0a19967dce3",
                                                "sense_id": "9644cbde-82cc-30ff-b9e5-66424942e27d",
                                                "text": "Allgemein waren 6 große oder 10 kleine Ohm eine Fuder."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ohm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5035eb5d-64e1-3684-9124-ec9ff1c4369a",
                                        "entry_id": "3403a6cb-d89d-3b8c-91d3-5d5aeaff2872",
                                        "glosses": [
                                            "Bruder der Mutter, in Abgrenzung zum Bruder des Vaters (Onkel)"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b1fd58d-823f-43b5-b447-95333853023b",
                                                "sense_id": "5035eb5d-64e1-3684-9124-ec9ff1c4369a",
                                                "text": "„Wer ist Ohm Hein? Ohm Hein ist Ohm Hein, weiter nichts.“"
                                            },
                                            {
                                                "example_id": "311a9fe9-8054-4e63-b5e8-4e03590369fb",
                                                "sense_id": "5035eb5d-64e1-3684-9124-ec9ff1c4369a",
                                                "text": "„Dagegen brachte die Großmutter den Ohm bei seinem nächsten Besuch, nachdem der sich an Kassler, Sauerkraut und Kartoffelbrei gelabt und einen wohlwollenden Blick auf meinen züchtig die Knie verhüllenden Rock geworfen hatte, sichtlich in Erklärungsnot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ohm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f949992-42ef-3be0-8fe8-372702e2cc73",
                                        "entry_id": "e874db15-55b9-3deb-8a64-dbe23af12864",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "125b9a6d-f6ef-4a12-99a8-2271c2e854ef",
                                                "sense_id": "9f949992-42ef-3be0-8fe8-372702e2cc73",
                                                "text": "Frau Ohm ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "24f5b2fb-605a-4b92-a9b8-75e49ae35904",
                                                "sense_id": "9f949992-42ef-3be0-8fe8-372702e2cc73",
                                                "text": "Herr Ohm wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "36665750-7fa3-40fe-8ba7-68037ec90928",
                                                "sense_id": "9f949992-42ef-3be0-8fe8-372702e2cc73",
                                                "text": "Die Ohms fahren heute nach Erfurt."
                                            },
                                            {
                                                "example_id": "f172091d-56cd-476b-be10-4da5cc3cbe9f",
                                                "sense_id": "9f949992-42ef-3be0-8fe8-372702e2cc73",
                                                "text": "Der Ohm trägt nie die Pullover, die die Ohm ihm strickt."
                                            },
                                            {
                                                "example_id": "528c8fcd-aac3-4557-b327-f0ac45f2d054",
                                                "sense_id": "9f949992-42ef-3be0-8fe8-372702e2cc73",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ohm kommt, geht der Herr Ohm.“"
                                            },
                                            {
                                                "example_id": "ca3bc8c4-ae68-4e48-acf2-f36c94acc3a8",
                                                "sense_id": "9f949992-42ef-3be0-8fe8-372702e2cc73",
                                                "text": "Ohm kommt und geht."
                                            },
                                            {
                                                "example_id": "600c7c3a-3cbe-401f-ab4f-d041b4cfb325",
                                                "sense_id": "9f949992-42ef-3be0-8fe8-372702e2cc73",
                                                "text": "Ohms kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ohm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4be531cb-fba4-351a-a942-5d9e65724d51",
                                        "entry_id": "ebf39175-59d8-3939-a8ef-1fc3fb67999f",
                                        "glosses": [
                                            "linker Nebenfluss der Lahn, der östlich von Ulrichstein im Vogelsberg entspringt und nach 60 km Flusslauf in Cölbe in die Lahn mündet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5a11de0-cfd0-4216-9f89-e33a894377a6",
                                                "sense_id": "4be531cb-fba4-351a-a942-5d9e65724d51",
                                                "text": "„Nach zum Teil heftigem Schneefall und Regen in den vergangenen Tagen sind Lahn, Ohm und Wohra über ihre Ufer getreten.“"
                                            },
                                            {
                                                "example_id": "c8568558-90ca-4866-ba3a-6ff4b1b2eed7",
                                                "sense_id": "4be531cb-fba4-351a-a942-5d9e65724d51",
                                                "text": "„Bis die Ohm in die Lahn mündet und ihren Namen einbüßt, sammelt sie 26 Zuflüsse und ist damit der Hauptwasserlieferant der Lahn.“"
                                            },
                                            {
                                                "example_id": "08823eb2-cd78-4b65-99ae-ad2ee20eca67",
                                                "sense_id": "4be531cb-fba4-351a-a942-5d9e65724d51",
                                                "text": "„Ein Pferd hatte offenbar den Zaun einer Weide übersprungen, war daraufhin in der angrenzenden Ohm gelandet und kam nicht mehr allein aus dem etwa zwei Meter tiefen Fluss heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
