                    {
                        "form_id": "48308770-904d-4d2a-8918-9a6c2a620cb6",
                        "entry_id": "44f163d3-dc65-3a3f-854b-74bb47e68d0c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Lautschriften"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0e3ec9f-89a5-33b2-bfb9-9c1bc3bd7440",
                        "entry_id": "44f163d3-dc65-3a3f-854b-74bb47e68d0c",
                        "glosses": [
                            "Schrift zur Kennzeichnung der Aussprache eines Wortes"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "0625d22d-ac54-4944-888a-b7d08895c210",
                                "sense_id": "c0e3ec9f-89a5-33b2-bfb9-9c1bc3bd7440",
                                "text": "Die Lautschrift zeigt Anwendern von Deutsch-Englisch-Wörterbüchern, wie sie ein deutsches Wort auszusprechen haben."
                            },
                            {
                                "example_id": "90821d31-7104-44d3-a97d-53c819a4e7d3",
                                "sense_id": "c0e3ec9f-89a5-33b2-bfb9-9c1bc3bd7440",
                                "text": "„Humboldt sah nur die Alternative zwischen Lautschrift und Begriffsschrift.“"
                            },
                            {
                                "example_id": "3c7dd0ee-de9a-4085-8493-3e8087dd203d",
                                "sense_id": "c0e3ec9f-89a5-33b2-bfb9-9c1bc3bd7440",
                                "text": "„Durch eine einheitliche Lautschrift wird verhindert, daß die Unterschiede in der Aussprache immer größer werden, die Dialekte einer Sprache sich immer mehr auseinanderentwickeln.“"
                            },
                            {
                                "example_id": "03dc9697-51ea-4821-8249-f9b33727226f",
                                "sense_id": "c0e3ec9f-89a5-33b2-bfb9-9c1bc3bd7440",
                                "text": "„Dieses Wort notiere ich mir in Lautschrift und nehme mir vor, es in Persien auf seine Richtigkeit zu überprüfen.“"
                            },
                            {
                                "example_id": "b0163ec6-b444-4c76-80de-ecff05421453",
                                "sense_id": "c0e3ec9f-89a5-33b2-bfb9-9c1bc3bd7440",
                                "text": "„Erst reine Lautschriften mit zumeist nur 20-30 Buchstaben waren leichter und schneller zu erlernen und blieben so nicht nur auf einige wenige Schreibkundige beschränkt.“"
                            },
                            {
                                "example_id": "974a2e65-808c-4757-afbb-35d1352fc793",
                                "sense_id": "c0e3ec9f-89a5-33b2-bfb9-9c1bc3bd7440",
                                "text": "„In einem anderen Fenster laufen die Zeichen der Lautschrift.“"
                            },
                            {
                                "example_id": "c8a2f308-e1c4-4f80-8311-451a635f335c",
                                "sense_id": "c0e3ec9f-89a5-33b2-bfb9-9c1bc3bd7440",
                                "text": "„Die verwendete Lautschrift fußt auf den Aussprachebezeichnungen der Association Phonétique Internationale (Internationale Phonetische Vereinigung), ist aber den Zwecken des Großen Fremdwörterbuchs angepasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
