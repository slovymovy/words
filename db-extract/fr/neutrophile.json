                                                "sense_id": "3188720b-2273-3113-8260-c32c7bfb0d87",
                                                "text": "Histological examination showed neutrophilic or pleocellular proliferative necrotizing bronchitis and bronchiolitis in all (6 out of 6) infected steers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc1941ee-a711-30ad-a7a2-8fb72ed7e3f6",
                                        "entry_id": "39875e02-9d8c-376e-847b-7b26e99da67d",
                                        "glosses": [
                                            "In microscopy and chemistry, not staining strongly with acidic or alkaline stains, but staining strongly with pH-neutral stains."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
