                "senses": [
                    {
                        "sense_id": "d7c9af7d-f225-3f49-bbb9-e3e3d8c19c65",
                        "entry_id": "66a1d262-e0a2-3ddf-905a-de1c395b9201",
                        "glosses": [
                            "paleface (white person from the perspective of Native Americans)"
                        ],
                        "tags": [
                            "humorous",
                            "neuter",
                            "often",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e486947d-379b-43f4-baef-b6c3835b7807",
                                "sense_id": "d7c9af7d-f225-3f49-bbb9-e3e3d8c19c65",
                                "text": "„Später vielleicht. Haben dir deine Kundschafter nicht gesagt, weshalb wir uns hier befinden?“\n„Ich habe es von ihnen erfahren. Ihr wollt einen Weg für das Feuerroß der Bleichgesichter bauen.",
                                "translation": "“Perhaps later. Haven’t your scouts told you why we’re here?”\n“I found out from them. You lot want to build a railroad for the pale-faces’ iron horse.",
                                "english": "“Perhaps later. Haven’t your scouts told you why we’re here?”\n“I found out from them. You lot want to build a railroad for the pale-faces’ iron horse."
                            }
                        ]
                    },
