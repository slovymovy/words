                "senses": [
                    {
                        "sense_id": "fb230a2e-a7e6-31a1-bd7b-1f125655611c",
                        "entry_id": "49f541fb-192e-3f1d-9062-e21b19d2d294",
                        "glosses": [
                            "de verhouding waarmee de ene muntsoort in de andere gewisseld kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c74c92fc-2a08-4811-a7f9-654c4889af54",
                                "sense_id": "fb230a2e-a7e6-31a1-bd7b-1f125655611c",
                                "text": "Onrust in de wisselkoersen kan internationale handel erg riskant maken."
                            },
                            {
                                "example_id": "03e9f89c-1fd1-400d-a025-ec9762fcad19",
                                "sense_id": "fb230a2e-a7e6-31a1-bd7b-1f125655611c",
                                "text": "De centrale bank van Zimbabwe heeft het belangrijkste rentetarief opgevoerd naar een recordhoogte. Dat doen de beleidsmakers om de torenhoge inflatie in het Afrikaanse land te beteugelen. Ook hopen ze de wisselkoers van de Zimbabwaanse dollar enigszins stabiel te krijgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9836f5b-d284-4715-baa2-a7145b0ec165",
                        "source_entry_id": "49f541fb-192e-3f1d-9062-e21b19d2d294",
                        "source_sense_id": "fb230a2e-a7e6-31a1-bd7b-1f125655611c",
                        "source_sense_description": "wisselkoers",
                        "target_lang_word": "Wechselkurs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wechselkurs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8adf63a4-7e7a-34d1-a27e-a51ab6f308b4",
                                        "entry_id": "b3401cbc-34c5-3963-b680-d189a23390ef",
                                        "glosses": [
                                            "Preis, zu dem man eine ausländische Währung kaufen kann, ausgedrückt in der inländischen Währung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "891e8737-8343-4fc3-851b-6f67cd0e7193",
                                                "sense_id": "8adf63a4-7e7a-34d1-a27e-a51ab6f308b4",
                                                "text": "Wechselkurse zu beobachten ist nicht nur etwas für Börsenspekulanten, es kann sich auch für Urlauber auszahlen."
                                            },
                                            {
                                                "example_id": "93ae82a6-f024-47a8-b7d5-217d9357c196",
                                                "sense_id": "8adf63a4-7e7a-34d1-a27e-a51ab6f308b4",
                                                "text": "„Dem stimmte Angel sofort zu, denn wie sie uns versicherte, war der Wechselkurs an der Grenze immer eine Abzocke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
