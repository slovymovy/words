                                        "sense_id": "5eaf893a-4503-3753-8c4f-162d511bbc0c",
                                        "entry_id": "611dc860-efb1-325b-b0e5-6ca5d644d12a",
                                        "glosses": [
                                            "Relating to or involving ships or shipping or navigation or seamen."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f98ff09-b610-42c9-97ff-22ee615469ea",
                                                "sense_id": "5eaf893a-4503-3753-8c4f-162d511bbc0c",
                                                "text": "nautical charts"
                                            },
                                            {
                                                "example_id": "66bc4bd5-da0c-4e3e-9cb2-650fc6afea98",
                                                "sense_id": "5eaf893a-4503-3753-8c4f-162d511bbc0c",
                                                "text": "I was mostly unfamiliar with the nautical terms used in the sailing documentary."
                                            },
                                            {
                                                "example_id": "87768e18-0bcd-4411-ad00-db620ad29a67",
                                                "sense_id": "5eaf893a-4503-3753-8c4f-162d511bbc0c",
                                                "text": "The mainsail was \"scandalised\" - a nautical mode of describing a sail reefed at both ends[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8253bd4-2139-4833-91a1-fc3ca56042f4",
                        "source_entry_id": "856cddfd-ba65-3460-9509-170e6851de6e",
                        "source_sense_id": "62a73b0c-9f20-349c-9d20-ba9958344d00",
                        "target_lang_word": "nautický",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2f233344-74d6-43ba-8281-6ed72a61ba87",
                        "source_entry_id": "856cddfd-ba65-3460-9509-170e6851de6e",
                        "source_sense_id": "62a73b0c-9f20-349c-9d20-ba9958344d00",
                        "target_lang_word": "nautique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nautique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "325114bf-4d0e-3931-8d96-43a728697e0f",
                                        "entry_id": "e425b27a-f2e4-3e27-b506-fa17ebe4e099",
                                        "glosses": [
                                            "Relatif à la navigation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7863d187-7155-41cd-84a9-c70993e969fd",
                                                "sense_id": "325114bf-4d0e-3931-8d96-43a728697e0f",
                                                "text": "Ce n’est qu’en frémissant qu’il posait le pied dans un bateau, ce véhicule nautique fût-il assuré par une traille à roulettes."
                                            },
                                            {
                                                "example_id": "dc61385b-dc61-4293-bd24-211f22b36256",
                                                "sense_id": "325114bf-4d0e-3931-8d96-43a728697e0f",
                                                "text": "Art nautique. — Astronomie nautique. — Cartes nautiques. — Observations, instructions nautiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a272cdfa-3cd6-3708-aa8c-e8b9301d3f31",
                                        "entry_id": "e425b27a-f2e4-3e27-b506-fa17ebe4e099",
                                        "glosses": [
                                            "Relatif à la nage et à toutes les activités de loisir qui se font dans l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8e85d1e-e45d-463a-8309-153f54373c1c",
                                                "sense_id": "a272cdfa-3cd6-3708-aa8c-e8b9301d3f31",
                                                "text": "À Saint-Georges, un hôtel possédait une magnifique piscine, où je vis plusieurs fêtes nautiques. Il y avait de bon nageurs et nageuses et deux excellentes équipes de water-polo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nautique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4857497e-0b94-31c6-9846-6b522ce4ba9e",
                                        "entry_id": "f1410969-ea8d-3179-aa3d-c5cb1334ffc1",
                                        "glosses": [
                                            "Mille marin, historiquement défini comme une minute d’arc sur un grand cercle terrestre, valant exactement 1852 mètres aujourd’hui. Note d’usage : Dans la Marine nationale et l’Armée de l’Air françaises, on dit simplement nautique, non pas mille nautique ; cette dernière prononciation signifierait plutôt 1000 nautiques, soit 1852 kilomètres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "820d080e-8cea-4d19-852b-dddc0ba27d20",
                                                "sense_id": "4857497e-0b94-31c6-9846-6b522ce4ba9e",
                                                "text": "La zone dangereuse aérienne prévue par le plan de campagne a donc une forme circulaire autour du point zéro, avec un excroissance vers l’est : son rayon atteint en effet les 500 nautiques (900 km) entre les azimuts 30° et 150° quand il n’est que de 200 nautiques (370 km) sur le reste de la circonférence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "949a00c5-73cf-42ed-9a6e-250014186152",
                        "source_entry_id": "856cddfd-ba65-3460-9509-170e6851de6e",
                        "source_sense_id": "62a73b0c-9f20-349c-9d20-ba9958344d00",
                        "target_lang_word": "nautisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nautisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "66c1dd38-7e95-3b64-bd4b-cecf5586b22e",
                                        "entry_id": "ffd1302a-ba4a-3f71-ac8d-964b4686a70c",
                                        "glosses": [
                                            "betrekking hebbend op watersport of scheepvaart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "786c607d-0833-48d1-886b-d9dba14e602d",
                                                "sense_id": "66c1dd38-7e95-3b64-bd4b-cecf5586b22e",
                                                "text": "Er is veel nautisch clichégebruik in de Tweede Kamer. Zo komen met enige regelmaat olie- dan wel mammoettankers voorbij (die zijn slechts met moeite van koers te veranderen, net als het overheidsbeleid). (Thijs Niemantsverdriet NRC 12 september 2015)"
                                            },
                                            {
                                                "example_id": "85867cf8-6b49-40ab-8734-9b386a344c9d",
                                                "sense_id": "66c1dd38-7e95-3b64-bd4b-cecf5586b22e",
                                                "text": "Het nautisch evenement Sail trok dit jaar volgens de gemeente 2,3 miljoen bezoekers, in opeenvolgende dagen 350, 400, 500, 600 en 450 duizend. Zou het waar zijn? (Karel Knip NRC 5 september 2015)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16d976aa-34bb-4039-a851-cfc4df69d23a",
                        "source_entry_id": "856cddfd-ba65-3460-9509-170e6851de6e",
                        "source_sense_id": "62a73b0c-9f20-349c-9d20-ba9958344d00",
                        "target_lang_word": "nautisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nautisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04de001f-43ab-35db-8648-15dbb22a8b93",
                                        "entry_id": "309b4c9b-5fcf-311f-94f0-0fb5ac1d3061",
                                        "glosses": [
                                            "die Nautik betreffend, zur Nautik gehörend, auf der Nautik beruhend"
                                        ],
                                        "tags": [
                                            "Seewesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd293fd0-4495-4bba-a46e-25a41449a8dd",
                                                "sense_id": "04de001f-43ab-35db-8648-15dbb22a8b93",
                                                "text": "Es gibt zu wenig Bewerber mit nautischem Patent bei der Wasserschutzpolizei."
                                            },
                                            {
                                                "example_id": "21bb9125-4487-4fe9-89db-372088241c55",
                                                "sense_id": "04de001f-43ab-35db-8648-15dbb22a8b93",
                                                "text": "Die 26-Jährige ist eine von 87 Offizierinnen in der deutschen Schifffahrt - bei 1314 nautischen Offizieren insgesamt."
                                            },
                                            {
                                                "example_id": "26587be4-48e9-4dae-9a91-af2b53ec74a6",
                                                "sense_id": "04de001f-43ab-35db-8648-15dbb22a8b93",
                                                "text": "Vertikal muss die Flugsicherung bei Start und Landung einen Abstand von drei nautischen Meilen, also rund fünf Kilometer sicherstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
