                "senses": [
                    {
                        "sense_id": "dc5762e3-32b5-3284-8d02-bb4ee9e39d4f",
                        "entry_id": "4ce2fb18-de83-3526-8bdf-c7c65788e3be",
                        "glosses": [
                            "Qui est trop minutieux, qui attache de l’importance aux moindres détails."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d668090-fc5e-42a5-a2d9-19cfdadba9e5",
                                "sense_id": "dc5762e3-32b5-3284-8d02-bb4ee9e39d4f",
                                "text": "Tatillon, maniaque, obnubilé par les détails et sujet à transformer ses meilleurs amis en ennemis à force d’inflexibilité, voici Alfred Marshall, qui connut malgré tout la consécration professionnelle."
                            },
                            {
                                "example_id": "ac1c3ed4-17eb-4c2c-9b61-ae0ef40e5c4b",
                                "sense_id": "dc5762e3-32b5-3284-8d02-bb4ee9e39d4f",
                                "text": "Jamais contente, tatillonne et rancunière, elle remonte chaque jour un peu plus avant dans le passé en pleurnichant, à la recherche d’une terre propre."
                            },
                            {
                                "example_id": "6202ec4a-3188-40b2-b030-6711605cb6ea",
                                "sense_id": "dc5762e3-32b5-3284-8d02-bb4ee9e39d4f",
                                "text": "L'avantage du collège et du couvent? Pouvoir exercer un contrôle tatillon des pratiques. Mais les élèves ne manquent pas de moyens pour les contourner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0741a89b-3b2b-4066-a85d-7974575c589d",
                        "source_entry_id": "4ce2fb18-de83-3526-8bdf-c7c65788e3be",
                        "source_sense_id": "dc5762e3-32b5-3284-8d02-bb4ee9e39d4f",
