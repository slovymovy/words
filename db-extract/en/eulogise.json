                                        "entry_id": "1e6b58ba-690d-31c5-97c1-0b1584bb79b1",
                                        "glosses": [
                                            "eine wertschätzende Aussage machen"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41d99cbb-6c8b-4d51-a60a-3b257e182451",
                                                "sense_id": "92e75582-3b18-3f00-a0e1-a2e0319b6266",
                                                "text": "Der Lehrer hat mich gelobt, weil ich diese Aufgabe sehr schnell gelöst habe."
                                            },
                                            {
                                                "example_id": "1800d052-64e8-48f9-b260-429391020e0e",
                                                "sense_id": "92e75582-3b18-3f00-a0e1-a2e0319b6266",
                                                "text": "Indem man jemanden lobt kann man ihn unterstützen, sich selbst zu motivieren."
                                            },
                                            {
                                                "example_id": "8956fed9-8779-4cab-a898-1951adfceaa9",
                                                "sense_id": "92e75582-3b18-3f00-a0e1-a2e0319b6266",
                                                "text": "Ihr Name wurde lobend erwähnt."
                                            },
                                            {
                                                "example_id": "dc56f58b-7387-44d5-b900-c4a76e3fc8ec",
                                                "sense_id": "92e75582-3b18-3f00-a0e1-a2e0319b6266",
                                                "text": "Gelobt sei, was hart macht!"
                                            },
                                            {
                                                "example_id": "f11ed594-9403-4b48-aa30-d17a92b69c00",
                                                "sense_id": "92e75582-3b18-3f00-a0e1-a2e0319b6266",
                                                "text": "„Ich lob mich selbst.“"
                                            },
                                            {
                                                "example_id": "aadaed2b-b35f-42f3-8a59-12d5be8cb888",
                                                "sense_id": "92e75582-3b18-3f00-a0e1-a2e0319b6266",
                                                "text": "„Ich lob’ euch\nFür eure Klugheit.“"
                                            },
                                            {
                                                "example_id": "6ad20abd-c1f1-455c-999e-03283123437e",
                                                "sense_id": "92e75582-3b18-3f00-a0e1-a2e0319b6266",
                                                "text": "Ausgehen? Nein, danke. Da lob ich mir mein Bier vor dem Fernseher."
                                            }
                                        ],
