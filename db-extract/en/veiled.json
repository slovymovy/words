                                            },
                                            {
                                                "example_id": "c5aae402-f471-41ba-9e86-e9e2cbb8d7a7",
                                                "sense_id": "d1ebe602-91aa-3bea-b316-6a2e8412c353",
                                                "text": "Ein verschleierter Himmel hat den Menschen in NRW bei der Sonnenfinsternis am Freitag vielerorts buchstäblich den Blick vernebelt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b191818f-5101-304d-9aeb-aafdb6b5869a",
                                        "entry_id": "b3a79884-d285-3c8f-a0e0-83beb596612a",
                                        "glosses": [
                                            "eine durch Alkohol, Tränenflüssigkeit oder Nässe verschwommene oder getrübte Sicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "241fa015-4d69-43cb-a726-6998da9f9f30",
                                                "sense_id": "b191818f-5101-304d-9aeb-aafdb6b5869a",
                                                "text": "Mit Tränen in den Augen und verschleiertem Blick gestand sie ihm ihre Liebe."
                                            },
                                            {
                                                "example_id": "11c90401-7fac-421d-9f03-a511ada7c02a",
                                                "sense_id": "b191818f-5101-304d-9aeb-aafdb6b5869a",
                                                "text": "Von den Wänden im Treppenhaus grüßen mit verschleiertem Blick Künstler, die mit Drogen seelische Höhlenforschung betrieben haben: Edgar Allan Poe und Trakl, Goya und Cocteau."
                                            },
                                            {
                                                "example_id": "e1f6c3c7-15b9-44af-a433-45645e590e4e",
                                                "sense_id": "b191818f-5101-304d-9aeb-aafdb6b5869a",
                                                "text": "[…] Elvis 1973 auf Hawaii: Zuschauer an den Fernsehern weltweit sahen den King mit verschleiertem Blick und unsicherem Schritt […]"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "430ec3cb-f9ca-3688-807c-b7b04de2c5f1",
                                        "entry_id": "b3a79884-d285-3c8f-a0e0-83beb596612a",
                                        "glosses": [
                                            "eine durch Krankheit oder belegte Stimmbänder veränderte Stimme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f219339-68bd-48c4-b35e-ee1f56113d5f",
                                                "sense_id": "430ec3cb-f9ca-3688-807c-b7b04de2c5f1",
                                                "text": "»Ja, Jenny,« hob er mit immer noch verschleierter Stimme an, »was versäumt ist, ist versäumt.[…]«"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
