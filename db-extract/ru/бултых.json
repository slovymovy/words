                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plouf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0df209b6-be64-3974-8213-cf8b086068a1",
                                        "entry_id": "932340b7-6f2d-3310-91d7-b7aad4a66be7",
                                        "glosses": [
                                            "Bruit de ce qui tombe dans un liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea2a022d-21ae-4786-8f6b-77bc26db5d66",
                                                "sense_id": "0df209b6-be64-3974-8213-cf8b086068a1",
                                                "text": "C’est que la base est un espace de loisirs à la portée de toutes les bourses, surtout des plus modestes qui n’ont pas les moyens de partir en vacances, d’aller à la plage ou même de faire un plouf au X’Eau de Châteaubernard."
                                            },
                                            {
                                                "example_id": "e6cfa478-2327-4197-8ea2-af088e5d1968",
                                                "sense_id": "0df209b6-be64-3974-8213-cf8b086068a1",
                                                "text": "Cascades métalliques de vaisselles versées à la vapeur sur les tables… éparpillement de cuillers… bouteilles attrapées au vol… soupières de corps de garde tenant en leurs flancs rebondis des mares écumantes où plongent les louches avec le plouf sonore des grenouilles en alerte…"
                                            },
                                            {
                                                "example_id": "a21e672e-9473-47ad-9c55-58315577a80e",
                                                "sense_id": "0df209b6-be64-3974-8213-cf8b086068a1",
                                                "text": "La Seine n’avait pas bougé depuis ce soir-là. D’ailleurs elle n’avait pas bougé depuis le « plouf » de Buridan clos dans son sac, amours mortes, et coulait toujours, autres amours mortes, sous le pont Mirabeau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plouf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87929678-e7d8-39be-a69d-a13f47519bea",
                                        "entry_id": "b23189c8-79ea-3299-926f-ea0498d49328",
                                        "glosses": [
                                            "Comptine chantée par des enfants pour choisir l'un d'entre eux, généralement dans le cadre d'un jeu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10230adf-6c29-47ee-af90-fc01eac8fc95",
                                                "sense_id": "87929678-e7d8-39be-a69d-a13f47519bea",
                                                "text": "On fait plouf plouf ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plouf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "705eff18-559d-3a3e-88d1-27a79e686658",
                                        "entry_id": "37e69ab4-e398-3771-8d56-d893b5f9ad0e",
                                        "glosses": [
                                            "Indique une chute dans un liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a549861-38c3-4861-be57-9c58e0c4db71",
                                                "sense_id": "705eff18-559d-3a3e-88d1-27a79e686658",
                                                "text": "Il glisse… et plouf ! le voilà dans la mare."
                                            },
                                            {
                                                "example_id": "6dfcd156-8243-4f55-8791-12110a0ac527",
                                                "sense_id": "705eff18-559d-3a3e-88d1-27a79e686658",
                                                "text": "Plouf! Les deux tiers du rapport Payette viennent de tomber à l'eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0e14f11-0b5d-3b95-b45b-663a52c218d1",
                                        "entry_id": "37e69ab4-e398-3771-8d56-d893b5f9ad0e",
                                        "glosses": [
                                            "Indique une chute dans quelque chose de mou"
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "535de60c-86c6-48db-b5d5-ca9fe49a7c35",
                                                "sense_id": "a0e14f11-0b5d-3b95-b45b-663a52c218d1",
                                                "text": "Je saute à pieds joints d’un lit sur l’autre, les lits sont séparés par un assez large espace, il faut bien viser et plouf, tomber de l’autre côté, s’enfoncer dans l’énorme édredon, se rouler en faisant du bruit, en poussant des cris…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
