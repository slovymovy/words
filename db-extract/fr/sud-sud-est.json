        "fr-extract.jsonl": [
            {
                "entry_id": "324a6aa7-38f9-39ba-a796-41cb8372379e",
                "word": "sud-sud-est",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9e6497f3-c75d-3a4a-9349-45e7a54cfbc0",
                        "entry_id": "324a6aa7-38f9-39ba-a796-41cb8372379e",
                        "glosses": [
                            "Point de l’horizon qui est entre le sud et le sud-est."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47c8329f-bf2c-422c-94bb-fb7dca3cce14",
                                "sense_id": "9e6497f3-c75d-3a4a-9349-45e7a54cfbc0",
                                "text": "Un vent de sud-sud-est soufflait dans la baie avec une telle rage , qu'il ne fallait pas songer à affronter en canot les lames courtes et frangées d'écume qui semblaient vouloir démolir les flancs du Valdemar."
                            },
                            {
                                "example_id": "ab801394-0382-439b-a17f-11dc75a5708f",
                                "sense_id": "9e6497f3-c75d-3a4a-9349-45e7a54cfbc0",
                                "text": "Le temps s’était gâté tout à fait, et les dirigeables, gênés par la nécessité de tenir tête au vent, manœuvraient malaisément. Les rafales, accompagnées de grêle et de tonnerre, se succédaient, accourant du sud sud-est, […]."
                            },
                            {
                                "example_id": "c2563f95-4b96-40ea-9640-a1daa34f7342",
                                "sense_id": "9e6497f3-c75d-3a4a-9349-45e7a54cfbc0",
                                "text": "Le vent souffle de l'est, ma route est sud-sud-est."
                            }
                        ]
                    }
                ],
