                "senses": [
                    {
                        "sense_id": "9df6fdaa-f487-32d9-a230-3449e4ee05dd",
                        "entry_id": "a300dcf2-e278-3edd-8a14-fffbca2b582b",
                        "glosses": [
                            "Dose zur Aufbewahrung von Milch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3041a04d-22c0-47b5-8036-452aa518ea66",
                                "sense_id": "9df6fdaa-f487-32d9-a230-3449e4ee05dd",
                                "text": "Gib mir mal die Milchdose, sagte die Schwester in der Küche."
                            },
                            {
                                "example_id": "fc3f35f2-c41a-4ec4-a4e9-216889b8a6ad",
                                "sense_id": "9df6fdaa-f487-32d9-a230-3449e4ee05dd",
                                "text": "Wir entfernen das Papier von einer leeren Milchdose."
                            },
                            {
                                "example_id": "f313c0df-a3f7-4b85-8274-ffd97bca27c9",
                                "sense_id": "9df6fdaa-f487-32d9-a230-3449e4ee05dd",
                                "text": "[…] die Wandstärke der Milchdose hat in den vergangenen fünf Jahren beispielsweise von 0,22 auf 0,18 Millimeter abgenommen, die Rumpfstärke der Getränkedose hat sich in wenigen Jahren von 0,25 auf 0,16 Millimeter verringert."
                            },
                            {
                                "example_id": "b011757e-edff-4736-881c-d35bbe3499a3",
                                "sense_id": "9df6fdaa-f487-32d9-a230-3449e4ee05dd",
                                "text": "„Eine nicht mehr produzierte Art von Dosenlochern bestand ebenfalls aus Metall: Unter einer Metallplatte war ein Dorn, der mit der flachen Hand in die Milchdose gedrückt oder geschlagen werden konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
