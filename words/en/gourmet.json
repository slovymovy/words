{
    "word_family": [
        "gourmand",
        "gourmandize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2ecb1d1d-f78a-3439-bd58-d04af47ada12",
                    "sense_definition": "Of high quality and sophisticated, especially in relation to food and drink.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to go to the <w>gourmet</w> grocery store to get the exotic ingredients for this recipe.",
                            "target_lang_translations": {
                                "ru": "Нам нужно пойти в <w>гурманский</w> продуктовый магазин, чтобы купить экзотические ингредиенты для этого рецепта."
                            }
                        },
                        {
                            "text": "The restaurant offered <w>gourmet</w> coffee and cigars after the meal.",
                            "target_lang_translations": {
                                "ru": "После трапезы ресторан предложил <w>изысканный</w> кофе и сигары."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gourmet coffee",
                        "gourmet meal",
                        "gourmet kitchen",
                        "gourmet food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокого качества и изысканный, особенно в отношении еды и напитков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гурманский",
                                "target_lang_sense_clarification": "относящийся к изысканной еде"
                            },
                            {
                                "target_lang_word": "изысканный",
                                "target_lang_sense_clarification": "высокого качества и утонченный"
                            },
                            {
                                "target_lang_word": "деликатесный",
                                "target_lang_sense_clarification": "о редких и вкусных продуктах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f0c8fff-5e43-35ca-958e-70807c0838f5",
                    "sense_definition": "A person who is a connoisseur of good food and drink.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a true <w>gourmet</w>, he traveled across Europe just to visit the best restaurants.",
                            "target_lang_translations": {
                                "ru": "Как истинный <w>гурман</w>, он объездил всю Европу только ради того, чтобы посетить лучшие рестораны."
                            }
                        },
                        {
                            "text": "The local <w>gourmet</w> enjoyed tasting the rare cheeses at the market.",
                            "target_lang_translations": {
                                "ru": "Местный <w>гурман</w> с удовольствием дегустировал редкие сыры на рынке."
                            }
                        }
                    ],
                    "synonyms": [
                        "foodie",
                        "gourmand"
                    ],
                    "common_phrases": [
                        "true gourmet",
                        "local gourmet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который является знатоком и ценителем хорошей еды и напитков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гурман",
                                "target_lang_sense_clarification": "ценитель тонких блюд"
                            },
                            {
                                "target_lang_word": "гастроном",
                                "target_lang_sense_clarification": "знаток кулинарного искусства"
                            },
                            {
                                "target_lang_word": "лакомка",
                                "target_lang_sense_clarification": "любитель вкусной еды"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}