                    {
                        "sense_id": "ec77a8ff-61bc-3d53-b4c1-004677ad0cd7",
                        "entry_id": "32e1377c-3560-3b2d-b80d-6ee49e2aac45",
                        "glosses": [
                            "Initialism of parental guidance: suitable for viewing, reading, or listening, by minors."
                        ],
                        "tags": [
                            "abbreviation",
