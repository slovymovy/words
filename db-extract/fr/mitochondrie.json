        "fr-extract.jsonl": [
            {
                "entry_id": "c4f29241-667d-3280-83e7-e93b702c6b72",
                "word": "mitochondrie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2ba5b486-5d01-4756-8efe-f956b1dc26db",
                        "entry_id": "c4f29241-667d-3280-83e7-e93b702c6b72",
                        "tags": [
                            "plural"
                        ],
                        "form": "mitochondries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c167b4e-da07-3f42-8613-edaf8e4b8942",
                        "entry_id": "c4f29241-667d-3280-83e7-e93b702c6b72",
                        "glosses": [
                            "Structure intracellulaire endosymbiote (ou organite), ayant pour fonction de récupérer l’énergie fournie par les molécules organiques, puis de la convertir sous forme d’ATP, et qui constitue donc la source principale d'énergie pour la cellule, par le processus de phosphorylation oxydative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ed83095-db6d-4050-91e2-3b89def36bf7",
                                "sense_id": "1c167b4e-da07-3f42-8613-edaf8e4b8942",
                                "text": "L’utilisation de l’oxygène et la production d’ATP pour la contraction musculaire dépendent aussi du nombre et de l’activité des mitochondries."
                            },
                            {
                                "example_id": "50730dbd-db9c-41da-8dcf-ba38369bc21d",
                                "sense_id": "1c167b4e-da07-3f42-8613-edaf8e4b8942",
                                "text": "Les carnitines aident au transport des acides gras à longue chaîne du cytoplasme aux mitochondries, ce qui peut augmenter la production d'énergie dans les cellules et combattre la fatigue."
                            },
                            {
                                "example_id": "0b87b084-708d-490c-a364-3e92b118eafc",
                                "sense_id": "1c167b4e-da07-3f42-8613-edaf8e4b8942",
                                "text": "La mitochondrie, un ancien organisme désormais intégré à nos cellules pour leur fournir l’énergie nécessaire, est identique à la chlorophylle, un plaste impliqué dans la photosynthèse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60ceba53-7365-4eb4-a51d-ebfc3f9858f9",
                        "source_entry_id": "c4f29241-667d-3280-83e7-e93b702c6b72",
                        "source_sense_id": "1c167b4e-da07-3f42-8613-edaf8e4b8942",
                        "source_sense_description": "Organite du cytoplasme",
                        "target_lang_word": "Mitochondrium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitochondrium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e95d745e-a832-3b78-8f0a-703520cdfefd",
                                        "entry_id": "9af2edc8-2d43-399b-8940-c288617b7d95",
                                        "glosses": [
                                            "der Atmung und dem Stoffwechsel dienender Zellbestandteil der höheren Lebewesen (Eukaryoten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bdd4d9a-8f01-41e2-9f80-847e92071b22",
                                                "sense_id": "e95d745e-a832-3b78-8f0a-703520cdfefd",
                                                "text": "Das Mitochondrium ist von einer Doppelmembran umhüllt."
                                            },
                                            {
                                                "example_id": "fed95178-a7c6-4471-a775-e035915eb6f4",
                                                "sense_id": "e95d745e-a832-3b78-8f0a-703520cdfefd",
                                                "text": "Mitochondrien werden auch als »Kraftwerke« der Zelle bezeichnet."
                                            },
                                            {
                                                "example_id": "4a7fd9f4-daa7-445f-96b5-e67007641e2c",
                                                "sense_id": "e95d745e-a832-3b78-8f0a-703520cdfefd",
                                                "text": "Die Mitochondrien enthalten DNA."
                                            },
                                            {
                                                "example_id": "0499475f-2cd7-4515-a848-4dc91fdc1925",
                                                "sense_id": "e95d745e-a832-3b78-8f0a-703520cdfefd",
                                                "text": "„Urbauer und seine Kollegen analysierten insbesondere, welchen Einfluss die Mitochondrien auf die Funktion des Darmepithels haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
