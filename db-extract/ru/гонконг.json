                                        "entry_id": "f4ed98e9-2119-3d1e-a24a-549d9ea58571",
                                        "glosses": [
                                            "eine Metropole und Sonderverwaltungszone im Süden Chinas mit gut 7 Millionen Einwohnern"
                                        ],
                                        "tags": [],
