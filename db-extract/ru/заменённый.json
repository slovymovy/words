                "senses": [
                    {
                        "sense_id": "536e94bc-73be-33d8-9c98-953f48325295",
                        "entry_id": "866f808c-a8cb-32c2-b77e-d265a5326ff7",
                        "glosses": [
                            "страд. прич. прош. вр. от заменить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "bbaa92f3-0d8c-4712-90ae-c8e3594709be",
                                "sense_id": "536e94bc-73be-33d8-9c98-953f48325295",
                                "text": "Вскоре приговор трём последним был заменён вечным заключением; наконец дарована им свобода."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a98f4cd-3dde-33c6-9ef2-4b0088e6f040",
                        "entry_id": "866f808c-a8cb-32c2-b77e-d265a5326ff7",
                        "glosses": [
                            "адъектив. выданный или полученный взамен другого"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65a3d729-54c5-4f91-aa69-01f065b69a51",
                                "sense_id": "0a98f4cd-3dde-33c6-9ef2-4b0088e6f040",
                                "text": "Следует с подозрениями относиться к тем автомобилям, у которых имеется заменённый паспорт транспортного средства, выданный взамен утерянного ранее, причём особенно это касается новых автомобилей."
                            }
                        ]
                    }
