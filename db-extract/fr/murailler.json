                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c65dd2d-89f4-3893-a63c-ef9a18f314f2",
                        "entry_id": "cfda58f5-2f61-3849-9485-679088eb150a",
                        "glosses": [
                            "Artisan dont le métier consiste à bâtir en pierre sèche, à édifier ou restaurer des éléments de construction en pierre sèche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8083501-1410-41e6-b220-0d724e192805",
                                "sense_id": "5c65dd2d-89f4-3893-a63c-ef9a18f314f2",
                                "text": "Le murailler - qui lui-même se dit plutôt paysan-bâtisseur – nous en raconte la constitution et l’ancien usage avant de mettre les élèves au travail : il veut leur faire reconstruire une clôture lithique, énorme et large mur à demi éboulé et mangé par la mousse."
                            },
                            {
                                "example_id": "f8606918-1d42-429d-bab5-4ff95ef3d535",
                                "sense_id": "5c65dd2d-89f4-3893-a63c-ef9a18f314f2",
                                "text": "Pour former un murailler professionnel, il faut deux ans. Et, le basalte, c’est plus compliqué à travailler que le calcaire », précise l’artisan."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
