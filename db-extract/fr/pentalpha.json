                "senses": [
                    {
                        "sense_id": "956be546-454f-3972-a99d-187129340eed",
                        "entry_id": "a244b54b-93c0-31b9-9dc8-0f0fb643a183",
                        "glosses": [
                            "Pentagramme composé de cinq alphas superposés à différents angles de rotation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f98a9a3c-77b4-4fbf-860a-f7fb17fbb7fc",
                                "sense_id": "956be546-454f-3972-a99d-187129340eed",
                                "text": "Au centre du sceau, on voit une grande étoile à cinq pointes, le pentalpha, connu chez les Juifs et les musulmans sous le nom de signe de Salomon."
                            },
                            {
                                "example_id": "599d1667-ddd6-4c73-97f8-e81d15d33c89",
                                "sense_id": "956be546-454f-3972-a99d-187129340eed",
                                "text": "Le pentalpha signifie que le propriétaire du sceau est fils de Salomon."
                            },
                            {
                                "example_id": "874368d7-0db3-4b07-8323-1934bea73c49",
                                "sense_id": "956be546-454f-3972-a99d-187129340eed",
                                "text": "Le pentagramme mystique, ou pentalpha, est l'emblème secret et signe de reconnaissance chez les pythagoriciens."
                            },
                            {
                                "example_id": "497e09a4-e188-4882-b730-20900b42fe78",
                                "sense_id": "956be546-454f-3972-a99d-187129340eed",
                                "text": "Aucune de ces désignations ne peut-être appliquée d’une façon correcte à l’étoile à cinq branches, le pentalpha ou pentagramme des pythagoriciens, lequel est l’étoile flamboyante maçonnique."
                            }
                        ]
                    }
                ],
