{
    "word_family": [
        "ailleurs"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e7ed8b80-8c87-3c5f-888f-692cdeb1df8f",
                    "sense_definition": "Sert à introduire un argument supplémentaire, une justification ou une précision pour appuyer ce qui précède.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "connecteur_argumentatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce restaurant est excellent et <w>d'ailleurs</w> il est complet presque tous les soirs."
                        },
                        {
                            "text": "Il n'a pas voulu venir avec nous, <w>d'ailleurs</w> il était beaucoup trop fatigué."
                        }
                    ],
                    "synonyms": [
                        "de plus",
                        "en outre",
                        "d'autre part"
                    ],
                    "common_phrases": [
                        "et d'ailleurs",
                        "comme d'ailleurs"
                    ]
                },
                {
                    "sense_id": "3d51bb71-f925-3d19-97bf-807d2c0c6908",
                    "sense_definition": "Sert à introduire une remarque incidente ou à faire une brève digression.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "connecteur_argumentatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai croisé ton frère hier au marché, <w>d'ailleurs</w> il te passe le bonjour."
                        },
                        {
                            "text": "Nous devons organiser la réunion de demain, <w>d'ailleurs</w> as-tu reçu les documents ?"
                        }
                    ],
                    "synonyms": [
                        "à propos",
                        "au fait"
                    ]
                },
                {
                    "sense_id": "163a2d5c-bace-3d13-a263-56858ff184f0",
                    "sense_definition": "D'un autre endroit géographique ou d'un autre lieu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette coutume ne vient pas de notre région, elle provient <w>d'ailleurs</w>."
                        },
                        {
                            "text": "Les épices utilisées dans ce plat traditionnel viennent <w>d'ailleurs</w>."
                        }
                    ],
                    "common_phrases": [
                        "venir d'ailleurs"
                    ]
                },
                {
                    "sense_id": "22074e99-58fb-3a21-92c9-11d132c4cd87",
                    "sense_definition": "D'une autre cause ou pour un autre motif.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "causalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne cherchez pas la cause dans cet incident mineur, son ressentiment vient <w>d'ailleurs</w>."
                        },
                        {
                            "text": "Le problème ne vient pas de cette décision récente, la crise provient <w>d'ailleurs</w>."
                        }
                    ]
                }
            ]
        }
    ]
}