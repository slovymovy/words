                    {
                        "sense_id": "8c2fc8cf-1ccd-333a-955b-1dd1110dc85a",
                        "entry_id": "9ba9ca1d-f5cf-3a31-bbb6-8877be3e6dc6",
                        "glosses": [
                            "Reine d’Égypte : épouse d’un pharaon."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "1f6ab665-99c1-477f-9f2d-e613b5e0d9d3",
                                "sense_id": "8c2fc8cf-1ccd-333a-955b-1dd1110dc85a",
                                "text": "Et la pharaonne superbe\nÉtait contente chez Amos\nSi la roche offrait un peu d’herbe\nAux longues lèvres des chameaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "25b5d832-b7ee-3efb-9d83-cabc7eaa462e",
                        "entry_id": "9ba9ca1d-f5cf-3a31-bbb6-8877be3e6dc6",
                        "glosses": [
                            "Reine d’Égypte : souveraine de l’Égypte antique."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "41ead288-896f-420a-9bbd-d74f797527ef",
                                "sense_id": "25b5d832-b7ee-3efb-9d83-cabc7eaa462e",
                                "text": "Pommettes hautes, Victoire, pharaonne de trente ans, déjoue la sagesse des modèles avec une désinvolture naturelle !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "beb33e1f-a7d1-46f6-a8d7-2ac4d7643a31",
                        "source_entry_id": "9ba9ca1d-f5cf-3a31-bbb6-8877be3e6dc6",
                        "target_lang_word": "Pharaonin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pharaonin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "806e478c-1816-33c7-8488-2e8f702ad292",
                                        "entry_id": "1d64b993-b295-3de1-8f07-f0fc3bc99aed",
                                        "glosses": [
                                            "Herrscherin im alten Ägypten"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3a5c2dd-5745-420e-b8d1-7717ae77ac08",
                                                "sense_id": "806e478c-1816-33c7-8488-2e8f702ad292",
                                                "text": "Die Pharaonin ließ eine Pyramide errichten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f219a6b1-3985-4723-abf2-e0f073e53036",
                        "source_entry_id": "9ba9ca1d-f5cf-3a31-bbb6-8877be3e6dc6",
                        "target_lang_word": "pharaohess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pharaohess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                        "entry_id": "2abede7a-1e6e-33c4-9a9b-c0cf95c69a1a",
                                        "glosses": [
                                            "A female pharaoh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f4ddeda-5b2d-4708-b805-c8edb0036dbc",
                                                "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                                "text": "[The priests decided] to pay everlasting honours to the Pharaohess Berenice, / the daughter of the Gods, the Well-doers, in all the temples of Egypt."
                                            },
                                            {
                                                "example_id": "b70fbf1f-742c-4fe9-b88e-8951bd76b11f",
                                                "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                                "text": "Writer-Director Joseph L. Mankiewicz (All About Eve) announced that his version of Cleopatra, which stars Elizabeth Taylor (naturally; who is Pharaohess of them all?), would be considerably different from Shaw’s Caesar and Cleopatra."
                                            },
                                            {
                                                "example_id": "aec99c8b-f0c2-45ac-92fd-2bf3f6f4239f",
                                                "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                                "text": "Here, too, are the same associations of old and new as, in “the sole irrhythm,” he describes his woman’s long neck and proud nose as “the way i always wanted/that pharaohess to me / to be hawk boned,” and then is ashamed “at what my god has done / to dam and hurt this nile.”"
                                            },
                                            {
                                                "example_id": "493ac340-08e7-4f99-bd44-2d174d30e5a3",
                                                "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                                "text": "Later that night, she visited me in my quarters with an urgent—and I might add, laudatory—message from the Pharaohess Herself."
                                            },
                                            {
                                                "example_id": "31fac68b-5319-4ddf-9641-828b6c7f85a8",
                                                "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                                "text": "Ashteshyt, whose name may be derived from the Egyptian name of Isis, Aset, agrees to disguise herself as a man and go to reconnoiter the enemy camp. Based on Ashteshyt’s information, the pharaohess decides to attack. She again invokes Isis to help her and orders her people to make preparations for the attack."
                                            },
                                            {
                                                "example_id": "7a442200-6c3e-4497-8791-883b497558a1",
                                                "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                                "text": "And the symbol of the Pyramid, adapted by the Illuminati, is NOT a symbol of Democracy for slaves, required to construct Pyramids for monetary Pharaohs and Pharaohesses who rule over many lands."
                                            },
                                            {
                                                "example_id": "37ecc170-063d-4f4d-a551-263aedd692d0",
                                                "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                                "text": "All the women you cite / > were operating within, and had to employ the methods of, patriarchic / > systems. / > / > / > / Oh. Is that why were like that? The Pharaohess of Egypt was working within a patriarchy? And the Queen of France? Kirk to Enterprise, please respond...Earth is calling..."
                                            },
                                            {
                                                "example_id": "3842a772-a8eb-484b-a0ea-27a0bb435e33",
                                                "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                                "text": "A three-foot-high pharaoh and pharaohess were watching the work from underneath a baldachin."
                                            },
                                            {
                                                "example_id": "a6f17844-9765-432a-8b99-d41cf5b2a0f3",
                                                "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                                "text": "This story survives in a much damaged text of the Graeco-Roman period and presents us with the spectacle of Prince Pedikhons embarking on a great campaign into Syria with an army made up of Egyptians and Assyrians. Here his great enemy is Queen Serpot, the ‘Pharaohess’ (so the Egyptian!) of the Land of Women, i.e. she is Queen of the Amazons."
                                            },
                                            {
                                                "example_id": "41a2519a-32cb-4f63-aa86-573ba857ba71",
                                                "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                                "text": "Nadezhda Osipovna’s singing reminded Vasily Lvovich of the husky songs of gypsies and swarthy pharaohesses, not the songs of fair ladies, and pleased him greatly."
                                            },
                                            {
                                                "example_id": "90019ddc-085a-45ce-965c-f3ad5916a980",
                                                "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                                "text": "I was so wrapped up in this scene: A pharaohess had to shun her lover, and she stood at the top of a thousand steps. I was watching her all the way from the bottom step."
                                            },
                                            {
                                                "example_id": "ff0c130c-513c-45a9-8c04-0cf0fca4e375",
                                                "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                                "text": "“Ooh, check this out, he looks at the Pharaohs as sons and Pharaohesses as daughters. So he looks at Ramses as being a wayward son, and sending him to limbo is like he’s sending Ramses to his room and grounding him even if he was turned against his will or something...” […] “[…] We’ve found everything we need to know, so the combatant we need to look for is a Good Pharaoh, if there is one.” / “What about a Pharaohess?” / “I don’t know either a Pharaoh or Pharaohess will do.”"
                                            },
                                            {
                                                "example_id": "acb01252-ff28-4e72-b754-92aecd5c42c1",
                                                "sense_id": "c11a14d6-3dab-305f-a01b-129805429a2d",
                                                "text": "“What I don’t see is,” he said, “why we had to go through all this rigmarole with you dressing up as a pantomime lioness and changing clothes and everything. You’ve already stood in for the Egyptian queen more than once, so you say, so why couldn’t you just put on your Pharaohess outfit and we could saunter down here and take our seats by ourselves? Then Theonoe needn’t have been involved, and it would all have been much less complicated and much safer.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b4bc066-170d-37ee-b1c5-d361bae1f790",
                                        "entry_id": "2abede7a-1e6e-33c4-9a9b-c0cf95c69a1a",
                                        "glosses": [
                                            "The wife of a pharaoh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efe97b22-c0ac-4a5d-b5ad-74c53255ba9d",
                                                "sense_id": "1b4bc066-170d-37ee-b1c5-d361bae1f790",
                                                "text": "Balancing four boxes on her head, she mounted the stairs, telling herself that she was a slave-girl in ancient Egypt carrying stone blocks for the great pyramid. When she reached the first floor she removed both the wrap and the sandals to add authentic local colour and so that she was a genuine naked Nubian slave-girl whose slinky walk quickened the blood of the Pharaoh, who, encountered by chance on the landing, promptly asked her to be his fair Pharaohess and Queen of Upper and Lower Egypt."
                                            },
                                            {
                                                "example_id": "be75a6a6-f4f5-409e-ba0d-bddb848828f1",
                                                "sense_id": "1b4bc066-170d-37ee-b1c5-d361bae1f790",
                                                "text": "“Unless you want to be his new bride by tomorrow, Ashley Porter, we’re outta here! And soon, kiddo, or you’ll be the latest Pharaohess! Mrs. Tutankhamun by morning.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
