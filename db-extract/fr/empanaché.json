                    }
                ],
                "senses": [
                    {
                        "sense_id": "24f87e79-0bd2-3b5a-b1a7-849544f26cef",
                        "entry_id": "9c08a354-cdf8-38a8-9de1-85f4d83c4806",
                        "glosses": [
                            "Garni d’un panache."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea129f5a-ab14-4a8f-a31d-257d3aacfa60",
                                "sense_id": "24f87e79-0bd2-3b5a-b1a7-849544f26cef",
                                "text": "Une tête empanachée\n N’est pas petit embarras."
                            },
                            {
                                "example_id": "ca270adb-d38c-4cf7-95e3-342fee53a84e",
                                "sense_id": "24f87e79-0bd2-3b5a-b1a7-849544f26cef",
                                "text": "À l’un des côtés de la selle pendait une courte hache […] ; à l’autre, le casque empanaché du cavalier avec un capuchon de mailles, et une de ces épées à deux mains dont se servaient les chevaliers à cette époque."
                            },
                            {
                                "example_id": "7fcb44ca-3d3d-4c72-a946-bff7c744e897",
                                "sense_id": "24f87e79-0bd2-3b5a-b1a7-849544f26cef",
                                "text": "On voyait d’un côté un lit doré, chargé d’un dais de tapisseries, empanaché de plumes, couvert de dentelles et d’ornements."
                            },
                            {
                                "example_id": "fb948212-09f9-4ff2-bfd9-d4b65fae6704",
                                "sense_id": "24f87e79-0bd2-3b5a-b1a7-849544f26cef",
                                "text": "Te voilà ravi d’être empanaché de vert."
                            },
                            {
                                "example_id": "1e96ea81-f2b2-4b1c-9ca8-a10bcb6d27c6",
                                "sense_id": "24f87e79-0bd2-3b5a-b1a7-849544f26cef",
                                "text": "Adolescent, je me souviens d'avoir aperçu, dans une salle étouffante d'assises, livrée aux avocats moins féroces que les dames empanachées, ta petite figure blanche et sans lèvres."
                            },
                            {
                                "example_id": "3b0e305c-c876-4bd7-8a40-15a27dffc29a",
                                "sense_id": "24f87e79-0bd2-3b5a-b1a7-849544f26cef",
                                "text": "Le rayon de la lanterne s’arrêta sur une carte ancienne, empanachée d’étranges lettres bouclées."
                            },
                            {
                                "example_id": "52e762d9-e601-40a2-94b0-bc59e2d89d88",
                                "sense_id": "24f87e79-0bd2-3b5a-b1a7-849544f26cef",
                                "text": "Des nuées compactes d’oiseaux de mer, jaillissant en flèche, puis se rabattant en volutes molles sur la roche, lui faisaient comme la respiration empanachée d’un geyser."
                            },
                            {
                                "example_id": "4a3c8769-b937-4aec-b10f-ee189888fe91",
                                "sense_id": "24f87e79-0bd2-3b5a-b1a7-849544f26cef",
                                "text": "Sur les photos de famille prises l’été suivant, on voit de jeunes dames en robes longues, aux chapeaux empanachés de plumes d’autruche, des messieurs coiffés de canotiers et de panamas qui sourient à un bébé : ce sont mes parents, mon grand-père, des oncles, des tantes, et c’est moi."
                            }
                        ]
                    }
