                    {
                        "translation_id": "2aeff0e1-343c-4693-9f15-2b1b51236f51",
                        "source_entry_id": "1ed117ad-0aaf-3ee6-8269-6dea748eafd5",
                        "source_sense_id": "a2b2d345-8102-3922-8d81-f35c3caf7805",
