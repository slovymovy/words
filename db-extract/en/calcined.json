                    },
                    {
                        "sense_id": "d806c584-9e14-3a12-92e3-dd80c92e171c",
                        "entry_id": "4b044a57-ddb7-383d-93d7-8169c8f373b9",
                        "glosses": [
                            "Purified, refined."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "06e6e6ec-886d-4881-81c7-cf053fac9aea",
                                "sense_id": "d806c584-9e14-3a12-92e3-dd80c92e171c",
                                "text": "[A]n ingenious man, who is ever on the watch for conquest, will, in his eagerness to exhibit his whole store of knowledge, furnish an attentive observer with some useful information, calcined by fancy and formed by taste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce2a7fba-cb5b-45b8-8941-5bfd6c4cf35c",
                        "source_entry_id": "4b044a57-ddb7-383d-93d7-8169c8f373b9",
                        "source_sense_description": "converted by calcination",
                        "target_lang_word": "calciné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calciné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66ec8e48-c5f1-3176-b942-43d496fb9c37",
                                        "entry_id": "7302223d-0890-3258-86fc-806a6f76b711",
                                        "glosses": [
                                            "Qui a été brûlé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68d5443d-5d09-4d78-aa31-58da480171bd",
                                                "sense_id": "66ec8e48-c5f1-3176-b942-43d496fb9c37",
                                                "text": "Le regard séducteur, plus pénétrant, plus envenimé que la dent de la vipère, va incendier votre sang et faire bouillir la moelle dans vos os calcinés."
                                            },
                                            {
                                                "example_id": "7b8a7f59-dc78-4e57-ae22-9b0a64f5e60c",
                                                "sense_id": "66ec8e48-c5f1-3176-b942-43d496fb9c37",
                                                "text": "… alors on retira des sous-résidus de l'échardonnage brins de laine que l'on appelle à Viviers des ploquettes brûlées et on vendit à l'agriculture le résidu calciné du traitement chimique."
                                            },
                                            {
                                                "example_id": "f60dc254-ccff-41d5-b63d-fb2d4e89a589",
                                                "sense_id": "66ec8e48-c5f1-3176-b942-43d496fb9c37",
                                                "text": "Près de dix jours après la disparition de la jeune Héléna Cluyou, à Brest, un corps calciné a été retrouvé en pleine forêt à Argol (Finistère)."
                                            },
                                            {
                                                "example_id": "b963e04e-6013-49e5-8695-ca740f24b3c6",
                                                "sense_id": "66ec8e48-c5f1-3176-b942-43d496fb9c37",
                                                "text": "Sur le calcaire nummulitique, calciné et désagrégé, formant le sol de la grotte, gisait un squelette humain associé à des silex taillés."
                                            },
                                            {
                                                "example_id": "47983273-d1f0-4ce9-b487-a16dc9de9294",
                                                "sense_id": "66ec8e48-c5f1-3176-b942-43d496fb9c37",
                                                "text": "J’ai ramassé, sur des collines caillouteuses de la basse Normandie, des coquilles d’huîtres très-entières, amalgamées avec des cailloux noirs qu’on appelle bisets. Si ces bisets eussent été vitrifiés par le feu, ils eussent calciné, ou au moins altéré les écailles d’huître qui leur étaient adhérentes ; mais elles étaient aussi saines que si elles sortaient de l’eau."
                                            }
                                        ]
                                    }
                                ]
                            },
