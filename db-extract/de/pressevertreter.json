                "senses": [
                    {
                        "sense_id": "0b07d7ca-5cf9-3d00-bca8-23990741f38d",
                        "entry_id": "cf5286dc-3c8f-3c32-8f9c-c616b3cae66f",
                        "glosses": [
                            "Journalist, der eine bestimmte Zeitung oder Zeitschrift vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c5b83e1-cd0e-4363-94ce-8fe530897e5d",
                                "sense_id": "0b07d7ca-5cf9-3d00-bca8-23990741f38d",
                                "text": "„Die US-amerikanische Marine präsentiert Pressevertretern eine neu entwickelte Startmöglichkeit für Militärflugzeuge, den sog. Katapultstart.“"
                            },
                            {
                                "example_id": "b8428fe7-e0c9-4fd5-8067-68bf4be1aab9",
                                "sense_id": "0b07d7ca-5cf9-3d00-bca8-23990741f38d",
                                "text": "„Sofort fiel er einigen Pressevertretern in die Hände und konnte sich nur mühsam befreien.“"
                            },
                            {
                                "example_id": "1a50c4a1-fa20-4ab8-9c37-1f3577f6f78b",
                                "sense_id": "0b07d7ca-5cf9-3d00-bca8-23990741f38d",
                                "text": "„Doch Mugabe konnte die Demütigung nicht vergessen, da die anwesenden Pressevertreter den Vorgang aufgezeichnet und verbreitet hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
