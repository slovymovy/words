                "senses": [
                    {
                        "sense_id": "cec4aa7b-09a7-3b38-b688-933f7f86c00d",
                        "entry_id": "00e364fe-d46c-3dfe-97b1-454667fc0acf",
                        "glosses": [
                            "die Vorläufersprache Uritalisch betreffend, zu ihr gehörend, auf ihr zurückgehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a93fea-07a9-444f-bda6-2009c234d527",
                                "sense_id": "cec4aa7b-09a7-3b38-b688-933f7f86c00d",
                                "text": "„Das vorliegende Werk intendiert nicht die Darstellung einer uritalischen oder gar einer vergleichenden italischen Grammatik.“"
                            },
                            {
                                "example_id": "1534fac5-ca11-46a1-9bf6-fdb504c5d9b0",
                                "sense_id": "cec4aa7b-09a7-3b38-b688-933f7f86c00d",
                                "text": "„Conway legt die uritalische Betonung der ersten Silbe zu Grunde, so dass in der ersten Wortsilbe überall s, in den übrigen Silben r stehen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
