                ],
                "senses": [
                    {
                        "sense_id": "f796ecab-dcdb-3408-bcf0-cc342dc33bbf",
                        "entry_id": "9a31de23-1d8e-382e-aad1-df20d6374920",
                        "glosses": [
                            "Epinephrine, the hormone and neurotransmitter."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "493f3da1-141b-3d35-b48f-04a3fc951198",
                        "entry_id": "9a31de23-1d8e-382e-aad1-df20d6374920",
                        "glosses": [
                            "Excitement; thrills."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "7714f948-17c2-4c41-b83a-5450e5513190",
                                "sense_id": "493f3da1-141b-3d35-b48f-04a3fc951198",
                                "text": "Some people bungee jump to feel alive through the surge of adrenaline."
                            },
                            {
                                "example_id": "33ccbd2c-c7e8-4c65-8a54-9dc583a59188",
                                "sense_id": "493f3da1-141b-3d35-b48f-04a3fc951198",
                                "text": "May be it's not as heavy as he thought, or may be he's on adrenaline overdrive."
                            },
                            {
                                "example_id": "7ea16743-64ee-489e-b754-b2c3092d6735",
                                "sense_id": "493f3da1-141b-3d35-b48f-04a3fc951198",
                                "text": "Despite the crisis, the adrenaline that must have been feeding his own alarm, Tim managed to maintain his control and spoke in a subdued tone, assuring the tenderman and all of us that things would be okay."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d31113d-f59f-4148-a989-ba0f8845d03d",
                        "source_entry_id": "9a31de23-1d8e-382e-aad1-df20d6374920",
                        "source_sense_description": "the compound epinephrine",
                        "target_lang_word": "adrenalin",
