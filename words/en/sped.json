{
    "word_family": [
        "speed",
        "speedy",
        "speeding",
        "speedometer",
        "speedway"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "697f27a9-31b4-317f-81b1-4d2af60d3ef6",
                    "sense_definition": "simple past and past participle of <w>speed</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "speed_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car <w>sped</w> down the highway at a dangerous pace.",
                            "target_lang_translations": {
                                "ru": "Машина <w>мчалась</w> по шоссе на опасной скорости."
                            }
                        },
                        {
                            "text": "He <w>sped</w> away as soon as the light turned green.",
                            "target_lang_translations": {
                                "ru": "Он <w>умчался</w>, как только загорелся зеленый свет."
                            }
                        }
                    ],
                    "synonyms": [
                        "speeded"
                    ],
                    "common_phrases": [
                        "sped away",
                        "sped past",
                        "sped up"
                    ],
                    "target_lang_definitions": {
                        "ru": "прошедшее время и причастие прошедшего времени от глагола speed (мчаться, спешить)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мчался",
                                "target_lang_sense_clarification": "двигаться очень быстро"
                            },
                            {
                                "target_lang_word": "промчался",
                                "target_lang_sense_clarification": "быстро проехать мимо"
                            },
                            {
                                "target_lang_word": "разогнался",
                                "target_lang_sense_clarification": "увеличить скорость"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2610434-7104-39af-98ff-848978ccdf79",
                    "sense_definition": "An abbreviation for special education, referring to programs for students with learning disabilities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has been working in <w>sped</w> for over ten years now.",
                            "target_lang_translations": {
                                "ru": "Она работает в сфере <w>спецобразования</w> уже более десяти лет."
                            }
                        },
                        {
                            "text": "The school is looking for a new <w>sped</w> teacher to join the staff.",
                            "target_lang_translations": {
                                "ru": "Школа ищет нового <w>учителя коррекционных классов</w>, чтобы пополнить штат."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sped teacher",
                        "sped department",
                        "sped student"
                    ],
                    "target_lang_definitions": {
                        "ru": "аббревиатура для специального образования (special education), относящаяся к программам для учащихся с ограниченными возможностями обучения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спецобразование",
                                "target_lang_sense_clarification": "система обучения детей с особенностями"
                            },
                            {
                                "target_lang_word": "коррекционное обучение",
                                "target_lang_sense_clarification": "образовательные программы для детей с ОВЗ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8a87e97-d7e6-3bbe-8237-7679c1616ef4",
                    "sense_definition": "A student who is enrolled in a special education program.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The term <w>sped</w> is often used informally within the school system.",
                            "target_lang_translations": {
                                "ru": "Термин <w>«спец»</w> часто используется неформально внутри школьной системы."
                            }
                        },
                        {
                            "text": "He was a <w>sped</w> student who eventually graduated with honors.",
                            "target_lang_translations": {
                                "ru": "Он был <w>учеником спецкласса</w>, который в итоге закончил учебу с отличием."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used pejoratively"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ученик, зачисленный в программу специального образования (часто используется как сленг или оскорбление)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коррекционник",
                                "target_lang_sense_clarification": "ученик коррекционного класса (разг.)"
                            },
                            {
                                "target_lang_word": "спец",
                                "target_lang_sense_clarification": "сокращение от ученика спецшколы (жарг.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5db60294-2137-3332-8426-fdf26c3ff87d",
                    "sense_definition": "Acronym for the Scheme for the Purchase of Evacuated Dwellings, a housing program in Northern Ireland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "housing_scheme",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The family applied for the <w>SPED</w> scheme after their home was threatened.",
                            "target_lang_translations": {
                                "ru": "Семья подала заявку на участие в <w>программе SPED</w> после того, как их дому стала угрожать опасность."
                            }
                        },
                        {
                            "text": "Under <w>SPED</w>, the government purchases houses from people at risk of violence.",
                            "target_lang_translations": {
                                "ru": "В рамках <w>SPED</w> правительство выкупает дома у людей, находящихся под угрозой насилия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "SPED scheme"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Northern Ireland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "акроним для Схемы покупки эвакуированного жилья (SPED), жилищная программа в Северной Ирландии"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "программа SPED",
                                "target_lang_sense_clarification": "схема выкупа жилья при угрозе насилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}