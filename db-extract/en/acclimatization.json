                                                "sense_id": "dce98e2c-b51c-3363-8c66-196419846c7b",
                                                "text": "Jardin d’acclimatation, société d’acclimatation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b39e29a2-648a-394d-822f-9c47bce7875c",
                                        "entry_id": "ac52490f-3eab-3263-980a-0627dc318f20",
