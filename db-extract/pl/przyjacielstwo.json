                    }
                ],
                "translations": [
                    {
                        "translation_id": "b274d39d-cbd1-43a8-a715-6885f3dd59d6",
                        "source_entry_id": "6da9f3b1-d247-36ad-a1b3-d71990b4d259",
                        "source_sense_id": "94f2b4f8-286f-3ce8-ab4f-367e876afae0",
                        "target_lang_word": "friendship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "friendship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cc4fa89-0830-3524-9d9d-fbb6770c5216",
                                        "entry_id": "3ef95cf7-76ef-3eff-bd90-f03f8d1a04f0",
                                        "glosses": [
                                            "The condition of being friends."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a93cf79-363f-418f-aaff-2c973e7b1c40",
                                                "sense_id": "8cc4fa89-0830-3524-9d9d-fbb6770c5216",
                                                "text": "“They’re cuddling by the fire, they’re going on trips together, they’re introducing their friends to their family, but they’re very clear that those are friendships,” Stinson said. “It really makes me think about the definitions that we have about friendship and romance, and how those things differ, and I just like how messy it all is.”"
                                            },
                                            {
                                                "example_id": "188b456d-3160-486d-8bdd-232168550db7",
                                                "sense_id": "8cc4fa89-0830-3524-9d9d-fbb6770c5216",
                                                "text": "But (as the Poet ſaith) Malè ſarta gratia, nequicquam coit, & reſcinditur: Friendſhip, that is but euill peeced, will not ioine cloſe, but falleth aſunder againe:"
                                            },
                                            {
                                                "example_id": "8b82268d-f0b2-4e13-9910-9dfd23b2f838",
                                                "sense_id": "8cc4fa89-0830-3524-9d9d-fbb6770c5216",
                                                "text": "We cannot tell the precise moment when friendship is formed. As in filling a vessel drop by drop, there is at last a drop which makes it run over; so in a series of kindnesses there is at last one which makes the heart run over."
                                            },
                                            {
                                                "example_id": "97634e23-92a8-45aa-b27b-938c60d61d7c",
                                                "sense_id": "8cc4fa89-0830-3524-9d9d-fbb6770c5216",
                                                "text": "Friendship is unnecessary, like philosophy, like art, like the universe itself (for God did not need to create). It has no survival value; rather it is one of those things which give value to survival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9816bb2-9cf5-3aa7-8d25-3093f4bbed9d",
                                        "entry_id": "3ef95cf7-76ef-3eff-bd90-f03f8d1a04f0",
                                        "glosses": [
                                            "A friendly relationship, or a relationship as friends."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26bdac21-8e3d-4e2a-991f-edf31dc7ed4c",
                                                "sense_id": "b9816bb2-9cf5-3aa7-8d25-3093f4bbed9d",
                                                "text": "“They’re cuddling by the fire, they’re going on trips together, they’re introducing their friends to their family, but they’re very clear that those are friendships,” Stinson said. “It really makes me think about the definitions that we have about friendship and romance, and how those things differ, and I just like how messy it all is.”"
                                            },
                                            {
                                                "example_id": "2df5e03d-3f2b-42ff-a422-a8113ecb2733",
                                                "sense_id": "b9816bb2-9cf5-3aa7-8d25-3093f4bbed9d",
                                                "text": "In good times and bad, in sickness and health, the benefits of friendships between women are physically and psychologically undeniable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "574aeb30-0663-3f5b-8118-5f60d67e79f9",
                                        "entry_id": "3ef95cf7-76ef-3eff-bd90-f03f8d1a04f0",
                                        "glosses": [
                                            "Good will."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
