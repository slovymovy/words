                "senses": [
                    {
                        "sense_id": "644d6494-7f1d-31e7-a25c-f79c4431b04e",
                        "entry_id": "a76c028a-52a7-3fc9-a663-c2912b3ed404",
                        "glosses": [
                            "Befragung, die telefonisch durchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daef195c-4cec-4676-a3af-66841c60f37a",
                                "sense_id": "644d6494-7f1d-31e7-a25c-f79c4431b04e",
                                "text": "„Doch diese Telefonumfrage unter 1.000 Wählern war kurz vor İnces Nominierung und seinen ersten Wahlkampfauftritten am Wochenende durchgeführt worden.“"
                            },
                            {
                                "example_id": "3efc6628-ddce-4a27-9816-7c0277f325c2",
                                "sense_id": "644d6494-7f1d-31e7-a25c-f79c4431b04e",
                                "text": "„Einfach nur Hallo zu sagen, ist rund der Hälfte der Österreicher eine viel zu lahme Begrüßung, fand das Linzer Meinungsforschungsinstitut Spectra jetzt bei einer Telefonumfrage heraus.“"
                            },
                            {
                                "example_id": "27d22924-3d4d-4572-83f2-489019a61e5f",
                                "sense_id": "644d6494-7f1d-31e7-a25c-f79c4431b04e",
                                "text": "„Mit einer Telefonumfrage unter Münchnern will das Wirtschaftsreferat mehr über den Tourismus in der Stadt herausfinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
