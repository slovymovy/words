                                        "entry_id": "cd0ed5f3-203e-3f85-a05c-736db335e46a",
                                        "glosses": [
                                            "von den Augenlidern gebildeter äußerer Rand des geöffneten Auges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bddf8048-5118-41f1-a9f0-ad1ef29fdeae",
                                                "sense_id": "13f757fc-b788-3cdd-9d81-1e425fe9c2d2",
                                                "text": "„Aus den Augenwinkeln beobachtet Eos, wie sich die Kellnerin vorbeugt, ihre Arme auf die Rückenlehne von Anraths Sitz legt und ihm dabei so nahe kommt, daß der Luftzug ihres Seufzers sein Ohr streift.“"
                                            },
                                            {
                                                "example_id": "8629b920-a9b3-414c-b9a3-84b5e7d3ac77",
                                                "sense_id": "13f757fc-b788-3cdd-9d81-1e425fe9c2d2",
                                                "text": "„In ihren Augenwinkeln glitzerten zwei, drei Tränen.“"
                                            },
                                            {
                                                "example_id": "6ad5e278-7ef5-4d83-8d3b-43bcd0db4e72",
                                                "sense_id": "13f757fc-b788-3cdd-9d81-1e425fe9c2d2",
                                                "text": "„Barbara sah ihn derart mitleidig an, dass in Rudis Augenwinkel eine Träne aufglitzerte.“"
                                            },
                                            {
                                                "example_id": "7cea979d-cb6a-404a-b090-2da9c8814da1",
                                                "sense_id": "13f757fc-b788-3cdd-9d81-1e425fe9c2d2",
                                                "text": "„Aus dem Augenwinkel erkannte ich ein bärtiges Gesicht, eine petrolfarbene Uniform.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
