                    },
                    {
                        "translation_id": "545cad53-0617-4f49-9e6e-a6337b5b33c5",
                        "source_entry_id": "3cfd2a63-de13-3042-822f-b94bb18356ff",
                        "source_sense_id": "37fcc9bd-4fb2-343b-bf3e-80fea38b3e84",
                        "source_sense_description": "to make feeble; to weaken",
                        "target_lang_word": "verzwakken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verzwakken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "31ae00c1-0d43-3035-9e2b-43ac1d66ecb0",
                                        "entry_id": "01f8c6b9-d361-3bdc-be47-f8d03f19f532",
                                        "glosses": [
                                            "zwakker maken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "222ce236-1333-464c-a3a6-3b64cc8c459c",
                                                "sense_id": "31ae00c1-0d43-3035-9e2b-43ac1d66ecb0",
                                                "text": "Het weinige slapen zal hun weerstand verzwakken."
                                            },
                                            {
                                                "example_id": "3a6c1319-397b-4e22-91d0-fb0ba66a9825",
                                                "sense_id": "31ae00c1-0d43-3035-9e2b-43ac1d66ecb0",
                                                "text": "Volgens hem heeft het stadsleven veel van onze zintuigen verzwakt en door ze te reactiveren en een met de natuur te worden, zou ik voor een groot deel op mezelf moeten kunnen vertrouwen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d42d133a-dec8-3e7b-bee2-7cace37c9321",
                                        "entry_id": "01f8c6b9-d361-3bdc-be47-f8d03f19f532",
                                        "glosses": [
                                            "zwakker worden"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e2df0f4-22c3-4bcb-a5f8-3590e1282527",
                                                "sense_id": "d42d133a-dec8-3e7b-bee2-7cace37c9321",
                                                "text": "Zij verzwakken door een tekort aan slaap."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "288c6ec0-3433-438a-b8a5-9505b7e9fc1b",
                        "source_entry_id": "3cfd2a63-de13-3042-822f-b94bb18356ff",
                        "source_sense_id": "37fcc9bd-4fb2-343b-bf3e-80fea38b3e84",
                        "source_sense_description": "to make feeble; to weaken",
                        "target_lang_word": "débiliter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débiliter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30167644-ed61-3ada-a330-26a9865b7d3a",
                                        "entry_id": "e2542c0c-35c4-32d4-b64d-44f2e85bd2be",
                                        "glosses": [
                                            "Rendre faible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1801cb01-f3d0-43a8-873d-2c30db376f5c",
                                                "sense_id": "30167644-ed61-3ada-a330-26a9865b7d3a",
                                                "text": "Vantez l’art avec lequel des femmes renommées par leur beauté ont su la conserver en se baignant, plusieurs fois par jour, dans du lait, ou des eaux composées de substances propres à rendre la peau plus douce, en débilitant le système nerveux."
                                            },
                                            {
                                                "example_id": "fa44f02d-1cb9-4851-9edc-fc6a816c47b8",
                                                "sense_id": "30167644-ed61-3ada-a330-26a9865b7d3a",
                                                "text": "Ah ! pourquoi ces doutes et ces craintes sans doute imaginaires qui lui débilitaient le sang et jetaient une ombre sur son bonheur ?"
                                            },
                                            {
                                                "example_id": "7eb4bbf7-c371-4035-9d4a-1c6c7f7cf8cc",
                                                "sense_id": "30167644-ed61-3ada-a330-26a9865b7d3a",
                                                "text": "Au lieu de me stimuler comme l’année passée, nos conversations me débilitaient. J’aimais mieux penser à lui, à distance, que me trouver en face de lui."
                                            },
                                            {
                                                "example_id": "c11aaa37-8961-40e7-8b53-fa491649bea8",
                                                "sense_id": "30167644-ed61-3ada-a330-26a9865b7d3a",
                                                "text": "Faites une France très forte, et nul n’osera jamais convoiter ses colonies. Laissez la France se débiliter davantage et son empire colonial, d’une manière ou d’une autre, s’écroulera."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b26443ba-b34b-4617-b3cd-2203cb06af56",
                        "source_entry_id": "3cfd2a63-de13-3042-822f-b94bb18356ff",
                        "source_sense_id": "37fcc9bd-4fb2-343b-bf3e-80fea38b3e84",
