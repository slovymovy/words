                "senses": [
                    {
                        "sense_id": "59983f7f-4a2c-3303-9a4b-967f992fd3ed",
                        "entry_id": "e2d0f0ee-6fca-3b8c-8356-9cb0c04384c3",
                        "glosses": [
                            "een hoge rang op de sociale ladder innemend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "757bddbc-b4ec-4349-a5ae-5404e0dfa0bb",
                                "sense_id": "59983f7f-4a2c-3303-9a4b-967f992fd3ed",
                                "text": "Omdat er hooggeplaatste mensen bij betrokken waren, is de zaak verzwegen."
                            },
                            {
                                "example_id": "6b2a2d06-4495-488b-bfc9-925432d4d388",
                                "sense_id": "59983f7f-4a2c-3303-9a4b-967f992fd3ed",
                                "text": "Het vertrek van een reeks hooggeplaatste functionarissen werd op 5 juli ingeluid door minister van Financiën Rishi Sunak en gezondheidsminister Sajid Javid. Het tweetal uitte bij hun vertrek felle kritiek op Johnson. Ze schreven in een verklaring dat de overheid geen \"goed, competent en serieus werk\" verricht."
                            }
                        ]
                    }
