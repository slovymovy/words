                "senses": [
                    {
                        "sense_id": "62a3e88d-00ec-3fa8-b5e7-77b6600b1225",
                        "entry_id": "32d41639-432f-306e-a05f-6096d46427a1",
                        "glosses": [
                            "Kurve, die die Beziehung zwischen Abfluss und Wasserstand feststellt"
                        ],
                        "tags": [
                            "Hydrologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d39f027b-5635-4625-a0b4-add33d144791",
                                "sense_id": "62a3e88d-00ec-3fa8-b5e7-77b6600b1225",
                                "text": "„Bei sich ständig änderndem Gewässerzustand, wie z.B. häufigen Änderungen der Gerinnehydraulik kann meist keine über einen längeren Zeitraum gültige Abflusskurve aufgestellt werden.“"
                            },
                            {
                                "example_id": "39059b90-6b2f-408e-a20f-dd95260739f7",
                                "sense_id": "62a3e88d-00ec-3fa8-b5e7-77b6600b1225",
                                "text": "„Obwohl die wissenschaftliche Definition der Abflusskurve festgelegt ist, wird in der Literatur teilweise missverständlicherweise auch eine Abfluss-Zeit-Kurve als Abflusskurve bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
