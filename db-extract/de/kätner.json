                                    {
                                        "sense_id": "db00faa4-84fa-3e77-9dae-399f7a61f80c",
                                        "entry_id": "affd3d6a-0a13-3453-bf19-187cfc591329",
                                        "glosses": [
                                            "A person who has the tenure of a cottage, usually also the occupant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f32f56-7f06-4b32-a7b5-e2606d56897b",
                                                "sense_id": "db00faa4-84fa-3e77-9dae-399f7a61f80c",
                                                "text": "The silver hair and benevolent countenance of the aged cottager, won my reverence; while the gentle manners of the girl enticed my love."
                                            },
                                            {
                                                "example_id": "cf51313c-e7fe-4626-93a6-ce11594c0c25",
                                                "sense_id": "db00faa4-84fa-3e77-9dae-399f7a61f80c",
                                                "text": "A cottager, I mark’d a throne\nOf half the world as all my own,\nAnd murmur’d at such lowly lot!"
                                            },
                                            {
                                                "example_id": "5388f680-7289-4961-b3d3-84d6718c19ba",
                                                "sense_id": "db00faa4-84fa-3e77-9dae-399f7a61f80c",
                                                "text": "I don't like shoppy people. I think we are far better off, knowing only cottagers and labourers, and people without pretence."
                                            }
                                        ]
                                    }
                                ]
                            },
