                "senses": [
                    {
                        "sense_id": "dcee8751-9988-3bc7-94e7-ad41d70c46a3",
                        "entry_id": "1b966266-0443-33a4-85b5-9afc758a8e9c",
                        "glosses": [
                            "Vertreter einer Ordnung ausgestorbener Kopffüßer (Belemnoidea)"
                        ],
                        "tags": [
                            "Paläontologie"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c538d2da-1967-3c1a-a8b6-96a80cd4a298",
                        "entry_id": "1b966266-0443-33a4-85b5-9afc758a8e9c",
                        "glosses": [
