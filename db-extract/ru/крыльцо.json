                            "porch, stoop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cc544a3-66a8-445f-a033-157d11b420d0",
                                "sense_id": "9ece75b8-c28f-3425-9596-ed5eec8bde26",
                                "text": "Четверть часа спустя оба экипажа остановились перед крыльцом нового деревянного дома, выкрашенного серою краской и покрытого железною красною крышей.",
                                "translation": "A quarter of an hour later both carriages drew up in front of the porch of a new wooden house, painted grey, with a red iron roof.",
                                "english": "A quarter of an hour later both carriages drew up in front of the porch of a new wooden house, painted grey, with a red iron roof."
                            }
                        ]
                    }
                ],
