                    {
                        "sense_id": "4f4f45bc-2f6f-35db-bf10-1fcb28d034d2",
                        "entry_id": "0d451010-0980-3d7e-b38c-64584b364286",
                        "glosses": [
                            "Caractère, goût de ce qui est européen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d6de8cd-a5b2-4ccf-8557-938888674176",
                                "sense_id": "4f4f45bc-2f6f-35db-bf10-1fcb28d034d2",
                                "text": "Je penchais pour vous par européanisme."
                            },
                            {
                                "example_id": "791f274c-d023-458c-935f-24794b191dc4",
                                "sense_id": "4f4f45bc-2f6f-35db-bf10-1fcb28d034d2",
                                "text": "L’européanisme, terme qu’il empruntait sans lui donner la signification commune, avait pour lui une acception non politique, strictement culturelle : il s’agissait uniquement de relations individuelles entre écrivains et intellectuels."
                            }
                        ]
                    },
                    {
                        "sense_id": "f05f2d33-a375-3e53-ba93-eaba98d2e2ae",
                        "entry_id": "0d451010-0980-3d7e-b38c-64584b364286",
                        "glosses": [
                            "Mot ou locution emprunté à une langue européenne et utilisé dans une autre langue non européenne, sans être encore bien intégré dans le vocabulaire de celle-ci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2679a981-aef3-4568-9b25-8373de1c912d",
                                "sense_id": "f05f2d33-a375-3e53-ba93-eaba98d2e2ae",
                                "text": "Les traducteurs d’ouvrages européens se garantissent difficilement des européanismes."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c2070f9-5256-3a00-a4e8-ca513b891286",
                        "entry_id": "0d451010-0980-3d7e-b38c-64584b364286",
                        "glosses": [
                            "Européisme, position politique favorable à l’unification de l’Europe."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
