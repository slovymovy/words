                "senses": [
                    {
                        "sense_id": "1311e09e-c469-3e1b-a082-fab0938039e0",
                        "entry_id": "ffd9c84e-1793-3ad4-af51-ad91160686bc",
                        "glosses": [
                            "Rendu réel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "625b39bd-5e60-4723-9453-d94315b60b62",
                                "sense_id": "1311e09e-c469-3e1b-a082-fab0938039e0",
                                "text": "On croit voir l’Atlantide du chancelier Bacon exécutée, le songe d’un savant réalisé."
                            },
                            {
                                "example_id": "63bf015d-f5e4-4a41-95ab-4d6e65a31a9d",
                                "sense_id": "1311e09e-c469-3e1b-a082-fab0938039e0",
                                "text": "Il est mort à présent, le pauvre : que la paix la plus sereine soit à son âme ! Mais il me semblait le type réalisé du « monsieur Ratin » de Töpffer ; il en avait tout, même la verrue avec les trois poils, au bout de son vieux nez d’une complication de lignes inimaginable ; il était pour moi la personnification du dégoûtant, de l’horrible."
                            }
                        ]
                    }
                ],
