                "senses": [
                    {
                        "sense_id": "1fa3174d-0d67-34b1-add8-ca7c7965bdd0",
                        "entry_id": "a620167c-02e1-3759-a55c-ac3f415d3daa",
                        "glosses": [
                            "En forme d’arc, courbé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "140b8555-e3fd-453b-8341-a0768e0700bf",
                                "sense_id": "1fa3174d-0d67-34b1-add8-ca7c7965bdd0",
                                "text": "Le spectacle de cette douleur donnait son gros rire à son mari, tandis qu’elle voyait se contracter les beaux sourcils noirs et si bien arqués de Julien."
                            },
                            {
                                "example_id": "211f794d-27b3-45a8-a8d5-9c5449b1286b",
                                "sense_id": "1fa3174d-0d67-34b1-add8-ca7c7965bdd0",
                                "text": "Naît-on pied-bot, hydrocéphale, avec un bec-de-lièvre, une arthrogrypose, des mains syndactyles, une scoliose ou des jambes arquées ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "789e7d3b-1397-37f9-8f7b-f0c9f8c95fae",
                        "entry_id": "a620167c-02e1-3759-a55c-ac3f415d3daa",
                        "glosses": [
                            "Qualifie un cheval qui fléchit le genou au repos."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28899a62-5877-4688-a92f-98a9c6bcee71",
                        "source_entry_id": "a620167c-02e1-3759-a55c-ac3f415d3daa",
                        "target_lang_word": "arched",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arched",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7b78866-4db5-36f5-bf40-56ba5073894e",
                                        "entry_id": "3b148584-928d-33bc-a0f5-4174cd08e3af",
                                        "glosses": [
                                            "Curved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f79d9fc5-0c92-4892-9354-4aae5967f8ad",
                                                "sense_id": "c7b78866-4db5-36f5-bf40-56ba5073894e",
                                                "text": "His arched back ached from the constant strain."
                                            },
                                            {
                                                "example_id": "b7750c82-2562-4e21-bb49-5e1919aebdd2",
                                                "sense_id": "c7b78866-4db5-36f5-bf40-56ba5073894e",
                                                "text": "The lobule margins, furthermore, are arched away from the lobe, with the consequence that (when fully inflated) the abaxial leaf surface forms the interior lining of the lobule."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arched",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43bb60b2-cec7-34a2-ba2f-4cd1403cbc3b",
                                        "entry_id": "0711ff9a-51de-3b1c-b2a4-95302a102169",
                                        "glosses": [
                                            "simple past and past participle of arch"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48496f31-d845-4a0b-a0b5-c4f2c8263404",
                                                "sense_id": "43bb60b2-cec7-34a2-ba2f-4cd1403cbc3b",
                                                "text": "He arched his back into a half-moon curve trying to get the stiffness out."
                                            }
                                        ]
