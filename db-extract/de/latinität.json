                "senses": [
                    {
                        "sense_id": "a5d0300e-4ab7-3714-a97c-6738199af791",
                        "entry_id": "dd54596b-1d4c-3294-8c50-128bcac71cf6",
                        "glosses": [
                            "Schreibweise des Lateinischen, die klassisch und mustergültig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d85dfb5f-fb4b-4261-b001-b82d0f5cd492",
                                "sense_id": "a5d0300e-4ab7-3714-a97c-6738199af791",
                                "text": "„Inzwischen bin ich durch vielfältige meinem Amte über angemerkte Exempel überzeugt, daß, wenn sich ein junger Mensch in diesem meinem Schulbuche fleißig umsiehet, er dadurch unvermerkt einen guten Geschmak von der reinen und zierlichen Latinität überkömt, der ihn in den Stand setzt, andere vorkommende Wörter und Redensarten, ob sie dem Geiste einer reinen Schreibart gemäß sind, zu beurtheilen.“ (1753)"
                            },
                            {
                                "example_id": "14a7245f-d8e5-41db-89b6-b5c19df18b73",
                                "sense_id": "a5d0300e-4ab7-3714-a97c-6738199af791",
                                "text": "„Ich werde gewiß nie lernen, sie zu erkennen, wie mir auch nie klargeworden ist, inwiefern Titus Livius angeblich gegen die Latinität verstieß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8e02d001-243a-3a99-b278-fc190d6e2a3e",
                        "entry_id": "dd54596b-1d4c-3294-8c50-128bcac71cf6",
                        "glosses": [
                            "klassische schriftliche Quellen (Schrifttum) des Lateinischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c1f3da8-3bad-42d9-a0e4-b646c9aaea59",
                                "sense_id": "8e02d001-243a-3a99-b278-fc190d6e2a3e",
                                "text": "„Als qualifizierendes \"Eigenschaftswort\" hingegen ist nescius in der klassischen Latinität nicht nachweisbar, taucht jedoch zweimal bei Plautus in der passivischen Bedeutung \"unbekannt\" auf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
