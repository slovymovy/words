                                "example_id": "d8131355-e567-42c2-8cae-cc9e630b680a",
                                "sense_id": "e9dd7d48-51dd-34db-84de-8c442c7e1960",
                                "text": "See not your bride in these unreverent robes:\nGo to my chamber, put on clothes of mine."
                            }
