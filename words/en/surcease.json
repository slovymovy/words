{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a971a84-2ae5-39bd-81a9-9a1406b09a36",
                    "sense_definition": "Cessation, relief, or a temporary stop to something, especially pain, distress, or sorrow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weary traveler sought a brief <w>surcease</w> from his endless journey in the quiet village.",
                            "target_lang_translations": {
                                "de": "Der müde Reisende suchte in dem ruhigen Dorf eine kurze <w>Erleichterung</w> von seiner endlosen Reise."
                            }
                        },
                        {
                            "text": "Many people find that listening to soft music offers <w>surcease</w> of sorrow during difficult times.",
                            "target_lang_translations": {
                                "de": "Viele Menschen finden, dass das Hören von sanfter Musik in schwierigen Zeiten <w>Trost</w> spendet."
                            }
                        }
                    ],
                    "synonyms": [
                        "cessation",
                        "respite",
                        "pause"
                    ],
                    "antonyms": [
                        "continuation"
                    ],
                    "common_phrases": [
                        "surcease of sorrow"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in literary or formal historical contexts."
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einstellung, Erleichterung oder ein vorübergehendes Aufhören von etwas, insbesondere von Schmerz, Leid oder Trauer."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Pause",
                                "target_lang_sense_clarification": "vorübergehendes Aufhören"
                            },
                            {
                                "target_lang_word": "die Erleichterung",
                                "target_lang_sense_clarification": "Befreiung von Schmerz oder Trauer"
                            },
                            {
                                "target_lang_word": "der Einhalt",
                                "target_lang_sense_clarification": "Stopp oder Ende von etwas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b5ca1ae-5e45-3ad1-8119-bc97aa12c2ed",
                    "sense_definition": "To come to an end; to stop or desist.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The violent storm began to <w>surcease</w> as the morning sun broke through the clouds.",
                            "target_lang_translations": {
                                "de": "Der heftige Sturm begann <w>nachzulassen</w>, als die Morgensonne durch die Wolken brach."
                            }
                        },
                        {
                            "text": "They hoped the ongoing conflict would finally <w>surcease</w> after the treaty was signed.",
                            "target_lang_translations": {
                                "de": "Sie hofften, dass der andauernde Konflikt nach der Unterzeichnung des Vertrags endlich <w>enden</w> würde."
                            }
                        }
                    ],
                    "synonyms": [
                        "cease",
                        "desist",
                        "stop"
                    ],
                    "antonyms": [
                        "continue",
                        "persist"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Zu einem Ende kommen; aufhören oder nachlassen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "aufhören",
                                "target_lang_sense_clarification": "zu einem Ende kommen"
                            },
                            {
                                "target_lang_word": "enden",
                                "target_lang_sense_clarification": "ein Ende finden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d490702-2c62-3e36-8a59-5f240d3043e1",
                    "sense_definition": "To bring an action or state to an end; to halt something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ruler issued a decree to <w>surcease</w> all military operations immediately.",
                            "target_lang_translations": {
                                "de": "Der Herrscher erließ ein Dekret, um alle militärischen Operationen unverzüglich <w>einzustellen</w>."
                            }
                        },
                        {
                            "text": "Nothing could easily <w>surcease</w> their ancient feud.",
                            "target_lang_translations": {
                                "de": "Nichts konnte ihre uralte Fehde leicht <w>beenden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "halt",
                        "terminate"
                    ],
                    "antonyms": [
                        "start",
                        "initiate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Handlung oder einen Zustand zu einem Ende bringen; etwas anhalten oder beenden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "beenden",
                                "target_lang_sense_clarification": "etwas zu einem Ende bringen"
                            },
                            {
                                "target_lang_word": "einstellen",
                                "target_lang_sense_clarification": "eine Tätigkeit oder Vorgang stoppen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}