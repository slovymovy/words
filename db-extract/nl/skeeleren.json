                    {
                        "sense_id": "81d528b5-f468-3c6d-a386-4caa69308eab",
                        "entry_id": "eba22749-532a-35cf-81e9-8b1cec591621",
                        "glosses": [
                            "rolschaatsen op een rolschaats met 4 wieltjes die recht achterelkaar staan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4c2c8ad-b684-4c88-8df2-a0a70ded55d0",
                                "sense_id": "81d528b5-f468-3c6d-a386-4caa69308eab",
                                "text": "Sandrine Tas heeft haar 22e verjaardag tijdens het WK skeeleren luister bijgezet met een zilveren medaille. Tas eindigde donderdag als tweede in de afvallingskoers op de weg over 20 kilometer, op de marathon na het langste onderdeel."
                            },
                            {
                                "example_id": "189a7f28-689b-4a47-a2b2-05e49f4522c9",
                                "sense_id": "81d528b5-f468-3c6d-a386-4caa69308eab",
                                "text": "Schouten groeide op in Andijk op een tulpenkwekerij. Haar ouders schaatsten niet, maar in het Noord-Hollandse dorp was de sport tijdens haar jeugd 'deel van de opvoeding'. Veel basisschoolkinderen gingen per bus naar de ijsbaan van Alkmaar. Schouten beschikte over talent en sloot aan bij een club. In de zomer skeeleren, 's winters op het ijs."
                            }
                        ]
                    }
