                        ],
                        "examples": [
                            {
                                "example_id": "6e4b8ca4-5df5-40b8-aa92-69462e891540",
                                "sense_id": "a8d16483-4430-37cc-b6b1-8e59b0dffe4b",
                                "text": "„Weiche, blaßgelbe Strümpfe ließen die bogenförmigen Schuhchen hervortreten.“"
                            },
                            {
                                "example_id": "bfb244c5-6fdd-480f-b382-f736f8d086cc",
                                "sense_id": "a8d16483-4430-37cc-b6b1-8e59b0dffe4b",
                                "text": "„Als Natascha wieder an der Reihe war, stand sie auf und lief in ihren schleifengeschmückten Schuhchen ganz allein und mit verlegenem Gesicht quer durch den Saal auf Denissow zu, der immer noch in seiner Ecke unter den alten Damen sass.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
