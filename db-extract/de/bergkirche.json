                "senses": [
                    {
                        "sense_id": "c413c5b7-d7f7-34e6-9ee9-a5f7fc890314",
                        "entry_id": "61974b95-8c4d-37ed-a047-cbcbc62a036c",
                        "glosses": [
                            "eine meist einfach gestaltete Kirche, die sich auf einem Berg oder einer anderen Erhebung befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a10d1078-bad4-4d8d-9049-93b62fc88458",
                                "sense_id": "c413c5b7-d7f7-34e6-9ee9-a5f7fc890314",
                                "text": "„Oben auf dem Gipfel wartet neben der neuromanischen Bergkirche St. Marien zu den 14 Nothelfern eine fantastische Aussicht ins Weidener Becken“"
                            },
                            {
                                "example_id": "7a83d599-c084-4078-8c1e-a2a3bb0d7973",
                                "sense_id": "c413c5b7-d7f7-34e6-9ee9-a5f7fc890314",
                                "text": "„Unsere kleine, aber schöne Bergkirche, erbaut im Jahre 1910, befindet sich gleich am Ortsanfang, oben an der Wolfsbrunnensteige 7.“"
                            },
                            {
                                "example_id": "468ad556-1d70-45bb-ad0f-5ad0c31083c2",
                                "sense_id": "c413c5b7-d7f7-34e6-9ee9-a5f7fc890314",
                                "text": "„Die Bergkirche gilt als der am reinsten erhaltene Kirchenbau der Stadt aus dem 19. Jahrhundert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
