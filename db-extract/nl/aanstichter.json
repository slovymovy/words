                                "target_senses": [
                                    {
                                        "sense_id": "aaeca311-00d5-333a-9002-f69a56e184bf",
                                        "entry_id": "629a7258-1ef7-3177-af97-2ccc8caea46d",
                                        "glosses": [
                                            "Personne qui incite ou qui pousse à faire quelque chose."
                                        ],
                                        "tags": [],
                                        "note": "Il se prend le plus souvent en mauvaise part",
                                        "examples": [
                                            {
                                                "example_id": "25fcfad9-3f63-4690-998a-bccd6071075d",
                                                "sense_id": "aaeca311-00d5-333a-9002-f69a56e184bf",
                                                "text": "Je croyais ce secret enseveli dans mon propre sein et dans celui d’une femme, l’instigatrice, la complice de mon crime."
                                            },
                                            {
                                                "example_id": "ba81c511-13c3-4218-bd20-ec9984f1a401",
                                                "sense_id": "aaeca311-00d5-333a-9002-f69a56e184bf",
                                                "text": "[…], tout concourait en même temps pour préparer la chute de la branche aînée des Bourbons; mais, de la probabilité à l'accomplissement du fait, il y avait loin , et l'on ne peut disconvenir que M. Thiers et tous les instigateurs du mouvement ne jouassent gros jeu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
