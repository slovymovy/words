                "senses": [
                    {
                        "sense_id": "e6b3a25b-5778-3b03-b20f-28addf318e29",
                        "entry_id": "14ea1db7-f7e3-30dd-8bf6-5960e8a9884d",
                        "glosses": [
                            "vereerster van een goddelijk of heilig wezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10289b9f-4cea-447f-abf4-9bedeea45ac9",
                                "sense_id": "e6b3a25b-5778-3b03-b20f-28addf318e29",
                                "text": "De vrome aanbidster van de heilige maagd Maria bad iedere dag een weesgegroetje"
                            }
                        ]
                    },
                    {
                        "sense_id": "c2b9796f-05eb-38e9-99d1-9bff719a35a2",
                        "entry_id": "14ea1db7-f7e3-30dd-8bf6-5960e8a9884d",
                        "glosses": [
                            "een vrouwelijk verliefd persoon, die een ander het hof maakt"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "6a09d161-1165-4de5-848d-0a341c4dfcd2",
                                "sense_id": "c2b9796f-05eb-38e9-99d1-9bff719a35a2",
                                "text": "De rijke vrijgezel had vele aanbidsters, maar wilde niets van ze weten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35070bab-a869-4955-83fd-a9e635f534f8",
                        "source_entry_id": "14ea1db7-f7e3-30dd-8bf6-5960e8a9884d",
                        "source_sense_id": "e6b3a25b-5778-3b03-b20f-28addf318e29",
                        "source_sense_description": "vereerster van een goddelijk wezen",
                        "target_lang_word": "worshipper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worshipper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5323995b-861a-3ace-85a9-834715f65654",
                                        "entry_id": "c48dbc76-8e74-35c6-9f53-369eaaabd767",
                                        "glosses": [
                                            "A person who worships, especially at a place of assembly for religious services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec27be60-a66e-4dd1-8775-85bcc558f6d8",
                                                "sense_id": "5323995b-861a-3ace-85a9-834715f65654",
                                                "text": "The temple was filled with worshippers."
                                            },
                                            {
                                                "example_id": "1271803b-7ea8-489d-8e34-a929d12b3f2c",
                                                "sense_id": "5323995b-861a-3ace-85a9-834715f65654",
                                                "text": "Sadly, the ever-eager Reverend Judith had not been able to conjure up many worshippers, even though it was Father’s Day. There was just one old dear sitting halfway back, her faulty hearing aid letting off a high-pitched whistle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c23dea5a-f775-4e39-a674-efd95b66f977",
                        "source_entry_id": "14ea1db7-f7e3-30dd-8bf6-5960e8a9884d",
                        "source_sense_id": "e6b3a25b-5778-3b03-b20f-28addf318e29",
                        "source_sense_description": "vereerster van een goddelijk wezen",
                        "target_lang_word": "adoratrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adoratrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2c7749e-44e9-3b36-9280-dda09102b826",
                                        "entry_id": "a8b5bd03-b6c8-3221-854f-59135418d49f",
                                        "glosses": [
                                            "Celle qui adore une divinité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68d2bf21-7211-4d0a-9308-5941dacf2fbf",
                                                "sense_id": "a2c7749e-44e9-3b36-9280-dda09102b826",
                                                "text": "Leclant, dans ce dernier article, étudie les liens qui unissent la divine adoratrice à la déesse Tefnout."
                                            },
                                            {
                                                "example_id": "9b4d1ca2-6d55-4705-9dd1-263cfc72d0b1",
                                                "sense_id": "a2c7749e-44e9-3b36-9280-dda09102b826",
                                                "text": "Notre présence ne paraît pas contrarier les adoratrices du dieu, qui viennent en foule nous vendre leurs volailles ou plutôt les échanger contre des morceaux de cotonnade rouge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dc633a4-f1cb-336c-9d1b-1b6c351daf8a",
                                        "entry_id": "a8b5bd03-b6c8-3221-854f-59135418d49f",
                                        "glosses": [
                                            "Celle qui a une estime extraordinaire, et qui admire en tout cette personne."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65750abc-8e4e-4ad5-ba13-51f3eba089ed",
                                                "sense_id": "1dc633a4-f1cb-336c-9d1b-1b6c351daf8a",
                                                "text": "C’était une entreprise hasardeuse que de prétendre amadouer le docteur Johnson. Il rebutait, rabrouait souvent ses belles adoratrices, payait de rebuffades leurs adulations et leurs cajoleries."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adoratrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86e294a8-ceac-3ee4-a647-08648c53e701",
                                        "entry_id": "876151e8-b848-3d32-8217-07127a87b844",
                                        "glosses": [
                                            "Féminin singulier de adorateur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97906800-ddcc-49c0-8813-f3dd9c9bfac3",
                                                "sense_id": "86e294a8-ceac-3ee4-a647-08648c53e701",
                                                "text": "Il a beau faire semblant d’être offusqué: L’immigrationniste Bourdin, sous influence de sa femme adoratrice des musulmans, est démasqué depuis longtemps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
