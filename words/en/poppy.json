{
    "word_family": [
        "pop"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "58eb457f-468b-3191-b633-76f61441af80",
                    "sense_definition": "A plant with delicate, often red, petals and a milky juice, known for its association with remembrance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright red <w>poppy</w> flowers bloomed beautifully in the garden during the early summer.",
                            "target_lang_translations": {
                                "ru": "Ярко-красные цветы <w>мака</w> красиво расцвели в саду в начале лета."
                            }
                        },
                        {
                            "text": "Many people wear a <w>poppy</w> to honor soldiers who died in war.",
                            "target_lang_translations": {
                                "ru": "Многие люди носят <w>мак</w> в знак уважения к солдатам, погибшим на войне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "red poppy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Травянистое растение с нежными, часто красными лепестками и млечным соком, известное как символ памяти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мак",
                                "target_lang_sense_clarification": "ботаническое название растения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc5f0f91-d08e-3020-a84e-6ae2e1c346c4",
                    "sense_definition": "An artificial flower worn to remember those who died in armed conflicts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remembrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pinned a small <w>poppy</w> to his coat before attending the ceremony.",
                            "target_lang_translations": {
                                "ru": "Перед церемонией он приколол к пальто маленький <w>мак</w>."
                            }
                        },
                        {
                            "text": "Everyone wore a <w>poppy</w> on their lapel during the Remembrance Day service.",
                            "target_lang_translations": {
                                "ru": "Во время службы в День памяти все носили на лацканах <w>мак</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wear a poppy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусственный цветок, который носят в память о погибших в вооруженных конфликтах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мак",
                                "target_lang_sense_clarification": "символический значок в виде цветка мака"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b0b641a-e790-340e-8ea4-64851b988425",
                    "sense_definition": "A bright red color with an orange tint.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She painted her bedroom walls a vibrant <w>poppy</w> red.",
                            "target_lang_translations": {
                                "ru": "Она покрасила стены в спальне в яркий <w>алый</w> цвет."
                            }
                        },
                        {
                            "text": "The sunset had a beautiful <w>poppy</w> glow across the horizon.",
                            "target_lang_translations": {
                                "ru": "На горизонте заката было красивое <w>алое</w> свечение."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ярко-красный цвет с оранжевым оттенком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алый",
                                "target_lang_sense_clarification": "ярко-красный цвет"
                            },
                            {
                                "target_lang_word": "маковый",
                                "target_lang_sense_clarification": "цвет, напоминающий цвет лепестков мака"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1bfcb94e-8b52-3609-86e2-db2034f59e2b",
                    "sense_definition": "An affectionate term for a father or grandfather.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>poppy</w> always tells the best stories about his childhood.",
                            "target_lang_translations": {
                                "ru": "Мой <w>дедуля</w> всегда рассказывает лучшие истории о своем детстве."
                            }
                        },
                        {
                            "text": "I went to visit my <w>poppy</w> for his birthday last weekend.",
                            "target_lang_translations": {
                                "ru": "В прошлые выходные я ездил к <w>дедушке</w> на день рождения."
                            }
                        }
                    ],
                    "synonyms": [
                        "pappy",
                        "pop",
                        "poppa",
                        "pops",
                        "pop-pop"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term of endearment."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласковое обращение к отцу или дедушке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "папа",
                                "target_lang_sense_clarification": "разговорное обращение к отцу"
                            },
                            {
                                "target_lang_word": "дедуля",
                                "target_lang_sense_clarification": "ласковое обращение к дедушке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3f7574a4-adb8-384b-b6df-72ea641642dc",
                    "sense_definition": "Having the catchy, accessible style of pop music.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band released a very <w>poppy</w> song that became a summer hit.",
                            "target_lang_translations": {
                                "ru": "Группа выпустила очень <w>попсовую</w> песню, которая стала летним хитом."
                            }
                        },
                        {
                            "text": "Her new album has a <w>poppy</w> sound that is easy to dance to.",
                            "target_lang_translations": {
                                "ru": "Ее новый альбом имеет <w>попсовое</w> звучание, под которое легко танцевать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poppy sound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий запоминающийся, доступный стиль поп-музыки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попсовый",
                                "target_lang_sense_clarification": "характерный для поп-музыки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bb2c9a0-0dfb-35fd-9005-00f15de52f8f",
                    "sense_definition": "Widely liked or appealing to many people.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "popularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author wrote a <w>poppy</w> novel that topped the bestseller lists.",
                            "target_lang_translations": {
                                "ru": "Автор написал <w>популярный</w> роман, который возглавил списки бестселлеров."
                            }
                        },
                        {
                            "text": "It was a <w>poppy</w> choice for the main event of the festival.",
                            "target_lang_translations": {
                                "ru": "Это был <w>популярный</w> выбор для главного события фестиваля."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко популярный или привлекательный для многих людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "популярный",
                                "target_lang_sense_clarification": "пользующийся широким признанием"
                            },
                            {
                                "target_lang_word": "массовый",
                                "target_lang_sense_clarification": "рассчитанный на широкую аудиторию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bf42d33-5383-320c-ae4c-64dfb1ade3f3",
                    "sense_definition": "Bright red with an orange tint.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>poppy</w> dress that stood out in the crowd.",
                            "target_lang_translations": {
                                "ru": "На ней было <w>алое</w> платье, которое выделялось в толпе."
                            }
                        },
                        {
                            "text": "The artist used a <w>poppy</w> shade of paint for the flowers.",
                            "target_lang_translations": {
                                "ru": "Художник использовал <w>алый</w> оттенок краски для цветов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ярко-красный с оранжевым оттенком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алый",
                                "target_lang_sense_clarification": "ярко-красный цвет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "432dc924-7439-35c7-9b49-532beda3877e",
                    "sense_definition": "Describing eyes that appear to stick out from the face.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cartoon character was drawn with large <w>poppy</w> eyes.",
                            "target_lang_translations": {
                                "ru": "Персонаж мультфильма был нарисован с большими <w>выпуклыми</w> глазами."
                            }
                        },
                        {
                            "text": "He had slightly <w>poppy</w> eyes that widened when he was surprised.",
                            "target_lang_translations": {
                                "ru": "У него были слегка <w>выпуклые</w> глаза, которые расширялись, когда он удивлялся."
                            }
                        }
                    ],
                    "synonyms": [
                        "bulging"
                    ],
                    "common_phrases": [
                        "poppy eyes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описание глаз, которые кажутся выпуклыми."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпуклый",
                                "target_lang_sense_clarification": "о глазах, выступающих вперед"
                            },
                            {
                                "target_lang_word": "навыкате",
                                "target_lang_sense_clarification": "о глазах, сильно выступающих из глазниц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64aaaaa4-8ded-36b2-8d91-ccfb9803092b",
                    "sense_definition": "Effervescent or fizzy, like a carbonated drink.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drink had a <w>poppy</w> texture that tickled the tongue.",
                            "target_lang_translations": {
                                "ru": "Напиток имел <w>шипучую</w> текстуру, которая щекотала язык."
                            }
                        },
                        {
                            "text": "She enjoyed the <w>poppy</w> sensation of the sparkling water.",
                            "target_lang_translations": {
                                "ru": "Ей нравилось <w>шипучее</w> ощущение газированной воды."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шипучий или газированный, как напиток."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шипучий",
                                "target_lang_sense_clarification": "о напитке с пузырьками газа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bc7cd81-27a9-3460-9f77-b31b4e41e791",
                    "sense_definition": "Characterized by a sharp, bursting sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fire made a <w>poppy</w> sound as the wood burned.",
                            "target_lang_translations": {
                                "ru": "Огонь издавал <w>трескучий</w> звук, пока горели дрова."
                            }
                        },
                        {
                            "text": "There was a <w>poppy</w> noise coming from the old engine.",
                            "target_lang_translations": {
                                "ru": "От старого двигателя исходил <w>трескучий</w> шум."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся резким, лопающимся звуком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трескучий",
                                "target_lang_sense_clarification": "издающий резкие звуки, треск"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d70c919f-9dd7-33a9-bcde-82d9c1e3a34b",
                    "sense_definition": "A female given name derived from the flower.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Poppy</w> is a very popular name for girls in the UK.",
                            "target_lang_translations": {
                                "ru": "<w>Поппи</w> — очень популярное имя для девочек в Великобритании."
                            }
                        },
                        {
                            "text": "I met a girl named <w>Poppy</w> at the park today.",
                            "target_lang_translations": {
                                "ru": "Сегодня в парке я встретил девочку по имени <w>Поппи</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя, происходящее от названия цветка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Поппи",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ef1f76a-a5f9-36c9-93a5-93e9117ff6bd",
                    "sense_definition": "A term of address for a father or grandfather.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going to visit <w>Poppy</w> this weekend.",
                            "target_lang_translations": {
                                "ru": "В эти выходные я собираюсь навестить <w>дедушку</w>."
                            }
                        },
                        {
                            "text": "Can you ask <w>Poppy</w> if he wants to come for dinner?",
                            "target_lang_translations": {
                                "ru": "Можешь спросить у <w>дедушки</w>, хочет ли он прийти на ужин?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма обращения к отцу или дедушке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "папа",
                                "target_lang_sense_clarification": "обращение к отцу"
                            },
                            {
                                "target_lang_word": "дедушка",
                                "target_lang_sense_clarification": "обращение к дедушке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "910605ab-e4b1-3655-800c-e84d915d03e1",
                    "sense_definition": "A nickname for the 41st U.S. President, George H. W. Bush.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "Some people referred to George H. W. Bush as <w>Poppy</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди называли Джорджа Г. У. Буша <w>Поппи</w>."
                            }
                        },
                        {
                            "text": "The biography explains why the president was nicknamed <w>Poppy</w>.",
                            "target_lang_translations": {
                                "ru": "В биографии объясняется, почему президента прозвали <w>Поппи</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозвище 41-го президента США Джорджа Г. У. Буша."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Поппи",
                                "target_lang_sense_clarification": "историческое прозвище"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}