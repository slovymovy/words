                "senses": [
                    {
                        "sense_id": "4e8dba43-1109-322f-bcc8-a6a01eb9d29b",
                        "entry_id": "718b1138-a44d-3ed2-88ae-f2602f711b57",
                        "glosses": [
                            "bar stool (a tall stool-like seat usually having a foot rest, commonly placed in bars)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "31b48b07-1715-4949-9b6f-c729e5a39b34",
                                "sense_id": "4e8dba43-1109-322f-bcc8-a6a01eb9d29b",
                                "text": "auf einem Barhocker sitzen, sich auf einen Barhocker setzen",
                                "translation": "to sit on a bar stool, to take a seat on a bar stool",
                                "english": "to sit on a bar stool, to take a seat on a bar stool"
                            },
                            {
                                "example_id": "7b7a2107-822e-4540-97ab-a563863fd776",
                                "sense_id": "4e8dba43-1109-322f-bcc8-a6a01eb9d29b",
                                "text": "Bruno rutschte von seinem Barhocker.",
                                "translation": "Bruno slid down from his bar stool.",
                                "english": "Bruno slid down from his bar stool."
                            },
                            {
                                "example_id": "9b67c563-ddd2-480b-96f7-6f017f3de967",
                                "sense_id": "4e8dba43-1109-322f-bcc8-a6a01eb9d29b",
                                "text": "Sie setzten sich auf einen Barhocker und bestellten zwei Gin Tonic.",
                                "translation": "They took a seat on a bar stool and ordered two gin and tonics.",
                                "english": "They took a seat on a bar stool and ordered two gin and tonics."
                            },
                            {
                                "example_id": "b97450b3-b0a3-4eb1-8190-ef8ad0de609a",
                                "sense_id": "4e8dba43-1109-322f-bcc8-a6a01eb9d29b",
                                "text": "Mit einigem Elan erkletterte sie den Barhocker, faltete knotige Hände, gab die üblichen Litaneien des Alters von sich und hustete mich mit dem rußigen Lachen der Kettenraucher an, während sie Margaritas kippte.",
                                "translation": "With some elan she climbed onto the bar stool, folded [her] knotty hands, uttered the usual litanies of old age, and coughed at me with the sooty laugh of chain smokers as she knocked back margaritas.",
                                "english": "With some elan she climbed onto the bar stool, folded [her] knotty hands, uttered the usual litanies of old age, and coughed at me with the sooty laugh of chain smokers as she knocked back margaritas."
                            }
                        ]
                    }
