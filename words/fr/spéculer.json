                    ]
                },
                {
                    "sense_id": "b00e083a-b7f6-3685-af12-d3d5f0fed554",
                    "sense_definition": "Méditer ou réfléchir de façon abstraite et théorique sans visée pratique immédiate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pensée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce philosophe préfère <w>spéculer</w> sur l'existence plutôt que d'aborder des problèmes concrets."
                        },
                        {
                            "text": "Il ne sert à rien de <w>spéculer</w> dans le vide sans jamais confronter ses idées au réel."
