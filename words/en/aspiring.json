{
    "word_family": [
        "aspire",
        "aspiration",
        "aspirant"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7db3cf28-89ea-37c7-b093-bb34951c15d5",
                    "sense_definition": "Hoping or working to become a specified type of professional or person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ambition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Aspiring</w> pop stars lined up for hours just to audition.",
                            "target_lang_translations": {
                                "ru": "<w>Начинающие</w> поп-звезды часами стояли в очереди, чтобы пройти прослушивание."
                            }
                        },
                        {
                            "text": "Many <w>aspiring</w> writers attend workshops to improve their craft.",
                            "target_lang_translations": {
                                "ru": "Многие <w>начинающие</w> писатели посещают семинары, чтобы улучшить свое мастерство."
                            }
                        }
                    ],
                    "synonyms": [
                        "ambitious",
                        "wannabe",
                        "would-be"
                    ],
                    "common_phrases": [
                        "aspiring artist",
                        "aspiring writer",
                        "aspiring politician"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который стремится стать кем-то или достичь определенной профессии в будущем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начинающий",
                                "target_lang_sense_clarification": "часто используется для творческих профессий"
                            },
                            {
                                "target_lang_word": "будущий",
                                "target_lang_sense_clarification": "указывает на потенциал или намерение"
                            },
                            {
                                "target_lang_word": "стремящийся",
                                "target_lang_sense_clarification": "подчеркивает активное желание достичь цели"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5459c427-a758-3acb-937c-7eb19c5621dd",
                    "sense_definition": "The present participle and gerund of <w>aspire</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ambition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>aspiring</w> to reach the top of her profession.",
                            "target_lang_translations": {
                                "ru": "Она <w>стремится</w> достичь вершин своей профессии."
                            }
                        },
                        {
                            "text": "His <w>aspiring</w> to greatness led him to work very long hours.",
                            "target_lang_translations": {
                                "ru": "Его <w>стремление</w> к величию заставляло его работать очень много."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола «стремиться» (aspire)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремящийся",
                                "target_lang_sense_clarification": "активное действие по достижению цели"
                            },
                            {
                                "target_lang_word": "стремление",
                                "target_lang_sense_clarification": "используется как существительное для передачи герундия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab1a7637-d846-3fa5-96cf-9fcdacce1963",
                    "sense_definition": "A strong desire or ambition to achieve something.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ambition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet wrote about the <w>aspirings</w> of the human soul.",
                            "target_lang_translations": {
                                "ru": "Поэт писал о <w>стремлениях</w> человеческой души."
                            }
                        },
                        {
                            "text": "He felt that his noble <w>aspirings</w> were misunderstood by his peers.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что его благородные <w>стремления</w> были не поняты сверстниками."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This noun form is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное желание или амбиция достичь чего-либо (устаревшая форма)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремление",
                                "target_lang_sense_clarification": "общее понятие сильного желания"
                            },
                            {
                                "target_lang_word": "порыв",
                                "target_lang_sense_clarification": "эмоциональное или духовное стремление"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}