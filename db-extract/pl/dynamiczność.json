                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynamisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6d200a9-524f-3f8d-8ab9-bc0f91cc0f1e",
                                        "entry_id": "4f95bf4f-5f11-32d2-9c40-c15974ad40af",
                                        "glosses": [
                                            "Doctrine qui attribue le mouvement de la matière à des forces immanentes et non à une action extérieure et mécanique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "641b46c5-9d47-4d78-ba6f-7793a802ef8c",
                                                "sense_id": "f6d200a9-524f-3f8d-8ab9-bc0f91cc0f1e",
                                                "text": "Le dynamisme de Leibnitz, de Newton, opposé au mécanisme de Descartes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d7a067f-a4e8-3397-bbc0-e2214d889d9d",
                                        "entry_id": "4f95bf4f-5f11-32d2-9c40-c15974ad40af",
                                        "glosses": [
                                            "Énergie, élan, entrain, fougue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c27f35-8c35-46c0-90e3-931fe8c60c64",
                                                "sense_id": "3d7a067f-a4e8-3397-bbc0-e2214d889d9d",
                                                "text": "Il fait preuve de dynamisme."
                                            },
                                            {
                                                "example_id": "f0ab8aed-4a31-473a-83da-d16310522ccb",
                                                "sense_id": "3d7a067f-a4e8-3397-bbc0-e2214d889d9d",
                                                "text": "Le dynamisme des petites entreprises n’est pas une fin en soi, mais un élément du secteur des PME qui concourt à la progression globale de la productivité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
