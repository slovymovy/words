                "senses": [
                    {
                        "sense_id": "6d9d5df3-31b9-34bf-a32e-8905ae106605",
                        "entry_id": "3df7b0df-b38d-3586-9060-de5640a26293",
                        "glosses": [
                            "Sortir de sa coquille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cb3068d-9348-4371-8403-412655138357",
                                "sense_id": "6d9d5df3-31b9-34bf-a32e-8905ae106605",
                                "text": "Il lui prépare des pâtées exquises et fait la chasse aux escargots, que Mariette désencoquille d’un prompt coup de bec."
                            },
                            {
                                "example_id": "096830ad-1ab6-491e-96a3-b1c31f106be0",
                                "sense_id": "6d9d5df3-31b9-34bf-a32e-8905ae106605",
                                "text": "C’est le printemps qui me désencoquille."
                            },
                            {
                                "example_id": "5cc524bc-4be2-404c-a423-4d345764bf99",
                                "sense_id": "6d9d5df3-31b9-34bf-a32e-8905ae106605",
                                "text": "Devant tel amas d’escargots, si profondément renfoncés que leur carapace semble vide, les plus petites, gris-faïence, ont vraiment l’air de limaçons ensorcelés auxquels le pouvoir de la sombre nuit a permis de se désencoquiller de leur maisonnette."
                            }
                        ]
                    }
