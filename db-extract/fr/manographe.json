                        "glosses": [
                            "Appareil de mesure servant à évaluer la puissance d'un moteur thermique, en mesurant la pression interne des gaz de combustion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6936bd85-900e-40f0-82ae-c916632f66ae",
                                "sense_id": "1ea5de0d-678a-371d-925b-cbd754fd184e",
                                "text": "Si la température est suffisamment élevée, l'auto-inflammation suivra l'introduction du mélange vers [le] manographe..."
                            },
                            {
                                "example_id": "ba3fb68d-9e5e-4968-bfe2-09478449ed82",
                                "sense_id": "1ea5de0d-678a-371d-925b-cbd754fd184e",
                                "text": "Le CNAM conserve un manographe de L'Hospitalier et Carpentier et aussi un manographe de Blondel à miroir mobile"
                            }
                        ]
                    },
                    {
                        "sense_id": "fef6edc4-fa58-3d70-bc9f-780377750d6e",
                        "entry_id": "77ba44d9-15b5-3966-897c-5ead33b206c9",
                        "glosses": [
