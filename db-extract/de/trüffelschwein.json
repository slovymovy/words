                "senses": [
                    {
                        "sense_id": "4ec1ea0d-1b5e-3a85-92a2-a2dde569cdfe",
                        "entry_id": "0ed0f70b-7d62-34d4-95fc-394d61a98e97",
                        "glosses": [
                            "ein weibliches Schwein, das darauf abgerichtet ist, Trüffel zu suchen oder dies instinktiv tut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0ce8806-7427-4828-89e0-b30d62cfce3c",
                                "sense_id": "4ec1ea0d-1b5e-3a85-92a2-a2dde569cdfe",
                                "text": "Ein Trüffelschwein findet höchstens zehn Trüffel pro Jahr."
                            },
                            {
                                "example_id": "4c5bea2f-7eab-48a4-81d5-2dd9ca888c7b",
                                "sense_id": "4ec1ea0d-1b5e-3a85-92a2-a2dde569cdfe",
                                "text": "Der Duft des Pilzes ähnelt sehr stark dem Androstenon, dem Sexualduftstoff des Ebers, weshalb weibliche, geschlechtsreife Schweine, die der Mensch als Trüffelschweine einsetzt, instinktiv danach suchen."
                            }
                        ],
                        "sense_index_json": "\"1\""
