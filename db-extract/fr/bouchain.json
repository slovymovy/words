            {
                "entry_id": "af28a466-4a1a-3a19-86de-bd837d40c048",
                "word": "bouchain",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "25229738-ee42-4330-b84e-3e229624ad7a",
                        "entry_id": "af28a466-4a1a-3a19-86de-bd837d40c048",
                        "tags": [
                            "plural"
                        ],
                        "form": "bouchains"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bd59854-8fa2-3f00-825f-0b78aac2ab71",
                        "entry_id": "af28a466-4a1a-3a19-86de-bd837d40c048",
                        "glosses": [
                            "Partie du bordé d’un bateau, représentant la zone intermédiaire entre les fonds et les murailles"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ed52cb2-9548-4945-9c5b-b47d321f62c7",
                                "sense_id": "7bd59854-8fa2-3f00-825f-0b78aac2ab71",
                                "text": "À la suite de mauvais temps en cours de voyage, le joint de trou d’homme de l’un des ballasts a présenté une fuite d’eau qui s’est écoulée dans le bouchain."
                            },
                            {
                                "example_id": "573f3963-525c-4532-8c99-445a60ca84ce",
                                "sense_id": "7bd59854-8fa2-3f00-825f-0b78aac2ab71",
                                "text": "Il avait l’air achevé, ses bouchains ronds étaient tous solidement assemblés, ses plats-bords attendaient de recevoir le pont et l’espèce de roof dont les structures reposaient au milieu d’un fouillis de bambous et de bois destinés à la mâture."
                            },
                            {
                                "example_id": "b34bff8c-efbe-4b02-b85b-58cd20c2a0a8",
                                "sense_id": "7bd59854-8fa2-3f00-825f-0b78aac2ab71",
                                "text": "Une coque dite « en forme » comporte des bouchains arrondis. Une coque angulaire est dite « à bouchains vifs »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8563a8d-1f37-426c-93f8-0b779d7d7a38",
                        "source_entry_id": "af28a466-4a1a-3a19-86de-bd837d40c048",
                        "source_sense_id": "7bd59854-8fa2-3f00-825f-0b78aac2ab71",
                        "target_lang_word": "Kimm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kimm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                        "entry_id": "b7338420-038a-356e-a454-7c93baefeacc",
                                        "glosses": [
                                            "Grenzlinie auf See zwischen Wasseroberfläche und Luft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd2efd67-6b1c-4233-945b-4c9840944a1b",
                                                "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                                "text": "„Angespannter als je zuvor suchten meine Blicke durch das Doppelglas in dem mir zugewiesenen rückwärtigen Sektor zunächst das Wasser der Kimm, dem Treffpunkt von Wasserfläche und dem bewölkten Himmel am Horizont.“"
                                            },
                                            {
                                                "example_id": "891ec7ec-e383-4b32-9329-c0cbb9dcd935",
                                                "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                                "text": "„Die Kimm zeichnet sich nun ringsum schon klar und deutlich ab.“"
                                            },
                                            {
                                                "example_id": "1fdbb82e-3302-4fdc-b8d8-19acfc3df587",
                                                "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                                "text": "„Palmen, Häuser, der Strand von Bagamoyo verschmelzen allmählich zu einem schmalen Strich an der Kimm.“"
                                            },
                                            {
                                                "example_id": "1b5b5910-d3a9-411c-a3f9-cc4247cad7db",
                                                "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                                "text": "„Die Kimm zitterte vor Hitze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33e1cdda-7ea6-3304-a845-7bf94912743d",
                                        "entry_id": "b7338420-038a-356e-a454-7c93baefeacc",
                                        "glosses": [
                                            "Grenze zwischen Boden und Wand bei Schiffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9f361e-9def-4c82-8e32-a8fb0a71aa2d",
                                                "sense_id": "33e1cdda-7ea6-3304-a845-7bf94912743d",
                                                "text": "„Wir versuchten zunächst, das Schiff über die Untiefe zu zwingen, doch ohne Erfolg, und als die Ebbe kam, kippte es auf die Kimm, und die Schandeckel gerieten unter Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01dc12ec-8488-4e3b-8828-b7f7e1640bc2",
                        "source_entry_id": "af28a466-4a1a-3a19-86de-bd837d40c048",
                        "source_sense_id": "7bd59854-8fa2-3f00-825f-0b78aac2ab71",
