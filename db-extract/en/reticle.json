                    },
                    {
                        "translation_id": "e8cf3758-11f2-4bc4-8895-ad7c47aa4c28",
                        "source_entry_id": "0ee26d11-a0c2-3b8c-9769-6a340ce72ff6",
                        "source_sense_description": "a gridwork or lattice of lines set into the eyepiece of optical instruments",
                        "target_lang_word": "Fadenkreuz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fadenkreuz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "991b42cf-39ed-34f3-aa5c-ab7b0555716d",
                                        "entry_id": "e3bde9f0-407a-3079-bc03-a3d43289808f",
                                        "glosses": [
                                            "Markierung der Schusslinie bzw. Ziellinie in einem Zielfernrohr; Absehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "573ebf46-e26b-42b7-bd7b-9bd63221c79c",
                                                "sense_id": "991b42cf-39ed-34f3-aa5c-ab7b0555716d",
                                                "text": "Indem nun Cavanilles das Fadenkreuz eines stark vergrößernden Fernrohres auf die Spitze eines solchen Schößlings einstellte, konnte er dieselbe beständig wie den Secundenzeiger einer Taschenuhr vorrücken sehen."
                                            },
                                            {
                                                "example_id": "dbd3cc12-0ab9-4338-8f98-e9ca24ec28e4",
                                                "sense_id": "991b42cf-39ed-34f3-aa5c-ab7b0555716d",
                                                "text": "„Ich bewegte das Fadenkreuz auf die Brust des rechten Kojoten und entsicherte.“"
                                            },
                                            {
                                                "example_id": "0d210323-1c71-4d1b-878a-20d28413bdff",
                                                "sense_id": "991b42cf-39ed-34f3-aa5c-ab7b0555716d",
                                                "text": "„Vor etwa fünf Jahren ist Andrej Holm in das Fadenkreuz der Ermittler geraten. Ein Sondereinsatzkommando stürmte seine Wohnung, denn die Bundesanwaltschaft hält ihn zum damaligen Zeitpunkt für einen geistigen Brandstifter.“"
                                            },
                                            {
                                                "example_id": "97b83bef-a717-40fc-83ee-ab4367fc9780",
                                                "sense_id": "991b42cf-39ed-34f3-aa5c-ab7b0555716d",
                                                "text": "„Im Fadenkreuz taucht ein langer dürrer Schatten von Mensch auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "81d5b33d-c31d-3fb6-9b9e-d9120a5c5e3d",
                                        "entry_id": "e3bde9f0-407a-3079-bc03-a3d43289808f",
                                        "glosses": [
                                            "Form der Strichplatte in Okularen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55aef18a-05cc-4e9c-95f1-68d6b35567db",
                                                "sense_id": "81d5b33d-c31d-3fb6-9b9e-d9120a5c5e3d",
                                                "text": "Der Schattenzeiger [der Büchsensonnenuhr] wird senkrecht in die Büchse montiert. Alternativ kann über die Büchse ein Fadenkreuz gespannt werden, das dann über einen Spiegel im Deckel abgelesen wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "43601ff5-b856-3cf2-aea6-18bd5f404a7b",
                                        "entry_id": "e3bde9f0-407a-3079-bc03-a3d43289808f",
                                        "glosses": [
                                            "Aus dünnen Strichen gebildetes Kreuz"
                                        ],
                                        "tags": [
                                            "Heraldik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5e170ba-d78e-4670-90f9-071c6f33da1d",
                                                "sense_id": "43601ff5-b856-3cf2-aea6-18bd5f404a7b",
                                                "text": "Verschiedene Kreuzformen sind bekannt: Liegen zwei Fäden parallel waagerecht und senkrecht wird ein Zwillingsfadenkreuz blasoniert. Sind in beiden Richtungen je drei Fäden zum Kreuz geordnet, ist es ein Drillingsfadenkreuz. Ein mit vier, selten mehr, gekreuzten Fäden gebildetes Kreuz ist dann nicht mehr als Fadenkreuz zu beschreiben, sondern dann ist es ein Gitterkreuz."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
