                    "frequency": "Middle",
                    "semantic_group_id": "reunion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce projet ambitieux <w>cumule</w> plusieurs difficultés techniques et financières imprévues."
                        },
                        {
