                "senses": [
                    {
                        "sense_id": "fac2471d-3703-3cc4-b053-75731de1b5eb",
                        "entry_id": "d70f46f0-e9a1-39ba-a6d7-fe83dd1448c7",
                        "glosses": [
                            "Réduction de la cote, baisse de la valeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2eff459-f50a-4a6d-92d1-f53cbe506c13",
                                "sense_id": "fac2471d-3703-3cc4-b053-75731de1b5eb",
                                "text": "Une restructuration classique peut prendre différentes formes en pratique : décote sur la valeur faciale des obligations, baisse des taux d'intérêt, allongement de la maturité, conversion en un autre actif."
                            },
                            {
                                "example_id": "932700a0-230f-4683-aec9-25c85135a5e3",
                                "sense_id": "fac2471d-3703-3cc4-b053-75731de1b5eb",
                                "text": "Le Canada n’est pas au bord d’une décote."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbb42af7-0743-321b-9790-db86aa2e6413",
                        "entry_id": "d70f46f0-e9a1-39ba-a6d7-fe83dd1448c7",
                        "glosses": [
                            "Réduction du niveau d’une pension du fait que le salarié prend sa retraite avant un âge minimum sans avoir le nombre d’annuités requis."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f5460ca9-0ae8-3b00-b58c-75d194e026dd",
                        "entry_id": "d70f46f0-e9a1-39ba-a6d7-fe83dd1448c7",
                        "glosses": [
                            "Abaissement irrégulier du niveau de la mer due à l’action des éléments météorologiques, vents et champ de pression atmosphérique, sur les eaux marines."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b3a4b07-7a46-40f9-b522-9e53fbe85912",
                        "source_entry_id": "d70f46f0-e9a1-39ba-a6d7-fe83dd1448c7",
                        "target_lang_word": "Wertverlust",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wertverlust",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5bad0e4-dc3a-399a-b0bf-be4bde3999bc",
                                        "entry_id": "702a7517-765d-3f2e-8b14-e593f149c7a1",
                                        "glosses": [
                                            "Verlieren an (materiellem) Wert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89b3d262-36dc-4b15-8256-46af38107eea",
                                                "sense_id": "d5bad0e4-dc3a-399a-b0bf-be4bde3999bc",
                                                "text": "„Da die Inflation vornehmlich den Wertverlust einer Währung widerspiegelt, so sollte eine sichere Währung ohne Wertverlust auch keine Inflation kennen.“"
                                            },
                                            {
                                                "example_id": "eda96ba0-bbe2-4093-a749-8fb1ad452a2e",
                                                "sense_id": "d5bad0e4-dc3a-399a-b0bf-be4bde3999bc",
                                                "text": "„Alle anderen Gebrauchsgüter unterliegen der Abnutzung und damit einem Wertverlust.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fae23c02-2d3c-4a41-8d35-315ca5451062",
                        "source_entry_id": "d70f46f0-e9a1-39ba-a6d7-fe83dd1448c7",
                        "target_lang_word": "Abschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "712efea4-2106-39e0-b39f-4e716acbe975",
                                        "entry_id": "75f4f070-8c83-3a8c-9c9c-d141fa46cec1",
                                        "glosses": [
                                            "Spielen des Balles aus der Hand mit dem Fuß durch den Torwart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e87ca95b-e07e-472b-8aad-e67461a1a63f",
                                                "sense_id": "712efea4-2106-39e0-b39f-4e716acbe975",
                                                "text": "Der Abschlag der Torwarts landete im Seitenaus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1f74269e-ca03-3f3f-bf28-9eafbe7e3253",
                                        "entry_id": "75f4f070-8c83-3a8c-9c9c-d141fa46cec1",
                                        "glosses": [
                                            "ebene Fläche, von der der Golfball zu Beginn einer Bahn ins Spiel gebracht wird"
                                        ],
                                        "tags": [
                                            "Golf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71afcdb0-8de4-4ae9-85cc-96ca809df447",
                                                "sense_id": "1f74269e-ca03-3f3f-bf28-9eafbe7e3253",
                                                "text": "Auf kurzen Spielbahnen (Par 3) müssen die Spieler am Abschlag warten, bis das Grün frei ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7bedb840-7df9-38c9-a94a-7c1917c10dfc",
                                        "entry_id": "75f4f070-8c83-3a8c-9c9c-d141fa46cec1",
                                        "glosses": [
                                            "erster Schlag auf einer Spielbahn (vom Tee)"
                                        ],
                                        "tags": [
                                            "Golf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "348d8976-a75e-4136-9ce5-37ad06b067b7",
                                                "sense_id": "7bedb840-7df9-38c9-a94a-7c1917c10dfc",
                                                "text": "Mit seinem weiten Abschlag hatte er den Mitspielern gut zwanzig Meter abgenommen."
                                            },
                                            {
                                                "example_id": "78711053-7d3e-484f-8902-b75e93c8c413",
                                                "sense_id": "7bedb840-7df9-38c9-a94a-7c1917c10dfc",
                                                "text": "„Bei einem Abschlag am 17. Loch passiert es: Der Ball fliegt über den Platz hinaus, durchschlägt die Frontscheibe eines Kleinwagens, der daraufhin ins Schleudern kommt und einen Schulbus rammt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b931bbad-d3a9-37d9-b8e2-ec489cd5d25c",
                                        "entry_id": "75f4f070-8c83-3a8c-9c9c-d141fa46cec1",
                                        "glosses": [
                                            "Teilzahlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2be6c041-c232-438d-be8d-d00e101cc65a",
                                                "sense_id": "b931bbad-d3a9-37d9-b8e2-ec489cd5d25c",
                                                "text": "Nach Beginn der Arbeiten bekam der Handwerker den ersten Abschlag."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6eab69cc-4a7d-3e09-8c85-2eb1c5ee6bd0",
                                        "entry_id": "75f4f070-8c83-3a8c-9c9c-d141fa46cec1",
                                        "glosses": [
                                            "Reduzierung eines Preises"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26be93b6-c72b-41dc-8c16-6569d1e9aecf",
                                                "sense_id": "6eab69cc-4a7d-3e09-8c85-2eb1c5ee6bd0",
                                                "text": "Auf seinen Angebotspreis machte er noch einen Abschlag von drei Prozent."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "b07099a9-e041-376e-a1d7-19b52caac33d",
                                        "entry_id": "75f4f070-8c83-3a8c-9c9c-d141fa46cec1",
                                        "glosses": [
                                            "Summe der Gebühren, die vor Auszahlung eines Kredites einbehalten werden, also den Kreditbetrag mindern"
                                        ],
                                        "tags": [
                                            "Bankwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9be60517-95cf-4979-a798-000c9aa8f9cb",
                                                "sense_id": "b07099a9-e041-376e-a1d7-19b52caac33d",
                                                "text": "„Wenn bekannt wurde, daß eine Bank nur schwer ihre Verpflichtung – Umtausch der Noten in Edelmetalle oder Münzen – erfüllen konnte, so sank auch der Wert, der Kurs der Noten, unter den aufgedruckten Betrag: sie wurden nur noch mit einem Abschlag – Disagio – in Zahlung genommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "4c4374fa-87f2-3a80-80e1-87a3dcc0c38f",
                                        "entry_id": "75f4f070-8c83-3a8c-9c9c-d141fa46cec1",
                                        "glosses": [
                                            "von Feuerstein oder Geröll abgeschlagenes Teilstück, das als Werkzeug benutzt wurde"
                                        ],
                                        "tags": [
                                            "Archäologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0820aef8-b4dc-47a6-9d6c-2089e7b909c7",
                                                "sense_id": "4c4374fa-87f2-3a80-80e1-87a3dcc0c38f",
                                                "text": "Abschläge wurden von Steinzeitmenschen zu Beilen weiterbearbeitet."
                                            },
                                            {
                                                "example_id": "446c22a6-1b03-46c2-948c-c7054162f67a",
                                                "sense_id": "4c4374fa-87f2-3a80-80e1-87a3dcc0c38f",
                                                "text": "„Typisch für die meist aus Feuerstein und anderen feinkörnigen Gesteinsarten hergestellten Faustkeile ist die durch beiderseitige Abschläge hergestellte dreieckige bis birnenförmige Form.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "b008dc6e-6ac0-3ec9-8278-892ddd37d7b0",
                                        "entry_id": "75f4f070-8c83-3a8c-9c9c-d141fa46cec1",
                                        "glosses": [
                                            "ablehnender Bescheid"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1103c0ac-cb47-4c56-8f2c-8e073270bba3",
                                                "sense_id": "b008dc6e-6ac0-3ec9-8278-892ddd37d7b0",
                                                "text": "„Und doch konnte er die Versuche nicht lassen, sooft er Elsi auf einem Wege traf, dasselbe zum Weine zu laden oder ihm zu sagen, am nächsten Sonntag gehe er dorthin, es solle auch kommen, und allemal ward er böse, daß er einen Abschlag erhielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    },
