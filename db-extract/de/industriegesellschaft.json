                ],
                "senses": [
                    {
                        "sense_id": "0746bb8e-4b94-3ea8-ac38-2ad16ab135cc",
                        "entry_id": "a6b64e8f-8b70-3508-8342-83f267a84813",
                        "glosses": [
                            "Gesellschaft, die vor allem von ihrer Industrie geprägt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de9fd941-1c69-4a5c-8b4f-ae940b281231",
                                "sense_id": "0746bb8e-4b94-3ea8-ac38-2ad16ab135cc",
                                "text": "„In Japan, das als Industriegesellschaft viele Arbeitssüchtige hat, gibt es sogar ein eigenes Wort für den Tod durch Überarbeitung: ‚Karoshi‘.“"
                            },
                            {
                                "example_id": "6e9b5f95-9570-4e24-9027-71ac7358b113",
                                "sense_id": "0746bb8e-4b94-3ea8-ac38-2ad16ab135cc",
                                "text": "„Der Witz hat seinen festen Platz in der modernen Industriegesellschaft der Gegenwart.“"
                            },
                            {
                                "example_id": "23a27b6c-c203-4f54-a9cd-90c2f88fcbe5",
                                "sense_id": "0746bb8e-4b94-3ea8-ac38-2ad16ab135cc",
                                "text": "„Als die moderne Industriegesellschaft noch jung war, entbrannte ein Unternehmerkrieg um ihre Elektrifizierung.“"
                            },
                            {
                                "example_id": "ac1ee20c-7dff-42b3-a181-069dc5f06665",
                                "sense_id": "0746bb8e-4b94-3ea8-ac38-2ad16ab135cc",
                                "text": "„Jedesmal, wenn die Treibstoffpreise hochschnellen, gerät pflanzliches Material ins Blickfeld der auf Mobilität angewiesenen Industriegesellschaft.“"
                            },
                            {
                                "example_id": "cad4248e-aff9-4620-9134-5e4932548a26",
                                "sense_id": "0746bb8e-4b94-3ea8-ac38-2ad16ab135cc",
                                "text": "„Der Sozialstaat folge aber weiterhin der Schablone der Industriegesellschaft und der traditionellen ‚Normalarbeit‘, kritisiert die FDP: Wer aus Festanstellung in die Selbständigkeit wechsle, ‚dem signalisiert die Politik bisher durch viele Regelungen bestenfalls Skepsis‘.“"
                            },
                            {
                                "example_id": "8fac4687-93ef-4e2a-87b3-96360f49addb",
                                "sense_id": "0746bb8e-4b94-3ea8-ac38-2ad16ab135cc",
                                "text": "„Die Fleischerzeugung für die moderne Industriegesellschaft ist ein auf Effizienz getrimmtes Massengeschäft.“"
                            },
                            {
                                "example_id": "395947fc-4f0c-44e7-a1ce-1dd3cdb2d398",
                                "sense_id": "0746bb8e-4b94-3ea8-ac38-2ad16ab135cc",
                                "text": "„Außerdem konzentrieren sich mehr als 90 Prozent der Jungen noch immer auf technische und handwerkliche Berufe, die für die Industriegesellschaft typisch sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
