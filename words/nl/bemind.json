                            "target_lang_translations": {
                                "en": "She has always <w>loved</w> her partner passionately and faithfully.",
                                "ru": "Она всегда пылко и верно <w>любила</w> своего партнёра."
                            }
                        },
                        {
                            "text": "Hij werd door het hele volk om zijn wijsheid <w>bemind</w>.",
                            "target_lang_translations": {
