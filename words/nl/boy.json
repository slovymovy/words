                {
                    "sense_id": "7a5a1479-8e7f-3dc9-8547-60cc8e287ef3",
                    "sense_definition": "Jongen of jonge man.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jongen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vind die Roy echt een rare <w>boy</w>.",
                            "target_lang_translations": {
                                "zh": "我觉得那个罗伊真是个古怪的<w>家伙</w>。"
                            }
                        },
                        {
                            "text": "Hij is een slimme <w>boy</w> die precies weet wat hij wil bereiken.",
                            "target_lang_translations": {
                                "zh": "他是个聪明的<w>小伙子</w>，非常清楚自己想达到什么目标。"
                            }
