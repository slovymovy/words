                ],
                "senses": [
                    {
                        "sense_id": "b15dc2d8-8b1b-33cb-b2e2-9a58ad1f59de",
                        "entry_id": "14168b36-103c-3ef4-b521-97f84f28ac85",
                        "glosses": [
                            "Dach eines Erweiterungsbaus (beispielsweise einer Garage, eines weiteren Raums), das direkt an das bestehende Dach anschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79ffbf53-727b-4251-9fcf-ca6290585a5b",
                                "sense_id": "b15dc2d8-8b1b-33cb-b2e2-9a58ad1f59de",
                                "text": "„Und da haben wir da unten die Getreidehalle gebaut und hier oben das Schleppdach als Maschinen-Unterstand.“"
                            },
                            {
                                "example_id": "59a92511-da6d-47f0-8065-37c396fa8619",
                                "sense_id": "b15dc2d8-8b1b-33cb-b2e2-9a58ad1f59de",
                                "text": "„Vor der Mitte der Westwand steht ein runder Treppenturm, an den ein Anbau mit Schleppdach angefügt ist.“"
                            },
                            {
                                "example_id": "d98cf6ed-f3cc-4e38-bc74-2ae1a6a01a44",
                                "sense_id": "b15dc2d8-8b1b-33cb-b2e2-9a58ad1f59de",
                                "text": "„Unter dem heutigen Schleppdach der erhöhten Sakristei hat sich die Ostfassade dieser Kapelle in fast baufrischem Zustand erhalten,“ […]."
                            },
                            {
                                "example_id": "d2be4c82-f82d-420f-bba3-77f87d4caef5",
                                "sense_id": "b15dc2d8-8b1b-33cb-b2e2-9a58ad1f59de",
                                "text": "„Auf dem alten Kasernengelände haben Stroh, Maschinen- und Fahrzeugteile unter einem Schleppdach Feuer gefangen. Die Brandursache ist noch unklar.“"
                            },
                            {
                                "example_id": "ccdc26e3-7383-4a63-98d9-7caf086aa4e5",
                                "sense_id": "b15dc2d8-8b1b-33cb-b2e2-9a58ad1f59de",
                                "text": "„Das Feuer war am Samstagabend in einem großen Strohlager ausgebrochen, das unter einem Schleppdach lag, wo es vor Feuchtigkeit geschützt wurde. Dieses Schleppdach grenzte unmittelbar an den 60 Meter langen und mehr als 20 Meter breiten Stall.“"
                            },
                            {
                                "example_id": "39bde2c6-1fee-4125-ae27-3944baa5f2f0",
                                "sense_id": "b15dc2d8-8b1b-33cb-b2e2-9a58ad1f59de",
                                "text": "„Die rechteckige Sakristei an der Chornordseite wurde 1590 angebaut und ist mit dem Schleppdach des Chors bedeckt.“"
                            },
                            {
                                "example_id": "1899998d-f9f0-4617-813a-414d55206a28",
                                "sense_id": "b15dc2d8-8b1b-33cb-b2e2-9a58ad1f59de",
                                "text": "„Der Architekt Gottfried Böhm entwarf im Industriestil einen originellen Kirchenbau mit Schleppdach, dessen Schiff von 42 × 15 Metern 13 Meter hoch ist.“"
                            },
                            {
                                "example_id": "f41049a2-21cb-4019-b33c-d244274189c5",
                                "sense_id": "b15dc2d8-8b1b-33cb-b2e2-9a58ad1f59de",
                                "text": "„»Es gibt andererseits Einfamilienhäuser von uns mit tief heruntergezogenem Schleppdach und Ziegelmauer-Geborgenheit.«“"
                            },
                            {
                                "example_id": "fa83b920-3ce5-41ee-aec9-be775524ca18",
                                "sense_id": "b15dc2d8-8b1b-33cb-b2e2-9a58ad1f59de",
                                "text": "„Ein Schleppdach eines Transportunternehmens eignet sich sehr gut, um den Pick- Up unauffällig zwischen zwei Lastwagen zu parken.“"
                            },
                            {
                                "example_id": "25ee7043-5c6b-4819-8f03-f2d44a0c11d2",
                                "sense_id": "b15dc2d8-8b1b-33cb-b2e2-9a58ad1f59de",
                                "text": "„In unmittelbarer Nachbarschaft des Stadions stand ein großer Schuppen, unter dessen Schleppdach die Kinder einen Haufen an der Bretterwand geparkter Tretroller entdeckten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
