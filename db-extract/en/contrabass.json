                                        "sense_id": "0c4f6637-05a4-3925-8ed8-10b007b3bb0e",
                                        "entry_id": "30c4a4d2-3aff-38d6-8898-2d7c05d98973",
                                        "glosses": [
                                            "het laagstklinkende muziekinstrument van de strijkinstrumenten met een lagere toon dan de bas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ab73ff-47bd-42e3-8d89-424bb77cc0de",
                                                "sense_id": "0c4f6637-05a4-3925-8ed8-10b007b3bb0e",
                                                "text": "Niek de Groot is voor het eerst met de contrabas te horen tijdens een concerttournee met violiste Liza Ferschtman. Vanaf 9 april treedt hij op in Enschede, Heerlen, Groningen, Leiden, Haarlem en Nijmegen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af909c3c-99dd-4939-963b-61f373077371",
                        "source_entry_id": "d13296cc-b0a7-3280-bde5-00267fd0dd2c",
                        "source_sense_description": "part or section one octave lower than bass",
                        "target_lang_word": "contrebasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrebasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5021d981-bf56-3a08-b741-9978053c3e9e",
                                        "entry_id": "1e2aeff9-6ed7-3647-b451-f9b9220599a0",
                                        "glosses": [
                                            "Le plus grand et le plus grave des instruments à cordes qui sonne une octave au-dessous de la basse ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41bef070-aa89-4f98-be7d-041e8008f244",
                                                "sense_id": "5021d981-bf56-3a08-b741-9978053c3e9e",
                                                "text": "Elle sera accompagnée par les musiciens de la compagnie Du souffle aux cordes Philippe Pouchard à la guitare, Marc Estrade à la guitare et au banjo et Jérôme Gast à la contrebasse."
                                            },
                                            {
                                                "example_id": "9e19937c-d779-405d-b78e-c4a1ca73d5f3",
                                                "sense_id": "5021d981-bf56-3a08-b741-9978053c3e9e",
                                                "text": "L’Opéra de Chicago commanda, en 1905, une contrebasse géante au luthier allemand Otto Roth, de Markneukirchen."
                                            },
                                            {
                                                "example_id": "b45bf917-a3cb-45d5-826b-d1bd90ef1d78",
                                                "sense_id": "5021d981-bf56-3a08-b741-9978053c3e9e",
                                                "text": "La contrebasse, c’est la modestie dans la force et dans la puissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c136acbe-d067-362a-b0af-d79bc08a4cb5",
                                        "entry_id": "1e2aeff9-6ed7-3647-b451-f9b9220599a0",
                                        "glosses": [
                                            "Dans un ensemble ou un orchestre, musicien qui joue de cet instrument."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a18bc899-1d3e-4fd6-b8bb-4bd672fd3816",
                                                "sense_id": "c136acbe-d067-362a-b0af-d79bc08a4cb5",
                                                "text": "Il y a quatre contrebasses, huit contrebasses dans cet orchestre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31adf96d-2afc-3dec-9dd5-1a391e457e2b",
                                        "entry_id": "1e2aeff9-6ed7-3647-b451-f9b9220599a0",
                                        "glosses": [
                                            "Voix d’homme qui est la plus basse de toutes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31aaec55-fc7c-4dc8-93e5-119157357f3b",
                                                "sense_id": "31adf96d-2afc-3dec-9dd5-1a391e457e2b",
                                                "text": "Une voix de contrebasse ou, simplement, une contrebasse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "386e35be-f877-40d9-ae25-0c62065f29ae",
                        "source_entry_id": "d13296cc-b0a7-3280-bde5-00267fd0dd2c",
                        "source_sense_description": "part or section one octave lower than bass",
                        "target_lang_word": "Kontrabass",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kontrabass",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d925550-b072-3954-9809-0b5e4bcd3912",
                                        "entry_id": "bbef6391-fc44-30de-af8e-f359ab72a95b",
                                        "glosses": [
                                            "größtes und tiefstes der heute im Orchester verwendeten Streichinstrumente"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ebc50b8-e8ee-40a9-8693-a4cc720e50ef",
                                                "sense_id": "0d925550-b072-3954-9809-0b5e4bcd3912",
                                                "text": "„Zwar ist der Kontrabass ein Orchester-Instrument und dient dort den Streichern als Fundament. Dennoch ist auf ihm Virtuosität entwickelt worden. Sogar Doppelgriffe und Flageolett sind möglich.“"
                                            },
                                            {
                                                "example_id": "e9cecbe6-ad15-45c8-9f6c-9c7d71d11f4f",
                                                "sense_id": "0d925550-b072-3954-9809-0b5e4bcd3912",
                                                "text": "Mit Kontrabass und Gitarre tourt er [Reinhard Röhrs] durch Deutschland und rezitiert Texte von Christian Morgenstern."
                                            },
                                            {
                                                "example_id": "0dc21e7d-1988-4ef8-a1eb-e9670ad5ab60",
                                                "sense_id": "0d925550-b072-3954-9809-0b5e4bcd3912",
                                                "text": "„Im zweiten Akt stellten die bemalten Kartons Grabmonumente vor, und in der Leinwand war ein Loch, das den Mond bedeutete, und das Rampenlicht war durch Schirme abgedämpft, und die Trompeten und Kontrabässe gaben dumpfe Basstöne von sich, und von rechts und links kam eine Menge von Menschen in schwarzen Mänteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cb4b572-c673-4d7c-8d65-ac34f9e4ba54",
                        "source_entry_id": "d13296cc-b0a7-3280-bde5-00267fd0dd2c",
                        "source_sense_description": "part or section one octave lower than bass",
