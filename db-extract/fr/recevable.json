                                    },
                                    {
                                        "sense_id": "39f67e22-5f83-3500-add2-8e911fdfbb48",
                                        "entry_id": "6d734766-0a24-3634-9124-a6ed090c43be",
                                        "glosses": [
                                            "Barely worthy, less than excellent; passable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b024a8-e353-41a1-a135-1340abd07d93",
