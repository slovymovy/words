                        "glosses": [
                            "van haar dat het een grijze kleur krijgt, meestal als teken van ouderdom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "055cbb9d-d07e-4ca0-9919-d0864c880724",
                                "sense_id": "a7b62ec4-12c1-3855-8e12-8a9705e9cb2e",
                                "text": "Wat is dat toch met grijzende mannen?: Weinigen kennen hem, de nieuwe Zomergastenpresentator Jan Leyers. Maakt niet uit: hij is een lekker ding. Want mooi grijs. HP de Tijd 08/05"
                            },
                            {
                                "example_id": "79ffb0b4-af09-4ee3-bfa9-9be8e4d6f2e5",
                                "sense_id": "a7b62ec4-12c1-3855-8e12-8a9705e9cb2e",
                                "text": "Jan Versteegh heeft tijdens zijn vakantie in Spanje twee vrienden voor het leven gemaakt: een grijzende ezel en een wat klein uitgevallen paard."
                            },
                            {
                                "example_id": "c1b5bf87-815a-4ee3-9886-e20896bfb35b",
                                "sense_id": "a7b62ec4-12c1-3855-8e12-8a9705e9cb2e",
                                "text": "Toen de kleine, grijzende Pool het woord kreeg van rechtbankpresident Bert Stoové, zei hij via de tolk: \"Ik werd geslagen, voor hun eigen plezier.\""
                            }
                        ]
                    }
