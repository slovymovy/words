                    {
                        "sense_id": "814991ec-39d4-35dc-bd1d-749613900557",
                        "entry_id": "a2d99bd2-afa7-33cb-9c74-0511355171a0",
                        "glosses": [
                            "iemand die een bepaald geloof aanhangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7689e870-8d89-40ad-aa2f-1c62246b2c31",
                                "sense_id": "814991ec-39d4-35dc-bd1d-749613900557",
                                "text": "De gelovigen stonden voor de kerk te wachten op de dienst."
                            },
                            {
                                "example_id": "63b79b05-9673-470c-81aa-aa928cf6cbcf",
                                "sense_id": "814991ec-39d4-35dc-bd1d-749613900557",
                                "text": "De gelovigen stonden te wachten op de handlezer."
                            },
                            {
                                "example_id": "e62f6077-7a94-47a6-8606-dc1f10db16dc",
                                "sense_id": "814991ec-39d4-35dc-bd1d-749613900557",
                                "text": "Duizenden gelovigen staan in de Italiaanse stad Padua in de rij om een glimp op te vangen van de relikwieën van de heilige Antonius. Het skelet is voor het eerst sinds 1981 weer van dichtbij te zien voor het publiek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e836fce-9b32-4b08-b888-40d3121c2044",
                        "source_entry_id": "a2d99bd2-afa7-33cb-9c74-0511355171a0",
                        "source_sense_id": "814991ec-39d4-35dc-bd1d-749613900557",
                        "source_sense_description": "iemand die een bepaald geloof aanhangt",
                        "target_lang_word": "Gläubige",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gläubige",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4791f9d3-2a19-3a13-a307-ed0b65ddef86",
                                        "entry_id": "bba50a4d-18e9-3350-850e-52cedab5c386",
                                        "glosses": [
                                            "weibliche Person, die gläubig ist"
                                        ],
                                        "tags": [
                                            "Glaube"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24800422-fd19-42d3-8138-fc637ac97f09",
                                                "sense_id": "4791f9d3-2a19-3a13-a307-ed0b65ddef86",
                                                "text": "„Die Sonne bestimmt in großem Maße das Alltagsleben auch der Gläubigen, richtet sich doch der Zeitpunkt der täglichen fünf Gebete nach dem Auf- und Untergang des Gestirns aus.“"
                                            },
                                            {
                                                "example_id": "3ffff20f-437b-447d-aa74-17429c1344d0",
                                                "sense_id": "4791f9d3-2a19-3a13-a307-ed0b65ddef86",
                                                "text": "Trotzdem war mir klar, dass ich das nicht suche, denn es berührte vielleicht die Künstlerin in mir, aber nicht die Gläubige."
                                            },
                                            {
                                                "example_id": "f788aa0d-ffa6-4c24-aead-683714de9910",
                                                "sense_id": "4791f9d3-2a19-3a13-a307-ed0b65ddef86",
                                                "text": "„Nichts wird ihnen etwa kleinlich motiviert, es steht einfach »ce qu'il vous faut pour cet hiver«, oder »à Paris la femme porte…«, oder »Lancé au printemps par quelques jeunes femmes de la société parisienne…«. Es ist ein Zwang stärkster Art, da er nicht als Gewalt bewußt wird, sondern als selbstverständliche Notwendigkeit. Und wehe, wenn eine Gläubige sich nicht fügt oder nicht fügen kann: sie fühlt sich ausgestoßen, gezeichnet, denn sie weiß wohl, daß jede Kollektivgenossin den Verrat sofort bemerkt. Für die Esoterischen ist der Zwang viel kleiner: sie dürfen sich manche Neuerung erlauben, die erst nachträglich im denkkollektiven Verkehr zum Zwange wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
