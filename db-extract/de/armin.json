                "senses": [
                    {
                        "sense_id": "61d08e96-a6ac-38bc-8f7c-04c83cc9cce9",
                        "entry_id": "7d5c12d4-2067-3323-8e5c-defc7c7d3d5b",
                        "glosses": [
                            "Männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6783889e-329c-4749-a169-0a193a452508",
                                "sense_id": "61d08e96-a6ac-38bc-8f7c-04c83cc9cce9",
                                "text": "Armin konnte einfach alles."
                            },
                            {
                                "example_id": "03146715-920d-4da9-b343-f597463343bb",
                                "sense_id": "61d08e96-a6ac-38bc-8f7c-04c83cc9cce9",
                                "text": "Hätte seine Meinung Boden in seinem Volke gefunden und seine Kühnheit Nacheiferer, so wäre ihm der Ruhm des Cheruskerfürsten Armin gegen die Römer unter Varus zugefallen."
                            },
                            {
                                "example_id": "845a7df6-f833-4fa0-8a4e-cef4a1b49bd5",
                                "sense_id": "61d08e96-a6ac-38bc-8f7c-04c83cc9cce9",
                                "text": "Donnernd und polternd lachte der große Schauspieler Armin Horch auf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
