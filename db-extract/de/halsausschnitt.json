                        "source_sense_id": "d30df27f-f52a-38e1-a894-720ea2d2a3d9",
                        "source_sense_description": "Kleidung: Öffnung bei Oberteilen, die für den Hals bestimmt ist",
                        "target_lang_word": "encolure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encolure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af84a3f4-764d-3330-994a-576ab4331c1f",
                                        "entry_id": "ed7672aa-7456-39ef-96cb-8ac22acddeed",
                                        "glosses": [
                                            "Partie du corps qui s’étend, chez un animal, depuis la tête jusqu’aux épaules et au poitrail."
                                        ],
                                        "tags": [
                                            "Hippologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45be9b9f-ebfb-4a76-bc91-f0cfe23760e7",
                                                "sense_id": "af84a3f4-764d-3330-994a-576ab4331c1f",
                                                "text": "Bientôt le Sultan arrive; les tambours battent, les clairons sonnent aux champs; les fantassins présentent les armes et les cavaliers s’inclinent sur l’encolure de leurs chevaux en criant."
                                            },
                                            {
                                                "example_id": "5f14963f-3e11-443d-871b-232befd2d489",
                                                "sense_id": "af84a3f4-764d-3330-994a-576ab4331c1f",
                                                "text": "Les femmes « youyoutèrent » à gorge déployée, et nous échangeâmes congratulations et compliments, l’un flattant l’encolure du mulet, notre héros, l’autre exagérant les mérites du conducteur bédouin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "070b933c-a4be-3aee-a32b-bdd0ba6751b2",
                                        "entry_id": "ed7672aa-7456-39ef-96cb-8ac22acddeed",
                                        "glosses": [
                                            "Même partie chez l’humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d0cbca-bb42-4c82-b926-b04441ffbbc2",
                                                "sense_id": "070b933c-a4be-3aee-a32b-bdd0ba6751b2",
                                                "text": "C’est un bel homme bien en chair, élégant en effet, quoique de massive encolure, avec de larges épaules, des joues pleines, de beaux yeux noirs caressans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63f6d2e2-4326-3ed0-be56-95437cd59571",
                                        "entry_id": "ed7672aa-7456-39ef-96cb-8ac22acddeed",
                                        "glosses": [
                                            "Partie d’un vêtement qui entoure le cou."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "255ae9f7-d9b5-44bc-8e7c-9d30666c6ae1",
                                                "sense_id": "63f6d2e2-4326-3ed0-be56-95437cd59571",
                                                "text": "L’encolure d’une chemise, d’un pardessus."
                                            },
                                            {
                                                "example_id": "6a30d188-b6de-456e-9d34-3a7690c5418f",
                                                "sense_id": "63f6d2e2-4326-3ed0-be56-95437cd59571",
                                                "text": "J’achetai un bouquet de violettes que j’épinglai à l’encolure de ma robe ; j’eus du mal à les attacher et dans mon impatience, je perdis mon sac à main."
                                            },
                                            {
                                                "example_id": "7dca1ede-8e03-4f46-9dcf-1275336f4ebf",
                                                "sense_id": "63f6d2e2-4326-3ed0-be56-95437cd59571",
                                                "text": "Anne Desbaresdes releva ses mains vers son cou nu dans l’encolure de sa robe d’été."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd5097c6-477f-3402-b9d2-acc8f299a0b5",
                                        "entry_id": "ed7672aa-7456-39ef-96cb-8ac22acddeed",
                                        "glosses": [
                                            "Air, apparence."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d060c8c-7f86-4da3-abbc-6bcf858f6a43",
                                                "sense_id": "fd5097c6-477f-3402-b9d2-acc8f299a0b5",
                                                "text": "Il a l’encolure d’un sot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
