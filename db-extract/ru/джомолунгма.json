                ],
                "senses": [
                    {
                        "sense_id": "7b272281-4b77-3c19-9de5-3771de865e3a",
                        "entry_id": "ca31c222-9e07-3dc0-8548-bedcc996304b",
                        "glosses": [
                            "геогр. то же, что Эверест; высочайшая горная вершина Земли"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d3d7878-5d5c-4e17-ae38-a3a44c45af73",
                                "sense_id": "7b272281-4b77-3c19-9de5-3771de865e3a",
                                "text": "Белизна лица девушки сравнивается со снегом Гауришанкара, а сила юноши ― с твердостью скал, окружающих вершину Джомолунгму."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d39588c3-b27e-4942-89b2-dc8392cf184b",
                        "source_entry_id": "ca31c222-9e07-3dc0-8548-bedcc996304b",
                        "source_sense_id": "7b272281-4b77-3c19-9de5-3771de865e3a",
                        "target_lang_word": "Chomolungma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chomolungma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d851163f-213e-35a1-8d88-c5e172c518c4",
                                        "entry_id": "9efd436b-248b-3c08-95a2-99a7e3196925",
                                        "glosses": [
                                            "Mount Everest."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e39bd05-de05-4dc9-9176-5e36d04c98b3",
                                                "sense_id": "d851163f-213e-35a1-8d88-c5e172c518c4",
                                                "text": "The lamas told many stories of the terror of the snows—of gods and demons and creatures far worse than yetis, who guarded the heights and would bring doom to any man who ventured there. But I knew that men, and among them my own people, had climbed high on the other side of Chomolungma, and, though some had been killed, more had returned alive."
                                            },
                                            {
                                                "example_id": "c5f23b81-69ea-4359-98b9-f6187694b038",
                                                "sense_id": "d851163f-213e-35a1-8d88-c5e172c518c4",
                                                "text": "Ironically, already Chomolungma herself is showing signs of wear ."
                                            },
                                            {
                                                "example_id": "c3e3a6b6-f21b-407d-86b8-f9ac3a52b35d",
                                                "sense_id": "d851163f-213e-35a1-8d88-c5e172c518c4",
                                                "text": "That is not to say that I don't think anything needs to be done for Chomolungma's environment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
