                        "glosses": [
                            "Raum in Krankenhäusern und Arztpraxen, der über die für Operationen nötige Ausstattung verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24b8f8a2-36cf-4cc1-a10d-cbd056c6d9c3",
                                "sense_id": "0d4f2184-d5c4-3269-a8e4-ce21f9490aa4",
                                "text": "„Aus dem OP-Saal beobachtet Mößmer, wie der Hubschrauber inmitten der Berg-Schnee-Tannen-Kulisse vor der Klinik landet.“"
                            },
                            {
                                "example_id": "d4f55420-c71b-456a-a1e7-43d55a8a14d1",
                                "sense_id": "0d4f2184-d5c4-3269-a8e4-ce21f9490aa4",
                                "text": "„Unser OP-Saal ist zufällig nur den Gang hinunter.“"
                            }
                        ],
