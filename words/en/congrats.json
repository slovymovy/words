{
    "word_family": [
        "congratulate",
        "congratulation",
        "congratulatory"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "5e7e91cc-7b0c-37ae-ab0b-b2cb227e794f",
                    "sense_definition": "Short for <w>congratulations</w>; used to express praise or pleasure at someone's success or good fortune.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard you got the new job, so <w>congrats</w>!",
                            "target_lang_translations": {
                                "ru": "Я слышал, ты получил новую работу, так что <w>поздравляю</w>!",
                                "zh": "听说你找到新工作了，<w>恭喜</w>！"
                            }
                        },
                        {
                            "text": "<w>Congrats</w> on finishing the marathon in such good time.",
                            "target_lang_translations": {
                                "ru": "<w>Поздравляю</w> с завершением марафона с таким хорошим временем.",
                                "zh": "<w>恭喜</w>你以这么好的成绩跑完了马拉松。"
                            }
                        }
                    ],
                    "synonyms": [
                        "well done",
                        "congratulations"
                    ],
                    "common_phrases": [
                        "congrats on",
                        "huge congrats",
                        "big congrats"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от 'congratulations'; используется для выражения похвалы или радости по поводу чьего-либо успеха или удачи.",
                        "zh": "“Congratulations”的缩写，用于表达对他人的成功或好运的赞赏或喜悦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поздравляю",
                                "target_lang_sense_clarification": "междометие"
                            },
                            {
                                "target_lang_word": "мои поздравления",
                                "target_lang_sense_clarification": "фраза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恭喜",
                                "target_lang_sense_clarification": "用于口语的祝贺"
                            },
                            {
                                "target_lang_word": "祝贺你",
                                "target_lang_sense_clarification": "表达祝贺的常用短语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f0126e1-a5b8-3d86-a64e-d1840b6276cf",
                    "sense_definition": "Short for <w>congratulations</w>; expressions of praise or good wishes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please accept our <w>congrats</w> for all your hard work on the project.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, примите наши <w>поздравления</w> за вашу усердную работу над проектом.",
                                "zh": "请接受我们对你在这个项目中辛勤工作的<w>祝贺</w>。"
                            }
                        },
                        {
                            "text": "She sent her <w>congrats</w> to the happy couple after the wedding.",
                            "target_lang_translations": {
                                "ru": "Она передала свои <w>поздравления</w> счастливой паре после свадьбы.",
                                "zh": "婚礼结束后，她向这对幸福的新人送去了<w>祝贺</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "send congrats",
                        "my congrats"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от 'congratulations'; выражения похвалы или добрых пожеланий.",
                        "zh": "“Congratulations”的缩写，指对他人的赞美或良好祝愿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поздравления",
                                "target_lang_sense_clarification": "существительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "祝贺",
                                "target_lang_sense_clarification": "名词，指祝贺的话语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
