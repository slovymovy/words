                        ],
                        "examples": [
                            {
                                "example_id": "fee974e3-3417-4987-8295-442abd85c527",
                                "sense_id": "bd75e9b7-4cb7-3778-8969-a1b0cb031194",
                                "text": "Po śmierci Odysa Penelopa pośłubiła Telegonosa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99579a34-c4a4-4c9e-b140-2db63c072162",
                        "source_entry_id": "b25e3a01-0adb-39fa-839e-988c5a990b99",
                        "source_sense_id": "bd75e9b7-4cb7-3778-8969-a1b0cb031194",
                        "target_lang_word": "Penelope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Penelope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e25731fc-3362-34b3-8ccd-dc7a67d682dc",
                                        "entry_id": "75708cf8-f7b3-3b1c-aeb2-86e59878cc40",
                                        "glosses": [
                                            "The faithful wife of Odysseus."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c73847ac-574d-48f0-b5f9-39114ddc2ed5",
                                                "sense_id": "e25731fc-3362-34b3-8ccd-dc7a67d682dc",
                                                "text": "You would be another Penelope; yet, they say, all the yarn she spun in Ulysses' absence did but fill Ithaca with moths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7561eb27-27b9-3450-b4eb-1fc17ddb901a",
                                        "entry_id": "75708cf8-f7b3-3b1c-aeb2-86e59878cc40",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f300bb8b-5ca4-4945-a6a5-7da3c9e96028",
                                                "sense_id": "7561eb27-27b9-3450-b4eb-1fc17ddb901a",
                                                "text": "\"She's a sort of pretend auntie - an old friend of Mummy's. Her real name's Miss Penelope Gill but we always call her Gillie.\"\n\"Don't you ever let her hear you calling her Penelope!\" said Mrs Lindsay, laughing. \"She hates the name, though really I can't see why. I suppose it wasn't so fashionable when she was young.\""
                                            },
                                            {
                                                "example_id": "ec850d1a-531a-44d8-93f7-feacd6c8e372",
                                                "sense_id": "7561eb27-27b9-3450-b4eb-1fc17ddb901a",
                                                "text": "\"What's her name?\" He meant the baby's. \"Penelope. We're never going to call her Penny. Penelope.\" - - - \"\"Oh. Well, it's Penelope Henderson - Porteous I guess. Or Porteous - Henderson. But maybe that's too much of a mouthful, when she's already called Penelope? We knew that we wanted Penelope. We'll have to settle it somehow.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b644044-a082-3550-97be-d4249096410a",
                                        "entry_id": "75708cf8-f7b3-3b1c-aeb2-86e59878cc40",
                                        "glosses": [
                                            "A town in Texas."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c8236c7-7110-4846-9220-cff0098c76b8",
                        "source_entry_id": "b25e3a01-0adb-39fa-839e-988c5a990b99",
                        "source_sense_id": "bd75e9b7-4cb7-3778-8969-a1b0cb031194",
                        "target_lang_word": "Pénélope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pénélope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73a6fa46-d763-3e13-ad4a-4810d9ebbe4e",
                                        "entry_id": "77c6f3e1-1f4f-3e61-837e-232e699849b4",
                                        "glosses": [
                                            "Personnage de la mythologie grecque, épouse d’Ulysse dont elle a un fils, Télémaque."
                                        ],
                                        "tags": [
                                            "Anthroponyme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37820db8-fe2d-42be-a3c6-28e9269738cd",
                                                "sense_id": "73a6fa46-d763-3e13-ad4a-4810d9ebbe4e",
                                                "text": "20 octobre 1940 – Il y a un Ulysse dans chaque homme et ils ne cessent de s’étonner quand on s’essaie à ne pas jouer les Pénélope."
                                            },
                                            {
                                                "example_id": "80e6f9fc-adff-4b8d-b8f1-e78f4f97ae69",
                                                "sense_id": "73a6fa46-d763-3e13-ad4a-4810d9ebbe4e",
                                                "text": "C’est au chant I : parce que la sage Pénélope a demandé à l’aède de cesser de jouer, elle se fait rabrouer devant les prétendants par son fils, Télémaque, et ordonner sans ambages de retourner dans ses appartements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "221dc2eb-d970-32c4-835d-95b1bf1dd78a",
                                        "entry_id": "77c6f3e1-1f4f-3e61-837e-232e699849b4",
                                        "glosses": [
                                            "Nymphe de la mythologie grecque, mère de Pan."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c69e0e3f-7aa4-3e74-9b14-29ea2f22571b",
                                        "entry_id": "77c6f3e1-1f4f-3e61-837e-232e699849b4",
                                        "glosses": [
                                            "(Par antonomase) Femme fidèle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dbabf21-2dde-4086-972a-83bf3fb801bf",
                                                "sense_id": "c69e0e3f-7aa4-3e74-9b14-29ea2f22571b",
                                                "text": "C’est une Pénélope."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Pénélope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "137c8e36-8570-3138-b8cb-7f4045c91df0",
                                        "entry_id": "c3af9007-c4ad-34db-8e1f-ac9115028ff1",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4029eb3-2ed1-4a38-82ec-10b1869a0c16",
                                                "sense_id": "137c8e36-8570-3138-b8cb-7f4045c91df0",
                                                "text": "« Nous réfléchissons, par exemple, à l’idée des carrières de la capitale », commente Pénélope Komitès, adjointe chargée de la prospective Paris 2030 et de la résilience."
                                            },
                                            {
                                                "example_id": "7a834f6a-0951-44f1-a981-8e7938b58d7f",
                                                "sense_id": "137c8e36-8570-3138-b8cb-7f4045c91df0",
                                                "text": "La bande dessinée fait son entrée à la Comédie-Française avec Culottées, de Pénélope Bagieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
