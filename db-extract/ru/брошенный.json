                        ],
                        "examples": [
                            {
                                "example_id": "dfd4565c-a32c-47e1-8c8c-3c54c094dc7b",
                                "sense_id": "7ea28e3c-97ab-3e02-8bfb-a71d8c08950b",
                                "text": "Затем подошел к столбу с телекамерой и взмахнул правой рукой: метко брошенный свинцовый грузик сбил мертвую мышь, и Савелий устремился к грузовику, срывая на ходу с себя ненужный уже комбинезон."
                            }
                        ]
                    },
