                        "source_entry_id": "5ff12934-3f1d-3844-8b6c-eb7533123124",
                        "source_sense_id": "893ad553-fb6b-3867-851c-3326409895c9",
                        "source_sense_description": "the act of involving or state of being involved",
                        "target_lang_word": "betrokkenheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "betrokkenheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "453ef6ed-5274-31e6-8d1f-ed32565de2a2",
                                        "entry_id": "4880b875-4761-3c7b-bf7a-99c799842a93",
                                        "glosses": [
                                            "het bij iets betrokken zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13edb463-c8f4-40b5-8418-7319de56a5ac",
                                                "sense_id": "453ef6ed-5274-31e6-8d1f-ed32565de2a2",
                                                "text": "Ik heb geen betrokkenheid hierbij."
                                            },
                                            {
                                                "example_id": "b7367d34-2185-4b53-9c4e-b7542345f704",
                                                "sense_id": "453ef6ed-5274-31e6-8d1f-ed32565de2a2",
                                                "text": "De controversiële betrokkenheid van Musk bij de regering van Trump, de openlijke steun van de techmiljardair aan de extreemrechtse partij AfD in Duitsland en een vermeende Hitlergroet van Musk na de inauguratie van Trump, hebben veel Tesla-eigenaren in verlegenheid gebracht"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3ee5783-7635-31ea-8aed-4a9ae118eb3e",
                                        "entry_id": "4880b875-4761-3c7b-bf7a-99c799842a93",
                                        "glosses": [
                                            "medeplichtig zijn aan iets strafbaars"
                                        ],
                                        "tags": [
                                            "pregnant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00f2903c-4252-4657-83af-fee7b27001d7",
                                                "sense_id": "e3ee5783-7635-31ea-8aed-4a9ae118eb3e",
                                                "text": "Hij zit een celstraf uit voor betrokkenheid bij de invoer van drugs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fdab479-7fd9-35fa-bd53-5fc923ae7285",
                                        "entry_id": "4880b875-4761-3c7b-bf7a-99c799842a93",
                                        "glosses": [
                                            "zich ergens nauw mee verbonden voelen, zich ergens voor inzetten"
                                        ],
                                        "tags": [
                                            "pregnant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "986cca41-a9f4-4b48-89e5-570b5c2992a6",
                                                "sense_id": "4fdab479-7fd9-35fa-bd53-5fc923ae7285",
                                                "text": "Ze heeft blijk gegeven van haar grote betrokkenheid bij het project."
                                            },
                                            {
                                                "example_id": "3cd317f1-5994-4f5c-9368-573e0814a744",
                                                "sense_id": "4fdab479-7fd9-35fa-bd53-5fc923ae7285",
                                                "text": "Betrokkenheid: Ook bijvoorbeeld de Rijksdienst voor Cultureel Erfgoed maakt gebruik van faciliteiten en kennis van de afdeling, net als grote ingenieursbureaus. Daarnaast hebben grote namen in de industrie, zoals Boskalis en Shell, veel aardwetenschappers nodig vanwege hun kennis over de bodem. En ook Energie Beheer Nederland (EBN) kan voor bijvoorbeeld vraagstukken over aardwarmte niet zonder dit soort kennis."
                                            },
                                            {
                                                "example_id": "d7152a9a-753c-4e64-b84e-49d14eab5797",
                                                "sense_id": "4fdab479-7fd9-35fa-bd53-5fc923ae7285",
                                                "text": "Deze indrukwekkende demonstratie van betrokkenheid van de kant van de majordomus had een onverwachte uitwerking op de gevleide dichteres. Ze begon te schateren, waarbij zichtbaar werd hoe haar tanden verankerd waren in de met roze tandvlees overtrokken mandibula van haar schedel. Het was bijna angstaanjagend hoe grappig zij de goedbedoelde declamatie van haar eigen meesterwerk achtte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
