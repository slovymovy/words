                                            {
                                                "example_id": "f85e99fa-83de-4aac-a9a4-d4e59d35fa6b",
                                                "sense_id": "16e213bb-f190-350e-bfe1-3790aecdf911",
                                                "text": "[…] impressed with the quality of the talent and production, good wardrobing and speedy pacing."
