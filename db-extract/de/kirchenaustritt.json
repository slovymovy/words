                ],
                "senses": [
                    {
                        "sense_id": "eb31c508-6025-37e8-84dc-ec4e20d2394a",
                        "entry_id": "6936707f-2439-3b83-8827-ab17b67b54af",
                        "glosses": [
                            "Action de mettre fin à son appartenance juridique à une Église (notamment lorsque celle-ci a un statut de culte reconnu), appelée sortie de l’Église en français de Suisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5233d2c-b538-42cb-bf05-3da2feb6e6e8",
                                "sense_id": "eb31c508-6025-37e8-84dc-ec4e20d2394a",
                                "text": "Je nach Bundesland muß ein Kirchenaustritt entweder vor dem zuständigen Amtsgericht oder Standesamt erklärt und zu Protokoll genommen werden.",
                                "translation": "Selon l’État fédéré dans lequel on se trouve, la sortie de l’Église doit être déclarée soit auprès du tribunal de baillage soit auprès du bureau d’état civil compétent et procès-verbal doit en être dressé."
                            },
                            {
                                "example_id": "29a345d2-73a3-40fd-a40e-5e8282263701",
                                "sense_id": "eb31c508-6025-37e8-84dc-ec4e20d2394a",
                                "text": "Eine Ausnahme insoweit stellt der Rekursentscheid des Bundesrates in der Rechtssache Béguin dar, wo der Bundesrat hervorhob, dass der Kirchenaustritt sowohl nach Art. 49 Abs. 2 BV 1874 als auch durch die Kantonsverfassung von Freiburg geschützt sei.",
                                "translation": "La décision sur recours rendue par le Conseil fédéral dans l’affaire Béguin constitue une exception à cet égard, le Conseil fédéral soulignant que la sortie de l’Église est protégée tant par l’art. 49 par. 2 de la constitution fédérale de 1874 que par la constitution cantonale fribourgeoise."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
