                                            {
                                                "example_id": "2d1bf10e-e986-4b43-9496-c5b8ab5e4930",
                                                "sense_id": "abd7772a-b934-3a55-b307-9c6422e3c3b5",
                                                "text": "So the question that is commonly asked is, why put a media incubator in a media desert and have it managed by a civil servant? This gets to the heart of the institutional support problem in Wales."
                                            },
                                            {
                                                "example_id": "cf8a8967-779d-458d-9253-91419a716c64",
                                                "sense_id": "abd7772a-b934-3a55-b307-9c6422e3c3b5",
                                                "text": "Tech City is very big on \"incubators\" – places where startups are supposed to grow out of a collection of adjacent desks in a huge barracks of other adjacent desks – and on luring big firms to the East End of London."
                                            }
                                        ]
                                    }
                                ]
