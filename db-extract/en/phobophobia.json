    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "68dbecfe-cfbc-3366-b7b1-fa33eda614bc",
                "word": "phobophobia",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "525d6460-065f-3ecf-b3cf-949b91b63a65",
                        "entry_id": "68dbecfe-cfbc-3366-b7b1-fa33eda614bc",
                        "glosses": [
                            "The fear of fear; the fear of developing a phobia."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d71ee852-6026-409b-a1f5-645a72a46491",
                                "sense_id": "525d6460-065f-3ecf-b3cf-949b91b63a65",
                                "text": "When Franklin Delano Roosevelt said, \"The only thing we have to fear is fear itself,\" he was describing phobophobia -- the fear of being afraid."
                            },
                            {
                                "example_id": "fe3d5276-4ead-463a-aefd-684c2ab192c8",
                                "sense_id": "525d6460-065f-3ecf-b3cf-949b91b63a65",
                                "text": "In particular, the rulemakers – here judges who craft free speech doctrine – may themselves display a pathological fear of succumbing to pathological fear, a kind of phobophobia."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12489606-7ecf-4c84-acf4-45c6eb74d512",
                        "source_entry_id": "68dbecfe-cfbc-3366-b7b1-fa33eda614bc",
                        "source_sense_id": "525d6460-065f-3ecf-b3cf-949b91b63a65",
                        "source_sense_description": "fear of fear",
                        "target_lang_word": "phobophobie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phobophobie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb4a9f63-380b-3e04-8cdb-629de7df13bf",
                                        "entry_id": "f4cc3dbe-246e-3ba0-a3e6-b00adffd3c92",
                                        "glosses": [
                                            "Phobie d'avoir peur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5c573db-ec03-4732-a58c-afdc5c18be12",
                                                "sense_id": "eb4a9f63-380b-3e04-8cdb-629de7df13bf",
                                                "text": "La peur d'avoir peur (phobophobie), dit aussi Féré est un phénomène commun dans la neurasthénie (Beard)"
                                            },
                                            {
                                                "example_id": "2b013d8e-5203-4e51-884c-5269fc787991",
                                                "sense_id": "eb4a9f63-380b-3e04-8cdb-629de7df13bf",
                                                "text": "Moralement le riche devient raffiné, égoïste, indifférent aux intérêts sociaux ; le plus souvent il est atteint de phobophobie et de mégalomanie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
