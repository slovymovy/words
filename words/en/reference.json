{
    "word_family": [
        "refer",
        "referral",
        "referee",
        "referent",
        "referential"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b3444b5-b8d1-37f6-a838-aa1e11d28885",
                    "sense_definition": "A mention of a source of information in a book or article, often including the author and title.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "citation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should include a <w>reference</w> for every quote you use in your essay.",
                            "target_lang_translations": {
                                "ru": "Вам следует указывать <w>ссылку</w> на каждую цитату, которую вы используете в своем эссе."
                            }
                        },
                        {
                            "text": "The author provided a list of <w>references</w> at the end of the final chapter.",
                            "target_lang_translations": {
                                "ru": "Автор привел <w>список</w> <w>литературы</w> в конце последней главы."
                            }
                        }
                    ],
                    "synonyms": [
                        "citation",
                        "source"
                    ],
                    "common_phrases": [
                        "list of references",
                        "bibliographic reference",
                        "cite a reference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упоминание источника информации в книге или статье, часто включающее автора и название."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссылка",
                                "target_lang_sense_clarification": "указание на источник"
                            },
                            {
                                "target_lang_word": "источник",
                                "target_lang_sense_clarification": "материал, на который ссылаются"
                            },
                            {
                                "target_lang_word": "отсылка",
                                "target_lang_sense_clarification": "указание на другую часть текста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "666499b8-692a-31e0-9428-1c3fa393cd63",
                    "sense_definition": "A letter or statement from a previous employer or acquaintance describing someone's character or abilities.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "recommendation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My former manager wrote a glowing <w>reference</w> for my new job application.",
                            "target_lang_translations": {
                                "ru": "Мой бывший менеджер написал блестящую <w>рекомендацию</w> для моего заявления на новую работу."
                            }
                        },
                        {
                            "text": "The company asked for a character <w>reference</w> to verify his reliability.",
                            "target_lang_translations": {
                                "ru": "Компания попросила личную <w>рекомендацию</w>, чтобы подтвердить его надежность."
                            }
                        }
                    ],
                    "synonyms": [
                        "recommendation",
                        "testimonial"
                    ],
                    "common_phrases": [
                        "character reference",
                        "job reference",
                        "provide a reference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Письмо или заявление от предыдущего работодателя или знакомого, описывающее характер или способности человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекомендация",
                                "target_lang_sense_clarification": "отзыв о качествах человека"
                            },
                            {
                                "target_lang_word": "характеристика",
                                "target_lang_sense_clarification": "официальный документ с отзывом"
                            },
                            {
                                "target_lang_word": "референция",
                                "target_lang_sense_clarification": "справка о работе и отзыв"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3e23158-42cb-3381-9c7a-439c95dde38e",
                    "sense_definition": "A connection or relationship between two things.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker made a direct <w>reference</w> to the recent changes in the law.",
                            "target_lang_translations": {
                                "ru": "Оратор сделал <w>прямую</w> <w>отсылку</w> к недавним изменениям в законе."
                            }
                        },
                        {
                            "text": "There is no <w>reference</w> to the previous incident in this official report.",
                            "target_lang_translations": {
                                "ru": "В этом официальном отчете нет никакого <w>упоминания</w> о предыдущем инциденте."
                            }
                        }
                    ],
                    "synonyms": [
                        "relation",
                        "connection",
                        "link"
                    ],
                    "common_phrases": [
                        "direct reference",
                        "with reference to",
                        "make reference to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связь или отношение между двумя вещами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связь",
                                "target_lang_sense_clarification": "взаимозависимость объектов"
                            },
                            {
                                "target_lang_word": "отношение",
                                "target_lang_sense_clarification": "взаимное положение или связь"
                            },
                            {
                                "target_lang_word": "упоминание",
                                "target_lang_sense_clarification": "замечание о чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c18e661a-82d1-37d6-9e29-72bc29748ac6",
                    "sense_definition": "A book or other source of information that is consulted for facts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resource",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This dictionary is an excellent <w>reference</w> work for language students.",
                            "target_lang_translations": {
                                "ru": "Этот словарь — отличное <w>справочное</w> издание для студентов, изучающих языки."
                            }
                        },
                        {
                            "text": "The library has a large collection of <w>reference</w> materials that cannot be borrowed.",
                            "target_lang_translations": {
                                "ru": "В библиотеке имеется большая коллекция <w>справочных</w> материалов, которые нельзя брать на дом."
                            }
                        }
                    ],
                    "synonyms": [
                        "resource",
                        "guide"
                    ],
                    "common_phrases": [
                        "reference work",
                        "reference book",
                        "reference material"
                    ],
                    "target_lang_definitions": {
                        "ru": "Книга или другой источник информации, к которому обращаются за фактами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "справочный",
                                "target_lang_sense_clarification": "используемый для справок"
                            },
                            {
                                "target_lang_word": "справочник",
                                "target_lang_sense_clarification": "книга для получения фактов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6fec048-c849-3084-b036-fa7ff5738c88",
                    "sense_definition": "A standard or point of comparison used for measurement or judgment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "standard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We used the previous year's data as a point of <w>reference</w> for our current study.",
                            "target_lang_translations": {
                                "ru": "Мы использовали данные за прошлый год в качестве <w>точки</w> <w>отсчета</w> для нашего текущего исследования."
                            }
                        },
                        {
                            "text": "The map provides a <w>reference</w> for the scale of the mountain range.",
                            "target_lang_translations": {
                                "ru": "Карта дает <w>представление</w> о масштабе горного хребта."
                            }
                        }
                    ],
                    "synonyms": [
                        "benchmark",
                        "standard",
                        "criterion"
                    ],
                    "common_phrases": [
                        "point of reference",
                        "frame of reference",
                        "standard reference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандарт или точка сравнения, используемая для измерения или суждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ориентир",
                                "target_lang_sense_clarification": "точка отсчета"
                            },
                            {
                                "target_lang_word": "образец",
                                "target_lang_sense_clarification": "пример для сравнения"
                            },
                            {
                                "target_lang_word": "эталон",
                                "target_lang_sense_clarification": "стандарт измерения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d53eb3c5-749e-30d2-ae62-2e305fc593a4",
                    "sense_definition": "In computing, a value that enables a program to indirectly access a particular datum, such as a variable's address.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The function receives a <w>reference</w> to the object rather than a copy of it.",
                            "target_lang_translations": {
                                "ru": "Функция получает <w>ссылку</w> на объект, а не его копию."
                            }
                        },
                        {
                            "text": "A null <w>reference</w> error occurred because the pointer was not initialized.",
                            "target_lang_translations": {
                                "ru": "Произошла ошибка нулевой <w>ссылки</w>, так как указатель не был инициализирован."
                            }
                        }
                    ],
                    "synonyms": [
                        "pointer",
                        "link"
                    ],
                    "common_phrases": [
                        "null reference",
                        "pass by reference",
                        "object reference"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В программировании: значение, позволяющее программе косвенно обращаться к определенным данным, например, адрес переменной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссылка",
                                "target_lang_sense_clarification": "адрес объекта в памяти"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4af7691-6ad2-3b86-a057-bd3266262e31",
                    "sense_definition": "To mention or refer to something or someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker <w>referenced</w> the recent economic crisis several times during the talk.",
                            "target_lang_translations": {
                                "ru": "Докладчик несколько раз <w>упомянул</w> недавний экономический кризис во время выступления."
                            }
                        },
                        {
                            "text": "I noticed that you <w>referenced</w> my research in your latest blog post.",
                            "target_lang_translations": {
                                "ru": "Я заметил, что вы <w>сослались</w> на мое исследование в своем последнем посте в блоге."
                            }
                        }
                    ],
                    "synonyms": [
                        "mention",
                        "cite",
                        "allude"
                    ],
                    "antonyms": [
                        "ignore",
                        "overlook"
                    ],
                    "common_phrases": [
                        "frequently referenced",
                        "referenced above"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упоминать или ссылаться на что-либо или кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упоминать",
                                "target_lang_sense_clarification": "касаться темы в речи"
                            },
                            {
                                "target_lang_word": "ссылаться",
                                "target_lang_sense_clarification": "указывать на источник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d1c16f2-ef35-36e1-9293-8fabd4c7b46c",
                    "sense_definition": "To provide a list of sources or citations for a piece of writing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "citation_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>reference</w> your sources correctly to avoid any accusations of plagiarism.",
                            "target_lang_translations": {
                                "ru": "Вы должны правильно <w>указывать</w> <w>источники</w>, чтобы избежать обвинений в плагиате."
                            }
                        },
                        {
                            "text": "The student <w>referenced</w> the paper using the APA style guide.",
                            "target_lang_translations": {
                                "ru": "Студент <w>оформил</w> <w>ссылки</w> в работе, используя руководство по стилю APA."
                            }
                        }
                    ],
                    "synonyms": [
                        "cite",
                        "document"
                    ],
                    "common_phrases": [
                        "properly referenced",
                        "reference a source"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять список источников или цитат для письменной работы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цитировать",
                                "target_lang_sense_clarification": "приводить выдержки"
                            },
                            {
                                "target_lang_word": "указывать ссылки",
                                "target_lang_sense_clarification": "оформлять библиографию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}