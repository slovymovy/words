                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry captain <w>typified</w> all new sailors as incompetent novices."
                        },
                        {
                            "text": "Critics argued the article unfairly <w>typified</w> urban youth as reckless."
                        }
                    ],
                    "synonyms": [
