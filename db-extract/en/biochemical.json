                    {
                        "translation_id": "8b192d5d-093d-44b1-ad0d-04f1cb558d04",
                        "source_entry_id": "9e365d93-7cdb-3a2b-80af-9732da4a3a20",
                        "source_sense_description": "of or relating to biochemistry",
                        "target_lang_word": "biochimique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biochimique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ffc6fcf-a433-311a-94d9-5fcd80fb9189",
                                        "entry_id": "789e02b5-e2de-31be-bc3f-89364688a607",
                                        "glosses": [
                                            "Relatif à la biochimie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9835ed97-9447-4449-939f-90daeb709a9a",
                                                "sense_id": "3ffc6fcf-a433-311a-94d9-5fcd80fb9189",
                                                "text": "De grands progrès ont été effectués dans la connaissance des événements biochimiques impliqués dans les troubles auto-immuns et auto-inflammatoires."
                                            },
                                            {
                                                "example_id": "698bdaab-8bfe-4e86-b630-45c5b251fe9e",
                                                "sense_id": "3ffc6fcf-a433-311a-94d9-5fcd80fb9189",
                                                "text": "Au C.H.U. de Paris-Est, le malade était véritablement bilanisé, sorte d’atomisation biochimique, histologique, électromagnétique."
                                            },
                                            {
                                                "example_id": "591f6d16-e43d-4426-8654-9a2edbb63e8b",
                                                "sense_id": "3ffc6fcf-a433-311a-94d9-5fcd80fb9189",
                                                "text": "Dès 1936, nous avons pu établir qu'à la suite de la vernalisation des semences d'après la méthode de Lyssenko, il se produit dans les plantes en végétation des transformations profondes d'ordre biochimique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c42ccb54-0fc3-40e7-80d6-62bb5ffd4141",
                        "source_entry_id": "9e365d93-7cdb-3a2b-80af-9732da4a3a20",
                        "source_sense_description": "of or relating to biochemistry",
                        "target_lang_word": "biochemisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biochemisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e548330d-52f4-3fd1-87bd-2fba14a2352d",
                                        "entry_id": "69384481-80dc-394f-9eed-9c11d9b7b5ce",
                                        "glosses": [
                                            "auf der Biochemie basierend, sie betreffend oder zu ihr gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36175e4d-c3a4-40a9-b183-605ee0fa9c78",
                                                "sense_id": "e548330d-52f4-3fd1-87bd-2fba14a2352d",
                                                "text": "Bei der Hausdurchsuchung des Verdächtigen wurde eine biochemische Substanz gefunden, die als gefährlich eingestuft wird."
                                            },
                                            {
                                                "example_id": "46899f89-5c14-4cd9-9ba6-e6e68237194e",
                                                "sense_id": "e548330d-52f4-3fd1-87bd-2fba14a2352d",
                                                "text": "„Davis, ein Genetiker, der früher biochemische Forschungen betrieb, wirft die Bettdecke beiseite und eilt über eine gewundene Holztreppe hinunter ins Erdgeschoss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
