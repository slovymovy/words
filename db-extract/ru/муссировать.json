                "senses": [
                    {
                        "sense_id": "7178b127-e28b-3e38-ac35-95f262bf12fd",
                        "entry_id": "80f2503b-efac-3e89-a1a1-cdcc55b3d251",
                        "glosses": [
                            "спец. взбивать на чем-нибудь пену, заставлять что-нибудь пениться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab011d2-2713-4568-83b5-1ae187a06293",
                                "sense_id": "7178b127-e28b-3e38-ac35-95f262bf12fd",
                                "text": "Муссировать вино."
                            }
                        ]
                    },
                    {
                        "sense_id": "68fefaac-b4b6-3263-bac0-bc34741546c3",
                        "entry_id": "80f2503b-efac-3e89-a1a1-cdcc55b3d251",
                        "glosses": [
                            "спец. : покрываться пеной, пениться"
                        ],
                        "tags": [
                            "о напитках"
                        ],
                        "examples": [
                            {
                                "example_id": "b77d0397-f82f-469e-b5bb-ecfe4cdc8e70",
                                "sense_id": "68fefaac-b4b6-3263-bac0-bc34741546c3",
                                "text": "Вино муссировало."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9635d2d-8ffc-349c-9a77-4f1a7e2aeab5",
                        "entry_id": "80f2503b-efac-3e89-a1a1-cdcc55b3d251",
                        "glosses": [
                            "перен. распространять какие-нибудь известия, преувеличивая, раздувая их значение; многократно упоминать о чём- или ком-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "721c15ea-cc1a-4dc9-8978-bc500e158bb7",
                                "sense_id": "f9635d2d-8ffc-349c-9a77-4f1a7e2aeab5",
                                "text": "Муссировать слухи."
                            },
                            {
                                "example_id": "d47412ab-e059-4800-a324-cd83b57f566e",
                                "sense_id": "f9635d2d-8ffc-349c-9a77-4f1a7e2aeab5",
                                "text": "Дюку льстило, что его имя муссировали в кругах, где лучшие мальчики катаются на катке с лучшими девочками, под музыку, скрестив руки перед собой."
                            }
                        ]
                    }
