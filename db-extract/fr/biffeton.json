                ],
                "senses": [
                    {
                        "sense_id": "070f1a86-5d5c-3aaa-a490-02a02ec721b8",
                        "entry_id": "7e5e0a3f-dc29-3a6f-86f8-47d1c99f8ea4",
                        "glosses": [
                            "Billet de banque."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "af55a983-e31d-4f57-bed6-51de8a27798f",
                                "sense_id": "070f1a86-5d5c-3aaa-a490-02a02ec721b8",
                                "text": "— Touche du bois! se récria Toto. La chance!\n— Mon petit, répondit la fausse Russe avec bon sens, je préférerais les biffetons."
                            },
                            {
                                "example_id": "58aa04d4-01f2-451b-9836-ae825b10a49f",
                                "sense_id": "070f1a86-5d5c-3aaa-a490-02a02ec721b8",
                                "text": "- Entre nous, Dabe, une supposition, je dis bien une supposition, que j’aie un graveur, du papier, et que j’imprime pour un milliard de biffetons."
                            }
                        ]
                    },
                    {
                        "sense_id": "6556d7af-50bd-3abb-8662-01944198acff",
                        "entry_id": "7e5e0a3f-dc29-3a6f-86f8-47d1c99f8ea4",
                        "glosses": [
                            "Billet de mille francs."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "65450e2f-b758-4d83-9280-ce8ccd938f7f",
                                "sense_id": "6556d7af-50bd-3abb-8662-01944198acff",
                                "text": "Un faux pas sur la pente des caprices, et les cent papiers pouvaient se retrouver engourdis, vite fait... Cent biffetons, c’était pas le Pactole !."
                            }
                        ]
                    },
                    {
                        "sense_id": "84bb5c72-156a-38a6-bf90-45fed66a130d",
                        "entry_id": "7e5e0a3f-dc29-3a6f-86f8-47d1c99f8ea4",
                        "glosses": [
                            "Argent."
                        ],
                        "tags": [
                            "metonymically",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5faa5d0-064b-4670-853f-d54b43d50c70",
                        "source_entry_id": "7e5e0a3f-dc29-3a6f-86f8-47d1c99f8ea4",
                        "target_lang_word": "Lappen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lappen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1e5399c-10a3-3529-b9ca-11e1f0ed07b5",
                                        "entry_id": "af2a5e0e-b936-3233-91ee-c697e994d235",
                                        "glosses": [
                                            "relativ kleines Stück aus Leder oder Stoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23c3fd4b-2099-4e48-8f13-2ef9e552868c",
                                                "sense_id": "f1e5399c-10a3-3529-b9ca-11e1f0ed07b5",
                                                "text": "Du kannst den Lack mit einem Lappen polieren."
                                            },
                                            {
                                                "example_id": "43639ac9-08c7-462e-aee0-abaa88692b60",
                                                "sense_id": "f1e5399c-10a3-3529-b9ca-11e1f0ed07b5",
                                                "text": "So eine Chance kannst du dir doch nicht durch die Lappen gehen lassen!"
                                            },
                                            {
                                                "example_id": "1eea5358-d76f-4fcd-98da-bf7486ca7e4b",
                                                "sense_id": "f1e5399c-10a3-3529-b9ca-11e1f0ed07b5",
                                                "text": "Der Heiratsschwindler ist der Polizei durch die Lappen gegangen."
                                            },
                                            {
                                                "example_id": "bd1556a9-26fa-4969-a080-c60e4e802cca",
                                                "sense_id": "f1e5399c-10a3-3529-b9ca-11e1f0ed07b5",
                                                "text": "„Dann stieß sie die Taschenlampe unter den Vordersitz ihres Pontiac und stopfte sie mit Lappen fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4198a0a0-eb8b-3797-9e03-0a924bf36a46",
                                        "entry_id": "af2a5e0e-b936-3233-91ee-c697e994d235",
                                        "glosses": [
                                            "Führerschein"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1302e0b8-4879-47b8-aabb-d3b947ec8d85",
                                                "sense_id": "4198a0a0-eb8b-3797-9e03-0a924bf36a46",
                                                "text": "Er hat wegen Trunkenheit am Steuer seinen Lappen abgeben müssen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2ce05de3-7ad8-3432-9a49-88737da254d2",
                                        "entry_id": "af2a5e0e-b936-3233-91ee-c697e994d235",
                                        "glosses": [
                                            "Geldschein"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba33d9fd-4762-4f0c-abd0-82df64aa6000",
                                                "sense_id": "2ce05de3-7ad8-3432-9a49-88737da254d2",
                                                "text": "Mit den paar Lappen soll ich mich für all die Arbeit zufrieden geben?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "eca60cc6-b35b-3f3a-8d63-3285b52c9a87",
                                        "entry_id": "af2a5e0e-b936-3233-91ee-c697e994d235",
                                        "glosses": [
                                            "Teil eines Organs, zum Beispiel der Haut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56912357-8bfc-488f-bd39-758c19f81f05",
                                                "sense_id": "eca60cc6-b35b-3f3a-8d63-3285b52c9a87",
                                                "text": "Die Wunde wurde durch Verpflanzung eines Hautlappens vom Oberschenkel geschlossen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "edcb2a37-22fc-31f9-81fb-94f3249fc7f0",
                                        "entry_id": "af2a5e0e-b936-3233-91ee-c697e994d235",
                                        "glosses": [
                                            "beleidigender Ausdruck in der Jugendsprache"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c6115e1-e3b0-4433-a98a-4c852dfb8808",
                                                "sense_id": "edcb2a37-22fc-31f9-81fb-94f3249fc7f0",
                                                "text": "Kober: \"Mensch Gaff, wir sind nur von Lappen umgeben.\" Gaff: \"Wie recht du doch hast, Kob.\""
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
