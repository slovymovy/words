                "senses": [
                    {
                        "sense_id": "dd4d9ffc-ca72-3db8-bfc7-a26258b041d7",
                        "entry_id": "4312609c-ebdf-3760-be8e-2e131fd1665a",
                        "glosses": [
                            "Fortement influencer un choix, une issue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "427a9b6c-e6d6-494b-8a58-f67e9d6eb700",
                                "sense_id": "dd4d9ffc-ca72-3db8-bfc7-a26258b041d7",
                                "text": "Le choix du laurier est surdéterminé par le nom de la femme aimée du poète, mais il est aussi le symbole de la poésie et de Pétrarque."
                            },
                            {
                                "example_id": "3aabf65f-5dd5-464c-bcd5-95dbbdf6f6ce",
                                "sense_id": "dd4d9ffc-ca72-3db8-bfc7-a26258b041d7",
                                "text": "L'inhabituelle densité des percussions de Stokowski surdéterminait cette impression de démesure sonore. Quel plaisir ! Immense et sensuel à la fois."
                            }
                        ]
                    }
