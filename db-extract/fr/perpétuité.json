                                "example_id": "0ad690ec-99b1-4fae-952b-b66bf6aebecf",
                                "sense_id": "cfba6630-ea61-39f4-8240-33a0abdc51de",
                                "text": "condamné à perpétuité",
                                "translation": "sentenced for life",
                                "english": "sentenced for life"
                            },
                            {
                                "example_id": "356fa9f9-af16-46f8-908e-e9fccef0ca7d",
                                "sense_id": "cfba6630-ea61-39f4-8240-33a0abdc51de",
                                "text": "La perpétuité de la race humaine ne dépend ni du hasard ni du caprice des individus: elle est garantie par un instinct naturel tout-puissant, qui demande impérieusement à être satisfait."
                            }
                        ]
                    }
