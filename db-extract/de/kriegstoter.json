                "senses": [
                    {
                        "sense_id": "034cc875-6519-379a-9c9e-0dfef07c68cc",
                        "entry_id": "33431bdf-60ca-35ed-a970-f430fa27125e",
                        "glosses": [
                            "durch Kriegseinwirkung umgekommene Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5239cf5f-f2d1-427c-9758-3180be751079",
                                "sense_id": "034cc875-6519-379a-9c9e-0dfef07c68cc",
                                "text": "„Wir sind mit 20 Millionen Kriegstoten aufgewachsen, dann stellte sich heraus, es waren viel mehr.“"
                            },
                            {
                                "example_id": "0e1f5ee4-a823-4ba8-aa05-eeedf7f6457e",
                                "sense_id": "034cc875-6519-379a-9c9e-0dfef07c68cc",
                                "text": "„Doch er hat sein Leben lang darunter gelitten, dass es fortgesetzt Kriege und Kriegstote gab – er wuchs auf während des Balkankriegs und musste in seinen letzten Jahren erneut verheerende kriegerische Auseinandersetzungen auf dem Balkan miterleben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
