                                "target_lang_word": "задок",
                                "target_lang_sense_clarification": "задняя часть туши при разделке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be4b3d77-ad56-384a-8a08-f4a95b457505",
                    "sense_definition": "A person's buttocks or rear end.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He slipped on the icy sidewalk and landed heavily on his <w>hindquarters</w>.",
                            "target_lang_translations": {
                                "ru": "Он поскользнулся на обледенелом тротуаре и тяжело плюхнулся на <w>пятую точку</w>."
                            }
                        },
                        {
                            "text": "The clumsy comedian pretended to bruise his <w>hindquarters</w> during the stage fall.",
                            "target_lang_translations": {
                                "ru": "Неуклюжий комик сделал вид, что ушиб <w>мягкое место</w> во время падения на сцене."
                            }
