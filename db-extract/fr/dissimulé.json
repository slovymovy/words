                    },
                    {
                        "form_id": "e5aa6135-65b1-4233-9d07-4943524d8cca",
                        "entry_id": "55f09753-de72-30ae-92a5-279208bbbc96",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "dissimulées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "860ce286-57f3-3d51-8501-deb7cc522706",
                        "entry_id": "55f09753-de72-30ae-92a5-279208bbbc96",
                        "glosses": [
                            "Qui ne laisse pas apercevoir ses sentiments, ses desseins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "975b3d0c-6cfa-4f3f-9b28-8b037f609bae",
                                "sense_id": "860ce286-57f3-3d51-8501-deb7cc522706",
                                "text": "J’ai affaire à un de ces hommes adroits, aimables, et profondément dissimulés, que l’on voit dans les romans. Ils savent plaire, mais précisément parce qu’ils sont incapables d’aimer."
                            },
                            {
                                "example_id": "b8701f7f-2b60-48b8-9144-bed99a07ec29",
                                "sense_id": "860ce286-57f3-3d51-8501-deb7cc522706",
                                "text": "Pierrette ne sourcilla pas.\n— Dissimulée ! s’écria Sylvie en sortant."
                            },
                            {
                                "example_id": "b12a1e1b-3236-4c28-9a0e-765d1eb561b5",
                                "sense_id": "860ce286-57f3-3d51-8501-deb7cc522706",
                                "text": "Elle fut une élève quelconque. Les autres enfants disaient d’elle : « Anne, au fond, n’est pas méchante, mais elle est dissimulée. »"
                            },
                            {
                                "example_id": "e987ef18-6f96-4970-a99c-9bde4a074c81",
                                "sense_id": "860ce286-57f3-3d51-8501-deb7cc522706",
                                "text": "Hector fit un geste d'absolution, onctueux comme un prélat, plus dissimulé qu'un Tartuffe et soulagea Arsène André de sa présence."
                            },
                            {
                                "example_id": "bb5751aa-0935-4717-8597-9b9ce754a8dd",
                                "sense_id": "860ce286-57f3-3d51-8501-deb7cc522706",
                                "text": "Jamais Jan n’aurait cru qu’un Suisse pouvait absorber tant d’alcool sans en paraître incommodé. Werner, d’abord grognon, l’avait reçu avec une mauvais grâce non dissimulée ; puis, comme Jan était de ceux qui acceptent en souriant les pires rebuffades, il finit par faire bon visage."
                            },
                            {
                                "example_id": "f6a7fca8-9d50-4248-9784-62b55470a6c7",
                                "sense_id": "860ce286-57f3-3d51-8501-deb7cc522706",
                                "text": "Esprit dissimulé. — Caractère dissimulé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d68f05db-a8a7-414c-9913-c01848c93894",
                        "source_entry_id": "55f09753-de72-30ae-92a5-279208bbbc96",
                        "source_sense_id": "860ce286-57f3-3d51-8501-deb7cc522706",
                        "target_lang_word": "concealed",
