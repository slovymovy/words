                "senses": [
                    {
                        "sense_id": "c506fb5b-9e0f-319c-963e-43270ef3fe32",
                        "entry_id": "4cd57456-4f18-3e45-a275-0aa8398fad14",
                        "glosses": [
                            "Gesamtheit aller Genvariationen einer Population"
                        ],
                        "tags": [
                            "Genetik"
                        ],
                        "examples": [
                            {
                                "example_id": "b3d726c3-b4ba-4009-b93c-468ff86a38a3",
                                "sense_id": "c506fb5b-9e0f-319c-963e-43270ef3fe32",
                                "text": "„Wenn du aber die Hälfte deines Lebens in der B&O Tavern auf der West Pratt Street versoffen hast und die andere Hälfte ständig vom Gericht im Southern District vorgeladen wurdest – wegen Diebstahl, Ruhestörung, Widerstand gegen die Staatsgewalt und Besitz von Angel Dust –, dann bist du für einen Detective von Baltimore höchstwahrscheinlich ein Billy-Boy, weißer Proletenabschaum, ein Penner, ein Versager von Geburt an, ausgebrütet in den seichten Gewässern eines degenerierenden Genpools.“"
                            },
                            {
                                "example_id": "2bbb8f75-f16d-41b1-8690-f525d9f89762",
                                "sense_id": "c506fb5b-9e0f-319c-963e-43270ef3fe32",
                                "text": "„Eine weitere Verkleinerung des Genpools könnte langfristig das Risiko für Inzucht und damit verbundene Gesundheitsprobleme erhöhen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
