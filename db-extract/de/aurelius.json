                                "target_senses": [
                                    {
                                        "sense_id": "2715c257-039d-3eb7-af0d-2e83c4cff012",
                                        "entry_id": "11f155e7-f3c9-3a8a-99a1-0be31f98ed81",
                                        "glosses": [
                                            "Prénom épicène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bca6e52-f989-4219-a2a4-758117dfab89",
                                                "sense_id": "2715c257-039d-3eb7-af0d-2e83c4cff012",
                                                "text": "À l'époque d'Aurèle de Carthage (388-430), il existait deux évêchés de Gummi."
                                            },
                                            {
                                                "example_id": "96012f84-4822-414d-b3ba-82da6d1536f9",
                                                "sense_id": "2715c257-039d-3eb7-af0d-2e83c4cff012",
                                                "text": "La bande de joyeux lurons composée d’Aurèle le mélenchoniste, Juju la présidente … collectionnaient les histoires de dingues !!"
                                            },
                                            {
                                                "example_id": "94f22c13-37b9-46fa-b9e5-7f600b9cc9f2",
                                                "sense_id": "2715c257-039d-3eb7-af0d-2e83c4cff012",
                                                "text": "Aurèle Mestré remporte ainsi le premier titre de champion du monde de frite authentique de l’histoire, rapporte La Voix du Nord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be7de6c1-820f-470e-97eb-cc8226a2c758",
                        "source_entry_id": "870c2bf4-7f13-3d89-8679-4634fb70014b",
                        "source_sense_id": "4d6846fc-84ae-344f-9b89-308967e758d2",
