                "senses": [
                    {
                        "sense_id": "52efb90d-f86c-39ec-81f1-b7d195ab28cb",
                        "entry_id": "b9347247-9bf5-3102-886e-8efa04b0e8f8",
                        "glosses": [
                            "Angebot an Obdachlose, im Winter (bei Kälte) sich in einem Bus aufzuwärmen, ein Heißgetränk und etwas zu Essen zu sich zu nehmen und weitere Angebote (beispielsweise Verteilung von Kleidung, Schlafsäcke); die Dienste werden in Deutschland von Ehrenamtlichen betrieben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e53f68d-fc5c-44c1-ad90-c726304145d6",
                                "sense_id": "52efb90d-f86c-39ec-81f1-b7d195ab28cb",
                                "text": "„Für die Helferin Dana Jörg ist der Kältebus eine sehr sinnvolle Einrichtung […]“"
                            },
                            {
                                "example_id": "1340e7bc-6714-44d5-83c2-18e8f5b6ab5d",
                                "sense_id": "52efb90d-f86c-39ec-81f1-b7d195ab28cb",
                                "text": "„In Hannover und Bremen ist der Kältebus der Johanniter wieder in den Innenstädten unterwegs.“"
                            },
                            {
                                "example_id": "b83fd4d9-8a2f-425a-a7d9-bbb73e1c517a",
                                "sense_id": "52efb90d-f86c-39ec-81f1-b7d195ab28cb",
                                "text": "„Jede Nacht von 19 bis 0 Uhr ist der Kältebus bis Ende März unterwegs, er fährt gezielt die Schlafplätze von Obdachlosen an.“"
                            },
                            {
                                "example_id": "8250760b-1dce-461c-a33f-ea365178e70b",
                                "sense_id": "52efb90d-f86c-39ec-81f1-b7d195ab28cb",
                                "text": "„»Wir versuchen, die obdachlosen Menschen mit dem Kältebus in ein Notquartier zu bringen oder sie zumindest mit warmer Kleidung und winterfesten Schlafsäcken zu versorgen und sie über Hilfsangebote zu beraten« […].“"
                            },
                            {
                                "example_id": "7e71ab50-ee8a-4841-adf3-06616f1e78df",
                                "sense_id": "52efb90d-f86c-39ec-81f1-b7d195ab28cb",
                                "text": "„Zwischen 5000 und 10.000 Wohnungslose leben in Berlin. Im Winter hilft ihnen die \"Berliner Kältehilfe\" mit Notunterkünften und einem Kältebus.“"
                            },
                            {
                                "example_id": "f8285902-09d6-431f-bfcf-bd9a349fc201",
                                "sense_id": "52efb90d-f86c-39ec-81f1-b7d195ab28cb",
                                "text": "„Viele Städte können […] keinen Kältebus anbieten, wie zum Beispiel das Sozialamt in Regensburg.“"
                            },
                            {
                                "example_id": "9f237c52-2a77-4b31-8814-8e99fcebb867",
                                "sense_id": "52efb90d-f86c-39ec-81f1-b7d195ab28cb",
                                "text": "„Die Sozialarbeiter des Vereins \"Die Schachtel\" helfen wohnungslosen Menschen regelmäßig mit dem Kältebus - zum Beispiel in der Koblenzer Innenstadt und in den Randbezirken.“"
                            },
                            {
                                "example_id": "cb8a3ede-7614-4e80-8242-c1c1a60afc08",
                                "sense_id": "52efb90d-f86c-39ec-81f1-b7d195ab28cb",
                                "text": "„Geht ein Anruf ein, wird das aus Freiwilligen bestehende Team aktiv und fährt im Kältebus zur betreffenden obdachlosen Person.“"
                            },
                            {
                                "example_id": "74d8ec46-cca2-4133-96f5-5dcde463254c",
                                "sense_id": "52efb90d-f86c-39ec-81f1-b7d195ab28cb",
                                "text": "„Der Verein \"Rheinhessen hilft\" hat das Geld für einen neuen Kältebus für die Obdachlosenhilfe zusammen.“"
                            },
                            {
                                "example_id": "a5fe531b-413b-4177-95a7-21c4179d0858",
                                "sense_id": "52efb90d-f86c-39ec-81f1-b7d195ab28cb",
                                "text": "„Der Erlös aus Anmeldegebühren und Spenden geht in diesem Jahr an den Kältebus der Johanniter-Unfallhilfe, der obdachlose Menschen in Hannover unterstützt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
