                "senses": [
                    {
                        "sense_id": "2ef56e4b-97a8-326e-9b9c-a44d8a918bd5",
                        "entry_id": "653f6d4a-8654-33d9-a76f-c3620370e6d5",
                        "glosses": [
                            "zeer lui en relaxed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4143d61b-def3-41e8-af80-bca1bbe69ed3",
                                "sense_id": "2ef56e4b-97a8-326e-9b9c-a44d8a918bd5",
                                "text": "Opeens zag ik hem op zijn oranje omamodel, komend van de Willemspark, de Cornelis Schuyt in zwenken. Languissant achterover leunend, pinken om de handvatten, meanderde hij volkomen op zijn gemak tussen de vastgelopen, claxonnerende auto's door — heel sierlijk eigenlijk, alsof het stadsverkeer zijn meest natuurlijke element was."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa454def-a21d-3d8c-8364-13ba33dafe26",
                        "entry_id": "653f6d4a-8654-33d9-a76f-c3620370e6d5",
                        "glosses": [
                            "op een gekwelde, smachtende manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5249753c-37cd-4784-8acf-1e2cae1c5f54",
                                "sense_id": "fa454def-a21d-3d8c-8364-13ba33dafe26",
                                "text": "Op de zinnenprikkelende foto ligt zij languissant op een chaise longue met duidelijk te veel caipirinha’s op, gekleed in een deux-piècesje en ook al spreekt Alex geen Russisch, hij gelooft Svetlana maar al te graag als die zegt in hem de ware jakob te hebben gevonden."
                            }
                        ]
                    }
