                "senses": [
                    {
                        "sense_id": "a8a5bb5c-272f-3338-8db3-4ec58db94c9a",
                        "entry_id": "5eab5578-0171-3ff8-a29b-2400ce150b74",
                        "glosses": [
                            "Communication réciproque, de l'un à l'autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e600713-5ab8-49e8-a32e-86d0afb015df",
                                "sense_id": "a8a5bb5c-272f-3338-8db3-4ec58db94c9a",
                                "text": "Le procédé qui développe les sciences est un procédé de subdivision perpétuelle et d'intercommunication des divisions et subdivisions."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb890561-ee97-380a-a31f-86cf271202da",
                        "entry_id": "5eab5578-0171-3ff8-a29b-2400ce150b74",
                        "glosses": [
                            "Appareil, dispositif assurant la liaison entre les voitures d'un train et la locomotive et permettant aux voyageurs de communiquer avec les agents du train et de provoquer l'arrêt immédiat de celui-ci en cas d'urgence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74ca2140-4fa7-454b-8abc-58d02df8664f",
                                "sense_id": "bb890561-ee97-380a-a31f-86cf271202da",
                                "text": "Quant à l’intercommunication pneumatique (communément désignée sous le nom de signal d’alarme), c'est un dispositif placé à la disposition des voyageurs pour arrêter le train en cas d'urgence et faire appel, par le truchement d'un sifflet qu'il met en action, aux agents d'accompagnement."
                            }
                        ]
                    }
                ],
                "translations": [
