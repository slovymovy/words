                        "source_sense_id": "b105c00a-774a-3187-bef3-425731d9dfbd",
                        "target_lang_word": "free and easy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "free and easy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b433f878-652d-32ff-85ee-bd5376967e4c",
                                        "entry_id": "8202bcbc-b501-3219-a23f-01a01ebfc9ff",
                                        "glosses": [
                                            "Casual, informal, relaxed, unrestrained."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d8fb09d-94d2-452d-bad6-e1b3b6ac4e50",
                                                "sense_id": "b433f878-652d-32ff-85ee-bd5376967e4c",
                                                "text": "He was[…] none of your free-and-easy companions, who would scrape their boots upon the firedogs in the common room, […]"
                                            },
                                            {
                                                "example_id": "56ab0a9a-a0ac-4b9f-870d-0ea43dd575e1",
                                                "sense_id": "b433f878-652d-32ff-85ee-bd5376967e4c",
                                                "text": "The other passengers were three Norwegians, three fossil Englishmen, two snobbish do., and some jolly, good-natured, free-and-easy youths."
                                            },
                                            {
                                                "example_id": "6d21b150-1005-4895-8b1f-7a97fd27491e",
                                                "sense_id": "b433f878-652d-32ff-85ee-bd5376967e4c",
                                                "text": "\"That's more money than I've seen in a month,\" said she. \"I wouldn't be so free and easy with it, if I were you.\""
                                            },
                                            {
                                                "example_id": "b7d3d004-152a-4fe5-93fd-986f645b2da0",
                                                "sense_id": "b433f878-652d-32ff-85ee-bd5376967e4c",
                                                "text": "The Netherlands, proud of its multicultural tolerance, its hospitality to strangers, its free and easy social ways, used to be thought of as a soft touch for would-be immigrants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07db3987-722c-3aa9-b42b-ef7e548df90b",
                                        "entry_id": "8202bcbc-b501-3219-a23f-01a01ebfc9ff",
                                        "glosses": [
                                            "Travelling according to one's own personal schedule and preferences."
                                        ],
                                        "tags": [
                                            "Singapore"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff2415e1-b61b-4fb0-a4d0-3da2720451f9",
                                                "sense_id": "07db3987-722c-3aa9-b42b-ef7e548df90b",
                                                "text": "With the increase in budget travelers coming to Singapore, a personalized recommender system has the potential to effectively provide assistance to this group of travellers to piece together free and easy travel plans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "free and easy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99ca8d85-ff53-3595-af9c-76d960fb9b12",
                                        "entry_id": "1a3be419-c5c9-3708-a0ce-86999550a2e4",
                                        "glosses": [
                                            "A tavern offering informal entertainment from amateur and professional performers."
