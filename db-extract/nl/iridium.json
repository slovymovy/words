                    {
                        "translation_id": "6a538c7c-fd11-49fe-bdb4-ab6383aec7b1",
                        "source_entry_id": "0c8963f0-7c4b-3bf5-8527-6580ffbf4267",
                        "source_sense_id": "bedcdb2e-f60f-3b40-9eab-33c8611d51f8",
