                        "form": "den Militarismus"
                    },
                    {
                        "form_id": "9c56b554-eedc-49c0-ad66-939e10f9220a",
                        "entry_id": "72ae64a8-eeca-3078-87af-6a184f4f1e01",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Militarismen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3777ed2c-c426-3f82-9c18-3eb1c9d510fa",
                        "entry_id": "72ae64a8-eeca-3078-87af-6a184f4f1e01",
                        "glosses": [
                            "Dominanz militärisch geprägter Denkkultur in einer Gesellschaft"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "b44d3cb3-c133-4aef-8d3b-13e37d2072f9",
                                "sense_id": "3777ed2c-c426-3f82-9c18-3eb1c9d510fa",
                                "text": "Der Militarismus im Deutschen Kaiserreich war einer der Gründe für den Ersten Weltkrieg."
                            },
                            {
                                "example_id": "8f128cc9-4285-4c73-aa9f-a4594a224bb4",
                                "sense_id": "3777ed2c-c426-3f82-9c18-3eb1c9d510fa",
                                "text": "„Potsdam war die Wiege des preußischen Militarismus und Imperialismus.“"
                            },
                            {
                                "example_id": "41e75a2d-5ee4-4c79-964d-d1036b9d1ee0",
                                "sense_id": "3777ed2c-c426-3f82-9c18-3eb1c9d510fa",
                                "text": "„Es basierte auf einer Anekdote aus den alten Tagen der Kaiserzeit und sollte eine Warnung an das deutsche Volk vor neuem Nationalismus und Militarismus sein.“"
                            },
                            {
                                "example_id": "d4bec5ca-8ce8-4b48-9df5-655161263710",
                                "sense_id": "3777ed2c-c426-3f82-9c18-3eb1c9d510fa",
                                "text": "„Ostpreußen, das war für die Kriegsgegner Deutschlands die Wiege des preußischen und damit deutschen Militarismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2281ccb-a26f-41ce-bb54-e4f727ba5282",
                        "source_entry_id": "72ae64a8-eeca-3078-87af-6a184f4f1e01",
                        "source_sense_id": "3777ed2c-c426-3f82-9c18-3eb1c9d510fa",
