                                                "example_id": "deab654d-899a-49ea-b3eb-39e5ba50fcff",
                                                "sense_id": "55c550ae-9250-3366-a1fe-493b22e45cf6",
                                                "text": "In English there are four moods:–1. The Infinitive Mood. 2. The Indicative Mood. 3. the Imperative Mood. 4. The Subjunctive Mood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10d11ace-334f-399e-a548-92863504055e",
                                        "entry_id": "6ad1ab73-3e13-3119-9dc6-6c958b228bc2",
                                        "glosses": [
                                            "Unlimited; not bounded or restricted; undefined."
