                "senses": [
                    {
                        "sense_id": "8487e97a-5093-3cfe-81c9-17f0a7aa0987",
                        "entry_id": "5dbf340e-3487-30c4-a511-fc8ca66feca1",
                        "glosses": [
                            "истор. способ мучительной медленной смертной казни на особом вращающемся колесе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09f14371-a50f-4657-8c54-49dd4aaae771",
                                "sense_id": "8487e97a-5093-3cfe-81c9-17f0a7aa0987",
                                "text": "Кроме повешения и отрубления головы, употреблялись: колесование, четвертование, прожжение языка и сожжение."
                            },
                            {
                                "example_id": "558d0709-559b-4ae4-b53e-84cc60981fe4",
                                "sense_id": "8487e97a-5093-3cfe-81c9-17f0a7aa0987",
                                "text": "Испокон века практиковались подвешивание за ребро и сажание на кол, а также колесование: приговорённого клали на большое колесо, и палач ломал ему руки и ноги."
                            }
                        ]
                    }
