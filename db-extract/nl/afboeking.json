                        "glosses": [
                            "een boekhoudkundige waardedaling van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "876f817d-42ca-468b-a42b-c8723f82a7d3",
                                "sense_id": "225f96f2-43ac-3fae-9090-c75f1597bf0a",
                                "text": "Bij een 4,2% hogere omzet van €437 miljoen verdiende Fagron vorig jaar €47 miljoen, ofwel €0,65 per aandeel. Een jaar eerder schreef de toeleverancier aan apothekers nog rode cijfers, door een afboeking op een Amerikaans bedrijf dat in 2013 werd overgenomen."
                            },
                            {
                                "example_id": "035ffebf-5aec-4061-93c8-0bb314e229ee",
                                "sense_id": "225f96f2-43ac-3fae-9090-c75f1597bf0a",
                                "text": "Het financiële concern zag over het vierde kwartaal zowel de baten als de winst teruglopen mede als gevolg afboekingen vanwege de belastinghervormingen in de VS."
                            },
                            {
                                "example_id": "3703a6ee-a7c5-46ef-a7ec-fb7aad25aaad",
                                "sense_id": "225f96f2-43ac-3fae-9090-c75f1597bf0a",
                                "text": "Een afboeking is het verwerken van waardevermindering van kapitaalgoederen in de boekhouding. Elk jaar worden goederen zoals bedrijfsauto’s minder waard tot ze niks meer waard zijn en vervangen kunnen worden. Ook machines, meubilair en andere zaken kunnen worden afgeboekt. Het afboeken gebeurt natuurlijk door financiële specialisten binnen een bedrijf."
                            }
                        ]
                    }
