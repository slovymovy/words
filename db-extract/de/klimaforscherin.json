                "senses": [
                    {
                        "sense_id": "c4391505-c8a9-38c8-a5f4-7892f94dfca5",
                        "entry_id": "361c3282-4513-3a22-bcf4-9a6acbb42ad0",
                        "glosses": [
                            "Wissenschaftlerin, die die Gesetzmäßigkeiten des Klimas erforscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35368e0a-c0bd-44a6-ac3c-0aa6cb418003",
                                "sense_id": "c4391505-c8a9-38c8-a5f4-7892f94dfca5",
                                "text": "Viele Klimaforscherinnen warnen vor den Folgen der globalen Erwärmung."
                            },
                            {
                                "example_id": "92f5f74a-381b-453f-824f-7b5296133b3c",
                                "sense_id": "c4391505-c8a9-38c8-a5f4-7892f94dfca5",
                                "text": "„Eine von ihnen, die Meteorologin und Klimaforscherin Helga Kromp-Kolb fasste die Forderungen so zusammen: \"Eine Diskussion darüber, welche Maßnahmen erforderlich sind, ist obsolet. Es sind fast alle erforderlich.\"“"
                            },
                            {
                                "example_id": "2845aea9-68c0-41b1-b114-6daf25a2384a",
                                "sense_id": "c4391505-c8a9-38c8-a5f4-7892f94dfca5",
                                "text": "„Klimaforscherinnen und Klimaforscher beschäftigen sich schon seit Jahren mit der Frage, bis wann die Welt bei Netto-Null-Emissionen ankommen muss, um den Klimawandel unter Kontrolle zu bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e08598d-1aa1-44eb-a7a9-6cf7a87e738a",
                        "source_entry_id": "361c3282-4513-3a22-bcf4-9a6acbb42ad0",
                        "source_sense_id": "c4391505-c8a9-38c8-a5f4-7892f94dfca5",
                        "source_sense_description": "Wissenschaftlerin, die die Gesetzmäßigkeiten des Klimas erforscht",
                        "target_lang_word": "climatologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "climatologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c5be25b-053e-36a7-a913-7a7674badfa5",
                                        "entry_id": "e8a171e6-e9aa-3218-8014-1be8ba5cde51",
                                        "glosses": [
                                            "A person who studies, professes or practices climatology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "005c4aaa-1bab-4b52-8ffc-586eee8a9a9b",
                                                "sense_id": "5c5be25b-053e-36a7-a913-7a7674badfa5",
                                                "text": "To most people, the huge ice sheets of Antarctica and Greenland are merely water that once was snow. To glaciologists and climatologists, they are storehouses of the Earth's former atmospheres."
                                            },
                                            {
                                                "example_id": "a593e730-ae90-43c9-9390-af4e02535adc",
                                                "sense_id": "5c5be25b-053e-36a7-a913-7a7674badfa5",
                                                "text": "“The lack of an agreement to phase out fossil fuels was devastating,” said Prof Michael Mann, a climatologist and geophysicist at the University of Pennsylvania in the US."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
