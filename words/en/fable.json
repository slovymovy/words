{
    "word_family": [
        "fabled",
        "fabulist",
        "fabulous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "479b578b-22d3-3c0d-a4ff-a4a38ac6ed54",
                    "sense_definition": "A short story, typically with animals as characters, conveying a moral.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fictional_stories",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher read a famous <w>fable</w> about a clever fox to the children.",
                            "target_lang_translations": {
                                "ru": "Учитель прочитал детям известную <w>басню</w> про умную лису."
                            }
                        },
                        {
                            "text": "Every traditional <w>fable</w> ends with a clear moral lesson for the reader.",
                            "target_lang_translations": {
                                "ru": "Каждая традиционная <w>басня</w> заканчивается ясным нравоучением для читателя."
                            }
                        }
                    ],
                    "synonyms": [
                        "legend"
                    ],
                    "common_phrases": [
                        "moral of the fable",
                        "ancient fable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий рассказ, обычно с животными в качестве персонажей, содержащий мораль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "басня",
                                "target_lang_sense_clarification": "короткий аллегорический рассказ с нравоучением"
                            },
                            {
                                "target_lang_word": "притча",
                                "target_lang_sense_clarification": "небольшой поучительный рассказ в иносказательной форме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8ed8240-ea65-3a86-b68d-adffdc69c964",
                    "sense_definition": "A statement or story that is untrue; a falsehood or fiction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "untruth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His explanation of where the money went turned out to be a complete <w>fable</w>.",
                            "target_lang_translations": {
                                "ru": "Его объяснение того, куда делись деньги, оказалось чистой <w>выдумкой</w>."
                            }
                        },
                        {
                            "text": "Do not believe those rumors, as the entire story is nothing but a <w>fable</w>.",
                            "target_lang_translations": {
                                "ru": "Не верьте этим слухам, ведь вся эта история — не более чем <w>сказка</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nothing but a fable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утверждение или история, не соответствующие действительности; вымысел или ложь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдумка",
                                "target_lang_sense_clarification": "то, что не соответствует действительности"
                            },
                            {
                                "target_lang_word": "сказка",
                                "target_lang_sense_clarification": "пустая лживая болтовня, вымысел"
                            },
                            {
                                "target_lang_word": "небылица",
                                "target_lang_sense_clarification": "выдуманная история, не соответствующая действительности"
                            },
                            {
                                "target_lang_word": "басня",
                                "target_lang_sense_clarification": "вымысел, враньё"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69ec85de-193b-31eb-9e97-ba05d7297338",
                    "sense_definition": "A story told to excite wonder, or a common talk; a subject of gossip or rumor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "untruth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their sudden and dramatic downfall quickly became the <w>fable</w> of the entire town.",
                            "target_lang_translations": {
                                "ru": "Их внезапное и драматичное падение быстро стало главной <w>притчей</w> всего города."
                            }
                        },
                        {
                            "text": "She feared that her private life would become a public <w>fable</w> for everyone to discuss.",
                            "target_lang_translations": {
                                "ru": "Она боялась, что её личная жизнь станет публичной <w>басней</w> для всеобщего обсуждения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fable of the city"
                    ],
                    "target_lang_definitions": {
                        "ru": "История, рассказываемая для возбуждения удивления, или предмет общих разговоров, сплетен и слухов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "байка",
                                "target_lang_sense_clarification": "выдуманная история, слух или сплетня"
                            },
                            {
                                "target_lang_word": "притча во языцех",
                                "target_lang_sense_clarification": "предмет общих разговоров, сплетен или насмешек"
                            },
                            {
                                "target_lang_word": "легенда",
                                "target_lang_sense_clarification": "история, ставшая предметом разговоров и удивления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef5ffd3e-b99b-3200-9b9a-adebad754bd1",
                    "sense_definition": "The plot or connected series of events forming the subject of an epic or dramatic poem.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "literary_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic analyzed the intricate <w>fable</w> of the epic poem in great detail.",
                            "target_lang_translations": {
                                "ru": "Критик подробно проанализировал сложную <w>фабулу</w> эпической поэмы."
                            }
                        },
                        {
                            "text": "A well-constructed dramatic <w>fable</w> must have a logical sequence of events.",
                            "target_lang_translations": {
                                "ru": "Хорошо выстроенная драматическая <w>фабула</w> должна иметь логическую последовательность событий."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary term for plot"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сюжет или связная последовательность событий, составляющая основу эпической или драматической поэмы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фабула",
                                "target_lang_sense_clarification": "сюжетная основа, последовательность событий в произведении"
                            },
                            {
                                "target_lang_word": "сюжет",
                                "target_lang_sense_clarification": "ход событий в литературном произведении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3c42f002-c690-347d-8e7c-3a034858c1f0",
                    "sense_definition": "To write or speak fiction; to invent or tell stories that are not true.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fictionalizing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient poets would often <w>fable</w> about gods descending from the heavens.",
                            "target_lang_translations": {
                                "ru": "Древние поэты часто любили <w>слагать мифы</w> о богах, спускающихся с небес."
                            }
                        },
                        {
                            "text": "He chose to <w>fable</w> rather than tell the plain truth about his journey.",
                            "target_lang_translations": {
                                "ru": "Он предпочёл <w>сочинять</w>, вместо того чтобы рассказать чистую правду о своём путешествии."
                            }
                        }
                    ],
                    "synonyms": [
                        "invent",
                        "make up"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сочинять или рассказывать вымыслы; придумывать или рассказывать неправдивые истории."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочинять",
                                "target_lang_sense_clarification": "выдумывать, рассказывать небылицы"
                            },
                            {
                                "target_lang_word": "выдумывать",
                                "target_lang_sense_clarification": "создавать вымышленные истории"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc75df17-9370-34a4-9c1d-6cbea1cb1519",
                    "sense_definition": "To devise, invent, or falsely recount something as true or real.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fictionalizing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They would <w>fable</w> stories of hidden gold to attract travelers to the remote island.",
                            "target_lang_translations": {
                                "ru": "Они <w>выдумывали</w> истории о спрятанном золоте, чтобы завлечь путешественников на далёкий остров."
                            }
                        },
                        {
                            "text": "It is easy to <w>fable</w> a heroic past when no witnesses remain to contradict you.",
                            "target_lang_translations": {
                                "ru": "Легко <w>сочинить</w> себе героическое прошлое, когда не осталось свидетелей, способных тебе возразить."
                            }
                        }
                    ],
                    "synonyms": [
                        "devise",
                        "feign",
                        "invent",
                        "make up"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрабатывать, изобретать или ложно преподносить что-либо как истинное или реальное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымышлять",
                                "target_lang_sense_clarification": "изобретать ложные истории, выдавая их за правду"
                            },
                            {
                                "target_lang_word": "сочинять",
                                "target_lang_sense_clarification": "придумывать ложные факты или события"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}