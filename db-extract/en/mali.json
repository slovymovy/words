                                "target_senses": [
                                    {
                                        "sense_id": "e1e1c61d-e9b3-34ae-91e5-4e5e0d3a7bd4",
                                        "entry_id": "b1734cf9-6643-31b4-bbf7-36c8d0cda9ae",
                                        "glosses": [
                                            "ein Staat im Westen Afrikas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f979f50-e647-463e-bd3b-189f9dc1977d",
                                                "sense_id": "e1e1c61d-e9b3-34ae-91e5-4e5e0d3a7bd4",
                                                "text": "Bamako ist die Hauptstadt von Mali."
                                            },
                                            {
                                                "example_id": "7e4eb384-6a6f-4cbf-8a30-f9483077bcdc",
                                                "sense_id": "e1e1c61d-e9b3-34ae-91e5-4e5e0d3a7bd4",
                                                "text": "Der Norden Malis grenzt an die Wüste Sahara und ist sehr trocken, der Süden ist etwas feuchter und bildet eine Savanne."
                                            },
                                            {
                                                "example_id": "198346f0-a134-470c-bc9d-5e8c3736c86e",
                                                "sense_id": "e1e1c61d-e9b3-34ae-91e5-4e5e0d3a7bd4",
                                                "text": "Mali gilt als gelungenes Beispiel einer Demokratisierung in Afrika, ist aber eines der ärmsten und am wenigsten entwickelten Länder der Welt."
                                            },
                                            {
                                                "example_id": "e6282e93-deee-4f22-ab39-9ed378c4a3cb",
                                                "sense_id": "e1e1c61d-e9b3-34ae-91e5-4e5e0d3a7bd4",
                                                "text": "„Lange Zeit hatte Mali als demokratischer Vorzeigestaat gegolten, niemandem fiel auf, dass die frühere Regierung den Drogenhandel im Norden nicht nur tolerierte, sondern kräftig von ihm profitierte.“"
                                            },
                                            {
                                                "example_id": "93bcd4c7-70ec-46c6-af55-775952a827a6",
                                                "sense_id": "e1e1c61d-e9b3-34ae-91e5-4e5e0d3a7bd4",
                                                "text": "„Aber wir durften uns bei der Ankunft auf etwas freuen: Angel hatte auf ihrer legendären LKW-Reise in Mali einige Entwicklungshelfer kennengelernt, und über einen davon hatte sie vage Kontakte in den Niger aufbauen können.“"
                                            },
                                            {
                                                "example_id": "48f3ac07-1f2c-46e8-aacb-c47aeb0f8d21",
                                                "sense_id": "e1e1c61d-e9b3-34ae-91e5-4e5e0d3a7bd4",
                                                "text": "„Als Frankreich im Januar 2013 in Mali einmarschierte, waren die Deutschen mit technischer und logistischer Hilfe dabei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mali",
                                "target_lang_code": "de",
