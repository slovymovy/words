                "senses": [
                    {
                        "sense_id": "34b87bac-edfe-3106-a3c3-d8ace0590656",
                        "entry_id": "2f72fb3f-18e2-37b3-9283-8fa03b77973b",
                        "glosses": [
                            "Anzahl derjenigen Personen einer untersuchten Gruppe, die sterben (oft bezogen auf 1 Jahr und 1.000/100.000 Personen, Rate)"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "b991416b-fcb5-4a2e-b591-55693a0685e4",
                                "sense_id": "34b87bac-edfe-3106-a3c3-d8ace0590656",
                                "text": "„Die einfachste Maßzahl der Mortalität ist die rohe Sterblichkeitsrate oder Sterbeziffer. Sie erfasst die absolute Anzahl der Todesfälle pro 100.000 Einwohner/innen der ständigen Wohnbevölkerung über einen bestimmten Zeitraum […].“"
                            },
                            {
                                "example_id": "9a7ad71d-e7be-43e9-a7af-491f96025cb5",
                                "sense_id": "34b87bac-edfe-3106-a3c3-d8ace0590656",
                                "text": "„Als Ursache der hohen Sterblichkeitsrate bei Heroinsüchtigen wird häufig die Überdosis angeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
