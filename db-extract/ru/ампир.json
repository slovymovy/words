                    {
                        "translation_id": "36928b9f-fedc-4f43-ba94-5ef4f3c4d61e",
                        "source_entry_id": "f2c3469a-2a34-3f62-8a61-7f2f2731fb73",
                        "source_sense_id": "5c28b9e5-b112-3cb8-8343-ca14506e5cfc",
