                        "entry_id": "895e6ca2-cc2c-3eb8-865b-edede1375b1b",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Liegeplatz"
                    },
                    {
                        "form_id": "faced4f7-f394-4b6b-b66a-ed098e4d465f",
                        "entry_id": "895e6ca2-cc2c-3eb8-865b-edede1375b1b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Liegeplätze"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b78a10c-414e-3b8b-97d1-92f607cef6f4",
                        "entry_id": "895e6ca2-cc2c-3eb8-865b-edede1375b1b",
                        "glosses": [
                            "Stelle in einem Hafen oder am Ufer, an der ein Wasserfahrzeug (zum Beispiel Boot) für eine gewisse Zeit angelegen darf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c673459-632d-4efe-9319-a3e694751873",
                                "sense_id": "3b78a10c-414e-3b8b-97d1-92f607cef6f4",
                                "text": "„In Hamburg gibt es 320 Liegeplätze an 41 Kilometern Kaimauer, an denen täglich etwa 30 Handelsschiffe anlegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b634fee1-dbdf-38a3-8402-c059943f30dd",
                        "entry_id": "895e6ca2-cc2c-3eb8-865b-edede1375b1b",
                        "glosses": [
                            "Platz in einem Verkehrsmittel, wo man sich hinlegen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b50e4a7-89d3-4789-8192-8e9bd068d33e",
                                "sense_id": "b634fee1-dbdf-38a3-8402-c059943f30dd",
                                "text": "„Auf langen Fahrstrecken, wie sie besonders im Osten vorliegen, ist es dringend wünschbar, auch Reisenden 3. Klasse einen Liegeplatz zu bieten; anderseits sind ausgesprochene Schlafwagen hierfür zu teuer.“"
                            },
                            {
                                "example_id": "49b54e4d-4b53-4972-bdcc-a2120b0c6d26",
                                "sense_id": "b634fee1-dbdf-38a3-8402-c059943f30dd",
                                "text": "„[…] in Einbett-Abteilen können die Sitzplätze in Liegeplätze (Längsrichtung) umgewandelt werden.“"
                            },
                            {
                                "example_id": "e5a7dacc-0f02-4163-95d9-d0cb1954cec4",
                                "sense_id": "b634fee1-dbdf-38a3-8402-c059943f30dd",
                                "text": "„Zudem gibt es 38 weitere Liegeplätze, wobei für 16 Patienten eine verstärkte medizinische Überwachung mit Monitoren möglich ist. “"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
