{
    "word_family": [
        "вероятность",
        "вероятный",
        "невероятный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8e6c8894-2caa-3d97-90a4-97cd6cd559b7",
                    "sense_definition": "Вводное слово, выражающее предположение, допущение или высокую степень уверенности говорящего; то же, что «наверное», «по-видимому».",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "parenthetic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы, <w>вероятно</w>, опоздаем на встречу из-за пробок.",
                            "target_lang_translations": {
                                "en": "We will <w>probably</w> be late for the meeting due to traffic.",
                                "zh": "因为堵车，我们<w>大概</w>会迟到。"
                            }
                        },
                        {
                            "text": "Он, <w>вероятно</w>, забыл позвонить мне вчера вечером.",
                            "target_lang_translations": {
                                "en": "He <w>probably</w> forgot to call me last night.",
                                "zh": "他<w>可能</w>是昨晚忘了给我打电话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "возможно",
                        "наверное",
                        "по-видимому"
                    ],
                    "common_phrases": [
                        "вполне вероятно",
                        "весьма вероятно"
                    ],
                    "target_lang_definitions": {
                        "en": "Introductory word expressing an assumption or a high degree of certainty; similar to \"probably\" or \"apparently\".",
                        "zh": "用作插入语，表示说话人的推测、假设或较高程度的确定性；相当于“大概”、“可能”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "probably",
                                "target_lang_sense_clarification": "adverb indicating high likelihood"
                            },
                            {
                                "target_lang_word": "most likely",
                                "target_lang_sense_clarification": "phrase indicating very high probability"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大概",
                                "target_lang_sense_clarification": "表示推测，可能性较高"
                            },
                            {
                                "target_lang_word": "可能",
                                "target_lang_sense_clarification": "表示不确定但有一定可能性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f904cf4f-c772-3b54-ab15-a207bac1ed6a",
                    "sense_definition": "Предикатив, дающий оценку ситуации как возможной, допустимой или ожидаемой.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "predicative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Очень <w>вероятно</w>, что завтра пойдёт сильный дождь.",
                            "target_lang_translations": {
                                "en": "It is very <w>likely</w> that it will rain heavily tomorrow.",
                                "zh": "明天<w>很有可能</w>会有大雨。"
                            }
                        },
                        {
                            "text": "Это событие более <w>вероятно</w>, чем вы думаете.",
                            "target_lang_translations": {
                                "en": "This event is more <w>likely</w> than you think.",
                                "zh": "这件事发生的可能性比你想象的要<w>大</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "возможно"
                    ],
                    "antonyms": [
                        "невероятно"
                    ],
                    "common_phrases": [
                        "очень вероятно",
                        "мало вероятно"
                    ],
                    "target_lang_definitions": {
                        "en": "Predicative expression assessing a situation as possible, admissible, or expected.",
                        "zh": "谓语性表达，用于评估某种情况发生的可能性或预期性。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "likely",
                                "target_lang_sense_clarification": "used in constructions like 'it is likely'"
                            },
                            {
                                "target_lang_word": "probable",
                                "target_lang_sense_clarification": "formal assessment of probability"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "很有可能",
                                "target_lang_sense_clarification": "表示事情发生的概率很高"
                            },
                            {
                                "target_lang_word": "大概率",
                                "target_lang_sense_clarification": "用于描述事件发生的可能性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "202bbe09-f638-3dc6-9728-07544cfe8d25",
                    "sense_definition": "Употребляется как самостоятельный ответ для выражения неуверенного подтверждения.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "response",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Ты пойдёшь с нами в кино? — <w>Вероятно</w>.",
                            "target_lang_translations": {
                                "en": "— Are you coming to the movies with us? — <w>Probably</w>.",
                                "zh": "— 你跟我们一起去看电影吗？— <w>大概吧</w>。"
                            }
                        },
                        {
                            "text": "— Они уже уехали домой? — <w>Вероятно</w>.",
                            "target_lang_translations": {
                                "en": "— Have they already gone home? — <w>Probably</w>.",
                                "zh": "— 他们已经回家了吗？— <w>可能吧</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "возможно"
                    ],
                    "target_lang_definitions": {
                        "en": "Used as a standalone answer to express uncertain confirmation.",
                        "zh": "用作独立回答，表示不确定的肯定。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "probably",
                                "target_lang_sense_clarification": "short answer indicating likelihood"
                            },
                            {
                                "target_lang_word": "quite possibly",
                                "target_lang_sense_clarification": "response indicating a good chance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大概吧",
                                "target_lang_sense_clarification": "用于回答，表示不完全确定但倾向于肯定"
                            },
                            {
                                "target_lang_word": "可能吧",
                                "target_lang_sense_clarification": "用于回答，表示可能性存在"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "65a8948a-ab22-3b01-9346-d46b8b1c3713",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>вероятный</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Такое объяснение вполне <w>вероятно</w> и звучит логично.",
                            "target_lang_translations": {
                                "en": "Such an explanation is quite <w>plausible</w> and sounds logical.",
                                "zh": "这种解释很<w>合理</w>，听起来很有逻辑。"
                            }
                        },
                        {
                            "text": "Наступление холодов в октябре было весьма <w>вероятно</w>.",
                            "target_lang_translations": {
                                "en": "The onset of cold weather in October was very <w>likely</w>.",
                                "zh": "十月份天气变冷是很<w>有可能的</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short neuter form of the adjective \"probable\".",
                        "zh": "形容词“可能的”的中性短尾形式，用于描述情况合理或有发生的可能。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "likely",
                                "target_lang_sense_clarification": "describing an event or outcome"
                            },
                            {
                                "target_lang_word": "plausible",
                                "target_lang_sense_clarification": "reasonable or probable (of an explanation)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "合理的",
                                "target_lang_sense_clarification": "指解释或理由站得住脚"
                            },
                            {
                                "target_lang_word": "有可能的",
                                "target_lang_sense_clarification": "指事件发生的可能性"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}