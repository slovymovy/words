                        "examples": [
                            {
                                "example_id": "28617c57-3b25-4da6-95d0-f2a1ceb042a1",
                                "sense_id": "1af6a911-e568-33bf-b615-4bba43019f81",
                                "text": "Hij beet op zijn onderlip van nervositeit.",
                                "translation": "He bit his lower lip out of nervousness.",
                                "english": "He bit his lower lip out of nervousness."
                            },
                            {
                                "example_id": "0d67353c-d2b8-42e8-a0de-e4d6bdcac9e9",
                                "sense_id": "1af6a911-e568-33bf-b615-4bba43019f81",
                                "text": "De zangeres raakte haar onderlip aan tijdens het zingen.",
                                "translation": "The singer touched her lower lip while singing.",
                                "english": "The singer touched her lower lip while singing."
                            },
                            {
                                "example_id": "62f92c5f-9d28-495d-a353-22c130c8529d",
                                "sense_id": "1af6a911-e568-33bf-b615-4bba43019f81",
                                "text": "Hij veegde de kruimels van zijn onderlipje na het eten.",
                                "translation": "He wiped the crumbs off his lower lip after eating.",
                                "english": "He wiped the crumbs off his lower lip after eating."
                            }
                        ]
                    }
                ],
