                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The British Columbia <w>Interior</w> is known for its diverse climate and beautiful mountain ranges.",
                            "target_lang_translations": {
                                "ru": "Регион <w>Интериор</w> в Британской Колумбии известен своим разнообразным климатом и красивыми горными хребтами.",
                                "zh": "不列颠哥伦比亚省<w>内陆地区</w>以多样的气候和美丽的山脉闻名。"
                            }
                        },
                        {
                            "text": "Many tourists visit the <w>Interior</w> of BC during the summer for hiking and lake activities.",
                            "target_lang_translations": {
                                "ru": "Многие туристы посещают <w>Интериор</w> Британской Колумбии летом ради походов и отдыха на озерах.",
                                "zh": "夏天，许多游客前往不列颠哥伦比亚省<w>内陆地区</w>徒步和参加湖上活动。"
                            }
                        }
                    ],
