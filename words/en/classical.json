{
    "word_family": [
        "classic",
        "classicism",
        "classicist",
        "neoclassic",
        "neoclassical",
        "classically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "15c94c89-c937-3f74-9f96-574e6a8d56fb",
                    "sense_definition": "Describing serious art music, often played by an orchestra, as opposed to pop, jazz, or folk.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "music_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She enjoys listening to <w>classical</w> music while she studies.",
                            "target_lang_translations": {
                                "ru": "Она любит слушать <w>классическую</w> музыку во время учебы.",
                                "zh": "她学习时喜欢听<w>古典</w>音乐。"
                            }
                        },
                        {
                            "text": "The radio station plays a mix of jazz and <w>classical</w> pieces.",
                            "target_lang_translations": {
                                "ru": "Радиостанция ставит в эфир смесь джаза и <w>классических</w> произведений.",
                                "zh": "这家电台播放爵士乐和<w>古典</w>乐曲的混合节目。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "classical music",
                        "classical concert",
                        "classical composer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к серьезной художественной музыке, часто исполняемой оркестром, в отличие от поп-музыки, джаза или фолка.",
                        "zh": "指严肃的艺术音乐，通常由管弦乐队演奏，区别于流行音乐、爵士乐或民间音乐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "классический",
                                "target_lang_sense_clarification": "о музыке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "古典",
                                "target_lang_sense_clarification": "指音乐风格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fd7c13a-6601-38cd-a570-0d40e9d0ec48",
                    "sense_definition": "Relating to the language, literature, history, and culture of ancient Greece and Rome.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ancient_history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to study <w>classical</w> mythology at the university.",
                            "target_lang_translations": {
                                "ru": "Он решил изучать <w>классическую</w> мифологию в университете.",
                                "zh": "他决定在大学里研究<w>古典</w>神话。"
                            }
                        },
                        {
                            "text": "The museum contains many statues from the <w>classical</w> period.",
                            "target_lang_translations": {
                                "ru": "В музее находится много статуй <w>классического</w> периода.",
                                "zh": "博物馆里收藏了许多<w>古典</w>时期的雕像。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "classical mythology",
                        "classical civilization",
                        "classical studies",
                        "classical languages"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к языку, литературе, истории и культуре Древней Греции и Рима.",
                        "zh": "与古希腊和古罗马的语言、文学、历史和文化有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "классический",
                                "target_lang_sense_clarification": "относящийся к античности"
                            },
                            {
                                "target_lang_word": "античный",
                                "target_lang_sense_clarification": "древнегреческий или древнеримский"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "古典",
                                "target_lang_sense_clarification": "指古代文明"
                            },
                            {
                                "target_lang_word": "古代",
                                "target_lang_sense_clarification": "指希腊罗马时期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afbe9a69-0556-3aaf-8801-1e0719720ba3",
                    "sense_definition": "Following established, traditional styles or principles in art, literature, or science, rather than modern or experimental ones.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "traditional_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has been trained in <w>classical</w> ballet since she was a child.",
                            "target_lang_translations": {
                                "ru": "Она обучалась <w>классическому</w> балету с детства.",
                                "zh": "她从小就接受<w>古典</w>芭蕾舞训练。"
                            }
                        },
                        {
                            "text": "The building features a <w>classical</w> design with tall white columns.",
                            "target_lang_translations": {
                                "ru": "Здание отличается <w>классическим</w> дизайном с высокими белыми колоннами.",
                                "zh": "这座建筑采用了带有高大白色圆柱的<w>古典</w>设计。"
                            }
                        }
                    ],
                    "synonyms": [
                        "classic"
                    ],
                    "common_phrases": [
                        "classical ballet",
                        "classical architecture",
                        "classical education"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следующий устоявшимся, традиционным стилям или принципам в искусстве, литературе или науке, в отличие от современных или экспериментальных.",
                        "zh": "在艺术、文学或科学中遵循既定的、传统的风格或原则，而非现代或实验性的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "классический",
                                "target_lang_sense_clarification": "традиционный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "古典",
                                "target_lang_sense_clarification": "指传统风格"
                            },
                            {
                                "target_lang_word": "传统",
                                "target_lang_sense_clarification": "指遵循旧制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a658bbe2-8847-3b62-9b2b-e76c222c51fb",
                    "sense_definition": "Relating to physics theories based on Newton's laws that do not include quantum or relativistic effects.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Classical</w> mechanics works well for describing the motion of everyday objects.",
                            "target_lang_translations": {
                                "ru": "<w>Классическая</w> механика хорошо подходит для описания движения обычных объектов.",
                                "zh": "<w>经典</w>力学在描述日常物体的运动时非常有效。"
                            }
                        },
                        {
                            "text": "Some phenomena cannot be explained by <w>classical</w> physics and require quantum theory.",
                            "target_lang_translations": {
                                "ru": "Некоторые явления не могут быть объяснены <w>классической</w> физикой и требуют квантовой теории.",
                                "zh": "有些现象无法用<w>经典</w>物理学解释，需要量子理论。"
                            }
                        }
                    ],
                    "antonyms": [
                        "quantum",
                        "relativistic"
                    ],
                    "common_phrases": [
                        "classical mechanics",
                        "classical physics",
                        "classical theory"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к физическим теориям, основанным на законах Ньютона, которые не включают квантовые или релятивистские эффекты.",
                        "zh": "指基于牛顿定律、不包含量子或相对论效应的物理学理论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "классический",
                                "target_lang_sense_clarification": "в физике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经典",
                                "target_lang_sense_clarification": "物理学用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48c4d36a-d4bc-39a1-bbcc-0c403e3c2dbb",
                    "sense_definition": "Relating specifically to the period of Western music from about 1750 to 1820, characterized by composers like Mozart and Haydn.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music_era",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>classical</w> era followed the Baroque period and preceded the Romantic era.",
                            "target_lang_translations": {
                                "ru": "<w>Классическая</w> эпоха следовала за периодом барокко и предшествовала эпохе романтизма.",
                                "zh": "<w>古典</w>主义时期继巴洛克时期之后，在浪漫主义时期之前。"
                            }
                        },
                        {
                            "text": "Sonata form was widely developed and used during the <w>classical</w> period.",
                            "target_lang_translations": {
                                "ru": "Сонатная форма получила широкое развитие и использовалась в <w>классический</w> период.",
                                "zh": "奏鸣曲式在<w>古典</w>时期得到了广泛的发展和应用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "classical era",
                        "classical period"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "musicology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся конкретно к периоду западной музыки примерно с 1750 по 1820 год, для которого характерны такие композиторы, как Моцарт и Гайдн.",
                        "zh": "特指约1750年至1820年间的西方音乐时期，以莫扎特和海顿等作曲家为代表。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "классический",
                                "target_lang_sense_clarification": "относящийся к эпохе классицизма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "古典主义",
                                "target_lang_sense_clarification": "音乐史时期"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bb6b5d23-ff52-31f7-b4b4-97c3e40a2432",
                    "sense_definition": "Classical music.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "music_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually prefer rock, but my brother listens to <w>classical</w>.",
                            "target_lang_translations": {
                                "ru": "Я обычно предпочитаю рок, но мой брат слушает <w>классику</w>.",
                                "zh": "我通常更喜欢摇滚乐，但我哥哥听<w>古典</w>乐。"
                            }
                        },
                        {
                            "text": "She has a large collection of jazz and <w>classical</w> on vinyl.",
                            "target_lang_translations": {
                                "ru": "У нее большая коллекция джаза и <w>классики</w> на виниле.",
                                "zh": "她收藏了大量的爵士乐和<w>古典</w>乐黑胶唱片。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "listen to classical"
                    ],
                    "target_lang_definitions": {
                        "ru": "Классическая музыка.",
                        "zh": "古典音乐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "классика",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "古典乐",
                                "target_lang_sense_clarification": "指古典音乐"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}