                        "glosses": [
                            "En France, structure associative créée pour gérer et protéger des espaces naturels ou semi-naturels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a656695-1ec4-434d-9ed8-fafd4a420b42",
                                "sense_id": "c158ffc5-5614-3ee2-bd19-05bbbcb5e6ad",
                                "text": "Mais, « en huit ans, il a perdu environ 15 % de sa masse », glisse Jean-Baptiste Bosson, glaciologue au Conservatoire des espaces naturels (CEN) de Haute-Savoie."
                            },
                            {
                                "example_id": "2f403023-5f22-492f-b759-4e941286c7c1",
                                "sense_id": "c158ffc5-5614-3ee2-bd19-05bbbcb5e6ad",
                                "text": "Les CEN sont des organismes qui peuvent mener des actions de connaissance, de gestion, de valorisation ou sur le foncier ou son usage, en faveur d’espaces naturels."
                            }
                        ]
