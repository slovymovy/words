                        "examples": [
                            {
                                "example_id": "1e415d4e-b76f-49dd-a785-555f8fdce835",
                                "sense_id": "8d99e153-ac17-3075-9f17-f16b2876c19f",
                                "text": "Stravinsky bepleitte een Ford Foundation ter Bestrijding van Middelmatige Amerikaanse Componisten en ook Boulez vond ze op een enkele na maar hoogst onbegaafd."
                            },
                            {
                                "example_id": "4779e16a-112b-4bc4-8a30-bd3891987da5",
                                "sense_id": "8d99e153-ac17-3075-9f17-f16b2876c19f",
                                "text": "In Oxford geeft geld, niet hersens de doorslag. Op Pembrooke College kon een onbegaafde bankierszoon dankzij pa's financiële gift studeren. Op Magdalen College werd eerder een meisje met topcijfers afgewezen omdat zij zich aan de selectiecommissie niet voldoende had `verkocht'."
                            }
                        ]
                    }
