        "fr-extract.jsonl": [
            {
                "entry_id": "64986b6f-b3a6-3f3a-991c-34a9c524fa86",
                "word": "bastonnade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "660c4456-8401-42f1-8c31-1159b19ff46c",
                        "entry_id": "64986b6f-b3a6-3f3a-991c-34a9c524fa86",
                        "tags": [
                            "plural"
                        ],
                        "form": "bastonnades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33e1807b-84f4-3e00-8371-62e600e86ffc",
                        "entry_id": "64986b6f-b3a6-3f3a-991c-34a9c524fa86",
                        "glosses": [
                            "Volée de coups de bâton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd0148d-caac-4e28-95d7-95ebcaa86652",
                                "sense_id": "33e1807b-84f4-3e00-8371-62e600e86ffc",
                                "text": "Le 7 septembre 1700, le major lui fit donner une bastonnade de soixante-seize coups de la corde goudronnée et trempée à la mer. Le lendemain, il lui fit donner une seconde bastonnade de quarante-un coups, lui disant : « À demain, à demain ; songe à ce que tu auras à faire. »"
                            },
                            {
                                "example_id": "400d61e8-fafc-43cd-85c8-d144a3e9fca2",
                                "sense_id": "33e1807b-84f4-3e00-8371-62e600e86ffc",
                                "text": "Dans les premiers âges historiques, on ne voit pas seulement les maîtres frapper et fouetter leurs esclaves ; les rois eux-mêmes administrent le supplice de la bastonnade."
                            },
                            {
                                "example_id": "6523d9a5-52d9-43d6-83bd-a042bee70970",
                                "sense_id": "33e1807b-84f4-3e00-8371-62e600e86ffc",
                                "text": "Qu’est-ce que c’est que cette batterie où vous avez contus de bastonnade un petit vicomte Albert de Ramonchamp ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5b75b95-7022-4447-86a9-fb873e8e139f",
                        "source_entry_id": "64986b6f-b3a6-3f3a-991c-34a9c524fa86",
                        "source_sense_id": "33e1807b-84f4-3e00-8371-62e600e86ffc",
                        "target_lang_word": "Stockschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stockschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7942a3e4-971a-3751-a044-a1bf7e7b4cae",
                                        "entry_id": "bc40ae1f-a186-3c35-be66-c4819f59f747",
                                        "glosses": [
                                            "kräftiger Schlag, ausgeführt mit einem Stock"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1bff499-3fac-4740-afe7-3b6f65e2e7f2",
                                                "sense_id": "7942a3e4-971a-3751-a044-a1bf7e7b4cae",
                                                "text": "„Da trifft ihn ein Stockschlag auf den Hinterkopf.“"
                                            },
                                            {
                                                "example_id": "e5b5c20c-6c83-41a8-b16e-8a02286fa77f",
                                                "sense_id": "7942a3e4-971a-3751-a044-a1bf7e7b4cae",
                                                "text": "„Sie erzählte mir die Neuigkeit, daß Teresa Imer, jene Teresa, deretwegen mir der alte Senator Malipiero dreizehn Jahre zuvor Stockschläge verabreicht hatte, gerade aus Bayreuth angekommen sei, wo sie durch den Markgrafen Karriere gemacht hatte.“"
                                            },
                                            {
                                                "example_id": "f081483c-4895-49f3-a9e1-29fbc0418e3f",
                                                "sense_id": "7942a3e4-971a-3751-a044-a1bf7e7b4cae",
                                                "text": "„Mit ein paar Stockschlägen hätten sie sich dort unter Hunderten von Pinguinen einen gehörigen Fleischvorrat verschaffen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9b046c9-4764-4325-9020-a702f46224a6",
                        "source_entry_id": "64986b6f-b3a6-3f3a-991c-34a9c524fa86",
                        "source_sense_id": "33e1807b-84f4-3e00-8371-62e600e86ffc",
                        "target_lang_word": "Stockstrafe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "586fd6e1-cece-4271-a1ef-1461f198c98d",
                        "source_entry_id": "64986b6f-b3a6-3f3a-991c-34a9c524fa86",
                        "source_sense_id": "33e1807b-84f4-3e00-8371-62e600e86ffc",
                        "target_lang_word": "Bastonade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bastonade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffcb321a-9f21-3713-adcd-713cd37e7c1b",
                                        "entry_id": "b72cf8f1-dd73-3a3d-8f2b-cabfa492307a",
                                        "glosses": [
                                            "Züchtigungspraktik oder Foltermethode, bei der eine Folge von Hieben auf die bloßen Fußsohlen einer Person vollzogen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfde2aac-9683-4b8c-a539-075cbfc60ef3",
                                                "sense_id": "ffcb321a-9f21-3713-adcd-713cd37e7c1b",
                                                "text": "„Auf das Verbrechen des Mitleids mit Armeniern stand laut den neuen Gesetzen Bastonade, Gefängnis, und in schweren Fällen der Tod.“"
                                            },
                                            {
                                                "example_id": "55243a71-0097-4220-b6ce-d456f6d33182",
                                                "sense_id": "ffcb321a-9f21-3713-adcd-713cd37e7c1b",
                                                "text": "„Aber wer zur Bastonade muß, trägt es mannhaft.“"
                                            },
                                            {
                                                "example_id": "a8cc0a93-3499-40b2-958b-d046869ad60b",
                                                "sense_id": "ffcb321a-9f21-3713-adcd-713cd37e7c1b",
                                                "text": "„Seine Gliedmaßen, geschwollen und steif von der gestrigen Bastonade, versagten den Dienst, seine klammen Finger waren außerstande, einen Pinsel zu halten, geschweige denn zu führen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c231d2b-42ec-4d8a-ba2e-395e411efe9f",
