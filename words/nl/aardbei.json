                },
                {
                    "sense_id": "44402cba-26da-37cc-9e55-45d23cb70847",
                    "sense_definition": "Iets met de smaak of geur van aardbeien, vaak gebruikt als aanduiding voor een smaakvariant.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "smaak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Welke smaak ijs wil je hebben, chocolade of <w>aardbei</w>?",
                            "target_lang_translations": {
                                "en": "Which flavor of ice cream would you like, chocolate or <w>strawberry</w>?"
                            }
                        },
                        {
                            "text": "Deze yoghurt met de smaak van <w>aardbei</w> is erg populair bij kinderen.",
                            "target_lang_translations": {
                                "en": "This <w>strawberry</w>-flavored yogurt is very popular with children."
