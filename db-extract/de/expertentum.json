                                                "sense_id": "7f311914-04b3-3b6d-88e4-be2c3656583a",
                                                "text": "The scientist has expertise in the field of nuclear fusion."
                                            },
                                            {
                                                "example_id": "30102674-40bc-4984-bed0-da42f31bb88d",
                                                "sense_id": "7f311914-04b3-3b6d-88e4-be2c3656583a",
                                                "text": "He spoke of Scotland's hydroelectric projects in Africa, local expertise shared with the world's poor."
                                            }
