                                    {
                                        "sense_id": "e2743988-1595-32bc-a85c-417cdf8507c8",
                                        "entry_id": "baa5cbb2-3577-3606-8211-4f9b41a1a053",
                                        "glosses": [
                                            "The act of setting apart and organizing things based upon their characteristics."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2247ffaf-ff9f-31f0-aefc-dc6241e40439",
                                        "entry_id": "baa5cbb2-3577-3606-8211-4f9b41a1a053",
                                        "glosses": [
                                            "The separation of people based upon race, sex, religion, or other identity in institutions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "352f05ff-f819-47f5-99f4-5762d3e4f231",
                                                "sense_id": "2247ffaf-ff9f-31f0-aefc-dc6241e40439",
                                                "text": "The fact that one is gay or one's brother is gay […] — this has less influence on the average HK person's attention or attitude than how he or she finds a job, the way he lives and the way he eats, which is like New York or oter large cities. There tends to be a segregation between a person's private life and his job or other affairs. It does not mean that they are liberal, just that city life fosters this individualism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "221e4fda-e968-3e5e-86cb-dba8b5006f6d",
                                        "entry_id": "baa5cbb2-3577-3606-8211-4f9b41a1a053",
                                        "glosses": [
                                            "The setting apart in Mendelian inheritance of alleles, such that each parent passes only one allele to its offspring."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3be1ec26-4cb3-3d9b-aff5-a5e9c0f35ee6",
                                        "entry_id": "baa5cbb2-3577-3606-8211-4f9b41a1a053",
                                        "glosses": [
                                            "Separation from a mass, and gathering about centers or into cavities at hand through cohesive or adhesive attraction or the crystallizing process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a345c521-dcd6-3b15-9ca6-a8e85c9350cf",
                                        "entry_id": "baa5cbb2-3577-3606-8211-4f9b41a1a053",
                                        "glosses": [
                                            "The separation of people (geographically, residentially, or in businesses, public transit, etc) into racial or other categories (e.g. religion, sex)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
