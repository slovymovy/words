    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d7e5727-559a-3e07-a43c-09a167f3b4f8",
                    "sense_definition": "A common breed of gun dog, specifically a <w>springer</w> spaniel, known for flushing out game.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter trained his <w>springer</w> to find birds in the tall grass.",
                            "target_lang_translations": {
                                "ru": "Охотник обучил своего <w>спрингера</w> находить птиц в высокой траве."
                            }
                        },
                        {
                            "text": "A loyal <w>springer</w> spaniel sat patiently by the door waiting for its owner.",
                            "target_lang_translations": {
                                "ru": "Верный <w>спрингер-спаниель</w> терпеливо сидел у двери, ожидая хозяина."
                            }
                        }
                    ],
                    "synonyms": [
                        "springer spaniel"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Популярная порода охотничьих собак, в частности спрингер-спаниель, известная своим умением спугивать дичь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спрингер",
                                "target_lang_sense_clarification": "порода собаки"
                            },
                            {
                                "target_lang_word": "спрингер-спаниель",
                                "target_lang_sense_clarification": "полное название породы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "489ae542-1629-38ab-94fc-82df35320738",
                    "sense_definition": "The lowest stone of an arch, resting directly on the support from which the arch begins to curve.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mason carefully placed the <w>springer</w> to ensure the arch would be stable.",
                            "target_lang_translations": {
                                "ru": "Каменщик осторожно установил <w>пяту</w>, чтобы обеспечить устойчивость арки."
                            }
                        },
                        {
                            "text": "You can see the decorative carvings on the <w>springer</w> at the base of the stone arch.",
                            "target_lang_translations": {
                                "ru": "Вы можете увидеть декоративную резьбу на <w>пятовом камне</w> в основании каменной арки."
                            }
                        }
                    ],
                    "synonyms": [
                        "skewback"
                    ],
                    "common_phrases": [
                        "arch springer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самый нижний камень арки, опирающийся непосредственно на опору, с которой начинается изгиб арки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пята арки",
                                "target_lang_sense_clarification": "архитектурный термин"
                            },
                            {
                                "target_lang_word": "спрингер",
                                "target_lang_sense_clarification": "в архитектуре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d3396e9-88f7-3a9a-aa5f-68b9591e2128",
                    "sense_definition": "A person or animal that jumps or leaps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete was a natural <w>springer</w> who excelled at the high jump.",
                            "target_lang_translations": {
                                "ru": "Атлет был прирожденным <w>прыгуном</w> и преуспел в прыжках в высоту."
                            }
                        },
                        {
                            "text": "As a powerful <w>springer</w>, the cat easily reached the top of the fence.",
                            "target_lang_translations": {
                                "ru": "Будучи сильным <w>прыгуном</w>, кот легко добрался до верха забора."
                            }
                        }
                    ],
                    "synonyms": [
                        "jumper",
                        "leaper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или животное, которое прыгает или совершает скачки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыгун",
                                "target_lang_sense_clarification": "тот, кто прыгает"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85dcb275-3191-330a-8d63-9a0a84cd65a8",
                    "sense_definition": "A salmon that runs up a river in the spring.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Local fishermen eagerly await the arrival of the first <w>springer</w> of the season.",
                            "target_lang_translations": {
                                "ru": "Местные рыбаки с нетерпением ждут появления первого <w>весеннего лосося</w> в этом сезоне."
                            }
                        },
                        {
                            "text": "The <w>springer</w> salmon is highly prized for its flavor and firm texture.",
                            "target_lang_translations": {
                                "ru": "Лосось-<w>спрингер</w> высоко ценится за свой вкус и плотную текстуру."
                            }
                        }
                    ],
                    "synonyms": [
                        "spring salmon"
                    ],
                    "common_phrases": [
                        "springer salmon"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in fishing contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лосось, идущий вверх по реке весной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весенний лосось",
                                "target_lang_sense_clarification": "рыба, идущая на нерест весной"
                            },
                            {
                                "target_lang_word": "спрингер",
                                "target_lang_sense_clarification": "рыболовный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39f51b5b-ff32-3f0f-afe6-9709334e8061",
                    "sense_definition": "An informal name for a springbok, a medium-sized antelope found in southwestern Africa.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spotted a lone <w>springer</w> grazing on the open plains during our safari.",
                            "target_lang_translations": {
                                "ru": "Во время сафари мы заметили одинокого <w>спрингбока</w>, пасущегося на открытой равнине."
                            }
                        },
                        {
                            "text": "The <w>springer</w> is known for its remarkable ability to leap high into the air.",
                            "target_lang_translations": {
                                "ru": "<w>Спрингбок</w> известен своей удивительной способностью высоко прыгать в воздух."
                            }
                        }
                    ],
                    "synonyms": [
                        "springbok"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal name for the animal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное название спрингбока, антилопы среднего размера, обитающей в юго-западной Африке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спрингбок",
                                "target_lang_sense_clarification": "вид антилопы"
                            },
                            {
                                "target_lang_word": "антилопа-прыгун",
                                "target_lang_sense_clarification": "описание поведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb4351aa-f589-31e7-8c69-727b365e2ef7",
                    "sense_definition": "A cow that is near to calving.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer moved the <w>springer</w> to a separate pen to monitor her closely.",
                            "target_lang_translations": {
                                "ru": "Фермер перевел <w>стельную корову</w> в отдельный загон, чтобы внимательно за ней наблюдать."
                            }
                        },
                        {
                            "text": "He decided to buy a healthy <w>springer</w> to increase his herd's milk production.",
                            "target_lang_translations": {
                                "ru": "Он решил купить здоровую <w>нетель</w>, чтобы увеличить производство молока в своем стаде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "springer cow"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in farming and livestock contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Корова, которая скоро должна отелиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нетель",
                                "target_lang_sense_clarification": "стельная корова"
                            },
                            {
                                "target_lang_word": "корова перед отелом",
                                "target_lang_sense_clarification": "описание состояния"
                            }
                        ]
                    }
                }
            ]
        },
        {
