                    {
                        "sense_id": "3559f3d6-ecd2-3131-a6c1-fe2f9787bb23",
                        "entry_id": "bcc4aac9-25ad-39c7-8bc5-05e171c88c75",
                        "glosses": [
                            "miasto w północnej Polsce, dawna stolica państwa krzyżackiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e8c5203-ed64-4f68-bdf1-38a47d696fd6",
                                "sense_id": "3559f3d6-ecd2-3131-a6c1-fe2f9787bb23",
                                "text": "Znanym wydarzeniem, nagłośnionym przez Krzyżaków w Europie, był napad w 1388 roku na oddział rycerski księcia geldryjskiego Wilhelma, zdążającego do Malborka i uwięzienie go na zamku w Złocieńcu"
                            },
                            {
                                "example_id": "e4541916-5f38-472b-8d49-44ac50bb7a14",
                                "sense_id": "3559f3d6-ecd2-3131-a6c1-fe2f9787bb23",
                                "text": "Z oddali widzieliśmy zamek krzyżacki w Malborku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
