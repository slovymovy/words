                                        "sense_id": "560b47df-d8e2-3076-b63f-7dc2ffae3a2c",
                                        "entry_id": "814fec14-1337-3699-8e06-38eb03de4693",
                                        "glosses": [
                                            "Personen- und Güterverkehr auf Wasserstraßen und dem offenen Meer, welche mit Hilfe von Schiffen erfolgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb886e49-4f77-49b8-871a-4628ab4d04cd",
                                                "sense_id": "560b47df-d8e2-3076-b63f-7dc2ffae3a2c",
                                                "text": "„Mehr als ein Drittel des weltweiten Schiffsverkehrs führt durch die Straße von Malakka und das angrenzende Südchinesische Meer.“"
                                            },
                                            {
                                                "example_id": "b81e4af2-722f-4695-add7-4641f6c265a1",
                                                "sense_id": "560b47df-d8e2-3076-b63f-7dc2ffae3a2c",
                                                "text": "„Ein festgefahrenes Küstenmotorschiff hat die Hafeneinfahrt von Wangerooge blockiert und damit den Schiffsverkehr von und zu der Nordseeinsel zum Stillstand gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10199e7c-e24a-4918-8cf9-a1f46c8b1902",
                        "source_entry_id": "0e406450-d6ef-3a48-bc56-1264390585ae",
