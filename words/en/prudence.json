{
    "word_family": [
        "prudent",
        "prudential",
        "prudently"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "792d04ef-4ae8-3b8c-b9a6-93494f9706d5",
                    "sense_definition": "The quality of being careful and sensible; good judgment in practical matters to avoid mistakes or risks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "good_judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Financial <w>prudence</w> dictates that we save at least three months of living expenses for unexpected emergencies.",
                            "target_lang_translations": {
                                "zh": "财务上的<w>谨慎</w>要求我们至少存够三个月的生活费，以应对突发紧急情况。"
                            }
                        },
                        {
                            "text": "The committee decided that <w>prudence</w> was necessary before investing such a large sum of public money.",
                            "target_lang_translations": {
                                "zh": "委员会决定，在投资如此大一笔公款之前，保持<w>慎重</w>是极其必要的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "discretion",
                        "judiciousness"
                    ],
                    "antonyms": [
                        "imprudence",
                        "rashness",
                        "recklessness"
                    ],
                    "common_phrases": [
                        "financial prudence",
                        "exercise prudence"
                    ],
                    "target_lang_definitions": {
                        "zh": "谨慎，深思熟虑；在实际事务中为规避错误或风险而表现出的良好判断力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "谨慎",
                                "target_lang_sense_clarification": "行事慎重、避免风险"
                            },
                            {
                                "target_lang_word": "慎重",
                                "target_lang_sense_clarification": "严肃认真、不轻率"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72ef73ed-f89d-3e11-ae93-99d2c23032b4",
                    "sense_definition": "Careful management of money and resources to avoid unnecessary waste; thrift.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "thrift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Through years of strict <w>prudence</w>, the family managed to pay off their mortgage much earlier than anticipated.",
                            "target_lang_translations": {
                                "zh": "经过多年严格的<w>节俭</w>，这个家庭比预期提前很久还清了房贷。"
                            }
                        },
                        {
                            "text": "Her natural <w>prudence</w> prevented her from spending money on items that were not strictly essential.",
                            "target_lang_translations": {
                                "zh": "她生性<w>节俭</w>，从不把钱花在非生活必需品上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frugality"
                    ],
                    "target_lang_definitions": {
                        "zh": "节俭，精打细算；对金钱和资源的审慎管理以避免浪费。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "节俭",
                                "target_lang_sense_clarification": "节省开支、不铺张"
                            },
                            {
                                "target_lang_word": "精打细算",
                                "target_lang_sense_clarification": "对资金和资源合理筹划"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7804febc-248b-3194-944d-1cc308c9650a",
                    "sense_definition": "Careful preparation for the future, characterized by foresight and provision.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "foresight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With admirable <w>prudence</w>, the captain checked the changing weather forecasts before guiding the vessel out to sea.",
                            "target_lang_translations": {
                                "zh": "出于令人赞许的<w>谨慎</w>，船长在引导船只出海前仔细查看了不断变化的天气预报。"
                            }
                        },
                        {
                            "text": "They lacked the <w>prudence</w> to plan for the upcoming winter, which left them vulnerable when supplies ran low.",
                            "target_lang_translations": {
                                "zh": "他们缺乏为即将到来的冬季做规划的<w>远见</w>，导致在物资短缺时陷入了困境。"
                            }
                        }
                    ],
                    "synonyms": [
                        "farsightedness",
                        "providence"
                    ],
                    "target_lang_definitions": {
                        "zh": "远见，防患未然；为了未来而展现出的预见力与周全准备。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "远见",
                                "target_lang_sense_clarification": "对未来的预见与周详准备"
                            },
                            {
                                "target_lang_word": "深谋远虑",
                                "target_lang_sense_clarification": "周密长远的考量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86b33c6e-5225-3aee-83e5-dc9446542f5e",
                    "sense_definition": "Wisdom and deep understanding applied to moral conduct and practical decision-making.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wisdom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient philosophers often regarded <w>prudence</w> as the cardinal virtue guiding all moral action.",
                            "target_lang_translations": {
                                "zh": "古代哲学家通常将<w>明智</w>视为统领一切道德行为的首要枢德。"
                            }
                        },
                        {
                            "text": "The elderly leader spoke with profound <w>prudence</w>, calming the anxious crowd with measured words.",
                            "target_lang_translations": {
                                "zh": "这位年长的领袖讲话极具<w>智慧</w>，用审慎的分寸安抚了焦虑的人群。"
                            }
                        }
                    ],
                    "synonyms": [
                        "discernment",
                        "sagacity",
                        "wisdom"
                    ],
                    "target_lang_definitions": {
                        "zh": "明智，实践智慧；运用于道德行为与实践决断中的深刻洞察与智慧。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "明智",
                                "target_lang_sense_clarification": "通达事理的智慧"
                            },
                            {
                                "target_lang_word": "智慧",
                                "target_lang_sense_clarification": "实践与道德层面上的洞察力"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ece62951-c9c8-3243-9acb-b572fa9dcc24",
                    "sense_definition": "A female given name, originally popular as a Puritan virtue name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Prudence</w> greeted the guests warmly as soon as they walked through the front door.",
                            "target_lang_translations": {
                                "zh": "客人一跨进大门，<w>普鲁登丝</w>就热情地迎接了他们。"
                            }
                        },
                        {
                            "text": "Her grandmother was named <w>Prudence</w>, following a long-standing family naming tradition.",
                            "target_lang_translations": {
                                "zh": "按照悠久的家族命名传统，她的祖母被取名为<w>普鲁登丝</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "普鲁登丝（女子教名，源于清教徒美德名）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "普鲁登丝",
                                "target_lang_sense_clarification": "女性人名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}