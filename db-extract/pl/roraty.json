                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3e1690-6e1e-4721-8d2b-606dc52497b3",
                                                "sense_id": "72e04e97-bba3-3e2b-b866-b9fd72e34b5e",
                                                "text": "„Alle Beteiligten überzeugten mit einem bewegenden, feierlichen Konzertprogramm zum vierten Adventssonntag „Rorate“.“"
                                            }
