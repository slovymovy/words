                        "entry_id": "9dd4c569-8e36-32e9-b164-a2f123417d0c",
                        "glosses": [
                            "The cell in Newgate prison for a prisoner condemned to death."
                        ],
                        "tags": [
                            "UK",
                            "historical",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7148f58b-d05c-45fe-92cb-4529daadbc15",
                                "sense_id": "fefb1f07-1e28-3aa4-9c4c-3e1954879665",
                                "text": "“I think I'd rather languish in the Salt Box at Newgate Prison wearing the Devil's Claws than to be married to that tree,” Kierney said."
                            },
                            {
                                "example_id": "f108294b-ee8b-4910-bf95-ced0d60e615e",
                                "sense_id": "fefb1f07-1e28-3aa4-9c4c-3e1954879665",
                                "text": "As expected, Peg was indeed cast for death and was moved to the 'salt box' (the condemned cell) in the Press-yard to be near the New Drop."
                            }
                        ]
