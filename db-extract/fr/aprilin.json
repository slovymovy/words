                                                "text": "Frau Frühling ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "5cf75b44-52bb-4cf3-be00-8812a3267810",
                                                "sense_id": "bf574a97-7a28-3985-ac3c-d0ec05f12269",
                                                "text": "Herr Frühling wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "537b3479-d56c-404c-8a68-613f97543ac5",
                                                "sense_id": "bf574a97-7a28-3985-ac3c-d0ec05f12269",
                                                "text": "Die Frühlings fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "631f3556-6413-4b5a-9621-28d7ff1a2f7e",
                                                "sense_id": "bf574a97-7a28-3985-ac3c-d0ec05f12269",
                                                "text": "Der Frühling trägt nie die Schals, die die Frühling ihm strickt."
                                            },
                                            {
                                                "example_id": "8ba78743-09f3-4ac4-9f3b-cb1ba36eee4b",
                                                "sense_id": "bf574a97-7a28-3985-ac3c-d0ec05f12269",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Frühling kommt, geht der Herr Frühling.“"
                                            },
                                            {
                                                "example_id": "dcba8957-3bd5-4ce7-8fda-5f1a04b53ce8",
                                                "sense_id": "bf574a97-7a28-3985-ac3c-d0ec05f12269",
                                                "text": "Frühling kommt und geht."
                                            },
                                            {
                                                "example_id": "d864a438-bfd6-4c37-9c1e-eef35a15b821",
                                                "sense_id": "bf574a97-7a28-3985-ac3c-d0ec05f12269",
                                                "text": "Frühlings kamen, sahen und siegten."
                                            }
