                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc66f1bd-7083-3a1a-a0e2-4532109bd9fb",
                                        "entry_id": "08e51b10-536c-3378-b363-337e67df456e",
                                        "glosses": [
                                            "The tenure in office of a bishop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4ed8d6e-5488-443d-abe5-2a213e0d5b5a",
                                                "sense_id": "bc66f1bd-7083-3a1a-a0e2-4532109bd9fb",
                                                "text": "Bishop Smith's episcopate ran for more than 30 years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7bea7e5-fa62-3789-a6fa-f5620256b915",
                                        "entry_id": "08e51b10-536c-3378-b363-337e67df456e",
                                        "glosses": [
                                            "A bishop's jurisdiction, the extent of his diocese."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
