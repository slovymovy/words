{
    "word_family": [
        "покупка",
        "покупатель",
        "покупательница",
        "покупательный",
        "купля",
        "купец",
        "купание",
        "купальня",
        "купальник"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19eeb807-9844-3477-af26-0ebef44fcb0e",
                    "sense_definition": "Приобретать что-либо в собственность за деньги.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "покупка",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждый день я <w>покупаю</w> свежий хлеб в магазине рядом с домом.",
                            "target_lang_translations": {
                                "nl": "Elke dag <w>koop</w> ik vers brood in de winkel bij mij in de buurt."
                            }
                        },
                        {
                            "text": "Мы решили <w>покупать</w> продукты только на местном рынке.",
                            "target_lang_translations": {
                                "nl": "We hebben besloten om alleen op de lokale markt boodschappen te <w>kopen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "выменивать"
                    ],
                    "antonyms": [
                        "продавать"
                    ],
                    "common_phrases": [
                        "покупать продукты",
                        "покупать одежду",
                        "покупать билеты"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets in bezit krijgen in ruil voor geld."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kopen",
                                "target_lang_sense_clarification": "iets aanschaffen tegen betaling"
                            },
                            {
                                "target_lang_word": "aanschaffen",
                                "target_lang_sense_clarification": "iets kopen, vaak met een doel of voor langdurig gebruik"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "157fccbf-a3ee-30ee-ac0d-8699d2c8edaa",
                    "sense_definition": "Заручаться чьей-либо поддержкой или действиями в обмен на деньги или выгоду.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "покупка",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Коррумпированные чиновники пытались <w>покупать</w> голоса избирателей перед выборами.",
                            "target_lang_translations": {
                                "nl": "Corrupte ambtenaren probeerden voor de verkiezingen stemmen te <w>kopen</w>."
                            }
                        },
                        {
                            "text": "Нельзя <w>покупать</w> дружбу или преданность людей за деньги.",
                            "target_lang_translations": {
                                "nl": "Je kunt vriendschap of loyaliteit van mensen niet met geld <w>kopen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "покупать голоса",
                        "покупать лояльность"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemands steun of acties verkrijgen door middel van geld of gunsten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "omkopen",
                                "target_lang_sense_clarification": "iemand onrechtmatig beïnvloeden met geld"
                            },
                            {
                                "target_lang_word": "kopen",
                                "target_lang_sense_clarification": "figuurlijk verkrijgen van loyaliteit of stemmen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed3ae64f-e1a0-3dad-aaf4-dc2b359dabb1",
                    "sense_definition": "Погружать кого-либо в воду для мытья.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "купание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама пошла <w>покупать</w> маленького ребенка в теплой ванне.",
                            "target_lang_translations": {
                                "nl": "Mama ging de kleine baby <w>in bad doen</w> in een warm bad."
                            }
                        },
                        {
                            "text": "Перед сном полезно <w>покупать</w> малыша с травяным отваром.",
                            "target_lang_translations": {
                                "nl": "Voor het slapengaan is het goed om de baby <w>in bad te doen</w> met een kruidenaftreksel."
                            }
                        }
                    ],
                    "common_phrases": [
                        "покупать ребенка"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand in water onderdompelen om te wassen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "in bad doen",
                                "target_lang_sense_clarification": "iemand wassen in een bad"
                            },
                            {
                                "target_lang_word": "wassen",
                                "target_lang_sense_clarification": "het reinigen van het lichaam"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}