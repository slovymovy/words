                                    },
                                    {
                                        "sense_id": "2537c643-eb8d-3486-b5ac-a9ad6915ae40",
                                        "entry_id": "7f88f555-c180-386b-8904-840ae51b39cf",
                                        "glosses": [
                                            "Exténué, épuisé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2624110e-0c30-4b41-9ba7-2d8b5ed20a5a",
                                                "sense_id": "2537c643-eb8d-3486-b5ac-a9ad6915ae40",
                                                "text": "On vient de rentrer d’une randonnée de plusieurs heures, donc on est un peu caisse, là."
                                            }
                                        ]
