                "senses": [
                    {
                        "sense_id": "97852ae5-8111-357f-bb23-c61bea31df5a",
                        "entry_id": "7743b26f-b67d-3587-96e1-44693b55c73e",
                        "glosses": [
                            "vent, kerel"
                        ],
