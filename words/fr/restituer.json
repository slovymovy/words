{
    "word_family": [
        "restitution",
        "restitutif",
        "restituteur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "50238edd-572c-3c98-a0bb-6fc3da4a8f30",
                    "sense_definition": "Rendre un objet ou une somme d'argent à son propriétaire légitime.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rendre_materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas de <w>restituer</w> les clés de l'appartement avant votre départ."
                        },
                        {
                            "text": "L'étudiant a promis qu'il <w>restituerait</w> tous les livres empruntés à la bibliothèque."
                        }
                    ],
                    "synonyms": [
                        "rendre",
                        "redonner"
                    ],
                    "antonyms": [
                        "conserver",
                        "dérober",
                        "garder"
                    ],
                    "common_phrases": [
                        "restituer les clés",
                        "restituer une caution"
                    ]
                },
                {
                    "sense_id": "6bfd8495-1f85-3fc2-a3f4-09ebffde2013",
                    "sense_definition": "Reproduire ou exprimer fidèlement une atmosphère, un son ou des propos.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce film historique parvient à merveille à <w>restituer</w> l'atmosphère des années folles."
                        },
                        {
                            "text": "Le journaliste s'efforce de <w>restituer</w> fidèlement les déclarations du ministre."
                        }
                    ],
                    "synonyms": [
                        "recréer",
                        "reproduire",
                        "retranscrire"
                    ],
                    "antonyms": [
                        "déformer",
                        "dénaturer"
                    ],
                    "common_phrases": [
                        "restituer fidèlement",
                        "restituer l'ambiance"
                    ]
                },
                {
                    "sense_id": "0b4b06e5-99fa-3c98-91b9-c0c5695ee78f",
                    "sense_definition": "Remettre un monument, un texte ou une œuvre dans son état d'origine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restauration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les archéologues ont réussi à <w>restituer</w> la forme originelle du temple détruit."
                        },
                        {
                            "text": "L'équipe de spécialistes <w>restitue</w> les parties manquantes de ce manuscrit médiéval."
                        }
                    ],
                    "synonyms": [
                        "reconstituer",
                        "restaurer",
                        "rétablir"
                    ],
                    "antonyms": [
                        "altérer",
                        "détruire"
                    ],
                    "common_phrases": [
                        "restituer un texte",
                        "restituer un monument"
                    ]
                },
                {
                    "sense_id": "c511c230-981f-35f7-b34d-8a9ddfe97ba9",
                    "sense_definition": "Redonner ce qui avait été ôté, perdu ou suspendu, comme un droit ou un honneur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rendre_abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La décision du tribunal a enfin <w>restitué</w> au citoyen son honneur et ses privilèges."
                        },
                        {
                            "text": "Ce traité de paix doit <w>restituer</w> à la région sa souveraineté d'autrefois."
                        }
                    ],
                    "synonyms": [
                        "réhabiliter",
                        "rendre"
                    ],
                    "antonyms": [
                        "enlever",
                        "retirer"
                    ],
                    "common_phrases": [
                        "restituer l'honneur"
                    ]
                }
            ]
        }
    ]
}