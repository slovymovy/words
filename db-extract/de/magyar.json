                "senses": [
                    {
                        "sense_id": "0633edc0-0b10-344f-b22c-c6ff1c1d971c",
                        "entry_id": "0fba120f-a514-3194-bfb6-279264d3bd82",
                        "glosses": [
                            "Einwohner Ungarns"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9382b6e8-88bf-43a8-a43b-7af07fbce0e3",
                                "sense_id": "0633edc0-0b10-344f-b22c-c6ff1c1d971c",
                                "text": "„Nach der Niederlage von 1866 konnten die Habsburger den Abfall der Magyaren nur dadurch verhindern, daß sie die Deutschen die Macht mit den Ungarn teilen ließen.“"
                            },
                            {
                                "example_id": "8a326e81-66b9-4a6a-90be-3c0eed6d5f9c",
                                "sense_id": "0633edc0-0b10-344f-b22c-c6ff1c1d971c",
                                "text": "„In seinem Kampf um die Zustimmung zur Vertreibung der Deutschen und der Magyaren aus der Tschechoslowakei hatte Beneš also starke Verbündete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
