                    {
                        "sense_id": "a940d07e-64cb-3ed1-84de-97d02b5f8fad",
                        "entry_id": "235c995c-213f-361c-b878-912ec2e03a79",
                        "glosses": [
                            "hinterer Körperfortsatz (= Schwanz) eines Bibers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f98ea6f-45ea-4493-8323-2d12223933f9",
                                "sense_id": "a940d07e-64cb-3ed1-84de-97d02b5f8fad",
                                "text": "Für die Fastenzeit erklärte die katholische Kirche früher Biber zu Fischen, damit Äbte und Bischöfe mit den Biberschwänzen weiter Fleisch essen konnten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e028742d-e049-36e6-8f9a-213adf96eae7",
                        "entry_id": "235c995c-213f-361c-b878-912ec2e03a79",
                        "glosses": [
                            "Flachziegel zur Abdeckung eines Daches, der am Ende halbrund ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d32dd85-6de7-4e23-b4df-e1b64cc3855d",
                                "sense_id": "e028742d-e049-36e6-8f9a-213adf96eae7",
                                "text": "Der Biberschwanz ist eine sehr alte Dachziegelform."
                            },
                            {
                                "example_id": "fc28275e-2052-4b5f-80c3-bc4165f87cfd",
                                "sense_id": "e028742d-e049-36e6-8f9a-213adf96eae7",
                                "text": "Beim Biberschwanz gibt es drei Eindeckarten: die Einfachdeckung, die Doppeldeckung und die Kronendeckung."
                            }
                        ],
