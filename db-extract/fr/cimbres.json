                "entry_id": "a894a6ac-3a12-3311-af78-9323be9a10f5",
                "word": "Cimbres",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ff9c21c4-7310-32a1-8e6a-4147c5f68f01",
                        "entry_id": "a894a6ac-3a12-3311-af78-9323be9a10f5",
                        "glosses": [
                            "Peuple germanique originaire du Jutland qui s’opposa aux Romains lors de la Guerre des Cimbres."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "22132ba7-dcef-42b3-ab7e-769622e17d0e",
                                "sense_id": "ff9c21c4-7310-32a1-8e6a-4147c5f68f01",
                                "text": "Les Cimbres et les Teutons, chassés de la Chersonèse cimbrique par un débordement de la mer Baltique, se montrèrent aux Romains sous les Alpes tridentines, au nombre de plus de trois cent mille."
                            },
                            {
                                "example_id": "cdbdc173-84d8-41f1-9cff-9609feda9535",
                                "sense_id": "ff9c21c4-7310-32a1-8e6a-4147c5f68f01",
                                "text": "On est obligé de penser aux oies du Capitole, aux Cimbres enroulés dans les brouillards nordiques comme les chenilles processionnaires dans leurs nids de coton."
                            }
                        ]
                    },
                    {
                        "sense_id": "3485b125-91ac-38b7-a11c-cc479192c5f0",
                        "entry_id": "a894a6ac-3a12-3311-af78-9323be9a10f5",
                        "glosses": [
                            "Peuple germanique d'Italie vivant principalement au Frioul."
