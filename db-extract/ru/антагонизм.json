                "senses": [
                    {
                        "sense_id": "e1e09232-fddf-3ba6-b2c1-1aebc97c7501",
                        "entry_id": "cc385546-cb50-37be-8d66-cf8c4f09e5b8",
                        "glosses": [
                            "Antagonisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d143b42e-0d8c-470c-93b7-19d1d0ffe141",
                                "sense_id": "e1e09232-fddf-3ba6-b2c1-1aebc97c7501",
                                "text": "Антагонизм Европы и Америки за последние годы принял новые формы. : L’antagonisme de l’Europe et de l’Amérique a pris ces dernières années de nouvelles formes."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bd5b020-f1b8-3d94-b297-dc67f8bdf3e1",
                        "entry_id": "cc385546-cb50-37be-8d66-cf8c4f09e5b8",
                        "glosses": [
                            "Opposition."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8b97713f-b35c-4025-b810-4fbb40a9dac3",
                                "sense_id": "0bd5b020-f1b8-3d94-b297-dc67f8bdf3e1",
                                "text": "антагонизм между родителями и детьми : l’opposition entre les parents et les enfants."
                            }
                        ]
                    }
