                "senses": [
                    {
                        "sense_id": "f6dcb09b-e140-3270-8fa6-325e3a81d4d1",
                        "entry_id": "ee9f424c-94f3-3896-a4d7-69ab372ba4f5",
                        "glosses": [
                            "Fidèle à l’observance religieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bdc19fc-3e45-4b17-aed4-71c3ff9a95a4",
                                "sense_id": "f6dcb09b-e140-3270-8fa6-325e3a81d4d1",
                                "text": "Jésus n'est pas observantin ; il néglige la pureté matérielle ; il tient médiocrement au sabbat."
                            },
                            {
                                "example_id": "aab52ea5-eb7d-4b32-94b6-9d053480ce28",
                                "sense_id": "f6dcb09b-e140-3270-8fa6-325e3a81d4d1",
                                "text": "Frère mineur observantin."
                            },
                            {
                                "example_id": "eb3d1c4a-8e3f-4fbc-9eae-233aee7d9cda",
                                "sense_id": "f6dcb09b-e140-3270-8fa6-325e3a81d4d1",
                                "text": "Frère observantin, s'est dit, dans le style plaisant, pour épilogueur, celui qui examine trop minutieusement."
                            },
                            {
                                "example_id": "23735085-2759-44b0-9c75-ba3c1c32e292",
                                "sense_id": "f6dcb09b-e140-3270-8fa6-325e3a81d4d1",
                                "text": "Déférons même à ces rudes critiques,\nPar toi nommés frères observantins,\nTrouvant à mordre aux choses les plus belles."
                            }
                        ]
                    }
                ],
