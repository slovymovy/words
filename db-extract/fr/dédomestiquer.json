                "senses": [
                    {
                        "sense_id": "1e6ac23b-5e43-316a-8c77-27c5eecea887",
                        "entry_id": "9fea6714-a04a-35b8-bc08-1cf380b8c37f",
                        "glosses": [
                            "Faire perdre son caractère domestique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3866c4a6-78c3-476f-b328-29e4b6fe0445",
                                "sense_id": "1e6ac23b-5e43-316a-8c77-27c5eecea887",
                                "text": "Bref documentaire sur les tentatives faites pour nous dédomestiquer et retrouver l'homme sauvage."
                            },
                            {
                                "example_id": "4147deba-2495-432f-aba7-02279d834884",
                                "sense_id": "1e6ac23b-5e43-316a-8c77-27c5eecea887",
                                "text": "Quitter une mission c'est démissionner. Quitter la domus c'est se dédomestiquer."
                            },
                            {
                                "example_id": "ae512700-9c31-43a6-b93c-809377b9aae9",
                                "sense_id": "1e6ac23b-5e43-316a-8c77-27c5eecea887",
                                "text": "Suivre la politique générale suggérée par Henri Michaux : se dédomestiquer, se défamiliariser, se dénationaliser, se déshumaniser."
                            }
                        ]
                    }
                ],
