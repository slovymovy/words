                        "tr": [
                            {
                                "target_lang_word": "saman rengi",
                                "target_lang_sense_clarification": "renk tonu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "稻草色",
                                "target_lang_sense_clarification": "颜色名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c54ce9a5-0eb2-3b9d-9f84-d36ba970e746",
                    "sense_definition": "Something of very little value or importance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "worthless_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not care a <w>straw</w> for what the critics say about my work.",
                            "target_lang_translations": {
                                "ru": "Я ни в <w>грош</w> не ставлю то, что критики говорят о моей работе.",
                                "tr": "Eleştirmenlerin işim hakkında ne söylediği benim için <w>hiç</w> önemli değil.",
                                "zh": "评论家对我的作品怎么说，我一点儿也不<w>在乎</w>。"
                            }
                        },
                        {
                            "text": "He would not give a <w>straw</w> to help those who betrayed him.",
                            "target_lang_translations": {
                                "ru": "Он и <w>гроша ломаного</w> не дал бы, чтобы помочь тем, кто его предал.",
                                "tr": "Ona ihanet edenlere yardım etmek için <w>kılını</w> bile kıpırdatmazdı.",
                                "zh": "他才不会花半点<w>心思</w>去帮助那些背叛他的人。"
                            }
                        }
