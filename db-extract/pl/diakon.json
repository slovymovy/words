                        "sense_id": "447c7d2c-11f4-3eb7-a7af-e352c3b50fc7",
                        "entry_id": "97a8ae27-7d4b-3c30-90a3-b44b30e9fabe",
                        "glosses": [
                            "duchowny z najniższym stopniem święceń sakramentalnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd3307dc-d401-4c52-b0ee-68826dad1712",
                                "sense_id": "447c7d2c-11f4-3eb7-a7af-e352c3b50fc7",
                                "text": "Ojciec diakon odczytał dziś ewangelię."
                            },
                            {
                                "example_id": "045fb785-9ead-461b-9e9a-a2ac5a51a1b8",
                                "sense_id": "447c7d2c-11f4-3eb7-a7af-e352c3b50fc7",
                                "text": "Diakoni nie noszą ornatów, ich strojem jest dalmatyka."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d0314cd-7de0-4252-afac-657c18bd9b44",
                        "source_entry_id": "97a8ae27-7d4b-3c30-90a3-b44b30e9fabe",
                        "source_sense_id": "447c7d2c-11f4-3eb7-a7af-e352c3b50fc7",
                        "target_lang_word": "deacon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deacon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a2e9a2c-4fe6-3f8c-959c-41ad6b05d72a",
                                        "entry_id": "4316d6c4-da8d-384f-80cc-954f90d56a6c",
                                        "glosses": [
                                            "A designated minister of charity in the early Church (see Acts 6:1-6)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6b4809c-6909-3cab-8817-5cbecf99c12b",
                                        "entry_id": "4316d6c4-da8d-384f-80cc-954f90d56a6c",
                                        "glosses": [
                                            "A modern-day member of a church who handles secular and/or administrative duties in a priest's stead, the specifics of which depends on denomination."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa7d5965-ced6-3360-bafd-af91d12ebca5",
                                        "entry_id": "4316d6c4-da8d-384f-80cc-954f90d56a6c",
                                        "glosses": [
                                            "A clergyman ranked directly below a priest, with duties of helping the priests and carrying out parish work."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8fddd9e-1319-34e9-bc73-b3673fd31bfc",
                                        "entry_id": "4316d6c4-da8d-384f-80cc-954f90d56a6c",
                                        "glosses": [
                                            "An ordained clergyperson usually serving a year prior to being ordained presbyter, though in some cases they remain a permanent deacon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ef1c641-ab0c-34c8-ac83-d58f140e5283",
                                        "entry_id": "4316d6c4-da8d-384f-80cc-954f90d56a6c",
                                        "glosses": [
                                            "A lay leader of a congregation who assists the pastor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75e8346a-decc-3dd8-b506-31a8889ef6ca",
                                        "entry_id": "4316d6c4-da8d-384f-80cc-954f90d56a6c",
                                        "glosses": [
                                            "A separate office from that of minister, neither leading to the other; instead there is a permanent deaconate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08588a94-d2bd-3bcd-87b1-9e16efc75e76",
                                        "entry_id": "4316d6c4-da8d-384f-80cc-954f90d56a6c",
                                        "glosses": [
                                            "A junior lodge officer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a147b1df-32ef-39a5-90ca-07d6867fe3bb",
                                        "entry_id": "4316d6c4-da8d-384f-80cc-954f90d56a6c",
                                        "glosses": [
                                            "The lowest office in the Aaronic priesthood, generally held by 12 or 13 year old boys or recent converts."
                                        ],
                                        "tags": [
                                            "Mormonism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01d459f9-3a54-374d-a39e-b56bb1ee649d",
                                        "entry_id": "4316d6c4-da8d-384f-80cc-954f90d56a6c",
                                        "glosses": [
                                            "A male calf of a dairy breed, so called because they are usually deaconed (see below)."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61ae333b-975c-32d1-9d4b-815bbb599bf8",
                                        "entry_id": "4316d6c4-da8d-384f-80cc-954f90d56a6c",
                                        "glosses": [
                                            "The chairman of an incorporated company."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "deacon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2ca6f21-3db9-3bc3-a0ab-632f0110213f",
                                        "entry_id": "1a8dc12e-d82a-39ef-af59-6dd220b22946",
                                        "glosses": [
                                            "For a choir leader to lead a hymn by speaking one or two lines at a time, which are then sung by the choir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c007ca71-412d-3bca-a3f2-a7fdd00894b7",
                                        "entry_id": "1a8dc12e-d82a-39ef-af59-6dd220b22946",
                                        "glosses": [
                                            "To kill a calf shortly after birth."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98416cfa-ccda-3634-8319-811945d8d494",
                                        "entry_id": "1a8dc12e-d82a-39ef-af59-6dd220b22946",
                                        "glosses": [
                                            "To place fresh fruit at the top of a barrel or other container, with spoiled or imperfect fruit hidden beneath."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4dca1a9-04b2-4497-813b-17fe6f98186a",
                                                "sense_id": "98416cfa-ccda-3634-8319-811945d8d494",
                                                "text": "The blanc mange was lumpy, and the strawberries not as ripe as they looked, having been skilfully 'deaconed'."
                                            },
                                            {
                                                "example_id": "66383006-c45a-4fc3-bb92-65d80c287c08",
                                                "sense_id": "98416cfa-ccda-3634-8319-811945d8d494",
                                                "text": "It's like buying a barrel of apples that's been deaconed — after you've found that the deeper you go the meaner and wormier the fruit, you forget all about the layer of big, rosy, wax-finished pippins that was on top."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a15531b-519f-3f23-a354-33205c92bfbe",
                                        "entry_id": "1a8dc12e-d82a-39ef-af59-6dd220b22946",
                                        "glosses": [
                                            "To make sly alterations to the boundaries of (land); to adulterate or doctor (an article to be sold), etc."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
