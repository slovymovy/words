                "senses": [
                    {
                        "sense_id": "acad5eb6-d835-3ba9-8065-81bac5150cf3",
                        "entry_id": "f6ef5fe1-6798-3c1c-b39d-291236f850f7",
                        "glosses": [
                            "sehr gewagt und spektakulär, an einen James-Bond-Film erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "315ed198-51b7-4117-81fa-02ac776af6a3",
                                "sense_id": "acad5eb6-d835-3ba9-8065-81bac5150cf3",
                                "text": "„Funktionierte er wie geplant, dann sauste der Ballon über 100 Meter hoch in die Luft und ein Flugzeug mit einer Fangvorrichtung darunter schnappte sich das Seil unterhalb des Ballons und hievte die Person in den Gurten hoch und hinweg. Einmal mit dem Flugzeug verhakt, konnte das Seil eingeholt und die zu rettende Person geborgen werden. Klang theoretisch toll, vielleicht ein bisschen arg James-Bond-mäßig, aber für einen Spion hinter feindlichen Linien ohne andere Fluchtmöglichkeit war es eindeutig besser als nichts.“"
                            }
                        ],
