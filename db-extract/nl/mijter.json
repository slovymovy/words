                    {
                        "translation_id": "e2c38138-215a-43f1-84ef-fa724e29dec1",
                        "source_entry_id": "ffd90d99-453c-3134-af0a-3344f4f09b26",
                        "source_sense_id": "5c32dfea-7f00-3d22-be37-02f5d51adce9",
                        "source_sense_description": "hoofddeksel voor kerkelijke hoogwaardigheidsbekleders",
                        "target_lang_word": "mitre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "51c13e02-f82c-3e55-b2ee-7c3d8414c993",
                                        "entry_id": "d573b86d-6df6-3e96-a57a-e18360d36ed9",
                                        "glosses": [
                                            "Coiffure que portent les évêques quand ils officient en habits pontificaux, ainsi que certains abbés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc42e674-834a-489d-8d18-8369248e03d0",
                                                "sense_id": "51c13e02-f82c-3e55-b2ee-7c3d8414c993",
                                                "text": "Monseigneur, je vais chercher la mitre, si Votre Grandeur le permet."
                                            },
                                            {
                                                "example_id": "163a748b-a676-471c-9b4f-f167da380a4c",
                                                "sense_id": "51c13e02-f82c-3e55-b2ee-7c3d8414c993",
                                                "text": "— Dis donc la vérité une fois dans ta vie, répliqua M. Le Génil ; tu viens chercher une mitre, vieille fouine ! Demain matin tu paraîtras, la bouche en cœur, devant le nonce. Guitrel, tu seras évêque !"
                                            },
                                            {
                                                "example_id": "29fb51b7-ad64-4ee9-ac7a-e4af7f6365e1",
                                                "sense_id": "51c13e02-f82c-3e55-b2ee-7c3d8414c993",
                                                "text": "La mitre en tête."
                                            },
                                            {
                                                "example_id": "63f07cff-06d6-468b-a09e-1f2858b02a0d",
                                                "sense_id": "51c13e02-f82c-3e55-b2ee-7c3d8414c993",
                                                "text": "Officier avec la mitre et la crosse."
                                            },
                                            {
                                                "example_id": "a111a67f-4137-4adf-929c-6bb2dd969ff8",
                                                "sense_id": "51c13e02-f82c-3e55-b2ee-7c3d8414c993",
                                                "text": "En quelques églises les chanoines et certains abbés portaient la mitre."
                                            },
                                            {
                                                "example_id": "cbd447dc-ce3f-4a5f-9d79-f9c75bb660b4",
                                                "sense_id": "51c13e02-f82c-3e55-b2ee-7c3d8414c993",
                                                "text": "Recevoir la mitre, c’est être nommé évêque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1e6e0eb-a207-33af-8d20-ad15e5725835",
                                        "entry_id": "d573b86d-6df6-3e96-a57a-e18360d36ed9",
                                        "glosses": [
                                            "Coiffure que portent les évêques quand ils officient en habits pontificaux, ainsi que certains abbés.",
                                            "Meuble représentant la coiffure du même nom dans les armoiries."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9e6ce3b-1e7f-397c-bbb3-e204ec1aa0b8",
                                        "entry_id": "d573b86d-6df6-3e96-a57a-e18360d36ed9",
                                        "glosses": [
                                            "Coiffure que portent les évêques quand ils officient en habits pontificaux, ainsi que certains abbés.",
                                            "Figure représentant la coiffure du même nom et placé au sommet ou au-dessus des armoiries. Elle est généralement utilisée pour marquer le titre d’évêque ou d’archevêque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb220508-38a2-4443-b992-9a2d6d054949",
                                                "sense_id": "c9e6ce3b-1e7f-397c-bbb3-e204ec1aa0b8",
                                                "text": "Écu de gueules à deux clés passées en sautoir d’argent, surmontées par la couronne britannique au naturel ; sommé d’une mitre, qui est l’Archevêque d’York → voir illustration « mitre utilisée comme ornement extérieur »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0bfb734-27a1-323c-9151-4e7016b0cbbb",
                                        "entry_id": "d573b86d-6df6-3e96-a57a-e18360d36ed9",
                                        "glosses": [
                                            "Coiffure qui était en usage chez les femmes romaines et qui venait originairement des Perses."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd51a355-6884-3bc8-baa7-e2232f277171",
                                        "entry_id": "d573b86d-6df6-3e96-a57a-e18360d36ed9",
                                        "glosses": [
                                            "Dispositif en forme de mitre d’évêque placé au-dessus d’une cheminée, pour réduire le risque que la pluie tombe à l’intérieur ainsi que le contre-tirage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
