                "senses": [
                    {
                        "sense_id": "87bcbeb1-6015-3d4e-9143-fddbbbcaaddb",
                        "entry_id": "465587f1-3434-3391-99c6-4701b6bfdf38",
                        "glosses": [
                            "Form des Unterrichts, bei der meist ein Wechsel von Präsenzunterricht in der Schule und Fernunterricht zuhause stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00057104-6277-4654-9db1-1367afbc1e3a",
                                "sense_id": "87bcbeb1-6015-3d4e-9143-fddbbbcaaddb",
                                "text": "„Eine Rückkehr zum Hybridunterricht ist unter Fachleuten und Schulakteuren seit Monaten heftig umstritten.“"
                            },
                            {
                                "example_id": "840aabc9-7db0-432b-8d90-a10c128b41e8",
                                "sense_id": "87bcbeb1-6015-3d4e-9143-fddbbbcaaddb",
                                "text": "„Eine Rückkehr zum Hybridunterricht galt als zentraler Streitpunkt zwischen der Kanzlerin und den Länderchefs, von denen sich einige noch kurz vor der Videoschalte klar auf der Seite ihrer Schulminister positioniert hatten.“"
                            },
                            {
                                "example_id": "962d1bea-391f-42fe-8be9-454543225d2c",
                                "sense_id": "87bcbeb1-6015-3d4e-9143-fddbbbcaaddb",
                                "text": "„Schulen in Hotspots sollen zum Hybridunterricht wechseln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
