                "senses": [
                    {
                        "sense_id": "f4238c82-dbd7-357b-a57c-ce07f0b18dba",
                        "entry_id": "dbad9dca-053d-382a-bc16-ab1315f5075f",
                        "glosses": [
                            "трад.-поэт. окрашивать в багряный цвет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed02aa6e-25cb-4ca1-a2e5-852fddfe6126",
                                "sense_id": "f4238c82-dbd7-357b-a57c-ce07f0b18dba",
                                "text": "Заря́ багря́нит свод небе́с."
                            },
                            {
                                "example_id": "ba9ca361-c208-4e98-9874-657e1542818b",
                                "sense_id": "f4238c82-dbd7-357b-a57c-ce07f0b18dba",
                                "text": "Мы беглецы́, и сза́ди на́ша Тро́я, // И за́рево наш па́рус багряни́т."
                            }
                        ]
                    },
                    {
                        "sense_id": "b28ab8e3-9f50-3111-b3a3-97702c7c676c",
                        "entry_id": "dbad9dca-053d-382a-bc16-ab1315f5075f",
                        "glosses": [
                            "светиться, отцвечивать, отдавать багряным цветом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bd5c78d-ea99-4fb3-97f1-18ddaa345528",
                                "sense_id": "b28ab8e3-9f50-3111-b3a3-97702c7c676c",
                                "text": "Причудливых форм заливные, желе и галантины вздрагивали, огромные красные омары и лангусты прятались в застывших соусах, как в облаках, и багрянили при ярком освещении."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1efb782-f5dc-4887-b566-455a721e2ef9",
                        "source_entry_id": "dbad9dca-053d-382a-bc16-ab1315f5075f",
