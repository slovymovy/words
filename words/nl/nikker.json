            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7ae66e0-c746-3c81-977a-1e9a0c346b0b",
                    "sense_definition": "Een zeer beledigende en racistische term voor een zwart persoon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "racistische_scheldwoorden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In historische documenten wordt soms het scheldwoord <w>nikker</w> aangetroffen, wat tegenwoordig als zeer kwetsend geldt.",
                            "target_lang_translations": {
                                "de": "In historischen Dokumenten stößt man manchmal auf das Schimpfwort <w>N-Wort</w>, das heute als zutiefst verletzend gilt."
                            }
                        },
                        {
                            "text": "Het gebruik van de term <w>nikker</w> is volstrekt onacceptabel en geldt als een ernstige belediging.",
                            "target_lang_translations": {
                                "de": "Die Verwendung des Begriffs <w>N-Wort</w> ist völlig inakzeptabel und gilt als schwere Beleidigung."
                            }
                        }
                    ],
                    "synonyms": [
                        "blauwe",
                        "roetmop"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "zeer beledigend en racistisch scheldwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein zutiefst beleidigender und rassistischer Begriff für eine schwarze Person."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "N-Wort",
                                "target_lang_sense_clarification": "Ersatzbezeichnung für die rassistische Schmähung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d20c4ec1-3842-3428-adda-6aea4f192605",
                    "sense_definition": "Een boosaardige watergeest in de Germaanse folklore die mensen naar de diepte probeert te lokken om ze te laten verdrinken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythologische_wezens",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "Volgens oude volksverhalen hield de gevaarlijke <w>nikker</w> zich schuil in diepe wateren om wandelaars te verdrinken.",
                            "target_lang_translations": {
                                "de": "Alten Volkserzählungen zufolge hielt sich der gefährliche <w>Nix</w> in tiefen Gewässern versteckt, um Wanderer zu ertränken."
                            }
                        },
                        {
                            "text": "De dorpelingen waarschuwden hun kinderen voor de <w>nikker</w> die in de diepe bergmeren zou huizen.",
                            "target_lang_translations": {
                                "de": "Die Dorfbewohner warnten ihre Kinder vor dem <w>Wassermann</w>, der in den tiefen Bergseen hausen soll."
                            }
                        }
                    ],
                    "synonyms": [
                        "nix",
                        "watergeest"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "vooral voorkomend in oude mythologische vertellingen en folklore"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein bösartiger Wassergeist in der germanischen Folklore, der versucht, Menschen in die Tiefe zu locken, um sie zu ertränken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Nix",
                                "target_lang_sense_clarification": "männlicher Wassergeist"
                            },
                            {
                                "target_lang_word": "Wassermann",
                                "target_lang_sense_clarification": "Folklore / Mythologie"
                            },
                            {
                                "target_lang_word": "Neck",
                                "target_lang_sense_clarification": "Wassergeist in Volkserzählungen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9752fbb-affe-3474-bc6c-fb0ce8043dc2",
                    "sense_definition": "Een kwaadaardig bovennatuurlijk wezen; een demoon of duivel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythologische_wezens",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "In die oude legende werd een kwaadaardige <w>nikker</w> opgeroepen om het dorp te kwellen.",
                            "target_lang_translations": {
                                "de": "In dieser alten Legende wurde ein bösartiger <w>Dämon</w> heraufbeschworen, um das Dorf zu quälen."
                            }
                        },
                        {
                            "text": "De monnik sprak bezweringen uit om de <w>nikker</w> voorgoed te verdrijven.",
                            "target_lang_translations": {
                                "de": "Der Mönch sprach Beschwörungen aus, um den <w>bösen Geist</w> für immer zu vertreiben."
                            }
                        }
                    ],
                    "synonyms": [
                        "demoon",
                        "droes",
                        "duivel"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "verouderde benaming voor duivel of demon"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein bösartiges übernatürliches Wesen; ein Dämon oder Teufel."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dämon",
                                "target_lang_sense_clarification": "böser Geist"
                            },
                            {
                                "target_lang_word": "Teufel",
                                "target_lang_sense_clarification": "boshaftes Wesen"
                            },
                            {
                                "target_lang_word": "böser Geist",
                                "target_lang_sense_clarification": "übernatürliches Wesen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
