                "senses": [
                    {
                        "sense_id": "d0f1de8f-6bd8-3028-acc3-7f13021ed7b6",
                        "entry_id": "8fb46087-5a80-3046-b9f7-1e6272d3ddb2",
                        "glosses": [
                            "Grouiller comme des crapauds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c373a2b4-3301-45d9-8696-cbf13dc5dc7b",
                                "sense_id": "d0f1de8f-6bd8-3028-acc3-7f13021ed7b6",
                                "text": "Ça vous crapouille dans la crasse, comme les cochons derrière une porte condamnée, comme les insectes qui se multiplient dans les lieux d'aisances."
                            }
                        ]
                    },
                    {
                        "sense_id": "68e11811-ccff-3a50-9eb4-f1fbcb0fa5d8",
                        "entry_id": "8fb46087-5a80-3046-b9f7-1e6272d3ddb2",
                        "glosses": [
                            "Bombarder avec des crapouillots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f6e2833-603f-4033-947c-aa9cd136536f",
                                "sense_id": "68e11811-ccff-3a50-9eb4-f1fbcb0fa5d8",
                                "text": "À midi je veux rentrer : j’aperçois un Boche qui se faisait crapouiller sur nos lignes à 2.400 mètres."
                            }
                        ]
                    }
