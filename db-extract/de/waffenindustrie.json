                "senses": [
                    {
                        "sense_id": "15b3d838-78cf-3970-ba67-0147d1dffe4a",
                        "entry_id": "2b5097ff-ed34-3926-a53f-9a34378693d2",
                        "glosses": [
                            "Industriezweig, der sich auf die Herstellung von Waffen und militärischen Geräten spezialisiert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1440d40a-e0ec-4b26-ba5b-212a987b0005",
                                "sense_id": "15b3d838-78cf-3970-ba67-0147d1dffe4a",
                                "text": "„Er handelte mit allen Arten von Explosivstoffen und hatte gute Beziehungen zur Waffenindustrie.“"
                            },
                            {
                                "example_id": "0f32ec33-045a-4d32-a97b-68b22a172252",
                                "sense_id": "15b3d838-78cf-3970-ba67-0147d1dffe4a",
                                "text": "„Die weißen Männer hatten halbautomatische Waffen, die ich noch nie gesehen hatte - bestimmt das neueste Angebot unserer feinen amerikanischen Waffenindustrie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
