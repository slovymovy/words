                "senses": [
                    {
                        "sense_id": "192bcc2c-9e9d-316f-90d7-8c1ab9aeaa74",
                        "entry_id": "7846da40-1078-3f06-90d7-c1eacb42bcaa",
                        "glosses": [
                            "Action de butter."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "75cfe01b-72de-4d26-b67b-b486e000a10f",
                                "sense_id": "192bcc2c-9e9d-316f-90d7-8c1ab9aeaa74",
                                "text": "Le buttage des cultures à plat associe le désherbage à l’apport de terre à la base des plantes."
                            },
                            {
                                "example_id": "df34d656-7312-4dbb-880d-3b149f5b4fa8",
                                "sense_id": "192bcc2c-9e9d-316f-90d7-8c1ab9aeaa74",
                                "text": "Un buttage définitif dès la plantation peut être envisagé dans les sols légers qui se réchauffent facilement."
                            },
                            {
                                "example_id": "07e8f064-096b-4314-b8d8-e939ff0e8c2a",
                                "sense_id": "192bcc2c-9e9d-316f-90d7-8c1ab9aeaa74",
                                "text": "Dans la grande culture, les buttages à la houe à bras ne sont pas praticables, soit en raison des frais qu'ils nécessitent, soit par la difficulté, souvent insurmontable, de réunir un nombre suffisant d'ouvriers pour les faire en temps utile."
                            }
                        ]
                    }
                ],
