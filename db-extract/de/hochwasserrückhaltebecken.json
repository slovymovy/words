                "senses": [
                    {
                        "sense_id": "53b688cd-f310-31cb-adcc-40c9853c9160",
                        "entry_id": "abfe428d-880e-3f0f-9856-bcbc05b711a4",
                        "glosses": [
                            "künstlich geschaffenes Becken oder großer Raum zur vorübergehenden Rückhaltung von übergroßen Mengen an Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9403c281-6467-4ffc-85f4-c8f2b8c139b0",
                                "sense_id": "53b688cd-f310-31cb-adcc-40c9853c9160",
                                "text": "„Definition Hochwasserrückhaltebecken: Hochwasserrückhaltebecken, die als Stauanlagen zum vorübergehenden Rückhalt von Hochwasser in Gewässern, Trockentälern und Mulden dienen und über keine oder nur kleine Betriebsräume im Verhältnis zum Hochwasserrückhalteraum verfügen [DIN 19700-12].“"
                            },
                            {
                                "example_id": "6ee4f3bd-3dfc-46dd-a796-e17b1282ddca",
                                "sense_id": "53b688cd-f310-31cb-adcc-40c9853c9160",
                                "text": "„Mitte März prüfte die Bezirksregierung Köln die Hochwasserrückhaltebecken Horchheim und Eicherscheid des Erftverbandes.“"
                            },
                            {
                                "example_id": "47de6fcb-6c70-403f-9e3e-603fc5b09789",
                                "sense_id": "53b688cd-f310-31cb-adcc-40c9853c9160",
                                "text": "„An der Stadtgrenze zwischen Dortmund-Mengede und Castrop-Rauxel-Ickern entsteht seit einigen Jahren ein neues Naherholungsgebiet. Als Hochwasserrückhaltebecken (kurz HRB) angelegt, soll das Gelände mit einer Größe von ungefähr 46 Fußballfeldern und mit einem geplanten Rückhaltevolumen von rund 1,1 Mio. Kubikmetern in erster Linie abwärts gelegene Siedlungsbereiche schützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
