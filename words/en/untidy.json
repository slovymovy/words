{
    "word_family": [
        "untidily",
        "untidiness",
        "tidiness",
        "tidy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "12bbc9e7-44f5-3dc7-90c1-1e9f904d725a",
                    "sense_definition": "Not neat, clean, or well-arranged; messy.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have never seen such an <w>untidy</w> room in my entire life!",
                            "target_lang_translations": {
                                "ru": "Я никогда в жизни не видел такой <w>неприбранной</w> комнаты!"
                            }
                        },
                        {
                            "text": "He left his <w>untidy</w> room before heading off to school.",
                            "target_lang_translations": {
                                "ru": "Он оставил свою <w>неубранную</w> комнату перед тем, как отправиться в школу."
                            }
                        }
                    ],
                    "synonyms": [
                        "disorderly",
                        "slovenly"
                    ],
                    "antonyms": [
                        "neat",
                        "tidy"
                    ],
                    "common_phrases": [
                        "untidy room",
                        "untidy hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неаккуратный, нечистый или неприбранный; грязный или находящийся в беспорядке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неаккуратный",
                                "target_lang_sense_clarification": "содержащийся в беспорядке"
                            },
                            {
                                "target_lang_word": "неопрятный",
                                "target_lang_sense_clarification": "грязный, неаккуратный внешне"
                            },
                            {
                                "target_lang_word": "неряшливый",
                                "target_lang_sense_clarification": "неприбранный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a42da22a-7219-34a9-ba16-486ccab2bd74",
                    "sense_definition": "Disorganized or lacking structure and order.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His personal finances were in an <w>untidy</w> state when he died.",
                            "target_lang_translations": {
                                "ru": "Его личные финансы находились в <w>беспорядочном</w> состоянии, когда он умер."
                            }
                        },
                        {
                            "text": "The manager tried to reorganize the <w>untidy</w> desk before the meeting.",
                            "target_lang_translations": {
                                "ru": "Менеджер попытался привести в порядок <w>захламленный</w> стол перед встречей."
                            }
                        }
                    ],
                    "synonyms": [
                        "disorderly"
                    ],
                    "antonyms": [
                        "neat",
                        "tidy"
                    ],
                    "common_phrases": [
                        "untidy state",
                        "untidy desk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дезорганизованный, не имеющий четкой структуры или порядка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспорядочный",
                                "target_lang_sense_clarification": "лишенный порядка, хаотичный"
                            },
                            {
                                "target_lang_word": "неорганизованный",
                                "target_lang_sense_clarification": "плохо структурированный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ca56dbe-e93b-3629-993e-31c8c998b664",
                    "sense_definition": "To make something messy or put it into disorder.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children always <w>untidy</w> the living room right after I clean it.",
                            "target_lang_translations": {
                                "ru": "Дети всегда <w>устраивают беспорядок</w> в гостиной сразу после того, как я ее убираю."
                            }
                        },
                        {
                            "text": "Please do not <w>untidy</w> the room while looking for your keys.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>наводите беспорядок</w> в комнате, пока ищете ключи."
                            }
                        }
                    ],
                    "antonyms": [
                        "tidy"
                    ],
                    "common_phrases": [
                        "untidy the room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устраивать беспорядок, делать что-либо неаккуратным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наводить беспорядок",
                                "target_lang_sense_clarification": "делать место неубранным"
                            },
                            {
                                "target_lang_word": "замусоривать",
                                "target_lang_sense_clarification": "захламлять"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}