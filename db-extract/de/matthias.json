                                        "glosses": [
                                            "Commune française, située dans le département du Calvados."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c89fb23-74a1-4dac-89ed-1901bbf7631d",
                                                "sense_id": "c7100c2a-e60f-3759-9859-a8bcccec51e1",
                                                "text": "Je viens de Mathieu."
                                            },
