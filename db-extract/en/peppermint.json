                "senses": [
                    {
                        "sense_id": "9b8aa4e1-08cb-34d8-be55-5d3c30d81563",
                        "entry_id": "bdbde008-464f-3785-b661-dda65847eea8",
                        "glosses": [
                            "A hybrid herb of the mint family (Mentha × piperita), formed by crossing watermint and spearmint, which has a high menthol content and a sharp flavor and is used in cooking, especially in herb teas and in confections."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8ea73dc2-6c04-388d-a724-786fbc64657b",
                        "entry_id": "bdbde008-464f-3785-b661-dda65847eea8",
                        "glosses": [
                            "Any of various eucalypts of southeastern Australia whose leaves yield peppermint-like essential oils."
                        ],
                        "tags": [
                            "Australia",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b02071af-5606-4a04-ae43-40628c44c583",
                                "sense_id": "8ea73dc2-6c04-388d-a724-786fbc64657b",
                                "text": "In the hissing flames, Greenhill and Travers boiled the bark from peppermint gums and roasted their kangaroo-skin jackets."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b479009-364d-3960-b1a6-bd006c0f44f2",
                        "entry_id": "bdbde008-464f-3785-b661-dda65847eea8",
                        "glosses": [
                            "Any of various sweets containing extract of the peppermint herb; peppermint confectionery."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
