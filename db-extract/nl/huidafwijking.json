                        "examples": [
                            {
                                "example_id": "cd82ba98-7a8f-42e0-b553-6cb2715dfb46",
                                "sense_id": "7b8aba57-b989-351b-ad15-4004dc8e08d5",
                                "text": "De dermatoloog geeft dan via beschermd internet advies binnen enkele uren. De huisarts leert hier veel van. Bewezen is dat zij na een aantal keren die huidafwijkingen beter en zonder hulp kunnen beoordelen. Er is hier sprake van wat heet een lerende organisatie: huisartsen leren binnen hun praktijk en niet op een losstaande cursus."
                            },
                            {
                                "example_id": "86750f1c-f963-4bad-9485-4f62e8dbac4f",
                                "sense_id": "7b8aba57-b989-351b-ad15-4004dc8e08d5",
                                "text": "Het is belangrijk dat mensen in de directe omgeving van de patiënt met schurft meebehandeld worden, ook wanneer zij helemaal geen jeuk of huidafwijkingen hebben."
                            }
                        ]
