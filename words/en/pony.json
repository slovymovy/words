        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d29085c0-f3a8-3331-ba26-fd9a9fd94406",
                    "sense_definition": "To lead a horse from another horse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "equestrian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trainer had to <w>pony</w> the racehorse to the starting gate.",
                            "target_lang_translations": {
                                "ru": "Тренеру пришлось <w>вести в поводу</w> скаковую лошадь к стартовым воротам.",
                                "zh": "驯马师不得不<w>牵引</w>着赛马前往起跑门。"
                            }
                        },
                        {
                            "text": "We <w>ponied</w> the young colt across the field to calm him down.",
                            "target_lang_translations": {
                                "ru": "Мы <w>вели</w> молодого жеребенка <w>в поводу</w> через поле, чтобы успокоить его.",
                                "zh": "我们<w>牵引</w>着那匹小公马穿过田野，好让它冷静下来。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "equestrian context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести лошадь на поводу, сидя верхом на другой лошади.",
                        "zh": "骑在一匹马上牵着另一匹马走。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести в поводу",
                                "target_lang_sense_clarification": "лошадь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牵引",
                                "target_lang_sense_clarification": "马术动作"
                            }
                        ]
                    }
                },
                {
