                "senses": [
                    {
                        "sense_id": "408f52ee-91d6-3d8c-a936-d186f1e34fc1",
                        "entry_id": "5d7718e1-0a1f-353d-9784-412c4d45e14b",
                        "glosses": [
                            "Chasse-neige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4990ca9c-01e1-43ef-8277-3d2d0008821e",
                                "sense_id": "408f52ee-91d6-3d8c-a936-d186f1e34fc1",
                                "text": "Plusieurs oublient également de déplacer leur véhicule lors du passage des déneigeuses, obligeant la multiplication des remorquages."
                            },
                            {
                                "example_id": "41f7cbb9-fe55-4176-85d4-482e6884dcfe",
                                "sense_id": "408f52ee-91d6-3d8c-a936-d186f1e34fc1",
                                "text": "À Clichy-sous-Bois (Seine-Saint-Denis), deux cars sont immobilisés allée Maurice-Audin, bloquant la circulation et empêchant la déneigeuse de passer."
                            },
                            {
                                "example_id": "20da5400-dfa4-4903-a14b-ebd00b2dfc0c",
                                "sense_id": "408f52ee-91d6-3d8c-a936-d186f1e34fc1",
                                "text": "On utilise une déneigeuse de piste. C’est un véhicule muni d’une lame de six mètres de large, d’une brosse métallique ainsi que d’une soufflerie."
                            }
                        ]
                    }
                ],
