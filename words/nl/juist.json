                {
                    "sense_id": "542d7816-930d-3ad9-ab77-f72dae35424a",
                    "sense_definition": "Om een tegenstelling aan te geven of iets te benadrukken dat anders is dan verwacht.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben niet boos op je, ik ben <w>juist</w> heel trots.",
                            "target_lang_translations": {
                                "en": "I am not angry with you; I am <w>actually</w> very proud.",
                                "ru": "Я не сержусь на тебя, я <w>наоборот</w> очень горжусь.",
                                "pl": "Nie jestem na ciebie zły, jestem <w>wręcz</w> bardzo dumny.",
                                "de": "Ich bin nicht böse auf dich, ich bin <w>im Gegenteil</w> sehr stolz.",
                                "fr": "Je ne suis pas en colère contre toi, je suis <w>au contraire</w> très fier.",
                                "it": "Non sono arrabbiato con te, <w>anzi</w>, sono molto orgoglioso.",
                                "cs": "Nezlobím se na tebe, jsem <w>naopak</w> moc pyšný.",
                                "tr": "Sana kızgın değilim, <w>aksine</w> seninle çok gurur duyuyorum.",
                                "es": "No estoy enfadado contigo, <w>al contrario</w>, estoy muy orgulloso."
                            }
                        },
                        {
                            "text": "Katten houden niet van water, terwijl honden er <w>juist</w> gek op zijn.",
                            "target_lang_translations": {
                                "en": "Cats do not like water, whereas dogs <w>actually</w> love it.",
                                "ru": "Кошки не любят воду, тогда как собаки <w>наоборот</w> от неё без ума.",
                                "pl": "Koty nie lubią wody, podczas gdy psy <w>wręcz przeciwnie</w> – uwielbiają ją.",
                                "de": "Katzen mögen kein Wasser, während Hunde <w>geradezu</w> verrückt danach sind.",
                                "fr": "Les chats n'aiment pas l'eau, alors que les chiens en sont <w>justement</w> fous.",
                                "it": "I gatti non amano l'acqua, mentre i cani <w>al contrario</w> ne vanno matti.",
                                "cs": "Kočky nemají rády vodu, zatímco psi ji <w>naopak</w> zbožňují.",
                                "tr": "Kediler sudan hoşlanmaz, oysa köpekler <w>tam tersine</w> suya bayılır.",
                                "es": "A los gatos no les gusta el agua, mientras que a los perros <w>más bien</w> les encanta."
                            }
                        }
