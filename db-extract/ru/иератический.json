                ],
                "senses": [
                    {
                        "sense_id": "76d2ce38-310f-3fef-816b-7bb8328e8777",
                        "entry_id": "2b327991-a828-3ae1-a566-643ac298feb5",
                        "glosses": [
                            "священный, жреческий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8971dfdc-0a85-46ae-a39e-a89973906c57",
                                "sense_id": "76d2ce38-310f-3fef-816b-7bb8328e8777",
                                "text": "Христианская живопись всей Европы XI- XII вв. обладала некоторыми общими внутренними чертами. Это торжественное иератическое искусство."
                            }
                        ]
                    },
                    {
                        "sense_id": "49b1edb8-85a0-33a7-a97d-777976e29402",
                        "entry_id": "2b327991-a828-3ae1-a566-643ac298feb5",
                        "glosses": [
                            "упрощённый, скорописный (о письме древних египтян, развившемся из иероглифического)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65b68e85-b6d1-4d31-802c-f3c65f990439",
                                "sense_id": "49b1edb8-85a0-33a7-a97d-777976e29402",
                                "text": "Иератические знаки писались чернилами по керамике или дереву, а позже и на папирусах, встречающихся в гробницах фараонов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d0188ca-3446-4aad-935a-187fcbb2fa48",
                        "source_entry_id": "2b327991-a828-3ae1-a566-643ac298feb5",
                        "target_lang_word": "hieratisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hieratisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14ce5034-2e01-3eb7-88dc-bbaff46dd4b2",
                                        "entry_id": "56002811-7d08-30de-927e-5802c676757a",
                                        "glosses": [
                                            "streng, starr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df39d0b3-8d49-4a35-9e32-06fa1f889622",
                                                "sense_id": "14ce5034-2e01-3eb7-88dc-bbaff46dd4b2",
                                                "text": "Sein Stil ist gerade und präzise, fast hieratisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11d0991f-388f-3106-94de-889810ddc714",
                                        "entry_id": "56002811-7d08-30de-927e-5802c676757a",
                                        "glosses": [
                                            "heilig, heiligen Gebräuchen entsprechend, heiligmäßige Schrift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "098c26dd-90ae-41f1-8570-b381a9e216c7",
                                                "sense_id": "11d0991f-388f-3106-94de-889810ddc714",
                                                "text": "Ein Lorbeerblatt ist ein Lorbeerblatt, ist es aber Apollo geweiht, hat es einen hieratischen Bezug und wird selbst hieratisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dfc89991-5cfa-3dc4-b7ce-99a30a03f9be",
                                        "entry_id": "56002811-7d08-30de-927e-5802c676757a",
                                        "glosses": [
                                            "Bezeichnung für eine Schrift, die aus Hieroglyphen weiterentwickelt wurde (benutzt in Ägypten vom 3. Jahrtausend vor bis ins 3. Jahrhundert nach Christus)"
                                        ],
                                        "tags": [
                                            "in der Bezeichnung »hieratische Schrift«"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edcf38af-f50e-4619-82df-a5fffafcca63",
                                                "sense_id": "dfc89991-5cfa-3dc4-b7ce-99a30a03f9be",
                                                "text": "Beispiele der hieratischen Schrift findet man meist auf Leder oder Papyrus."
                                            },
                                            {
                                                "example_id": "4b95e828-0ae1-4e19-87a0-56652c804f0d",
                                                "sense_id": "dfc89991-5cfa-3dc4-b7ce-99a30a03f9be",
                                                "text": "„Wir benutzen aber hier zu ihrer Wiedergabe Hieroglyphen, denn sie sind viel deutlicher voneinander zu unterscheiden als die hieratischen Kürzel und auch weniger den individuellen Schwankungen der Schreiberhand unterworfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
