                        "entry_id": "f78520be-e232-3e0d-bcc3-344195625b4d",
                        "glosses": [
                            "polisacharyd bliski chemicznie i strukturalnie celulozie, budujący ścianę komórkową roślin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85346dc4-4694-4715-aabb-8fb7a75df03e",
                                "sense_id": "06075a36-e3ce-3957-a261-35b0add06996",
                                "text": "Obok celulozy i ligniny hemicelulozy występują w zdrewniałych tkankach roślin."
                            },
                            {
                                "example_id": "5322361d-d029-42f0-b88e-a1d9d81f19be",
                                "sense_id": "06075a36-e3ce-3957-a261-35b0add06996",
                                "text": "Jako kryterium podziału hemiceluloz przyjął on budowę ich podstawowych jednostek i makrocząsteczek"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
