                        "entry_id": "8c33c663-2acd-34c4-8aa2-82faabd95e1d",
                        "glosses": [
                            "Person, die einen Torhüter betreut, ausbildet und auf einen Wettkampf vorbereitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "501df60c-968b-462c-9ebb-c99b85b6effa",
                                "sense_id": "c81b717a-8305-3805-85a0-e581e5094f9f",
                                "text": "Mein Cousin ist Torwarttrainer."
                            },
                            {
                                "example_id": "92f9c402-562f-40a2-8d45-bfa48bd4de58",
                                "sense_id": "c81b717a-8305-3805-85a0-e581e5094f9f",
                                "text": "„Nach mehreren Saisons als Torwarttrainer bei Schalke 04, war er Chefcoach beim MSV Duisburg, Fortuna Düsseldorf und den Kickers Offenbach.“"
                            },
                            {
                                "example_id": "939552ca-4277-4f3d-94ae-9459c84166b6",
                                "sense_id": "c81b717a-8305-3805-85a0-e581e5094f9f",
                                "text": "„Der frühere Schlussmann ist längst einer der besten Torwarttrainer der Fußball-Bundesliga.“"
                            },
                            {
                                "example_id": "f895cc52-a9c7-4fbc-a8e0-0fe5a00abd38",
                                "sense_id": "c81b717a-8305-3805-85a0-e581e5094f9f",
                                "text": "„Der neue Torwarttrainer Michael Kraft schwärmt von der Nummer eins der Eintracht – sieht aber auch noch Steigerungspotential.“"
                            }
                        ],
