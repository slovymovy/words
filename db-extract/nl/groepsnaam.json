                        "glosses": [
                            "de naam die men heeft als lid van een groep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc0297b7-3f84-4b4a-9104-3cda06884c22",
                                "sense_id": "25413890-c4f0-3b1b-93bc-02c9e8bbc24c",
                                "text": "De Duitse tiener Rayouf Alhumedhi diende daarvoor dit jaar een voorstel in bij het emojibedrijf. De van oorsprong Saoedische Rayouf wilde een appgroep aanmaken met vriendinnen. In de groepsnaam moest elk meisje een duidelijk emoticon hebben. Rayouf miste er eentje met een hoofddoek."
                            }
