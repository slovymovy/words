                    {
                        "sense_id": "d76b7e81-4a3c-355d-811e-2bd545fb3c6c",
                        "entry_id": "b6c6b941-4c5e-330d-b88e-cfca528bce90",
                        "glosses": [
                            "een wetenschapper die de biologie beoefent"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "4e6a03cb-0cc3-4fe4-a6be-4ea65e8eb0ef",
                                "sense_id": "d76b7e81-4a3c-355d-811e-2bd545fb3c6c",
                                "text": "De vijf biologen werken nog door aan hun onderzoek naar de werking van het enzym."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11961672-b66f-41b7-b249-3353eb333d6e",
                        "source_entry_id": "b6c6b941-4c5e-330d-b88e-cfca528bce90",
                        "source_sense_id": "d76b7e81-4a3c-355d-811e-2bd545fb3c6c",
                        "source_sense_description": "een wetenschapper die de biologie beoefent",
                        "target_lang_word": "Biologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2a415bf-bce7-3c8e-b58d-e0037955b787",
                                        "entry_id": "9fe05291-4e30-3c1a-bcb8-6abd5ef57249",
                                        "glosses": [
                                            "Wissenschaftler, der sich mit belebter Natur (Biologie) beschäftigt"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3965fa2-9de7-4c1f-b3d9-841e967b0057",
                                                "sense_id": "c2a415bf-bce7-3c8e-b58d-e0037955b787",
                                                "text": "Zur Umweltverträglichkeitsprüfung wurden Biologen zu Rate gezogen."
                                            },
                                            {
                                                "example_id": "d4fcdef9-b6a0-4d24-8071-e44c01e541df",
                                                "sense_id": "c2a415bf-bce7-3c8e-b58d-e0037955b787",
                                                "text": "„Die Einladung habe ich den Biologen von Nuuk Basic zu verdanken, einem Freiluftlabor eine halbe Stunde südlich der Hauptstadt.“"
                                            },
                                            {
                                                "example_id": "f7018ecb-7ded-4219-ad7e-04bebc304217",
                                                "sense_id": "c2a415bf-bce7-3c8e-b58d-e0037955b787",
                                                "text": "„Ich dachte an einen Onkel von mir, einen Biologen, der mich mit einem Begriff beschenkt hatte, der mir ein ultimativer Schlüssel zu allen möglichen Phänomenen geworden war.“"
                                            },
                                            {
                                                "example_id": "c6c83eaf-cc2c-4c5d-8f77-72c57c5727e0",
                                                "sense_id": "c2a415bf-bce7-3c8e-b58d-e0037955b787",
                                                "text": "„Biologe Boisseau hat vom Krähennest aus mit dem Fernglas eine Schule Weißschnauzendelfine entdeckt, die näher kommen und in der Bugwelle des Seglers reiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bf08a58-9618-407c-a1b6-e226a45d5cb0",
                        "source_entry_id": "b6c6b941-4c5e-330d-b88e-cfca528bce90",
                        "source_sense_id": "d76b7e81-4a3c-355d-811e-2bd545fb3c6c",
                        "source_sense_description": "een wetenschapper die de biologie beoefent",
                        "target_lang_word": "biologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee1092e2-051a-379a-a7c8-84869ac08c7f",
                                        "entry_id": "243976be-dda5-3681-9d5c-cc937a0f10d7",
                                        "glosses": [
                                            "A student of biology; one versed in the science of biology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d435863-fdb0-47f7-b5fd-a62ea18ed976",
                                                "sense_id": "ee1092e2-051a-379a-a7c8-84869ac08c7f",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus.[…]A photo processing technique called focus stacking has changed that. Developed as a tool to electronically combine the sharpest bits of multiple digital images, focus stacking is a boon to biologists seeking full focus on a micron scale."
                                            },
                                            {
                                                "example_id": "a8fca659-0fd0-4daf-a2ba-0f239bc248ef",
                                                "sense_id": "ee1092e2-051a-379a-a7c8-84869ac08c7f",
                                                "text": "Wildlife biologist Stanley Temple hypothesised that perhaps the dodo tree was dependent on its seeds passing through the digestive system of dodos in order to properly germinate and that the handful of individuals in the 1970s were the last remaining trees from seeds that passed through a dodo in the 1690s-1700s when they went extinct."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "201cf2e7-e656-4cd1-9dc7-3a9dde1b98ad",
                        "source_entry_id": "b6c6b941-4c5e-330d-b88e-cfca528bce90",
                        "source_sense_id": "d76b7e81-4a3c-355d-811e-2bd545fb3c6c",
                        "source_sense_description": "een wetenschapper die de biologie beoefent",
                        "target_lang_word": "biologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5ee0573-d7a0-3bf9-9c0c-41006fef3639",
                                        "entry_id": "87753e98-2e79-37bf-9966-72ede723a0af",
                                        "glosses": [
                                            "Personne qui étudie la biologie, c’est-à-dire les organismes vivants ainsi que leurs constituants et leurs interactions avec leur environnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c231f364-f411-4e21-b49f-12e18c227155",
                                                "sense_id": "a5ee0573-d7a0-3bf9-9c0c-41006fef3639",
                                                "text": "Aucun biologiste ni éthologue, qu’il soit évolutionniste ou non, n’établit de différence fondamentale entre les lois biologiques régissant le monde animal et celles régissant l’espèce humaine."
                                            },
                                            {
                                                "example_id": "d667380c-d19a-4e47-8473-3534fef4d269",
                                                "sense_id": "a5ee0573-d7a0-3bf9-9c0c-41006fef3639",
                                                "text": "« Endormir un cerf pour le relocaliser est une épreuve très stressante pour l’animal. Dans plus de 50 % des cas de déplacement, il meurt dans les heures ou les jours suivants son réveil », explique Anaïs Gasse, biologiste au ministère de la Faune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eab96340-ae11-3de0-905e-a3daffad0a81",
                                        "entry_id": "87753e98-2e79-37bf-9966-72ede723a0af",
                                        "glosses": [
                                            "Personne qui utilise la biologie dans une branche particulière (voir les Dérivés ci-dessous)."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95481556-f7a8-4259-8213-a81125305739",
                        "source_entry_id": "b6c6b941-4c5e-330d-b88e-cfca528bce90",
