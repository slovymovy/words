                    {
                        "translation_id": "b042c6fa-641d-4cb4-9000-d1a53116d39e",
                        "source_entry_id": "71adce9a-14d5-3b9f-b043-369e8ff8fcf6",
                        "source_sense_id": "86c93d39-bc93-3dc2-90be-b6b9ad45a799",
