                "senses": [
                    {
                        "sense_id": "68891a5f-75ec-355e-9ca3-845eb4d46137",
                        "entry_id": "bea7a8da-18c4-3bc7-923a-6ea79bfaefbc",
                        "glosses": [
                            "Ort der Gewinnung (Fabrik) für den Rohstoff, das Alkalimetall Lithium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a7356a5-0563-49cb-ada8-86ac4326764d",
                                "sense_id": "68891a5f-75ec-355e-9ca3-845eb4d46137",
                                "text": "„Dort flimmert das schwarze Dach der Lithiumfabrik in der Sonne.“"
                            },
                            {
                                "example_id": "82d8089f-be0c-421c-b76a-0d087b5dc04b",
                                "sense_id": "68891a5f-75ec-355e-9ca3-845eb4d46137",
                                "text": "„Manchmal spielen sie noch Fußball auf dem staubigen Feld neben der Baustelle, aus der einmal eine Lithiumfabrik werden soll.“"
                            },
                            {
                                "example_id": "8bc1dbaf-ce7a-4fee-b979-ac1a557cbabc",
                                "sense_id": "68891a5f-75ec-355e-9ca3-845eb4d46137",
                                "text": "„Vor der kleinen Lithiumfabrik stehen Soldaten und bewachen den Eingang.“"
                            },
                            {
                                "example_id": "0b9b4475-67f0-4efc-90b5-3f318f3c2375",
                                "sense_id": "68891a5f-75ec-355e-9ca3-845eb4d46137",
                                "text": "„Die ‚Lithium Corporation of America‘ hat 7 Millionen Dollar aufgewendet, um eine Lithiumfabrik in Bessemer City, North Carolina, zu erstellen.“"
                            },
                            {
                                "example_id": "9c1c9d00-da1e-4ca6-be52-d6112033a736",
                                "sense_id": "68891a5f-75ec-355e-9ca3-845eb4d46137",
                                "text": "„Diese betreibt seit kurzem in San Antonio (Texas) eine Lithiumfabrik auf Grundlage von südrhodesischen Erzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
