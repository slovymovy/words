                    {
                        "sense_id": "43cd0a59-a4c6-3602-99d1-d4907588bdfd",
                        "entry_id": "9ad9f222-3fd4-39e9-914f-28664a3937fa",
                        "glosses": [
                            "Application de l’informatique à la création, au traitement et à l’exploitation des images. — Image ainsi produite."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "04c0b025-55ae-4b23-87e2-a94e4d1d84ed",
                                "sense_id": "43cd0a59-a4c6-3602-99d1-d4907588bdfd",
                                "text": "Le produit final de l’infographie est une image en deux ou trois dimensions."
                            },
                            {
                                "example_id": "231826b8-f7ae-43d1-9b4e-cb03894ae013",
                                "sense_id": "43cd0a59-a4c6-3602-99d1-d4907588bdfd",
                                "text": "L’infographie est utilisée dans de nombreux domaines : télévision, médecine, architecture, muséographie, publicité, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "74b1019d-df8a-37f3-ba36-082fd48397d6",
                        "entry_id": "9ad9f222-3fd4-39e9-914f-28664a3937fa",
                        "glosses": [
                            "Ensemble des techniques permettant la réalisation d’un document graphique à partir de données numériques sur support informatique."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "57935ef6-ef87-35e3-a7f2-ec7a3f122a5f",
                        "entry_id": "9ad9f222-3fd4-39e9-914f-28664a3937fa",
                        "glosses": [
                            "Image qui vise à transmettre des informations de façon attractive."
