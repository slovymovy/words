{
    "word_family": [
        "blotter",
        "blotting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "75b05e67-01ad-367e-a0aa-895c5972ae78",
                    "sense_definition": "A spot or stain made by a coloured substance like ink.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She accidentally left a large ink <w>blot</w> on her homework assignment.",
                            "target_lang_translations": {
                                "zh": "她不小心在作业上留下了一大块墨<w>污点</w>。",
                                "ru": "Она случайно посадила большую чернильную <w>кляксу</w> в домашней работе."
                            }
                        },
                        {
                            "text": "A drop of ink fell from his pen and left a dark <w>blot</w> on the page.",
                            "target_lang_translations": {
                                "zh": "一滴墨水从他的笔尖滴落，在纸上留下了一块深色的<w>墨迹</w>。",
                                "ru": "С его пера упала капля чернил и оставила тёмное <w>пятно</w> на странице."
                            }
                        }
                    ],
                    "synonyms": [
                        "stain",
                        "spot",
                        "blemish"
                    ],
                    "common_phrases": [
                        "blot on landscape"
                    ],
                    "target_lang_definitions": {
                        "zh": "指墨水等有色物质留下的斑点或污迹。",
                        "ru": "Пятно или клякса, оставленная красящим веществом (обычно чернилами)."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "污点",
                                "target_lang_sense_clarification": "指物体表面留下的污迹或斑点。"
                            },
                            {
                                "target_lang_word": "墨迹",
                                "target_lang_sense_clarification": "特指墨水留下的痕迹。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "клякса",
                                "target_lang_sense_clarification": "бесформенное чернильное пятно"
                            },
                            {
                                "target_lang_word": "пятно",
                                "target_lang_sense_clarification": "загрязненное место на поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ef754b2-82e7-3334-a5ab-b24f18bd6a96",
                    "sense_definition": "A stain on someone's reputation or character; a disgrace.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal was a permanent <w>blot</w> on his otherwise clean record.",
                            "target_lang_translations": {
                                "zh": "这桩丑闻成了他原本清白的记录中永远的<w>污点</w>。",
                                "ru": "Скандал стал несмываемым <w>пятном</w> на его безупречной до этого биографии."
                            }
                        },
                        {
                            "text": "His criminal past remains a <w>blot</w> on his reputation.",
                            "target_lang_translations": {
                                "zh": "他过去的犯罪经历依然是他名誉上的一个<w>污点</w>。",
                                "ru": "Его криминальное прошлое остаётся <w>пятном</w> на его репутации."
                            }
                        }
                    ],
                    "synonyms": [
                        "disgrace",
                        "stain",
                        "stigma"
                    ],
                    "target_lang_definitions": {
                        "zh": "指名誉或品格上的污点；耻辱。",
                        "ru": "Позор или порочащий факт, наносящий ущерб репутации или характеру человека."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "污点",
                                "target_lang_sense_clarification": "指名誉或记录上的不光彩之处。"
                            },
                            {
                                "target_lang_word": "耻辱",
                                "target_lang_sense_clarification": "指令人蒙羞的事件或行为。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пятно",
                                "target_lang_sense_clarification": "порочащий факт в репутации"
                            },
                            {
                                "target_lang_word": "позор",
                                "target_lang_sense_clarification": "бесчестие, постыдный поступок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "968f3e80-b599-3e4f-b49e-7c70d00257e3",
                    "sense_definition": "A laboratory technique for transferring biological molecules like DNA or proteins onto a carrier membrane.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers performed a Western <w>blot</w> to detect the specific protein.",
                            "target_lang_translations": {
                                "zh": "研究人员进行了蛋白质免疫印迹（Western <w>印迹法</w>）以检测特定蛋白质。",
                                "ru": "Исследователи провели вестерн-<w>блоттинг</w>, чтобы выявить специфический белок."
                            }
                        },
                        {
                            "text": "The results of the Southern <w>blot</w> confirmed the genetic mutation.",
                            "target_lang_translations": {
                                "zh": "Southern <w>印迹法</w>的结果证实了基因突变。",
                                "ru": "Результаты саузерн-<w>блота</w> подтвердили генетическую мутацию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "western blot"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种将DNA或蛋白质等生物分子转移到载体膜上的实验室技术。",
                        "ru": "Лабораторный метод переноса биологических молекул (ДНК, белков) на полимерную мембрану; блоттинг."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "印迹法",
                                "target_lang_sense_clarification": "生物化学中用于检测特定分子的实验技术。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "блот",
                                "target_lang_sense_clarification": "метод переноса макромолекул на мембрану"
                            },
                            {
                                "target_lang_word": "блоттинг",
                                "target_lang_sense_clarification": "лабораторная техника анализа белков и нуклеиновых кислот"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9b9bee9-915e-3694-bf4c-29ba6f72d737",
                    "sense_definition": "A single exposed piece in the game of backgammon that can be hit by an opponent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He left a <w>blot</w> on the five-point, allowing his opponent to hit it.",
                            "target_lang_translations": {
                                "zh": "他在五点位留下了一个<w>孤子</w>，让对手有机会将其击出。",
                                "ru": "Он оставил <w>блот</w> на пятом пункте, позволив сопернику его побить."
                            }
                        },
                        {
                            "text": "Leaving a <w>blot</w> is risky when your opponent has many checkers nearby.",
                            "target_lang_translations": {
                                "zh": "当对手在附近有很多棋子时，留下<w>孤子</w>是很冒险的。",
                                "ru": "Оставлять <w>блот</w> рискованно, когда у противника поблизости много шашек."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在双陆棋游戏中，指棋盘上单个且容易被对方吃掉的棋子。",
                        "ru": "Одиночная незащищенная шашка в нардах (коротких), которую может побить соперник."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "孤子",
                                "target_lang_sense_clarification": "双陆棋中落单的棋子。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "блот",
                                "target_lang_sense_clarification": "одиночная шашка в коротких нардах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "566c3c6d-0008-39b0-8493-f13f74e2c92f",
                    "sense_definition": "To dry wet ink on paper using special absorbent paper.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a piece of paper to <w>blot</w> the wet ink on the letter.",
                            "target_lang_translations": {
                                "zh": "他用一张纸把信上未干的墨水<w>吸干</w>了。",
                                "ru": "Он воспользовался листочком, чтобы <w>промокнуть</w> сырые чернила на письме."
                            }
                        },
                        {
                            "text": "Make sure to <w>blot</w> the signature so it does not smear.",
                            "target_lang_translations": {
                                "zh": "一定要把签名<w>吸干</w>，以免弄花。",
                                "ru": "Обязательно <w>промокните</w> подпись, чтобы она не размазалась."
                            }
                        }
                    ],
                    "synonyms": [
                        "dry",
                        "absorb"
                    ],
                    "target_lang_definitions": {
                        "zh": "用吸水纸吸干纸上未干的墨水。",
                        "ru": "Сушить свежие чернила на бумаге с помощью промокашки."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吸干",
                                "target_lang_sense_clarification": "用纸张吸收多余的液体。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "промакивать",
                                "target_lang_sense_clarification": "сушить чернила промокательной бумагой"
                            },
                            {
                                "target_lang_word": "промокнуть",
                                "target_lang_sense_clarification": "осушить излишки чернил промокашкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cec2eba-42f7-3700-aee3-07868964338a",
                    "sense_definition": "To remove or erase something completely, usually followed by 'out'.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government tried to <w>blot</w> out the memory of the failed revolution.",
                            "target_lang_translations": {
                                "zh": "政府试图<w>抹去</w>那场失败革命的记忆。",
                                "ru": "Правительство пыталось <w>стереть</w> память о неудавшейся революции."
                            }
                        },
                        {
                            "text": "She decided to <w>blot</w> out the embarrassing incident from her mind.",
                            "target_lang_translations": {
                                "zh": "她决定将那件尴尬的事从脑海中<w>抹去</w>。",
                                "ru": "Она решила <w>вычеркнуть</w> этот неловкий случай из памяти."
                            }
                        }
                    ],
                    "synonyms": [
                        "erase",
                        "obliterate",
                        "efface"
                    ],
                    "common_phrases": [
                        "blot out"
                    ],
                    "target_lang_definitions": {
                        "zh": "彻底消除或抹去某事（通常与out连用）。",
                        "ru": "Полностью стирать, вычеркивать или уничтожать (обычно с предлогом out)."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抹去",
                                "target_lang_sense_clarification": "指从记忆或记录中彻底清除。"
                            },
                            {
                                "target_lang_word": "忘掉",
                                "target_lang_sense_clarification": "指主观上试图消除记忆。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "стирать",
                                "target_lang_sense_clarification": "удалять из памяти или записей"
                            },
                            {
                                "target_lang_word": "вычеркивать",
                                "target_lang_sense_clarification": "намеренно забывать, уничтожать след"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9020013-5031-35de-a335-01a12a751b58",
                    "sense_definition": "To accidentally make a stain on a surface.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>blot</w> the document with your coffee.",
                            "target_lang_translations": {
                                "zh": "小心别用咖啡把文件<w>弄脏</w>了。",
                                "ru": "Осторожнее, не <w>посади пятно</w> от кофе на документ."
                            }
                        },
                        {
                            "text": "He managed to <w>blot</w> his shirt with ink while writing.",
                            "target_lang_translations": {
                                "zh": "他写字时没注意，把衬衫<w>弄脏</w>了墨水。",
                                "ru": "Во время письма он умудрился <w>заляпать</w> рубашку чернилами."
                            }
                        }
                    ],
                    "synonyms": [
                        "stain",
                        "spot"
                    ],
                    "target_lang_definitions": {
                        "zh": "不小心在表面上弄出污渍。",
                        "ru": "Случайно сажать пятно или пачкать поверхность."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弄脏",
                                "target_lang_sense_clarification": "指不慎使物体表面产生污迹。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сажать пятно",
                                "target_lang_sense_clarification": "ставить кляксу или загрязнять"
                            },
                            {
                                "target_lang_word": "пачкать",
                                "target_lang_sense_clarification": "оставлять следы грязи или чернил"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdeab498-1840-34af-86a0-cb90f6b49c9c",
                    "sense_definition": "To soak up or absorb a liquid.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a paper towel to <w>blot</w> the spilled water on the table.",
                            "target_lang_translations": {
                                "zh": "用纸巾把桌上洒的水<w>吸</w>干。",
                                "ru": "Возьмите бумажное полотенце, чтобы <w>промокнуть</w> пролитую на стол воду."
                            }
                        },
                        {
                            "text": "This special paper is designed to <w>blot</w> excess moisture quickly.",
                            "target_lang_translations": {
                                "zh": "这种特制纸张旨在快速<w>吸</w>走多余的水分。",
                                "ru": "Эта специальная бумага создана для того, чтобы быстро <w>впитывать</w> лишнюю влагу."
                            }
                        }
                    ],
                    "synonyms": [
                        "absorb",
                        "soak"
                    ],
                    "target_lang_definitions": {
                        "zh": "吸收液体。",
                        "ru": "Впитывать влагу или осушать жидкость прикладыванием салфетки, ткани или бумаги."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吸",
                                "target_lang_sense_clarification": "指通过接触吸收水分或液体。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "промакивать",
                                "target_lang_sense_clarification": "впитывать излишки жидкости салфеткой"
                            },
                            {
                                "target_lang_word": "впитывать",
                                "target_lang_sense_clarification": "поглощать жидкость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0365510-f586-3b01-bdb2-7e08fc8e048d",
                    "sense_definition": "To damage someone's reputation or bring shame upon them.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>blot</w> your family name with such dishonest behavior.",
                            "target_lang_translations": {
                                "zh": "不要用这种不诚实的行为来<w>玷污</w>你的家族名声。",
                                "ru": "Не <w>пятнай</w> имя своей семьи столь нечестным поведением."
                            }
                        },
                        {
                            "text": "His actions served only to <w>blot</w> his professional reputation.",
                            "target_lang_translations": {
                                "zh": "他的行为只会<w>玷污</w>他的职业声誉。",
                                "ru": "Его действия лишь <w>запятнали</w> его профессиональную репутацию."
                            }
                        }
                    ],
                    "synonyms": [
                        "disgrace",
                        "tarnish",
                        "stain"
                    ],
                    "target_lang_definitions": {
                        "zh": "损害某人的名誉或使其蒙羞。",
                        "ru": "Наносить ущерб чьей-либо репутации, покрывать позором."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "玷污",
                                "target_lang_sense_clarification": "指损害名誉或清白。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пятнать",
                                "target_lang_sense_clarification": "порочить чье-либо доброе имя"
                            },
                            {
                                "target_lang_word": "запятнать",
                                "target_lang_sense_clarification": "опорочить честь или репутацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8379d0dc-5a65-3754-af2b-f26b030cb50f",
                    "sense_definition": "To sell illegal drugs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested the man for <w>blotting</w> drugs on the street corner.",
                            "target_lang_translations": {
                                "zh": "警察因该男子在街角<w>贩毒</w>而将其逮捕。",
                                "ru": "Полиция арестовала мужчину за <w>торговлю</w> наркотиками на углу улицы."
                            }
                        },
                        {
                            "text": "He was caught <w>blotting</w> in the neighborhood late at night.",
                            "target_lang_translations": {
                                "zh": "他深夜在社区里<w>贩毒</w>时被抓住了。",
                                "ru": "Его поймали поздно ночью, когда он <w>барыжил</w> на районе."
                            }
                        }
                    ],
                    "synonyms": [
                        "deal",
                        "push"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in criminal or street contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "非法贩卖毒品。",
                        "ru": "Заниматься незаконной торговлей наркотиками (жаргон)."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贩毒",
                                "target_lang_sense_clarification": "指非法买卖毒品的犯罪行为。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "толкать",
                                "target_lang_sense_clarification": "сбывать наркотики (жарг.)"
                            },
                            {
                                "target_lang_word": "барыжить",
                                "target_lang_sense_clarification": "торговать запрещенными веществами (жарг.)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}