                        {
                            "text": "Dat is <w>dus</w> precies wat ik bedoelde.",
                            "target_lang_translations": {
                                "ru": "Это, <w>значит</w>, именно то, что я имел в виду.",
                                "en": "<w>So</w> that is exactly what I meant.",
                                "pl": "To jest <w>więc</w> dokładnie to, co miałem na myśli.",
                                "de": "Das ist <w>also</w> genau das, was ich meinte.",
                                "fr": "C'est <w>donc</w> exactement ce que je voulais dire.",
                                "it": "Questo è <w>quindi</w> esattamente ciò che intendevo.",
                                "cs": "To je <w>tedy</w> přesně to, co jsem měl na mysli.",
                                "tr": "<w>Demek ki</w> tam olarak kastettiğim şey buydu.",
                                "es": "Eso es <w>exactamente</w> lo que quería decir."
                            }
                        }
