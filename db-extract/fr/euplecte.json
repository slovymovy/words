                        "glosses": [
                            "Oiseau de l'Afrique centrale appelé aussi Franciscain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "155af38a-b011-4e8f-bbd5-f47224eaaf18",
                                "sense_id": "e9561859-f37f-3030-a0ae-d7d833016203",
                                "text": "Des euplectes ignicolores, parés de plumes rouge brillant et noir, se dressent au sommet des papyrus."
                            },
                            {
                                "example_id": "113725a8-fab1-445d-90d2-2163341c1f0a",
                                "sense_id": "e9561859-f37f-3030-a0ae-d7d833016203",
                                "text": "Dans le marais, ils surprennent un euplecte à longue queue qui peine sous le poids de son lourd panache trempé."
                            },
                            {
                                "example_id": "4fe672d1-f3d7-49c1-89f5-c8dd3973efcd",
                                "sense_id": "e9561859-f37f-3030-a0ae-d7d833016203",
                                "text": "Un euplecte veuve-noire, encombré de sa longue queue, passa juste au-dessus d'eux en un ballet sinueux, presque poussif. On aurait dit qu'il nageait dans l’air plus qu'il ne volait."
                            }
                        ]
                    }
