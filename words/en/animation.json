{
    "word_family": [
        "animate",
        "animator",
        "animated",
        "inanimate",
        "reanimate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c30ef8c-0a52-3337-aa97-45553c576a19",
                    "sense_definition": "The process of creating films, games, or computer graphics in which drawings or models appear to move.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children watched a movie with colorful <w>animation</w>.",
                            "target_lang_translations": {
                                "ru": "Дети смотрели фильм с красочной <w>анимацией</w>.",
                                "zh": "孩子们看了一部色彩鲜艳的<w>动画</w>电影。"
                            }
                        },
                        {
                            "text": "He wants to study <w>animation</w> at the university.",
                            "target_lang_translations": {
                                "ru": "Он хочет изучать <w>анимацию</w> в университете.",
                                "zh": "他想在大学里学习<w>动画</w>制作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "computer animation",
                        "animation studio",
                        "3D animation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс создания фильмов, игр или компьютерной графики, в которых рисунки или модели кажутся движущимися.",
                        "zh": "制作电影、游戏或计算机图形的过程，使图画或模型看起来在移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "анимация",
                                "target_lang_sense_clarification": "компьютерная графика или общий термин"
                            },
                            {
                                "target_lang_word": "мультипликация",
                                "target_lang_sense_clarification": "создание мультфильмов, обычно рисованных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动画",
                                "target_lang_sense_clarification": "指动画制作或动画片"
                            },
                            {
                                "target_lang_word": "动画制作",
                                "target_lang_sense_clarification": "指制作动画的过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dac802f-3b0d-38fd-a839-37dcb5ceb582",
                    "sense_definition": "Entertainment activities and sports organized for guests at a holiday resort or hotel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel <w>animation</w> included sports and dancing.",
                            "target_lang_translations": {
                                "ru": "Отельная <w>анимация</w> включала спорт и танцы.",
                                "zh": "酒店的<w>康乐活动</w>包括体育运动和舞蹈。"
                            }
                        },
                        {
                            "text": "We joined the daily <w>animation</w> by the pool.",
                            "target_lang_translations": {
                                "ru": "Мы присоединились к дневной <w>анимации</w> у бассейна.",
                                "zh": "我们参加了泳池边每天举办的<w>娱乐活动</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hotel animation",
                        "evening animation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Развлекательные мероприятия и спорт, организованные для гостей курорта или отеля.",
                        "zh": "为度假村或酒店客人组织的娱乐活动和体育项目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "анимация",
                                "target_lang_sense_clarification": "организация досуга"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "康乐活动",
                                "target_lang_sense_clarification": "酒店或度假村提供的娱乐项目"
                            },
                            {
                                "target_lang_word": "娱乐活动",
                                "target_lang_sense_clarification": "通用的休闲娱乐安排"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "deaf7d11-09fa-39cc-a82a-8c63358adfe3",
                    "sense_definition": "A state of being full of energy, enthusiasm, and life.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "life_spirit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She discussed her new project with great <w>animation</w>.",
                            "target_lang_translations": {
                                "ru": "Она обсуждала свой новый проект с большим <w>оживлением</w>.",
                                "zh": "她<w>兴致勃勃</w>地讨论着她的新项目。"
                            }
                        },
                        {
                            "text": "His face lost its <w>animation</w> when he heard the news.",
                            "target_lang_translations": {
                                "ru": "Его лицо утратило <w>живость</w>, когда он услышал новости.",
                                "zh": "听到这个消息时，他的脸上失去了往日的<w>活力</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "liveliness",
                        "energy",
                        "enthusiasm",
                        "spirit",
                        "vivacity"
                    ],
                    "common_phrases": [
                        "with animation",
                        "speak with animation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, полное энергии, энтузиазма и жизни.",
                        "zh": "充满活力、热情和生命力的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживление",
                                "target_lang_sense_clarification": "активность, живость в поведении"
                            },
                            {
                                "target_lang_word": "воодушевление",
                                "target_lang_sense_clarification": "душевный подъём"
                            },
                            {
                                "target_lang_word": "живость",
                                "target_lang_sense_clarification": "энергичность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活力",
                                "target_lang_sense_clarification": "充满生命力和能量"
                            },
                            {
                                "target_lang_word": "兴致勃勃",
                                "target_lang_sense_clarification": "形容表现出的热情和精神"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18c99f93-dff7-3d11-8ee4-c60109b0e421",
                    "sense_definition": "The condition of being alive or possessing life.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "life_spirit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frozen insect showed no signs of <w>animation</w>.",
                            "target_lang_translations": {
                                "ru": "Замёрзшее насекомое не подавало признаков <w>жизни</w>.",
                                "zh": "那只冻僵的昆虫没有表现出任何<w>生命</w>迹象。"
                            }
                        },
                        {
                            "text": "The patient was kept in suspended <w>animation</w>.",
                            "target_lang_translations": {
                                "ru": "Пациента держали в состоянии <w>анабиоза</w>.",
                                "zh": "病人被维持在<w>假死</w>状态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "life"
                    ],
                    "common_phrases": [
                        "suspended animation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние жизни или наличие признаков жизни.",
                        "zh": "活着或具有生命的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жизнь",
                                "target_lang_sense_clarification": "наличие жизненных функций"
                            },
                            {
                                "target_lang_word": "жизненность",
                                "target_lang_sense_clarification": "свойство живого"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "生命",
                                "target_lang_sense_clarification": "生物存在的状态"
                            },
                            {
                                "target_lang_word": "生命迹象",
                                "target_lang_sense_clarification": "表现出活着的特征"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f39d283-8287-3651-a885-e699a1ca4a08",
                    "sense_definition": "The act of bringing something to life or giving it spirit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "life_spirit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>animation</w> of the clay figure was magical.",
                            "target_lang_translations": {
                                "ru": "<w>Оживление</w> глиняной фигурки было волшебным.",
                                "zh": "让泥塑<w>赋予生命</w>的过程非常神奇。"
                            }
                        },
                        {
                            "text": "He described the <w>animation</w> of the soul in his poem.",
                            "target_lang_translations": {
                                "ru": "Он описал <w>одушевление</w> души в своём стихотворении.",
                                "zh": "他在诗中描述了灵魂的<w>注入</w>过程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vitalization",
                        "vivification",
                        "enlivenment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по оживлению чего-либо или наделению душой.",
                        "zh": "使某物获得生命或赋予其精神的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживление",
                                "target_lang_sense_clarification": "возвращение к жизни или придание движения"
                            },
                            {
                                "target_lang_word": "одушевление",
                                "target_lang_sense_clarification": "наделение душой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赋予生命",
                                "target_lang_sense_clarification": "使无生命之物变得生动"
                            },
                            {
                                "target_lang_word": "注入灵魂",
                                "target_lang_sense_clarification": "赋予精神或灵性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24ab101f-527f-3453-a91a-de488d84da15",
                    "sense_definition": "A grammatical category distinguishing living things from non-living things.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In grammar, <w>animation</w> affects how words change form.",
                            "target_lang_translations": {
                                "ru": "В грамматике <w>одушевлённость</w> влияет на то, как изменяются слова.",
                                "zh": "在语法中，<w>有生性</w>会影响词汇的变格。"
                            }
                        },
                        {
                            "text": "The rule depends on the <w>animation</w> of the noun.",
                            "target_lang_translations": {
                                "ru": "Правило зависит от <w>одушевлённости</w> существительного.",
                                "zh": "这条规则取决于名词的<w>有生性</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грамматическая категория, различающая живые и неживые предметы.",
                        "zh": "区分生物与非生物的语法范畴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одушевлённость",
                                "target_lang_sense_clarification": "грамматическая категория"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有生性",
                                "target_lang_sense_clarification": "语言学中区分生命体的范畴"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}