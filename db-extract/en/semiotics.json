                    {
                        "translation_id": "f8f7df29-9df3-4a18-b915-d4462d22dd05",
                        "source_entry_id": "f636b538-f0cd-33a6-a624-89ec94173076",
                        "source_sense_description": "study of signs",
                        "target_lang_word": "sémiotique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sémiotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17efc7da-ad86-30b2-b2df-a118d0782ee4",
                                        "entry_id": "1b067bfd-4350-3f22-b805-280e9165f013",
                                        "glosses": [
                                            "Qui relève de la sémiotique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37c3570-70b9-4208-86f5-0d874ac40c1c",
                                                "sense_id": "17efc7da-ad86-30b2-b2df-a118d0782ee4",
                                                "text": "La Recherche est un « apprentissage » du sens et de sa saisie, une recherche sémiotique donc, qui conduit selon Deleuze à une « expérimentation des essences »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sémiotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24dc4873-0449-3a00-9b7a-4a5d8e36911f",
                                        "entry_id": "76d82d57-0814-3fea-b534-2b0dccfefea1",
                                        "glosses": [
                                            "Partie de la médecine qui traite des signes cliniques et des symptômes des maladies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f47e7123-22a2-4829-89db-1632a96fd9cc",
                                                "sense_id": "24dc4873-0449-3a00-9b7a-4a5d8e36911f",
                                                "text": "Dans les trois cas, on entrevoit le modèle de la sémiotique médicale — la discipline qui permet de diagnostiquer les maladies inaccessibles à l’observation directe basé sur des symptômes superficiels, parfois insignifiant aux yeux du profane."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sémiotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bba4e598-7fc7-3e78-ac70-2d196848ae3a",
                                        "entry_id": "015a610f-089e-37e6-b5ea-409a81daf755",
                                        "glosses": [
                                            "Étude des signes, des symboles et de leur signification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "251e0e8d-0f8e-4810-ab00-6cc7053e6af1",
                                                "sense_id": "bba4e598-7fc7-3e78-ac70-2d196848ae3a",
                                                "text": "La sémiotique se fonde sur le concept de signe, formé par la relation entre un élément perceptible, le signifiant, et le sens donné à ce signifiant à l'intérieur d'un code plus ou moins construit, sens auquel on donne le nom de signifié."
                                            },
                                            {
                                                "example_id": "b309717f-9fc8-43a1-9aa4-b9f17406cea1",
                                                "sense_id": "bba4e598-7fc7-3e78-ac70-2d196848ae3a",
                                                "text": "'Sémiotique, venu de l’anglais, est tantôt un synonyme de sémiologie et tantôt en est distingué, mais de diverses façons. Souvent il concerne la théorie générale de la signification, telle que celle-ci se manifeste, non seulement dans le langage proprement dit, mais aussi dans les œuvres d’art, dans les rites religieux, dans le droit, etc."
                                            },
                                            {
                                                "example_id": "337219c9-914a-42e3-96e2-d07fddb18bc3",
                                                "sense_id": "bba4e598-7fc7-3e78-ac70-2d196848ae3a",
                                                "text": "La sémiotique matérielle des marchandises est devenue ainsi de plus en plus importante au fur et à mesure de leur montée en puissance comme marqueurs d’identité et de statut de l’individu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ebe0c37-517b-4a6b-8157-fb3429ce4800",
                        "source_entry_id": "f636b538-f0cd-33a6-a624-89ec94173076",
                        "source_sense_description": "study of signs",
                        "target_lang_word": "Semiotik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Semiotik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                        "entry_id": "c8b3ad5e-826c-3212-91d9-0921fb3c0e14",
                                        "glosses": [
                                            "Wissenschaft, die sich mit Zeichensystemen aller Art (zum Beispiel: Bilderschrift, Gestik, Formeln, Sprache, Verkehrszeichen) befasst und versucht, sie zu beschreiben und zu erklären"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cf626e8-ef4f-45f3-bf78-17cb4e1c6701",
                                                "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                                "text": "Im Verkehrsunterricht lernt man die Semiotik der Straße, das heißt alle Verkehrszeichen. Im Unterschied dazu stehen die Verkehrsregeln, die nicht die Semiotik betreffen."
                                            },
                                            {
                                                "example_id": "9b0998b3-ab81-41db-b696-cd60a951417b",
                                                "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                                "text": "„Die Semiotik untersucht alle kulturellen Prozesse als Kommunikationsprozesse.“"
                                            },
                                            {
                                                "example_id": "23ce2dba-9cde-41bb-8b0b-9d1de2e8fa61",
                                                "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                                "text": "„Der Gegenstandsbereich der Semiotik - letztlich eine Art und Weise der Erweiterung unserer Wahrnehmung der Welt - ist der Austausch jedweder Nachrichten und der Zeichensysteme, die ihnen zugrunde liegen […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f21b8665-2207-3a4d-b005-fb411feb3e2f",
                                        "entry_id": "c8b3ad5e-826c-3212-91d9-0921fb3c0e14",
                                        "glosses": [
                                            "Lehre von den Anzeichen für eine Erkrankung oder Verletzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c83a899-bf74-4bc1-8893-7adbed93534b",
                                                "sense_id": "f21b8665-2207-3a4d-b005-fb411feb3e2f",
                                                "text": "„Semiotik ist die Lehre von den Zeichen des widernatürlichen Zustandes.“"
                                            },
                                            {
                                                "example_id": "d621bf6f-e018-4937-930d-55ee7a3e82bd",
                                                "sense_id": "f21b8665-2207-3a4d-b005-fb411feb3e2f",
                                                "text": "„Die Lehre, welche die einzelnen Zeichen auf ihre Ursachen, oder auf die ihnen entsprechenden Veränderungen des lebenden Körpers zurückführt, und dabei das Verhältnis der einzelnen Zeichen unter einander berücksichtigt, ist die Semiotik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
