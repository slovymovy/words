    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c01fe58-9c43-375f-be1d-cb8a71d53954",
                    "sense_definition": "Een eenvoudige, vaak herhalende melodie of een liedje dat makkelijk in het gehoor ligt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "melodie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vrolijke <w>deun</w> van de ijscoman was al van verre te horen in de straat.",
                            "target_lang_translations": {
                                "en": "The ice cream man's cheerful <w>tune</w> could be heard from far away in the street."
                            }
                        },
                        {
                            "text": "Hij floot een herkenbare <w>deun</w> terwijl hij aan het werk was.",
                            "target_lang_translations": {
                                "en": "He whistled a recognizable <w>tune</w> while he was working."
                            }
                        }
                    ],
                    "synonyms": [
                        "wijs",
                        "wijsje"
                    ],
                    "common_phrases": [
                        "een vrolijke deun",
                        "een herkenbare deun"
                    ],
                    "target_lang_definitions": {
                        "en": "A simple, often repetitive melody or a song that is easy to remember."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tune",
                                "target_lang_sense_clarification": "a melody or simple song"
                            },
                            {
                                "target_lang_word": "ditty",
                                "target_lang_sense_clarification": "a short, simple song"
                            },
                            {
                                "target_lang_word": "jingle",
                                "target_lang_sense_clarification": "a catchy, repetitive tune"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f44d4fb-1163-3d61-a6ba-28633034d623",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>deunen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>deun</w> zachtjes mee met de muziek die uit de radio komt.",
                            "target_lang_translations": {
                                "en": "I softly <w>hum</w> along with the music coming from the radio."
                            }
                        },
                        {
                            "text": "Als ik me verveel, <w>deun</w> ik vaak een simpel melodietje.",
                            "target_lang_translations": {
                                "en": "When I'm bored, I often <w>hum</w> a simple melody."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'deunen' (to hum or sing a simple tune)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hum",
                                "target_lang_sense_clarification": "to make a low, steady continuous sound or sing with closed lips"
                            },
                            {
                                "target_lang_word": "croon",
                                "target_lang_sense_clarification": "to hum or sing in a soft, low voice"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72f872ad-0d7f-3a32-a6ca-3f5cc6504e64",
                    "sense_definition": "Gebiedende wijs van <w>deunen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Deun</w> niet zo irritant de hele dag door!",
                            "target_lang_translations": {
                                "en": "Don't <w>hum</w> so annoyingly all day long!"
                            }
                        },
                        {
                            "text": "Kom op, <w>deun</w> gezellig mee met dit liedje.",
                            "target_lang_translations": {
                                "en": "Come on, <w>hum</w> along nicely with this song."
                            }
