                                                "sense_id": "f15ab7c8-4926-35a0-8684-dbc8afad4a6f",
                                                "text": "Ik vaag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a273014-23b6-3553-baca-fcc508f2a948",
                                        "entry_id": "68fe5720-3b5b-3184-96df-b451a1227b2a",
                                        "glosses": [
