                "forms": [],
                "senses": [
                    {
                        "sense_id": "ac2ee0d3-6475-33f7-9181-4e9101580607",
                        "entry_id": "6a98664c-3d5e-3140-942b-c1ded8553625",
                        "glosses": [
                            "Composé de formule chimique NO₂CCl₃."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1cb4d11-d8c0-4c55-8034-4c6297286819",
                                "sense_id": "ac2ee0d3-6475-33f7-9181-4e9101580607",
                                "text": "Cette huile a été nommée chloropicrine par M. Steuhouse. La chloropicrine, l'acide carbonique et l'acide chlorhydrique paraissent être les seuls produits de la décomposition de l'acide picrique par l'hypochlorite de chaux."
                            },
                            {
                                "example_id": "2a1eb610-8bb1-4349-9027-4db475473e84",
                                "sense_id": "ac2ee0d3-6475-33f7-9181-4e9101580607",
                                "text": "Chloropicrine ou nitrochloroforme CCl³(AzO²). — Ce corps se produit par l'action du chlorure de chaux sur les dérivés nitrés de beaucoup de corps organiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "80a0b044-1e56-39b1-8689-dd613575a9fb",
                        "entry_id": "6a98664c-3d5e-3140-942b-c1ded8553625",
                        "glosses": [
                            "Cette substance à usage de gaz de combat,"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7d85da67-b3f2-3e27-af5b-9896623197a1",
                        "entry_id": "6a98664c-3d5e-3140-942b-c1ded8553625",
                        "glosses": [
                            "Cette substance , à usage phytosanitaire, utilisable en traitement de sols contre la plupart des champignons parasites et les nématodes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a0231b2-3dc6-483e-a10e-5741a8421ce4",
                                "sense_id": "7d85da67-b3f2-3e27-af5b-9896623197a1",
                                "text": "La chloropicrine (trichloronitrométhane, D = 5,2) est un gaz très pénétrant que l'on utilise en injection dans le sol à raison de 400 à 600 litres de liquide à bas point d’ébullition par hectare."
                            }
                        ]
                    }
