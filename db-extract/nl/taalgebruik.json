                ],
                "senses": [
                    {
                        "sense_id": "140c84b0-4f17-3c8f-bfa7-fc7cd29b6a6a",
                        "entry_id": "98cc0fb4-8aa3-3a31-b973-9e2b786a86bb",
                        "glosses": [
                            "de manier waarop een taal wordt gebruikt b.v. vulgair, informeel, ongemarkeerd, formeel of archaïsch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b4e8908-7590-405a-81c0-1f77232530d2",
                                "sense_id": "140c84b0-4f17-3c8f-bfa7-fc7cd29b6a6a",
                                "text": "Het geheim van dit lied is dus het taalgebruik van Maaike Ouboter, noem het Ouboteriaans, maar natuurlijk ook de manier waarop ze het zingt. Technisch niet eens perfect, dat geeft ze zelf ook toe, maar wel met een intensiteit en bezieling dat het lijkt alsof ze zelf even de engel wordt waarvan ze heeft gedroomd."
                            },
                            {
                                "example_id": "bb9beae6-c6c4-4c6e-b50b-d2d142f68d14",
                                "sense_id": "140c84b0-4f17-3c8f-bfa7-fc7cd29b6a6a",
                                "text": "En hij had zich voorzien van een taalgebruik dat bijna komisch elegant klonk in de mond van een achttienjarige."
                            },
                            {
                                "example_id": "b49d3119-722e-43d9-a621-9170537fade0",
                                "sense_id": "140c84b0-4f17-3c8f-bfa7-fc7cd29b6a6a",
                                "text": "Eric kon de analyse van de subjectieve aspecten in zoverre volgen dat, in alledaagser taalgebruik, de regeringsleider Kosygin bepaald geen idioot was, maar dat de partijleider Brezjnev zonder twijfel een idioot was, maar helaas ook degene die de hoogste politieke macht in handen had."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41e462e7-fa18-4826-a79a-724248bcb349",
                        "source_entry_id": "98cc0fb4-8aa3-3a31-b973-9e2b786a86bb",
                        "source_sense_id": "140c84b0-4f17-3c8f-bfa7-fc7cd29b6a6a",
                        "source_sense_description": "de manier...",
                        "target_lang_word": "Sprachgebrauch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachgebrauch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f72ab630-913f-3a87-8ccd-b5a5aa93003c",
                                        "entry_id": "153dfde5-78c8-33fe-8ef6-dc91548cf075",
                                        "glosses": [
                                            "Anwendung der Sprache in Äußerungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c1f85d8-12ed-49bb-9c04-d34a64cfc99c",
                                                "sense_id": "f72ab630-913f-3a87-8ccd-b5a5aa93003c",
                                                "text": "In der Linguistik wird klar zwischen der Sprache selbst, dem Sprachsystem (= langue), und dem Gebrauch, der Verwendung dieses Systems (= Sprachgebrauch, parole) unterschieden."
                                            },
                                            {
                                                "example_id": "2ad4afcb-fc1c-41f1-bc64-7aca52dbae65",
                                                "sense_id": "f72ab630-913f-3a87-8ccd-b5a5aa93003c",
                                                "text": "„Beim Sprachgebrauch kann man sich darauf verlassen, daß der Kommunikationspartner viele Informationen schon hat, sowohl was allgemein gültige Überzeugungen wie auch was spezielle durch den Kontext vermittelte Informationen betrifft.“"
                                            },
                                            {
                                                "example_id": "1d3afd56-d0ce-4974-9b09-f93432608589",
                                                "sense_id": "f72ab630-913f-3a87-8ccd-b5a5aa93003c",
                                                "text": "„Wenn wir überdies auch für die frühen Zeiträume das Wort »Computer« benutzen, dann ist dieses als unsere Bezeichnung für das Gerät beziehungsweise die Technologie der jeweiligen Entwicklungsstufe zu verstehen und keineswegs als Zitat aus den damaligen (oft anderslautenden) Sprachgebräuchen.“"
                                            },
                                            {
                                                "example_id": "62d5f42c-2942-4dc5-80db-41694dc465d7",
                                                "sense_id": "f72ab630-913f-3a87-8ccd-b5a5aa93003c",
                                                "text": "„Im modernen Sprachgebrauch spielen Sprichwörter zweifellos noch immer eine wichtige Rolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "23b7130b-b6c0-37ca-9796-6cf0177a43d5",
                                        "entry_id": "153dfde5-78c8-33fe-8ef6-dc91548cf075",
                                        "glosses": [
                                            "die bei der Anwendung der Sprache in Äußerungen übliche Ausdrucksweise (= Usus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6b55ee-17fa-4c35-829b-4f047c294bf3",
                                                "sense_id": "23b7130b-b6c0-37ca-9796-6cf0177a43d5",
                                                "text": "Manche Ausdrucksweise, die früher üblich war, scheint aus dem Sprachgebrauch zu verschwinden. Auffällig ist z.B. eine Vermenschlichung von Tieren. Statt des früheren Sprachgebrauchs \"Der Hund ist verendet\" hört man inzwischen meist \"Der Hund ist gestorben.\""
                                            },
                                            {
                                                "example_id": "c4f798cd-1e2d-47aa-beaa-c940614b8d36",
                                                "sense_id": "23b7130b-b6c0-37ca-9796-6cf0177a43d5",
                                                "text": "„Die eine oder andere sprachplanerische Frage wird jedoch in jedem Land diskutiert: …der Einfluß der Medien auf den Sprachgebrauch...“"
                                            },
                                            {
                                                "example_id": "43bb6b85-0e14-48ed-b133-57cc3f974cac",
                                                "sense_id": "23b7130b-b6c0-37ca-9796-6cf0177a43d5",
                                                "text": "„Der Sprachgebrauch ist vielmehr so beharrlich, daß man den Wandel im Verlauf eines Menschenalters erst bei einiger Aufmerksamkeit gewahr wird.“"
                                            },
                                            {
                                                "example_id": "53ecf9ef-ed3a-4b5d-af3d-3cfe1a490dbe",
                                                "sense_id": "23b7130b-b6c0-37ca-9796-6cf0177a43d5",
                                                "text": "„Schließlich geht es um die Rückführung in ein Land, in dem nach der aktuellen, als vertraulich gestempelten Einschätzung des Auswärtigen Amtes bewaffnete Übergriffe, Bombenanschläge und Entführungen stetig zunehmen; in dem, inzwischen auch nach dem gültigen Sprachgebrauch der Bundesregierung, Krieg herrscht.“"
                                            },
                                            {
                                                "example_id": "d9fb0d72-0c8a-4f42-9715-88284ae9792f",
                                                "sense_id": "23b7130b-b6c0-37ca-9796-6cf0177a43d5",
                                                "text": "„Die Autoren von Grammatiken und Wörterbüchern hatten aus den - nicht in allen Punkten miteinander vereinbaren - vorbildlichen Sprachgebräuchen Prinzipien des guten und richtigen Schreibens und Sprechens abzuleiten, mit denen die vorhandenen Möglichkeiten der Sprache ausgebaut und Erfordernissen neuer gesellschaftlicher Entwicklungen angepasst werden konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
