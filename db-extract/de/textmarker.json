                                        "examples": [
                                            {
                                                "example_id": "29f7a287-ba92-4a7e-805a-0ecf53393622",
                                                "sense_id": "9baacb80-17fc-3132-a75d-114903321901",
                                                "text": "Susie got marker all over the walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97efa65d-9e1e-3749-aea1-2bee417f5b08",
                                        "entry_id": "4d5cf861-0743-3ebf-b933-f3332abb41ce",
                                        "glosses": [
                                            "A personal favor owed to someone, whether written or not."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00791586-7aee-4c0c-ba56-1f76e6aea622",
                                                "sense_id": "97efa65d-9e1e-3749-aea1-2bee417f5b08",
                                                "text": "We may not be able to do this alone. Maybe it’s time to call in some of our markers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "097a78ba-5791-3f3e-99c0-0a5da5e2809e",
                                        "entry_id": "4d5cf861-0743-3ebf-b933-f3332abb41ce",
                                        "glosses": [
                                            "A formal certification that a company was the first to approach a competition authority to reveal the existence of a cartel, generally entitling it to greater leniency during the cartel's dissolution and punishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c097afa0-7b8f-34f4-84d2-81400b912815",
                                        "entry_id": "4d5cf861-0743-3ebf-b933-f3332abb41ce",
                                        "glosses": [
                                            "A player on defense used to mark one or more offensive players."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af4e6b02-b736-4705-9e9d-c24ceaa66e78",
                                                "sense_id": "c097afa0-7b8f-34f4-84d2-81400b912815",
                                                "text": "He skipped past Marc Wilson before clipping a delicious cross into the Stoke danger zone, where Cisse's sharp movement allowed him to escape marker Robert Huth and send a far-post header crashing against the crossbar. And Cabaye was waiting to pounce on the rebound with a close range header."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd781425-4380-37d6-a155-07d8e9d8784a",
                                        "entry_id": "4d5cf861-0743-3ebf-b933-f3332abb41ce",
                                        "glosses": [
                                            "A player employed by a private club to compete against members."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aef6471c-130b-471a-9a00-a47402fea29d",
                                                "sense_id": "cd781425-4380-37d6-a155-07d8e9d8784a",
                                                "text": "The Court itself, with its rent, the wages of the Marker and the tips to the Marker, the rackets and the balls, the baths and the flannels and the washing of the flannels, do much to account for the costliness of play."
                                            },
                                            {
                                                "example_id": "20d8539a-c5ad-4a06-a843-e15370bbcb28",
                                                "sense_id": "cd781425-4380-37d6-a155-07d8e9d8784a",
                                                "text": "Some of the native markers attain to great skill, and the brilliant success in London of \" Jamsetjee \" the Bombay professional affords sufficient testimony to their capabilities."
                                            },
                                            {
                                                "example_id": "a0931e94-c6aa-4b3c-a11d-b6d362209182",
                                                "sense_id": "cd781425-4380-37d6-a155-07d8e9d8784a",
                                                "text": "Of his victories over the curate at this game he is as proud as are others of his sex and cloth, not being old maids, of their mastery of \"side\" at billiards, and of an occasional victory over the club marker at evens."
                                            },
                                            {
                                                "example_id": "93786ea6-4ede-4c5f-9f20-3cf91c13c1aa",
                                                "sense_id": "cd781425-4380-37d6-a155-07d8e9d8784a",
                                                "text": "I played seven sets of doubles with Mitchell (the second best player in Ceylon) and David, the native marker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbad73f3-010c-37b4-a70b-943cbc656d36",
                                        "entry_id": "4d5cf861-0743-3ebf-b933-f3332abb41ce",
                                        "glosses": [
                                            "A point, unit of scoring in a game or competition."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "marker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "202dba82-3edf-3763-8ae7-0ee7a8d8c34d",
                                        "entry_id": "2721e29e-a04d-33e5-a415-9f84afd7b6bb",
                                        "glosses": [
                                            "To mark or write on (something) using a marker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6357c4-6b9c-4fe8-a16d-0b293677bf4e",
                                                "sense_id": "202dba82-3edf-3763-8ae7-0ee7a8d8c34d",
                                                "text": "On one page someone has markered: \"Remember, you are your own best thing.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
