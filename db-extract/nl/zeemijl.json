                    }
                ],
                "translations": [
                    {
                        "translation_id": "816f3b61-e3a5-4f15-b0c7-d8f5844ca8a0",
                        "source_entry_id": "98328e90-ab83-346e-8037-2c5feb461511",
                        "source_sense_id": "d06852ba-6dbf-3fb9-8709-fc4128a0a1e8",
                        "source_sense_description": "afstandsmaat, in gebruik op zee, 1852m",
                        "target_lang_word": "Seemeile",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seemeile",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
                                        "entry_id": "9b5c30fd-f5f5-378b-b4d1-0544cf0f3e9e",
                                        "glosses": [
                                            "Längenmaß aus der Seefahrt: entspricht 1,852 Kilometer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2b5c55-eda0-41d3-9df1-c1a8a1fce6c9",
                                                "sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
                                                "text": "5 Seemeilen sind etwa 9 Kilometer."
                                            },
                                            {
                                                "example_id": "b8dbbd69-0e8f-47d7-ada1-334497156f26",
                                                "sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
                                                "text": "„Eine Stunde später machte der Rudergänger backbord voraus in einer Entfernung von sechs Seemeilen ein anderes Schiff aus, das westlichen Kurs steuerte, ihnen also in etwa entgegenkam.“"
                                            },
                                            {
                                                "example_id": "28961de6-7c97-4753-beca-c2dacf7f64bb",
                                                "sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
                                                "text": "„In diesem Moment lagen unsere hintersten Schiffe zwei Seemeilen zurück, und der Kommodore drehte vor dem Wind und holte kreuzend auf dem anderen Gang auf.“"
                                            },
                                            {
                                                "example_id": "c06be1de-3566-429e-93bb-4b63e04e54a6",
                                                "sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
                                                "text": "„U 96 war zu diesem Zeitpunkt etwa 230 Seemeilen nordöstlich des Geleitzuges, Lehmann-Willenbrock beschloss, die Verfolgung aufzunehmen und den Konvoi anzugreifen.“"
                                            },
                                            {
                                                "example_id": "828b2972-4a69-429e-9cc9-7653dfc1bcc5",
                                                "sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
                                                "text": "„Das feste Land müßte bei etwa zehn Seemeilen Küstenabstand in Sicht kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3cd2457-2c96-45b7-a589-63776ca2b4c7",
                        "source_entry_id": "98328e90-ab83-346e-8037-2c5feb461511",
                        "source_sense_id": "d06852ba-6dbf-3fb9-8709-fc4128a0a1e8",
                        "source_sense_description": "afstandsmaat, in gebruik op zee, 1852m",
                        "target_lang_word": "nautical mile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nautical mile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b168166-7dd7-36c1-8bc4-72e09e6dd6dd",
                                        "entry_id": "c8f118ba-65f8-314e-bb7d-46d4c7e938fb",
                                        "glosses": [
                                            "A unit of length corresponding approximately to one minute of arc of latitude along any meridian. By international agreement it is exactly 1,852 metres (approximately 6,076 feet or 1.151 statute mile)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6649c446-c2c4-4482-ad6a-8dcb1a48f8b5",
                                                "sense_id": "0b168166-7dd7-36c1-8bc4-72e09e6dd6dd",
                                                "text": "Near-synonym: geographical mile (very close to the same distance)"
                                            },
                                            {
                                                "example_id": "9d006622-13bf-4887-81f5-38b4c848a181",
                                                "sense_id": "0b168166-7dd7-36c1-8bc4-72e09e6dd6dd",
                                                "text": "Personnel trenches have been constructed or improved in Tantung (40-05-50N 124-21-30E) and along roads 13 nautical miles (nm) south-southwest of Tantung and 1.5 nm west of the border (Figures 2 and 3)."
                                            },
                                            {
                                                "example_id": "a533fa59-8645-4b1f-ba77-07ef3107d8bb",
                                                "sense_id": "0b168166-7dd7-36c1-8bc4-72e09e6dd6dd",
                                                "text": "An even more impressive nineteenth-century militarized lighthouse is found on the Taiwanese Wuchiu island, located just 20 nautical miles off the Chinese coast. While much of the surrounding military structure has been demolished, its black tower and high walls painted in camouflage colours stand as reminders of the contested history of this small frontier island."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "868b15ac-2626-3799-a3af-9df06ca28e26",
                                        "entry_id": "c8f118ba-65f8-314e-bb7d-46d4c7e938fb",
                                        "glosses": [
                                            "Synonym of sea mile, a historical Scandinavian unit of distance equal to about 4 nmi."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0c94c0e-bdf1-47f7-b20d-d7e67a6dd22a",
                        "source_entry_id": "98328e90-ab83-346e-8037-2c5feb461511",
                        "source_sense_id": "d06852ba-6dbf-3fb9-8709-fc4128a0a1e8",
                        "source_sense_description": "afstandsmaat, in gebruik op zee, 1852m",
                        "target_lang_word": "mille marin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mille marin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd3e97dd-3d8c-354a-ab2b-004d4aba0d43",
                                        "entry_id": "913a830f-e054-3418-8cce-629cf254b57f",
                                        "glosses": [
                                            "Unité de mesure de longueur (symbole M ou NM) ayant la valeur d’une minute de latitude à la surface de la Terre, maintenant définie comme 1,852 mètres exactement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "814e5d79-d83f-4040-8543-4b5aabf4126f",
                                                "sense_id": "bd3e97dd-3d8c-354a-ab2b-004d4aba0d43",
                                                "text": "Son souffle à peine perceptible soulevait délicatement les draps. Mais c’était assez pour rassurer un homme haletant, à 7.000 milles marins de sa patrie, les pieds nus sur un lourd tapis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
