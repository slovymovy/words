                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0729ffaf-b900-4d5c-9bfd-a2f170a6f397",
                                "sense_id": "66fb3683-3f45-3486-8126-1d85e4a12d1c",
                                "text": "Peters schoot nog hoog over het doel van de gasten na een dieptebal van Cuco Martina. Bij rust stond het 0-0."
                            },
                            {
                                "example_id": "6bcaea38-01c9-4855-9ea7-12bed66168f9",
                                "sense_id": "66fb3683-3f45-3486-8126-1d85e4a12d1c",
                                "text": "'Mijn assistent riep dat het toch een overtreding was. De dieptebal kon ik niet bijhouden. Dan blijkt waarschijnlijk toch dat je te oud wordt', grapte Bossen, die bezig is aan zijn laatste seizoen als scheidsrechter in het betaalde voetbal. 'Als de assistent het roept weet je direct dat het rood waard is, want hij voorkomt scoringskans', aldus Bossen."
                            }
                        ]
                    }
