                "senses": [
                    {
                        "sense_id": "b07e9657-dff2-3523-86e5-590affab1a18",
                        "entry_id": "3f769309-70bb-3131-9603-12c73ebb33d0",
                        "glosses": [
                            "ботан. однолетнее травянистое растение семейства зонтичных, употребляемое как пряность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd6b4ca-c8e0-4fab-ab5d-f468109d0e9b",
                                "sense_id": "b07e9657-dff2-3523-86e5-590affab1a18",
                                "text": "На всем Кавказе не садятся за стол без вороха свежей нежной зелени: в Армении любят кинзу, в Грузии — реган, но повсеместно не обходят вниманием ни одну травку."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b5ce15b-4509-30d3-8923-c4f4e1514dc4",
                        "entry_id": "3f769309-70bb-3131-9603-12c73ebb33d0",
                        "glosses": [
                            "кулин. высушенные семена такого растения; кориандр"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd9433bd-8d1d-408a-a923-70243a78f118",
                        "source_entry_id": "3f769309-70bb-3131-9603-12c73ebb33d0",
                        "target_lang_word": "coriander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coriander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf93b081-3565-327e-80b6-19c23197fa32",
                                        "entry_id": "ac70c12f-fe17-3e57-bb6c-532febf6c626",
                                        "glosses": [
                                            "The annual herb Coriandrum sativum, used in many cuisines."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6025a5ea-6120-4c7d-94a7-bb6de6eceb44",
                                                "sense_id": "cf93b081-3565-327e-80b6-19c23197fa32",
                                                "text": "The life of one plant would be affected by another. Rue was definitely hostile to basil, rosemary to hyssop, but coriander, dill and chervil lived on the friendliest of terms[.]"
                                            },
                                            {
                                                "example_id": "f5b9f2af-3370-44a1-8ba6-210ea9c9c330",
                                                "sense_id": "cf93b081-3565-327e-80b6-19c23197fa32",
                                                "text": "Tobacco and the plant valerian are also considered to be anaphrodisiac in their effects, diminishing sexual inclination. Also vinegar, dried coriander, potassium bromide, cocaine, vervain, acid drinks, lemonade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fba17a3f-d75d-3679-9230-f2b4768f2342",
                                        "entry_id": "ac70c12f-fe17-3e57-bb6c-532febf6c626",
                                        "glosses": [
                                            "The dried fruits thereof, used as a spice."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
