                    {
                        "sense_id": "6920b83e-5975-3d6c-bbd3-370feaf22142",
                        "entry_id": "9d50213d-decc-394e-a3f5-0a1c705ecffc",
                        "glosses": [
                            "gebouw waarin muziekoptredens kunnen plaatsvinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3acc5e2e-c75c-4ae3-a4ef-c24b1340e998",
                                "sense_id": "6920b83e-5975-3d6c-bbd3-370feaf22142",
                                "text": "Utrecht werkt al jaren aan de vernieuwing van het stationsgebied. Het project omvat onder meer de uitbreiding van winkelcentrum Hoog Catharijne en de renovatie van het Jaarbeursplein. Ook werd er een nieuw muziekpaleis gebouwd en is de stationshal vernieuwd. Die laatste wordt morgen grotendeels weer geopend."
                            },
                            {
                                "example_id": "6bc0cc1a-7615-44e8-85e5-e10b8e0f0b26",
                                "sense_id": "6920b83e-5975-3d6c-bbd3-370feaf22142",
                                "text": "De rekenkamer verwijt de gemeente onvoldoende regie te hebben gehouden bij de totstandkoming van het Muziekpaleis. Pas bij de oplevering van het gebouw werd de huidige stichting TivoliVredenburg actief. De voorbereiding van de nieuwe organisatie liep volledig vast door ruzies. Daardoor was de stichting nauwelijks voorbereid toen het gebouw in gebruik werd genomen."
                            }
                        ]
                    }
