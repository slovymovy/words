    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2d732524-093c-30f5-b504-4dd42dc516e7",
                "word": "skinhead",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "480a1b5f-1e72-45fd-8c96-e23dcd486de9",
                        "entry_id": "2d732524-093c-30f5-b504-4dd42dc516e7",
                        "tags": [
                            "plural"
                        ],
                        "form": "skinheads"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "883e6261-a7d1-3c79-a0d4-cc3fd467a6b5",
                        "entry_id": "2d732524-093c-30f5-b504-4dd42dc516e7",
                        "glosses": [
                            "Someone with a shaved head."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "634a3f26-6fee-3c55-ab3b-052d8e8da687",
                        "entry_id": "2d732524-093c-30f5-b504-4dd42dc516e7",
                        "glosses": [
                            "A member of a subculture that arose among working-class youth in late 1960s England or its diaspora, defined by close-cropped or shaven heads and working-class clothing, and often associated with violence and white-supremacist or anti-immigrant principles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f9fa0c8-3854-475c-91e7-0f478f2428ec",
                                "sense_id": "634a3f26-6fee-3c55-ab3b-052d8e8da687",
                                "text": "Their rules haven't changed: Skinheads are very young, mostly between the ages of 13 and 18, and they come from strictly working class backgrounds. They wear short‐ankled denims, T‐shirts, suspenders and heavy boots known as Bovverboots (Botherboots), and their hair is shorn to an eighth of an inch all over their skulls. They dance the Reggae, a West Indian shuffle, and they drink Coca Cola and they whip up riots at soccer games."
                            },
                            {
                                "example_id": "02ab4b14-3b30-49c4-bfb7-684f63a4e41a",
                                "sense_id": "634a3f26-6fee-3c55-ab3b-052d8e8da687",
                                "text": "By the end of the show, fights would break out all over the place: the Atlantic City skins against the crew from Philly; the oldschool skinheads feuding with overzealous fresh-cuts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7a8d802-11d4-4a2c-af46-4d9e1539a18e",
                        "source_entry_id": "2d732524-093c-30f5-b504-4dd42dc516e7",
                        "source_sense_description": "member of subculture",
                        "target_lang_word": "skinhead",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skinhead",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "afa95aa5-c943-3762-8bf1-4dea38c0c8fb",
                                        "entry_id": "3261318c-2665-3ed3-bb3c-6c8f60983a89",
                                        "glosses": [
                                            "Personne appartenant à un mouvement dont les codes sont l’idéologie de la race blanche, le racisme et l’homophobie, organisation affiliée au Ku Klux Klan, les codes vestimentaires sont d'avoir le crâne rasé, de porter des bottes et qui prône l’agressivité."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ae4426-4405-4ef5-8396-42cee3147ce2",
                                                "sense_id": "afa95aa5-c943-3762-8bf1-4dea38c0c8fb",
                                                "text": "Témoin clé au procès de trois skinheads jugés pour la mort de l’antifasciste Clément Méric, Serge Ayoub, figure tutélaire de la jeunesse d’ultra-droite, a fait savoir hier à la cour d’assises qu’il ne serait pas présent."
                                            },
                                            {
                                                "example_id": "efc1c15e-e224-470b-8f12-5d727cf96340",
                                                "sense_id": "afa95aa5-c943-3762-8bf1-4dea38c0c8fb",
                                                "text": "Fondé en 1987 aux États-Unis, SHARP (Skinheads Against Racial Prejudice ou Skinheads contre les préjugés raciaux) désigne un mouvement de skinheads dits « traditionnels » (tradskins) qui se positionnent radicalement contre le racisme, contre les néo-fascistes et autres groupes d'extrême droite, plus particulièrement si ceux-ci se proclament eux aussi skinheads"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2524675a-6636-4cbf-a2ef-a7d3a379a66c",
                        "source_entry_id": "2d732524-093c-30f5-b504-4dd42dc516e7",
