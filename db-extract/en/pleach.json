                        "source_sense_description": "to unite by interweaving",
                        "target_lang_word": "сплета́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сплета́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "62f341b4-35c5-33c5-86d9-1f8e548181f5",
                                        "entry_id": "70081c4a-9fd1-3b7c-b279-9212f72a912b",
                                        "glosses": [
                                            "изготовлять плетением"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e681ba5-ed5a-4477-acf9-e93d7b5d3726",
                                                "sense_id": "62f341b4-35c5-33c5-86d9-1f8e548181f5",
                                                "text": "Сейчас кончают сплетать стальной канат, на котором повиснет мост."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfe3c4f1-bb86-30a9-b3a8-f9c9375f46ff",
                                        "entry_id": "70081c4a-9fd1-3b7c-b279-9212f72a912b",
                                        "glosses": [
                                            "соединять, скреплять плетением"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d7b6438-1403-3b43-ae83-a34b277cc2b3",
                                        "entry_id": "70081c4a-9fd1-3b7c-b279-9212f72a912b",
                                        "glosses": [
                                            "перен. тесно связывать, соединять, сочетать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "695fd283-7df9-483b-9c96-6f29baf1e4b3",
                                                "sense_id": "4d7b6438-1403-3b43-ae83-a34b277cc2b3",
                                                "text": "Деревья с огромными чёрными стволами сплетали над нашими головами ветки, закрывая солнце."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6da9fb9-23cf-3023-9a5a-83763209cc5d",
                                        "entry_id": "70081c4a-9fd1-3b7c-b279-9212f72a912b",
                                        "glosses": [
                                            "перен., разг. сочинять, выдумывать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "192f1a98-77c4-4232-987f-1c4425110530",
                                                "sense_id": "e6da9fb9-23cf-3023-9a5a-83763209cc5d",
                                                "text": "Но Виктор не вынес такого огромного безмолвия в просто времени первых людей, он вынырнул обратно и стал сплетать сказки сам."
                                            },
                                            {
                                                "example_id": "b16963f8-740d-4836-a85e-62d3c8309e88",
                                                "sense_id": "e6da9fb9-23cf-3023-9a5a-83763209cc5d",
                                                "text": "Как смеешь ты передо мною сплетать такую ложь?"
                                            },
                                            {
                                                "example_id": "e6d80cf0-05ab-4212-8683-4fcfb5475840",
                                                "sense_id": "e6da9fb9-23cf-3023-9a5a-83763209cc5d",
                                                "text": "Тут бы начать фантазировать, достраивать историю до романа, сплетать сюжетные линии; не стану."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
