                ],
                "translations": [
                    {
                        "translation_id": "3b1c80f4-0b29-444a-b132-4acc438beb37",
                        "source_entry_id": "90350fc5-7040-3043-91d7-ff87ec3748da",
                        "source_sense_id": "727ecde4-58b4-3cd2-8108-6becce39519a",
                        "target_lang_word": "collector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f67c9ca0-3686-3e7c-b9ef-0a0ad516e133",
                                        "entry_id": "89674fca-284a-38d1-92e9-ee07bc695211",
                                        "glosses": [
                                            "A person who or thing that collects, or which creates or manages a collection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62e92e9-b539-42bc-8fb4-1195c6d44525",
                                                "sense_id": "f67c9ca0-3686-3e7c-b9ef-0a0ad516e133",
                                                "text": "She is an avid collector of nineteenth-century postage stamps."
                                            },
                                            {
                                                "example_id": "948c303c-cdfd-408e-a5ad-d06167897207",
                                                "sense_id": "f67c9ca0-3686-3e7c-b9ef-0a0ad516e133",
                                                "text": "That old piano is just a big dust collector."
                                            },
                                            {
                                                "example_id": "12bbb4b3-da20-47e5-9074-f4def55054da",
                                                "sense_id": "f67c9ca0-3686-3e7c-b9ef-0a0ad516e133",
                                                "text": "The Young Collector's Handbook. By E. C. R. Hadfield and C. Hamilton Ellis. London: Oxford University Press, Amen House, E.C.4. 7½ in. × 5 in. × 1 in. 78 pp. Illustrated. Price 4s. 6d. net.—Most persons are collectors at some periods of their lives. Some outgrow the habit; with others it becomes a mania; and with still others it is a lasting habit intelligently planned as one aspect of a study of a particular subject."
                                            },
                                            {
                                                "example_id": "6ed94108-e9a5-48ce-831e-ddefb191be00",
                                                "sense_id": "f67c9ca0-3686-3e7c-b9ef-0a0ad516e133",
                                                "text": "Hungry for fame and the approval of rare-animal collector Queen Victoria (Imelda Staunton), Darwin deceives the Captain and his crew into believing they can get enough booty to win the pirate competition by entering Polly in a science fair. So the pirates journey to London in cheerful, blinkered defiance of the Queen, a hotheaded schemer whose royal crest reads simply “I hate pirates.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c40bfba-7777-3fe3-8f40-0310791417b6",
                                        "entry_id": "89674fca-284a-38d1-92e9-ee07bc695211",
                                        "glosses": [
                                            "A person who is employed to collect payments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc3c5ecc-ce24-447c-b7a0-672d9b12da7d",
                                                "sense_id": "7c40bfba-7777-3fe3-8f40-0310791417b6",
                                                "text": "She works for the government as a tax collector."
                                            },
                                            {
                                                "example_id": "c8278db6-a601-440f-a1d5-f0364dc66b5d",
                                                "sense_id": "7c40bfba-7777-3fe3-8f40-0310791417b6",
                                                "text": "Andrew Houſtoun and Adam Muſhet, being Tackſmen of the Excize, did Imploy Thomas Rue to be their Collector, and gave him a Sallary of 30. pound Sterling for a year."
                                            },
                                            {
                                                "example_id": "300a2cda-88be-4190-a544-9d4ddc2bb1e7",
                                                "sense_id": "7c40bfba-7777-3fe3-8f40-0310791417b6",
                                                "text": "I should've left my phone at home 'cause this is a disaster / Callin' like a collector / Sorry, I cannot answer"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0305f661-8c20-354f-b5cd-1b951eaf992b",
                                        "entry_id": "89674fca-284a-38d1-92e9-ee07bc695211",
                                        "glosses": [
                                            "A person who is employed to collect payments.",
                                            "A mafioso whose task is to collect protection money from small businesses"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f821e478-93ba-32a2-8f85-9272a9d87bf6",
                                        "entry_id": "89674fca-284a-38d1-92e9-ee07bc695211",
                                        "glosses": [
                                            "The amplified terminal on a bipolar junction transistor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8970257b-5aab-383e-b8b5-10f1ecdbd621",
                                        "entry_id": "89674fca-284a-38d1-92e9-ee07bc695211",
                                        "glosses": [
                                            "A compiler of books; one who collects scattered passages and puts them together in one book."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c6dc05d-7b8a-494b-8672-d96e83b27988",
                                                "sense_id": "8970257b-5aab-383e-b8b5-10f1ecdbd621",
                                                "text": "Volumes[…] without any of tthe collector's own reflections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ca152c8-940d-3596-bae4-865244ac9c64",
                                        "entry_id": "89674fca-284a-38d1-92e9-ee07bc695211",
                                        "glosses": [
                                            "One holding a Bachelor of Arts in Oxford, formerly appointed to superintend some scholastic proceedings in Lent."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1441acc9-74c0-482c-a437-98600994f0af",
                                                "sense_id": "4ca152c8-940d-3596-bae4-865244ac9c64",
                                                "text": "Whereupon he soon after appointed A. W. his collector in Austins; which office he kept till he was admitted Mr. of arts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce8824a3-05e4-3c92-91d7-311d01070dc3",
                                        "entry_id": "89674fca-284a-38d1-92e9-ee07bc695211",
                                        "glosses": [
                                            "A major sewer which collects sewerage from a number of smaller branch sewers"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d81fbf79-3c80-4254-8fd7-3963657e4079",
                        "source_entry_id": "90350fc5-7040-3043-91d7-ff87ec3748da",
                        "source_sense_id": "727ecde4-58b4-3cd2-8108-6becce39519a",
                        "target_lang_word": "collectionneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collectionneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89f0ff8c-01c3-3f8e-86c9-c2ec6d8c04af",
                                        "entry_id": "17672a0f-4f7b-3a41-a9ed-5ce137b164c5",
                                        "glosses": [
                                            "Qui aime collectionner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dcd966d-37c0-4975-9525-7be92e5ff66f",
                                                "sense_id": "89f0ff8c-01c3-3f8e-86c9-c2ec6d8c04af",
                                                "text": "Fatigué des femmes — non de la sienne — Renaud a quitté cette fièvre collectionneuse, cette anxiété de philatéliste qui le jetait au-devant d’une femme nouvelle : « Ah ! un exemplaire qui me manquait !… »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "collectionneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                        "entry_id": "c8217f0b-f0f6-36d2-80e4-b7272fa88ff4",
                                        "glosses": [
                                            "Personne qui collectionne quelque chose ; celui qui fait des collections."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "729adadf-5791-43bd-ac00-8cd9a67e5db1",
                                                "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                                "text": "Les journaux et les magazines qui alimentaient les cerveaux américains (car les livres, sur ce continent impatient, n’intéressaient plus que les collectionneurs) devinrent instantanément un feu d’artifice."
                                            },
                                            {
                                                "example_id": "5bfad12e-fbc3-450c-90df-c894bd84363e",
                                                "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                                "text": "J’aime la nature telle que les dieux l’on faite, et j’aime tant à la voir que je ne trouve pas le temps de la regarder par les yeux des autres, comme font les collectionneurs de tableaux."
                                            },
                                            {
                                                "example_id": "562140df-c2e0-490a-8d28-a0c22a7c52f1",
                                                "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                                "text": "— Il publia, en 1706, un recueil, Cent Vues de Venise, aux planches incisées avec une maestria qui lui fait le plus grand honneur et lui assure, aujourd'hui encore, l'admiration des iconophiles collectionneurs."
                                            },
                                            {
                                                "example_id": "80df6bb0-8fba-4a74-8518-61b8aa6354e3",
                                                "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                                "text": "Un cartophile est un collectionneur de cartes postales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d40d1930-2d0c-4559-b946-efb940612f63",
                        "source_entry_id": "90350fc5-7040-3043-91d7-ff87ec3748da",
