{
    "word_family": [
        "adventure",
        "adventurer",
        "adventurous",
        "venturesome"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7d76cf40-1c42-3710-9ec1-c77ed3089f29",
                    "sense_definition": "A new activity, project, or business that involves risk or uncertainty.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "business_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two companies agreed to form a joint <w>venture</w> to expand their sales in Asia.",
                            "target_lang_translations": {
                                "ru": "Две компании договорились создать совместное <w>предприятие</w> для расширения продаж в Азии.",
                                "zh": "两家公司同意成立一家合资<w>企业</w>，以扩大它们在亚洲的销售。"
                            }
                        },
                        {
                            "text": "Starting a new business <w>venture</w> requires a lot of planning and capital.",
                            "target_lang_translations": {
                                "ru": "Запуск нового коммерческого <w>предприятия</w> требует тщательного планирования и капитала.",
                                "zh": "开启一项新的商业<w>冒险</w>需要大量的规划和资金。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enterprise",
                        "undertaking",
                        "endeavor"
                    ],
                    "common_phrases": [
                        "joint venture",
                        "business venture",
                        "new venture",
                        "risky venture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новое дело, проект или бизнес, связанные с риском или неопределенностью.",
                        "zh": "一项涉及风险或不确定性的新活动、项目或商业行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предприятие",
                                "target_lang_sense_clarification": "бизнес или проект"
                            },
                            {
                                "target_lang_word": "рискованное начинание",
                                "target_lang_sense_clarification": "дело с неопределенным исходом"
                            },
                            {
                                "target_lang_word": "авантюра",
                                "target_lang_sense_clarification": "рискованное дело"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "企业",
                                "target_lang_sense_clarification": "商业项目或公司"
                            },
                            {
                                "target_lang_word": "冒险",
                                "target_lang_sense_clarification": "具有不确定性的尝试"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e3db051-0e96-344e-9da3-da28c2dbe282",
                    "sense_definition": "To go somewhere that is unknown, dangerous, or unpleasant.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers prepared to <w>venture</w> into the dense and uncharted jungle.",
                            "target_lang_translations": {
                                "ru": "Исследователи готовились <w>отважиться</w> войти в густые и неизведанные джунгли.",
                                "zh": "探险家们准备<w>冒险前往</w>那片茂密且未被勘测过的丛林。"
                            }
                        },
                        {
                            "text": "Because of the heavy snow, we did not <w>venture</w> out of the house all day.",
                            "target_lang_translations": {
                                "ru": "Из-за сильного снегопада мы весь день не <w>отваживались выйти</w> из дома.",
                                "zh": "因为大雪，我们整天都没<w>敢</w>出门。"
                            }
                        }
                    ],
                    "synonyms": [
                        "journey",
                        "fare",
                        "trip"
                    ],
                    "common_phrases": [
                        "venture into",
                        "venture out",
                        "venture forth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправиться в неизвестное, опасное или неприятное место.",
                        "zh": "前往未知、危险或令人不快的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отваживаться",
                                "target_lang_sense_clarification": "пойти куда-либо"
                            },
                            {
                                "target_lang_word": "рисковать",
                                "target_lang_sense_clarification": "отправиться куда-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冒险前往",
                                "target_lang_sense_clarification": "进入危险或未知区域"
                            },
                            {
                                "target_lang_word": "敢于",
                                "target_lang_sense_clarification": "有勇气去某处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e0db767-2ea6-3041-a307-01c0a81f06dd",
                    "sense_definition": "To say or do something that involves risk or uncertainty, especially when offering an opinion or guess.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication_risk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like to <w>venture</w> a guess about why the system failed.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы <w>рискнуть предположить</w>, почему система вышла из строя.",
                                "zh": "我想<w>试着</w>猜测一下系统故障的原因。"
                            }
                        },
                        {
                            "text": "She hesitated to <w>venture</w> an opinion during the meeting for fear of being wrong.",
                            "target_lang_translations": {
                                "ru": "Она не решалась <w>высказать</w> свое мнение во время встречи, боясь ошибиться.",
                                "zh": "她担心出错，在会议期间不敢<w>大胆提出</w>自己的意见。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chance",
                        "stake",
                        "possibility"
                    ],
                    "common_phrases": [
                        "venture a guess",
                        "venture an opinion",
                        "nothing ventured nothing gained"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сказать или сделать что-то рискованное, особенно высказывая мнение или догадку.",
                        "zh": "说出或做出涉及风险或不确定性的事，尤指提出观点或猜测。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осмеливаться",
                                "target_lang_sense_clarification": "высказать что-либо"
                            },
                            {
                                "target_lang_word": "рисковать",
                                "target_lang_sense_clarification": "сделать или сказать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大胆提出",
                                "target_lang_sense_clarification": "冒着风险表达观点"
                            },
                            {
                                "target_lang_word": "试着",
                                "target_lang_sense_clarification": "尝试性地表达猜测"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}