                "senses": [
                    {
                        "sense_id": "4715ce26-9f9e-3e6f-b727-f225ae76f52a",
                        "entry_id": "53c1cf3b-b28a-31f9-8b36-94f7df2b94a6",
                        "glosses": [
                            "Additionner de fluor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77553185-d476-45c8-ae80-e5fd68b425db",
                                "sense_id": "4715ce26-9f9e-3e6f-b727-f225ae76f52a",
                                "text": "Pourquoi fluoriser l'eau?"
                            },
                            {
                                "example_id": "7c4409b2-7e9d-4155-be1b-6aa11510af02",
                                "sense_id": "4715ce26-9f9e-3e6f-b727-f225ae76f52a",
                                "text": "S’il n’est vraiment pas possible de fluoriser l’eau de distribution pour quelque raison que ce soit, il est toujours loisible d’ajouter du fluor à l’eau courante des écoles, en corrigeant la concentration en fonction du temps passé en classe par rapport au temps vécu à domicile."
                            },
                            {
                                "example_id": "cf60b4ac-60ed-4fba-a22c-a59b2ef7d753",
                                "sense_id": "4715ce26-9f9e-3e6f-b727-f225ae76f52a",
                                "text": "Vous êtes de ceux qui croient aux bienfaits de fluoriser l'eau potable pour combattre la carie dentaire chez les enfants ?"
                            }
                        ]
                    }
                ],
