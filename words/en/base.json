    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "200d54bf-f1cd-33c3-9795-9c65e0b5facf",
                    "sense_definition": "A supporting, lower or bottom component of a structure or object.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "foundation_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lamp has a heavy wooden <w>base</w> to keep it stable.",
                            "target_lang_translations": {
                                "ru": "У лампы тяжелое деревянное <w>основание</w> для устойчивости.",
                                "tr": "Lambanın devrilmesini önlemek için ağır bir ahşap <w>kaidesi</w> var.",
                                "zh": "这盏灯有一个沉重的木制<w>底座</w>以保持稳定。"
                            }
                        },
                        {
                            "text": "We sat at the <w>base</w> of the cliff and watched the waves.",
                            "target_lang_translations": {
                                "ru": "Мы сидели у <w>подножия</w> утеса и смотрели на волны.",
                                "tr": "Uçurumun <w>eteğinde</w> oturup dalgaları izledik.",
                                "zh": "我们坐在悬崖<w>脚下</w>看着海浪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bottom",
                        "foot"
                    ],
                    "antonyms": [
                        "superstructure",
                        "apex"
                    ],
                    "common_phrases": [
                        "at the base of",
                        "base of the pyramid",
                        "concrete base"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опорная, нижняя часть конструкции или объекта.",
                        "tr": "Bir yapının veya nesnenin tabanını oluşturan, en alt veya destekleyici parça.",
                        "zh": "结构或物体的支撑部分、底部或下部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основание",
                                "target_lang_sense_clarification": "общая часть предмета"
                            },
                            {
                                "target_lang_word": "база",
                                "target_lang_sense_clarification": "архитектура, колонны"
                            },
                            {
                                "target_lang_word": "подножие",
                                "target_lang_sense_clarification": "горы, скалы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "taban",
                                "target_lang_sense_clarification": "nesnenin veya yapının altı"
                            },
                            {
                                "target_lang_word": "kaide",
                                "target_lang_sense_clarification": "sütun veya lamba gibi şeylerin altlığı"
                            },
                            {
                                "target_lang_word": "подножие",
                                "target_lang_sense_clarification": "etek, etek kısmı (dağ/kayalık için)"
                            },
                            {
                                "target_lang_word": "etek",
                                "target_lang_sense_clarification": "dağ veya kayalıkların alt kısmı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "底座",
                                "target_lang_sense_clarification": "物体的支撑部分"
                            },
                            {
                                "target_lang_word": "底部",
                                "target_lang_sense_clarification": "物体的最下端"
                            },
                            {
                                "target_lang_word": "山脚",
                                "target_lang_sense_clarification": "山或悬崖的底部"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a79bd283-50b9-362d-91f6-0bc27694b3a4",
                    "sense_definition": "A site, structure, or both, usually durable and often permanent, for housing military personnel and materiel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "location_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers returned to the <w>base</w> after their patrol.",
                            "target_lang_translations": {
                                "ru": "Солдаты вернулись на <w>базу</w> после патрулирования.",
                                "tr": "Askerler devriyeden sonra <w>üsse</w> döndü.",
                                "zh": "士兵们巡逻后回到了<w>基地</w>。"
                            }
                        },
                        {
                            "text": "Access to the air <w>base</w> is restricted to authorized personnel.",
                            "target_lang_translations": {
                                "ru": "Доступ на авиа<w>базу</w> разрешен только уполномоченному персоналу.",
                                "tr": "Hava <w>üssüne</w> giriş yalnızca yetkili personelle sınırlandırılmıştır.",
                                "zh": "只有获得授权的人员才能进入空军<w>基地</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "military base",
                        "air base",
                        "naval base",
                        "army base"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место или сооружение для размещения военных сил и техники.",
                        "tr": "Askeri personeli ve teçhizatı barındırmak için kullanılan dayanıklı ve genellikle kalıcı tesis veya bölge.",
                        "zh": "用于驻扎军事人员和存放物资的场所或设施。"
                    },
                    "translations": {
