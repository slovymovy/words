                "senses": [
                    {
                        "sense_id": "3ebd10cc-f596-3735-bf53-2e4d982e49a4",
                        "entry_id": "67e2ef15-d0b0-3c74-847d-8851f1d212af",
                        "glosses": [
                            "dak van een auto met een raam dat zonlicht kan doorlaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "702d00dd-0d3f-4511-9812-527d19777eb8",
                                "sense_id": "3ebd10cc-f596-3735-bf53-2e4d982e49a4",
                                "text": "De politie zegt in het bijzonder op zoek te zijn naar informatie over een witte Volkswagen Polo met zwart zonnedak, een donkergrijze Kia Rio en een blauwe Volkswagen. In ‘Bureau Rijnmond’, het opsporingsprogramma van Openbaar Ministerie en politie, wordt donderdag aandacht gevraagd voor de zaak."
                            }
                        ]
                    },
                    {
                        "sense_id": "40ee5b64-a596-3e64-aff7-e0feb1d501e5",
                        "entry_id": "67e2ef15-d0b0-3c74-847d-8851f1d212af",
                        "glosses": [
                            "een scherm dat gespannen is boven een bepaalde ruimte ter bescherming tegen de zon"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "08e7d504-d446-3352-be9c-7dbbaf454d18",
                        "entry_id": "67e2ef15-d0b0-3c74-847d-8851f1d212af",
                        "glosses": [
                            "een dak met zonnepanelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da56f9c7-4126-425c-8df2-3f9cb187ccb0",
                                "sense_id": "08e7d504-d446-3352-be9c-7dbbaf454d18",
                                "text": "Op 1 augustus daalt de overheidssteun voor zonnepanelen van 210 naar 90 euro. Eigenaars van een zonnedak verdienen voor elke 1.000 kilowattuur groene stroom die ze opwekken een groenestroomcertificaat, wat vanaf 1 augustus recht geeft op een bedrag van 90 euro."
                            },
                            {
                                "example_id": "94d25ca5-55e5-4f0b-a317-27a312e4b947",
                                "sense_id": "08e7d504-d446-3352-be9c-7dbbaf454d18",
                                "text": "Energiecoöperatie Enschede Energie kan zeven nieuwe 'zonnedaken' aanleggen. De coöperatie 'van, voor en door Enschedeërs' kreeg vrijdag de daarvoor aangevraagde subsidie van het rijk. Om hoeveel geld het precies gaat, is nog niet bekend."
                            }
                        ]
                    }
