{
    "word_family": [
        "blameless",
        "blameworthy",
        "blamable",
        "blameful"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd38b496-84f5-3e4c-88fc-a57dcfa8ea9e",
                    "sense_definition": "To say or think that someone is responsible for something bad happening.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "assign_responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver was <w>blamed</w> for the accident because he was texting.",
                            "target_lang_translations": {
                                "ru": "Водителя <w>обвинили</w> в аварии, так как он писал сообщение за рулем.",
                                "tr": "Sürücü mesajlaştığı için kazadan <w>sorumlu tutuldu</w>."
                            }
                        },
                        {
                            "text": "I do not <w>blame</w> you for being angry about the delay.",
                            "target_lang_translations": {
                                "ru": "Я не <w>виню</w> тебя за то, что ты злишься из-за задержки.",
                                "tr": "Gecikmeye kızdığın için seni <w>suçlamıyorum</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hold someone responsible",
                        "hold someone accountable",
                        "accuse",
                        "reproach"
                    ],
                    "antonyms": [
                        "absolve"
                    ],
                    "common_phrases": [
                        "blame for",
                        "to blame",
                        "not blame someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Считать или говорить, что кто-то несет ответственность за что-то плохое.",
                        "tr": "Birinin kötü bir şeyden sorumlu olduğunu söylemek veya düşünmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "винить",
                                "target_lang_sense_clarification": "считать виноватым"
                            },
                            {
                                "target_lang_word": "обвинять",
                                "target_lang_sense_clarification": "возлагать вину"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "suçlamak",
                                "target_lang_sense_clarification": "birini bir şeyle itham etmek"
                            },
                            {
                                "target_lang_word": "sorumlu tutmak",
                                "target_lang_sense_clarification": "birini bir olayın nedeni görmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e598cff0-a639-32f2-acca-95f12f834416",
                    "sense_definition": "To say that a bad event was caused by a specific person or thing, often using the word 'on'.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assign_responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>blamed</w> the failure of the project on poor management.",
                            "target_lang_translations": {
                                "ru": "Они <w>свалили</w> провал проекта на плохое руководство.",
                                "tr": "Projenin başarısızlığını kötü yönetime <w>yüklediler</w>."
                            }
                        },
                        {
                            "text": "You cannot simply <w>blame</w> it on the weather every time you are late.",
                            "target_lang_translations": {
                                "ru": "Ты не можешь просто <w>сваливать</w> это на погоду каждый раз, когда опаздываешь.",
                                "tr": "Her geç kaldığında suçu öylece havaya <w>atamazsın</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "put the blame on"
                    ],
                    "common_phrases": [
                        "blame it on",
                        "blame on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утверждать, что причиной плохого события стал конкретный человек или вещь (часто используется с предлогом 'на').",
                        "tr": "Kötü bir olayın belirli bir kişi veya şeyden kaynaklandığını söylemek (genellikle 'on' ile kullanılır)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сваливать вину",
                                "target_lang_sense_clarification": "перекладывать ответственность"
                            },
                            {
                                "target_lang_word": "приписывать вину",
                                "target_lang_sense_clarification": "указывать как причину"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "suç atmak",
                                "target_lang_sense_clarification": "suçu başkasına veya başka bir şeye yüklemek"
                            },
                            {
                                "target_lang_word": "yüklemek",
                                "target_lang_sense_clarification": "suçu veya sorumluluğu üzerine yıkmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f6d90bb-38a7-35b3-86e1-e208f90cabf1",
                    "sense_definition": "To criticize or find fault with someone for a mistake.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "censure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics <w>blamed</w> the author for a lack of creativity in his new book.",
                            "target_lang_translations": {
                                "ru": "Критики <w>упрекали</w> автора в отсутствии креативности в его новой книге.",
                                "tr": "Eleştirmenler, yeni kitabındaki yaratıcılık eksikliği nedeniyle yazarı <w>eleştirdi</w>."
                            }
                        },
                        {
                            "text": "He spent more time praising his team than <w>blaming</w> them for errors.",
                            "target_lang_translations": {
                                "ru": "Он тратил больше времени на похвалу своей команды, чем на то, чтобы <w>винить</w> их за ошибки.",
                                "tr": "Ekibini hataları için <w>kınamak</w> yerine övmeye daha çok zaman ayırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "reproach",
                        "fault",
                        "find fault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Критиковать или находить недостатки в ком-то за ошибку.",
                        "tr": "Bir hatadan dolayı birini eleştirmek veya onda kusur bulmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упрекать",
                                "target_lang_sense_clarification": "высказывать недовольство"
                            },
                            {
                                "target_lang_word": "порицать",
                                "target_lang_sense_clarification": "критиковать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sitem etmek",
                                "target_lang_sense_clarification": "birine hatasından dolayı kırgınlığını belirtmek"
                            },
                            {
                                "target_lang_word": "kınamak",
                                "target_lang_sense_clarification": "bir davranışı veya kişiyi olumsuz eleştirmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b90ecd7f-9c16-31ed-bf9b-aaa1dc1a4119",
                    "sense_definition": "Responsibility for a mistake, accident, or something bad.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>blame</w> for the broken window lies with the children playing baseball.",
                            "target_lang_translations": {
                                "ru": "<w>Вина</w> за разбитое окно лежит на детях, игравших в бейсбол.",
                                "tr": "Kırık pencerenin <w>suçu</w> beysbol oynayan çocuklardadır."
                            }
                        },
                        {
                            "text": "She accepted the <w>blame</w> for the error even though it was not entirely her fault.",
                            "target_lang_translations": {
                                "ru": "Она взяла на себя <w>вину</w> за ошибку, хотя это была не совсем её вина.",
                                "tr": "Tamamen kendi hatası olmamasına rağmen hatanın <w>sorumluluğunu</w> kabul etti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "take the blame",
                        "put the blame on",
                        "shift the blame",
                        "bear the blame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ответственность за ошибку, несчастный случай или что-то плохое.",
                        "tr": "Bir hatanın, kazanın veya kötü bir şeyin sorumluluğu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вина",
                                "target_lang_sense_clarification": "ответственность за проступок"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "suç",
                                "target_lang_sense_clarification": "kötü bir durumun sorumluluğu"
                            },
                            {
                                "target_lang_word": "kabahat",
                                "target_lang_sense_clarification": "kusur, küçük suç"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc929a39-b026-32aa-8574-874c3a4f1ce1",
                    "sense_definition": "A feature in software development tools that shows which user wrote specific lines of source code.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use the git <w>blame</w> command to see who introduced this bug.",
                            "target_lang_translations": {
                                "ru": "Используйте команду git <w>blame</w>, чтобы узнать, кто внес этот баг.",
                                "tr": "Bu hatayı kimin eklediğini görmek için git <w>blame</w> komutunu kullanın."
                            }
                        },
                        {
                            "text": "The <w>blame</w> view helps developers understand the history of the file changes.",
                            "target_lang_translations": {
                                "ru": "Режим <w>blame</w> помогает разработчикам понять историю изменений файла.",
                                "tr": "<w>Blame</w> görünümü, geliştiricilerin dosya değişikliklerinin geçmişini anlamalarına yardımcı olur."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Функция в инструментах разработки ПО, показывающая, кто из пользователей написал конкретные строки исходного кода.",
                        "tr": "Yazılım geliştirme araçlarında hangi kullanıcının kodun belirli satırlarını yazdığını gösteren özellik."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "blame",
                                "target_lang_sense_clarification": "команда или режим просмотра (сленг)"
                            },
                            {
                                "target_lang_word": "аннотирование",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "blame",
                                "target_lang_sense_clarification": "git komutu veya görünümü"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c2b2bffe-be15-3c81-be38-4c29e253ee0c",
                    "sense_definition": "Used to emphasize a statement or express annoyance, similar to 'damn'.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was a <w>blame</w> interesting story he told us last night.",
                            "target_lang_translations": {
                                "ru": "Это была <w>чертовски</w> интересная история, которую он рассказал нам вчера вечером.",
                                "tr": "Dün gece bize anlattığı <w>kahrolası derecede</w> ilginç bir hikayeydi."
                            }
                        },
                        {
                            "text": "I do not want one of those <w>blame</w> things in my house.",
                            "target_lang_translations": {
                                "ru": "Я не хочу ни одной из этих <w>чёртовых</w> штук в моем доме.",
                                "tr": "Evimde o <w>lanet</w> şeylerden birini istemiyorum."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для усиления утверждения или выражения раздражения, похоже на 'чёртов'.",
                        "tr": "Bir ifadeyi vurgulamak veya kızgınlığı belirtmek için kullanılan sözcük (lanet, kahrolası anlamında)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёртов",
                                "target_lang_sense_clarification": "ругательство"
                            },
                            {
                                "target_lang_word": "проклятый",
                                "target_lang_sense_clarification": "выражение досады"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "lanet",
                                "target_lang_sense_clarification": "vurgulayıcı kızgınlık ifadesi"
                            },
                            {
                                "target_lang_word": "kahrolası",
                                "target_lang_sense_clarification": "kızgınlık belirten sıfat"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}