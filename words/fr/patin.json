                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "glisse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce ski est doté d'un <w>patin</w> large qui assure une excellente stabilité en poudreuse."
