                    {
                        "sense_id": "ecd956ff-158f-30a1-b101-83ad56c387f8",
                        "entry_id": "748e1144-3f93-3307-aef2-ccdc00f1634f",
                        "glosses": [
                            "Une des principales villes d’Inde, capitale du Maharashtra."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e18a6a0-cf3a-47e7-80a3-48a626517cc8",
                                "sense_id": "ecd956ff-158f-30a1-b101-83ad56c387f8",
                                "text": "Pour l'instant, seules des restrictions régionales sont imposées. La ville de Bombay, principal foyer d'explosion des cas de COVID-19 en Inde, est à nouveau sous le coup d'un couvre-feu."
                            },
                            {
                                "example_id": "a41ab2b3-bab0-457c-8289-4ac2d0234ee0",
                                "sense_id": "ecd956ff-158f-30a1-b101-83ad56c387f8",
                                "text": "Un peu partout dans le pays, les réseaux de prostitution enlèvent des milliers de gamines pour les envoyer dans le terrible quartier de Kamathirupa, à Bombay, où elles sont vendues, battues et asservies — on y trouve la plus forte concentration de maisons closes au monde."
                            }
                        ]
                    }
