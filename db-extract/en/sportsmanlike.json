                                                "sense_id": "0cac43eb-3d7d-3f7f-9857-d02b39278bda",
                                                "text": "„Grundsätzlich gilt die Namensregelung, wonach SUV ungerade Ziffern (Q1, Q3, Q5, etc.) erhalten, die geraden Zahlen dagegen den sportlicheren, eleganteren Crossover-Modellen vorbehalten bleiben.“"
                                            },
                                            {
                                                "example_id": "774cc2b9-0b00-4834-bd71-d9ba0866570b",
                                                "sense_id": "0cac43eb-3d7d-3f7f-9857-d02b39278bda",
                                                "text": "„Der Gipfelstürmer sucht das markante Unbekannte. Er hat sportliche Ambitionen.“"
                                            },
                                            {
                                                "example_id": "d8b1e462-f16a-41a9-aea7-c278346b8de5",
                                                "sense_id": "0cac43eb-3d7d-3f7f-9857-d02b39278bda",
                                                "text": "„Seine sportlichen Aktivitäten wie Extrembergsteigen und Gleitschirmfliegen legen nahe, dass er gern an seine Grenzen ging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
