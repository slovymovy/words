{
    "word_family": [
        "odpór",
        "odparcie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f8a53bb8-19d9-3b93-8c8f-ac79079b1ab8",
                    "sense_definition": "skutecznie przeciwstawić się atakowi lub naporowi",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obrona",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wojska zdołały <w>odeprzeć</w> atak wroga na granicy państwa.",
                            "target_lang_translations": {
                                "ru": "Войска сумели <w>отразить</w> атаку врага на границе государства."
                            }
                        },
                        {
                            "text": "Musimy <w>odeprzeć</w> te bezpodstawne oskarżenia, aby oczyścić nasze dobre imię.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>опровергнуть</w> эти беспочвенные обвинения, чтобы очистить наше доброе имя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odeprzeć atak",
                        "odeprzeć zarzuty"
                    ],
                    "target_lang_definitions": {
                        "ru": "успешно противостоять нападению или натиску"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отразить",
                                "target_lang_sense_clarification": "в контексте военных действий или физического натиска"
                            },
                            {
                                "target_lang_word": "отбить",
                                "target_lang_sense_clarification": "в контексте отражения атаки или нападения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b56b2fc-5a5d-31e8-bdb0-004836d6e20e",
                    "sense_definition": "odpowiedzieć komuś krótko lub stanowczo",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "komunikacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie mam czasu na głupoty – <w>odparł</w> szorstko, nie patrząc na rozmówcę.",
                            "target_lang_translations": {
                                "ru": "У меня нет времени на глупости, — <w>ответил</w> он грубо, не глядя на собеседника."
                            }
                        },
                        {
                            "text": "To nie twoja sprawa – <w>odparła</w> krótko, zamykając za sobą drzwi.",
                            "target_lang_translations": {
                                "ru": "Это не твое дело, — <w>отрезала</w> она коротко, закрывая за собой дверь."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ответить кому-либо кратко или решительно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ответить",
                                "target_lang_sense_clarification": "в значении дать ответ в диалоге"
                            },
                            {
                                "target_lang_word": "отрезать",
                                "target_lang_sense_clarification": "в значении ответить резко и категорично"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a8cbd23-57ee-3d08-9f52-6cf6aa54f94d",
                    "sense_definition": "wykazać fałszywość twierdzenia lub zarzutu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obrona",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prawnik z łatwością <w>odparł</w> wszystkie argumenty oskarżyciela.",
                            "target_lang_translations": {
                                "ru": "Адвокат с легкостью <w>опроверг</w> все аргументы обвинителя."
                            }
                        },
                        {
                            "text": "Trudno było <w>odeprzeć</w> dowody przedstawione przez komisję śledczą.",
                            "target_lang_translations": {
                                "ru": "Было трудно <w>опровергнуть</w> доказательства, представленные следственной комиссией."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odeprzeć argumenty"
                    ],
                    "target_lang_definitions": {
                        "ru": "доказать ложность утверждения или обвинения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опровергнуть",
                                "target_lang_sense_clarification": "в значении доказать несостоятельность аргументов"
                            },
                            {
                                "target_lang_word": "отвести",
                                "target_lang_sense_clarification": "в значении отклонить обвинения или доводы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}