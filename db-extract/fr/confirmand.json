                        "entry_id": "3553eb7b-9f29-3e20-8499-47452a4e2d94",
                        "tags": [
                            "plural"
                        ],
                        "form": "confirmands"
                    },
                    {
                        "form_id": "f40426ab-c1cd-4849-a901-f9339da27537",
                        "entry_id": "3553eb7b-9f29-3e20-8499-47452a4e2d94",
                        "tags": [
                            "feminine"
                        ],
                        "form": "confirmande"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "036c4b4e-80da-34e8-8597-8d3f6bfc0f6f",
                        "entry_id": "3553eb7b-9f29-3e20-8499-47452a4e2d94",
                        "glosses": [
                            "Celui qui se présente pour recevoir le sacrement de confirmation, dans l’Église catholique romaine ou la cérémonie protestante homonyme (qui n’est pas alors considérée comme sacrement)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e4cad82-c006-4d31-84b2-530b4f65c098",
                                "sense_id": "036c4b4e-80da-34e8-8597-8d3f6bfc0f6f",
                                "text": "L'usage du chrémeau nous conduit ainsi naturellement à celui du bandeau de lin que les confirmands tiennent à la main en s'approchant du Pontife et dont on leur bande le front après l’onction sacramentelle."
                            },
                            {
                                "example_id": "5714a557-73b1-4d0e-8ce8-65c2d4b6ea9d",
                                "sense_id": "036c4b4e-80da-34e8-8597-8d3f6bfc0f6f",
                                "text": "A l’endroit marqué par une croix, l’évêque bénit les confirmands."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5b6f6c6-e614-4b36-b04a-55d5de9a7fee",
                        "source_entry_id": "3553eb7b-9f29-3e20-8499-47452a4e2d94",
                        "source_sense_id": "036c4b4e-80da-34e8-8597-8d3f6bfc0f6f",
                        "target_lang_word": "Konfirmand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konfirmand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79a0f19c-6967-3646-974b-9a48e76d78cc",
                                        "entry_id": "6a3e7d36-0bae-3b47-ad9f-0e4aed9a2688",
                                        "glosses": [
                                            "Person, die im Konfirmationsunterricht auf die Konfirmation vorbereitet wird, Person, die gerade konfirmiert wird/wurde"
                                        ],
                                        "tags": [
                                            "evangelische Kirche",
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6591f816-1e1a-4911-9940-ba8b1019eb77",
                                                "sense_id": "79a0f19c-6967-3646-974b-9a48e76d78cc",
                                                "text": "Die Konfirmanden besuchen regelmäßig den Konfirmationsunterricht und während der gesamten Konfirmandenzeit den Gottesdienst der Kirchengemeinde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67aec534-78ac-4db7-9655-0e9623b882de",
                        "source_entry_id": "3553eb7b-9f29-3e20-8499-47452a4e2d94",
                        "source_sense_id": "036c4b4e-80da-34e8-8597-8d3f6bfc0f6f",
                        "target_lang_word": "Firmling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Firmling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2cec9e89-9f1d-3b2e-8671-14903a591f71",
                                        "entry_id": "24a86f1e-daaa-3a4e-94d1-f1ca867f5f7c",
                                        "glosses": [
                                            "Person, die gefirmt wird; die zur Firmung geht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cde5956-9fc7-4768-97ce-759288a8c156",
                                                "sense_id": "2cec9e89-9f1d-3b2e-8671-14903a591f71",
                                                "text": "„Der Pate begleitet den Firmling und legt die rechte Hand auf die rechte Schulter des Firmlings.“"
                                            },
                                            {
                                                "example_id": "ed121655-b32b-4a36-8047-ceb72a0d2a40",
                                                "sense_id": "2cec9e89-9f1d-3b2e-8671-14903a591f71",
                                                "text": "„Voraussetzung für die Firmung ist, dass der Firmling getauft ist und aus freiem Willen gefirmt werden will.“"
                                            },
                                            {
                                                "example_id": "6973d81a-3429-4c71-bcf8-246f207870bc",
                                                "sense_id": "2cec9e89-9f1d-3b2e-8671-14903a591f71",
                                                "text": "„Beim feierlichen Empfang des Erzbischofs in der alten Frauenkirche waren auch wir Firmlinge anwesend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20f1af1b-a4ee-41a1-af04-6ec17f4b50ff",
                        "source_entry_id": "3553eb7b-9f29-3e20-8499-47452a4e2d94",
                        "source_sense_id": "036c4b4e-80da-34e8-8597-8d3f6bfc0f6f",
                        "target_lang_word": "confirmand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confirmand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84ba8893-3862-3606-94f4-0661c7fdab76",
                                        "entry_id": "cea34800-2624-3034-a094-8e2a48193500",
                                        "glosses": [
                                            "A candidate for confirmation or affirmation of baptism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68940f25-43e8-4c22-9766-ce27fd469e34",
                                                "sense_id": "84ba8893-3862-3606-94f4-0661c7fdab76",
                                                "text": "The preacher then tells the confirmands, that as a token of their full consent to the confession just made, each of them should kiss the Scroll of the Law."
                                            },
                                            {
                                                "example_id": "a8b3c6e9-1bc9-45f3-8e50-af2f7606efb1",
                                                "sense_id": "84ba8893-3862-3606-94f4-0661c7fdab76",
                                                "text": "In confirmation the confirmand confesses his faith and expresses a willingness to accept and obey Jesus Christ as his Lord; and the Christian Church confirms the worthiness of the confirmand to partake of the fellowship and heavenly blessings which this new relation called church-membership involves."
                                            },
                                            {
                                                "example_id": "b42d7b48-a031-46f2-811c-4128d2adfe21",
                                                "sense_id": "84ba8893-3862-3606-94f4-0661c7fdab76",
                                                "text": "These persons are recruited from a list of several, active adults in the church that is submitted by each confirmand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "026e477a-cfcd-44cb-af57-a4c87304eb64",
