                "senses": [
                    {
                        "sense_id": "e26a7d46-e024-3dee-8daf-2fc4909d1c31",
                        "entry_id": "964bc4dd-78ef-3b94-b102-7a18a8c91b53",
                        "glosses": [
                            "Bankhaus, das Diskontgeschäft betreibt; Stelle, an der man Geld wechseln und überweisen kann"
                        ],
                        "tags": [
                            "Bankwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "7f6b5521-a083-4990-a9fb-7b370c980a85",
                                "sense_id": "e26a7d46-e024-3dee-8daf-2fc4909d1c31",
                                "text": "„In Städten, wo es keine Wechselbanken gab, spielte noch im 17. Jahrhundert die Messe als Zentrum des Zahlungsverkehrs eine wichtige Rolle.“"
                            },
                            {
                                "example_id": "18a817f9-ac62-4057-a93b-a7db0df97285",
                                "sense_id": "e26a7d46-e024-3dee-8daf-2fc4909d1c31",
                                "text": "Die Aufgabe einer Wechselbank war es, Geldbeträge in andere Währungen zu wechseln, aber auch zu verwalten, zu überweisen und für die Auszahlung von Geld zu garantieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
