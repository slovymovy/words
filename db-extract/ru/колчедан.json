                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kies",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c357716f-54b0-3c1d-8074-eb8b8bd7f376",
                                        "entry_id": "3d91e4e3-56ad-30d2-a46a-d3e26ca46e1d",
                                        "glosses": [
                                            "lose Gesteinsstücke in einer Korngröße von etwa 3 mm bis 30 mm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "077b1ef8-0942-4c26-8694-ec6e3da4d80a",
                                                "sense_id": "c357716f-54b0-3c1d-8074-eb8b8bd7f376",
                                                "text": "Das Ufer des Flusses besteht aus Kies."
                                            },
                                            {
                                                "example_id": "04ac04e3-3992-40c8-ada7-9dcea1addca7",
                                                "sense_id": "c357716f-54b0-3c1d-8074-eb8b8bd7f376",
                                                "text": "„Der vulkanische Kies ist ein hervorragender Boden, die Besonnung ist kräftig; die Trauben, die hier gelesen werden, ergeben einen sehr wohlduftenden Muskatwein.“"
                                            },
                                            {
                                                "example_id": "b882cd7f-6b2c-47ca-bb79-8730ef7c2c05",
                                                "sense_id": "c357716f-54b0-3c1d-8074-eb8b8bd7f376",
                                                "text": "„Auf dem Nachhauseweg, den Blick auf meine Füße gerichtet, während unter meinen Schuhen Kies, Kopfsteinpflaster und Betonplatten abwechselten, ging mir die Sache mit den beiden wieder und wieder durch den Kopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "26405d68-3dd1-3973-ad9d-33cbebe7bb57",
                                        "entry_id": "3d91e4e3-56ad-30d2-a46a-d3e26ca46e1d",
                                        "glosses": [
                                            "Baustoff und Bauzuschlagstoff, Filtermaterial aus [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
