                                "example_id": "66c64bc6-320b-4200-9694-82c634b7d67e",
                                "sense_id": "f87228f2-7659-35a0-b0c0-5f98d891d213",
                                "text": "Сам собой вдруг упал с полки альбом и распластался по полу со шмяком."
                            }
