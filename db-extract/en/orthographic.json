                                            {
                                                "example_id": "838eb4e6-3250-4696-b2fd-2c29ecaa11f2",
                                                "sense_id": "33843576-0fc3-397c-bced-e987ab268597",
                                                "text": "„Wir stoßen außer den genannten orthographischen und phonetischen noch auf morphologische, semantische und syntaktische Probleme vielfältigster Art, die einer genauen Wortdefinition entgegenstehen.“"
                                            },
                                            {
                                                "example_id": "51a30af9-bec6-4a0d-9bcf-7f5a5a59f705",
                                                "sense_id": "33843576-0fc3-397c-bced-e987ab268597",
                                                "text": "„Auf der morphologischen, grammatischen und orthographischen Ebene ist die Einheitlichkeit der deutschen Standardsprache stets voll gewahrt geblieben…“"
                                            },
                                            {
                                                "example_id": "9e9dad56-1263-4e3e-a313-15fe579d1cfa",
                                                "sense_id": "33843576-0fc3-397c-bced-e987ab268597",
                                                "text": "„Bald sickerte das Geheimnis durch, daß dieser Schachmeister in seinem Privatleben außerstande war, in irgendeiner Sprache einen Satz ohne orthographischen Fehler zu schreiben,“ […]."
                                            }
