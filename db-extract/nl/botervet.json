                "senses": [
                    {
                        "sense_id": "efd535b8-7535-3964-a2eb-e0bf73e9bc5a",
                        "entry_id": "1624a23d-0004-3e91-bf10-78b2b3a4803c",
                        "glosses": [
                            "glycerol molecuul met daaraan drie moleculen boterzuur gebonden; het hoofdbestanddeel van boter; het vet dat in melk zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec71bade-d97e-4e01-9436-af182f54d0b5",
                                "sense_id": "efd535b8-7535-3964-a2eb-e0bf73e9bc5a",
                                "text": "Boter klaren is niet zo heel lastig, heel zachtjes opzetten, alles wegscheppen wat bovenkomt en langzaam, langzaam afgieten zodat achterblijft wat is gezonken. Het zijn eiwitdeeltjes die in het botervet verbranden. Ghee maken is hetzelfde maar dan laat je na het scheiden het botervet op een pitje staan tot er helemaal geen vocht meer inzit."
                            },
                            {
                                "example_id": "56d79669-ceea-4791-9eba-09914aa78f01",
                                "sense_id": "efd535b8-7535-3964-a2eb-e0bf73e9bc5a",
                                "text": "Giet de room in een grote glazen bokaal die je afsluit met een goed passend deksel. Schud de bokaal stevig heen en weer tot de room stijf is. Op dit punt moet je even op je tanden bijten: je blijft schudden tot de massa opnieuw in beweging komt en zich uiteindelijk opsplitst in karnemelk en vlokjes botervet."
                            }
                        ]
                    }
                ],
                "translations": [
