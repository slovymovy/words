                                        "entry_id": "1b1b2af0-0c84-3f0b-9851-7489123d4a6e",
                                        "glosses": [
                                            "het systematisch en eenzijdig onderwijzen (met de nodige druk) van overtuigingen, met de bedoeling dat deze kritiekloos worden aanvaard"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a08a839-9d35-49ae-9104-a4504293e721",
                                                "sense_id": "1f8d47f8-a93b-3912-a36e-35e56e7ee4bd",
                                                "text": "In Pakistan, de bakermat van het fundamentalistisch koranonderwijs, begint de indoctrinatie vanaf 3 of 4 jaar en duurt tot het einde van de schooljaren"
                                            },
                                            {
                                                "example_id": "d605730d-cf27-4fdc-9be2-8a0aedf1ee22",
                                                "sense_id": "1f8d47f8-a93b-3912-a36e-35e56e7ee4bd",
                                                "text": "Een onbekend aantal ouders in het noordoosten van Nigeria stuurt uit eigen beweging hun dochters naar de jihadistische groepering Boko Haram voor indoctrinatie en zelfmoordaanslagen"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
