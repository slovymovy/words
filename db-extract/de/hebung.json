                    {
                        "sense_id": "b685a8ac-b668-378b-8c49-4fd9ec6cbaf6",
                        "entry_id": "7b969993-a24e-3f28-97e5-bc53e49ef65c",
                        "glosses": [
                            "das Anheben von etwas, das von unten nach oben Bewegen"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "a0a08a72-a5d7-409b-b5d9-182ad8bece2b",
                                "sense_id": "b685a8ac-b668-378b-8c49-4fd9ec6cbaf6",
                                "text": "Die Hebung des Schiffes erwies sich als schwieriger als erwartet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f5b9db4e-06dc-3df1-ae8e-329a3914c5b9",
                        "entry_id": "7b969993-a24e-3f28-97e5-bc53e49ef65c",
                        "glosses": [
                            "das Steigern, Verbessern von etwas"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "a7d05d67-735e-4d0d-972d-84535e3789fe",
                                "sense_id": "f5b9db4e-06dc-3df1-ae8e-329a3914c5b9",
                                "text": "An eine Hebung der Stimmung war unter diesen Umständen nicht zu denken."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "01b605c2-5f2a-34e0-af24-a1bea3fdf49e",
