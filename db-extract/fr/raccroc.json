                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9bb6d2d-1e9f-3f7f-9b34-3fef60c0abb0",
                                        "entry_id": "7d9aa0b8-ea97-31b2-a003-688bc9be868b",
                                        "glosses": [
                                            "Vertreter einer Gruppe von bestimmten kurzbeinigen Arten der Familie der Hunde (Canidae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57c7d584-498d-49de-b288-c91bffcc423f",
                                                "sense_id": "e9bb6d2d-1e9f-3f7f-9b34-3fef60c0abb0",
                                                "text": "Die Tante des Jungen ist schlau wie ein Fuchs."
                                            },
                                            {
                                                "example_id": "9391b3b2-3c5b-4aaa-84a5-9cbc890da8bf",
                                                "sense_id": "e9bb6d2d-1e9f-3f7f-9b34-3fef60c0abb0",
                                                "text": "„Der graue Hase hatte den Haarwechsel schon zur Hälfte hinter sich, die jungen Füchse vom diesjährigen Wurf schwärmten bereits aus, und die jungen Wölfe waren schon größer als Hunde.“"
                                            },
                                            {
                                                "example_id": "39e751f6-8b10-44cd-a272-fc82ff690b86",
                                                "sense_id": "e9bb6d2d-1e9f-3f7f-9b34-3fef60c0abb0",
                                                "text": "Fuchs, du hast die Gans gestohlen – (Kinderlied)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4bd772eb-3206-3a24-824f-812b2ed8419b",
                                        "entry_id": "7d9aa0b8-ea97-31b2-a003-688bc9be868b",
                                        "glosses": [
                                            "männlicher Fuchs^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65fcaa6c-c5b6-47c9-a371-ef3d62b2c6a5",
                                                "sense_id": "4bd772eb-3206-3a24-824f-812b2ed8419b",
                                                "text": "Der Fuchs jagt die Fähe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d7631335-6164-3620-8277-41ec31d51db0",
                                        "entry_id": "7d9aa0b8-ea97-31b2-a003-688bc9be868b",
