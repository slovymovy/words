{
    "word_family": [
        "pacify",
        "pacific",
        "pacification"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3846fef-57d4-3937-90af-b1d36662d12e",
                    "sense_definition": "A rubber or plastic device imitating a nipple that goes into a baby’s mouth, used to calm and quiet the baby.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "baby_care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby stopped crying as soon as his mother gave him his <w>pacifier</w>.",
                            "target_lang_translations": {
                                "zh": "妈妈一给宝宝<w>安抚奶嘴</w>，他就停止了哭闹。"
                            }
                        },
                        {
                            "text": "She cleaned the <w>pacifier</w> before putting it back in the baby's mouth.",
                            "target_lang_translations": {
                                "zh": "她在把<w>安抚奶嘴</w>放回宝宝嘴里之前先清洗了一下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dummy",
                        "comforter",
                        "soother",
                        "binky"
                    ],
                    "common_phrases": [
                        "baby pacifier",
                        "clean pacifier"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种模仿乳头形状的橡胶或塑料制品，放在婴儿嘴里，用来安抚婴儿。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "安抚奶嘴",
                                "target_lang_sense_clarification": "最常用的术语，指婴儿用的橡胶或硅胶奶嘴。"
                            },
                            {
                                "target_lang_word": "奶嘴",
                                "target_lang_sense_clarification": "口语中常用来指代安抚奶嘴。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7360ade6-7a51-385c-b0e1-f79a27a2c248",
                    "sense_definition": "Someone or something that pacifies or calms a situation or person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calming_agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy was intended as a <w>pacifier</w> to calm the angry protesters.",
                            "target_lang_translations": {
                                "zh": "这项新政策旨在作为一种<w>缓和剂</w>来平息抗议者的愤怒。"
                            }
                        },
                        {
                            "text": "He acted as a <w>pacifier</w> during the heated argument between his two friends.",
                            "target_lang_translations": {
                                "zh": "在两个朋友激烈争吵时，他充当了<w>安抚者</w>的角色。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指能够平息事态或安抚他人的人或事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "安抚者",
                                "target_lang_sense_clarification": "指起到安抚作用的人。"
                            },
                            {
                                "target_lang_word": "缓和剂",
                                "target_lang_sense_clarification": "指起到平息事态作用的事物或政策。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}