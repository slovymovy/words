                "senses": [
                    {
                        "sense_id": "de698d7b-bba7-30fe-9bcc-022149cbbf56",
                        "entry_id": "52671b1f-1ea2-3c08-ab85-1a7e464aa360",
                        "glosses": [
                            "Politikerin, welche in der Kommunalpolitik tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a700877-522f-46a5-ac16-15a01e206671",
                                "sense_id": "de698d7b-bba7-30fe-9bcc-022149cbbf56",
                                "text": "„In der CDU kam es kürzlich zu einer öffentlichen Diskussion über Sexismus und Mobbing, nachdem eine Berliner Kommunalpolitikerin Parteikollegen öffentlich Sexismus und Verleumdungen vorgeworfen hatte.“"
                            },
                            {
                                "example_id": "ae443cad-114a-44d7-8cca-ac6db0bd601f",
                                "sense_id": "de698d7b-bba7-30fe-9bcc-022149cbbf56",
                                "text": "„Köpping ist auch erfahrene Kommunalpolitikerin – und die SPD braucht demnächst einen Kandidaten für das Rathaus von Leipzig.“"
                            }
                        ],
