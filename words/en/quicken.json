                            {
                                "target_lang_word": "участиться",
                                "target_lang_sense_clarification": "о пульсе или сердцебиении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67707546-4d31-3c29-a653-50d2690df51c",
                    "sense_definition": "To stimulate, inspire, or rouse a feeling, interest, or action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher's enthusiastic lecture helped to <w>quicken</w> the students' interest in ancient history.",
                            "target_lang_translations": {
                                "ru": "Увлеченная лекция учителя помогла <w>оживить</w> интерес студентов к древней истории."
                            }
                        },
                        {
                            "text": "Seeing the beautiful landscape served to <w>quicken</w> her resolution to travel more often.",
                            "target_lang_translations": {
                                "ru": "Вид прекрасного пейзажа помог <w>укрепить</w> её решимость путешествовать чаще."
                            }
                        }
                    ],
                    "synonyms": [
                        "stimulate",
                        "arouse",
                        "awaken",
                        "inspire",
                        "kindle",
                        "rouse",
                        "whet"
                    ],
                    "antonyms": [
