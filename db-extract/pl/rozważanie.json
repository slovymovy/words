                                                "example_id": "4d5bd894-5c17-45c9-b515-73f12a5c1f72",
                                                "sense_id": "df69ca92-a63e-3b13-b2f5-883a8bad4f47",
                                                "text": "non hai nessuna considerazione di me!"
