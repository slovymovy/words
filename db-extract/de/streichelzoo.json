                "senses": [
                    {
                        "sense_id": "9afc5970-7f2c-3bcc-9d87-18d43e065acd",
                        "entry_id": "3caf3f6d-e178-3cb4-ac5c-50388be823f4",
                        "glosses": [
                            "Zoo/Bereich eines Zoos, in dem Tiere gehalten werden, die sich anfassen lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49e28e93-c6ee-4213-9a20-578ca364d78d",
                                "sense_id": "9afc5970-7f2c-3bcc-9d87-18d43e065acd",
                                "text": "„Holländer lieben diese nationalen Tage, an denen sie kollektiv vorlesen, die Strände reinigen oder die Ställe der Streichelzoos ausmisten.“"
                            },
                            {
                                "example_id": "b067ec4f-144a-4bea-9993-fd360478ea87",
                                "sense_id": "9afc5970-7f2c-3bcc-9d87-18d43e065acd",
                                "text": "„Seit Monaten kursieren im Netz haarsträubende Berichte über angebliche Untaten von Flüchtlingen, die Mär von den geschlachteten Zicklein aus dem Streichelzoo ist nur eine davon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
