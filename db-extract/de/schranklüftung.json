                "senses": [
                    {
                        "sense_id": "761182da-0131-3239-b149-17eb80e44e63",
                        "entry_id": "67a5244f-eb52-34cd-9626-8dc25ebeb120",
                        "glosses": [
                            "selbsttätige oder technische Luftzirkulation in und aus einem Schrank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0849261-a1a7-45c0-9f6f-f3deda5f0391",
                                "sense_id": "761182da-0131-3239-b149-17eb80e44e63",
                                "text": "„Es muss eine Vorrichtung vorhanden sein, die im Brandfall die Schranklüftung unterbricht.“"
                            },
                            {
                                "example_id": "75258473-6985-4d66-8fe2-7687765fc8bc",
                                "sense_id": "761182da-0131-3239-b149-17eb80e44e63",
                                "text": "„Sie kann auch in Labor- oder Chemikalienschränken vorgenommen werden, die - im Brandfall, z. B. durch Unterbrechen der Schranklüftung eine Brandausbreitung verhindern.“"
                            },
                            {
                                "example_id": "c4dccc41-86ba-4dbd-8e14-678a1ca1f110",
                                "sense_id": "761182da-0131-3239-b149-17eb80e44e63",
                                "text": "„Die Schranklüftung verhindert die Rezirkulation warmer Luft innerhalb des Schranks und ermöglicht so geringere Vorlauftemperaturen für verbesserte Leistung und Kühleffizienz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
