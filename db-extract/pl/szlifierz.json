                "translations": [
                    {
                        "translation_id": "55410a11-ec3e-4a60-96fd-0b9fa2378aa6",
                        "source_entry_id": "c5e4ba50-cdfb-3cca-9071-7a2f7c5da7a9",
                        "source_sense_id": "dccfada9-93b3-3b9e-9a80-290c2132dcfb",
                        "target_lang_word": "Schleifer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schleifer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b1f5b22-f01b-3608-bdb4-03eb1e59541c",
                                        "entry_id": "6e536708-f1e0-31f5-9133-9812ecb9efa8",
                                        "glosses": [
                                            "Trainer beziehungsweise Ausbilder, der Sportler beziehungsweise Rekruten hart trainieren lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a59f1543-e78c-4d8f-a657-4b2ce2450a72",
                                                "sense_id": "2b1f5b22-f01b-3608-bdb4-03eb1e59541c",
                                                "text": "Der Ausbilder war als ein übler Schleifer bekannt."
                                            },
                                            {
                                                "example_id": "8f67d3bb-b650-4c11-b7a5-4b01c2f7a6ae",
                                                "sense_id": "2b1f5b22-f01b-3608-bdb4-03eb1e59541c",
                                                "text": "„Es ist halb drei; der Schleifer vieler Generationen unglücklicher Rekruten muß also schwer geladen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schleifer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59419087-0c26-3f3f-a88a-36c37e43901c",
                                        "entry_id": "1980d652-967e-3b93-82bc-a70ef90ff198",
                                        "glosses": [
                                            "jemand, der die Oberfläche eines Gegenstandes glättet/formt"
                                        ],
                                        "tags": [
                                            "Handwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef70f87-8a52-4b58-a66c-a2ea5cbcb389",
                                                "sense_id": "59419087-0c26-3f3f-a88a-36c37e43901c",
                                                "text": "Ein Schleifer kann am Diamanten absichtlich Facetten erzeugen, die sich nicht genau treffen, zum Beispiel, um exakt 1,00 Karat zu erreichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f504fc45-12e1-3562-bc99-048b96f2dabe",
                                        "entry_id": "1980d652-967e-3b93-82bc-a70ef90ff198",
                                        "glosses": [
                                            "Gerät für das mechanische Glätten einer Oberfläche"
                                        ],
                                        "tags": [
                                            "rare",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "784b1f11-4b9c-4dc1-ae19-b56c3891ac9f",
                                                "sense_id": "f504fc45-12e1-3562-bc99-048b96f2dabe",
                                                "text": "„Für jeden Einsatz gibt es den richtigen Schleifer.“"
                                            },
                                            {
                                                "example_id": "d0435fe4-7adc-4dd2-9d86-7a0d1329a0fb",
                                                "sense_id": "f504fc45-12e1-3562-bc99-048b96f2dabe",
                                                "text": "„Schließlich wollen Sie wissen, wie der Schleifer sich auf Flächen, an Kanten und in Ecken schlägt.“"
                                            },
                                            {
                                                "example_id": "f45743c4-7fa2-4ff8-a1e1-e09bce3d5618",
                                                "sense_id": "f504fc45-12e1-3562-bc99-048b96f2dabe",
                                                "text": "„Die Leistungswerte sind für einen extrem günstigen Schleifer in Ordnung: […]“"
                                            },
                                            {
                                                "example_id": "8ae4d957-f9e2-445b-baec-fd58483e2ff1",
                                                "sense_id": "f504fc45-12e1-3562-bc99-048b96f2dabe",
                                                "text": "„Dieser Schleifer hat einen komfortableren Griff, […]“"
                                            },
                                            {
                                                "example_id": "44797ef2-00c4-49fb-a2d4-edbc4f3d6688",
                                                "sense_id": "f504fc45-12e1-3562-bc99-048b96f2dabe",
                                                "text": "„Der Schleifer vibriert sehr stark[.]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
