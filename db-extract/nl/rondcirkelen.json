                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e5b618b-6ce4-4901-a6b6-3dbc3d32e917",
                                                "sense_id": "54929ef5-0552-3584-8b49-6a6518b2e8c0",
                                                "text": "The wolves circled the herd of deer."
                                            },
                                            {
                                                "example_id": "16b2fde9-d0b8-4c66-8866-7144420da676",
                                                "sense_id": "54929ef5-0552-3584-8b49-6a6518b2e8c0",
                                                "text": "Other planets circle other suns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd42069-33b6-385c-bee4-22c181ad7be9",
                                        "entry_id": "d6671169-1605-3114-9f5e-e0a6e75a9886",
                                        "glosses": [
                                            "To surround."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f9c2da4-c9c2-42cd-812e-ec5eb202b859",
                                                "sense_id": "2fd42069-33b6-385c-bee4-22c181ad7be9",
                                                "text": "A high fence circles the enclosure."
                                            },
                                            {
                                                "example_id": "58abaa85-dfff-4a4f-96c3-00a206cac60f",
                                                "sense_id": "2fd42069-33b6-385c-bee4-22c181ad7be9",
                                                "text": "Their heads are circled with a short turban."
                                            },
                                            {
                                                "example_id": "87c681cc-423e-4195-a6bc-f8fe5e90461c",
                                                "sense_id": "2fd42069-33b6-385c-bee4-22c181ad7be9",
                                                "text": "So he lies, circled with evil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1cf9692-2045-3019-89a1-1966775f554c",
                                        "entry_id": "d6671169-1605-3114-9f5e-e0a6e75a9886",
                                        "glosses": [
                                            "To place or mark a circle around."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d64b3f95-6769-43a7-bed8-4b4c677eac35",
                                                "sense_id": "f1cf9692-2045-3019-89a1-1966775f554c",
                                                "text": "Circle the jobs that you are interested in applying for."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e3e17ed-85a5-308e-bc98-de9600339094",
                                        "entry_id": "d6671169-1605-3114-9f5e-e0a6e75a9886",
                                        "glosses": [
                                            "To travel in circles."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c983ded-35e4-4260-90f0-d6fbdf91aa64",
                                                "sense_id": "3e3e17ed-85a5-308e-bc98-de9600339094",
                                                "text": "Vultures circled overhead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dfa7865-9836-39ac-ad80-55ac4796b580",
                                        "entry_id": "d6671169-1605-3114-9f5e-e0a6e75a9886",
                                        "glosses": [
                                            "To take part in a magic circle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d68b4df1-d67c-42de-b313-71b93a48616a",
                                                "sense_id": "6dfa7865-9836-39ac-ad80-55ac4796b580",
                                                "text": "I circled with that group for three years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
