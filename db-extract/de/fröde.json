                ],
                "senses": [
                    {
                        "sense_id": "d3b17e7e-5c80-30b8-9ffa-17644e3c3ba9",
                        "entry_id": "09096c6a-de5d-3cda-a6f3-191b823d2c09",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname - klug, weise Seiender, Weiser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc11e725-7c22-4338-9525-5b49084111d0",
                                "sense_id": "d3b17e7e-5c80-30b8-9ffa-17644e3c3ba9",
                                "text": "Frau Fröde ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f717af82-48b2-441d-acea-bf303eecd122",
                                "sense_id": "d3b17e7e-5c80-30b8-9ffa-17644e3c3ba9",
                                "text": "Herr Fröde wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f6989a1f-8595-476e-a6e8-0f63510a19bd",
                                "sense_id": "d3b17e7e-5c80-30b8-9ffa-17644e3c3ba9",
                                "text": "Die Frödes kommen heute aus dem Erzgebirge."
                            },
                            {
                                "example_id": "935a2bfa-fd2f-42d6-ad00-e974a99fdc96",
                                "sense_id": "d3b17e7e-5c80-30b8-9ffa-17644e3c3ba9",
                                "text": "Der Fröde trägt nie die Schals, die die Fröde ihm strickt."
                            },
                            {
                                "example_id": "69e49569-746e-47da-9d67-c2b8563684a6",
                                "sense_id": "d3b17e7e-5c80-30b8-9ffa-17644e3c3ba9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fröde kommt, geht der Herr Fröde.“"
                            },
                            {
                                "example_id": "5b93b09c-47f8-432b-af58-5d8766b55c27",
                                "sense_id": "d3b17e7e-5c80-30b8-9ffa-17644e3c3ba9",
                                "text": "Fröde kommt und geht."
                            },
                            {
                                "example_id": "1b513049-225b-498d-8b82-27ded261d13c",
                                "sense_id": "d3b17e7e-5c80-30b8-9ffa-17644e3c3ba9",
                                "text": "Frödes kamen, sahen und siegten."
                            },
                            {
                                "example_id": "d2ff0af4-12b1-45b9-a2cb-90d07207cad1",
                                "sense_id": "d3b17e7e-5c80-30b8-9ffa-17644e3c3ba9",
                                "text": "An verregneten Herbsttagen ist Familie Frödes liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "4bb24fcc-e1aa-41be-b039-3dc26ba19cd2",
                                "sense_id": "d3b17e7e-5c80-30b8-9ffa-17644e3c3ba9",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Fröde das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
