                    {
                        "sense_id": "0c9baf7f-60bf-3d87-9db1-cd1f41addc11",
                        "entry_id": "0cb0f4aa-6c90-37c0-87f6-73cc10dde20a",
                        "glosses": [
                            "waarvan de verblijfplaats en het welbevinden niet zeker is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e7480d0-9e7e-438e-a97e-78457bee703f",
                                "sense_id": "0c9baf7f-60bf-3d87-9db1-cd1f41addc11",
                                "text": "Het vermiste meisje werd uitgeput en met een gebroken been aangetroffen op de berghelling."
                            },
                            {
                                "example_id": "368bbf98-0046-48a0-abdf-f89bc78221ac",
                                "sense_id": "0c9baf7f-60bf-3d87-9db1-cd1f41addc11",
                                "text": "Het is onduidelijk hoe de boot heeft kunnen kapseizen. Een helikopter heeft tevergeefs naar de vermiste personen gezocht."
                            }
                        ]
                    }
                ],
