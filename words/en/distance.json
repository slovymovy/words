{
    "word_family": [
        "distant",
        "distantly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3f087fb-a714-3927-8066-9be4ccaec6cc",
                    "sense_definition": "An amount of space between two points or places.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "space_measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>distance</w> from my house to the station is about two miles.",
                            "target_lang_translations": {
                                "ru": "<w>Расстояние</w> от моего дома до станции составляет около двух миль.",
                                "tr": "Evimden istasyona olan <w>mesafe</w> yaklaşık iki mildir."
                            }
                        },
                        {
                            "text": "Please keep a safe <w>distance</w> from the edge of the cliff.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, держитесь на безопасном <w>расстоянии</w> от края обрыва.",
                                "tr": "Lütfen uçurumun kenarından güvenli bir <w>mesafe</w> bırakın."
                            }
                        }
                    ],
                    "synonyms": [
                        "length",
                        "space"
                    ],
                    "antonyms": [
                        "closeness",
                        "proximity"
                    ],
                    "common_phrases": [
                        "walking distance",
                        "long distance",
                        "short distance",
                        "safe distance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество пространства между двумя точками или местами.",
                        "tr": "İki nokta veya yer arasındaki boşluk miktarı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстояние",
                                "target_lang_sense_clarification": "физическое пространство между объектами"
                            },
                            {
                                "target_lang_word": "дистанция",
                                "target_lang_sense_clarification": "интервал или промежуток"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mesafe",
                                "target_lang_sense_clarification": "iki nokta arasındaki uzaklık"
                            },
                            {
                                "target_lang_word": "uzaklık",
                                "target_lang_sense_clarification": "bir yerin ne kadar uzakta olduğu"
                            },
                            {
                                "target_lang_word": "ara",
                                "target_lang_sense_clarification": "iki şeyi ayıran boşluk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ffb4420-413b-30d1-abfe-f8044182b15f",
                    "sense_definition": "A place or point that is far away, often visible but remote.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "space_measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could see the lights of the city twinkling in the <w>distance</w>.",
                            "target_lang_translations": {
                                "ru": "Мы видели огни города, мерцающие <w>вдали</w>.",
                                "tr": "Şehrin ışıklarının <w>uzakta</w> parıldadığını görebiliyorduk."
                            }
                        },
                        {
                            "text": "The mountains looked beautiful from a <w>distance</w>.",
                            "target_lang_translations": {
                                "ru": "Горы выглядели красиво с <w>расстояния</w>.",
                                "tr": "Dağlar <w>uzaktan</w> güzel görünüyordu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the distance",
                        "from a distance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место или точка, находящиеся далеко, часто видимые, но удаленные.",
                        "tr": "Genellikle görülebilen ancak uzak olan bir yer veya nokta."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "даль",
                                "target_lang_sense_clarification": "удаленное пространство, видимое глазом"
                            },
                            {
                                "target_lang_word": "расстояние",
                                "target_lang_sense_clarification": "значительная удаленность"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uzak",
                                "target_lang_sense_clarification": "mesafece geride olan yer"
                            },
                            {
                                "target_lang_word": "mesafe",
                                "target_lang_sense_clarification": "belirli bir uzaklık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95f0efbe-6861-3566-82ff-ee30a354d5b0",
                    "sense_definition": "An interval or amount of time between two events.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "time_measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At a <w>distance</w> of twenty years, it is easier to forgive what happened.",
                            "target_lang_translations": {
                                "ru": "С <w>дистанции</w> двадцати лет легче простить то, что произошло.",
                                "tr": "Yirmi yıllık bir <w>ara</w>dan sonra olanları affetmek daha kolay."
                            }
                        },
                        {
                            "text": "The <w>distance</w> between the two meetings was too short to prepare a report.",
                            "target_lang_translations": {
                                "ru": "<w>Промежуток</w> между двумя встречами был слишком коротким, чтобы подготовить отчет.",
                                "tr": "İki toplantı arasındaki <w>zaman</w> bir rapor hazırlamak için çok kısaydı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "distance of time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Интервал или количество времени между двумя событиями.",
                        "tr": "İki olay arasındaki zaman dilimi veya miktarı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промежуток",
                                "target_lang_sense_clarification": "отрезок времени"
                            },
                            {
                                "target_lang_word": "интервал",
                                "target_lang_sense_clarification": "временная пауза"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ara",
                                "target_lang_sense_clarification": "iki olay arasındaki zaman"
                            },
                            {
                                "target_lang_word": "zaman aralığı",
                                "target_lang_sense_clarification": "vakit farkı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f01f275b-4e8d-3c8b-8a49-04926fafa5d8",
                    "sense_definition": "A lack of friendliness, intimacy, or involvement with other people; emotional separation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the argument, there was a noticeable <w>distance</w> between the two friends.",
                            "target_lang_translations": {
                                "ru": "После ссоры между двумя друзьями возникла заметная <w>дистанция</w>.",
                                "tr": "Tartışmadan sonra iki arkadaş arasında gözle görülür bir <w>mesafe</w> oluştu."
                            }
                        },
                        {
                            "text": "She treated the strangers with a polite but cold <w>distance</w>.",
                            "target_lang_translations": {
                                "ru": "Она относилась к незнакомцам с вежливой, но холодной <w>отстранённостью</w>.",
                                "tr": "Yabancılara nazik ama soğuk bir <w>mesafeyle</w> yaklaştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "unfriendliness",
                        "standoffishness",
                        "alienation",
                        "unsociableness"
                    ],
                    "antonyms": [
                        "closeness",
                        "intimacy",
                        "warmth"
                    ],
                    "common_phrases": [
                        "keep one's distance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие дружелюбия, близости или участия; эмоциональная отстраненность.",
                        "tr": "İnsanlar arasındaki samimiyet veya yakınlık eksikliği; duygusal kopukluk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дистанция",
                                "target_lang_sense_clarification": "отчужденность в отношениях"
                            },
                            {
                                "target_lang_word": "отстранённость",
                                "target_lang_sense_clarification": "эмоциональная холодность"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mesafe",
                                "target_lang_sense_clarification": "ilişkilerdeki resmiyet veya soğukluk"
                            },
                            {
                                "target_lang_word": "soğukluk",
                                "target_lang_sense_clarification": "duygusal uzaklık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0352cc7d-d89d-3270-a35b-40fb8863aede",
                    "sense_definition": "The completion of a full course or a difficult task, often used in the phrase 'go the distance'.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "idiomatic_progress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He started the project with enthusiasm but did not have the stamina to go the <w>distance</w>.",
                            "target_lang_translations": {
                                "ru": "Он начал проект с энтузиазмом, но у него не хватило выносливости, чтобы пройти всю <w>дистанцию</w>.",
                                "tr": "Projeye hevesle başladı ama sonuna kadar <w>gidecek</w> dayanıklılığı yoktu."
                            }
                        },
                        {
                            "text": "The boxer managed to go the <w>distance</w> and finish all twelve rounds.",
                            "target_lang_translations": {
                                "ru": "Боксер сумел продержаться всю <w>дистанцию</w> и закончить все двенадцать раундов.",
                                "tr": "Boksör tüm <w>raundları</w> tamamlamayı ve maçı bitirmeyi başardı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go the distance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Завершение полного курса или сложной задачи, часто используется во фразе 'go the distance'.",
                        "tr": "Bir parkurun veya zorlu bir görevin tamamlanması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дистанция",
                                "target_lang_sense_clarification": "полная протяженность пути или состязания"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mesafe",
                                "target_lang_sense_clarification": "kat edilmesi gereken yolun tamamı"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e513717-3686-3325-aa0e-851b95f42fc7",
                    "sense_definition": "To become less involved or connected with someone or something, often to avoid association.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "social_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician tried to <w>distance</w> himself from the controversial statement.",
                            "target_lang_translations": {
                                "ru": "Политик попытался <w>дистанцироваться</w> от спорного заявления.",
                                "tr": "Politikacı tartışmalı açıklamadan kendisini <w>uzaklaştırmaya</w> çalıştı."
                            }
                        },
                        {
                            "text": "It is healthy to <w>distance</w> yourself from people who constantly bring you down.",
                            "target_lang_translations": {
                                "ru": "Полезно <w>отдаляться</w> от людей, которые постоянно тянут вас вниз.",
                                "tr": "Sizi sürekli aşağı çeken insanlarla aranıza <w>mesafe koymak</w> sağlıklıdır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "distance oneself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться менее вовлеченным или связанным с кем-то, часто чтобы избежать ассоциации.",
                        "tr": "Biriyle veya bir şeyle olan bağı azaltmak, ilişkiyi kesmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дистанцироваться",
                                "target_lang_sense_clarification": "отстраняться, избегать участия"
                            },
                            {
                                "target_lang_word": "отдаляться",
                                "target_lang_sense_clarification": "прекращать близкие отношения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mesafe koymak",
                                "target_lang_sense_clarification": "aradaki samimiyeti azaltmak"
                            },
                            {
                                "target_lang_word": "uzaklaşmak",
                                "target_lang_sense_clarification": "bağlantıyı kesmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fcf6bf2-4243-380a-9ea5-5ca715db485d",
                    "sense_definition": "To leave others behind in a race or competition; to run much faster than opponents.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The champion runner easily <w>distanced</w> the other competitors in the final lap.",
                            "target_lang_translations": {
                                "ru": "Чемпион по бегу легко <w>опередил</w> других участников на последнем круге.",
                                "tr": "Şampiyon koşucu son turda diğer rakiplerine kolayca <w>fark attı</w>."
                            }
                        },
                        {
                            "text": "Our team has <w>distanced</w> all rivals in terms of innovation and sales.",
                            "target_lang_translations": {
                                "ru": "Наша команда <w>обошла</w> всех соперников по инновациям и продажам.",
                                "tr": "Ekibimiz inovasyon ve satış konularında tüm rakiplerini <w>geride bıraktı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "outdistance",
                        "outrun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставлять других позади в гонке или соревновании; бежать намного быстрее соперников.",
                        "tr": "Bir yarışta veya rekabette diğerlerini geride bırakmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опережать",
                                "target_lang_sense_clarification": "оставлять позади"
                            },
                            {
                                "target_lang_word": "обгонять",
                                "target_lang_sense_clarification": "уходить вперед"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fark atmak",
                                "target_lang_sense_clarification": "arayı açarak öne geçmek"
                            },
                            {
                                "target_lang_word": "geride bırakmak",
                                "target_lang_sense_clarification": "yarışta rakiplerini geçmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}