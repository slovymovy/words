{
    "word_family": [
        "admire",
        "admirer",
        "admiring",
        "admiringly",
        "admirable",
        "admirably"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                    "sense_definition": "A feeling of deep respect and approval, often combined with wonder, for someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "feelings_of_respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked at the beautiful landscape in <w>admiration</w>.",
                            "target_lang_translations": {
                                "ru": "Она смотрела на красивый пейзаж с <w>восхищением</w>."
                            }
                        },
                        {
                            "text": "The young musician gained the <w>admiration</w> of critics worldwide after her stunning performance.",
                            "target_lang_translations": {
                                "ru": "После своего потрясающего выступления молодая музыкантка завоевала <w>восхищение</w> критиков по всему миру."
                            }
                        }
                    ],
                    "synonyms": [
                        "appreciation",
                        "adoration",
                        "reverence",
                        "wonder",
                        "worship"
                    ],
                    "antonyms": [
                        "contempt",
                        "disdain"
                    ],
                    "common_phrases": [
                        "in admiration",
                        "express admiration",
                        "gain admiration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство глубокого уважения и одобрения, часто в сочетании с изумлением, по отношению к кому-либо или чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восхищение",
                                "target_lang_sense_clarification": "чувство очарованности кем-либо или чем-либо"
                            },
                            {
                                "target_lang_word": "восторг",
                                "target_lang_sense_clarification": "сильный подъем радостных чувств"
                            },
                            {
                                "target_lang_word": "преклонение",
                                "target_lang_sense_clarification": "глубокое уважение и почтение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f748cfe3-68bd-3b50-b958-900d0abd8eab",
                    "sense_definition": "An object, person, or thing that excites wonder, surprise, or pleased approval.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "source_of_wonder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newly restored cathedral became the <w>admiration</w> of the entire city.",
                            "target_lang_translations": {
                                "ru": "Недавно отреставрированный собор стал <w>предметом восхищения</w> всего города."
                            }
                        },
                        {
                            "text": "He brought in the rare artifact, presenting the <w>admiration</w> to the gathered crowd.",
                            "target_lang_translations": {
                                "ru": "Он принес редкий артефакт, представив это <w>чудо</w> собравшейся толпе."
                            }
                        }
                    ],
                    "synonyms": [
                        "wonder"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used to refer to the object of wonder itself"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект, человек или вещь, вызывающие удивление, изумление или одобрение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предмет восхищения",
                                "target_lang_sense_clarification": "то, что вызывает всеобщее одобрение и восторг"
                            },
                            {
                                "target_lang_word": "чудо",
                                "target_lang_sense_clarification": "объект удивления и восторга"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70ef4473-6af6-38af-aa2b-e6d6ed0ff3fd",
                    "sense_definition": "Wonder, astonishment, or questioning, without implying a positive or negative attitude.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "neutral_wonder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stared in pure <w>admiration</w> at the strange phenomenon, unable to comprehend its cause.",
                            "target_lang_translations": {
                                "ru": "Он смотрел в чистом <w>изумлении</w> на странное явление, не в силах понять его причину."
                            }
                        },
                        {
                            "text": "The sudden change in his behavior filled the onlookers with great <w>admiration</w> and confusion.",
                            "target_lang_translations": {
                                "ru": "Внезапная перемена в его поведении наполнила зрителей сильным <w>удивлением</w> и замешательством."
                            }
                        }
                    ],
                    "synonyms": [
                        "wonder"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the classical sense of neutral wonder or astonishment"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изумление, удивление или недоумение без выраженного положительного или отрицательного отношения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изумление",
                                "target_lang_sense_clarification": "крайнее удивление"
                            },
                            {
                                "target_lang_word": "удивление",
                                "target_lang_sense_clarification": "нейтральное чувство, вызванное чем-то необычным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}