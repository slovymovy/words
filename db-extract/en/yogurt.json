                                "target_senses": [
                                    {
                                        "sense_id": "e6f943e6-24cf-3259-8a2c-80a2fc914410",
                                        "entry_id": "78fbabc4-1fc1-3260-bfae-aaa3c846604c",
                                        "glosses": [
                                            "Dickmilchprodukt, welches aus eingedickter, pasteurisierter Milch gewonnen wird, in der durch spezielle Milchsäurebakterien eine Teilgärung hervorgerufen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a3f4498-e2cf-4b2a-9a10-3d2a94a1b910",
                                                "sense_id": "e6f943e6-24cf-3259-8a2c-80a2fc914410",
                                                "text": "„Seit Jahrtausenden nutzen Menschen die Wirkung von Enzymen: Ohne sie gäbe es keinen Joghurt, keinen Wein, kein Bier.“"
                                            },
                                            {
                                                "example_id": "cd875bd6-2e50-4765-bb48-268e2982b842",
                                                "sense_id": "e6f943e6-24cf-3259-8a2c-80a2fc914410",
                                                "text": "Deutschland: „Diese Produkte kennt fast jeder: die \"Müller-Milch\", den \"Joghurt mit Ecke\" oder den \"Froop-Frucht auf Joghurt\".“"
                                            },
                                            {
                                                "example_id": "79cb88ee-8cd1-4b6c-86b2-ba6e87ab8cd6",
                                                "sense_id": "e6f943e6-24cf-3259-8a2c-80a2fc914410",
                                                "text": "Österreich: „Die Joghurt stammt aus dem Orient und entsteht durch die Gerinnung von Milch“"
                                            },
                                            {
                                                "example_id": "846fffec-3125-461f-855b-b0a9fa13fd8c",
                                                "sense_id": "e6f943e6-24cf-3259-8a2c-80a2fc914410",
                                                "text": "Schweiz: „Ihr Seliger zum Beispiel habe sich einmal zu Beginn einer Ohnmacht das Joghurt über den Kopf geleert und nachher behauptet, sie selber habe das getan“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
