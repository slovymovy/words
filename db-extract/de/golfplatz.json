                ],
                "senses": [
                    {
                        "sense_id": "98b86a32-cbb1-3d31-bd3c-421ac59cdb67",
                        "entry_id": "99ce2044-fa2b-388e-b78a-0b15df50483c",
                        "glosses": [
                            "das Spielfeld für das Golfspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "598e56be-aa46-422e-af75-ec005a3c1d11",
                                "sense_id": "98b86a32-cbb1-3d31-bd3c-421ac59cdb67",
                                "text": "Vor dem Turnier wurde der Rasen des Golfplatzes ausgebessert."
                            },
                            {
                                "example_id": "f1e65834-29f6-4192-82f2-9a2a3bb3f19f",
                                "sense_id": "98b86a32-cbb1-3d31-bd3c-421ac59cdb67",
                                "text": "„Finanziert wird der Sanierungsplan in erster Linie durch die Verwertung des gesamten Gesellschaftsvermögens, insbesondere durch den Verkauf der drei Tiroler Hotels (Hotel Achenkirch, Golfhotel Reith, Hotel Going) und der Verwertung des Cordial Hotels Pelagone samt Golfplatz, das der italienischen Tochtergesellschaft Il Pelagone S.r.l. zugerechnet werde, teilten die Kreditschützer mit.“"
                            },
                            {
                                "example_id": "40dd00fe-1cfe-4e4e-a20d-f426711050d2",
                                "sense_id": "98b86a32-cbb1-3d31-bd3c-421ac59cdb67",
                                "text": "„Der alte Mann sah aus dem Fenster, und sein Blick fiel als erstes auf einen gepflegten Golfplatz, schöner, als er je auf Erden erbaut worden sein könnte.“"
                            },
                            {
                                "example_id": "c1a9954d-5943-4bd2-80c9-af2717c0e710",
                                "sense_id": "98b86a32-cbb1-3d31-bd3c-421ac59cdb67",
                                "text": "„Als das Plateau der Golfplätze erreicht war, ging die Sonne auf.“"
                            },
                            {
                                "example_id": "9f2ab6c1-e974-4d99-a0b8-e20a37e14157",
                                "sense_id": "98b86a32-cbb1-3d31-bd3c-421ac59cdb67",
                                "text": "„Sie gingen weiter Richtung Golfplatz und durch einen Ortsteil namens Jörundarholt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
