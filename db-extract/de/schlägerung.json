                "senses": [
                    {
                        "sense_id": "cca258db-46bf-3818-81c6-fd1ae773886a",
                        "entry_id": "425ac08a-3222-33a5-b256-bfc4cab09b17",
                        "glosses": [
                            "das Fällen von Bäumen, Rodung des Waldes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63d231e8-f58e-4bb8-a45d-bc6129e1ea63",
                                "sense_id": "cca258db-46bf-3818-81c6-fd1ae773886a",
                                "text": "„Das nötige Material sollte durch Schlägerung der chinesischen Wälder gewonnen werden.“"
                            },
                            {
                                "example_id": "368b42f4-5c36-4741-abf3-710b76b6320f",
                                "sense_id": "cca258db-46bf-3818-81c6-fd1ae773886a",
                                "text": "„Ein Baum wächst 100 Jahre lang, nach der Schlägerung könnte er uns weitere 200 Jahre als Baustoff dienen; wir aber verbrennen ihn in Hochleistungsöfen in ein paar Minuten.“"
                            },
                            {
                                "example_id": "c133e985-b1ab-4fb0-8d54-78041fbacc0e",
                                "sense_id": "cca258db-46bf-3818-81c6-fd1ae773886a",
                                "text": "„Im Bergwald gesellt er sich zu den Knechten des Hofes und arbeitet mit bei der Schlägerung des Holzes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
