                        "glosses": [
                            "Verre de dégustation : verre (récipient) destiné à la dégustation de boissons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57205595-2666-4d09-a7f6-f6bd61577a32",
                                "sense_id": "2657d2a6-4b9f-372b-8e4c-8cd9349ce693",
                                "text": "Für Probierwettbewerbe gibt es entsprechende normierte Probiergläser.",
                                "translation": "Pour les concours de dégustation, il y a des verres de dégustation normés correspondants."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e43e94b-49f4-3f1e-85ce-d3619a18eaa0",
                        "entry_id": "11f6c6a2-50d8-3915-9276-6f7f7835e2db",
                        "glosses": [
                            "Éprouvette, tube à essai : vase cylindrique étroit destiné à recueillir des liquides, suspensions ou poudres en petite quantité pour des réactions chimiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0c952d-b66b-452e-a6b9-1f5108831ff0",
                                "sense_id": "5e43e94b-49f4-3f1e-85ce-d3619a18eaa0",
                                "text": "Probiergläser eignen sich für die Ausführung chemischer Reaktionen im kleinen Maßstab für Testzwecke.",
                                "translation": "Les tubes à essai conviennent à la réalisation de réactions chimiques à petite échelle, à fin de test."
                            }
                        ]
                    }
