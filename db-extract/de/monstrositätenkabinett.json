                        "glosses": [
                            "Räumlichkeit, in der als monströs Empfundenes ausgestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2db51db-8c89-4631-ae2d-8cc4c29f88ae",
                                "sense_id": "bba8f033-62fd-3885-b87b-a1a8d80fdbc3",
                                "text": "„Ich saß da und lauschte einer Stimme, die daran gewöhnt war, über Wunder zu sprechen; Spare war wie ein geübter Werber für ein Monstrositätenkabinett.“"
                            },
                            {
                                "example_id": "d45cd38e-e048-4465-905e-09054ef205f3",
                                "sense_id": "bba8f033-62fd-3885-b87b-a1a8d80fdbc3",
                                "text": "„Gurken schwammen in Lake, ihre Haut wie durchsichtiger Gummi, ein selbstgebasteltes Monstrositätenkabinett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
