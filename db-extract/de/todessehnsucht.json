                        "form": "die Todessehnsüchte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "421c8de6-58bd-3370-9330-e34526796e76",
                        "entry_id": "5f98e7df-53b3-37ba-b89d-1235ca55d1f4",
                        "glosses": [
                            "der Drang, der Wunsch, tot zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3b53b1f-9495-42bb-9f19-371a450fb2f8",
                                "sense_id": "421c8de6-58bd-3370-9330-e34526796e76",
                                "text": "„Ihre Musik kreuzte Aggression mit Todessehnsucht.“"
                            },
                            {
                                "example_id": "d622d87a-12cc-49fc-8d78-94fb01834e06",
                                "sense_id": "421c8de6-58bd-3370-9330-e34526796e76",
                                "text": "„Romantische Todessehnsucht, in der Gruft der Ahnen theatralisch ausgespielt, und alberner Studentenulk scheinen zwar extreme Gegensätze.“"
                            },
                            {
                                "example_id": "39e1f3a9-314a-46ef-aff9-ecfde1b69ae9",
                                "sense_id": "421c8de6-58bd-3370-9330-e34526796e76",
                                "text": "„Wagnis wird nicht von einer Todessehnsucht bestimmt, sondern von einer Lebenssehnsucht, die einen Sinngrund sucht.“"
                            },
                            {
                                "example_id": "dc03fcd3-8afc-4353-aa6d-6d799cc6e110",
                                "sense_id": "421c8de6-58bd-3370-9330-e34526796e76",
                                "text": "„Oder hat, was noch weit schlimmer wäre, Jahrzehnte in seinem tiefsten Innern, von niemandem wahrgenommen, vielleicht von ihm selbst nicht gespürt, nicht eingestanden oder unterdrückt, eine Todessehnsucht geschlummert, ein nihilistischer Drive, der ihn signalverspätet mit einer fatalen Logik und Konsequenz in den Tod getrieben hat?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3d8e0c9-c18d-4044-aea6-acb2fc191597",
                        "source_entry_id": "5f98e7df-53b3-37ba-b89d-1235ca55d1f4",
                        "source_sense_id": "421c8de6-58bd-3370-9330-e34526796e76",
                        "source_sense_description": "der Drang, der Wunsch, tot zu sein",
                        "target_lang_word": "yearning for death",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1e009961-ed6e-4049-812f-ff817321bbb6",
                        "source_entry_id": "5f98e7df-53b3-37ba-b89d-1235ca55d1f4",
                        "source_sense_id": "421c8de6-58bd-3370-9330-e34526796e76",
                        "source_sense_description": "der Drang, der Wunsch, tot zu sein",
                        "target_lang_word": "death wish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "death wish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd97b1c4-5dbe-3a66-9043-44308a57f368",
                                        "entry_id": "e6fd797b-9178-34a0-a8f2-24f1606dd767",
                                        "glosses": [
                                            "A desire, especially subconscious, for the death of oneself or of someone else."
                                        ],
                                        "tags": [
                                            "often",
                                            "sarcastic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b1bd07-8054-4f74-a790-ae10b43eb6b9",
                                                "sense_id": "dd97b1c4-5dbe-3a66-9043-44308a57f368",
                                                "text": "Does Trump suffer from some kind of political death wish? If so, we must hope his fall comes quickly. It is hard to think of any precedent for such a calamitous display of insensitivity, historical ignorance and uncomprehending political stupidity."
                                            },
                                            {
                                                "example_id": "da71d143-757d-48a2-bab5-47f62beccc3a",
                                                "sense_id": "dd97b1c4-5dbe-3a66-9043-44308a57f368",
                                                "text": "Wait, Kris! What the HELL was that!??!?! Why would NOELLE?? Ask ME?? To do HOMEWORK?? With HER?!?? Deathwish much? Does she WANNA fail?"
                                            },
                                            {
                                                "example_id": "d4320d09-9ccf-47ce-ac95-ca38115e7929",
                                                "sense_id": "dd97b1c4-5dbe-3a66-9043-44308a57f368",
                                                "text": "\"I reiterate: outside is death.\" Brenda squeezed her hand. \"You won't make it far by yourself.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1db57ce-beef-4ef0-926c-c1029007d97c",
                        "source_entry_id": "5f98e7df-53b3-37ba-b89d-1235ca55d1f4",
                        "source_sense_id": "421c8de6-58bd-3370-9330-e34526796e76",
