                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "723654b6-057a-4e4a-84bc-ffb9c4157c1d",
                        "entry_id": "0a2d54ee-0ffe-3d41-89c1-3876025146e5",
                        "tags": [
