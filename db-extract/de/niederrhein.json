                    {
                        "form_id": "ba44142b-b9fa-4b4a-b7d0-54e8b70422d1",
                        "entry_id": "a06cfa8e-239c-37d7-9dd9-068d5e4a9033",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Niederrhein"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13e4e32f-7330-30d1-ace7-549dd9862836",
                        "entry_id": "a06cfa8e-239c-37d7-9dd9-068d5e4a9033",
                        "glosses": [
                            "ein Abschnitt des Rheins: nördlich von Bonn mündet die Sieg in den Rhein, der von hier ab bis nach Hoek-van-Holland (Rheinkilometer 660–1033) Niederrhein genannt wird (die Region Niederrhein (siehe [2]) beginnt jedoch erst weiter nördlich)"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "5be4c6a7-c8e8-4892-8859-ce7f3492703d",
                                "sense_id": "13e4e32f-7330-30d1-ace7-549dd9862836",
                                "text": "Der Niederrhein fließt durch eine weithin ebene Landschaft."
                            },
                            {
                                "example_id": "020dfd2d-ed7c-4f4a-8015-e95f6d5bc75d",
                                "sense_id": "13e4e32f-7330-30d1-ace7-549dd9862836",
                                "text": "„Am deutschen Niederrhein kennt man noch immer Johanna Sebus.“"
                            },
                            {
                                "example_id": "dbd5cef2-42f9-4f2a-a3ae-e41b529d8e21",
                                "sense_id": "13e4e32f-7330-30d1-ace7-549dd9862836",
                                "text": "„Sie begann zu vagabundieren, fuhr ins Emsland, danach an den Niederrhein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7f32e121-bff2-349a-bc93-b97c89e06955",
                        "entry_id": "a06cfa8e-239c-37d7-9dd9-068d5e4a9033",
                        "glosses": [
                            "eine an die Niederlande grenzende Region beziehungsweise Landschaft im Westen des deutschen Bundeslandes Nordrhein-Westfalen"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "b66c0834-4b19-49bb-b50f-60530223ee49",
                                "sense_id": "7f32e121-bff2-349a-bc93-b97c89e06955",
                                "text": "„Kerngebiet des Niederrheins sind die Kreise Kleve, Wesel und Viersen sowie die Städte Krefeld und Duisburg.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
