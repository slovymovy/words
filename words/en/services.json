                    "sense_definition": "Commercial activities or work provided for others, distinct from physical goods.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The economy relies heavily on the production of goods and <w>services</w>.",
                            "target_lang_translations": {
                                "ru": "Экономика сильно зависит от производства товаров и <w>услуг</w>.",
                                "zh": "经济在很大程度上依赖于商品和<w>服务</w>的生产。"
                            }
                        },
                        {
                            "text": "This company exports financial <w>services</w> to clients around the world.",
                            "target_lang_translations": {
