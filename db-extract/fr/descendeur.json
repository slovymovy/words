                    {
                        "sense_id": "8dd58000-7e90-3d52-8b5f-015541aad8c1",
                        "entry_id": "be807095-ffcc-33da-b6dc-18e6110aef43",
                        "glosses": [
                            "Outil d’alpinisme pour la descente en rappel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77a37d75-4518-4d1b-a06d-41fffa7ec686",
                                "sense_id": "8dd58000-7e90-3d52-8b5f-015541aad8c1",
                                "text": "Rappelons que deux modèles de descendeurs, avec ou sans autoblocage, se disputent les faveurs des spéléologues.\nLe descendeur sans blocage conviendra bien au débutant."
                            },
                            {
                                "example_id": "b026eeea-9d25-40c8-a1fc-1255cf29666f",
                                "sense_id": "8dd58000-7e90-3d52-8b5f-015541aad8c1",
                                "text": "Le descendeur ainsi en croix, on prend la corde qui vient de l'amarrage avec la main droite et on vient la placer, en passant par-dessus la flasque ouverte, au contact de la poulie fixe inférieure (celle qui est la plus proche du mousqueton)."
                            }
                        ]
                    }
                ],
