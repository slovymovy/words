                "senses": [
                    {
                        "sense_id": "89eec62b-bfff-3421-b59e-2db948fdcc46",
                        "entry_id": "40b1ecd5-2809-3730-8810-a9c9d201b54a",
                        "glosses": [
                            "Qui appartient à l’aurore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03e2b1e8-0e88-4075-8717-6312625ea001",
                                "sense_id": "89eec62b-bfff-3421-b59e-2db948fdcc46",
                                "text": "La lumière aurorale."
                            },
                            {
                                "example_id": "4aa011c7-d677-4e06-a7f4-aeb3379773ea",
                                "sense_id": "89eec62b-bfff-3421-b59e-2db948fdcc46",
                                "text": "Les phénomènes auroraux."
                            }
                        ]
                    },
                    {
                        "sense_id": "961291c5-9c7a-3db7-b1ed-bb1bb9392a21",
                        "entry_id": "40b1ecd5-2809-3730-8810-a9c9d201b54a",
                        "glosses": [
                            "Relatif à une aurore polaire due au champ magnétique d'une planète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9237c98e-0114-45b2-94dc-6f53281227ad",
                                "sense_id": "961291c5-9c7a-3db7-b1ed-bb1bb9392a21",
                                "text": "L'empreinte aurorale nouvellement découverte mesurait environ 1 200 km dans le sens longitudinal et moins de 400 kilomètres perpendiculairement, couvrant une superficie comparable à celle de la Californie ou de la Suède."
                            },
                            {
                                "example_id": "a1da232d-2892-4efb-b893-5b6e515243dd",
                                "sense_id": "961291c5-9c7a-3db7-b1ed-bb1bb9392a21",
                                "text": "En 1839, une expédition conduite par Auguste Bravais (1811-1863) fait hiverner la corvette La Recherche au voisinage du cap Nord dans le but de procéder aux premières observations modernes aurorales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d14f7655-49af-449d-9e94-d63a534af378",
                        "source_entry_id": "40b1ecd5-2809-3730-8810-a9c9d201b54a",
                        "target_lang_word": "auroral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auroral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae9fe79a-3b1d-31a7-a99c-fca4fbb616f1",
                                        "entry_id": "f4c5d500-2a1d-37f8-a538-94b38f6a001b",
                                        "glosses": [
                                            "Pertaining to the dawn; dawning, eastern, like a new beginning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8981db0e-d7b5-4d9b-b44b-9b48ddf55890",
                                                "sense_id": "ae9fe79a-3b1d-31a7-a99c-fca4fbb616f1",
                                                "text": "This first created light is properly the auroral light."
                                            },
                                            {
                                                "example_id": "f03e3f1e-5c47-4a68-85bb-d36bfdb2f32a",
                                                "sense_id": "ae9fe79a-3b1d-31a7-a99c-fca4fbb616f1",
                                                "text": "This auroral openness and uplift gives to all creative ideal levels a bright and caroling quality, which is nowhere more marked than where the controlling emotion is religious."
                                            },
                                            {
                                                "example_id": "b04d72b8-008f-4f28-8603-f493a38e9ad7",
                                                "sense_id": "ae9fe79a-3b1d-31a7-a99c-fca4fbb616f1",
                                                "text": "Sunsets were redder and more intense; dawns were whiter and more auroral."
                                            },
                                            {
                                                "example_id": "7845896a-3067-404b-8d1e-3e106483aa90",
                                                "sense_id": "ae9fe79a-3b1d-31a7-a99c-fca4fbb616f1",
                                                "text": "Hugh kissed her and Abby felt as young and tremulous as a schoolgirl. But she was not demanding and she was not headlong and she counseled herself to look on this tenuous, auroral experience as one that would last only so long as she remained in England […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c97da961-9b44-3f3d-be7b-1675c87341fe",
                                        "entry_id": "f4c5d500-2a1d-37f8-a538-94b38f6a001b",
                                        "glosses": [
                                            "Rosy in colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "692466e0-3b01-4460-8421-50ff6c2008b9",
                                                "sense_id": "c97da961-9b44-3f3d-be7b-1675c87341fe",
                                                "text": "Her cheeks suffused with an auroral blush,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ede6490c-899f-309c-9767-fefa720a34e8",
                                        "entry_id": "f4c5d500-2a1d-37f8-a538-94b38f6a001b",
                                        "glosses": [
                                            "Pertaining to the aurora borealis or aurora australis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae3ea445-9427-4795-acab-0712be80b5fc",
                                                "sense_id": "ede6490c-899f-309c-9767-fefa720a34e8",
                                                "text": "The creature brought within him an amplitude of Northern knowledge. Glacial catastrophes, snow-storm episodes, glittering auroral effects, Polaris in the zenith, Franklin underfoot,—the category of his commonplaces was wonderful."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
