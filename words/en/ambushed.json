{
    "word_family": [
        "ambush",
        "ambusher"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b40b5b00-0ebe-370c-9e29-0314be7d562d",
                    "sense_definition": "Having been the target of an ambush.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attacked",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ambushed</w> soldiers quickly took cover behind the stone wall.",
                            "target_lang_translations": {
                                "zh": "<w>遭到伏击的</w>士兵迅速躲到了石墙后面。"
                            }
                        },
                        {
                            "text": "The <w>ambushed</w> convoy was unable to escape the trap set by the enemy.",
                            "target_lang_translations": {
                                "zh": "<w>遭到伏击的</w>车队没能逃脱敌人设下的陷阱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trapped",
                        "surprised"
                    ],
                    "common_phrases": [
                        "ambushed soldiers",
                        "ambushed convoy"
                    ],
                    "target_lang_definitions": {
                        "zh": "指遭到伏击的，处于被埋伏状态的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "遭到伏击的",
                                "target_lang_sense_clarification": "形容处于被埋伏攻击状态的人或物体"
                            },
                            {
                                "target_lang_word": "被埋伏的",
                                "target_lang_sense_clarification": "指陷入敌方预设圈套的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "503cc3d8-2317-3776-9d8c-34af11ecf220",
                    "sense_definition": "Having been subjected to a shock for which one is unprepared.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attacked",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ambushed</w> reporter felt completely overwhelmed by the sudden barrage of difficult questions.",
                            "target_lang_translations": {
                                "zh": "感到<w>措手不及的</w>记者被突然抛出的一连串难题弄得不知所措。"
                            }
                        },
                        {
                            "text": "Feeling <w>ambushed</w> by the unexpected criticism, she struggled to find a calm response.",
                            "target_lang_translations": {
                                "zh": "面对意料之外的批评，她感到<w>措手不及</w>，努力让自己冷静地回应。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blindsided",
                        "startled"
                    ],
                    "common_phrases": [
                        "feeling ambushed"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因突如其来的情况而感到措手不及或震惊。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "措手不及的",
                                "target_lang_sense_clarification": "形容因突发状况而感到惊慌或准备不足"
                            },
                            {
                                "target_lang_word": "被突袭的",
                                "target_lang_sense_clarification": "比喻在心理上受到意外攻击或批评"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c39ba9e5-398d-3f50-bffe-8e1a4ccf60c0",
                    "sense_definition": "Simple past and past participle of <w>ambush</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The enemy <w>ambushed</w> our patrol near the river crossing at dawn.",
                            "target_lang_translations": {
                                "zh": "敌人在黎明时分于河道渡口附近<w>伏击</w>了我们的巡逻队。"
                            }
                        },
                        {
                            "text": "The group was <w>ambushed</w> while they were walking through the dense forest.",
                            "target_lang_translations": {
                                "zh": "这群人在穿过茂密森林时遭到<w>伏击</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "伏击，埋伏（动词 ambush 的过去式及过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "伏击",
                                "target_lang_sense_clarification": "指在隐蔽处突然袭击"
                            },
                            {
                                "target_lang_word": "埋伏",
                                "target_lang_sense_clarification": "指预先潜伏以待机攻击"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}