                    {
                        "translation_id": "91d04218-19aa-454d-99fc-0c12197cdb8c",
                        "source_entry_id": "478f289f-db0b-313d-9e57-75103d0391ec",
                        "source_sense_id": "62323a2d-5e99-37c2-9c2c-c25f2ed95321",
