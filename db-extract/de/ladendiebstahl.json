                ],
                "senses": [
                    {
                        "sense_id": "4922ff10-1723-3e3a-95b5-c1a129817c0a",
                        "entry_id": "5c111908-885c-326f-9dba-85e6770d8b2a",
                        "glosses": [
                            "Diebstahl von Waren meist geringen Wertes im Einzelhandel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae234d07-36da-4031-971c-b87c78749953",
                                "sense_id": "4922ff10-1723-3e3a-95b5-c1a129817c0a",
                                "text": "Der Ladendiebstahl ist ein großes Problem für den Einzelhandel."
                            },
                            {
                                "example_id": "38dedc3c-d985-43d2-80e7-afa461b8779f",
                                "sense_id": "4922ff10-1723-3e3a-95b5-c1a129817c0a",
                                "text": "Wegen der vielen Ladendiebstähle werden viele Waren mit einer Diebstahlsicherung versehen."
                            },
                            {
                                "example_id": "ff7d410f-5fa3-4fb6-aad7-0caef8e894b1",
                                "sense_id": "4922ff10-1723-3e3a-95b5-c1a129817c0a",
                                "text": "Wer beim Ladendiebstahl erwischt wird, bekommt nicht nur strafrechtliche Probleme, sondern muss auch mit einem Hausverbot in dem Geschäft rechnen."
                            },
                            {
                                "example_id": "149370d0-cb40-4d6a-abbf-98b72317d8c1",
                                "sense_id": "4922ff10-1723-3e3a-95b5-c1a129817c0a",
                                "text": "„Über die Sache mit dem Ladendiebstahl war allmählich Gras gewachsen.“"
                            },
                            {
                                "example_id": "9f4cd4b3-d2a6-4b39-a707-d9dfe897620e",
                                "sense_id": "4922ff10-1723-3e3a-95b5-c1a129817c0a",
                                "text": "„Ein türkischer Junge, etwa zehn Jahre alt, wurde bei einem Ladendiebstahl erwischt.“"
                            },
                            {
                                "example_id": "2aa32d30-e980-4a1c-a287-16cb28cde56e",
                                "sense_id": "4922ff10-1723-3e3a-95b5-c1a129817c0a",
                                "text": "„An einem kühlen Herbstmorgen, nicht lange nach dem Ladendiebstahl ihrer Mutter, als Sylvia Beschreibungen zu den Notizen und Zeichnungen Whitmans verfasste und ihre Mutter und Myrsine Kunden bedienten, Bücher einsortierten und im Verkaufsbereich ein wenig aufräumten, kam Julie mit der kleinen Amélie auf dem Arm herein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51090914-e9ee-4c70-a2c9-c310c9714f85",
                        "source_entry_id": "5c111908-885c-326f-9dba-85e6770d8b2a",
                        "source_sense_id": "4922ff10-1723-3e3a-95b5-c1a129817c0a",
                        "source_sense_description": "Diebstahl von Waren meist geringen Wertes im Einzelhandel",
                        "target_lang_word": "shoplifting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shoplifting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5e1d59a-42d6-3799-a05e-9b3ec0727077",
                                        "entry_id": "0ca0fe22-d973-32a6-8502-083cc36a8a36",
                                        "glosses": [
                                            "The action of stealing goods from a shop, store or other place of business."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0141c5c7-f273-4a97-b86e-33f54defa398",
                                                "sense_id": "d5e1d59a-42d6-3799-a05e-9b3ec0727077",
                                                "text": "Shoplifting is one of the most prevalent crimes and it costs retailers millions of dollars each year."
                                            },
                                            {
                                                "example_id": "2f3cad51-8329-4e34-b981-c43f39e43049",
                                                "sense_id": "d5e1d59a-42d6-3799-a05e-9b3ec0727077",
                                                "text": "On my first day on the watch after leaving the shoplifting squad I paraded on earlies but had completely forgotten to take my ear ring off."
                                            },
                                            {
                                                "example_id": "16fa388d-df83-4589-b211-0239ca0b553b",
                                                "sense_id": "d5e1d59a-42d6-3799-a05e-9b3ec0727077",
                                                "text": "[…]William Grove for robbing his Master of twenty-sive Guineas ; and Catharine Knox for Shoplifting."
                                            },
                                            {
                                                "example_id": "1874103c-2d5a-43fa-b98a-c760cd73a1ed",
                                                "sense_id": "d5e1d59a-42d6-3799-a05e-9b3ec0727077",
                                                "text": "1757 December 22, The London Chronicle, Volume II: June 30 - December 31, page 594,\nYesterday Afternoon a Woman well dreſs'd, was detected at Mr. Flint′s, a Haberdasher on London-Bridge, in Shoplifting, and on examining her, there were found on her ſome Goods belonging to Mr. Kennet, a Haberdasher at the ſame Place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6053fb5c-64aa-30bd-93d4-873a164c2100",
                                        "entry_id": "0ca0fe22-d973-32a6-8502-083cc36a8a36",
                                        "glosses": [
                                            "A theft from a shop during trading hours."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ea7436a-b9b6-48fe-9d2f-374e395534de",
                                                "sense_id": "6053fb5c-64aa-30bd-93d4-873a164c2100",
                                                "text": "In high school, he bleached his hair and began a series of shopliftings and bicycle thefts."
                                            },
                                            {
                                                "example_id": "ec067a83-08c5-40d1-87ae-3de2f54496a9",
                                                "sense_id": "6053fb5c-64aa-30bd-93d4-873a164c2100",
                                                "text": "And we hardly even consider the countless robberies, shopliftings, burglaries, carjackings, kidnappings, stalkings, intimidations and harassments."
                                            },
                                            {
                                                "example_id": "16793b8d-5c37-46f1-af30-3ea8c70d4fd0",
                                                "sense_id": "6053fb5c-64aa-30bd-93d4-873a164c2100",
                                                "text": "When we described the 80-20 rule, we mentioned that 5% of the stores in Danvers, Massachusetts, accounted for 50% of the reported shopliftings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shoplifting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22e7f4ac-2117-345e-a424-625c188a7961",
                                        "entry_id": "aa963d38-059d-33e7-970a-ca3c563e9246",
