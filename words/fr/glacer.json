                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce cri soudain dans l'obscurité a suffi pour me <w>glacer</w> le sang."
                        },
                        {
                            "text": "Le regard sévère du juge <w>glace</w> immédiatement tous les témoins présents."
                        }
                    ],
                    "common_phrases": [
