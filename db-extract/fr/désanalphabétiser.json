                ],
                "senses": [
                    {
                        "sense_id": "89cbe947-7be8-32b4-89e1-944eba50d9f0",
                        "entry_id": "fa7d713a-05c8-317e-bf3d-e6e050f2a652",
                        "glosses": [
                            "Libérer de l’analphabétisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f02dcc3a-1875-438b-a7d7-9612eea26472",
                                "sense_id": "89cbe947-7be8-32b4-89e1-944eba50d9f0",
                                "text": "En ce sens, les analphabètes actuels sont des précurseurs, non des « bavures » ; et ceux qui veulent les « désanalphabétiser » des nostalgiques."
                            },
                            {
                                "example_id": "0a0abef4-5f5d-43fe-8eb4-a954caa6fc93",
                                "sense_id": "89cbe947-7be8-32b4-89e1-944eba50d9f0",
                                "text": "La soif d’apprendre des jeunes républiques africaines d’expression française, leur désir de « désanalphabétiser » leurs populations et de scolariser le plus rapidement possible un maximum d’enfants créent des besoins immenses en matériel pédagogique, au premier plan duquel se trouve évidemment le manuel scolaire."
                            }
                        ]
                    }
