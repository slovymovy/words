                "senses": [
                    {
                        "sense_id": "39401f58-09e0-340c-a1fc-177213bf3df4",
                        "entry_id": "8d9a5a98-05d9-3bbb-819e-b591681c2112",
                        "glosses": [
                            "Localiser de façon très précise."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b8fc3bb6-9a34-3158-825a-56c54e6d62dd",
                        "entry_id": "8d9a5a98-05d9-3bbb-819e-b591681c2112",
                        "glosses": [
                            "Donner un caractère hyperlocal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7319ab8f-ffbf-4c49-b50c-4c1565a7c6d3",
                                "sense_id": "b8fc3bb6-9a34-3158-825a-56c54e6d62dd",
                                "text": "A contrario, il peut y avoir un intérêt à hyper-localiser son service numérique pour mettre en avant la proximité et la relation physique comme valeurs différenciantes."
                            },
                            {
                                "example_id": "7d9ff500-7ebb-4a64-9a20-bb8c22db891a",
                                "sense_id": "b8fc3bb6-9a34-3158-825a-56c54e6d62dd",
                                "text": "Frédéric Martel évoque ensuite l'influence de la mobilité dans l'usage des internets en hyper-localisant ses services, et en offrant une véritable place aux spécificités linguistiques et culturelles, ainsi qu'aux marchés de niches."
                            }
                        ]
                    }
