                    {
                        "sense_id": "5a7a128a-cf86-3b03-89f7-47b7e07f9606",
                        "entry_id": "a2bdf48f-1855-3a48-84eb-0d52021083f0",
                        "glosses": [
                            "osoba zajmująca się zawodowo plastyką"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b373aec9-2655-4093-a44f-961e0a53c8a3",
                                "sense_id": "5a7a128a-cf86-3b03-89f7-47b7e07f9606",
                                "text": "To znany artysta plastyk, jego obrazy wiszą w najlepszych galeriach."
                            },
                            {
                                "example_id": "6d2098d1-1aff-42e2-b108-713841d9e784",
                                "sense_id": "5a7a128a-cf86-3b03-89f7-47b7e07f9606",
                                "text": "On pracuje w szkole, jest plastykiem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
