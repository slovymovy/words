                                        "sense_id": "6b73a22b-fcc5-361c-a188-d8bae244bb26",
                                        "entry_id": "3d6e7d56-a2c1-3a56-913d-e44acecb0866",
                                        "glosses": [
                                            "mit Asphalt befestigen, überziehen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f500c716-72ab-4bb6-8a9c-0880816e205a",
                                                "sense_id": "6b73a22b-fcc5-361c-a188-d8bae244bb26",
                                                "text": "„Während Ost-Deutschland, zwanzig Jahre nach der Wende, geschmackvoll gefliest und picobello asphaltiert ist und die Zinsen stabil bei 1,5 Prozent liegen, gibt es in Polen noch Basisarbeit zu leisten: Bahnhöfe zu bauen, Flüsse auszubaggern und Fertighausfirmen zu gründen.“"
                                            },
                                            {
                                                "example_id": "8fb9236d-89e3-475d-af73-a1bc0d92eb35",
                                                "sense_id": "6b73a22b-fcc5-361c-a188-d8bae244bb26",
                                                "text": "„Er kratzte sich am Cap und bemerkte, dass vielen Leuten nicht klar wäre, welche Schwierigkeiten ein völlig gewöhnlicher Linienbus bereiten könnte, wenn asphaltiert werden sollte.“"
                                            },
                                            {
                                                "example_id": "414245aa-8b55-457d-8e0e-eb9c84fdae0d",
                                                "sense_id": "6b73a22b-fcc5-361c-a188-d8bae244bb26",
                                                "text": "„Sie sollten zweihundertdreißig Kilometer einer zweispurigen Straße, die den ländlichen Süden des Landes mit der Hauptstadt im urbanen Norden verband, asphaltieren und markieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
