                        "sense_id": "a7408a41-86c0-3c7f-a3fe-4b4b2f3363f1",
                        "entry_id": "1a4af8ae-cb7c-3d23-9692-6e7769229f66",
                        "glosses": [
                            "porozumienie o wzajemnym wsparciu w sytuacji konfliktu (zwłaszcza zbrojnego)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "861656fe-24ca-41df-8927-c6112c00061d",
                                "sense_id": "a7408a41-86c0-3c7f-a3fe-4b4b2f3363f1",
                                "text": "Jeśli duński król wydawał syna za córkę króla szwedzkiego, to było to w sytuacji, gdy istniała potrzeba pokoju i zawiązywania sojuszy."
                            },
                            {
                                "example_id": "f8d88915-e1ea-45b8-b0a5-06de7a9f0dde",
                                "sense_id": "a7408a41-86c0-3c7f-a3fe-4b4b2f3363f1",
                                "text": "Po inwazji Rosji na Ukrainę Finlandia wystąpiła o członkostwo w zachodnim sojuszu obronnym NATO. To samo Szwecja."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
