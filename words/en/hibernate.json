                    "frequency": "Middle",
                    "semantic_group_id": "dormancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many bears <w>hibernate</w> in dens during the coldest months of winter."
                        },
                        {
                            "text": "Certain types of frogs <w>hibernate</w> deep beneath the frozen mud."
                        }
                    ],
                    "antonyms": [
                        "estivate"
                    ],
                    "common_phrases": [
                        "hibernate for the winter",
                        "hibernate in winter"
                    ]
                },
                {
                    "sense_id": "1c926b6b-1753-30d8-95d6-059ea0c0c445",
                    "sense_definition": "To enter a low-power standby mode where memory contents are saved to storage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dormancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your laptop will automatically <w>hibernate</w> when the battery becomes critically low."
                        },
                        {
                            "text": "I usually <w>hibernate</w> my computer overnight to quickly resume my work later."
                        }
                    ],
                    "common_phrases": [
                        "cause the computer to hibernate"
                    ]
                },
                {
                    "sense_id": "ec119d29-7f8e-3bb1-8b07-3264d293a3cc",
                    "sense_definition": "To withdraw from social activity or stay secluded indoors for an extended period.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the rainy season, she prefers to <w>hibernate</w> at home with a good book."
                        },
                        {
                            "text": "After a stressful month, he decided to <w>hibernate</w> away from everyone for a weekend."
                        }
                    ],
                    "synonyms": [
