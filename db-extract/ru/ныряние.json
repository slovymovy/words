                                "target_senses": [
                                    {
                                        "sense_id": "d68401b3-bb7d-33d7-9275-6b8a66d9f789",
                                        "entry_id": "d6ae3842-48a5-3983-a6df-f89105f70b76",
                                        "glosses": [
                                            "Action de plonger."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe553a6d-1391-3b3e-96a5-55e1db90b475",
                                        "entry_id": "d6ae3842-48a5-3983-a6df-f89105f70b76",
                                        "glosses": [
                                            "Action de plonger.",
                                            "Action de plonger dans l’eau, en exécutant en l’air une figure acrobatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d83b0dc-cfb0-46ea-8af8-adaf7799885f",
                                                "sense_id": "fe553a6d-1391-3b3e-96a5-55e1db90b475",
                                                "text": "J’eus le plaisir d’y admirer miss Gertrude Ederle, Ailen Riggin et Helen Wainwright, qui vinrent faire une démonstration de plongeons et de nages modernes."
                                            },
                                            {
                                                "example_id": "a6bf3f75-5e36-4441-9b57-2f92530e8b53",
                                                "sense_id": "fe553a6d-1391-3b3e-96a5-55e1db90b475",
                                                "text": "À part Simon qui nage comme un poisson, les plongeons ressemblent plutôt à des écrabouillages qui font de gros bouillons.\nLe maître nageur crie sans arrêt et ne dit jamais que c’est bien, ce serait trop lui demander."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcc88e1a-eece-3bf9-a732-127427d1f969",
                                        "entry_id": "d6ae3842-48a5-3983-a6df-f89105f70b76",
                                        "glosses": [
                                            "Action de plonger.",
                                            "Action de plonger sur une balle ou vers le sol, dans certains sports."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1b9c22c-7ba1-49c9-bdf0-4bd84a6a1f5b",
                                                "sense_id": "bcc88e1a-eece-3bf9-a732-127427d1f969",
                                                "text": "Le plongeon du gardien est un geste technique qui nécessite de l’entraînement, mais qui permet souvent de solder une action adverse par un bel arrêt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70210f17-3af8-3b34-8a4e-fa23fd668f30",
                                        "entry_id": "d6ae3842-48a5-3983-a6df-f89105f70b76",
                                        "glosses": [
                                            "Descente rapide."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29e98ff9-0203-4482-8f60-219035629ac0",
                                                "sense_id": "70210f17-3af8-3b34-8a4e-fa23fd668f30",
                                                "text": "Le mouvement du ballon, son trajet sinueux, ses plongeons et ses remontées, étaient nettement perceptibles, et l’incessante trépidation des moteurs semblait se ralentir et s’accélérer tour à tour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "721ac3dd-ea9a-35aa-8543-a86e30541575",
                                        "entry_id": "d6ae3842-48a5-3983-a6df-f89105f70b76",
                                        "glosses": [
                                            "Oiseau palmipède de la famille des gaviidés, vivant dans l’hémisphère Nord et ainsi appelé parce qu’il plonge dans l’eau pour y prendre sa nourriture :"
                                        ],
