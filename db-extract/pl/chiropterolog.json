                "senses": [
                    {
                        "sense_id": "d7e67817-e62c-36a7-8fe7-5d27fe0f9d30",
                        "entry_id": "97f50fc0-c75d-3ac4-aa9c-ea75bea7a098",
                        "glosses": [
                            "naukowiec zajmujący się badaniem nietoperzy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a216c86-476e-4d8a-8d70-7bc5454548f3",
                                "sense_id": "d7e67817-e62c-36a7-8fe7-5d27fe0f9d30",
                                "text": "Polscy chiropterolodzy odkryli w peruwiańskich jaskiniach nowy gatunek nietoperzy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65b24e0c-1d1a-4f31-acf4-cceaaedf24bd",
                        "source_entry_id": "97f50fc0-c75d-3ac4-aa9c-ea75bea7a098",
                        "source_sense_id": "d7e67817-e62c-36a7-8fe7-5d27fe0f9d30",
                        "target_lang_word": "chiropterologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiropterologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f0792d4-7f8a-377e-a444-d6ee85fa69f3",
                                        "entry_id": "00353299-e909-3aaf-bd96-502bbae90015",
                                        "glosses": [
                                            "Someone who studies bats (the flying mammals)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "524b6fd6-20b2-4313-ae20-95bbf81e8272",
                                                "sense_id": "6f0792d4-7f8a-377e-a444-d6ee85fa69f3",
                                                "text": "Several years later, after reading three of his books on bats, I placed a call to the venerable chiropterologist Dr. M. Brock Fenton, known as the \"batman\" of York University in Toronto."
                                            },
                                            {
                                                "example_id": "18315ef8-bf1f-4a9d-866d-2d36dd8459f4",
                                                "sense_id": "6f0792d4-7f8a-377e-a444-d6ee85fa69f3",
                                                "text": "The older man introduced himself as Otto. The other two were Fabio and Gunther. They were chiropterologists he explained from Erlangen University in Germany."
                                            },
                                            {
                                                "example_id": "36f81abe-3f60-4d40-954d-a85a28066de5",
                                                "sense_id": "6f0792d4-7f8a-377e-a444-d6ee85fa69f3",
                                                "text": "According to the recommendation, the chiropterologist would work in the Wildlands Conservation Division of the Austin Water Utility and would protect the population of about 1.5 million bats from disease, impacts of climate change and harm from construction and development."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
