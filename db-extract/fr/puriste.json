        "fr-extract.jsonl": [
            {
                "entry_id": "4c77514f-1bc5-382a-b9f2-4f8344b649f4",
                "word": "puriste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fea44fae-7377-46cc-9c1f-0701d04607a7",
                        "entry_id": "4c77514f-1bc5-382a-b9f2-4f8344b649f4",
                        "tags": [
                            "plural"
                        ],
                        "form": "puristes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb755790-4b83-30b1-8f5c-5084cc077556",
                        "entry_id": "4c77514f-1bc5-382a-b9f2-4f8344b649f4",
                        "glosses": [
                            "Qui a un grand souci de la correction du langage, du style."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e7ca22-5967-4dbd-b6b8-f178872c4a53",
                                "sense_id": "bb755790-4b83-30b1-8f5c-5084cc077556",
                                "text": "Madame Beauzée couchait avec un maître de langue allemande. M. Beauzée les surprit au retour de l'Académie. L'Allemand dit à la femme : « Quand je vous disais qu'il était temps que je m'en aille. » M. Beauzée, toujours puriste, lui dit : « Que je m'en allasse, monsieur »."
                            },
                            {
                                "example_id": "ff96cfbe-4367-48fc-9d9d-3ac5c80e830b",
                                "sense_id": "bb755790-4b83-30b1-8f5c-5084cc077556",
                                "text": "J'étais devenue puriste sans trop le savoir, ce qui me rendait critique à l'égard des pratiques linguistiques de celles et ceux qui dérogeaient à un idéal pourtant désincarné, attitude qui se retournait forcément contre moi et me rendait très insécure."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbe96d10-9527-36b6-a3d9-390f8edf8072",
                        "entry_id": "4c77514f-1bc5-382a-b9f2-4f8344b649f4",
                        "glosses": [
                            "Qui a un souci de la pureté des mœurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f391bb09-d9e8-4f84-af96-87f8fd41b93d",
                                "sense_id": "dbe96d10-9527-36b6-a3d9-390f8edf8072",
                                "text": "Chez les Allemands de Rome — les nazaréens —, puis chez les raphaéliques britanniques, cette orientation puriste et religieuse allait prendre une ampleur remarquable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bdfc2ef-ef09-44b8-a264-25c323afe0fe",
                        "source_entry_id": "4c77514f-1bc5-382a-b9f2-4f8344b649f4",
                        "target_lang_word": "puristisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puristisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9371966f-8c80-364f-bbf3-cd5a9e8e2761",
                                        "entry_id": "70519175-44ae-3ec1-9343-e4df1f54a602",
                                        "glosses": [
                                            "auf den Purismus bezogen, nach Art des Purismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df3ce669-0d21-4955-b3a3-715a86b9b9d0",
                                                "sense_id": "9371966f-8c80-364f-bbf3-cd5a9e8e2761",
                                                "text": "„Wir erleben seit einiger Zeit eine Rückkehr ernsthaften Verständnisses für das, was früher als puristische Malerei bekannt war, ein Stil, der während der fünfzehn Jahre Vorherrschaft des abstrakten Expressionismus verfallen war.“"
                                            },
                                            {
                                                "example_id": "0fd44b75-83c5-432c-bf79-9b10751189b5",
                                                "sense_id": "9371966f-8c80-364f-bbf3-cd5a9e8e2761",
                                                "text": "„Die ungezwungene Umgangssprache besonders der jüngeren Generationen ist hingegen weit weniger puristisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbd141b8-684c-4e98-adc3-1fc2d7a6783c",
