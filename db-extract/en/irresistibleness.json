                        "examples": [
                            {
                                "example_id": "69ad611b-8862-4797-b61a-2e82f6de442a",
                                "sense_id": "e976a49f-c8de-31b1-ab85-b13dd60a0178",
                                "text": "Once Rome, fully conscious of the irresistibleness of her power by land, had transferred her superiority also to the other element; now the mighty state was powerless at sea and, as it seemed, on the point of also losing its dominion at least over the Asiatic continent."
                            },
                            {
                                "example_id": "61278bc5-de99-4747-9d14-3e1bd5cd85c5",
                                "sense_id": "e976a49f-c8de-31b1-ab85-b13dd60a0178",
                                "text": "If he could get our point of view and let some woman take a hand at him, she might efface his irresistibleness and make a man of him."
                            }
                        ]
                    }
