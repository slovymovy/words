                        "examples": [
                            {
                                "example_id": "26895809-bd40-4ebb-97ba-0b6a04dcc185",
                                "sense_id": "ccd31e4c-fd29-3db5-a3d6-13b59e30ae4a",
                                "text": "Jest to ta sama okrutna alternatywa, z pomocą której niegdyś sprawdzano kobiety oskarżane o czarodziejstwo: wrzucano skrępowane do wody i jeśli tonęły to oznaczało, że były niesłusznie oskarżone, a jeśli wypływały — to były czarownicami i wiadomo było, jak dalej postąpić…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
