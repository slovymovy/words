                        "examples": [
                            {
                                "example_id": "5982c4cb-d055-4bdd-a077-a39e976be5e8",
                                "sense_id": "9f649b19-1b4e-3a2e-a4f8-4f5c9b3c29e8",
                                "text": "C’est un long vieillard, mince comme un baliveau, un peu courbé par une bonne septantaine d’ans."
                            },
                            {
                                "example_id": "061ed7fa-e290-4faa-b8bd-e0646de80d01",
                                "sense_id": "9f649b19-1b4e-3a2e-a4f8-4f5c9b3c29e8",
                                "text": "Ces deux romans figurent aujourd’hui parmi la septantaine de Delly qui ornent fièrement ma bibliothèque […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "b939c32e-beb9-3c24-b1fa-d3ce752a75b0",
                        "entry_id": "b3419454-7a89-3812-8c56-bacec5536ec5",
                        "glosses": [
                            "ou Âge de septante ans, ou allant de septante à quatre-vingts ans."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ab1e1d45-2403-42a9-8709-dd546f0fde52",
                                "sense_id": "b939c32e-beb9-3c24-b1fa-d3ce752a75b0",
                                "text": "Oh, moi ! reprit-il en riant, j’ai passé la septantaine."
                            },
                            {
                                "example_id": "21e6d817-a9df-4ca4-be9a-51477227207d",
                                "sense_id": "b939c32e-beb9-3c24-b1fa-d3ce752a75b0",
                                "text": "Je vais te confier mon opinion à présent que j’ai passé la septantaine : on est toujours couillonné."
                            }
                        ]
                    }
