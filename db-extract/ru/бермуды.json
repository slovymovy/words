                                    {
                                        "sense_id": "7d9bd545-f250-339a-b740-04499ea9d651",
                                        "entry_id": "36a9391a-fce3-374f-9f2f-28f0386cc9b1",
                                        "glosses": [
                                            "Inselgruppe im Atlantik nahe Nordamerika, britisches Überseegebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9207f88f-d2d5-4efc-8e31-0f6a270fb365",
                                                "sense_id": "7d9bd545-f250-339a-b740-04499ea9d651",
                                                "text": "Bermuda wurde 1503 von dem Spanier Juan de Bermúdez entdeckt, der aber wegen der gefährlichen Riffe, die die Insel umgeben, nicht an Land ging."
                                            },
                                            {
                                                "example_id": "986b7385-a2ed-4b62-ad6d-af36533adc7a",
                                                "sense_id": "7d9bd545-f250-339a-b740-04499ea9d651",
                                                "text": "„Auf den Inseln leben eine Reihe glücklicher Engländer, denn zur Zeit gibt es auf den Bermudas keine Einkommen[- ]und keine Erbschaftssteuer.“"
                                            },
                                            {
                                                "example_id": "7723aed7-eaa7-4e44-92d8-fd0584f0437f",
                                                "sense_id": "7d9bd545-f250-339a-b740-04499ea9d651",
                                                "text": "Über das Bermuda des 19. Jahrhunderts existieren einige Berichte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6764a1a7-7676-468c-96b6-c76af4295be2",
                        "source_entry_id": "4a0a9327-6441-38b9-aaf0-3cce7388c355",
                        "source_sense_description": "группа островов",
                        "target_lang_word": "Bermudes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bermudes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a76451bc-1492-370c-89dc-5cdc37151319",
                                        "entry_id": "72497546-df65-336b-afe4-73d3d2f1fc96",
                                        "glosses": [
                                            "Archipel situé au nord-ouest de l’océan Atlantique Nord, possession britannique, dont la ville principale est Saint-George, et la capitale, Hamilton."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab18c7f9-f7ec-4760-810c-d6415153f547",
                                                "sense_id": "a76451bc-1492-370c-89dc-5cdc37151319",
                                                "text": "Dans mon demi-sommeil je pense à ces défectuosités du gréement […] et à tout ce qu'il faudra réparer aux îles Bermudes, avant de continuer ma croisière."
                                            },
                                            {
                                                "example_id": "9c515e66-227a-4bfe-b582-a1101fd58036",
                                                "sense_id": "a76451bc-1492-370c-89dc-5cdc37151319",
                                                "text": "Je suis monté sur le yacht, dit Gaspard, et je suis allé aux Bermudes."
                                            },
                                            {
                                                "example_id": "c93f0182-24f2-4eb0-a5a2-c6f263b1568a",
                                                "sense_id": "a76451bc-1492-370c-89dc-5cdc37151319",
                                                "text": "Le pétrel des Bermudes, l’oiseau emblématique de cet archipel britannique situé dans l’océan Atlantique, a été redécouvert en 1951, près de 300 ans après sa prétendue extinction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0518c8f5-e616-42f6-b8a1-e9d607728ead",
