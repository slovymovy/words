                "senses": [
                    {
                        "sense_id": "6de12ce6-ef9f-3f66-9c96-6d60d3e4c0ad",
                        "entry_id": "3033bf84-1ab9-3856-a8f4-6d802e78f4dc",
                        "glosses": [
                            "zonder reden, onderbouwing, motivatie en/of bewijs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "917f1a56-039f-4936-a8d8-1f9f60fd3296",
                                "sense_id": "6de12ce6-ef9f-3f66-9c96-6d60d3e4c0ad",
                                "text": "Het is geen gratuite bewering, die samenhang is al vele malen aangetoond."
                            },
                            {
                                "example_id": "34ff7818-5d0e-48e8-a4cd-c8f00f4e2dff",
                                "sense_id": "6de12ce6-ef9f-3f66-9c96-6d60d3e4c0ad",
                                "text": "Hij verbaasde zich over het gratuite geweld in het computerspel."
                            }
                        ]
                    },
                    {
                        "sense_id": "fef79117-97c4-3527-a330-f28f4ad17fc8",
                        "entry_id": "3033bf84-1ab9-3856-a8f4-6d802e78f4dc",
                        "glosses": [
                            "zonder consequentie, vrijblijvend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37c46d59-568a-4525-a2e0-9500beb1d2ff",
                                "sense_id": "fef79117-97c4-3527-a330-f28f4ad17fc8",
                                "text": "Het is een gratuit gebaar, het kost niets en heeft geen consequenties dus mag niet als offer worden beschouwd."
                            },
                            {
                                "example_id": "c9973a88-8767-4b9a-acc0-ecdb88d7fa78",
                                "sense_id": "fef79117-97c4-3527-a330-f28f4ad17fc8",
                                "text": "Het is een gratuite bewering, ook als deze niet blijkt te kloppen zullen er geen consequenties zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "effbc640-ff50-4b4f-8f94-672dbc63518e",
