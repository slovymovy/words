                        "entry_id": "a8238dfe-f822-3d8a-9840-91877d03ed5e",
                        "glosses": [
                            "iemand die op een hoorn blaast (voor zijn beroep)"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "1d5a74cf-681a-4ec0-8b34-e194fff37425",
                                "sense_id": "982a6e3e-8168-38dd-a637-4aed46553a27",
                                "text": "Op het gezicht van iedereen, van Denisov tot en met de hoornblazer, lag om de lippen en de kin eenzelfde uitdrukking van vechtlust, spanning en opwinding."
                            },
                            {
                                "example_id": "34083194-3b4e-4682-9987-83b174fa97fb",
                                "sense_id": "982a6e3e-8168-38dd-a637-4aed46553a27",
                                "text": "Scholte, inmiddels 90, is vermoedelijk de laatste ooggetuige die nog in leven is. Elk jaar op 4 mei bezoekt hij het monument ter nagedachtenis aan de massa-executie, tot corona dat vorig jaar onmogelijk maakte. Ook dit jaar is een collectieve herdenking bij De Gevallen Hoornblazer in het Weteringplantsoen niet mogelijk."
                            }
                        ]
                    }
