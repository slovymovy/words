                        "entry_id": "2cda75d5-cd38-3bac-b269-66a975077d6e",
                        "glosses": [
                            "to pick or pluck off pills/nubs (from a fabric)"
                        ],
                        "tags": [
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "c96dc336-8fca-4370-a7bd-c792fee0fbf2",
                                "sense_id": "67d1ab5d-8fb1-36dc-a25a-b88fead10bb8",
                                "text": "Sie noppt den Wollpullover, bis alle Knötchen weg sind.",
                                "translation": "She picks the pills off the wool sweater until all the little knots are gone.",
                                "english": "She picks the pills off the wool sweater until all the little knots are gone."
                            }
                        ]
                    },
                    {
                        "sense_id": "337a77ad-8d1b-320c-b14d-757092dc7570",
                        "entry_id": "2cda75d5-cd38-3bac-b269-66a975077d6e",
                        "glosses": [
                            "to provide with nubs; to create a nubby texture"
                        ],
                        "tags": [
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "91872d3d-5d1e-4df8-8009-ca562a2228e5",
                                "sense_id": "337a77ad-8d1b-320c-b14d-757092dc7570",
                                "text": "Beim Spinnen kann man das Garn absichtlich noppen.",
                                "translation": "When spinning you can deliberately create nubs in the yarn.",
                                "english": "When spinning you can deliberately create nubs in the yarn."
                            }
                        ]
                    }
