                    {
                        "translation_id": "82fe0a3c-f8a4-470f-8b10-6c2044f524c9",
                        "source_entry_id": "595d2f27-f8c0-3c9d-aeb7-0c1867b39378",
                        "source_sense_description": "inflammation of the mucous membranes",
                        "target_lang_word": "catarrhe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catarrhe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "346a45f5-fb8f-3ef3-8b10-edaecaaa5fac",
                                        "entry_id": "bf3f9986-d05c-39d8-82ca-91028b9537c9",
                                        "glosses": [
                                            "Terme générique par lequel les anciens médecins ont désigné tout écoulement d’un liquide, plus ou moins clair ou épais, par une membrane muqueuse, quelle qu’en soit d’ailleurs la cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8b8798c-4c39-4cf4-8235-2103e8bfa77a",
                                                "sense_id": "346a45f5-fb8f-3ef3-8b10-edaecaaa5fac",
                                                "text": "Catarrhe pulmonaire. Catarrhe de la vessie, etc."
                                            },
                                            {
                                                "example_id": "ea8f24aa-0f83-4038-8706-abd133f74231",
                                                "sense_id": "346a45f5-fb8f-3ef3-8b10-edaecaaa5fac",
                                                "text": "À vingt pas de la porte, vous sentez je ne sais quelle odeur glaciale et fade d’eau bénite et de caveau sépulcral que vous apporte un courant d’air chargé de pleurésies et de catarrhes."
                                            },
                                            {
                                                "example_id": "7e2aa7bc-639f-4354-a9d6-be553f636154",
                                                "sense_id": "346a45f5-fb8f-3ef3-8b10-edaecaaa5fac",
                                                "text": "Les gamins le regardaient par les fentes du mur, et lui jetaient des cailloux, qui tombaient sur son grabat, où il gisait, continuellement secoué par un catarrhe, avec des cheveux très longs, les paupières enflammées, et au bras une tumeur plus grosse que sa tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1136ff67-6aec-3da7-a8fe-014785bab16a",
                                        "entry_id": "bf3f9986-d05c-39d8-82ca-91028b9537c9",
                                        "glosses": [
                                            "Gros rhume."
                                        ],
                                        "tags": [
                                            "Communément"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "491c2613-b1f1-4b04-884c-940bc8513bad",
                                                "sense_id": "1136ff67-6aec-3da7-a8fe-014785bab16a",
                                                "text": "Avant que de finir au plat sur ce granit\nÉtais-tu préposé au catarrhe au prurit\nOu bien à résoudre une quinte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee9b652c-29be-479d-91aa-d69ee6404106",
