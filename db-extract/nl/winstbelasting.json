                                "example_id": "b3883d4c-6d99-4f23-a7c1-24b4e26eabbb",
                                "sense_id": "633cf087-2d16-3604-9897-476e024c2a84",
                                "text": "Multinationals kunnen buitenlandse verliezen als aftrekpost opvoeren waardoor ze in Nederland nauwelijks winstbelasting betalen. Aan die situatie wil het kabinet een einde maken."
                            },
