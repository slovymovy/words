                ],
                "senses": [
                    {
                        "sense_id": "c2f368ff-7cfd-3ffd-9135-436a00bd9df9",
                        "entry_id": "8d1be352-a8d3-3274-afa1-07b50e6c2a65",
                        "glosses": [
                            "Akkordeon oder Ziehharmonika"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "5df5b91e-1ab5-426e-b22d-4b2578947871",
                                "sense_id": "c2f368ff-7cfd-3ffd-9135-436a00bd9df9",
                                "text": "Spiel mal was auf deiner Quetschkommode!"
                            },
                            {
                                "example_id": "b088e8cc-4259-4f62-89f8-c42a8f64a52f",
                                "sense_id": "c2f368ff-7cfd-3ffd-9135-436a00bd9df9",
                                "text": "„In der Wohnung links neben der Treppe müssen die Frauen mit ihren Gästen essen und trinken, singen und tanzen, denn einer der Soldaten hat eine Quetschkommode mitgebracht,, der er leichte und schwermütige russische Lieder entlockt.“"
                            },
                            {
                                "example_id": "4d3f1a89-8a1b-40e0-9215-9b72881d041d",
                                "sense_id": "c2f368ff-7cfd-3ffd-9135-436a00bd9df9",
                                "text": "„Albert Schweitzer, der Urwalddoktor aus Lambarene, hat zum Lobe Bachs georgelt, der saarländische Akkordeonspieler Stefan Hussong die Quetschkommode malträtiert, die Teenie-Virtuosin Vanessa Mae hat den Meister erbärmlich vergeigt und die HipHop-Formation Sweetbox aus Bach-Noten einen Hit gemixt.“"
                            },
                            {
                                "example_id": "5451ade2-e4c5-4ec6-8d5e-b3bd0d4010b5",
                                "sense_id": "c2f368ff-7cfd-3ffd-9135-436a00bd9df9",
                                "text": "„Eine Geige hatte ich mir gewünscht und diese Quetschkommode bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e79d7e2-48b3-45b4-8968-29baa5ce6a29",
