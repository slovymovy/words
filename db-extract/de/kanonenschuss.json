                "senses": [
                    {
                        "sense_id": "1897f6c5-2d6c-37a7-ad0b-d5564e1b4a54",
                        "entry_id": "b45c4d46-1820-3a60-bb2d-03ae68d17290",
                        "glosses": [
                            "Schuss, der aus einer Kanone abgefeuert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f33e7c6-3231-4978-8565-801684a4af99",
                                "sense_id": "1897f6c5-2d6c-37a7-ad0b-d5564e1b4a54",
                                "text": "„Um sieben Uhr ließen sie direkt gegenüber von Keta erneut den Anker fallen und feuerten drei Kanonenschüsse ab, um dem örtlichen Herrscher Ehre zu erweisen.“"
                            },
                            {
                                "example_id": "6088d301-7856-4adc-8f27-027efe105c66",
                                "sense_id": "1897f6c5-2d6c-37a7-ad0b-d5564e1b4a54",
                                "text": "Den Beginn der Feierlichkeiten markierte ein Kanonenschuss."
                            },
                            {
                                "example_id": "20bbe5c0-f1b5-4059-b332-643f6546b036",
                                "sense_id": "1897f6c5-2d6c-37a7-ad0b-d5564e1b4a54",
                                "text": "„Immer war der Feind nach einigen Kanonenschüssen in den Wäldern verschwunden.“"
                            },
                            {
                                "example_id": "25bc7350-6d5c-4e2f-8827-03a4b614a280",
                                "sense_id": "1897f6c5-2d6c-37a7-ad0b-d5564e1b4a54",
                                "text": "„Etwa um acht Uhr gesellte sich zum Gewehrfeuer auch das Krachen von Kanonenschüssen.“"
                            },
                            {
                                "example_id": "c7bdbab8-71f7-4dbb-ab5f-d746ade437cc",
                                "sense_id": "1897f6c5-2d6c-37a7-ad0b-d5564e1b4a54",
                                "text": "„In dieser verzweifelten Situation fühlte ich mich neu belebt, als Kanonenschüsse die Ankunft des Gesandten ankündigten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
