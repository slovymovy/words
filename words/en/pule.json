{
    "word_family": [
        "puling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88ecb769-5ce8-3d6a-a1c5-fd6d204c2421",
                    "sense_definition": "To whimper or whine in a weak or childish way.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "whining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>puling</w> child refused to stop crying until he received his favorite toy.",
                            "target_lang_translations": {
                                "ru": "<w>Хныкающий</w> ребенок отказывался перестать плакать, пока не получил свою любимую игрушку."
                            }
                        },
                        {
                            "text": "He <w>puled</w> about the unfair treatment instead of taking responsibility for his actions.",
                            "target_lang_translations": {
                                "ru": "Он <w>ныл</w> о несправедливом обращении вместо того, чтобы взять на себя ответственность за свои поступки."
                            }
                        }
                    ],
                    "synonyms": [
                        "whimper",
                        "whine",
                        "snivel"
                    ],
                    "common_phrases": [
                        "puling child"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скулить, ныть или плакать слабым, детским голосом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хныкать",
                                "target_lang_sense_clarification": "плакать или жаловаться слабым, раздражающим голосом"
                            },
                            {
                                "target_lang_word": "скулить",
                                "target_lang_sense_clarification": "издавать жалобные звуки, выражая недовольство или боль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5392186-d3d1-3715-9b8b-13767f41c849",
                    "sense_definition": "To make a high-pitched piping or chirping sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small birds <w>puled</w> softly in their nest as the sun began to rise.",
                            "target_lang_translations": {
                                "ru": "Маленькие птички тихо <w>попискивали</w> в гнезде, когда начало всходить солнце."
                            }
                        },
                        {
                            "text": "I could hear the insects <w>puling</w> in the tall grass during the quiet evening.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как насекомые <w>пищали</w> в высокой траве тихим вечером."
                            }
                        }
                    ],
                    "synonyms": [
                        "chirp",
                        "pipe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать высокий, тонкий писк или щебетание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пищать",
                                "target_lang_sense_clarification": "издавать тонкий, высокий звук"
                            },
                            {
                                "target_lang_word": "попискивать",
                                "target_lang_sense_clarification": "издавать слабые, прерывистые пищащие звуки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a8d5cdb-0539-3677-adee-666f96e3d5e3",
                    "sense_definition": "To fall in a continuous, light, and weak drizzle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>puling</w> rain made the afternoon feel gloomy and cold.",
                            "target_lang_translations": {
                                "ru": "<w>Моросящий</w> дождь сделал день мрачным и холодным."
                            }
                        },
                        {
                            "text": "We walked through the <w>puling</w> rain while heading back to the cabin.",
                            "target_lang_translations": {
                                "ru": "Мы шли под <w>моросящим</w> дождем, возвращаясь в хижину."
                            }
                        }
                    ],
                    "synonyms": [
                        "drizzle",
                        "sprinkle"
                    ],
                    "common_phrases": [
                        "puling rain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти непрерывным, мелким и слабым дождем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моросить",
                                "target_lang_sense_clarification": "идти мелким, слабым дождем"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "792d86ae-c209-35a0-9d36-11a983fca795",
                    "sense_definition": "A plaintive, melancholy, or weak whine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "whining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog let out a soft <w>pule</w> when it realized it was being left behind.",
                            "target_lang_translations": {
                                "ru": "Собака издала тихий <w>скулеж</w>, когда поняла, что ее оставляют."
                            }
                        },
                        {
                            "text": "I heard a faint <w>pule</w> coming from the dark corner of the room.",
                            "target_lang_translations": {
                                "ru": "Я услышал слабый <w>писк</w>, доносящийся из темного угла комнаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "whimper",
                        "whine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жалобный, меланхоличный или слабый скулеж."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скулеж",
                                "target_lang_sense_clarification": "жалобный звук, издаваемый животным или человеком"
                            },
                            {
                                "target_lang_word": "хныканье",
                                "target_lang_sense_clarification": "процесс или звук жалобного плача"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "751ce433-3ca4-3356-b654-20d9b44fb988",
                    "sense_definition": "A rare type of Serbian cheese produced from donkey milk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gourmet shop offered a small sample of expensive <w>pule</w> for the customers to try.",
                            "target_lang_translations": {
                                "ru": "В гастрономе предлагали небольшой образец дорогого сыра <w>пуле</w> для дегустации."
                            }
                        },
                        {
                            "text": "Many people are surprised to learn that <w>pule</w> is considered one of the most expensive cheeses in the world.",
                            "target_lang_translations": {
                                "ru": "Многие удивляются, узнав, что <w>пуле</w> считается одним из самых дорогих сыров в мире."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Associated with Serbia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Редкий вид сербского сыра, производимого из ослиного молока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пуле",
                                "target_lang_sense_clarification": "название редкого сорта сыра"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}