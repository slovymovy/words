                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4c16da0b-2b6b-317d-bec4-2dd953bc02dd",
                        "entry_id": "427afc8d-0404-3c61-a948-59dd508bf251",
                        "glosses": [
                            "onopvallend, rustig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cce9dbda-67ce-4297-9a2d-479e70d82fd9",
                                "sense_id": "4c16da0b-2b6b-317d-bec4-2dd953bc02dd",
                                "text": "Aandacht is er genoeg voor de nieuwe Vantage, ook zonder buitenissig rijgedrag. Dat komt deels door de neon-groen gekleurde diffusor onder onze witte auto, die een prachtig effect geeft, maar ook wel een beetje erg opvallend is. In een gedekte kleur kun je je echter ook aardig anoniem door het verkeer bewegen."
                            }
                        ]
                    },
                    {
                        "sense_id": "eeceda99-5823-3ba6-9cff-b090a8c0602b",
                        "entry_id": "427afc8d-0404-3c61-a948-59dd508bf251",
                        "glosses": [
                            "van een tafel dat deze is voorzien van al het benodigde eetgerei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feb5adb9-0551-4c87-980c-51ec1cc151e1",
                                "sense_id": "eeceda99-5823-3ba6-9cff-b090a8c0602b",
                                "text": "Het interieur ademt nog de sfeer van uit de textielfabriek. Waar vroeger in de Enschedese wijk Roombeek poetsdoeken werden geweven, serveert chef-kok Gaston Olde Olthof nu culinaire verrassingen en begeleiden gastvrouw Manita Driezen en gastheer Raymond Ruitenberg u naar een mooi gedekte tafel."
                            },
                            {
                                "example_id": "ef33c17a-dfdf-49a2-b0c6-4b85386b05dc",
                                "sense_id": "eeceda99-5823-3ba6-9cff-b090a8c0602b",
                                "text": "De tafels zijn hoopvol gedekt voor het diner, maar truckersrestaurant Le Mistral straalt een zekere mismoedigheid uit."
                            },
                            {
                                "example_id": "a0202b0f-08bb-48a5-9081-4f19b5286350",
                                "sense_id": "eeceda99-5823-3ba6-9cff-b090a8c0602b",
                                "text": "Ondertussen was de tafel mooi gedekt en stond hij vol eten."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba12fd4f-fbac-32d1-a03b-315e2db02304",
                        "entry_id": "427afc8d-0404-3c61-a948-59dd508bf251",
                        "glosses": [
                            "beschermd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5af7f7a-8971-41d6-ab64-513f3465d7ec",
                                "sense_id": "ba12fd4f-fbac-32d1-a03b-315e2db02304",
                                "text": "DNB wijst in een rapport over de zorgverzekeraars op een verontrustende ontwikkeling. Mensen nemen steeds vaker alleen een aanvullende verzekering als ze verwachten dat ze de daarin gedekte zorg nodig hebben. Oftewel: de aanvullende verzekering wordt steeds vaker maximaal gebruikt. En dat maakt de aanvullende zorgverzekering duurder en duurder."
                            }
                        ]
                    }
