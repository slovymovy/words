                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f16b1b96-46f3-472d-aa59-feb0414973c5",
                        "source_entry_id": "8138a84d-cb8a-3697-9a3c-a3c83cae9db8",
                        "source_sense_id": "591a127b-f2ea-38a0-b4e5-8a1d247ea09d",
                        "target_lang_word": "unheilbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unheilbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a470a42d-1f5c-3aa0-bc92-e6f1917ab2b8",
                                        "entry_id": "1f096d4a-10c8-3f50-bc76-e1565364d0d4",
                                        "glosses": [
                                            "ohne Aussicht auf oder Möglichkeit von Heilung; nicht heilbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b358b1f-2c0d-40c4-b700-b6ca35ce07f8",
                                                "sense_id": "a470a42d-1f5c-3aa0-bc92-e6f1917ab2b8",
                                                "text": "Er ist unheilbar an Krebs erkrankt."
                                            },
                                            {
                                                "example_id": "3233d87d-0321-4069-9ed5-7dcd6701ff7c",
                                                "sense_id": "a470a42d-1f5c-3aa0-bc92-e6f1917ab2b8",
                                                "text": "„Wenn Darmkrebs entdeckt wird, ist er sehr häufig in einem späten Stadium und damit unheilbar.“"
                                            },
                                            {
                                                "example_id": "6bc212f8-f398-48ae-9b02-49dbea24c533",
                                                "sense_id": "a470a42d-1f5c-3aa0-bc92-e6f1917ab2b8",
                                                "text": "Antikörper können aktive Krebszellen reduzieren oder sogar ausschalten. Das zeigt eine Reihe von Experimenten an sieben als unheilbar krank eingestuften Krebspatienten an der Universität Tübingen."
                                            },
                                            {
                                                "example_id": "a75f5f9e-4aa9-4b37-bd61-47642faf450e",
                                                "sense_id": "a470a42d-1f5c-3aa0-bc92-e6f1917ab2b8",
                                                "text": "Im Gegensatz zum Hospital, auch Krankenhaus genannt, sind Hospize nur für unheilbar kranke Menschen, die bald sterben werden, vorgesehen."
                                            },
                                            {
                                                "example_id": "3c7c6130-4577-4868-bbeb-6c52845a2409",
                                                "sense_id": "a470a42d-1f5c-3aa0-bc92-e6f1917ab2b8",
                                                "text": "Wenn ein unheilbar krankes Kind den Wunsch hat zu sterben, können belgische Ärzte künftig ganz legal seinen Tod herbeiführen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c97aecf8-f296-4433-a725-90ea51f5d770",
                        "source_entry_id": "8138a84d-cb8a-3697-9a3c-a3c83cae9db8",
