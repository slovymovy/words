                        "sense_id": "60b175d2-f0ae-3ff8-bfda-0d2b62b6d7c1",
                        "entry_id": "c7881773-7f7d-3453-b77c-8676be781f83",
                        "glosses": [
                            "Village des Pays-Bas situé dans la commune de L’Écluse."
                        ],
