                    {
                        "translation_id": "bfc36443-2306-4c24-bb20-7a44cce709f1",
                        "source_entry_id": "baa696b4-9927-318f-a127-353dac8a1e5e",
                        "source_sense_id": "758c9ce5-d1d7-3f2d-9eb9-3b9eaf1b471a",
                        "target_lang_word": "arachide",
                        "target_lang_code": "fr",
