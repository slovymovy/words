                    {
                        "sense_id": "bc3a88a3-ec18-3ae8-856f-82845b60bd90",
                        "entry_id": "74c4b4d0-a8ee-3252-a1f2-4fcf1d753b66",
                        "glosses": [
                            "wegen des geringen Sauerstoffgehalts der Luft in großen Höhen auftretende Beschwerden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80fcaf7a-6be0-489b-9251-bf0db7e82a77",
                                "sense_id": "bc3a88a3-ec18-3ae8-856f-82845b60bd90",
                                "text": "„Die Höhenkrankheit kann unbehandelt bis zum Tod führen.“"
                            },
                            {
                                "example_id": "5f2db4a1-6754-4f98-868e-c92b08bef81f",
                                "sense_id": "bc3a88a3-ec18-3ae8-856f-82845b60bd90",
                                "text": "„Eine Attacke der Höhenkrankheit hat den Bergsteiger ereilt und zwingt ihn, sein Vorhaben aufzugeben.“"
                            },
                            {
                                "example_id": "dc336c9c-5614-47f8-b580-dd9d4603ae15",
                                "sense_id": "bc3a88a3-ec18-3ae8-856f-82845b60bd90",
                                "text": "„Das bei Extremtouren immer wieder beschriebene Auftreten der Höhenkrankheit provoziert die Frage, inwieweit der Mensch überhaupt die Eignung und die Ausstattung mitbringt, sich als Erkunder solcher Höhenregionen zu betätigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
