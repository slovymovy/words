                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78a7be69-643f-4481-b9c6-b359e3e6cbb2",
                                                "sense_id": "cc7e9d10-5aff-3fdd-b721-b0c7e5e03789",
                                                "text": "We will never eliminate the crudenesses, the anti-intellectual rules, the mucker pose in higher education, until we give the universities back to faculty and students."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
