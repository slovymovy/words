                        "sense_id": "d49e1b34-913f-3501-8be6-e5d2545b87c8",
                        "entry_id": "035b6856-321c-37b9-ba27-4db72ca604f6",
                        "glosses": [
                            "Produire un batik par impression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e201c900-d72b-4d9d-8ff8-5fbf1a8ac4bc",
                                "sense_id": "d49e1b34-913f-3501-8be6-e5d2545b87c8",
                                "text": "Le ton crème est la teinte même du tissu tel qu'on l'emploie pour batiker."
                            },
                            {
                                "example_id": "52727c6c-fbb8-49b0-8eaf-9e731752f44e",
                                "sense_id": "d49e1b34-913f-3501-8be6-e5d2545b87c8",
                                "text": "Pour atteindre l'effet de couleurs souhaité elle teint, colore, batike elle-même ses tissus."
                            }
                        ]
                    }
