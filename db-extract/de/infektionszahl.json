                    {
                        "form_id": "5f8e338a-9da5-4822-9bcf-e2e7979d29c8",
                        "entry_id": "4a5a6dd6-122c-3ade-9d97-96dfb7f1292c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Infektionszahlen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8146fe5b-507c-38ed-afe8-145c2edab066",
                        "entry_id": "4a5a6dd6-122c-3ade-9d97-96dfb7f1292c",
                        "glosses": [
                            "Angabe (Zahl), die über die Verbreitung und das Ausmaß einer Infektionskrankheit informiert, zum Beispiel die Anzahl der Neuinfektionen/Neuerkrankungen; Angabe der Infizierten in Prozent Angabe der Gesamtanzahl aller Infizierten in einer untersuchten Gruppe"
                        ],
                        "tags": [
                            "Infektiologie",
                            "auch",
                            "oder"
                        ],
                        "examples": [
                            {
                                "example_id": "1e26328f-abcc-498b-9e09-d0d5fc83ca6d",
                                "sense_id": "8146fe5b-507c-38ed-afe8-145c2edab066",
                                "text": "„Die Infektionszahl betrug in 13 Städten 12,6 % gegen 6,6 % auf den Farmen.“ (1932)"
                            },
                            {
                                "example_id": "14707516-7597-452e-b577-1cc096d85650",
                                "sense_id": "8146fe5b-507c-38ed-afe8-145c2edab066",
                                "text": "„Die Arbeit gibt einen Überblick über die Infektionszahl, Morbidität und Mortalität der Tbc, die als eine Weltpandemie bekannt ist.“ (1958)"
                            },
                            {
                                "example_id": "94b25b1a-af1b-4a8a-97ba-193d830d7ace",
                                "sense_id": "8146fe5b-507c-38ed-afe8-145c2edab066",
                                "text": "„Die konstante Medienberichterstattung, die im halbstündlichen Takt die Infektionszahlen und Todesfälle veröffentlichte, hielt die Beunruhigung innerhalb der Bevölkerung hoch.“"
                            },
                            {
                                "example_id": "7eaef8cb-70e1-44e3-9dd0-c76e458e9a6e",
                                "sense_id": "8146fe5b-507c-38ed-afe8-145c2edab066",
                                "text": "„Derzeit übersteigt in Deutschland außerdem ein Landkreis die von Bund und Ländern als Obergrenze angesehene Infektionszahl. Dabei handelt es sich um den Kreis Greiz in Thüringen. Er registrierte dem RKI zufolge 80,5 Infektionen pro 100.000 Einwohner in den vergangenen sieben Tagen.“"
                            },
                            {
                                "example_id": "9ceb3320-e616-400f-bff0-e1c6b46f5c6d",
                                "sense_id": "8146fe5b-507c-38ed-afe8-145c2edab066",
                                "text": "Eine Region mit erhöhten Infektionszahlen ist ein Hotspot."
                            },
                            {
                                "example_id": "53b4d983-210f-4696-84a8-d64baa3ffd06",
                                "sense_id": "8146fe5b-507c-38ed-afe8-145c2edab066",
                                "text": "„»Wenn die Infektionszahlen stark ansteigen, ist es natürlich schlecht, wenn man gleichzeitig Maßnahmen aufhebt und das Infektionsgeschehen dadurch noch ankurbelt.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
