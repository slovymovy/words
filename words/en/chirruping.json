                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19817067-a1d4-335c-a230-9af14aa942dc",
                    "sense_definition": "A chirrup sound, or the act of producing repeated high-pitched sounds like a bird or insect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chirrup_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet morning was broken by the cheerful <w>chirruping</w> of sparrows.",
                            "target_lang_translations": {
                                "zh": "清晨的寂静被麻雀欢快的<w>啁啾声</w>打破了。"
                            }
                        },
                        {
                            "text": "We fell asleep to the continuous <w>chirruping</w> of grasshoppers outside.",
                            "target_lang_translations": {
                                "zh": "我们伴着外面蚱蜢连绵不断的<w>唧唧声</w>入睡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chirping",
                        "twittering",
                        "chittering"
                    ],
                    "common_phrases": [
                        "chirruping of birds",
                        "cheerful chirruping"
                    ],
                    "target_lang_definitions": {
                        "zh": "啁啾声，唧唧声（鸟或昆虫发出的清脆叫声）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "啁啾声",
                                "target_lang_sense_clarification": "鸟类轻快的叫声"
                            },
                            {
                                "target_lang_word": "唧唧声",
                                "target_lang_sense_clarification": "蟋蟀、虫子或小鸟的叫声"
                            },
                            {
                                "target_lang_word": "鸣叫声",
                                "target_lang_sense_clarification": "鸟虫的发声"
                            }
                        ]
