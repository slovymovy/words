                "senses": [
                    {
                        "sense_id": "520f484d-1aaf-3cd3-a927-5489340dbfb5",
                        "entry_id": "454a64d8-c8e5-3ef9-b899-afab9730e1fc",
                        "glosses": [
                            "Enlever la chlorophylle de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3878e309-e08e-4e33-bcdb-27a4ab221f24",
                                "sense_id": "520f484d-1aaf-3cd3-a927-5489340dbfb5",
                                "text": "...sinon le magnétisme peut momifier la viande pourquoi pas \"déchlorophyller\" les végétaux..."
                            },
                            {
                                "example_id": "11f84a93-41d7-4102-9411-08dcd6e0e38a",
                                "sense_id": "520f484d-1aaf-3cd3-a927-5489340dbfb5",
                                "text": "L'invention concerne en outre une préparation de RuBisCO déchlorophyllée particulaire qui est obtenue par le procédé susmentionné, ladite préparation ayant un diamètre moyen en poids de 10 à 1000 µm ; contenant au moins 30 % en poids de RuBisCO non dénaturé et contenant moins de 0,1 % de chlorophylle en poids de RuBisCO."
                            },
                            {
                                "example_id": "18086487-db3a-4a9a-a2ea-7a727f799494",
                                "sense_id": "520f484d-1aaf-3cd3-a927-5489340dbfb5",
                                "text": "J'ai essayé de la déchlorophyller aussi, mais du coup elle a pris un ptit coup d'azur !"
                            }
                        ]
                    }
