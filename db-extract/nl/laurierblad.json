                "senses": [
                    {
                        "sense_id": "405a7438-c8b1-35bc-8733-615596e22590",
                        "entry_id": "e985f5ea-eaef-3810-8844-dff7b4750dcd",
                        "glosses": [
                            "loof van Laurus nobilis"
                        ],
                        "tags": [
                            "wikidata: laurierblad"
                        ],
                        "examples": [
                            {
                                "example_id": "6c58e35b-d9c6-4ad5-850d-515ac3d9ecc3",
                                "sense_id": "405a7438-c8b1-35bc-8733-615596e22590",
                                "text": "Europese zonnewende (Eliotrophia): deze moet geplukt worden in augustus als de zon zich in het teken Leo (Leeuw) bevindt. Wanneer iemand het bij zich draagt, gewikkeld in een laurierblad samen met de tand van een wolf, dan zal iedereen hem vriendschap betonen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7fb7fa56-04be-3069-8296-f54c1e2334f3",
                        "entry_id": "e985f5ea-eaef-3810-8844-dff7b4750dcd",
                        "glosses": [
                            "bladeren van Laurus nobilis gebruikt in de keuken"
                        ],
                        "tags": [
                            "kruid",
                            "wikidata: laurierblad",
                            "gedroogde"
                        ],
                        "examples": [
                            {
                                "example_id": "41d6eb2a-3666-4784-b5d3-880f4be3cd4b",
                                "sense_id": "7fb7fa56-04be-3069-8296-f54c1e2334f3",
                                "text": "Knijp de teentjes knoflook uit hun velletje in de pan, doe er het laurierblad bij en laat het geheel 10 minuten pruttelen. Zet de pan van het vuur en vis er het laurierblad uit."
                            }
                        ]
                    }
                ],
