                "senses": [
                    {
                        "sense_id": "9f8cd221-9767-3965-a9f3-2f250b6e8469",
                        "entry_id": "d3e45631-19f7-3dff-a75d-2d074ba742fb",
                        "glosses": [
                            "einfaches Gefährt, das von einer Person gezogen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73073c68-68b6-4382-a42c-00c31d59e3b5",
                                "sense_id": "9f8cd221-9767-3965-a9f3-2f250b6e8469",
                                "text": "„Er schob einen Handkarren, an den man ihn mit einer kurzen Kette angebunden hatte, und wurde vom Gefängniskoch und zwei von Garcias Soldaten begleitet.“"
                            },
                            {
                                "example_id": "502c5ed5-17bb-4bc7-843b-5710893e95ce",
                                "sense_id": "9f8cd221-9767-3965-a9f3-2f250b6e8469",
                                "text": "„Die weißen Lichtkegel der Laternen zitterten hilflos in einen Schneesturm hinein, der dem starken Wagen das geruhsame Hinrollen eines Handkarrens aufzwang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
