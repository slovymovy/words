                "forms": [],
                "senses": [
                    {
                        "sense_id": "fcaa6349-f318-39f3-8096-42451cbfd815",
                        "entry_id": "253d4fc2-42ef-310f-86a7-2a498d05c1b9",
                        "glosses": [
                            "Aneinanderreihung, Reihenfolge, Verkettung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "439ab38a-7461-4f60-8fd3-60b362508070",
                                "sense_id": "fcaa6349-f318-39f3-8096-42451cbfd815",
                                "text": "Un enchaînement malheureux de causes et d'effets a mené à la catastrophe ferroviaire de 1998 à Eschede."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b0fd8d1-5eeb-47e3-8bd0-fc23d98837c1",
                        "source_entry_id": "253d4fc2-42ef-310f-86a7-2a498d05c1b9",
                        "source_sense_id": "fcaa6349-f318-39f3-8096-42451cbfd815",
                        "source_sense_description": "Aneinanderreihung, Reihenfolge, Verkettung",
                        "target_lang_word": "Aneinanderreihung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aneinanderreihung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ece70f7-457a-3c7b-aba1-8cf66fa61b5e",
                                        "entry_id": "98957a3c-3372-3ee7-a5f5-018ed3db31fb",
                                        "glosses": [
                                            "Handlung, Dinge nebeneinander anzuordnen, und Ergebnis dieser Aktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0035e116-2bda-49dd-a05d-9113bdbec887",
                                                "sense_id": "7ece70f7-457a-3c7b-aba1-8cf66fa61b5e",
                                                "text": "„Wer will, kann das Ganze eine Collage nennen, aber es ist mehr, mehr als eine Aneinanderreihung von Fundstücken.“"
                                            },
                                            {
                                                "example_id": "4e53af64-e683-427d-b93b-8de59dd98c4a",
                                                "sense_id": "7ece70f7-457a-3c7b-aba1-8cf66fa61b5e",
                                                "text": "„Aber die Aneinanderreihung einer möglichst großen Zahl an Details ist auch gar kein sinnvoller Weg, eine wissenschaftliche Disziplin wie die Insektenkunde zu erschließen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27495cde-7b67-4430-bc44-c65a26065d00",
                        "source_entry_id": "253d4fc2-42ef-310f-86a7-2a498d05c1b9",
                        "source_sense_id": "fcaa6349-f318-39f3-8096-42451cbfd815",
                        "source_sense_description": "Aneinanderreihung, Reihenfolge, Verkettung",
                        "target_lang_word": "Reihenfolge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reihenfolge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85ea306c-0c84-3450-b754-8ddd1d8592d6",
                                        "entry_id": "d6c575a2-a2fa-38af-a5d0-4b6e7f0df683",
                                        "glosses": [
                                            "geregelte, ordnungsgemäße Aufeinanderfolge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd067d1b-ffa7-4ff7-924f-026bcad7b1a4",
                                                "sense_id": "85ea306c-0c84-3450-b754-8ddd1d8592d6",
                                                "text": "In welcher Reihenfolge sind denn die Anträge eingegangen?"
                                            },
                                            {
                                                "example_id": "7de98c54-5eae-49ed-9dc3-75df074b20fc",
                                                "sense_id": "85ea306c-0c84-3450-b754-8ddd1d8592d6",
                                                "text": "Sie mag gerne mal in umgekehrter Reihenfolge vorgehen."
                                            },
                                            {
                                                "example_id": "5a7777d9-028d-4483-8b6e-631d5307c30a",
                                                "sense_id": "85ea306c-0c84-3450-b754-8ddd1d8592d6",
                                                "text": "Die Patienten bekamen der Reihenfolge nach ihre Anti-Grippe-Spritze."
                                            },
                                            {
                                                "example_id": "bdc46589-f3c6-4b35-8c34-2f709d54e6eb",
                                                "sense_id": "85ea306c-0c84-3450-b754-8ddd1d8592d6",
                                                "text": "Die richtige Reihenfolge ist wichtig."
                                            },
                                            {
                                                "example_id": "2a6cbafc-0a23-466f-94f1-e7977b55244a",
                                                "sense_id": "85ea306c-0c84-3450-b754-8ddd1d8592d6",
                                                "text": "Hier haben Sie noch einmal alle Seiten in der richtigen Reihenfolge."
                                            },
                                            {
                                                "example_id": "76b3805e-a057-409b-81a3-b2327c6b723f",
                                                "sense_id": "85ea306c-0c84-3450-b754-8ddd1d8592d6",
                                                "text": "„Das Abendessen kam in der gehörigen Reihenfolge durch die drehbare Anrichte, jeder Gang jeweils auf zwei Tellern.“"
                                            },
                                            {
                                                "example_id": "8939633a-77e0-4e3e-a12c-9d1be1a7d2c3",
                                                "sense_id": "85ea306c-0c84-3450-b754-8ddd1d8592d6",
                                                "text": "„Dann beobachtete er sorgsam, wie die Teller gewechselt wurden, schnalzte ärgerlich mit der Zunge, als eine der Schüsseln anscheinend in falscher Reihenfolge vom Tablett auf den Tisch gesetzt wurde.“"
                                            },
                                            {
                                                "example_id": "f726a757-f004-480b-b292-91bc33942b1c",
                                                "sense_id": "85ea306c-0c84-3450-b754-8ddd1d8592d6",
                                                "text": "„Für die Reihenfolge des Einschenkens gibt es Regeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60e5f7a2-8c60-4ce3-8add-e0d5033bebbe",
                        "source_entry_id": "253d4fc2-42ef-310f-86a7-2a498d05c1b9",
