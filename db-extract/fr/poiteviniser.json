                "senses": [
                    {
                        "sense_id": "57cdea8e-3259-3534-b12d-918021053131",
                        "entry_id": "c207578f-3e52-3e5f-b9c9-b18f41c208b3",
                        "glosses": [
                            "Donner un caractère rappelant le poisson (ou les poissons) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "697d0170-27bd-4a27-ab40-936a9c846b69",
                                "sense_id": "57cdea8e-3259-3534-b12d-918021053131",
                                "text": "Les \"Poitevinistes\" ont tendance à refaire l'histoire, à annexer les gabacheries cises en Gascogne, à poiteviniser l'histoire de la Saintonge et de l'Aunis."
                            },
                            {
                                "example_id": "2e997b9e-b107-4715-acdc-348974ed7b89",
                                "sense_id": "57cdea8e-3259-3534-b12d-918021053131",
                                "text": "Parfois le ms. 5714 altère la forme de Lee 5714* de manière curieuse, mais le plus souvent il la conserve fidèlement alors que le ms. Lee la poitevinise."
                            },
                            {
                                "example_id": "488f1a8b-fd75-4cf1-ae1f-37be7e130d21",
                                "sense_id": "57cdea8e-3259-3534-b12d-918021053131",
                                "text": "Il a poitevinisé le nom de Jean-Jacques Chevrier (Jhan-Jhaquét Chebrét) alors que ce dernier ne le fait, à ma connaissance, jamais."
                            }
                        ]
                    }
                ],
