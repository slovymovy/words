                "senses": [
                    {
                        "sense_id": "33230308-c75a-386d-83a0-12dad2288816",
                        "entry_id": "bca180a7-877a-38d3-8ded-1670ac278b43",
                        "glosses": [
                            "Foolish; idiotic or simple-minded."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26f02b0d-d6b6-4975-867e-48bc86fd6970",
                                "sense_id": "33230308-c75a-386d-83a0-12dad2288816",
                                "text": "An evil, however, accompanied the benefit; shoals of worthless authors sprang up, and you may still perceive the garreteer drawing upon his lackwit brain for some production, the labour of which he expects will be paid by the declaration of his country, that a second Boileau, a Montesquieu, or a Racine has at length appeared."
                            },
                            {
                                "example_id": "f6918c5d-0399-46b9-a98b-e5b9c995bbc7",
                                "sense_id": "33230308-c75a-386d-83a0-12dad2288816",
                                "text": "One wall was painted with the story of St Robert the hermit and his persecution by Sir William de Stuteville, while the other depicted the cowherd Caedmon, albeit looking too lackwit to herd a hen let alone wax lyrical."
                            },
                            {
                                "example_id": "7313829d-ad2b-4ab7-8349-3ff31e7928bb",
                                "sense_id": "33230308-c75a-386d-83a0-12dad2288816",
                                "text": "Your fault for bein' so lackwit, ours for givin' you leave."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54d81a5f-30b5-4a6f-a74a-50e60feea4fd",
                        "source_entry_id": "bca180a7-877a-38d3-8ded-1670ac278b43",
                        "source_sense_id": "33230308-c75a-386d-83a0-12dad2288816",
                        "source_sense_description": "foolish, simple-mimded",
                        "target_lang_word": "töricht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "töricht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62d658c5-1022-3c0e-b322-e96c46f36db0",
                                        "entry_id": "509a411f-00c0-3be9-9d23-161856b7659f",
                                        "glosses": [
                                            "ohne Vernunft und Überlegung"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daac3354-8ce8-4925-96cd-f2dd12bc0b38",
                                                "sense_id": "62d658c5-1022-3c0e-b322-e96c46f36db0",
                                                "text": "Es wäre äußerst töricht, wenn du dieses Stellenangebot ausschlügest."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c43146f-47c8-3f8b-ab58-514775d3e5c5",
                                        "entry_id": "509a411f-00c0-3be9-9d23-161856b7659f",
                                        "glosses": [
                                            "keinen Argwohn zeigend; nicht besonders schlau, klug"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f96ceb1d-4d15-4322-ab63-43e7fd9b9462",
                                                "sense_id": "4c43146f-47c8-3f8b-ab58-514775d3e5c5",
                                                "text": "Immer wenn ich dich etwas frage, lächelst du nur töricht zurück."
                                            },
                                            {
                                                "example_id": "3ef720bb-8232-4c38-9775-ab1ae9c3a8c2",
                                                "sense_id": "4c43146f-47c8-3f8b-ab58-514775d3e5c5",
                                                "text": "„Man kann hier natürlich sagen, das Tier sei zu töricht, um die Sinnlosigkeit seines Verfahrens einzusehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a228e2ba-ab87-37cc-9207-4e7309785ca5",
                                        "entry_id": "509a411f-00c0-3be9-9d23-161856b7659f",
                                        "glosses": [
                                            "ohne Erfolg oder Hoffnung, sich nicht lohnend"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3e748a3-154d-4df8-9934-aaeaea152092",
                                                "sense_id": "a228e2ba-ab87-37cc-9207-4e7309785ca5",
                                                "text": "„Meine Schwester hofft auch nach 20 Jahren noch auf die Rückkehr ihres in Afrika verschwundenen Gatten.“ — „Tja, das ist wohl eine törichte Hoffnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "267c5120-ca90-36ae-874d-24000eb01814",
                                        "entry_id": "509a411f-00c0-3be9-9d23-161856b7659f",
                                        "glosses": [
                                            "besonders seltsam, unsinnig oder ärgerlich wirkend"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfb35c15-3d76-46da-9251-b47b6d7c242e",
                                                "sense_id": "267c5120-ca90-36ae-874d-24000eb01814",
                                                "text": "Dein ewiges törichtes Verhalten bei Tisch kannst du dir mal abgewöhnen."
                                            },
                                            {
                                                "example_id": "38f737e3-3e82-48e3-a2b1-5b249a1da03e",
                                                "sense_id": "267c5120-ca90-36ae-874d-24000eb01814",
                                                "text": "Selbst im Hirn des weisesten Mannes gibt es einen törichten Winkel. (Aristoteles 384–322 v.Chr.)"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a5abfe8-b2cb-4f30-bcad-f10e6bdd995d",
                        "source_entry_id": "bca180a7-877a-38d3-8ded-1670ac278b43",
                        "source_sense_id": "33230308-c75a-386d-83a0-12dad2288816",
