                "senses": [
                    {
                        "sense_id": "683c9e44-6820-3215-b231-7c56d42ae04f",
                        "entry_id": "a23c0f49-a140-34e7-b1a0-ac4193e85d31",
                        "glosses": [
                            "Enlever son caractère amalgamé à quelque chose, séparer, ne plus faire l’amalgame."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7e48cd2-1769-4494-a02f-6c162ec06669",
                                "sense_id": "683c9e44-6820-3215-b231-7c56d42ae04f",
                                "text": "La tâche critique est d'abord de désamalgamer « communautaire » et « communautarisme » (pp.55-56)."
                            },
                            {
                                "example_id": "b3c17892-8701-4a3e-b6f9-1d409d0877b6",
                                "sense_id": "683c9e44-6820-3215-b231-7c56d42ae04f",
                                "text": "Désamalgamer les éléments scientifiques, même s’ils sont contradictoires, des éléments d’éthique de l’environnement et des éléments de symbolique conduit à une nouvelle articulation de l’ensemble des discours pour prendre des décisions plus éclairées."
                            }
                        ]
                    }
