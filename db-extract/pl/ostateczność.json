                                        "sense_id": "af8339b6-d887-3fc5-9e7d-eaaf2043af05",
                                        "entry_id": "811bedca-ae5d-327b-b984-d45dc0592d74",
                                        "glosses": [
                                            "The condition of being ultimate"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f61d8959-e2ea-4d88-bc32-dd71a9327485",
                                                "sense_id": "af8339b6-d887-3fc5-9e7d-eaaf2043af05",
                                                "text": "The ultimacy of God's eschatological revelation impinges proleptically on . . . and, then, it all gets over my head."
                                            }
                                        ]
                                    }
                                ]
