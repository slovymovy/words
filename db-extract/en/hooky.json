        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e92d8ea5-82fd-3a9f-8305-8dae92a40c0a",
                "word": "hooky",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1de6a0d1-a4e6-41c9-a538-ad08afafdee4",
                        "entry_id": "e92d8ea5-82fd-3a9f-8305-8dae92a40c0a",
                        "tags": [
                            "comparative"
                        ],
                        "form": "hookier"
                    },
                    {
                        "form_id": "05a2571c-b594-4b11-a5eb-698cae3a40f7",
                        "entry_id": "e92d8ea5-82fd-3a9f-8305-8dae92a40c0a",
                        "tags": [
                            "superlative"
                        ],
                        "form": "hookiest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21c9d360-fd00-37b9-b055-865a20a58aec",
                        "entry_id": "e92d8ea5-82fd-3a9f-8305-8dae92a40c0a",
                        "glosses": [
                            "Full of hooks (in any sense)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b31ea7a6-77dd-4e1c-a745-b3092fc1bf60",
                                "sense_id": "21c9d360-fd00-37b9-b055-865a20a58aec",
                                "text": "Sew the hooky half of the Velcro on the inner side so that it doesn't pick up fluff."
                            },
                            {
                                "example_id": "8031d571-b07b-4d0d-aaeb-1d222333ebb4",
                                "sense_id": "21c9d360-fd00-37b9-b055-865a20a58aec",
                                "text": "At least the mostly instrumental kickoff “Long Tailed Winter Bird” offers a hooky acoustic guitar riff you can’t blame McCartney for hanging on to as long as he does."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed74709a-5ab6-3efa-a75c-abcbd92c0425",
                        "entry_id": "e92d8ea5-82fd-3a9f-8305-8dae92a40c0a",
                        "glosses": [
                            "Shaped like or resembling a hook; hooked."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9e63d79f-85ed-358e-a255-2b038f6dbd9a",
                        "entry_id": "e92d8ea5-82fd-3a9f-8305-8dae92a40c0a",
                        "glosses": [
                            "Dodgy; crooked; illicit."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a4075a8c-fc30-4316-a274-9ba1e5b093d8",
                                "sense_id": "9e63d79f-85ed-358e-a255-2b038f6dbd9a",
                                "text": "Start a thing in the street and attract attention to bags full of hooky gear? No. She was smarter than that."
                            },
                            {
                                "example_id": "3f7a35a3-5551-41d6-8449-75f720d9cfbc",
                                "sense_id": "9e63d79f-85ed-358e-a255-2b038f6dbd9a",
                                "text": "So I decided to put on my seediest voice and leer, and go round offering the traders the Cole line in cheap hooky goods."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a0c0ef19-6816-3e2d-962c-3f42010e7119",
                "word": "hooky",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "41c8701a-e4da-33b7-871c-dfadd4460690",
                        "entry_id": "a0c0ef19-6816-3e2d-962c-3f42010e7119",
                        "glosses": [
                            "Absence from school or work; truancy."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1b7879ef-fc22-4a79-a72e-9925ec6a9c0e",
                                "sense_id": "41c8701a-e4da-33b7-871c-dfadd4460690",
                                "text": "Let's play hooky and go to the mall."
                            },
                            {
                                "example_id": "59e038a4-5de3-4628-b6b7-9fb6a0251751",
                                "sense_id": "41c8701a-e4da-33b7-871c-dfadd4460690",
                                "text": "I was already two years late getting to college. I was twenty, not eighteen like most people who were about to graduate. All that hooky playing, stealing, and getting sent to juvenile jails had set me way back."
                            }
                        ]
                    }
                ],
