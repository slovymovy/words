                    },
                    {
                        "form_id": "4c7efe5d-2aef-4898-b450-3d92b855a612",
                        "entry_id": "76c3f293-5ee1-30ca-8204-6df97b38dcee",
                        "tags": [
                            "Ancient"
                        ],
                        "form": "nomenclator"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2bbbf9b8-31e9-35ad-af64-70920b89c911",
                        "entry_id": "76c3f293-5ee1-30ca-8204-6df97b38dcee",
                        "glosses": [
                            "Esclave dont les romains qui briguaient les magistratures se faisaient accompagner, afin qu’il leur dît le nom des citoyens qu’ils rencontraient et qu’ils avaient intérêt à saluer."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4229b3c2-f780-37af-bb77-66998a5afa85",
                        "entry_id": "76c3f293-5ee1-30ca-8204-6df97b38dcee",
                        "glosses": [
                            "Celui qui s’occupe de la nomenclature d’une science ou d’un art."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83f7851f-cf63-41b6-a0ce-3c077cfb1f83",
                                "sense_id": "4229b3c2-f780-37af-bb77-66998a5afa85",
                                "text": "Balzac c’est le nomenclateur du mobilier social, c’est historien des mœurs ; Proust c’est l’écoute de la psychologie, c’est un moi obsédé par soi-même."
                            },
                            {
                                "example_id": "316228f5-4258-4024-bc6c-b1e27a11c211",
                                "sense_id": "4229b3c2-f780-37af-bb77-66998a5afa85",
                                "text": "L'âne et le cheval viennent-ils donc originairement de la même souche ? sont-ils, comme le disent les nomenclateurs, de la même famille ? ou ne sont-ils pas, et n'ont-ils pas toujours été, des animaux différents ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5fbe2c7-25e8-4234-b385-961bce5bb0a9",
                        "source_entry_id": "76c3f293-5ee1-30ca-8204-6df97b38dcee",
                        "source_sense_description": "esclave chargé de nommer les personnes importantes",
                        "target_lang_word": "nomenclator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nomenclator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6262bc67-3f21-36c6-9172-6509c727d1e9",
                                        "entry_id": "30da1d3a-eea1-3e68-bc31-15d40dae3a96",
                                        "glosses": [
                                            "An assistant who specializes in providing timely and spatially relevant reminders of the names of persons and other socially important information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "725e5dcc-b291-4d78-9431-4a4d66e85bc6",
                                                "sense_id": "6262bc67-3f21-36c6-9172-6509c727d1e9",
                                                "text": "If he does not know them, it is deception to pretend that he does, while all the time he has never heard of them until instructed by the nomenclator."
                                            },
                                            {
                                                "example_id": "cdd46f3e-4adc-4364-a37a-48f70ca8fcaf",
                                                "sense_id": "6262bc67-3f21-36c6-9172-6509c727d1e9",
                                                "text": "Pray, do you suppose that those books of names, which your nomenclator can hardly carry or remember, are those of friends ?"
                                            },
                                            {
                                                "example_id": "424d2a3b-0720-4f64-a66e-d1166f0599cd",
                                                "sense_id": "6262bc67-3f21-36c6-9172-6509c727d1e9",
                                                "text": "Daw. I have brought some ladies here to see and know you. My Lady Haughty [as he presents them severally, EPI. kisses them.]—this my Lady Centaure — Mistress Dol Mavis — Mistress Trusty, my Lady Haughty's woman. Where's your husband ? let's see him: can he endure no noise? let me come to him.\nMor. What nomenclator is this !\nTrue. Sir John Daw, sir, your wife's servant, this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a424d0b1-1756-3710-b917-aa38a99ef5f0",
                                        "entry_id": "30da1d3a-eea1-3e68-bc31-15d40dae3a96",
                                        "glosses": [
                                            "One who assigns or constructs names for persons or objects or classes thereof, as in a scientific classification system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e274db46-a2d5-44f3-9501-0245c606feb7",
                                                "sense_id": "a424d0b1-1756-3710-b917-aa38a99ef5f0",
                                                "text": "The nomenclator's method is first to look about and see if the place has any natural features to suggest a name—like Rocking Stone Farm or White Birches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0711d629-1c9c-3e9d-96ad-94228843da5b",
                                        "entry_id": "30da1d3a-eea1-3e68-bc31-15d40dae3a96",
                                        "glosses": [
                                            "A document containing such name assignments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1754d33-7828-3f10-953c-16cc24c6dc5f",
                                        "entry_id": "30da1d3a-eea1-3e68-bc31-15d40dae3a96",
                                        "glosses": [
                                            "An early form of substitution cipher."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
