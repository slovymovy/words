                                            {
                                                "example_id": "d29dde38-6832-444e-929f-e0ee9114f737",
                                                "sense_id": "13c50e66-1483-3b6d-beba-bbc4544eed32",
                                                "text": "„Von der ersten Ausgabe mit einem Leitartikel in Dari und in Paschtunisch wurden 20000 Exemplare verkauft.“"
                                            },
                                            {
                                                "example_id": "952fee0a-63a2-4bb6-88c1-07ac937ba0e7",
                                                "sense_id": "13c50e66-1483-3b6d-beba-bbc4544eed32",
                                                "text": "„die Stämme im Südwesten, in Khuzistan, sprachen Arabaisch, die Belutschen im Südosten des Landes Paschtunisch, während im Nordosten und Norden Turkmenisch gesprochen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
