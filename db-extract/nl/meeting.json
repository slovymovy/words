                                                "example_id": "903b9e11-4b69-48a3-944e-9637a5b32c12",
                                                "sense_id": "a9fe5491-1fd6-3b13-bae5-1537001b4358",
                                                "text": "In a meeting with government officials, Moon noted that China was “much more advanced” than South Korea in rain-making technologies, his spokesman said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1c8c872-e0ed-3c94-b7c5-1fde2ff35562",
