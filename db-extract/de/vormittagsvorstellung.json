                        "examples": [
                            {
                                "example_id": "a85e95b5-9c8f-4f75-8702-c03787d4e26b",
                                "sense_id": "56ca3bce-49b1-31b2-8d2c-e5637fd7ec54",
                                "text": "„Die Vormittagsvorstellung sei angesetzt worden, weil die Wiener Philharmoniker gebeten hätten, am Abend des 31. August wieder nach Wien zurückfahren zu können, da sie am 1. September ihren ‚Dienst‘ als Staatsopernorchester anzutreten haben.“"
                            },
                            {
                                "example_id": "43c7ebbf-4a43-4595-8419-75b79e34c118",
                                "sense_id": "56ca3bce-49b1-31b2-8d2c-e5637fd7ec54",
                                "text": "„Restkarten gibt es noch für die Vormittagsvorstellung am Freitag, 17. März, Beginn 10 Uhr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
