                ],
                "senses": [
                    {
                        "sense_id": "62d761a4-c5ce-3acd-acec-6a91f7080393",
                        "entry_id": "501ec246-57a4-3423-a4f2-083cb154d1eb",
                        "glosses": [
                            "To remove the ions from; to deprive of ions.",
                            "To cause (an ionized substance) to return to a neutral state; to convert (an ion) into a neutral atom or molecule."
                        ],
                        "tags": [
                            "physical",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d855cd5b-ae0c-3409-a6c0-60a3f2fdb04c",
                        "entry_id": "501ec246-57a4-3423-a4f2-083cb154d1eb",
                        "glosses": [
                            "To remove the ions from; to deprive of ions.",
                            "To remove the ionic constituents from (a liquid, e.g. water)."
                        ],
                        "tags": [
                            "physical",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "41ea0b7b-cde7-4d3e-b84c-0c80db9b1e97",
                                "sense_id": "d855cd5b-ae0c-3409-a6c0-60a3f2fdb04c",
                                "text": "Water can be deionized using ion exchange resins."
                            }
                        ]
                    },
                    {
                        "sense_id": "abf6b288-c621-3e37-ac39-06c7a7b88937",
                        "entry_id": "501ec246-57a4-3423-a4f2-083cb154d1eb",
                        "glosses": [
                            "To be deprived of ions."
                        ],
                        "tags": [
                            "intransitive",
                            "physical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0de9f68a-9cc7-3fb0-bbef-269ac3670306",
                        "entry_id": "501ec246-57a4-3423-a4f2-083cb154d1eb",
                        "glosses": [
                            "To be deprived of ions.",
                            "Of an ionized substance, to return to a neutral state."
                        ],
                        "tags": [
                            "intransitive",
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "1432e602-0af8-42b4-ab85-52d119a0ee09",
                                "sense_id": "0de9f68a-9cc7-3fb0-bbef-269ac3670306",
                                "text": "Sparks have been made with durations as light sources down to a few nanoseconds, the advantage being that the ionized gas which created the light can deionize and dissipate its heat sufficiently quickly whereas a discharge in gases like xenon in a bottle deionizes and dissipates more slowly."
                            },
                            {
                                "example_id": "b946c332-9ba8-4639-a676-489e1dcba972",
                                "sense_id": "0de9f68a-9cc7-3fb0-bbef-269ac3670306",
                                "text": "In the acidic medium at pH 2.0, amino, imino and hydroxyl groups of the hybrid are protonated and KP [ketoprofen] deionizes and becomes less soluble [36]; this leads to a decrease in the release rate and percentage of KP."
                            }
                        ]
                    }
                ],
