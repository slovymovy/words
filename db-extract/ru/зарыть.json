                ],
                "senses": [
                    {
                        "sense_id": "92084ad2-9a81-32c3-b8fb-08450ed8dc66",
                        "entry_id": "08fb665e-3edc-3865-9904-544c747b9f91",
                        "glosses": [
                            "забросать сверху чем-либо сыпучим, рыхлым что-либо, положенное в яму, углубление и т. п.; закопать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ed54828-8333-46b0-9887-09cc8b0e33fb",
                                "sense_id": "92084ad2-9a81-32c3-b8fb-08450ed8dc66",
                                "text": "— А куда бабушка ушла? — Внука хоронить. — Его в землю зароют? — А как же? Зароют."
                            }
                        ]
                    },
                    {
                        "sense_id": "aab9710a-8277-3b11-9173-a8044ddad181",
                        "entry_id": "08fb665e-3edc-3865-9904-544c747b9f91",
                        "glosses": [
                            "перен. погрузить, спрятать лицо, голову и т. п. во что-либо мягкое, рыхлое"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abcbdcb8-b500-4613-9517-76733c39a87a",
                        "source_entry_id": "08fb665e-3edc-3865-9904-544c747b9f91",
                        "target_lang_word": "bury",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bfc2eb8-e2e8-3fb6-89cc-424884b63790",
                                        "entry_id": "ca3beaae-5452-3f76-acfb-4bb41c6e9d97",
                                        "glosses": [
                                            "To ritualistically inter in a grave or tomb.",
                                            "To kill or murder."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "900fef81-6a9c-3947-a7f8-5b083e941376",
                                        "entry_id": "ca3beaae-5452-3f76-acfb-4bb41c6e9d97",
                                        "glosses": [
                                            "To ritualistically inter in a grave or tomb.",
                                            "To outlive."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "humorous",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6445523-ac02-4bf5-9f22-9ef98bf9d481",
                                                "sense_id": "900fef81-6a9c-3947-a7f8-5b083e941376",
                                                "text": "Grandpa’s still in excellent health. He’ll bury us all!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d74e537-0462-3b0e-811c-62eeb0312b0e",
                                        "entry_id": "ca3beaae-5452-3f76-acfb-4bb41c6e9d97",
                                        "glosses": [
                                            "To place in the ground."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ebd7d34-72bf-43c8-93f8-b4f6d31fbb48",
                                                "sense_id": "6d74e537-0462-3b0e-811c-62eeb0312b0e",
                                                "text": "bury a bone; bury the embers"
                                            },
                                            {
                                                "example_id": "7cfeded1-5b3e-44ff-9c82-57fd50966b3d",
                                                "sense_id": "6d74e537-0462-3b0e-811c-62eeb0312b0e",
                                                "text": "Later that morning, they wrapped Ian in a wildebeest skin and buried him near a shepherd tree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b27a63c-4d89-3c5a-9911-99644433c8c6",
                                        "entry_id": "ca3beaae-5452-3f76-acfb-4bb41c6e9d97",
                                        "glosses": [
                                            "To hide or conceal as if by covering with earth or another substance."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b75ceacb-5cc8-4537-99e4-1fc3df69c4cf",
                                                "sense_id": "1b27a63c-4d89-3c5a-9911-99644433c8c6",
                                                "text": "She buried her face in the pillow, and I buried mine in my hands."
                                            },
                                            {
                                                "example_id": "31663fb7-501d-4e16-950d-0299b8ca3e8b",
                                                "sense_id": "1b27a63c-4d89-3c5a-9911-99644433c8c6",
                                                "text": "The splinter has buried itself under the nail."
                                            },
                                            {
                                                "example_id": "263cb5be-7362-4f03-a6c6-746cad48e1ca",
                                                "sense_id": "1b27a63c-4d89-3c5a-9911-99644433c8c6",
                                                "text": "The information I need is buried behind needless details."
                                            },
                                            {
                                                "example_id": "30f52692-8df2-4432-8583-c21985e263f2",
                                                "sense_id": "1b27a63c-4d89-3c5a-9911-99644433c8c6",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale.[…]Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            },
                                            {
                                                "example_id": "180dd527-95c5-467d-9fce-75bceeb46210",
                                                "sense_id": "1b27a63c-4d89-3c5a-9911-99644433c8c6",
                                                "text": "The Thai government has been trying to bury the memory of the revolution that gave birth to democracy in Thailand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ff4b496-27d8-31d4-9773-86fe79619ee0",
                                        "entry_id": "ca3beaae-5452-3f76-acfb-4bb41c6e9d97",
                                        "glosses": [
                                            "To hide or conceal as if by covering with earth or another substance.",
                                            "To render imperceptible by other, more prominent stimuli; to drown out."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e10e6082-4f11-4457-9ec8-0664884f56f2",
                                                "sense_id": "7ff4b496-27d8-31d4-9773-86fe79619ee0",
                                                "text": "vocals buried in the mix"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a470f26f-7752-3b45-b4df-30c4758cc522",
                                        "entry_id": "ca3beaae-5452-3f76-acfb-4bb41c6e9d97",
                                        "glosses": [
                                            "To hide or conceal as if by covering with earth or another substance.",
                                            "To overwhelm."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8394c122-dd05-4a89-969c-9a03ec71ffd4",
                                                "sense_id": "a470f26f-7752-3b45-b4df-30c4758cc522",
                                                "text": "They buried us in paperwork."
                                            },
                                            {
                                                "example_id": "d04067a7-efb7-4383-962d-cd7d96c3dd8d",
                                                "sense_id": "a470f26f-7752-3b45-b4df-30c4758cc522",
                                                "text": "Beyond the daily firefighting, these managers and executives are overwhelmed in details and buried in administrative work"
                                            },
                                            {
                                                "example_id": "65b17d02-6e8b-4d56-869b-86f40b9fc019",
                                                "sense_id": "a470f26f-7752-3b45-b4df-30c4758cc522",
                                                "text": "We live in an age when people are buried with information and nobody knows anything"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7031d32f-b332-3b64-940c-83ba6ebee529",
                                        "entry_id": "ca3beaae-5452-3f76-acfb-4bb41c6e9d97",
                                        "glosses": [
                                            "To suppress and hide away in one's mind."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9221d665-ce92-4a2c-9a30-ad6e2897d346",
                                                "sense_id": "7031d32f-b332-3b64-940c-83ba6ebee529",
                                                "text": "secrets kept buried"
                                            },
                                            {
                                                "example_id": "c12689c0-82d6-4909-937e-7c563208dafd",
                                                "sense_id": "7031d32f-b332-3b64-940c-83ba6ebee529",
                                                "text": "She buried her shame and put on a smiling face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e512a05e-3a56-34a4-8ace-877c36dc52fe",
                                        "entry_id": "ca3beaae-5452-3f76-acfb-4bb41c6e9d97",
                                        "glosses": [
                                            "To put an end to; to abandon."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ea85a79-e2be-4814-bfb3-cafabd9a1f68",
                                                "sense_id": "e512a05e-3a56-34a4-8ace-877c36dc52fe",
                                                "text": "They buried their argument and shook hands."
                                            },
                                            {
                                                "example_id": "d224b6b0-3386-4b6f-9bfc-abbf3eba5bb0",
                                                "sense_id": "e512a05e-3a56-34a4-8ace-877c36dc52fe",
                                                "text": "Give me a bowl of wine. / In this I bury all unkindness, Cassius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99238a76-598d-365e-b02c-caf37f48c3de",
                                        "entry_id": "ca3beaae-5452-3f76-acfb-4bb41c6e9d97",
                                        "glosses": [
                                            "To score (a goal)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0aa0858-f76b-4350-a16b-3c28588a24b2",
                                                "sense_id": "99238a76-598d-365e-b02c-caf37f48c3de",
                                                "text": "You could feel the relief after Bendtner collected Wilshere's raking pass before cutting inside Carlos Edwards and burying his shot beyond Fulop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e08e100-352e-3ab1-aac9-aba5c377b654",
                                        "entry_id": "ca3beaae-5452-3f76-acfb-4bb41c6e9d97",
                                        "glosses": [
                                            "To ruin the image or character of another wrestler; usually by embarrassing or defeating them in dominating fashion."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "809007fa-8d68-3e08-a958-401fb19a30cc",
                                        "entry_id": "2ebe565e-11ff-3887-bd92-3112a97ecc94",
                                        "glosses": [
                                            "A burrow."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e00471de-9145-47e5-8a88-bfc69e786a4d",
                                                "sense_id": "809007fa-8d68-3e08-a958-401fb19a30cc",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out."
                                            },
                                            {
                                                "example_id": "7934e2e9-fe3f-42a3-a4d6-74d027e36055",
                                                "sense_id": "809007fa-8d68-3e08-a958-401fb19a30cc",
                                                "text": "The conies had hundreds of buries under these trees, so close together that the problem was not to find a rabbit, but to find a rabbit far enough away from its hole."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e25c29d-9a32-378f-adc3-14ae51eec57b",
                                        "entry_id": "3af47474-71aa-31ea-be55-2886569d3fdc",
                                        "glosses": [
                                            "A borough; a manor"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc3c15c8-4c34-4392-9658-8c269e757bc3",
                                                "sense_id": "4e25c29d-9a32-378f-adc3-14ae51eec57b",
                                                "text": "Indisputable, though very dim to modern vision, rests on its hill-slope that same Bury, Stow, or Town of St. Edmund; already a considerable place, not without traffic"
                                            }
                                        ]
