                "senses": [
                    {
                        "sense_id": "afb4241b-a82d-3c5d-968b-d00ea5221725",
                        "entry_id": "7b523c7d-45dd-3adc-8cf3-9ec7c1286b02",
                        "glosses": [
                            "die Seele eines ganzen Volkes, im Volk verbreitete psychische Einstellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd16d0a8-e44c-4db5-9001-acfb4d0cda69",
                                "sense_id": "afb4241b-a82d-3c5d-968b-d00ea5221725",
                                "text": "„Die CSU streichelt die deutsche Volksseele, oder zumindest das, was sie sich darunter vorstellt.“"
                            },
                            {
                                "example_id": "67052095-93fb-4a85-99dc-839db85e8bec",
                                "sense_id": "afb4241b-a82d-3c5d-968b-d00ea5221725",
                                "text": "„Die 975000 Einwohner, zum Großteil Bulgaren, blieben mehrheitlich ruhig, doch in der Volksseele begann es zu brodeln.“"
                            },
                            {
                                "example_id": "7778ca4c-780e-47af-b570-1eb9c60003a6",
                                "sense_id": "afb4241b-a82d-3c5d-968b-d00ea5221725",
                                "text": "„Lebendiger und kräftiger als in anderen Gegenden kamen daher hier unter den Bauern jene geheimnisvollen Strömungen der russischen Volksseele zur Geltung, die nach Entstehung und Bedeutung der Zeitgenossen so oft unerklärlich bleiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
