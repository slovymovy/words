                "translations": [
                    {
                        "translation_id": "5884bb98-4149-43a7-bac2-eca49e9592d8",
                        "source_entry_id": "d9df7b0a-4a4f-3bde-966e-caedbfc27986",
                        "source_sense_id": "7fcd3f13-bcb1-37ec-8574-55d4a877f52f",
                        "target_lang_word": "hostility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hostility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                        "entry_id": "537e2829-e992-34e3-a7f9-dcdab7f0f044",
                                        "glosses": [
                                            "The state of being hostile."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d59f2fc-f757-4a0f-85cf-c745b6ed3b97",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "My resentment and anger towards you caused hostility and a division between us."
                                            },
                                            {
                                                "example_id": "ea990558-94ef-4c52-a74f-572894267c08",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "There is no hostilitie so excellent, as that which is absolutely Christian."
                                            },
                                            {
                                                "example_id": "bced59d3-8aa0-4a69-9d9c-dd8efade346a",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "But with Goodison Park openly directing its full hostility towards Atkinson, Liverpool went ahead when Carroll turned in his first Premier League goal of the season after 70 minutes."
                                            },
                                            {
                                                "example_id": "c080f4fe-3a47-4e2e-a9af-933eec9ccc11",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "The polarization of wealth and the polarization of attitudes to diversity are not unrelated. A key reason for popular hostility to immigrants is that to many people, particularly within working-class communities, immigration has become a symbol of unacceptable change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5de9e25f-7825-3008-a6f2-f917c727d100",
                                        "entry_id": "537e2829-e992-34e3-a7f9-dcdab7f0f044",
                                        "glosses": [
                                            "A hostile action, especially a military action. See hostilities for specific plural definition."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eb4c81c-aec6-4f2b-a0b6-e46a68b42b43",
                                                "sense_id": "5de9e25f-7825-3008-a6f2-f917c727d100",
                                                "text": "As the revivals died down in the 1740s, the revivalist camp made concessions to their opponents, admonished prorevivalists who continued with the hostilities, and generally sought to heal divisions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0aa7be6-6cbf-489d-b3df-4d3f6872f7d1",
                        "source_entry_id": "d9df7b0a-4a4f-3bde-966e-caedbfc27986",
                        "source_sense_id": "7fcd3f13-bcb1-37ec-8574-55d4a877f52f",
                        "target_lang_word": "dislike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dislike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b4fe8e7-b419-32f2-839d-bc511cc30b8e",
                                        "entry_id": "2a611033-b4c8-3684-911e-25e7f68b0d79",
                                        "glosses": [
                                            "An attitude or a feeling of distaste or aversion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2285807-8523-4cad-82fa-d4f1c6ca1394",
                                                "sense_id": "2b4fe8e7-b419-32f2-839d-bc511cc30b8e",
                                                "text": "In deference to Queen Victoria's dislike of high speed, the specials were allowed about 75 min. for the journey on the Deeside line, but after her death, they were slightly accelerated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9e38d20-5cb6-34fe-8ac5-5bf6a3c2c2ae",
                                        "entry_id": "2a611033-b4c8-3684-911e-25e7f68b0d79",
                                        "glosses": [
                                            "Something that a person dislikes (has or feels aversion to)."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "507a8379-684a-4f7a-870c-aee659d993fd",
                                                "sense_id": "a9e38d20-5cb6-34fe-8ac5-5bf6a3c2c2ae",
                                                "text": "Tell me your likes and dislikes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2cdcd2e-d670-3f42-ab71-dfbea16aac4b",
                                        "entry_id": "2a611033-b4c8-3684-911e-25e7f68b0d79",
                                        "glosses": [
                                            "An individual vote showing disapproval of, or lack of support for, something posted on the Internet."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dislike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cadbeef8-a34b-3830-8425-7b2b4ae135d5",
                                        "entry_id": "accabc0b-51f4-325a-bd8b-58fc91a563b8",
                                        "glosses": [
                                            "To displease; to offend. In third-person only."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "969103ac-afc0-4c5e-ba58-92d7bb149ba8",
                                                "sense_id": "cadbeef8-a34b-3830-8425-7b2b4ae135d5",
                                                "text": "customes and conceipts differing from mine, doe not so much dislike [translating desplaisent] me, as instruct me[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f198308b-3350-34a7-a24c-f417c4b79454",
                                        "entry_id": "accabc0b-51f4-325a-bd8b-58fc91a563b8",
                                        "glosses": [
                                            "To have a feeling of aversion or antipathy towards; not to like."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27bbff42-12c4-4a4c-b493-45de8acc94fc",
                                                "sense_id": "f198308b-3350-34a7-a24c-f417c4b79454",
                                                "text": "In the thick of the railway controversies of his day, Francis naturally had his prejudices. It seems that he cordially disliked the aristocracy in general."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aec5133-51c2-3d63-91aa-c84e88492715",
                                        "entry_id": "accabc0b-51f4-325a-bd8b-58fc91a563b8",
                                        "glosses": [
                                            "To leave a vote to show disapproval of, or lack of support for, something posted on the Internet."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41e05e9f-9320-408d-9628-81732098cc65",
                                                "sense_id": "1aec5133-51c2-3d63-91aa-c84e88492715",
                                                "text": "Rebecca Black's \"Friday\" video has gained notoriety for being one of the most disliked videos in YouTube history."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
