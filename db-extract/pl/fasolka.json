                        "source_sense_id": "1181d3e6-6866-3f25-a54e-ef27f6509702",
                        "target_lang_word": "hole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hole",
