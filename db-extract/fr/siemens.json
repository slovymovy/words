                "senses": [
                    {
                        "sense_id": "8cd2c8eb-74a0-3aaf-832f-5676d40c3cad",
                        "entry_id": "61facbaf-6ac4-3a1a-a0f6-4f6ab58f0bb6",
                        "glosses": [
                            "Groupe international d’origine allemande spécialisé dans les secteurs de l’énergie, de la santé, de l’industrie, du bâtiment et du transport."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46226161-d768-44a1-9914-6d4992db6cc2",
                                "sense_id": "8cd2c8eb-74a0-3aaf-832f-5676d40c3cad",
                                "text": "« Il y a plus de complexité à rénover une ligne qu’à en créer une », appuie Vincent Fontanel, directeur de l’unité Rail Infrastructure chez Siemens Mobility."
                            },
                            {
                                "example_id": "38252df2-3876-459b-9c3f-e941d1b26a02",
                                "sense_id": "8cd2c8eb-74a0-3aaf-832f-5676d40c3cad",
                                "text": "En 1919, la compagnie Siemens fonde la société Osram, qui produit des lampes électriques."
                            },
                            {
                                "example_id": "dc7814c6-aa37-467f-809c-389a3bd8094c",
                                "sense_id": "8cd2c8eb-74a0-3aaf-832f-5676d40c3cad",
                                "text": "Le S25 de Siemens est bourré de fonctions et très soigné esthétiquement."
                            }
                        ]
                    }
