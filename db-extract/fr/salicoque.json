                                ]
                            },
                            {
                                "target_word": "shrimp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e924bfb-d523-3db5-b946-84db8f71fd2d",
                                        "entry_id": "d6ccdaea-bfbb-3261-8811-c681c3083160",
                                        "glosses": [
                                            "To fish for shrimp."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c628dc4-251b-42ea-b48a-23d4d9d4e60a",
                                                "sense_id": "7e924bfb-d523-3db5-b946-84db8f71fd2d",
                                                "text": "Fishing, shrimping and crabbing are permitted on designated areas of the refuge subject to the following conditions:[…]"
                                            },
                                            {
                                                "example_id": "8f4761e9-6159-4e3e-bc54-88b021a358d5",
                                                "sense_id": "7e924bfb-d523-3db5-b946-84db8f71fd2d",
                                                "text": "Although the line is not always sharply drawn, offshore shrimping and inshore shrimping require different strategies."
                                            },
                                            {
                                                "example_id": "d697f0f6-c082-4fca-ae22-ed19e61bd15d",
                                                "sense_id": "7e924bfb-d523-3db5-b946-84db8f71fd2d",
                                                "text": "There were times we shrimped in the same boat due to breakdowns and such, but for the most part we each had our own separate boat. We started out using outboard motor boats. However, shrimping with an outboard is pretty hard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "271ba107-54f9-3e11-9ee3-9930d942458f",
                                        "entry_id": "d6ccdaea-bfbb-3261-8811-c681c3083160",
                                        "glosses": [
                                            "To contract; to shrink."
                                        ],
