                ],
                "senses": [
                    {
                        "sense_id": "b92c8c21-9bfc-361a-9e83-fa4902de6e8d",
                        "entry_id": "3859217f-3d57-362c-b6a6-225bcaf88add",
                        "glosses": [
                            "van een werkwoord een lijdend voorwerp bezittend waarop de werking van het werkwoord overgedragen wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4de1971-a0bc-4734-af41-c45d5be9605f",
                                "sense_id": "b92c8c21-9bfc-361a-9e83-fa4902de6e8d",
                                "text": "Het bedrijvende werkwoord drukt eenig bedrijf uit, welk van het werkende wezen tot een ander overgaat, alwaarom dit werkwoord meermalen overgankelijk (transitive) genoemd wordt."
                            }
                        ]
                    },
                    {
                        "sense_id": "23e05187-5230-301c-a098-d6a62c06e7f8",
                        "entry_id": "3859217f-3d57-362c-b6a6-225bcaf88add",
                        "glosses": [
                            "van een werkwoord een lijdend voorwerp bezittend dat in de lijdende vorm overgaat in een onderwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6a94b99-a681-4a6d-8782-3503197024e4",
                                "sense_id": "23e05187-5230-301c-a098-d6a62c06e7f8",
                                "text": "Hier volgt in het art. 'opvolgen', dat iemand vooronderstelt, die \"voorgegaan\" is, en dus den 3en naamval eischt, maar blijkens 'de koning werd opgevolgd', 'mijn raad werd door hem opgevolgd' overgankelijk geworden is."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1a6771d-091e-3909-a62f-5dd533967f1e",
                        "entry_id": "3859217f-3d57-362c-b6a6-225bcaf88add",
                        "glosses": [
                            "door te geven, verder werkend, over te dragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "909ec109-cb01-4db6-bc56-6ba6de33f494",
                                "sense_id": "d1a6771d-091e-3909-a62f-5dd533967f1e",
                                "text": "Als Aruba wordt bestempeld als een \"newly independent state\" volgens internationaal recht, dan zijn die buitenlandse verdragen niet automatisch overgankelijk."
                            },
                            {
                                "example_id": "4dbf8563-bc1c-47a7-97c0-7450035a8696",
                                "sense_id": "d1a6771d-091e-3909-a62f-5dd533967f1e",
                                "text": "Ziehier opnieuw een zeer belangrijke qualiteit van het spel: het erin behaalde succes is in hooge mate overgankelijk van den enkele op de groep."
                            }
                        ]
                    },
                    {
                        "sense_id": "587059a4-f1b4-3a33-9ff7-6aed8c8bb8b6",
                        "entry_id": "3859217f-3d57-362c-b6a6-225bcaf88add",
                        "glosses": [
                            "van voorbijgaande aard, een tussenstadium vormend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eec0d466-f254-4cb9-9ff5-46155a0fab15",
                                "sense_id": "587059a4-f1b4-3a33-9ff7-6aed8c8bb8b6",
                                "text": "Het is een overgangsmoment en al mijn werk is overgankelijk, nomadisch"
                            },
                            {
                                "example_id": "73903de9-58a6-42e1-8909-66db29915f20",
                                "sense_id": "587059a4-f1b4-3a33-9ff7-6aed8c8bb8b6",
                                "text": "Bedenkelijk is het bijvoorbeeld wanneer het ‘overgankelijk’ karakter van een figuur moet dienen om het belang daarvan te relativeren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed26b445-4558-437c-9664-4f239e7756cb",
                        "source_entry_id": "3859217f-3d57-362c-b6a6-225bcaf88add",
                        "source_sense_id": "b92c8c21-9bfc-361a-9e83-fa4902de6e8d",
                        "source_sense_description": "(van een werkwoord) een lijdend voorwerp bezittend waarop de werking van het werkwoord overgedragen wordt",
                        "target_lang_word": "transitiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transitiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8beb4b1-453b-39b7-9637-5149764f6d64",
                                        "entry_id": "fec9a04f-75a0-3f5f-95d9-82d0643b190b",
                                        "glosses": [
                                            "ein Akkusativobjekt mit sich ziehend (bei Verben)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22a03765-1dae-4990-be55-5e1d51d58e88",
                                                "sense_id": "f8beb4b1-453b-39b7-9637-5149764f6d64",
                                                "text": "„Sehen“ ist ein transitives Verb."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2fc421c5-65ea-35cb-8e50-d3a3606d4e58",
                                        "entry_id": "fec9a04f-75a0-3f5f-95d9-82d0643b190b",
                                        "glosses": [
                                            "eine zweistellige Relation R heißt transitiv, wenn aus a R b und b R c stets a R c folgt."
                                        ],
                                        "tags": [
                                            "Mengenlehre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6214952e-3bd8-437b-a634-4b18defc5ea7",
                                                "sense_id": "2fc421c5-65ea-35cb-8e50-d3a3606d4e58",
                                                "text": "Typische transitive Relationen sind die Ordnungsrelationen: Aus a > b und b > c etwa folgt immer a > c."
                                            },
                                            {
                                                "example_id": "82673266-a19a-4df2-b5c4-952d6f37bec7",
                                                "sense_id": "2fc421c5-65ea-35cb-8e50-d3a3606d4e58",
                                                "text": "„Die Teilerrelation ist transitiv, ergibt also eine Ordnung auf N.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
