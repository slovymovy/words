                "senses": [
                    {
                        "sense_id": "a16a461d-180d-3d27-878e-81c25d0f5a03",
                        "entry_id": "308f5840-0e18-395e-b765-cb8dfa77378c",
                        "glosses": [
                            "ein Mensch, der in einem fremden Land um Aufnahme und Schutz vor politischer Verfolgung bittet; jemand, der einen Asylantrag stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aee0b1c-434d-467f-bb32-009bdbfc37cb",
                                "sense_id": "a16a461d-180d-3d27-878e-81c25d0f5a03",
                                "text": "Asylbewerber erhalten in einem Verfahren eine Entscheidung, darüber, ob sie als Asylberechtigte anerkannt werden."
                            },
                            {
                                "example_id": "4cdf8d0e-39e6-4884-9344-a300b5680c75",
                                "sense_id": "a16a461d-180d-3d27-878e-81c25d0f5a03",
                                "text": "„Die Zahl der Übergriffe auf Asylbewerber beziehungsweise ihre Unterkünfte hat sich 2014 verdreifacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9a62b58-7437-42f2-8e6b-f63dc4d7ad57",
                        "source_entry_id": "308f5840-0e18-395e-b765-cb8dfa77378c",
                        "source_sense_id": "a16a461d-180d-3d27-878e-81c25d0f5a03",
                        "source_sense_description": "Mensch, der in einem fremden Land um Aufnahme und Schutz vor politischer Verfolgung bittet",
                        "target_lang_word": "asylum seeker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asylum seeker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e649427c-1f35-3c78-8ba0-e2410f7b202e",
                                        "entry_id": "c51220bb-dc53-3f98-a72e-1e933540d1d4",
                                        "glosses": [
                                            "A person who has applied for asylum in a foreign country but has not yet been granted refugee status by that country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d503a8e4-2404-4e00-9ea8-b9730bd7ea0d",
                                                "sense_id": "e649427c-1f35-3c78-8ba0-e2410f7b202e",
                                                "text": "He stayed with friends and even spent a few nights in a hotel when had nowhere else to go. In September 2019, he moved into a flat with three other gay asylum seekers through Le Refuge, an organisation supporting isolated LGBTQI+ youth."
                                            },
                                            {
                                                "example_id": "57913538-0703-4206-99d3-ef1d92b0c31d",
                                                "sense_id": "e649427c-1f35-3c78-8ba0-e2410f7b202e",
                                                "text": "In Manchester and in Aldershot in Hampshire, asylum seeker accommodation was targeted by demonstrators carrying placards that read “deport them, don’t support them” and “no apartments for illegals”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
