                        "entry_id": "c8f76fa5-7d71-362a-8944-78973228a965",
                        "glosses": [
                            "Personne qui vit comme une gouape."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1b37b227-df17-4751-93ee-664a979c2e83",
                                "sense_id": "f460c53f-182f-3428-adb7-373f03752d53",
                                "text": "C’est un garçon corrompu par l’oisiveté, un gouapeur, un esprit assez peu développé ; mais ce n’est ni un idiot ni un imbécile."
                            }
                        ]
                    }
