                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5954651-0cf9-4222-8771-a26a79e98680",
                                                "sense_id": "a090de0e-9b65-34b6-a150-962819be4748",
                                                "text": "Si dijera lo contrario, sería un hipócrita."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7d8e12da-d0d5-3bd6-9dad-44210c8daf4e",
                                        "entry_id": "81b9d7d1-324c-3722-b277-6a9351f9152c",
                                        "glosses": [
                                            "Por extensión, persona que actúa con malicia ocultando sus verdaderas intenciones tras una fachada de zalamería y falsa bondad."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
