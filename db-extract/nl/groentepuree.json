                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3fd967e-5d10-4718-9679-8cb503106711",
                                "sense_id": "be1ed91f-3ef5-3117-b68c-75f814980d1b",
                                "text": "Op zich wel een prima beet in combinatie met een mooie lamskwaliteit, maar mijn haasje (let op het vlies, chef) moet watertrappelen, net als de bontgekleurde groentepuree. Op basis van de gerechtsprijs (23 euro): een rood cijfer voor dit witte, natte goud."
                            },
