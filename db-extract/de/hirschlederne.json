                "senses": [
                    {
                        "sense_id": "d288e0f6-fb9d-346a-8c7e-4f695515343f",
                        "entry_id": "d57e3575-b183-3df9-ba78-b9b1f3344822",
                        "glosses": [
                            "(Trachten-)Hose aus Hirschleder"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "6ee5722b-740a-49b2-af7b-579dd7a80e14",
                                "sense_id": "d288e0f6-fb9d-346a-8c7e-4f695515343f",
                                "text": "„Ein junger Bursche kommt uns entgegen, er trägt eine schöne Hirschlederne mit Stickereien, ein schlichtes Trachtenhemd - und Bergschuhe, über deren Schaft die Strümpfe zu einem Wulst zusammengeschoben sind.“"
                            },
                            {
                                "example_id": "7a409cb6-0f97-41c6-86ce-49ca5b03eb2c",
                                "sense_id": "d288e0f6-fb9d-346a-8c7e-4f695515343f",
                                "text": "„Das junge, urbane Deutschland macht Party an der Isar, ein Kostümfest ohne Kostümzwang. Basketballstiefel zum Dirndlrock – passt. Kate-Moss-T-Shirt zur Hirschledernen – cool.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
