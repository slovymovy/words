                        "cross_references": [
                            {
                                "target_word": "tall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36933737-2ba0-31d6-ba20-d6a2a2ac4a0f",
                                        "entry_id": "48057b70-fda3-3268-aaa0-b26f8faa6826",
                                        "glosses": [
                                            "Having a vertical extent greater than the average. For example, somebody with a height of over 6 feet would generally be considered to be tall."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "061c0a48-be44-4089-babe-2f8eacdc3c48",
                                                "sense_id": "36933737-2ba0-31d6-ba20-d6a2a2ac4a0f",
                                                "text": "Being tall is an advantage in basketball."
                                            },
                                            {
                                                "example_id": "f07134e3-6625-45ed-8611-3de1c05ba725",
                                                "sense_id": "36933737-2ba0-31d6-ba20-d6a2a2ac4a0f",
                                                "text": "Then came a maid with hand-bag and shawls, and after her a tall young lady. She stood for a moment holding her skirt above the grimy steps,[…], and the light of the reflector fell full upon her."
                                            },
                                            {
                                                "example_id": "afddef68-68c4-45af-aa67-b152eb9b431c",
                                                "sense_id": "36933737-2ba0-31d6-ba20-d6a2a2ac4a0f",
                                                "text": "He′d been packed in with all the other journos, standing out only in that he was taller than most and didn′t make as much noise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc0f225e-1d26-327b-9550-0bb324b33f63",
                                        "entry_id": "48057b70-fda3-3268-aaa0-b26f8faa6826",
                                        "glosses": [
                                            "Having its top a long way up; having a great vertical (and often greater than horizontal) extent."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08b5adb3-1ef4-44e2-8e8d-9bcf441fb954",
                                                "sense_id": "bc0f225e-1d26-327b-9550-0bb324b33f63",
                                                "text": "Tall trees, at least about 30m high."
                                            },
                                            {
                                                "example_id": "bdbbe4b3-1fb9-4ab2-ab21-7b254cefcac6",
                                                "sense_id": "bc0f225e-1d26-327b-9550-0bb324b33f63",
                                                "text": "To him it seemed that the Bornean rainforests, the tallest on Earth, were places that had: 'remained untouched and unchanged since remote geological epochs[.]'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6037bb4-d57a-32f3-8701-68ddfa74ba16",
                                        "entry_id": "48057b70-fda3-3268-aaa0-b26f8faa6826",
                                        "glosses": [
                                            "Hard to believe, such as a tall story or a tall tale."
                                        ],
                                        "tags": [
                                            "of a story"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71553204-462e-4a51-9d72-77b3c995c93d",
                                                "sense_id": "a6037bb4-d57a-32f3-8701-68ddfa74ba16",
                                                "text": "\"That's tall talk.\"\n\"Not an inch taller than the truth.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87cb4eb5-5488-38f4-b3f7-3703c0f5cea4",
                                        "entry_id": "48057b70-fda3-3268-aaa0-b26f8faa6826",
                                        "glosses": [
                                            "Smaller than grande, usually 8 ounces (~ 230 ml)."
                                        ],
