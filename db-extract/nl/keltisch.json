                                        "sense_id": "1b836960-92ad-3eb4-9f95-7b3ddeae6641",
                                        "entry_id": "e0beb524-fa84-3f53-b41b-28762b70311b",
                                        "glosses": [
                                            "Of or relating to the Celts."
