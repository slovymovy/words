                "senses": [
                    {
                        "sense_id": "30b1caab-e897-3b6b-80e3-b4df7ee9e6b2",
                        "entry_id": "274a7811-6544-3b8b-8066-28a5af69d907",
                        "glosses": [
                            "Bild einer alltäglichen Szene zur Darstellung von bestimmten Lebensformen oder Umgebungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69b1e2fc-a6bb-4dd4-9670-82debaafd305",
                                "sense_id": "30b1caab-e897-3b6b-80e3-b4df7ee9e6b2",
                                "text": "„Das Genrebild erinnert an die heimelige Gefühlskultur der Gartenlaube, des meistgelesenen Familienblatts im deutschen Biedermeier.“"
                            },
                            {
                                "example_id": "357c7ac8-e1c0-44c8-99b6-6a5de264361f",
                                "sense_id": "30b1caab-e897-3b6b-80e3-b4df7ee9e6b2",
                                "text": "„Über das Genrebild entzogen sich breite Bevölkerungskreise der Industrialisierung und Vermassung in eine idyllische Traumwelt.“"
                            },
                            {
                                "example_id": "3c014ca9-3ec8-4d81-a5c8-326fe76b2b48",
                                "sense_id": "30b1caab-e897-3b6b-80e3-b4df7ee9e6b2",
                                "text": "„Ob Historien- oder Genrebild - beide dienen in erster Linie als lehrreiche Exempla.“"
                            },
                            {
                                "example_id": "00eb2949-109e-4868-a79b-4d39c54990ad",
                                "sense_id": "30b1caab-e897-3b6b-80e3-b4df7ee9e6b2",
                                "text": "„Daß das historische Genrebild wenig kultivirt wurde, ist wohl auch ein Zeichen sozusagen der geistigen Gesundheit der maßgebenden Genremaler der damaligen Zeit.“"
                            },
                            {
                                "example_id": "0103dab8-5430-48c9-a1f0-6468b5763ad8",
                                "sense_id": "30b1caab-e897-3b6b-80e3-b4df7ee9e6b2",
                                "text": "„Die Arena der Stiergefechte bietet da zunächst interessante Motive für das novellistische Genrebild dar, denen der aufregende Reiz, selbst auch ein gewilles tragisches Interesse nicht fehlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
