                "senses": [
                    {
                        "sense_id": "852c5790-90e1-3f49-96c7-6b3f412b22d7",
                        "entry_id": "73ae01c9-a710-36df-8172-c7f53ef4131c",
                        "glosses": [
                            "Behälter zur Lagerung von Treibstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97bd275c-1234-4409-b873-ce4b058aa52b",
                                "sense_id": "852c5790-90e1-3f49-96c7-6b3f412b22d7",
                                "text": "Der Treibstofftank wurde befüllt."
                            },
                            {
                                "example_id": "7f766500-f293-4c68-bd2f-5dbe1fc9853f",
                                "sense_id": "852c5790-90e1-3f49-96c7-6b3f412b22d7",
                                "text": "„Einsatzmöglichkeiten für das neue Material fänden sich in der künftigen Weltraumerforschung, in Treibstofftanks von Raumgefährten und Raketen und auch zum Beispiel als Schwingungsdämpfer in Automotoren, so Xu Ming.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2c702d2-fb48-44d4-819c-1969549389fa",
                        "source_entry_id": "73ae01c9-a710-36df-8172-c7f53ef4131c",
                        "source_sense_id": "852c5790-90e1-3f49-96c7-6b3f412b22d7",
                        "source_sense_description": "Behälter zur Lagerung von Treibstoff",
                        "target_lang_word": "fuel tank",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuel tank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "682623d5-555b-3915-835a-ba1e821247d5",
                                        "entry_id": "2f0fcf77-9321-3ebc-aac0-e25baa83dcba",
                                        "glosses": [
                                            "A container of fuel, especially one for motor fuel inside a vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8b0965f-37c9-43c8-8905-9d58553a073f",
                                                "sense_id": "682623d5-555b-3915-835a-ba1e821247d5",
                                                "text": "The main fuel tank is slung from the underframe midway between the two bogies, and its capacity of 420 gal. supplies both the main engine and the train heating boiler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23ce919a-b806-382c-9359-b97fa156c4be",
                                        "entry_id": "2f0fcf77-9321-3ebc-aac0-e25baa83dcba",
                                        "glosses": [
                                            "A container for storage of fuel, e.g. in a depot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d94a499d-9eff-44ae-82cc-7a43ef5ead67",
                                                "sense_id": "23ce919a-b806-382c-9359-b97fa156c4be",
                                                "text": "Pending the installation of four 7,000-gal. diesel fuel tanks, temporary refuelling facilities have been provided by the adaptation of a 3,000-gal. oil tank wagon."
                                            }
                                        ]
                                    }
                                ]
                            }
