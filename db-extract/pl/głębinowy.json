                    }
                ],
                "senses": [
                    {
                        "sense_id": "570ff71d-f79e-37c1-a9f2-2bb1808bad8b",
                        "entry_id": "660ae61d-acad-32a9-8a4f-c1c0cd7ab1c1",
                        "glosses": [
                            "depth, deep (of or relating to the depths of the earth or of a body of water)"
                        ],
                        "tags": [
                            "not-comparable",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "69e6bd99-68de-4a12-86a1-89916279c149",
                                "sense_id": "570ff71d-f79e-37c1-a9f2-2bb1808bad8b",
                                "text": "Na obszarze Dolnego Śląska znajduj[e] się [...] dolnośląskie zagłębie węglowe, gdzie głębinowo eksploatowano złoże węgla kamiennego [...]",
                                "translation": "In the region of Lower Silesia, there is … the Lower Silesian coalfield, where a deposit of stone coal has been exploited on a deep level …",
                                "english": "In the region of Lower Silesia, there is … the Lower Silesian coalfield, where a deposit of stone coal has been exploited on a deep level …"
                            }
                        ]
                    },
                    {
                        "sense_id": "d738ff02-e3ac-38ad-ac36-0f7d4362973c",
                        "entry_id": "660ae61d-acad-32a9-8a4f-c1c0cd7ab1c1",
                        "glosses": [
                            "low, present at a deep level of earth or water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc2061ae-6ab3-4ce0-b327-012afb729d5d",
                                "sense_id": "d738ff02-e3ac-38ad-ac36-0f7d4362973c",
                                "text": "Podobnie w środkowej Finlandii stał się on [Pisidium conventus] bardziej głębinowym, w oligotroficznym jeziorze Kuorinkajärvi znaleziony został na 29 m[etrach] głębokości.",
                                "translation": "Similarly, in central Finland, it [Pisidium conventus] has come to be lower down; in the oligotrophic lake Kuorinkajärvi it has been found at a depth of 29 meters.",
                                "english": "Similarly, in central Finland, it [Pisidium conventus] has come to be lower down; in the oligotrophic lake Kuorinkajärvi it has been found at a depth of 29 meters."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa3c3a0e-739e-3ebc-bb1b-e82c17300817",
                        "entry_id": "660ae61d-acad-32a9-8a4f-c1c0cd7ab1c1",
                        "glosses": [
                            "deep, extending to a deep level of earth or water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44a31e3e-492a-4c49-b4b1-3b4eed3b2985",
                                "sense_id": "aa3c3a0e-739e-3ebc-bb1b-e82c17300817",
                                "text": "Wreszcie zaś wybudowano studnię głębinową.",
                                "translation": "Meanwhile, a deep well was finally built.",
                                "english": "Meanwhile, a deep well was finally built."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bd69e4f-e4cf-3978-9a31-dbeb9f9646e8",
                        "entry_id": "660ae61d-acad-32a9-8a4f-c1c0cd7ab1c1",
                        "glosses": [
                            "deep, profound, obscure"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "292d7974-49b3-4283-9b24-57315032cc13",
                                "sense_id": "7bd69e4f-e4cf-3978-9a31-dbeb9f9646e8",
                                "text": "Prawdopodownie Czesław uważał, że ten wpływ jest bardziej głębinowy i będzie się dopiero ujawniał.",
                                "translation": "Probably, Czesław thought that this influence was more deep and would only later reveal itself.",
                                "english": "Probably, Czesław thought that this influence was more deep and would only later reveal itself."
                            }
                        ]
                    }
                ],
