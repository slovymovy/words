                "translations": [
                    {
                        "translation_id": "8d1e4954-1750-43bc-8eaf-9d579f29daa2",
                        "source_entry_id": "64adc821-4b86-3616-bd63-c574662c265f",
                        "source_sense_id": "2cb78982-2c13-35da-bb4d-9ba5a5b046b7",
                        "source_sense_description": "plank, tafel",
                        "target_lang_word": "Brett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2c8add0-56ca-3089-a559-d1a170e23467",
                                        "entry_id": "5959b500-8a4b-3e5e-8c41-83585c9b9123",
                                        "glosses": [
                                            "ein längliches, gleichmäßig und in Wuchsrichtung zugeschnittenes Stück Holz, welches um ein Mehrfaches länger als Höhe und Breite ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca056ae4-6f46-43de-9a58-1fc4eef19c90",
                                                "sense_id": "c2c8add0-56ca-3089-a559-d1a170e23467",
                                                "text": "Für meine Bretter in der Küche möchte ich in gar keinem Falle Paraffinöl benutzen, da dies ein Erdölprodukt ist, und die gesundheitlichen Folgen nicht absehbar sind."
                                            },
                                            {
                                                "example_id": "5c05432d-cc82-4776-9815-8cf13b00bef4",
                                                "sense_id": "c2c8add0-56ca-3089-a559-d1a170e23467",
                                                "text": "„Auch die Bootshalle bedarf der Pflege. Hier müssen einige Bretter erneuert oder wenigstens befestigt werden.“"
                                            },
                                            {
                                                "example_id": "575cc39f-2593-420d-b2df-9c09d7473f00",
                                                "sense_id": "c2c8add0-56ca-3089-a559-d1a170e23467",
                                                "text": "„Dieser hatte sich ein wenig erhoben, um das Brett unter seinem Sitze zurückzuschieben und umzuschlagen, war aber, in seiner schwankenden Stellung vom Faustschlage des Briten getroffen, über die Bootswand in den Strom hinabgestürzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89741fe7-e637-3080-aa9c-adb68356b7ec",
                                        "entry_id": "5959b500-8a4b-3e5e-8c41-83585c9b9123",
                                        "glosses": [
                                            "das Spielbrett, das Spielfeld, die Spieltafel verschiedener Gesellschaftsspiele"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a816acc5-d1a6-445b-8b0d-9a9acf046613",
                                                "sense_id": "89741fe7-e637-3080-aa9c-adb68356b7ec",
                                                "text": "„Holst du bitte das Brett, Dorothea. Wir wollen Halma spielen.“"
                                            },
                                            {
                                                "example_id": "81dea3d6-ed53-449f-974b-d4768bb1558b",
                                                "sense_id": "89741fe7-e637-3080-aa9c-adb68356b7ec",
                                                "text": "„Mirko, unbeweglich vier Stunden vor dem Brett sitzend, besiegte, ohne ein Wort zu sprechen oder auch nur aufzuschauen, einen Spieler nach dem andern;“ […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6b627015-b05a-3264-8380-27c3b76e61b8",
                                        "entry_id": "5959b500-8a4b-3e5e-8c41-83585c9b9123",
                                        "glosses": [
                                            "eine Anschlagtafel für Mitteilungen, Aushänge, Anzeigen und Ähnliches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acceb5eb-5d2f-4985-abc9-782293e88a62",
                                                "sense_id": "6b627015-b05a-3264-8380-27c3b76e61b8",
                                                "text": "Eine der wichtigsten Einrichtungen im Sommerzeltlager war das Brett mit den Programmaushängen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "917ec0f1-d59e-38f0-931e-62388195e573",
                                        "entry_id": "5959b500-8a4b-3e5e-8c41-83585c9b9123",
                                        "glosses": [
                                            "durch einen Hefepilz verursachter Fehlton im Wein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4e31812-4203-4f2f-8570-f76214ce7a3c",
                                                "sense_id": "917ec0f1-d59e-38f0-931e-62388195e573",
                                                "text": "„Dieser von Weinleuten kurz als »Brett« bezeichnete Fehlton ist besonders häufig in St. Laurent und Syrah zu beobachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2fb20605-cebe-3769-b66c-79797f1fd2a9",
                                        "entry_id": "5959b500-8a4b-3e5e-8c41-83585c9b9123",
                                        "glosses": [
                                            "Hilfsmittel, um besser durch den Schnee zu kommen; Skier oder auch Schuhe mit breiter Sohle"
                                        ],
                                        "tags": [
                                            "plural",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0365988e-ccf6-4cee-ba88-b183b05f7a5c",
                                                "sense_id": "2fb20605-cebe-3769-b66c-79797f1fd2a9",
                                                "text": "Wenn du den Laufstil nicht beherrschst, werden deine Bretter noch zu Kleinholz."
                                            },
                                            {
                                                "example_id": "3866ef7e-1ec3-4097-bb06-5a50018a5c86",
                                                "sense_id": "2fb20605-cebe-3769-b66c-79797f1fd2a9",
                                                "text": "Komm, lass uns die Bretter unterschnallen und los gehts!"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "3078d9cb-5f04-33c1-a869-cae611d41106",
                                        "entry_id": "5959b500-8a4b-3e5e-8c41-83585c9b9123",
                                        "glosses": [
                                            "Bühne, besonders die eines Schauspielhauses"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdcd141e-f7c7-45dd-afba-1693d77ad807",
                                                "sense_id": "3078d9cb-5f04-33c1-a869-cae611d41106",
                                                "text": "Sie stand schon mit fünf auf den Brettern des Thaliatheaters, damals in einem Weihnachtsmärchen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
