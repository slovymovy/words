                                        "entry_id": "9a76ca26-f89e-3d39-b76e-b7b130bb4d2d",
                                        "glosses": [
                                            "Of or pertaining to Franco-Ontarians."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
