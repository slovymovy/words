                                        "entry_id": "49c39f54-a244-330b-86c5-64c7cd7fd1a9",
                                        "glosses": [
                                            "Acronym of Brazil, Russia, India, China, South Africa, an international economic organization comprising several fast-growing economies."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "acronym",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79a64ba1-fe1d-46e5-b95b-d23b36ca9a18",
                                                "sense_id": "6acc3887-84f7-3b1c-bf6e-5f967538134f",
                                                "text": "As shown by the BRICS expansion and the long waiting list to join, Xi’s offer of an alternative world order is finding receptive ears in the Global South, where many countries feel themselves marginalized in an international system they see as dominated by the US and its wealthy allies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
