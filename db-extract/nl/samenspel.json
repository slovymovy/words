                    {
                        "sense_id": "2c2e4fea-c44a-3de8-955e-7b6804425452",
                        "entry_id": "c9af40db-e06c-3abe-b052-df451abd18b7",
                        "glosses": [
                            "wijze waarop verschillende personen bij een spel elkaar steunen of een geheel vormen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "285c36a3-0bf1-49d9-b625-b4cb8adc5037",
                                "sense_id": "2c2e4fea-c44a-3de8-955e-7b6804425452",
                                "text": "Hij deed mee met het samenspel van die jongens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc4badef-7632-4cf0-badb-e1e77b9fba40",
                        "source_entry_id": "c9af40db-e06c-3abe-b052-df451abd18b7",
                        "source_sense_id": "2c2e4fea-c44a-3de8-955e-7b6804425452",
                        "source_sense_description": "wijze waarop verschillende personen bij een spel elkaar steunen of een geheel vormen",
                        "target_lang_word": "Zusammenspiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusammenspiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab9192a5-14e7-3420-a3d8-ea22f11ea0fe",
                                        "entry_id": "c1cdfa7c-2845-3796-88eb-900e22a9a5bd",
                                        "glosses": [
                                            "gemeinsames Spiel, kooperatives Zusammenwirken mehrerer Personen beim Spielen, etwa in Orchester, Theater, Mannschaftssport"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "Schauspiel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40f016ac-9432-424c-aeed-6b17694b91c9",
                                                "sense_id": "ab9192a5-14e7-3420-a3d8-ea22f11ea0fe",
                                                "text": "„Larry Grenadier zupft in seinen herausragenden Soli erfindungsreiche, melodiöse Parts, bestimmt eher Rhythmus und Sound, als sich ihnen unterzuordnen, ist auch im Zusammenspiel ein eigenständiger Mitspieler, kein untergeordneter Taktgeber.“"
                                            },
                                            {
                                                "example_id": "fbeac232-4df9-4f64-bcbf-a26472f721a6",
                                                "sense_id": "ab9192a5-14e7-3420-a3d8-ea22f11ea0fe",
                                                "text": "„Den Torschuss, den die eine Mannschaft erreichen will, muss die andere im geschickten Zusammenspiel zu verhindern versuchen und umgekehrt.“"
                                            },
                                            {
                                                "example_id": "19f9a1e1-cbe0-4e09-b46f-bd823004a731",
                                                "sense_id": "ab9192a5-14e7-3420-a3d8-ea22f11ea0fe",
                                                "text": "„Mit Hilfe der im Zusammenspiel so ungemein genauen Musiker gelingen ihm musikalische Spannungsbögen, die faszinieren.“"
                                            },
                                            {
                                                "example_id": "32a324eb-92ce-4740-924b-3656541e2478",
                                                "sense_id": "ab9192a5-14e7-3420-a3d8-ea22f11ea0fe",
                                                "text": "„Und an dessen Ende die Italiener mit einem bedachten Zusammenspiel die Belgier durch den eigenen Strafraum irren ließen wie durch die verwinkelten Gassen in der schmucken Altstadt von Lyon.“"
                                            },
                                            {
                                                "example_id": "549a6589-649e-4150-8d32-8ed1aefbab2e",
                                                "sense_id": "ab9192a5-14e7-3420-a3d8-ea22f11ea0fe",
                                                "text": "„Interessant ist auch, dass nach unseren Ergebnissen für die Kinder die Möglichkeit des Zusammenspiels mit anderen ebenfalls einen wichtigen Spielanlass darstellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a27e0863-17f1-3dc2-8f32-0bed5ed0922f",
                                        "entry_id": "c1cdfa7c-2845-3796-88eb-900e22a9a5bd",
                                        "glosses": [
                                            "gemeinschaftliches Arbeiten von Personen, Gruppen, Organisationen im Dienste einer Sache"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2483191-6e54-4a60-a40f-10d10da6ba0f",
                                                "sense_id": "a27e0863-17f1-3dc2-8f32-0bed5ed0922f",
                                                "text": "„Das Zusammenspiel von Haupt- und Sekundärinsolvenzverfahren kann im Groben in zwei Bereiche unterteilt werden.“"
                                            },
                                            {
                                                "example_id": "1a3958ea-57ce-40f6-b0fe-1cb2b89afcd5",
                                                "sense_id": "a27e0863-17f1-3dc2-8f32-0bed5ed0922f",
                                                "text": "„Erst unter der Voraussetzung des Zugangs zu den Quellen ist Selbstdarstellung durch Information unmittelbar zu erfassen und konstant zu halten, und erst auf dieser Grundlage ist das Zusammenspiel von Öffentlichkeitsarbeit und Journalismus in einem festgelegten, durch forschungsstrategische und –ökonomische Vorentscheidungen möglichst wenig manipulierten Medienkontext ‚in operation’ zu beobachten.“"
                                            },
                                            {
                                                "example_id": "2622a1fc-04c2-4e79-b7f0-e20fd3521ffd",
                                                "sense_id": "a27e0863-17f1-3dc2-8f32-0bed5ed0922f",
                                                "text": "„Auf Einladung der Kreisbauernverbände Göppingen und Ostalb-Heidenheim hat Umweltstaatssekretär Andre Baumann am 4. Juli die aktuellen Herausforderungen im Zusammenspiel von Naturschutz auf der einen und Landwirtschaft auf der anderen Seite skizziert.“"
                                            },
                                            {
                                                "example_id": "fbcf6cd6-d2ce-4e85-a1b1-bd6acda1cf35",
                                                "sense_id": "a27e0863-17f1-3dc2-8f32-0bed5ed0922f",
                                                "text": "„Das Zusammenspiel von Mensch und Natur verdeutlicht eine Insektenweide, die als Hotspotzone für Artenvielfalt dient.“"
                                            },
                                            {
                                                "example_id": "709c57ba-83a3-42e4-8c71-1f3c95f267af",
                                                "sense_id": "a27e0863-17f1-3dc2-8f32-0bed5ed0922f",
                                                "text": "„Mich faszinierte von Anfang an das Zusammenspiel von Technik, Mensch und Material, sagt der im bayrischen Höchstadt lebende Ingenieur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d1491d43-ecc4-3f4d-9cd1-b772591f9d0c",
                                        "entry_id": "c1cdfa7c-2845-3796-88eb-900e22a9a5bd",
                                        "glosses": [
                                            "reibungsloser Wirkmechanismus von verschiedenen Apparaten, Körperteilen, Maschinenteilen, Nahrungsingredienzien, Naturelementen"
                                        ],
                                        "tags": [
                                            "Natur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62d35381-7896-4f26-a0ae-319782b6e65c",
                                                "sense_id": "d1491d43-ecc4-3f4d-9cd1-b772591f9d0c",
                                                "text": "„Nur durch das optimale Zusammenspiel der Luftdruckverteilungen am Boden sowie in größeren Höhen können derartig heiße Temperaturen zwischen 30 und 40 Grad zur Wochenmitte erreicht werden.“"
                                            },
                                            {
                                                "example_id": "68483a54-e4fc-4f4f-bc00-6aa7f5620110",
                                                "sense_id": "d1491d43-ecc4-3f4d-9cd1-b772591f9d0c",
                                                "text": "„Doch von der vermeintlichen Bewegungseinschränkung ist nichts mehr übrig, wenn sechs dieser sogenannten robotischen Knoten im Zusammenspiel mit standardisierten Holzleisten ihr Werk verrichten.“"
                                            },
                                            {
                                                "example_id": "72b98078-3b06-41d0-a885-fa29c00af0dc",
                                                "sense_id": "d1491d43-ecc4-3f4d-9cd1-b772591f9d0c",
                                                "text": "„Auf gemeinsamen Ausstellungsflächen präsentieren Maschinen- und Anlagenbauer ihre Technologien im Zusammenspiel – und das im laufenden Betrieb, um so die einzelnen Teilprozesse im Zusammenhang zeigen zu können.“"
                                            },
                                            {
                                                "example_id": "381b7c1a-0293-44c4-830a-6158e7b12399",
                                                "sense_id": "d1491d43-ecc4-3f4d-9cd1-b772591f9d0c",
                                                "text": "„Er sah, dass nicht nur ein Areal aktiv war, sondern viele in einem komplexen Zusammenspiel: die für Motorik und Sensorik zuständigen, die für Sprache sowie die für das kreative Denken.“"
                                            },
                                            {
                                                "example_id": "3027545c-b7af-4151-81c0-68517abfdc5e",
                                                "sense_id": "d1491d43-ecc4-3f4d-9cd1-b772591f9d0c",
                                                "text": "„Eine smarte und vernetzte Infrastruktur bietet die Grundlage für eine weitere Optimierung des Zusammenspiels verschiedener Beförderungsmittel im städtischen Raum.“"
                                            },
                                            {
                                                "example_id": "529a7cbc-974b-4379-ae5b-11e5c16b03fe",
                                                "sense_id": "d1491d43-ecc4-3f4d-9cd1-b772591f9d0c",
                                                "text": "„Magnesium und Calcium: Das Zusammenspiel der Mineralstoffe“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "60519c85-3fed-3a06-b0c5-0f42f8493ae8",
                                        "entry_id": "c1cdfa7c-2845-3796-88eb-900e22a9a5bd",
                                        "glosses": [
                                            "Harmonie von Sinneseindrücken wie das Abgestimmtsein von Farben, Formen, Gerüchen, Tönen"
                                        ],
                                        "tags": [
                                            "Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7237c792-2d66-4f9f-ac3e-4c0940f34a7c",
                                                "sense_id": "60519c85-3fed-3a06-b0c5-0f42f8493ae8",
                                                "text": "„Komponiere ein Bild spannender, indem Du das Zusammenspiel der Farben beachtest; schreiend oder leise, harmonisch oder dissonant, kräftig und dominant oder zart und blässlich – das Zusammenwirken der Farben beeinflusst die Bildaussage und die Stimmung des Betrachters.“"
                                            },
                                            {
                                                "example_id": "957b7a3d-f58c-46d1-961a-a2795979f05f",
                                                "sense_id": "60519c85-3fed-3a06-b0c5-0f42f8493ae8",
                                                "text": "„Damit die Einrichtung am Ende einen harmonischen, modernen und individuellen Eindruck hinterlässt, sollte das Zusammenspiel von Möbeln, Farben, Licht und Fußböden perfekt aufeinander abgestimmt sein.“"
                                            },
                                            {
                                                "example_id": "8a65477b-579a-422c-9026-6ca0d1b9e173",
                                                "sense_id": "60519c85-3fed-3a06-b0c5-0f42f8493ae8",
                                                "text": "„Einen Abend lang verwandelt sich die Anlage des UNESCO Weltkulturerbes in ein mystisches Zusammenspiel aus Licht, Feuer und Show.“"
                                            },
                                            {
                                                "example_id": "cf72c415-ba37-4e3f-85cd-801b37d1bb89",
                                                "sense_id": "60519c85-3fed-3a06-b0c5-0f42f8493ae8",
                                                "text": "„Dann probieren sie, schmecken das süße Johannisbeergelee, den sauren Apfel und die scharfen Jalapeños heraus, als Reminiszenz an das Gastland hat Tim Raue noch ein wenig Knoblauch untergerührt, und sie schmecken das Zusammenspiel, das trotzdem jeder einzelnen Komponente ihren Raum lässt.“"
                                            },
                                            {
                                                "example_id": "862dc7dc-d579-4e58-9663-59b19e322015",
                                                "sense_id": "60519c85-3fed-3a06-b0c5-0f42f8493ae8",
                                                "text": "„Mit Wasabi-Soße und eingelegtem Ingwer überrascht das Gericht mit seiner asiatischen Note und dem Zusammenspiel von warm und kalt.“"
                                            },
                                            {
                                                "example_id": "26b31d0b-47e0-4bfe-9d92-b7d7139fdf55",
                                                "sense_id": "60519c85-3fed-3a06-b0c5-0f42f8493ae8",
                                                "text": "„Das Echo wurde zuerst durch das geheimnisvolle Zusammenspiel der Sinne hörbar, da in ihnen Empfindungen nachklangen wie ein Ton in Saiten nachklingt, wenn man sie berührt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
