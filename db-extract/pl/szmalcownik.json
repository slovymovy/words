                        "entry_id": "aca1bd98-d895-347b-aa51-05856c301cd4",
                        "glosses": [
                            "a person who, during the Nazi occupation, blackmailed Jews or the people hiding them under threat of exposing them to the Nazis"
                        ],
                        "tags": [
                            "derogatory",
                            "historical",
