                "senses": [
                    {
                        "sense_id": "e192a7ac-63df-3a56-a010-d06130d60ea2",
                        "entry_id": "3d483294-8cb7-391a-b645-5b724c7c6c65",
                        "glosses": [
                            "Menge der Zeichen, die eine Turingmaschine auf ihrem Band verarbeitet"
                        ],
                        "tags": [
                            "Automatentheorie"
                        ],
                        "examples": [
                            {
                                "example_id": "99eb8c5f-63d9-4b4a-9159-139db1388ed7",
                                "sense_id": "e192a7ac-63df-3a56-a010-d06130d60ea2",
                                "text": "„Indem das Bandalphabet Γ geeignet codiert wird, genügt es, über Turingmaschinen mit Bandalphabet {0,1,B} zu reden.“"
                            },
                            {
                                "example_id": "961ebe61-2958-43ec-b123-cfa5c997485e",
                                "sense_id": "e192a7ac-63df-3a56-a010-d06130d60ea2",
                                "text": "„Jeder Lese-Schreib-Kopf steht zu jedem Zeitpunkt auf genau einem Feld seines Bandes. Er kann erkennen, welches Zeichen auf dem Feld steht, und es evtl. durch ein anderes Zeichen aus dem Bandalphabet überdrucken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
