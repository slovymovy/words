                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4e43590-0914-3f15-9225-e02249a094d2",
                        "entry_id": "f25f8f5f-d018-3fec-8146-c4b25d932af1",
                        "glosses": [
                            "Diskriminierung aufgrund des Geschlechts oder der sexuellen Neigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a476db9-0bc4-4808-9e5d-4d27a64bfec3",
                                "sense_id": "b4e43590-0914-3f15-9225-e02249a094d2",
                                "text": "Kritiker bezeichnen das Buch als puren Sexismus."
                            },
                            {
                                "example_id": "59c04534-a9bf-47ea-9ca6-a62fc2b753db",
                                "sense_id": "b4e43590-0914-3f15-9225-e02249a094d2",
                                "text": "„Mundarten haben auch keine Angst vor dem Vorwurf des Sexismus.“"
                            },
                            {
                                "example_id": "27f68ef3-1522-43fe-abb2-be2221cde33c",
                                "sense_id": "b4e43590-0914-3f15-9225-e02249a094d2",
                                "text": "„Aber es war nicht nur der offensichtliche Sexismus, der mich in dieser Situation störte, sondern auch die schiere Dummheit, das Fehlen jeglicher Logik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dea2a93b-d20b-40c9-bac8-4022c36e23c2",
                        "source_entry_id": "f25f8f5f-d018-3fec-8146-c4b25d932af1",
                        "source_sense_id": "b4e43590-0914-3f15-9225-e02249a094d2",
                        "source_sense_description": "Diskriminierung aufgrund des Geschlechts oder der sexuellen Neigung",
                        "target_lang_word": "sexism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sexism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85ab5b8e-99e8-3bdc-a8bb-1c140f14b3a4",
                                        "entry_id": "ab5bb114-0d9a-358d-9246-3a3fd32c9b35",
                                        "glosses": [
                                            "The belief that people of one sex (or gender) are inherently different from those of another sex, and generally that one sex is superior to others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35c30257-fd86-436f-a799-88d95fdeb0d7",
                                                "sense_id": "85ab5b8e-99e8-3bdc-a8bb-1c140f14b3a4",
                                                "text": "The notion that either gender is superior is sexism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5a47c77-2b6e-30ef-b1e4-97a7bde17f85",
                                        "entry_id": "ab5bb114-0d9a-358d-9246-3a3fd32c9b35",
                                        "glosses": [
                                            "Discrimination or different treatment based on sex or gender, especially discrimination against women."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4ab249d-c6a9-4055-98d5-a9fc70d07705",
                                                "sense_id": "e5a47c77-2b6e-30ef-b1e4-97a7bde17f85",
                                                "text": "The fact that there is only one woman in a management position in that company makes it easy to believe that sexism runs rampant there."
                                            },
                                            {
                                                "example_id": "8b6cfc34-2e4e-48a8-8502-b8381786d79c",
                                                "sense_id": "e5a47c77-2b6e-30ef-b1e4-97a7bde17f85",
                                                "text": "Dati launched a blistering attack on the prime minister, François Fillon, under whom she served as justice minister, accusing him of sexism, elitism, arrogance and hindering the political advancement of ethnic minorities."
                                            },
                                            {
                                                "example_id": "014338ee-ea2f-42c8-b98d-73a1af41b86c",
                                                "sense_id": "e5a47c77-2b6e-30ef-b1e4-97a7bde17f85",
                                                "text": "Beyond the glaring sexism inherent in suggesting that women's brains are so different from men's that they can't think properly, Musk lending credence to this dogshit hypothesis is incredibly goofy given that he and his audience of supposedly \"high-T\" men seem far more likely to fall in line with the sort of groupthink the original post references in such pseudo-phrenological terms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e5635cb-61c5-363b-a376-34fc22031ddd",
                                        "entry_id": "ab5bb114-0d9a-358d-9246-3a3fd32c9b35",
                                        "glosses": [
                                            "Attitudes or actions that are based on or promote the expectation that people adhere to stereotypical social roles (gender roles) based on sex."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d7e80c8-ae25-4e33-87ad-e37771f93857",
                                                "sense_id": "6e5635cb-61c5-363b-a376-34fc22031ddd",
                                                "text": "The sexism of making and promoting violent films for men and romantic comedies for women."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2c3f4f9-4472-4f17-a30a-1e9b9922cf27",
                        "source_entry_id": "f25f8f5f-d018-3fec-8146-c4b25d932af1",
                        "source_sense_id": "b4e43590-0914-3f15-9225-e02249a094d2",
                        "source_sense_description": "Diskriminierung aufgrund des Geschlechts oder der sexuellen Neigung",
                        "target_lang_word": "sexisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sexisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba44fa06-0378-382d-b1f7-47b3a66c5c9d",
                                        "entry_id": "48a6c5c5-0077-3922-bf91-0ec48e5b0b92",
                                        "glosses": [
                                            "Attitude, acte ou parole discriminatoire, fondé sur des stéréotypes ou des préjugés liés au sexe ou au genre, visant à maintenir ou justifier une hiérarchie entre les individus."
                                        ],
                                        "tags": [
                                            "Psychologie sociale",
                                            "Travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "066fca88-40f0-49c5-8c81-174d483241e1",
                                                "sense_id": "ba44fa06-0378-382d-b1f7-47b3a66c5c9d",
                                                "text": "L’anecdote s’inscrit dans le contexte des nombreuses affaires de sexisme, de discrimination sexuelle et de harcèlement dans la Silicon Valley et le monde loin d’être rose des start-up et de la tech."
                                            },
                                            {
                                                "example_id": "a93416f9-a741-456e-8869-9b5f1860aa8b",
                                                "sense_id": "ba44fa06-0378-382d-b1f7-47b3a66c5c9d",
                                                "text": "Les filles n’étaient pas, contrairement au lieu commun actuel, surveillées par sexisme, mais pour leur propre protection, parce que devenir, comme on disait, « fille mère » était la voie royale vers une existence difficile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea4cee27-4add-3bcf-beee-0e1302978755",
                                        "entry_id": "48a6c5c5-0077-3922-bf91-0ec48e5b0b92",
                                        "glosses": [
                                            "Système idéologique et social reposant sur des croyances et des stéréotypes relatifs au sexe ou au genre, et produisant des rapports de pouvoir inégalitaires, des discriminations et des inégalités institutionnelles, économiques et culturelles."
                                        ],
                                        "tags": [
                                            "Science politique",
                                            "Études de genre",
                                            "Études féministes",
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68f1030b-f769-4f3f-8978-0683fb05cb87",
                                                "sense_id": "ea4cee27-4add-3bcf-beee-0e1302978755",
                                                "text": "Nous ne pouvons tolérer ni le sexisme ni le racisme dans notre communauté."
                                            },
                                            {
                                                "example_id": "d4051feb-e045-4a28-93f1-5ba59edd7f57",
                                                "sense_id": "ea4cee27-4add-3bcf-beee-0e1302978755",
                                                "text": "Le « sexisme » est tout un système dont le moteur est la discrimination des individus en fonction de leur sexe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9e292bc-04ea-415d-8cc4-fd22eff590ed",
