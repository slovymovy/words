{
    "word_family": [
        "kartonada",
        "kartonik",
        "kartoniarka",
        "kartonownia",
        "kartonowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b504f472-78de-392b-a670-75927623633d",
                    "sense_definition": "pudełko lub opakowanie wykonane z grubej tektury",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "opakowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszystkie stare książki spakowałem w duży <w>karton</w> i wyniosłem do piwnicy.",
                            "target_lang_translations": {
                                "ru": "Все старые книги я сложил в большую <w>картонную коробку</w> и отнёс в подвал."
                            }
                        },
                        {
                            "text": "Codziennie rano piję świeże mleko prosto z <w>kartonu</w>.",
                            "target_lang_translations": {
                                "ru": "Каждое утро я пью свежее молоко прямо из <w>пакета</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pudło"
                    ],
                    "common_phrases": [
                        "karton mleka",
                        "duży karton",
                        "spakować do kartonu"
                    ],
                    "target_lang_definitions": {
                        "ru": "коробка или упаковка из плотного картона"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картонная коробка",
                                "target_lang_sense_clarification": "упаковка из картона"
                            },
                            {
                                "target_lang_word": "коробка",
                                "target_lang_sense_clarification": "емкость, тара"
                            },
                            {
                                "target_lang_word": "пакет",
                                "target_lang_sense_clarification": "тетрапак для молока, сока"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dbe1655-8d74-3f1b-9ca1-7545c2c9b7ef",
                    "sense_definition": "gruby, sztywny papier używany m.in. do rysowania lub produkcji opakowań",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "materiał",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci wycinały kolorowe maski na bal z twardego <w>kartonu</w>.",
                            "target_lang_translations": {
                                "ru": "Дети вырезали цветные маски для бала из твёрдого <w>картона</w>."
                            }
                        },
                        {
                            "text": "Uliczny artysta malował piękne pejzaże na białym <w>kartonie</w>.",
                            "target_lang_translations": {
                                "ru": "Уличный художник рисовал красивые пейзажи на белом <w>картоне</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "brystol",
                        "tektura"
                    ],
                    "common_phrases": [
                        "kolorowy karton",
                        "kawałek kartonu"
                    ],
                    "target_lang_definitions": {
                        "ru": "толстая, плотная бумага, используемая для рисования или изготовления упаковок"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картон",
                                "target_lang_sense_clarification": "материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63c446c8-b6c3-3df3-a815-157905cb3a89",
                    "sense_definition": "ilość towaru mieszcząca się w jednym tekturowym opakowaniu",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opakowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na przyjęcie urodzinowe kupiliśmy cały <w>karton</w> soku jabłkowego.",
                            "target_lang_translations": {
                                "ru": "На день рождения мы купили целую <w>коробку</w> яблочного сока."
                            }
                        },
                        {
                            "text": "W magazynie zostało jeszcze pięć <w>kartonów</w> nowych butów sportowych.",
                            "target_lang_translations": {
                                "ru": "На складе осталось ещё пять <w>коробок</w> новой спортивной обуви."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cały karton"
                    ],
                    "target_lang_definitions": {
                        "ru": "количество товара, вмещающееся в одну картонную коробку"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коробка",
                                "target_lang_sense_clarification": "мера объема или количества"
                            },
                            {
                                "target_lang_word": "ящик",
                                "target_lang_sense_clarification": "упаковка с товаром"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f16b4ec6-57ad-3e12-beaa-e33f545714a7",
                    "sense_definition": "opakowanie zbiorcze papierosów mieszczące zazwyczaj dziesięć paczek",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opakowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas kontroli celnicy znaleźli w bagażniku samochodu nielegalny <w>karton</w> papierosów.",
                            "target_lang_translations": {
                                "ru": "Во время досмотра таможенники обнаружили в багажнике автомобиля нелегальный <w>блок</w> сигарет."
                            }
                        },
                        {
                            "text": "Kupując od razu cały <w>karton</w> papierosów, można było trochę zaoszczędzić.",
                            "target_lang_translations": {
                                "ru": "Покупая сразу целый <w>блок</w> сигарет, можно было немного сэкономить."
                            }
                        }
                    ],
                    "synonyms": [
                        "wagon"
                    ],
                    "common_phrases": [
                        "karton papierosów"
                    ],
                    "target_lang_definitions": {
                        "ru": "групповая упаковка сигарет, обычно содержащая десять пачек"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блок",
                                "target_lang_sense_clarification": "блок сигарет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be11e49b-415a-3068-80ef-24e0580f5ef1",
                    "sense_definition": "szkic w skali rzeczywistej wykonany na grubym papierze jako wzór do fresku, gobelinu lub mozaiki",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sztuka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Renesansowy mistrz przygotował szczegółowy <w>karton</w> przed przystąpieniem do malowania fresku.",
                            "target_lang_translations": {
                                "ru": "Мастер эпохи Возрождения подготовил подробный <w>картон</w>, прежде чем приступить к росписи фрески."
                            }
                        },
                        {
                            "text": "W muzeum zachował się oryginalny <w>karton</w> do wielkiego gobelinu z epoki baroku.",
                            "target_lang_translations": {
                                "ru": "В музее сохранился оригинальный <w>картон</w> для большого гобелена эпохи барокко."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "подготовительный рисунок в натуральную величину на плотной бумаге для фрески, мозаики или гобелена"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картон",
                                "target_lang_sense_clarification": "эскиз в натуральную величину в искусстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b882a82-bea6-382b-84e3-25e51f4bab92",
                    "sense_definition": "cienka, gęsto tkana tkanina bawełniana używana dawniej na bieliznę lub pościel",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "materiał",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W zabytkowym dworku pościel uszyta była z delikatnego, gładkiego <w>kartonu</w>.",
                            "target_lang_translations": {
                                "ru": "В старинной усадьбе постельное бельё было сшито из нежного, гладкого <w>перкаля</w>."
                            }
                        },
                        {
                            "text": "W dawnych magazynach tekstylnych znaleziono bele staroświeckiego <w>kartonu</w> bawełnianego.",
                            "target_lang_translations": {
                                "ru": "На старых текстильных складах нашли тюки старомодного хлопчатобумажного <w>перкаля</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "perkal"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historyczne określenie tkaniny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "тонкая плотная хлопчатобумажная ткань, ранее использовавшаяся для белья или постельных принадлежностей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перкаль",
                                "target_lang_sense_clarification": "вид тонкой плотной ткани"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}