                        "target_lang_word": "век",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "век",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bf83f244-9e53-3b89-8b26-008b97bc3ebb",
                                        "entry_id": "f1424afc-0688-3216-b0a4-b03107c71edf",
                                        "glosses": [
                                            "столетие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf371f7c-4447-4a6a-93b5-c78e22c67414",
                                                "sense_id": "bf83f244-9e53-3b89-8b26-008b97bc3ebb",
                                                "text": "В четырнадцатом веке роль руководящей державы на Западе берет на себя Франция."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df433357-cdb8-3d0c-b77f-1788bd5eccb0",
                                        "entry_id": "f1424afc-0688-3216-b0a4-b03107c71edf",
                                        "glosses": [
                                            "протяжение жизни кого-либо или чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30e6f6e2-140a-482c-b332-82250f6713cd",
                                                "sense_id": "df433357-cdb8-3d0c-b77f-1788bd5eccb0",
                                                "text": "На своём веку этот кот повидал немало."
                                            },
                                            {
                                                "example_id": "bdeb64fc-e7e4-4b2d-9fd4-6fc4104840eb",
                                                "sense_id": "df433357-cdb8-3d0c-b77f-1788bd5eccb0",
                                                "text": "Главная причина всех этих неудобств банальна: старые эскалаторы отслужили свой век и требуют замены."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "657f3172-aae5-39f2-a831-a94002c688b9",
                                        "entry_id": "f1424afc-0688-3216-b0a4-b03107c71edf",
                                        "glosses": [
                                            "исторический период, эпоха"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2beff5ff-2df5-44cb-97ea-8ea2d50f1367",
                                                "sense_id": "657f3172-aae5-39f2-a831-a94002c688b9",
                                                "text": "Уже давно прошел серебряный, а тем более — золотой век русской литературы."
                                            },
                                            {
                                                "example_id": "ebab28e9-3442-4fd3-beb7-5b690efc8f1f",
                                                "sense_id": "657f3172-aae5-39f2-a831-a94002c688b9",
                                                "text": "Большое внимание было уделено изучению памятников переходного времени от неолита к бронзовому веку и от бронзового века к раннему железному."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd7a38e-8d05-35ee-9393-9116a67813c3",
                                        "entry_id": "f1424afc-0688-3216-b0a4-b03107c71edf",
                                        "glosses": [
                                            "геол. геологический век; промежуток времени, в течение которого образовались отложения, соответствующие геологическому ярусу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eeded61-2bc9-49f1-a24c-582401d6f713",
                                                "sense_id": "2fd7a38e-8d05-35ee-9393-9116a67813c3",
                                                "text": "Эйфельская трансгрессия сопровождалась вулканической деятельностью, особенно бурно протекавшей на территории Рудного Алтая во второй половине эйфельского века."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "век",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "511dbd7e-7689-30d6-8d4e-a8c025aef0b3",
                                        "entry_id": "fb47538c-0e1e-331b-96ba-da8f6fe847c8",
