                        ],
                        "form": "décharnées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80a34afb-71f4-3a50-b3b1-3fb26a717d10",
                        "entry_id": "84affc25-1aed-3a1d-82b4-9153a6e946d8",
                        "glosses": [
                            "Maigre ; amaigri ; squelettique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0455f205-52cf-4c2f-a6d3-162cf531096a",
                                "sense_id": "80a34afb-71f4-3a50-b3b1-3fb26a717d10",
                                "text": "Mais voici. Sur le seuil du juste assassiné,\nCroisant ses bras velus sur sa large poitrine,\nSe dresse un grand vieillard, farouche et décharné."
                            },
                            {
                                "example_id": "8fcdd3d3-0f05-4568-a12f-75769213db7e",
                                "sense_id": "80a34afb-71f4-3a50-b3b1-3fb26a717d10",
                                "text": "C’était un jeune chat, menu et décharné, qui frottait sa tête contre les jambes de Bert, en ronronnant."
                            },
                            {
                                "example_id": "4b391735-858b-4293-b0a9-34001f077837",
                                "sense_id": "80a34afb-71f4-3a50-b3b1-3fb26a717d10",
                                "text": "Oncle Archibald, d’un ton gouailleur\nLui dit : « Va-t’en faire pendre ailleurs\nTon squelette\nFi ! des femelles décharnées !\nVive les belles un tantinet\nRondelettes ! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "79ab027b-68d7-3f57-928a-115ff2d29c75",
                        "entry_id": "84affc25-1aed-3a1d-82b4-9153a6e946d8",
                        "glosses": [
                            "Pauvre, sec."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "79c4d985-d5a5-42e9-8f3b-1fff23272d11",
                                "sense_id": "79ab027b-68d7-3f57-928a-115ff2d29c75",
                                "text": "Sur le revers d’une de ces collines décharnées qui bossuent les Landes, entre Dax et Mont-de-Marsan, s’élevait, sous le règne de Louis XIII, une de ces gentilhommières si communes en Gascogne, et que les villageois décorent du nom de château."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c628aeaf-188e-4950-bfea-8185b134dfcf",
                        "source_entry_id": "84affc25-1aed-3a1d-82b4-9153a6e946d8",
                        "source_sense_description": "Maigre, amaigri, squelettique",
                        "target_lang_word": "scrawny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scrawny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7f40fec-8594-3a86-827e-9f06a21f17be",
                                        "entry_id": "a63b80cb-60a0-3df3-9873-2867da683631",
                                        "glosses": [
                                            "Thin, malnourished, and weak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9d8d48d-f68b-4e35-90cc-43748fd6c284",
                                                "sense_id": "a7f40fec-8594-3a86-827e-9f06a21f17be",
                                                "text": "“Tell him, in these words, that I will have his scrawny bones before me now. Tell him, Byar, and bring him if you must arrest him and those filthy wretches who disgrace the Children. Go.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
