            "senses": [
                {
                    "sense_id": "e8d32916-7b52-3a62-b3ef-e03893baa6d9",
                    "sense_definition": "To signify, indicate, or give evidence of something by a visible sign or token.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet confidence in her voice seemed to <w>betoken</w> a deep inner strength."
                        },
                        {
                            "text": "A sudden silence fell over the room, which appeared to <w>betoken</w> their growing nervousness."
                        }
                    ],
                    "synonyms": [
                        "indicate",
                        "mark",
                        "note"
                    ],
                    "common_phrases": [
                        "betoken a change",
                        "betoken a shift"
                    ]
                },
                {
                    "sense_id": "7860a69d-1bae-329f-a4b8-5fb1c1988c04",
                    "sense_definition": "To foreshadow or indicate a future event by present signs; to portend.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gathering dark clouds on the horizon <w>betoken</w> an approaching winter storm."
                        },
                        {
                            "text": "Ancient scholars believed the appearance of a rare comet <w>betokened</w> great misfortune."
                        }
                    ],
                    "synonyms": [
                        "portend",
                        "presage",
                        "forebode"
                    ],
                    "common_phrases": [
