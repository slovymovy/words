        "de-extract.jsonl": [
            {
                "entry_id": "b27de309-b823-3857-a949-cbe394152a25",
                "word": "Greenland",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1e6de74e-3715-3752-ab2a-c086fe00f94a",
                        "entry_id": "b27de309-b823-3857-a949-cbe394152a25",
                        "glosses": [
                            "Grönland"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5c363eb-8e58-4051-96b8-b2752cab83a1",
                        "source_entry_id": "b27de309-b823-3857-a949-cbe394152a25",
                        "source_sense_id": "1e6de74e-3715-3752-ab2a-c086fe00f94a",
                        "source_sense_description": "Grönland",
                        "target_lang_word": "Grönland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grönland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                        "entry_id": "67ee84d8-b020-3cff-988e-267c9c747c5a",
                                        "glosses": [
                                            "größte Insel der Erde, autonomer Bestandteil Dänemarks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "099e9f28-8f55-4ad8-a046-b35454122e73",
                                                "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                                "text": "Man kann auch auf Grönland Urlaub machen."
                                            },
                                            {
                                                "example_id": "b837b6fc-1e62-4687-8ec1-1ed4610679e5",
                                                "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                                "text": "Das Grönland der Wikingerzeit war anders als das heutige."
                                            },
                                            {
                                                "example_id": "92b59d2f-da68-467e-b82b-d8c63ecccb76",
                                                "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                                "text": "„Island und Grönland haben eines gemeinsam: Beide waren Kolonien Dänemarks.“"
                                            },
                                            {
                                                "example_id": "d40b4310-1049-4abd-97e4-932ce6cf6c74",
                                                "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                                "text": "„Dänische Forscher sind überzeugt, an der Südwestküste Grönlands den größten Meteoritenkrater der Welt gefunden zu haben.“"
                                            },
                                            {
                                                "example_id": "d66e1915-b806-4f52-8aa4-7e30582d7a9e",
                                                "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                                "text": "„Frühe Archäologen und Anthropologen fanden immer mehr Ähnlichkeiten zwischen den indigenen Bevölkerungen der polaren Regionen Sibiriens, Nordamerikas und Grönlands.“"
                                            },
                                            {
                                                "example_id": "9db3f50f-4641-4589-a2c3-4e5d649c03d3",
                                                "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                                "text": "„Ich erinnerte mich an ihn in Grönland, bevor meine Mutter starb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7940a04-51f6-457f-bede-3d35b31a3d77",
                        "source_entry_id": "b27de309-b823-3857-a949-cbe394152a25",
                        "source_sense_id": "1e6de74e-3715-3752-ab2a-c086fe00f94a",
                        "source_sense_description": "Grönland",
                        "target_lang_word": "Groenland",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Groenland",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96198c6a-f2dc-39d0-ac72-966b25b6ccb3",
                                        "entry_id": "22008fc6-79af-3b5f-8697-a5dcd61500e1",
                                        "glosses": [
                                            "Très grande île située au nord de l’océan Atlantique."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "108255c5-c0b3-46a8-8675-a929fc34bd84",
                                                "sense_id": "96198c6a-f2dc-39d0-ac72-966b25b6ccb3",
                                                "text": "Le Groenland, qui a la chance d’appartenir au Danemark, est, après l’Australie, la plus grande île du monde ; son étendue correspond approximativement au quart de celle de l’Europe."
                                            },
                                            {
                                                "example_id": "020e95b8-9d98-4416-9008-b068a99a6a67",
                                                "sense_id": "96198c6a-f2dc-39d0-ac72-966b25b6ccb3",
                                                "text": "Des gisements célèbres du Groenland ont été étudiés par Heer. On y trouvait Noisetiers, Magnolias, Liquidambars, Vignes, Platanes, et des Conifères comme les Cyprès chauves."
                                            },
                                            {
                                                "example_id": "7e742fa4-32ea-40b5-a35c-fc10add3de13",
                                                "sense_id": "96198c6a-f2dc-39d0-ac72-966b25b6ccb3",
                                                "text": "Il n’y a que quelques régions où l’ours polaire cohabite avec le bœuf musqué : sur la côte est du Groenland et dans quelques régions centrales de l’Arctique canadien."
                                            },
                                            {
                                                "example_id": "49a20922-a7b5-4fdd-9f88-bc8528425133",
                                                "sense_id": "96198c6a-f2dc-39d0-ac72-966b25b6ccb3",
                                                "text": "Le Groenland attise de longue date les convoitises pour ses ressources naturelles (fer, plomb, zinc, or, nickel, platine et métaux rares) - bien que la prospection pétrolière et l’exploitation de l’uranium y soient interdites - et aussi pour son importance géostratégique. Les États-Unis y ont d’ailleurs déjà une base militaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "137b2181-fbcc-3579-97e2-6c7eb191bfa8",
                                        "entry_id": "22008fc6-79af-3b5f-8697-a5dcd61500e1",
                                        "glosses": [
                                            "Territoire occupant cette île, pays constitutif du royaume du Danemark et territoire d’outre-mer associé à l’Union européenne."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a242e61a-72db-4e9a-8297-43a90499196b",
                                                "sense_id": "137b2181-fbcc-3579-97e2-6c7eb191bfa8",
                                                "text": "Depuis que le fils de Donald Trump s’est rendu à Nuuk, la capitale du pays, et que le président américain a refusé d’exclure le recours à la force militaire pour acquérir ce territoire danois autonome qu’il convoitise tant, le Groenland fait la Une des journaux européens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
