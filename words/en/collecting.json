                    "sense_definition": "Present participle and gerund of <w>collect</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are currently <w>collecting</w> donations for the local animal shelter.",
                            "target_lang_translations": {
                                "ru": "В данный момент мы <w>собираем</w> пожертвования для местного приюта для животных.",
                                "tr": "Şu anda yerel hayvan barınağı için bağış <w>topluyoruz</w>."
                            }
                        },
                        {
                            "text": "She is busy <w>collecting</w> her thoughts before the important meeting.",
                            "target_lang_translations": {
                                "ru": "Она занята тем, что <w>собирается</w> с мыслями перед важной встречей.",
                                "tr": "Önemli toplantıdan önce düşüncelerini <w>toparlamakla</w> meşgul."
                            }
                        }
                    ],
                    "synonyms": [
                        "gathering",
                        "accumulating",
                        "assembling"
                    ],
                    "antonyms": [
                        "distributing",
                        "scattering"
                    ],
                    "common_phrases": [
