                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een slapeloze nacht zag haar gezicht er erg <w>vaal</w> en vermoeid uit.",
                            "target_lang_translations": {
                                "en": "After a sleepless night, her face looked very <w>pale</w> and tired."
                            }
