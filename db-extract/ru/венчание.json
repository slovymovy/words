                    },
                    {
                        "sense_id": "fa7008f8-9c86-3c68-9c37-e0db1b38ba41",
                        "entry_id": "ab1cbcf8-87e7-3689-8c3c-aa9eec498f00",
                        "glosses": [
                            "религ., церк. христианский церковный обряд бракосочетания"
                        ],
