                    {
                        "translation_id": "4969c0bd-506d-4eb4-9e67-4555527952ba",
                        "source_entry_id": "5587ed85-4563-308d-ac52-fbbb31eafe71",
                        "source_sense_id": "810b3624-3b39-3760-bcf4-b2d72a4666dc",
                        "source_sense_description": "free of a misconception",
                        "target_lang_word": "détromper",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détromper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c0240d2-7938-3b64-a1ca-d65a284a5d0f",
                                        "entry_id": "ef3dec21-30ab-3738-a894-df13d5612a00",
                                        "glosses": [
                                            "Tirer quelqu’un de l’erreur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94abb7a6-85a2-4797-8a03-20192ffb1cf8",
                                                "sense_id": "1c0240d2-7938-3b64-a1ca-d65a284a5d0f",
                                                "text": "Je ne crus point ici devoir détromper le père Milot au sujet de ses croyances linguistiques et il continua : […]."
                                            },
                                            {
                                                "example_id": "cc8b8d9a-9d4d-40aa-8fe9-26d2288f027a",
                                                "sense_id": "1c0240d2-7938-3b64-a1ca-d65a284a5d0f",
                                                "text": "Je veux vous détromper sur le compte de cet homme-là. — Il se fiait à ce fripon, j’ai eu bien de la peine à l’en détromper."
                                            },
                                            {
                                                "example_id": "2190ee91-79f1-4090-a663-671521ef2194",
                                                "sense_id": "1c0240d2-7938-3b64-a1ca-d65a284a5d0f",
                                                "text": "— Pour la détromper mon oncle, je crois qu’une bonne fessée s’impose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9ad2ee0-6631-44cf-adf7-117339e192eb",
                        "source_entry_id": "5587ed85-4563-308d-ac52-fbbb31eafe71",
                        "source_sense_id": "810b3624-3b39-3760-bcf4-b2d72a4666dc",
                        "source_sense_description": "free of a misconception",
                        "target_lang_word": "aufklären",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufklären",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d60b4d50-85a4-3e4b-af9b-2377c0192ee4",
                                        "entry_id": "fd70c146-faab-3c46-aca1-e2bf0f611a66",
                                        "glosses": [
                                            "die Wahrheit über etwas Ungeklärtes ans Licht bringen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85dff437-0b47-4d62-8c94-4effb8762323",
                                                "sense_id": "d60b4d50-85a4-3e4b-af9b-2377c0192ee4",
                                                "text": "Die Polizei konnte den Tathergang rekonstruieren und den Fall aufklären."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "84a1741c-b961-3c80-84c8-5231e30ecfff",
                                        "entry_id": "fd70c146-faab-3c46-aca1-e2bf0f611a66",
                                        "glosses": [
                                            "aufhören, ungeklärt zu sein"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ce56bf7-023c-4699-bb2c-a9e54af80fae",
                                                "sense_id": "84a1741c-b961-3c80-84c8-5231e30ecfff",
                                                "text": "Das Missverständnis zwischen uns klärte sich erst gestern auf, als meine Freundin mir deutlich machte, dass sie mich doch nicht verlassen wolle."
                                            },
                                            {
                                                "example_id": "1fed67d8-3b53-4cc7-9d37-9f1cb52ea8ec",
                                                "sense_id": "84a1741c-b961-3c80-84c8-5231e30ecfff",
                                                "text": "Der Unfall klärte sich von selbst auf, als die Ermittler die Schäden am Fahrzeug begutachteten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5b60fd17-6d9f-3a6b-ada4-d662064aa4b1",
                                        "entry_id": "fd70c146-faab-3c46-aca1-e2bf0f611a66",
                                        "glosses": [
                                            "jemanden Unwissenden über etwas informieren [meist mit dem Ziel, dass er zukünftig entsprechend handeln kann]"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f5bbaf2-f412-4da0-a849-9d31f9df36d4",
                                                "sense_id": "5b60fd17-6d9f-3a6b-ada4-d662064aa4b1",
                                                "text": "Sein Freund klärte ihn auf, dass er [die Platte] verkauft habe und dass er ihm dafür eine Rechnung stellen solle. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "e659b436-3ab5-4767-a37d-927c3534e1c4",
                                                "sense_id": "5b60fd17-6d9f-3a6b-ada4-d662064aa4b1",
                                                "text": "Der Staatsanwalt musste die Angeklagte zunächst über ihre Rechte aufklären."
                                            },
                                            {
                                                "example_id": "35c2480d-92b1-48df-b7cd-8666e2799de7",
                                                "sense_id": "5b60fd17-6d9f-3a6b-ada4-d662064aa4b1",
                                                "text": "Bitte kläre mich darüber auf, was hier geschieht!"
                                            },
                                            {
                                                "example_id": "bf4987c7-e924-4777-a61b-4d4da3314235",
                                                "sense_id": "5b60fd17-6d9f-3a6b-ada4-d662064aa4b1",
                                                "text": "Die Infektion erfasse den ganzen Körper und könne bis zum Organversagen führen, klärte der Experte auf."
                                            },
                                            {
                                                "example_id": "04f8c86c-52d9-4f1a-9909-18c45dea48fe",
                                                "sense_id": "5b60fd17-6d9f-3a6b-ada4-d662064aa4b1",
                                                "text": "Der Postbeamte klärte ihn [darüber] auf, wie ein Standardbrief zu frankieren ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "91533952-e3bc-3463-a653-06f9984cdccf",
                                        "entry_id": "fd70c146-faab-3c46-aca1-e2bf0f611a66",
                                        "glosses": [
                                            "[einen Jugendlichen] über die zwischenmenschliche Sexualität informieren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dcb27e0-d5c4-40db-b499-60d983676812",
                                                "sense_id": "91533952-e3bc-3463-a653-06f9984cdccf",
                                                "text": "Es ist nach Meinung einiger die Pflicht der Eltern, ihre Kinder vor der ersten sexuellen Erfahrung ausreichend aufzuklären."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "12e8b139-2eb0-3527-a3c1-ce7ab62f18de",
                                        "entry_id": "fd70c146-faab-3c46-aca1-e2bf0f611a66",
                                        "glosses": [
                                            "sich aufheitern, klar werden"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "outdated",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "567f10db-64c5-44b5-99d0-1bf2be4bf3ed",
                                                "sense_id": "12e8b139-2eb0-3527-a3c1-ce7ab62f18de",
                                                "text": "Dem Wetterbericht zufolge wird es heute Nachmittag zunächst bedeckt sein, dann soll sich der Himmel allerdings wieder aufklären."
                                            },
                                            {
                                                "example_id": "eeb96241-df42-48d4-965b-d7d38848cac7",
                                                "sense_id": "12e8b139-2eb0-3527-a3c1-ce7ab62f18de",
                                                "text": "„Nun, ich will jetzt meinen Besuch machen, das Wetter hat sich ja aufgeklärt […]“ (Paul Heyse, Marienkind, 1892)"
                                            },
                                            {
                                                "example_id": "c42e4312-13bf-4183-88f0-eadb1ea7b6b7",
                                                "sense_id": "12e8b139-2eb0-3527-a3c1-ce7ab62f18de",
                                                "text": "„[S]prach darauf langsam: ‚Ich glaube, daß mich Gott‘, [und] fügte, während ihr Gesicht sich aufklärte, rasch hinzu: ‚– geschaffen hat samt allen Kreaturen‘ […]“ (Thomas Mann, Buddenbrooks, 1901)"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
