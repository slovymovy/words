                    "sense_definition": "waard om betreurd te worden of spijt over te hebben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regrettable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit was een <w>betreurenswaardige</w> vergissing die we niet meer kunnen herstellen.",
                            "target_lang_translations": {
