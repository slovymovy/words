                                                "sense_id": "faac39d6-23a4-3351-a156-3a69d5457c82",
                                                "text": "Amsterdam ist die Hauptstadt der Niederlande."
                                            },
                                            {
                                                "example_id": "31dbe08f-7020-4863-b189-25e8b177eb1d",
                                                "sense_id": "faac39d6-23a4-3351-a156-3a69d5457c82",
                                                "text": "Holland ist eigentlich nur der Name einer Region in den Niederlanden, wird aber auch im Land selbst als Synonym akzeptiert."
                                            },
                                            {
                                                "example_id": "244f7c99-2cda-44dd-b342-720f1571fc51",
                                                "sense_id": "faac39d6-23a4-3351-a156-3a69d5457c82",
                                                "text": "„Teile der Niederlande, wie zum Beispiel fast die gesamte Provinz Flevoland, wurden durch Landgewinnung dem Meer abgewonnen.“"
                                            },
                                            {
                                                "example_id": "594fade4-1369-4536-9a1d-d978003b590e",
                                                "sense_id": "faac39d6-23a4-3351-a156-3a69d5457c82",
                                                "text": "„Amateurastronomen haben mit einem Teleskop in den Niederlanden Signale der Raumsonde Voyager 1 empfangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
