                "senses": [
                    {
                        "sense_id": "313bced5-e888-37bd-8305-a9b8fffbea27",
                        "entry_id": "3b2f7d95-6bdf-3c55-adf7-a109cb3d2525",
                        "glosses": [
                            "Papier zum Verpacken von Geschenken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b800abb9-feb5-4738-a421-b7de95b8aa47",
                                "sense_id": "313bced5-e888-37bd-8305-a9b8fffbea27",
                                "text": "Verbrauchst du immer 20 Rollen Geschenkpapier zu Weihnachten?"
                            },
                            {
                                "example_id": "498b905f-4a76-4674-91bc-97881c27dd8d",
                                "sense_id": "313bced5-e888-37bd-8305-a9b8fffbea27",
                                "text": "„Der Bäcker legte sie in eine hübsche Pappschachtel und wickelte sie in prachtvolles Geschenkpapier ein.“"
                            },
                            {
                                "example_id": "3f29f8da-ad5b-47c9-b7c4-8696d804ecbe",
                                "sense_id": "313bced5-e888-37bd-8305-a9b8fffbea27",
                                "text": "„Ich höre schon das Geschenkpapier rascheln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
