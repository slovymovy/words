                        ],
                        "examples": [
                            {
                                "example_id": "8c3c6885-e3be-49c5-a86a-9da2610b15a5",
                                "sense_id": "16c22984-a520-305f-b791-2891853239b9",
                                "text": "Industry will meet this obligation either voluntarily or coercibly through taxes."
                            },
                            {
                                "example_id": "b14d3412-5344-4589-b4e8-bc85a23d6610",
                                "sense_id": "16c22984-a520-305f-b791-2891853239b9",
                                "text": "Had the Persians, however, not transported those Paionians farther east, we must consider that hundreds of other Skudrians had also entered Asia and traveled to Parsa, either freely or coercibly."
