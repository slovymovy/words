                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67b39d8b-aebd-4c3a-be4d-30ba8df674e3",
                                                "sense_id": "939630bf-93d9-3819-a99f-77fd70ba1870",
                                                "text": "Нет; когда уровняет поверхность ее, он сеет чернуху, или рассыпает тмин, или разбрасывает пшеницу рядами, и ячмень в определенном месте, и полбу рядом с ним."
                                            }
                                        ]
                                    },
