                {
                    "sense_id": "661eae83-050d-3bc1-9381-14661b7ee7c5",
                    "sense_definition": "A rainbow trout.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went fishing early in the morning and caught a large <w>rainbow</w>.",
                            "target_lang_translations": {
                                "ru": "Он отправился на рыбалку рано утром и поймал большую <w>радужную форель</w>.",
                                "zh": "他清晨去钓鱼，钓到了一条大<w>虹鳟</w>。"
                            }
                        },
                        {
                            "text": "The river is famous for its abundance of wild <w>rainbows</w>.",
                            "target_lang_translations": {
                                "ru": "Река славится изобилием дикой <w>радужной форели</w>.",
                                "zh": "这条河以盛产野生<w>虹鳟</w>而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "catch a rainbow"
                    ],
                    "traits": [
                        {
