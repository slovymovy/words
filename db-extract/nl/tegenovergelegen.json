                        "entry_id": "4058c673-3de9-38cf-84e4-89eeee0f2ca2",
                        "glosses": [
                            "aan de overzijde liggend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61ce12cc-fa61-4e28-b28f-af2e9f6d3c2c",
                                "sense_id": "65e9d4f3-18c5-33a9-883c-59a66975d7c0",
                                "text": "De mist begon op te trekken en op een werst of twee afstand, op de tegenovergelegen heuvels, waren al vaag de vijandelijke troepen te zien."
                            },
                            {
                                "example_id": "8eb7705a-0119-4d39-9f9a-1e4666380f2c",
                                "sense_id": "65e9d4f3-18c5-33a9-883c-59a66975d7c0",
                                "text": "Het Mauritshuis in Den Haag gaat twee jaar dicht voor een grote verbouwing. Vandaag werd het ontwerp van de plannen gepresenteerd door directeur Gordenker. Het museum krijgt een ondergrondse foyer die het gebouw verbindt met het tegenovergelegen pand, Plein 26."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7fe0b43-dc9d-4040-b71b-df92ae084e2e",
                        "source_entry_id": "4058c673-3de9-38cf-84e4-89eeee0f2ca2",
                        "source_sense_id": "65e9d4f3-18c5-33a9-883c-59a66975d7c0",
