                "senses": [
                    {
                        "sense_id": "d6e3516f-e382-39eb-97e7-ddea3041868d",
                        "entry_id": "ec78eb29-68b3-3679-9132-95a2ea73def9",
                        "glosses": [
                            "Hafenstadt in Nordkorea"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c715fe5-34f7-46ec-bcf9-f17ac65df7d2",
                                "sense_id": "d6e3516f-e382-39eb-97e7-ddea3041868d",
                                "text": "„Man wusste, dass Großvater aus Wonsan im nordkoreanischen Hamkyoungnam-do stammte.“"
                            },
                            {
                                "example_id": "e553a565-afb5-4770-85a3-883cfc7e5308",
                                "sense_id": "d6e3516f-e382-39eb-97e7-ddea3041868d",
                                "text": "„Im Tauchgang erreichte es bloß eine mittlere Geschwindigkeit von zehn Stundenkilometern; die 445 Kilometer im offenen Meer zwischen dem nordkoreanischen Hafen Wonsan und diesem Abschnitt der japanischen Küste hatten sich also zu einer unbequemen Unterwasserreise von ganzen zwei Tagen gedehnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
