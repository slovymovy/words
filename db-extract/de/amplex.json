                        "examples": [
                            {
                                "example_id": "1ed734fe-bcd6-461b-832e-bc37cde5c4bb",
                                "sense_id": "9c5cd06e-3c9e-3584-b36d-8b4799c47103",
                                "text": "„Amplex (amplexus)“: „Die liturgische Umarmung beim Friedenskuss (pax). Sie geschieht in der Weise, dass der Grüßende seine Hände flach auf die Schultern des Empfängers, letzterer aber seine Arme unter die Ellenbogen des Gebers legt und dann beide ihre linke Wange einander nähern, ohne sich zu berühren.“"
                            }
                        ],
