                                            {
                                                "example_id": "a9c83a4c-d5d1-45f4-8574-a799c56b7418",
                                                "sense_id": "4bc0a7a0-31ec-346b-a301-0d479dcaaeae",
                                                "text": "Je cloche tout ce qui est clochable au moment du semis et de la plantation, c’est vraiment un système efficace contre les limaces."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clocher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01df5de7-2a19-3e0b-a614-939d2b4ddf01",
                                        "entry_id": "a38b2b2e-50e0-35dc-bacd-0ae0d88f194c",
                                        "glosses": [
                                            "Boiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "623d9294-25e8-4d20-8059-33fb3731bcc3",
                                                "sense_id": "01df5de7-2a19-3e0b-a614-939d2b4ddf01",
                                                "text": "L’un d’eux suivit assez longtemps M. Bergeret en clochant du pied, et toutefois d’un pas agile."
                                            },
                                            {
                                                "example_id": "77062e06-549b-4264-a1a4-8b17f13a39dc",
                                                "sense_id": "01df5de7-2a19-3e0b-a614-939d2b4ddf01",
                                                "text": "Assez belle fille à cela près qu’elle louchait d’un œil et clochait d’un pied."
                                            },
                                            {
                                                "example_id": "a9d2f92b-c73b-44a7-a8a5-4be9613c33d1",
                                                "sense_id": "01df5de7-2a19-3e0b-a614-939d2b4ddf01",
                                                "text": "L’enfant ne souffrait plus, clochait seulement un peu à gauche."
                                            },
                                            {
                                                "example_id": "3868d925-e7e7-4114-9558-bfa2d0149ad1",
                                                "sense_id": "01df5de7-2a19-3e0b-a614-939d2b4ddf01",
                                                "text": "Il ne faut pas clocher devant les boiteux, il ne faut pas rappeler aux gens quelque souvenir pénible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3cbbb05-8366-39a4-ab39-d31d753b7ddf",
                                        "entry_id": "a38b2b2e-50e0-35dc-bacd-0ae0d88f194c",
                                        "glosses": [
                                            "Être bancal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55ee6965-c890-4d57-aa9f-58b6a3dd95c8",
                                                "sense_id": "f3cbbb05-8366-39a4-ab39-d31d753b7ddf",
                                                "text": "Ce meuble cloche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a118402c-c4ec-33fa-8af3-64221732f9f0",
                                        "entry_id": "a38b2b2e-50e0-35dc-bacd-0ae0d88f194c",
                                        "glosses": [
                                            "Ne pas aller bien, avoir un défaut, en parlant de quelque chose."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2963ae22-a4e0-492d-ac36-0807d94a04f1",
                                                "sense_id": "a118402c-c4ec-33fa-8af3-64221732f9f0",
                                                "text": "Cependant elle me paraît soucieuse depuis quelque temps, y aurait-il quelque chose qui clocherait chez elle ?"
                                            },
                                            {
                                                "example_id": "f81b9c89-5c87-4646-8256-aba060cb63a1",
                                                "sense_id": "a118402c-c4ec-33fa-8af3-64221732f9f0",
                                                "text": "Nous étions allées porter à cette dame une robe de soirée, et il fallait qu’elle s’habillât devant nous afin de voir si rien ne clochait."
                                            },
                                            {
                                                "example_id": "9399fa3b-8b98-4829-891e-236eb704949f",
                                                "sense_id": "a118402c-c4ec-33fa-8af3-64221732f9f0",
                                                "text": "Il ne pouvait croire qu’il eût raison contre des magistrats dont il n’avait pas compris les raisons ; il lui était impossible de concevoir que quelque chose clochât dans une si belle cérémonie."
                                            },
                                            {
                                                "example_id": "91d22a7a-3275-4ec4-b6aa-b5e1b99ab764",
                                                "sense_id": "a118402c-c4ec-33fa-8af3-64221732f9f0",
                                                "text": "Est-ce que rien ne clochait dans ce plan ?"
                                            },
                                            {
                                                "example_id": "38a054f8-4f1d-47f3-b047-75508a88bf7e",
                                                "sense_id": "a118402c-c4ec-33fa-8af3-64221732f9f0",
                                                "text": "On aurait pu se douter que quelque chose clochait en voyant le tracé retenu par la Caisse et qui débordait largement le mandat initial qui était une desserte de l’aéroport et d’assurer le service sur le nouveau pont Samuel-De Champlain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
