                                        "sense_id": "d5a6231f-cbc7-3c04-a89e-0d9ae6ba3182",
                                        "entry_id": "71dfd939-2d96-3dfd-9663-8cf1eb1eff26",
                                        "glosses": [
                                            "Siliceous (including basanite)."
                                        ],
