                "senses": [
                    {
                        "sense_id": "837ff3d0-f862-3254-ac13-7b68210d7f86",
                        "entry_id": "f8f104d1-eaaf-31c6-861f-809e5a6f1a51",
                        "glosses": [
                            "Gesamtheit der Umstände, die das Sprechen beeinflussen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "788c41bf-5a05-4b15-b14a-a3e8487795f0",
                                "sense_id": "837ff3d0-f862-3254-ac13-7b68210d7f86",
                                "text": "„In der Redesituation selbst ist das nicht nötig, weil die Personen anwesend sind und sich direkt hören.“"
                            },
                            {
                                "example_id": "57f23a6f-2ab7-4557-8bb0-1193d7b55380",
                                "sense_id": "837ff3d0-f862-3254-ac13-7b68210d7f86",
                                "text": "„Natürlich kennt das Japanische zum Beispiel Anredepronomen, nicht nur zwei, sondern sogar mindestens sechs, aber diese spielen eher eine Nebenrolle, sind in zahlreichen Redesituationen gar nicht erlaubt und zum Teil nur auf die Männersprache beschränkt.“"
                            }
                        ],
