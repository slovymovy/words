                "senses": [
                    {
                        "sense_id": "dc328b94-bd8c-38c8-b4a3-3fb24a175565",
                        "entry_id": "7308660a-14e4-332e-b3bb-0884d37fc2f3",
                        "glosses": [
                            "kosmetisches Utensil, mit dem man die Fingernägel bearbeiten (abrunden, kürzen) kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bce1676-d1ec-4b97-9822-53e964b9ce13",
                                "sense_id": "dc328b94-bd8c-38c8-b4a3-3fb24a175565",
                                "text": "„Als der alte Schaft der Nagelfeile kaputtgegangen war, hatte Ludda-Kristjan die Feile repariert.“"
                            },
                            {
                                "example_id": "1fd40438-2e7e-4e7c-a827-4826cda5b5f0",
                                "sense_id": "dc328b94-bd8c-38c8-b4a3-3fb24a175565",
                                "text": "„Kern sah, daß in der perlmutternen Schale außerdem noch eine Nagelfeile eingelassen war.“"
                            },
                            {
                                "example_id": "801da9bd-b780-41ed-8253-ba57e716bcff",
                                "sense_id": "dc328b94-bd8c-38c8-b4a3-3fb24a175565",
                                "text": "„Elma stellte sich vor, wie er zu Hause mit der Nagelfeile vor dem Fernseher saß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
