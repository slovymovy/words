                        "glosses": [
                            "aus Guerillakämpfern bestehende Armee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80ac8f88-5f8d-4ec9-9b9a-846902290a79",
                                "sense_id": "861d2a1a-484e-3a2c-8656-de609159eb75",
                                "text": "„Die CIA machte sich ans Werk und kaufte sich zunächst eine neue laotische Regierung, dann baute sie eine Guerillaarmee auf, die die Kommunisten bekämpfen und den Dschungelpfad angreifen sollte.“"
                            },
                            {
                                "example_id": "fd0cf47d-e748-441a-84a9-055eb4d50197",
                                "sense_id": "861d2a1a-484e-3a2c-8656-de609159eb75",
                                "text": "„1972 war es erstmals zu größeren Kampfhandlungen der Guerillaarmeen in Rhodesien gekommen, und im benachbarten Mosambik hatte die marxistische Unabhängigkeitsbewegung der FRELIMO bedeutende Geländegewinne im Norden des Landes zu verzeichnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
