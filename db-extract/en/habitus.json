                        "examples": []
                    },
                    {
                        "sense_id": "7cd0b07f-40a9-3984-97c2-5c66b5944443",
                        "entry_id": "16d070c3-fe85-3c91-9a84-7db2360f1ccf",
                        "glosses": [
                            "the general shape and appearance of the body, usually with reference to weight, adipose distribution, posture, and gait; most often called by the collocation body habitus."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "17b889ed-af21-3bd3-a005-c3a8739ded71",
                        "entry_id": "16d070c3-fe85-3c91-9a84-7db2360f1ccf",
                        "glosses": [
                            "The lifestyle, values, dispositions and expectations of particular social groups that are acquired through the activities and experiences of everyday life."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "986abb1f-753b-4379-a6ed-58342ee6c316",
                                "sense_id": "17b889ed-af21-3bd3-a005-c3a8739ded71",
                                "text": "A wrestler could gain the rank of ōzeki based on his competitive achievements, but the promotion to yokozuna implied the presence of a certain habitus than embodied the quintessential traditional Japaneseness."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0f6c2b8-8ccb-36cf-8f43-e42cba6aa2dd",
                        "entry_id": "16d070c3-fe85-3c91-9a84-7db2360f1ccf",
                        "glosses": [
                            "The liturgical clothing of monks, nuns and the clerical community, metaphorically referring to the religious mode of life."
                        ],
