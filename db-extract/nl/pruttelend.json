        "nl-extract.jsonl": [
            {
                "entry_id": "f0446208-eb5d-35c0-9505-f38c6882d0df",
                "word": "pruttelend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "539ac87e-44c4-3609-ba30-5f3921b5c1ca",
                        "entry_id": "f0446208-eb5d-35c0-9505-f38c6882d0df",
                        "glosses": [
                            "kokend op een laag vuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "737d7622-5d1f-4afd-8dd4-4c830974165d",
                                "sense_id": "539ac87e-44c4-3609-ba30-5f3921b5c1ca",
                                "text": "Paling die vers gerookt wordt, vers gegaarde Black Angus spareribs, groentestoofpotjes, bitterballen van asperges, 1000-dagen kaas, worteltaart met witte chocolademousse en pruttelende gevulde portbello-champignons op de Ofyr, een barbecue en vuurplaat in één."
                            },
                            {
                                "example_id": "e3e30690-c91b-4cbc-b4fc-608ca628c9e8",
                                "sense_id": "539ac87e-44c4-3609-ba30-5f3921b5c1ca",
                                "text": "Ontspannen lag hij op zijn matje met een pruttelend potje aardappelpuree op zijn gasbrander."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b8d9802-a82c-34da-b6f2-b3788cc73b43",
                        "entry_id": "f0446208-eb5d-35c0-9505-f38c6882d0df",
                        "glosses": [
                            "van een verbrandingsmotor dat deze een ploffend, onregelmatig geluid maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3257aa6-0418-4d64-a686-458fa19f37f8",
                                "sense_id": "4b8d9802-a82c-34da-b6f2-b3788cc73b43",
                                "text": "Maar nee hoor. Zijn pruttelende McLaren-Honda hield er ondanks alle verbeteringen na een paar honderd meter in de eerste vrije training alweer mee op vanwege een lekkende motor."
                            },
                            {
                                "example_id": "d734aaf5-0d88-480b-966b-62dc1bd7ec52",
                                "sense_id": "4b8d9802-a82c-34da-b6f2-b3788cc73b43",
                                "text": "Het is dinsdag 31 oktober op de dag af honderd jaar geleden dat het rustige dorpje Holten tegen het middaguur werd opgeschrikt door het pruttelende motorgeluid van een vliegtuig."
                            }
                        ]
                    }
