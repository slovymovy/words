                        ]
                    }
                },
                {
                    "sense_id": "68dc39af-4cdd-38c3-84bc-0b9ab1aebb6d",
                    "sense_definition": "Qui manifeste un orgueil dédaigneux ou blessant, notamment en situation de supériorité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a adopté une attitude <w>insolente</w> face aux journalistes qui l'interrogeaient.",
                            "target_lang_translations": {
                                "en": "The minister adopted an <w>arrogant</w> attitude towards the journalists who were questioning him.",
                                "ru": "Министр держался <w>высокомерно</w> по отношению к журналистам, которые его расспрашивали.",
                                "de": "Der Minister zeigte gegenüber den Journalisten, die ihn befragten, eine <w>überhebliche</w> Haltung.",
                                "es": "El ministro adoptó una actitud <w>arrogante</w> ante los periodistas que lo interrogaban.",
                                "zh": "面对向他提问的记者，部长的态度十分<w>傲慢</w>。"
                            }
                        },
                        {
                            "text": "Il ne faut pas devenir <w>insolent</w> dans la victoire et humilier ses adversaires vaincus.",
                            "target_lang_translations": {
                                "en": "One should not become <w>arrogant</w> in victory and humiliate one's defeated opponents.",
                                "ru": "Не следует становиться <w>высокомерным</w> в победе и унижать побеждённых соперников.",
                                "de": "Man sollte im Sieg nicht <w>überheblich</w> werden und seine besiegten Gegner demütigen.",
                                "es": "No hay que volverse <w>arrogante</w> en la victoria ni humillar a los adversarios derrotados.",
                                "zh": "胜利后不能变得<w>傲慢</w>，更不能羞辱战败的对手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arrogant",
                        "hautain",
                        "méprisant"
                    ],
                    "antonyms": [
                        "humble",
                        "modeste"
                    ],
                    "common_phrases": [
                        "attitude insolente"
                    ],
                    "target_lang_definitions": {
                        "en": "Showing scornful, hurtful pride, especially when in a position of superiority.",
                        "ru": "Проявляющий презрительную и обидную гордость, особенно когда занимает положение превосходства.",
                        "de": "Ein Auftreten, das verächtlich und verletzend stolz wirkt, besonders in einer überlegenen Position.",
                        "es": "Que muestra un orgullo despectivo e hiriente, sobre todo desde una posición de superioridad.",
                        "zh": "表现出傲慢轻视他人的态度，尤其是处于优势地位时。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arrogant",
                                "target_lang_sense_clarification": "conceited, looking down on others"
                            },
                            {
                                "target_lang_word": "haughty",
                                "target_lang_sense_clarification": "proud, aloof, superior manner"
                            },
                            {
                                "target_lang_word": "condescending",
                                "target_lang_sense_clarification": "patronising tone toward subordinates"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "высокомерный",
                                "target_lang_sense_clarification": "смотрит свысока на других"
                            },
                            {
                                "target_lang_word": "надменный",
                                "target_lang_sense_clarification": "холодное, гордое превосходство"
                            },
                            {
                                "target_lang_word": "заносчивый",
                                "target_lang_sense_clarification": "самоуверенный, хвастливый тон"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "überheblich",
                                "target_lang_sense_clarification": "blickt verächtlich auf andere herab"
                            },
                            {
                                "target_lang_word": "anmaßend",
                                "target_lang_sense_clarification": "beansprucht mehr Rechte, als zusteht"
                            },
                            {
                                "target_lang_word": "hochmütig",
                                "target_lang_sense_clarification": "stolz und verächtlich gegenüber anderen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "arrogante",
                                "target_lang_sense_clarification": "creído, se cree superior"
                            },
                            {
                                "target_lang_word": "altivo",
                                "target_lang_sense_clarification": "orgulloso, de trato distante"
                            },
                            {
                                "target_lang_word": "soberbio",
                                "target_lang_sense_clarification": "orgulloso, con aire de superioridad"
