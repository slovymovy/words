                                "example_id": "2bcfb28b-eed5-4822-bd25-1de79e5f1564",
                                "sense_id": "8f2b14a8-2c74-318e-aef8-6d69a069ada9",
                                "text": "Veel rijst wordt verbouwd in het laagland van Azië.",
                                "translation": "A lot of rice is grown in the lowland areas of Asia.",
                                "english": "A lot of rice is grown in the lowland areas of Asia."
                            },
                            {
                                "example_id": "9d5226d9-f132-4541-a0bc-92b423c3f0e6",
                                "sense_id": "8f2b14a8-2c74-318e-aef8-6d69a069ada9",
                                "text": "Het laagland is vaak gevoeliger voor overstromingen.",
                                "translation": "The lowland is often more susceptible to flooding.",
                                "english": "The lowland is often more susceptible to flooding."
                            },
                            {
                                "example_id": "fdbf1490-615b-4187-92e2-d5c1a01d7b6f",
                                "sense_id": "8f2b14a8-2c74-318e-aef8-6d69a069ada9",
                                "text": "Het laaglandje bij de rivier is een perfecte plek voor picknicken.",
                                "translation": "The small lowland area by the river is a perfect spot for picnicking.",
                                "english": "The small lowland area by the river is a perfect spot for picnicking."
                            }
                        ]
