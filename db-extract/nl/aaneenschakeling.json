                        "examples": [
                            {
                                "example_id": "972470ef-0130-42c1-83fb-5b356f4210bf",
                                "sense_id": "0d215a6a-04ac-3c25-9935-fc9d7f8950cc",
                                "text": "Door de aaneenschakeling zonnecellen in meerdere modules kan deze elektriciteit nuttig gebruikt worden in de woning."
                            }
                        ]
                    },
                    {
                        "sense_id": "af96ad3b-a9dd-3617-9a7e-f268da2499f6",
                        "entry_id": "16fe3336-4812-31d5-ac56-50e3d68c152c",
                        "glosses": [
                            "ononderbroken reeks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcff9f36-9052-44c6-915a-cd49f79fff09",
                                "sense_id": "af96ad3b-a9dd-3617-9a7e-f268da2499f6",
                                "text": "Een aaneenschakeling van woningen."
                            },
                            {
                                "example_id": "f506d5fc-c752-4c5e-ab56-40b340fb29e7",
                                "sense_id": "af96ad3b-a9dd-3617-9a7e-f268da2499f6",
                                "text": "Zijn leven is een aaneenschakeling van ziekten, rampen en andere ellendigheden, het is een echt tranendal."
                            },
                            {
                                "example_id": "290c3edd-15b4-4067-a8a8-8f215395fc21",
                                "sense_id": "af96ad3b-a9dd-3617-9a7e-f268da2499f6",
                                "text": "Mijn jeugd is slechts een aaneenschakeling van beelden, geluiden en geuren."
                            },
                            {
                                "example_id": "6c9f8cef-1f43-482b-897e-bb1e7ad15b3e",
                                "sense_id": "af96ad3b-a9dd-3617-9a7e-f268da2499f6",
                                "text": "Een aaneenschakeling van voorvallen leidde naar wat er volgde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1efa547-90ad-48ec-8ee4-ed24a27ca749",
                        "source_entry_id": "16fe3336-4812-31d5-ac56-50e3d68c152c",
                        "target_lang_word": "Aneinanderreihung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aneinanderreihung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ece70f7-457a-3c7b-aba1-8cf66fa61b5e",
                                        "entry_id": "98957a3c-3372-3ee7-a5f5-018ed3db31fb",
                                        "glosses": [
                                            "Handlung, Dinge nebeneinander anzuordnen, und Ergebnis dieser Aktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0035e116-2bda-49dd-a05d-9113bdbec887",
                                                "sense_id": "7ece70f7-457a-3c7b-aba1-8cf66fa61b5e",
                                                "text": "„Wer will, kann das Ganze eine Collage nennen, aber es ist mehr, mehr als eine Aneinanderreihung von Fundstücken.“"
                                            },
                                            {
                                                "example_id": "4e53af64-e683-427d-b93b-8de59dd98c4a",
                                                "sense_id": "7ece70f7-457a-3c7b-aba1-8cf66fa61b5e",
                                                "text": "„Aber die Aneinanderreihung einer möglichst großen Zahl an Details ist auch gar kein sinnvoller Weg, eine wissenschaftliche Disziplin wie die Insektenkunde zu erschließen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
