                "translations": [
                    {
                        "translation_id": "d1669d48-9db6-4500-97cb-1711b32541c8",
                        "source_entry_id": "beaf8ba1-a6f6-36db-bf89-61f7315562c9",
                        "source_sense_id": "0d6c3dee-ed20-3d2e-b8e3-f0b7df67122d",
                        "source_sense_description": "benaming voor grote roofvissen uit het geslacht Siluris",
                        "target_lang_word": "Wels",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wels",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0eea0c38-4cd8-35dd-91bb-31ca5806f480",
                                        "entry_id": "89018b45-ccff-3ab2-8894-3927382f56be",
                                        "glosses": [
                                            "Fisch der Gattung Silurus oder der Familie Siluridae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c29ab5e-1d9d-475d-b5ad-fb5844b384a0",
                                                "sense_id": "0eea0c38-4cd8-35dd-91bb-31ca5806f480",
                                                "text": "Der Wels bewohnt bevorzugt große, warme Seen und tiefe, langsam fließende Flüsse."
                                            },
                                            {
                                                "example_id": "8a3658b4-5e24-4690-88da-fbb4d0a3ba0f",
                                                "sense_id": "0eea0c38-4cd8-35dd-91bb-31ca5806f480",
                                                "text": "„Welse reiben hingegen mit einem Stachel ihrer Brustflosse an ihrem Schultergelenk und produzieren so ganz andere, hochfrequente Laute.“"
                                            },
                                            {
                                                "example_id": "074eeba5-4c06-4776-bbde-14fdc31e889a",
                                                "sense_id": "0eea0c38-4cd8-35dd-91bb-31ca5806f480",
                                                "text": "„Dann aber erzählte ich Papa noch von den Fischen in der Mosel, indem ich sie genau beschrieb, so, wie ich sie gesehen hatte, und am Ende hatten wir heraus bekommen, dass ich anscheinend einen Hecht, mehrere Aale und vielleicht sogar einen Wels gesehen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef3cfc0e-87cd-35a8-9f7d-e530d111bbc4",
                                        "entry_id": "89018b45-ccff-3ab2-8894-3927382f56be",
                                        "glosses": [
                                            "Fisch der Ordnung Siluriformes"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wels",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d31c5a0-732b-3e6f-9201-ae64613e3cbe",
                                        "entry_id": "5ce782fa-b1be-3db6-8a88-26a1e70da553",
