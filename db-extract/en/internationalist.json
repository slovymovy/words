                        "source_entry_id": "95571ec0-c68e-3b7e-9a7c-f902814d7f14",
                        "source_sense_description": "advocate of internationalism",
                        "target_lang_word": "интернационали́ст",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
