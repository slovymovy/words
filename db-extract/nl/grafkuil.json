                                                "sense_id": "31eccbb8-2701-3544-86c0-a01f91368fe1",
                                                "text": "He hath graven and digged up a pit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12ae7252-0c9c-3d3f-8de3-6cb6953a0699",
                                        "entry_id": "a156862e-2872-33a3-acf8-efefdf322ef0",
                                        "glosses": [
                                            "To carve or cut, as letters or figures, on some hard substance; to engrave."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e816d514-03ac-450f-b807-cd4ec7104a41",
                                                "sense_id": "12ae7252-0c9c-3d3f-8de3-6cb6953a0699",
                                                "text": "Thou shalt take two onyx stones, and grave on them the names of the children of Israel."
                                            },
                                            {
                                                "example_id": "afbd942b-654e-4286-afc1-454ae7969ce9",
                                                "sense_id": "12ae7252-0c9c-3d3f-8de3-6cb6953a0699",
                                                "text": "Deep lines were graven on her pale forehead, and on her wan, thin cheeks."
                                            },
                                            {
                                                "example_id": "6ed433ce-0535-43a6-844d-0adaf4cbf72f",
                                                "sense_id": "12ae7252-0c9c-3d3f-8de3-6cb6953a0699",
                                                "text": "a. 1894, Robert Louis Stevenson, \"Requiem\"\nThis be the verse you grave for me / \"Here he lies where he longs to be\""
                                            },
                                            {
                                                "example_id": "4df4d475-9453-4c3b-9e8c-4ff2d32bbced",
                                                "sense_id": "12ae7252-0c9c-3d3f-8de3-6cb6953a0699",
                                                "text": "'It may be so,' I answered; 'but if the loved one prove a broken reed to pierce us, or if the love be loved in vain - what then? Shall a man grave his sorrows upon a stone when he hath but need to write them on the water?'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f2bf281-b58a-357b-abc6-be8bc9d8e5b4",
                                        "entry_id": "a156862e-2872-33a3-acf8-efefdf322ef0",
                                        "glosses": [
                                            "To carve out or give shape to, by cutting with a chisel; to sculpture."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7051fddc-d8ec-4f20-8db5-4f3d9fc0dfdf",
                                                "sense_id": "8f2bf281-b58a-357b-abc6-be8bc9d8e5b4",
                                                "text": "to grave an image"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75d9f589-c1b1-32ad-9157-e1fe536f546f",
                                        "entry_id": "a156862e-2872-33a3-acf8-efefdf322ef0",
                                        "glosses": [
                                            "To impress deeply (on the mind); to fix indelibly."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2200b96-bb2a-4ed6-91eb-cbf666867f56",
                                                "sense_id": "75d9f589-c1b1-32ad-9157-e1fe536f546f",
                                                "text": "O! may they graven in thy heart remain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1d6c894-500a-303c-aec2-88634a6178e8",
                                        "entry_id": "a156862e-2872-33a3-acf8-efefdf322ef0",
                                        "glosses": [
                                            "To entomb; to bury."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be33f870-a7d3-4800-b3e0-927fffdda30d",
                                                "sense_id": "a1d6c894-500a-303c-aec2-88634a6178e8",
                                                "text": "[…]And lie full low, graved in the hollow ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6109f04-864d-3f2b-9321-c197d6e47f2a",
                                        "entry_id": "a156862e-2872-33a3-acf8-efefdf322ef0",
                                        "glosses": [
                                            "To write or delineate on hard substances, by means of incised lines; to practice engraving."
                                        ],
                                        "tags": [
