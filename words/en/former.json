                                "target_lang_word": "模具",
                                "target_lang_sense_clarification": "用于成型的工具"
                            },
                            {
                                "target_lang_word": "模板",
                                "target_lang_sense_clarification": "用于参照的形状工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab626e46-d5a1-333a-9730-af7f8aa87ff7",
                    "sense_definition": "A person who creates, makes, or shapes something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is considered the <w>former</w> of the new company policy.",
                            "target_lang_translations": {
                                "ru": "Он считается <w>создателем</w> новой политики компании.",
                                "tr": "Şirketin yeni politikasının <w>biçimlendireni</w> olarak kabul ediliyor.",
                                "zh": "他被认为是新公司政策的<w>制定者</w>。"
                            }
                        },
                        {
                            "text": "The <w>former</w> of this sculpture was a renowned artist.",
                            "target_lang_translations": {
                                "ru": "<w>Автором</w> этой скульптуры был известный художник.",
                                "tr": "Bu heykelin <w>yaratıcısı</w> ünlü bir sanatçıydı.",
                                "zh": "这座雕塑的<w>创造者</w>是一位著名的艺术家。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который создает или формирует что-либо",
                        "tr": "Bir şeyi oluşturan, kuran veya ona biçim veren kişi.",
                        "zh": "创造、制定或塑造某事物的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "созда́тель",
                                "target_lang_sense_clarification": "творец"
                            },
