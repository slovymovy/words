                        "examples": [
                            {
                                "example_id": "1e65d4d1-9152-46bb-a858-77344fce0751",
                                "sense_id": "60899fca-5ab3-3f54-bc15-a61145f38a2d",
                                "text": "Eerder op de dag behaalde De Sousa voor het eerst in zijn carrière de halve finales van een PDC-major door Smith na een ware nagelbijter met 16-14 te verslaan. De Portugees was tegen de Engelsman al snel flink op dreef en kwam op een 8-2 voorsprong. Maar daarna kwam Smith sterk terug en maakte hij er 8-8 van."
                            },
                            {
                                "example_id": "bb85dfa3-ef42-482f-b666-6322ac71dfe3",
                                "sense_id": "60899fca-5ab3-3f54-bc15-a61145f38a2d",
                                "text": "Lijsttrekkersverkiezing CDA wordt nagelbijter: Mona Keijzer is vandaag afgevallen, zodat alleen Hugo de Jonge en Pieter Omtzigt nog in de race zijn. Bij de partijtop nemen de zenuwen ondertussen toe."
                            }
                        ]
