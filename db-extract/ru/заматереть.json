                    {
                        "sense_id": "c5044a81-f9a6-3491-a3a0-ae1423a99063",
                        "entry_id": "bd9d2340-5a47-3c53-bcc9-e8f22448eb60",
                        "glosses": [
                            "достигнуть зрелого возраста; возмужать (о человеке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8af3351a-cf82-4458-8165-bfd675d569c2",
                                "sense_id": "c5044a81-f9a6-3491-a3a0-ae1423a99063",
                                "text": "Петя и внешне изменился: заматерел, окреп, лицо довольное, сытое."
                            }
                        ]
                    },
                    {
                        "sense_id": "c04f2126-1c61-3219-b077-aff7eb4e92b9",
                        "entry_id": "bd9d2340-5a47-3c53-bcc9-e8f22448eb60",
                        "glosses": [
                            "устар., разг. закоснеть, закоренеть, застареть (о человеке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c759e0e-59e3-478d-ba7f-6d006cedd06c",
                                "sense_id": "c04f2126-1c61-3219-b077-aff7eb4e92b9",
                                "text": "Но Тихмень таков: что раз ему втемяшилось ― в том заматереет."
                            }
                        ]
                    }
