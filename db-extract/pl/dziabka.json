                                            {
                                                "example_id": "049d9e08-155d-4769-9291-66e534510fac",
                                                "sense_id": "ad210801-6ff1-328c-b370-864897aaf3ec",
                                                "text": "Двенадцать девок из деревни рубили капусту в большой колоде около людской, ― пели песни, стучали тяпками на весь двор."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ad7158b-b0f6-35c7-8365-cb8b9bfcab7f",
                                        "entry_id": "e233002b-a606-342b-a362-65a6a6b37244",
                                        "glosses": [
                                            "лёгкая мотыга для рыхления междурядий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86c8271b-74af-4b25-863d-8b9e58472cac",
                                                "sense_id": "8ad7158b-b0f6-35c7-8365-cb8b9bfcab7f",
                                                "text": "Старайтесь, чтобы тяпка встречалась с почвой с наклоном под углом 15—20 градусов."
                                            }
                                        ]
                                    }
                                ]
