{
    "word_family": [
        "dearly",
        "dearness",
        "endear",
        "endearment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "73869409-aab9-39d5-9a4e-cd3078ef96c8",
                    "sense_definition": "A formal way to start addressing somebody at the beginning of a letter or email",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "addressing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please start your formal email with <w>Dear</w> Sir or Madam if you do not know their name.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, начинайте свое официальное письмо с обращения «<w>Уважаемый</w> господин или госпожа», если вы не знаете их имени."
                            }
                        },
                        {
                            "text": "I received a letter that began with <w>Dear</w> Customer regarding my recent bank account activity.",
                            "target_lang_translations": {
                                "ru": "Я получил письмо, которое начиналось со слов «<w>Уважаемый</w> клиент», касающееся недавних операций по моему банковскому счету."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dear sir",
                        "dear madam",
                        "dear friend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное обращение в начале письма или электронного сообщения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уважаемый",
                                "target_lang_sense_clarification": "официальное обращение"
                            },
                            {
                                "target_lang_word": "дорогой",
                                "target_lang_sense_clarification": "менее официальное, но вежливое обращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f91c6448-2743-3823-8139-f032f40b6bd8",
                    "sense_definition": "Loved, lovable, or held in high affection",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat down to write a long letter to her <w>dear</w> sister who lives abroad.",
                            "target_lang_translations": {
                                "ru": "Она села писать длинное письмо своей <w>дорогой</w> сестре, которая живет за границей."
                            }
                        },
                        {
                            "text": "The children are very <w>dear</w> to their grandmother who visits them every weekend.",
                            "target_lang_translations": {
                                "ru": "Дети очень <w>дороги</w> своей бабушке, которая навещает их каждые выходные."
                            }
                        }
                    ],
                    "synonyms": [
                        "darling"
                    ],
                    "common_phrases": [
                        "dear to me",
                        "my dear sister"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любимый, милый или вызывающий глубокую привязанность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорогой",
                                "target_lang_sense_clarification": "близкий сердцу"
                            },
                            {
                                "target_lang_word": "любимый",
                                "target_lang_sense_clarification": "тот, кого любят"
                            },
                            {
                                "target_lang_word": "милый",
                                "target_lang_sense_clarification": "вызывающий симпатию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "260675b8-fe37-31f5-9797-f8d4fabb0b99",
                    "sense_definition": "High in price; expensive",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cost",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everything in this boutique is far too <w>dear</w> for my current budget.",
                            "target_lang_translations": {
                                "ru": "Все в этом бутике слишком <w>дорого</w> для моего нынешнего бюджета."
                            }
                        },
                        {
                            "text": "The rent for a cottage on the island is not too <w>dear</w> during the winter months.",
                            "target_lang_translations": {
                                "ru": "Аренда коттеджа на острове не слишком <w>дорогая</w> в зимние месяцы."
                            }
                        }
                    ],
                    "synonyms": [
                        "darling"
                    ],
                    "antonyms": [
                        "cheap"
                    ],
                    "common_phrases": [
                        "too dear",
                        "not dear"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий высокую цену; дорогостоящий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорогой",
                                "target_lang_sense_clarification": "высокий по цене"
                            },
                            {
                                "target_lang_word": "дорогостоящий",
                                "target_lang_sense_clarification": "требующий больших затрат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cac6ea9-6dab-314b-8d62-017cd1bbf7fb",
                    "sense_definition": "Precious to or greatly valued by someone",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He held onto the old watch because it was <w>dear</w> to his heart.",
                            "target_lang_translations": {
                                "ru": "Он хранил старые часы, потому что они были <w>дороги</w> его сердцу."
                            }
                        },
                        {
                            "text": "The freedom of speech is a <w>dear</w> right that many people fight to protect.",
                            "target_lang_translations": {
                                "ru": "Свобода слова — это <w>ценное</w> право, за защиту которого борются многие люди."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dear to heart",
                        "hold dear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Драгоценный или очень значимый для кого-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорогой",
                                "target_lang_sense_clarification": "представляющий ценность для чувств"
                            },
                            {
                                "target_lang_word": "ценный",
                                "target_lang_sense_clarification": "важный, значимый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cfe6b53-6771-385e-bc02-ad17e99ee2a3",
                    "sense_definition": "Lovely or kind in nature",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was so <w>dear</w> of you to remember my birthday after all these years.",
                            "target_lang_translations": {
                                "ru": "Это было так <w>мило</w> с твоей стороны — вспомнить о моем дне рождения спустя столько лет."
                            }
                        },
                        {
                            "text": "She is a <w>dear</w> person who always helps her neighbors with their groceries.",
                            "target_lang_translations": {
                                "ru": "Она <w>чудесный</w> человек, который всегда помогает соседям с продуктами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "how dear of you"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приятный, милый или добрый по натуре"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "милый",
                                "target_lang_sense_clarification": "о человеке или поступке"
                            },
                            {
                                "target_lang_word": "любезный",
                                "target_lang_sense_clarification": "проявляющий доброту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93d468f0-8510-3c7a-b04d-137e4a84d9fe",
                    "sense_definition": "An ironic or patronizing way to address someone one dislikes or considers inferior",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "addressing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>dear</w> man, you really should think twice before making such a bold threat.",
                            "target_lang_translations": {
                                "ru": "<w>Дорогой мой</w> человек, вам действительно стоит дважды подумать, прежде чем выступать с такой дерзкой угрозой."
                            }
                        },
                        {
                            "text": "Listen, my <w>dear</w> fellow, your excuses are becoming quite tiresome to everyone here.",
                            "target_lang_translations": {
                                "ru": "Послушайте, <w>любезный</w>, ваши оправдания уже всем здесь порядком надоели."
                            }
                        }
                    ],
                    "common_phrases": [
                        "my dear man",
                        "my dear fellow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ироничное или покровительственное обращение к кому-то, кто неприятен или считается ниже по статусу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорогой мой",
                                "target_lang_sense_clarification": "ироничное обращение"
                            },
                            {
                                "target_lang_word": "любезный",
                                "target_lang_sense_clarification": "снисходительный тон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aec877eb-6c2f-31df-b742-5f18c92a3861",
                    "sense_definition": "Severe, fierce, or causing great pain",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers faced a <w>dear</w> struggle against the harsh winter winds on the mountain.",
                            "target_lang_translations": {
                                "ru": "Солдаты столкнулись с <w>тяжким</w> испытанием в борьбе с суровыми зимними ветрами на горе."
                            }
                        },
                        {
                            "text": "They found the heathens <w>dear</w> in battle, fighting with unexpected and brutal strength.",
                            "target_lang_translations": {
                                "ru": "Они обнаружили, что язычники <w>жестоки</w> в бою, сражаясь с неожиданной и грубой силой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Суровый, ожесточенный или причиняющий сильную боль (архаичное)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжкий",
                                "target_lang_sense_clarification": "о борьбе или испытании"
                            },
                            {
                                "target_lang_word": "жестокий",
                                "target_lang_sense_clarification": "о битве"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4bf0c2f7-bf40-3545-aea0-9a308b003e58",
                    "sense_definition": "An affectionate, familiar term of address used for a loved one",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "addressing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you please pass me the salt, <w>dear</w>?",
                            "target_lang_translations": {
                                "ru": "Не мог бы ты передать мне соль, <w>дорогой</w>?"
                            }
                        },
                        {
                            "text": "Don't worry about the mess, <w>dear</w>, I will clean it up later tonight.",
                            "target_lang_translations": {
                                "ru": "Не беспокойся о беспорядке, <w>дорогая</w>, я уберу все сегодня попозже."
                            }
                        }
                    ],
                    "synonyms": [
                        "darling"
                    ],
                    "common_phrases": [
                        "yes dear",
                        "hello dear"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in spoken English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласковое, неформальное обращение к близкому человеку"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорогой",
                                "target_lang_sense_clarification": "обращение к мужчине"
                            },
                            {
                                "target_lang_word": "дорогая",
                                "target_lang_sense_clarification": "обращение к женщине"
                            },
                            {
                                "target_lang_word": "милый",
                                "target_lang_sense_clarification": "ласковое обращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3ece8c9-051e-3ee7-9f15-7a83af2d41f8",
                    "sense_definition": "A very kind, helpful, or loving person",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My neighbor is such a <w>dear</w> for looking after my cat while I was away.",
                            "target_lang_translations": {
                                "ru": "Моя соседка такая <w>душка</w> — она присмотрела за моим котом, пока меня не было."
                            }
                        },
                        {
                            "text": "The nurse was a real <w>dear</w> and stayed late to comfort the worried patient.",
                            "target_lang_translations": {
                                "ru": "Медсестра была просто <w>прелестью</w> и осталась допоздна, чтобы утешить обеспокоенного пациента."
                            }
                        }
                    ],
                    "synonyms": [
                        "darling"
                    ],
                    "common_phrases": [
                        "such a dear",
                        "be a dear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень добрый, отзывчивый или любящий человек"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душка",
                                "target_lang_sense_clarification": "очень милый человек"
                            },
                            {
                                "target_lang_word": "прелесть",
                                "target_lang_sense_clarification": "о добром человеке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d617b520-1bd6-3e0f-929c-875eb8eea823",
                    "sense_definition": "At a high price or great cost",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cost",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you attempt to cheat the system, it will surely cost you <w>dear</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы попытаетесь обмануть систему, это наверняка обойдется вам <w>дорого</w>."
                            }
                        },
                        {
                            "text": "The victory was won, but it was bought <w>dear</w> with many lives lost.",
                            "target_lang_translations": {
                                "ru": "Победа была одержана, но она была куплена <w>дорогой</w> ценой многих потерянных жизней."
                            }
                        }
                    ],
                    "antonyms": [
                        "cheaply"
                    ],
                    "common_phrases": [
                        "cost dear",
                        "bought dear"
                    ],
                    "target_lang_definitions": {
                        "ru": "По высокой цене или большой ценой (в том числе метафорически)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорого",
                                "target_lang_sense_clarification": "о цене или последствиях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f2e5d5c7-65b6-354e-addd-ead3a28be359",
                    "sense_definition": "An exclamation indicating surprise, pity, or disapproval",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh <w>dear</w>, I seem to have forgotten my keys inside the house again.",
                            "target_lang_translations": {
                                "ru": "О <w>боже</w>, кажется, я снова забыл ключи в доме."
                            }
                        },
                        {
                            "text": "<w>Dear</w> me, that is a very nasty bruise on your arm.",
                            "target_lang_translations": {
                                "ru": "<w>Батюшки</w>, какой у тебя ужасный синяк на руке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oh dear",
                        "dear me",
                        "dear dear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, выражающее удивление, жалость или неодобрение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боже мой",
                                "target_lang_sense_clarification": "выражение испуга или удивления"
                            },
                            {
                                "target_lang_word": "батюшки",
                                "target_lang_sense_clarification": "просторечное удивление"
                            },
                            {
                                "target_lang_word": "о господи",
                                "target_lang_sense_clarification": "выражение досады"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "03f49440-cbab-38f3-bae1-3b773bd0e846",
                    "sense_definition": "A surname",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the philanthropist Mr. <w>Dear</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа мистера <w>Дира</w>."
                            }
                        },
                        {
                            "text": "We are researching the genealogy of the <w>Dears</w> who lived in this county.",
                            "target_lang_translations": {
                                "ru": "Мы исследуем генеалогию семьи <w>Дир</w>, живших в этом округе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дир",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f5348961-e474-383a-a2cc-31f90acb4f98",
                    "sense_definition": "To make someone or something <w>dear</w> or beloved; to endear",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant kindness <w>deared</w> him to everyone in the small village.",
                            "target_lang_translations": {
                                "ru": "Его неизменная доброта <w>расположила</w> к нему всех жителей маленькой деревни."
                            }
                        },
                        {
                            "text": "The child's innocent laughter <w>deared</w> her to the hearts of her foster parents.",
                            "target_lang_translations": {
                                "ru": "Невинный смех ребенка <w>привязал</w> ее к сердцам приемных родителей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-то полюбить себя; расположить к себе (архаичное)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расположить",
                                "target_lang_sense_clarification": "сделать любимым"
                            },
                            {
                                "target_lang_word": "привязать",
                                "target_lang_sense_clarification": "вызвать привязанность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}