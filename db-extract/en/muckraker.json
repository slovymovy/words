                                        "entry_id": "c93ed842-3a1e-3d65-82f2-7f605da118e0",
                                        "glosses": [
                                            "Nom vulgaire de plusieurs insectes coléoptères coprophages, qu’on trouve dans les champs sous les bouses de vache."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab2f38a7-f0b0-49c9-b4a1-9efd04204f54",
                                                "sense_id": "802d2ad5-c0aa-3080-9f8d-b49eec6801b1",
                                                "text": "Le bousier fouille-merde se trouve dans les savanes africaines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71577869-0b88-3d48-9ce2-07890d8947e2",
                                        "entry_id": "c93ed842-3a1e-3d65-82f2-7f605da118e0",
                                        "glosses": [
                                            "Personne qui se mêle de ce qui ne la regarde pas ; ou selon le point de vue, personne qui enquête sur des affaires douteuses."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5e519eb-b63e-49f4-8d0f-16ad87ff2d42",
                                                "sense_id": "71577869-0b88-3d48-9ce2-07890d8947e2",
                                                "text": "Monsieur Tach, je suis une sale petite fouille-merde."
                                            },
                                            {
                                                "example_id": "1f498c0d-03ac-4947-9c0b-b1961fb29276",
                                                "sense_id": "71577869-0b88-3d48-9ce2-07890d8947e2",
                                                "text": "Gilles Ottolini arrivait trop tard. Ce fouille-merde resterait sur sa faim. Daragane regretta de l’avoir affublé d’un qualificatif aussi grossier."
                                            },
                                            {
                                                "example_id": "091f414e-3440-46cb-8aef-5fe8d8212667",
                                                "sense_id": "71577869-0b88-3d48-9ce2-07890d8947e2",
                                                "text": "Il m’avait fait l’effet d’être un fouille-merde : un type déterminé à se faire un nom, qui posait des questions sur le film à toutes sortes de gens (moi y compris) pour dénicher une histoire à raconter."
                                            },
                                            {
                                                "example_id": "29fdc082-a718-4058-a906-a4cb2e35ffaa",
                                                "sense_id": "71577869-0b88-3d48-9ce2-07890d8947e2",
                                                "text": "Il suffit d’aborder le sujet, même à distance, pour être aussitôt qualifié de woke, d’antiaméricain ou de fouille-merde."
                                            }
                                        ]
                                    }
                                ]
                            }
