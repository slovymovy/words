                        "examples": [
                            {
                                "example_id": "38f2b27f-98c0-4173-b736-6dda29dc4089",
                                "sense_id": "be4008cf-9cb3-3f5f-ad54-3b1ab5233c2a",
                                "text": "„Und, ja, meine Eltern haben mir viel über Kontext und Marcel Duchamp beigebracht, und wie selbst ein Pissbecken zum Kunstwerk wird, wenn man es an der Wand einer schicken Galerie befestigt.“"
                            },
                            {
                                "example_id": "78a7c2b8-87fb-4fdd-92e1-128010fda69b",
                                "sense_id": "be4008cf-9cb3-3f5f-ad54-3b1ab5233c2a",
                                "text": "„Dann stand er in einem weißgetünchten Betonraum und pinkelte unter Schmerzen ein paar Tropfen in ein altmodisches Pissbecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
