{
    "word_family": [
        "persistence",
        "persistent",
        "persistently"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "00cf8f2e-a7b3-3ea1-a46f-d6db4dad17dc",
                    "sense_definition": "To continue to exist or occur, especially in a way that is lasting or difficult to stop.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "continue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the symptoms <w>persist</w> for more than three days, you should consult a doctor.",
                            "target_lang_translations": {
                                "ru": "Если симптомы <w>сохраняются</w> более трех дней, вам следует обратиться к врачу."
                            }
                        },
                        {
                            "text": "Despite the new laws, some old prejudices <w>persist</w> in the remote villages.",
                            "target_lang_translations": {
                                "ru": "Несмотря на новые законы, в отдаленных деревнях все еще <w>сохраняются</w> старые предрассудки."
                            }
                        }
                    ],
                    "synonyms": [
                        "last",
                        "remain",
                        "endure",
                        "prevail"
                    ],
                    "antonyms": [
                        "fail",
                        "break"
                    ],
                    "common_phrases": [
                        "symptoms persist",
                        "problems persist",
                        "rumors persist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжать существовать или происходить, особенно в течение длительного времени или вопреки попыткам это прекратить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохраняться",
                                "target_lang_sense_clarification": "о симптомах, традициях или явлениях"
                            },
                            {
                                "target_lang_word": "продолжаться",
                                "target_lang_sense_clarification": "длиться во времени"
                            },
                            {
                                "target_lang_word": "оставаться",
                                "target_lang_sense_clarification": "не исчезать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18c8b3fd-9f41-3a12-8d20-4f31e9a7b539",
                    "sense_definition": "To continue firmly or obstinately in an opinion or a course of action in spite of difficulty or opposition.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "persevere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>persisted</w> in her efforts to get the job despite being rejected twice.",
                            "target_lang_translations": {
                                "ru": "Она <w>упорствовала</w> в своих попытках получить работу, несмотря на два отказа."
                            }
                        },
                        {
                            "text": "Why do you <w>persist</w> in asking such personal questions when I refuse to answer?",
                            "target_lang_translations": {
                                "ru": "Почему вы <w>продолжаете</w> задавать такие личные вопросы, когда я отказываюсь отвечать?"
                            }
                        }
                    ],
                    "synonyms": [
                        "persevere",
                        "hold on",
                        "stick it out",
                        "go on"
                    ],
                    "antonyms": [
                        "yield"
                    ],
                    "common_phrases": [
                        "persist in",
                        "persist with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердо или упрямо продолжать придерживаться мнения или линии поведения, несмотря на трудности или противодействие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упорствовать",
                                "target_lang_sense_clarification": "настойчиво продолжать делать что-либо"
                            },
                            {
                                "target_lang_word": "настаивать",
                                "target_lang_sense_clarification": "на своем мнении или действии"
                            },
                            {
                                "target_lang_word": "продолжать",
                                "target_lang_sense_clarification": "несмотря на отказы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c9b8f6d-8d88-384e-b12b-0688871aba2e",
                    "sense_definition": "To store data permanently, especially in a database or non-volatile memory.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "data storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application will <w>persist</w> the user settings to a local file before closing.",
                            "target_lang_translations": {
                                "ru": "Приложение <w>сохранит</w> пользовательские настройки в локальный файл перед закрытием."
                            }
                        },
                        {
                            "text": "We need to <w>persist</w> these changes in the database to ensure no data is lost.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>сохранить</w> эти изменения в базе данных, чтобы гарантировать отсутствие потери данных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "persist data",
                        "persist settings"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно сохранять данные, особенно в базе данных или энергонезависимой памяти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "данные в постоянное хранилище"
                            },
                            {
                                "target_lang_word": "персистить",
                                "target_lang_sense_clarification": "технический жаргон в программировании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "137a3b53-53ad-31e3-b40f-069b5749cd50",
                    "sense_definition": "To repeat a statement or utterance, often with emphasis or insistence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>persisted</w> that he was innocent, even when presented with the evidence.",
                            "target_lang_translations": {
                                "ru": "Он <w>настаивал</w> на своей невиновности, даже когда ему предъявили улики."
                            }
                        },
                        {
                            "text": "She <w>persisted</w> her claim that the document was a forgery.",
                            "target_lang_translations": {
                                "ru": "Она <w>утверждала</w>, что документ был подделкой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторять утверждение или высказывание, часто с акцентом или настойчивостью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждать",
                                "target_lang_sense_clarification": "настойчиво повторять"
                            },
                            {
                                "target_lang_word": "настаивать",
                                "target_lang_sense_clarification": "на истинности своих слов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}