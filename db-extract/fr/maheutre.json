                        ],
                        "examples": [
                            {
                                "example_id": "03fb74af-e75a-42c7-8078-8ee5fa991c37",
                                "sense_id": "f4178098-3e8f-3ae6-a619-88e480d80d7f",
                                "text": "Vous auriez bien dû rester neutre ;\nOù vais-je vous larder, dindon ? …\n Dans le flanc, sous votre maheutre ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "cfb048b0-a0f1-3544-9b6d-22a1bb7109b4",
                        "entry_id": "4468ded7-c0ee-32dd-8399-270127d69fe5",
                        "glosses": [
                            "Soldat, habituellement protestant pendant les guerres de Religion."
                        ],
                        "tags": [
