            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5d229d7b-afdc-3c56-b884-47dae4625d88",
                    "sense_definition": "Surprisingly excellent; very good or admirable, extremely impressive.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "excellent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They served a <w>wonderful</w> six-course meal.",
                            "target_lang_translations": {
                                "ru": "Они подали <w>восхитительный</w> ужин из шести блюд.",
                                "nl": "Ze serveerden een <w>heerlijke</w> zesgangenmaaltijd."
                            }
                        },
                        {
                            "text": "She did a <w>wonderful</w> job organizing the charity event.",
                            "target_lang_translations": {
                                "ru": "Она проделала <w>замечательную</w> работу по организации благотворительного мероприятия.",
                                "nl": "Ze heeft <w>fantastisch</w> werk geleverd bij het organiseren van het liefdadigheidsevenement."
                            }
                        }
                    ],
                    "synonyms": [
                        "great",
                        "amazing",
                        "fantastic",
                        "marvelous",
                        "fabulous",
                        "splendid",
                        "awesome",
                        "magnificent",
                        "excellent",
                        "lovely"
                    ],
                    "antonyms": [
                        "terrible",
                        "horrible",
                        "disgusting",
                        "boring",
                        "dull"
                    ],
                    "common_phrases": [
                        "wonderful time",
                        "wonderful news",
                        "wonderful job",
                        "wonderful opportunity"
                    ],
                    "target_lang_definitions": {
