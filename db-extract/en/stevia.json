                        "cross_references": [
                            {
                                "target_word": "сте́вия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aabfbc8e-b72c-3e5d-b498-1ef0be081001",
                                        "entry_id": "9e34e5c6-9abe-314f-b17c-89be76a20fcc",
                                        "glosses": [
                                            "ботан. род многолетних растений семейства Астровые"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "478c89b0-5146-41c2-93f0-42302c414953",
                                                "sense_id": "aabfbc8e-b72c-3e5d-b498-1ef0be081001",
                                                "text": "И в заключение пару слов о новом чуде из Аргентины, называется стевия. Если возьмётесь её разводить, то вам потребуется всего квадратный метр земли или подоконник, чтобы обеспечить семью сахаром для чаепития на три года. Вас это очень удивит, но не пугайтесь, а секрет в том, что лист стевии слаще сахара в 300 раз."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db19445d-ce16-3413-8a28-0d3252d3958a",
                                        "entry_id": "9e34e5c6-9abe-314f-b17c-89be76a20fcc",
                                        "glosses": [
                                            "кулин. измельчённые листья, а также водяной экстракт, медовой стевии (Stevia rebaudiana) , используемые как подсластитель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c8c321d-323a-42fc-ab5f-e4ed2ce63bb9",
                                                "sense_id": "db19445d-ce16-3413-8a28-0d3252d3958a",
                                                "text": "Стевия — один из важнейших источников получения стевиозида, применяемого в пищевой промышленности в качестве заменителя сахара при производстве различных напитков и кондитерских изделий. В листьях стевии содержится 7% стевиозида, что в 300–350 раз слаще сахара."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
