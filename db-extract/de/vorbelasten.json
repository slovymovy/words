                    {
                        "sense_id": "ca01885a-c764-397d-bac7-6a39019b8814",
                        "entry_id": "21d2130b-6f5d-34bc-9bcc-35542abfac08",
                        "glosses": [
                            "eine Last/Belastung (zum Beispiel Gewicht/Steuer/Beanspruchung) auf etwas legen, bevor ein gewisser Zeitpunkt erreicht ist, an dem zum Beispiel der Ernstfall eintritt oder eine Gültigkeit beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e665ccd-9233-41bb-9bff-13bcbea78bcd",
                                "sense_id": "ca01885a-c764-397d-bac7-6a39019b8814",
                                "text": "„Im Zuge der Bauausführung hatte es sich darüber hinaus als vorteilhaft erwiesen, die einzelnen Pfähle vor Beginn der eigentlichen Lastübernahme aus den Bauwerken mit Hilfe von Pressen mit einer Last von 400 kN vorzubelasten.“"
                            },
                            {
                                "example_id": "dfd0b44b-f4fe-48ef-832e-26c75b18e37c",
                                "sense_id": "ca01885a-c764-397d-bac7-6a39019b8814",
                                "text": "„Dämme sind unter Umständen vorzubelasten.“"
                            },
                            {
                                "example_id": "668e1917-1285-4dba-9d1f-2a317f7991a5",
                                "sense_id": "ca01885a-c764-397d-bac7-6a39019b8814",
                                "text": "„Diese Übereinstimmung ergibt sich aus dem Wesen der Vermögensteuer als einer Ergänzungssteuer, die die sogenannten „fundierten\" Einkünfte vorbelasten soll.“"
                            },
                            {
                                "example_id": "0a9e892c-3262-49dc-9b70-eaf5378ce1ea",
                                "sense_id": "ca01885a-c764-397d-bac7-6a39019b8814",
                                "text": "„Man kann gewisse Arten der Luxusbedarfsbefriedigung in besonderem Maße vorbelasten, erschweren, kontingentieren, ganz verbieten.“"
                            },
                            {
                                "example_id": "9fee6d07-0fb4-4f9d-b4f6-86201ebef1f2",
                                "sense_id": "ca01885a-c764-397d-bac7-6a39019b8814",
                                "text": "„Morton entwickelte eine Anregungsmethode (siehe Bild 2), bei der eine rotierende Welle mit einer Kraft F über ein Foliengleitlager vorbelastet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
