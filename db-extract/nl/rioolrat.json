                                        "entry_id": "d645867a-b148-3502-b548-72fd868a2dae",
                                        "glosses": [
                                            "ein zu den echten Mäusen zählendes Nagetier aus der Familie der Langschwanzmäuse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "469084fe-89a0-417f-bf4a-e8c8a4bc4c04",
                                                "sense_id": "d815b0aa-998a-3844-86cb-271e4617933c",
                                                "text": "Die Wanderratte kroch aus dem Loch neben der Tür."
                                            },
                                            {
                                                "example_id": "aa1e6ca5-4d7f-49de-a75e-7c3242b883ff",
                                                "sense_id": "d815b0aa-998a-3844-86cb-271e4617933c",
                                                "text": "„Die Wanderratte ist unter ungestörten Bedingungen dämmerungs- und nachtaktiv mit Aktivitätsmaxima kurz nach Sonnenuntergang und kurz vor Sonnenaufgang“."
                                            }
