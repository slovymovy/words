                ],
                "senses": [
                    {
                        "sense_id": "916489d2-8018-34f3-8e26-35e762e4c83a",
                        "entry_id": "94f76ae7-1cf3-390e-be83-72d4243e6ad7",
                        "glosses": [
                            "Fahrt mit einem Auto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897d41e7-11e6-4ed8-b910-3ee3e4ed3dde",
                                "sense_id": "916489d2-8018-34f3-8e26-35e762e4c83a",
                                "text": "„Mir war, als käme der beißende, bittere Geruch der damaligen Autofahrten zurück mit diesem aus der Armatur springenden Feuerzeug.“"
                            },
                            {
                                "example_id": "cac870e3-3859-4a0e-9002-4e0a395b517b",
                                "sense_id": "916489d2-8018-34f3-8e26-35e762e4c83a",
                                "text": "„Nach stundenlangen Autofahrten in Island habe ich häufig das Gefühl, tagelang gewandert zu sein.“"
                            },
                            {
                                "example_id": "c93f5b50-0553-460a-8b48-4599cd609bab",
                                "sense_id": "916489d2-8018-34f3-8e26-35e762e4c83a",
                                "text": "„Sophie wollte ans Meer, die Mädchen scheuten die lange Autofahrt.“"
                            },
                            {
                                "example_id": "561cc06a-a7d1-4dfe-ab72-3366b79966b6",
                                "sense_id": "916489d2-8018-34f3-8e26-35e762e4c83a",
                                "text": "„Nach endlosen Anrufen und Autofahrten von Baustelle zu Baustelle findet ihn eine tollgewordene Kundin im überschwemmten Keller eines Neubaues.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
