                ],
                "senses": [
                    {
                        "sense_id": "88f572ed-461e-3950-a0cf-6d0720cceddb",
                        "entry_id": "5f7a793b-a1b9-33f2-8cfd-53b68e5cf867",
                        "glosses": [
                            "One of the fine branching tubes of the trachea of an insect, which penetrates the tissues to provide oxygen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98c36c2a-a830-4f9c-813f-c1218ee3d684",
                                "sense_id": "88f572ed-461e-3950-a0cf-6d0720cceddb",
                                "text": "Indeed, in the muscles of the wings every fibre has its own particular tracheole (small trachea)."
                            },
                            {
                                "example_id": "2c793d73-3d78-4ed9-b007-705b6582f244",
                                "sense_id": "88f572ed-461e-3950-a0cf-6d0720cceddb",
                                "text": "A subsequent molting of the intima of the trachea opens a connection between the lumen of the tracheole and the trachea. At the same time or a little later the tracheole breaks forth from its mother cell, uncoils, and extends far beyond the cell in which it was developed."
                            },
                            {
                                "example_id": "f33496cf-d1c9-48ea-ab4c-726402061904",
                                "sense_id": "88f572ed-461e-3950-a0cf-6d0720cceddb",
                                "text": "Oxygen is absorbed all over the body surface through branched tracheoles which are located directly under the body surface."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
