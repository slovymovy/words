                "senses": [
                    {
                        "sense_id": "60db63cf-b947-3fe2-8cd9-662797ccee17",
                        "entry_id": "1c41ff44-4f4c-31ad-85eb-559a07a61265",
                        "glosses": [
                            "Policier de la BAC."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3538fedd-e8bc-49d6-9f3b-5a54ffede223",
                                "sense_id": "60db63cf-b947-3fe2-8cd9-662797ccee17",
                                "text": "L’origine est apparemment une course-poursuite par une voiture de flic d’un jeune du quartier en scooter qui s’est soldée par une chute […]. Rien d’étonnant à cela puisque les flics (et notamment les BACeux) se sont spécialisés dans les arrestations de type « tampon »."
                            },
                            {
                                "example_id": "18209991-bf78-4bd7-b0b4-3fce12817635",
                                "sense_id": "60db63cf-b947-3fe2-8cd9-662797ccee17",
                                "text": "Quand quatre BACeux se retrouvent pris en flag’ de faux et usage de faux dans le cadre d’une enquête ouverte par le parquet de Lyon lors d’une interpellation violente cet été sur les quais..."
                            },
                            {
                                "example_id": "b2feb6e2-44fa-4ec4-8548-a42b23a992da",
                                "sense_id": "60db63cf-b947-3fe2-8cd9-662797ccee17",
                                "text": "Après une heure sur place je vois du mouvement et préfère rentrer chez moi. En m’éloignant de l’attroupement, je vois cinq BACeux me courir après, par réflexe, je me mets à courir."
                            }
                        ]
                    }
