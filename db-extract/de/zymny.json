                "senses": [
                    {
                        "sense_id": "64bdb252-cd86-3bca-8d5b-b4fa789acf7a",
                        "entry_id": "c60b6c54-4051-3d26-9793-b78756e3feba",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5b68bde-e0b1-42c4-a8ef-8e854cec25f9",
                                "sense_id": "64bdb252-cd86-3bca-8d5b-b4fa789acf7a",
                                "text": "Frau Zymny ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fe795e92-ccdd-48a1-b92e-bb29d2331412",
                                "sense_id": "64bdb252-cd86-3bca-8d5b-b4fa789acf7a",
                                "text": "Herr Zymny wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ec0f0d57-3cf2-454c-984b-473736c12587",
                                "sense_id": "64bdb252-cd86-3bca-8d5b-b4fa789acf7a",
                                "text": "Die Zymnys fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "e58c83c4-32d1-427a-896d-f2ad4987ab9f",
                                "sense_id": "64bdb252-cd86-3bca-8d5b-b4fa789acf7a",
                                "text": "Der Zymny trägt nie die Pullover, die die Zymny ihm strickt."
                            },
                            {
                                "example_id": "e0cb4ac1-0706-417b-921d-6790c9cb159e",
                                "sense_id": "64bdb252-cd86-3bca-8d5b-b4fa789acf7a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zymny kommt, geht der Herr Zymny.“"
                            },
                            {
                                "example_id": "cf51de2f-a32b-4417-b87e-cf4476a7cfe4",
                                "sense_id": "64bdb252-cd86-3bca-8d5b-b4fa789acf7a",
                                "text": "Zymny kommt und geht."
                            },
                            {
                                "example_id": "c7e2c288-ea0b-4615-b986-54ab264dd8bb",
                                "sense_id": "64bdb252-cd86-3bca-8d5b-b4fa789acf7a",
                                "text": "Zymnys kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
