                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "135d2ff5-0a49-493f-b9f5-0fc922c63818",
                                                "sense_id": "65cc255d-2fe0-3c20-bbca-2b3a8bf2ffda",
                                                "text": "The cowboy roped the calf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f320d9a5-500f-3409-858a-1dbe728127fa",
                                        "entry_id": "11ee3531-a69b-3707-be18-7a227b4978ed",
                                        "glosses": [
                                            "To climb by means of a rope or ropes."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba948d46-7367-4603-a02c-e094aa75e232",
                                                "sense_id": "f320d9a5-500f-3409-858a-1dbe728127fa",
                                                "text": "We roped down to the platform selected for the bivouac; set up our bags and brewed a reasonable meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "963ac215-666d-38b5-a269-0d48e83b36ba",
                                        "entry_id": "11ee3531-a69b-3707-be18-7a227b4978ed",
                                        "glosses": [
                                            "To be formed into rope; to draw out or extend into a filament or thread."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9961487-fbf0-4493-95c4-4d66e2f3ba53",
                                                "sense_id": "963ac215-666d-38b5-a269-0d48e83b36ba",
                                                "text": "Let us not hang like roping icicles / Upon our houses' thatch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d3751fa-a453-3d8b-b6df-b5b4f1db3096",
                                        "entry_id": "11ee3531-a69b-3707-be18-7a227b4978ed",
                                        "glosses": [
                                            "To pull or restrain (the horse one is riding) to prevent it from winning a race."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44b6f543-0a14-43f7-98d9-a6028216116c",
                                                "sense_id": "4d3751fa-a453-3d8b-b6df-b5b4f1db3096",
                                                "text": "Others, a shade more advanced, have been known to bribe a jockey to \"hold,\" \"rope\" a horse, or a stableman to poison or stupefy him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab3d0512-cf47-3a7f-913d-887ab06788d8",
                                        "entry_id": "11ee3531-a69b-3707-be18-7a227b4978ed",
                                        "glosses": [
                                            "To commit suicide, particularly by hanging."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a71d9b65-de79-4ceb-8d3d-2f7876223616",
                                                "sense_id": "ab3d0512-cf47-3a7f-913d-887ab06788d8",
                                                "text": "In figure 71, the poster Brahcel notes that he “almost roped” because he could not find the community […]"
                                            },
                                            {
                                                "example_id": "8ac765b3-bd7c-448d-bb38-c5554f374c10",
                                                "sense_id": "ab3d0512-cf47-3a7f-913d-887ab06788d8",
                                                "text": "ToxicAlcoholSyndrome explains that his, “dreams are all really depressing and vivid, so… I’m constantly in a bad mood and know in the back of my brain, I need to rope.”"
                                            },
                                            {
                                                "example_id": "ec918140-ba3c-4a16-956e-62413f418081",
                                                "sense_id": "ab3d0512-cf47-3a7f-913d-887ab06788d8",
                                                "text": "Another man wrote that the only reason he hasn't “roped” (incel terminology for death by suicide) is he didn't want to ruin his family's Christmas."
                                            },
                                            {
                                                "example_id": "0d03596b-e7ca-4010-bc87-82e315d28974",
                                                "sense_id": "ab3d0512-cf47-3a7f-913d-887ab06788d8",
                                                "text": "My life is a mess; I might as well rope."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a516477-07ff-355c-87b1-1f04c2d66c76",
                                        "entry_id": "19cc250f-ae89-3be6-9e7b-d40bcf8d8b58",
                                        "glosses": [
                                            "The small intestines."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fe9180c-fcbc-4af4-8788-53135558d711",
                                                "sense_id": "2a516477-07ff-355c-87b1-1f04c2d66c76",
                                                "text": "the ropes of birds"
                                            }
                                        ]
                                    }
