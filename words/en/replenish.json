{
    "word_family": [
        "replenishment",
        "replenishable",
        "plenish",
        "plenitude",
        "plenty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ecb82e77-61ca-311d-ab20-89885ad243fe",
                    "sense_definition": "To refill or supply something again to restore it to its former level or condition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "refill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a popular product, and they have to <w>replenish</w> their stock of it frequently.",
                            "target_lang_translations": {
                                "ru": "Это популярный товар, и им приходится часто <w>пополнять</w> его запасы.",
                                "tr": "Popüler bir ürün olduğu için stoklarını sık sık <w>tazelemeleri</w> gerekiyor."
                            }
                        },
                        {
                            "text": "The hikers stopped at the stream to <w>replenish</w> water supplies before continuing their journey.",
                            "target_lang_translations": {
                                "ru": "Походники остановились у ручья, чтобы <w>пополнить</w> запасы воды перед продолжением пути.",
                                "tr": "Yürüyüşçüler yollarına devam etmeden önce su stoklarını <w>tazelemek</w> için derede durdular."
                            }
                        }
                    ],
                    "synonyms": [
                        "refresh"
                    ],
                    "antonyms": [
                        "deplete"
                    ],
                    "common_phrases": [
                        "replenish stock",
                        "replenish water supplies",
                        "replenish funds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снова наполнить или снабдить чем-либо, чтобы восстановить прежний уровень или состояние.",
                        "tr": "Bir şeyi eski seviyesine veya durumuna getirmek için yeniden doldurmak veya tedarik etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пополнять",
                                "target_lang_sense_clarification": "запасы, ресурсы или коллекции"
                            },
                            {
                                "target_lang_word": "восполнять",
                                "target_lang_sense_clarification": "недостаток или утраченное"
                            },
                            {
                                "target_lang_word": "дозаправлять",
                                "target_lang_sense_clarification": "жидкости или топливо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tazelemek",
                                "target_lang_sense_clarification": "stokları veya kaynakları yenilemek"
                            },
                            {
                                "target_lang_word": "tamamlamak",
                                "target_lang_sense_clarification": "eksik olanı yerine koymak"
                            },
                            {
                                "target_lang_word": "doldurmak",
                                "target_lang_sense_clarification": "boşalan bir kabı veya alanı yeniden doldurmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e316feae-de3a-36ac-b3f5-238028364759",
                    "sense_definition": "To fill up completely or to occupy a space fully.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text commanded the people to be fruitful and <w>replenish</w> the earth.",
                            "target_lang_translations": {
                                "ru": "Древний текст повелевал людям плодиться и <w>наполнять</w> землю.",
                                "tr": "Kadim metin insanlara verimli olmalarını ve dünyayı <w>doldurmalarını</w> emrediyordu."
                            }
                        },
                        {
                            "text": "The goal was to <w>replenish</w> the empty halls with new students by the end of the year.",
                            "target_lang_translations": {
                                "ru": "Цель состояла в том, чтобы к концу года <w>заполнить</w> пустые залы новыми студентами.",
                                "tr": "Amaç, yıl sonuna kadar boş salonları yeni öğrencilerle <w>doldurmaktı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "plenish"
                    ],
                    "common_phrases": [
                        "replenish the earth"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in formal or biblical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью заполнить или занять пространство.",
                        "tr": "Bir alanı tamamen doldurmak veya kaplamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наполнять",
                                "target_lang_sense_clarification": "пространство или землю"
                            },
                            {
                                "target_lang_word": "заселять",
                                "target_lang_sense_clarification": "территорию людьми или животными"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "doldurmak",
                                "target_lang_sense_clarification": "bir mekanı tamamen kaplamak"
                            },
                            {
                                "target_lang_word": "yerleştirmek",
                                "target_lang_sense_clarification": "bir alanı insan veya nesnelerle doldurmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "872bfdd8-b02a-3d91-b685-970757c73042",
                    "sense_definition": "To finish, complete, or make perfect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "complete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet sought to <w>replenish</w> his masterpiece with one final, perfect stanza.",
                            "target_lang_translations": {
                                "ru": "Поэт стремился <w>завершить</w> свой шедевр последней, идеальной строфой.",
                                "tr": "Şair, başyapıtını son bir mükemmel kıta ile <w>tamamlamaya</w> çalışıyordu."
                            }
                        },
                        {
                            "text": "In the old play, they spoke of how they smothered the most <w>replenished</w> sweet work of nature.",
                            "target_lang_translations": {
                                "ru": "В старой пьесе говорили о том, как они задушили самое <w>совершенное</w> и милое творение природы.",
                                "tr": "Eski oyunda, doğanın en <w>mükemmel</w> ve tatlı eserini nasıl boğduklarından bahsediyorlardı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Завершить, довести до конца или сделать совершенным.",
                        "tr": "Bitirmek, tamamlamak veya mükemmel hale getirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завершать",
                                "target_lang_sense_clarification": "работу или творение"
                            },
                            {
                                "target_lang_word": "усовершенствовать",
                                "target_lang_sense_clarification": "доводить до идеала"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tamamlamak",
                                "target_lang_sense_clarification": "bir eseri veya işi bitirmek"
                            },
                            {
                                "target_lang_word": "mükemmelleştirmek",
                                "target_lang_sense_clarification": "bir şeyi kusursuz hale getirmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}