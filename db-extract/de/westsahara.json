                "senses": [
                    {
                        "sense_id": "6884ed72-4080-3e8a-aa62-828ca500d9d2",
                        "entry_id": "0f9b20e3-f4fc-3e3c-8489-95672f26dfe8",
                        "glosses": [
                            "umstrittenes Gebiet im Nordwesten Afrikas, das von Marokko beansprucht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b728e1c9-065e-472b-8123-55c95a003bb0",
                                "sense_id": "6884ed72-4080-3e8a-aa62-828ca500d9d2",
                                "text": "„Die Bevölkerung des Gebiets Westsahara von 373.008 Einwohnern besteht vor allem aus Arabern und arabisierten Berbern.“"
                            },
                            {
                                "example_id": "b01e8165-b90e-47b0-b8dd-cde3e6e06857",
                                "sense_id": "6884ed72-4080-3e8a-aa62-828ca500d9d2",
                                "text": "Der Westteil der ehemaligen spanischen Kolonie Westsahara wird von Marokko verwaltet und der Ostteil von der provisorischen Regierung der Befreiungsfront Polisario, die auch die Flüchtlingslager der Saharauis im benachbarten Algerien geschaffen hat."
                            },
                            {
                                "example_id": "58bde5e1-6bfa-4875-b86c-6b1014ac898f",
                                "sense_id": "6884ed72-4080-3e8a-aa62-828ca500d9d2",
                                "text": "„Auf Marokko folgten die Westsahara und dann Mauretanien und der Senegal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecd3406b-3a87-4751-8353-1d068a05f74b",
                        "source_entry_id": "0f9b20e3-f4fc-3e3c-8489-95672f26dfe8",
                        "source_sense_id": "6884ed72-4080-3e8a-aa62-828ca500d9d2",
                        "source_sense_description": "umstrittenes Gebiet im Nordwesten Afrikas, das von Marokko beansprucht wird",
                        "target_lang_word": "West Sahara",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c32c16c5-58e9-4cd0-82b8-ff502347e3da",
                        "source_entry_id": "0f9b20e3-f4fc-3e3c-8489-95672f26dfe8",
                        "source_sense_id": "6884ed72-4080-3e8a-aa62-828ca500d9d2",
                        "source_sense_description": "umstrittenes Gebiet im Nordwesten Afrikas, das von Marokko beansprucht wird",
                        "target_lang_word": "Sahara occidental",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sahara occidental",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6b21ac5-11e1-344b-8dfa-fc2b2f84325b",
                                        "entry_id": "16882a9a-eac3-38e6-b229-5e3c26927e58",
                                        "glosses": [
                                            "Territoire du nord-ouest de l’Afrique, annexé par le Maroc, bordé au nord-est par le Maroc et l'Algérie, au sud et à l’est par la Mauritanie, tandis que sa côte ouest donne sur l’océan Atlantique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb5f363d-9f1c-4b9d-9c38-5c2203345755",
                                                "sense_id": "e6b21ac5-11e1-344b-8dfa-fc2b2f84325b",
                                                "text": "Dans un premier temps, ce fut celui-ci qui ne voulait rien entendre, estimant qu'après la « Marche verte », la maroquinité du Sahara occidental ne pouvait plus être remise en cause."
                                            },
                                            {
                                                "example_id": "58b1a5cd-2016-4316-85f0-09594e237661",
                                                "sense_id": "e6b21ac5-11e1-344b-8dfa-fc2b2f84325b",
                                                "text": "Au Maroc, remettre en cause la marocanité du Sahara occidental est passible de prison."
                                            },
                                            {
                                                "example_id": "7b0b9084-4a42-424d-b30c-588d803564f7",
                                                "sense_id": "e6b21ac5-11e1-344b-8dfa-fc2b2f84325b",
                                                "text": "Qu’il s’agisse de reconnaître la souveraineté du Maroc sur le Sahara occidental, d’attiser la tension avec l’Iran ou de minimiser une cyberattaque pour ne pas froisser les maîtres du Kremlin, les crocs-en-jambe de Trump à son successeur s’accumulent."
                                            },
                                            {
                                                "example_id": "87637ace-014b-4b0a-b9d1-d4333f95d392",
                                                "sense_id": "e6b21ac5-11e1-344b-8dfa-fc2b2f84325b",
                                                "text": "La Cour a également statué ce vendredi que les produits agricoles tels que les melons et les tomates doivent être clairement étiquetés comme étant originaires du Sahara occidental, excluant toute référence au Maroc, afin d’éviter d’induire les consommateurs en erreur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ad0e276-6656-4653-9caa-56a33186dbd1",
                        "source_entry_id": "0f9b20e3-f4fc-3e3c-8489-95672f26dfe8",
