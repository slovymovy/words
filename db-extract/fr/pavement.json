                "senses": [
                    {
                        "sense_id": "217a0c74-16ac-319c-8410-bdca0eecbe85",
                        "entry_id": "c42432de-10e5-3a87-a4d0-7bf69451595d",
                        "glosses": [
                            "Action de paver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d71960e-b048-48cc-a0c7-235ce68d8014",
                                "sense_id": "217a0c74-16ac-319c-8410-bdca0eecbe85",
                                "text": "Le pavement des rues de Paris n’eut lieu que sous Philippe-Auguste."
                            },
                            {
                                "example_id": "6b5a8a56-14e0-4860-aef3-c57dcc635fe0",
                                "sense_id": "217a0c74-16ac-319c-8410-bdca0eecbe85",
                                "text": "La même année 1186, le roi lance un chantier encore plus décisif : le pavement des rues."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9d5ebbf-1dcd-34bb-a04d-b6384f7704a7",
                        "entry_id": "c42432de-10e5-3a87-a4d0-7bf69451595d",
                        "glosses": [
                            "Matériaux qu’on emploie pour cet effet et, plus particulièrement, des ouvrages de luxe et de goût qui forment les pavages intérieurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b1d669c-21de-4bc4-93bd-49dd9e22d031",
                                "sense_id": "b9d5ebbf-1dcd-34bb-a04d-b6384f7704a7",
                                "text": "Le pavement en mosaïque d’une église."
                            },
                            {
                                "example_id": "29c7091e-7ee4-4ea2-98e5-092e9a4c1391",
                                "sense_id": "b9d5ebbf-1dcd-34bb-a04d-b6384f7704a7",
                                "text": "Le pavement des édifices grecs et romains était souvent de marbre de couleur."
                            }
                        ]
                    }
