                    {
                        "form_id": "eb1058dd-a2ab-4642-a861-18bc4b08d925",
                        "entry_id": "4bc255ac-467a-387a-a06e-09ea4aba9a98",
                        "tags": [
                            "feminine"
                        ],
                        "form": "importatrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f370b70-0369-33b6-be10-5badeb841b34",
                        "entry_id": "4bc255ac-467a-387a-a06e-09ea4aba9a98",
                        "glosses": [
                            "Celui qui fait le commerce d’importation : commerçant indépendant qui achète ferme les produits de l'exportateur et qui ensuite les revend à son nom et pour son propre compte, donc à ses risques et profits. Il se rémunère en prélevant une marge bénéficiaire."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2b5872e2-d9be-3a5d-afd2-61a09d0ef00c",
                        "entry_id": "4bc255ac-467a-387a-a06e-09ea4aba9a98",
                        "glosses": [
                            "Entité qui importe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc69749a-b542-44f1-9711-9cc203bebc1a",
                                "sense_id": "2b5872e2-d9be-3a5d-afd2-61a09d0ef00c",
                                "text": "La Chine est le deuxième importateur mondial à hauteur de 50 % de sa consommation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "138677fb-91b4-4f27-9c45-db6fa3752889",
                        "source_entry_id": "4bc255ac-467a-387a-a06e-09ea4aba9a98",
                        "source_sense_description": "Celui qui importe",
                        "target_lang_word": "importer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "importer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "529bb7ff-4b71-3e76-9770-eab548bd01c4",
                                        "entry_id": "db1c5d3f-c257-3541-8de5-2c54126b5b9e",
                                        "glosses": [
                                            "One who, or that which, imports: especially a person or company importing goods into a country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d95846e-9391-4312-a74f-8ea8f35376eb",
                                                "sense_id": "529bb7ff-4b71-3e76-9770-eab548bd01c4",
                                                "text": "India is the world's biggest importer of gold."
                                            },
                                            {
                                                "example_id": "db4f306e-fa36-40d4-aa0a-0db931f819d2",
                                                "sense_id": "529bb7ff-4b71-3e76-9770-eab548bd01c4",
                                                "text": "The data importer has crashed. Did we receive a corrupted file?"
                                            },
                                            {
                                                "example_id": "b2d92fcc-4f5f-4086-8723-2001aeb2f10d",
                                                "sense_id": "529bb7ff-4b71-3e76-9770-eab548bd01c4",
                                                "text": "Tobacco, for instance, shrinks materially by frequent reshippings, and as all goods are warehoused as a convenience to importers, duties should be paid on what the importer receives."
                                            }
                                        ]
                                    }
                                ]
                            }
