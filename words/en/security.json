{
    "word_family": [
        "secure",
        "insecurity",
        "securely"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b648f72-2f96-311c-8253-da62829ca296",
                    "sense_definition": "The state of being free from danger, threat, anxiety, or uncertainty.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state_of_safety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new alarm system gives the family a greater sense of <w>security</w> at night.",
                            "target_lang_translations": {
                                "ru": "Новая сигнализация дает семье большее чувство <w>безопасности</w> по ночам.",
                                "zh": "新的报警系统让这家人在晚上更有<w>安全感</w>。"
                            }
                        },
                        {
                            "text": "Strict measures were introduced to ensure the <w>security</w> of all passengers.",
                            "target_lang_translations": {
                                "ru": "Были введены строгие меры для обеспечения <w>безопасности</w> всех пассажиров.",
                                "zh": "为了确保所有乘客的<w>安全</w>，当局采取了严格的措施。"
                            }
                        }
                    ],
                    "synonyms": [
                        "safety",
                        "protection"
                    ],
                    "antonyms": [
                        "insecurity"
                    ],
                    "common_phrases": [
                        "national security",
                        "job security",
                        "sense of security",
                        "security breach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние защищённости от опасности, угроз, тревоги или неопределённости.",
                        "zh": "免受危险、威胁、焦虑或不确定性影响的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безопа́сность",
                                "target_lang_sense_clarification": "состояние защищённости"
                            },
                            {
                                "target_lang_word": "защи́та",
                                "target_lang_sense_clarification": "ограждение от угроз"
                            },
                            {
                                "target_lang_word": "надёжность",
                                "target_lang_sense_clarification": "уверенность, отсутствие риска"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安全",
                                "target_lang_sense_clarification": "没有危险的状态"
                            },
                            {
                                "target_lang_word": "保障",
                                "target_lang_sense_clarification": "保护使不受损害"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f185851-ca5f-3274-a1ae-975b857154bc",
                    "sense_definition": "A department, organization, or group of people responsible for preventing danger, enforcing rules, and maintaining order.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "department",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to pass through airport <w>security</w> before we could board the plane.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось пройти через <w>службу безопасности</w> аэропорта, прежде чем мы смогли сесть на самолет.",
                                "zh": "我们必须通过机场<w>安检</w>才能登机。"
                            }
                        },
                        {
                            "text": "The store <w>security</w> stopped the shoplifter at the exit.",
                            "target_lang_translations": {
                                "ru": "<w>Охрана</w> магазина остановила вора на выходе.",
                                "zh": "商店<w>保安</w>在出口处拦住了那个小偷。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "airport security",
                        "security guard",
                        "call security",
                        "security camera"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдел, организация или группа людей, отвечающих за предотвращение опасности и поддержание порядка.",
                        "zh": "负责预防危险、执行规则和维持秩序的部门、组织或人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охра́на",
                                "target_lang_sense_clarification": "группа людей, обеспечивающая порядок"
                            },
                            {
                                "target_lang_word": "слу́жба безопа́сности",
                                "target_lang_sense_clarification": "организация или отдел"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安保",
                                "target_lang_sense_clarification": "安全保卫工作或人员"
                            },
                            {
                                "target_lang_word": "保安",
                                "target_lang_sense_clarification": "负责安全的人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae7fce45-33db-36b8-a425-0bb13f614438",
                    "sense_definition": "A tradeable financial asset, such as a stock or bond, that holds value.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance_asset",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank manages a diverse portfolio of <w>securities</w> for its wealthy clients.",
                            "target_lang_translations": {
                                "ru": "Банк управляет разнообразным портфелем <w>ценных бумаг</w> для своих состоятельных клиентов.",
                                "zh": "这家银行为其富裕客户管理着多元化的<w>证券</w>投资组合。"
                            }
                        },
                        {
                            "text": "Investing in government <w>securities</w> is generally considered a low-risk option.",
                            "target_lang_translations": {
                                "ru": "Инвестирование в государственные <w>ценные бумаги</w> обычно считается вариантом с низким риском.",
                                "zh": "投资政府<w>证券</w>通常被认为是一种低风险的选择。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "government securities",
                        "marketable securities",
                        "securities market"
                    ],
                    "target_lang_definitions": {
                        "ru": "Торгуемый финансовый актив, такой как акция или облигация, имеющий стоимость.",
                        "zh": "具有价值的可交易金融资产，如股票或债券。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "це́нная бума́га",
                                "target_lang_sense_clarification": "финансовый документ (акция, облигация)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "证券",
                                "target_lang_sense_clarification": "金融投资工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3da04048-b058-3e6c-bb84-66b1e0093544",
                    "sense_definition": "Property or a promise given to a lender to guarantee the repayment of a loan or the fulfillment of an obligation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance_collateral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used his house as <w>security</w> to borrow a large sum of money from the bank.",
                            "target_lang_translations": {
                                "ru": "Он использовал свой дом в качестве <w>залога</w>, чтобы занять крупную сумму денег в банке.",
                                "zh": "他用房子作<w>抵押</w>，从银行借了一大笔钱。"
                            }
                        },
                        {
                            "text": "The lender demanded adequate <w>security</w> before approving the business loan.",
                            "target_lang_translations": {
                                "ru": "Кредитор потребовал надлежащего <w>обеспечения</w> перед одобрением бизнес-кредита.",
                                "zh": "贷款人在批准商业贷款前要求提供充足的<w>担保</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "guarantee",
                        "surety",
                        "pledge"
                    ],
                    "common_phrases": [
                        "security for a loan",
                        "stand security",
                        "give security"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имущество или обещание, предоставляемое кредитору в качестве гарантии возврата кредита.",
                        "zh": "为保证贷款偿还或履行义务而提供给贷款人的财产或承诺。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зало́г",
                                "target_lang_sense_clarification": "имущество для обеспечения займа"
                            },
                            {
                                "target_lang_word": "гара́нтия",
                                "target_lang_sense_clarification": "обеспечение выполнения обязательств"
                            },
                            {
                                "target_lang_word": "обеспе́чение",
                                "target_lang_sense_clarification": "финансовый термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抵押",
                                "target_lang_sense_clarification": "作为债务担保的财产"
                            },
                            {
                                "target_lang_word": "担保",
                                "target_lang_sense_clarification": "保证履行义务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f1d347b-08de-373d-bbba-4ccbac9091b0",
                    "sense_definition": "A feeling of overconfidence or carelessness that leads to negligence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_negligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His false <w>security</w> led him to ignore the approaching danger until it was too late.",
                            "target_lang_translations": {
                                "ru": "Его ложная <w>самоуверенность</w> заставила его игнорировать приближающуюся опасность, пока не стало слишком поздно.",
                                "zh": "他那种虚假的<w>安全感</w>使他忽视了临近的危险，直到为时已晚。"
                            }
                        },
                        {
                            "text": "The army was lulled into <w>security</w> and failed to set a proper guard for the night.",
                            "target_lang_translations": {
                                "ru": "Армия была убаюкана <w>беспечностью</w> и не выставила надлежащую охрану на ночь.",
                                "zh": "军队因<w>麻痹大意</w>而没有在夜间安排适当的守卫。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a lack of caution due to overconfidence."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство излишней самоуверенности или неосторожности, ведущее к халатности.",
                        "zh": "导致疏忽的过度自信或粗心大意的感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспе́чность",
                                "target_lang_sense_clarification": "отсутствие бдительности"
                            },
                            {
                                "target_lang_word": "самоуве́ренность",
                                "target_lang_sense_clarification": "ложное чувство безопасности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "麻痹大意",
                                "target_lang_sense_clarification": "因过度自信而失去警惕"
                            },
                            {
                                "target_lang_word": "盲目自信",
                                "target_lang_sense_clarification": "不切实际的自信"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}