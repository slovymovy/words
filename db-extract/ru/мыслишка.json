                ],
                "senses": [
                    {
                        "sense_id": "19644054-1af4-3a6a-b47e-3b81a468a9ff",
                        "entry_id": "0806c72e-99ce-3f5d-815a-3a87848c80bb",
                        "glosses": [
                            "разг., уничиж. к мысль"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fd3c195-668b-436a-889d-2c041576fe89",
                                "sense_id": "19644054-1af4-3a6a-b47e-3b81a468a9ff",
                                "text": "Но под этой большой шляпой нет здравых мыслей, есть порхающие, как мотыльки, обрывки мыслишек и воспоминаний."
                            },
                            {
                                "example_id": "185c8b24-3edf-4379-8425-5010a83346a0",
                                "sense_id": "19644054-1af4-3a6a-b47e-3b81a468a9ff",
                                "text": "Еда и на ум не идёт, сон от меня бежит, всякие дурные мыслишки в голову лезут…"
                            },
                            {
                                "example_id": "b190c35d-888c-48cc-88bf-ecd80b908e80",
                                "sense_id": "19644054-1af4-3a6a-b47e-3b81a468a9ff",
                                "text": "Великие стратегические думы президента и маршала о будущем России и Белоруссии удачно сочетались с их тайными меркантильными мыслишками о собственном положении во власти."
                            }
                        ]
                    }
                ],
