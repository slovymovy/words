                                        "glosses": [
                                            "An eater of coconuts; someone subsisting primarily on coconut."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4a46ead-53c7-4936-b589-5d2d9d3c8756",
                                                "sense_id": "012712e7-5ccc-35fb-bb38-46148b680195",
                                                "text": "Fraulein Schwab was German, a nudist, a Cocovore, but undoubtedly a well-born lady."
                                            },
                                            {
                                                "example_id": "341b0850-12a9-4b17-b6c6-4d6ff87ca90f",
                                                "sense_id": "012712e7-5ccc-35fb-bb38-46148b680195",
                                                "text": "August Engelhardt's most fervent wish, his destiny in fact, was to establish a colony of cocovores."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
