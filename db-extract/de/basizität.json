                "senses": [
                    {
                        "sense_id": "adc197f4-cdb3-3154-82aa-41fabbf19625",
                        "entry_id": "6680fd80-1484-32b7-9d34-f7cd34412700",
                        "glosses": [
                            "Eigenschaft, Basen bilden zu können, Basenstärke"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "b28c462f-9a6a-42c1-b4dc-126f107c91a5",
                                "sense_id": "adc197f4-cdb3-3154-82aa-41fabbf19625",
                                "text": "„Ammoniak ist in Wasser eine schwache Base, Stickstofftrifluorid zeigt jedoch keinerlei Basizität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9ffc29b7-6c7f-3e67-ab6a-ee67f39d0ab3",
                        "entry_id": "6680fd80-1484-32b7-9d34-f7cd34412700",
                        "glosses": [
                            "Grad der Fähigkeit, Protonen aufnehmen zu können, das freie Elektronenpaar zu teilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09a0fc57-d64c-46c7-ad95-0a7b09aa459b",
                                "sense_id": "9ffc29b7-6c7f-3e67-ab6a-ee67f39d0ab3",
                                "text": "„Dabei können kurzzeitig Basizitäten auftreten, die wesentlich höher sind als die durch das Protonengleichgewicht gemessene Durchschnittsbasizität, eine thermodynamische Konstante.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
