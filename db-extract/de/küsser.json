                "senses": [
                    {
                        "sense_id": "14bead87-0080-3c3e-af0d-a1ab69693c89",
                        "entry_id": "5153140c-2cdb-3186-8a9a-cd6bd9d0fb6e",
                        "glosses": [
                            "Person, die eine andere küsst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "079ceb60-3842-4587-8bbf-26b8f769c883",
                                "sense_id": "14bead87-0080-3c3e-af0d-a1ab69693c89",
                                "text": "„Aggressive Küsser sind nach Erfahrung der Befragten Egoisten, die vor allem selbst auf ihre Kosten kommen wollen.“"
                            },
                            {
                                "example_id": "7248979b-b2f9-4191-a1ee-57c0b01c3882",
                                "sense_id": "14bead87-0080-3c3e-af0d-a1ab69693c89",
                                "text": "„Als Lejla noch lebte, haben sie einander mindestens 20 SMS am Tag geschickt. Haben über Mindestlohn und Chancengleichheit diskutiert, über schlechte Küsser und krasse Diätregeln gelästert, über Differenzialrechnungen geklagt und sich gegenseitig über neue Nagellackmarken und neue Pickel informiert.“"
                            },
                            {
                                "example_id": "d86164b9-5b05-445f-937f-62b0b46e1156",
                                "sense_id": "14bead87-0080-3c3e-af0d-a1ab69693c89",
                                "text": "„Die Spanier fanden bei einer weiteren Studie zum \"Europäischen Kussverhalten\" auch heraus, dass Deutschland besonders schlechte Küsser hervorbringt.“"
                            },
                            {
                                "example_id": "28dd89fa-3edd-4ec5-8703-d7c7e3fe0a9b",
                                "sense_id": "14bead87-0080-3c3e-af0d-a1ab69693c89",
                                "text": "„Es gab die enthusiastischen Küsser, die mit der Zunge spielten, und solche, die beim Küssen automatisch versuchten, eine Hand unter mein T-Shirt zu schieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54f0b763-f95d-4456-8792-24565ba41798",
                        "source_entry_id": "5153140c-2cdb-3186-8a9a-cd6bd9d0fb6e",
                        "source_sense_id": "14bead87-0080-3c3e-af0d-a1ab69693c89",
