                                    },
                                    {
                                        "sense_id": "ab25dd98-644b-3e16-9def-36f0cfdd1a0c",
                                        "entry_id": "59a1b2a2-469c-3ad1-a0e5-5e997e2c41bc",
                                        "glosses": [
                                            "To become cold."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
