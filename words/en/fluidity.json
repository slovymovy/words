{
    "word_family": [
        "fluid",
        "fluidly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95f5c774-d053-3980-b302-956e8217911b",
                    "sense_definition": "The quality of being smooth, graceful, or able to change easily.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer moved with such <w>fluidity</w> that she seemed to glide across the stage.",
                            "target_lang_translations": {
                                "ru": "Танцовщица двигалась с такой <w>плавностью</w>, что казалось, будто она парит над сценой."
                            }
                        },
                        {
                            "text": "The team showed great <w>fluidity</w> in their passing, making it hard for the opponents to defend.",
                            "target_lang_translations": {
                                "ru": "Команда продемонстрировала отличную <w>слаженность</w> передач, что сильно усложнило соперникам защиту."
                            }
                        }
                    ],
                    "synonyms": [
                        "grace",
                        "smoothness",
                        "flexibility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плавность, грациозность движений или способность легко меняться и адаптироваться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плавность",
                                "target_lang_sense_clarification": "о движениях, речи или переходах"
                            },
                            {
                                "target_lang_word": "гибкость",
                                "target_lang_sense_clarification": "способность легко меняться, адаптироваться"
                            },
                            {
                                "target_lang_word": "текучесть",
                                "target_lang_sense_clarification": "переносное значение: изменчивость, непрерывность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "722db4c8-667d-3d3c-9619-44c0fd041804",
                    "sense_definition": "The physical state of being a liquid or gas that can flow easily.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fluidity</w> of the oil allows it to move through the narrow pipes without resistance.",
                            "target_lang_translations": {
                                "ru": "<w>Текучесть</w> масла позволяет ему беспрепятственно проходить по узким трубам."
                            }
                        },
                        {
                            "text": "Scientists studied the <w>fluidity</w> of the molten metal to improve the casting process.",
                            "target_lang_translations": {
                                "ru": "Учёные исследовали <w>жидкотекучесть</w> расплавленного металла, чтобы усовершенствовать процесс литья."
                            }
                        }
                    ],
                    "synonyms": [
                        "liquidity"
                    ],
                    "antonyms": [
                        "viscosity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое свойство жидкости или газа легко течь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "текучесть",
                                "target_lang_sense_clarification": "способность вещества течь"
                            },
                            {
                                "target_lang_word": "жидкотекучесть",
                                "target_lang_sense_clarification": "свойство расплавленных металлов или растворов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e86e4495-531d-3810-9d2a-937303f9918b",
                    "sense_definition": "A scientific measure of how easily a substance flows, calculated as the inverse of viscosity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Increasing the temperature of the substance significantly improves its <w>fluidity</w>.",
                            "target_lang_translations": {
                                "ru": "Повышение температуры вещества значительно увеличивает его <w>текучесть</w>."
                            }
                        },
                        {
                            "text": "The <w>fluidity</w> of the chemical mixture was measured precisely in the laboratory experiment.",
                            "target_lang_translations": {
                                "ru": "<w>Текучесть</w> химической смеси была точно измерена в ходе лабораторного эксперимента."
                            }
                        }
                    ],
                    "antonyms": [
                        "viscosity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Научная величина, характеризующая способность вещества течь; величина, обратная вязкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "текучесть",
                                "target_lang_sense_clarification": "физическая характеристика, обратная вязкости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}