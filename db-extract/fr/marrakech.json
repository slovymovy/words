        "fr-extract.jsonl": [
            {
                "entry_id": "9fbaa7f6-524b-35da-a0b7-a3d4d917dffb",
                "word": "Marrakech",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3607f952-b027-3884-9b2b-9fe06c7ea21d",
                        "entry_id": "9fbaa7f6-524b-35da-a0b7-a3d4d917dffb",
                        "glosses": [
                            "Ville du Maroc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f056322-0741-4026-aad4-59b0dfa3d04b",
                                "sense_id": "3607f952-b027-3884-9b2b-9fe06c7ea21d",
                                "text": "Je partis donc le lendemain même, pris part à tout le reste de la campagne, parcourant les Chaouïa, les Doukkala, les Rahamna, et, trois mois après mon départ de Casablanca, j’assistais à l’entrée triomphale du Sultan et de son armée à Marrakech."
                            },
                            {
                                "example_id": "6ab93b7c-f5c9-43a7-8029-657f1d210f41",
                                "sense_id": "3607f952-b027-3884-9b2b-9fe06c7ea21d",
                                "text": "Les marchés d’esclaves les plus importants étaient ceux de Fez et de Marrakech."
                            },
                            {
                                "example_id": "cd71310e-8643-4e7c-a166-956811435ebf",
                                "sense_id": "3607f952-b027-3884-9b2b-9fe06c7ea21d",
                                "text": "Sa nuit « à la belle étoile » sous le ciel de Marrakech, Tara l’a passée avec ses voisins de chambre, près d’un terrain de foot, dans l’angoisse d’une réplique du terrible séisme qui a ravagé la Maroc vendredi soir."
                            },
                            {
                                "example_id": "4b71d2e4-0b13-4353-b496-72b9ae9f8175",
                                "sense_id": "3607f952-b027-3884-9b2b-9fe06c7ea21d",
                                "text": "« Dix-septième édition ! », annonce le chorégraphe Taoufiq Izeddiou, 49 ans, directeur du Festival international de danse contemporaine On marche, créé en 2005, à Marrakech."
                            }
                        ]
                    }
                ],
