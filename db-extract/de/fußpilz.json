                        "entry_id": "96042410-1722-3d6c-93b4-c9d6a3c3fed7",
                        "glosses": [
                            "Pilzinfektion an den Füßen, insbesondere zwischen den Zehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b6d4a2b-1b5c-4bce-af86-47e2a50fb262",
                                "sense_id": "b3a855da-35f4-3087-be14-dd1923b63958",
                                "text": "Verursacht wird Fußpilz durch so genannte Fadenpilze (Dermatophyten), die das Hornmaterial (Nägel, Haare) befallen und sich hauptsächlich in den Zehenzwischenräumen ansiedeln."
                            },
                            {
                                "example_id": "dc8eca6c-8b40-4eac-8a74-a7d6b6c0f905",
                                "sense_id": "b3a855da-35f4-3087-be14-dd1923b63958",
                                "text": "Typische Symptome des Fußpilzes sind Rötung, Nässen, Schuppung, Blasenbildung und Juckreiz, oft begleitet von Entzündungen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
