                "senses": [
                    {
                        "sense_id": "2abf2dc8-4a5c-34ad-8b28-1363053ff835",
                        "entry_id": "d01689f8-1476-3333-a7ec-eedaf3851ce7",
                        "glosses": [
                            "Laufen/Joggen an einem Donnerstag"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "bc1aab98-b67b-44e4-b038-968b163f04f7",
                                "sense_id": "2abf2dc8-4a5c-34ad-8b28-1363053ff835",
                                "text": "„Am Dienstag ging es auf einen langsameren Lauf, der Donnerstagslauf war dafür dann deutlich schneller.“"
                            },
                            {
                                "example_id": "a76ff078-c640-47d5-82c7-3c8d02476265",
                                "sense_id": "2abf2dc8-4a5c-34ad-8b28-1363053ff835",
                                "text": "„Heute Mittag habe ich dann quasi noch mein anderes neues Langarm-Oberteil von Intersport erfolgreich getestet, als ich den ausgefallenen Donnerstagslauf nachgeholt habe.“"
                            },
                            {
                                "example_id": "32907cbb-ca2c-4fc6-8b3e-b7828216dbcd",
                                "sense_id": "2abf2dc8-4a5c-34ad-8b28-1363053ff835",
                                "text": "„Meinen Donnerstagslauf habe ich in dieser Woche auf den Freitag verschoben.“"
                            },
                            {
                                "example_id": "988a39e8-4928-4184-8c8d-08268a5a91cb",
                                "sense_id": "2abf2dc8-4a5c-34ad-8b28-1363053ff835",
                                "text": "„Beim Kartenstudium meines Donnerstagslaufes ist mir dann eine nette Idee gekommen.“"
                            },
                            {
                                "example_id": "69c35fc7-7378-44bb-978c-025a7894addd",
                                "sense_id": "2abf2dc8-4a5c-34ad-8b28-1363053ff835",
                                "text": "„Der Donnerstagslauf wurde erst auf Freitag, dann auf Samstag morgen verschoben und schließlich wegen der Reise nach Bayern ganz weggelassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
