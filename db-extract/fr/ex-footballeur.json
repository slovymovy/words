                                "sense_id": "ad90c952-adf3-3628-8d5f-2249b620b947",
                                "text": "Encore faut-il que les ex-footballeurs sachent comment investir leur pécule."
                            },
                            {
                                "example_id": "1b121e68-e1c5-4abb-9706-810ca3ff9de5",
                                "sense_id": "ad90c952-adf3-3628-8d5f-2249b620b947",
                                "text": "L’arthrose du genou touche à l’âge moyen de 55 ans, 5 % des ex-footballeurs et 15 % des ex-joueurs d’élite."
                            }
                        ]
