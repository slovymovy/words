                    {
                        "sense_id": "d9682505-c3e5-3b4e-9566-28666386c425",
                        "entry_id": "642628ed-db22-313a-a0a6-d74778d38986",
                        "glosses": [
                            "Nom vernaculaire de nombreux oiseaux de l’ordre des passereaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bfc710a-b6d4-46cb-9cfa-fb2040b108b6",
                                "sense_id": "d9682505-c3e5-3b4e-9566-28666386c425",
                                "text": "Oiseaux chanteurs et de joli plumage, dont : le bengali et le colibri, le bec d’argent, le cardinal, le merle métallique, la « veuve » en voile de deuil alourdie à la saison des amours par sa longue traîne empennée, le parlementaire, les gendarmes ou tisserins ou républicains qui ont tôt fait de désenfeuiller palmiers etc. pour tisser leurs nids des longs rubans de feuilles arrachés un par un, etc."
                            },
                            {
                                "example_id": "148a59ba-c425-4761-937e-36bcf1afe0fa",
                                "sense_id": "d9682505-c3e5-3b4e-9566-28666386c425",
                                "text": "Le bruit du moteur était couvert par les piaillements d’une colonie de tisserins dont les nids pendaient mollement aux branches des acacias."
                            }
                        ]
                    }
                ],
