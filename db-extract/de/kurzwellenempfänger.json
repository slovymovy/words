                "senses": [
                    {
                        "sense_id": "25ac0ace-cd08-361c-ac49-da0863f7b587",
                        "entry_id": "55062daf-ab7a-3d20-b3de-207b0a13eb10",
                        "glosses": [
                            "elektronisches Gerät, das auf Kurzwelle gesendete Signale empfangen und verarbeiten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd28f0ab-3b81-4d9b-9d88-9e13ed7f4635",
                                "sense_id": "25ac0ace-cd08-361c-ac49-da0863f7b587",
                                "text": "„Jeden Dienstag gegen sechs Uhr morgens saß sie vor einem Kurzwellenempfänger und nahm Weisungen aus der Heimat entgegen.“"
                            },
                            {
                                "example_id": "1e0d73fb-85de-433e-ab46-cc91c1801a56",
                                "sense_id": "25ac0ace-cd08-361c-ac49-da0863f7b587",
                                "text": "„Angespannt lauschen die Ingenieure auf das Knistern in den Kurzwellenempfängern.Erst als sie ganz leise, dann immer lauter das charakteristische Piep-Piep des Sputnik hören, fallen sie sich in die Arme.“"
                            },
                            {
                                "example_id": "6b269df9-4b2d-4131-bf6a-a91097f61522",
                                "sense_id": "25ac0ace-cd08-361c-ac49-da0863f7b587",
                                "text": "„Gegen 7.00 Uhr fällt unser Kurzwellenempfänger aus; in der Endstufe sind mehrere Widerstände durchgebrannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
