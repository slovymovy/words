                            {
                                "example_id": "6d6a8dd8-8001-4632-86c3-c98758efc147",
                                "sense_id": "f1dd3e4c-6306-38ec-9823-b68e6842de38",
                                "text": "on every syde / They trembling stood, and made a long broad dyke, / That his swift charet might have passage wyde / Which foure great Hippodames did draw in temewise tyde."
                            },
                            {
                                "example_id": "9ac1dd57-9b07-4d9a-9f4f-17d63b62026e",
                                "sense_id": "f1dd3e4c-6306-38ec-9823-b68e6842de38",
                                "text": "Nor did less tumult swell the late defeat Of monstrous Dagon, from whom, worse deformed With hippodame and kraken, self -assumed, So spirits can, turned infantry and steed, Nor chose the ambush of his doubtful shape."
                            }
                        ]
