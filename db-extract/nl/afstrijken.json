                "senses": [
                    {
                        "sense_id": "a97b693e-2a00-34ce-845d-5183b424541b",
                        "entry_id": "fa8ecc27-0fed-39df-a839-bf1450a62d0d",
                        "glosses": [
                            "to strike (a match, to attempt to ignite it)"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "44c2bcc9-0f2e-45b9-b70a-afbb53781226",
                                "sense_id": "a97b693e-2a00-34ce-845d-5183b424541b",
                                "text": "Een veiligheidslucifer, in tegensteling tot een strijklucifer, kun je niet redelijk aan alles afstrijken.",
                                "translation": "A safety match, as opposed to a strike-anywhere match, can't be easily struck on any surface.",
                                "english": "A safety match, as opposed to a strike-anywhere match, can't be easily struck on any surface."
                            }
                        ]
                    },
                    {
                        "sense_id": "51896d0d-a4d0-3cdc-a3a1-7661e08eea03",
                        "entry_id": "fa8ecc27-0fed-39df-a839-bf1450a62d0d",
                        "glosses": [
                            "to rub out"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5fd2e72f-305b-4156-b646-114644451f4f",
                                "sense_id": "51896d0d-a4d0-3cdc-a3a1-7661e08eea03",
                                "text": "Strijk het overvloed kit af met terpentine.",
                                "translation": "Rub out excessive sealant with turpentine.",
                                "english": "Rub out excessive sealant with turpentine."
                            }
                        ]
                    }
