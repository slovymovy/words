                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cd1215c-8169-440d-af96-b0bb63331e16",
                        "source_entry_id": "40b0c83c-d5d7-3971-9874-71ef06f0c304",
                        "source_sense_id": "b19453f0-4d9b-3886-b39c-92ad3f39941d",
                        "target_lang_word": "лирик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лирик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0d942861-26bd-3571-86d0-8d6c814564d9",
                                        "entry_id": "21fc3df4-fe53-3fbc-9d2f-eafb095c5936",
                                        "glosses": [
                                            "автор лирических стихов, лирический поэт"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15536848-0316-4d63-ab57-de78d068a0dd",
                                                "sense_id": "0d942861-26bd-3571-86d0-8d6c814564d9",
                                                "text": "Лирик Державин, воспевавший величие России, был в то же время и сатириком, и его оды к «Фелице», его «Вельможа» принадлежат к лучшим и оригинальнейшим его произведениям."
                                            },
                                            {
                                                "example_id": "a2042c53-06e7-4248-9529-5aa432c96adb",
                                                "sense_id": "0d942861-26bd-3571-86d0-8d6c814564d9",
                                                "text": "А. А. Фет, которого исключительное дарование как лирика было по справедливости оценено в начале его литературного поприща, подвергся затем продолжительному гонению и глумлению по причинам, не имеющим никакого отношения к поэзии."
                                            },
                                            {
                                                "example_id": "fcc7c78c-2727-4d22-8188-e8f28f4c81b8",
                                                "sense_id": "0d942861-26bd-3571-86d0-8d6c814564d9",
                                                "text": "Несмотря на всю свою славу, Пушкин при жизни не был достаточно глубоко оценён даже наиболее проницательными из своих современников. Он был любим и ценим как прекрасный лирик, как непревзойдённый мастер стиха и слова — не более."
                                            },
                                            {
                                                "example_id": "ee1eef5a-41bd-4bea-83c2-eb64ba6f8b22",
                                                "sense_id": "0d942861-26bd-3571-86d0-8d6c814564d9",
                                                "text": "Гумилёв не только лирик, он и драматург, и эпик, и автор сильных новелл и статей о поэзии."
                                            },
                                            {
                                                "example_id": "ffa3a6f1-93d9-487d-928c-7ff96edd8591",
                                                "sense_id": "0d942861-26bd-3571-86d0-8d6c814564d9",
                                                "text": "Мандельштам был великим лириком — именно как поэт он известен и любим."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbfefd38-035e-3114-9dcd-ed3a4950697d",
                                        "entry_id": "21fc3df4-fe53-3fbc-9d2f-eafb095c5936",
                                        "glosses": [
                                            "разг. тот, у кого эмоциональные переживания преобладают над рассудочным началом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "937ce525-a200-4ea7-80e8-2ff3fdc1eb15",
                                                "sense_id": "cbfefd38-035e-3114-9dcd-ed3a4950697d",
                                                "text": "Он был пламенная, восторженная душа; его мысль и дух всегда парили; он всегда был лирик, всю жизнь был идеалист."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
