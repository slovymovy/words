                "senses": [
                    {
                        "sense_id": "379ef9f5-3794-3ebc-ba52-79c56ecdc7a3",
                        "entry_id": "8de01c26-80de-3f93-a85a-add8512f943b",
                        "glosses": [
                            "Imitation eines Diamanten aus bleihaltigem Glasfluss mit starker Lichtbrechung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d91fadb3-d5b0-4807-af3a-7523605397b7",
                                "sense_id": "379ef9f5-3794-3ebc-ba52-79c56ecdc7a3",
                                "text": "Das erschwinglichere Imitat namens \"Strass\" war erfunden und ziert heute die Trend-Uhren in jeder Preisklasse."
                            },
                            {
                                "example_id": "f6575e63-e08d-43c5-be2a-f3cca416edfb",
                                "sense_id": "379ef9f5-3794-3ebc-ba52-79c56ecdc7a3",
                                "text": "In der Bar des Bristol glitzert einfach alles: die Diamanten auf den Zifferblättern der Uhren, der Strass auf den spitzen Stiefelettenabsätzen der drei Paris-Hilton-Klone, die auf drei kleinen Fauteuils hocken."
                            },
                            {
                                "example_id": "051a126f-758b-421e-a076-47a3e4cc1e1d",
                                "sense_id": "379ef9f5-3794-3ebc-ba52-79c56ecdc7a3",
                                "text": "Nach einer unverfänglichen Antwort suchend, betrachte ich die Damenunterhosen mit dem Playboy-Bunny aus Strass, der da sitzt, wo ihn sich wohl jeder Mann wünschen würde."
                            },
                            {
                                "example_id": "816b5bd8-b867-4265-9c8b-8a260317f462",
                                "sense_id": "379ef9f5-3794-3ebc-ba52-79c56ecdc7a3",
                                "text": "„Sie befragte Agata, die nicht den Mut hatte zuzugeben, daß sie echt waren, und ihr sagte, sie seien aus Strass; ich hätte sie ihr geliehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
