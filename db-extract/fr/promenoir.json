        "fr-extract.jsonl": [
            {
                "entry_id": "06ff9aa0-aaf5-3390-abde-3590faf37b59",
                "word": "promenoir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8248c4e6-273f-4be0-8993-61bb1488451c",
                        "entry_id": "06ff9aa0-aaf5-3390-abde-3590faf37b59",
                        "tags": [
                            "plural"
                        ],
                        "form": "promenoirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e08ff2de-f8ab-377b-8de0-1b0b2818b5dc",
                        "entry_id": "06ff9aa0-aaf5-3390-abde-3590faf37b59",
                        "glosses": [
                            "Lieu destiné à la promenade dans un édifice clos, tel qu’un hôpital, une prison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ef898fe-2675-4bb7-8e65-f4f8b990698f",
                                "sense_id": "e08ff2de-f8ab-377b-8de0-1b0b2818b5dc",
                                "text": "L’une de ses fenêtres s’ouvrait sur l’Escaut et sur la terrasse-promenoir qui le borde, avec le grand café, au bout."
                            },
                            {
                                "example_id": "dc751cea-268e-4253-8925-368794725c8b",
                                "sense_id": "e08ff2de-f8ab-377b-8de0-1b0b2818b5dc",
                                "text": "Sous la terrasse régnait une galerie de même taille qui faisait promenoir et salle des pas perdus."
                            },
                            {
                                "example_id": "c39f05e6-f763-48dd-a4c9-915f9488db58",
                                "sense_id": "e08ff2de-f8ab-377b-8de0-1b0b2818b5dc",
                                "text": "Cette galerie sert de promenoir en temps de pluie."
                            },
                            {
                                "example_id": "4cfaa1ca-997b-4d2b-af83-20bd30854537",
                                "sense_id": "e08ff2de-f8ab-377b-8de0-1b0b2818b5dc",
                                "text": "La distribution avait lieu dans une ancienne chapelle abandonnée depuis longtemps, qui n’était ouverte et décorée qu’une fois par an pour ce jour-là. Cette chapelle était située au fond de la grande cour du collège ; on y arrivait en passant sous la double rangée de tilleuls dont la vaste verdure égayait un peu ce froid promenoir."
                            },
                            {
                                "example_id": "5ba11b0d-ca6d-44cd-96d9-584a4e777977",
                                "sense_id": "e08ff2de-f8ab-377b-8de0-1b0b2818b5dc",
                                "text": "Cet arrangement disgracieux n’eut pas de succès ; on n’en trouve aucune trace hors du promenoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "75019f54-67f9-3804-8521-c3b5e9e8aa84",
                        "entry_id": "06ff9aa0-aaf5-3390-abde-3590faf37b59",
                        "glosses": [
                            "Partie de certains théâtres où l’on se tient debout et où l’on peut changer de place."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8590a7d9-ca7f-4b4e-b7ef-71ffc3327214",
                                "sense_id": "75019f54-67f9-3804-8521-c3b5e9e8aa84",
                                "text": "Un billet de promenoir."
                            },
                            {
                                "example_id": "40b9071b-3e86-4644-a63b-de4cf65487a6",
                                "sense_id": "75019f54-67f9-3804-8521-c3b5e9e8aa84",
                                "text": "J’ai déjà parlé quelque part de ce lieu empli d’une grâce expirante et de parfums quelquefois chers où, dans les premiers temps, j’allais retrouver mes amies. Je crois bien qu’après un certain coin du promenoir des Folies-Bergère, c’est dans cet endroit un peu morose que j’ai le plus laissé mon cœur."
                            },
                            {
                                "example_id": "67022dcf-e059-4464-a1f0-a45677d8ce3f",
                                "sense_id": "75019f54-67f9-3804-8521-c3b5e9e8aa84",
                                "text": "Il dit couramment que tel promenoir de music-hall est « avantageux », que « l’Anglais chic ne donne pas cette saison », qu’« Un Tel, un garçon si bien, est tombé maintenant dans les truqueurs »."
                            },
                            {
                                "example_id": "56d929c0-bdfe-4f42-bf3e-412f689ee80f",
                                "sense_id": "75019f54-67f9-3804-8521-c3b5e9e8aa84",
                                "text": "En contre-bas des loges et des promenoirs, un immense parquet luisant et glissant attendait les danseuses qu’on pouvait choisir ensuite pour la nuit."
                            },
                            {
                                "example_id": "06c9747b-bf3b-4689-8ba6-b40d01c06aba",
                                "sense_id": "75019f54-67f9-3804-8521-c3b5e9e8aa84",
                                "text": "Toutes les places assises étaient occupées et nous restâmes debout au promenoir."
                            }
                        ]
                    }
                ],
