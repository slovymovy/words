                "senses": [
                    {
                        "sense_id": "06fae79c-63b7-39db-a585-ef0a70cd4911",
                        "entry_id": "e3f75aca-bbce-3ad9-9d86-9e1988127873",
                        "glosses": [
                            "halboffener Stand, in Form eines Zaunes, in dem Bienenkörbe geschützt stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38e425d9-2957-41a1-84fe-56cf3bc14b70",
                                "sense_id": "06fae79c-63b7-39db-a585-ef0a70cd4911",
                                "text": "„Unter dieser Adresse finden Sie tatsächlich einen Bienenzaun/Bienenstand aus den 50er Jahren.“"
                            },
                            {
                                "example_id": "aee96b3c-5f85-4b35-8aee-3816ab792832",
                                "sense_id": "06fae79c-63b7-39db-a585-ef0a70cd4911",
                                "text": "„Jeder Bauernhof besaß einen Bienenzaun.“"
                            },
                            {
                                "example_id": "2b1baa03-bb22-4565-802b-261f1229da33",
                                "sense_id": "06fae79c-63b7-39db-a585-ef0a70cd4911",
                                "text": "„Ein Bienenzaun ist ein überdachter, halboffener Stand, in dem Imker ihre Bienenvölker in Körben („Stülper“) oder Kästen aufstellen.“"
                            },
                            {
                                "example_id": "556b8b99-72a9-45af-9b43-a18040f80f46",
                                "sense_id": "06fae79c-63b7-39db-a585-ef0a70cd4911",
                                "text": "„Der Bienenzaun in der Krelinger Heide ist einer der letzten Zeugen der historischen Korbimkerei der Lüneburger Heide.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
