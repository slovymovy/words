        "fr-extract.jsonl": [
            {
                "entry_id": "2db58a9f-84cc-3b36-9bcb-7d9ffe16cfdb",
                "word": "vatnik",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b0867088-0038-4433-a4c4-625ca25d9a4e",
                        "entry_id": "2db58a9f-84cc-3b36-9bcb-7d9ffe16cfdb",
                        "tags": [
                            "plural"
                        ],
                        "form": "vatniks"
                    },
                    {
                        "form_id": "f49b2d84-d3e0-407c-808c-99fc6e35a4b5",
                        "entry_id": "2db58a9f-84cc-3b36-9bcb-7d9ffe16cfdb",
                        "tags": [
                            "plural"
                        ],
                        "form": "vatniki"
                    },
                    {
                        "form_id": "46f38349-e443-41dd-806c-787845b9ced0",
                        "entry_id": "2db58a9f-84cc-3b36-9bcb-7d9ffe16cfdb",
                        "tags": [],
                        "form": "vatnyk"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a58445ae-4776-3e0b-994b-8608121c5d35",
                        "entry_id": "2db58a9f-84cc-3b36-9bcb-7d9ffe16cfdb",
                        "glosses": [
                            "Doudoune russe permettant à son porteur de survivre à des températures glaciales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a35dc761-6d36-461d-8913-7c03535f526b",
                                "sense_id": "a58445ae-4776-3e0b-994b-8608121c5d35",
                                "text": "Chaude, coupe-vent et, surtout, pas chère. Tel était le vatnik classique - une veste rembourrée avec de la ouate. En Union soviétique, tout le pays le portait."
                            }
                        ]
                    },
                    {
                        "sense_id": "db176798-7eca-3bd0-bd49-7283b25ff68b",
                        "entry_id": "2db58a9f-84cc-3b36-9bcb-7d9ffe16cfdb",
                        "glosses": [
                            "Personne russe adepte de la propagande, avec une foi aveugle dans les stéréotypes et clichés, issue du peuple, peu éduquée et facilement manipulable."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "38eb59f0-bf28-43f6-aecd-86aee74b36cf",
                                "sense_id": "db176798-7eca-3bd0-bd49-7283b25ff68b",
                                "text": "Depuis les années 2010, « vatnik », sur les réseaux sociaux russophones, est un terme péjoratif désignant des Russes patriotes, qui se distinguent par l'ignorance de leur histoire."
                            },
                            {
                                "example_id": "d47f806f-1ced-4f73-b3c1-21b1bf5c8878",
                                "sense_id": "db176798-7eca-3bd0-bd49-7283b25ff68b",
                                "text": "L'autre publication est un dessin représentant un \"vatnik\", terme qui désigne à l'origine un vêtement porté lors de la période soviétique et qui est utilisé comme insulte envers des personnes considérées comme soutenant aveuglément les autorités."
                            },
                            {
                                "example_id": "0285ef0e-a127-4914-96de-8cd95d98a9aa",
                                "sense_id": "db176798-7eca-3bd0-bd49-7283b25ff68b",
                                "text": "De la part d'une vatnik qui avale tout ce que le Régime du Kremlin lui balance, je suis honoré ^^"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "280e721c-7063-4722-8f54-9ba0dbdc2ae7",
                        "source_entry_id": "2db58a9f-84cc-3b36-9bcb-7d9ffe16cfdb",
                        "source_sense_description": "doudoune",
                        "target_lang_word": "Watnik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "97902c89-aa70-4bcc-9026-7bc96db991d5",
                        "source_entry_id": "2db58a9f-84cc-3b36-9bcb-7d9ffe16cfdb",
                        "source_sense_description": "doudoune",
                        "target_lang_word": "vatnik",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vatnik",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c094be65-c313-355f-8979-a86f7cf875b6",
                                        "entry_id": "088ec2f2-4e45-3e6b-882b-3820165f741a",
                                        "glosses": [
                                            "A Russian style of quilted jacket."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ce550a-bfc7-4376-9c40-c6977a1cd2e1",
                                                "sense_id": "c094be65-c313-355f-8979-a86f7cf875b6",
                                                "text": "Two models each for men and women are featured at prices ranging from 100 to 140 rubles, more than the cost of a 'vatnik.' (The ruble is nominally valued at four to $1.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc0b11fc-2a0c-3e31-9fd5-0b9ecc39b27c",
                                        "entry_id": "088ec2f2-4e45-3e6b-882b-3820165f741a",
                                        "glosses": [
                                            "An unintelligent Russian patriot."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df8ec5e7-db91-406b-a4f9-ff17da7a12e1",
                                                "sense_id": "cc0b11fc-2a0c-3e31-9fd5-0b9ecc39b27c",
                                                "text": "Vatnik, originally a name of a warm cotton-padded Russian jacket that is still used sometimes in rural areas, has a broad meaning of all people with imperial Russian ideology."
                                            },
                                            {
                                                "example_id": "8c28b8a2-f52d-4294-9ac4-1c97d86f60d6",
                                                "sense_id": "cc0b11fc-2a0c-3e31-9fd5-0b9ecc39b27c",
                                                "text": "A vatnik basically refers to a Russian who is not too bright and who loves him some Putin."
                                            },
                                            {
                                                "example_id": "e2603b1d-1755-4a48-a211-2c9633f1b602",
                                                "sense_id": "cc0b11fc-2a0c-3e31-9fd5-0b9ecc39b27c",
                                                "text": "To mock the audience and depict the Russian man as a vatnik [uneducated hurray patriot] or a gopnik [in English: chav] seems totally inappropriate to me."
                                            },
                                            {
                                                "example_id": "affefd06-3c95-4a6d-89f9-427da06020b1",
                                                "sense_id": "cc0b11fc-2a0c-3e31-9fd5-0b9ecc39b27c",
                                                "text": "At first, vatniks were pro-Russian citizens, in the view of some, Sovietized lumpenproletariat, who supported the separation of Crimea and close ties with [Russia]."
                                            },
                                            {
                                                "example_id": "fd0771fd-6e47-44c4-acc7-4c5531b32ead",
                                                "sense_id": "cc0b11fc-2a0c-3e31-9fd5-0b9ecc39b27c",
                                                "text": "[…] many pro-Maidan FB-users whose posts I analysed saw themselves as nothing less than the standard-bearers of civilization: 'The work on vatniks requires huge eﬀorts, but this is what distinguishes civilization from barbarism' (FB-user 15, Kyiv)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b29daf1-6df8-3f51-89f7-48ef006ad2ba",
                                        "entry_id": "088ec2f2-4e45-3e6b-882b-3820165f741a",
                                        "glosses": [
                                            "A supporter of Vladimir Putin, Russian nationalism, or the Russian invasion of Ukraine in 2022; a Putinist."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly",
                                            "derogatory",
                                            "neologism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10f20dc8-73cb-3306-9eea-238d13e53f45",
                                        "entry_id": "088ec2f2-4e45-3e6b-882b-3820165f741a",
                                        "glosses": [
                                            "A soldier in the Russian armed forces involved in the invasion of Ukraine."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly",
                                            "derogatory",
                                            "neologism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
