                "senses": [
                    {
                        "sense_id": "e7620875-c54f-3bfd-9f76-280cfabb414c",
                        "entry_id": "76b24a74-97b1-3d3b-b109-3bef904a9353",
                        "glosses": [
                            "Fahrzeug zum Transport von Gefangenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb93bd17-84a3-47b1-b74c-f15391232703",
                                "sense_id": "e7620875-c54f-3bfd-9f76-280cfabb414c",
                                "text": "„Sodann stiegen dreizehn Männer in Handschellen in den Gefangenentransporter, mit dem man sie zu ihren Zellen zurückbrachte.“"
                            },
                            {
                                "example_id": "61c158c4-5343-4bc4-a5b4-700c7ebda40e",
                                "sense_id": "e7620875-c54f-3bfd-9f76-280cfabb414c",
                                "text": "„Als man Perkins in einem Gefangenentransporter in das andere Gefängnis brachte, war er zunächst nervös, weil er glaubte, dass die CIA in irgendeiner Form seine Auslieferung erreicht habe.“"
                            },
                            {
                                "example_id": "b3f04018-ae82-4016-abf1-d1df816eb291",
                                "sense_id": "e7620875-c54f-3bfd-9f76-280cfabb414c",
                                "text": "„In Nordfrankreich haben offenbar schwer bewaffnete Männer einen Gefangenentransporter überfallen, um einen Häftling zu befreien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
