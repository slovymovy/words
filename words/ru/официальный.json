{
    "word_family": [
        "официально",
        "официальность"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dd5a0b88-8e79-3b10-adfe-ce46d7f3d503",
                    "sense_definition": "Исходящий от государственных органов или должностных лиц; утверждённый правительством или администрацией.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы получили <w>официальный</w> ответ из министерства через неделю.",
                            "target_lang_translations": {
                                "en": "We received an <w>official</w> response from the ministry a week later.",
                                "zh": "一周后，我们收到了来自该部门的<w>官方</w>回复。"
                            }
                        },
                        {
                            "text": "Русский язык является <w>официальным</w> языком в этой стране.",
                            "target_lang_translations": {
                                "en": "Russian is the <w>official</w> language in this country.",
                                "zh": "俄语是这个国家的<w>官方</w>语言。"
                            }
                        }
                    ],
                    "antonyms": [
                        "неофициальный"
                    ],
                    "common_phrases": [
                        "официальный сайт",
                        "официальный визит",
                        "официальный документ",
                        "официальное заявление"
                    ],
                    "target_lang_definitions": {
                        "en": "Coming from government bodies or officials; approved by the government or administration.",
                        "zh": "由政府机构或官员发布；经政府或行政部门批准的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "official",
                                "target_lang_sense_clarification": "authorized or issued by authority"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "官方",
                                "target_lang_sense_clarification": "指属于政府或权威机构的"
                            },
                            {
                                "target_lang_word": "正式",
                                "target_lang_sense_clarification": "指经过批准或符合规定的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5fadfef-1fe0-3593-b6eb-cb836ccfebf2",
                    "sense_definition": "Свойственный деловому общению; строгий, сдержанный, соблюдающий правила этикета.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его голос стал холодным и слишком <w>официальным</w>.",
                            "target_lang_translations": {
                                "en": "His voice became cold and too <w>formal</w>.",
                                "zh": "他的声音变得冷淡且过于<w>正式</w>了。"
                            }
                        },
                        {
                            "text": "Для встречи с директором он выбрал строгий <w>официальный</w> костюм.",
                            "target_lang_translations": {
                                "en": "He chose a strict <w>formal</w> suit for the meeting with the director.",
                                "zh": "为了与经理会面，他选择了一套严谨的<w>正式</w>西装。"
                            }
                        }
                    ],
                    "synonyms": [
                        "строгий",
                        "формальный"
                    ],
                    "antonyms": [
                        "неофициальный"
                    ],
                    "common_phrases": [
                        "официальный тон",
                        "официальный стиль",
                        "официальный вид",
                        "официальная обстановка"
                    ],
                    "target_lang_definitions": {
                        "en": "Characteristic of business communication; strict, restrained, observing rules of etiquette.",
                        "zh": "具有商务沟通特征的；严格、克制、遵守礼仪规范的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "formal",
                                "target_lang_sense_clarification": "following accepted rules, customs, or dress codes"
                            },
                            {
                                "target_lang_word": "official",
                                "target_lang_sense_clarification": "stiff, ceremonious, or distant in manner"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正式",
                                "target_lang_sense_clarification": "指符合礼仪或规范的"
                            },
                            {
                                "target_lang_word": "严肃",
                                "target_lang_sense_clarification": "指态度严谨、不苟言笑的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}