                "senses": [
                    {
                        "sense_id": "89a8204b-2ab1-3fc3-9576-74c16f4d1145",
                        "entry_id": "30f62087-9c3c-3a67-a8a0-8fb893c8a115",
                        "glosses": [
                            "Zuschauer beim Kartenspiel, der dann für einen der aktiven Spieler eintritt, wenn dieser eine kurze Pause braucht"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "2b12d632-1254-4aa2-afd9-3a3a7c0e6b67",
                                "sense_id": "89a8204b-2ab1-3fc3-9576-74c16f4d1145",
                                "text": "Er kann nicht mehr mitspielen, da wir schon genügend sind. Aber er darf den Brunzkartler machen."
                            },
                            {
                                "example_id": "4fb5dcc5-a0d3-4fc5-99e4-8603454c87f8",
                                "sense_id": "89a8204b-2ab1-3fc3-9576-74c16f4d1145",
                                "text": "„»Es ist nämlich so, Frau Frischkes, der Brunzkartler ist beim Kartlern sozusagen der Ersatzmann. Wenn also ein Spieler einmal zum Brunz… wenn einer mal austreten, also zu Toilette muss, dann springt der Brunzkartler für ihn ein.«“"
                            },
                            {
                                "example_id": "98e33de2-1e91-4cc7-b34e-945368561d8c",
                                "sense_id": "89a8204b-2ab1-3fc3-9576-74c16f4d1145",
                                "text": "„Als er vom Klosett zurückkam, schaute er als fünfter Mann zwei Runden zu, da ein Nachbar als Brunzkartler für ihn eingesprungen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
