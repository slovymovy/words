        "fr-extract.jsonl": [
            {
                "entry_id": "19fe3137-7f27-3103-8678-a0644ed6c540",
                "word": "songerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "03d883e4-412c-49bb-8427-9bf2eda2a510",
                        "entry_id": "19fe3137-7f27-3103-8678-a0644ed6c540",
                        "tags": [
                            "plural"
                        ],
                        "form": "songeries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "634f346c-eaf8-309d-80f8-8e6351267125",
                        "entry_id": "19fe3137-7f27-3103-8678-a0644ed6c540",
                        "glosses": [
                            "ou Rêverie, état de l’esprit qui se plaît à songer, à rêver ; qui laisse ses idées vagabonder."
                        ],
                        "tags": [
                            "dated",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "7bdea9d8-615e-4b47-a0de-b2c3234a8255",
                                "sense_id": "634f346c-eaf8-309d-80f8-8e6351267125",
                                "text": "Le capitaine semblait préoccupé, et il me parut que le nuage d’indifférence et de noire songerie qui le défendait depuis quelques semaines contre une approche trop intime s’était encore assombri."
                            },
                            {
                                "example_id": "50f695c4-92f8-4c2e-b375-7d12d348400f",
                                "sense_id": "634f346c-eaf8-309d-80f8-8e6351267125",
                                "text": "J’étais touché au possible de ce que de jeunes doigts eussent brodé de la sorte sur le canevas d’un bonhomme et figuré d’une façon si brillante les songeries d’un vieux radoteur."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1f5b91f-c690-3bd1-9dcb-9faa402452c0",
                        "entry_id": "19fe3137-7f27-3103-8678-a0644ed6c540",
                        "glosses": [
                            "ou Suite de pensées vagues développées ainsi."
                        ],
                        "tags": [
                            "dated",
                            "literary",
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "f1b8371a-3cde-4896-a4b8-75a259c12af9",
                                "sense_id": "b1f5b91f-c690-3bd1-9dcb-9faa402452c0",
                                "text": "Qu’est-ce que cette songerie ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2e34d38-ce5f-4ed0-b6c4-5c06efa53fbc",
                        "source_entry_id": "19fe3137-7f27-3103-8678-a0644ed6c540",
                        "target_lang_word": "daydream",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daydream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9aeb6f21-94c1-3cfc-b603-da9303e68c39",
                                        "entry_id": "340c4089-31db-384b-96d8-47dbb8f40e69",
                                        "glosses": [
                                            "A spontaneous series of thoughts while awake not connected to immediate reality."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "daydream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f95afdcd-19f8-3222-982c-ec2248e3b33b",
                                        "entry_id": "e002b1c9-569b-322a-842d-dc8c60d13e27",
                                        "glosses": [
                                            "To have such a series of thoughts; to woolgather."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4c1aa1e-9073-4090-8919-b3f3e3d703d4",
                                                "sense_id": "f95afdcd-19f8-3222-982c-ec2248e3b33b",
                                                "text": "Stop daydreaming and get back to work!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2139704-7a21-439d-b145-6282ba103232",
                        "source_entry_id": "19fe3137-7f27-3103-8678-a0644ed6c540",
                        "target_lang_word": "reverie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reverie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2aa0dfcd-e3eb-33e3-acfb-2ae75a1ff911",
                                        "entry_id": "3cf48351-ab83-3c1f-9b8d-5a81aee24c6c",
                                        "glosses": [
                                            "A state of dreaming while awake; a loose or irregular train of thought; musing or meditation; daydream."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6592362-c5d3-42fa-a1c0-a5257fe389a5",
                                                "sense_id": "2aa0dfcd-e3eb-33e3-acfb-2ae75a1ff911",
                                                "text": "If you rouse from your reverie, you are restless and agitated; your eye wanders round in one perpetual search; and if, perchance, as has happened once or twice, he has only passed in the distance, your eye brightens, your cheek flushes crimson, and your whole frame quivers with uncontrollable emotion!"
                                            },
                                            {
                                                "example_id": "1c157dce-165e-4715-869d-33a3368ee1b9",
                                                "sense_id": "2aa0dfcd-e3eb-33e3-acfb-2ae75a1ff911",
                                                "text": "we sat / But spoke not, rapt in nameless reverie, […]"
                                            },
                                            {
                                                "example_id": "464d3e05-8f90-45a2-b831-abe93c3b50a9",
                                                "sense_id": "2aa0dfcd-e3eb-33e3-acfb-2ae75a1ff911",
                                                "text": "Within the branching shade of Reverie / Dreams even may spring till autumn; yet none be / ⁠Like woman's budding day-dream spirit-fann'd."
                                            },
                                            {
                                                "example_id": "e0c11366-4147-48b2-8e4a-b44b372484d8",
                                                "sense_id": "2aa0dfcd-e3eb-33e3-acfb-2ae75a1ff911",
                                                "text": "He fell into a reverie, a most dangerous state of mind for a chauffeur, since a fall into reverie on the part of a driver may mean a fall into a ravine on the part of the machine."
                                            },
                                            {
                                                "example_id": "0b471d23-8329-4db2-972c-85ab0a2d68fe",
                                                "sense_id": "2aa0dfcd-e3eb-33e3-acfb-2ae75a1ff911",
                                                "text": "Even the blithely unselfconscious Homer is more than a little freaked out by West’s private reverie, and encourages his spawn to move slowly away without making eye contact with the crazy man."
                                            },
                                            {
                                                "example_id": "15fcf566-1c2d-4cb5-b460-7dcc779442b3",
                                                "sense_id": "2aa0dfcd-e3eb-33e3-acfb-2ae75a1ff911",
                                                "text": "We were bound for eternity / Now I am lost inside this everlasting reverie / And I'm losing my mind"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24acb0e0-0367-31d6-af7e-d820c0b1f228",
                                        "entry_id": "3cf48351-ab83-3c1f-9b8d-5a81aee24c6c",
                                        "glosses": [
                                            "An extravagant conceit of the imagination; a vision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b03d2bd-3faf-4cad-ac2b-7e633a328d94",
                                                "sense_id": "24acb0e0-0367-31d6-af7e-d820c0b1f228",
                                                "text": "If the minds of men were laid open, we should see but little difference between that of the wise man and that of the fool; There are infinite reveries , numberless extravagancies , and a perpetual train of vanities , which pass through both ."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reverie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36d3021c-775a-3dfa-bc0f-9f4f8b87227c",
                                        "entry_id": "6b010234-9031-3da9-b3b5-d55394ca2d42",
                                        "glosses": [
                                            "To daydream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c53d6ba-68f6-4e45-bf3e-7a3fc115a46e",
                                                "sense_id": "36d3021c-775a-3dfa-bc0f-9f4f8b87227c",
                                                "text": "By this time the mouth begins to feel uneasy—I pick another cheroot from Cotton’s last box, and walk up and down reverie-ing as before."
                                            },
                                            {
                                                "example_id": "b50b2241-57c4-42a7-8dcf-8728d9b376ec",
                                                "sense_id": "36d3021c-775a-3dfa-bc0f-9f4f8b87227c",
                                                "text": "So now the dream of all my life is realized, and I have seen snow mountains! When I was quite a little child of eight years old I used to reverie about them, and when I heard the name of the snow-covered Sierra de la Summa Paz (perfect peace) the idea was completed; and I thenceforth always thought of eternal snow and perfect peace together, and longed to see the one and drink in the other."
                                            },
                                            {
                                                "example_id": "47d925c3-0d09-4194-811a-99db579cfd92",
                                                "sense_id": "36d3021c-775a-3dfa-bc0f-9f4f8b87227c",
                                                "text": "During my twelfth and thirteenth years I often reveried in school, or less often at night, with penis quite erect—imagining perhaps myself in company with several of the girls that most attracted me on a Pacific Island, and I would feel and see myself again and again in sexual intercourse."
                                            },
                                            {
                                                "example_id": "d38ffa52-849c-45ca-b84c-f19ec33f14c0",
                                                "sense_id": "36d3021c-775a-3dfa-bc0f-9f4f8b87227c",
                                                "text": "In her old days she’ll either be Madame Representativewoman from the same said X-town, or a cheerful old philanderer, pardon me, I mean philanthropist, living in seclusion and reverying in the shades of the past."
                                            },
                                            {
                                                "example_id": "8441d1a7-353b-4797-8f94-55f904252af0",
                                                "sense_id": "36d3021c-775a-3dfa-bc0f-9f4f8b87227c",
                                                "text": "He reveried on."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reverie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4ff80e1-ccfb-37e9-91c1-e7dfddad2f80",
