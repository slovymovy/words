                                                "sense_id": "e553d737-4725-3036-9a7a-459d7344e43f",
                                                "text": "Doe eerst die smerige broek eens in de was!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f2a1c5a-c20a-30ba-a79c-ada8c84efea7",
                                        "entry_id": "d4bf179a-0eb7-386f-a0bb-b6b6087aa7fe",
                                        "glosses": [
                                            "zeer slecht van smaak"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15a3699b-3fd8-35f8-9af7-4c6099150ace",
                                        "entry_id": "d4bf179a-0eb7-386f-a0bb-b6b6087aa7fe",
                                        "glosses": [
                                            "schunnig, gemeen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f47a0a88-bf94-4961-b084-cba191782195",
                                                "sense_id": "15a3699b-3fd8-35f8-9af7-4c6099150ace",
                                                "text": "wat een smerige streek is dat!"
                                            },
                                            {
                                                "example_id": "4f69e29b-c937-405e-b77f-c297f08e753a",
                                                "sense_id": "15a3699b-3fd8-35f8-9af7-4c6099150ace",
                                                "text": "Rondom Albert hield iedereen even de adem in. Toen barstte het geschreeuw los. De smeerlappen. Die moffen zijn nog geen steek veranderd, wat een smerig tuig! Barbaren, enz. En dan ook nog een jonge en een oude man!"
                                            },
                                            {
                                                "example_id": "bbda54e1-5718-4c19-9dd0-6b25cd3ef825",
                                                "sense_id": "15a3699b-3fd8-35f8-9af7-4c6099150ace",
                                                "text": "Het was tenslotte erg smerig om menselijke uitwerpselen te zien liggen met wapperend WC papier erop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
