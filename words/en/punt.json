                {
                    "sense_id": "e5ffc99f-7472-395f-830f-2a6aba85ae93",
                    "sense_definition": "the indentation or hollow at the bottom of a wine bottle",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bottles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A deep <w>punt</w> in a wine bottle is often associated with higher quality sparkling wines.",
                            "target_lang_translations": {
                                "ru": "Глубокий <w>пунт</w> в винной бутылке часто ассоциируется с более качественными игристыми винами."
                            }
