            "senses": [
                {
                    "sense_id": "557c9b56-0c2b-30f8-a18c-6dc3d3784d27",
                    "sense_definition": "Événement catastrophique causant des dégâts matériels importants, tel qu'un incendie ou une inondation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "catastrophe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers sont intervenus très rapidement sur les lieux du <w>sinistre</w> pour éteindre le feu."
                        },
                        {
                            "text": "Après la tempête, les habitants ont constaté l'ampleur du <w>sinistre</w> dans leur quartier."
                        }
                    ],
                    "common_phrases": [
                        "lieu du sinistre",
                        "victime d'un sinistre"
                    ]
                },
                {
                    "sense_id": "c96438dd-5c7a-3f92-9832-233f5e974dd3",
                    "sense_definition": "Dommage ou perte de biens ouvrant droit à une indemnisation par un contrat d'assurance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'automobiliste a rapidement envoyé sa déclaration de <w>sinistre</w> à sa compagnie d'assurances."
                        },
                        {
                            "text": "Un expert doit d'abord évaluer le montant du <w>sinistre</w> avant tout versement des indemnités."
