                    },
                    {
                        "sense_id": "163d1879-b488-373a-a4f0-b1ae0bf054d3",
                        "entry_id": "39540738-7486-3db7-bb1c-893adf287ae2",
                        "glosses": [
                            "A line used to define a curve or surface; especially a line, the distance from which a point on a conic has a constant ratio to that from the focus."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd13dc57-b5ca-4450-b1b6-b483cf294086",
                        "source_entry_id": "39540738-7486-3db7-bb1c-893adf287ae2",
                        "source_sense_description": "a line used to define a curve or surface",
                        "target_lang_word": "richtlijn",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "richtlijn",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7e4a27d9-01cf-385c-ac1e-6ea1dfcc8cbe",
                                        "entry_id": "fc6016db-5e87-3840-b477-1dfb22c5c7a1",
                                        "glosses": [
                                            "aanwijzing voor een te volgen gedrag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63441b29-067b-403b-b36d-02f1057fd54e",
                                                "sense_id": "7e4a27d9-01cf-385c-ac1e-6ea1dfcc8cbe",
                                                "text": "Lange stilte. „Huisartsen zijn goed bekend met de richtlijn en schrijven zuiniger voor dan vroeger. Maar artsen zitten met een ongemakkelijk gevoel: wat moet ik doen in de spreekkamer met de wanhopige man of vrouw die niet slaapt?"
                                            },
                                            {
                                                "example_id": "f8ab7587-5777-4200-b106-fd30dd80bfc4",
                                                "sense_id": "7e4a27d9-01cf-385c-ac1e-6ea1dfcc8cbe",
                                                "text": "‘Dit virus en de maatregelen die wereldwijd worden genomen hebben wel enorme gevolgen voor de economie. Dat is dan zo, en daar zal de overheid zich ook op richten, maar nu gaat het om veiligheid. We moeten ons allemaal zo veel mogelijk aan de richtlijnen houden.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acb6a93e-9023-360e-a9df-96cc90508c59",
                                        "entry_id": "fc6016db-5e87-3840-b477-1dfb22c5c7a1",
                                        "glosses": [
                                            "bindend voorschrift"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9695b2b-fca2-3a04-a974-6a70a891a85f",
                                        "entry_id": "fc6016db-5e87-3840-b477-1dfb22c5c7a1",
                                        "glosses": [
                                            "lijn waarlangs grondwerk gegraven of metselwerk opgetrokken wordt"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "887a0fa9-d0d6-3c80-b4bb-820fb09ec55e",
                                        "entry_id": "fc6016db-5e87-3840-b477-1dfb22c5c7a1",
                                        "glosses": [
                                            "denkbeeldige lijn waarover een vuurwapen gericht wordt"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c6a51fd-d341-4f87-87e9-b505b3ff513a",
                        "source_entry_id": "39540738-7486-3db7-bb1c-893adf287ae2",
                        "source_sense_description": "a line used to define a curve or surface",
                        "target_lang_word": "directrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "directrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e831bd15-408d-3a7e-a1df-0634b44e7e6f",
                                        "entry_id": "687860b7-171a-3b9e-a21d-1dfe3510ba00",
                                        "glosses": [
                                            "Celle qui dirige un établissement, un service, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0ad31aa-a3b4-4acc-b71b-8c75c69a2035",
                                                "sense_id": "e831bd15-408d-3a7e-a1df-0634b44e7e6f",
                                                "text": "Après trois semaines de retraite forcée, rendue moins ennuyeuse par la présence presque continue du docteur, Lucien fit sa première sortie, et ce fut pour aller chez la directrice de la poste, la bonne mademoiselle Prichard, dévote célèbre."
                                            },
                                            {
                                                "example_id": "d6bd3faa-f9b0-496f-8c66-ef8058da0c29",
                                                "sense_id": "e831bd15-408d-3a7e-a1df-0634b44e7e6f",
                                                "text": "Elle se souvient que la directrice de l’école de sages-femmes de la clinique bruxelloise la regarda avec surprise lorsque l’élève accoucheuse Régine lui déclara ne pas être catholique, mais Juive."
                                            },
                                            {
                                                "example_id": "b9b00157-7e27-4620-bd9f-37a2ab40e5ac",
                                                "sense_id": "e831bd15-408d-3a7e-a1df-0634b44e7e6f",
                                                "text": "La directrice suscite l’admiration de toutes par sa manière sûre et encourageante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17023f3b-8181-3b9e-a23a-318242a79028",
                                        "entry_id": "687860b7-171a-3b9e-a21d-1dfe3510ba00",
                                        "glosses": [
                                            "Celle qui préside une séance."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "directrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16d450ae-cb5e-396d-bb40-6af6367bba24",
                                        "entry_id": "b2311390-cf4a-3a19-8259-3103c1a22717",
                                        "glosses": [
                                            "Ligne sur laquelle vient s’appuyer une autre ligne en engendrant une surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ea1652-ac85-45ea-bfc1-8b13e27ca985",
                                                "sense_id": "16d450ae-cb5e-396d-bb40-6af6367bba24",
                                                "text": "L’axe de symétrie orthogonale d'une parabole est la perpendiculaire à la directrice passant par le foyer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d85ce5a2-1c25-3935-9b8d-cef479e7ebf6",
                                        "entry_id": "b2311390-cf4a-3a19-8259-3103c1a22717",
                                        "glosses": [
                                            "Ligne de tir d’un canon tirant par l’embrasure d’une fortification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b8f0d1-dc3f-46c1-8ac5-dac9fd11a027",
                                                "sense_id": "d85ce5a2-1c25-3935-9b8d-cef479e7ebf6",
                                                "text": "La directrice d’une embrasure est la ligne de tir qui va du point intérieur correspondant à l’axe de la pièce au point extérieur que la pièce doit battre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3ed8a88-ef9c-3eb0-a398-f61e25ac4713",
                                        "entry_id": "b2311390-cf4a-3a19-8259-3103c1a22717",
                                        "glosses": [
                                            "Élément servant à diriger un fluide moteur vers la partie mobile d’une turbine, permettant de récupérer l’énergie de ce fluide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71012dd5-8a33-481b-bc44-94304b1b73e4",
                                                "sense_id": "c3ed8a88-ef9c-3eb0-a398-f61e25ac4713",
                                                "text": "La vitesse d’une turbine doit être calculée en rapport avec la vitesse de l’eau, de manière qu’il n’y ait pas de choc au moment où l’eau passe de la directrice dans la turbine, ce rapport étant du reste différent pour chaque turbine et dépendant de la forme des aubes de la directrice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "directrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70c3e135-01d2-35b9-9a63-d69f74a03b6b",
                                        "entry_id": "2b90edfd-2042-3313-a2e2-cf3664687540",
                                        "glosses": [
                                            "Féminin singulier de directeur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "670eedc3-5c59-4c0d-9f44-e0ead61c4ded",
                                                "sense_id": "70c3e135-01d2-35b9-9a63-d69f74a03b6b",
                                                "text": "Penser contre la sophistique c’est prendre, au moins comme idée directrice, le pari d’un travail inverse sur le savoir : travail de sabotage visant à le rendre malpropre à la consommation et inutile à la domination : travail pour décalibrer la marchandise, arracher les pancartes, déflécher les voies ; restituer aux carrefours forestiers l’angoisse de n’avoir pour savoir où aller à compter que sur soi et sur ces arbres que la mousse se fait un malin plaisir d’entourer de tous côtés ; rendre aux savoirs leurs singularités, aux rebelles leurs raisons, aux enfants amoureux leurs cartes et leurs estampes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
