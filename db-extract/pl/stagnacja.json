                                    {
                                        "sense_id": "a81ac596-ea4a-3c55-bb12-850af7f15f5f",
                                        "entry_id": "3d3c79f7-5afc-36da-8799-0c034ee3d6a9",
                                        "glosses": [
                                            "Inactivity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f688de5-b208-44ea-9f8f-12bca974ddb1",
                                                "sense_id": "a81ac596-ea4a-3c55-bb12-850af7f15f5f",
                                                "text": "The general concern about industrial stagnation inspired an overhaul of the patent system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3a4afe4-9b7d-3686-bd9e-234594e8f173",
                                        "entry_id": "3d3c79f7-5afc-36da-8799-0c034ee3d6a9",
                                        "glosses": [
                                            "The state of being stagnant, without circulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1a01336-c2ce-453e-bd52-5b7a24781ded",
                                                "sense_id": "b3a4afe4-9b7d-3686-bd9e-234594e8f173",
                                                "text": "Factors known to encourage the growth of harmful bacteria inside cooling systems include the stagnation of the water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
