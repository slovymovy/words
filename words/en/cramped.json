{
    "word_family": [
        "cramp"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5f11d8fb-df59-3b58-bd67-88b587aa85eb",
                    "sense_definition": "Uncomfortably restricted in size or space.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We felt very <w>cramped</w> in the tiny apartment.",
                            "target_lang_translations": {
                                "ru": "Мы чувствовали себя очень <w>стеснённо</w> в этой крошечной квартире."
                            }
                        },
                        {
                            "text": "The office was too <w>cramped</w> for all the new equipment.",
                            "target_lang_translations": {
                                "ru": "Офис был слишком <w>тесным</w> для всего нового оборудования."
                            }
                        }
                    ],
                    "synonyms": [
                        "confined",
                        "small",
                        "tight"
                    ],
                    "antonyms": [
                        "spacious",
                        "roomy"
                    ],
                    "common_phrases": [
                        "cramped space",
                        "cramped conditions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Некомфортно ограниченный в размере или пространстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тесный",
                                "target_lang_sense_clarification": "о пространстве, в котором мало места"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d73e48d7-048d-32cd-9baf-fd14db4a54c6",
                    "sense_definition": "Overcrowded or congested.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train was <w>cramped</w> during the busy morning commute.",
                            "target_lang_translations": {
                                "ru": "В утренний час пик поезд был <w>переполнен</w>."
                            }
                        },
                        {
                            "text": "They lived in <w>cramped</w> quarters with many other people.",
                            "target_lang_translations": {
                                "ru": "Они жили в <w>тесных</w> условиях вместе со многими другими людьми."
                            }
                        }
                    ],
                    "synonyms": [
                        "overcrowded",
                        "congested"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переполненный или забитый людьми или вещами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стеснённый",
                                "target_lang_sense_clarification": "о пространстве, плотно заполненном чем-либо"
                            },
                            {
                                "target_lang_word": "переполненный",
                                "target_lang_sense_clarification": "о месте, где слишком много людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a74f0fc-0ee5-3e73-9da7-0fdd2b4d792c",
                    "sense_definition": "Tight because of or like suffering a muscle spasm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His leg felt <w>cramped</w> after the long race.",
                            "target_lang_translations": {
                                "ru": "После долгого забега его ногу <w>свело судорогой</w>."
                            }
                        },
                        {
                            "text": "She rubbed her <w>cramped</w> hand after writing for hours.",
                            "target_lang_translations": {
                                "ru": "Она разминала <w>затекшую</w> руку после многочасового письма."
                            }
                        }
                    ],
                    "synonyms": [
                        "stiff",
                        "tight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напряженный или сведенный судорогой (о мышцах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сведённый судорогой",
                                "target_lang_sense_clarification": "о мышцах, испытывающих спазм"
                            },
                            {
                                "target_lang_word": "затекший",
                                "target_lang_sense_clarification": "о конечности, ставшей жесткой от долгого неподвижного положения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e274a29-30b2-3a87-9790-3ef897be8a2f",
                    "sense_definition": "Difficult to read due to small or messy handwriting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor left a note in <w>cramped</w> handwriting.",
                            "target_lang_translations": {
                                "ru": "Врач оставил записку <w>мелким неразборчивым</w> почерком."
                            }
                        },
                        {
                            "text": "I could barely understand the <w>cramped</w> scribbles on the page.",
                            "target_lang_translations": {
                                "ru": "Я едва мог разобрать <w>корявые</w> каракули на странице."
                            }
                        }
                    ],
                    "synonyms": [
                        "illegible"
                    ],
                    "antonyms": [
                        "legible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудночитаемый из-за мелкого или неразборчивого почерка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелкий и неразборчивый",
                                "target_lang_sense_clarification": "о почерке, который трудно прочитать"
                            },
                            {
                                "target_lang_word": "корявый",
                                "target_lang_sense_clarification": "о некрасивом, неровном почерке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "550960c7-2c58-3dec-b335-0204d50ec755",
                    "sense_definition": "Past tense and past participle of <w>cramp</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy boxes <w>cramped</w> his style during the move.",
                            "target_lang_translations": {
                                "ru": "Тяжелые коробки <w>стесняли</w> его движения во время переезда."
                            }
                        },
                        {
                            "text": "Lack of funding <w>cramped</w> the project's progress.",
                            "target_lang_translations": {
                                "ru": "Нехватка финансирования <w>ограничивала</w> прогресс проекта."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время от глагола «cramp» (мешать, ограничивать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничивал",
                                "target_lang_sense_clarification": "мешал развитию или свободе действий"
                            },
                            {
                                "target_lang_word": "стеснял",
                                "target_lang_sense_clarification": "создавал препятствия или неудобства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}