                                "target_senses": [
                                    {
                                        "sense_id": "6896dd48-98d5-3ade-aea1-96786f07f39e",
                                        "entry_id": "67a36f36-1aad-379f-b5cd-2c7ac6ba7ca6",
                                        "glosses": [
                                            "das einzige geschlechtsreife weibliche Tier in einer Kolonie von Honigbienen"
                                        ],
                                        "tags": [
                                            "Imkerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "526d44a7-dd1a-4816-b80f-d0f12b5c91e2",
                                                "sense_id": "6896dd48-98d5-3ade-aea1-96786f07f39e",
                                                "text": "„Bienenköniginnen entstehen entweder, weil sich das Bienenvolk über das Schwärmen vermehren (teilen) will, oder weil die bisherige Königin durch Tod oder aus Altersgründen ersetzt werden soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "600b1b8b-daed-46e9-986d-465bfe81adf9",
                        "source_entry_id": "646266e4-49ef-308c-b475-1b8ee07bef54",
                        "source_sense_id": "38395cf6-6826-3e31-aaa2-9017d2fe869d",
                        "source_sense_description": "moeder van alle bijen in een bijenkorf",
                        "target_lang_word": "queen bee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "queen bee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a37e978a-f745-33fb-9a32-3706158d367f",
                                        "entry_id": "532aab6f-188e-32c0-97f4-eb2d39cc826b",
                                        "glosses": [
                                            "A reproductive female (especially the only one) in a colony of bees."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e427e80-e002-4cb7-ae9c-930b42a6b349",
                                                "sense_id": "a37e978a-f745-33fb-9a32-3706158d367f",
                                                "text": "It is generally believed that the queen bee mates only once in her lifetime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "655e1621-56a7-3be1-ac5c-45c2c910438b",
                                        "entry_id": "532aab6f-188e-32c0-97f4-eb2d39cc826b",
                                        "glosses": [
                                            "The most important or dominant woman in an organization or situation."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d2a7070-9464-45bf-a9cc-3e84034d909c",
                                                "sense_id": "655e1621-56a7-3be1-ac5c-45c2c910438b",
                                                "text": "She wrote very generously to aspiring women writers, gave them good advice, took time to read their manuscripts and comments, and warmly applauded their successes. There is not a hint of the Queen Bee in the attitude toward other women writers."
                                            },
                                            {
                                                "example_id": "236253a8-683f-4385-9773-7b330a9b4c94",
                                                "sense_id": "655e1621-56a7-3be1-ac5c-45c2c910438b",
                                                "text": "She muttered to her mother, “There's that obnoxious redhead who thought she was the Queen Bee last year when she was a senior!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9db22480-1f19-3ec3-a9af-a46d5f9cca26",
                                        "entry_id": "532aab6f-188e-32c0-97f4-eb2d39cc826b",
                                        "glosses": [
                                            "A stem cell."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
