                "senses": [
                    {
                        "sense_id": "442348d7-4ab1-36a6-84ff-13717588e423",
                        "entry_id": "854f5c7a-fb83-3ae6-aeed-2112a21c154a",
                        "glosses": [
                            "A woman of doubtful reputation or suspected character; an adventuress."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3c62f7f3-9160-482a-92d5-980e3ace4b5d",
                                "sense_id": "442348d7-4ab1-36a6-84ff-13717588e423",
                                "text": "he had no knowledge of that character which is vulgarly called a demirep; that is to say, a woman who intrigues with every man she likes, under the name and appearance of virtue [...] in short, whom everybody knows to be what nobody calls her."
                            },
                            {
                                "example_id": "130155b3-43c9-41cb-b5ca-30c896417b43",
                                "sense_id": "442348d7-4ab1-36a6-84ff-13717588e423",
                                "text": "Madam by this Time Lady Brittle is the Talk of half the Town—and I doubt not in a week the Men will toast her as a Demirep."
                            },
                            {
                                "example_id": "a6729d2d-c49f-4410-bf6f-24c4d3aab2c9",
                                "sense_id": "442348d7-4ab1-36a6-84ff-13717588e423",
                                "text": "[…] in short, this delightful, blissful, wise, pleasurable, honourable, virtuous, true, and immortal prince, was a violator of his word, a libertine, over head and ears in disgrace, a despiser of domestic ties, the companion of gamblers and demireps […] ."
                            },
                            {
                                "example_id": "2b75f041-5150-4131-9369-4e45dc0a20e4",
                                "sense_id": "442348d7-4ab1-36a6-84ff-13717588e423",
                                "text": "[…] the greater part of our confessions (that is, spontaneous and extra-judicial confessions) proceed from demireps, adventurers, or swindlers […]."
                            },
                            {
                                "example_id": "98548de2-3220-4c07-940c-7f4c438a6482",
                                "sense_id": "442348d7-4ab1-36a6-84ff-13717588e423",
                                "text": "With the mincing step of a demirep / Some sidled up the stairs […]."
                            },
                            {
                                "example_id": "94300a5d-f9be-4576-8f02-cc33510d84e2",
                                "sense_id": "442348d7-4ab1-36a6-84ff-13717588e423",
                                "text": "In this new world, ruled by charlatans and dominated by demireps, Talleyrand may have found much to shock his sense of decorum, but little to outrage his moral standards."
                            }
                        ]
                    }
                ],
