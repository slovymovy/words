                                    },
                                    {
                                        "sense_id": "31d5e5b8-e254-3aee-883d-53526d7eb669",
                                        "entry_id": "7a6d6061-c714-3800-8f6e-cf8f21b75007",
                                        "glosses": [
                                            "zu einer Moschee gehörende Schule, in der die Vermittlung und Lesung des Korans im Vordergrund steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "205bc252-fa28-4e97-a1d6-0b7d18bdbc22",
                                                "sense_id": "31d5e5b8-e254-3aee-883d-53526d7eb669",
                                                "text": "„Omar wurde in einer Medresse, in einer Koranschule, erzogen, schloss sich den Taleban an.“"
                                            }
