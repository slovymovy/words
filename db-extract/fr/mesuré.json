                ],
                "senses": [
                    {
                        "sense_id": "a1bb281d-cb1b-396d-afca-c9dedd6bf9e8",
                        "entry_id": "c54666bb-bb69-3423-b574-bc430e6a1462",
                        "glosses": [
                            "Qui respecte une mesure ; régulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b6b979b-eecd-4f31-aa41-cc2aee86c795",
                                "sense_id": "a1bb281d-cb1b-396d-afca-c9dedd6bf9e8",
                                "text": "Elle allait d'un pas mesuré."
                            },
                            {
                                "example_id": "9276a6d6-b9c6-40dc-9a00-1ded33195a70",
                                "sense_id": "a1bb281d-cb1b-396d-afca-c9dedd6bf9e8",
                                "text": "Les mouvements mesurés demandent moins d'effort."
                            },
                            {
                                "example_id": "c6715ef8-7a8e-40fe-944e-f2fc35a44a37",
                                "sense_id": "a1bb281d-cb1b-396d-afca-c9dedd6bf9e8",
                                "text": "La musique savante exige souvent une interprétation rigoureusement mesurée."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e654ffd-d939-35bf-ad14-d7926d1b0129",
                        "entry_id": "c54666bb-bb69-3423-b574-bc430e6a1462",
                        "glosses": [
                            "Qui fait preuve de modération ou de retenue ; qui respecte la bienséance ; adapté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a9fc963-a047-4b4a-b80e-9c4a79b2e646",
                                "sense_id": "4e654ffd-d939-35bf-ad14-d7926d1b0129",
                                "text": "Le docteur se montrait à la fois sublime, grand, sobre et mesuré."
                            },
                            {
                                "example_id": "1e0c6288-bd08-4996-ad53-c0d13431cb9f",
                                "sense_id": "4e654ffd-d939-35bf-ad14-d7926d1b0129",
                                "text": "Les mouvements de la cuiller à café dans la tasse, pour mélanger le sucre et le lait, seront mesurés et calmes."
                            },
                            {
                                "example_id": "8a0a6167-12ce-4e9c-833c-41f6d395e551",
                                "sense_id": "4e654ffd-d939-35bf-ad14-d7926d1b0129",
                                "text": "Lui, d’habitude si mesuré, se met dans des colères noires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc3a389a-07f0-4cba-9dcb-35972abaad87",
                        "source_entry_id": "c54666bb-bb69-3423-b574-bc430e6a1462",
