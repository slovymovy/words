                        "glosses": [
                            "lijst van competitiewedstrijden met de datum en de plaats waar ze gespeeld worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d49243-0cf4-4ce3-93d0-0b62f04f8814",
                                "sense_id": "58e3d1b2-a17a-3525-ab54-fed73a35a73b",
                                "text": "Wijchen is definitief afgehaakt. De FEB houdt in het competitieprogramma de mogelijkheid van een tiende deelnemer aan de competitie open."
                            },
                            {
                                "example_id": "f79283e1-0ddd-4402-b337-6af70266c9e5",
                                "sense_id": "58e3d1b2-a17a-3525-ab54-fed73a35a73b",
                                "text": "Bondscoach Louis van Gaal begint zijn nieuwe baan als trainer van Manchester United in het weekeinde van 16 en 17 augustus met een thuiswedstrijd tegen Swansea City, de ploeg van de internationals Jonathan de Guzman en Michel Vorm. Dat blijkt uit het voorlopige competitieprogramma dat bekend is gemaakt door de Engelse voetbalbond."
                            },
                            {
                                "example_id": "8a7a6b93-ff54-4d9b-b5cf-5c04186cebd6",
                                "sense_id": "58e3d1b2-a17a-3525-ab54-fed73a35a73b",
                                "text": "Clubs kunnen hun voorkeur aangeven, waarna de KNVB daar bij het competitieprogramma zo veel mogelijk rekening mee zal proberen te houden."
                            }
                        ]
                    }
