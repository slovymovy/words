                "senses": [
                    {
                        "sense_id": "3580f4e6-6e21-3573-a5c1-d9cb6beac7fc",
                        "entry_id": "642cf265-09eb-3a43-bd42-c24b2a207803",
                        "glosses": [
                            "Geruchswahrnehmung und die Reaktion auf diesen Reiz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "045c63ba-1aa1-4d15-92c3-2212695fea3d",
                                "sense_id": "3580f4e6-6e21-3573-a5c1-d9cb6beac7fc",
                                "text": "„Im Rahmen einer neurologisch-psychiatrischen Untersuchung im Februar 1998 berichtete die Patientin über ein pelziges Gefühl im Hals, rezidivierende Schwellungen der Zunge und Augenbindehäute, Muskelschmerzen, eine erhöhte Geruchsempfindlichkeit gegenüber Parfums, Waschmitteln und Zeitungen.“"
                            },
                            {
                                "example_id": "6257fc3b-1f1c-42a9-9f12-dc713966c5af",
                                "sense_id": "3580f4e6-6e21-3573-a5c1-d9cb6beac7fc",
                                "text": "„Häufig werden auch Konzentrationsstörungen, Schwindel, Benommenheit und Geruchsempfindlichkeit berichtet.“"
                            },
                            {
                                "example_id": "393291c0-8305-40dc-9551-25ddde258100",
                                "sense_id": "3580f4e6-6e21-3573-a5c1-d9cb6beac7fc",
                                "text": "„Für manche chemische Stoffe besteht eine sehr hohe Geruchsempfindlichkeit, so dass sie schon in sehr geringen Konzentrationen wahrgenommen werden.“"
                            },
                            {
                                "example_id": "3c2ba85a-34ec-4b02-959a-7281b8b723d6",
                                "sense_id": "3580f4e6-6e21-3573-a5c1-d9cb6beac7fc",
                                "text": "„Auch ein Vitamin-B6-Mangel, eine gesteigerte Geruchsempfindlichkeit, psychische Faktoren und eine genetische Prädisposition werden für die Schwangerschaftsbeschwerden verantwortlich gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
