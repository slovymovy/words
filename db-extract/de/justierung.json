                "senses": [
                    {
                        "sense_id": "11a8cd32-d6cd-36eb-9916-af32fb6166a8",
                        "entry_id": "3ff7a1f0-30b9-3d34-aec1-afe166dd07a5",
                        "glosses": [
                            "Ajustage : réglage, modification d’un instrument de mesure, d’une pièce mécanique, d’un circuit électronique, etc., pour correspondre aux spécifications."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76d2cefe-112d-44f5-80e3-4ef888b6f330",
                                "sense_id": "11a8cd32-d6cd-36eb-9916-af32fb6166a8",
                                "text": "Die meisten Sensoren sind genügend linear und benötigen lediglich eine Justierung des Anfangswertes und der Spanne des Ausgangssignals.",
                                "translation": "La plupart des capteurs sont suffisament linéaires et ne nécessitent qu’un ajustement de la valeur initiale et de l’étendue du signal de sortie."
                            },
                            {
                                "example_id": "81e6ceae-2c38-4b3b-b007-9ae64c2b924b",
                                "sense_id": "11a8cd32-d6cd-36eb-9916-af32fb6166a8",
                                "text": "Viele genaue mechanische Bauteile werden am Ende deren Bearbeitungsprozesses feingeschliffen, was die Justierung deren Maße innerhalb des Toleranzbereiches erlaubt.",
                                "translation": "Maintes pièces mécaniques de précision sont rectifiées en fin de leur processus d’usinage, ce qui permet l’ajustage de leurs dimensions dans la plage de tolérance."
                            }
                        ]
                    }
                ],
