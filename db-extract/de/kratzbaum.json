                            "plural"
                        ],
                        "form": "die Kratzbäume"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27c0e588-cbe3-3015-86c8-de99262a550f",
                        "entry_id": "a266496c-b5ef-35c0-a9c9-5ff1eff9276e",
                        "glosses": [
                            "Möbelstück, Gerüst, an dem Katzen klettern und ihre Krallen schärfen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a26c55a3-fffd-49a9-a6a1-96585852e264",
                                "sense_id": "27c0e588-cbe3-3015-86c8-de99262a550f",
                                "text": "„Um die Möbel zu schützen, sollten Katzen darauf trainiert werden, einen Kratzbaum zu benutzen.“"
                            },
                            {
                                "example_id": "d0501c2d-1526-477b-a89c-e942c8188923",
                                "sense_id": "27c0e588-cbe3-3015-86c8-de99262a550f",
                                "text": "„Der Kratzbaum ist dem kleinen »Perserker« völlig schnuppe und steht neuwertig unbeachtet in einer Ecke.“"
                            },
                            {
                                "example_id": "fb2fe06e-e6f2-4132-a586-69e37b34e9da",
                                "sense_id": "27c0e588-cbe3-3015-86c8-de99262a550f",
                                "text": "„Sibirische Katzen sind temperamentvoll und kletterfreudig, daher sollten Sie einen stabilen Kratzbaum besorgen, der bis an die Decke reicht.“"
                            },
                            {
                                "example_id": "9d7b252e-6bb2-4294-8196-4fec25fe0d8d",
                                "sense_id": "27c0e588-cbe3-3015-86c8-de99262a550f",
                                "text": "„Gestern war mein Mann den Kratzbaum im Nachbarort abholen, den ich mir beim Universum ‚bestellt‘ habe.“"
                            },
                            {
                                "example_id": "b0702445-e721-4533-a6ff-d93961386253",
                                "sense_id": "27c0e588-cbe3-3015-86c8-de99262a550f",
                                "text": "„Ein Kratzbaum, der einer Katze etwas bietet, reicht zumindest fast bis an die Decke.“"
                            },
                            {
                                "example_id": "6ff480dc-6902-4057-a1cc-c7e92aa590eb",
                                "sense_id": "27c0e588-cbe3-3015-86c8-de99262a550f",
                                "text": "„Ein deckenhoher Kratzbaum mit vielen Höhlen und Liegeflächen, wie Hängematten erscheint Menschen wie ein Katzenparadies.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
