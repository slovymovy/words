                        "glosses": [
                            "landbouwvoertuig met grote achterwielen, waardoor het landbouwmachines kan voorttrekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32bd6afb-6ddd-41f8-b5bd-1fab7de2d10b",
                                "sense_id": "ca74c92f-d2e6-3cb1-8554-e2004a7e29a6",
                                "text": "Een kleine groep boeren blokkeert woensdagochtend opnieuw een distributiecentrum van ALDI in Drachten. Eén van de ALDI-vrachtwagens buiten de hekken kon door drie trekkers geen kant meer op."
                            }
