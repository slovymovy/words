                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3f8a04b-51c9-4876-beaf-66af80f776ba",
                        "source_entry_id": "3c354daa-f018-3344-8b4a-d5447a0c2f2f",
                        "source_sense_id": "e3bb4481-faa8-3ec2-8805-488071126ea1",
                        "target_lang_word": "pyriform",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyriform",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5cdb3b-b2d2-3ce9-8f6e-a9a9974289bc",
                                        "entry_id": "f5a1519a-9ec6-39c3-b7bb-cdd86ae0ab3a",
                                        "glosses": [
                                            "Pear-shaped."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "590aaba0-3a7f-475d-9f90-7bf990814776",
                                                "sense_id": "5a5cdb3b-b2d2-3ce9-8f6e-a9a9974289bc",
                                                "text": "The chief difference between this brain and that of the Turtle obtains in the large size of the optic lobe and cerebrum as compared with the cerebellum, in the more pyriform figure of the cerebral hemispheres, and in the transverse fissure of the cerebellum."
                                            },
                                            {
                                                "example_id": "9105fe91-309a-4717-8f4c-adf792a7f464",
                                                "sense_id": "5a5cdb3b-b2d2-3ce9-8f6e-a9a9974289bc",
                                                "text": "Most small worms have a pyriform shape. Larger worms living in unconsolidated sediments are cylindrical and elongate. Those in rock fissures or coral crevices have stouter and more pyriform bodies."
                                            },
                                            {
                                                "example_id": "89a6e321-2b40-4266-a624-f168b23cd4a0",
                                                "sense_id": "5a5cdb3b-b2d2-3ce9-8f6e-a9a9974289bc",
                                                "text": "In fact, Clavigula is very similar to Glochidorella, differing from this mainly in the absence of perioral disc (vs. presence), shape of pharyngeal bulb (more cylindrical vs. more pyriform) and more robust spicules."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pyriform",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80f1a7c0-d8ad-38b7-8efc-f2e9f74f4dc7",
                                        "entry_id": "675c5626-43b6-3d5e-94fd-24c86d99efd3",
                                        "glosses": [
                                            "A pyriform object."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "899500fa-6824-487a-b6da-be300b4dc19a",
                        "source_entry_id": "3c354daa-f018-3344-8b4a-d5447a0c2f2f",
                        "source_sense_id": "e3bb4481-faa8-3ec2-8805-488071126ea1",
                        "target_lang_word": "pear-shaped",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pear-shaped",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca59ec48-d21a-3121-8a85-81eed956b6fd",
                                        "entry_id": "aab3d54c-da66-38b2-b57e-e4bab7097e71",
                                        "glosses": [
                                            "Having a shape of a (typical western) pear, or in cross-section, like the cross-section of a pear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "012ff9aa-4a3a-4a01-91ae-2e690bc647e3",
                                                "sense_id": "ca59ec48-d21a-3121-8a85-81eed956b6fd",
                                                "text": "Single egg laid directly on ledge, pear-shaped to prevent rolling off[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23e5e1fe-29d6-3cc9-aa58-e1be60e7822a",
                                        "entry_id": "aab3d54c-da66-38b2-b57e-e4bab7097e71",
                                        "glosses": [
                                            "Having a shape of a (typical western) pear, or in cross-section, like the cross-section of a pear.",
                                            "Having gynoid fat distribution, not android fat distribution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dbd74b9-4999-4cea-adb0-271404752b1d",
                                                "sense_id": "23e5e1fe-29d6-3cc9-aa58-e1be60e7822a",
                                                "text": "pear-shaped obesity versus apple-shaped obesity"
                                            },
                                            {
                                                "example_id": "fa80c029-3718-4f4f-90e0-ec1482e488b1",
                                                "sense_id": "23e5e1fe-29d6-3cc9-aa58-e1be60e7822a",
                                                "text": "Just as one should take sitting-up exercises every day to keep one's figure from going pear-shaped in the hips, one should spend at least a little time, even if it is only very little, sloughing off mental flabbiness by thinking, studying or just reading something that requires an exercising effort of the mind to understand, memorise or digest."
                                            },
                                            {
                                                "example_id": "5c168c3a-c6be-49f8-bd19-509b3b401257",
                                                "sense_id": "23e5e1fe-29d6-3cc9-aa58-e1be60e7822a",
                                                "text": "Even at BMIs above 30, where obesity begins, men and women whose waist-to-hip ratio identified them as more pear-shaped were less likely to die -- of any cause and of cardiovascular causes -- than those with similar BMIs who were apple-shaped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98b29bd8-3877-312b-b3f3-08a5bd9e2163",
                                        "entry_id": "aab3d54c-da66-38b2-b57e-e4bab7097e71",
                                        "glosses": [
                                            "rich, mellow, sonorous"
                                        ],
                                        "tags": [
                                            "of a vocal or musical tone"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d77afbc5-05f2-3ea1-9684-f21abb291174",
                                        "entry_id": "aab3d54c-da66-38b2-b57e-e4bab7097e71",
                                        "glosses": [
                                            "Wrong, awry, usually in the phrase go pear-shaped."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
