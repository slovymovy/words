{
    "word_family": [
        "here",
        "herein",
        "heretofore",
        "herewith"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d119c32f-90dc-3cdc-a0ea-cd758e0df8b0",
                    "sense_definition": "By means of this statement, act, or document",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_declaration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>hereby</w> declare you husband and wife in accordance with the laws of this state.",
                            "target_lang_translations": {
                                "ru": "В соответствии с законами этого штата я <w>настоящим</w> объявляю вас мужем и женой.",
                                "es": "<w>Por la presente</w> los declaro marido y mujer de conformidad con las leyes de este estado."
                            }
                        },
                        {
                            "text": "The committee members <w>hereby</w> authorize the release of the confidential documents to the public.",
                            "target_lang_translations": {
                                "ru": "Члены комитета <w>этим</w> решением санкционируют публикацию конфиденциальных документов.",
                                "es": "Los miembros del comité autorizan <w>por este medio</w> la divulgación pública de los documentos confidenciales."
                            }
                        }
                    ],
                    "synonyms": [
                        "herewith"
                    ],
                    "common_phrases": [
                        "hereby declare",
                        "hereby authorize",
                        "hereby certify"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посредством данного заявления, действия или документа; официально подтверждая что-либо.",
                        "es": "Por medio de esta declaración, acto o documento; de manera formal o legal."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настоящим",
                                "target_lang_sense_clarification": "в официальных документах и заявлениях"
                            },
                            {
                                "target_lang_word": "этим",
                                "target_lang_sense_clarification": "посредством этого действия или акта"
                            },
                            {
                                "target_lang_word": "сим",
                                "target_lang_sense_clarification": "устаревший или крайне формальный стиль"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "por la presente",
                                "target_lang_sense_clarification": "en documentos o declaraciones formales"
                            },
                            {
                                "target_lang_word": "por este medio",
                                "target_lang_sense_clarification": "mediante este acto o escrito"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b864ed1-63ed-36ff-836c-74bd36667f83",
                    "sense_definition": "Near this place or close by",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old shepherd told us that a dangerous beast lived <w>hereby</w> in the dark woods.",
                            "target_lang_translations": {
                                "ru": "Старый пастух сказал нам, что <w>поблизости</w> в темном лесу живет опасный зверь.",
                                "es": "El viejo pastor nos dijo que una bestia peligrosa vivía <w>por aquí cerca</w>, en el bosque oscuro."
                            }
                        },
                        {
                            "text": "There is a small village <w>hereby</w> where we might find some food and shelter for the night.",
                            "target_lang_translations": {
                                "ru": "Здесь <w>неподалёку</w> есть небольшая деревня, где мы могли бы найти еду и ночлег.",
                                "es": "Hay una pequeña aldea <w>cerca</w> donde podríamos encontrar comida y refugio para pasar la noche."
                            }
                        }
                    ],
                    "synonyms": [
                        "nearby",
                        "close by"
                    ],
                    "antonyms": [
                        "faraway"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рядом с этим местом или поблизости.",
                        "es": "Cerca de este lugar o en las inmediaciones (uso arcaico)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поблизости",
                                "target_lang_sense_clarification": "недалеко от этого места"
                            },
                            {
                                "target_lang_word": "неподалёку",
                                "target_lang_sense_clarification": "в непосредственной близости"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cerca",
                                "target_lang_sense_clarification": "a poca distancia"
                            },
                            {
                                "target_lang_word": "por aquí cerca",
                                "target_lang_sense_clarification": "en las inmediaciones"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}