                "senses": [
                    {
                        "sense_id": "af13a812-9033-36f2-b89e-8b3965f70ba5",
                        "entry_id": "22d7ae63-b537-3413-8da3-05a9671437bf",
                        "glosses": [
                            "Gerät, um hohe Temperaturen, die sogenannte Glühhitze, zu messen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "f9b69ea7-df41-4e05-a500-2f199a42d6df",
                                "sense_id": "af13a812-9033-36f2-b89e-8b3965f70ba5",
                                "text": "„Die Hitze könnte zwar nach dem Pyrometer regulirt werden; man darf sich aber nicht lediglich auf diesen verlassen.“"
                            },
                            {
                                "example_id": "e0f5871e-d6f4-495d-992b-a414e3e9609d",
                                "sense_id": "af13a812-9033-36f2-b89e-8b3965f70ba5",
                                "text": "„Ist dem Pyrometer ein Ampèremeter beigefügt, so ist seine Stromanzeige gesondert zu prüfen.“"
                            },
                            {
                                "example_id": "e2a80974-8e52-4b0e-847a-0934f00ed5e3",
                                "sense_id": "af13a812-9033-36f2-b89e-8b3965f70ba5",
                                "text": "„Bei der Messung der Kathodentemperatur mit dem Pyrometer ist vor allem die Abkühlung der Kathodenenden als Fehlerquelle zu berücksichtigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "104126c6-f276-4ad6-a3ec-e3963c9213c1",
                        "source_entry_id": "22d7ae63-b537-3413-8da3-05a9671437bf",
                        "source_sense_id": "af13a812-9033-36f2-b89e-8b3965f70ba5",
                        "source_sense_description": "Physik, Messtechnik: Gerät, um hohe Temperaturen, die sogenannte Glühhitze, zu messen",
                        "target_lang_word": "pyromètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
