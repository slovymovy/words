                    "target_lang_definitions": {
                        "ru": "Высочайшего качества, ценности или репутации; подлинный и превосходный.",
                        "zh": "品质、价值或声誉极高的；卓越的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безупречный",
                                "target_lang_sense_clarification": "о репутации или работе"
