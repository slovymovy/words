        "fr-extract.jsonl": [
            {
                "entry_id": "d1122a2d-b283-3184-923e-c96c02b23575",
                "word": "épineux",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d62bdcd1-3027-4658-8b47-018a305f4749",
                        "entry_id": "d1122a2d-b283-3184-923e-c96c02b23575",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "épineuse"
                    },
                    {
                        "form_id": "c681dac8-355f-4f3b-bdb1-99d0f9b34148",
                        "entry_id": "d1122a2d-b283-3184-923e-c96c02b23575",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "épineuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db0852fb-e36d-3fdf-8bf0-e6b07faf66a9",
                        "entry_id": "d1122a2d-b283-3184-923e-c96c02b23575",
                        "glosses": [
                            "Qui a des épines, des piquants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf462008-5b89-4ed4-9e33-0edd2be3e890",
                                "sense_id": "db0852fb-e36d-3fdf-8bf0-e6b07faf66a9",
                                "text": "Les pâturages, enclavés dans les bois de tous côtés, sauf au levant, où des haies vives érigeaient leurs épaisses barrières épineuses, restaient d’un vert dru malgré la chaleur torride de cette fin d’été."
                            }
                        ]
                    },
                    {
                        "sense_id": "173653be-d620-3dfb-868d-42d9660b9a38",
                        "entry_id": "d1122a2d-b283-3184-923e-c96c02b23575",
                        "glosses": [
                            "Qui est plein de difficultés, d’embarras, de contrariétés, etc."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2a16508c-b372-4d2d-bbab-57d15da9510c",
                                "sense_id": "173653be-d620-3dfb-868d-42d9660b9a38",
                                "text": "– La montée au temple de la Fortune qui se présente à vous est une des moins épineuses que j’aie vues."
                            },
                            {
                                "example_id": "60064267-280f-4c0e-9939-20844325ad25",
                                "sense_id": "173653be-d620-3dfb-868d-42d9660b9a38",
                                "text": "En vacances, il me dictait des textes épineux, choisis d’ordinaire chez Victor Hugo."
                            },
                            {
                                "example_id": "62e0e1b6-b28b-4bc1-b481-d4d722e183e0",
                                "sense_id": "173653be-d620-3dfb-868d-42d9660b9a38",
                                "text": "La question d’argent devient épineuse. Je ne peux plus vivre que pauvrement dans cette grande ville."
                            }
                        ]
                    },
                    {
                        "sense_id": "9aaa1464-b5bb-3365-8fa2-471f05d3c50f",
                        "entry_id": "d1122a2d-b283-3184-923e-c96c02b23575",
                        "glosses": [
                            "Qui fait des difficultés sur tout, en parlant des personnes."
                        ],
                        "tags": [
                            "broadly",
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2ce8cd67-7148-47c0-92f4-720fdeffbf42",
                                "sense_id": "9aaa1464-b5bb-3365-8fa2-471f05d3c50f",
                                "text": "Il est désagréable d’avoir affaire à lui, il est trop épineux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "863bd31f-d6e4-4da2-a52f-a38c81f951b6",
                        "source_entry_id": "d1122a2d-b283-3184-923e-c96c02b23575",
                        "target_lang_word": "thorny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thorny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bec99a7-1c4f-3c0f-bc95-d6d3c3d4ae50",
                                        "entry_id": "391e7bf1-f823-3cee-8eec-18ec953cb2fc",
                                        "glosses": [
                                            "Having thorns or spines."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b81081e4-29c2-41fc-93c3-284f7cd37954",
                                                "sense_id": "4bec99a7-1c4f-3c0f-bc95-d6d3c3d4ae50",
                                                "text": "Tara flour is one of two products made from the seed pods of a thorny shrub native to Peru. One of those, tara gum, has been used safely for years as a thickening agent or stabilizer in human foods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                        "entry_id": "391e7bf1-f823-3cee-8eec-18ec953cb2fc",
                                        "glosses": [
                                            "Troublesome or vexatious."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a94cb7-511d-4c40-813c-1356c206b800",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "thorny issues"
                                            },
                                            {
                                                "example_id": "4caabe0e-8af1-4430-9f7b-802d4901a127",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "the steep and thorny way to heaven"
                                            },
                                            {
                                                "example_id": "c344e867-dff1-4df0-b8ba-c0192ce0dc0d",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Westcott doesn’t even consider the thornier question of fan fiction based on real and often living people, for instance, the “bandslash” or “bandfic” phenomenon built around rock-star characters and often homoerotic subplots."
                                            },
                                            {
                                                "example_id": "0b74a2c4-3a7d-484a-9a06-ca24d689d039",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Six weeks into the renegotiation of the North American Free Trade Agreement, the thorniest issues surrounding the pact remain unresolved."
                                            },
                                            {
                                                "example_id": "d91a01af-009b-4c43-a477-59a6a70ba9b6",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Museums have recently begun to confront the same thorny question, with several issuing public apologies for collecting the remains of people believed or known to have been enslaved."
                                            },
                                            {
                                                "example_id": "c89aa11d-55c8-45f9-8c9d-e7996e57570d",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Station capacity in London, Paris, Brussels and Amsterdam remains a thorny issue, as does obtaining suitable Channel Tunnel-compliant trains."
                                            },
                                            {
                                                "example_id": "42e9dd9e-dc91-4480-8546-fc189c383552",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Mr. [Jake] Sullivan noted that turning away from thorny global issues like climate change would not stop them from posing a threat to the United States, and the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "180fac26-626b-38ba-ac74-8799fa61f76a",
                                        "entry_id": "391e7bf1-f823-3cee-8eec-18ec953cb2fc",
                                        "glosses": [
                                            "Aloof and irritable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c62bbd06-cb9a-4607-b5f1-d7fdb3351d2e",
                                                "sense_id": "180fac26-626b-38ba-ac74-8799fa61f76a",
                                                "text": "Come, Jo, don't be thorny. After studying himself to a skeleton all the week, a fellow deserves petting, and ought to get it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b18f3f2-c2ce-471c-ab61-5025ae269d21",
                        "source_entry_id": "d1122a2d-b283-3184-923e-c96c02b23575",
                        "target_lang_word": "prickly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prickly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d4d3cdf-30e8-39f5-991c-11e0bdc98352",
                                        "entry_id": "4cc83690-c39d-385b-9229-d49ab35a68a3",
                                        "glosses": [
                                            "Covered with sharp points."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a63d254-30a4-49b0-b3c3-acff6a351cc1",
                                                "sense_id": "4d4d3cdf-30e8-39f5-991c-11e0bdc98352",
                                                "text": "The prickly pear is a cactus; you have to peel it before eating it to remove the spines and the tough skin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecca4299-823d-3a8f-bbf3-a8e3569b236f",
                                        "entry_id": "4cc83690-c39d-385b-9229-d49ab35a68a3",
                                        "glosses": [
                                            "Easily irritated."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3fb9c4e-d5ac-4637-90dd-e0847ef5eb70",
                                                "sense_id": "ecca4299-823d-3a8f-bbf3-a8e3569b236f",
                                                "text": "He has a prickly personality. He doesn't get along with people because he is easily set off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d3b0421-d045-37b5-bc6c-4a27f11d6e6c",
                                        "entry_id": "4cc83690-c39d-385b-9229-d49ab35a68a3",
                                        "glosses": [
                                            "Difficult; complicated; hairy or thorny."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1807c3ed-8ca1-4207-97a0-7ff75f01c5a6",
                                                "sense_id": "1d3b0421-d045-37b5-bc6c-4a27f11d6e6c",
                                                "text": "It was a prickly situation."
                                            },
                                            {
                                                "example_id": "a7046c7b-0746-44b5-a3b9-86b99570f1b2",
                                                "sense_id": "1d3b0421-d045-37b5-bc6c-4a27f11d6e6c",
                                                "text": "People who are prickly can’t be hurt any more. They’ve had it. So we just have to be prickly to make sure nobody’s going to come in and grab us."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prickly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59bba77e-628a-32a3-a4ed-326b0faf1b56",
                                        "entry_id": "c5a27fc3-cac5-30e3-8e7c-bcc5ecf32217",
                                        "glosses": [
                                            "In a prickly manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9d39d28-efc4-4b1d-8b93-a7c1d851b66c",
                                                "sense_id": "59bba77e-628a-32a3-a4ed-326b0faf1b56",
                                                "text": "Striding across stage in his bright white jacket, his voice soaring and cracking – like Charlie Parker’s – he was nervous but prickly eloquent, caustic yet encouraging."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prickly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e59c41de-82f2-348e-a94a-2f39cbd0d4a0",
                                        "entry_id": "40818779-f3e3-3720-86f6-5813eb1df72c",
                                        "glosses": [
                                            "Something that gives a pricking sensation; a sharp object."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3231c405-d844-484e-9573-88e28c3bbdc5",
                                                "sense_id": "e59c41de-82f2-348e-a94a-2f39cbd0d4a0",
                                                "text": "Below, way out on the flat, Blue had seen a light green that could be graze but up here was nothing 'cept all kinds of prickly bushes, and too many of them. Ground-spreading pricklies that reached out to jump at a horse's belly […]"
                                            },
                                            {
                                                "example_id": "42caf3a9-8e78-4011-8842-9be6b76e508d",
                                                "sense_id": "e59c41de-82f2-348e-a94a-2f39cbd0d4a0",
                                                "text": "Dad, I need to ride on your shoulders because the pricklies hurt my feet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
