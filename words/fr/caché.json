            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "719f0dbe-917d-3abe-b8cb-7ec8e208bbf8",
                    "sense_definition": "Qui est dissimulé aux regards, qui n'est pas immédiatement visible.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dissimule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit garçon cherche le trésor <w>caché</w> derrière le grand chêne du jardin.",
                            "target_lang_translations": {
                                "en": "The little boy is searching for the treasure <w>hidden</w> behind the big oak in the garden.",
                                "ru": "Маленький мальчик ищет <w>спрятанный</w> клад за большим дубом в саду.",
                                "de": "Der kleine Junge sucht den <w>versteckten</w> Schatz hinter der großen Eiche im Garten.",
                                "es": "El niño pequeño busca el tesoro <w>escondido</w> detrás del gran roble del jardín.",
                                "zh": "小男孩正在花园里寻找那棵大橡树后面<w>隐藏的</w>宝藏。"
                            }
                        },
                        {
                            "text": "Ils ont découvert une porte secrète qui menait à un escalier <w>caché</w>.",
                            "target_lang_translations": {
                                "en": "They discovered a secret door that led to a <w>hidden</w> staircase.",
                                "ru": "Они обнаружили потайную дверь, которая вела к <w>скрытой</w> лестнице.",
                                "de": "Sie entdeckten eine geheime Tür, die zu einer <w>versteckten</w> Treppe führte.",
                                "es": "Descubrieron una puerta secreta que conducía a una escalera <w>oculta</w>.",
                                "zh": "他们发现了一扇暗门，通往一段<w>隐蔽的</w>楼梯。"
                            }
                        }
                    ],
                    "synonyms": [
                        "invisible"
                    ],
                    "antonyms": [
                        "visible"
                    ],
                    "common_phrases": [
                        "trésor caché",
                        "caméra cachée",
                        "face cachée"
                    ],
                    "target_lang_definitions": {
                        "en": "Hidden from view, not immediately visible.",
                        "ru": "Скрытый от взглядов, не сразу видимый.",
                        "de": "Vor Blicken verborgen und nicht sofort sichtbar.",
                        "es": "Que está oculto a la vista y no se ve de inmediato.",
                        "zh": "被藏起来、不容易被看见的，不是立即可以看到的。"
                    },
                    "translations": {
