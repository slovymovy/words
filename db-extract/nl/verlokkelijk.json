                                        "sense_id": "1c10dd1b-4f52-3649-98e5-a5bf0a68cd27",
                                        "entry_id": "e7225338-ae5e-3b8f-821a-b39fc9ee75f9",
                                        "glosses": [
                                            "enticement; temptation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef7bd41a-4131-46a1-88ef-cd5e3c449ca6",
                                                "sense_id": "1c10dd1b-4f52-3649-98e5-a5bf0a68cd27",
                                                "text": "On each soft side [of the White Whale]—coincident with the parted swell, that but once leaving him, then flowed so wide away—on each bright side, the whale shed off enticings."
                                            }
                                        ]
                                    }
                                ]
