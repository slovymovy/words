                "senses": [
                    {
                        "sense_id": "c8c60300-3d93-33b1-a82b-919033a55124",
                        "entry_id": "40bdf1a0-b92d-3bc0-babb-669d2d9a4dd0",
                        "glosses": [
                            "Donner un caractère coopératif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dab8b6d6-4416-42ba-9a95-e8175cd9b110",
                                "sense_id": "c8c60300-3d93-33b1-a82b-919033a55124",
                                "text": "Le rachat d'une entreprise saine pour la coopérativiser."
                            },
                            {
                                "example_id": "59cb1c5b-e61a-4567-a42e-37d0fd4536c5",
                                "sense_id": "c8c60300-3d93-33b1-a82b-919033a55124",
                                "text": "En fait à partir de cette période des années 80, on demanda aux paysans de s’unir de se « coopérativiser » pour mieux faire face aux coûts insupportables de l’agriculture moderne."
                            },
                            {
                                "example_id": "4f385fd8-c8e0-4330-85e5-da949eccc688",
                                "sense_id": "c8c60300-3d93-33b1-a82b-919033a55124",
                                "text": "Elle est d'abord une forme de fondation, avant de passer sous la tutelle de l'État, puis de se coopérativiser en 1999."
                            }
                        ]
                    }
