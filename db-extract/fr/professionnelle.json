                    {
                        "sense_id": "6e5c1d76-4516-3b9c-9221-f97a39866653",
                        "entry_id": "dd78630d-c16e-3f76-988a-00a5a270a417",
                        "glosses": [
                            "Féminin singulier de professionnel."
                        ],
