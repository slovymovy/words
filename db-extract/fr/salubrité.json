                        "source_entry_id": "a989bbf3-caaf-3a9b-a19f-36c623c27c34",
                        "target_lang_word": "Gesundheitspflege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesundheitspflege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f11b74f-cbfe-33a6-aff1-365e90b43cdf",
                                        "entry_id": "815c90b9-c3d9-35b3-878d-a0e246c3839b",
                                        "glosses": [
                                            "Gesamtheit der Maßnahmen zur Förderung und Erhaltung des gesundheitlichen Zustandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da684b64-8823-41d1-8ae4-21d80f715c86",
                                                "sense_id": "5f11b74f-cbfe-33a6-aff1-365e90b43cdf",
                                                "text": "„Etwa vier Prozent des monatlichen Nettoeinkommens gibt jeder hessische Haushalt für die Gesundheitspflege aus - wie im Fall der Fältchencremes jedoch oft umsonst.“"
                                            },
                                            {
                                                "example_id": "f1a06aa5-d79f-4a35-bb5d-7482242246ac",
                                                "sense_id": "5f11b74f-cbfe-33a6-aff1-365e90b43cdf",
                                                "text": "„Ein Sprecher des Ministeriums für Gesundheitspflege und Soziale Dienste (HHS) hatte schon vor einigen Wochen angedeutet, Prominente für öffentliche Ankündigungen in sozialen Medien, Fernsehen und Radio rekrutieren zu wollen.“"
                                            },
                                            {
                                                "example_id": "41235a01-2a70-4d29-8dcc-043eb0bf2dcd",
                                                "sense_id": "5f11b74f-cbfe-33a6-aff1-365e90b43cdf",
                                                "text": "„GSK und Novartis legen außerdem ihre Geschäftsfelder für rezeptfreie Medikamente und Gesundheitspflegeprodukte wie Voltaren und Sensodyne zusammen.“"
                                            },
                                            {
                                                "example_id": "31922981-b94f-430b-a47b-c3046ccaded6",
                                                "sense_id": "5f11b74f-cbfe-33a6-aff1-365e90b43cdf",
                                                "text": "„Die Stadt Hanau wiederum komme ihrer Verantwortung nicht nach, dem Kreis die Kosten für die Gesundheitspflege der Schulkinder zu erstatten, nannte Frenz ein weiteres Beispiel für einen auch in der Praxis fehlenden Gemeinschaftsgeist der großen Städte.“"
                                            },
                                            {
                                                "example_id": "3da23c59-fcaf-46cd-9259-392e0416717b",
                                                "sense_id": "5f11b74f-cbfe-33a6-aff1-365e90b43cdf",
                                                "text": "„Seit Jahren ringen finnische Regierungen darum, die Gesundheitspflege zu reformieren.“"
                                            },
                                            {
                                                "example_id": "2c85fa6c-8eb1-4a0d-b82f-2a38e207a40b",
                                                "sense_id": "5f11b74f-cbfe-33a6-aff1-365e90b43cdf",
                                                "text": "„So lagen die Preise für die Gesundheitspflege im Dezember noch gut 21 Prozent über dem Vorjahreswert, im Januar waren es nur noch 4,7 Prozent, berichteten die Statistiker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
