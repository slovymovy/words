        "fr-extract.jsonl": [
            {
                "entry_id": "9cc4049d-bc21-31e6-921d-27b34d5378af",
                "word": "piémontais",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d00f7034-6bb7-4e3f-9e28-487ccb725360",
                        "entry_id": "9cc4049d-bc21-31e6-921d-27b34d5378af",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "piémontaise"
                    },
                    {
                        "form_id": "b9f4969e-9b05-4159-88c8-9561ed4beccb",
                        "entry_id": "9cc4049d-bc21-31e6-921d-27b34d5378af",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "piémontaises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aca1c030-dcab-390c-ac14-b96bf8f6a716",
                        "entry_id": "9cc4049d-bc21-31e6-921d-27b34d5378af",
                        "glosses": [
                            "Relatif au Piémont, région située au Nord-Ouest de l’Italie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59255946-3439-44fe-8feb-c1d285d29700",
                                "sense_id": "aca1c030-dcab-390c-ac14-b96bf8f6a716",
                                "text": "Je fus obligé, pour sortir, d’endosser une de ses redingotes, qui me tombait jusqu’aux talons et me donnait l’air d’un musicien piémontais ; il ne me manquait qu’une harpe. Quelques mois auparavant, si j’avais dû courir les rues dans un pareil accoutrement, je serais mort de honte."
                            },
                            {
                                "example_id": "0dcb7652-8aa3-4bdc-be40-069813bf0b38",
                                "sense_id": "aca1c030-dcab-390c-ac14-b96bf8f6a716",
                                "text": "Et des terrassiers piémontais, de beaux hommes, aux têtes frisées, formaient dans un coin un groupe compact, hostile et sournois. On les craignait, car leurs discussions se terminaient, d’ordinaire, par des coups de couteau."
                            },
                            {
                                "example_id": "98ff6d4b-6cef-4c0c-b18d-d6fd24646869",
                                "sense_id": "aca1c030-dcab-390c-ac14-b96bf8f6a716",
                                "text": "Ce type de pratiques n’est pas réservé aux travailleurs de nationalité française ; Mino Faïta a montré que les pratiques des saisonniers piémontais du bâtiment-travaux publics ne sont pas très différentes de celles des maçons creusois."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c1db800-f9c3-39ed-b57b-f8e2d9c5bd25",
                        "entry_id": "9cc4049d-bc21-31e6-921d-27b34d5378af",
                        "glosses": [
                            "Relatif au piémontais, langue du Piémont."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10247591-16a7-4167-9d50-23fc273ce7d1",
                                "sense_id": "2c1db800-f9c3-39ed-b57b-f8e2d9c5bd25",
                                "text": "Celle des dialectes piémontais correspond à l’ancienne principauté de Piémont, acquise au Moyen Âge par les ducs de Savoie, puis devenue le cœur de leurs États : le transfert de la capitale de Chambéry à Turin date de 1562."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2a58af3-3998-4b34-8a2d-756a733f249a",
                        "source_entry_id": "9cc4049d-bc21-31e6-921d-27b34d5378af",
