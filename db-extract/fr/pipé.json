                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e64ccde4-748a-37ef-93a1-5dfac923593b",
                                        "entry_id": "b36241f6-1923-3394-9cac-71ab33ac74e5",
                                        "glosses": [
                                            "Rigged; fraudulently prearranged."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8638103-f400-4859-8b23-e87f82d98250",
                                                "sense_id": "e64ccde4-748a-37ef-93a1-5dfac923593b",
                                                "text": "The mob made a lot of money from fixed horse races."
                                            },
                                            {
                                                "example_id": "fd36c5a5-934b-4746-a243-e0821544c2c6",
                                                "sense_id": "e64ccde4-748a-37ef-93a1-5dfac923593b",
                                                "text": "The U.S. often relied on fixed elections to keep anti-communist dictatorships in power."
