                        "entry_id": "ad59b228-d687-3700-b2bc-2b03e58ef61c",
                        "glosses": [
                            "Donner un caractère pulsionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4da1c526-ed8b-4368-a1ff-44ef43706dc0",
                                "sense_id": "8e332688-e13f-3807-988d-97caf351636c",
                                "text": "Quant à la force des excitations, on la retrouve évidemment dans le jeu des quantités pulsionnelles qui vont traiter, « pulsionnaliser », ces quantités d’excitations."
                            },
                            {
                                "example_id": "d0b272df-9c91-4d7b-9c35-f060aa15f237",
                                "sense_id": "8e332688-e13f-3807-988d-97caf351636c",
                                "text": "Le problème, pour nous, c’est de saisir comment un enfant excité peut se « pulsionnaliser », c’est-à-dire passer de la quantité à la qualité."
                            }
                        ]
                    }
