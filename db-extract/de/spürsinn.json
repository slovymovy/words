                "senses": [
                    {
                        "sense_id": "7914af51-4d90-3f24-8a30-3323c1b111b1",
                        "entry_id": "68186ebc-7ae9-3c3a-bbf2-f1502d4df6f0",
                        "glosses": [
                            "Fähigkeit von Menschen oder Tieren, etwas aufzuspüren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4b8cf6e-6875-48c0-991e-e1325a89ac05",
                                "sense_id": "7914af51-4d90-3f24-8a30-3323c1b111b1",
                                "text": "„Barbaro, der mich mit dem allen Venezianern eigenen Spürsinn erkannte, kam auf mich zu und beglückwünschte mich; als er aber sah, daß ich nicht antwortete, entfernte er sich wieder.“"
                            },
                            {
                                "example_id": "475393eb-3ca0-47e5-9234-4920978c3820",
                                "sense_id": "7914af51-4d90-3f24-8a30-3323c1b111b1",
                                "text": "„Mit etwas Spürsinn lässt sich eine heilige Quelle oder ein Heilbrunnen in der Nähe fast jeder deutschen Gemeinde finden – eine Tradition, die gerade ausstirbt, aber viele Jahrtausende in unsere Vergangenheit zurückreicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
