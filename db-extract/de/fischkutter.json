                "senses": [
                    {
                        "sense_id": "3ea7e72b-bc6f-39d9-8ae9-8e81ebb877b0",
                        "entry_id": "7c58a463-e2f1-34e3-b3d3-51cff533a119",
                        "glosses": [
                            "relativ kleines Schiff, das dem Fischfang auf See dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d6cfb35-af76-47a9-bec7-8839d172177d",
                                "sense_id": "3ea7e72b-bc6f-39d9-8ae9-8e81ebb877b0",
                                "text": "Fischkutter kann man an der Küste in fast jedem Hafen sehen."
                            },
                            {
                                "example_id": "490d5aa5-ba8c-48fa-b999-e59c8fbb3332",
                                "sense_id": "3ea7e72b-bc6f-39d9-8ae9-8e81ebb877b0",
                                "text": "„Wir steigen auf einen der alten Fischkutter im Hafen und legen ab zur Fahrt hinein ins Labyrinth.“"
                            },
                            {
                                "example_id": "27688376-81d7-4434-b9de-e7defc18f611",
                                "sense_id": "3ea7e72b-bc6f-39d9-8ae9-8e81ebb877b0",
                                "text": "„Sie sagten, sie wären lieber mit einem Fischkutter nach Island gesegelt, statt diesen langweiligen Törn durch ein ödes Land zu unternehmen.“"
                            },
                            {
                                "example_id": "936f13b0-8354-4fec-bb8b-013105b1ee62",
                                "sense_id": "3ea7e72b-bc6f-39d9-8ae9-8e81ebb877b0",
                                "text": "„Er lag im Bug eines unappetitlich riechenden Fischkutters, dessen Motor nervös tuckerte.“"
                            },
                            {
                                "example_id": "58e2d1aa-7c0a-4856-a9d1-d4b935824f5c",
                                "sense_id": "3ea7e72b-bc6f-39d9-8ae9-8e81ebb877b0",
                                "text": "„»Übersegelt« hieß eine alte Xylographie mit dem mächtigen Bug eines Vollschiffs, der einen Fischkutter zu Trümmern zerspellte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
