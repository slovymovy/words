                    {
                        "form_id": "9641557b-779d-4992-b119-3ffd8f8ff1da",
                        "entry_id": "56f63f54-8ebc-30e7-a417-485da77d6400",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "minaudières"
