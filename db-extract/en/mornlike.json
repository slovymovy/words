                                "example_id": "3ef3b554-4b9c-4e99-9a72-6bd4a6b8ce20",
                                "sense_id": "9cbc887e-4f77-39d0-89e6-3f8294323d21",
                                "text": "The future from the star, / More mornlike than the present, from the sun."
                            }
                        ]
                    }
