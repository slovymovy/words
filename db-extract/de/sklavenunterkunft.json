                "senses": [
                    {
                        "sense_id": "fa10d5f9-c697-393f-b917-d4a96e5fe70a",
                        "entry_id": "57646c9c-ce31-30a0-a846-693d61f2c777",
                        "glosses": [
                            "Wohnraum für Sklaven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1921ef43-8c33-4f16-b3fc-fc4393d15b9a",
                                "sense_id": "fa10d5f9-c697-393f-b917-d4a96e5fe70a",
                                "text": "„Sicherlich, Dread Moore hatte keinen glücklichen Start gehabt, als er in einer armseligen Sklavenunterkunft das Licht dieser Welt erblickt hatte.“"
                            },
                            {
                                "example_id": "5ab5f6f6-e939-43d9-8a44-76eb3acb0d8c",
                                "sense_id": "fa10d5f9-c697-393f-b917-d4a96e5fe70a",
                                "text": "„Er dachte an seinen Geburtstag letztes Jahr, der wie jeder andere Tag, wo in der Sklavenunterkunft in einer Ecke saß, Angst hatte und einsam war.“"
                            },
                            {
                                "example_id": "ff03afdc-591d-4994-a5ec-a6c066d7f479",
                                "sense_id": "fa10d5f9-c697-393f-b917-d4a96e5fe70a",
                                "text": "„Am frühen Abend stand plötzlich Merte im Tor der Sklavenunterkunft, eine ganze Reihe Helferinnen und Kisten voller Verbände und Heilmittel im Gepäck.“"
                            },
                            {
                                "example_id": "f585ef88-5daa-4bfa-a7c7-4996fccd1e15",
                                "sense_id": "fa10d5f9-c697-393f-b917-d4a96e5fe70a",
                                "text": "„Nach allem, was ich durchgemacht habe, reizt es mich nicht sonderlich, in einer ehemaligen Sklavenunterkunft gefangen gehalten zu werden.“"
                            },
                            {
                                "example_id": "61609d8f-9337-495e-b083-fbae2e2568ba",
                                "sense_id": "fa10d5f9-c697-393f-b917-d4a96e5fe70a",
                                "text": "„Die östlichen Sklavenunterkünfte – ein zweistöckiges Gebäude, größer als so manches Vorstadthaus – waren mein Zuhause während meiner Kindheit.“"
                            },
                            {
                                "example_id": "1306eaf8-47e2-49d9-9d22-f5d686acc269",
                                "sense_id": "fa10d5f9-c697-393f-b917-d4a96e5fe70a",
                                "text": "„Die Gästequartiere waren im Gegensatz zu den Sklavenunterkünften eine wahre Wohltat an Sauberkeit und dekorativer Inneneinrichtung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
