                "senses": [
                    {
                        "sense_id": "f65a8693-6c14-3de6-94c6-ddc1197d05aa",
                        "entry_id": "f8bfec15-0cea-3125-a0f7-4dadccc80cea",
                        "glosses": [
                            "resubmission; the act of handing in a document again"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "b1fe2fe4-85ec-4c37-b0d3-e6b9a68636cf",
                                "sense_id": "f65a8693-6c14-3de6-94c6-ddc1197d05aa",
                                "text": "Das Schreiben von Herrn Winter brauche ich zur Wiedervorlage am 31. Oktober.",
                                "translation": "I’ll need Mr Winter’s letter for resubmission on October 31st.",
                                "english": "I’ll need Mr Winter’s letter for resubmission on October 31st."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a051997-203e-373f-91f2-62db52341008",
                        "entry_id": "f8bfec15-0cea-3125-a0f7-4dadccc80cea",
                        "glosses": [
                            "a file in an office where documents are kept on hold for resubmission, especially by a secretary"
                        ],
                        "tags": [
                            "broadly",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "a340a379-9e75-4965-a780-7e2c56942da7",
                                "sense_id": "0a051997-203e-373f-91f2-62db52341008",
                                "text": "Suchen Sie mal in der Wiedervorlage nach dem Schreiben von Herrn Winter.",
                                "translation": "Would you please look for Mr Winter’s letter in the resubmission file.",
                                "english": "Would you please look for Mr Winter’s letter in the resubmission file."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fdb159d-e5d0-359f-bcbc-d9b3fa2ad87a",
                        "entry_id": "f8bfec15-0cea-3125-a0f7-4dadccc80cea",
                        "glosses": [
                            "used to imply that something is not currently dealt with but will be, or might be, in the future; backburner"
                        ],
                        "tags": [
                            "feminine",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4eab103a-54ac-42e2-8318-bee4aa53a763",
                                "sense_id": "4fdb159d-e5d0-359f-bcbc-d9b3fa2ad87a",
                                "text": "Die Sache mit Ihrer gefälschten Krankschreibung habe ich nicht vergessen. Die liegt bei mir zur Wiedervorlage!",
                                "translation": "I haven’t forgotten that thing about your forged doctor’s note. It’s on the backburner!",
                                "english": "I haven’t forgotten that thing about your forged doctor’s note. It’s on the backburner!"
                            }
                        ]
                    }
