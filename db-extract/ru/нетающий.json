                                    {
                                        "sense_id": "b6ece59a-61d6-3910-af35-c207c2680d5f",
                                        "entry_id": "9562a61a-f063-3b42-8c3f-e137a5926bf9",
                                        "glosses": [
                                            "eternally frozen; not prone to thaw"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb75ffde-b664-46f5-8a3b-eb2351534d6b",
                                                "sense_id": "b6ece59a-61d6-3910-af35-c207c2680d5f",
                                                "text": "An Arctic nature built up the ice of thawless winter."
                                            }
                                        ]
                                    }
                                ]
                            }
