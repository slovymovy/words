                        "glosses": [
                            "verklaring dat men de bedoeling heeft om tot een gemeenschappelijke besluit te komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d864b59d-7697-40f6-bb53-7be38a2a3c69",
                                "sense_id": "72fe5eaf-51bd-3b9e-9a73-ee92caf87676",
                                "text": "Feyenoord gaat in de toekomst verder als multisportclub. Vier sportclubs uit Rotterdam-Zuid gaan mogelijk verder onder de naam Feyenoord. Bestuurders van Forward Lease Rotterdam Basketbal, handbalvereniging HARO/Snelwiek, Hockeyclub Feijenoord en zaalvoetbalvereniging TPP Rotterdam hebben een intentieovereenkomst getekend met de voetbalclub om te komen tot een multisportclub."
                            },
                            {
                                "example_id": "b6d788dc-8dcc-4707-9148-35f2f768cff9",
                                "sense_id": "72fe5eaf-51bd-3b9e-9a73-ee92caf87676",
                                "text": "Desondanks werd precies een jaar geleden door de betrokken partijen een intentieovereenkomst getekend waarin de naamsverandering tot Johan Cruijff Arena centraal staat. Het duurde vervolgens nog bijna een jaar voordat het officieel werd."
                            },
                            {
                                "example_id": "a3f8dc25-5100-4529-be30-e3350d921a92",
                                "sense_id": "72fe5eaf-51bd-3b9e-9a73-ee92caf87676",
                                "text": "De bevrijding wordt dit weekeinde herdacht omdat die precies 73 jaar geleden plaatsvond. Tijdens die bijeenkomst in Breda tekende een Poolse minister een intentieovereenkomst met burgemeester Depla en voorzitter Krzeszewski van de stichting Generaal Maczek Memorial. De Poolse bijdrage zal bestaan uit kennis, niet uit geld."
                            }
                        ]
