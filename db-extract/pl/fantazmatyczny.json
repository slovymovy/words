                            "adjective"
                        ],
                        "examples": [
                            {
                                "example_id": "9406ee87-f153-4fec-9fee-ba610a7b8e47",
                                "sense_id": "cc9fb868-45ea-3d25-a6a0-52fa91b5c1d3",
                                "text": "W podwójnym znaczeniu: mijały, przelatując obok rzeki kiedyś we wspominanej przeszłości, albo mijały w pamięci, gdy nakładały się na siebie dwie odrębne rzeczywistości – ta realna z teraźniejszości i ta realna z przeszłości a obecnie fantazmatyczna tylko przywoływana przez pamięć"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
