                                        "glosses": [
                                            "potargane i brudne włosy"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0afc1fbb-5518-4c41-82c7-e0f319e5b692",
                                                "sense_id": "1c66ddb9-4569-30e8-8dcd-dcce1bf09a63",
                                                "text": "Jak ty wyglądasz?! Umaluj się chociaż i zrób coś z tym kołtunem na głowie!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "kołtun",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "7bf82ec7-7680-3e41-89f2-ca157167cf6b",
                                        "entry_id": "3e23f26c-44f7-3d99-bbc2-cb79c92418de",
                                        "glosses": [
                                            "człowiek zacofany i ograniczony"
                                        ],
                                        "tags": [
                                            "scornfully"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1527771-ceea-4d4a-b502-ce9518814dce",
                                                "sense_id": "7bf82ec7-7680-3e41-89f2-ca157167cf6b",
                                                "text": "W tej mieścinie to same kołtuny mieszkają."
                                            }
