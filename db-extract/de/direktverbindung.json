                "senses": [
                    {
                        "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                        "entry_id": "0412a1fa-3820-382d-85b3-00d0fe382bbb",
                        "glosses": [
                            "Transport ohne Umstieg"
                        ],
                        "tags": [
                            "Bahn",
                            "Flug",
                            "Bus"
                        ],
                        "examples": [
                            {
                                "example_id": "2b96d2a8-523d-4621-8362-ad7463ec0675",
                                "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                                "text": "„Alle 30 Minuten fährt normalerweise ein Fernverkehrszug zwischen Hamburg und Berlin. Die Strecke gilt als die wichtigste Direktverbindung zwischen den zwei Städten in Deutschland.“"
                            },
                            {
                                "example_id": "51b4abb4-7295-45fd-b288-1d25a6aea28d",
                                "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                                "text": "„Der absolute Klassiker für jeden Hamburger ist ein Ausflug an die Ostsee. Mit dem Auto sind es 83 Kilometer bis Travemünde, per Bahn geht’s mit Umsteigen in Lübeck, an Sommerwochenenden sogar in Direktverbindung an den Strand.“"
                            },
                            {
                                "example_id": "f85de15a-9959-4a69-bd15-b3191287c8d1",
                                "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                                "text": "[Schlagzeile:] „In acht Stunden von Berlin nach Paris: Deutsche Bahn startet Direktverbindung“"
                            },
                            {
                                "example_id": "612862ca-263b-4282-90d7-98f240b75eb6",
                                "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                                "text": "„Ab Mitte Dezember können Bahnreisende auch tagsüber mit einer Direktverbindung von Berlin in die französische Hauptstadt Paris fahren.“"
                            },
                            {
                                "example_id": "393c1f4c-fd8b-4430-8c4b-b9b80c261a58",
                                "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                                "text": "[Zugfahrt:] „Die Direktverbindung zwischen Reichenburg und Zürich war vor allem bei Pendlern beliebt.“"
                            },
                            {
                                "example_id": "61492bf2-7c27-4057-9e0b-9dbb1f3974c0",
                                "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                                "text": "„Zusätzlich verkehren etwa 13 Zugpaare täglich zwischen Dschidda und Flughafen mit einer Fahrzeit von 20 Minuten sowie einzelne Direktverbindungen von Mekka und Medina zum Flughafen.“"
                            },
                            {
                                "example_id": "98279a3e-7637-4410-b533-23911ddc2e5b",
                                "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                                "text": "„Vom Zwickauer Hauptbahnhof gibt es Direktverbindungen nach Leipzig und Dresden, wo in den Fernverkehr umgestiegen werden kann.“"
                            },
                            {
                                "example_id": "321eb081-ccd4-4024-9e01-39934efc72bf",
                                "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                                "text": "„Ein Schwerpunkt des neuen Fahrplans liegt auf dem Ausbau grenzüberschreitender Verbindungen. Ab Dezember wird es eine neue Direktverbindung von München über Stuttgart nach Amsterdam geben.“"
                            },
                            {
                                "example_id": "154197f7-9cf3-4550-b68d-27e578e3a542",
                                "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                                "text": "[Fahrt über die Alpen:] „Auch die Schiene kann eine Alternative sein. Die Deutsche Bahn bietet sechs Direktverbindungen täglich, unter anderem nach Venedig, Verona und Rimini.“"
                            },
                            {
                                "example_id": "518cc358-1784-413b-81dc-eecc18fa5519",
                                "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                                "text": "„Der Nürnberger Flughafen bietet wieder eine Direktverbindung nach Athen an.“"
                            },
                            {
                                "example_id": "cd73a8c0-9fd6-4183-bae4-e0bfe53ebf71",
                                "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                                "text": "[Neue Direktflüge von der Ostküste Australiens nach Europa oder an die Ostküste der USA in 2025:] „Für die neuen Direktverbindungen will das Unternehmen zwölf Airbus-Maschinen vom Typ A350-1000 beschaffen.“"
                            },
                            {
                                "example_id": "5bb33f97-bb88-4bca-b82d-7f9a6eec0cc8",
                                "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                                "text": "[Busverkehr:] „Der Linienbetrieb begann am 13. Februar 2013 mit täglich mehreren Direktverbindungen zwischen München, Nürnberg und Erlangen.“"
                            },
                            {
                                "example_id": "d8484009-948e-4545-b511-8a0ecc2deb5c",
                                "sense_id": "6649381e-1b9b-3b89-bab4-d3e181c8f5aa",
                                "text": "[Transport mit einer Fähre:] […] „HADAG-Vorstand Martin Lobmeyer: »Wir werden ab November eine lange gewünschte Direktverbindung Landungsbrücken- Finkenwerder-Landungsbrücken ohne Zwischenhalt einrichten.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e2f64347-1272-3634-9b4d-cb524372b0d6",
                        "entry_id": "0412a1fa-3820-382d-85b3-00d0fe382bbb",
                        "glosses": [
                            "Verbindung zwischen zwei Endpunkten ohne Vermittlungsstellen, Zwischenstationen oder Hubs"
                        ],
                        "tags": [
                            "Telefontechnik",
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "55bea869-be71-42d2-b59e-ae6fa34b4894",
                                "sense_id": "e2f64347-1272-3634-9b4d-cb524372b0d6",
                                "text": "„Wenige Monate nach der Kuba-Krise, am 30. August 1963, stand die Hotline schließlich und wurde bekannt als „Heißer Draht“ beziehungsweise „Rotes Telefon“. Vor allem letztere Bezeichnung ist äußerst irreführend, da es sich bei dieser Direktverbindung weder um ein Telefon handelte noch die Farbe Rot eine Rolle spielte. Es war eine Fernschreiberverbindung, die wie ein Fax-Gerät geschriebene Nachrichten von Ost nach West und andersherum übermittelte.“"
                            },
                            {
                                "example_id": "fbeb7dcc-7232-4569-9a96-ee26c2f599c4",
                                "sense_id": "e2f64347-1272-3634-9b4d-cb524372b0d6",
                                "text": "„Mit herkömmlichen Telefonen ist diese Direktverbindung möglich, sofern der SIP-Adapter ein Telefonbuch bietet, dessen Einträge per Kurzwahl vom Telefon aus erreichbar sind.“"
                            },
                            {
                                "example_id": "fca6c3e5-f3de-428d-8761-9bac968e2ccc",
                                "sense_id": "e2f64347-1272-3634-9b4d-cb524372b0d6",
                                "text": "„Eine neue Untersuchung nährt Befürchtungen, dass die Zunahme erdnaher Satelliten in Zukunft immer stärker die Weltraumforschung beeinträchtigt. Im Fokus stehen dabei die neuen Direct-to-Cell-Starlink-Satelliten (DTC) von SpaceX, die Direktverbindungen zu Smartphones ermöglichen sollen.“"
                            },
                            {
                                "example_id": "10e3b803-f5bd-4dca-aeaa-71af0bafcb4c",
                                "sense_id": "e2f64347-1272-3634-9b4d-cb524372b0d6",
                                "text": "„Wenn Sie zuverlässig, ungeteilt und abhörsicher in jedem Zimmer optimale Übertragungsraten erzielen wollen, stellt nach wie vor das Verlegen von Ethernet-Kabeln die beste Lösung dar. Diese sorgen für Verbindungen mit 1 Gigabit/s oder mehr in jedem Raum, weil sie eine Direktverbindung zwischen dem Router und dem Endgerät, etwa dem Computer oder dem Smart-TV, herstellen.“"
                            },
                            {
                                "example_id": "9ec71c69-a359-4eb5-b556-8d7b12acc67d",
                                "sense_id": "e2f64347-1272-3634-9b4d-cb524372b0d6",
                                "text": "„Beide Seiten bekräftigten auch die Bedeutung einer sicheren Unterseekabelinfrastruktur. Beide Seiten wollen weiterhin zusammenarbeiten, um Direktverbindungen zwischen Europa und Japan zu entwickeln.“"
                            },
                            {
                                "example_id": "be764d96-f7f0-4a02-b536-05050f78ba2d",
                                "sense_id": "e2f64347-1272-3634-9b4d-cb524372b0d6",
                                "text": "„Generell ist das gut, wenn euer Router eher Richtung Zimmerdecke platziert ist, z.B auf einem Schrank liegen. Ansonsten solltet ihr noch darauf achten, dass bei der gedachten Direktverbindung zwischen euren Geräten und dem Router keine Metallteile, zum Beispiel im Kühlschrank, die Verbindung stören.“"
                            },
                            {
                                "example_id": "ae096144-2979-492f-982f-146fa9f12ecc",
                                "sense_id": "e2f64347-1272-3634-9b4d-cb524372b0d6",
                                "text": "„Samsung hatte das Samsung Galaxy Tab 2 von 2012 zwar schon mit Wi-Fi Direct ausgestattet, aber in der Praxis ist eine stabile Direktverbindung zu Geräten anderer Hersteller Glückssache.“"
                            },
                            {
                                "example_id": "ba9c9608-8028-4f5e-b68e-43a355c6a428",
                                "sense_id": "e2f64347-1272-3634-9b4d-cb524372b0d6",
                                "text": "[Autos:] „Statt eines klassischen Kabelbaums mit zahlreichen Direktverbindungen zwischen den Steuergeräten kommt in der Neuen Klasse eine Zonen-Architektur zum Einsatz, die das Bordnetz in vier Zonen unterteilt.“",
                                "translation": "[*] Die beiden Zimmer haben keine Direktverbindung, man muss über den Flur gehen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
