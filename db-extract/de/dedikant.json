                "senses": [
                    {
                        "sense_id": "e485d147-5cdb-3761-99ba-32d491d7a0c2",
                        "entry_id": "93ff4bc5-e5a3-3543-891e-86859a66ab1c",
                        "glosses": [
                            "dankende, männliche Person, die im Rahmen einer Dedikation handelt und ein gewidmetes Relikt abliefert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ea2faa8-1328-4e70-b10d-7ae336c61af4",
                                "sense_id": "e485d147-5cdb-3761-99ba-32d491d7a0c2",
                                "text": "„Für die niedergermanischen vici wurde festgestellt, dass die zentralen Kultplätze für die Matronen in der Regel nicht innerhalb geschlossener Siedlungen gelegen waren und dass die Dedikanten offensichtlich in direkter Nachbarschaft der Heiligtümer wohnten.“"
                            },
                            {
                                "example_id": "8c4dbff1-0678-442e-83c9-5c669b9bcf19",
                                "sense_id": "e485d147-5cdb-3761-99ba-32d491d7a0c2",
                                "text": "„Auf die Tatsache, dass in der älteren Inschrift A zwei Buchstaben im Namen des Dedikanten vergessen wurden, deutet auch die Zeilenaufteilung hin.“"
                            },
                            {
                                "example_id": "e7a68723-6200-4a1b-ba38-aea474aa9d04",
                                "sense_id": "e485d147-5cdb-3761-99ba-32d491d7a0c2",
                                "text": "„Die typische Weihinschrift enthält neben Nennung des Namens (im Dativ) der Gottheit, der die Widmung gilt und dem Namen des Dedikanten (d.h. der Person, die der Gottheit huldigt) selbst, meist auch eine Dedikationsformel, die gekennzeichnet wird durch Wörter wie sacrum (geweiht), dedicavit (er/sie hat gewidmet) und so weiter.“"
                            },
                            {
                                "example_id": "dbcb8feb-d882-4bf2-8257-8fcab10a5683",
                                "sense_id": "e485d147-5cdb-3761-99ba-32d491d7a0c2",
                                "text": "„Es ist auffällig, wie ausführlich der Dedikant den Grund für seine Ehrung des Statthalters darlegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
