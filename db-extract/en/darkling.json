    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "912973bd-1150-31d6-8ece-dc2d7740c367",
                "word": "darkling",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5e2e7b4d-7137-3b82-9371-ac670e308ff0",
                        "entry_id": "912973bd-1150-31d6-8ece-dc2d7740c367",
                        "glosses": [
                            "Dark; growing dark; darkening."
                        ],
                        "tags": [
                            "not-comparable",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "be7d01b6-89ba-4f05-9e4e-c5501a48466b",
                                "sense_id": "5e2e7b4d-7137-3b82-9371-ac670e308ff0",
                                "text": "She still pursued its flight, with all the speed / Her fainting strength had hitherto supplied: / What pathless wilds she crossed ! What forests darkling wide !"
                            },
                            {
                                "example_id": "07a8605f-3001-4f38-a1a3-a5a23e9758e6",
                                "sense_id": "5e2e7b4d-7137-3b82-9371-ac670e308ff0",
                                "text": "May thine autumn calm, serene, / Never want some lingering flower, / Which Affection's hand may glean, / Though the darkling mists may lower !"
                            },
                            {
                                "example_id": "dd01d29a-1dab-4a77-be2c-b77113b23371",
                                "sense_id": "5e2e7b4d-7137-3b82-9371-ac670e308ff0",
                                "text": "And we are here as on a darkling plain\nSwept with confused alarms of struggle and flight,\nWhere ignorant armies clash by night"
                            },
                            {
                                "example_id": "9674c55d-1a34-4de8-8571-2230d27abd9a",
                                "sense_id": "5e2e7b4d-7137-3b82-9371-ac670e308ff0",
                                "text": "The air is cool and it’s darkling, / And calmly flows the Rhine; / The mountain tops are sparkling / In sunset’s parting shrine."
                            },
                            {
                                "example_id": "14e19d72-47ee-44bc-ad39-9fa2d308886a",
                                "sense_id": "5e2e7b4d-7137-3b82-9371-ac670e308ff0",
                                "text": "To us and to an observer about Ripley it would have had precisely the same effect the Martians seemed in solitary possession of the darkling night, lit only as it was by the slender moon, the stars, the after-glow of the daylight[.]"
                            }
                        ]
                    },
                    {
                        "sense_id": "5920c3e4-b7b9-3bc9-8edd-60abfa05eae4",
                        "entry_id": "912973bd-1150-31d6-8ece-dc2d7740c367",
                        "glosses": [
                            "Obscure; taking place unseen, as if in the dark."
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "bd02f753-79c7-33e5-96d0-310632f2ea51",
                "word": "darkling",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "69066bd9-6c3c-3d0a-a721-0534b0fd3a31",
                        "entry_id": "bd02f753-79c7-33e5-96d0-310632f2ea51",
                        "glosses": [
                            "In the dark; in obscurity."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "575c365c-8a16-4b75-b4d6-f281f5db2dfc",
                                "sense_id": "69066bd9-6c3c-3d0a-a721-0534b0fd3a31",
                                "text": "So, out went the candle, and we were left darkling."
                            },
                            {
                                "example_id": "526597d7-3709-40bb-8e25-38c4b3247e24",
                                "sense_id": "69066bd9-6c3c-3d0a-a721-0534b0fd3a31",
                                "text": "As the wakeful bird sings darkling."
                            },
                            {
                                "example_id": "6cc53a56-97d4-4bac-941f-1db36f4ad41c",
                                "sense_id": "69066bd9-6c3c-3d0a-a721-0534b0fd3a31",
                                "text": "I had a dream, which was not all a dream. / The bright sun was extinguish'd, and the stars / Did wander darkling in the eternal space, / Rayless, and pathless, and the icy earth / Swung blind and blackening in the moonless air;"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
