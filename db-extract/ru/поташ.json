                                "target_senses": [
                                    {
                                        "sense_id": "2977c348-ebcc-3bfc-a5a2-b1a50a645798",
                                        "entry_id": "783e50d5-138d-3431-b975-96e695974284",
                                        "glosses": [
                                            "The water-soluble part of wood ash, used for making soap and glass and as a fertilizer (chemically speaking, an impure form of potassium carbonate (K₂CO₃) mixed with other potassium salts)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cfc0963-42aa-3bcc-a585-66500512846d",
                                        "entry_id": "783e50d5-138d-3431-b975-96e695974284",
                                        "glosses": [
                                            "Potassium. Chiefly used in the names of compounds of the form \\\"... of potash\\\"."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1115299c-8249-4a99-86af-4d132bc57611",
                                                "sense_id": "9cfc0963-42aa-3bcc-a585-66500512846d",
                                                "text": "permanganate of potash",
                                                "translation": "potassium permanganate",
                                                "english": "potassium permanganate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ee288a6-aeb3-3ebd-a362-80a6511d1512",
                                        "entry_id": "783e50d5-138d-3431-b975-96e695974284",
                                        "glosses": [
                                            "A class of potassium minerals, of similar applicability to potassium carbonate, such as being a fertilizer. (ie. potassium chloride, potassium hydroxide)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "potash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5353d48-b524-3443-b7c9-1f18c37c9ccc",
                                        "entry_id": "97ba3067-9a31-3bb7-a458-9cdbda1f675b",
                                        "glosses": [
                                            "To treat with potassium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69ddf49a-8727-4ec7-bdab-7419d7475bbf",
                                                "sense_id": "f5353d48-b524-3443-b7c9-1f18c37c9ccc",
                                                "text": "In order to ascertain the difference between the rapidity of pickling when the tin frames had been potashed and pickling without such treatment, two batches were used."
                                            },
                                            {
                                                "example_id": "cca2978d-cccf-4eb6-94e6-48c4f7cb56ca",
                                                "sense_id": "f5353d48-b524-3443-b7c9-1f18c37c9ccc",
                                                "text": "Gold ornaments are sand blasted or steel brushed nicely, then potashed,"
                                            },
                                            {
                                                "example_id": "f506a48f-ebc5-4676-bc78-88fa6f849add",
                                                "sense_id": "f5353d48-b524-3443-b7c9-1f18c37c9ccc",
                                                "text": "After removal from a worker bee they should be potashed in ten percent potassium hydroxide, washed, dehydrated, cleared, and mounted."
                                            },
                                            {
                                                "example_id": "ba39863b-26d2-4af6-8248-cf424b612e33",
                                                "sense_id": "f5353d48-b524-3443-b7c9-1f18c37c9ccc",
                                                "text": "For the extraction of the internal sclerites the aedeagus was potashed in cold saturated KOH solution for several hours and transferred to a vial of distilled water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbc3a703-a3be-47bf-89c0-4893c594e7ea",
                        "source_entry_id": "e28e7e11-e565-38d8-b954-a033d54cf891",
                        "target_lang_word": "Pottasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pottasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed88ca1d-6ca6-3102-94e9-145027d02b60",
                                        "entry_id": "9f436bad-bebf-3a06-b451-595a38d2c92e",
                                        "glosses": [
                                            "Kaliumsalz der Kohlensäure, das unter anderem als Treibmittel zum Backen, als Säureregulator, als Grundstoff für Seifen und als Bestandteil von Glas Verwendung findet"
                                        ],
                                        "tags": [
                                            "Trivialname"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eed8586-427b-441b-af74-1ac5f7cd5f51",
                                                "sense_id": "ed88ca1d-6ca6-3102-94e9-145027d02b60",
                                                "text": "In großer Bütte stand die Wäsche tagelang mit Pottasche eingeweicht in der Bauge – und es regnete."
                                            },
                                            {
                                                "example_id": "d473a32b-c3ca-4b33-8fa5-aa7de8700d75",
                                                "sense_id": "ed88ca1d-6ca6-3102-94e9-145027d02b60",
                                                "text": "»[…] Wer kauft Pottasche und verlangt Ausweis über den eingeäscherten Wald?«"
                                            },
                                            {
                                                "example_id": "2fef4b35-30f6-42c3-be5d-55297fc9e5ea",
                                                "sense_id": "ed88ca1d-6ca6-3102-94e9-145027d02b60",
                                                "text": "Die Bergarbeiter in den Silber- und Kupferminen in der dünnen Luft weit über der Baumgrenze kauen Koka-Blätter mit Pottasche, um den Hunger zu bekämpfen und wach zu bleiben."
                                            },
                                            {
                                                "example_id": "a1c4130c-9b56-4f11-96d6-7ecb98b8541f",
                                                "sense_id": "ed88ca1d-6ca6-3102-94e9-145027d02b60",
                                                "text": "Seife zu rühren ist anstrengend. Ist der Brei dick genug, verwandeln ihn geschickte Hände in \"Seifen-Germknödel\" aus Palmöl und Pottasche."
                                            },
                                            {
                                                "example_id": "2496bcad-cc57-41b9-b5ff-2b93f9e15c69",
                                                "sense_id": "ed88ca1d-6ca6-3102-94e9-145027d02b60",
                                                "text": "Pottasche, ihrer chemischen Zusammensetzung nach gewöhnlich als Kaliumkarbonat bezeichnet, wird vorwiegend im sogenannten Neustaßfurter Verfahren aus den Rückständen der Wollwäscherei und der Zuckerverarbeitung gewonnen: aus Wollschweiß also und aus Melassen. Pottasche dient zur Herstellung von Seifen und wird in der Glasindustrie, in der Farbendruckerei, in der Bleicherei und als Ausgangsprodukt für die Erzeugung weiterer Kalisalze verwandt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
