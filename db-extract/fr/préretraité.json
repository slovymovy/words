                                    {
                                        "sense_id": "e6efdcc4-a8eb-3ac4-bf40-fdcedcb5d32e",
                                        "entry_id": "0beecf0e-1b85-3982-8b10-2081e3081728",
                                        "glosses": [
                                            "Person, die wegen besonderer Umstände frühzeitig Rente bezieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0191932-d27c-4e7b-8354-7efc7d468fb0",
                                                "sense_id": "e6efdcc4-a8eb-3ac4-bf40-fdcedcb5d32e",
                                                "text": "„Zudem sei geplant, dass Frührentner statt bisher 400 Euro künftig bis zur Höhe ihres früheren Nettolohns ohne Abschläge Geld dazu verdienen dürfen.“"
                                            },
                                            {
                                                "example_id": "91a49a32-4215-4f5b-9848-d3984845d8ab",
                                                "sense_id": "e6efdcc4-a8eb-3ac4-bf40-fdcedcb5d32e",
                                                "text": "„Erst als Frührentner kehrten sie 1990 in ihre Heimatstadt Grosny zurück.“"
                                            },
                                            {
                                                "example_id": "20574704-1b30-40b7-96ae-e6519907b9cc",
                                                "sense_id": "e6efdcc4-a8eb-3ac4-bf40-fdcedcb5d32e",
                                                "text": "„Onkel Uli war mit fünfzig Frührentner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
