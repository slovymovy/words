                "senses": [
                    {
                        "sense_id": "39a14170-c62d-3e54-aa6d-c487be95f290",
                        "entry_id": "bfd38d37-3e56-376e-80ae-9e64ec13a79e",
                        "glosses": [
                            "Vorgang, Maßnahme, etwas (ein Gebäude) umzunutzen, für einen anderen Zweck zu verwenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1762a9b4-ee05-4fa7-b7b6-e7d8463a6931",
                                "sense_id": "39a14170-c62d-3e54-aa6d-c487be95f290",
                                "text": "„Nachnutzungen sind hinzunehmen und zum Teil wünschenswert.“"
                            },
                            {
                                "example_id": "530265d2-a8df-4ee8-a818-0088f22cb06b",
                                "sense_id": "39a14170-c62d-3e54-aa6d-c487be95f290",
                                "text": "„In Gebieten mit altem Bergbau, dessen Grubenbaue teilweise oder ganz geflutet sind, ist zu prüfen, ob die durch die Nachnutzung notwendige Sümpfung der Grubenbaue durch Bewegung der Füllsäulen zu Bergschäden führen kann.“"
                            },
                            {
                                "example_id": "4eb6af81-bcff-451c-9258-56adee524ad7",
                                "sense_id": "39a14170-c62d-3e54-aa6d-c487be95f290",
                                "text": "„Bei der Nachnutzung des Chnumtempelbezirks als Wohnbaugebiet wurde die zur Verfügung stehende Fläche nicht von Grund auf neu geplant .“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
