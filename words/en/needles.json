                            },
                            {
                                "target_lang_word": "хвоя",
                                "target_lang_sense_clarification": "иголки хвойных деревьев"
                            },
                            {
                                "target_lang_word": "иголки",
                                "target_lang_sense_clarification": "разговорное обозначение швейных игл или хвои"
