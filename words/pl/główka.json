    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "857e9afd-58ca-3cec-b857-54883aeae33e",
                    "sense_definition": "Mała głowa człowieka lub zwierzęcia; zdrobnienie od słowa <w>głowa</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Małe dziecko położyło zmęczoną <w>główkę</w> na miękkiej poduszce.",
                            "target_lang_translations": {
                                "ru": "Маленький ребёнок положил уставшую <w>головку</w> на мягкую подушку."
                            }
                        },
                        {
                            "text": "Ptak przekrzywił małą <w>główkę</w> i uważnie spojrzał na okruszki chleba.",
                            "target_lang_translations": {
                                "ru": "Птица склонила набок маленькую <w>головку</w> и внимательно посмотрела на хлебные крошки."
                            }
                        }
                    ],
                    "synonyms": [
                        "głowina",
                        "łebek",
                        "łepek"
                    ],
                    "common_phrases": [
                        "mała główka",
                        "rusz główką"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая голова человека или животного; уменьшительно-ласкательное от слова «голова»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "головка",
                                "target_lang_sense_clarification": "маленькая голова ребёнка или животного"
                            },
                            {
                                "target_lang_word": "головушка",
                                "target_lang_sense_clarification": "ласково"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a38a42ff-109c-3e82-8f38-3367de5a4755",
                    "sense_definition": "Zwarta kula liści tworząca jadalną część niektórych warzyw, zwłaszcza kapusty lub sałaty.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rosliny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do przygotowania tradycyjnych gołąbków potrzebna będzie duża <w>główka</w> kapusty.",
                            "target_lang_translations": {
                                "ru": "Для приготовления традиционных голубцов понадобится крупный <w>кочан</w> капусты."
                            }
                        },
                        {
                            "text": "Kupiłem na targu świeżą <w>główkę</w> sałaty na dzisiejszy obiad.",
                            "target_lang_translations": {
                                "ru": "Я купил на рынке свежий <w>кочан</w> салата к сегодняшнему обеду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "główka kapusty",
                        "główka sałaty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотный округлый шар из листьев, образующий съедобную часть некоторых овощей (капусты, салата)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кочан",
                                "target_lang_sense_clarification": "капусты, салата"
                            },
                            {
                                "target_lang_word": "вилок",
                                "target_lang_sense_clarification": "капусты"
                            },
                            {
                                "target_lang_word": "головка",
                                "target_lang_sense_clarification": "капусты, салата"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d33211cb-830d-3aed-bb49-c4c4f3b7cd25",
                    "sense_definition": "Cała, wieloząbkowa cebula czosnku.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rosliny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przepis wymaga, aby dodać całą upieczoną <w>główkę</w> czosnku do sosu.",
                            "target_lang_translations": {
                                "ru": "Рецепт требует добавить в соус целую запечённую <w>головку</w> чеснока."
                            }
                        },
                        {
                            "text": "W spiżarni wisi cały warkocz złożony z wielu <w>główek</w> czosnku.",
                            "target_lang_translations": {
                                "ru": "В кладовой висит целая коса из множества <w>головок</w> чеснока."
                            }
                        }
                    ],
                    "common_phrases": [
                        "główka czosnku"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цельная луковица чеснока, состоящая из зубчиков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "головка",
                                "target_lang_sense_clarification": "чеснока"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2aba19a8-2b14-3968-97df-4b46df873594",
                    "sense_definition": "Zaokrąglone lub poszerzone zakończenie przedmiotu, na przykład szpilki, gwoździa lub zapałki.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "przedmioty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czerwona <w>główka</w> zapałki zapala się pod wpływem mocnego potarcia.",
                            "target_lang_translations": {
                                "ru": "Красная <w>головка</w> спички зажигается от сильного трения."
                            }
                        },
                        {
                            "text": "Uważaj na ostre szpilki z kolorowymi <w>główkami</w> leżące na podłodze.",
                            "target_lang_translations": {
                                "ru": "Осторожно, на полу лежат острые булавки с цветными <w>головками</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "łebek",
                        "łepek"
                    ],
                    "common_phrases": [
                        "główka od szpilki",
                        "główka zapałki"
                    ],
                    "target_lang_definitions": {
                        "ru": "Округлое или расширенное окончание продолговатого предмета (спички, булавки, гвоздя)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "головка",
                                "target_lang_sense_clarification": "спички, булавки"
                            },
                            {
                                "target_lang_word": "шляпка",
                                "target_lang_sense_clarification": "гвоздя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cd85f3e-cede-3567-94d5-9e78b15995fc",
                    "sense_definition": "W piłce nożnej: uderzenie lub skierowanie piłki głową.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Napastnik zdobył decydującą bramkę precyzyjnym uderzeniem z <w>główki</w>.",
                            "target_lang_translations": {
                                "ru": "Нападающий забил решающий гол точным <w>ударом головой</w>."
                            }
                        },
                        {
                            "text": "Po rzucie rożnym obrońca wybił piłkę pewną <w>główką</w> z pola karnego.",
                            "target_lang_translations": {
                                "ru": "После углового защитник уверенным <w>ударом головой</w> выбил мяч из штрафной площади."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strzał z główki",
                        "bramka z główki"
                    ],
                    "target_lang_definitions": {
                        "ru": "В футболе: удар по мячу или передача мяча головой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар головой",
                                "target_lang_sense_clarification": "в футболе"
                            },
                            {
                                "target_lang_word": "игра головой",
                                "target_lang_sense_clarification": "в футболе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66776d31-2a19-3a6a-a127-5a739fc1538f",
                    "sense_definition": "Botaniczny typ zwartego, kulistego kwiatostanu osadzonego na skróconej osi, np. u koniczyny.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na łące pszczoły zbierały nektar z różowych <w>główek</w> koniczyny.",
                            "target_lang_translations": {
                                "ru": "На лугу пчёлы собирали нектар с розовых <w>головок</w> клевера."
                            }
                        },
                        {
                            "text": "Ten gatunek rośliny wykształca charakterystyczne, gęste kwiatostany w formie <w>główki</w>.",
                            "target_lang_translations": {
                                "ru": "Этот вид растений образует характерные плотные соцветия в форме <w>головки</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "główka koniczyny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ботаническое простое соцветие с укороченной утолщённой осью и плотно сидящими цветками (например, у клевера)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "головка",
                                "target_lang_sense_clarification": "тип соцветия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5f85e7f-b78e-3f76-9aaf-bfab99d23fee",
                    "sense_definition": "Część instrumentu strunowego szyjkowego, znajdująca się na końcu gryfu, w której zamocowane są kołki lub klucze.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "muzyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muzyk zamontował nowe stroiki na drewnianej <w>główce</w> swojej gitary.",
                            "target_lang_translations": {
                                "ru": "Музыкант установил новые колки на деревянной <w>головке грифа</w> своей гитары."
                            }
                        },
                        {
                            "text": "Przy upadku instrumentu pękła delikatna <w>główka</w> gryfu skrzypiec.",
                            "target_lang_translations": {
                                "ru": "При падении инструмента треснула хрупкая <w>головка</w> скрипичного грифа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "główka gitary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхняя оконечная часть грифа струнного инструмента, где расположены колки для натяжения струн."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "головка грифа",
                                "target_lang_sense_clarification": "музыкального инструмента"
                            },
                            {
                                "target_lang_word": "головка",
                                "target_lang_sense_clarification": "грифа гитары, скрипки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a697c64b-38f9-392f-a843-62d594a7b68e",
                    "sense_definition": "Krótki, wstępny akapit tekstu dziennikarskiego, streszczający najważniejsze informacje; lead prasowy.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dziennikarstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Redaktor naczelny poprosił o skróconą i bardziej chwytliwą <w>główkę</w> artykułu.",
                            "target_lang_translations": {
                                "ru": "Главный редактор попросил сделать <w>лид</w> статьи более кратким и броским."
                            }
                        },
                        {
                            "text": "W dobrze napisanym materiale prasowym <w>główka</w> od razu przyciąga uwagę czytelnika.",
                            "target_lang_translations": {
                                "ru": "В качественно написанном материале прессы <w>вводка</w> сразу привлекает внимание читателя."
                            }
                        }
                    ],
                    "synonyms": [
                        "lead",
                        "lede",
                        "lid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводный абзац журналистского материала, резюмирующий суть новости; лид."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лид",
                                "target_lang_sense_clarification": "в журналистике"
                            },
                            {
                                "target_lang_word": "вводка",
                                "target_lang_sense_clarification": "вводный абзац статьи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfdb8d16-417d-3234-815d-534bc655a5c7",
                    "sense_definition": "Wodne zakończenie falochronu lub molo, zwykle wyznaczające tor wejściowy do portu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zegluga",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Statek bezpiecznie minął zielone światło na zachodniej <w>główce</w> portu.",
                            "target_lang_translations": {
                                "ru": "Судно благополучно миновало зелёный огонь на западной <w>голове</w> портового мола."
                            }
                        },
                        {
                            "text": "Rybacy obserwowali wzburzone morze, stojąc bezpiecznie za <w>główkami</w> falochronu.",
                            "target_lang_translations": {
                                "ru": "Рыбаки наблюдали за бушующим морем, стоя в безопасности за <w>оголовками</w> волнолома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "główki portu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оконечность мола или волнолома, выдающаяся в воду и обозначающая вход в гавань."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голова",
                                "target_lang_sense_clarification": "мола или волнолома"
                            },
                            {
                                "target_lang_word": "оголовок",
                                "target_lang_sense_clarification": "гидротехнического сооружения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c460ee3-9e1d-3e7d-b9cb-7325157b07cc",
                    "sense_definition": "Krótsza boczna powierzchnia prostopadłościennej cegły lub kamienia budowlanego.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "budownictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Klasyczny wątek murarski polega na naprzemiennym układaniu wozówki oraz <w>główki</w>.",
                            "target_lang_translations": {
                                "ru": "Классическая кирпичная кладка заключается в чередовании ложка и <w>тычка</w>."
                            }
                        },
                        {
                            "text": "W tym starym murze na zewnątrz widoczna jest tylko <w>główka</w> każdej cegły.",
                            "target_lang_translations": {
                                "ru": "В этой старой стене снаружи виден только <w>тычок</w> каждого кирпича."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая торцевая грань прямоугольного кирпича или строительного камня."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тычок",
                                "target_lang_sense_clarification": "короткая грань кирпича"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad3446ab-a9a9-3a01-876c-f6cdbe997c08",
                    "sense_definition": "Przedni narząd czepny tasiemca, zaopatrzony w przyssawki lub haczyki; skoleks.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "zoologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pasożyt przyczepia się do ściany jelita za pomocą haczykowatej <w>główki</w>.",
                            "target_lang_translations": {
                                "ru": "Паразит прикрепляется к стенке кишечника с помощью снабжённого крючьями <w>сколекса</w>."
                            }
                        },
                        {
                            "text": "W badaniu mikroskopowym widoczna była charakterystyczna <w>główka</w> tasiemca.",
                            "target_lang_translations": {
                                "ru": "При микроскопическом исследовании была видна характерная <w>головка</w> солитёра."
                            }
                        }
                    ],
                    "synonyms": [
                        "skoleks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передний орган прикрепления ленточного червя, снабжённый присосками или крючьями; сколекс."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сколекс",
                                "target_lang_sense_clarification": "орган прикрепления ленточного червя"
                            },
                            {
                                "target_lang_word": "головка",
                                "target_lang_sense_clarification": "паразитического червя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ea8aa85-7d8b-3cc4-8fa3-bd0226d884b0",
                    "sense_definition": "Przednia część męskiej komórki rozrodczej zawierająca jądro komórkowe z materiałem genetycznym.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Badanie nasienia wykazało prawidłową budowę anatomiczną <w>główki</w> plemnika.",
                            "target_lang_translations": {
                                "ru": "Анализ семенной жидкости показал правильное анатомическое строение <w>головки</w> сперматозоида."
                            }
                        },
                        {
                            "text": "Akrosom zlokalizowany w przedniej części <w>główki</w> umożliwia wniknięcie do komórki jajowej.",
                            "target_lang_translations": {
                                "ru": "Акросома, расположенная в передней части <w>головки</w>, обеспечивает проникновение в яйцеклетку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "główka plemnika"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передняя расширенная часть сперматозоида, содержащая ядро с генетической информацией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "головка",
                                "target_lang_sense_clarification": "сперматозоида"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c12ecd9d-76ed-3adb-9135-d5a4584237d9",
                    "sense_definition": "W żargonie przestępczym: kara śmierci.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gwara_przestepcza",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W starym grypsie za ten ciężki czyn groziła oskarżonemu bezwzględna <w>główka</w>.",
                            "target_lang_translations": {
                                "ru": "По старым тюремным понятиям за такое тяжкое деяние обвиняемому грозила безоговорочная <w>вышка</w>."
                            }
                        },
                        {
                            "text": "Świadek zeznał, że bandyci bali się surowego wyroku i samej <w>główki</w>.",
                            "target_lang_translations": {
                                "ru": "Свидетель показал, что бандиты боялись сурового приговора и самой <w>высшей меры</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "czerwioch"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gwara więzienna / przestępcza"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В криминальном жаргоне: смертная казнь, высшая мера наказания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вышка",
                                "target_lang_sense_clarification": "жаргон: смертная казнь"
                            },
                            {
                                "target_lang_word": "смертная казнь",
                                "target_lang_sense_clarification": ""
                            }
                        ]
                    }
                }
            ]
        }
    ]
}