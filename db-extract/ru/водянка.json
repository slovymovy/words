                    },
                    {
                        "translation_id": "e0aeb5c2-5893-4a15-8c70-dae9151dcba2",
                        "source_entry_id": "edbb56ef-34d5-3c74-b33a-12e8af57b37e",
                        "source_sense_id": "5a8b1d15-9d06-3e93-aa22-6c65dcf29dce",
                        "target_lang_word": "hydropisie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydropisie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                        "entry_id": "57249e6e-9d0b-3b7a-84d7-bce4048b4739",
                                        "glosses": [
                                            "Accumulation de sérosité dans une cavité quelconque du corps ou dans le tissu cellulaire."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "122874d2-41fe-4224-9599-f644b5eabc64",
                                                "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                                "text": "Hydropisie générale."
                                            },
                                            {
                                                "example_id": "c0359a84-7448-4f4f-a567-da023cb40877",
                                                "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                                "text": "Hydropisie de poitrine."
                                            },
                                            {
                                                "example_id": "70da8422-6c6c-4bdf-b333-cf24f554fa9c",
                                                "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                                "text": "Hydropisie de la tête, des yeux, etc."
                                            },
                                            {
                                                "example_id": "fe1efcbb-46a9-4cca-b574-badec343e503",
                                                "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                                "text": "Monsieur Purgon. – De la dyssenterie dans l’hydropisie.\nArgan. – Monsieur Purgon !\nMonsieur Purgon. – Et de l’hydropisie dans la privation de la vie, où vous aura conduit votre folie."
                                            },
                                            {
                                                "example_id": "6e70f5ea-ee29-4d54-82b1-5af23dac8d49",
                                                "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                                "text": "Je perdis mon père, qui succomba assez subitement à une hydropisie de poitrine."
                                            },
                                            {
                                                "example_id": "9e5be5e5-6f52-4d9e-9def-482e1ad70aca",
                                                "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                                "text": "Maigret, qui regarda machinalement les chevilles d’Anna Gorskine, constata que, comme sa mère le craignait, elle était atteinte d’hydropisie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "205fc48e-f53a-34bf-8e7e-d7fce6cb843d",
                                        "entry_id": "57249e6e-9d0b-3b7a-84d7-bce4048b4739",
                                        "glosses": [
                                            "Dans le langage ordinaire, enflure plus ou moins considérable du bas-ventre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52eec1f3-2998-4992-974b-df34c917f2d6",
                                                "sense_id": "205fc48e-f53a-34bf-8e7e-d7fce6cb843d",
                                                "text": "Dans l’hydropisie, on est toujours altéré."
                                            },
                                            {
                                                "example_id": "d156e0c7-0fe4-4a3a-b88c-6077bc6043b7",
                                                "sense_id": "205fc48e-f53a-34bf-8e7e-d7fce6cb843d",
                                                "text": "Mourir d’hydropisie."
                                            },
                                            {
                                                "example_id": "8bf687e1-cfe0-4400-bd16-1ba29a609750",
                                                "sense_id": "205fc48e-f53a-34bf-8e7e-d7fce6cb843d",
                                                "text": "On soulage l’hydropisie par la ponction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b730c5c0-2b3b-3997-8e3e-4f5bfc317e35",
                                        "entry_id": "57249e6e-9d0b-3b7a-84d7-bce4048b4739",
                                        "glosses": [
                                            "Maladie des poissons caractérisée par un décollement des écailles et un gonflement du corps consécutif à un empoisonnement ou à un virus ayant entraîné une nécrose des viscères de l'animal."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
