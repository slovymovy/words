            "pos": "noun",
            "senses": [
                {
                    "sense_id": "700eae96-c596-3152-ba30-709be74557aa",
                    "sense_definition": "A tough material produced from the skin of animals by tanning, used for making shoes, clothes, and furniture.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My new boots are made of genuine <w>leather</w>.",
                            "target_lang_translations": {
                                "ru": "Мои новые ботинки сделаны из натуральной <w>кожи</w>.",
                                "nl": "Mijn nieuwe laarzen zijn gemaakt van echt <w>leer</w>.",
                                "pl": "Moje nowe buty są zrobione z prawdziwej <w>skóry</w>.",
                                "de": "Meine neuen Stiefel sind aus echtem <w>Leder</w> hergestellt.",
                                "fr": "Mes nouvelles bottes sont en <w>cuir</w> véritable.",
                                "it": "I miei nuovi stivali sono fatti di vera <w>pelle</w>.",
                                "cs": "Moje nové boty jsou vyrobeny z pravé <w>kůže</w>.",
                                "tr": "Yeni botlarım hakiki <w>deriden</w> yapılmıştır.",
                                "es": "Mis botas nuevas están hechas de <w>cuero</w> legítimo.",
                                "zh": "我的新靴子是真<w>皮</w>做的。"
                            }
                        },
                        {
                            "text": "You should polish the <w>leather</w> regularly to keep it soft.",
                            "target_lang_translations": {
                                "ru": "Вам следует регулярно полировать <w>кожу</w>, чтобы она оставалась мягкой.",
                                "nl": "Je moet het <w>leer</w> regelmatig poetsen om het zacht te houden.",
                                "pl": "Powinieneś regularnie pastować <w>skórę</w>, aby zachowała miękkość.",
                                "de": "Du solltest das <w>Leder</w> regelmäßig polieren, damit es weich bleibt.",
                                "fr": "Vous devriez cirer le <w>cuir</w> régulièrement pour qu'il reste souple.",
                                "it": "Dovresti lucidare regolarmente la <w>pelle</w> per mantenerla morbida.",
                                "cs": "Měli byste <w>kůži</w> pravidelně leštit, aby zůstala měkká.",
                                "tr": "Yumuşak kalmasını sağlamak için <w>deriyi</w> düzenli olarak parlatmalısınız.",
                                "es": "Deberías pulir el <w>cuero</w> regularmente para mantenerlo suave.",
                                "zh": "你应该定期擦拭<w>皮革</w>以保持其柔软。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "genuine leather",
                        "shoe leather",
                        "leather goods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочный материал, получаемый из шкур животных путем дубления, используемый для изготовления обуви, одежды и мебели.",
                        "nl": "Een stevig materiaal gemaakt van de huid van dieren door middel van looien, gebruikt voor het maken van schoenen, kleding en meubels.",
                        "pl": "Wytrzymały materiał otrzymywany ze skór zwierzęcych w procesie garbowania, używany do produkcji butów, odzieży i mebli.",
                        "de": "Ein widerstandsfähiges Material, das durch Gerben aus Tierhaut hergestellt wird und zur Herstellung von Schuhen, Kleidung und Möbeln verwendet wird.",
                        "fr": "Matière résistante obtenue à partir de la peau d'animaux par tannage, utilisée pour fabriquer des chaussures, des vêtements et des meubles.",
                        "it": "Un materiale resistente ottenuto dalla pelle di animali mediante concia, utilizzato per fabbricare scarpe, vestiti e mobili.",
                        "cs": "Pevný materiál vyrobený ze zvířecí kůže činěním, používaný k výrobě obuvi, oděvů a nábytku.",
                        "tr": "Hayvan derisinin tabaklanmasıyla elde edilen, ayakkabı, giysi ve mobilya yapımında kullanılan dayanıklı malzeme.",
                        "es": "Material resistente que se obtiene de la piel de los animales mediante el curtido, utilizado para fabricar zapatos, ropa y muebles.",
                        "zh": "一种由动物皮经过鞣制而成的坚韧材料，用于制作鞋子、衣服和家具。"
                    },
