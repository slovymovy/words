                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come out",
                                "target_lang_sense_clarification": "to become available to the public"
                            },
                            {
                                "target_lang_word": "be released",
                                "target_lang_sense_clarification": "of movies, products, or media"
                            },
                            {
                                "target_lang_word": "be published",
                                "target_lang_sense_clarification": "of books, articles, or written works"
                            }
