                ],
                "translations": [
                    {
                        "translation_id": "20bdd06c-4ee9-462f-b005-fec3636432bd",
                        "source_entry_id": "908c7cc0-b2d9-3d98-9fc8-7480895c31d6",
                        "source_sense_id": "9f43eb8e-b634-3729-bbf0-6f6929e11667",
                        "source_sense_description": "transitiv, Rundfunk: abmoderieren",
                        "target_lang_word": "abmoderieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abmoderieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27671846-7808-3d7f-8d39-8e6cee1367cf",
                                        "entry_id": "e7f9b20e-62ba-3ea7-b4fa-42a77d6f9a8e",
                                        "glosses": [
                                            "die abschließenden Worte einer Sendung oder eines Beitrags sprechen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f00bdee5-212e-48a8-bd44-07d2af09dcd6",
                                                "sense_id": "27671846-7808-3d7f-8d39-8e6cee1367cf",
                                                "text": "Die Nachrichtensprecherin moderierte den Beitrag ab."
                                            },
                                            {
                                                "example_id": "80a438c8-27e5-4890-beb2-d67fc024a865",
                                                "sense_id": "27671846-7808-3d7f-8d39-8e6cee1367cf",
                                                "text": "Doch sie wurden von Jauch teilweise so ungeschickt an- und abmoderiert - vor allem die Überleitungen von einem zum anderen Gast gerieten sinnfrei -, dass die Runde wegen ihrer bisweilen unfreiwilligen Komik fast an einen Loriot-Sketch erinnerte."
                                            },
                                            {
                                                "example_id": "72618a68-8690-4757-b921-c0c8cca1e946",
                                                "sense_id": "27671846-7808-3d7f-8d39-8e6cee1367cf",
                                                "text": "Auch am Ende des Interviews hatte es Stronach eilig. Er stand auf und verließ die Sendung, noch ehe Lorenz-Dittlbacher abmoderiert hatte."
                                            },
                                            {
                                                "example_id": "b88abe0f-d344-4e99-9389-38255ab6e697",
                                                "sense_id": "27671846-7808-3d7f-8d39-8e6cee1367cf",
                                                "text": "Das Buch kommt in etwa so kalkuliert produziert daher, wie früher der große Bildband zur Fußballweltmeisterschaft mit Harry Valerien, der auch immer schon verdächtig früh im Buchhandel lag, wenn das Endspiel gerade eben erst abmoderiert war."
                                            },
                                            {
                                                "example_id": "012f74f5-076f-4fe9-8b36-91f1dd6c4935",
                                                "sense_id": "27671846-7808-3d7f-8d39-8e6cee1367cf",
                                                "text": "All die bedenklichen Fakten werden zwar zur Sprache gebracht, dann aber gleich wieder relativiert oder abmoderiert, die Diskussion springt auf Nebenschauplätze wie das Einkommen des selbständigen Narkosearztes, die angeblichen Qualitätsanstrengungen der Krankenkassen oder das Einholen einer zweiten ärztlichen Meinung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
