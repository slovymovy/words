                        "examples": [
                            {
                                "example_id": "abaf4087-431a-4709-87ab-7c222bc409d0",
                                "sense_id": "31fbe50e-e278-3c00-bf8c-5b8de099ba41",
                                "text": "„Die Förster begrüßen den Luchs meist, weil er die Rehe dezimiert, die ihrerseits den Jungwald kahl fressen.“"
                            },
                            {
                                "example_id": "13e9438a-e876-4956-a071-d23a7107eaa7",
                                "sense_id": "31fbe50e-e278-3c00-bf8c-5b8de099ba41",
                                "text": "„Etwa um die Mittagszeit wurden die Hatzrüden in eine mit dichtem Jungwald bestandene Schlucht hineingeschickt.“"
                            }
                        ],
