                "senses": [
                    {
                        "sense_id": "765f5280-45c1-3607-8510-6879f2328b91",
                        "entry_id": "8e70fade-ac8b-3841-8915-46e1c88ae6a5",
                        "glosses": [
                            "Eigenname, der vom Namen der Mutter abgeleitet ist"
                        ],
                        "tags": [
                            "Onomastik"
                        ],
                        "examples": [
                            {
                                "example_id": "9cd26f64-aab3-43e1-9cbc-a71b269032ca",
                                "sense_id": "765f5280-45c1-3607-8510-6879f2328b91",
                                "text": "Niobide ist ein Metronymikon, das sich vom Namen „Niobe“ ableitet."
                            },
                            {
                                "example_id": "70a06de9-2bdc-432c-b08a-8dfaaa6995a8",
                                "sense_id": "765f5280-45c1-3607-8510-6879f2328b91",
                                "text": "„Auch Frauenrufnamen konnten zu Familiennamen werden. Ist es der Name der Mutter, sprechen wir von Metronymika (im Gegensatz zu Patronymika).“"
                            },
                            {
                                "example_id": "2ed0a0e1-8bdb-4822-8efe-87bdc6800d75",
                                "sense_id": "765f5280-45c1-3607-8510-6879f2328b91",
                                "text": "„Mögliche Gründe für die Entstehung von Familiennamen aus weiblichen Vornamen: 1. Benennung nach der Mutter, Metronymika, oder der Ehefrau, Gynäkonymika, weil diese den Vater bzw. Gatten an Abstammung, Vermögen oder Ansehen übertraf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
