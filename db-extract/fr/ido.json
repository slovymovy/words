                                "target_senses": [
                                    {
                                        "sense_id": "7dbbe768-156a-3314-b2b8-55ee3dd252f3",
                                        "entry_id": "0d9548aa-a390-39ea-a3cb-e7035154b356",
                                        "glosses": [
                                            "1907 auf der Basis des Esperanto entwickelte Plansprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "003b4abd-3ac6-466b-9198-cec2c840940f",
                                                "sense_id": "7dbbe768-156a-3314-b2b8-55ee3dd252f3",
                                                "text": "Ido ist eine Plansprache."
                                            },
                                            {
                                                "example_id": "e948187f-e2b0-46ca-a56b-dbb8a0fcf031",
                                                "sense_id": "7dbbe768-156a-3314-b2b8-55ee3dd252f3",
                                                "text": "„Letztlich geht aus dem Streit der Sprachen Esperanto gestärkt hervor, zumal die häufigen Modifikationen und Revisionen des Ido wenig zur Stabilität der Sprache beitragen.“"
                                            }
