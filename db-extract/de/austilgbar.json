                    },
                    {
                        "form_id": "712c5e78-6d1a-4054-a396-8829938d0ae5",
                        "entry_id": "47f2590d-57f4-3183-b9c8-efd8a93192ac",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind austilgbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d390df9f-4297-39d9-bd1e-e8ea18b240d8",
                        "entry_id": "47f2590d-57f4-3183-b9c8-efd8a93192ac",
                        "glosses": [
                            "so, dass es rückstandslos entfernt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcf244ff-912e-481e-8f3b-ad227d45a257",
                                "sense_id": "d390df9f-4297-39d9-bd1e-e8ea18b240d8",
                                "text": "„Auf der anderen Seite bestreitet niemand, daß die Provinz nicht austilgbar ist, solange es ein ‚System anscheinend unentrinnbarer Werte‘ gibt, gegen die sich aufzubäumen einen Weltuntergang bedeutet; insoweit freilich existiert Provinz gelegentlich auch in Berlin-Zehlendorf, zumindest auch in Moabit.“"
                            },
                            {
                                "example_id": "295b25f9-c05b-4318-80f0-6e902b6656f7",
                                "sense_id": "d390df9f-4297-39d9-bd1e-e8ea18b240d8",
                                "text": "„Nie halte man den Zunder zum Enthusiasmus oder gar zur Schwärmerei in der menschlichen Natur ausgetilgt oder austilgbar.“"
                            },
                            {
                                "example_id": "d2f58f5b-77eb-477b-8c62-93d73931560f",
                                "sense_id": "d390df9f-4297-39d9-bd1e-e8ea18b240d8",
                                "text": "„Noch schwerer austilgbar ist jene Nervenschwäche, die in dem psychischen Gebiet wurzelt u. durch gewisse Eigenthümlichkeiten, die durch Erziehung und Ausbildung entstanden sind und die dem innern Menschen angehören, immer irritirend u. vergiftend auf das Nervensystem einwirken.“"
                            },
                            {
                                "example_id": "76ee113d-6528-4853-987c-59d1c6b81f3f",
