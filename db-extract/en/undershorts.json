                        "target_lang_word": "onderbroek",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onderbroek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "093715d7-d1c6-3e3e-bf4f-3a40caaae9d8",
                                        "entry_id": "3f9b3f58-4b58-3e46-8d4d-123515d7f4df",
                                        "glosses": [
                                            "kledingstuk dat onder de gewone broek, direct op de huid wordt gedragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6a703dd-fd21-4e16-9c1a-7d7c4f8ddd3f",
                                                "sense_id": "093715d7-d1c6-3e3e-bf4f-3a40caaae9d8",
                                                "text": "De naad in mijn onderbroek veroorzaakte zoveel pijn dat ik hem uittrok en die avond op het kampvuur ritueel verbrandde."
                                            },
                                            {
                                                "example_id": "2783a8b3-9951-4f05-9ae7-8188fa6d897d",
                                                "sense_id": "093715d7-d1c6-3e3e-bf4f-3a40caaae9d8",
                                                "text": "Ze trokken langzaam hun kleren uit, ze deed niet eens alsof ze weerstand bood, maar toen ze alleen nog haar hemd en onderbroek aanhad, verontschuldigde ze zich en ging naar de badkamer om iets te doen, plassen of een pessarium indoen of wat het ook kon zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34ef0e47-05a7-4950-b9d8-c0bf1bf8aa06",
                        "source_entry_id": "0d900285-ae6f-3d51-ad06-9d2230feac33",
                        "source_sense_id": "c8db854b-0147-399c-9d13-09a3f6a51c1a",
                        "source_sense_description": "underpants",
                        "target_lang_word": "Unterhose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterhose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "103dc520-51a7-3914-9d09-a5eb986874e6",
                                        "entry_id": "ed86da10-9b0e-3599-9b76-b2d1608c0b29",
                                        "glosses": [
                                            "Hose, die direkt am Körper anliegt und unter anderen Kleidungsstücken getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1604871b-060b-4b0d-9e8e-365654dd7775",
                                                "sense_id": "103dc520-51a7-3914-9d09-a5eb986874e6",
                                                "text": "Nach den seinerzeitigen Erkenntnissen ziehen rund 87 Prozent aller Deutschen täglich eine neue Unterhose respektive einen neuen Schlüpfer an."
                                            },
                                            {
                                                "example_id": "d2aa55d9-bbef-4152-af0f-032f1019f68e",
                                                "sense_id": "103dc520-51a7-3914-9d09-a5eb986874e6",
                                                "text": "„In dem Moment kam Húni in die Küche, in Unterhosen und mit einer norwegischen Pizza in einer Packung.“"
                                            },
                                            {
                                                "example_id": "41ad9346-959e-4b08-afa2-7b1fe78dda0b",
                                                "sense_id": "103dc520-51a7-3914-9d09-a5eb986874e6",
                                                "text": "„Ich kam aus dem Bad, Achim lag wieder auf dem Bett, nur in Unterhose und lächelte unsicher.“"
                                            },
                                            {
                                                "example_id": "f4b391a1-ccac-4cd3-be9d-08431bfc13ab",
                                                "sense_id": "103dc520-51a7-3914-9d09-a5eb986874e6",
                                                "text": "„Die Soldaten tragen Socken und Unterhosen im Tornister, vielleicht auch noch ein paar Reserveschuhe.“"
                                            },
                                            {
                                                "example_id": "7da2f348-9a04-43b8-8a44-e2fe46dd965a",
                                                "sense_id": "103dc520-51a7-3914-9d09-a5eb986874e6",
                                                "text": "„Ich schloss die Tür wieder, schlüpfte aus Unterhose, Strumpfhose und Rock, wusch das Blut raus, so gut es ging, und hängte die Sachen auf die Heizung, die wie immer im Iran voll aufgedreht war.“"
                                            },
                                            {
                                                "example_id": "c4c819f8-691b-4b3b-9fe6-379a73d41c75",
                                                "sense_id": "103dc520-51a7-3914-9d09-a5eb986874e6",
                                                "text": "„Die Schlafsäle, an denen sie vorbeikamen, waren vollgestopft mit Kindern, um die 40 pro Raum, die nichts am Leib hatten außer einem dreckigen Hemdchen oder einer dreckigen Unterhose, aber offenbar niemals beides.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
