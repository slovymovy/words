                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba897916-0216-48c7-807d-d547cf5585d9",
                                                "sense_id": "06a2cabc-fd10-3527-8228-a43457dd3dd5",
                                                "text": "We can get subs at that deli."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fa9b536-d820-338c-9f9f-e9d21610d24e",
                                        "entry_id": "00cba8d9-c51e-3d9f-94a6-9105100353c2",
                                        "glosses": [
                                            "Clipping of submersible."
                                        ],
                                        "tags": [
