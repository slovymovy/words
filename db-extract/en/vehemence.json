                                    {
                                        "sense_id": "a8aaacf4-b932-3af3-9a29-f9fd875d6092",
                                        "entry_id": "1a825a12-e757-3bfd-8fe8-cc11f881b7b3",
                                        "glosses": [
                                            "starke Intensität eines Vorgangs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2462a98c-ed30-4890-8de6-794d194c6bb2",
                                                "sense_id": "a8aaacf4-b932-3af3-9a29-f9fd875d6092",
                                                "text": "Von einer solchen Heftigkeit der Unwetter war vorher nicht die Rede."
                                            },
                                            {
                                                "example_id": "f38dd1cb-6f24-4339-b03e-e2b4e99e8fab",
                                                "sense_id": "a8aaacf4-b932-3af3-9a29-f9fd875d6092",
                                                "text": "„Auch das Schneetreiben nahm an Heftigkeit zu.“"
                                            },
                                            {
                                                "example_id": "8f94824d-e14b-4237-934f-ee42c0ca5d77",
                                                "sense_id": "a8aaacf4-b932-3af3-9a29-f9fd875d6092",
                                                "text": "„Der Truck war dieser Heftigkeit nicht gewachsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78c1f905-41b8-36b0-9b8e-993d7be441e7",
                                        "entry_id": "1a825a12-e757-3bfd-8fe8-cc11f881b7b3",
                                        "glosses": [
                                            "starke, emotionale Verhaltensweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e730108a-9554-4b5a-8a53-26fe706300ba",
                                                "sense_id": "78c1f905-41b8-36b0-9b8e-993d7be441e7",
                                                "text": "„Der von beiden stets befürchtete und lange aufgeschobene Streit bricht mit aller Heftigkeit aus.“"
                                            },
                                            {
                                                "example_id": "5def7a84-e2c4-472f-b42f-f90f91e57310",
                                                "sense_id": "78c1f905-41b8-36b0-9b8e-993d7be441e7",
                                                "text": "„Rasch stieß ich zu ihrem schwachen Punkt vor; aber kaum war ich dort, wehrte sie mich ab, doch ohne Heftigkeit und mit weniger ernster Miene.“"
                                            },
                                            {
                                                "example_id": "bb5592ce-321e-4c18-bbe5-52cd4e04fe94",
                                                "sense_id": "78c1f905-41b8-36b0-9b8e-993d7be441e7",
                                                "text": "„Robert bat, seine Heftigkeit zu entschuldigen.“"
                                            },
                                            {
                                                "example_id": "5d472aa4-e80b-49c4-ad2e-adedd5dd51bc",
                                                "sense_id": "78c1f905-41b8-36b0-9b8e-993d7be441e7",
                                                "text": "„Es war bei aller scheinbaren Mäßigung und dem hohen Anstande des Sprechenden eine gewisse Heftigkeit und Bitterkeit des Gefühls zu bemerken, dem man es ansah, daß es Mühe kostete, den verbissenen Ingrimm zurückzuhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6d9d6f0-3801-47df-9723-d9018ac4d662",
