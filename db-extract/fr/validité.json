        "fr-extract.jsonl": [
            {
                "entry_id": "9054de74-c4c6-3f34-a8bf-d2cf12b3fcde",
                "word": "validité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4a7c5302-8219-4518-817f-9d4325b4179c",
                        "entry_id": "9054de74-c4c6-3f34-a8bf-d2cf12b3fcde",
                        "tags": [
                            "plural"
                        ],
                        "form": "validités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c4c69e5-0eda-3dfe-8cfe-8c8d281c330a",
                        "entry_id": "9054de74-c4c6-3f34-a8bf-d2cf12b3fcde",
                        "glosses": [
                            "Caractère de ce qui est valide ou valable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ea23ff6-f8a7-4f42-9ad8-7c1fd6529442",
                                "sense_id": "5c4c69e5-0eda-3dfe-8cfe-8c8d281c330a",
                                "text": "Les députés se demandèrent donc si la sanction royale étaient indispensable à la validité des textes constituants. […]. Les lois constitutionnelles ne devaient donc pas être sanctionnées par le roi."
                            },
                            {
                                "example_id": "3e820be6-b59d-4a01-a4ce-a54200db181d",
                                "sense_id": "5c4c69e5-0eda-3dfe-8cfe-8c8d281c330a",
                                "text": "Cette nomenclature binomiale a été introduite, en botanique d'abord puis en zoologie, par le célèbre naturaliste suédois Cari von Linné (1707- 1778); elle est devenue une règle internationale non sans donner lieu à d’interminables querelles de spécialistes sur sa validité lorsqu'on l'applique aux animaux domestiques."
                            },
                            {
                                "example_id": "b41be005-002b-41d2-9aaf-8cf1680e4955",
                                "sense_id": "5c4c69e5-0eda-3dfe-8cfe-8c8d281c330a",
                                "text": "Les sources d’information appuyant la version alternative se trouvent surtout sur Internet. La validité des faits et des arguments rapportés dans de nombreux sites Web « amateurs » se révèle souvent douteuse ou carrément nulle."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b1d06e0-1298-374e-9675-835548d6580c",
                        "entry_id": "9054de74-c4c6-3f34-a8bf-d2cf12b3fcde",
                        "glosses": [
                            "Force, vertu que certaines choses reçoivent de l’accomplissement des formalités et des conditions qui leur sont nécessaires."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "a9bf6807-8ab4-4217-a38f-16b4f3ee8afb",
                                "sense_id": "7b1d06e0-1298-374e-9675-835548d6580c",
                                "text": "On lui conteste la validité de son titre."
                            },
                            {
                                "example_id": "8a4aef58-0ac5-4985-8584-07566fa8f398",
                                "sense_id": "7b1d06e0-1298-374e-9675-835548d6580c",
                                "text": "La validité d’un acte."
                            },
                            {
                                "example_id": "cb13603e-9c54-40ab-9c2d-ce62dc264fad",
                                "sense_id": "7b1d06e0-1298-374e-9675-835548d6580c",
                                "text": "La durée de validité d’un billet de chemin de fer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df89295b-e6d9-4361-b95d-ca48e2ccca9a",
                        "source_entry_id": "9054de74-c4c6-3f34-a8bf-d2cf12b3fcde",
                        "target_lang_word": "Validität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Validität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "079cb6b4-3ee7-300a-a5ca-fc16c0a01b63",
                                        "entry_id": "72af5b91-74dd-32ec-84fd-a280b2e93cf8",
                                        "glosses": [
                                            "Zuverlässigkeit einer Aussage, Richtigkeit, Rechtsgültigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2130dfa6-d027-4353-b6e1-91c91c438cdb",
                                                "sense_id": "079cb6b4-3ee7-300a-a5ca-fc16c0a01b63",
                                                "text": "Objektivität bildet eine notwendige, wenn auch nicht hinreichende Voraussetzung für die Reliabilität; Reliabilität ist eine notwendige, wenn auch nicht hinreichende Voraussetzung für die Validität."
                                            },
                                            {
                                                "example_id": "460b2c0f-4538-4a5e-bf57-158b61710528",
                                                "sense_id": "079cb6b4-3ee7-300a-a5ca-fc16c0a01b63",
                                                "text": "Die inhaltliche Validität wird einem Test über das Expertenurteil zugebilligt und beruht somit auf subjektiven Einschätzungen."
                                            },
                                            {
                                                "example_id": "caae24a1-5115-4f1b-a674-001c4c30a6af",
                                                "sense_id": "079cb6b4-3ee7-300a-a5ca-fc16c0a01b63",
                                                "text": "„Bezugnehmend auf die Validität der Befragung soll an dieser Stelle noch die Komposition des Inhalts beschrieben werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a94853a2-2c4d-4fd4-9ebd-ee292b99bf24",
                        "source_entry_id": "9054de74-c4c6-3f34-a8bf-d2cf12b3fcde",
                        "target_lang_word": "Gültigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gültigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79c49044-64a4-377e-9cc4-4448d24959d6",
                                        "entry_id": "4509f520-13c0-3bea-83e1-30b2e0b09a80",
                                        "glosses": [
                                            "Eigenschaft, wirksam zu sein/zuzutreffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5b741a2-1c90-4312-b465-c9005513dba2",
                                                "sense_id": "79c49044-64a4-377e-9cc4-4448d24959d6",
                                                "text": "„Und einen Monat später, im Juni, kommen die Isländer zu einem weiteren Treffen zusammen, dessen Entscheidungen auf der gesamten Insel Gültigkeit haben: zum Althing - einem in Europa einzigartigen Plenum.“"
                                            },
                                            {
                                                "example_id": "2efd9a2f-e698-48ed-b11e-5470fc4b0e22",
                                                "sense_id": "79c49044-64a4-377e-9cc4-4448d24959d6",
                                                "text": "„Es ist seine Entscheidung, er hat seine künftige Stellung verhandelt, aber damit der Vertrag dann auch Gültigkeit hat, muss das kurfürstliche Placet dazukommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0b78864-7cd1-449e-8abd-f6eb90fe1fb1",
                        "source_entry_id": "9054de74-c4c6-3f34-a8bf-d2cf12b3fcde",
                        "target_lang_word": "Wirksamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wirksamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88a72f6c-9680-34fa-97ff-a5dcab6bf20c",
                                        "entry_id": "aea2de10-a07a-3326-9ed1-77433a343b9b",
                                        "glosses": [
                                            "das Wirksamsein; der Grad, in dem etwas wirksam ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb13d6d1-c12c-4cca-b7e7-70d0b6e2379c",
                                                "sense_id": "88a72f6c-9680-34fa-97ff-a5dcab6bf20c",
                                                "text": "„Bei der Beurteilung der Wirksamkeit und der Sicherheit osteopathischer Verfahren sind einige grundlegende Aspekte zu berücksichtigen.“"
                                            },
                                            {
                                                "example_id": "7288b8ec-70c0-43e7-b542-3247d5729dd0",
                                                "sense_id": "88a72f6c-9680-34fa-97ff-a5dcab6bf20c",
                                                "text": "„Sie begann ihre Wirksamkeit erst wieder, als Robert durch eine schmale Seitentür in das Arbeitszimmer des Kommissars beordert wurde.“"
                                            },
                                            {
                                                "example_id": "aed22366-884d-4f75-98c4-00e430d39efc",
                                                "sense_id": "88a72f6c-9680-34fa-97ff-a5dcab6bf20c",
                                                "text": "„Diesen Trick verriet der niemals seine Wirksamkeit aus den Augen verlierende Charismatiker dem jungen Johann Matz, der es als Mathesius in seinen Luther-Historien weitererzählte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
