                "senses": [
                    {
                        "sense_id": "34a7e002-e6b7-3ccd-bf86-ef3d9f1d42b8",
                        "entry_id": "9ee365db-ddf8-34fc-9ee2-d73338631cf8",
                        "glosses": [
                            "is de studie en de wetenschap van de theoretische fundamenten van informatie en het rekenen, de theoretische informatica, en de implementatie en toepassing in computersystemen"
                        ],
                        "tags": [],
