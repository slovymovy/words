                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Iroquois",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3fd3d6f-aec5-3286-b089-84e08dffce76",
                                        "entry_id": "def66204-fda0-3b3d-b334-72534fef7dc9",
                                        "glosses": [
                                            "A member of a confederacy of (originally) five Native American (Indian) tribes: the Mohawks, the Oneidas, the Onondagas, the Cayugas, and the Senecas. Also known as the Iroquois League."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "656b300f-5e82-3876-a3c2-13c25c9c2f4a",
                                        "entry_id": "def66204-fda0-3b3d-b334-72534fef7dc9",
                                        "glosses": [
                                            "A kind of hairdo where both sides of the head are shaved, leaving only a stripe of hair in the middle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Iroquois",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
