                "senses": [
                    {
                        "sense_id": "6096e921-39dc-30fb-92b5-09ae26fd0df2",
                        "entry_id": "de1a613f-dfa3-3b7c-85a9-bca81b643da6",
                        "glosses": [
                            "Se couronner soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20b97277-98d7-46a8-b6a8-687ea4cf8445",
                                "sense_id": "6096e921-39dc-30fb-92b5-09ae26fd0df2",
                                "text": "Je pense que le latin est de Loisel et la traduction de Pasquier, lequel n’a pas voulu s’autocouronner."
                            },
                            {
                                "example_id": "f991f804-2905-4411-994e-72e915adf9b7",
                                "sense_id": "6096e921-39dc-30fb-92b5-09ae26fd0df2",
                                "text": "Censure hypocrite de la bienséance, alors que seuls les actes comptent : pour l’homme moderne la tentation de l’orgueil restera de s’autocouronner."
                            },
                            {
                                "example_id": "9a60759a-7884-4697-a90c-a2dbeba9d02e",
                                "sense_id": "6096e921-39dc-30fb-92b5-09ae26fd0df2",
                                "text": "Je vois facilement Kanye West s'autocouronner nouveau roi de la pop musique."
                            }
                        ]
                    }
