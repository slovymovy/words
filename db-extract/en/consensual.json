                        "sense_id": "6474e6ef-f98c-31f8-b223-fdb617d6924a",
                        "entry_id": "c08cbfd3-cdc6-3919-8ada-77cc178ec078",
                        "glosses": [
                            "With permission, with consensus, without coercion; allowed without objecting or resisting."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e60584f0-cf90-4b34-af9a-96b44de6047e",
                                "sense_id": "6474e6ef-f98c-31f8-b223-fdb617d6924a",
                                "text": "He'd operated on an almost permanent adrenaline high, a byproduct of youth and proficiency, jacked into a custom cyberspace deck that projected his disembodied consciousness into the consensual hallucination that was the matrix."
                            },
                            {
                                "example_id": "67f815b2-478c-40d8-9eb1-7e498d896891",
                                "sense_id": "6474e6ef-f98c-31f8-b223-fdb617d6924a",
                                "text": "consensual sex"
                            }
                        ]
                    },
                    {
                        "sense_id": "95a0b710-ee30-35c1-acf0-8e66f1530921",
                        "entry_id": "c08cbfd3-cdc6-3919-8ada-77cc178ec078",
                        "glosses": [
