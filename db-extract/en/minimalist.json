                                    {
                                        "sense_id": "e73e1b7e-aab7-3c7d-b48e-20dfa1f2284a",
                                        "entry_id": "90c95d11-b669-380a-934a-f63e7bae8d1f",
                                        "glosses": [
                                            "Qui se contente d’un minimum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "225e99c6-7fc2-46c9-93d1-ac1cb2800ffb",
                                                "sense_id": "e73e1b7e-aab7-3c7d-b48e-20dfa1f2284a",
                                                "text": "Adopter une position minimaliste."
                                            },
                                            {
                                                "example_id": "95f83d14-c4b2-45f1-a190-4ffde21ed839",
                                                "sense_id": "e73e1b7e-aab7-3c7d-b48e-20dfa1f2284a",
                                                "text": "Des jeunes vont choisir d'aller vers des téléphones minimalistes pour mieux se concentrer, pour éviter d'être constamment distraits et tentés par des applications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "053ecdf0-02f8-3764-b6ea-9536b54bb77a",
                                        "entry_id": "90c95d11-b669-380a-934a-f63e7bae8d1f",
                                        "glosses": [
                                            "Relatif au minimalisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ab856e-cf5d-4486-a39a-072eb605d7b7",
                                                "sense_id": "053ecdf0-02f8-3764-b6ea-9536b54bb77a",
                                                "text": "Du design minimaliste."
                                            },
                                            {
                                                "example_id": "629297d3-0e61-43cc-a601-f50e9f34e8fa",
                                                "sense_id": "053ecdf0-02f8-3764-b6ea-9536b54bb77a",
                                                "text": "L’artiste François Morellet, précurseur du minimalisme, est mort\nPeintre, graveur et sculpteur, l’artiste français est décédé ce mercredi 11 mai à l’âge de 90 ans. Il restera notamment célèbre pour ses œuvres lumineuses réalisées à partir de néons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "minimaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1093b482-85f8-3181-8fe1-c3d0bd4ee778",
                                        "entry_id": "f00208af-283f-3107-ae1e-dd0f30b06634",
                                        "glosses": [
                                            "Personne qui se contente du minimum, qui recherche un minimum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5189720e-e700-4a5f-8c06-89a14dc35a30",
                                                "sense_id": "1093b482-85f8-3181-8fe1-c3d0bd4ee778",
                                                "text": "Certains déconsomment pour se sentir mieux, c’est le cas des minimalistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e97dc2b5-b33f-3fc1-82ab-c54730c394cf",
                                        "entry_id": "f00208af-283f-3107-ae1e-dd0f30b06634",
                                        "glosses": [
                                            "Artiste appartenant au minimalisme, au courant de l'art minimal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "534918b3-8780-45ee-a71c-f372cb051265",
                                                "sense_id": "e97dc2b5-b33f-3fc1-82ab-c54730c394cf",
                                                "text": "C’est un minimaliste de la première heure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
