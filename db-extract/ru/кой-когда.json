                    {
                        "translation_id": "70446115-30b2-4c04-9822-6a4f67d38368",
                        "source_entry_id": "4f25b73e-0ad2-35bf-a968-9a8b883aff4a",
                        "source_sense_id": "e93aa95d-c1be-3730-8c43-12c4211e2f28",
                        "target_lang_word": "hie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e277256c-3618-32c0-857e-c30466f50e56",
                                        "entry_id": "70ef7229-0c20-3739-98f3-a107a4f16d8d",
                                        "glosses": [
                                            "hier, an diesem Ort, in diesem Fall, in dieser Zeit"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5bbfcf5-ad4d-4f9c-bb34-3eea4368d511",
                                                "sense_id": "e277256c-3618-32c0-857e-c30466f50e56",
                                                "text": "„Hie gilts nicht den Brei im Maul wälzen, und mum mum sagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1cc59750-74f1-372a-80b7-ac12eb39dff1",
                                        "entry_id": "70ef7229-0c20-3739-98f3-a107a4f16d8d",
                                        "glosses": [
                                            "hier"
                                        ],
                                        "tags": [
                                            "in den Wendungen hie und hie und hie und da"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d320b686-755b-4fb4-b046-10df78989d40",
                                                "sense_id": "1cc59750-74f1-372a-80b7-ac12eb39dff1",
                                                "text": "Europa war in zwei Lager gespalten, hie die Sieger und hie die Verlierer."
                                            },
                                            {
                                                "example_id": "c754f7d2-14bf-4c22-a8df-c377bde11177",
                                                "sense_id": "1cc59750-74f1-372a-80b7-ac12eb39dff1",
                                                "text": "Hie und da guckt bereits ein Krokus aus der Schneedecke."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1384b1ec-7b64-4d2b-b10a-61724693da91",
                        "source_entry_id": "4f25b73e-0ad2-35bf-a968-9a8b883aff4a",
                        "source_sense_id": "e93aa95d-c1be-3730-8c43-12c4211e2f28",
                        "target_lang_word": "hie und da",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hie und da",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53bc053b-7e0d-35b9-8c24-429b582aeee8",
                                        "entry_id": "12639021-2da7-3fe6-af03-816f8387884d",
                                        "glosses": [
                                            "an manchen Stellen, an einigen Orten"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c5308a0-83bf-4b2a-a300-a4b63109772a",
                                                "sense_id": "53bc053b-7e0d-35b9-8c24-429b582aeee8",
                                                "text": "Hie und da steht ein einzelner Baum in der weiten Ebene."
                                            },
                                            {
                                                "example_id": "341535a3-0a1f-4d80-912b-c28bb0694862",
                                                "sense_id": "53bc053b-7e0d-35b9-8c24-429b582aeee8",
                                                "text": "„Im Norden der Grafschaft Ruppin, hart an der mecklenburgischen Grenze, zieht sich von dem Städtchen Gransee bis nach Rheinsberg hin (und noch darüber hinaus) eine mehrere Meilen lange Seeenkette durch eine menschenarme, nur hie und da mit ein paar alten Dörfern, sonst aber ausschließlich mit Förstereien, Glas- und Teeröfen besetzte Waldung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9fa1e9ae-0d3e-3abf-9a36-6d9b02bb19b2",
                                        "entry_id": "12639021-2da7-3fe6-af03-816f8387884d",
                                        "glosses": [
                                            "mehr oder weniger oft, gelegentlich, nicht regelmäßig"
                                        ],
                                        "tags": [
                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca67cd51-c0cd-4cc2-af52-79be821c8a0a",
                                                "sense_id": "9fa1e9ae-0d3e-3abf-9a36-6d9b02bb19b2",
                                                "text": "Hie und da geht Doris in die Sauna."
                                            },
                                            {
                                                "example_id": "878dd9a9-2efc-4fb2-be42-4d24ff423ed7",
                                                "sense_id": "9fa1e9ae-0d3e-3abf-9a36-6d9b02bb19b2",
                                                "text": "„Wer verlassen lebt und sich doch hie und da irgendwo anschließen möchte, wer mit Rücksicht auf die Veränderungen der Tageszeit, der Witterung, der Berufsverhältnisse und dergleichen ohne weiteres irgend einen beliebigen Arm sehen will, an dem er sich halten könnte, — der wird es ohne ein Gassenfenster nicht lange treiben.“"
                                            },
                                            {
                                                "example_id": "d6ae33e5-1639-4629-be5a-4da53bbe87da",
                                                "sense_id": "9fa1e9ae-0d3e-3abf-9a36-6d9b02bb19b2",
                                                "text": "„Ob die Bauers so gut sein könnten, hie und da einmal nach den Kindern zu sehen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51dc874c-2856-4ac8-9ae8-ff2ed459adc0",
                        "source_entry_id": "4f25b73e-0ad2-35bf-a968-9a8b883aff4a",
                        "source_sense_id": "e93aa95d-c1be-3730-8c43-12c4211e2f28",
                        "target_lang_word": "parfois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parfois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                        "entry_id": "41dffee8-437e-34ff-ad5d-84cef587bbe6",
                                        "glosses": [
                                            "Quelquefois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce081a8c-286e-4270-83d3-b7f029e8e1b1",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Le père Cotton craignait si peu que ses pénitentes le quittassent, qu’au contraire il leur conseillait d’aller parfois aux autres confesseurs : […]."
                                            },
                                            {
                                                "example_id": "4ef2ee3f-fde7-4796-a1ce-b4a736fe910a",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Cependant, au milieu de la chaussée, des nègres se poursuivaient à coup de boules de neige et parfois, une de ces boules, manquant son but, s’écrasait contre une devanture ; […]."
                                            },
                                            {
                                                "example_id": "b2db85de-7479-4225-93cb-22067e2785ae",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "La masse des véhicules s’avançait dans un grondement […], puis s’arrêtait, bloquée parfois pendant trois heures."
                                            },
                                            {
                                                "example_id": "5944037f-7ca8-4524-b30b-a6df107b8daa",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Ce n'était pas la première fois que des boîtes de singe entraient dans la maison ; parfois des soldats nous en donnaient, mais jamais nous n’en avions rapporté autant."
                                            },
                                            {
                                                "example_id": "888e0b6c-f0b3-4cbd-84bf-92fe41361b15",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "[…], et je me rendis compte que même à Göttingen il pleuvait parfois, les gens pouvaient être maussades, […]."
                                            },
                                            {
                                                "example_id": "2b5829e1-297e-471c-aebc-40ea7d62e048",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Parfois voulues, parfois subies, les migrations introduisent un mode d’organisation réticulaire dans le pavage territorial, d’autant qu’on constate que leur fonctionnement est de plus en plus de type diasporique."
                                            },
                                            {
                                                "example_id": "e82a3c43-c0dc-4408-9e06-fe1da33def02",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Les cinquante titres récupèrent et déroutent, avec un zeste d’ironie et, parfois, avec un léger effet captieux, le lexique sur la pandémie de COVID-19, le vocabulaire et les syntagmes titrés dans les journaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
