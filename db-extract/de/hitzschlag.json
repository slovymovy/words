                "senses": [
                    {
                        "sense_id": "eb6149b8-b116-3da3-96a5-ad1b085ea8b7",
                        "entry_id": "2b974537-6034-38cc-bf48-75e21a098407",
                        "glosses": [
                            "lebensgefährlicher Zustand, der durch starke Hitzeeinwirkung hervorgerufen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77193bdd-83a1-4925-b4a7-30a046912b6f",
                                "sense_id": "eb6149b8-b116-3da3-96a5-ad1b085ea8b7",
                                "text": "Immer wieder passiert es, dass Kinder in geschlossenen PKWs einen Hitzschlag erleiden."
                            },
                            {
                                "example_id": "652f096a-c58d-46cf-a31b-30d81ac843de",
                                "sense_id": "eb6149b8-b116-3da3-96a5-ad1b085ea8b7",
                                "text": "„Mittags mußte man im Schatten liegen, wenn man sich keinen Sonnenbrand holen wollte oder einen Hitzschlag oder einen Sonnenstich.“"
                            },
                            {
                                "example_id": "f1e0bc80-30e2-42c8-b1ac-9e8b68f85a44",
                                "sense_id": "eb6149b8-b116-3da3-96a5-ad1b085ea8b7",
                                "text": "„Jetzt hatte ich nicht nur mit meiner Angst zu tun, einen Hitzschlag zu bekommen oder vom Bike zu fallen, sondern auch damit, ihm den Spaß zu verderben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
