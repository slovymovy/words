                        "glosses": [
                            "Person, die Tiere dressiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4625c056-2e9a-4d84-8c91-6f60fb5081e3",
                                "sense_id": "316053e9-9fa7-3ee9-940b-9a2db13463a0",
                                "text": "Während einer Vorstellung wurde der Dompteur von einem seiner Tiger angegriffen."
