        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e1c63cc4-6a38-3f2a-b84f-5069bd0f46ac",
                "word": "amphiprostyle",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d02d8910-8497-321b-8c9d-c3fc50a04266",
                        "entry_id": "e1c63cc4-6a38-3f2a-b84f-5069bd0f46ac",
                        "glosses": [
                            "Having columns at either end but not along the sides."
                        ],
                        "tags": [
                            "historical",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "996b7252-9dcb-4b8a-b658-b6b7b6041bd7",
                                "sense_id": "d02d8910-8497-321b-8c9d-c3fc50a04266",
                                "text": "This much being sufficiently proved; before I draw the inference in contemplation, I have next to prove, the original temple was amphiprostyle, and hexastyle."
                            },
                            {
                                "example_id": "77aaee35-d5bb-4f8f-938e-79bf0f03bfc7",
                                "sense_id": "d02d8910-8497-321b-8c9d-c3fc50a04266",
                                "text": "Another characteristic of amphiprostyle temples was that of their porticoes, consisting of four columns only."
                            },
                            {
                                "example_id": "f70cc89d-e974-43b8-8660-de456fbc5881",
                                "sense_id": "d02d8910-8497-321b-8c9d-c3fc50a04266",
                                "text": "\"The Ilissos Temple is the first attested amphiprostyle temple in Greek architecture.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0f4a55a-ed23-4fed-82e5-c22d6704487b",
                        "source_entry_id": "e1c63cc4-6a38-3f2a-b84f-5069bd0f46ac",
                        "source_sense_id": "d02d8910-8497-321b-8c9d-c3fc50a04266",
                        "source_sense_description": "having columns at either end but not along the sides",
                        "target_lang_word": "amphiprostyle",
