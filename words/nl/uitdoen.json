                    "sense_id": "c4820f06-4b60-3fd7-9f4d-f7ed05b6ee1f",
                    "sense_definition": "Kledingstukken of schoeisel van het lichaam verwijderen.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "kleding_uitdoen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergeet niet je schoenen <w>uit</w> te <w>doen</w> als je binnenkomt.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>take off</w> your shoes when you come inside.",
                                "ru": "Не забудь <w>снять</w> обувь, когда войдешь.",
                                "pl": "Nie zapomnij <w>zdjąć</w> butów, kiedy wchodzisz do środka.",
                                "de": "Vergiss nicht, deine Schuhe <w>auszuziehen</w>, wenn du reinkommst.",
                                "fr": "N'oublie pas d'<w>enlever</w> tes chaussures quand tu entres.",
                                "it": "Non dimenticare di <w>toglierti</w> le scarpe quando entri.",
                                "cs": "Nezapomeň si při příchodu dovnitř <w>zout</w> boty.",
                                "tr": "İçeri girerken ayakkabılarını <w>çıkarmayı</w> unutma.",
                                "es": "No olvides <w>quitarte</w> los zapatos cuando entres."
                            }
                        },
                        {
                            "text": "Hij <w>deed</w> zijn warme jas <w>uit</w> omdat het binnen erg warm was.",
                            "target_lang_translations": {
                                "en": "He <w>took off</w> his warm coat because it was very warm inside.",
                                "ru": "Он <w>снял</w> свое теплое пальто, потому что внутри было очень тепло.",
                                "pl": "<w>Zdjął</w> swój ciepły płaszcz, ponieważ w środku było bardzo ciepło.",
                                "de": "Er <w>zog</w> seine warme Jacke <w>aus</w>, weil es drinnen sehr warm war.",
                                "fr": "Il a <w>retiré</w> son manteau chaud parce qu'il faisait très chaud à l'intérieur.",
                                "it": "Si <w>tolse</w> il cappotto caldo perché dentro faceva molto caldo.",
                                "cs": "Měl na sobě teplý kabát, který si <w>svlékl</w>, protože uvnitř bylo velmi teplo.",
                                "tr": "İçerisi çok sıcak olduğu için kalın ceketini <w>çıkardı</w>.",
                                "es": "Se <w>quitó</w> el abrigo abrigado porque hacía mucho calor adentro."
                            }
                        }
                    ],
                    "synonyms": [
                        "uittrekken"
                    ],
                    "antonyms": [
                        "aandoen",
                        "aantrekken"
                    ],
                    "common_phrases": [
                        "je schoenen uitdoen",
                        "je jas uitdoen"
                    ],
                    "target_lang_definitions": {
