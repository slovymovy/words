                                    {
                                        "sense_id": "e425be22-fa18-3cd0-9044-a7cedc29a05b",
                                        "entry_id": "518f60a4-bfb0-30e3-8324-9f382cf242cd",
                                        "glosses": [
                                            "The act of making an activity or substance no longer criminalized (no longer a crime, subject to criminal penalties, to perform or possess). (Compare legalization, which often implies regulation.)"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be6c5e7f-6bc7-4d86-beee-6411aee7b407",
                                                "sense_id": "e425be22-fa18-3cd0-9044-a7cedc29a05b",
                                                "text": "the decriminalization of all plant-based psychedelics"
                                            },
                                            {
                                                "example_id": "f3c7063a-789a-45f4-8820-15b92c72b43b",
                                                "sense_id": "e425be22-fa18-3cd0-9044-a7cedc29a05b",
                                                "text": "Some opponents also said federal decriminalization would contribute to more death and injury from impaired drivers using marijuana."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26326883-e2ef-3016-ac7b-3733bf82cc95",
                                        "entry_id": "518f60a4-bfb0-30e3-8324-9f382cf242cd",
                                        "glosses": [
                                            "The act of ceasing to treat a person as a criminal, by making their activities legal or no longer subjecting them to the criminal justice system (but instead possibly the mental healthcare system, etc)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b97bceef-3fe6-4eb0-bf6a-bd7bf3aab316",
                                                "sense_id": "26326883-e2ef-3016-ac7b-3733bf82cc95",
                                                "text": "Most sex work feminists support either the legalization or the decriminalization of sex workers."
                                            }
                                        ]
                                    }
