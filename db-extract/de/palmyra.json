                "senses": [
                    {
                        "sense_id": "3b687773-9787-3d24-9f6b-72328c680862",
                        "entry_id": "5633c2fd-c893-336b-aa65-f96b3234ff4c",
                        "glosses": [
                            "antike Ruinenstadt in Syrien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d446003-28a5-4eb7-9311-0fb57b0dbe1e",
                                "sense_id": "3b687773-9787-3d24-9f6b-72328c680862",
                                "text": "Die Ruinen von Palmyra gehören zum Weltkulturerbe der UNESCO."
                            },
                            {
                                "example_id": "a1d93226-4057-4b6f-af13-00aa3bfdee97",
                                "sense_id": "3b687773-9787-3d24-9f6b-72328c680862",
                                "text": "„Wo bleibt der Aufschrei im Westen über die drohende Zerstörung von Palmyra durch den IS?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f146381-4e0b-48ef-ab13-2f497c907679",
                        "source_entry_id": "5633c2fd-c893-336b-aa65-f96b3234ff4c",
                        "source_sense_id": "3b687773-9787-3d24-9f6b-72328c680862",
                        "source_sense_description": "antike Ruinenstadt in Syrien",
                        "target_lang_word": "Palmyra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palmyra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "237f2457-df62-3cbc-8136-973b3533e62a",
                                        "entry_id": "79733562-c769-30ce-8862-c0f353817399",
                                        "glosses": [
                                            "An ancient city, an oasis in the Syrian Desert, in present-day central Syria, recorded historically from around 2000 BCE, subsequently subject to various empires and destroyed in 273 CE and again in 1400, when it was reduced to a village."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00a5f8ed-f13e-4d44-bea2-c37d53d414d0",
                                                "sense_id": "237f2457-df62-3cbc-8136-973b3533e62a",
                                                "text": "In the mid-fifth century B.C. Herodotus (1:131; 3.8) mentioned the importance of the cult of Al-Ilât, i.e. Allat, in ancient Arabia. Her sanctuary at Palmyra (Pl. XVII), excavated in the 1970s by the Polish mission, is in the neighborhood of the temple of Baal Shamin and lends a special character to the city's western quarter, in which Arab tribes settled during the second century B.C."
                                            },
                                            {
                                                "example_id": "b658a7ad-0032-4173-b8c7-d3ce25bb7274",
                                                "sense_id": "237f2457-df62-3cbc-8136-973b3533e62a",
                                                "text": "The chief man in Palmyra had been charged by Rome to police the trade routes, paying for his militia from his own well-stuffed coffers as befitted a rich man with a civic conscience."
                                            },
                                            {
                                                "example_id": "49756b23-3651-4417-8cad-063b20210cc8",
                                                "sense_id": "237f2457-df62-3cbc-8136-973b3533e62a",
                                                "text": "Edessa lies just under 300 kilometres north of Palmyra as the crow flies, and its Aramaic dialect, known today as Syriac, is closely related to that of Palmyra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f53547ee-552b-3b1f-854d-69b9c51a82a4",
                                        "entry_id": "79733562-c769-30ce-8862-c0f353817399",
                                        "glosses": [
                                            "A city, the county seat of Marion County, Missouri, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40111178-7b83-3cb4-8cf4-90cc7698265b",
                                        "entry_id": "79733562-c769-30ce-8862-c0f353817399",
                                        "glosses": [
                                            "A census-designated place, the county seat of Fluvanna County, Virginia, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05482965-8421-3945-91ab-53b401fa1821",
                                        "entry_id": "79733562-c769-30ce-8862-c0f353817399",
                                        "glosses": [
                                            "A number of townships in the United States, listed under Palmyra Township."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee46814b-4fce-484a-81a0-f94eaa0c0c74",
                        "source_entry_id": "5633c2fd-c893-336b-aa65-f96b3234ff4c",
                        "source_sense_id": "3b687773-9787-3d24-9f6b-72328c680862",
                        "source_sense_description": "antike Ruinenstadt in Syrien",
                        "target_lang_word": "Palmyre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palmyre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37c0c1c8-8636-3784-b606-6bc6de006a19",
                                        "entry_id": "cb37f4eb-584a-334a-9d2c-a325084885e7",
                                        "glosses": [
                                            "Ville de Syrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92036324-3ae7-4aa2-b104-df266b27f989",
                                                "sense_id": "37c0c1c8-8636-3784-b606-6bc6de006a19",
                                                "text": "Par bonheur, ils étaient arrivés près de la piste menant de Deir-er-Zoor à Palmyre, où des méharistes les retrouvèrent et les sauvèrent."
                                            },
                                            {
                                                "example_id": "9077fc1d-b431-4c7c-8892-3d57f35614e8",
                                                "sense_id": "37c0c1c8-8636-3784-b606-6bc6de006a19",
                                                "text": "En 2015, Palmyre était peuplée de 90 000 habitants. Aujourd’hui on estime que près de 1 500 personnes y vivent."
                                            },
                                            {
                                                "example_id": "816fe64c-a31f-4c81-8de1-756e6782419e",
                                                "sense_id": "37c0c1c8-8636-3784-b606-6bc6de006a19",
                                                "text": "Des archives semblent d'ailleurs avoir été conservées au Proche-Orient dès l'époque antique : à Hegra, les copies de certains documents étaient déposées dans un temple, tandis qu'à Palmyre existait peut-être un bureau des archives."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Palmyre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e101ba8-eadf-3c14-80a8-c5e1693aa6de",
                                        "entry_id": "96f9e8ac-8e75-3c31-bc07-7349933ab62c",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcdd0f95-91a3-49a4-a1d9-da41f604a8f0",
                                                "sense_id": "0e101ba8-eadf-3c14-80a8-c5e1693aa6de",
                                                "text": "Chez le pharmacien de la rue Grande, parmi les dorures, Palmyre, éreintée et debout, attendait qu’on lui préparât une potion pour son frère, malade depuis une semaine : quelque sale drogue qui lui mangeait vingt sous, sur les quarante si durement gagnés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4819094e-98c9-3b44-b79a-432417cb7da9",
