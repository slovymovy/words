{
    "word_family": [
        "hurler",
        "hurling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ef7ec1b-efdd-38c4-8274-66575e789734",
                    "sense_definition": "To throw something with great force.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "throw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry protester <w>hurled</w> a stone at the police line.",
                            "target_lang_translations": {
                                "nl": "De boze demonstrant <w>smeet</w> een steen naar de politielinie."
                            }
                        },
                        {
                            "text": "The athlete <w>hurled</w> the heavy metal ball as far as he could.",
                            "target_lang_translations": {
                                "nl": "De atleet <w>wierp</w> de zware metalen bal zo ver als hij kon."
                            }
                        }
                    ],
                    "synonyms": [
                        "throw",
                        "fling",
                        "toss",
                        "cast"
                    ],
                    "common_phrases": [
                        "hurl oneself"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets met grote kracht werpen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "smijten",
                                "target_lang_sense_clarification": "Iets met kracht gooien of werpen."
                            },
                            {
                                "target_lang_word": "werpen",
                                "target_lang_sense_clarification": "Iets met een krachtige zwaai van de arm wegwerpen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6da727f-4bd0-3571-9577-86e8d0da3fdb",
                    "sense_definition": "To shout insults or angry words at someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbal_attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd began to <w>hurl</w> insults at the referee after the controversial decision.",
                            "target_lang_translations": {
                                "nl": "De menigte begon beledigingen naar de scheidsrechter te <w>schreeuwen</w> na de controversiële beslissing."
                            }
                        },
                        {
                            "text": "They <w>hurled</w> abuse at the politician as he walked to his car.",
                            "target_lang_translations": {
                                "nl": "Ze <w>scholden</w> de politicus uit terwijl hij naar zijn auto liep."
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "yell"
                    ],
                    "common_phrases": [
                        "hurl abuse",
                        "hurl insults"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand beledigingen of boze woorden toeschreeuwen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "toeschreeuwen",
                                "target_lang_sense_clarification": "Iemand boos of beledigend toespreken."
                            },
                            {
                                "target_lang_word": "uitschelden",
                                "target_lang_sense_clarification": "Iemand beledigende woorden toevoegen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1f2f1a0-a35e-314b-b7e0-68a57a7c7a73",
                    "sense_definition": "To vomit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vomit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt so sick after the roller coaster that he had to <w>hurl</w>.",
                            "target_lang_translations": {
                                "nl": "Hij voelde zich zo misselijk na de achtbaan dat hij moest <w>overgeven</w>."
                            }
                        },
                        {
                            "text": "The smell of the rotten food made her want to <w>hurl</w>.",
                            "target_lang_translations": {
                                "nl": "De geur van het rotte eten deed haar <w>kokhalzen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vomit",
                        "puke",
                        "throw up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Overgeven of braken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "overgeven",
                                "target_lang_sense_clarification": "De maaginhoud uitbraken."
                            },
                            {
                                "target_lang_word": "spugen",
                                "target_lang_sense_clarification": "Informele term voor overgeven."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d9ec5ba-f675-3f8c-830e-a910f110dd1a",
                    "sense_definition": "To play the Irish sport of hurling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He grew up in County Cork and learned to <w>hurl</w> at a very young age.",
                            "target_lang_translations": {
                                "nl": "Hij groeide op in County Cork en leerde op zeer jonge leeftijd <w>hurling spelen</w>."
                            }
                        },
                        {
                            "text": "Many local teenagers gather on the field every weekend to <w>hurl</w>.",
                            "target_lang_translations": {
                                "nl": "Veel lokale tieners verzamelen zich elk weekend op het veld om te <w>hurlen</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Ireland."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De Ierse sport hurling beoefenen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "hurling spelen",
                                "target_lang_sense_clarification": "De specifieke Ierse sport beoefenen."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf348216-efad-3ac2-874a-28182694c3d9",
                    "sense_definition": "A powerful or violent throw.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "throw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a mighty <w>hurl</w>, he sent the javelin flying across the field.",
                            "target_lang_translations": {
                                "nl": "Met een krachtige <w>worp</w> liet hij de speer over het veld vliegen."
                            }
                        },
                        {
                            "text": "The athlete prepared for his final <w>hurl</w> of the competition.",
                            "target_lang_translations": {
                                "nl": "De atleet bereidde zich voor op zijn laatste <w>worp</w> van de wedstrijd."
                            }
                        }
                    ],
                    "synonyms": [
                        "throw",
                        "fling",
                        "toss"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een krachtige of gewelddadige worp."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "worp",
                                "target_lang_sense_clarification": "De actie van het werpen."
                            },
                            {
                                "target_lang_word": "smijtbeweging",
                                "target_lang_sense_clarification": "Een krachtige beweging waarbij iets wordt weggesmeten."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "910449a0-b518-32cf-8c68-3e17bc7e3f6a",
                    "sense_definition": "Vomit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vomit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The janitor had to clean up the <w>hurl</w> left on the sidewalk.",
                            "target_lang_translations": {
                                "nl": "De conciërge moest de <w>kots</w> opruimen die op het trottoir lag."
                            }
                        },
                        {
                            "text": "He felt disgusted by the sight of the <w>hurl</w> on the floor.",
                            "target_lang_translations": {
                                "nl": "Hij voelde zich walgen bij het zien van het <w>braaksel</w> op de vloer."
                            }
                        }
                    ],
                    "synonyms": [
                        "vomit",
                        "puke"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Very informal and potentially offensive."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Braaksel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "braaksel",
                                "target_lang_sense_clarification": "Het uitgebraakte materiaal."
                            },
                            {
                                "target_lang_word": "kots",
                                "target_lang_sense_clarification": "Zeer informele en platte term voor braaksel."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}