                "senses": [
                    {
                        "sense_id": "474a0c89-c419-3f9c-b0c7-5f9eceabd8ad",
                        "entry_id": "5b3c7504-509c-3bfe-aafd-9e1d41b0bb06",
                        "glosses": [
                            "Établir une stratégie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6afe89a0-9e8b-4bb6-9fde-0cb408dd2f68",
                                "sense_id": "474a0c89-c419-3f9c-b0c7-5f9eceabd8ad",
                                "text": "En plus je possède un casque avec micro pour qu’on puisse stratégifier en combat."
                            },
                            {
                                "example_id": "334318a0-1728-4983-9f3f-f1c9b94b0a14",
                                "sense_id": "474a0c89-c419-3f9c-b0c7-5f9eceabd8ad",
                                "text": "Pendant que des « animateurs » passent une journée à préparer une réunion, à évaluer, à stratégifier, etc., durant ce temps les travailleurs sont enfermés dans le bruit de l’usine, ils sont esclaves de la chaîne de montage, ils sont dans le fond de la mine, ils sont branchés sur des structures d’acier, ils sont à respirer les acides, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "13f04791-95a0-3f46-9730-f1c39724bb10",
                        "entry_id": "5b3c7504-509c-3bfe-aafd-9e1d41b0bb06",
                        "glosses": [
                            "Donner un caractère stratégique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff52c20a-a19e-4b5e-83af-090a4775c501",
                                "sense_id": "13f04791-95a0-3f46-9730-f1c39724bb10",
                                "text": "Les choses sont pensées, prévues, gérées, «stratégifiées» de façon à ce qu'il n'y ait pas de galère."
                            }
                        ]
                    }
