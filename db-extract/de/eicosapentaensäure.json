                        "glosses": [
                            "eine mehrfach ungesättigte Fettsäure, Summenformel C₂₀H₃₀O₂"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "434c8817-832c-47d2-a550-3146098837a5",
                                "sense_id": "96d6b9a7-810b-39e2-a311-8ec5c77fa1d4",
                                "text": "Die Eicosapentaensäure reagiert mit Alkoholen zu Estern."
                            },
                            {
                                "example_id": "18560473-6176-4468-afd0-6cec6cbca91b",
                                "sense_id": "96d6b9a7-810b-39e2-a311-8ec5c77fa1d4",
                                "text": "„Wissenschaftliche Studien lassen auf die besondere Bedeutung von Eicosapentaensäure (EPA) zur Stimmungsaufhellung und günstigen Einflussnahme auf Minderung von Depressionen schließen.“"
                            }
                        ],
