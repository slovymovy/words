                "senses": [
                    {
                        "sense_id": "ee2022cd-5b93-3b6d-b86e-5234db96980f",
                        "entry_id": "c7ec277e-22bb-3876-853d-2cfee45753e7",
                        "glosses": [
                            "Dégager les épis de maïs de leurs spathes ou panouilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67a56484-155c-4aa0-9926-fb6c518a5f0f",
                                "sense_id": "ee2022cd-5b93-3b6d-b86e-5234db96980f",
                                "text": "Le soir, à la veillée, en plein air, filles et garçons, nous allions aider à dépanouiller le maïs (retirer l'épi des feuilles)."
                            },
                            {
                                "example_id": "7a422101-aa07-4054-aa85-b1bcfa79778f",
                                "sense_id": "ee2022cd-5b93-3b6d-b86e-5234db96980f",
                                "text": "Ils savent aussi dépanouiller le maïs, enlever les grands cheveux roux qui sortent de l'écosse jaune."
                            }
                        ]
                    }
