                                        "entry_id": "591d744c-1f30-3af3-9760-28b50f34cc16",
                                        "glosses": [
                                            "The son of Zeus and Leto (or Jupiter and Latona), and the twin brother of Artemis (or Diana). He was the god of light, music, medicine, and poetry; and prophecy, dance, manly beauty, and more."
                                        ],
                                        "tags": [
                                            "Greek",
                                            "Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af235876-1f7a-4b66-8c73-9876e9ef6eb1",
                                                "sense_id": "02197ccf-22ab-3d1d-9612-d1248ae8de92",
                                                "text": "‘Blue are the hills that are far away,’ is an owercome in the countryside, and while at first on his side it may have been but a young man’s fancy, to her he was like the god Apollo descending from the skies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d35043d0-3ab0-3e6d-b041-324c5189166c",
                                        "entry_id": "591d744c-1f30-3af3-9760-28b50f34cc16",
                                        "glosses": [
                                            "The planet Mercury, when observed as a Morning Star."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "283e9650-5633-3e0b-a5de-3d18a305fa7e",
