                        "glosses": [
                            "A ball used in the game of bowls"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01825457-4a78-43b5-a76d-f6a5a88548a0",
