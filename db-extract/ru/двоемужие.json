                "senses": [
                    {
                        "sense_id": "0040a38d-7ce8-3eec-9c98-807046690e6e",
                        "entry_id": "a37517b8-a9e1-320b-b01b-925082254e1c",
                        "glosses": [
                            "сожительство (или нахождение в браке) с двумя мужчинами одновременно"
                        ],
                        "tags": [],
