                ],
                "senses": [
                    {
                        "sense_id": "5f7f9c41-51bc-3401-a7ea-f7cff28f180a",
                        "entry_id": "4153e121-318a-306b-9654-64a2d5b8b387",
                        "glosses": [
                            "meist unbebaute Fläche vor einem Bahnhof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49252b83-3863-4302-83a4-a1e06c58b6be",
                                "sense_id": "5f7f9c41-51bc-3401-a7ea-f7cff28f180a",
                                "text": "„Bereits gestern mussten in Gelsenkirchen zahlreiche Polizisten rund 180 Demonstranten aufhalten, die sich vom Bahnhofsplatz Richtung Synagoge bewegten.“"
                            },
                            {
                                "example_id": "a1be1cc0-d052-47ff-93e3-4c03aa9e3b8a",
                                "sense_id": "5f7f9c41-51bc-3401-a7ea-f7cff28f180a",
                                "text": "„Wer den Bahnhofsplatz hinter sich hat und stadteinwärts läuft, kommt unweigerlich am \"Bauhaus-Museum\" vorbei.“"
                            },
                            {
                                "example_id": "18453e56-8c88-4307-9710-6e8dd1a4e53f",
                                "sense_id": "5f7f9c41-51bc-3401-a7ea-f7cff28f180a",
                                "text": "„Der Bahnhofsplatz füllt sich mit Mannschaftswagen der Polizei, drei, acht, ein gutes Dutzend, die sich wie ein Sicherheitskordon dicht an dicht vor die beiden Bars am Platz schieben.“"
                            },
                            {
                                "example_id": "3888007b-7db0-4475-a237-a9618024f89e",
                                "sense_id": "5f7f9c41-51bc-3401-a7ea-f7cff28f180a",
                                "text": "„[…] die vielen Flüchtlinge sitzen alle hier fest, rund um den Bahnhofsplatz in Tovarnik.“"
                            },
                            {
                                "example_id": "fa1cb11b-a942-4088-9fd0-db9be93f0001",
                                "sense_id": "5f7f9c41-51bc-3401-a7ea-f7cff28f180a",
                                "text": "„Die ungarische Regierung lässt zahlreiche Flüchtlinge nicht weiterreisen. Eine Alternative hat sie aber auch nicht. So warten Tausende weiter am Bahnhofsplatz in Budapest.“"
                            },
                            {
                                "example_id": "edc1a076-197f-4648-a578-d60e01706626",
                                "sense_id": "5f7f9c41-51bc-3401-a7ea-f7cff28f180a",
                                "text": "„Wenn wir heute das Wort \"Platz\" benutzen, dann geht dies auf das lateinische Wort \"platea\" zurück, das so viel heißt wie \"breite Strasse\". […] Kombiniert mit dem jeweiligen Gebäude kommt dann der Rathausplatz dabei heraus, der Theaterplatz, der Kirchplatz, der Schloss- oder Bahnhofsplatz.“"
                            },
                            {
                                "example_id": "6280b48a-2b1b-4c33-949f-f5c0b87506db",
                                "sense_id": "5f7f9c41-51bc-3401-a7ea-f7cff28f180a",
                                "text": "[Zapfendorf:] „Hunderte Menschen verfolgten die Enthüllung des neuen Mahnmals durch Bürgermeister Josef Martin (CSU) auf dem Bahnhofsplatz.“"
                            },
                            {
                                "example_id": "5e25efeb-5ca1-439b-a7dc-0af23d806799",
                                "sense_id": "5f7f9c41-51bc-3401-a7ea-f7cff28f180a",
                                "text": "[Schlagzeile:] „Bauarbeiten am Nürnberger Bahnhofsplatz – Diese Straßen sind gesperrt“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d83d6e9a-33e9-3496-9970-dcb737e68cea",
                        "entry_id": "4153e121-318a-306b-9654-64a2d5b8b387",
                        "glosses": [
                            "Eigenname zu [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db4479d2-e399-4cb4-a00c-969f43c5dfae",
                                "sense_id": "d83d6e9a-33e9-3496-9970-dcb737e68cea",
                                "text": "[Zapfendorf:] „Hunderte Menschen verfolgten die Enthüllung des neuen Mahnmals durch Bürgermeister Josef Martin (CSU) auf dem Bahnhofsplatz.“"
                            },
                            {
                                "example_id": "7b67f38c-a6b5-474f-bef5-0806467a59d9",
                                "sense_id": "d83d6e9a-33e9-3496-9970-dcb737e68cea",
                                "text": "[Schlagzeile:] „Bauarbeiten am Nürnberger Bahnhofsplatz – Diese Straßen sind gesperrt“"
                            },
                            {
                                "example_id": "42d8b22c-8017-4ff0-b024-6d26aacdc6ce",
                                "sense_id": "d83d6e9a-33e9-3496-9970-dcb737e68cea",
                                "text": "„Es ist geschafft: Nach mehr als 20 Jahren ist das BR-Korrespondentenbüro Chiemgau in ein neues Gebäude umgezogen. Durch die Entwicklung hin zur Trimedialität wurde der Umzug vom knapp 50 Quadratmeter großen Büro im Stadtzentrum in das Postgebäude am Bahnhofsplatz 4 notwendig.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
