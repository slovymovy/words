                    },
                    {
                        "translation_id": "36c5e327-65e6-48fe-8996-890f3c07d663",
                        "source_entry_id": "126a4528-5b4a-3b6e-9e71-ac341c9ce79f",
                        "source_sense_id": "9b57e9ee-670a-33a3-8327-d3dc266bd000",
                        "target_lang_word": "Arthrologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arthrologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e623ed1-f718-3bf6-a115-d52f4901735d",
                                        "entry_id": "320db718-dafd-3dd6-9d27-acf61ad4671f",
                                        "glosses": [
                                            "Lehre von (anatomischen) Gelenken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14fac53c-8b07-4899-9bbf-a05f7026d7cd",
                                                "sense_id": "9e623ed1-f718-3bf6-a115-d52f4901735d",
                                                "text": "„Ähnlich wie die CT und die MRT hat die Arthroskopie die diagnostischen, aber auch die therapeutischen Möglichkeiten in der Arthrologie entscheidend erweitert.“"
                                            },
                                            {
                                                "example_id": "0c9abca9-087f-49c1-a11b-18e759f94b8a",
                                                "sense_id": "9e623ed1-f718-3bf6-a115-d52f4901735d",
                                                "text": "„Die Arthrologie befaßt sich mit Bau und Funktion der „Bewegungsstellen\" zwischen den durch Muskelkraft bewegten knöchernen Skelettstücken.“"
                                            },
                                            {
                                                "example_id": "cd172d85-d720-4a9e-9f08-3960383a2114",
                                                "sense_id": "9e623ed1-f718-3bf6-a115-d52f4901735d",
                                                "text": "„Ich erinnere nur daran, dass noch jetzt Lehrbücher der Anatomie im Gebrauch sind, welche die Arthrologie unter der Bezeichnung der Syndesmologie abhandeln und durch eine langweilige Aufzählung der Gelenkbänder den Gegenstand erschöpft zu haben glauben.“"
                                            },
                                            {
                                                "example_id": "d8750b7a-a95f-402c-a19d-93185f9ccb35",
                                                "sense_id": "9e623ed1-f718-3bf6-a115-d52f4901735d",
                                                "text": "„Früher war die feline Arthrologie ein überschaubarer Bereich, der sich überwiegend auf Gelenkerkrankungen kleiner Tiere insbesondere in Hinblick auf Hunde bezog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b060721-3472-4aec-b393-ff9060f9b349",
                        "source_entry_id": "126a4528-5b4a-3b6e-9e71-ac341c9ce79f",
                        "source_sense_id": "9b57e9ee-670a-33a3-8327-d3dc266bd000",
