                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ab98e31a-c68c-4141-8cd1-cff565d079a1",
                                "sense_id": "8667c47f-633a-37be-813e-1ef279956833",
                                "text": "Znał różne, stare piernikarskie tajemnice."
                            },
                            {
                                "example_id": "da292a91-9f93-4b71-8d98-ebd1b967f6cf",
                                "sense_id": "8667c47f-633a-37be-813e-1ef279956833",
                                "text": "Zgłębimy tajniki wiedzy piernikarskiej i samodzielnie upieczemy piernik tak, jak to robili przed 500 laty toruńscy mistrzowie"
                            },
                            {
                                "example_id": "616f6527-795e-4758-bf2d-917244559f5c",
                                "sense_id": "8667c47f-633a-37be-813e-1ef279956833",
                                "text": "Gospodarzem pokazu jest słynny mistrz piernikarski Bartłomiej, pomagają mu wiedźma korzenna i czeladnicy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
