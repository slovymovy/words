                        "entry_id": "c0e876aa-c274-3ea9-bffc-f64dc24001b4",
                        "glosses": [
                            "Pflichtarbeitsdienst als ein Teil des nationalsozialistischen Machtapparates im Deutschen Reich der Jahre 1933–1945"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1da9ceff-2d18-4cfc-8539-4a5da9c7a27b",
                                "sense_id": "ce81f5fc-0c8d-3c77-949a-1ac3b5e7cc27",
                                "text": "Der Reichsarbeitsdienst war ein Pflichtarbeitsdienst."
                            },
                            {
                                "example_id": "170a0b45-8e07-452a-ba5c-aadfb2789174",
                                "sense_id": "ce81f5fc-0c8d-3c77-949a-1ac3b5e7cc27",
                                "text": "„Ihn verschlug es nach dem Abitur 1937 im Herbst des gleichen Jahres auf den Oberjochberg bei Hindelang im Allgäu, in das höchstgelegene Barackenlager des Reichsarbeitsdienstes auf rund 1100 Meter Höhe.“"
                            },
                            {
                                "example_id": "c473f102-0eb9-49d4-a1fb-1e3bc860f058",
                                "sense_id": "ce81f5fc-0c8d-3c77-949a-1ac3b5e7cc27",
                                "text": "„Am nächsten Morgen irrte Thomas Lieven durch eine Dienststelle des Reichsarbeitsdienstes in Paris.“"
                            }
                        ],
