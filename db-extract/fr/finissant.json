                "senses": [
                    {
                        "sense_id": "562603a6-9736-31ce-98ef-eb27260f1463",
                        "entry_id": "9c6fa682-4316-3ffb-ab90-57f92791c3ab",
                        "glosses": [
                            "Qui se termine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78428665-58cc-4011-82b0-896ee0ea3b35",
                                "sense_id": "562603a6-9736-31ce-98ef-eb27260f1463",
                                "text": "Rien n’égale le charme mélancolique des longs hivers finissants, alors que des clartés semblent rôder continuellement au bord de l’horizon, et n’osent pas venir."
                            },
                            {
                                "example_id": "88fbd2d3-e2f4-4da2-a859-f0cf813d8e72",
                                "sense_id": "562603a6-9736-31ce-98ef-eb27260f1463",
                                "text": "Tout était triste et grand et doux, dans le soir finissant."
                            },
                            {
                                "example_id": "df6cfc8e-e5b5-4fd0-b307-727c0cae47b9",
                                "sense_id": "562603a6-9736-31ce-98ef-eb27260f1463",
                                "text": "Les Pays de Vilaine n’échappent pas à ce phénomène selon lequel des chercheurs venus de l’extérieur veulent connaître et faire connaître un peu mieux une population charnière entre ce monde finissant et un monde nouveau […]"
                            },
                            {
                                "example_id": "7dc53ac4-53f6-4e44-9faa-1e49e13d0c29",
                                "sense_id": "562603a6-9736-31ce-98ef-eb27260f1463",
                                "text": "Le plus noble vers de la langue latine, aux beaux soirs albigeois de ma jeunesse, enchantait les mêmes douceurs de la lumière finissante, et la majesté de l’ombre envahissante […]"
                            },
                            {
                                "example_id": "e3ba1b65-d4c2-42df-a761-03b8c5b436ac",
                                "sense_id": "562603a6-9736-31ce-98ef-eb27260f1463",
                                "text": "— Même si, un jour, à Knokke-Le-Zoute, je deviens, comme je le redoute, chanteur pour dames finissantes ! En roulant vers notre destination, je ne me lassais pas de me répéter cette phrase."
                            }
                        ]
                    }
                ],
