                {
                    "sense_id": "ff5f0174-e0f5-386a-b439-bd05c694afb7",
                    "sense_definition": "In a state of hurry, panic, or wild activity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intense_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen staff was in a <w>frenzied</w> state as they prepared for the busy dinner rush.",
                            "target_lang_translations": {
                                "nl": "Het keukenpersoneel was in een <w>koortsachtige</w> toestand terwijl ze zich voorbereidden op de drukke avondspits.",
                                "zh": "厨房员工在准备繁忙的晚餐高峰时处于一种<w>忙乱</w>的状态。"
                            }
                        },
                        {
                            "text": "After the announcement, there was a <w>frenzied</w> rush to buy tickets before they sold out.",
                            "target_lang_translations": {
                                "nl": "Na de aankondiging was er een <w>woeste</w> stormloop om kaartjes te kopen voordat ze uitverkocht waren.",
                                "zh": "公告发布后，人们<w>疯狂</w>地抢购门票，生怕售罄。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hectic",
                        "frantic",
                        "manic"
                    ],
                    "antonyms": [
                        "calm",
                        "composed"
                    ],
                    "common_phrases": [
                        "frenzied activity",
                        "frenzied pace"
                    ],
                    "target_lang_definitions": {
                        "nl": "In een toestand van haast, paniek of wilde activiteit.",
                        "zh": "处于匆忙、恐慌或疯狂活动的状态。"
                    },
