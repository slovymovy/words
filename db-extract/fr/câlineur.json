                                        "glosses": [
                                            "Someone or something cuddly, who cuddles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b86d0d0d-6e58-45ae-bd9c-9d9bd231be13",
                                                "sense_id": "a1aade10-8e15-3b48-be75-95a8ba79582e",
                                                "text": "Zoe was a cuddler. Annie swore she had been a cuddler in the womb, so continued..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c43e5efd-03df-352b-9067-88a339be781f",
                                        "entry_id": "4366e32f-43ca-3a31-bfe4-e7b1eb87c70b",
                                        "glosses": [
                                            "Someone who volunteers or works in a hospital by caring for babies (by showing human touch, giving cuddles etc.)"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73c1a1d9-b4d9-432d-b2a4-3cc36add1b23",
                                                "sense_id": "c43e5efd-03df-352b-9067-88a339be781f",
                                                "text": "At the Children's Hospital, an active cuddler's program was developed to provide stimulation for infants whose parents found it difficult to visit on a regualar basis. Cuddlers are recruited from within the hospital and the local community."
                                            },
                                            {
                                                "example_id": "036a2cbf-41e2-4401-afe9-286573eeca83",
                                                "sense_id": "c43e5efd-03df-352b-9067-88a339be781f",
                                                "text": "A volunteer program at St. Vincent Children's Hospital is aimed at taking care of the littlest patients. Nancy Franciscy is one of 15 cuddlers at St. Vincent. The cuddlers are volunteers in the neonatal intensive care unit. The program began in the fall."
                                            }
                                        ]
                                    }
                                ]
                            }
