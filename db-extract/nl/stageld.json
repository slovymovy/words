                "senses": [
                    {
                        "sense_id": "cb2e1969-0493-3c7a-8808-2746de76d7ae",
                        "entry_id": "bfcc0398-0be4-378b-823a-a4b2e2327b63",
                        "glosses": [
                            "geld dat betaald moet worden als men ergens iets wil laten staan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "985667f3-d269-4285-807d-84220053f84d",
                                "sense_id": "cb2e1969-0493-3c7a-8808-2746de76d7ae",
                                "text": "Als de vaste gasten voor 15 september zijn vertrokken krijgen ze het al deels betaalde stageld geretourneerd en 500 euro als bijdrage in de verwijderkosten van de Stichting Twickel."
                            },
                            {
                                "example_id": "14a6fa79-4c74-4dfe-b496-658cd22a902b",
                                "sense_id": "cb2e1969-0493-3c7a-8808-2746de76d7ae",
                                "text": "\"De gemeente vindt zo'n kermisattractie en het stageld kennelijk belangrijker dan mijn bankje. Schande!\" In de brief eist ze het bankje terug. De transportkosten wil ze zelf wel betalen. \"Ik kan het mooi gebruiken voor mijn ontwerp voor de inrichting van het marktplein in Hengelo.\""
                            },
                            {
                                "example_id": "a24b4a18-a244-4b93-adce-2f97d2e05d39",
                                "sense_id": "cb2e1969-0493-3c7a-8808-2746de76d7ae",
                                "text": "De Roelinks runden een paardenhouderij. In een pension werden 13 paarden van derden verzorgd, voor minimaal 3.000 euro stageld per jaar. Volgens advocaat Robers wordt nu, in afwachting van de deal, geen paard meer gehouden. De familie overweegt nieuwbouw, maar ziet ondertussen de bouwkosten stijgen."
                            }
                        ]
                    }
                ],
