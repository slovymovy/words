                "senses": [
                    {
                        "sense_id": "c270a0ef-78d3-387f-ac24-0be3a1e3e4ee",
                        "entry_id": "3397a0cb-8c26-3605-b0d3-af16f27a317b",
                        "glosses": [
                            "Schriftstück für Minderjährige, mit dem ein Erziehungsberechtigter (beispielsweise die Mutter oder der Vater) eine andere volljährige Person für die Dauer einer öffentlichen Tanzveranstaltung (beispielsweise einer Diskothek, einem Konzert) mit der Aufsicht beauftragt"
                        ],
                        "tags": [
                            "Behördendeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "49ee9577-6936-4c5b-992b-9543db09109d",
                                "sense_id": "c270a0ef-78d3-387f-ac24-0be3a1e3e4ee",
                                "text": "Du musst mit dem Erziehungsbeauftragten und der Erziehungbeauftragung zur Einlasskontrolle gehen und den Zettel dort abgeben. Nur dann darfst du, wenn über 16 Jahre alt bist, auch nach Mitternacht in der Disko bleiben."
                            },
                            {
                                "example_id": "0572a961-d66e-4103-9d01-5d29c6a920ff",
                                "sense_id": "c270a0ef-78d3-387f-ac24-0be3a1e3e4ee",
                                "text": "Eine elektronische Erziehungsbeauftragung für das Handy gibt es nicht, die muss eigenhändig auf Papier von einem deiner Eltern unterschrieben sein."
                            },
                            {
                                "example_id": "f5878b23-e107-4ef8-8e53-5f76df6ff521",
                                "sense_id": "c270a0ef-78d3-387f-ac24-0be3a1e3e4ee",
                                "text": "Selbst im Kino kann man eine Erziehungsbeauftragung benötigen, wenn nicht die Eltern den Jugendlichen oder die Jugendliche begleiten."
                            },
                            {
                                "example_id": "07767c95-61d1-4155-a8c8-ee921943ee70",
                                "sense_id": "c270a0ef-78d3-387f-ac24-0be3a1e3e4ee",
                                "text": "In Bayern hat fast jeder Landkreis ein eigenes Formular für die Erziehungsbeauftragung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
