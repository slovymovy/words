                "entry_id": "8b00754e-f86e-3626-aea2-aa3441f6dc83",
                "word": "arbitrage",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4e0d1db9-87e2-41b2-83dc-776fc1c189fa",
                        "entry_id": "8b00754e-f86e-3626-aea2-aa3441f6dc83",
                        "tags": [
                            "plural"
                        ],
                        "form": "arbitrages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f180575-92c6-3287-981a-ac81102c6881",
                        "entry_id": "8b00754e-f86e-3626-aea2-aa3441f6dc83",
                        "glosses": [
                            "A market activity in which a security, commodity, currency or other tradable item is bought in one market and sold simultaneously in another, in order to profit from price differences between the markets."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6c17d52b-ceb0-4d32-a129-faf094e447e1",
                                "sense_id": "8f180575-92c6-3287-981a-ac81102c6881",
                                "text": "But in recent years, for reasons we shall develop later, the field of \"arbitrages and workouts\" became riskier and less profitable."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bbd460a-392a-34a6-9dbf-ff40e5181594",
                        "entry_id": "8b00754e-f86e-3626-aea2-aa3441f6dc83",
                        "glosses": [
                            "Arbitration."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
