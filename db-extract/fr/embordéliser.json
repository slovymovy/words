                ],
                "senses": [
                    {
                        "sense_id": "f5c40653-5335-3745-a9fe-3f402bb77d6e",
                        "entry_id": "f8ccc13e-269e-3c19-b090-40255e46a059",
                        "glosses": [
                            "Mettre le chantier, le bordel dans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb7a20e8-cd62-4898-a31a-5b4ab1a41e4b",
                                "sense_id": "f5c40653-5335-3745-a9fe-3f402bb77d6e",
                                "text": "J'ai toujours pas capté pourquoi ils n'envahissent pas à la mongole tous les établissements du coin pour tout embordéliser, mais je m'en torche."
                            },
                            {
                                "example_id": "8fbef1b7-8c98-42d2-9328-b336b7f9e7de",
                                "sense_id": "f5c40653-5335-3745-a9fe-3f402bb77d6e",
                                "text": "Ce sont ces types-là, Robespierre à leur tête, qui vont embordéliser le petit plan raisonnable des notables."
                            }
                        ]
                    },
                    {
                        "sense_id": "6368de62-a067-3b9c-87a3-255abcda67af",
                        "entry_id": "f8ccc13e-269e-3c19-b090-40255e46a059",
                        "glosses": [
                            "Fréquenter le bordel."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "473a1e10-63b5-4371-96a9-5ba2eca80318",
                                "sense_id": "6368de62-a067-3b9c-87a3-255abcda67af",
                                "text": "Ceux qui en avaient encore la force allaient s’encanailler, s’embordéliser ou s’ensoûler chez madame Kimoto, qui les aidait à faire semblant d’être heureux."
                            }
                        ]
                    }
                ],
