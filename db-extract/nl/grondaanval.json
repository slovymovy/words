                        "examples": [
                            {
                                "example_id": "a5f99de4-051f-45b9-8aea-938921a73284",
                                "sense_id": "16156f4f-976d-3956-8344-47934173aff6",
                                "text": "Bevelhebber Amos zegt dat de twee generaals te weinig militairen hebben ingezet voor het beveiligen van de basis. Ook waren ze niet goed voorbereid op een grondaanval."
                            },
                            {
                                "example_id": "ca7e29f2-60d9-46e4-a67f-415d3129d5d5",
                                "sense_id": "16156f4f-976d-3956-8344-47934173aff6",
                                "text": "Obama vraagt het Congres om toestemming voor een actie. De buitenlandcommissie van de Senaat heeft al ingestemd, op voorwaarde dat er geen grondaanval komt en de actie maximaal negentig dagen duurt."
                            },
                            {
                                "example_id": "d39b7888-aa7b-4d2c-90ac-68dfbfb99e7b",
                                "sense_id": "16156f4f-976d-3956-8344-47934173aff6",
                                "text": "De Amerikanen zullen waarschijnlijk niet wachten op een stemming in de VN-Veiligheidsraad. Na dagen van onderhandelen tussen de Republikeinse en Democratische senatoren, is er een ontwerpresolutie opgesteld over een mogelijke aanval op Syrië. Zo'n aanval mag volgens deze resolutie maximaal 90 dagen duren. Een grondaanval is uitdrukkelijk uitgesloten. Dat benadrukte ook minister Kerry van Buitenlandse Zaken gisteravond tijdens een hoorzitting in de buitenlandcommissie van de Senaat."
                            }
                        ]
                    }
