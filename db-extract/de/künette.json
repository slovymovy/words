                        "glosses": [
                            "Abflussgraben im Fuß von Festungsgräben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "086d117a-3572-43f4-80e9-5a266cbec321",
                                "sense_id": "43893dfa-97ae-3889-a639-b885a3f5d940",
                                "text": "In der Mitte des Grabens befindet sich eine Künette von 10 Fuß Tiefe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "134f85df-2e18-398b-81c8-e80f470aece0",
                        "entry_id": "7ed86c8b-4d44-3c2f-91aa-a1285dda3647",
