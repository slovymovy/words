                                "sense_id": "f1c9b8af-9f49-3dec-810e-aaf5ae15c4f0",
                                "text": "\"Фиг вам!\"",
                                "translation": "\"Screw you!\"",
                                "english": "\"Screw you!\""
                            }
                        ]
                    }
