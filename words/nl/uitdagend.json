                            "target_lang_translations": {
                                "en": "Solving this complex puzzle is a very <w>challenging</w> project for the students."
                            }
                        },
                        {
                            "text": "Zij zoekt een <w>uitdagende</w> baan waarin ze al haar talenten kan gebruiken.",
                            "target_lang_translations": {
