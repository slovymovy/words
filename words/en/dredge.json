{
    "word_family": [
        "dredger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed9a41b9-f472-32a7-a026-3098493abc02",
                    "sense_definition": "To clear out, widen, or deepen a river, harbor, or other body of water using a dredge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excavation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local authorities decided to <w>dredge</w> the canal to allow larger cargo ships to pass through.",
                            "target_lang_translations": {
                                "ru": "Местные власти решили <w>углубить</w> канал, чтобы через него могли проходить более крупные грузовые суда."
                            }
                        },
                        {
                            "text": "They need to <w>dredge</w> the harbor regularly because sand and silt accumulate quickly.",
                            "target_lang_translations": {
                                "ru": "Им необходимо регулярно <w>очищать</w> гавань, так как песок и ил быстро накапливаются."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dredge the harbor",
                        "dredge the river"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очищать, расширять или углублять русло реки, гавань или другой водоем с помощью земснаряда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "углублять",
                                "target_lang_sense_clarification": "дно водоема"
                            },
                            {
                                "target_lang_word": "углубить",
                                "target_lang_sense_clarification": "дно водоема, сов. вид"
                            },
                            {
                                "target_lang_word": "очищать земснарядом",
                                "target_lang_sense_clarification": "водоем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79e3a8fb-ed2e-351d-9296-356323f0c774",
                    "sense_definition": "To bring something up from the bottom of a body of water using a dredge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excavation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists managed to <w>dredge</w> up rare marine specimens from the ocean floor.",
                            "target_lang_translations": {
                                "ru": "Ученым удалось <w>поднять со дна</w> редкие морские экземпляры."
                            }
                        },
                        {
                            "text": "Workers <w>dredged</w> old bicycles and trash from the city's main canal.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>вытащили со дна</w> старые велосипеды и мусор из главного канала города."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dredge up silt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимать что-либо со дна водоема с помощью драги или земснаряда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычерпывать",
                                "target_lang_sense_clarification": "со дна"
                            },
                            {
                                "target_lang_word": "вычерпать",
                                "target_lang_sense_clarification": "со дна, сов. вид"
                            },
                            {
                                "target_lang_word": "доставать со дна",
                                "target_lang_sense_clarification": "с помощью драги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adfa5620-9566-3bd1-90d6-a1c896f04471",
                    "sense_definition": "To sprinkle or coat food lightly with a powdery ingredient, such as flour, sugar, or spices.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>dredge</w> the chicken in flour before frying it to make it crispy.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>обвалять</w> курицу в муке перед жаркой, чтобы она получилась хрустящей."
                            }
                        },
                        {
                            "text": "Gently <w>dredge</w> the fish fillets with seasoned flour before placing them in the hot pan.",
                            "target_lang_translations": {
                                "ru": "Аккуратно <w>присыпьте</w> рыбное филе приправленной мукой, прежде чем класть его на горячую сковороду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dredge with flour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка посыпать или обваливать пищу в порошкообразном ингредиенте, таком как мука, сахар или специи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обваливать",
                                "target_lang_sense_clarification": "в муке или сухарях"
                            },
                            {
                                "target_lang_word": "панировать",
                                "target_lang_sense_clarification": "в муке или специях"
                            },
                            {
                                "target_lang_word": "посыпать",
                                "target_lang_sense_clarification": "мукой или пудрой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cc58643-d1eb-3b61-8192-193f40c2f1b4",
                    "sense_definition": "To unearth, recall, or bring to light something forgotten or hidden, especially something unpleasant.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "recall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no need to <w>dredge</w> up old arguments from years ago.",
                            "target_lang_translations": {
                                "ru": "Нет никакой необходимости <w>ворошить</w> старые споры многолетней давности."
                            }
                        },
                        {
                            "text": "The journalists tried to <w>dredge</w> up secrets from the politician's past.",
                            "target_lang_translations": {
                                "ru": "Журналисты пытались <w>раскопать</w> секреты из прошлого политика."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dredge up the past"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскапывать, вспоминать или извлекать на свет что-то забытое или скрытое, особенно что-то неприятное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворошить",
                                "target_lang_sense_clarification": "прошлое"
                            },
                            {
                                "target_lang_word": "вспоминать",
                                "target_lang_sense_clarification": "старые обиды или прошлое"
                            },
                            {
                                "target_lang_word": "откапывать",
                                "target_lang_sense_clarification": "забытые тайны или факты"
                            },
                            {
                                "target_lang_word": "раскапывать",
                                "target_lang_sense_clarification": "неприятные подробности прошлого"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24f6daf9-882d-3240-91d0-62b97754e56b",
                    "sense_definition": "A machine or barge equipped for clearing, deepening, or widening a body of water.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large suction <w>dredge</w> was anchored in the middle of the bay to clear the shipping lane.",
                            "target_lang_translations": {
                                "ru": "Посреди залива встал на якорь крупный всасывающий <w>земснаряд</w> для очистки судоходного пути."
                            }
                        },
                        {
                            "text": "The port authority purchased a new <w>dredge</w> to maintain the depth of the channel.",
                            "target_lang_translations": {
                                "ru": "Управление порта приобрело новый <w>земснаряд</w> для поддержания глубины фарватера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "suction dredge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Машина или судно, оборудованное для очистки, углубления или расширения водоема."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "земснаряд",
                                "target_lang_sense_clarification": "землесосный снаряд"
                            },
                            {
                                "target_lang_word": "драга",
                                "target_lang_sense_clarification": "плавучее горно-обогатительное судно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "820241c5-56fd-31ea-ab52-4c0bbc171b96",
                    "sense_definition": "An apparatus, such as a dragnet or iron frame with a net, dragged along the sea bottom to gather oysters, shellfish, or biological specimens.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fishermen lowered the oyster <w>dredge</w> into the shallow waters of the bay.",
                            "target_lang_translations": {
                                "ru": "Рыбаки опустили устричную <w>драгу</w> на мелководье залива."
                            }
                        },
                        {
                            "text": "Marine biologists used a specialized <w>dredge</w> to collect organisms living on the seabed.",
                            "target_lang_translations": {
                                "ru": "Морские биологи использовали специальную <w>драгу</w> для сбора организмов, обитающих на морском дне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oyster dredge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приспособление, такое как бредень или железная рама с сетью, протаскиваемое по морскому дну для сбора устриц, моллюсков или биологических образцов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драга",
                                "target_lang_sense_clarification": "рыболовное или исследовательское приспособление"
                            },
                            {
                                "target_lang_word": "бредень",
                                "target_lang_sense_clarification": "сеть для ловли устриц и моллюсков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10938fb1-a757-3189-87e9-b4fdaf6c211c",
                    "sense_definition": "A container with a perforated lid used for sprinkling flour, sugar, or spices onto food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kitchenware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baker used a flour <w>dredge</w> to dust the work surface before kneading the dough.",
                            "target_lang_translations": {
                                "ru": "Пекарь использовал <w>сито для муки</w>, чтобы присыпать рабочую поверхность перед замешиванием теста."
                            }
                        },
                        {
                            "text": "Keep a sugar <w>dredge</w> nearby to sprinkle over the freshly baked pastries.",
                            "target_lang_translations": {
                                "ru": "Держите поблизости <w>баночку для сахарной пудры</w>, чтобы посыпать свежую выпечку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flour dredge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контейнер с перфорированной крышкой, используемый для посыпания пищи мукой, сахаром или специями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сито для пудры",
                                "target_lang_sense_clarification": "или муки"
                            },
                            {
                                "target_lang_word": "дозатор",
                                "target_lang_sense_clarification": "для специй или сахарной пудры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2babeaac-a4b6-3333-95f9-b60158c61375",
                    "sense_definition": "The act or process of clearing or deepening a body of water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "excavation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The environmental impact of the river <w>dredge</w> was carefully analyzed by experts.",
                            "target_lang_translations": {
                                "ru": "Экологические последствия <w>дноуглубления</w> реки были тщательно проанализированы экспертами."
                            }
                        },
                        {
                            "text": "A thorough <w>dredge</w> of the canal is scheduled for next spring.",
                            "target_lang_translations": {
                                "ru": "Тщательная <w>очистка</w> канала запланирована на следующую весну."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс очистки или углубления водоема."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дноуглубление",
                                "target_lang_sense_clarification": "процесс очистки дна"
                            },
                            {
                                "target_lang_word": "драгирование",
                                "target_lang_sense_clarification": "процесс работы драги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "445e8990-c6a2-3353-8e23-8b10819b5797",
                    "sense_definition": "A mixture of oats and barley sown together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historically, farmers in this region cultivated <w>dredge</w> as a reliable feed crop for livestock.",
                            "target_lang_translations": {
                                "ru": "Исторически фермеры в этом регионе выращивали <w>смесь овса и ячменя</w> в качестве надежной кормовой культуры для скота."
                            }
                        },
                        {
                            "text": "The field was sown with <w>dredge</w> to provide a balanced grain mixture at harvest.",
                            "target_lang_translations": {
                                "ru": "Поле было засеяно <w>смесью овса и ячменя</w>, чтобы при сборе урожая получить сбалансированную зерновую смесь."
                            }
                        }
                    ],
                    "synonyms": [
                        "bullimong"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mainly British agriculture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смесь овса и ячменя, посеянных вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смесь овса и ячменя",
                                "target_lang_sense_clarification": "сельскохозяйственная культура"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4a61fb1c-82e9-30da-ba75-1fc5809801d5",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Professor <w>Dredge</w> to deliver the keynote lecture on marine engineering.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили профессора <w>Дреджа</w> выступить с пленарным докладом по морской инженерии."
                            }
                        },
                        {
                            "text": "The historical documents were signed by a merchant named William <w>Dredge</w>.",
                            "target_lang_translations": {
                                "ru": "Исторические документы были подписаны купцом по имени Уильям <w>Дредж</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дредж",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}