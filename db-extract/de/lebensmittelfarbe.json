                    {
                        "sense_id": "98718b16-e627-395d-946e-a32f6d1fd14c",
                        "entry_id": "73b989dd-cfd4-336d-86d4-74bb0e5e4dfe",
                        "glosses": [
                            "Zusatzstoff, der das Aussehen von Lebensmitteln hinsichtlich der Farbe verändert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b205d05-b5f2-41d9-8f8d-d4e5b5901f84",
                                "sense_id": "98718b16-e627-395d-946e-a32f6d1fd14c",
                                "text": "„Als Erwachsener, wenn er sich vor der Arbeit drücken wollte, träufelte Rant sich rote Lebensmittelfarbe in die Augen und erzählte seinem Chef, er habe Bindehautentzündung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "878ce926-b42f-4f39-bc5a-c475fdfcee9d",
                        "source_entry_id": "73b989dd-cfd4-336d-86d4-74bb0e5e4dfe",
