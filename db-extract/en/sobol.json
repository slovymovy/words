                                "example_id": "e2609e5c-5f14-4803-8e08-ee176b846886",
                                "sense_id": "b359fb1d-fd57-3cc2-90dc-4dc6dd680332",
                                "text": "Rhizomes are of two kinds, slender and fleshy. The slender rhizome, or sobol (Fig. 16), is popularly called the creeping stem of the plant."
                            },
                            {
                                "example_id": "f78618ac-6a78-414e-8316-e5a552460a3b",
                                "sense_id": "b359fb1d-fd57-3cc2-90dc-4dc6dd680332",
                                "text": "Stems [...] erect or somewhat decumbent at base, rising from an elongate, rhizome-like, root-bearing organ, representing a sobol of the previous season."
                            }
                        ]
                    }
