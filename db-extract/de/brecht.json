                    }
                ],
                "senses": [
                    {
                        "sense_id": "05d9ca88-9ab8-305c-a146-c8f65bb61814",
                        "entry_id": "33351e89-761f-325e-943e-7e89d032dae0",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a5febc0-4775-4c1b-89a1-896d6ef9cfea",
                                "sense_id": "05d9ca88-9ab8-305c-a146-c8f65bb61814",
                                "text": "Frau Brecht ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dc0df93a-7f38-439e-9263-f99bed0bf0c0",
                                "sense_id": "05d9ca88-9ab8-305c-a146-c8f65bb61814",
                                "text": "Herr Brecht wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "077dc00d-38d8-4674-b5f3-579f0577fafb",
                                "sense_id": "05d9ca88-9ab8-305c-a146-c8f65bb61814",
                                "text": "Die Brechts fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "f0a6b722-729f-4a53-a543-73a361641721",
                                "sense_id": "05d9ca88-9ab8-305c-a146-c8f65bb61814",
                                "text": "Der Brecht trägt nie die Pullover, die die Brecht ihm strickt."
                            },
                            {
                                "example_id": "47a29d1c-8247-4d8c-9c55-5032dae46cff",
                                "sense_id": "05d9ca88-9ab8-305c-a146-c8f65bb61814",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brecht kommt, geht der Herr Brecht.“"
                            },
                            {
                                "example_id": "803c1364-76db-43df-917b-3e4270506409",
                                "sense_id": "05d9ca88-9ab8-305c-a146-c8f65bb61814",
                                "text": "Brecht kommt und geht."
                            },
                            {
                                "example_id": "2bfd3b12-c254-4845-b0cc-c45961cbcb37",
                                "sense_id": "05d9ca88-9ab8-305c-a146-c8f65bb61814",
                                "text": "Brechts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
