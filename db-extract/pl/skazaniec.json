                                        "entry_id": "ec937467-2c29-3b76-bba6-f1ac5b365927",
                                        "glosses": [
                                            "A person convicted of a crime by a judicial body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae699b86-63f4-3173-9718-315ed81cdcab",
                                        "entry_id": "ec937467-2c29-3b76-bba6-f1ac5b365927",
                                        "glosses": [
