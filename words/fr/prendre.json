                    "sense_definition": "Nécessiter ou exiger une certaine quantité de temps ou d'efforts.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "duree_besoin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce travail important va me <w>prendre</w> au moins trois heures complètes."
                        },
                        {
                            "text": "Le trajet jusqu'à la gare lui a <w>pris</w> une demi-heure."
                        }
                    ],
                    "synonyms": [
                        "demander",
                        "nécessiter"
                    ],
                    "common_phrases": [
                        "prendre du temps"
                    ]
                },
                {
                    "sense_id": "619749ff-ede8-3e65-afa3-16bf85a8e3ec",
                    "sense_definition": "Capturer un animal à la chasse ou à la pêche.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "capture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pêcheur a <w>pris</w> trois gros poissons dans la rivière ce matin."
                        },
                        {
                            "text": "Le chat essaie souvent de <w>prendre</w> des oiseaux dans le jardin."
                        }
                    ],
                    "synonyms": [
