    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1b758d3-20c9-3c02-8f4f-0a16b6e68610",
                    "sense_definition": "iemand of iets op een bepaalde manier beschouwen of van mening zijn dat iets zo is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beschouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>acht</w> u zeker daartoe in staat na al uw harde werk.",
                            "target_lang_translations": {
                                "en": "I certainly <w>consider</w> you capable of that after all your hard work."
                            }
                        },
                        {
                            "text": "De commissie <w>acht</w> het noodzakelijk om de regels direct aan te passen.",
                            "target_lang_translations": {
                                "en": "The committee <w>deems</w> it necessary to adjust the rules immediately."
                            }
                        }
                    ],
                    "synonyms": [
                        "beschouwen",
                        "vinden",
                        "houden voor"
                    ],
                    "common_phrases": [
                        "noodzakelijk achten",
                        "mogelijk achten",
                        "in staat achten"
                    ],
                    "target_lang_definitions": {
                        "en": "To consider or deem someone or something in a certain way, or to be of the opinion that something is the case."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consider",
                                "target_lang_sense_clarification": "to think of someone or something in a particular way"
                            },
                            {
                                "target_lang_word": "deem",
                                "target_lang_sense_clarification": "to judge or consider in a formal context"
                            },
                            {
                                "target_lang_word": "regard",
                                "target_lang_sense_clarification": "to think of someone or something in a specified way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "feee18d1-ac65-3c68-b983-0b05b765ef97",
                    "sense_definition": "veel respect of waardering hebben voor iemand",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "respecteren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>achtte</w> mijn schoonvader heel hoog vanwege zijn enorme wijsheid.",
                            "target_lang_translations": {
                                "en": "I <w>esteemed</w> my father-in-law very highly because of his enormous wisdom."
                            }
                        },
                        {
                            "text": "Zij wordt door al haar collega's zeer <w>geacht</w> om haar inzet.",
                            "target_lang_translations": {
                                "en": "She is highly <w>respected</w> by all her colleagues for her commitment."
                            }
                        }
                    ],
                    "synonyms": [
                        "respecteren",
                        "waarderen",
                        "hoogachten"
                    ],
                    "antonyms": [
                        "minachten",
                        "verachten"
                    ],
                    "common_phrases": [
                        "hoog achten",
                        "zeer geacht"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in formele context gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To have a lot of respect or appreciation for someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "esteem",
                                "target_lang_sense_clarification": "to respect and admire someone greatly"
                            },
                            {
                                "target_lang_word": "respect",
                                "target_lang_sense_clarification": "to have a high opinion of someone"
                            },
                            {
                                "target_lang_word": "value",
                                "target_lang_sense_clarification": "to consider someone to be important or beneficial"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "962a5c37-55bc-3ddc-9dbc-68b4135d78a9",
                    "sense_definition": "aandacht schenken aan iets of ergens goed op letten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opletten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je op de computer werkt moet je <w>acht</w> slaan op de meldingen.",
                            "target_lang_translations": {
                                "en": "When you work on the computer, you must <w>heed</w> the notifications."
                            }
                        },
                        {
                            "text": "Men dient <w>acht</w> te geven op de veiligheidsvoorschriften in het laboratorium.",
                            "target_lang_translations": {
                                "en": "One should <w>pay attention</w> to the safety regulations in the laboratory."
                            }
                        }
                    ],
                    "synonyms": [
                        "letten",
                        "oppassen"
                    ],
                    "antonyms": [
                        "negeren",
                        "verwaarlozen"
                    ],
                    "common_phrases": [
