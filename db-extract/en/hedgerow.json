                    {
                        "translation_id": "5c4da51c-a38f-4df6-b6de-9e58d7f4fd85",
                        "source_entry_id": "8bd9de1e-2d59-316c-a18e-9dc8d5720f76",
                        "source_sense_id": "204434dd-d07d-32a0-9ba6-122d5320a2ba",
