            {
                "entry_id": "ee5913ac-2279-312f-9696-dc27f4eca800",
                "word": "Cubist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8c3080ad-395e-4c1a-998a-f69aabb9417a",
                        "entry_id": "ee5913ac-2279-312f-9696-dc27f4eca800",
                        "tags": [
                            "plural"
