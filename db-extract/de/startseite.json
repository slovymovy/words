                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a99ad4b-8577-403a-bce9-b06fd5ef674b",
                        "source_entry_id": "27e847af-dd10-34b0-b69c-9e4aa1063905",
                        "source_sense_id": "3e252800-0849-376e-a5f7-5dfaaeaf12d4",
                        "source_sense_description": "zentrale Einstiegsseite einer Webpräsenz",
                        "target_lang_word": "home page",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "home page",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "673143e9-ce3d-348f-a33d-fcdc6c5fcae3",
                                        "entry_id": "7b618749-b537-330a-bbb2-7756f793e839",
                                        "glosses": [
                                            "The main or first page of a website or set of hyperlinked documents."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc2ea7a4-dba8-4bd3-95a8-ce5cdc1c3d60",
                                                "sense_id": "673143e9-ce3d-348f-a33d-fcdc6c5fcae3",
                                                "text": "Creating Your Own Home Page\nThe home page provided by CERN is a good entry point into the Web; it points you to a lot of resources fairly quickly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9aa1f01-c8d2-31ad-a357-7a59342febf8",
                                        "entry_id": "7b618749-b537-330a-bbb2-7756f793e839",
                                        "glosses": [
                                            "The default page set to open in a web browser or hypertext system when it starts up, or when its home function is invoked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f700fdc1-030b-48d8-8da0-9fb1aa518d40",
                                                "sense_id": "a9aa1f01-c8d2-31ad-a357-7a59342febf8",
                                                "text": "A computer virus kept changing my home page to a site full of adware."
                                            },
                                            {
                                                "example_id": "aca33b02-6781-44ed-8351-3a30e63ef254",
                                                "sense_id": "a9aa1f01-c8d2-31ad-a357-7a59342febf8",
                                                "text": "When you first launch Netscape, it will load your predefined home page. To change Netscape's home page, select Edit, Preferences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d68c97c2-525d-3a32-8f50-59da7dafd471",
                                        "entry_id": "7b618749-b537-330a-bbb2-7756f793e839",
                                        "glosses": [
                                            "Someone's public personal home page/site on the World Wide Web."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd11f334-6bf1-485d-afdd-22cb31de666d",
                                                "sense_id": "d68c97c2-525d-3a32-8f50-59da7dafd471",
                                                "text": "My home page is www.example.com/~user."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
