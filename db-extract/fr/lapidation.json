        "fr-extract.jsonl": [
            {
                "entry_id": "ba8db891-dbd5-3a5f-be03-5ad1f3928c26",
                "word": "lapidation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "879e1c9f-d069-4c52-8d64-779b0f4b9621",
                        "entry_id": "ba8db891-dbd5-3a5f-be03-5ad1f3928c26",
                        "tags": [
                            "plural"
                        ],
                        "form": "lapidations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c13a80a-e9c6-32a4-b590-a2ece1ba17e9",
                        "entry_id": "ba8db891-dbd5-3a5f-be03-5ad1f3928c26",
                        "glosses": [
                            "Action de lapider."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e77d8889-f9bc-48e1-a2c6-82321571e43e",
                                "sense_id": "0c13a80a-e9c6-32a4-b590-a2ece1ba17e9",
                                "text": "Lapidé ! Nahoum voyait juste. Ma singularité, mon opposition au Temple, cela me conduirait à la lapidation"
                            },
                            {
                                "example_id": "3ed2ceff-3c80-4460-99da-763a60675fc9",
                                "sense_id": "0c13a80a-e9c6-32a4-b590-a2ece1ba17e9",
                                "text": "En 2007, un mémoire, présenté à la commission Bouchard-Taylor, par Bernard Thompson et son acolyte André Drouin, stipulait notamment qu’il était indésirable de tuer les femmes par lapidation ou de les brûler vives à Hérouxville."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9024a26-f1d1-371c-ad76-fd3bb91ec018",
                        "entry_id": "ba8db891-dbd5-3a5f-be03-5ad1f3928c26",
                        "glosses": [
                            "Représentation artistique d’une lapidation."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "cb430bda-d666-43b9-ac33-c4d537494f21",
                                "sense_id": "b9024a26-f1d1-371c-ad76-fd3bb91ec018",
                                "text": "Pour dénoncer l’oppression des femmes, elle avait peint une lapidation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05b9e464-d83e-45a7-80e1-921ae311924b",
                        "source_entry_id": "ba8db891-dbd5-3a5f-be03-5ad1f3928c26",
                        "target_lang_word": "lapidation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapidation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4bca3db-bf39-335e-a009-3768da94e927",
                                        "entry_id": "878e13d7-7eeb-3fdb-80fd-a5b71b62acbe",
                                        "glosses": [
                                            "The practice or act of stoning, sometimes to the point of death, as punishment"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29089e1f-e8c2-47cf-bb09-8cf695c2110c",
                                                "sense_id": "c4bca3db-bf39-335e-a009-3768da94e927",
                                                "text": "The five women on trial were almost all activists for the full repeal (not just a moratorium) of lapidation, ie stoning, from Iran’s law books."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65ef13c0-21a6-425e-a8b1-91751f78b6fb",
                        "source_entry_id": "ba8db891-dbd5-3a5f-be03-5ad1f3928c26",
