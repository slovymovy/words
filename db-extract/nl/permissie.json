                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "617c8d4b-5b1a-399b-a016-602a796c5c06",
                                        "entry_id": "ecf3d276-0fa8-3cbc-a438-abf54a1237bb",
                                        "glosses": [
                                            "Flags or access control lists pertaining to a file that dictate who can access it, and how."
                                        ],
                                        "tags": [
                                            "countable",
