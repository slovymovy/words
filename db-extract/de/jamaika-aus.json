                ],
                "senses": [
                    {
                        "sense_id": "bcdb8063-b162-35bf-9083-386ee57eb660",
                        "entry_id": "3f862e5f-c357-3eea-b1eb-c19f9a718ead",
                        "glosses": [
                            "Scheitern und darauffolgende Beendigung von Gesprächen/Verhandlungen über eine mögliche Zusammenarbeit der Parteien „CDU“, „FDP“ und „Bündnis 90/Die Grünen“"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "49aafc9a-40b4-4642-a207-cc6dab65eb87",
                                "sense_id": "bcdb8063-b162-35bf-9083-386ee57eb660",
                                "text": "„Jamaika-Aus ist zum Wort des Jahres 2017 gekürt worden.“"
                            },
                            {
                                "example_id": "041876d2-b16f-4f59-adfc-7a72fcb3848b",
                                "sense_id": "bcdb8063-b162-35bf-9083-386ee57eb660",
                                "text": "„Das Wort des Jahres ist ein echtes Bedeutungswunderwerk, findet Arno Orzessek. Allerdings bedauert er, dass das Wort nicht aufzeigt, wer für das traurige ‚Jamaika-Aus‘ die Verantwortung trägt.“"
                            },
                            {
                                "example_id": "97a36330-9bb0-4b83-92f0-53238f8a82cb",
                                "sense_id": "bcdb8063-b162-35bf-9083-386ee57eb660",
                                "text": "„Wenige Wochen nach dem Jamaika-Aus hat FDP-Chef Christian Lindner in der Bevölkerung massiv an Zuspruch verloren.“"
                            },
                            {
                                "example_id": "77c1bf09-cd7c-4a07-b741-21d877a4ef67",
                                "sense_id": "bcdb8063-b162-35bf-9083-386ee57eb660",
                                "text": "„Kurz nach dem Jamaika-Aus hatte die SPD-Führung ihr Nein zu einer großen Koalition per Beschluss bekräftigt, diesen aber nur wenige Tage später zurückgenommen.“"
                            },
                            {
                                "example_id": "2120d814-c7ec-46d6-a498-bb9ab44c073a",
                                "sense_id": "bcdb8063-b162-35bf-9083-386ee57eb660",
                                "text": "„Doch jetzt kommt Seehofer mit leeren Händen zurück nach München, zurück zur CSU-Basis, die nach dem verheerenden Ergebnis bei der Bundestagswahl ohnehin seit Wochen in Aufruhr ist. Was bedeutet das Jamaika-Aus für die CSU und für den 68-Jährigen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
