                            {
                                "example_id": "22700f32-d4b2-4a68-99a3-e080d583cd67",
                                "sense_id": "5233b27e-2b48-36e5-8b80-7bbc6e8b824e",
                                "text": "High intensity EMF can have adverse impacts on the operation of implantable medical devices (IMDs) such as pacemakers and defibrillators."
