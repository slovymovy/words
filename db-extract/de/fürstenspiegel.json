                        "examples": [
                            {
                                "example_id": "ca880ba9-465b-464f-a5d9-6a184693bfac",
                                "sense_id": "d4189379-0e53-3941-8f7e-bd76670351a5",
                                "text": "„Die meisten Fürstenspiegel stammen aus dem Mittelalter und der Frühen Neuzeit, es gab aber Vorläufer in der Antike und zum Beispiel eine eigenständige Entwicklung in Byzanz.“"
                            },
                            {
                                "example_id": "5c4eaeaa-3f4c-4cab-b501-3cb41cebc9a9",
                                "sense_id": "d4189379-0e53-3941-8f7e-bd76670351a5",
                                "text": "„Auch wenn der König sich hier Gedanken über eine gute Regierung macht, haben wir es nicht mit einem modernen Fürstenspiegel zu tun.“"
                            }
                        ],
