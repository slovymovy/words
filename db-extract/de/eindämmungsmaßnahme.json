                "senses": [
                    {
                        "sense_id": "1c8862b3-4ad0-3437-94f5-9129bf83cc65",
                        "entry_id": "f5ca566c-80a0-3e70-a350-0e2a138ed027",
                        "glosses": [
                            "Vorschrift, die eine bestimmte Entwicklung verhindern soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01c559fe-af84-4e4c-bbe4-5bec994fb9f4",
                                "sense_id": "1c8862b3-4ad0-3437-94f5-9129bf83cc65",
                                "text": "„Gleichzeitig müssen wir unseren Blick nach vorne richten, damit die Mitgliedstaaten ihre Eindämmungsmaßnahmen schrittweise aufheben können und so die Erholungsphase und die Neubelebung unserer Gesellschaften und der Wirtschaft einleiten können.“"
                            },
                            {
                                "example_id": "c918e8b7-f1ed-4f90-b237-aa1ec7d064bc",
                                "sense_id": "1c8862b3-4ad0-3437-94f5-9129bf83cc65",
                                "text": "„Die jeweils aktuell geltende Version der \"Verordnung über befristete Eindämmungsmaßnahmen aufgrund des SARS-CoV-2-Virus und COVID-19 im Land Brandenburg\" und der zugehörige Bußgeldkatalog sind auf dem Landesrecht-Portal einzusehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
