                                        "glosses": [
                                            "An early three-stringed instrument, somewhat like a simple violin only pear shaped, played with a bow and used in Medieval and the early Renaissance eras."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b32bc22f-9a9a-42b5-aa81-89fc162b8529",
                                                "sense_id": "cbd2842a-8d30-39d2-8807-b1bb049dc555",
                                                "text": "The villages also must have their visitors to enquire what lectures the bagpipe and the rebbeck reads ev'n to the ballatry, and the gammuth of every municipal fidler, for these are the Countrymans Arcadia's and his Monte Mayors."
                                            }
                                        ]
                                    }
                                ]
                            }
