                "senses": [
                    {
                        "sense_id": "c31a7cd8-dbe6-3b6d-b0ed-a688094736c4",
                        "entry_id": "162df6c2-aead-3382-a97f-949fec4fbaf5",
                        "glosses": [
                            "improvisiertes Zusammenspiel von Jazzmusikern"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "fe02f999-d005-482b-9079-79a7ad39f363",
                                "sense_id": "c31a7cd8-dbe6-3b6d-b0ed-a688094736c4",
                                "text": "„Auch eine spontane Jamsession mit Musikern vom Festival ist zur späten Stunde im Theatertreff nie ausgeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d76b2140-7ea0-43ad-aeb4-dbb0face1077",
                        "source_entry_id": "162df6c2-aead-3382-a97f-949fec4fbaf5",
                        "source_sense_id": "c31a7cd8-dbe6-3b6d-b0ed-a688094736c4",
                        "source_sense_description": "Musik: improvisiertes Zusammenspiel von Jazzmusikern",
                        "target_lang_word": "jam session",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jam session",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a10af91-6a93-3db2-ad2e-21d166ef7c82",
                                        "entry_id": "4f8bdaa4-bdea-3d7f-9763-45dee7cf0950",
                                        "glosses": [
                                            "An informal gathering of musicians to play music, especially improvised jazz or a similar genre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "227e409f-bed1-440a-9f78-3bfcc265a130",
                                                "sense_id": "5a10af91-6a93-3db2-ad2e-21d166ef7c82",
                                                "text": "There were some prerehearsals in small groups, but more often they were put together on the spot or just minutes prior to the practice jam sessions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef3eef7e-20c3-4bbe-af0e-cd368fd19f52",
                        "source_entry_id": "162df6c2-aead-3382-a97f-949fec4fbaf5",
                        "source_sense_id": "c31a7cd8-dbe6-3b6d-b0ed-a688094736c4",
                        "source_sense_description": "Musik: improvisiertes Zusammenspiel von Jazzmusikern",
                        "target_lang_word": "jam-session",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jam-session",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "254bdd1c-ce1e-37f8-8005-a3e82972f359",
                                        "entry_id": "7d7bc9f7-72a1-3e80-aa3b-cd3fe7272cc8",
                                        "glosses": [
                                            "Séance musicale improvisée fondée sur des standards de jazz à laquelle peuvent se joindre différents musiciens."
                                        ],
                                        "tags": [
                                            "Jazz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94b2c76e-c07b-41ae-a642-6ee833988722",
                                                "sense_id": "254bdd1c-ce1e-37f8-8005-a3e82972f359",
                                                "text": "Jamais les deux artistes n’avaient connu semblable condition physique, n’avaient participé à un tel festival de Bayreuth, n’avaient improvisé dans une aussi brillante jam-session."
                                            },
                                            {
                                                "example_id": "092bbcf3-48fe-4ee4-b1b5-defe14d441f6",
                                                "sense_id": "254bdd1c-ce1e-37f8-8005-a3e82972f359",
                                                "text": "– Il avait appris tous mes solos par cœur et, aux jam-sessions, chaque fois que c’était possible, il s’arrangeait pour jouer mes solos avant que ce soit mon tour de jouer !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5456e45-af5c-4e47-ba61-b9fe7a51fdef",
                        "source_entry_id": "162df6c2-aead-3382-a97f-949fec4fbaf5",
                        "source_sense_id": "c31a7cd8-dbe6-3b6d-b0ed-a688094736c4",
                        "source_sense_description": "Musik: improvisiertes Zusammenspiel von Jazzmusikern",
                        "target_lang_word": "jam session",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jam session",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd6555a5-17f9-352e-aef2-dbc3d2add2ab",
                                        "entry_id": "19688622-0537-3208-b058-bd18b658b7e7",
                                        "glosses": [
                                            "Bœuf, improvisation musicale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "926a8aab-c19c-434c-be1e-84b207429c53",
                                                "sense_id": "bd6555a5-17f9-352e-aef2-dbc3d2add2ab",
                                                "text": "La deuxième bonne idée fut d’ouvrir officieusement une jam session après le concert donné par le quartet maison. C’était un calcul commercial ingénieux : les musiciens qui venaient taper le bœuf commençaient par manger à l’œil, mais finissaient pas jouer à l’œil aussi."
                                            },
                                            {
                                                "example_id": "82803a4b-45eb-4f85-9173-4d5054d7e189",
                                                "sense_id": "bd6555a5-17f9-352e-aef2-dbc3d2add2ab",
                                                "text": "En 2018, il enregistrait d’ailleurs une incroyable ode à l’or ambré des Charentes : « Cognac », jam session de plus de cinq minutes sur l’album « The blues is alive and well »."
                                            },
                                            {
                                                "example_id": "afdf4664-fae5-4807-8609-e1301e17431f",
                                                "sense_id": "bd6555a5-17f9-352e-aef2-dbc3d2add2ab",
                                                "text": "Les jam sessions sont des événements musicaux incontournables pour les amoureux de la musique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c8f4585-f33f-4d66-94bd-77a1ae4892c7",
