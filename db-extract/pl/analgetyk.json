                        "translation_id": "7a9bbc23-9c3b-48d6-8135-38ba701fb3fb",
                        "source_entry_id": "a0e49ca3-d6e5-3df5-acfa-391be15eb0ec",
                        "source_sense_id": "71200e7e-2546-3aa1-a9b8-98e3d14e95bd",
                        "target_lang_word": "Analgetikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Analgetikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e633cdcd-25df-3414-a5fe-d104e6052973",
                                        "entry_id": "b2d67e6e-4820-3eeb-8dc9-7d3907f80114",
                                        "glosses": [
                                            "schmerzstillendes Mittel; umgangssprachlich Schmerzmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ecdc0a-054f-4050-8b74-f3eb2dec3fa9",
                                                "sense_id": "e633cdcd-25df-3414-a5fe-d104e6052973",
                                                "text": "Xylazin ist ein in der Veterinärmedizin sehr weit verbreitetes Analgetikum."
                                            },
                                            {
                                                "example_id": "5b3db2e0-47b9-4c50-a88c-3fa09b19f25d",
                                                "sense_id": "e633cdcd-25df-3414-a5fe-d104e6052973",
                                                "text": "Paracetamol wird als Analgetikum mit geringen Nebenwirkungen beschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89d75135-696b-4238-9b27-84218e759c24",
                        "source_entry_id": "a0e49ca3-d6e5-3df5-acfa-391be15eb0ec",
                        "source_sense_id": "71200e7e-2546-3aa1-a9b8-98e3d14e95bd",
                        "target_lang_word": "анальгетик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "анальгетик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "998e7c66-a080-3eba-8b5a-c8f189d304cc",
                                        "entry_id": "2575a28b-a1c2-3a23-8002-ac57a0d3c7b7",
                                        "glosses": [
                                            "мед. препарат, оказывающий обезболивающее действие, используемый для обезболивания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dde768c-6c2c-45f6-8ed2-1abb43de80e8",
                                                "sense_id": "998e7c66-a080-3eba-8b5a-c8f189d304cc",
                                                "text": "Войдя в медицинскую практику в начале прошлого столетия, морфин, несмотря на свой более чем почтенный возраст, продолжает оставаться одним из основных представителей анальгетиков — болеутоляющих средств, не выключающих сознание и общую чувствительность."
                                            },
                                            {
                                                "example_id": "dabd0858-08d7-4fa5-be3a-8e881958c818",
                                                "sense_id": "998e7c66-a080-3eba-8b5a-c8f189d304cc",
                                                "text": "Природные анальгетики — чай и кофе, содержащие кофеин, имбирь, а также мята, которую можно использовать в качестве приправы к различным блюдам или как заварку."
                                            },
                                            {
                                                "example_id": "16de3b44-f6a5-4339-b4a6-c47c8e2222b1",
                                                "sense_id": "998e7c66-a080-3eba-8b5a-c8f189d304cc",
                                                "text": "По статистике, каждая вторая женщина тяжело переносит «критические» дни. В этот период в организме женщины повышается содержание особых веществ — простагландинов, которые, собственно, и вызывают боль и другие неприятные симптомы. В таких случаях врач может порекомендовать использовать НПВП (нестероидные противовоспалительные препараты), которые эффективнее обычных анальгетиков."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
