    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ce65a9b0-44a5-3a94-82fd-9eb7db20c034",
                "word": "misapprehension",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "db18ca0a-4e5c-4fe9-aae1-fe4e9bd3ca11",
                        "entry_id": "ce65a9b0-44a5-3a94-82fd-9eb7db20c034",
                        "tags": [
                            "plural"
                        ],
                        "form": "misapprehensions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65a39b9d-874a-3ff3-bfc7-6a82b0bc056e",
                        "entry_id": "ce65a9b0-44a5-3a94-82fd-9eb7db20c034",
                        "glosses": [
                            "A failure to understand something; an illusion, misconception or misunderstanding."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f4fb0076-572b-4da0-b7dc-92bd943c0ea0",
                                "sense_id": "65a39b9d-874a-3ff3-bfc7-6a82b0bc056e",
                                "text": "They had thought it obsolete, but, were relieved of this misapprehension by Yule’s friend Major Trotter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99f73d0a-17f8-4482-9b17-7f5c0c5bd854",
                        "source_entry_id": "ce65a9b0-44a5-3a94-82fd-9eb7db20c034",
                        "source_sense_id": "65a39b9d-874a-3ff3-bfc7-6a82b0bc056e",
                        "source_sense_description": "a failure to understand something",
                        "target_lang_word": "Irrtum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Irrtum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "962ca326-61ef-33a0-8991-ecbe08d48209",
                                        "entry_id": "cb67a1ec-876e-3e79-a103-abf385d0e76f",
                                        "glosses": [
                                            "unabsichtlich falsche Annahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c475c289-6cc9-491e-b81c-2f767e3a0da9",
                                                "sense_id": "962ca326-61ef-33a0-8991-ecbe08d48209",
                                                "text": "Es war ein Irrtum zu denken, dass hier schon ein Beispiel steht."
                                            },
                                            {
                                                "example_id": "6fb6d04d-c56c-4b2e-95e9-fb5ea093787b",
                                                "sense_id": "962ca326-61ef-33a0-8991-ecbe08d48209",
                                                "text": "„Jedenfalls mag ich es, wenn sich kurz oder lange in mir aufbewahrte Irrtümer in nichts als Wohlgefallen auflösen.“"
                                            },
                                            {
                                                "example_id": "945ea0bd-697b-4fb4-b642-64d3ecd91b43",
                                                "sense_id": "962ca326-61ef-33a0-8991-ecbe08d48209",
                                                "text": "„Ein weitverbreiteter Irrtum, dem besonders gerne intellektuelle Trinker anhängen, die ihre Exzesse akademisch rechtfertigen wollen.“"
                                            },
                                            {
                                                "example_id": "ab0d0f7f-cc4c-4791-bc43-dbc0adcde08d",
                                                "sense_id": "962ca326-61ef-33a0-8991-ecbe08d48209",
                                                "text": "„Dieses Mal war kein Irrtum mehr möglich.“"
                                            },
                                            {
                                                "example_id": "adf4d42f-c3fb-489a-a7eb-e82476111f0c",
                                                "sense_id": "962ca326-61ef-33a0-8991-ecbe08d48209",
                                                "text": "„Ihr neuer Freund war im Irrtum gewesen, sie hatte in Wahrheit nie gezögert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49ab063b-f148-4601-8949-79c8c053d1ca",
                        "source_entry_id": "ce65a9b0-44a5-3a94-82fd-9eb7db20c034",
                        "source_sense_id": "65a39b9d-874a-3ff3-bfc7-6a82b0bc056e",
                        "source_sense_description": "a failure to understand something",
                        "target_lang_word": "Missverständnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Missverständnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                        "entry_id": "b510f009-a394-3a16-8171-6d541f53989e",
                                        "glosses": [
                                            "unabsichtliches falsches Verstehen, falsches Interpretieren einer Handlung oder Aussage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f742bd6a-0a02-445d-b33a-9712f1c3d23a",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "Das war ein Missverständnis. Er wollte eine Tafel Schokolade, kein Schokoladengetränk."
                                            },
                                            {
                                                "example_id": "0e21deb6-3de6-426a-8526-e3875716013d",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "„Sehen wir uns zunächst an, wie die Missverständnisse aussehen.“"
                                            },
                                            {
                                                "example_id": "2b963c5b-5f25-4149-b931-d7431f10088b",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "Lass uns erst einmal alle Missverständnisse aus dem Wege räumen."
                                            },
                                            {
                                                "example_id": "f9ed52fd-d53d-4248-b35b-761fc7c9febe",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "Darf ich das Missverständnis aufklären?"
                                            },
                                            {
                                                "example_id": "22329f62-7ed6-46aa-a507-79e649bbbe3e",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "Das muss sich hier um ein Missverständnis handeln, ich habe gar nichts getan."
                                            },
                                            {
                                                "example_id": "4aa08374-e8fa-4b66-b12a-2c1e2b17f691",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "„Gehen wir noch zwei weiteren Missverständnissen aus dem Weg, denn wir reden hier vom Reisen als größerem Vorhaben.“"
                                            },
                                            {
                                                "example_id": "137dc752-fb51-47f2-93d5-eb2777dc23ae",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "„Prinzessin Marja schrieb, sie sei über das zwischen ihnen vorgefallene Missverständnis ganz verzweifelt.“"
                                            },
                                            {
                                                "example_id": "cbe0ecf2-26d9-4f98-9827-b94db6c26f7e",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "„Zwei Typen von Missverständnissen lassen sich dabei ausmachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
