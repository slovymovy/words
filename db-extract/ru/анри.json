                "senses": [
                    {
                        "sense_id": "7859af22-e4f2-3697-8d68-901edebe8432",
                        "entry_id": "703430bc-1de3-3741-9e61-f48a9e98c6b3",
                        "glosses": [
                            "французское мужское имя, соответствующее немецкому Генрих"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0887ddf5-009d-478f-b609-33856a716c9a",
                                "sense_id": "7859af22-e4f2-3697-8d68-901edebe8432",
                                "text": "Ещё в 1889 году французский математик Анри Пуанкаре показал, что невозможно раз и навсегда рассчитать, как поведут себя хотя бы три тела, связанные друг с другом силами взаимного притяжения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0e40ba3-a7df-4dd1-b13c-ff3506731122",
                        "source_entry_id": "703430bc-1de3-3741-9e61-f48a9e98c6b3",
                        "source_sense_id": "7859af22-e4f2-3697-8d68-901edebe8432",
                        "source_sense_description": "Перевод имени",
                        "target_lang_word": "Henri",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Henri",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d683148d-5b1c-3869-a9e8-6975a80ab860",
                                        "entry_id": "ee3531c0-7726-3ca8-b21c-1df2d2099682",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f63c9c0-6350-4834-927f-219b3be23ad9",
                                                "sense_id": "d683148d-5b1c-3869-a9e8-6975a80ab860",
                                                "text": "La magnificence et la galanterie n’ont jamais paru en France avec tant d’éclat que dans les dernières années du règne de Henri II."
                                            },
                                            {
                                                "example_id": "e3fddd27-03cc-4a74-aafe-6b76a2144463",
                                                "sense_id": "d683148d-5b1c-3869-a9e8-6975a80ab860",
                                                "text": "Il y a quatre Henri dans cette salle, mon adorée ! reprit le roi : Henri de France, Henri de Condé, Henri de Guise ; mais il n’y a qu’un Henri de Navarre."
                                            },
                                            {
                                                "example_id": "89ef5282-5795-4b2b-a289-500b456fc70d",
                                                "sense_id": "d683148d-5b1c-3869-a9e8-6975a80ab860",
                                                "text": "Henri IV est le grand-père de Louis XIV, Cotton, le grand-oncle du P. la Chaise : deux royautés, deux dynasties, celle des rois, celle des confesseurs jésuites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
