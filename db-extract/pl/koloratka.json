                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e03763ea-8729-36f9-ad52-ec781de630fa",
                                        "entry_id": "311a75fe-8397-3b3f-815a-aa643a2d61a4",
                                        "glosses": [
                                            "Col, partie du vêtement rabattue vers le bas."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f45ff49-55b3-358b-b9f3-d966cc125cfe",
                                        "entry_id": "311a75fe-8397-3b3f-815a-aa643a2d61a4",
                                        "glosses": [
                                            "Col de toile, garni ou non de dentelles, qui laissait le cou des hommes découvert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e5cf554-00df-4072-91e6-94999779d6be",
                                                "sense_id": "4f45ff49-55b3-358b-b9f3-d966cc125cfe",
                                                "text": "Le Chrysale de Molière parle d’un gros Plutarque à mettre ses rabats."
                                            },
                                            {
                                                "example_id": "195f8ea0-b8d5-4749-b50c-0fa5bbc9658b",
                                                "sense_id": "4f45ff49-55b3-358b-b9f3-d966cc125cfe",
                                                "text": "Ah ! je comprends aujourd’hui le bonhomme Chrysale qui serrait ses rabats dans un gros Plutarque. À son exemple, je mettrai désormais toutes mes cravates entre les feuillets des Acta sanctorum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b69edcd8-ff64-3e1e-a433-43e44cd9e1e2",
                                        "entry_id": "311a75fe-8397-3b3f-815a-aa643a2d61a4",
                                        "glosses": [
                                            "Col du costume ecclésiastique consistant en un morceau de toile noire divisé en deux portions oblongues, bordées de blanc, qui se rabattait sur le devant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb0165f4-a7ed-4b7f-ab69-b4d6bd00881d",
                                                "sense_id": "b69edcd8-ff64-3e1e-a433-43e44cd9e1e2",
                                                "text": "Empeser les rabats."
                                            },
                                            {
                                                "example_id": "86dc9bb2-40fb-4176-9d68-50814ae38fd0",
                                                "sense_id": "b69edcd8-ff64-3e1e-a433-43e44cd9e1e2",
                                                "text": "Au lieu de rabat, il portait un petit collet (alzacuello) bleu et blanc, comme les prêtres de Belgique."
                                            },
                                            {
                                                "example_id": "d5b8f9c9-1066-4baf-9113-9783f1e8b5ab",
                                                "sense_id": "b69edcd8-ff64-3e1e-a433-43e44cd9e1e2",
                                                "text": "Deux juges à petits rabbats d’abbé, regardaient, une plume en main, d’un air recueilli, la voûte du cachot où se passait la scène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be30bada-c2df-3158-a0ec-08a122957a92",
                                        "entry_id": "311a75fe-8397-3b3f-815a-aa643a2d61a4",
                                        "glosses": [
                                            "Pièce de batiste, de dentelle, etc., qui fait office de cravate dans le costume officiel des magistrats, des avocats, des membres de l’université, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d1974b4-66d6-3efc-8e1b-6a8c9c098de8",
                                        "entry_id": "311a75fe-8397-3b3f-815a-aa643a2d61a4",
                                        "glosses": [
                                            "Action de rabattre le gibier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aae5b1ac-0ada-4137-9d27-fb065b6b662c",
                                                "sense_id": "5d1974b4-66d6-3efc-8e1b-6a8c9c098de8",
                                                "text": "Nous chassions au rabat."
                                            }
                                        ]
                                    },
                                    {
