                "senses": [
                    {
                        "sense_id": "4836fad9-e603-3dad-aba6-d594e0c2d47c",
                        "entry_id": "19b5b817-9a66-3dc4-9b1d-383bb0790db7",
                        "glosses": [
                            "Bezeichnung eines Tieres aus der Gruppe der Stinktiere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65764529-8732-4838-9065-a2334a2202ad",
                                "sense_id": "4836fad9-e603-3dad-aba6-d594e0c2d47c",
                                "text": "Wenn man einem Skunk zu nahe kommt, muss man mit einer starken Geruchsbelästigung rechnen."
                            },
                            {
                                "example_id": "9f51f6d8-5a44-44b6-92a2-462163f8875a",
                                "sense_id": "4836fad9-e603-3dad-aba6-d594e0c2d47c",
                                "text": "„Im Licht der schmalen Mondsichel sah Brian deutlich den buschigen Schweif, den der Skunk zierlich in die Luft reckte, und die weißen Streifen an seinem Rücken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "953d2433-4943-34fb-a4ed-b84d6035d064",
                        "entry_id": "19b5b817-9a66-3dc4-9b1d-383bb0790db7",
                        "glosses": [
                            "Familie der Stinktiere (siehe [1])"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "a5c775ef-9a7e-4414-8f20-ce8144d181b6",
                                "sense_id": "953d2433-4943-34fb-a4ed-b84d6035d064",
                                "text": "Es gibt zwölf Arten von Skunks, die fast ausschließlich in Nordamerika leben."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
