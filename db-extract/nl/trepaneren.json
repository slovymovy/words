                "translations": [
                    {
                        "translation_id": "1a74c050-ffb3-42f1-b268-6115701ed1fc",
                        "source_entry_id": "8c2cfaa3-e667-38dc-8dc2-b9038003b0b0",
                        "source_sense_id": "e9f0f28b-0fa1-38f0-b114-d3a0cb405399",
                        "target_lang_word": "trépaner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trépaner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fab6a14c-f1d4-3d6a-b8b7-013a7c53da17",
                                        "entry_id": "5448cd1e-cf6d-3fbe-87ea-8cd39d10e8d7",
                                        "glosses": [
                                            "Faire l’opération du trépan à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "901a3614-a032-4013-aa98-b5b6ef1e15c7",
                                                "sense_id": "fab6a14c-f1d4-3d6a-b8b7-013a7c53da17",
                                                "text": "Les hommes ne se séparent de rien sans regret, et même les lieux, les choses et les gens qui les rendirent le plus malheureux, ils ne les abandonnent point sans douleur.\nC’est ainsi qu’en 1912, je ne vous quittai pas sans amertume, lointain Auteuil, quartier charmant de mes grandes tristesses. Je n’y devais revenir qu’en l’an 1916 pour être trépané à la Villa Molière."
                                            },
                                            {
                                                "example_id": "c7f77225-96b6-4b73-bb0c-988b38dd7a2f",
                                                "sense_id": "fab6a14c-f1d4-3d6a-b8b7-013a7c53da17",
                                                "text": "C’est là que j’ai été blessé dans les Flandres. C’est là qu’on m’a trépané… que j’insistais moi."
                                            },
                                            {
                                                "example_id": "35801402-39f0-4e4e-b17e-4ba15acae10b",
                                                "sense_id": "fab6a14c-f1d4-3d6a-b8b7-013a7c53da17",
                                                "text": "Il n’est pas pensable qu’on homme puisse supporter qu’on lui ouvre le ventre, qu’on l’ampute d’un bras, qu’on le trépane sans chloroforme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "711df71a-a44f-368f-9d7e-295e19258400",
                                        "entry_id": "5448cd1e-cf6d-3fbe-87ea-8cd39d10e8d7",
                                        "glosses": [
                                            "Faire l’opération du trépan à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48591bc5-4c97-4e6a-83aa-7361fb87bbb3",
                                                "sense_id": "711df71a-a44f-368f-9d7e-295e19258400",
                                                "text": "Le crâne a été trépané."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
