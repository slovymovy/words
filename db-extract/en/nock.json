                "senses": [
                    {
                        "sense_id": "f74e4005-cd7f-3a7b-bbdc-11d172e4d350",
                        "entry_id": "7dcde9e4-d1a9-33c4-b099-2f7df2e76154",
                        "glosses": [
                            "Either of the two grooves in a bow that hold the bowstring."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02bd3d2b-a853-44f1-a23d-db0d3f2fd9b3",
                                "sense_id": "f74e4005-cd7f-3a7b-bbdc-11d172e4d350",
                                "text": "Meanwhile there had been bustle and preparation in all parts of the great vessel. The archers stood in groups about the decks, new-stringing their bows, and testing that they were firm at the nocks."
                            },
                            {
                                "example_id": "c5f1df27-8fe5-4430-8e21-f3fa2e440150",
                                "sense_id": "f74e4005-cd7f-3a7b-bbdc-11d172e4d350",
                                "text": "Each drew his string from its waterproof case and bent the huge arc of his war-bow as he fitted it into the nocks."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f5a2bbb-0022-302f-8814-24522fc78b23",
                        "entry_id": "7dcde9e4-d1a9-33c4-b099-2f7df2e76154",
                        "glosses": [
                            "The notch at the rear of an arrow that fits on the bowstring."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cd191a9-79e0-4f81-bfcf-8de2ee2f5002",
                                "sense_id": "5f5a2bbb-0022-302f-8814-24522fc78b23",
                                "text": "He took his arrow by the nock."
                            }
                        ]
                    },
