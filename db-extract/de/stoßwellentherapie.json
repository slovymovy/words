                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b7c63d2-cee1-4457-b3a4-9ce209eaca20",
                                "sense_id": "532c5da5-191d-394b-a649-b05f3640b5b5",
                                "text": "„Kurz und kräftig sind die Schalldruckwellen, die bei der sogenannten extrakorporalen Stoßwellentherapie (ESWT) ausgesendet werden.“"
                            },
                            {
                                "example_id": "4bbd6c58-179d-4045-92e7-51110b07e8db",
                                "sense_id": "532c5da5-191d-394b-a649-b05f3640b5b5",
                                "text": "„An unserer Abteilung bieten wir die Möglichkeit einer Stoßwellentherapie als sinnvolle Alternative zu einer Operation.“"
                            }
                        ],
