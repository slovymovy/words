                "senses": [
                    {
                        "sense_id": "2909218c-3a39-3bb0-a1f0-c17502ad04c6",
                        "entry_id": "b0178268-3505-35cd-b04e-d578b07cf707",
                        "glosses": [
                            "mit Mosaiken verzierter Fußboden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5cc80f1-18ab-429a-9b3a-b11a6cfac7f7",
                                "sense_id": "2909218c-3a39-3bb0-a1f0-c17502ad04c6",
                                "text": "„Dieses außergewöhnliche Gebäude verfügte über sechs Höfe mit feinsten Mosaikfußböden.“"
                            },
                            {
                                "example_id": "f94587b1-52d7-4c23-847b-07e746db7ed1",
                                "sense_id": "2909218c-3a39-3bb0-a1f0-c17502ad04c6",
                                "text": "„Ein paar Bücher mit Illustrationen von ihr aus den Zwanziger- und Dreißigerjahren sind antiquarisch erhältlich, die Porzellankacheln im Brunnen der St. Anna Schule in München und der Mosaikfußboden der Aussegnungshalle des Friedhofs im Perlacher Forst sind von ihr entworfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
