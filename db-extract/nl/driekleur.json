                "translations": [
                    {
                        "translation_id": "55964634-67af-470a-bd1b-eb2558ed2211",
                        "source_entry_id": "1186304a-4eb5-3c15-81aa-89c3aeaa8d8b",
                        "source_sense_id": "481c2ae3-d7cc-3de6-b32e-8ac714a63e58",
                        "target_lang_word": "tricolour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tricolour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7db5be5f-bcfc-3a0c-b91e-54bb7a0e42e4",
                                        "entry_id": "e4a16ce8-b329-3efa-9da9-b46946f95c39",
                                        "glosses": [
                                            "A flag consisting of three stripes that are either vertical or horizontal, all of equal size, and each of a different colour."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c01ea9e-bb95-456c-b0b3-c2f563546217",
                                                "sense_id": "7db5be5f-bcfc-3a0c-b91e-54bb7a0e42e4",
                                                "text": "Tricolours are seen in the national flags of over twenty countries, including Belgium, France, India, Italy, Russia, The Netherlands and Ireland."
                                            },
                                            {
                                                "example_id": "e334aa28-f5e9-4715-b592-cb69a4026064",
                                                "sense_id": "7db5be5f-bcfc-3a0c-b91e-54bb7a0e42e4",
                                                "text": "Journalists too were unwelcome and photographers had to conceal cameras. “He’s with the Guardian,” a man in his 60s, holding a tricolour, shouted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00bf7146-d409-3688-8df4-9a6059e16c22",
                                        "entry_id": "e4a16ce8-b329-3efa-9da9-b46946f95c39",
                                        "glosses": [
                                            "Anything which is composed of three colours."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff37e8af-21a5-407a-8175-1392be5e18e9",
                                                "sense_id": "00bf7146-d409-3688-8df4-9a6059e16c22",
                                                "text": "[…] to the Indian red. The black, to complete the racial tricolor, was yet to come. The white population settled, as the more advanced Indian groups had, in areas having the most comfortable temperatures."
                                            },
                                            {
                                                "example_id": "48134c39-b28f-45a6-932b-06d7f3fb06a9",
                                                "sense_id": "00bf7146-d409-3688-8df4-9a6059e16c22",
                                                "text": "David Hammons would go one^([sic]) to produce his own national colors, to subvert the boundaries of nation with his Pan-African Flag (1990), a version of the American tricolor reimagined in the black internationalist tones of red, green, and black."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tricolour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2ce7a2e-9958-3473-b303-c2c44ac39705",
                                        "entry_id": "768aff42-1b41-380a-9467-6677289614ad",
                                        "glosses": [
                                            "Having three colours."
                                        ],
