                "senses": [
                    {
                        "sense_id": "eda38249-5e6d-3320-855e-b28deb32d98d",
                        "entry_id": "2abd1b63-1b82-32b7-8cf1-1e198f963867",
                        "glosses": [
                            "Konflikt zwischen weltlichen Herrschern und dem Papst um die Amtseinsetzung von Bischöfen und Äbten im 11. und 12. Jahrhundert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "def96964-ca16-48eb-8e18-8011de21138c",
                                "sense_id": "eda38249-5e6d-3320-855e-b28deb32d98d",
                                "text": "„Papst Gregor VII. war unter Missachtung des Papstwahldekrets von 1059 ins Amt gekommen. Über 15 Jahre später spitzte sich der Investiturstreit zu, die Opposition gegen Gregor VII. verübte am Weihnachtstag 1075 sogar einen missglückten Anschlag auf den Papst.“"
                            },
                            {
                                "example_id": "29ed6237-813e-49cd-8695-da9edc308586",
                                "sense_id": "eda38249-5e6d-3320-855e-b28deb32d98d",
                                "text": "„Nach Thronwirren bis etwa 1000 schloss sich Mailand den Städten des Lombardischen Bunds gegen Heinrich IV. an und stellte sich mit ihnen im Investiturstreit auf die Seite des Papstes.“"
                            },
                            {
                                "example_id": "5f1b045b-5b14-4022-ba10-310d7510de3a",
                                "sense_id": "eda38249-5e6d-3320-855e-b28deb32d98d",
                                "text": "„In dieser Zeit kam es immer öfter zum Investiturstreit zwischen weltlichen Herrschern und der Kirche, wodurch die Exkommunizierung, der Kirchenbann, zur schärfsten Waffe des Papstes wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
