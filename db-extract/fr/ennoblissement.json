                    {
                        "sense_id": "8d860957-65f2-3016-a9ce-23f65e738395",
                        "entry_id": "be8c2ec7-9f15-39ec-8e35-13e4f4a71633",
                        "glosses": [
                            "Action d’ennoblir ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e77982c1-0f5c-410c-86e5-c7f0996d4a0c",
                                "sense_id": "8d860957-65f2-3016-a9ce-23f65e738395",
                                "text": "Or, — ajoutait mon ami, — ce que nous regardons comme un ennoblissement du paysage peut bien être un ennoblissement réel, mais seulement au point de vue moral ou humain. Toute altération du décor naturel produirait peut-être un défaut […]."
                            },
                            {
                                "example_id": "a2c303d1-8903-4248-b111-bd9614797647",
                                "sense_id": "8d860957-65f2-3016-a9ce-23f65e738395",
                                "text": "Elle allait, cette lassitude, presque jusqu’à la tristesse, et la tristesse est un ennoblissement."
                            }
                        ]
                    }
                ],
