                                                "sense_id": "269aaff8-5396-3a4c-921c-aa74e6ebb778",
                                                "text": "Ja, er wurde beleidigt und er ging am Tage darauf zum Chef."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "efff3f6e-277b-381e-bafb-3c83d4ede4dd",
                                        "entry_id": "005c044d-6caf-34f0-ab28-74d45a08eb9c",
                                        "glosses": [
