        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "403e1ee5-be50-3da1-be2c-f06d193c37a5",
                    "sense_definition": "To cover an area with concrete building material.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>concrete</w> the driveway to make parking their cars easier.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>забетонировать</w> подъездную дорожку, чтобы облегчить парковку машин.",
                                "zh": "他们决定把车道<w>浇筑</w>上混凝土，以便停车。"
                            }
                        },
                        {
                            "text": "The city council plans to <w>concrete</w> the river channel to prevent flooding in the flatlands.",
                            "target_lang_translations": {
                                "ru": "Городской совет планирует <w>забетонировать</w> русло реки, чтобы предотвратить наводнения на равнине.",
                                "zh": "市议会计划对河道进行<w>混凝土硬化</w>，以防止平原地区发生洪水。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "concrete over",
                        "concrete the yard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность бетонным строительным материалом.",
                        "zh": "用混凝土覆盖某区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бетони́ровать",
                                "target_lang_sense_clarification": "покрывать бетоном"
                            },
                            {
