                "senses": [
                    {
                        "sense_id": "00dce00a-9d99-3401-afc0-05edc3fab294",
                        "entry_id": "817f3f26-1715-3cd0-b8be-363dfaeb0810",
                        "glosses": [
                            "техн. круглый сердечник для наматывания чего-либо гибкого (нитей, плёнок, листов и т. п.)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2756045d-607e-3f16-a89e-6a185bb6f08e",
                        "entry_id": "817f3f26-1715-3cd0-b8be-363dfaeb0810",
                        "glosses": [
                            "бобина [1] с намотанной на ней нитью, плёнкой и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f90f3e-7636-45af-b4b2-496476d5f5eb",
                                "sense_id": "2756045d-607e-3f16-a89e-6a185bb6f08e",
                                "text": "И вдруг как перед собой вижу: не одну бобину, а две — и не рядом, а как будто бобинодержатель такой длинный, что на него еще одна бобина надета."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c0365c9-8674-493f-807e-b9559f368a7f",
                        "source_entry_id": "817f3f26-1715-3cd0-b8be-363dfaeb0810",
                        "target_lang_word": "bobbin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bobbin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c047e304-cdbf-30c4-95e3-3c47870f56d7",
                                        "entry_id": "6d9cae83-3d19-38ac-8e99-9716af7c9a52",
                                        "glosses": [
                                            "A spool or cylinder around which wire is coiled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9c7b08-476f-4849-9c77-4ed40cf58b71",
                                                "sense_id": "c047e304-cdbf-30c4-95e3-3c47870f56d7",
                                                "text": "Ignition coils using a bobbin molded from high-performance polyester withstand open-circuit bench tests to 70kV."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1220bfd7-afac-351a-8acf-4742435a3041",
                                        "entry_id": "6d9cae83-3d19-38ac-8e99-9716af7c9a52",
                                        "glosses": [
                                            "In a sewing machine, the small spool that holds the lower thread."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffa5b9dd-7e54-4c99-b4f1-4e8c072df36b",
                                                "sense_id": "1220bfd7-afac-351a-8acf-4742435a3041",
                                                "text": "Wind the bobbin, place it in the machine, and raise the thread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f209ed5f-e49e-3c12-9388-cf5bf62fdae4",
                                        "entry_id": "6d9cae83-3d19-38ac-8e99-9716af7c9a52",
                                        "glosses": [
                                            "The little rounded piece of wood at the end of a latch string, which is pulled to raise the latch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55b18ec0-b213-4556-9914-3dc80b5dbe86",
                                                "sense_id": "f209ed5f-e49e-3c12-9388-cf5bf62fdae4",
                                                "text": "She went from the linhay and boldly pulled the bobbin of the fuel-house door."
                                            },
                                            {
                                                "example_id": "a795d1f9-78af-4d1b-b64c-86450f472467",
                                                "sense_id": "f209ed5f-e49e-3c12-9388-cf5bf62fdae4",
                                                "text": "Put the bobbin and the latch will go up"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8123215-7a84-3e81-9acd-8f6661e3854c",
                                        "entry_id": "6d9cae83-3d19-38ac-8e99-9716af7c9a52",
                                        "glosses": [
                                            "A fine cord or narrow braid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11117408-4986-482a-b258-e5babb8a014b",
