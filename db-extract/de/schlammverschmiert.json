                        "examples": [
                            {
                                "example_id": "9b74b95f-c011-4830-8b80-38b71d8550d1",
                                "sense_id": "dab8c29e-a0f4-3413-b14f-384e981a7257",
                                "text": "„Alles war schlammverschmiert, und die Halskette war durchgebrochen.“"
                            },
                            {
                                "example_id": "96d5c294-9124-409e-92ed-df5e34122a79",
                                "sense_id": "dab8c29e-a0f4-3413-b14f-384e981a7257",
                                "text": "„Er drehte den Kopf langsam von einer Seite zur anderen und sah schlammverschmierte, hellbraune Kampfstiefel vor sich.“"
                            },
