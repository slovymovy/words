                    ],
                    "target_lang_definitions": {
                        "ru": "одаривать кого-либо чем-либо, давать кому-либо что-то в дар"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одаривать",
                                "target_lang_sense_clarification": "награждать, наделять чем-либо"
                            },
                            {
                                "target_lang_word": "наделять",
                                "target_lang_sense_clarification": "давать кому-либо какие-то качества или блага"
                            }
                        ]
                    }
                }
            ]
