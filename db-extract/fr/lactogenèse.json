                        "entry_id": "440b4f38-3696-3e8e-a7ac-24f757c0cab0",
                        "glosses": [
                            "Ensemble des phénomènes physiologiques qui permettent la sécrétion de lait par les glandes mammaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8e0701b-67d3-40bb-85df-6844bb973229",
                                "sense_id": "def2c705-6d65-365b-8a49-392801d3d206",
                                "text": "La prolactine joue un rôle essentiel dans la lactogenèse, chez toutes les espèces."
                            },
                            {
                                "example_id": "002622f8-1d5d-4822-a534-6df2ca4e772f",
                                "sense_id": "def2c705-6d65-365b-8a49-392801d3d206",
                                "text": "La lactogenèse est caractérisée par l’apparition, pendant la mammogenèse, de l’activité synthétique de la cellule mammaire ; les éléments du lait restent dans la lumière des alvéoles."
                            }
                        ]
                    }
