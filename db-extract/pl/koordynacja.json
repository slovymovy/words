                                                "sense_id": "d8496689-ac82-3903-86a2-db08773dd0f9",
                                                "text": "„Zur Koordination des Bildungs-, besonders des Hochschulwesens unter den Besatzungsmächten wurden neue Gremien geschaffen.“"
                                            },
                                            {
                                                "example_id": "f1b53784-2c0a-4be5-bd1d-04bc9d397043",
                                                "sense_id": "d8496689-ac82-3903-86a2-db08773dd0f9",
                                                "text": "„Es wäre wahrscheinlich gut, wenn wir eine regelmäßige bilaterale Sitzung zur Koordination unserer internen Kommunikation einrichten würden.“"
                                            }
                                        ],
