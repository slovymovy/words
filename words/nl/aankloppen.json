            "senses": [
                {
                    "sense_id": "4eb8baa2-9719-3909-8299-d0bb3c85c27e",
                    "sense_definition": "op een deur slaan om iemands aandacht te trekken of om binnen te mogen komen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kloppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet eerst <w>aankloppen</w> voordat je de kamer van je broer binnengaat.",
                            "target_lang_translations": {
                                "en": "You must <w>knock</w> first before entering your brother's room."
                            }
                        },
                        {
                            "text": "Ik hoorde iemand zachtjes op de voordeur <w>aankloppen</w> midden in de nacht.",
                            "target_lang_translations": {
                                "en": "I heard someone <w>knock</w> softly on the front door in the middle of the night."
                            }
                        }
                    ],
                    "synonyms": [
                        "kloppen",
                        "bonzen"
                    ],
                    "common_phrases": [
                        "op de deur aankloppen",
                        "zachtjes aankloppen"
                    ],
                    "target_lang_definitions": {
                        "en": "to hit a door to get someone's attention or to be allowed to enter"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knock",
                                "target_lang_sense_clarification": "on a door"
                            },
                            {
                                "target_lang_word": "knock at the door",
                                "target_lang_sense_clarification": "to request entry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7787ad5e-e887-3b2e-a90d-8de0252744d5",
                    "sense_definition": "hulp, advies of financiële steun vragen bij een persoon of instantie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hulp_vragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij allerlei tegenslagen kunnen de kinderen altijd bij hun ouders <w>aankloppen</w> voor steun.",
                            "target_lang_translations": {
                                "en": "In case of all kinds of setbacks, the children can always <w>turn to</w> their parents for support."
                            }
                        },
                        {
                            "text": "Als je financiële problemen hebt, kun je bij de gemeente <w>aankloppen</w> voor een lening.",
                            "target_lang_translations": {
                                "en": "If you have financial problems, you can <w>approach</w> the municipality for a loan."
                            }
                        }
                    ],
                    "synonyms": [
                        "te rade gaan",
                        "hulp vragen"
                    ],
                    "common_phrases": [
                        "bij iemand aankloppen",
                        "om hulp aankloppen"
                    ],
                    "target_lang_definitions": {
                        "en": "to ask a person or organization for help, advice, or financial support"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn to",
                                "target_lang_sense_clarification": "for help or advice"
                            },
                            {
                                "target_lang_word": "approach",
                                "target_lang_sense_clarification": "someone for assistance"
                            },
                            {
                                "target_lang_word": "call upon",
                                "target_lang_sense_clarification": "someone for support"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0f26041-94d7-34c6-ad97-74dce34273a4",
                    "sense_definition": "iets steviger of vaster maken door er herhaaldelijk op te slaan",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bevestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet het materiaal in de voeg goed <w>aankloppen</w> met een zachte bezem.",
                            "target_lang_translations": {
                                "en": "You must <w>tap</w> the material in the joint <w>down</w> well with a soft broom."
                            }
                        },
                        {
                            "text": "De stratenmaker moet de stenen voorzichtig <w>aankloppen</w> zodat het wegdek overal gelijk blijft.",
                            "target_lang_translations": {
                                "en": "The paver must carefully <w>tap</w> the stones <w>down</w> so that the road surface remains level everywhere."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastkloppen",
                        "aanstampen"
                    ],
                    "antonyms": [
                        "losmaken"
                    ],
                    "common_phrases": [
                        "de voegen aankloppen",
                        "stevig aankloppen"
                    ],
                    "traits": [
