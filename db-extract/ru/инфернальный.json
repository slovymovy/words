                        "form_id": "9ab24c7b-09e5-44f1-8391-3a3d253d997e",
                        "entry_id": "0fb5b98e-0615-3607-abd4-22ffe9f05834",
                        "tags": [
                            "singular",
                            "feminine",
                            "short-form"
                        ],
                        "form": "инферна́льна"
                    },
                    {
                        "form_id": "db647163-0015-4d24-87a5-05fb06b5f29e",
                        "entry_id": "0fb5b98e-0615-3607-abd4-22ffe9f05834",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "инферна́льны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3445a723-5cbf-33e6-afe7-6106d2486bae",
                        "entry_id": "0fb5b98e-0615-3607-abd4-22ffe9f05834",
                        "glosses": [
                            "демонический, адский, дьявольский"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47588baa-8360-433f-9b47-6450ce883b89",
                                "sense_id": "3445a723-5cbf-33e6-afe7-6106d2486bae",
                                "text": "Лизанька, в этом фокс-троте звучит что-то инфернальное. В нём нарастающее мученье без конца."
                            },
                            {
                                "example_id": "d17448cf-c9cf-4c13-ace0-7b5f7e45ea67",
                                "sense_id": "3445a723-5cbf-33e6-afe7-6106d2486bae",
                                "text": "В очереди материализовалась огромная идея куска хлеба, а вывеска воплотила инфернальное томление очереди."
                            },
                            {
                                "example_id": "2d7d640f-ce08-4778-90ce-5085e0c6ff3e",
                                "sense_id": "3445a723-5cbf-33e6-afe7-6106d2486bae",
                                "text": "Я никогда не соглашусь с той инфернальной картиной мира, в которую ты веришь."
                            }
                        ]
                    },
                    {
                        "sense_id": "68416266-46a5-3a78-b301-29949812a216",
                        "entry_id": "0fb5b98e-0615-3607-abd4-22ffe9f05834",
                        "glosses": [
                            "книжн., филол. : обсценный, матерный"
                        ],
                        "tags": [
                            "о словах, выражениях, лексике"
                        ],
                        "examples": [
                            {
                                "example_id": "b3dabe3a-d004-4de6-8084-9b31dda19218",
                                "sense_id": "68416266-46a5-3a78-b301-29949812a216",
                                "text": "Инфернальная лексика уместна лишь в контексте и к месту, мат для связки слов недопустим."
                            }
                        ]
                    },
                    {
                        "sense_id": "3338f1e9-f5e8-3a63-82e8-1e808a013e6e",
                        "entry_id": "0fb5b98e-0615-3607-abd4-22ffe9f05834",
                        "glosses": [
                            "субстантивир., ж., устар. комната для азартных карточных игр"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afdb4308-76c1-4ed7-8e35-b4046c443431",
                                "sense_id": "3338f1e9-f5e8-3a63-82e8-1e808a013e6e",
                                "text": "Разговаривая и здороваясь со встречавшимися знакомыми, Левин с князем прошёл все комнаты..; заглянули и в инфернальную, где у одного стола, за который уже сел Яшвин, толпилось много державших."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac7e10fe-bb3f-4cbb-9f0f-6a43529fe00b",
                        "source_entry_id": "0fb5b98e-0615-3607-abd4-22ffe9f05834",
                        "target_lang_word": "infernal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infernal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad0f95d6-bd53-3445-b8ab-33950175b6c3",
                                        "entry_id": "5ec4932d-9916-3f63-9aae-8341bf47ae02",
                                        "glosses": [
                                            "Of or relating to hell, or the world of the dead; hellish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fa8b433-d8b7-3905-9514-a2b2e356988a",
                                        "entry_id": "5ec4932d-9916-3f63-9aae-8341bf47ae02",
                                        "glosses": [
                                            "Of or relating to a fire or inferno."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61e41b3d-88d4-35bc-bd79-2d1b0124bb7b",
                                        "entry_id": "5ec4932d-9916-3f63-9aae-8341bf47ae02",
                                        "glosses": [
                                            "Stygian, gloomy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fe94ed5-bfaf-3709-b7c3-3bc8099b54a2",
                                        "entry_id": "5ec4932d-9916-3f63-9aae-8341bf47ae02",
                                        "glosses": [
                                            "Diabolical or fiendish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f989017-e346-4512-8348-822e41b351c4",
                                                "sense_id": "4fe94ed5-bfaf-3709-b7c3-3bc8099b54a2",
                                                "text": "Th' infernal Serpent; he it was, whose guile\nStird up with Envy and Revenge, deceiv'd\nThe Mother of Mankind"
                                            },
                                            {
                                                "example_id": "af4c15c6-8bb4-4898-bc46-d52404652dd0",
                                                "sense_id": "4fe94ed5-bfaf-3709-b7c3-3bc8099b54a2",
                                                "text": "the instruments or abettors in such infernal dealings"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86642d30-8d06-3c89-bfec-221b278fd797",
                                        "entry_id": "5ec4932d-9916-3f63-9aae-8341bf47ae02",
                                        "glosses": [
                                            "Very annoying; damned."
                                        ],
                                        "tags": [
                                            "as an expletive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7aa82d2-ea82-40ae-be8d-55b79450eadd",
                                                "sense_id": "86642d30-8d06-3c89-bfec-221b278fd797",
                                                "text": "As I had to put up with the patronage and the lecturings, and the eyeglass of that infernal old woman, […]"
                                            },
                                            {
                                                "example_id": "ae4c9352-1695-4f2a-9b9c-682609154d82",
                                                "sense_id": "86642d30-8d06-3c89-bfec-221b278fd797",
                                                "text": "When are you ever going to learn to mind your own infernal business?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "infernal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff2c537e-9822-3aa5-8706-c0a5d5bf24ce",
