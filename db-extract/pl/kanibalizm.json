                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d67ab394-5ae8-4951-9137-babd3ea3ef5d",
                        "source_entry_id": "aff8b5a9-5f88-31c4-a497-7b61f6be7b0a",
                        "source_sense_id": "681f7222-866c-3824-9e89-5c1b916eb744",
                        "target_lang_word": "Kannibalismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kannibalismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c4d7e59-ffb4-3c60-9ec5-bf9fb2888840",
                                        "entry_id": "be76c58c-679d-3816-9977-6d1197dd0892",
                                        "glosses": [
                                            "der Verzehr von Menschenfleisch durch Menschen (Kannibalen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74de8132-4a47-4772-aaf0-0bc8a6f7ae06",
                                                "sense_id": "7c4d7e59-ffb4-3c60-9ec5-bf9fb2888840",
                                                "text": "„Gewisse Volksstämme, die sogenannten Feuerländer, huldigen noch dem Kannibalismus, soviel ich weiß.“"
                                            },
                                            {
                                                "example_id": "1a29849c-a425-456c-8209-9c79ceaf9e47",
                                                "sense_id": "7c4d7e59-ffb4-3c60-9ec5-bf9fb2888840",
                                                "text": "„Ich glaube durch Beschreibung einzelner Sitten und Gebräuche etwas mehr Licht über den Charakter und die Lebensart dieser Menschen zu verbreiten und halte es für notwendig, mich besonders ausführlich mit dem Kannibalismus zu beschäftigen.“"
                                            },
                                            {
                                                "example_id": "29c48ebb-00b4-44f8-b831-ffe0fbe2efb4",
                                                "sense_id": "7c4d7e59-ffb4-3c60-9ec5-bf9fb2888840",
                                                "text": "„Sichtbare untrügliche Anzeichen von Kannibalismus fanden sich aber auf Schritt und Tritt.“"
                                            },
                                            {
                                                "example_id": "fb209ebf-9861-481a-9efb-809181dbc156",
                                                "sense_id": "7c4d7e59-ffb4-3c60-9ec5-bf9fb2888840",
                                                "text": "„William Snelgrave bezichtigte die Krieger König Agajas (aber nicht den Herrscher von Dahomey selbst), Kannibalismus zu praktizieren, gab aber zu, dass er keinen Beweis dafür habe.“"
                                            },
                                            {
                                                "example_id": "9a47d52e-15ab-4416-a5ca-c87d6104a991",
                                                "sense_id": "7c4d7e59-ffb4-3c60-9ec5-bf9fb2888840",
                                                "text": "„Forschende kennen drei unterschiedliche Motive für Kannibalismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4495c0e-d35b-3570-ba05-27176ccfd11a",
                                        "entry_id": "be76c58c-679d-3816-9977-6d1197dd0892",
                                        "glosses": [
                                            "das Fressen von anderen Tieren der eigenen Art"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e54f78d3-ad4a-4076-878d-87519be20fb8",
                                                "sense_id": "e4495c0e-d35b-3570-ba05-27176ccfd11a",
                                                "text": "„Zuletzt starben die Zwergkrebse aus, da ihre Vermehrung der der Polypen nicht standhielt, und diese ergaben sich nun einem durch die Blutsverwandtschaft doppelt schauerlichen Kannibalismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cdbb262d-f4c5-3bb9-8f16-c4eda276602f",
                                        "entry_id": "be76c58c-679d-3816-9977-6d1197dd0892",
                                        "glosses": [
                                            "das Aufnehmen von kleinen Galaxien durch größere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a88e848d-91de-476b-89dd-0d909f25c13a",
                                                "sense_id": "cdbb262d-f4c5-3bb9-8f16-c4eda276602f",
                                                "text": "Unsere Milchstraße hat sich durch Kannibalismus auch Sagittarius vereinnahmt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c261dd9e-1359-434b-8ece-1bc5e069d3ed",
                        "source_entry_id": "aff8b5a9-5f88-31c4-a497-7b61f6be7b0a",
                        "source_sense_id": "681f7222-866c-3824-9e89-5c1b916eb744",
                        "target_lang_word": "каннибализм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "каннибализм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "293f5390-adba-34b6-ae74-7d17a2fed97e",
                                        "entry_id": "d0fc3548-d7ac-35fe-85f2-9aa40d8867af",
                                        "glosses": [
                                            "в широком смысле — поедание животными представителей своего вида"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0795ba0c-3e5b-4dc7-9c23-4658626157e3",
                                                "sense_id": "293f5390-adba-34b6-ae74-7d17a2fed97e",
                                                "text": "Каннибализм приводит к тому, что богомолы в природе никогда не скапливаются группами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "655ac821-f794-390e-8241-89c8257693c9",
                                        "entry_id": "d0fc3548-d7ac-35fe-85f2-9aa40d8867af",
                                        "glosses": [
                                            "в узком смысле — людоедство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b13ef8fa-900c-4ef0-8e5b-2d4046daba9e",
                                                "sense_id": "655ac821-f794-390e-8241-89c8257693c9",
                                                "text": "Были съедены все лошади, кошки, собаки, люди грызли ремни, доходило до каннибализма."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8293810c-4d9b-3af5-a2bd-100a579491cd",
                                        "entry_id": "d0fc3548-d7ac-35fe-85f2-9aa40d8867af",
                                        "glosses": [
                                            "перен. нечеловеческая жестокость; зверство, варварство"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6020db04-8fd0-37b9-8a5f-a02ed693e93e",
                                        "entry_id": "d0fc3548-d7ac-35fe-85f2-9aa40d8867af",
                                        "glosses": [
                                            "перен., техн. разборка одной исправной или частично исправной машины (трактора, корабля, самолёта и т. п.) с целью использования её деталей для поддержания эксплуатации другой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89195505-155d-4245-8adb-0e1fab8ec205",
                                                "sense_id": "6020db04-8fd0-37b9-8a5f-a02ed693e93e",
                                                "text": "Королевский флот Великобритании все чаще вынужден «пожирать» свои собственные военные корабли и подводные лодки, то есть использовать их детали для ремонта и реконструкции других судов. Как сообщает газета The Telegraph, подобный процесс ремонтные службы флота неофициально называют «каннибализмом». Причина — недостаток финансирования (Российская газета о проблемах ВМФ Великобритании)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
