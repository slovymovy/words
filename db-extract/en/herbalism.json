                        "translation_id": "c8ade9ae-1ae6-42f3-92dc-b43ce6aa4e24",
                        "source_entry_id": "0a3a376e-990a-3036-b8bf-5c3cd20b0813",
                        "source_sense_description": "practice or study of medicinal herbs",
                        "target_lang_word": "kruidengeneeskunde",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kruidengeneeskunde",
