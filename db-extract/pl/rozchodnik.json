                        "entry_id": "31586639-5b0e-368f-8c22-1d068e0fba0f",
                        "glosses": [
                            "Sedum L., rodzaj rośliny z rodziny gruboszowatych, do którego należy od ~280 do ~470 gatunków występujących głównie na półkuli północnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e131ec-e2f7-46ea-be96-d9992a1a8ddb",
                                "sense_id": "23f579e6-03fc-374f-935a-c7da3a8b431b",
                                "text": "Teraz tam rozchodniki bujały i mchy przeróżne, a z sosen spoglądały dzięcioły pstre"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
