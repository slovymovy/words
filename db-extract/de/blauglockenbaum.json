                                "sense_id": "f1c0429d-e145-3b83-b39d-aa7f5cd78cba",
                                "text": "„Der Blauglockenbaum ist in Zentral- und Westchina beheimatet.“"
                            },
                            {
                                "example_id": "ff2b75ef-d264-402e-a072-1d085209bb99",
                                "sense_id": "f1c0429d-e145-3b83-b39d-aa7f5cd78cba",
                                "text": "Der Blauglockenbaum blüht nach der Kastanie."
                            }
