                "senses": [
                    {
                        "sense_id": "6342aba7-1cb5-35ca-bc76-0e2136e9857e",
                        "entry_id": "2f0991c4-7740-3e66-b972-c97d61031659",
                        "glosses": [
                            "Pertaining to the sectionary party."
                        ],
                        "tags": [
                            "historical",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "067efe2d-88f5-48d4-a849-604c30f702af",
                                "sense_id": "6342aba7-1cb5-35ca-bc76-0e2136e9857e",
                                "text": "Any explanation for the triumph of the 'federalist' or sectionary movement at Toulon must, therefore, begin by examining the profound isolation of the incumbent Jacobin administration."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd76cdae-7719-4dba-8212-417663e4849e",
                        "source_entry_id": "2f0991c4-7740-3e66-b972-c97d61031659",
                        "source_sense_id": "6342aba7-1cb5-35ca-bc76-0e2136e9857e",
                        "source_sense_description": "pertaining to the sectionary party",
                        "target_lang_word": "sectionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sectionnaire",
