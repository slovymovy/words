                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4610c142-e425-4eb3-8385-5a95dbe54e3a",
                        "source_entry_id": "01f7517d-7c0d-39cf-acb4-5518b4f77bc4",
                        "target_lang_word": "Mikropore",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mikropore",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7be42c4-8627-3703-af35-6cc67a9c7d15",
                                        "entry_id": "77b0c639-32da-3407-bf69-9c9da695f262",
                                        "glosses": [
                                            "besonders kleine Pore (mit einem Durchmesser von weniger als 2 Nanometer)"
                                        ],
                                        "tags": [
                                            "von Materialien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ea05949-ef51-4e02-9515-9c3ef4093a95",
                                                "sense_id": "b7be42c4-8627-3703-af35-6cc67a9c7d15",
                                                "text": "„Bei der Entstehung und dem Versuch einer Komprimierung entstandener Mikroporen innerhalb der Fäden sind die Kapillareffekte mit zu berücksichtigen.“"
                                            },
                                            {
                                                "example_id": "b81914d6-ba36-484f-a3ff-8e7cbef23b1a",
                                                "sense_id": "b7be42c4-8627-3703-af35-6cc67a9c7d15",
                                                "text": "„Neuerdings wird besonders in England der Prüfung von Gestein auf Mikroporen (Mikroporosität) besondere Aufmerksamkeit geschenkt.“"
                                            },
                                            {
                                                "example_id": "5fcc3dea-8f24-44ce-a599-7cbfd16db30d",
                                                "sense_id": "b7be42c4-8627-3703-af35-6cc67a9c7d15",
                                                "text": "„Es muß darauf hingewiesen werden, daß der Schichtzwischenraum dann als Mikropore wirkt und daß auch Mikroporen zwischen den Teilchen auftreten können.“"
                                            },
                                            {
                                                "example_id": "6af0e5bd-38a9-4d43-b33a-2025925b603e",
                                                "sense_id": "b7be42c4-8627-3703-af35-6cc67a9c7d15",
                                                "text": "„Es bildet sich dadurch gewissermassen eine Mikropore aus, deren Umgebung sehr viele Zwischengitteratome enthält und die daher ihrerseits eine Druckzone darstellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ede3ca1-3533-4a78-a3b7-bcfcb7b1997a",
                        "source_entry_id": "01f7517d-7c0d-39cf-acb4-5518b4f77bc4",
