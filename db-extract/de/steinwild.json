                        ],
                        "examples": [
                            {
                                "example_id": "20314b2a-6ab2-40b5-afad-bd21e45298bb",
                                "sense_id": "c4374908-3b24-36b4-a9bd-bf08d9c68985",
                                "text": "„Sofern die für die Abschussplanung maßgeblichen Verhältnisse für Steinwild aufgrund besonderer Umstände, wie beispielsweise Schneelage oder Seuchenzüge, im April nicht ermittelt werden können, hat die Behörde hinsichtlich Steinwild bis zum 31. Juli des Jahres die Abschussplanbesprechung (Abs. 6) durchzuführen und den Abschussplan (Abs. 4) zu erlassen.“"
                            },
                            {
                                "example_id": "733a64e5-4e85-4868-a19a-2e6934d6e934",
                                "sense_id": "c4374908-3b24-36b4-a9bd-bf08d9c68985",
                                "text": "„Und rund um den Piz Albris oberhalb von Pontresina im Oberengadin begeben sich die Gäste auf die Spuren von Murmeltieren und Steinwild.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
