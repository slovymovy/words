    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5c7c0905-00d3-3a55-b433-782d501b630a",
                "word": "hoor",
                "pos": "intj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dfaf5f91-e7d8-3f54-86d4-c8faac871180",
                        "entry_id": "5c7c0905-00d3-3a55-b433-782d501b630a",
                        "glosses": [
                            "modal particle indicating reassurance or confidence from the speaker: certainly, surely, at all, but often weak and untranslatable"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd826df2-15be-434e-a244-34e2db2cf476",
                                "sense_id": "dfaf5f91-e7d8-3f54-86d4-c8faac871180",
                                "text": "Straks komen we nog te laat! — Nee hoor, we hebben nog genoeg tijd.",
                                "translation": "We'll be late! — Nah, surely not, we have plenty of time.",
                                "english": "We'll be late! — Nah, surely not, we have plenty of time."
                            },
                            {
                                "example_id": "a464d335-18bd-4bdd-9243-6b3b46e6484f",
                                "sense_id": "dfaf5f91-e7d8-3f54-86d4-c8faac871180",
                                "text": "Wilt u het bonnetje? — Nee hoor, bedankt.",
                                "translation": "Do you want the receipt? — No, thanks.",
                                "english": "Do you want the receipt? — No, thanks."
                            },
                            {
                                "example_id": "b2bc9853-2442-4cda-895d-826b533b5755",
                                "sense_id": "dfaf5f91-e7d8-3f54-86d4-c8faac871180",
                                "text": "Zeg maar 'jij' hoor.",
                                "translation": "Feel free to thou me.",
                                "english": "Feel free to thou me."
                            },
                            {
                                "example_id": "34fef260-461d-44e1-8857-6e89638cb4ff",
                                "sense_id": "dfaf5f91-e7d8-3f54-86d4-c8faac871180",
                                "text": "Lekker weertje hoor.",
                                "translation": "I say, the weather is lovely.",
                                "english": "I say, the weather is lovely."
                            },
                            {
                                "example_id": "395adbd4-0782-4931-b5d8-e585b6a79b10",
                                "sense_id": "dfaf5f91-e7d8-3f54-86d4-c8faac871180",
                                "text": "Chef, halte hoor.",
                                "translation": "Driver, I'd like to get off the bus here.",
                                "english": "Driver, I'd like to get off the bus here."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d8483aa-e1d8-384b-8c6d-ab2a12dabc46",
                        "entry_id": "5c7c0905-00d3-3a55-b433-782d501b630a",
                        "glosses": [
                            "modal particle indicating disagreement or a certain nuance with an earlier statement: regardless, despite that, anyway, you know"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c11a3a86-9904-4f9b-bf0b-64c7cf8e773b",
                                "sense_id": "1d8483aa-e1d8-384b-8c6d-ab2a12dabc46",
                                "text": "De kou valt best mee. — Nou, ik vind het toch wel koud hoor!",
                                "translation": "The cold isn't so bad. — Well, I still think it's pretty cold regardless!",
                                "english": "The cold isn't so bad. — Well, I still think it's pretty cold regardless!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
