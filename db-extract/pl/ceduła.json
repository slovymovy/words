                "translations": [
                    {
                        "translation_id": "8900b3ae-c179-4b8a-a4f1-ee74a7358458",
                        "source_entry_id": "350bb48c-ed1b-3322-a72d-f48fbf2514a1",
                        "source_sense_id": "6ccd4ea1-b04d-3b94-98f1-cd530d307381",
