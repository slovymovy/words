                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1cdfb61-4cb1-4ff9-afd5-606de011d082",
                                "sense_id": "ce8f817f-ddb4-3ee4-9ca7-4d4c1d7af072",
                                "text": "„In Deutschland überleben bisher nur drei bis acht von hundert Betroffenen einen plötzlichen Herztod.“"
                            },
                            {
                                "example_id": "7225e3c1-02e4-48e0-814f-4652fc950768",
                                "sense_id": "ce8f817f-ddb4-3ee4-9ca7-4d4c1d7af072",
                                "text": "„Der Herztod ist in Deutschland allgegenwärtig. Bei mindestens 60.000 Menschen im Jahr hört das Herz plötzlich auf zu pumpen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
