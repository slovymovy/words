                ],
                "senses": [
                    {
                        "sense_id": "ccb16597-be04-3498-8852-1f0cd5af0ec9",
                        "entry_id": "310ec113-dcbf-3915-9d2d-9fdcb406869d",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1811979-fcf6-4ba4-a780-a97e1ee87c74",
                                "sense_id": "ccb16597-be04-3498-8852-1f0cd5af0ec9",
                                "text": "Pour donner au tube de verre une électricité négative, il ne faut qu’aigriser sa surface & lui faire perdre sa transparence."
                            }
                        ]
                    },
                    {
                        "sense_id": "25785232-ca6e-3904-85fa-905a990a22c5",
                        "entry_id": "310ec113-dcbf-3915-9d2d-9fdcb406869d",
                        "glosses": [
                            "ou Devenir aigre."
                        ],
                        "tags": [
                            "intransitive",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "98d8fe62-bf1a-4be5-bc4a-1f8316281d8e",
                                "sense_id": "25785232-ca6e-3904-85fa-905a990a22c5",
                                "text": "Si on ne peut plus aigriser un peu, qu'est-ce qui nous reste ?"
                            },
                            {
                                "example_id": "83c9702f-26c0-4954-845b-aa07fb309f1f",
                                "sense_id": "25785232-ca6e-3904-85fa-905a990a22c5",
                                "text": "Retourne aigriser sur CPC toi."
                            },
                            {
                                "example_id": "04f8b3b5-bb06-44dc-965d-6f2ab39a2a9f",
                                "sense_id": "25785232-ca6e-3904-85fa-905a990a22c5",
                                "text": "Ah ben là moi j'attend plus rien de rien, je vais m'aigriser encore plus, et retourner m'enfouir dans notre passion commune sur ce forum."
                            }
                        ]
                    }
                ],
