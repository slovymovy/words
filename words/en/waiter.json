{
    "word_family": [
        "wait",
        "waitress",
        "waitstaff",
        "waitering",
        "dumbwaiter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6568d8e8-c2ac-38d9-9a3c-ddb1833e48c9",
                    "sense_definition": "A person who serves customers at their tables in a restaurant or café.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "restaurant_staff",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>waiter</w> brought us the menu and asked if we wanted any drinks.",
                            "target_lang_translations": {
                                "ru": "<w>Официант</w> принес нам меню и спросил, не хотим ли мы каких-нибудь напитков.",
                                "fr": "Le <w>serveur</w> nous a apporté la carte et nous a demandé si nous voulions des boissons."
                            }
                        },
                        {
                            "text": "I decided to call the <w>waiter</w> because there was a fly in my soup.",
                            "target_lang_translations": {
                                "ru": "Я решил позвать <w>официанта</w>, потому что в моем супе была муха.",
                                "fr": "J'ai décidé d'appeler le <w>serveur</w> parce qu'il y avait une mouche dans ma soupe."
                            }
                        }
                    ],
                    "synonyms": [
                        "server",
                        "waitstaff",
                        "attendant"
                    ],
                    "antonyms": [
                        "customer",
                        "guest",
                        "diner"
                    ],
                    "common_phrases": [
                        "call the waiter",
                        "head waiter",
                        "restaurant waiter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который обслуживает посетителей за столиками в ресторане или кафе.",
                        "fr": "Personne qui sert les clients à leur table dans un restaurant ou un café."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "официант",
                                "target_lang_sense_clarification": "мужчина, обслуживающий в ресторане"
                            },
                            {
                                "target_lang_word": "официантка",
                                "target_lang_sense_clarification": "женщина, обслуживающая в ресторане"
                            },
                            {
                                "target_lang_word": "кельнер",
                                "target_lang_sense_clarification": "устаревшее или в западноевропейском контексте"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "serveur",
                                "target_lang_sense_clarification": "homme qui sert à table"
                            },
                            {
                                "target_lang_word": "serveuse",
                                "target_lang_sense_clarification": "femme qui sert à table"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e63b0b90-fe35-3a3f-87b6-91ca5eee77ab",
                    "sense_definition": "A person who is waiting for someone or something to happen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "waiting_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital tried to reduce the number of long <w>waiters</w> on the surgery list.",
                            "target_lang_translations": {
                                "ru": "Больница пыталась сократить число тех, кто долго <w>ожидает</w> в списке на операцию.",
                                "fr": "L'hôpital a essayé de réduire le nombre de personnes <w>attendant</w> depuis longtemps sur la liste d'opération."
                            }
                        },
                        {
                            "text": "As a <w>waiter</w> for the news, he sat by the phone all afternoon.",
                            "target_lang_translations": {
                                "ru": "Как человек, <w>ждущий</w> новостей, он просидел у телефона весь день.",
                                "fr": "En <w>attente</w> de nouvelles, il est resté assis près du téléphone tout l'après-midi."
                            }
                        }
                    ],
                    "synonyms": [
                        "expectant"
                    ],
                    "common_phrases": [
                        "long waiter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ждет кого-то или наступления какого-либо события.",
                        "fr": "Personne qui attend quelqu'un ou que quelque chose se produise."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ожидающий",
                                "target_lang_sense_clarification": "тот, кто находится в состоянии ожидания"
                            },
                            {
                                "target_lang_word": "ждущий",
                                "target_lang_sense_clarification": "человек, который ждет"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "personne en attente",
                                "target_lang_sense_clarification": "quelqu'un qui patiente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "faa143a0-bc2c-39c4-a6f2-ea6f891d0098",
                    "sense_definition": "A tray or vessel used for carrying dishes or glasses.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "serving_vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hall was cluttered with a <w>waiter</w> full of glasses from the party.",
                            "target_lang_translations": {
                                "ru": "Зал был загроможден <w>подносом</w>, полным стаканов после вечеринки.",
                                "fr": "Le hall était encombré par un <w>plateau</w> rempli de verres provenant de la fête."
                            }
                        },
                        {
                            "text": "She placed the silver <w>waiter</w> on the table to serve the tea.",
                            "target_lang_translations": {
                                "ru": "Она поставила серебряный <w>поднос</w> на стол, чтобы подать чай.",
                                "fr": "Elle a posé le <w>plateau</w> en argent sur la table pour servir le thé."
                            }
                        }
                    ],
                    "synonyms": [
                        "tray",
                        "salver"
                    ],
                    "common_phrases": [
                        "silver waiter"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used to describe a serving tray"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднос или сосуд, используемый для переноски посуды или стаканов.",
                        "fr": "Plateau ou récipient utilisé pour transporter de la vaisselle ou des verres."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднос",
                                "target_lang_sense_clarification": "плоское изделие для подачи еды и напитков"
                            },
                            {
                                "target_lang_word": "сальва",
                                "target_lang_sense_clarification": "архаичный серебряный поднос"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "plateau",
                                "target_lang_sense_clarification": "objet plat pour porter des verres ou des plats"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d46b476b-7fcf-3168-b796-56cead3c051e",
                    "sense_definition": "A person employed to keep watch; a watchman.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "guard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The night <w>waiter</w> patrolled the grounds to ensure everything was secure.",
                            "target_lang_translations": {
                                "ru": "Ночной <w>сторож</w> патрулировал территорию, чтобы убедиться, что все в безопасности.",
                                "fr": "Le <w>gardien</w> de nuit patrouillait sur les lieux pour s'assurer que tout était en sécurité."
                            }
                        },
                        {
                            "text": "In olden times, a <w>waiter</w> would stand guard at the city gates.",
                            "target_lang_translations": {
                                "ru": "В прежние времена <w>стражник</w> стоял на карауле у городских ворот.",
                                "fr": "Autrefois, un <w>garde</w> montait la garde aux portes de la ville."
                            }
                        }
                    ],
                    "synonyms": [
                        "watchman",
                        "guard",
                        "sentry"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historical term for a watchman"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, нанятый для несения караула; сторож.",
                        "fr": "Personne employée pour monter la garde ; un gardien."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сторож",
                                "target_lang_sense_clarification": "человек, охраняющий объект"
                            },
                            {
                                "target_lang_word": "стражник",
                                "target_lang_sense_clarification": "исторический термин для охранника"
                            },
                            {
                                "target_lang_word": "часовой",
                                "target_lang_sense_clarification": "вооруженный охранник на посту"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "gardien",
                                "target_lang_sense_clarification": "personne chargée de la surveillance"
                            },
                            {
                                "target_lang_word": "sentinelle",
                                "target_lang_sense_clarification": "soldat ou garde en faction"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "63324d44-e5e5-3825-92a4-97593168690b",
                    "sense_definition": "To perform the duties of a <w>waiter</w> in a restaurant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "work_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>waitered</w> at a local bistro to pay his way through college.",
                            "target_lang_translations": {
                                "ru": "Он <w>работал официантом</w> в местном бистро, чтобы оплатить учебу в колледже.",
                                "fr": "Il a <w>travaillé comme serveur</w> dans un bistrot local pour payer ses études universitaires."
                            }
                        },
                        {
                            "text": "She has <w>waitered</w> for years and knows how to handle difficult customers.",
                            "target_lang_translations": {
                                "ru": "Она годами <w>работала официанткой</w> и знает, как обращаться с трудными клиентами.",
                                "fr": "Elle a <w>travaillé comme serveuse</w> pendant des années et sait comment gérer les clients difficiles."
                            }
                        }
                    ],
                    "synonyms": [
                        "serve",
                        "wait"
                    ],
                    "common_phrases": [
                        "waitered for years"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять обязанности официанта в ресторане.",
                        "fr": "Exercer le métier de serveur dans un restaurant."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "работать официантом",
                                "target_lang_sense_clarification": "заниматься обслуживанием столиков"
                            },
                            {
                                "target_lang_word": "прислуживать",
                                "target_lang_sense_clarification": "подавать еду (часто в более старом смысле)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "travailler comme serveur",
                                "target_lang_sense_clarification": "exercer la profession de serveur"
                            },
                            {
                                "target_lang_word": "faire le service",
                                "target_lang_sense_clarification": "assurer le service en salle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}