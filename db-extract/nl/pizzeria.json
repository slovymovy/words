                                                "example_id": "d213892f-fa1a-4d05-9f17-34765404250d",
                                                "sense_id": "e48fbf6e-c0db-3e43-9edd-36cd788a6825",
                                                "text": "„Wir gehen um zwei Ecken, in eine Pizzeria.“"
                                            },
                                            {
                                                "example_id": "b113042b-1afd-46b0-850c-f5fdb14e6a4d",
                                                "sense_id": "e48fbf6e-c0db-3e43-9edd-36cd788a6825",
                                                "text": "„Der lustigste Ausspruch, den ich hierzulande je hörte, fiel vor ein paar Jahren, als ich mit ein paar Freunden in einer leicht überteuerten Pizzeria zusammensaß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
