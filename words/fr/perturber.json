    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb1cd599-74f0-3d85-950a-bba02dff03d7",
                    "sense_definition": "Déranger le cours normal ou le déroulement régulier d'une activité, d'un événement ou d'un service.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "derangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La grève des transports va <w>perturber</w> la circulation dans tout le centre-ville.",
                            "target_lang_translations": {
                                "en": "The transport strike will <w>disrupt</w> traffic throughout the city centre.",
                                "ru": "Забастовка транспорта <w>нарушит</w> движение во всём центре города.",
                                "de": "Der Streik der Verkehrsbetriebe wird den Verkehr in der gesamten Innenstadt <w>stören</w>.",
                                "es": "La huelga de transportes <w>perturbará</w> el tráfico en todo el centro de la ciudad.",
                                "zh": "交通运输罢工将<w>扰乱</w>整个市中心的交通。"
                            }
                        },
                        {
                            "text": "Cette manifestation imprévue a réussi à <w>perturber</w> le déroulement de la conférence.",
                            "target_lang_translations": {
                                "en": "This unexpected demonstration managed to <w>disrupt</w> the conference's proceedings.",
                                "ru": "Эта непредвиденная демонстрация сумела <w>нарушить</w> ход конференции.",
                                "de": "Diese unvorhergesehene Demonstration schaffte es, den Ablauf der Konferenz zu <w>stören</w>.",
                                "es": "Esta manifestación imprevista logró <w>interrumpir</w> el desarrollo de la conferencia.",
                                "zh": "这场突如其来的示威成功<w>扰乱</w>了会议的进行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bouleverser",
                        "déranger"
                    ],
                    "common_phrases": [
                        "perturber la circulation",
                        "perturber le trafic"
                    ],
                    "target_lang_definitions": {
                        "en": "To interrupt or throw into disorder the normal course of an activity, event, or service.",
                        "ru": "Нарушать нормальный ход деятельности, событий или работы служб.",
                        "de": "Den normalen Ablauf einer Tätigkeit, eines Ereignisses oder eines Dienstes unterbrechen oder durcheinanderbringen.",
                        "es": "Interrumpir o desordenar el curso normal de una actividad, un suceso o un servicio.",
                        "zh": "打断某项活动、事件或服务的正常进行，使其陷入混乱。"
                    },
                    "translations": {
                        "en": [
                            {
