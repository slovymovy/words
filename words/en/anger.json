                {
                    "sense_id": "ddf99fba-4710-308e-9494-14c06b4eefe4",
                    "sense_definition": "Pain or inflammation of a sore or wound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medicine helped to take away the <w>anger</w> of the wound.",
                            "target_lang_translations": {
                                "ru": "Лекарство помогло снять <w>воспаление</w> раны.",
                                "de": "Das Medikament half, die <w>Entzündung</w> der Wunde zu lindern.",
                                "zh": "药物有助于消除伤口的<w>炎症</w>。",
                                "nl": "Het medicijn hielp om de <w>ontsteking</w> van de wond te verminderen.",
                                "pl": "Lekarstwo pomogło złagodzić <w>stan zapalny</w> rany."
                            }
                        },
                        {
                            "text": "He waited for the <w>anger</w> in his sore foot to subside.",
                            "target_lang_translations": {
                                "ru": "Он ждал, пока утихнет <w>боль</w> в его больной ноге.",
                                "de": "Er wartete darauf, dass der <w>Schmerz</w> in seinem wunden Fuß nachließ.",
                                "zh": "他等着脚上的<w>疼痛</w>消退。",
                                "nl": "Hij wachtte tot de <w>pijn</w> in zijn zere voet zou afnemen.",
                                "pl": "Czekał, aż <w>ból</w> w obolałej stopie ustąpi."
                            }
                        }
                    ],
                    "traits": [
