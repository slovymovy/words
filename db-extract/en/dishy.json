                "senses": [
                    {
                        "sense_id": "52eebdc0-dfb8-374b-b291-2bd59df7ae56",
                        "entry_id": "cb4a1bd2-bc54-33e0-90e9-b16a02ea1d95",
                        "glosses": [
                            "Tending to relay information and gossip."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d6801a43-b4c7-493a-9b77-d1570b50916d",
                                "sense_id": "52eebdc0-dfb8-374b-b291-2bd59df7ae56",
                                "text": "\"[…] that transformed her into a shimmering golden redhead.\" That color became Lucy's trademark hair color for the rest of her career. Guilaroff wrote a dishy memoir in 1996, Crowning Glory […]"
                            },
                            {
                                "example_id": "fd553154-5023-4ec9-a4b7-18b17d922596",
                                "sense_id": "52eebdc0-dfb8-374b-b291-2bd59df7ae56",
                                "text": "A reference book that also takes a playful glimpse into the personal lives of some fascinating artists and personalities Kramer peppers this superior tome with the kind of dishy details that will keep readers turning the page."
                            },
                            {
                                "example_id": "ad11f681-d02d-40e8-b7f1-a5605027194b",
                                "sense_id": "52eebdc0-dfb8-374b-b291-2bd59df7ae56",
                                "text": "Without some dishy details, Vern might not pass my name up the ladder. I jumped up, restless."
                            },
                            {
                                "example_id": "125fbbf5-7c31-4063-9b77-17664a96ea7f",
                                "sense_id": "52eebdc0-dfb8-374b-b291-2bd59df7ae56",
                                "text": "With its sympathetic narrator, suspenseful plot pivots, snappy pace, and dishy details about Hollywood's inner workings, Liftin's compelling, highly readable novel is likely to engage even readers who remain blissfully unaware of the tabloid ..."
                            }
                        ]
                    }
                ],
