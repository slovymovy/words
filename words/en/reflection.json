{
    "word_family": [
        "reflect",
        "reflective",
        "reflector",
        "unreflective"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39485565-099e-387b-8983-6531d2e54442",
                    "sense_definition": "An image seen in a mirror or on a shiny surface.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_reflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog barked at his own <w>reflection</w> in the mirror.",
                            "target_lang_translations": {
                                "ru": "Собака залаяла на свое собственное <w>отражение</w> в зеркале."
                            }
                        },
                        {
                            "text": "She looked at her <w>reflection</w> in the water of the lake.",
                            "target_lang_translations": {
                                "ru": "Она посмотрела на свое <w>отражение</w> в воде озера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mirror reflection",
                        "reflection in the water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображение, видимое в зеркале или на блестящей поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отражение",
                                "target_lang_sense_clarification": "в зеркале или воде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e446014-0858-36e7-927d-d2a836500b52",
                    "sense_definition": "Serious and careful thought about something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After careful <w>reflection</w>, I have decided not to vote for that proposition.",
                            "target_lang_translations": {
                                "ru": "После тщательного <w>размышления</w> я решил не голосовать за это предложение."
                            }
                        },
                        {
                            "text": "The book is a collection of his personal <w>reflections</w> on life.",
                            "target_lang_translations": {
                                "ru": "Книга представляет собой сборник его личных <w>размышлений</w> о жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "cogitation",
                        "contemplation",
                        "deliberation",
                        "mulling",
                        "musing",
                        "pondering",
                        "meditation",
                        "thought"
                    ],
                    "common_phrases": [
                        "careful reflection",
                        "moment of reflection",
                        "personal reflection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серьезное и тщательное обдумывание чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размышление",
                                "target_lang_sense_clarification": "процесс обдумывания"
                            },
                            {
                                "target_lang_word": "раздумье",
                                "target_lang_sense_clarification": "состояние глубокого обдумывания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a98e8b6-ce5f-31c8-a788-5ab948a3763a",
                    "sense_definition": "A sign or result that shows the nature or quality of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manifestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our recent results are a <w>reflection</w> of the progress we've made as a team.",
                            "target_lang_translations": {
                                "ru": "Наши недавние результаты являются <w>отражением</w> прогресса, которого мы достигли как команда."
                            }
                        },
                        {
                            "text": "The messy room was a <w>reflection</w> of his state of mind.",
                            "target_lang_translations": {
                                "ru": "Беспорядок в комнате был <w>отражением</w> его душевного состояния."
                            }
                        }
                    ],
                    "common_phrases": [
                        "true reflection",
                        "reflection of progress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Признак или результат, который показывает природу или качество чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отражение",
                                "target_lang_sense_clarification": "проявление чего-либо"
                            },
                            {
                                "target_lang_word": "показатель",
                                "target_lang_sense_clarification": "свидетельство качества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04accaef-5b08-3a53-8d65-2dc9e3f535d9",
                    "sense_definition": "The return of light, heat, or sound from a surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_reflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reflection</w> of light from the snow was blindingly bright.",
                            "target_lang_translations": {
                                "ru": "<w>Отражение</w> света от снега было ослепительно ярким."
                            }
                        },
                        {
                            "text": "Scientists measured the <w>reflection</w> of the radar waves.",
                            "target_lang_translations": {
                                "ru": "Ученые измерили <w>отражение</w> радарных волн."
                            }
                        }
                    ],
                    "common_phrases": [
                        "light reflection",
                        "angle of reflection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращение света, тепла или звука от поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отражение",
                                "target_lang_sense_clarification": "физический процесс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26e47bea-06fc-3804-b69c-ca70c2b863e7",
                    "sense_definition": "An action or remark that brings discredit or criticism to someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manifestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a <w>reflection</w> on his character that he never came back to see them.",
                            "target_lang_translations": {
                                "ru": "Это бросает <w>тень</w> на его характер, что он так и не вернулся навестить их."
                            }
                        },
                        {
                            "text": "The failure of the project is a poor <w>reflection</w> on the management.",
                            "target_lang_translations": {
                                "ru": "Провал проекта — это плохое <w>свидетельство</w> о работе руководства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reflection on character",
                        "poor reflection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или замечание, которое бросает тень или вызывает критику в чей-то адрес."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "на репутацию"
                            },
                            {
                                "target_lang_word": "свидетельство",
                                "target_lang_sense_clarification": "не в пользу кого-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f635385d-64fa-3950-b7fc-1b034fca1fba",
                    "sense_definition": "The ability of a computer program to examine and modify its own structure and behavior at runtime.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "DynamicMBeanFacade uses Java's <w>reflection</w> API to introspect the managed resource.",
                            "target_lang_translations": {
                                "ru": "DynamicMBeanFacade использует Java <w>reflection</w> API для интроспекции управляемого ресурса."
                            }
                        },
                        {
                            "text": "Using <w>reflection</w> can make the code more flexible but slower.",
                            "target_lang_translations": {
                                "ru": "Использование <w>рефлексии</w> может сделать код более гибким, но более медленным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reflection API"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность компьютерной программы изучать и изменять свою структуру и поведение во время выполнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рефлексия",
                                "target_lang_sense_clarification": "в программировании"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}