                                            },
                                            {
                                                "example_id": "60fc825f-eb24-4a0f-8bc9-561c0baa378d",
                                                "sense_id": "f85b6303-862a-3fd0-a7d2-07f928dcfc7f",
                                                "text": "Un chat qui s’épuce."
