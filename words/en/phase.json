                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team managed to string together several <w>phases</w> before finally scoring.",
                            "target_lang_translations": {
                                "ru": "Команде удалось провести несколько <w>фаз</w> атаки, прежде чем они наконец забили.",
