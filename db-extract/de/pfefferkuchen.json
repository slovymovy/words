                ],
                "senses": [
                    {
                        "sense_id": "1d700983-5ee1-39d8-8afe-0828e1379edc",
                        "entry_id": "abf86d5f-f3cc-30ea-b63b-143cbb417881",
                        "glosses": [
                            "Gebäck, das mit exotischen Gewürzen verfeinert vor allem in der Adventszeit gebacken wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d3de416-c818-49cf-8260-8e7dda9e0fff",
                                "sense_id": "1d700983-5ee1-39d8-8afe-0828e1379edc",
                                "text": "Ich esse Pfefferkuchen sehr gerne."
                            },
                            {
                                "example_id": "ce5f13ac-dc19-4169-806f-6662b6ae49a0",
                                "sense_id": "1d700983-5ee1-39d8-8afe-0828e1379edc",
                                "text": "Das besondere an diesen Pfefferkuchen sind das Hirschhornsalz und das Pfefferkuchengewürz."
                            },
                            {
                                "example_id": "eb1c2d6c-e3b7-4131-a06c-e7f978038cb0",
                                "sense_id": "1d700983-5ee1-39d8-8afe-0828e1379edc",
                                "text": "„Düfte von Pfefferkuchen ziehen durchs Haus.“"
                            },
                            {
                                "example_id": "58d88fcd-6664-45ae-b866-96143534385e",
                                "sense_id": "1d700983-5ee1-39d8-8afe-0828e1379edc",
                                "text": "„Zuweilen wurde auch diese Stille durch die Insubordination der erwähnten Quasi-Kompanie, die außerhalb des Städtchens manövrierte, oder durch die gellende Stimme eines Weibes oder Mädchens unterbrochen, das Pfefferkuchen, Äpfel und Zider ausschrie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
