                "senses": [
                    {
                        "sense_id": "7da613db-c7fa-3840-993f-572ff90a67da",
                        "entry_id": "34992e15-70a0-37a4-86da-65c7ad698b2e",
                        "glosses": [
                            "Bewohnerin von Texas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe7dec4-9dae-4d6f-8898-9b02987b53bd",
                                "sense_id": "7da613db-c7fa-3840-993f-572ff90a67da",
                                "text": "„Auf Nachfrage gibt die gebürtige Texanerin, die seit rund einem Jahr die US-Regierung in Österreich vertritt, allerdings an, dass \"nichts Geheimes\" in Wien geschehe.“"
                            },
                            {
                                "example_id": "db48ef87-a2c3-4f8e-9f26-9a42223e01c3",
                                "sense_id": "7da613db-c7fa-3840-993f-572ff90a67da",
                                "text": "„Die Mutter des nichtehelichen Kindes sei eine Texanerin, die Frau habe die Tür zugeschlagen, als Vanity Fair bei ihr angeklopft habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
