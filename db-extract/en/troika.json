                        "target_lang_word": "trojka",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trojka",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cb3dcc1a-dd13-3086-b40d-0e9fae671ea0",
                                        "entry_id": "881f98ea-231b-3d88-b86a-3d50e8dc83cb",
                                        "glosses": [
                                            "licht Russisch rijtuig met drie paarden bespannen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6d133de-430d-4d32-ab7f-255d0f2ddd22",
                                                "sense_id": "cb3dcc1a-dd13-3086-b40d-0e9fae671ea0",
                                                "text": "'n Landeigenaar stapte in oude tijden, wanneer hem de lust bekroop, in z'n trojka en maakte een rondrit langs zijn pachters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44146067-1d53-3c78-a702-cbcfa1a45135",
                                        "entry_id": "881f98ea-231b-3d88-b86a-3d50e8dc83cb",
                                        "glosses": [
                                            "nummer van paardendressuur"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1258ceac-c8dd-3287-96a1-3fca616de131",
                                        "entry_id": "881f98ea-231b-3d88-b86a-3d50e8dc83cb",
                                        "glosses": [
                                            "politieke leiding die bestaat uit drie (rechts-)personen"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1575eed-1748-4a15-aeed-fcb9850a37d9",
                                                "sense_id": "1258ceac-c8dd-3287-96a1-3fca616de131",
                                                "text": "De zogenoemde trojka van deskundigen keert de komende dagen terug naar Griekenland om te praten over de stand van zaken bij de noodzakelijke hervormingen"
                                            },
                                            {
                                                "example_id": "8dc10dc7-59e8-41c0-b448-4fcfffcbf06d",
                                                "sense_id": "1258ceac-c8dd-3287-96a1-3fca616de131",
                                                "text": "Journalisten vroegen Merkel tijdens de persconferentie hoe lang ze nog kan wachten op het rapport van de trojka over Griekenland. Als het klaar is, is het klaar, zei Merkel. \"Gedegenheid is belangrijker is dan snelheid.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "583002fe-25c3-3066-aeda-edb9e549a552",
                                        "entry_id": "881f98ea-231b-3d88-b86a-3d50e8dc83cb",
                                        "glosses": [
                                            "bepaalde Russische volksdans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b3dc98a-ceca-4122-a5fd-c7ef4461ff67",
                                                "sense_id": "583002fe-25c3-3066-aeda-edb9e549a552",
                                                "text": "Net als Tarantino in ‘Inglourious Basterds’ en ‘Once Upon A Time In Hollywood’ voert Vaughn een reeks historische figuren op, maar herschrijft hij de geschiedkundige context. Het verschil: kiest Tarantino ervoor om Hitler genadeloos aan flarden te knallen, dan laat Vaughn Rasputin de trojka dansen tijdens het zwaardvechten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "980cbce7-0085-40f0-abd1-d42ad53aeb84",
                        "source_entry_id": "b67f8ab7-f1fe-3d15-a99b-c517a72b3389",
                        "source_sense_description": "carriage",
                        "target_lang_word": "troïka",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troïka",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d31b74be-c787-36ff-95cd-e3ba809ee39b",
                                        "entry_id": "9c260a57-8661-3b3a-ac5d-15eb881e9074",
                                        "glosses": [
                                            "Chariot ou traîneau russe tiré par un attelage de trois chevaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f8abfb4-c1c9-3528-b8c9-05717aae1673",
                                        "entry_id": "9c260a57-8661-3b3a-ac5d-15eb881e9074",
                                        "glosses": [
                                            "Réunion de trois personnes."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a8c8caf-082b-45ba-8f9c-5c9e90acc854",
                                                "sense_id": "3f8abfb4-c1c9-3528-b8c9-05717aae1673",
                                                "text": "29 décembre 1940 – Dès qu’il est couché, nous faisons troïka, dans le grand divan vert, la couverture de fourrure sur les genoux, maman, Flora et moi avec la nuit devant nous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb0fede6-539e-3569-aa9c-73a819643844",
                                        "entry_id": "9c260a57-8661-3b3a-ac5d-15eb881e9074",
                                        "glosses": [
                                            "Alliance de trois personnalités politiques ou militaires pour diriger."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0d30c0-edce-4b88-ba72-bdbd8c75b537",
                                                "sense_id": "fb0fede6-539e-3569-aa9c-73a819643844",
                                                "text": "En 1955, nous étions sous le choc de la “réconciliation” soviéto-yougoslave. Sans crier gare, la troïka moscovite avait débarqué à Belgrade pour se jeter dans les bras de Tito et le couvrir de fleurs."
                                            },
                                            {
                                                "example_id": "ef82268b-47b6-4400-927c-f7870f491bb2",
                                                "sense_id": "fb0fede6-539e-3569-aa9c-73a819643844",
                                                "text": "L’Union européenne, représentée par la troïka France, Allemagne et Grande-Bretagne, et l’Iran ont repris, mercredi 21 décembre, à Vienne, des pourparlers cruciaux sur le programme nucléaire de Téhéran"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6933167a-d4f2-3fd8-ab0d-2586c8560e4a",
                                        "entry_id": "9c260a57-8661-3b3a-ac5d-15eb881e9074",
                                        "glosses": [
                                            "Experts représentant la Commission européenne, la Banque centrale européenne et le Fonds monétaire international."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc0b044d-339f-4748-86b6-d536495e6d3d",
                                                "sense_id": "6933167a-d4f2-3fd8-ab0d-2586c8560e4a",
                                                "text": "« Des experts de la troïka calculent, notamment sous la pression de Berlin, les conséquences financières d’une faillite de Chypre », écrit le quotidien le plus lu d’Europe, sans citer de source."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7c610e4-954a-38a9-aa62-ab552d8a2e87",
                                        "entry_id": "9c260a57-8661-3b3a-ac5d-15eb881e9074",
                                        "glosses": [
                                            "Danse traditionnelle russe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdfbb0fe-0718-4cf0-800a-014d4340ded7",
                        "source_entry_id": "b67f8ab7-f1fe-3d15-a99b-c517a72b3389",
                        "source_sense_description": "carriage",
                        "target_lang_word": "Troika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Troika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b54c3da-2ba3-3ef4-ada4-6126af0b4683",
                                        "entry_id": "878b1fca-a6e9-373a-a5cf-9c92d3433d38",
                                        "glosses": [
                                            "Gespann aus drei Pferden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13b0c65f-31a7-4300-815b-59fa0ded1230",
                                                "sense_id": "5b54c3da-2ba3-3ef4-ada4-6126af0b4683",
                                                "text": "Die Troika ist eine vor allem in Russland und Westasien verbreitete Anspannung."
                                            },
                                            {
                                                "example_id": "e937b474-5cf6-4203-bd2e-542a65825b1b",
                                                "sense_id": "5b54c3da-2ba3-3ef4-ada4-6126af0b4683",
                                                "text": "„Die Pferde überschütteten die Gesichter der Schlitteninsassen mit feinem, trockenem Schneestaub, weithin klirrten und rasselten Glöckchen und Zaumzeug, und die hurtigen Pferdebeine bildeten mit dem Schatten der überholten Troika ein wirr dahinhuschendes Durcheinander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03e0ae5d-3889-3e2b-b351-77414947568b",
                                        "entry_id": "878b1fca-a6e9-373a-a5cf-9c92d3433d38",
                                        "glosses": [
                                            "Gruppe von drei Personen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c641efcf-caee-4fa2-9e64-3e89cba0c3da",
                                                "sense_id": "03e0ae5d-3889-3e2b-b351-77414947568b",
                                                "text": "Die Troika Schröder-Chirac-Putin hat eine Pressekonferenz abgehalten."
                                            },
                                            {
                                                "example_id": "3c2aa218-05a2-4acd-ac0f-0f8bd8a0f9ad",
                                                "sense_id": "03e0ae5d-3889-3e2b-b351-77414947568b",
                                                "text": "Seit dem Bruch der Troika Schröder-Lafontaine-Scharping standen die Riesen-Egos der Spitzengenossen der Teambildung an der SPD-Spitze entgegen."
                                            },
                                            {
                                                "example_id": "a260e263-aaf3-4c85-a95f-1e7fb8979d25",
                                                "sense_id": "03e0ae5d-3889-3e2b-b351-77414947568b",
                                                "text": "„Jakob und ich bestaunen die erhabene Erscheinung dieser Troika wie kleine Jungs den Auftritt eines Weihnachtsmanns samt Rentieren.“"
                                            },
                                            {
                                                "example_id": "b470ae42-3516-4188-a3ba-bb0d35c8c9a2",
                                                "sense_id": "03e0ae5d-3889-3e2b-b351-77414947568b",
                                                "text": "Für die Faktenerhebung werden Experten der drei beteiligten Institutionen EU-Kommission, Europäische Zentralbank und Internationaler Währungsfonds - vormals Troika genannt - nach Athen reisen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
