    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2de4d209-d892-390d-b4ea-9cb4eca791de",
                    "sense_definition": "An assistant, especially one who works for a political leader or government official.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "assistant_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senator's top <w>aide</w> prepared the speech for the morning conference.",
                            "target_lang_translations": {
                                "ru": "Главный <w>помощник</w> сенатора подготовил речь для утренней конференции.",
                                "zh": "参议员的首席<w>助手</w>为早晨的会议准备了演讲稿。"
                            }
                        },
                        {
                            "text": "She works as a close <w>aide</w> to the governor, managing his daily schedule.",
                            "target_lang_translations": {
                                "ru": "Она работает доверенным <w>помощником</w> губернатора, управляя его ежедневным расписанием.",
                                "zh": "她担任州长的亲信<w>助理</w>，负责管理他的日常日程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "assistant",
                        "adviser",
                        "helper",
                        "deputy"
                    ],
                    "common_phrases": [
                        "senior aide",
                        "political aide",
                        "presidential aide",
                        "close aide",
                        "top aide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помощник, особенно работающий на политического лидера или государственного чиновника.",
                        "zh": "助手，尤指政治领导人或政府官员的助理、顾问。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помощник",
                                "target_lang_sense_clarification": "ассистент руководителя"
                            },
                            {
                                "target_lang_word": "советник",
                                "target_lang_sense_clarification": "консультант"
                            },
                            {
                                "target_lang_word": "референт",
                                "target_lang_sense_clarification": "должностное лицо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "助手",
                                "target_lang_sense_clarification": "泛指政客或官员的助手"
                            },
                            {
                                "target_lang_word": "助理",
                                "target_lang_sense_clarification": "协助领导工作的职务"
                            },
                            {
                                "target_lang_word": "幕僚",
                                "target_lang_sense_clarification": "政界领导人的顾问、智囊"
                            },
                            {
                                "target_lang_word": "顾问",
                                "target_lang_sense_clarification": "提供专业咨询的随从人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0c46d5c-cb24-3289-a5c1-29386227f48e",
                    "sense_definition": "A military officer who acts as a confidential assistant to a senior officer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "assistant_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general instructed his <w>aide</w> to deliver the urgent message to the front lines.",
                            "target_lang_translations": {
                                "ru": "Генерал приказал своему <w>адъютанту</w> доставить срочное сообщение на передовую.",
                                "zh": "将军指示他的<w>副官</w>将紧急消息传达到前线。"
                            }
                        },
                        {
                            "text": "He served as a military <w>aide</w> during the war, organizing logistics for the commander.",
                            "target_lang_translations": {
                                "ru": "Во время войны он служил военным <w>адъютантом</w>, организуя логистику для командира.",
                                "zh": "战争期间他担任军事<w>副官</w>，为指挥官组织后勤保障。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aide-de-camp",
                        "adjutant"
                    ],
                    "antonyms": [
                        "commander"
                    ],
                    "common_phrases": [
                        "military aide"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short for aide-de-camp"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Военный офицер, выполняющий функции личного помощника старшего офицера.",
                        "zh": "副官，担任高级军官机要助手的军官。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адъютант",
                                "target_lang_sense_clarification": "военный чин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "副官",
                                "target_lang_sense_clarification": "高级军官身边的随从军官"
                            },
                            {
                                "target_lang_word": "侍从官",
                                "target_lang_sense_clarification": "负责长官日常与机要事务的军官"
                            }
                        ]
                    }
                }
            ]
