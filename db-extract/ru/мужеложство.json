                        "examples": [
                            {
                                "example_id": "e843aaaa-0cb0-4826-ad86-4b74b0ea7faf",
                                "sense_id": "5ab3b1b7-110b-370e-838e-484dfd947100",
                                "text": "«Мужело́жство» — оди́н из те́рминов в ру́сском языке́, обознача́ющий гомосексуа́льные отноше́ния. Разли́чные исто́чники ра́знятся в понима́нии поня́тия.",
                                "translation": "\"Мужело́жство\" is one of the terms in the Russian language denoting homosexual relations. Different sources differ in the understanding of the term.",
                                "english": "\"Мужело́жство\" is one of the terms in the Russian language denoting homosexual relations. Different sources differ in the understanding of the term."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6b0babb-7c33-3f9c-a3f7-18e33b4ea509",
                        "entry_id": "905605d5-8202-3eb8-9ff8-e846545e90f2",
                        "glosses": [
                            "anal sex, gay sex"
                        ],
