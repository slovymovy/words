                                "sense_id": "5c0d7617-a998-3357-8d98-7521fa07ff83",
                                "text": "Patienten mit Hyperhidrose leiden häufig unter einem starken sozialen und psychischen Leidensdruck."
                            },
                            {
                                "example_id": "58fcffbe-cfa9-42fe-977d-d5e8c6208cf8",
                                "sense_id": "5c0d7617-a998-3357-8d98-7521fa07ff83",
                                "text": "„Die genaue Ursache der axillären Hyperhidrose ist nicht bekannt, jedoch wird vermutet, dass ein überaktives Nervensystem sie verursacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
