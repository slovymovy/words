                                                "sense_id": "388bda1d-b86a-3cf3-8c49-ea9f8f0feda1",
                                                "text": "His inclination to drink escalated to alcoholism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0202364e-096d-329c-9069-267b9f012094",
                                        "entry_id": "9cfeeb01-cbb3-37ac-ac7c-56144c201dba",
                                        "glosses": [
                                            "The angle of intersection of a reference plane."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cba1937d-5725-47ff-9831-90b834a65b3a",
                                                "sense_id": "0202364e-096d-329c-9069-267b9f012094",
                                                "text": "The astronomer calculated the inclination of the equator or ecliptic of Earth and the orbital planes of each visible heavenly body."
                                            },
                                            {
                                                "example_id": "4d017a2e-e9ef-40b2-9884-c1b42f2b311b",
                                                "sense_id": "0202364e-096d-329c-9069-267b9f012094",
                                                "text": "Artillery must take account of a weapon's precise inclination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfdd0dcd-3059-387d-9b7d-fd33174fc18a",
                                        "entry_id": "9cfeeb01-cbb3-37ac-ac7c-56144c201dba",
                                        "glosses": [
                                            "A person or thing loved or admired."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ed2254c-f31d-4e13-a343-af16a4cc9971",
                                                "sense_id": "bfdd0dcd-3059-387d-9b7d-fd33174fc18a",
                                                "text": "c. 1672-1679, William Temple, Memoirs\nyou make will be a Discovery of your Inclinations"
                                            },
                                            {
                                                "example_id": "8db03a30-aaa2-4f2b-8837-e822ee09a503",
                                                "sense_id": "bfdd0dcd-3059-387d-9b7d-fd33174fc18a",
                                                "text": "c. 1771, John Adams, speaking in a trial\nFacts are stubborn things; and whatever may be our wishes, our inclinations, or the dictates of our passion, they cannot alter the state of facts and evidence."
                                            }
                                        ]
                                    }
                                ]
