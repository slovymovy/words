    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f4d2fe2-f107-3472-8773-3a64b4632ed6",
                    "sense_definition": "Se propager ou se manifester rapidement et en grand nombre de toutes parts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propagation_verbale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès l'annonce de la mesure controversée, les questions ont commencé à <w>fuser</w> dans la salle."
                        },
                        {
                            "text": "Durant le débat télévisé, les critiques <w>fusent</w> de toutes parts sans laisser de répit au ministre."
                        }
                    ],
                    "synonyms": [
                        "jaillir",
                        "pleuvoir"
                    ],
                    "common_phrases": [
                        "fuser de toutes parts",
                        "les critiques fusent"
                    ]
                },
                {
                    "sense_id": "49193f44-a6de-333a-a3a4-783c62fc8a0c",
                    "sense_definition": "Sortir ou se manifester de façon soudaine, vive et spontanée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "jaillissement_spontane",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa répartie cinglante a <w>fusé</w> sans la moindre seconde d'hésitation, amusant toute l'assemblée."
                        },
                        {
                            "text": "Un rire franc et sonore <w>fuse</w> soudain au milieu de cette ambiance pesante."
                        }
                    ],
                    "synonyms": [
                        "jaillir"
                    ],
                    "common_phrases": [
                        "la réponse fuse"
                    ]
                },
                {
                    "sense_id": "aba30394-c973-3e29-b517-4d2ca7c17575",
                    "sense_definition": "Jaillir avec force et rapidité à la manière d'une fusée, en parlant d'un fluide ou d'un projectile.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jaillissement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un jet de vapeur brûlante a soudainement <w>fusé</w> de la vieille tuyauterie sous pression."
                        },
                        {
                            "text": "Sous l'effet de l'explosion, plusieurs débris ont <w>fusé</w> au-dessus des têtes des témoins terrifiés."
