    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a92d8e61-54cf-3e62-8504-0e21bcf1d1a3",
                    "sense_definition": "Personne dont on descend par filiation, généralement au-delà des grands-parents.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a fait des recherches généalogiques pour retrouver les traces de ses <w>ancêtres</w> en Italie."
                        },
                        {
                            "text": "La maison familiale appartenait autrefois à un <w>ancêtre</w> qui s'était installé dans la région."
                        }
                    ],
                    "synonyms": [
                        "ascendant",
                        "aïeul"
                    ],
                    "antonyms": [
                        "descendant"
                    ],
                    "common_phrases": [
                        "culte des ancêtres",
                        "ancêtre commun",
                        "terre des ancêtres"
                    ]
                },
                {
                    "sense_id": "0409b5c6-fb53-3b38-b6fa-4ae55d5de147",
                    "sense_definition": "Objet, dispositif ou concept ancien qui a précédé et préfiguré une création moderne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "precurseur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le télégraphe est souvent considéré comme l'<w>ancêtre</w> direct de nos réseaux de communication modernes."
                        },
                        {
                            "text": "Ce vieux modèle mécanique constitue l'<w>ancêtre</w> de la bicyclette telle que nous la connaissons."
                        }
                    ],
                    "common_phrases": [
                        "ancêtre direct"
                    ]
                },
                {
                    "sense_id": "72d2bd8f-d2cf-361a-8d8f-d961a57e0e5c",
                    "sense_definition": "Membre des générations humaines du passé lointain qui ont précédé l'époque contemporaine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les archéologues tentent de comprendre le mode de vie de nos lointains <w>ancêtres</w> préhistoriques."
                        },
                        {
                            "text": "Ces peintures rupestres montrent comment nos <w>ancêtres</w> chassaient les animaux sauvages."
                        }
                    ],
                    "common_phrases": [
                        "lointains ancêtres",
                        "nos ancêtres les Gaulois"
                    ]
                },
                {
                    "sense_id": "8e23d445-a7c0-305f-a1ae-cdec1727f1a4",
                    "sense_definition": "Personne très âgée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laisse donc l'<w>ancêtre</w> traverser tranquillement sans lui klaxonner dessus."
                        },
                        {
                            "text": "Le vieil homme marchait à petits pas au milieu des promeneurs, tel un <w>ancêtre</w> infatigable."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent teinté d'ironie ou d'affection"
                        }
                    ]
                }
            ]
        }
