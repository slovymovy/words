                "senses": [
                    {
                        "sense_id": "ab4896d5-8075-3a81-abe7-549705de2351",
                        "entry_id": "87041857-d6ac-3a98-b5aa-4b9922a242f6",
                        "glosses": [
                            "Ort, an dem ein bestimmter Wettbewerb veranstaltet und entschieden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24be1230-800e-430b-b6d9-0e1d6d01250b",
                                "sense_id": "ab4896d5-8075-3a81-abe7-549705de2351",
                                "text": "München war Austragungsort der Olympischen Spiele 1972."
                            },
                            {
                                "example_id": "4621befb-9f3c-4f27-ba18-fbb6fe208f2f",
                                "sense_id": "ab4896d5-8075-3a81-abe7-549705de2351",
                                "text": "„Der Austragungsort für das DFB-Pokalspiel zwischen der fünftklassigen SV Hemelingen und dem Bundesligisten VfL Wolfsburg steht bisher nicht fest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84678b48-19f1-4a32-97d1-be95103c243d",
                        "source_entry_id": "87041857-d6ac-3a98-b5aa-4b9922a242f6",
                        "source_sense_id": "ab4896d5-8075-3a81-abe7-549705de2351",
