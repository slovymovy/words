{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b95725c7-5a42-3fec-b1f5-dd11b233c5df",
                    "sense_definition": "Indique qu'une action ou un état se poursuit dans le temps.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "continuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu es <w>encore</w> au lit alors qu'il est déjà midi passé."
                        },
                        {
                            "text": "Malgré l'heure tardive, les enfants sont <w>encore</w> réveillés dans leur chambre."
                        }
                    ],
                    "synonyms": [
                        "toujours"
                    ],
                    "common_phrases": [
                        "encore là",
                        "être encore en vie"
                    ]
                },
                {
                    "sense_id": "9863184c-39bf-384e-bd75-dae32008b754",
                    "sense_definition": "Indique une quantité supplémentaire de quelque chose.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Est-ce que tu veux <w>encore</w> de la soupe avant le dessert ?"
                        },
                        {
                            "text": "Il reste <w>encore</w> un peu de café chaud dans la cuisine."
                        }
                    ],
                    "synonyms": [
                        "davantage"
                    ],
                    "common_phrases": [
                        "encore un peu"
                    ]
                },
                {
                    "sense_id": "5f640fcc-0168-305a-8780-594fae866091",
                    "sense_definition": "Marque la répétition d'un événement ou d'une action.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a répété la consigne <w>encore</w> une fois pour les élèves."
                        },
                        {
                            "text": "Le train est <w>encore</w> en retard ce matin sur cette ligne."
                        }
                    ],
                    "synonyms": [
                        "à nouveau"
                    ],
                    "common_phrases": [
                        "encore une fois"
                    ]
                },
                {
                    "sense_id": "1da3726f-2974-3555-9c05-3eb2a8315d12",
                    "sense_definition": "Marque qu'un événement ne s'est pas produit jusqu'au moment présent, surtout en tournure négative.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "negation_temporelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train pour Paris n'est pas <w>encore</w> arrivé sur le quai."
                        },
                        {
                            "text": "Je n'ai pas <w>encore</w> fini de ranger tous mes livres."
                        }
                    ],
                    "common_phrases": [
                        "pas encore",
                        "jamais encore"
                    ],
                    "antonyms": [
                        "déjà"
                    ]
                },
                {
                    "sense_id": "3946b3fd-a0ef-31b3-8f15-79d12efe5ac7",
                    "sense_definition": "Sert à intensifier un adverbe comparatif de supériorité ou d'infériorité.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "intensification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette méthode de révision est <w>encore</w> plus efficace que la précédente."
                        },
                        {
                            "text": "Il fait très froid aujourd'hui et demain sera <w>encore</w> pire selon la météo."
                        }
                    ],
                    "common_phrases": [
                        "encore plus",
                        "encore moins",
                        "encore mieux"
                    ]
                },
                {
                    "sense_id": "cfb45e15-9d36-3022-8118-58d48734617d",
                    "sense_definition": "S'emploie pour ajouter un fait ou un élément supplémentaire à ce qui précède.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musée expose non seulement des peintures, mais <w>encore</w> de superbes sculptures anciennes."
                        },
                        {
                            "text": "En plus de son travail quotidien, il donne <w>encore</w> des cours particuliers le soir."
                        }
                    ],
                    "common_phrases": [
                        "mais encore",
                        "non seulement mais encore"
                    ]
                },
                {
                    "sense_id": "a5e2b65b-0d61-3da8-8129-633a01b232c6",
                    "sense_definition": "Introduit une restriction ou une condition nécessaire par rapport à ce qui vient d'être affirmé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous pourrions partir demain en voyage, <w>encore</w> faut-il trouver des billets disponibles."
                        },
                        {
                            "text": "Il a promis de réparer la voiture, mais <w>encore</w> faut-il qu'il ait les bons outils."
                        }
                    ],
                    "common_phrases": [
                        "encore faut-il"
                    ]
                },
                {
                    "sense_id": "489c59d0-0b60-3055-915c-09bb3a1a4cbc",
                    "sense_definition": "Exprime une atténuation ou une concession minimale ; du moins.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si <w>encore</w> il avait prévenu de son retard, nous ne serions pas si inquiets."
                        },
                        {
                            "text": "Elle accepterait volontiers cette décision, si <w>encore</w> on lui expliquait les raisons."
                        }
                    ],
                    "common_phrases": [
                        "si encore"
                    ]
                }
            ]
        }
    ]
}