                        "examples": [
                            {
                                "example_id": "279afab8-ada8-43d2-b690-a5a068bae480",
                                "sense_id": "5d4f452e-2af9-3034-a4f9-9ac2c7fd9bfd",
                                "text": "Ze kon vandaag niet zingen wegens keelpijn.",
                                "translation": "She couldn't sing today because of a sore throat.",
                                "english": "She couldn't sing today because of a sore throat."
                            },
                            {
                                "example_id": "a70514cb-4dd2-4056-8390-1621f9fc888c",
                                "sense_id": "5d4f452e-2af9-3034-a4f9-9ac2c7fd9bfd",
                                "text": "Hij klaagde over hevige keelpijn en kon nauwelijks praten.",
                                "translation": "He complained about severe sore throat and could hardly speak.",
                                "english": "He complained about severe sore throat and could hardly speak."
                            },
                            {
                                "example_id": "f0ef7732-ca52-489d-9472-2496bf1142be",
                                "sense_id": "5d4f452e-2af9-3034-a4f9-9ac2c7fd9bfd",
                                "text": "Ik heb last van keelpijn en moet veel water drinken om het te verzachten.",
                                "translation": "I have sore throat and need to drink a lot of water to soothe it.",
                                "english": "I have sore throat and need to drink a lot of water to soothe it."
                            },
                            {
                                "example_id": "b0531d1b-1585-49a9-98e0-8c8745293e03",
                                "sense_id": "5d4f452e-2af9-3034-a4f9-9ac2c7fd9bfd",
                                "text": "Bij keelpijntjes is het raadzaam om warme thee met honing te drinken.",
                                "translation": "For sore throats, it is advisable to drink warm tea with honey.",
                                "english": "For sore throats, it is advisable to drink warm tea with honey."
                            }
                        ]
                    }
