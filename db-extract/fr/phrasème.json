                ],
                "senses": [
                    {
                        "sense_id": "34f1c584-a3ea-3dbd-b7dd-76d86e5b521d",
                        "entry_id": "cb287a0f-9eeb-3d99-a0a3-3afde37ef39e",
                        "glosses": [
                            "Ensemble des expressions lexicalisées, telles que les expressions idiomatiques, les locutions et autres unités lexicales composées de plusieurs mots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51d75fda-3ee0-4477-9bbe-ea9a73a6b662",
                                "sense_id": "34f1c584-a3ea-3dbd-b7dd-76d86e5b521d",
                                "text": "On proposera donc le terme de phrasème pour désigner l'unité supérieure de l'analyse morphosyntaxique disposant d'une autonomie constructionnelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6f87550-66e8-4847-80a5-26668907998d",
                        "source_entry_id": "cb287a0f-9eeb-3d99-a0a3-3afde37ef39e",
                        "source_sense_id": "34f1c584-a3ea-3dbd-b7dd-76d86e5b521d",
                        "target_lang_word": "Phrasem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phrasem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9afaa146-31aa-3249-a7ff-0ccc3917bddb",
                                        "entry_id": "c01740a5-b2c7-33ae-8f18-ad2959618ea1",
                                        "glosses": [
                                            "feste Verbindung von zwei oder mehr Wörtern, deren Gesamtbedeutung sich nicht mehr aus den Bedeutungen der einzelnen Komponenten ergibt, sondern eine Übertragung erfahren hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b81496a4-993f-4e99-8594-2806559565b5",
                                                "sense_id": "9afaa146-31aa-3249-a7ff-0ccc3917bddb",
                                                "text": "„Die meisten Phraseme versprachlichen einen Begriff, indem sie ihn verbildlichen.“"
                                            },
                                            {
                                                "example_id": "1f8fd8b8-ca12-4939-8067-d6e8e873454a",
                                                "sense_id": "9afaa146-31aa-3249-a7ff-0ccc3917bddb",
                                                "text": "„Die Motivation bleibt dabei unbeachtet, ist aber durch Verweise auf die Bedeutungen des Lemmazeichens, von denen sich das Phrasem herleiten läßt, angebbar.“"
                                            },
                                            {
                                                "example_id": "350548a7-2453-49d7-af6b-83e92b6f751d",
                                                "sense_id": "9afaa146-31aa-3249-a7ff-0ccc3917bddb",
                                                "text": "„Wie im Hauptteil bleibe ich in Entsprechung zum Adjektiv phraseologisch bei dem Terminus Phraseologismus – trotz des Plädoyers von DONALIES (…) für Phrasem.“"
                                            },
                                            {
                                                "example_id": "6bd55e8e-17ad-4ecf-b4b1-d948833b4657",
                                                "sense_id": "9afaa146-31aa-3249-a7ff-0ccc3917bddb",
                                                "text": "„Als zentrale Gruppe der phraseologischen Einheiten, Phraseme oder Idiome definieren wir hier für unsere Zwecke nicht satzwertige Wortgruppen mit unterschiedlicher syntaktischer Struktur und mehr oder weniger ausgeprägter Umdeutung der Komponenten (der in die Gruppe eingehenden Wörter).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4708afa7-60a4-4112-be8e-e126639f62dc",
                        "source_entry_id": "cb287a0f-9eeb-3d99-a0a3-3afde37ef39e",
                        "source_sense_id": "34f1c584-a3ea-3dbd-b7dd-76d86e5b521d",
                        "target_lang_word": "set phrase",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "set phrase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16c7f1c9-66ed-3eef-885d-edb7212430e2",
                                        "entry_id": "67811164-f077-3c14-bef9-7d228cbf7067",
                                        "glosses": [
                                            "An established expression whose wording is subject to little or no variation, and which may or may not be idiomatic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e62404d-9429-4174-ad64-0d7aeaa76df5",
                                                "sense_id": "16c7f1c9-66ed-3eef-885d-edb7212430e2",
                                                "text": "Bally remarks in passing, as Hall does not, that the inversion in toujours est-il que is part of a set phrase and hence invariable."
                                            },
                                            {
                                                "example_id": "615e7d73-a2b2-4b89-86b0-52e4aaee8603",
                                                "sense_id": "16c7f1c9-66ed-3eef-885d-edb7212430e2",
                                                "text": "American courts sometimes use cherry in place of apple, but the latter fruit vastly predominates. The American version is that rare set phrase that is not so well set, variations on the phrase being more common than the main phrase itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "230d8194-70f2-3af2-8212-d3931e29e2bc",
                                        "entry_id": "67811164-f077-3c14-bef9-7d228cbf7067",
                                        "glosses": [
                                            "An idiomatic expression in general."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd36169-8ebd-4214-9b93-bcfe7d9121c5",
                                                "sense_id": "230d8194-70f2-3af2-8212-d3931e29e2bc",
                                                "text": "If it proves clearly unfeasible to make the audience laugh at a thin and far-fetched joke, it is always better to change the way the joke works . . . for instance, a pun based on the speaker's taking literally some set phrase or metaphor with a pun based on phonetic similarity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
