                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3f128f7-b244-4dbe-a52e-43d71f310dfd",
                        "source_entry_id": "18edf5b7-635b-3223-8780-a5e993c7d2cf",
                        "source_sense_id": "2c00f251-a8b1-368e-b1f4-04593244304d",
                        "target_lang_word": "lamprey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lamprey",
