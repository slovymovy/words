                                            {
                                                "example_id": "a57f85ce-57df-4d5f-8c82-7f42c3668f14",
                                                "sense_id": "979a09ef-2e82-30a5-b4f6-0483d1d70611",
                                                "text": "Alle Kaufleute des Ortes beklagen die Flaute nach dem Bau der Ortsumfahrung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5d4081a1-d476-340f-995f-e3ff46b6dcd4",
                                        "entry_id": "fc4ee122-9231-3340-a7f1-62a46e104cc4",
                                        "glosses": [
                                            "Stimmungstief, Motivationsschwäche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fab16f7-beb5-4ed4-9b15-e44152f6694d",
                                                "sense_id": "5d4081a1-d476-340f-995f-e3ff46b6dcd4",
                                                "text": "Nach der Flaute in der ersten Spielhälfte wollte der Trainer mehr Einsatz sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30844954-b1ff-4a44-b40c-bcd031a3e932",
                        "source_entry_id": "155d9d4b-cd6d-33e0-89ad-fa62ebc49a48",
                        "source_sense_id": "5ec2660b-07e5-37f8-868d-4325540d83b7",
                        "target_lang_word": "Windstille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Windstille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9e77d9e-6b6c-3838-ab68-096466b5e5a4",
                                        "entry_id": "1e496ccf-f965-3c4b-9f00-82827a1c9eaa",
                                        "glosses": [
                                            "die Abwesenheit von Wind; das Fehlen jeglichen Windes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97df46f1-2a9c-4daa-86bb-225caecad7b7",
                                                "sense_id": "a9e77d9e-6b6c-3838-ab68-096466b5e5a4",
                                                "text": "Gestern herrschte völlige Windstille, sehr zum Ärger der Segler."
                                            },
                                            {
                                                "example_id": "8c1c8083-7e38-4c78-bc07-9a6b6e167f50",
                                                "sense_id": "a9e77d9e-6b6c-3838-ab68-096466b5e5a4",
                                                "text": "„Bei anhaltender Windstille und ohne alle Temperatur- und Dichteänderungen bzw. die globale Zirkulation würde der Meeresspiegel genau mit der theoretischen Niveaufläche des Geoids zusammenfallen.“"
                                            },
                                            {
                                                "example_id": "2d279a3d-edf8-4f68-8848-2f22ad0721cf",
                                                "sense_id": "a9e77d9e-6b6c-3838-ab68-096466b5e5a4",
                                                "text": "„Es herrschte klare Sicht bei Windstille und ruhiger See.“"
                                            },
                                            {
                                                "example_id": "2a1e8ccc-22c3-44dc-ab82-501da2f2fa8b",
                                                "sense_id": "a9e77d9e-6b6c-3838-ab68-096466b5e5a4",
                                                "text": "„Steigende Hitze und vollkommene Windstille begünstigten Angriffe von winzigen Fliegen, Mücken und Moskitos, welche sich von der weißen Haut besonders angezogen fühlten.“"
                                            },
                                            {
                                                "example_id": "da74c267-3a11-437f-bfd5-f0cb2cf4a57d",
                                                "sense_id": "a9e77d9e-6b6c-3838-ab68-096466b5e5a4",
                                                "text": "„Am Nachmittag herrschte Windstille bis auf ein paar wechselnde Winde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
