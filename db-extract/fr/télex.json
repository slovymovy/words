        "fr-extract.jsonl": [
            {
                "entry_id": "a69fe02f-2f88-33bf-a788-8b9d2fdeec28",
                "word": "télex",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6d827ba5-af0b-3e5d-97b6-c79472484145",
                        "entry_id": "a69fe02f-2f88-33bf-a788-8b9d2fdeec28",
                        "glosses": [
                            "Système de communication qui remplaçait, partiellement, le télégraphe en morse et qui a été largement supplanté par le fax et, totalement, par la messagerie électronique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16715ffa-9242-4956-bd3f-35f3a303abf5",
                                "sense_id": "6d827ba5-af0b-3e5d-97b6-c79472484145",
                                "text": "Un avantage majeur du télex réside dans le fait que la réception d'un message peut être confirmée par le destinataire avec un haut degré de certitude par un mécanisme de réponse automatique."
                            },
                            {
                                "example_id": "01b2366f-a6ab-4dc5-be13-92e9c0470f53",
                                "sense_id": "6d827ba5-af0b-3e5d-97b6-c79472484145",
                                "text": "Ce n'était pas parfait, mais c'était la seule façon de les acheminer par télex à La Presse, se souvient-il, maintenant âgé de 70 ans et toujours aussi fier de son épopée."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c671552-4bc0-3c23-9a7f-c90290f09f58",
                        "entry_id": "a69fe02f-2f88-33bf-a788-8b9d2fdeec28",
                        "glosses": [
                            "Message reçu par ce moyen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c58c30b2-c10f-49d4-bf02-b733191ad60e",
                                "sense_id": "9c671552-4bc0-3c23-9a7f-c90290f09f58",
                                "text": "Aux archives, un fonctionnaire entre deux âges et réglé comme une pendule se concentrait déjà sur les écritures en recopiant avec une patience de bénédictin les télex et les rapports qu'on lui demandait de traiter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52b932aa-ef6d-47d7-aa11-666098846a1e",
                        "source_entry_id": "a69fe02f-2f88-33bf-a788-8b9d2fdeec28",
                        "target_lang_word": "Fernschreiben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fernschreiben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2e7a50b-20c0-38af-b12a-77c8f09ab022",
                                        "entry_id": "a39c1f81-8350-3688-8203-2007aeef0a2e",
                                        "glosses": [
                                            "mit Fernschreibern übermittelte Textnachricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "629dcdaa-6b65-4796-b6b7-ab1f8d29af5d",
                                                "sense_id": "c2e7a50b-20c0-38af-b12a-77c8f09ab022",
                                                "text": "Das Fernschreiben musste nach dem Empfang erst noch entschlüsselt werden."
                                            },
                                            {
                                                "example_id": "8336351b-631a-493f-83ca-7938c2e75b04",
                                                "sense_id": "c2e7a50b-20c0-38af-b12a-77c8f09ab022",
                                                "text": "„Aus seiner Brusttasche lugte das Fernschreiben von der Reederei, dessen Inhalt mich sehr interessierte.“"
                                            },
                                            {
                                                "example_id": "939fb87f-f198-4629-b180-7b591ecdca95",
                                                "sense_id": "c2e7a50b-20c0-38af-b12a-77c8f09ab022",
                                                "text": "„Seit 80 Jahren gibt es Fernschreiben. Doch ihre große Zeit ist längst schon wieder vorbei - heute sind E-Mails, SMS und Twitter populärer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9f3ff26-e427-4c4c-bf21-78297a836c74",
                        "source_entry_id": "a69fe02f-2f88-33bf-a788-8b9d2fdeec28",
                        "target_lang_word": "Telex",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Telex",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f401f81a-be40-30f1-96f9-215fa282cac8",
                                        "entry_id": "1762a145-8043-341d-b2cd-30ef926fd8e8",
                                        "glosses": [
                                            "schreibmaschinenähnliches Gerät zur Übermittlung von Textnachrichten mittels elektrischer Signale"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56c50871-4399-4651-ad07-7a8a784654fa",
                                                "sense_id": "f401f81a-be40-30f1-96f9-215fa282cac8",
                                                "text": "Das Telex stand in einem mit Glaswänden abgeschotteten Raum, um die Belastung mit Staub so gering wie möglich zu gestalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c3e44a5-c9bf-3a50-9087-9d56e68579aa",
                                        "entry_id": "1762a145-8043-341d-b2cd-30ef926fd8e8",
                                        "glosses": [
                                            "mit einem Fernschreiber verfasstes Schreiben"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bdae947-a870-4afe-a356-f79e237df40a",
                                                "sense_id": "7c3e44a5-c9bf-3a50-9087-9d56e68579aa",
                                                "text": "Bringen Sie mir bitte sofort das Telex, egal, wann es ankommt, ich warte hier."
                                            },
                                            {
                                                "example_id": "0043bfc6-abb5-40a0-a38d-5e9027aac644",
                                                "sense_id": "7c3e44a5-c9bf-3a50-9087-9d56e68579aa",
                                                "text": "„Das Telex aus Washington enthüllte zugleich das erste Grundprinzip des atomaren Zeitalters: Sicher darf man sich nur fühlen, wenn man den Gegner zur Geisel machen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
