                        "sense_id": "a765d744-8f6e-351f-8abb-bd409e4447c2",
                        "entry_id": "6092a2ba-9cc8-341a-9b87-174379dbc7c6",
                        "glosses": [
                            "Arbitrary or meaningless (of the usage of a word or phrase)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23101c8f-7da8-437f-8439-0581a92ebacf",
                                "sense_id": "a765d744-8f6e-351f-8abb-bd409e4447c2",
                                "text": "The Chairman felt it his imperative duty to demand of the honourable gentleman, whether he had used the expression which had just escaped him in a common sense. Mr. Blotton had no hesitation in saying that he had not—he had used the word in its Pickwickian sense."
                            },
                            {
                                "example_id": "d5464bde-7532-47f1-b9d6-da947da2d35c",
                                "sense_id": "a765d744-8f6e-351f-8abb-bd409e4447c2",
                                "text": "But let us defend the poor battered old language against those who use words in private Pickwickian senses of their own[…]"
                            },
                            {
                                "example_id": "af42bd6f-a9d7-4946-9c33-4c50764db398",
                                "sense_id": "a765d744-8f6e-351f-8abb-bd409e4447c2",
                                "text": "But we are prisoners in a Pickwickian sense; if we try we can break out of our frameworks at any time."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b7380d3-96fd-39be-92dd-3ca49693fcc0",
                        "entry_id": "6092a2ba-9cc8-341a-9b87-174379dbc7c6",
                        "glosses": [
                            "Having, or relating to, Pickwickian syndrome."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51d13790-7d2a-4eb9-b9e4-68a0e15e4869",
                                "sense_id": "6b7380d3-96fd-39be-92dd-3ca49693fcc0",
                                "text": "This pattern of EEG and respiratory changes has been observed during both diurnal and nocturnal sleep in Pickwickian patients."
                            }
                        ]
                    },
                    {
                        "sense_id": "7018776d-ecae-3f61-b5e2-39966839e174",
                        "entry_id": "6092a2ba-9cc8-341a-9b87-174379dbc7c6",
                        "glosses": [
                            "Of or relating to The Pickwick Papers, its storyline, or its characters (chiefly Samuel Pickwick himself)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bf11919-11b3-42ab-a22e-918328691474",
                                "sense_id": "7018776d-ecae-3f61-b5e2-39966839e174",
                                "text": "Calverley's test of Pickwickian scholarship has been followed by similar tests with which students of the Holmesian chronicles may put their knowledge of their hero's exploits to the proof."
                            }
                        ]
                    }
