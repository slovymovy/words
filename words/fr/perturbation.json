{
    "word_family": [
        "perturber",
        "perturbateur",
        "perturbatrice"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4655f53f-b682-330a-8138-b6d19a89713d",
                    "sense_definition": "Zone de mauvais temps caractérisée par des variations de pression atmosphérique, apportant souvent des nuages, du vent et de la pluie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "meteo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une nouvelle <w>perturbation</w> pluvieuse traversera le nord du pays dès demain matin."
                        },
                        {
                            "text": "Le météorologue a annoncé l'arrivée d'une forte <w>perturbation</w> venue de l'Atlantique."
                        }
                    ],
                    "synonyms": [
                        "dépression"
                    ],
                    "antonyms": [
                        "anticyclone"
                    ],
                    "common_phrases": [
                        "perturbation atmosphérique",
                        "perturbation pluvieuse"
                    ]
                },
                {
                    "sense_id": "aab04822-f373-3933-8c7c-e49b97565e08",
                    "sense_definition": "Dérèglement ou anomalie affectant le fonctionnement normal d'un appareil, d'un service ou d'un réseau de transport.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des travaux sur les voies provoquent d'importantes <w>perturbations</w> du trafic ferroviaire."
                        },
                        {
                            "text": "La panne d'électricité a entraîné une <w>perturbation</w> temporaire de nos serveurs informatiques."
                        }
                    ],
                    "synonyms": [
                        "dysfonctionnement",
                        "dérèglement",
                        "anomalie"
                    ],
                    "common_phrases": [
                        "perturbations du trafic"
                    ]
                },
                {
                    "sense_id": "fea85c17-df11-3e85-a807-0c4a2b357400",
                    "sense_definition": "Trouble profond qui affecte la stabilité d'une société, d'une organisation, ou l'équilibre psychologique d'un individu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette crise financière risque de provoquer une grave <w>perturbation</w> dans l'économie mondiale."
                        },
                        {
                            "text": "Le choc de la nouvelle a causé une profonde <w>perturbation</w> émotionnelle chez cet enfant."
                        }
                    ],
                    "synonyms": [
                        "bouleversement",
                        "trouble",
                        "désordre"
                    ],
                    "antonyms": [
                        "stabilité",
                        "calme"
                    ],
                    "common_phrases": [
                        "causer une perturbation",
                        "perturbation émotionnelle"
                    ]
                },
                {
                    "sense_id": "3252fe45-9e4a-35d5-84be-987e05e83602",
                    "sense_definition": "Modification ou écart constaté dans la trajectoire régulière d'un corps céleste sous l'effet de l'attraction d'autres corps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sciences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'analyse des <w>perturbations</w> orbitales d'Uranus a permis de calculer l'existence de Neptune."
                        },
                        {
                            "text": "Cette comète subit une légère <w>perturbation</w> gravitationnelle à l'approche de Jupiter."
                        }
                    ],
                    "synonyms": [
                        "altération",
                        "variation"
                    ],
                    "common_phrases": [
                        "perturbation gravitationnelle",
                        "perturbations orbitales"
                    ]
                }
            ]
        }
    ]
}