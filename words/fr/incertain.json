            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8e1b5631-3001-3775-9eba-b953100ebe75",
                    "sense_definition": "Dont la réalité, la vérité ou l'issue n'est pas garantie ou assurée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "doute_issue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La victoire est restée longtemps <w>incertaine</w> avant le coup de sifflet final.",
                            "target_lang_translations": {
                                "en": "The victory remained <w>uncertain</w> for a long time before the final whistle.",
                                "ru": "Победа долго оставалась <w>неопределённой</w> до финального свистка.",
                                "de": "Bis zum Schlusspfiff blieb der Sieg lange <w>ungewiss</w>.",
                                "es": "La victoria siguió <w>incierta</w> mucho tiempo antes del pitido final.",
                                "zh": "在终场哨响之前，比赛胜负很长时间都<w>不确定</w>。"
                            }
                        },
                        {
                            "text": "Le succès de notre projet demeure encore <w>incertain</w> en raison du manque de budget.",
                            "target_lang_translations": {
                                "en": "The success of our project is still <w>uncertain</w> because of the lack of budget.",
                                "ru": "Успех нашего проекта всё ещё <w>неопределён</w> из-за нехватки бюджета.",
                                "de": "Der Erfolg unseres Projekts bleibt wegen des fehlenden Budgets noch <w>ungewiss</w>.",
                                "es": "El éxito de nuestro proyecto sigue <w>incierto</w> por la falta de presupuesto.",
                                "zh": "由于预算不足，我们项目的成功与否仍然<w>不确定</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "douteux"
                    ],
                    "antonyms": [
                        "certain",
                        "sûr"
                    ],
                    "common_phrases": [
                        "résultat incertain",
                        "avenir incertain"
                    ],
                    "target_lang_definitions": {
                        "en": "Not guaranteed or assured; its truth, outcome, or occurrence is not known for certain.",
                        "ru": "Не гарантированный и не обеспеченный; истинность, исход или наступление чего-либо неизвестны.",
                        "de": "Nicht garantiert oder gesichert; man weiß nicht, wie etwas ausgeht oder ob es wahr ist.",
                        "es": "Que no está garantizado ni asegurado; no se sabe con certeza si algo ocurrirá o cómo terminará.",
                        "zh": "没有保证或无法确定的；事情的结果、真相或能否实现都不清楚。"
                    },
                    "translations": {
