                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не стоит жить одним <w>сегодня</w>, нужно думать и о будущем.",
                            "target_lang_translations": {
                                "en": "One shouldn't live just for <w>today</w>; one needs to think about the future as well.",
                                "zh": "不应该只活在<w>今天</w>，也需要考虑未来。",
                                "de": "Man sollte nicht nur für das <w>Heute</w> leben, man muss auch an die Zukunft denken.",
                                "nl": "Je moet niet alleen voor <w>vandaag</w> leven, je moet ook aan de toekomst denken.",
                                "pl": "Nie warto żyć tylko <w>dzisiaj</w>, trzeba myśleć także o przyszłości.",
                                "fr": "Il ne faut pas vivre seulement pour l'<w>aujourd'hui</w>, il faut aussi penser à l'avenir.",
                                "it": "Non bisogna vivere solo per l'<w>oggi</w>, bisogna pensare anche al futuro.",
                                "cs": "Nemá cenu žít jen pro <w>dnešek</w>, je třeba myslet i na budoucnost.",
                                "tr": "Sadece <w>bugün</w> için yaşamamalı, geleceği de düşünmelisin.",
                                "es": "No hay que vivir solo para el <w>hoy</w>, también hay que pensar en el futuro."
                            }
                        },
                        {
                            "text": "Твоё <w>сегодня</w> зависит от решений, принятых вчера.",
                            "target_lang_translations": {
                                "en": "Your <w>today</w> depends on decisions made yesterday.",
                                "zh": "你的<w>今天</w>取决于昨天所做的决定。",
                                "de": "Dein <w>Heute</w> hängt von den Entscheidungen ab, die gestern getroffen wurden.",
                                "nl": "Jouw <w>vandaag</w> hangt af van de beslissingen die gisteren zijn genomen.",
                                "pl": "Twoje <w>dzisiaj</w> zależy od decyzji podjętych wczoraj.",
                                "fr": "Ton <w>aujourd'hui</w> dépend des décisions prises hier.",
                                "it": "Il tuo <w>oggi</w> dipende dalle decisioni prese ieri.",
                                "cs": "Tvůj <w>dnešek</w> závisí na rozhodnutích učiněných včera.",
                                "tr": "Senin <w>bugünün</w> dün alınan kararlara bağlıdır.",
                                "es": "Tu <w>hoy</w> depende de las decisiones tomadas ayer."
                            }
