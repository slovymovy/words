                                    {
                                        "sense_id": "784201bd-1a24-3889-9d13-ce8921aac2b1",
                                        "entry_id": "5a88f16f-8ad0-3d4f-8153-13b3034db2bf",
                                        "glosses": [
                                            "Celui qui illustre, qui dessine, qui compose des illustrations pour les livres, les journaux, les revues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24edc670-3431-4a68-8092-704492ced07c",
                                                "sense_id": "784201bd-1a24-3889-9d13-ce8921aac2b1",
                                                "text": "Le hasard me fit rencontrer un illustrateur de talent il sut mettre des images sur mes pensées."
                                            },
                                            {
                                                "example_id": "4b28341c-c61b-4b71-a18f-f284566bd7ae",
                                                "sense_id": "784201bd-1a24-3889-9d13-ce8921aac2b1",
                                                "text": "Elle sera accompagnée de son coauteur, l’illustrateur François Ravard."
                                            },
                                            {
                                                "example_id": "f5223d01-ef5d-44e3-bafd-5c958147fe0a",
                                                "sense_id": "784201bd-1a24-3889-9d13-ce8921aac2b1",
                                                "text": "Le visiteur découvre les multiples talents de Mathurin Méheut, à la fois peintre, décorateur, illustrateur, céramiste et sculpteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
