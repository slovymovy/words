                "senses": [
                    {
                        "sense_id": "011be560-fbbf-37a6-899a-637e85f8697b",
                        "entry_id": "e8708e8d-9c0d-388b-aeab-d8c100db8c04",
                        "glosses": [
                            "Lautäußerung vor, während oder nach einer körperlichen oder geistigen Anstrengung oder bei dem Gedanken daran"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4f55740-09f3-4458-8f74-e45aae912399",
                                "sense_id": "011be560-fbbf-37a6-899a-637e85f8697b",
                                "text": "Puh, jetzt brauche ich erst Mal eine Pause!"
                            },
                            {
                                "example_id": "4e4c2bbc-f164-44df-9a2c-b2ea84dfdc4c",
                                "sense_id": "011be560-fbbf-37a6-899a-637e85f8697b",
                                "text": "Puh! Und das soll ich alles ausrechnen?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4bff02ba-3bce-31bf-86f9-f1b466721e2e",
                        "entry_id": "e8708e8d-9c0d-388b-aeab-d8c100db8c04",
                        "glosses": [
                            "Ausruf des Missfallens oder Unbehagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "221b74fd-da5b-478f-b683-a3250e88aac6",
                                "sense_id": "4bff02ba-3bce-31bf-86f9-f1b466721e2e",
                                "text": "Puh, ist das warm heute."
                            },
                            {
                                "example_id": "d885f59b-7cfe-4115-b1c6-ecdb7ec7d0cb",
                                "sense_id": "4bff02ba-3bce-31bf-86f9-f1b466721e2e",
                                "text": "Puh, wie das hier stinkt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
