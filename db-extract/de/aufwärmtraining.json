                "translations": [
                    {
                        "translation_id": "9d5f7c2a-42df-4993-9256-284a84dfc70e",
                        "source_entry_id": "edcca341-c11a-3641-944a-c46945462547",
                        "source_sense_id": "b567f2eb-d410-3510-9531-be1f38af1201",
