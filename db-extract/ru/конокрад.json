                "senses": [
                    {
                        "sense_id": "594b85a7-31cc-3211-ae3a-a63f36ae6b07",
                        "entry_id": "72c49e1b-8df0-3570-b15e-b9e56ec04790",
                        "glosses": [
                            "horse thief"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43d0ebf3-0210-4d6a-8e40-b14f63a226ac",
                                "sense_id": "594b85a7-31cc-3211-ae3a-a63f36ae6b07",
                                "text": "Э́то был Кала́шников, отъя́вленный моше́нник и конокра́д, оте́ц и дя́дя кото́рого держа́ли в Богалёвке тракти́р и торгова́ли, где придётся, кра́деными лошадя́ми.",
                                "translation": "It was Kalashnikov, an arrant scoundrel and horse-stealer, whose father and uncle kept a tavern in Bogalyovka, and disposed of the stolen horses where they could.",
                                "english": "It was Kalashnikov, an arrant scoundrel and horse-stealer, whose father and uncle kept a tavern in Bogalyovka, and disposed of the stolen horses where they could."
                            }
                        ]
                    }
                ],
