                    {
                        "sense_id": "4f4d2395-b857-362a-98f0-f0db3964d624",
                        "entry_id": "35c42925-5578-35ea-bacb-4b13960ec64f",
                        "glosses": [
                            "antiker Versfuß, der aus zwei langen Silben besteht (– –)"
                        ],
                        "tags": [
                            "Metrik"
                        ],
                        "examples": [
                            {
                                "example_id": "dd9ba79d-2d4b-400f-b88b-da4a5a2f8dc2",
                                "sense_id": "4f4d2395-b857-362a-98f0-f0db3964d624",
                                "text": "„Das Heft wimmelte von Ausdrücken wie Skandieren, Spondeus, Jambus, Molossus und anderen antiken Versfüßen, das alles sorgfältig, fast schon kalligraphisch eingetragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
