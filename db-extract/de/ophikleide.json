                                "example_id": "ee2cec78-889b-48a6-8566-1770b016a06b",
                                "sense_id": "0c35fe02-72a0-3b25-8d90-d891e4603af5",
                                "text": "Die Ophikleide wurde weitgehend von der Tuba verdrängt."
                            },
                            {
                                "example_id": "7d6a0e6e-f735-4d27-a716-99133e52a2c3",
                                "sense_id": "0c35fe02-72a0-3b25-8d90-d891e4603af5",
                                "text": "Ophikleiden werden nur noch sehr selten in Orchestern benutzt."
                            }
