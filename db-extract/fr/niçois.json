                        "entry_id": "c60021e3-6fe4-379b-921b-74d0cf48d892",
                        "glosses": [
                            "Relatif à Nice, commune française située dans le département des Alpes-Maritimes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d8d4fa-f14e-4a75-b8c7-6009166d1e90",
                                "sense_id": "236ef0f0-0aa0-36ed-8d82-8f9763cc5e0d",
                                "text": "Côté cuisine, les plats sont d'une grande fraicheur et les assiettes bien présentées : raviolis niçois à la ricotta et copeaux de truffes, cabillaud demi-sel en aïoli et légumes du jardin, […]"
                            }
                        ]
                    }
