                                        "sense_id": "0ed83d44-312e-33f3-92fd-28264270eb36",
                                        "entry_id": "b22e2a2a-c839-33be-a65a-e39993cda2c0",
                                        "glosses": [
                                            "Used as a command to bring soldiers to the attention position."
                                        ],
