                    {
                        "translation_id": "2b435323-fc23-468c-a1a3-7ce5fa66c280",
                        "source_entry_id": "ef8b07a9-978c-3219-80d7-6737c7e174f8",
                        "source_sense_id": "2ffd0188-b0a3-3b5b-8264-c682c4fa0026",
