                                        "glosses": [
                                            "Se dice de una persona que proviene de una mezcla racial, especialmente entre la europea y la indígena de América."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e4e7827-7fac-465e-a5dc-bd2059a5abc4",
                                                "sense_id": "76d5f2ef-4c13-37cd-8fd9-58e87fd37edf",
                                                "text": "Del español y la yndia nace el mestizo, por lo común, humilde, quieto y sencillo"
                                            }
