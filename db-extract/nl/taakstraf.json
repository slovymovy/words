                                        "entry_id": "ed6334f9-890b-3afa-9c87-4886f4f1cafb",
                                        "glosses": [
                                            "Service or activity performed for the benefit of the community at large, such as cleaning, fundraising, pro bono professional services, etc."
                                        ],
                                        "tags": [
