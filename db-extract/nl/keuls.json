                "forms": [],
                "senses": [
                    {
                        "sense_id": "65d56837-f23d-3b44-9065-a3d66063f362",
                        "entry_id": "272d8311-b92b-31ad-9bc3-b68dd0240d11",
                        "glosses": [
                            "een lokaal, Ripuarisch dialect dat in Keulen wordt gesproken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6a0a6c6-0902-4429-9497-496a0add018b",
                                "sense_id": "65d56837-f23d-3b44-9065-a3d66063f362",
                                "text": "Hij verstond niets van het Keuls van die verkoper."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63343496-33e0-4f90-98b3-090cd11813ec",
                        "source_entry_id": "272d8311-b92b-31ad-9bc3-b68dd0240d11",
                        "source_sense_id": "65d56837-f23d-3b44-9065-a3d66063f362",
                        "source_sense_description": "een lokaal, Ripuarische dialect dat in Keulen wordt gesproken",
                        "target_lang_word": "Kölsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kölsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75eca2c5-4e33-3a89-9980-a1a730d494f6",
                                        "entry_id": "206d793a-c58f-34e0-9de6-27ab6d7f5651",
                                        "glosses": [
                                            "obergärige Biersorte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "384618bc-29b0-427e-bb3b-b3271a5ed0c9",
                                                "sense_id": "75eca2c5-4e33-3a89-9980-a1a730d494f6",
                                                "text": "Wir bestellten einen Kranz Kölsch."
                                            },
                                            {
                                                "example_id": "a10dbd95-ab54-44b1-8661-4fe2398d66b4",
                                                "sense_id": "75eca2c5-4e33-3a89-9980-a1a730d494f6",
                                                "text": "Das besondere Glas für Kölsch heißt Stange."
                                            },
                                            {
                                                "example_id": "9c24b654-5bf6-4111-8477-8bb9095871be",
                                                "sense_id": "75eca2c5-4e33-3a89-9980-a1a730d494f6",
                                                "text": "„Der Köbes brachte dem Vater in Windeseile ein Kölsch, alle Gäste in diesem Vorraum tranken Kölsch, eins nach dem andern und meist sehr rasch, auf einen Zug.“"
                                            },
                                            {
                                                "example_id": "d0c6a9d1-75e1-4c55-b1e5-fe9c76bb293b",
                                                "sense_id": "75eca2c5-4e33-3a89-9980-a1a730d494f6",
                                                "text": "„Zu den obergärigen Bieren zählen Kölsch, Weizen- oder Altbier.“"
                                            },
                                            {
                                                "example_id": "c90b1588-300e-4837-842f-c0f38bddc5f1",
                                                "sense_id": "75eca2c5-4e33-3a89-9980-a1a730d494f6",
                                                "text": "„Und wir verließen die Geburtstagsfeier des soeben dem Establishment zugealterten Gastgebers Arnulf und erholten uns beim Früh mit nem halve Hahn und Kölsch vom Köbes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f4c8f223-af67-3ecd-a6b7-7d817a31beb3",
                                        "entry_id": "206d793a-c58f-34e0-9de6-27ab6d7f5651",
                                        "glosses": [
                                            "Kölner Mundart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f58d6d7d-0681-4b12-b378-82540973e8a6",
                                                "sense_id": "f4c8f223-af67-3ecd-a6b7-7d817a31beb3",
                                                "text": "Kannst du mit dem Wirt Kölsch reden?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kölsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72a0b8c9-ee87-344d-85b1-b296b76f482c",
                                        "entry_id": "f78598c4-563c-33d6-86a1-a4194886a038",
                                        "glosses": [
                                            "zweifarbig gewürfelter Stoff aus Baumwolle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
