            {
                "entry_id": "c89a5379-b69d-3c3f-a9f4-7f2fa5cf55e7",
                "word": "blackwashing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a68bd4b-fe85-3561-98b0-eb2f50a0c827",
                        "entry_id": "c89a5379-b69d-3c3f-a9f4-7f2fa5cf55e7",
                        "glosses": [
                            "The revisionist portrayal of something as belonging to a black race of people."
                        ],
                        "tags": [
                            "derogatory",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b04f6a36-41ab-481d-b3dd-b6f9fea8d9c0",
                                "sense_id": "9a68bd4b-fe85-3561-98b0-eb2f50a0c827",
                                "text": "If Pindell opposes the 'whitewashing' of history, then Walker's is a revisionist blackwashing."
                            },
                            {
                                "example_id": "c3b7d8ac-b7dd-4804-ac36-9bfd9d15650b",
                                "sense_id": "9a68bd4b-fe85-3561-98b0-eb2f50a0c827",
                                "text": "This “blackwashing,” in Hare's opinion, was the work of black studies departments and the black faculty […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "fbf72f71-2b0f-37df-8100-a436ee1cff03",
                        "entry_id": "c89a5379-b69d-3c3f-a9f4-7f2fa5cf55e7",
                        "glosses": [
                            "The application of a coating of blackwash."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "46c63f9c-43a5-4b38-ab35-0f5f5a2a08fe",
                                "sense_id": "fbf72f71-2b0f-37df-8100-a436ee1cff03",
                                "text": "The blackwashing is here to be the very last operation, and to be well performed, and when dry must be polished by a large sleeker fitting the circle of the cylinder."
                            }
                        ]
                    },
                    {
                        "sense_id": "5bec09c9-4b76-34d0-a615-183233a91f6e",
                        "entry_id": "c89a5379-b69d-3c3f-a9f4-7f2fa5cf55e7",
                        "glosses": [
                            "The revisionist portrayal of something as evil."
                        ],
                        "tags": [
                            "derogatory",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "477670ca-5003-46ba-9914-631ef80c6cb6",
                                "sense_id": "5bec09c9-4b76-34d0-a615-183233a91f6e",
                                "text": "Historical writing proliferates in examples of tendentious accounts of national history, where the “whitewashing” of one history goes hand in hand with the “blackwashing” of another."
                            }
                        ]
                    }
