                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d0c2654-6976-4c43-ab81-8be0c2effecc",
                                                "sense_id": "0aded1fb-5209-3e84-9803-9ff82974f5f8",
                                                "text": "Die Werte sind aber nur grob geschätzt."
                                            },
                                            {
                                                "example_id": "0d029379-f222-4e2f-862f-b12853806bcb",
                                                "sense_id": "0aded1fb-5209-3e84-9803-9ff82974f5f8",
                                                "text": "„Die Heinsberg-Studie zur Dunkelziffer der Corona-Infektionen basiert auf einer grob falschen Berechnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2c49f0b7-8b28-371e-b904-046b2f8b4830",
                                        "entry_id": "4f4348bc-7537-30e5-8e95-cb1f725e6a62",
                                        "glosses": [
                                            "ungelenk, ungeschickt, unerzogen, ungebildet, bäurisch, gewalttätig"
                                        ],
                                        "tags": [
