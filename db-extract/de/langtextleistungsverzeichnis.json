                ],
                "senses": [
                    {
                        "sense_id": "809f47c9-9368-3ee1-8de1-a56a05142d7d",
                        "entry_id": "42eb46c6-76f4-32e7-bc28-6eb3e9e7fccb",
                        "glosses": [
                            "ausführliche, listenmäßige Beschreibung von Lieferungen und Leistungen als Kalkulationsgrundlage und Vertragsgrundlage; ausführliches Vertragsangebot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cce059f-78f7-405c-8abc-4408d78471d8",
                                "sense_id": "809f47c9-9368-3ee1-8de1-a56a05142d7d",
                                "text": "„Handelt es sich dabei um ein Kurzleistungsverzeichnis, in dem Textergänzungen nicht vorgesehen sind, kann der öffentliche Auftraggeber den Ausschluss des Angebots nicht darauf stützen, er habe sich an anderer Stelle in den Vergabeunterlagen ausbedungen, dass bei Verwendung selbst gefertigter Abschriften oder Kurzfassungen alle im Langtextleistungsverzeichnis geforderten Textergänzungen in das Kurztextverzeichnis übertragen werden müssen.“"
                            },
                            {
                                "example_id": "8e5392dd-09a4-4202-ab93-b12ae286879b",
                                "sense_id": "809f47c9-9368-3ee1-8de1-a56a05142d7d",
                                "text": "Ob unter dem Begriff des Leistungsverzeichnisses in den Bewerbungsbedingungen das Langtextleistungsverzeichnis zu verstehen ist, ist nicht entscheidungserheblich."
                            },
                            {
                                "example_id": "239f4318-827c-42f4-a971-70f3519fd26c",
                                "sense_id": "809f47c9-9368-3ee1-8de1-a56a05142d7d",
                                "text": "Die Beklagte schloss das Angebot mit der Begründung von der Wertung aus, das eingereichte Kurztextleistungsverzeichnis enthalte entgegen den Vorgaben in Klausel 3.2 Abs. 3 nicht die im Langtextleistungsverzeichnis geforderten Textergänzungen, also die Angaben zum Material und dessen Herkunft."
                            },
                            {
                                "example_id": "9b5e54a4-4ac4-4d33-81c5-17fe8ea469e5",
                                "sense_id": "809f47c9-9368-3ee1-8de1-a56a05142d7d",
                                "text": "Der öffentliche Auftraggeber könne in diesem Fall den Ausschluss des Angebots nicht darauf stützen, er habe sich an anderer Stelle in den Vergabeunterlagen ausbedungen, dass bei Verwendung selbstgefertigter Abschriften oder Kurzfassungen alle im Langtextleistungsverzeichnis geforderten Textergänzungen in das Kurztextverzeichnis übertragen werden müssen."
                            },
                            {
                                "example_id": "714b16d7-fa40-4710-bba3-5a1c9581681f",
                                "sense_id": "809f47c9-9368-3ee1-8de1-a56a05142d7d",
                                "text": "Die im Langtextleistungsverzeichnis geforderten Textergänzungen hatte er nicht angegeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
