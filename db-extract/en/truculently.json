                                        "glosses": [
                                            "zich als een vijand gedragend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c80b99-a11b-4412-916f-773b6180ca86",
                                                "sense_id": "7501bea9-9e1b-3a29-b61f-61a70c25eba9",
                                                "text": "Zijn vijandige houding is onbegrijpelijk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b341e8e-d34d-45bd-98e1-4153d8bea26b",
                        "source_entry_id": "528ba296-e33f-35f5-a623-385ce070af2a",
                        "source_sense_id": "e1557e62-d720-33d9-8f97-7af870dd9a3f",
