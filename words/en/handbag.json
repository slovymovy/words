{
    "word_family": [
        "hand",
        "bag"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ddec1835-6053-313c-b7eb-49a1dfaf8b11",
                    "sense_definition": "A small bag used chiefly by women for carrying various small personal items, sometimes considered as a fashion accessory.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bags",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She opened her <w>handbag</w> to look for her car keys.",
                            "target_lang_translations": {
                                "ru": "Она открыла свою <w>сумочку</w>, чтобы найти ключи от машины."
                            }
                        },
                        {
                            "text": "In London, people are always on the lookout for an unzipped <w>handbag</w> or a phone sticking out of a pocket.",
                            "target_lang_translations": {
                                "ru": "В Лондоне люди всегда высматривают расстегнутую <w>сумку</w> или телефон, торчащий из кармана."
                            }
                        }
                    ],
                    "synonyms": [
                        "purse"
                    ],
                    "common_phrases": [
                        "unzipped handbag",
                        "leather handbag",
                        "designer handbag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая сумка, используемая в основном женщинами для ношения личных вещей, часто выступающая в качестве модного аксессуара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумочка",
                                "target_lang_sense_clarification": "уменьшительное от сумка, женская"
                            },
                            {
                                "target_lang_word": "дамская сумка",
                                "target_lang_sense_clarification": "женский аксессуар"
                            },
                            {
                                "target_lang_word": "ридикюль",
                                "target_lang_sense_clarification": "устаревшая ручная дамская сумочка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6ccd8be-b4ad-3c66-b1d3-7dd086f3ff74",
                    "sense_definition": "A small bag carried in the hand, used either when travelling or to carry tools for a specific job.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bags",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From a little <w>handbag</w> he extracted his automatic pistol, which he put upon the mantelpiece.",
                            "target_lang_translations": {
                                "ru": "Из маленькой <w>сумки</w> он достал автоматический пистолет и положил его на каминную полку."
                            }
                        },
                        {
                            "text": "The doctor carried a small <w>handbag</w> containing his medical instruments.",
                            "target_lang_translations": {
                                "ru": "Врач нес небольшую <w>сумку</w> со своими медицинскими инструментами."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая сумка, которую носят в руке, используемая в поездках или для переноски инструментов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумка",
                                "target_lang_sense_clarification": "небольшое вместилище с ручками"
                            },
                            {
                                "target_lang_word": "саквояж",
                                "target_lang_sense_clarification": "дорожная сумка для мелких вещей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8003ed5f-51cf-35c5-91b4-bc6deed66da4",
                    "sense_definition": "To attack verbally or subject to criticism (typically used of a woman).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Virginia saw him and <w>handbagged</w> him because she really was very cross.",
                            "target_lang_translations": {
                                "ru": "Вирджиния увидела его и <w>напала</w> на него с критикой, потому что была очень рассержена."
                            }
                        },
                        {
                            "text": "The politician was <w>handbagged</w> by the journalist during the live interview.",
                            "target_lang_translations": {
                                "ru": "Журналист <w>разнес</w> политика в пух и прах во время прямого эфира."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in British English in reference to Margaret Thatcher"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Словесно атаковать или подвергать резкой критике (обычно о женщине)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отхлестать",
                                "target_lang_sense_clarification": "образно, подвергнуть резкой критике"
                            },
                            {
                                "target_lang_word": "напасть",
                                "target_lang_sense_clarification": "словесно атаковать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}