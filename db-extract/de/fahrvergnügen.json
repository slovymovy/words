                "senses": [
                    {
                        "sense_id": "6fa1ba14-8d1e-3fc7-847c-270240edd414",
                        "entry_id": "78c7243f-5eda-3453-be9d-f7db9d28d09b",
                        "glosses": [
                            "Freude am Lenken eines Fahrzeugs, (in Amerika „geflügeltes“) Wort aus der Autowerbung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4738984f-1115-42e7-925d-2f8a5a7025e8",
                                "sense_id": "6fa1ba14-8d1e-3fc7-847c-270240edd414",
                                "text": "„Ein Segelschein ist deshalb Voraussetzung, um sich dem berauschenden Fahrvergnügen auf den sandigen Pisten hingeben zu dürfen.“"
                            },
                            {
                                "example_id": "b1907994-12eb-4453-88a6-e64738acff13",
                                "sense_id": "6fa1ba14-8d1e-3fc7-847c-270240edd414",
                                "text": "„Die Anfänge der Kraftfahrzeuge liegen in Europa inzwischen so weit zurück, dass nur wenige das Fahrvergnügen in einer der ersten Automobile kennen.“"
                            },
                            {
                                "example_id": "e5fdd71f-3258-4b4f-b2b5-6116a621bfc0",
                                "sense_id": "6fa1ba14-8d1e-3fc7-847c-270240edd414",
                                "text": "„Muss es da immer gleich ein Neuwagen sein, oder sorgt ein hochwertigeres Modell für deutlich längeres Fahrvergnügen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
