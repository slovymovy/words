                    "sense_id": "d88ffa6a-91f2-3ab5-b365-99b3c5569826",
                    "sense_definition": "Schittering, glans of meesterschap waarmee een opmerkelijke prestatie wordt geleverd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge violiste speelde het moeilijke muziekstuk met grote <w>brille</w>.",
                            "target_lang_translations": {
                                "de": "Die junge Geigerin spielte das schwierige Musikstück mit großer <w>Brillanz</w>."
                            }
                        },
                        {
                            "text": "Hij slaagde erin om zijn examens met <w>brille</w> te halen.",
                            "target_lang_translations": {
                                "de": "Es gelang ihm, seine Prüfungen mit <w>Glanz</w> zu bestehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "glans",
                        "luister",
                        "verve"
                    ],
                    "common_phrases": [
                        "met brille"
                    ],
                    "target_lang_definitions": {
