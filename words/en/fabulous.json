    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "36798e25-f26a-3e3e-92c6-64b50dc484b0",
                    "sense_definition": "Extremely good, pleasant, or enjoyable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "excellent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>fabulous</w> time at the party last night.",
                            "target_lang_translations": {
                                "ru": "Мы <w>потрясающе</w> провели время на вечеринке вчера вечером.",
                                "nl": "We hebben gisteravond een <w>fantastische</w> tijd gehad op het feest."
                            }
                        },
                        {
                            "text": "The weather was <w>fabulous</w> during our entire vacation by the sea.",
                            "target_lang_translations": {
                                "ru": "Погода была <w>замечательной</w> на протяжении всего нашего отпуска у моря.",
                                "nl": "Het weer was <w>geweldig</w> tijdens onze hele vakantie aan zee."
                            }
                        }
                    ],
                    "synonyms": [
                        "excellent"
                    ],
                    "antonyms": [
                        "terrible",
                        "awful"
                    ],
                    "common_phrases": [
                        "fabulous time",
                        "fabulous weather",
                        "fabulous meal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно хороший, приятный или доставляющий удовольствие.",
                        "nl": "Buitengewoon goed, aangenaam of plezierig."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "вызывающий сильное впечатление"
                            },
                            {
                                "target_lang_word": "замечательный",
                                "target_lang_sense_clarification": "очень хороший"
                            },
                            {
                                "target_lang_word": "прекрасный",
                                "target_lang_sense_clarification": "красивый и приятный"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "fantastisch",
                                "target_lang_sense_clarification": "buitengewoon goed"
                            },
                            {
                                "target_lang_word": "geweldig",
                                "target_lang_sense_clarification": "zeer plezierig"
                            },
                            {
                                "target_lang_word": "verrukkelijk",
                                "target_lang_sense_clarification": "heerlijk en aangenaam"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4d66a0c-f431-36b3-846d-d76d0e33b765",
                    "sense_definition": "Very fashionable, attractive, and impressive in style.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked absolutely <w>fabulous</w> in her new silk dress.",
                            "target_lang_translations": {
                                "ru": "Она выглядела абсолютно <w>потрясающе</w> в своем новом шелковом платье.",
                                "nl": "Ze zag er absoluut <w>fantastisch</w> uit in haar nieuwe zijden jurk."
                            }
                        },
                        {
                            "text": "The interior design of the hotel is <w>fabulous</w> and modern.",
                            "target_lang_translations": {
                                "ru": "Дизайн интерьера отеля <w>великолепен</w> и современен.",
                                "nl": "Het interieurontwerp van het hotel is <w>schitterend</w> en modern."
                            }
                        }
