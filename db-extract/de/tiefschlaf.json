                                    {
                                        "sense_id": "5e2b5f3c-ed35-36d9-bb08-381748b745af",
                                        "entry_id": "1c06fefd-8ead-3494-923f-ebc224bdb9ca",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see deep, sleep."
                                        ],
