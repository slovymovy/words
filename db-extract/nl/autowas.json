                            {
                                "example_id": "a45c87bd-90fe-4f3a-9b22-d934e2e796b8",
                                "sense_id": "f17f7bd0-0395-3883-899e-43b18fb7ee70",
                                "text": "Aan de andere kant van de Bornsestraat opent Thijs Autowas - ook bekend onder de naam The Wash - begin april een nieuwe autowasstraat."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd655a1e-68d2-3a70-b940-aa13ce994094",
                        "entry_id": "1fc2935b-9796-3296-9124-f793f32f58af",
                        "glosses": [
                            "was waarmee je de lak van een auto kunt beschermen"
