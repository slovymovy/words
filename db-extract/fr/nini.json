                "senses": [
                    {
                        "sense_id": "f0a935ac-0190-3d8b-9295-e90ef8b82744",
                        "entry_id": "d4c7e167-f2bd-374f-b850-be85c3ed4287",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e563fafd-460d-4857-af0d-64062c478028",
                                "sense_id": "f0a935ac-0190-3d8b-9295-e90ef8b82744",
                                "text": "C’est dans La Loge, peint en 1874, que Nini Lopez fait son apparition dans la peinture d’Auguste Renoir (1841-1919)."
                            },
                            {
                                "example_id": "177cc4a0-5c79-4d8f-bf5b-0872bd2c08a1",
                                "sense_id": "f0a935ac-0190-3d8b-9295-e90ef8b82744",
                                "text": "L’enseignement de Magdeleine était toujours baroque ; elle m’expliqua que le plaisir dépendait des goûts de chacun : son amie Nini exigeait que son partenaire lui embrassât ou lui chatouillât la plante des pieds."
                            },
                            {
                                "example_id": "f8bbcf75-4182-40a8-9977-3a65686f687f",
                                "sense_id": "f0a935ac-0190-3d8b-9295-e90ef8b82744",
                                "text": "Merci Henriette Fieu, née Blot et dite « Nini »."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5f0da247-e8ae-3308-86fd-b7387b43f003",
