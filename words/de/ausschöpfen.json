                {
                    "sense_id": "da3a4c65-c99f-3484-81bf-855dbc0ad037",
                    "sense_definition": "eine Flüssigkeit mit einem Gefäß schöpfend aus etwas entfernen oder ein Behältnis auf diese Weise leeren",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "leeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem starken Gewitter mussten die Fischer das Wasser schnell aus dem Boot <w>ausschöpfen</w>."
                        },
                        {
                            "text": "Er <w>schöpfte</w> das Regenwasser mit einem kleinen Eimer aus dem Kessel <w>aus</w>."
                        }
                    ],
                    "synonyms": [
