                        "entry_id": "ba6268bf-95ff-3b6a-86fe-34bef0c815bd",
                        "glosses": [
                            "sterke emoties van schok en ontzetting oproepend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef8cebb6-ebe3-4454-b445-b404817d104d",
                                "sense_id": "fb9c3bde-5f9b-3630-b374-16eb70e3c394",
                                "text": "Bij de ingang van de koolmijn speelden zich na de explosie hartverscheurende taferelen af."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec9f7196-9cd8-4e3a-b5de-e74209556de8",
