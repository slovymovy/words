                "senses": [
                    {
                        "sense_id": "4a22cf4c-a2b5-326b-9af7-926de8a487f4",
                        "entry_id": "a703615b-fed0-35e5-8feb-f773194f90f2",
                        "glosses": [
                            "plötzlicher, meist einseitiger Verlust des Hörvermögens, der oft einen Tinnitus nach sich zieht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1ba0b364-9d53-4283-b2dc-ba4b98bc122e",
                                "sense_id": "4a22cf4c-a2b5-326b-9af7-926de8a487f4",
                                "text": "Ein Ohrinfarkt muss ernstgenommen werden, soll es nicht zum dauerhaften Verlust des Hörvermögens kommen."
                            },
                            {
                                "example_id": "6a036af7-65eb-4344-9a6e-e74135671cf8",
                                "sense_id": "4a22cf4c-a2b5-326b-9af7-926de8a487f4",
                                "text": "„Mediziner sprechen von einem Hörsturz oder auch Ohrinfarkt, wenn plötzlich und ohne erkennbare äußere Ursacheeinseitige Hörprobleme – eine sogenannte Innenohrschwerhörigkeit – auftritt, die bis hin zum Hörverlust reichen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
