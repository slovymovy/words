                "senses": [
                    {
                        "sense_id": "55278eda-acfa-393a-959a-3b3c761d01cd",
                        "entry_id": "61c4a66d-ab25-3d59-b455-92568d0a667c",
                        "glosses": [
                            "bekanntestes deutsches Heldenepos, das das Schicksal der Nibelungen behandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a4ac5ad-71b5-411e-ae9c-e78a0be5b77a",
                                "sense_id": "55278eda-acfa-393a-959a-3b3c761d01cd",
                                "text": "„Glaubt man dem Nibelungenlied, so wurde der deutsche Held Siegfried zwischen den römischen Ruinen geboren.“"
                            },
                            {
                                "example_id": "5cafe95f-b588-45ba-85a8-08651ca2cf15",
                                "sense_id": "55278eda-acfa-393a-959a-3b3c761d01cd",
                                "text": "„Unter den Merkwürdigkeiten der deutschen Geschichte nimmt das Nibelungenlied einen besonderen Platz ein.“"
                            },
                            {
                                "example_id": "b055ccf3-1a4b-4c2f-a400-23fa1d026d9e",
                                "sense_id": "55278eda-acfa-393a-959a-3b3c761d01cd",
                                "text": "„Viertens erinnerte der Gehalt der Dolchstoßlegende an einen im damaligen Deutschland allgemein bekannten literarischen Mythos: die Ermordung Siegfrieds durch Hagen im Nibelungenlied.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
