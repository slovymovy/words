    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9e08c3bd-c481-325c-92f2-39413b4d331a",
                    "sense_definition": "not settled, solved, or brought to a conclusion",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_settlement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several major issues remained <w>unresolved</w> after the meeting ended.",
                            "target_lang_translations": {
                                "ru": "После окончания встречи несколько важных вопросов так и остались <w>нерешёнными</w>."
                            }
                        },
                        {
                            "text": "The mystery surrounding the stolen painting is still <w>unresolved</w> after many years.",
                            "target_lang_translations": {
                                "ru": "Тайна похищенной картины всё ещё остаётся <w>неразгаданной</w> спустя много лет."
                            }
                        }
                    ],
                    "synonyms": [
