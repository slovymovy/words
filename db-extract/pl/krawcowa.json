                            {
                                "example_id": "0e2feae5-4c13-44c5-9a52-996be2f40226",
                                "sense_id": "610ac1d9-8d96-3b9b-92d2-684b80d7b765",
                                "text": "Muszę pójść do krawcowej, aby zwęziła mi sukienkę."
