                "senses": [
                    {
                        "sense_id": "48925d0c-0337-3f81-9ce7-f30c4eba61b3",
                        "entry_id": "4965c9c7-80e1-3f54-8864-2295ee009bc1",
                        "glosses": [
                            "het zwaar onder invloed van alcohol zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38db0d8e-d6b2-4705-841e-2a0127b642f3",
                                "sense_id": "48925d0c-0337-3f81-9ce7-f30c4eba61b3",
                                "text": "Hij werd wegens openbare dronkenschap aangehouden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9431ec1-206d-4f87-8ae5-2beae71c15b2",
                        "source_entry_id": "4965c9c7-80e1-3f54-8864-2295ee009bc1",
                        "source_sense_id": "48925d0c-0337-3f81-9ce7-f30c4eba61b3",
                        "source_sense_description": "het zwaar onder invloed van alcohol zijn",
                        "target_lang_word": "Trunkenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trunkenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                                        "entry_id": "db0c3eee-2e50-3940-bbf6-040e85ecc18c",
                                        "glosses": [
                                            "Zustand nach dem übermäßigen Konsum alkoholhaltiger Getränke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24032876-19c6-4ce9-af7a-aecc25b3a85c",
                                                "sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                                                "text": "„Ich kann jedoch nicht sagen, ich hätte ihre Trunkenheit mißbraucht, denn in ihrer starken Sinnlichkeit kam sie allen Genüssen, zu denen ich sie bis zwei Uhr morgens anspornte, bereitwillig entgegen, bis wir beide nicht mehr konnten und uns trennten.“"
                                            },
                                            {
                                                "example_id": "1fa49106-ffc2-4565-b1df-e81e931a8344",
                                                "sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                                                "text": "„Ganz oben am Pyramidion wird dargestellt, wie der Pharao den Göttern Wein, der göttliche Trunkenheit herbeiführt, oder reinigendes Wasser opfert.“"
                                            },
                                            {
                                                "example_id": "6b186f5a-494e-4b4c-9eb1-eb0f7722dc8b",
                                                "sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                                                "text": "„Wie Roth bald erfahren würde, hatte sie das Sorgerecht für ihre Kinder verloren, weil sie Alkoholikerin war und man sie mehrfach wegen Trunkenheit am Steuer verurteilt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9965be4c-ff13-4c1a-b3ec-503e968323a5",
                        "source_entry_id": "4965c9c7-80e1-3f54-8864-2295ee009bc1",
                        "source_sense_id": "48925d0c-0337-3f81-9ce7-f30c4eba61b3",
                        "source_sense_description": "het zwaar onder invloed van alcohol zijn",
                        "target_lang_word": "drunkenness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drunkenness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f17732b2-78ee-3532-8571-21917930638e",
                                        "entry_id": "1042a7d3-6e4c-3b39-b4d7-74613176ba25",
                                        "glosses": [
                                            "A state of being drunk."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "574bbc9e-455a-499d-8522-ff97ea27727f",
                                                "sense_id": "f17732b2-78ee-3532-8571-21917930638e",
                                                "text": "But presently the fumes of the wine rising to his head, he became helplessly drunk and his side-muscles and limbs relaxed and he swayed to and fro on my back. When I saw that he had lost his senses for drunkenness, I put my head to his legs and, loosing them from my neck, stooped down well-nigh to the ground and threw him at full length, […]"
                                            },
                                            {
                                                "example_id": "52bde6e9-85ff-477c-b8fa-ff4bcbdef3ad",
                                                "sense_id": "f17732b2-78ee-3532-8571-21917930638e",
                                                "text": "The Englishman had a reputation throughout Europe for gluttony; it was said that overeating was the English vice, just as lust was the French vice and drunkenness the German vice. Some Englishmen became very fat, and were famous for being so. Henry VIII ate enormous meals, but as a young man he was slim, perhaps because he always took a great deal of physical exercise. By the time that he was forty-five he was suffering from painful ulcers in his leg which prevented him from riding or walking without the greatest difficulty; but though he ceased to take exercise, he ate as much as ever. He then became very fat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7cf7d29-38aa-43aa-a8df-e9d0d247b416",
                        "source_entry_id": "4965c9c7-80e1-3f54-8864-2295ee009bc1",
                        "source_sense_id": "48925d0c-0337-3f81-9ce7-f30c4eba61b3",
                        "source_sense_description": "het zwaar onder invloed van alcohol zijn",
                        "target_lang_word": "inebriety",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inebriety",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "873c0199-7cd5-3090-b26b-7b30034b617a",
                                        "entry_id": "10605a26-13c6-32b1-95f8-c20fbded6d55",
                                        "glosses": [
                                            "The state of being inebriated; inebriation, drunkenness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a94dd3-2052-443c-9d1f-010a0dcf6790",
                                                "sense_id": "873c0199-7cd5-3090-b26b-7b30034b617a",
                                                "text": "It is a just observation of a very celebrated author, that in proportion as every country is barbarous, it is addicted to inebriety. Were the people of England to be judged of by this standard, it is much to be feared, that our national character would be none of the most amiable."
                                            },
                                            {
                                                "example_id": "e76acaa3-dd02-4263-b06e-4ada51f17b94",
                                                "sense_id": "873c0199-7cd5-3090-b26b-7b30034b617a",
                                                "text": "As she thought less of his inebriety, she thought more of his inconstancy and presumption […]"
                                            },
                                            {
                                                "example_id": "c723fbbb-30a2-4bdd-b9a3-fc131653e3f9",
                                                "sense_id": "873c0199-7cd5-3090-b26b-7b30034b617a",
                                                "text": "Our ship was now wholly given up to every species of riot and debauchery. The grossest licentiousness and the most shameful inebriety prevailed, with occasional and but short-lived interruptions, through the whole period of her stay."
                                            },
                                            {
                                                "example_id": "698dfeb1-1c14-43dc-96f3-ae9459bb1f8e",
                                                "sense_id": "873c0199-7cd5-3090-b26b-7b30034b617a",
                                                "text": "Generally, as I have said, my inebrieties were nocturnal only, and the day paid the penalty of the night’s excess."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02ace7d4-d080-4f51-b43d-0904c16d9b8d",
                        "source_entry_id": "4965c9c7-80e1-3f54-8864-2295ee009bc1",
                        "source_sense_id": "48925d0c-0337-3f81-9ce7-f30c4eba61b3",
                        "source_sense_description": "het zwaar onder invloed van alcohol zijn",
                        "target_lang_word": "ivresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ivresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bd57ed5-3a24-3917-8530-644565a831e3",
                                        "entry_id": "1fb59d28-c3be-3aab-ab1a-138467e41c02",
                                        "glosses": [
                                            "État d’une personne ivre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fffab7f-8535-440f-b6d4-c9bb453e3bde",
                                                "sense_id": "9bd57ed5-3a24-3917-8530-644565a831e3",
                                                "text": "L’ivresse qui dure longtemps chez les Sauvages, et qui est pour eux une espèce de maladie, les empêcha sans doute de nous poursuivre durant les premières journées."
                                            },
                                            {
                                                "example_id": "7d898682-636b-4124-9e1a-363e013d5c87",
                                                "sense_id": "9bd57ed5-3a24-3917-8530-644565a831e3",
                                                "text": "C’était une ivresse de respirer, de humer ces rayons solaires que le printemps rendait si vivifiants !"
                                            },
                                            {
                                                "example_id": "326b1941-b61d-47da-97cc-cb9c31b43466",
                                                "sense_id": "9bd57ed5-3a24-3917-8530-644565a831e3",
                                                "text": "À l’origine on ne vit dans les boissons fermentées qu’un moyen de se mettre en état d’ivresse. C’est l’étonnement provoqué sur des âmes simples par les propriétés exhilarantes de ces breuvages qui fit décerner à leurs inventeurs les honneurs divins. Tous les hommes ont le goût des excitants propres à leur procurer, avec l’oubli momentané de leurs maux, les jouissances d’une vie que l’imagination arrange quelques instants à son gré. L’ivresse, cette poésie des fonctions digestives, est même, selon une remarque de Ernest Renan, la seule forme sous laquelle les hommes sans culture puissent concevoir l’idéal."
                                            },
                                            {
                                                "example_id": "724434ba-6d00-4b7d-b95f-02784e471999",
                                                "sense_id": "9bd57ed5-3a24-3917-8530-644565a831e3",
                                                "text": "Jamais il n’avait éprouvé une ivresse de volupté aussi aiguë et il eût voulu prolonger indéfiniment cette délicieuse torture."
                                            },
                                            {
                                                "example_id": "f91ccae2-c206-49bd-a6c4-03cd17d6bbba",
                                                "sense_id": "9bd57ed5-3a24-3917-8530-644565a831e3",
                                                "text": "Comme si l’ivresse eût délié sa langue, l’ivresse qui met dans la bouche des hommes un balbutiement pareil à la voix des bêtes, lui, dès qu’il était saoul, devenait d’une loquacité terrible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e25a2d-890d-3550-b695-d538a5cc7709",
                                        "entry_id": "1fb59d28-c3be-3aab-ab1a-138467e41c02",
                                        "glosses": [
                                            "État d’une personne enivrée par l’abus d’alcool."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfe56aae-742a-41ba-949f-da564bd763ae",
                                                "sense_id": "f7e25a2d-890d-3550-b695-d538a5cc7709",
                                                "text": "[…] car, dans le naufrage de l’ivresse, on peut observer que l’amour-propre est le seul sentiment qui surnage."
                                            },
                                            {
                                                "example_id": "7b4e51a8-def4-403d-9745-10651bc6fc95",
                                                "sense_id": "f7e25a2d-890d-3550-b695-d538a5cc7709",
                                                "text": "L’ivresse se lisait dans ses yeux, une ivresse crâne et satisfaite qui lui arrachait quelquefois de gros rires."
                                            },
                                            {
                                                "example_id": "2fc37e18-520a-4bcb-8ca9-dab01331553e",
                                                "sense_id": "f7e25a2d-890d-3550-b695-d538a5cc7709",
                                                "text": "Les éléphants roses n'existent pas, l’ivresse n'abrite que les noirs serpents de la douleur et de la déchéance. On boit pour une seule raison : pas pour oublier que l'on boit, comme ce personnage du Petit Prince, mais pour oublier tout le reste et échapper à la dépression."
                                            },
                                            {
                                                "example_id": "c29571c9-42d5-4a00-ae2d-3f76f62d48a6",
                                                "sense_id": "f7e25a2d-890d-3550-b695-d538a5cc7709",
                                                "text": "Fréquent et insupportable à l’urgence, un agité, saoul, méchant et sale, hurle des grossièretés […] Les gendarmes refusent de s’en occuper. L’ivresse qui est une infraction sur la voie publique devient une maladie à l’hôpital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94fba530-310d-30ed-a7b9-d0686a5439d1",
                                        "entry_id": "1fb59d28-c3be-3aab-ab1a-138467e41c02",
                                        "glosses": [
                                            "Enthousiasme ; exaltation qui monte à la tête."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddc43ed5-8d31-469e-9bbf-9bcfef8111a4",
                                                "sense_id": "94fba530-310d-30ed-a7b9-d0686a5439d1",
                                                "text": "Je dois rendre à la nature l’ivresse que tu as mise en moi."
                                            },
                                            {
                                                "example_id": "6f8c8b0b-edff-4b53-bfdb-be999ae47082",
                                                "sense_id": "94fba530-310d-30ed-a7b9-d0686a5439d1",
                                                "text": "Des années de frénésie et de farouche indépendance, dans l’ivresse de ses neuves et intactes illusions."
                                            },
                                            {
                                                "example_id": "0db118d8-19ca-4aba-b973-7c28f02c6d99",
                                                "sense_id": "94fba530-310d-30ed-a7b9-d0686a5439d1",
                                                "text": "[…] Le Kalevala est un véritable éblouissement, auquel cette traduction de Gabriel Rebourcet rend sa faconde et son ivresse furibarde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
