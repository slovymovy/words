                ],
                "senses": [
                    {
                        "sense_id": "e5af515f-5a0b-3e3f-a5ee-0fddc7b1352e",
                        "entry_id": "48b8d3c5-3d2f-3439-907a-5db7e9d63cd3",
                        "glosses": [
                            "Danser avec plus d’enthousiasme que de talent ; danser maladroitement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "907b75d3-2815-4f10-b622-e4edd3a10c16",
                                "sense_id": "e5af515f-5a0b-3e3f-a5ee-0fddc7b1352e",
                                "text": "L’honneur d’une femme n’y pesait pas lourd, et les enfants ravis usaient leurs chaussures à les dansailler."
                            },
                            {
                                "example_id": "620d1aa3-0286-4dd5-9c24-7552e02528c2",
                                "sense_id": "e5af515f-5a0b-3e3f-a5ee-0fddc7b1352e",
                                "text": "Ils sont tous restés debout, à dansailler d’une jambe sur l’autre, puisque ceux de devant n’ont pas voulu s’asseoir : les chaises pliantes sont en métal et il fait cinq degrés."
                            }
                        ]
                    }
                ],
