                "forms": [
                    {
                        "form_id": "71e44b86-5721-476d-a7f8-e83a292df02d",
                        "entry_id": "029227d7-3dac-38fb-a769-197bb1e7e730",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
