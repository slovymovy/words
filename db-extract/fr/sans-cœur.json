        "fr-extract.jsonl": [
            {
                "entry_id": "1616e611-ca32-3577-90da-1b4b2b927c7d",
                "word": "sans-cœur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b81dec68-84f8-4f25-91ea-1bb93edd7303",
                        "entry_id": "1616e611-ca32-3577-90da-1b4b2b927c7d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "sans-cœurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c7993b4-acdd-35a8-acb8-a76c4af13abc",
                        "entry_id": "1616e611-ca32-3577-90da-1b4b2b927c7d",
                        "glosses": [
                            "Personne qui manque de cœur, de sensibilité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ecdfd6-cd00-4b48-8ebb-8b2c4cdc0237",
                                "sense_id": "7c7993b4-acdd-35a8-acb8-a76c4af13abc",
                                "text": "Philippe. – N’es-tu pas diffamé, traité de chien et de sans-cœur ?"
                            },
                            {
                                "example_id": "8b655b5a-80f2-4709-b71f-52541f05b003",
                                "sense_id": "7c7993b4-acdd-35a8-acb8-a76c4af13abc",
                                "text": "Le diable soit de la parole de ton grand-père !\n— Mon grand-père a bien agi, et si je l’avais contredit, j’aurais été une sans-cœur."
                            },
                            {
                                "example_id": "58a22567-2351-4b93-971e-9e54c7e6f873",
                                "sense_id": "7c7993b4-acdd-35a8-acb8-a76c4af13abc",
                                "text": "Ma femme […] m’invectivait, réclamant toujours quelque argent, que je ne pouvais lui donner. Et elle me traitait d’avare, de grippe-sous, de sans-cœur."
                            },
                            {
                                "example_id": "03fae2b7-498e-4849-8106-2f3581375873",
                                "sense_id": "7c7993b4-acdd-35a8-acb8-a76c4af13abc",
                                "text": "Si vous n’avez pas encore la larme à l’œil – bande de sans-cœur –, sachez que le renvoi de notre chère Aurore risque de générer une souffrance incommensurable et de briser sa vie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3b7fff3-9643-47c6-94b8-1ade35cff4d5",
                        "source_entry_id": "1616e611-ca32-3577-90da-1b4b2b927c7d",
                        "source_sense_id": "7c7993b4-acdd-35a8-acb8-a76c4af13abc",
                        "source_sense_description": "Personne qui manque de sensibilité",
                        "target_lang_word": "ungerührt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungerührt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec84567a-19cc-3dc6-b505-7bd14f9ab1e0",
                                        "entry_id": "539829e4-3c09-3e5d-b41a-ed31477d5e07",
                                        "glosses": [
                                            "keine innere Anteilnahme zeigend; emotional unbeeindruckt; gleichgültig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcfce9fa-827d-4a69-bced-66f5ddee52bd",
                                                "sense_id": "ec84567a-19cc-3dc6-b505-7bd14f9ab1e0",
                                                "text": "„O marmorhart und eisern muß er seyn / Der ungerührt, der ohne Mitleid dich / Gemartert sieht ….“"
                                            },
                                            {
                                                "example_id": "d4c53170-c6ab-4510-ba0b-c5e00ecbaeea",
                                                "sense_id": "ec84567a-19cc-3dc6-b505-7bd14f9ab1e0",
                                                "text": "„Mit dir ist meine Muse nicht vermählt; / Daher magst ungerührt du überseh’n / Die Widmungsworte, die der Dichter wählt ….“"
                                            },
                                            {
                                                "example_id": "9236a7d2-bb2b-4987-9aec-3758960c1ecb",
                                                "sense_id": "ec84567a-19cc-3dc6-b505-7bd14f9ab1e0",
                                                "text": "„[Eine Berbermaus-Mutter übernimmt die Pflege der Jungen einer anderen.] Die andere Mutter blieb nicht ungerührt, sie schloß Frieden mir ihrer Widersacherin und theilte sich mit ihr freundschaftlich in die Freuden und Leiden der Mutterschaft.“"
                                            },
                                            {
                                                "example_id": "0feaaacb-eb20-4a4e-8427-3901efe7e7c9",
                                                "sense_id": "ec84567a-19cc-3dc6-b505-7bd14f9ab1e0",
                                                "text": "„Sie müssen doch sehen, daß [Ihre] Thorheit … mich völlig ungerührt gelassen hat.“"
                                            },
                                            {
                                                "example_id": "7b800d93-4c22-4f76-bc99-4653eab6f031",
                                                "sense_id": "ec84567a-19cc-3dc6-b505-7bd14f9ab1e0",
                                                "text": "„»Wie heißen Sie?« fragte Karl, … zwar sehr höflich, aber gänzlich ungerührt …. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7f1034e-5f59-40d0-83dc-406b2ee8852a",
                        "source_entry_id": "1616e611-ca32-3577-90da-1b4b2b927c7d",
                        "source_sense_id": "7c7993b4-acdd-35a8-acb8-a76c4af13abc",
                        "source_sense_description": "Personne qui manque de sensibilité",
                        "target_lang_word": "heartless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heartless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                        "entry_id": "4e9e7f36-4cce-3791-a382-b62328c01af0",
                                        "glosses": [
                                            "Without feeling, emotion, or concern for others; uncaring; cruel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04470f3c-416e-47bb-9f47-fc67a76c8956",
                                                "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                                "text": "His heartless actions and cold manner left her saddened and feeling alone."
                                            },
                                            {
                                                "example_id": "c9474884-b764-4116-9122-1762d8a83e97",
                                                "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                                "text": "The world is a dangerous, violent place […] and the only true refuge from this heartless world is the family."
                                            },
                                            {
                                                "example_id": "e2d6331d-9c7d-478a-b21f-796eeca4ffbb",
                                                "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                                "text": "It's safer to be heartless than mindless. The history of the world is the history of the triumph of the heartless over the mindless."
                                            },
                                            {
                                                "example_id": "7df848d9-85ca-4b57-99f8-998f487af970",
                                                "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                                "text": "Mr. Burns is similarly perfectly cast as a heartless capitalist willing to do anything for a quick buck, even if it means endangering the lives of those around him and Marge elegantly rounds out the main cast as a good, pure-hearted and overly indulgent woman who sees the big, good heart (literally and metaphorically) of a monstrous man-brute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c6d48e3-f62c-3d6c-9ffc-ca14ac20aabd",
                                        "entry_id": "4e9e7f36-4cce-3791-a382-b62328c01af0",
                                        "glosses": [
                                            "Without a physical heart."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a48b5566-1834-3ab8-a951-c1bf57455921",
                                        "entry_id": "4e9e7f36-4cce-3791-a382-b62328c01af0",
                                        "glosses": [
                                            "Listless, unenthusiastic."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "014e7ada-b24f-4251-9545-0300018964fa",
                                                "sense_id": "a48b5566-1834-3ab8-a951-c1bf57455921",
                                                "text": "Near-synonyms: spiritless, unhearty"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36ff8ba9-9164-37c5-b120-41e88a25d002",
                                        "entry_id": "4e9e7f36-4cce-3791-a382-b62328c01af0",
                                        "glosses": [
                                            "Without courage; fearful, cowardly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cccba9a-8f1f-449e-a0a7-2886124832e6",
                                                "sense_id": "36ff8ba9-9164-37c5-b120-41e88a25d002",
                                                "text": "Cecilia then, though almost heartless, resolved upon talking with Mr. Harrel himself […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
