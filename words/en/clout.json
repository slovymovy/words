                {
                    "sense_id": "15c5e03c-9405-3f69-a250-e18613138a67",
                    "sense_definition": "An iron plate fitted to an axle or other wooden structure to prevent excessive wear.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metalwork",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blacksmith attached a sturdy iron <w>clout</w> to the cart's wooden axle.",
                            "target_lang_translations": {
                                "zh": "铁匠在手推车的木轴上安装了一块坚固的<w>轴衬铁片</w>。"
                            }
                        },
                        {
                            "text": "After years of friction on rough roads, the axle's protective <w>clout</w> had worn thin.",
                            "target_lang_translations": {
                                "zh": "在崎岖道路上经过多年的摩擦后，车轴的防护<w>护铁</w>已经磨得很薄了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Traditional wheelwright and carpentry terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "装在车轴等木质结构上以防过度磨损的铁护板"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轴衬铁片",
                                "target_lang_sense_clarification": "防磨铁皮或护轴板"
                            },
                            {
                                "target_lang_word": "护铁",
                                "target_lang_sense_clarification": "固定在木结构上的保护性铁板"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c273f08-615f-365e-9e86-e1e7783bfe52",
