{
    "word_family": [
        "jinxed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "20bab0b8-5b47-38d1-ae52-2aa078bf33f6",
                    "sense_definition": "A hex or an evil spell.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bad_luck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old woman believed a <w>jinx</w> had been placed on her family for generations.",
                            "target_lang_translations": {
                                "tr": "Yaşlı kadın, ailesinin nesillerdir bir <w>lanet</w> altında olduğuna inanıyordu."
                            }
                        },
                        {
                            "text": "He tried to break the <w>jinx</w> by throwing salt over his shoulder.",
                            "target_lang_translations": {
                                "tr": "Omzunun üzerinden tuz atarak <w>uğursuzluğu</w> kırmaya çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "curse",
                        "hoodoo",
                        "spell"
                    ],
                    "common_phrases": [
                        "break the jinx"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birine veya bir şeye atılan kötü büyü, lanet."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uğursuzluk",
                                "target_lang_sense_clarification": "Genel olarak kötü şans getiren durum."
                            },
                            {
                                "target_lang_word": "lanet",
                                "target_lang_sense_clarification": "Büyü yoluyla gelen kötü etki."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed77df18-9eb1-38ca-a076-4de680b4a7d6",
                    "sense_definition": "A person or thing that is believed to bring bad luck.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bad_luck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some players think the new mascot is a <w>jinx</w> because the team keeps losing.",
                            "target_lang_translations": {
                                "tr": "Bazı oyuncular, takım sürekli kaybettiği için yeni maskotun <w>uğursuz</w> olduğunu düşünüyor."
                            }
                        },
                        {
                            "text": "Don't call me a <w>jinx</w> just because it started raining when I arrived.",
                            "target_lang_translations": {
                                "tr": "Sırf ben gelince yağmur başladı diye bana <w>uğursuz</w> deme."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kötü şans getirdiğine inanılan kişi veya nesne."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uğursuz",
                                "target_lang_sense_clarification": "Kötü şans getiren kişi veya şey."
                            },
                            {
                                "target_lang_word": "uğursuzluk getiren",
                                "target_lang_sense_clarification": "Kötü şansın kaynağı olarak görülen."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b6ec29b-3137-39d2-900d-fff903a656f2",
                    "sense_definition": "To cause someone or something to have bad luck.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bad_luck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I did not want to <w>jinx</w> our chances by talking about the victory too early.",
                            "target_lang_translations": {
                                "tr": "Zafer hakkında çok erken konuşarak şansımızı <w>uğursuzluğa uğratmak</w> istemedim."
                            }
                        },
                        {
                            "text": "He felt that his presence would <w>jinx</w> the entire project.",
                            "target_lang_translations": {
                                "tr": "Varlığının tüm projeye <w>uğursuzluk getireceğini</w> hissetti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jinx the project"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinin veya bir şeyin başına kötü şans gelmesine neden olmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uğursuzluk getirmek",
                                "target_lang_sense_clarification": "Bir işin kötü gitmesine sebep olmak."
                            },
                            {
                                "target_lang_word": "büyülemek",
                                "target_lang_sense_clarification": "Kötü bir etki altına almak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6b43de2-76ee-3124-88a7-cd3ddc095a76",
                    "sense_definition": "To prevent a desired outcome from happening by speaking about it prematurely.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "bad_luck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have almost finished the deal, so please do not <w>jinx</w> it now.",
                            "target_lang_translations": {
                                "tr": "Anlaşmayı neredeyse bitirdik, lütfen şimdi <w>nazara getirme</w>."
                            }
                        },
                        {
                            "text": "I am afraid to <w>jinx</w> it by announcing the news before it is official.",
                            "target_lang_translations": {
                                "tr": "Haber resmiyet kazanmadan duyurarak <w>işi bozmaktan</w> korkuyorum."
                            }
                        }
                    ],
                    "common_phrases": [
                        "don't jinx it"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şey hakkında erken konuşarak onun gerçekleşmesini engellemek veya bozmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "nazara getirmek",
                                "target_lang_sense_clarification": "İyi giden bir işi konuşarak bozmak."
                            },
                            {
                                "target_lang_word": "bozmak",
                                "target_lang_sense_clarification": "İşin gidişatını olumsuz etkilemek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbfbe34c-41fd-3bc0-bc67-e461a5ffd186",
                    "sense_definition": "To cast a magical spell on someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bad_luck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witch tried to <w>jinx</w> the knight before he entered the dark forest.",
                            "target_lang_translations": {
                                "tr": "Cadı, şövalye karanlık ormana girmeden önce onu <w>lanetlemeye</w> çalıştı."
                            }
                        },
                        {
                            "text": "Legend says the sorcerer could <w>jinx</w> anyone who dared to enter his cave.",
                            "target_lang_translations": {
                                "tr": "Efsaneye göre büyücü, mağarasına girmeye cüret eden herkesi <w>lanetleyebiliyordu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "curse",
                        "spell"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birine veya bir şeye büyü yapmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "lanetlemek",
                                "target_lang_sense_clarification": "Kötü bir büyü ile etkilemek."
                            },
                            {
                                "target_lang_word": "büyü yapmak",
                                "target_lang_sense_clarification": "Doğaüstü bir etki uygulamak."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "c54123d8-a821-3720-8122-19e460295c0d",
                    "sense_definition": "A word shouted when two people say the same thing at the same time.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We both said the answer at once and shouted <w>jinx</w> at each other.",
                            "target_lang_translations": {
                                "tr": "İkimiz de cevabı aynı anda söyledik ve birbirimize <w>aynı anda</w> diye bağırdık."
                            }
                        },
                        {
                            "text": "After the <w>jinx</w>, we had to stay silent until someone said our names.",
                            "target_lang_translations": {
                                "tr": "<w>Aynı anda</w> oyunundan sonra, biri ismimizi söyleyene kadar sessiz kalmamız gerekiyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "snap"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal social games among children or friends."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "İki kişi aynı anda aynı şeyi söylediğinde kullanılan bir ifade."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "aynı anda",
                                "target_lang_sense_clarification": "Aynı şeyi söyleme durumunu ifade eden oyun."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}