                    {
                        "translation_id": "a5506604-bac5-4100-aef6-da7eb238b6cf",
                        "source_entry_id": "be11d0c5-ce52-35c0-a2af-a90d2db34099",
                        "source_sense_id": "3ac09ba4-6cd8-3083-9674-89a1905f9196",
                        "source_sense_description": "heterosexual",
                        "target_lang_word": "Hetero",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hetero",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "733909ab-163e-38ec-9f22-fb7fb02ded17",
                                        "entry_id": "1cff0ccf-47dc-38a5-8289-0dd5fc8f4994",
                                        "glosses": [
                                            "Heterosexueller; Mensch, der sich zu Personen des anderen Geschlechts hingezogen fühlt"
                                        ],
                                        "tags": [
                                            "Kurzwort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5742b2a8-226f-4b83-b218-109ca048c981",
                                                "sense_id": "733909ab-163e-38ec-9f22-fb7fb02ded17",
                                                "text": "„Nach 1983 – die Grünen waren zum ersten Mal im Bundestag vertreten – beschloss die Fraktion, einen Antrag gegen den Paragrafen 175 im Parlament einzubringen und für die Gleichberechtigung vor dem Gesetz von Schwulen und Lesben mit Heteros zu votieren.“"
                                            },
                                            {
                                                "example_id": "cfce5670-2a87-40e0-9d54-4669246d010c",
                                                "sense_id": "733909ab-163e-38ec-9f22-fb7fb02ded17",
                                                "text": "„Den Mädchen gegenüber beteuerte er, in Wirklichkeit noch immer wie in München ein Hetero zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hetero",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66b81fbf-8d95-3ff4-a97e-6b50696c95cf",
                                        "entry_id": "ed7776a4-b0f6-349e-9056-edf86914028b",
                                        "glosses": [
                                            "Heterosexuelle; Frau, die sich zu Männern hingezogen fühlt"
                                        ],
                                        "tags": [
                                            "Kurzwort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e970e52f-9971-4a9a-a29a-03cd58210247",
                                                "sense_id": "66b81fbf-8d95-3ff4-a97e-6b50696c95cf",
                                                "text": "„Schluss mit den Stereotypen! Du benimmst dich wie eine Hetero!“"
                                            },
                                            {
                                                "example_id": "84335189-0a90-4a3e-b727-c25d3e016689",
                                                "sense_id": "66b81fbf-8d95-3ff4-a97e-6b50696c95cf",
                                                "text": "„‚Das war nicht Buffy. Ich bin freiwillig hier.‘ ‚Weil du die andere Lesbe bist.‘ ‚Weil du wissen sollst, dass du nicht die einzige bist, die mal eine Hetero vernascht hat.‘“"
                                            },
                                            {
                                                "example_id": "d0b819c0-9d0c-489e-bedc-8e58fd7cdafd",
                                                "sense_id": "66b81fbf-8d95-3ff4-a97e-6b50696c95cf",
                                                "text": "„Die Psychologin Dr. Noel Benedict (Karen Trumbo) glaubt daran und versucht, die schöne Hetero Claire Jabrowski (Trisha Todd) davon zu überzeugen, daß die Anziehungskraft zwischen Mann und Frau klar definiert und deshalb langweilig sei.“"
                                            },
                                            {
                                                "example_id": "b711f1f0-e8ae-4b0c-865c-4b38dc0560a9",
                                                "sense_id": "66b81fbf-8d95-3ff4-a97e-6b50696c95cf",
                                                "text": "„Ich als Mensch aber habe noch nie behauptet und würde auch nie behaupten, dass ein Schwuler schlechter als eine Hetero ist, oder ein Buddhist weniger wert als ein Christ ist.“"
                                            },
                                            {
                                                "example_id": "d0f4ac1c-4254-42a9-8161-310e9a6dbcd6",
                                                "sense_id": "66b81fbf-8d95-3ff4-a97e-6b50696c95cf",
                                                "text": "„Das haben auch Sie gemerkt, obwohl Sie eine Hetero sind, stimmt doch?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b50c58f7-c7c3-4216-a946-424ae8c91474",
                        "source_entry_id": "be11d0c5-ce52-35c0-a2af-a90d2db34099",
                        "source_sense_id": "3ac09ba4-6cd8-3083-9674-89a1905f9196",
                        "source_sense_description": "heterosexual",
                        "target_lang_word": "Hete",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hete",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10dbb9a5-d917-378e-b51f-10adefdc190d",
                                        "entry_id": "b5dd6655-7b88-3859-b47d-138f1e71b9c7",
                                        "glosses": [
                                            "leicht abfällig: Person mit heterosexueller Orientierung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56bcb943-4af3-436b-b8b8-b450a266ba66",
                                                "sense_id": "10dbb9a5-d917-378e-b51f-10adefdc190d",
                                                "text": "„An der Schauspielschule waren die meisten Männer schwul; wenn sie dann am Theater engagiert werden, sind sie plötzlich alle Heten.“"
                                            },
                                            {
                                                "example_id": "13bb41b8-b246-4b9c-aba5-f8f20e83c2d9",
                                                "sense_id": "10dbb9a5-d917-378e-b51f-10adefdc190d",
                                                "text": "„Was habt ihr Lesben nur davon, immer eine Hete umdrehen zu wollen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
