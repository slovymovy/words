                        "glosses": [
                            "officier die zich bezighoudt met de contacten tussen de verschillende legeronderdelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f393987d-3ebf-4d1f-9cb2-ae5ea9ae85f5",
                                "sense_id": "13ad8e20-9770-30c9-b192-c2ee3673760b",
                                "text": "Op een open veldje stond verbindingsofficier Kamennodvorski bij zijn archief overbodig bevonden papierrommel uit Kappels regimentsadministratie te verbranden, tezamen met stapels rapporten van de partizanen zelf."
