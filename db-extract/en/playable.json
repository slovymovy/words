                    {
                        "translation_id": "c8426ca3-06de-4a89-815d-1d7342d16567",
                        "source_entry_id": "06fd5794-3b49-3e5d-ac29-501b02a54e84",
                        "source_sense_description": "able to be played",
                        "target_lang_word": "jouable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jouable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "876d9dd6-92df-36ed-bfaf-6cb52e58a410",
                                        "entry_id": "8a87e5f4-48c1-3d0a-a79c-9788e0864036",
                                        "glosses": [
                                            "Qui peut être joué, en parlant d’une pièce de théâtre, d’un morceau de musique, d’un jeu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65409fa5-a6f5-49d2-9869-c34d4f79cfb4",
                                                "sense_id": "876d9dd6-92df-36ed-bfaf-6cb52e58a410",
                                                "text": "Voyez, jugez ; trouvez-vous enfin Mahomet jouable ?"
                                            },
                                            {
                                                "example_id": "c7b1f624-6a35-4b85-87af-6521fee79071",
                                                "sense_id": "876d9dd6-92df-36ed-bfaf-6cb52e58a410",
                                                "text": "Dès qu’on a touché un pion, on est obligé de le jouer s’il est jouable, conformément à l’axiome connu, Dame touchée Dame jouée."
                                            },
                                            {
                                                "example_id": "7fd3f6b6-a4b9-4184-ae30-1094b2cb008e",
                                                "sense_id": "876d9dd6-92df-36ed-bfaf-6cb52e58a410",
                                                "text": "« J’aurais souhaité plus d’informations sur la conception des jeux vidéo et que des titres plus méconnus que Pac-Man ou Pong soient jouables. Cela aurait permis d’élargir un peu plus les connaissances de ceux qui s’intéressent déjà à ce secteur », regrette Renaud Daniel, 21 ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65b1646e-cc50-3738-9ebb-3ffaffb15f7a",
                                        "entry_id": "8a87e5f4-48c1-3d0a-a79c-9788e0864036",
                                        "glosses": [
                                            "Qui peut être tenté : faisable, réalisable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "016f2582-fe63-4b7d-bfdd-ba50c4a87d4e",
                                                "sense_id": "65b1646e-cc50-3738-9ebb-3ffaffb15f7a",
                                                "text": "Si c’est Donald Trump en revanche qui remporte l’Etat [de Floride], tout sera encore jouable."
                                            },
                                            {
                                                "example_id": "40396639-8443-4a5c-853e-facb7278e241",
                                                "sense_id": "65b1646e-cc50-3738-9ebb-3ffaffb15f7a",
                                                "text": "Politique genevoise – Pierre Maudet se lance: «Audacieux, mais jouable». De nombreux candidats vont tenter de ravir le siège de l’ex-PLR."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0affccf6-abab-4d8b-b80f-c950c62bc867",
                        "source_entry_id": "06fd5794-3b49-3e5d-ac29-501b02a54e84",
                        "source_sense_description": "able to be played",
                        "target_lang_word": "spielbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spielbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebca9903-10fd-3a8a-89ac-fdb11061441d",
                                        "entry_id": "a79d4f9e-f0ea-3164-b77c-1b5360ba20dd",
                                        "glosses": [
                                            "technisch geeignet, der Unterhaltung zu dienen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da689f0b-6a5b-475b-a2de-d378d355e3c4",
                                                "sense_id": "ebca9903-10fd-3a8a-89ac-fdb11061441d",
                                                "text": "„Mit druckreifen, wohlgesetzten Ansagen, in sich ruhend und tiefenentspannt bis in die Fingerspitzen - anders wäre vieles von dem, was er macht, auch gar nicht spielbar - vermittelt er den Eindruck eines Musikers, der den Schlüssel zu seiner Kunst gefunden hat.“"
                                            },
                                            {
                                                "example_id": "c62a8d40-2b79-4803-8a40-6442bb2ab633",
                                                "sense_id": "ebca9903-10fd-3a8a-89ac-fdb11061441d",
                                                "text": "„[Janine Jansen:] Manchmal werde ich gefragt, ob diese oder jene Stelle spielbar sei, aber selbst dann denke ich, der Komponist sollte nicht so schreiben, wie es mir passt, sondern was er im Kopf hat.“"
                                            },
                                            {
                                                "example_id": "bff629fb-d7d4-4f15-8662-1ad93fc69f98",
                                                "sense_id": "ebca9903-10fd-3a8a-89ac-fdb11061441d",
                                                "text": "„Charlotte meinte, sie möchte liebend gern versuchen, die Noten so umzuschreiben, dass sie auch auf dem Klavier spielbar seien.“"
                                            },
                                            {
                                                "example_id": "777811c8-ea51-44d2-bfd2-3180f2a1b4bf",
                                                "sense_id": "ebca9903-10fd-3a8a-89ac-fdb11061441d",
                                                "text": "„Das Internet-Archiv archive.org hat Tausende Spiele-Klassiker veröffentlicht - spielbar direkt im Browser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
