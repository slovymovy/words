                                        "examples": [
                                            {
                                                "example_id": "05e6fcc0-2a9d-4b6f-abc2-c92f71893f95",
                                                "sense_id": "74315e74-3344-377a-b02e-df1c7acdf717",
                                                "text": "Ein Atom des Heliums besitzt zwei Elektronen."
                                            },
                                            {
                                                "example_id": "b68618f6-9d52-4a23-9781-fb930ae9caf1",
                                                "sense_id": "74315e74-3344-377a-b02e-df1c7acdf717",
                                                "text": "„Früher hatte man jedes Atom für ein Sonnensystem im kleinen gehalten, das aus einem Kern bestand, der von kreisenden Elektronen umgeben war und die Sphärenharmonie in mikroskopischem Maßstab widerspiegelte.“"
                                            },
                                            {
                                                "example_id": "5e843e31-420e-4356-ab44-eaf7ba8d5fce",
                                                "sense_id": "74315e74-3344-377a-b02e-df1c7acdf717",
                                                "text": "„Weder gibt es einen Plus- noch einen Minuspol, sondern nur ein Gefälle von geladenen Teilchen wie Elektronen oder Ionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65f3d67b-6c69-32e0-b3f2-a896fb27e3cf",
