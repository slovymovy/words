    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7cdbceb9-4570-3feb-af38-3f4172884ebf",
                "word": "taskmaster",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9d70072a-d9ce-420a-9db5-19d4b08d308c",
                        "entry_id": "7cdbceb9-4570-3feb-af38-3f4172884ebf",
                        "tags": [
                            "plural"
                        ],
                        "form": "taskmasters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28e2ff3f-064f-3a95-97ac-cffb667e9b3e",
                        "entry_id": "7cdbceb9-4570-3feb-af38-3f4172884ebf",
                        "glosses": [
                            "Someone who supervises workers, especially one who imposes hard or burdensome work."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab7f2520-0d62-4364-a8d3-f4fadc4e66d4",
                                "sense_id": "28e2ff3f-064f-3a95-97ac-cffb667e9b3e",
                                "text": "And the Lord said, I have surely seen the affliction of my people which are in Egypt, and have heard their cry by reason of their taskmasters; for I know their sorrows"
                            }
                        ]
                    },
                    {
                        "sense_id": "f06e2b65-550b-38f2-8800-800f3c78d2b1",
                        "entry_id": "7cdbceb9-4570-3feb-af38-3f4172884ebf",
                        "glosses": [
                            "A source of hard work or responsibility."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "741cd438-0814-47bb-9ada-9ffd74c5f3bb",
                                "sense_id": "f06e2b65-550b-38f2-8800-800f3c78d2b1",
                                "text": "It all looked so easy when the competent were at the helm, but reality is a cruel taskmaster, and all the excuses that worked as an underling wear thin once the incompetent are in leadership roles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8de7e5b0-4820-45a6-a98b-2fa75c6445f2",
                        "source_entry_id": "7cdbceb9-4570-3feb-af38-3f4172884ebf",
                        "source_sense_description": "Supervisor",
                        "target_lang_word": "Zuchtmeister",
                        "target_lang_code": "de",
