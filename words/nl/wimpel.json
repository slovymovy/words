{
    "word_family": [
        "wimpelen",
        "afwimpelen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b061eaea-a4f6-3204-b66b-5a189b274a23",
                    "sense_definition": "Een smalle, lange strook stof die aan een vlaggenmast wordt bevestigd, vaak boven een vlag.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vlaggen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de nationale feestdag hing er een oranje <w>wimpel</w> boven de Nederlandse vlag.",
                            "target_lang_translations": {
                                "en": "During the national holiday, an orange <w>pennant</w> hung above the Dutch flag."
                            }
                        },
                        {
                            "text": "De <w>wimpel</w> wapperde vrolijk in de wind bovenop de hoge mast van het schip.",
                            "target_lang_translations": {
                                "en": "The <w>pennant</w> fluttered cheerfully in the wind atop the ship's tall mast."
                            }
                        }
                    ],
                    "synonyms": [
                        "vaantje",
                        "banier"
                    ],
                    "common_phrases": [
                        "oranje wimpel",
                        "wimpel in top"
                    ],
                    "target_lang_definitions": {
                        "en": "A narrow, long strip of fabric attached to a flagpole, often above a flag."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pennant",
                                "target_lang_sense_clarification": "a long, narrow flag used on ships or for decoration"
                            },
                            {
                                "target_lang_word": "streamer",
                                "target_lang_sense_clarification": "a long, thin strip of material used as a decoration or flag"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b052f382-de71-3077-923d-f6f422bef80a",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>wimpelen</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>wimpel</w> de lastige vragen van de journalist direct af tijdens het interview.",
                            "target_lang_translations": {
                                "en": "I <w>brush off</w> the journalist's difficult questions immediately during the interview."
                            }
                        },
                        {
                            "text": "Als ik de kans krijg, <w>wimpel</w> ik dat saaie voorstel liever vandaag nog af.",
                            "target_lang_translations": {
                                "en": "If I get the chance, I'd rather <w>dismiss</w> that boring proposal today."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'afwimpelen' (to brush off/dismiss)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brush off",
                                "target_lang_sense_clarification": "to dismiss or ignore someone or something"
                            },
                            {
                                "target_lang_word": "dismiss",
                                "target_lang_sense_clarification": "to treat as unworthy of serious consideration"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f07dda3-9ed5-3270-ae00-34fc929e8638",
                    "sense_definition": "De gebiedende wijs van <w>wimpelen</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wimpel</w> die onzin nu eindelijk eens af en concentreer je op je echte werk.",
                            "target_lang_translations": {
                                "en": "Finally <w>brush off</w> that nonsense and concentrate on your real work."
                            }
                        },
                        {
                            "text": "<w>Wimpel</w> hem niet zomaar af, maar luister eerst naar wat hij te zeggen heeft.",
                            "target_lang_translations": {
                                "en": "Don't just <w>dismiss</w> him, but listen to what he has to say first."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative mood of 'afwimpelen' (to brush off/dismiss)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brush off",
                                "target_lang_sense_clarification": "command to dismiss or ignore"
                            },
                            {
                                "target_lang_word": "wave away",
                                "target_lang_sense_clarification": "command to reject or dismiss"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "914fead0-32a8-3f49-83ee-d62be9a71f3c",
                    "sense_definition": "De tweede persoon enkelvoud tegenwoordige tijd van <w>wimpelen</w> in inversie.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>wimpel</w> je elk goed advies dat ik je geef altijd direct af?",
                            "target_lang_translations": {
                                "en": "Why do you always immediately <w>brush off</w> every piece of good advice I give you?"
                            }
                        },
                        {
                            "text": "<w>Wimpel</w> je die uitnodiging voor het feestje vanavond ook weer af?",
                            "target_lang_translations": {
                                "en": "Are you <w>rejecting</w> that invitation for the party tonight as well?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present inversion"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The second person singular present tense of 'afwimpelen' in inversion (to brush off/dismiss)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brush off",
                                "target_lang_sense_clarification": "to dismiss or ignore"
                            },
                            {
                                "target_lang_word": "reject",
                                "target_lang_sense_clarification": "to refuse to accept or consider"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}