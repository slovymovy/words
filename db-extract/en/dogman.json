                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "75f8c78d-c203-462e-a4d1-437a216cf7b6",
                        "entry_id": "a817f98d-1f62-30f3-b29e-3df142a33d5f",
