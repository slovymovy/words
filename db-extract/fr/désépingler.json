                "senses": [
                    {
                        "sense_id": "8b5e3525-a401-3b98-9739-342b38e72fa8",
                        "entry_id": "845ce5ba-23e6-35e3-95b1-8e1c52baebdb",
                        "glosses": [
                            "Détacher ce qui était épinglé, arrêter d’épingler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23ffc6ce-b110-448c-840f-90e8df73417b",
                                "sense_id": "8b5e3525-a401-3b98-9739-342b38e72fa8",
                                "text": "Épingler et désépingler une carte de visite sur votre bureau"
                            },
                            {
                                "example_id": "f82033bd-bcaa-4a1e-93a0-7707c17b3441",
                                "sense_id": "8b5e3525-a401-3b98-9739-342b38e72fa8",
                                "text": "Faudrait désépingler, c'est plus trop à l’ordre du jour"
                            },
                            {
                                "example_id": "134f7a5b-d7a0-4750-b558-af1e6e909085",
                                "sense_id": "8b5e3525-a401-3b98-9739-342b38e72fa8",
                                "text": "Ca fait longtemps qu’il est épinglé, à désépingler si besoin."
                            }
                        ]
                    }
                ],
