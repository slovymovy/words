{
    "word_family": [
        "дача",
        "даритель",
        "подарок",
        "отдача",
        "раздача",
        "выдача",
        "передача",
        "задача"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b6aa63c-3863-37b9-9fc3-97ee2f3aaa70",
                    "sense_definition": "Перемещать что-либо в распоряжение другого субъекта.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, <w>давай</w> мне эту книгу.",
                            "target_lang_translations": {
                                "cs": "Prosím, <w>dej</w> mi tuhle knihu."
                            }
                        },
                        {
                            "text": "Он <w>даёт</w> деньги на благотворительность.",
                            "target_lang_translations": {
                                "cs": "On <w>dává</w> peníze na charitu."
                            }
                        }
                    ],
                    "antonyms": [
                        "брать",
                        "принимать",
                        "получать"
                    ],
                    "common_phrases": [
                        "давать деньги",
                        "давать совет"
                    ],
                    "target_lang_definitions": {
                        "cs": "Předávat něco do vlastnictví nebo dispozice někomu jinému."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dávat",
                                "target_lang_sense_clarification": "obecný význam předávání nebo poskytování něčeho"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b607d3a-cb9f-380c-8fca-703ef87387ca",
                    "sense_definition": "В повелительном наклонении — вводное слово, выражающее предложение сделать что-либо вместе.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "suggestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Давай</w> сходим сегодня в кино.",
                            "target_lang_translations": {
                                "cs": "<w>Pojďme</w> dnes do kina."
                            }
                        },
                        {
                            "text": "<w>Давай</w> помогу тебе с сумками.",
                            "target_lang_translations": {
                                "cs": "<w>Pojď</w>, pomůžu ti s taškami."
                            }
                        }
                    ],
                    "common_phrases": [
                        "давай сходим",
                        "давай сделаем"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyzvání k společné akci, vyjádření návrhu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pojďme",
                                "target_lang_sense_clarification": "vyjádření společného záměru nebo výzvy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4933067e-c03a-3444-8949-6d602048ff27",
                    "sense_definition": "Доставлять, приносить как результат или продукт.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта корова <w>даёт</w> много молока каждый день.",
                            "target_lang_translations": {
                                "cs": "Tato kráva <w>dává</w> každý den hodně mléka."
                            }
                        },
                        {
                            "text": "Упорный труд <w>даёт</w> отличные результаты.",
                            "target_lang_translations": {
                                "cs": "Usilovná práce <w>přináší</w> skvělé výsledky."
                            }
                        }
                    ],
                    "common_phrases": [
                        "давать результат",
                        "давать молоко"
                    ],
                    "target_lang_definitions": {
                        "cs": "Produkovat, přinášet jako výsledek nebo užitek."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dávat",
                                "target_lang_sense_clarification": "v kontextu produkce (např. mléka) nebo výsledků"
                            },
                            {
                                "target_lang_word": "přinášet",
                                "target_lang_sense_clarification": "v kontextu výsledků nebo užitku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "820823a5-8d8a-3c9a-a5c5-bf5423b3c78c",
                    "sense_definition": "Разрешать, позволять, не препятствовать действию.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Плохая погода не <w>давала</w> нам выйти на улицу.",
                            "target_lang_translations": {
                                "cs": "Špatné počasí nám <w>nedovolilo</w> jít ven."
                            }
                        },
                        {
                            "text": "Мама не <w>даёт</w> детям смотреть телевизор допоздна.",
                            "target_lang_translations": {
                                "cs": "Máma <w>nedovoluje</w> dětem dívat se na televizi dlouho do noci."
                            }
                        }
                    ],
                    "common_phrases": [
                        "не давать покоя"
                    ],
                    "target_lang_definitions": {
                        "cs": "Umožňovat, dovolovat nebo nebránit v činnosti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dovolovat",
                                "target_lang_sense_clarification": "udělovat svolení"
                            },
                            {
                                "target_lang_word": "nechat",
                                "target_lang_sense_clarification": "umožnit někomu něco dělat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b9d559d-5dc4-33e7-870c-fd847af9af09",
                    "sense_definition": "Оценивать чей-либо возраст на вид.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "estimation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ей уже пятьдесят, но никто не <w>даёт</w> ей больше сорока.",
                            "target_lang_translations": {
                                "cs": "Je jí už padesát, ale nikdo jí <w>nehádá</w> víc než čtyřicet."
                            }
                        },
                        {
                            "text": "По внешности ему можно <w>дать</w> тридцать лет.",
                            "target_lang_translations": {
                                "cs": "Podle vzhledu mu lze <w>hádat</w> třicet let."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Odhadovat něčí věk na základě vzhledu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hádat",
                                "target_lang_sense_clarification": "odhadovat věk"
                            },
                            {
                                "target_lang_word": "tipovat",
                                "target_lang_sense_clarification": "odhadovat věk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d20e2cbf-ee8d-35ed-b0e0-b3acd7206c16",
                    "sense_definition": "Делать что-то неожиданное или удивительное.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ну ты <w>даёшь</w>, я совсем не ожидал такого ответа!",
                            "target_lang_translations": {
                                "cs": "Teda ty <w>dáváš</w>, takovou odpověď jsem vůbec nečekal!"
                            }
                        },
                        {
                            "text": "Ты сегодня <w>даёшь</w> — так быстро всё закончил.",
                            "target_lang_translations": {
                                "cs": "Ty dnes <w>dáváš</w> — všechno jsi tak rychle dokončil."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное выражение"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Dělat něco nečekaného, překvapivého nebo neobvyklého."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dávat zabrat",
                                "target_lang_sense_clarification": "v kontextu někoho, kdo překvapuje svým výkonem nebo chováním"
                            },
                            {
                                "target_lang_word": "překvapovat",
                                "target_lang_sense_clarification": "v kontextu nečekaného jednání"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd3a7a6f-733f-3273-8774-082e3a635ab1",
                    "sense_definition": "Начинать делать что-то с энергией или интенсивностью.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он увидел смешную сцену и <w>давай</w> хохотать на весь зал.",
                            "target_lang_translations": {
                                "cs": "Uviděl vtipnou scénu a <w>začal</w> se smát na celé kolo."
                            }
                        },
                        {
                            "text": "Они поссорились и <w>давай</w> кричать друг на друга.",
                            "target_lang_translations": {
                                "cs": "Pohádali se a <w>začali</w> na sebe křičet."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное выражение"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Začít něco dělat s velkou intenzitou nebo energií."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pustit se do",
                                "target_lang_sense_clarification": "začít intenzivně konat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80175715-90b2-3ba3-add6-0888c680af53",
                    "sense_definition": "Использоваться при дружеском прощании.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "farewell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ну, <w>давай</w>, увидимся на следующей неделе!",
                            "target_lang_translations": {
                                "cs": "Tak <w>měj se</w>, uvidíme se příští týden!"
                            }
                        },
                        {
                            "text": "Пока, <w>давай</w>, не болей!",
                            "target_lang_translations": {
                                "cs": "Ahoj, <w>měj se</w> a buď zdráv!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное выражение"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Používá se při neformálním loučení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "měj se",
                                "target_lang_sense_clarification": "přátelské rozloučení"
                            },
                            {
                                "target_lang_word": "tak zatím",
                                "target_lang_sense_clarification": "neformální rozloučení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}