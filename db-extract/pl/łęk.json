                                "sense_id": "60450b97-df86-34c1-ab8f-46f2982f3699",
                                "text": "Gurty pojawiły się w sklepieniu kolebkowym jako tzw. łęki jarzmowe"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
