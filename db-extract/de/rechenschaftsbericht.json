                    {
                        "sense_id": "cf617765-e2cb-36bd-b1bb-dfe000f56d1e",
                        "entry_id": "d99d830a-6552-334f-928d-1302ff013b8b",
                        "glosses": [
                            "Darstellung der Aktivitäten, die im Namen eines Auftraggebers durchgeführt wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d46d48e7-0c07-495f-a130-c9db36910020",
                                "sense_id": "cf617765-e2cb-36bd-b1bb-dfe000f56d1e",
                                "text": "„Die Auseinandersetzung der beiden und Mitenkas Rechenschaftsbericht dauerten nicht lange.“"
                            },
                            {
                                "example_id": "05cd8e54-4c7a-49aa-90ed-cb6352078e9f",
                                "sense_id": "cf617765-e2cb-36bd-b1bb-dfe000f56d1e",
                                "text": "„Politische Parteien finanzieren sich in Deutschland vor allem durch Mitgliedsbeiträge, Geld vom Staat und Spenden. […] Zuwendungen, die im Jahr 10.000 Euro übersteigen, müssen mit Namen und Anschrift des Spenders sowie der Gesamtsumme im Rechenschaftsbericht verzeichnet werden.“"
                            },
                            {
                                "example_id": "3b19f696-ae4c-4406-bbe2-9ec314fe297b",
                                "sense_id": "cf617765-e2cb-36bd-b1bb-dfe000f56d1e",
                                "text": "„Die AfD hätte Einnahmen aus dem ‚Kyffhäusertreffen‘ in Thüringen in ihrem Rechenschaftsbericht angeben müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
