                                "target_senses": [
                                    {
                                        "sense_id": "ddf07184-6fb7-3652-a8b6-cd948109bc4a",
                                        "entry_id": "241fc77e-4ecb-32c7-8fa7-9c54fd93791b",
                                        "glosses": [
                                            "Qui donne un mouvement de propulsion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94a192b1-ef71-4619-acf4-d4500d8280fb",
                                                "sense_id": "ddf07184-6fb7-3652-a8b6-cd948109bc4a",
                                                "text": "Le but de cette disposition est d'abaisser le plus possible l'arbre coudé, qui est celui de la vis ou organe propulseur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "propulseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34c4cbec-ea09-35c0-8310-4c03d029495b",
                                        "entry_id": "544dab59-24fd-3cb8-b47f-d43f839b87da",
                                        "glosses": [
                                            "Outil, machine, appareil qui en propulse un autre."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44488e06-cb24-453f-9c85-9df6451d44f9",
                                                "sense_id": "34c4cbec-ea09-35c0-8310-4c03d029495b",
                                                "text": "Les navires à vapeur ont pour propulseur des hélices ou des roues à aubes."
                                            },
                                            {
                                                "example_id": "19a1dc17-247a-453e-94ae-3ad53a598c58",
                                                "sense_id": "34c4cbec-ea09-35c0-8310-4c03d029495b",
                                                "text": "Le propulseur Cockerill a été essayé sur une embarcation de formes très-fines, le Seraing, disposé pour un service de passagers: la machine n’a qu’un seul cylindre horizontal placé dans le sens longitudinal du bâtiment; sa bielle est attelée sur un coude de l’arbre vertical de la turbine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49d62d47-49f2-3b35-99f2-c59a5abb3bc5",
                                        "entry_id": "544dab59-24fd-3cb8-b47f-d43f839b87da",
                                        "glosses": [
                                            "Sorte de baguette qui permettait le jet au plus loin d'une lance."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
