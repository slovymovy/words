                "senses": [
                    {
                        "sense_id": "7d733d49-3786-336e-98e6-7f143c88c6af",
                        "entry_id": "67e48619-4bdb-3b9b-8e44-24e0fc140eec",
                        "glosses": [
                            "Piccadilly, a street running from Hyde Park Corner to Piccadilly Circus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1d6fd0-8578-42d6-a04b-c9c3119bb264",
                                "sense_id": "7d733d49-3786-336e-98e6-7f143c88c6af",
                                "text": "Though the Philistines may jostle, you will rank as an apostle in the high aesthetic band -\nIf you walk down Piccadilly with a poppy or a lily in your mediaeval hand."
                            },
                            {
                                "example_id": "b9adcb37-1bfd-4a83-97e5-6696044465f1",
                                "sense_id": "7d733d49-3786-336e-98e6-7f143c88c6af",
                                "text": "Goodbye Piccadilly,\nFarewell Leicester Square -\nIt's a long, long way to Tipperary\nBut my heart's right there."
                            },
                            {
                                "example_id": "98377aa5-e61c-499a-808a-ab99447e6c11",
                                "sense_id": "7d733d49-3786-336e-98e6-7f143c88c6af",
                                "text": "The Inn that I speak of is about the Middle of Piccadilly upon the left hand."
                            }
                        ]
                    },
                    {
                        "sense_id": "afa1ba1f-a2b7-3695-93de-c5c9015d2336",
                        "entry_id": "67e48619-4bdb-3b9b-8e44-24e0fc140eec",
                        "glosses": [
                            "The surrounding area."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7bd7016-ea61-443d-a632-345c4d4d30bb",
                                "sense_id": "afa1ba1f-a2b7-3695-93de-c5c9015d2336",
                                "text": "Valentine Dawes, a Quaker, living in Aier-street in the Piccadilly, being for many years troubled with the Falling-Sickness, was perfectly cured; and thereupon presently became a Roman Catholick."
                            }
                        ]
                    },
                    {
                        "sense_id": "19cf4692-e6eb-329e-bc87-01a656d65989",
                        "entry_id": "67e48619-4bdb-3b9b-8e44-24e0fc140eec",
                        "glosses": [
                            "Manchester Piccadilly station, the main railway station in Manchester."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "60a99bc4-4b8f-3135-b828-72466fc83d6a",
                        "entry_id": "67e48619-4bdb-3b9b-8e44-24e0fc140eec",
                        "glosses": [
                            "The Piccadilly Line of the London Underground, originally known as the Great Northern, Piccadilly and Brompton Railway."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b972ec-bf5e-4031-bd5f-60edb9b33cdc",
                                "sense_id": "60a99bc4-4b8f-3135-b828-72466fc83d6a",
                                "text": "Why Piccadilly? The Piccadilly Line was originally the Great Northern, Piccadilly & Brompton Railway (GNP&BR) which was shortened to Piccadilly in practice. Running under the main road between Piccadilly Circus and Hyde Park Corner, Piccadilly made sense and was also the most well-known location in the original company name."
                            }
                        ]
