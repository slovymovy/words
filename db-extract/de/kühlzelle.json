                "senses": [
                    {
                        "sense_id": "9f35b55f-bdb7-3878-8346-a8793d253908",
                        "entry_id": "5085e99f-669e-37e3-9099-d1662f89ed24",
                        "glosses": [
                            "abgeteilter, gut isolierter Raum mit Zugangstür und Kühltechnik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00cd5627-fb16-4c62-88e1-7450351b004f",
                                "sense_id": "9f35b55f-bdb7-3878-8346-a8793d253908",
                                "text": "„Für eine reibungslose Nutzung im Klinikbetrieb werden die Kühlzellen den örtlichen Gegebenheiten angepasst.“"
                            },
                            {
                                "example_id": "c70e68f5-1d20-4ece-a58c-c065477f9099",
                                "sense_id": "9f35b55f-bdb7-3878-8346-a8793d253908",
                                "text": "„Kühlzellen sind die wirtschaftliche Antwort auf das steigende Bevorratungs- und Gesundheitsbewusstsein im gewerblichen und privaten Bereich.“"
                            },
                            {
                                "example_id": "dcd134a1-a3d0-4448-a544-2b2b762327cb",
                                "sense_id": "9f35b55f-bdb7-3878-8346-a8793d253908",
                                "text": "„Unsere in verschiedenen Dämmstärken (75, 80, 100 oder 120 mm) lieferbaren und modular aufgebauten Kühlzellen können im Bereich der Pluskühlung als auch der Tiefkühlung eingesetzt werden.“"
                            },
                            {
                                "example_id": "caad4325-b9a8-47c7-bab2-e6800b080885",
                                "sense_id": "9f35b55f-bdb7-3878-8346-a8793d253908",
                                "text": "„Druckausgleichsventil und Türrahmenheizung sind bei allen PU100 Kühlzellen serienmäßig im Lieferumfang enthalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
