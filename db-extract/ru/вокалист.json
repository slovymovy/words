                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d4695af-bc5f-431b-962e-5f726e077c18",
                        "source_entry_id": "eca3a190-b299-3078-a9bf-3524c248d2c7",
                        "target_lang_word": "choriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "choriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                        "entry_id": "108689c5-d3ee-356d-ba77-487cdf58a908",
                                        "glosses": [
                                            "Chantre du chœur dans une église, chanteur dans une chorale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9823021-f286-4e3a-96da-367fa865a02b",
                                                "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                                "text": "Les heures comprennent surtout des psaumes et elles sont chantées au chœur dans le texte latin. Les choristes de l'Hôtel-Dieu de Québec se rendaient donc plusieurs fois par jour au chœur pour psalmodier."
                                            },
                                            {
                                                "example_id": "e4fc7b27-805d-40bf-aef4-90eb318496e8",
                                                "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                                "text": "J’étais heureux pour Martine, petite choriste anonyme, dont personne ne connaîtrait jamais le nom, mais pourtant saluée chaque soir, applaudie, pour la portion de poésie qu’elle avait apportée à l’œuvre."
                                            },
                                            {
                                                "example_id": "7e5b1491-ccbe-4189-9926-33df52e284f2",
                                                "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                                "text": "La maison de production fournissait les choristes et les musiciens, suggérait fortement les chansons, déterminait les arrangements, et quelques choubidous plus tard, Françoise Deldick, Agnès Loti, Michèle et ses Wouaps sortaient de l'ombre."
                                            },
                                            {
                                                "example_id": "3386e23d-daad-4487-b71e-a961f4016076",
                                                "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                                "text": "Le moindre choriste dans un chœur chantant une Passion de Bach m'a toujours semblé pouvoir aller plus loin que moi dans mon travail de savant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f44eb99-8da7-492d-b6f9-5eaa9b30a107",
                        "source_entry_id": "eca3a190-b299-3078-a9bf-3524c248d2c7",
                        "target_lang_word": "chanteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chanteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b92c0666-54b8-3482-b06e-d5e0cf9f7907",
                                        "entry_id": "7b1f19e2-4e3d-36e8-bbbc-d55311dd4a2e",
                                        "glosses": [
                                            "Personne qui chante, qui module sa voix pour produire de la musique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "095467a7-3e80-3970-b14f-2591fcdf018e",
                                        "entry_id": "7b1f19e2-4e3d-36e8-bbbc-d55311dd4a2e",
                                        "glosses": [
                                            "Personne qui fait métier de chanter."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b7f4841-d216-4c97-8e0f-6cda68cb5684",
                                                "sense_id": "095467a7-3e80-3970-b14f-2591fcdf018e",
                                                "text": "Appartenant à la grande confrérie des conteurs et chanteurs errants, ce troubadour marocain ne possède pour toute fortune qu’un âne famélique, un vieux haïk en lambeaux, une pipe et une blague à kif et un petit instrument primitif à deux cordes, un gimbri, attribut de son état."
                                            },
                                            {
                                                "example_id": "5e43e7db-7f09-4456-ab55-cfbdb66ca235",
                                                "sense_id": "095467a7-3e80-3970-b14f-2591fcdf018e",
                                                "text": "Tu n’as pas une vilaine voix et la mienne est très bien. De tous les chanteurs de plages que j’ai entendus, il n’y en a pas un seul que je n’aurais dégoté facilement."
                                            },
                                            {
                                                "example_id": "db4b8ca5-baee-4a9b-9e75-acbe23cf298f",
                                                "sense_id": "095467a7-3e80-3970-b14f-2591fcdf018e",
                                                "text": "Les chanteurs sont supérieurs à ceux du même ordre entendus à Paris."
                                            },
                                            {
                                                "example_id": "898b505d-12a0-42dd-964e-5705ff92fab1",
                                                "sense_id": "095467a7-3e80-3970-b14f-2591fcdf018e",
                                                "text": "Le chanteur des rues qui brame :\n« À vot’bon cœur, messieurs-dames »\nParis sera toujours Paname\nEt tout ça ne vaut pas l’amour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bfc918f-805a-3745-b3bc-210c483c9e95",
                                        "entry_id": "7b1f19e2-4e3d-36e8-bbbc-d55311dd4a2e",
                                        "glosses": [
                                            "Maître-chanteur."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62e5bfd5-9b22-4609-a2ec-a7f85fa09395",
                                                "sense_id": "9bfc918f-805a-3745-b3bc-210c483c9e95",
                                                "text": "Et l’allusion aux dix ans qui allaient expirer avant la fin de 1870 était assez claire. Aux termes du Code, l’action criminelle se prescrit par dix ans. L’heure de la prescription approchait et le chanteur n’avait plus que huit mois pour exploiter le coupable qui n’aurait plus rien à redouter quand le temps fixé par la loi serait écoulé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chanteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23a6e6be-c4c9-312d-91ee-8a4a12fd362e",
                                        "entry_id": "797f3680-c9d1-32c1-9fe5-b3fb6466b3f5",
                                        "glosses": [
                                            "Qui chante, qui produit du son harmonieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63638a3d-c61b-44ce-8952-113c3f1b3526",
                                                "sense_id": "23a6e6be-c4c9-312d-91ee-8a4a12fd362e",
                                                "text": "Les oiseaux chanteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aa49a42-6cc6-3399-aaf0-863e63783579",
                                        "entry_id": "797f3680-c9d1-32c1-9fe5-b3fb6466b3f5",
                                        "glosses": [
                                            "Dont le son évoque une mélodie."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "468562f0-9db6-4849-a739-d9ee759b04a2",
                                                "sense_id": "1aa49a42-6cc6-3399-aaf0-863e63783579",
                                                "text": "Ces champs ne sont-ils pas à moi, et ces bois chanteurs, et ce ciel que raye continuellement le vol fantaisiste des martinets ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
