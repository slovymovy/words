                        "entry_id": "dfbfabae-b767-3cc6-83d3-8137f262d881",
                        "glosses": [
                            "Entente ou groupement de personnes ou d’entités en vue d’une action, politique ou économique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d76f3160-3404-4b8e-aaf8-8e76e85d2f4d",
                                "sense_id": "8d5d4feb-9b60-32c9-bcf7-9ed1c9e6d1a7",
                                "text": "Le cartel des Gauches."
                            }
                        ]
                    },
                    {
                        "sense_id": "75d2b698-c73b-3861-aa30-da928a8d3d6c",
                        "entry_id": "dfbfabae-b767-3cc6-83d3-8137f262d881",
                        "glosses": [
                            "Entente d’un groupe d’industrie en vue de fausser la concurrence et fixer les prix sur les marchés."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "02961fc5-2442-3171-bd5f-d22d9edc55dc",
                        "entry_id": "dfbfabae-b767-3cc6-83d3-8137f262d881",
                        "glosses": [
                            "Association de malfaiteurs, surtout dans le cadre du trafic de drogue en Amérique du sud et Amérique centrale."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b811e82-e376-4308-b0ff-0ca2b5e87db5",
                        "source_entry_id": "dfbfabae-b767-3cc6-83d3-8137f262d881",
                        "source_sense_id": "75d2b698-c73b-3861-aa30-da928a8d3d6c",
                        "source_sense_description": "(Économie) Entente d’un groupe d’industrie en vue de fausser la concurrence et fixer les prix sur les marchés.",
                        "target_lang_word": "Kartell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kartell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3fff269a-b5e1-3b52-8ad3-2f1d626ae9ea",
                                        "entry_id": "429d17f5-a9e9-355a-afdd-f4f09edb5079",
                                        "glosses": [
                                            "verbotene Vereinbarungen zwischen Unternehmern, Beschlüsse von Unternehmervereinigungen und aufeinander abgestimmte Verhaltensweisen, die eine Verhinderung, Einschränkung oder Verfälschung des Wettbewerbs bezwecken oder bewirken"
                                        ],
                                        "tags": [
                                            "Kriminalität",
                                            "gemäß Legaldefinition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0cd6515-0044-4d46-8670-9f84899b6edb",
                                                "sense_id": "3fff269a-b5e1-3b52-8ad3-2f1d626ae9ea",
                                                "text": "„Weil Kartelle verboten waren, blieben zur Eindämmung oder gar Ausschaltung von Wettbewerb nur noch Zusammenschlüsse. Eine regelrechte Fusionswelle setzte ein: Zwischen 1894 und 1904 wurden laut Walter Licht 131 Fusionen gezählt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3a52aad5-7402-3181-818e-b1925bc3e80d",
                                        "entry_id": "429d17f5-a9e9-355a-afdd-f4f09edb5079",
                                        "glosses": [
                                            "Gruppe von Akteuren, die illegale Absprachen treffen, die kriminelle Ziele verfolgen"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d87c9039-d785-48d9-b0b2-c7e2845d815d",
                                                "sense_id": "3a52aad5-7402-3181-818e-b1925bc3e80d",
                                                "text": "„Oft genug wollen die Kartelle nur ihre Macht demonstrieren oder Territorien annektieren, um Waffen und Drogen für den Grenzschmuggel zu lagern.“"
                                            },
                                            {
                                                "example_id": "eedb9308-2b2e-43ab-a35e-2bb217fb14a8",
                                                "sense_id": "3a52aad5-7402-3181-818e-b1925bc3e80d",
                                                "text": "„Ein Kartell, das uns erst verunsichert und sofort scheinbare Lösungen zur Hand hat. Gegen diese Profiteure der Angst setzen […] den gesunden Menschenverstand und faktenreiche Hintergrundrecherchen.“"
                                            },
                                            {
                                                "example_id": "205fe6d7-c717-4c8d-b461-436fa88116e9",
                                                "sense_id": "3a52aad5-7402-3181-818e-b1925bc3e80d",
                                                "text": "„Ich vermute, dass er die Kleinen zu sich nehmen will, um sie in sein Kartell einzuführen.“"
                                            },
                                            {
                                                "example_id": "35d71340-02cf-4cab-b4af-72342df8af07",
                                                "sense_id": "3a52aad5-7402-3181-818e-b1925bc3e80d",
                                                "text": "„Allein in Medellin unterhält das Kartell etwa 800 meist jugendliche Killer, die in 130 Banden organisiert sind.“"
