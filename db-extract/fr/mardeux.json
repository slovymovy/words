                        "entry_id": "ef3a4e4d-5808-3872-b312-4fd3505b90ee",
                        "glosses": [
                            "Personne chanceuse."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "0afe29ae-4e2e-4a94-b40a-9f7f9e3a41d3",
                                "sense_id": "4b6be8a5-0a70-34ef-85c1-14112cf37f75",
                                "text": "T’es rien qu’un mardeux, t’as pas de talent, juste de la chance !"
                            },
                            {
                                "example_id": "dc5fb8d6-1268-4648-a52f-a9a9a3d9bbff",
                                "sense_id": "4b6be8a5-0a70-34ef-85c1-14112cf37f75",
                                "text": "Espèce de gros plein de marde! (signifie qu’une personne est très chanceuse)"
                            }
                        ]
                    },
                    {
                        "sense_id": "aefacbaa-8748-3590-acec-f538bb16bc95",
                        "entry_id": "ef3a4e4d-5808-3872-b312-4fd3505b90ee",
                        "glosses": [
                            "Merdeux, hypocrite, poltron, peureux."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "35862b6d-b223-47fe-b0c4-05f0892354d2",
                                "sense_id": "aefacbaa-8748-3590-acec-f538bb16bc95",
                                "text": "Quand les visiteurs sont enfin partis, il se replonge dans son journal en murmurant :\n– Tas de petits politicailleux ! Bande de petits mardeux !"
                            }
                        ]
                    },
                    {
                        "sense_id": "d0a1e9f3-6923-381c-bff1-3d741f8944ca",
                        "entry_id": "ef3a4e4d-5808-3872-b312-4fd3505b90ee",
                        "glosses": [
                            "(théâtre) Habitué des représentations classiques du mardi à la Comédie-Française."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5c0ae870-6010-4b16-8aba-03b92dd6f708",
                                "sense_id": "d0a1e9f3-6923-381c-bff1-3d741f8944ca",
                                "text": "Surtout le public des abonnés du Français, les abonnés du mardi, ceux que de Max appelaient^([sic]) dédaigneusement, mais avec tant d’esprit, les mardeux."
                            }
                        ]
                    }
