                        "examples": [
                            {
                                "example_id": "2ead1097-be46-4140-aa36-5b3d3a1817cb",
                                "sense_id": "b492d621-c13b-3749-a38c-e9c47dc1acc6",
                                "text": "Ich ziehe das Pferd und das Kamel den Posten und Bahnen, das Kanoe dem Steamer und die Büchse dem wohl visierten Passe vor; auch reise ich lieber nach Timbuktu oder Tobolsk als nach Nizza oder Helgoland; ich verlasse mich auf keinen Dolmetscher und auf keinen Bädeker; […]"
                            }
                        ]
