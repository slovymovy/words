                                                "sense_id": "aea7c418-6ba5-36f0-ac0f-e0d65ff0ddfa",
                                                "text": "Das Unternehmen führte einen Wettbewerb unter dem Motto »ich verschönere meinen Arbeitsplatz« durch."
                                            },
                                            {
                                                "example_id": "d3c861aa-ce0d-48b6-a7e1-bf0314a82296",
                                                "sense_id": "aea7c418-6ba5-36f0-ac0f-e0d65ff0ddfa",
                                                "text": "Nehmen sie sich ein Wochenende Zeit und verschönern Sie Ihr Heim!"
                                            },
                                            {
                                                "example_id": "9af586da-cb65-4909-b645-89341375fe23",
                                                "sense_id": "aea7c418-6ba5-36f0-ac0f-e0d65ff0ddfa",
                                                "text": "Sie versuchte alles, um ihre bescheidene Existenz zu verschönern."
                                            }
