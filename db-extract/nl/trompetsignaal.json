                        "sense_id": "257d3b36-be17-30ac-be7a-f10f072f6a4e",
                        "entry_id": "468c5b03-4dfb-3ad4-8682-e72b50c68675",
                        "glosses": [
                            "een afgesproken teken afgegeven door een trompet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a1bb3b7-004a-4d36-9b5a-a8294100b86d",
                                "sense_id": "257d3b36-be17-30ac-be7a-f10f072f6a4e",
                                "text": "Een trompetsignaal weerklonk en op de vier hoeken van het strijdperk werd omgeroepen dat niemand mocht praten, hoesten of tekens geven op straffe des doods, waarvoor buiten het strijdperk drie galgen opgericht waren."
                            },
                            {
                                "example_id": "79089175-632c-4866-bd96-711a0d02d7b2",
                                "sense_id": "257d3b36-be17-30ac-be7a-f10f072f6a4e",
                                "text": "De organisatie roept mensen nadrukkelijk op om de herdenking thuis te volgen via televisie of internet en vooral niet naar de Dam te komen. De Dodenherdenking begint zoals ieder jaar met het trompetsignaal taptoe, om 19.58 uur. Het Nationaal Comité roept alle mensen met een blaasinstrument op om het signaal vanuit huis mee te spelen. Na twee minuten stilte zal het volkslied klinken; het is de bedoeling dat mensen dat thuis ook meezingen."
                            }
                        ]
                    }
