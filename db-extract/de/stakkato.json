                ],
                "senses": [
                    {
                        "sense_id": "59ded886-086e-3e6b-be45-1e0d8ceb54c8",
                        "entry_id": "cc7582e4-cb40-33c9-b7ef-7b33d661bcb4",
                        "glosses": [
                            "Abfolge kurzer, abgehackter Geräusche/Töne"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "b18517de-fa10-4eff-bb6a-bfe2ad73e6df",
                                "sense_id": "59ded886-086e-3e6b-be45-1e0d8ceb54c8",
                                "text": "„Trommelschläge dröhnen durch die Nacht, seit Stunden schon, ein stampfendes Stakkato, der Klang eines angekündigten Krieges.“"
                            },
                            {
                                "example_id": "dd09b737-e46d-4a22-9378-9d259ca27dda",
                                "sense_id": "59ded886-086e-3e6b-be45-1e0d8ceb54c8",
                                "text": "„Nur gelegentlich übertönt das Stakkato von Flugzeugmotoren die Feier: Äthiopische Tiefflieger kreisen über der Kathedrale, zu Ehren des größten Flugzeugfans des Landes.“"
                            },
                            {
                                "example_id": "d8ddc32b-de3d-444a-905d-5d611c353020",
                                "sense_id": "59ded886-086e-3e6b-be45-1e0d8ceb54c8",
                                "text": "„Er steigerte sich in ein monotones Stakkato hinein.“"
                            },
                            {
                                "example_id": "345eb10f-acbc-4e03-b12c-82ae5a5b03fd",
                                "sense_id": "59ded886-086e-3e6b-be45-1e0d8ceb54c8",
                                "text": "„Tag und Nacht donnerten Kampfflugzeuge über das Dorf hinweg, und das Stakkato der Artillerie hallte über die Hügel und schien von allen Seiten zu kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
