                "senses": [
                    {
                        "sense_id": "bc412dad-1581-3c2c-9cdc-5f246bc28bd2",
                        "entry_id": "355cf1d3-0b4a-3629-9f90-6f5a440eb7b6",
                        "glosses": [
                            "to fall, to pour, to run out"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4f01271-3a43-463c-9c6f-6826d213d88b",
                                "sense_id": "bc412dad-1581-3c2c-9cdc-5f246bc28bd2",
                                "text": "штукату́рка сы́плется",
                                "translation": "the plaster flakes off",
                                "english": "the plaster flakes off"
                            },
                            {
                                "example_id": "23dcf9ce-991d-4d7b-8fe9-083a5394ddb5",
                                "sense_id": "bc412dad-1581-3c2c-9cdc-5f246bc28bd2",
                                "text": "И́з-за шу́ма вы́звали менто́в\nОни́ сказа́ли, что нехорошо́\nЧто штукату́рка сы́пется со стен\nИ никому́ не ве́село совсе́м"
                            }
                        ]
                    },
                    {
                        "sense_id": "110f575a-a6f9-38d7-aceb-a4437067a9da",
                        "entry_id": "355cf1d3-0b4a-3629-9f90-6f5a440eb7b6",
                        "glosses": [
                            "to rain down, to pour forth"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9d794e5-6788-4e24-bc75-8e32ec5bc4a8",
                                "sense_id": "110f575a-a6f9-38d7-aceb-a4437067a9da",
                                "text": "сы́паться гра́дом",
                                "translation": "to hail (precipitation), (figuratively) to rain down",
                                "english": "to hail (precipitation), (figuratively) to rain down"
                            }
                        ]
                    },
                    {
                        "sense_id": "397ba760-987a-39fa-b4aa-4e50d601defb",
                        "entry_id": "355cf1d3-0b4a-3629-9f90-6f5a440eb7b6",
                        "glosses": [
                            "to fall thick and fast"
                        ],
                        "tags": [],
                        "examples": [
                            {
