                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3d2604e-64be-48ff-afe1-28ce38ba1627",
                        "source_entry_id": "33dcf9fc-9627-3d0a-b669-e5a9e1cbf43f",
                        "source_sense_id": "a4f4c842-5d15-3f4a-a5c1-d13131a8217d",
                        "target_lang_word": "millilitre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "millilitre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd9be76-9c21-3179-943c-c1877765d0b8",
                                        "entry_id": "383f472b-e60a-3624-b941-22ba3c8af5a9",
                                        "glosses": [
                                            "A unit of measure of capacity, equal to one thousandth of a litre. Symbol: mL or ml."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34860cf6-312d-424f-af51-878d369ed4c4",
                                                "sense_id": "4dd9be76-9c21-3179-943c-c1877765d0b8",
                                                "text": "Holonyms: litre < kilolitre < megalitre < gigalitre"
                                            },
                                            {
                                                "example_id": "f83c0881-93a0-4534-b490-b5c2316a84b4",
                                                "sense_id": "4dd9be76-9c21-3179-943c-c1877765d0b8",
                                                "text": "Meronyms: picolitre < nanolitre < microlitre"
                                            },
                                            {
                                                "example_id": "14203f9e-4934-4e55-aea2-3268a54c4df7",
                                                "sense_id": "4dd9be76-9c21-3179-943c-c1877765d0b8",
                                                "text": "A smaller mammal such as a dog has a sperm concentration of 300 000 000 per millilitre in an ejaculate of 8 ml in volume. Thus, each ejaculate will contain only 2 400 000 000 (24 × 10⁸)."
                                            },
                                            {
                                                "example_id": "49a5c039-916e-4a94-97fe-f61e593cb3ca",
                                                "sense_id": "4dd9be76-9c21-3179-943c-c1877765d0b8",
                                                "text": "One serve of carbohydrates is approximately equal to a slice of bread, a piece of fruit, third of a cup of cooked rice, half a cup of grains, cereals, starchy vegetables or cooked pasta, 200 grams of plain yoghurt, or 300 millilitres of milk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
