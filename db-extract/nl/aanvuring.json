                        "sense_id": "69f7161e-e09a-3ad4-a770-afe5748f7bd6",
                        "entry_id": "78c76c03-305a-3ebd-8a4b-08b3363c6cbb",
                        "glosses": [
                            "de keer dat men iemand stimuleert om iets goeds te doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec4b1b2d-3bdd-4405-9de3-c0ac4626aa46",
                                "sense_id": "69f7161e-e09a-3ad4-a770-afe5748f7bd6",
                                "text": "Op het plein onder de prachtige Zuid-Amerikaanse boom Le Bel Ombra is het wel druk. maar dat komt omdat er onder aanvuring van de plaatselijke deejay door het vrouwelijk schoon van Porto Vecchio massaal een dans wordt uitgevoerd."
                            },
                            {
                                "example_id": "d04038ad-f877-4dad-9553-0e3a959eb24e",
                                "sense_id": "69f7161e-e09a-3ad4-a770-afe5748f7bd6",
                                "text": "Door consequent te investeren in de stad is enorme vooruitgang geboekt. Samen met liberalen en confessionelen, maar ideologisch onder aanvuring van de sociaaldemocratie."
                            }
                        ]
                    }
