            },
            {
                "entry_id": "0a7a9f8b-2442-3195-b85f-06d0c18f63fc",
                "word": "atomy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e90d553a-63a9-4527-b993-159ac4ddb354",
                        "entry_id": "0a7a9f8b-2442-3195-b85f-06d0c18f63fc",
                        "tags": [
                            "plural"
                        ],
                        "form": "atomies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7460960-3848-3d02-8cd5-b5507e28a4e7",
                        "entry_id": "0a7a9f8b-2442-3195-b85f-06d0c18f63fc",
                        "glosses": [
                            "A skeleton."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "34abb22e-f2a8-42f6-ad54-df77e8d50700",
                                "sense_id": "a7460960-3848-3d02-8cd5-b5507e28a4e7",
                                "text": "Hostess Quickly. Ay, come, you starv’d bloodhound.\nDoll Tearsheet. Goodman death, goodman bones!\nHostess Quickly. Thou atomy, thou!\nDoll Tearsheet. Come, you thin thing! come, you rascal!"
                            },
                            {
                                "example_id": "decf51c6-04f8-45b5-854a-4d743f538c20",
                                "sense_id": "a7460960-3848-3d02-8cd5-b5507e28a4e7",
                                "text": "1728, John Gay, The Beggar’s Opera, Dublin: George Risk et al., Act II, Scene 1, p. 67,\nI could not save him from those fleaing Rascals the Surgeons; and now, poor Man, he is among the Otamys [sic] at Surgeon's Hall."
                            },
                            {
                                "example_id": "b5123a23-3eea-4df2-908c-d4c11b440ab3",
                                "sense_id": "a7460960-3848-3d02-8cd5-b5507e28a4e7",
                                "text": "I was now thrown into a violent perturbation of spirit; for I never could behold an atomy without fear and trembling, even when I knew it was no more than a composition of dry bones;"
                            },
                            {
                                "example_id": "746fb8fd-fd63-4fae-854d-714a9d02f49c",
                                "sense_id": "a7460960-3848-3d02-8cd5-b5507e28a4e7",
                                "text": "[…] a bedstead with four bare atomies of posts, each terminating in a spike, as if for the dismal accommodation of lodgers who might prefer to impale themselves."
                            },
                            {
                                "example_id": "1522c8be-a9ae-4caa-acea-5ce0f3960ff8",
                                "sense_id": "a7460960-3848-3d02-8cd5-b5507e28a4e7",
                                "text": "The veriest atomy he looked,\nWith grimy fingers clutching and crooked,\nTight skin, a nose all bony and hooked,\nAnd a shaking, sharp, suspicious way;"
                            }
                        ]
                    }
                ],
