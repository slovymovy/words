                "senses": [
                    {
                        "sense_id": "613a0356-68ff-3173-a547-83bd66983295",
                        "entry_id": "482b9fa4-9851-3335-8fb0-e72bc948c45d",
                        "glosses": [
                            "Donner un caractère néo-libéral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea009a85-2110-4a0d-8895-5339891073c8",
                                "sense_id": "613a0356-68ff-3173-a547-83bd66983295",
                                "text": "Néo-libéraliser l'espace, néo-libéraliser les corps : gouverner la mobilité dans la société de contrôle urbaine"
                            },
                            {
                                "example_id": "28b9b5a8-8751-488b-89ae-e6891b9f3f4f",
                                "sense_id": "613a0356-68ff-3173-a547-83bd66983295",
                                "text": "On peut se demander à l’inverse, s’il ne s’agit pas encore d’un miroir aux alouettes pour séduire les « pédagogues » et contribuer à néo-libéraliser le « marché scolaire »."
                            },
                            {
                                "example_id": "5cce7469-dfcc-4ee9-af98-60b6e42fe43a",
                                "sense_id": "613a0356-68ff-3173-a547-83bd66983295",
                                "text": "Or, socialo-gréviste irresponsable longtemps entraîné dans les camps d'éducation populaire de la Corée du Nord, un entraînement complété à Cuba par la formation d'excellence internationale aux opérations commando, le corps professoral de souche ne se laisse pas aisément néo-libéraliser."
                            }
                        ]
                    }
