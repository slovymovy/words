                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3ab6715-1e2c-4bff-8679-e7e507a944d4",
                                "sense_id": "3d21cbaa-f02d-3d6c-a72d-56f39a0b6ffa",
                                "text": "„Die Aussichten bleiben schwach, die Quartalsdividende wird um gut ein Drittel gekürzt.“"
                            },
                            {
                                "example_id": "1740a3d7-9609-4b30-82f4-eabde620b9e4",
                                "sense_id": "3d21cbaa-f02d-3d6c-a72d-56f39a0b6ffa",
                                "text": "„Der amerikanische Industriekonzern General Electric kündigte am Montag an einer Investorenkonferenz in New York an, die Quartalsdividende auf 12 Cent je Aktie zu halbieren.“"
                            },
                            {
                                "example_id": "183ffc25-2cf4-4e7e-8c83-b46e6d0fb65a",
                                "sense_id": "3d21cbaa-f02d-3d6c-a72d-56f39a0b6ffa",
                                "text": "„Die Quartalsdividende wird auf 12,5 US-Cent pro Aktie von zuvor 36,5 Cent gesenkt, wie Intel mitteilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
