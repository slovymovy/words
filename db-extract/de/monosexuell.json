                ],
                "senses": [
                    {
                        "sense_id": "810cf8e3-2fc4-3cca-b8af-04e9fb44e295",
                        "entry_id": "f5074699-60d3-3129-9dec-62dcc074fbe3",
                        "glosses": [
                            "sexuelle Neigung zu ausschließlich einem Geschlecht habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff740299-2ab7-49d3-9ba2-bcc2b39c9f54",
                                "sense_id": "810cf8e3-2fc4-3cca-b8af-04e9fb44e295",
                                "text": "„Weitere sexuelle Identitäten sind heteroflexibel (im Wesentlichen heterosexuell mit kleinem homosexuellen Anteil), homoflexibel (im Wesentlichen homosexuell mit kleinem heterosexuellen Anteil), fließend (kaine statische sexuelle Orientierung), queer (von der Heteronormativität abweichende Lebensweise) und nicht monosexuell (ein Oberbegriff für alle, die nicht heterosexuell oder homosexuell sind).“"
                            },
                            {
                                "example_id": "4cfa3ef4-9ae0-4b7d-a527-3d21be603cbb",
                                "sense_id": "810cf8e3-2fc4-3cca-b8af-04e9fb44e295",
                                "text": "„Wenn man sich als ‚homosexuell‘ oder ‚heterosexuell‘ definiert, dann definiert man sich als ‚monosexuell‘, wie John Money es genannt hat.“"
                            },
                            {
                                "example_id": "4f122d69-0535-4e67-8e88-a94d400d79b3",
                                "sense_id": "810cf8e3-2fc4-3cca-b8af-04e9fb44e295",
                                "text": "„Wir haben bisher gezeigt, dass wir uns mit dem Thema der Geschlechtlichkeit erstens auf den Aspekt der biologischen Ausstattung beziehen, der keinesfalls so statisch monosexuell zu verstehen ist, sondern bisexuelle Aspekte einschließt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "14679465-9db2-4cde-9958-5f18cecc625a",
