                "senses": [
                    {
                        "sense_id": "585e9a0c-0f00-37bd-aa20-1018ae4e7903",
                        "entry_id": "a6aa314e-0a02-315e-9513-1f0b2ef8cd3e",
                        "glosses": [
                            "plek waar auto's of andere voertuigen geparkeerd kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5abb1698-aa48-4adb-b3f0-c2e19cc5c5eb",
                                "sense_id": "585e9a0c-0f00-37bd-aa20-1018ae4e7903",
                                "text": "We stoppen op een parkeerplaats aan de snelweg om even te rusten."
                            },
                            {
                                "example_id": "11c37e32-2d0b-4eb5-ba4e-949663b46d80",
                                "sense_id": "585e9a0c-0f00-37bd-aa20-1018ae4e7903",
                                "text": "Op de parkeerplaats ter grootte van een voetbalveld staat een handjevol vrachtwagens."
                            },
                            {
                                "example_id": "cbdced8e-4fd3-4672-abf2-95efce873c3b",
                                "sense_id": "585e9a0c-0f00-37bd-aa20-1018ae4e7903",
                                "text": "Nooit eerder rende ik zó hard over een parkeerplaats naar een McDonald’s toen ik er eindelijk was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efec5ff0-da2a-4501-84be-f9f7b95c4c08",
                        "source_entry_id": "a6aa314e-0a02-315e-9513-1f0b2ef8cd3e",
                        "source_sense_id": "585e9a0c-0f00-37bd-aa20-1018ae4e7903",
                        "source_sense_description": "plek waar auto's of andere voertuigen geparkeerd kunnen worden",
                        "target_lang_word": "Parklücke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parklücke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c158f01c-6812-3d57-ad2d-3c48f68b473a",
                                        "entry_id": "f54896c8-fef2-3880-8e0d-8fa515f205f2",
                                        "glosses": [
                                            "freie Fläche zwischen zwei Dingen (meist Fahrzeugen), wo man sein Fahrzeug abstellen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0aadc80-0c9a-4f90-8013-42592ccbe78f",
                                                "sense_id": "c158f01c-6812-3d57-ad2d-3c48f68b473a",
                                                "text": "„Auf dem Rückweg lockt mich eine Parklücke vor Meyer Beck.“"
                                            },
                                            {
                                                "example_id": "5e3b1778-daf1-44d6-9445-42d302eaf399",
                                                "sense_id": "c158f01c-6812-3d57-ad2d-3c48f68b473a",
                                                "text": "Mit einem Kleinstwagen passt man so gut wie in jede Parklücke."
                                            },
                                            {
                                                "example_id": "3256553a-38ea-46bc-9f7e-dbc96e84cd2c",
                                                "sense_id": "c158f01c-6812-3d57-ad2d-3c48f68b473a",
                                                "text": "Wenn man Pech hat, ist dort, wo man sein Auto am letzten Tag abgestellt hat, am Morgen nur noch eine leere Parklücke."
                                            },
                                            {
                                                "example_id": "41f35d3b-2fb5-49d7-8d75-cb4c7c8d2aa9",
                                                "sense_id": "c158f01c-6812-3d57-ad2d-3c48f68b473a",
                                                "text": "„Nur eine Frau blickt von der blauen Bank bei der Haltestelle herüber, als Eos ihren Wagen rückwärts in eine Parklücke setzt und den Motor abstellt.“"
                                            },
                                            {
                                                "example_id": "300c7198-0b1f-457c-b7f0-8d7326b44489",
                                                "sense_id": "c158f01c-6812-3d57-ad2d-3c48f68b473a",
                                                "text": "„Mehr als eine Stunde später sah Sung, der auf der Straße gerade einen Lieferanten in eine Parklücke dirigierte, die Lehrerin den Laden verlassen.“"
                                            },
                                            {
                                                "example_id": "2f16c49b-9106-4590-8db4-a77d7ff7a3ca",
                                                "sense_id": "c158f01c-6812-3d57-ad2d-3c48f68b473a",
                                                "text": "„Mit wilder Entschlossenheit stößt er rückwärts in eine Parklücke.“"
                                            },
                                            {
                                                "example_id": "0234c8ed-f263-481c-8c94-8f6018536115",
                                                "sense_id": "c158f01c-6812-3d57-ad2d-3c48f68b473a",
                                                "text": "„Dann legte er den Gang ein, stieß rückwärts aus der Parklücke und fuhr auf den Highway hinaus in Richtung Stadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e10e4c4b-9270-418d-a8d2-fe9a1ac91708",
                        "source_entry_id": "a6aa314e-0a02-315e-9513-1f0b2ef8cd3e",
                        "source_sense_id": "585e9a0c-0f00-37bd-aa20-1018ae4e7903",
                        "source_sense_description": "plek waar auto's of andere voertuigen geparkeerd kunnen worden",
                        "target_lang_word": "Parkplatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parkplatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1704aec-8663-3b99-ac46-b8ce142d220b",
                                        "entry_id": "fa6323c1-912d-3e9f-b86b-0150e6366c9b",
                                        "glosses": [
                                            "Fläche auf öffentlichem oder privatem Grund zum Abstellen von Fahrzeugen über die Dauer eines Haltevorgangs hinaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "725cec3f-2b16-49b5-8fe4-069056c8c3e7",
                                                "sense_id": "c1704aec-8663-3b99-ac46-b8ce142d220b",
                                                "text": "Fahren Sie auf den Parkplatz dort rechts!"
                                            },
                                            {
                                                "example_id": "00c97046-cc7d-4031-86dc-b8339a7942ee",
                                                "sense_id": "c1704aec-8663-3b99-ac46-b8ce142d220b",
                                                "text": "„Er bog auf den kleinen Parkplatz vor dem winzigen Rathaus ein.“"
                                            },
                                            {
                                                "example_id": "a512f957-e4aa-4cad-89f3-f55fcf64c584",
                                                "sense_id": "c1704aec-8663-3b99-ac46-b8ce142d220b",
                                                "text": "„Auf dem Parkplatz steht ihr Wagen nicht mehr allein.“"
                                            },
                                            {
                                                "example_id": "3b21eb49-7a98-4836-8af2-d449386ff9fa",
                                                "sense_id": "c1704aec-8663-3b99-ac46-b8ce142d220b",
                                                "text": "„Das von außen nicht gerade einladend wirkende Hotel ist in einem schwarz getünchten Flachbau neben dem Parkplatz des Flughafens zu finden.“"
                                            },
                                            {
                                                "example_id": "d203e7cd-28f5-4b0b-93ce-ad4ae629b773",
                                                "sense_id": "c1704aec-8663-3b99-ac46-b8ce142d220b",
                                                "text": "„In Teguise fand ich einen Parkplatz ganz in der Nähe des Marktes und setzte mich gleich ins erste Straßencafé; Rudi ließ ich allein zwischen den Marktständen schlendern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "55303aee-820f-3dd9-bbce-aee100b88c31",
                                        "entry_id": "fa6323c1-912d-3e9f-b86b-0150e6366c9b",
                                        "glosses": [
                                            "Platz zum Parken von Fahrzeugen"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "472a510b-45ab-4931-96b7-42217a7d16ce",
                                                "sense_id": "55303aee-820f-3dd9-bbce-aee100b88c31",
                                                "text": "Der Parkplatz in der Innenstadt ist sehr knapp geworden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "be77c4b5-9154-3238-bf4b-cd251d4c20dc",
                                        "entry_id": "fa6323c1-912d-3e9f-b86b-0150e6366c9b",
                                        "glosses": [
                                            "individueller Stellplatz auf einem Parkplatz^([1]) oder in einem Parkhaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29911749-b0c8-4e9e-af6d-7900067fded8",
                                                "sense_id": "be77c4b5-9154-3238-bf4b-cd251d4c20dc",
                                                "text": "Auf dem Parkplatz, auf dem sie ihr Auto sonst meist abstellte, stand ein Motorrad."
                                            },
                                            {
                                                "example_id": "23ffc545-e52a-48e4-b85d-49e41d2d7f50",
                                                "sense_id": "be77c4b5-9154-3238-bf4b-cd251d4c20dc",
                                                "text": "„Zum ersten Mal seit Monaten hatte ich das Glück gehabt, einen Parkplatz am Straßenrand zu ergattern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
