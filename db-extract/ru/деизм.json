                        "cross_references": [
                            {
                                "target_word": "Deismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e408f03-8a30-3336-9c12-1a2c886ecc0b",
                                        "entry_id": "683491c7-1e57-38a8-8ee7-291e85951ea2",
                                        "glosses": [
                                            "Glauben an Gott aus Gründen der Vernunft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55a69979-3e0c-47df-a1aa-e2ec14daecef",
                                                "sense_id": "8e408f03-8a30-3336-9c12-1a2c886ecc0b",
                                                "text": "Der Deismus bildet in manchen Ländern die religiöse Grundlage des Freimaurertums und hatte in der Zeit der Aufklärung bedeutende Anhänger wie Thomas Jefferson und Voltaire."
                                            },
                                            {
                                                "example_id": "914422b5-07bb-4b43-b8cf-d80fa0dd5795",
                                                "sense_id": "8e408f03-8a30-3336-9c12-1a2c886ecc0b",
                                                "text": "„Der Deismus betrachtet die verschiedenen Religionen einfach als Parteien mit eigenen Interessen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
