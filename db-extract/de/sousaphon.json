                "senses": [
                    {
                        "sense_id": "99f5f185-4e7e-326c-964c-e0842a041ecf",
                        "entry_id": "35f22f4f-46e5-3fac-b31c-1627e9487270",
                        "glosses": [
                            "Bauart der Tuba mit nach vorne gerichtetem Schallbecher, deren Schallrohr den Musiker ringförmig umgibt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "d2c168ec-b305-436f-8460-4364c6e68616",
                                "sense_id": "99f5f185-4e7e-326c-964c-e0842a041ecf",
                                "text": "Das Sousaphon ist vor allem zum Marschieren besser geeignet als herkömmliche Tuben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6b89a8c-9fc1-45fe-951d-a053e6dee493",
                        "source_entry_id": "35f22f4f-46e5-3fac-b31c-1627e9487270",
                        "source_sense_id": "99f5f185-4e7e-326c-964c-e0842a041ecf",
                        "target_lang_word": "sousaphone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sousaphone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9738d5b-b913-3ac8-8d37-5aa1c522b7af",
                                        "entry_id": "66544db8-3ecb-3c13-b54d-bfbd5d276618",
                                        "glosses": [
                                            "A valved brass instrument with the same length as a tuba, but shaped differently so that the bell is above the head, that the valves are situated directly in front of the musical instruments and a few inches above the waist, and that most of the weight rests on one shoulder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b5dc057-baef-46ee-945b-8849fc2a7694",
                                                "sense_id": "a9738d5b-b913-3ac8-8d37-5aa1c522b7af",
                                                "text": "One version of the large tuba, popular in marching bands, is called a sousaphone in honor of bandsman John Philip Sousa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "085534f9-4e4f-48fc-b530-60d8437d9710",
                        "source_entry_id": "35f22f4f-46e5-3fac-b31c-1627e9487270",
                        "source_sense_id": "99f5f185-4e7e-326c-964c-e0842a041ecf",
                        "target_lang_word": "soubassophone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soubassophone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "842bcf56-57f5-3ad6-936a-256c21c0449f",
                                        "entry_id": "052143ec-9526-3c5e-8d3c-e566b7a0ca40",
                                        "glosses": [
                                            "Instrument de musique de la famille des cuivres doux, apparenté au tuba-contrebasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9c64a1-de10-40a0-a8b4-f47f2a18e9e0",
                                                "sense_id": "842bcf56-57f5-3ad6-936a-256c21c0449f",
                                                "text": "Citons enfin le contretuba ou contrebasse-tuba en ut à 4 ou 5 pistons qui sonne à l’octave inférieure des notes écrites, ainsi que, pour mémoire, les spectaculaires hélicon, sousaphone ou soubassophone, si prisés aux U.S.A."
                                            },
                                            {
                                                "example_id": "4127b9ae-a08a-4bf4-9672-a27ffe6c5053",
                                                "sense_id": "842bcf56-57f5-3ad6-936a-256c21c0449f",
                                                "text": "Les connaisseurs pouvaient reconnaître des instruments de la même famille tels que l’hélicon, le saxhorn, l’euphonium, le contre-tuba, l’alto, le bugle, le soubassophone…"
                                            },
                                            {
                                                "example_id": "eaf9ecd6-3aa5-400b-9131-3eb57bd6a384",
                                                "sense_id": "842bcf56-57f5-3ad6-936a-256c21c0449f",
                                                "text": "Le répertoire de Miri Gili vous invite à découvrir la variété des chansons tziganes, depuis les balades roumaines et manouches accompagnées au violon jusqu’aux danses de mariage et de fanfares accompagnées au soubassophone, en prenant soin de respecter l’esprit roman : \"La larme à l’œil mais le sourire aux lèvres\"… ou inversement…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
