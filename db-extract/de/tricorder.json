                "senses": [
                    {
                        "sense_id": "23109f2c-86fa-31c1-bd0e-d8e73ee84313",
                        "entry_id": "eea2c5e2-2571-3a84-ac68-46bc2e98dc3c",
                        "glosses": [
                            "Messgerät, das an ein fiktives Messgerät des »Star Trek«-Science-Fiction-Universums erinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71cf2e31-3c7a-405e-91bd-f0242f9165bb",
                                "sense_id": "23109f2c-86fa-31c1-bd0e-d8e73ee84313",
                                "text": "„Sensordrone erinnert ein wenig an den Tricorder aus der Sci-Fi-Serie Star Trek. Ähnlich wie das fiktionale Vorbild arbeitet das kompakte Gerät mit zahlreichen Sensoren, darunter gleich zwei Gasmesser, mit denen Alkohol, Kohlenmonoxid und einige gifte Gase erkannt werden sollen.“"
                            },
                            {
                                "example_id": "5ca94b8b-d737-4a2e-945a-ed78bd8523b0",
                                "sense_id": "23109f2c-86fa-31c1-bd0e-d8e73ee84313",
                                "text": "„Ein mobiles Breitbanddiagnosegerät nach dem Vorbild des Tricorders aus der Star-Trek-Serie zu entwickeln, ist die Aufgabe des Tricorder X Prize.“"
                            },
                            {
                                "example_id": "9089c783-1bbc-4aeb-afaa-b72dc35d386b",
                                "sense_id": "23109f2c-86fa-31c1-bd0e-d8e73ee84313",
                                "text": "„Auch anderswo sei die an Tricorder aus ‚Star Trek‘ erinnernde Technologie nützlich, etwa um in der Garage vor Abgasen zu warnen.“"
                            },
                            {
                                "example_id": "8d6d6537-f063-44e2-980a-5289aebd8af4",
                                "sense_id": "23109f2c-86fa-31c1-bd0e-d8e73ee84313",
                                "text": "„Bitte nachbauen: Ein US-Wissenschaftler hat den Tricorder aus der TV-Serie ‚Star Trek‘ nachgebaut. Daran haben sich schon viele andere versucht, sind aber meist gescheitert. Nicht so Peter Jansen, denn dessen Multimessgerät funktioniert wirklich – wenn auch anders als das Original.“"
                            },
                            {
                                "example_id": "bbb68afc-8fb3-4531-810a-5e1258d95fc5",
                                "sense_id": "23109f2c-86fa-31c1-bd0e-d8e73ee84313",
                                "text": "„Inspiriert vom Tricorder in Star Trek hat ein US-Wissenschaftler ein handliches Gerät entwickelt, das alle möglichen Daten unserer Umgebung erfasst und leicht verständlich darstellt. Wer den Tricorder selbst nachbauen möchte, kann die komplette Bauanleitung kostenlos herunterladen.“"
                            },
                            {
                                "example_id": "b495f76c-33f1-40dd-a646-2d9d3f0f8213",
                                "sense_id": "23109f2c-86fa-31c1-bd0e-d8e73ee84313",
                                "text": "„Der spitzohrige Wissenschaftsoffizier Commander Spock zückt auf Erkundungstour auf einem fernen Planeten einfach seinen Tricorder, wenn er Flora und Fauna bestimmen will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
