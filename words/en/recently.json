            "senses": [
                {
                    "sense_id": "2c297d62-901c-33f4-a491-112c48da1ac4",
                    "sense_definition": "At a time that was not long ago; a short while ago.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <recently> moved to a new apartment in the city center.",
                            "target_lang_translations": {
                                "ru": "Она <недавно> переехала в новую квартиру в центре города.",
                                "nl": "Ze is <onlangs> verhuisd naar een nieuw appartement in het stadscentrum.",
                                "pl": "Ona <w>niedawno</w> przeprowadziła się do nowego mieszkania w centrum miasta.",
                                "de": "Sie ist <w>vor kurzem</w> in eine neue Wohnung im Stadtzentrum gezogen.",
                                "fr": "Elle a <récemment> déménagé dans un nouvel appartement au centre-ville.",
                                "it": "Si è trasferita <w>di recente</w> in un nuovo appartamento in centro città.",
                                "cs": "Ona se <w>nedávno</w> přestěhovala do nového bytu v centru města.",
                                "tr": "Şehir merkezinde yeni bir daireye <w>yakın zamanda</w> taşındı.",
                                "es": "Ella se mudó <recientemente> a un nuevo apartamento en el centro de la ciudad.",
                                "zh": "她<w>最近</w>搬到了市中心的一套新公寓。"
                            }
                        },
                        {
                            "text": "This is a <recently> published book about the history of art.",
                            "target_lang_translations": {
                                "ru": "Это <недавно> изданная книга об истории искусства.",
                                "nl": "Dit is een <recentelijk> gepubliceerd boek over de kunstgeschiedenis.",
                                "pl": "To jest <w>niedawno</w> wydana książka o historii sztuki.",
                                "de": "Dies ist ein <w>kürzlich</w> veröffentlichtes Buch über die Kunstgeschichte.",
                                "fr": "C'est un livre <récemment> publié sur l'histoire de l'art.",
                                "it": "Questo è un libro sulla storia dell'arte pubblicato <w>recentemente</w>.",
                                "cs": "Toto je <w>nedávno</w> vydaná kniha o historii umění.",
                                "tr": "Bu, sanat tarihi hakkında <w>yeni</w> yayınlanmış bir kitaptır.",
                                "es": "Este es un libro <recién> publicado sobre la historia del arte.",
                                "zh": "这是一本<w>最近</w>出版的关于艺术史的书。"
                            }
                        }
                    ],
                    "synonyms": [
                        "just now",
                        "newly",
                        "freshly"
                    ],
                    "antonyms": [
                        "long ago",
                        "long since"
                    ],
                    "common_phrases": [
