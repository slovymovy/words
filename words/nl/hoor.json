                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hoor</w> eens, ik ben het daar helemaal niet mee eens.",
                            "target_lang_translations": {
                                "en": "<w>Listen</w>, I don't agree with that at all.",
                                "ru": "<w>Послушай</w>-ка, я с этим совершенно не согласен.",
                                "it": "<w>Senti</w>, non sono affatto d'accordo."
                            }
