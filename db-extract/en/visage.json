                            "plural"
                        ],
                        "form": "visages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "378612bd-01c7-3186-8cb2-191c82b1efdc",
                        "entry_id": "89e99809-7c6b-3522-a520-4b1aab0cfbd7",
                        "glosses": [
                            "Countenance; appearance; one's face."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8605f64-fe09-48d1-9342-d95c37ce18ab",
                                "sense_id": "378612bd-01c7-3186-8cb2-191c82b1efdc",
                                "text": "[T]he monſter, rouſed by the noiſe, ſtarted forward, preſented ſuch a viſage of horror, and raiſed ſuch a hideous roar, that the hearts of the bold were contracted, and the nerves of the valiant unſtrung."
                            },
                            {
                                "example_id": "f2658746-598b-4e08-8d5a-cf64913b8337",
                                "sense_id": "378612bd-01c7-3186-8cb2-191c82b1efdc",
                                "text": "Lying on the floor was a dead man, in evening dress, with a knife in his heart. He was withered, wrinkled, and loathsome of visage. It was not till they had examined the rings that they recognized who it was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2270f9b5-045a-45f6-909e-18120ac91f18",
                        "source_entry_id": "89e99809-7c6b-3522-a520-4b1aab0cfbd7",
                        "source_sense_id": "378612bd-01c7-3186-8cb2-191c82b1efdc",
                        "source_sense_description": "countenance; appearance; face",
                        "target_lang_word": "Gesicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67dd9433-eab9-3023-b3f0-63f38478700e",
                                        "entry_id": "886a80a6-db1f-3a66-85ab-2daa9ffb6f6b",
                                        "glosses": [
                                            "die vom Haupthaar ausgesparte Vorderseite des menschlichen Kopfes, auf der die Augen, die Nase und der Mund liegen"
                                        ],
                                        "tags": [
                                            "moderner Mensch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41436e35-b770-4439-9c5d-01aa2f1f07fc",
                                                "sense_id": "67dd9433-eab9-3023-b3f0-63f38478700e",
                                                "text": "Er fuhr sich mit den Händen durchs Gesicht."
                                            },
                                            {
                                                "example_id": "485909e4-b7b7-4461-9872-21fcfeb2ff70",
                                                "sense_id": "67dd9433-eab9-3023-b3f0-63f38478700e",
                                                "text": "„Ich betastete ihr Gesicht wie ein Blinder.“"
                                            },
                                            {
                                                "example_id": "e9a7502a-1ddc-4b5e-b17e-ac91452ed212",
                                                "sense_id": "67dd9433-eab9-3023-b3f0-63f38478700e",
                                                "text": "„Einige große Glassplitter hatten sich tief in ihr Gesicht und ihren Hals gebohrt.“"
                                            },
                                            {
                                                "example_id": "2d51d5ff-f3c0-42cb-a165-53f04a21baf5",
                                                "sense_id": "67dd9433-eab9-3023-b3f0-63f38478700e",
                                                "text": "„Was sie nun im Spiegel sah, war ein klaräugiges frisches Gesicht, lächelnd, ebenmäßig, schön.“"
                                            },
                                            {
                                                "example_id": "e04049a9-e1e2-4551-b0cd-5a29d8432903",
                                                "sense_id": "67dd9433-eab9-3023-b3f0-63f38478700e",
                                                "text": "„Schließlich trocknete er sein Gesicht mit dem Taschentuch.“"
                                            },
                                            {
                                                "example_id": "6f288e4c-5df7-45d7-bbd1-1dfb93916cbf",
                                                "sense_id": "67dd9433-eab9-3023-b3f0-63f38478700e",
                                                "text": "„Ihr Gesicht war rot von dem Pizzafeuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19258658-fa4a-374d-9a79-5ec1ec6d4885",
                                        "entry_id": "886a80a6-db1f-3a66-85ab-2daa9ffb6f6b",
                                        "glosses": [
                                            "Vorderseite des Kopfes, auf der die Augen, die Nase und das Maul liegen"
                                        ],
                                        "tags": [
                                            "Tiere"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93b7e179-d770-4cc8-aff3-f6445cb828c7",
                                                "sense_id": "19258658-fa4a-374d-9a79-5ec1ec6d4885",
                                                "text": "Der Schimpanse hatte eine Narbe im Gesicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f915ddad-7fbc-36c9-bc1e-4f20ab587f08",
                                        "entry_id": "886a80a6-db1f-3a66-85ab-2daa9ffb6f6b",
                                        "glosses": [
                                            "eine Person als Ganzes"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "288c4e4e-f82f-495e-8802-46a06b1d731d",
                                                "sense_id": "f915ddad-7fbc-36c9-bc1e-4f20ab587f08",
                                                "text": "So viele neue Gesichter!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4f101220-e94a-3755-8359-2085ac0a0414",
                                        "entry_id": "886a80a6-db1f-3a66-85ab-2daa9ffb6f6b",
                                        "glosses": [
                                            "ein Gesichtsausdruck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95eb5c81-23be-4927-b35a-c9617673e4d8",
                                                "sense_id": "4f101220-e94a-3755-8359-2085ac0a0414",
                                                "text": "Mach nicht so ein Gesicht!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a99d7d9a-8c2a-32f2-af22-05136995eca7",
                                        "entry_id": "886a80a6-db1f-3a66-85ab-2daa9ffb6f6b",
                                        "glosses": [
                                            "Ansehen und Respekt (in den Augen anderer)"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "578b2db7-24a6-4796-bcdd-add6a7504011",
                                                "sense_id": "a99d7d9a-8c2a-32f2-af22-05136995eca7",
                                                "text": "Es ist gut, wenn man seinen Gesprächspartner das Gesicht wahren lässt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "b04c92b4-5af6-3583-89ad-1f2c73b7f3e9",
                                        "entry_id": "886a80a6-db1f-3a66-85ab-2daa9ffb6f6b",
                                        "glosses": [
                                            "Anblick, Betrachtungsmöglichkeit (einer von mehreren Aspekten einer Person oder eines Gegenstandes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "878ebdb8-dd57-4773-b60b-a1cb086d3ff2",
                                                "sense_id": "b04c92b4-5af6-3583-89ad-1f2c73b7f3e9",
                                                "text": "Mein Bruder hat viele Gesichter, es kommt ganz darauf an, wo und wann du ihn triffst."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "4c9741cb-725f-3973-b423-0edd8aa5354f",
                                        "entry_id": "886a80a6-db1f-3a66-85ab-2daa9ffb6f6b",
                                        "glosses": [
                                            "Offenbarung, Traumbild"
                                        ],
                                        "tags": [
                                            "Plural 2",
                                            "Parapsychologie",
                                            "Okkultismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47a65a6d-73a7-4612-985d-139b7f428841",
                                                "sense_id": "4c9741cb-725f-3973-b423-0edd8aa5354f",
                                                "text": "„Kaum hatte Hutter die Brücke überschritten, da ergriffen ihn die unheimlichen Gesichte, von denen er mir oft erzählt hat.“"
                                            },
                                            {
                                                "example_id": "2a7e8a3a-b1e6-40db-b3b1-f3880a217a79",
                                                "sense_id": "4c9741cb-725f-3973-b423-0edd8aa5354f",
                                                "text": "„Greet hatte die Gabe des Zweiten Gesichts, das sie häufig nachts überfiel, sodass sie das Bett verließ und durch das Dorf und die Felder irrte. Namentlich drei Gesichte sind in der örtlichen Überlieferung noch heute bekannt.“"
                                            },
                                            {
                                                "example_id": "d18b70c3-1460-4dd1-9e54-f787bc35ccd8",
                                                "sense_id": "4c9741cb-725f-3973-b423-0edd8aa5354f",
                                                "text": "„Er hielt sich berufen, seinen Zeitgenossen Buße und Bekehrung zu predigen, er stützte sich dabei auf allerlei wunderbare Erscheinungen und Gesichte, die er gehabt haben wollte und die er als wahrhaftige von Gott und seinen Engeln herkommende treue Warnungen - ‚Offenbarungen‘ - nannte.“"
                                            },
                                            {
                                                "example_id": "2edf2f48-8a61-4f7d-a4ac-6b165b9d58c4",
                                                "sense_id": "4c9741cb-725f-3973-b423-0edd8aa5354f",
                                                "text": "„Hoffmann hat nicht nur ein sehr lebhaftes Traumleben, oft kommt es auch vor, daß ihm Wachträume erscheinen, er hat oft Vorahnungen und Gesichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
