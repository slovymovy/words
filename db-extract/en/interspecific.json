                    },
                    {
                        "sense_id": "6ac75a59-2584-37d4-88fb-88d231885b4d",
                        "entry_id": "f7c9e6ab-4745-37c6-a5b8-9b1658127699",
                        "glosses": [
                            "Existing or occurring between different species"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "fe52dc4b-8fb8-4b93-946b-e42422b5633e",
                                "sense_id": "6ac75a59-2584-37d4-88fb-88d231885b4d",
                                "text": "Interspecific crossing in the wild appears to be limited as well, at least partly due to geographic isolation. However, I. wallerana and I. usambarensis are known to have naturally hybridized in the wild (Grey-Wilson, 1980a; Grey-Wilson, 1980b). With the wonderful horticulture discovery of the New Guinea group of impatiens in the early 1970's, there was significant interest in attempting controlled interspecific pollinations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a22554ee-0993-4fb8-8ac4-5d40b853600a",
                        "source_entry_id": "f7c9e6ab-4745-37c6-a5b8-9b1658127699",
                        "source_sense_description": "occurring among members of different species",
                        "target_lang_word": "interspécifique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
