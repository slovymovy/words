                                "target_senses": [
                                    {
                                        "sense_id": "13a9dc97-e713-3eee-9fbd-27349533090d",
                                        "entry_id": "2a6b4b05-2767-309d-a5b4-0be7e61bcd09",
                                        "glosses": [
                                            "antreibende Kraft, innere Bewegung"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1536419-2161-4784-bdfb-68b4a866f4fa",
                                                "sense_id": "13a9dc97-e713-3eee-9fbd-27349533090d",
                                                "text": "Die Proteste haben mittlerweile eine eigene Dynamik entwickelt."
                                            },
                                            {
                                                "example_id": "b4b11d32-e70e-4acd-89f5-15d838eda436",
                                                "sense_id": "13a9dc97-e713-3eee-9fbd-27349533090d",
                                                "text": "„Für das Natura 2000-Gebiet Nationalpark Hohe Tauern, Tirol, […], werden folgende Erhaltungsziele festgelegt: 1. Erhaltung und Wiederherstellung eines ausreichenden Maßes an naturnahen Gewässerabschnitten mit einer charakteristischen Dynamik sowie ihrer Lebensräume. […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f47ae5cd-46c6-3bc0-8286-25b547ae36d8",
                                        "entry_id": "2a6b4b05-2767-309d-a5b4-0be7e61bcd09",
                                        "glosses": [
                                            "Lehre von den durch Kräfte erzeugten Bewegungen"
                                        ],
                                        "tags": [
                                            "no-plural",
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56131b40-a296-4059-81dd-7a3c5f09ce5f",
                                                "sense_id": "f47ae5cd-46c6-3bc0-8286-25b547ae36d8",
                                                "text": "Die Newtonschen Axiome sind die Grundgesetze der Dynamik."
                                            },
                                            {
                                                "example_id": "348316fa-73f7-4ad9-90a0-85ac1e1b8f36",
                                                "sense_id": "f47ae5cd-46c6-3bc0-8286-25b547ae36d8",
                                                "text": "„In Pisa nimmt Galilei wesentliche Fragen der Dynamik in Angriff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1ee82480-87e7-3757-9900-baf40ee95f18",
                                        "entry_id": "2a6b4b05-2767-309d-a5b4-0be7e61bcd09",
                                        "glosses": [
                                            "Lehre der Tonstärke beziehungsweise Lautheit"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c16982a2-c2b1-48d8-9bb8-f56e5a8c2a20",
                                                "sense_id": "1ee82480-87e7-3757-9900-baf40ee95f18",
                                                "text": "Während der Barockzeit hatte die Dynamik als musikalischer Parameter noch wenig Gewicht; es wurde weitgehend dem mündlich tradierten Stilempfinden der Musiker überlassen, wo leiser oder lauter zu spielen war."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
