                        "examples": [
                            {
                                "example_id": "049dfd4c-d8c2-4fe0-b8d1-9dfed1c7bd3a",
                                "sense_id": "038eb1a2-da48-3872-879f-fae97e75d320",
                                "text": "PELTIFORME, adj., peltiformis, peltæformis (pelta, bouclier, forma, forme). On donne cette épithète, en minéralogie, aux couches qui sont convexes et appliquées sur le penchant d’une montagne ; en botanique, aux apothécies en forme de bouclier (ex. Peltigera), et, d’après Candolle, aux feuilles de fucus dont les nervures sont formées de simple tissu cellulaire allongé, et ont la même disposition que celles des feuilles peltinerves."
                            },
                            {
                                "example_id": "0a925929-6a0c-4d46-a34a-0c1ee4b0bd21",
                                "sense_id": "038eb1a2-da48-3872-879f-fae97e75d320",
                                "text": "Feuille peltiforme."
                            }
                        ]
