{
    "word_family": [
        "trucker",
        "trucking",
        "truckload"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d0bea01-920b-3dab-aa3b-45829a26dfd8",
                    "sense_definition": "A large, heavy motor vehicle designed to carry goods, materials, or troops.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The delivery <w>truck</w> arrived early this morning with our furniture.",
                            "target_lang_translations": {
                                "ru": "<w>Грузовик</w> службы доставки прибыл сегодня рано утром с нашей мебелью.",
                                "zh": "送货<w>卡车</w>今天一大早就把我们的家具送到了。"
                            }
                        },
                        {
                            "text": "He rented a large <w>truck</w> to move his belongings to the new house.",
                            "target_lang_translations": {
                                "ru": "Он арендовал большой <w>грузовик</w>, чтобы перевезти свои вещи в новый дом.",
                                "zh": "他租了一辆大<w>卡车</w>把行李搬到新家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lorry"
                    ],
                    "common_phrases": [
                        "pickup truck",
                        "fire truck",
                        "dump truck",
                        "tow truck",
                        "drive a truck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое тяжелое моторное транспортное средство, предназначенное для перевозки грузов, материалов или людей.",
                        "zh": "一种用于运输货物、材料或人员的大型重型机动车辆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грузовик",
                                "target_lang_sense_clarification": "общее название"
                            },
                            {
                                "target_lang_word": "фура",
                                "target_lang_sense_clarification": "большой крытый грузовик для дальних перевозок"
                            },
                            {
                                "target_lang_word": "грузовая машина",
                                "target_lang_sense_clarification": "синоним для грузовика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡车",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "货车",
                                "target_lang_sense_clarification": "侧重于运输功能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef7677e9-e4a1-368c-8d5b-8afe4b14e195",
                    "sense_definition": "A small vehicle with wheels, pushed or pulled by hand, used to move heavy goods or luggage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The porter loaded all the suitcases onto a hand <w>truck</w>.",
                            "target_lang_translations": {
                                "ru": "Портье погрузил все чемоданы на ручную <w>тележку</w>.",
                                "zh": "搬运工把所有的行李箱都装上了<w>手推车</w>。"
                            }
                        },
                        {
                            "text": "We used a small <w>truck</w> to move the boxes of books into the library.",
                            "target_lang_translations": {
                                "ru": "Мы использовали маленькую <w>тележку</w>, чтобы перевезти коробки с книгами в библиотеку.",
                                "zh": "我们用一辆小<w>手推车</w>把书箱搬进了图书馆。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hand truck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая тележка на колесах, которую толкают или тянут вручную, используемая для перемещения тяжелых грузов.",
                        "zh": "一种带轮子的小型推车，用手推或拉，用于搬运重物或行李。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тележка",
                                "target_lang_sense_clarification": "общее название"
                            },
                            {
                                "target_lang_word": "ручная тележка",
                                "target_lang_sense_clarification": "уточнение типа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手推车",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "搬运车",
                                "target_lang_sense_clarification": "用于搬运重物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54981eb7-4297-389e-9837-74768f7e604e",
                    "sense_definition": "A railroad car designed to carry goods rather than passengers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coal was loaded into the open <w>truck</w> at the railway siding.",
                            "target_lang_translations": {
                                "ru": "Уголь погрузили в открытый <w>товарный вагон</w> на запасном пути.",
                                "zh": "煤炭在铁路侧线被装进了敞篷<w>货车</w>里。"
                            }
                        },
                        {
                            "text": "Several goods <w>trucks</w> were decoupled from the main train.",
                            "target_lang_translations": {
                                "ru": "Несколько <w>товарных вагонов</w> отцепили от основного состава.",
                                "zh": "几节<w>货车</w>车厢从主列车上被解开了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "goods wagon",
                        "freight car",
                        "freight wagon",
                        "goods truck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Железнодорожный вагон, предназначенный для перевозки грузов, а не пассажиров.",
                        "zh": "一种专门用于运送货物而非乘客的铁路车辆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "товарный вагон",
                                "target_lang_sense_clarification": "железнодорожный термин"
                            },
                            {
                                "target_lang_word": "платформа",
                                "target_lang_sense_clarification": "открытый тип вагона"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "货车",
                                "target_lang_sense_clarification": "铁路货运车辆"
                            },
                            {
                                "target_lang_word": "货运车厢",
                                "target_lang_sense_clarification": "指代具体的车厢"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "052c0346-bfca-39ed-87c7-93eb7afd32c4",
                    "sense_definition": "Social dealings, association, or interaction, typically used in negative contexts to indicate a refusal to engage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will have no <w>truck</w> with people who are dishonest.",
                            "target_lang_translations": {
                                "ru": "Я не буду иметь никаких <w>дел</w> с нечестными людьми.",
                                "zh": "我绝不会和不诚实的人<w>打交道</w>。"
                            }
                        },
                        {
                            "text": "The manager refused to have any <w>truck</w> with the new proposal.",
                            "target_lang_translations": {
                                "ru": "Менеджер отказался иметь какие-либо <w>дела</w> с новым предложением.",
                                "zh": "经理拒绝与这项新提案有任何<w>往来</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have no truck with"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "idiomatic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общение, взаимодействие или дела с кем-либо (обычно используется в отрицании).",
                        "zh": "指与某人交往、打交道或互动，通常用于否定句中表示拒绝往来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дело",
                                "target_lang_sense_clarification": "в выражении 'иметь дело'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打交道",
                                "target_lang_sense_clarification": "指人际交往或业务往来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7542e69-d695-3093-8fdc-6aee0ea46406",
                    "sense_definition": "A pivoting frame with wheels attached to the bottom of a railway car or skateboard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic inspected the rear <w>truck</w> of the carriage for damage.",
                            "target_lang_translations": {
                                "ru": "Механик осмотрел заднюю <w>тележку</w> вагона на предмет повреждений.",
                                "zh": "机械师检查了车厢后部的<w>转向架</w>是否有损坏。"
                            }
                        },
                        {
                            "text": "He tightened the <w>trucks</w> on his skateboard to improve stability.",
                            "target_lang_translations": {
                                "ru": "Он подтянул <w>подвеску</w> на своем скейтборде, чтобы улучшить устойчивость.",
                                "zh": "他拧紧了滑板上的<w>支架</w>以提高稳定性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bogie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поворотная рама с колесами, прикрепленная к нижней части железнодорожного вагона или скейтборда.",
                        "zh": "安装在铁路车辆底部或滑板底部的带轮转向架或悬挂装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тележка",
                                "target_lang_sense_clarification": "часть вагона"
                            },
                            {
                                "target_lang_word": "подвеска",
                                "target_lang_sense_clarification": "часть скейтборда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "转向架",
                                "target_lang_sense_clarification": "铁路术语"
                            },
                            {
                                "target_lang_word": "支架",
                                "target_lang_sense_clarification": "滑板术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81e924fb-777e-36d7-9761-b3d529125759",
                    "sense_definition": "To convey or transport goods by means of a truck.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>trucked</w> the equipment to the concert venue overnight.",
                            "target_lang_translations": {
                                "ru": "Они <w>перевезли на грузовиках</w> оборудование к месту концерта за ночь.",
                                "zh": "他们连夜用卡车把设备<w>运输</w>到了音乐会现场。"
                            }
                        },
                        {
                            "text": "All the debris from the construction site was <w>trucked</w> away.",
                            "target_lang_translations": {
                                "ru": "Весь мусор со строительной площадки был <w>вывезен на грузовиках</w>.",
                                "zh": "建筑工地上的所有垃圾都被用卡车<w>运走</w>了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевозить или транспортировать грузы на грузовике.",
                        "zh": "用卡车运输货物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевозить на грузовике",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "транспортировать автотранспортом",
                                "target_lang_sense_clarification": "формальный вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用卡车运输",
                                "target_lang_sense_clarification": "动作描述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1fabd0b-0439-3b07-b19e-2d8c5dc9a10c",
                    "sense_definition": "To drive a truck, especially as a job.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My uncle has been <w>trucking</w> across the country for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мой дядя <w>работает дальнобойщиком</w> по всей стране уже двадцать лет.",
                                "zh": "我叔叔<w>开卡车</w>跑全国已经二十年了。"
                            }
                        },
                        {
                            "text": "He enjoys <w>trucking</w> because he gets to see many different places.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>водить грузовик</w>, потому что он видит много разных мест.",
                                "zh": "他喜欢<w>开卡车</w>，因为他能看到许多不同的地方。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Водить грузовик, особенно в качестве профессии.",
                        "zh": "驾驶卡车，通常作为职业。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водить грузовик",
                                "target_lang_sense_clarification": "процесс вождения"
                            },
                            {
                                "target_lang_word": "работать дальнобойщиком",
                                "target_lang_sense_clarification": "профессия (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开卡车",
                                "target_lang_sense_clarification": "驾驶行为"
                            },
                            {
                                "target_lang_word": "当货车司机",
                                "target_lang_sense_clarification": "职业描述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2baacc7d-93ff-38c7-a1fb-91826ef55248",
                    "sense_definition": "To persist, continue, or move along, often in a casual or determined way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the difficulties, we just have to keep <w>trucking</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на трудности, мы просто должны продолжать <w>двигаться вперед</w>.",
                                "zh": "尽管困难重重，我们还是得<w>坚持下去</w>。"
                            }
                        },
                        {
                            "text": "She is still <w>trucking</w> along with her studies despite the heavy workload.",
                            "target_lang_translations": {
                                "ru": "Она все еще <w>продолжает заниматься</w> учебой, несмотря на большую нагрузку.",
                                "zh": "尽管工作量很大，她依然在<w>坚持</w>学习。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "keep on trucking"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжать делать что-то, двигаться вперед, несмотря на трудности.",
                        "zh": "指坚持做某事，或在困难中继续前进。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двигаться вперед",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "продолжать дело",
                                "target_lang_sense_clarification": "упорство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坚持下去",
                                "target_lang_sense_clarification": "表示毅力"
                            },
                            {
                                "target_lang_word": "继续前进",
                                "target_lang_sense_clarification": "表示持续状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}