                                        "glosses": [
                                            "Qui recèle des fossiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32675012-b4ed-44ca-9dbe-86f140d87bc2",
                                                "sense_id": "5010be0e-5e73-30dd-be6f-20198fec9808",
                                                "text": "Superposition et succession chronologique des couches fossilifères."
                                            },
                                            {
                                                "example_id": "8ecf7339-adf2-47a3-89bc-d41ccfdbbcf7",
                                                "sense_id": "5010be0e-5e73-30dd-be6f-20198fec9808",
                                                "text": "Les grès à Woltzia […] forment dans leur niveau inférieur des bancs compacts et fossilifères où « les couches gréseuses alternent avec des argiles diversement nuancées » […]"
                                            },
                                            {
                                                "example_id": "244ded8f-18df-4e95-b274-b578352374d1",
                                                "sense_id": "5010be0e-5e73-30dd-be6f-20198fec9808",
                                                "text": "La plupart des gisements d’ambre ont été trouvés en Amérique du Nord et en Eurasie, et seuls quelques rares ambres non fossilifères étaient connus pour le Gondwana."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
