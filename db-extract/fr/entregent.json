        "fr-extract.jsonl": [
            {
                "entry_id": "4a6bc1b3-feb8-3e7f-9378-c1c931215cf2",
                "word": "entregent",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7c9d1e02-ccb0-46f7-8ef3-ee67a1624765",
                        "entry_id": "4a6bc1b3-feb8-3e7f-9378-c1c931215cf2",
                        "tags": [
                            "plural"
                        ],
                        "form": "entregents"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ed83358-343c-3c37-ab41-96779dcf9058",
                        "entry_id": "4a6bc1b3-feb8-3e7f-9378-c1c931215cf2",
                        "glosses": [
                            "Manière adroite de se pousser dans le monde, dans la société, de s’insinuer auprès des personnes utiles, de s’en servir pour ses intérêts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80e3de50-b7dd-4c35-a5bd-7a63b409f41f",
                                "sense_id": "5ed83358-343c-3c37-ab41-96779dcf9058",
                                "text": "Cet homme ne fera pas fortune, il n’a point d’entregent, il manque d’entregent."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0338b54-9cfc-35f9-a0f9-738ab7a35217",
                        "entry_id": "4a6bc1b3-feb8-3e7f-9378-c1c931215cf2",
                        "glosses": [
                            "Habileté à créer et entretenir un réseau de connaissances influentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8559de3-53a6-45ba-9b08-b2858adabd99",
                                "sense_id": "d0338b54-9cfc-35f9-a0f9-738ab7a35217",
                                "text": "Les plus jeunes damoiselles, encore nices et peu garnies d’entregent, étaient doucement chapitrées par les jouvenceaux avisés qui leur prêchaient maintes jolies doctrines."
                            },
                            {
                                "example_id": "e365c04a-47f0-46f5-96fa-145a163f645a",
                                "sense_id": "d0338b54-9cfc-35f9-a0f9-738ab7a35217",
                                "text": "M. Badinot (notre homme s’appelle ainsi) a beaucoup d’entregent et des relations patentes ou occultes dans presque toutes les classes de la société."
                            },
                            {
                                "example_id": "acde1b0a-e51c-4dc3-9a37-a349991aacb9",
                                "sense_id": "d0338b54-9cfc-35f9-a0f9-738ab7a35217",
                                "text": "Pour les Verger, la dépense avait été dérisoire : grâce à leur sens des affaires et à leur entregent, ils étaient les fournisseurs en viande de l’armée américaine depuis la guerre civile."
                            },
                            {
                                "example_id": "273269ac-28af-412e-8241-8409c2a560cb",
                                "sense_id": "d0338b54-9cfc-35f9-a0f9-738ab7a35217",
                                "text": "Pleine d’entregent et de relations, Dominique Cantien s’occupe des programmes et la créative Pascale Breugnot des divertissements."
                            }
                        ]
                    }
                ],
