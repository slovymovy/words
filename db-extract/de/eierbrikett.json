                ],
                "senses": [
                    {
                        "sense_id": "4e46724c-0179-34a0-a444-ee598a99ddf8",
                        "entry_id": "6a76e033-7cc5-330c-96c0-d3bed3f668cf",
                        "glosses": [
                            "eiförmig gepresstes Stück Brennmaterial aus Steinkohle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f70b191a-e794-4898-a27e-a44d9ccfcde8",
                                "sense_id": "4e46724c-0179-34a0-a444-ee598a99ddf8",
                                "text": "Mit einem Stück Eierbrikett kommt man nicht weit."
                            },
                            {
                                "example_id": "145c9143-ffe8-4109-be2b-05aaa8fdb56f",
                                "sense_id": "4e46724c-0179-34a0-a444-ee598a99ddf8",
                                "text": "Eierbriketts sind deutlich kleiner als die sonst üblichen Braunkohlebriketts."
                            },
                            {
                                "example_id": "4c9cdcec-9987-495e-83e3-361f29d4eab8",
                                "sense_id": "4e46724c-0179-34a0-a444-ee598a99ddf8",
                                "text": "Wir hatten früher immer auch Eierbriketts im Keller."
                            },
                            {
                                "example_id": "279a5075-3b69-4ea7-ac6a-ea412e42da9d",
                                "sense_id": "4e46724c-0179-34a0-a444-ee598a99ddf8",
                                "text": "„Zusammen mit der Tochter ihrer Zimmerwirtin fuhr Ditti abends mit der Straßenbahn zur Endstation, sie kletterten auf die Güterwaggons mit den Eierbriketts, stopften die Rucksäcke voll und schleppten sie – verdammt schwer, wie sie waren – wieder zurück nach Hause.“"
                            },
                            {
                                "example_id": "2ad0b914-6d4e-43f0-a136-53fe0230a928",
                                "sense_id": "4e46724c-0179-34a0-a444-ee598a99ddf8",
                                "text": "„Zwei Berliner Hühner stehen vor einem Haufen Eierbriketts.“"
                            },
                            {
                                "example_id": "4c30d4dc-1086-4d32-93c6-015c73775458",
                                "sense_id": "4e46724c-0179-34a0-a444-ee598a99ddf8",
                                "text": "„Wer diese Witze liest, kann rekapitulieren, dass es in den kalten Nachkriegswintern nichts zu heizen gab – und wenn überhaupt, dann nur aus Kohlenstaub zusammengepresste Eierbriketts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
