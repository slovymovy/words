                "senses": [
                    {
                        "sense_id": "3e9d1c07-1f93-36a2-9903-54f38ca38410",
                        "entry_id": "33e3fd0e-a184-361e-8a93-258b82248ef9",
                        "glosses": [
                            "Work done by a tailor."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "81a5e4b4-4107-4ca7-84ec-d1323cb18c1d",
                                "sense_id": "3e9d1c07-1f93-36a2-9903-54f38ca38410",
                                "text": "A man got up in all the outward trappings of a gentleman: an extensive display of snowy linen, unimpeachable tailoring, ganté, botté, in perfection; nothing overdone."
                            }
                        ]
                    },
                    {
                        "sense_id": "00e5e550-b90b-3139-b52f-874fa68f05ba",
                        "entry_id": "33e3fd0e-a184-361e-8a93-258b82248ef9",
                        "glosses": [
                            "Any modification or ornamentation."
                        ],
                        "tags": [
                            "countable",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3b7b698-165f-481d-8044-308f9ef57019",
                        "source_entry_id": "33e3fd0e-a184-361e-8a93-258b82248ef9",
                        "source_sense_description": "work of a tailor",
                        "target_lang_word": "Schneiderei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneiderei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9595b32-4322-30fd-9fcf-27ce1a346fca",
                                        "entry_id": "7440470f-419a-3251-9c42-cb15b18167ef",
                                        "glosses": [
                                            "Werkstatt zur Herstellung von Kleidungsstücken aus gewebten Stoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d69a8956-56db-4a22-bf92-2f7e497edcc7",
                                                "sense_id": "e9595b32-4322-30fd-9fcf-27ce1a346fca",
                                                "text": "„Eine Schneiderei nämlich sei noch nie da gewesen.“"
                                            },
                                            {
                                                "example_id": "34580c4e-e7f4-4877-8b23-03a148c5153b",
                                                "sense_id": "e9595b32-4322-30fd-9fcf-27ce1a346fca",
                                                "text": "„Er streifte sich ein paar Strohkrümel von der Tunika und sah hinüber zu Giselas Schneiderei.“"
                                            },
                                            {
                                                "example_id": "bf9fd3a7-86cd-4954-bf17-b0da9451b20b",
                                                "sense_id": "e9595b32-4322-30fd-9fcf-27ce1a346fca",
                                                "text": "„Das jüdische Ehepaar, bei dem Paul untergebracht worden war, betrieb eine kleine Schneiderei in einem Dorf nahe Reims und Paul hatte neben dem Familienanschluss gleich einen beruflichen Start gefunden.“"
                                            },
                                            {
                                                "example_id": "6fd7fa08-7f32-4a05-9f73-5160bfa8a9eb",
                                                "sense_id": "e9595b32-4322-30fd-9fcf-27ce1a346fca",
                                                "text": "„Sie arbeitete in einer Schneiderei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea4a7b67-875e-31d6-9651-e982be103452",
                                        "entry_id": "7440470f-419a-3251-9c42-cb15b18167ef",
                                        "glosses": [
                                            "Herstellung von Kleidungsstücken aus gewebten Stoffen als Tätigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23248793-9429-4021-a9cd-29b9de9b92aa",
                                                "sense_id": "ea4a7b67-875e-31d6-9651-e982be103452",
                                                "text": "„Wenn Cornelius Stern in der Woche fern von ihr in seinem Hochschulstädtchen blieb, dann hatten wir viel Raum für Gespräche, aber auch für unser gemeinsames Hobby, die Schneiderei.“"
                                            },
                                            {
                                                "example_id": "e161b4e3-0c7a-4614-a395-86784e85fd97",
                                                "sense_id": "ea4a7b67-875e-31d6-9651-e982be103452",
                                                "text": "„Ich fieng also die Schneiderei, oder vielmehr die Pfuscherei an; denn es kam ein gar erbärmliches Werk heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a0654324-8122-360e-93b1-5174e0e347b9",
                                        "entry_id": "7440470f-419a-3251-9c42-cb15b18167ef",
                                        "glosses": [
                                            "Herstellung von Kleidungsstücken aus gewebten Stoffen als erlernbares Handwerk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e0022b0-4aa4-4643-a089-d522242bf2cc",
                                                "sense_id": "a0654324-8122-360e-93b1-5174e0e347b9",
                                                "text": "„Marianne Koch: Auf mein Drängen durfte ich die Schneiderei lernen und machte nun das ganze Martyrium eines Lehrmädchens durch.“"
                                            },
                                            {
                                                "example_id": "1ad4f471-0958-47fa-8085-9c29a3f1b358",
                                                "sense_id": "a0654324-8122-360e-93b1-5174e0e347b9",
                                                "text": "„Reithoffer erlernte in seinem Geburtsort die Schneiderei, ging auf Wanderschaft (Paris) und hörte chemische Vorlesungen an der Sorbonne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
