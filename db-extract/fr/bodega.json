                ],
                "translations": [
                    {
                        "translation_id": "6dbb0d90-c093-4361-8389-9534b3cbe515",
                        "source_entry_id": "158c2173-e8f2-3fe1-ad12-6316853f5082",
                        "source_sense_id": "f6fa1244-27dc-3506-8881-58514169bf9f",
                        "source_sense_description": "Gastronomie, Spanien und Südfrankreich: Bodega, Weinlokal",
                        "target_lang_word": "Bodega",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bodega",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3ee7fae-3297-367c-8290-b8bc7e2e63ca",
                                        "entry_id": "c779c4b3-fc25-3ec2-a740-b04ab6163c4d",
                                        "glosses": [
                                            "Bezeichnung für Orte in Spanien/Lateinamerika, an denen Wein verkauft oder ausgeschenkt wird (Weinkellereien, Weinhandlungen, Weinstuben)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff62afaf-81a6-43de-bc2d-1ac88006b433",
                                                "sense_id": "a3ee7fae-3297-367c-8290-b8bc7e2e63ca",
                                                "text": "„Gegen Mittag hatten sie eine Bodega ausfindig gemacht, eine schäbige, von einem Mann namens Frank Carroll betriebene Schnapsbude, die ursprünglich ein Stall gewesen war und deren Türen, die einzige Lichtquelle, zur Straße hin offen standen.“"
                                            },
                                            {
                                                "example_id": "68d31108-e9be-445f-b284-23772b23b70b",
                                                "sense_id": "a3ee7fae-3297-367c-8290-b8bc7e2e63ca",
                                                "text": "„Shaw parkte vor einer Bodega, ging hinein und erkaufte sich mit einem Schmiergeld von zwanzig Dollar sowie dem Erwerb mehrerer Tüten Lebensmittel, die er gar nicht benötigte, das Recht, sich zur Hintertür hinauszuschleichen.“"
                                            },
                                            {
                                                "example_id": "76fd65b1-a871-461a-b215-e91078db87a1",
                                                "sense_id": "a3ee7fae-3297-367c-8290-b8bc7e2e63ca",
                                                "text": "„Court reagierte überrascht, als Hanley auf der República de Ecuador vor einer Bodega stoppte und ohne ein weiteres Wort aus dem Auto sprang.“"
                                            },
                                            {
                                                "example_id": "4edae3a3-f5f9-4521-893d-ad54646ec0e6",
                                                "sense_id": "a3ee7fae-3297-367c-8290-b8bc7e2e63ca",
                                                "text": "„Soldaten und Kommissköppe stürzten Autos um, die vor einer Bodega geparkt waren, während Kadetten in kurzärmeligen weißen Hemden und weit ausgestellten weißen Hosen mit Knüppeln die Scheiße aus einer zahlenmäßig hoffnungslos unterlegenen Gruppe von Zooters auf dem Bürgersteig ein Haus weiter herausprügelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "158156fa-0597-422a-a11c-50e4ee9363dd",
                        "source_entry_id": "158c2173-e8f2-3fe1-ad12-6316853f5082",
                        "source_sense_id": "f6fa1244-27dc-3506-8881-58514169bf9f",
                        "source_sense_description": "Gastronomie, Spanien und Südfrankreich: Bodega, Weinlokal",
                        "target_lang_word": "Weinlokal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weinlokal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e05fde4e-4041-35ee-98fc-55d02ee027cc",
                                        "entry_id": "6710d257-c0a0-3c8b-966b-cba3e69242d1",
                                        "glosses": [
                                            "ein öffentliches Lokal, in dem vorwiegend Wein ausgeschenkt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3554110-aee3-42b8-a353-749e29aa0531",
                                                "sense_id": "e05fde4e-4041-35ee-98fc-55d02ee027cc",
                                                "text": "In der Innenstadt gibt es tolle Weinlokale."
                                            },
                                            {
                                                "example_id": "6cbbb336-86ac-46e8-ba64-e956d37e3dcf",
                                                "sense_id": "e05fde4e-4041-35ee-98fc-55d02ee027cc",
                                                "text": "„Ich sitze in dem behaglichen Sofa eines Weinlokals, vor mir steht ein Kühler mit Rheinwein, ich habe mir das erste Glas vollgeschenkt, führe es zum Munde und atme in tiefen Zügen den Duft des Weines ein.“"
                                            },
                                            {
                                                "example_id": "99527438-00ea-432e-bfc8-0471b08d0c97",
                                                "sense_id": "e05fde4e-4041-35ee-98fc-55d02ee027cc",
                                                "text": "„Vier Herren vom Gericht haben sich abends in einem Weinlokal verabredet.“"
                                            },
                                            {
                                                "example_id": "d8e84bb4-cb87-430e-be89-78ece3cba919",
                                                "sense_id": "e05fde4e-4041-35ee-98fc-55d02ee027cc",
                                                "text": "„Nach der Vorstellung gingen die beiden Freunde in ein intimes kleines Weinlokal, um die Eindrücke langsam verklingen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
