                ],
                "senses": [
                    {
                        "sense_id": "c1606f2b-e3e2-3669-9da5-7498e2ae71be",
                        "entry_id": "517cc57f-14f7-3426-8b27-ae25fe3395b8",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d32c357-0ab2-4154-bee5-72392e78de28",
                                "sense_id": "c1606f2b-e3e2-3669-9da5-7498e2ae71be",
                                "text": "Frau Federer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1b532e3d-dd6f-4bbc-bdc4-dced3d43d32b",
                                "sense_id": "c1606f2b-e3e2-3669-9da5-7498e2ae71be",
                                "text": "Herr Federer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cb62935a-c167-4dfc-9727-927cc2978eca",
                                "sense_id": "c1606f2b-e3e2-3669-9da5-7498e2ae71be",
                                "text": "Die Federers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "da8fa894-24bf-49e7-969d-447843584623",
                                "sense_id": "c1606f2b-e3e2-3669-9da5-7498e2ae71be",
                                "text": "Der Federer trägt nie die Schals, die die Federer ihm strickt."
                            },
                            {
                                "example_id": "19b3b9b7-d499-452e-99a5-39a1e1d4d0d3",
                                "sense_id": "c1606f2b-e3e2-3669-9da5-7498e2ae71be",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Federer kommt, geht der Herr Federer.“"
                            },
                            {
                                "example_id": "cda76308-5ff7-45cd-91e4-4d9578ba8bcf",
                                "sense_id": "c1606f2b-e3e2-3669-9da5-7498e2ae71be",
                                "text": "Federer kommt und geht."
                            },
                            {
                                "example_id": "a1b54bfb-fefb-44f4-88e1-4b02c1a4df72",
                                "sense_id": "c1606f2b-e3e2-3669-9da5-7498e2ae71be",
                                "text": "Federers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
