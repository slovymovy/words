                "senses": [
                    {
                        "sense_id": "4fc4c9a0-ccc6-3b60-8d5b-62d3930b244d",
                        "entry_id": "386fa625-95ec-3927-a33f-99e90fe7e53b",
                        "glosses": [
                            "związany z akumulatorem; wykorzystujący akumulator do zasilania"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc030bab-2da7-40c9-9b1e-153af532f83f",
                        "source_entry_id": "386fa625-95ec-3927-a33f-99e90fe7e53b",
                        "source_sense_id": "4fc4c9a0-ccc6-3b60-8d5b-62d3930b244d",
                        "target_lang_word": "Akkumulator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akkumulator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06e23d5c-9e6b-3a20-92ee-fa4fcfe03b16",
                                        "entry_id": "daadb775-0d23-34cb-940e-cf0006ae5976",
                                        "glosses": [
                                            "chemischer Energiespeicher, der elektrische Energie an einen Verbraucher abgeben kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ae6eb1-7915-4379-a6f2-eb3d2e3f2933",
                                                "sense_id": "06e23d5c-9e6b-3a20-92ee-fa4fcfe03b16",
                                                "text": "Es empfiehlt sich wiederaufladbare Batterien (Akkumulatoren) zu verwenden."
                                            },
                                            {
                                                "example_id": "91f11c4d-2a71-40f7-bd2e-c575fe6efe58",
                                                "sense_id": "06e23d5c-9e6b-3a20-92ee-fa4fcfe03b16",
                                                "text": "„Leider bestätigten die ersten Radionachrichten, von Leuten übermittelt, die ihre Apparate mit Akkumulatoren funktionstüchtig gemacht hatten, Vaters Optimismus nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb9dc3b6-ec33-3e12-8ff7-fdf9db19d830",
                                        "entry_id": "daadb775-0d23-34cb-940e-cf0006ae5976",
                                        "glosses": [
                                            "Speicherzelle/Register in einem Prozessor"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c98dafcc-e94f-47ec-9a70-eb4abd1bf8f8",
                                                "sense_id": "cb9dc3b6-ec33-3e12-8ff7-fdf9db19d830",
                                                "text": "Um die Addition vollziehen zu können muss der Wert in den Akkumulator geschrieben werden, das Ergebnis steht wiederum im Akkumulator."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9ff065e-a491-4a84-8dce-25bacbf02289",
                        "source_entry_id": "386fa625-95ec-3927-a33f-99e90fe7e53b",
                        "source_sense_id": "4fc4c9a0-ccc6-3b60-8d5b-62d3930b244d",
                        "target_lang_word": "Akku",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akku",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bbc78b7-d1f3-3fb3-9621-83766d65eff9",
                                        "entry_id": "36587622-df13-3335-99e8-ede42057dddf",
                                        "glosses": [
                                            "Akkumulator; eine wiederaufladbare Batterie"
                                        ],
                                        "tags": [
                                            "Kurzform"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e21a3e14-357d-467a-ab1d-09701f9bf83c",
                                                "sense_id": "4bbc78b7-d1f3-3fb3-9621-83766d65eff9",
                                                "text": "Ich betreibe meinen MP3-Spieler mit Akkus."
                                            },
                                            {
                                                "example_id": "c24aa7e0-e10f-4f2a-9ef3-c6a1136ec062",
                                                "sense_id": "4bbc78b7-d1f3-3fb3-9621-83766d65eff9",
                                                "text": "„Und weil die Montage eines zusätzlichen Steckers und ein paar weiterer Bauteile aus dem Regal jetzt den großen Aufwand nicht mehr bedeutet hat, machte Mercedes-Benz sein Brennstoffzellenauto gleich zum Plug-in-Hybrid, dessen Akku man an der Steckdose laden kann.“"
                                            },
                                            {
                                                "example_id": "84939fcf-097f-41fa-b30e-6542a9534eb8",
                                                "sense_id": "4bbc78b7-d1f3-3fb3-9621-83766d65eff9",
                                                "text": "„Ihm war gar nicht aufgefallen, dass der Akku sich entleert hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
