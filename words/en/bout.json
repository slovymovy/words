                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wedstrijd",
                                "target_lang_sense_clarification": "algemene term voor een sportieve competitie"
                            },
                            {
                                "target_lang_word": "partij",
                                "target_lang_sense_clarification": "specifiek gebruikt voor gevechtssporten zoals boksen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90227a96-24e6-3f98-a28d-f33c32df17e0",
                    "sense_definition": "A curved or bulging part of a musical instrument, especially the sides of a guitar.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guitar's lower <w>bout</w> is wider to provide better sound resonance.",
                            "target_lang_translations": {
                                "nl": "De onderste <w>welving</w> van de gitaar is breder voor een betere klankresonantie."
                            }
                        },
                        {
                            "text": "The luthier carefully shaped the <w>bout</w> of the violin to ensure perfect acoustics.",
                            "target_lang_translations": {
                                "nl": "De vioolbouwer vormde zorgvuldig de <w>welving</w> van de viool om een perfecte akoestiek te garanderen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gebogen of uitpuilend deel van een muziekinstrument, met name de zijkanten van een gitaar."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "klankkastvorm",
                                "target_lang_sense_clarification": "verwijst naar de welving van de kast"
                            },
                            {
                                "target_lang_word": "welving",
                                "target_lang_sense_clarification": "de fysieke kromming van het instrument"
                            }
                        ]
                    }
                }
            ]
        },
        {
