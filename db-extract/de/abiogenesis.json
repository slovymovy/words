                    {
                        "form_id": "ded2360d-131c-44b6-9624-4526c4ee2d26",
                        "entry_id": "f18f69d5-f94e-3ed0-a915-e043cdbd5c5d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Abiogenesis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "517e0156-24ce-3be1-850b-21262bfe988f",
                        "entry_id": "f18f69d5-f94e-3ed0-a915-e043cdbd5c5d",
                        "glosses": [
                            "Vorgang, bei dem Leben aus nicht belebter Materie entsteht („Urzeugung“)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19c6df0e-44ec-477c-a03b-4363915278b6",
                                "sense_id": "517e0156-24ce-3be1-850b-21262bfe988f",
                                "text": "„Herr Dr. Gscheidlen aus Breslau sprach über Abiogenesis. Jedem, der die Versuche von Schwann‚ Franz Schulze, Schroeder & Dusch, Pasteur kennt, muss sich die Ueberzeugung aufdrängen, dass niemals niedere Organismen aus gekochten organischen Flüssigkeiten bei Abhaltung der in der Luft schwebenden Keime entstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d7e91398-1d11-3909-8db6-517c00f7b8cf",
                        "entry_id": "f18f69d5-f94e-3ed0-a915-e043cdbd5c5d",
                        "glosses": [
                            "moderne Hypothese zur Entstehung organischer und biologischer Moleküle aus anorganischen Molekülen („chemische Evolution“, „abiotische“ oder „abiogene Synthese“)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc8bb2d1-8439-40aa-9e62-d456f8c2b096",
                                "sense_id": "d7e91398-1d11-3909-8db6-517c00f7b8cf",
                                "text": "Die Abiogenesis im Sinne einer abiotischen, abiogenen oder chemischen Synthese biologisch wichtiger Moleküle unter Bedingungen und ausgehend von einfachen, meist anorganischen Verbindungen, wie sie auf der Urerde in Form der reduzierenden Uratmosphäre bzw. als Bestandteile der \"Ursuppe\" (Urozean) angenommen werden, wurde erstmals von Stanley Lloyd Miller 1953 (Miller-Experiment) beschrieben."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7296e600-26f9-4ac8-8ee5-ad8ce9a43235",
                        "source_entry_id": "f18f69d5-f94e-3ed0-a915-e043cdbd5c5d",
                        "source_sense_id": "517e0156-24ce-3be1-850b-21262bfe988f",
                        "source_sense_description": "Biologie: Vorgang, bei dem Leben aus nicht belebter Materie entsteht; die Urzeugung",
                        "target_lang_word": "生命起源",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f499cf8b-b23c-4049-adc8-348c337fc940",
                        "source_entry_id": "f18f69d5-f94e-3ed0-a915-e043cdbd5c5d",
                        "source_sense_id": "517e0156-24ce-3be1-850b-21262bfe988f",
                        "source_sense_description": "Biologie: Vorgang, bei dem Leben aus nicht belebter Materie entsteht; die Urzeugung",
                        "target_lang_word": "abiogenesis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abiogenesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2b387b1-1966-38fd-be69-27844d283042",
                                        "entry_id": "2ab0f4cc-9eac-3340-8010-fc01263bfc8f",
                                        "glosses": [
                                            "The origination of living organisms from lifeless matter; such genesis as does not involve the action of living parents."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0eba6ea-4ea7-45e6-9a9a-52737cfc0f15",
                                                "sense_id": "b2b387b1-1966-38fd-be69-27844d283042",
                                                "text": "And thus the hypothesis that living matter always arises by the agency of pre-existing living matter, took definite shape; […] It will be necessary for me to refer to this hypothesis so frequently, that, to save circumlocution, I shall call it the hypothesis of Biogenesis; and I shall term the contrary doctrine—that living matter may be produced by not living matter—the hypothesis of Abiogenesis."
                                            },
                                            {
                                                "example_id": "7dc419f2-e964-45c1-88c9-0294fa5b65b0",
                                                "sense_id": "b2b387b1-1966-38fd-be69-27844d283042",
                                                "text": "The assertion of [Louis] Pasteur is justified, that the onus probandi [burden of proof] lies with abiogenesists, since there is no experience of any living form more than ¹⁄₁₀₀₀ of an inch in diameter springing to life out of inorganic matter; it is therefore vastly improbable (needing most cogent evidence to prove), that any form less than ¹⁄₁₀₀₀ of an inch in size can be made to spring into life from inorganic matter. While abiogenesis is unproved, we hold to the conclusion that vital force is not the mere outcome or resultant of any or all of the other cosmic forces."
                                            },
                                            {
                                                "example_id": "94d18ad0-3d8e-4b52-a3bb-9df810aaa6d2",
                                                "sense_id": "b2b387b1-1966-38fd-be69-27844d283042",
                                                "text": "Life began. There was one abiogenesis when something happened to turn inanimate matter into animate cells. And it happened only once. There are no abiogeneses today. Human life is continuous. Human persons are discontinuous and individual."
                                            },
                                            {
                                                "example_id": "36cdff8c-a382-4e62-8853-f7a74fd9e739",
                                                "sense_id": "b2b387b1-1966-38fd-be69-27844d283042",
                                                "text": "According to [Carl] Nägeli, the highest forms have evolved from the oldest cells produced through abiogenesis, and the lower forms are, depending on their position in the hierarchy, the descendants of respectively more recent abiogenesis."
                                            },
                                            {
                                                "example_id": "c0c2c9a6-7620-4aa4-ba4d-1fdd0581929e",
                                                "sense_id": "b2b387b1-1966-38fd-be69-27844d283042",
                                                "text": "Although abiogenesis, the spontaneous creation of a living system under appropriate conditions, must have occurred at the end of the prebiotic world, spontaneous generation of life no longer occurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba14e326-c47e-4ddd-a141-9d22361212bd",
                        "source_entry_id": "f18f69d5-f94e-3ed0-a915-e043cdbd5c5d",
                        "source_sense_id": "517e0156-24ce-3be1-850b-21262bfe988f",
                        "source_sense_description": "Biologie: Vorgang, bei dem Leben aus nicht belebter Materie entsteht; die Urzeugung",
                        "target_lang_word": "abiogenèse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abiogenèse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be2c76d9-662e-3ab9-9bca-fa06f8914ce3",
                                        "entry_id": "ea71e191-6c73-37f5-8ec8-11160167d621",
                                        "glosses": [
                                            "Ensemble des théories expliquant l'émergence de la vie à partir de matière inorganique inanimée."
                                        ],
                                        "tags": [
                                            "Astrobiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b78a07cb-84ed-45ac-80f4-18c2fc282a46",
                                                "sense_id": "be2c76d9-662e-3ab9-9bca-fa06f8914ce3",
                                                "text": "Les biologistes d’aujourd'hui sont dans leur très grande majorité des tenants de l’abiogenèse."
                                            },
                                            {
                                                "example_id": "70b7e5b0-e347-4483-b37a-2b52c45c26ff",
                                                "sense_id": "be2c76d9-662e-3ab9-9bca-fa06f8914ce3",
                                                "text": "Ainsi, il n’est pas exclu que, si les événements qui ont conduit à la vie terrestre sont extrêmement rares, peu importe qu’il y ait des centaines de milliards d’étoiles dans des milliards de galaxies, les nombreux systèmes stellaires seraient insuffisants, statistiquement, pour donner lieu à l’abiogenèse ailleurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b47f064-19f6-4d6c-9801-005412b93020",
                        "source_entry_id": "f18f69d5-f94e-3ed0-a915-e043cdbd5c5d",
                        "source_sense_id": "517e0156-24ce-3be1-850b-21262bfe988f",
                        "source_sense_description": "Biologie: Vorgang, bei dem Leben aus nicht belebter Materie entsteht; die Urzeugung",
                        "target_lang_word": "abiogeneza",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abiogeneza",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "bf332d4d-ed52-37d9-8c0f-3aa0670691fe",
                                        "entry_id": "45ae9855-89e1-3528-a696-a86470b9255d",
                                        "glosses": [
                                            "spontaniczne powstawanie życia z materii nieożywionej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fb4998d-457f-4e20-9763-5a223782a5ee",
                                                "sense_id": "bf332d4d-ed52-37d9-8c0f-3aa0670691fe",
                                                "text": "Pierwszym krokiem obalającym teorię arystotelowskiej abiogenezy było wykazanie przez Włocha Francesco Rediego w 1668, że robaki obserwowane w gnijącym mięsie nie powstają samoistnie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b76e198-6c8e-40df-93a1-80c3b8ea0a54",
