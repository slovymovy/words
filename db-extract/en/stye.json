                                                "sense_id": "742f7dbc-7096-3370-8249-8508e52b276b",
                                                "text": "Ich habe ein Gerstenkorn am linken Auge."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
