                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1aac0274-8259-4113-8982-d3e0168d68cb",
                        "entry_id": "2fb147d9-19cb-37ff-a432-0e2bad44937c",
                        "tags": [],
                        "form": "sport boules"
