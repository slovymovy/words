                    {
                        "translation_id": "d6825806-4889-467c-a009-7ca70ef25dc5",
                        "source_entry_id": "dc97f6ad-89bd-3d68-8182-b0f63ba404c3",
                        "source_sense_id": "fe791bef-0062-3dbf-a9fb-89365a679b67",
