    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f5994590-2260-3ce1-bb82-331c4bee5dab",
                "word": "incision",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2ec9d7aa-a042-48c4-aa5e-468745f0ff7d",
                        "entry_id": "f5994590-2260-3ce1-bb82-331c4bee5dab",
                        "tags": [
                            "plural"
                        ],
                        "form": "incisions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7568ba3c-7b6f-303b-bc27-2668a4a9bc93",
                        "entry_id": "f5994590-2260-3ce1-bb82-331c4bee5dab",
                        "glosses": [
                            "A cut, especially one made by a scalpel or similar medical tool in the context of surgical operation; the scar resulting from such a cut."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c5edf989-c715-4701-9589-96e16ff8198f",
                                "sense_id": "7568ba3c-7b6f-303b-bc27-2668a4a9bc93",
                                "text": "Wrath-kindled gentlemen, be ruled by me;\nLet’s purge this choler without letting blood:\nThis we prescribe, though no physician;\nDeep malice makes too deep incision;"
                            },
                            {
                                "example_id": "6067c5dc-c83e-4a06-88ec-6d13af85bdb7",
                                "sense_id": "7568ba3c-7b6f-303b-bc27-2668a4a9bc93",
                                "text": "Gunch was so humorous that Mrs. Babbitt said he must “stop making her laugh because honestly it was hurting her incision.”"
                            },
                            {
                                "example_id": "a9666ae1-3108-4c74-a16f-c9898eb71979",
                                "sense_id": "7568ba3c-7b6f-303b-bc27-2668a4a9bc93",
                                "text": "In the midst of the men a black upright stove sends out its heat. On the glowing holes at the top Ya‘qub Artin has carefully placed some chestnuts, each with a neat incision in its side."
                            }
                        ]
                    },
                    {
                        "sense_id": "13264132-543c-374a-bb81-1087649369fa",
                        "entry_id": "f5994590-2260-3ce1-bb82-331c4bee5dab",
                        "glosses": [
                            "The act of cutting into a substance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b487a1d0-07a4-4f74-bd83-6fa4343d4beb",
                                "sense_id": "13264132-543c-374a-bb81-1087649369fa",
                                "text": "The parte of Euacuation by lettyng of blud, is incision or cuttyng of the vayne, wherby the bloud, whiche is cause of syckenes or grefe to the hole body, or any particular part therof, doth most aptly passe."
                            },
                            {
                                "example_id": "3b666eab-75e4-4d0b-80cc-c82914897d27",
                                "sense_id": "13264132-543c-374a-bb81-1087649369fa",
                                "text": "Never considering […] that these miseries of the people are still his own handy work, having smitt’n them like a forked Arrow so sore into the Kingdoms side, as not to be drawn out and cur’d without the incision of more flesh."
                            },
                            {
                                "example_id": "facd6d95-db26-4a4d-acb1-6b64a7747fab",
                                "sense_id": "13264132-543c-374a-bb81-1087649369fa",
                                "text": "Mnesarchus, early as a sculptor known,\nFrom nice incision of the costly stone,"
                            },
                            {
                                "example_id": "36071a01-5730-4a5d-b4b2-11a86653a4ca",
                                "sense_id": "13264132-543c-374a-bb81-1087649369fa",
                                "text": "Slowly, as meticulously as if engaged upon a surgical incision, Mr Nox opened his mail."
                            }
                        ]
                    },
                    {
                        "sense_id": "4806cdc5-2939-3368-a46c-b5fd6ea80a85",
                        "entry_id": "f5994590-2260-3ce1-bb82-331c4bee5dab",
                        "glosses": [
                            "Separation or solution of viscid matter by medicines."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "412d36b9-5437-3f2d-b2a9-76e53e13f53d",
                        "entry_id": "f5994590-2260-3ce1-bb82-331c4bee5dab",
                        "glosses": [
                            "A cut-back"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "aa7f3162-67cd-4d42-afa5-c928b9180dcc",
                                "sense_id": "412d36b9-5437-3f2d-b2a9-76e53e13f53d",
                                "text": "Riyad Mahrez also dragged wide after a De Bruyne incision."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc2444ff-1d4e-4e05-9934-118d3ac9a820",
                        "source_entry_id": "f5994590-2260-3ce1-bb82-331c4bee5dab",
                        "source_sense_description": "cut",
                        "target_lang_word": "incision",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incision",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3cc5760-3b73-3506-b52e-66a3db8634c0",
                                        "entry_id": "ece77355-393c-36f1-850a-5191cfaec701",
                                        "glosses": [
                                            "Action d’inciser ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fa4c24b-62da-4757-a150-d847a893b8e6",
                                                "sense_id": "d3cc5760-3b73-3506-b52e-66a3db8634c0",
                                                "text": "Faire une incision à l’écorce d’un arbre pour le greffer."
                                            },
                                            {
                                                "example_id": "5721eafe-087b-4fc8-8590-32f0a5583d1c",
                                                "sense_id": "d3cc5760-3b73-3506-b52e-66a3db8634c0",
                                                "text": "Faire une incision dans les chairs, au bras, à la cuisse."
                                            },
                                            {
                                                "example_id": "a3a745cb-f972-4c56-8238-e8acc91e2838",
                                                "sense_id": "d3cc5760-3b73-3506-b52e-66a3db8634c0",
                                                "text": "Chacun d’eux s’approcha d’une vache et chacun, de la pointe effilée de sa lance, fit une incision très mince au cou de l’animal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfaa1b8e-8c2a-39b5-a06e-810c1313b116",
                                        "entry_id": "ece77355-393c-36f1-850a-5191cfaec701",
                                        "glosses": [
                                            "Coupure dans une couche de terrain."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aab9d523-5e48-4fa9-a9e8-7e4a2980368c",
                                                "sense_id": "dfaa1b8e-8c2a-39b5-a06e-810c1313b116",
                                                "text": "Plus au Nord, après l’incision de la Sallanches, on retrouve plusieurs cordons morainiques entre les hameaux de Ste Anne (840 m) et le Crêt (725 m)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84631623-5aca-4092-9712-67183f8d4718",
                        "source_entry_id": "f5994590-2260-3ce1-bb82-331c4bee5dab",
                        "source_sense_description": "cut",
                        "target_lang_word": "Einschnitt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einschnitt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b7d1692-6ebc-3c0b-aa69-38061a9b3255",
                                        "entry_id": "ab81679a-96b5-373e-93f4-f5c093ad3ab0",
                                        "glosses": [
                                            "das Schneiden in etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e09f7eaf-b58d-44e8-aec2-f117bdcf1b36",
                                                "sense_id": "4b7d1692-6ebc-3c0b-aa69-38061a9b3255",
                                                "text": "„Damit Sie den Rock später leichter an- und ausziehen können, machen Sie einen Einschnitt vom Innenkreis zirka 17 cm Richtung Saum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1615057-f0ca-3e17-96eb-efbe5f8f4ec4",
                                        "entry_id": "ab81679a-96b5-373e-93f4-f5c093ad3ab0",
                                        "glosses": [
                                            "(scheinbar) durch Schneiden in etwas getriebene Kerbe, auch durch Abtragung entstandene Vertiefung im Gelände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5492d647-54c1-4e39-9e79-aca93a7c9ed5",
                                                "sense_id": "e1615057-f0ca-3e17-96eb-efbe5f8f4ec4",
                                                "text": "„Befindet sich der Einschnitt an der Blattspitze und der Stiel an der anderen Seite, ist das Blatt verkehrt herzförmig.“"
                                            },
                                            {
                                                "example_id": "43b17a98-0c1b-431d-b5a8-e5b57fb5159c",
                                                "sense_id": "e1615057-f0ca-3e17-96eb-efbe5f8f4ec4",
                                                "text": "„Noch kritischer als beim Damm ist die Hangneigung bei Einschnitten zu beurteilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5731450f-094d-3293-ac25-ee341849a864",
                                        "entry_id": "ab81679a-96b5-373e-93f4-f5c093ad3ab0",
                                        "glosses": [
                                            "Ereignis, das einen Ablauf entscheidend verändert"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca472568-0987-4383-ae2d-37443c249f14",
                                                "sense_id": "5731450f-094d-3293-ac25-ee341849a864",
                                                "text": "„Dies liegt laut Ministerium vor allem an dem durch die Strafe verursachten drastischen Einschnitt in die Lebenswelt des Verurteilten.“"
                                            },
                                            {
                                                "example_id": "fa54ce64-9bb3-4f81-bb9c-67daf9c09cda",
                                                "sense_id": "5731450f-094d-3293-ac25-ee341849a864",
                                                "text": "„Für die taiwanesische Geschichte markiert der Friedensvertrag einen tiefen Einschnitt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "89da9a64-4ceb-34f0-b774-1ddc24aa2982",
                                        "entry_id": "ab81679a-96b5-373e-93f4-f5c093ad3ab0",
                                        "glosses": [
                                            "Maßnahme, die zu wirtschaftlicher Verschlechterung für jemanden führt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a6b4dd-0387-4475-a647-e7b984251cf7",
                                                "sense_id": "89da9a64-4ceb-34f0-b774-1ddc24aa2982",
                                                "text": "„Er befürchte zweistellige Einschnitte bei den Agrar-Umweltmaßnahmen, sagte Bonde am Freitag in Stuttgart.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
