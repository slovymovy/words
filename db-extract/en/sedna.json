                    {
                        "translation_id": "d51b0b73-ffa7-4b0e-8fbd-25f328e8a7bd",
                        "source_entry_id": "147cc77a-cac5-3ff5-8921-ac616d9d3467",
                        "source_sense_description": "planetoid",
                        "target_lang_word": "Sedna",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sedna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32019209-07ba-3441-a9ce-056a92b5691e",
                                        "entry_id": "84a7b0ca-5559-3c02-a5e7-258ef6f92145",
                                        "glosses": [
                                            "großes transneptunisches Objekt jenseits des Kuipergürtels, das höchstwahrscheinlich zu den Zwergplaneten gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76993c68-8d1a-4228-9beb-5d46fe0d969a",
                                                "sense_id": "32019209-07ba-3441-a9ce-056a92b5691e",
                                                "text": "Sedna wurde am 14. November 2003 entdeckt."
                                            },
                                            {
                                                "example_id": "9f11aebf-1bab-436a-b05a-f25581f017b4",
                                                "sense_id": "32019209-07ba-3441-a9ce-056a92b5691e",
                                                "text": "Sednas Oberfläche ist rot gefärbt."
                                            },
                                            {
                                                "example_id": "cbf7acda-03c7-4802-8ecd-96e16f7df959",
                                                "sense_id": "32019209-07ba-3441-a9ce-056a92b5691e",
                                                "text": "„Sedna hat einen Durchmesser von höchstens 1600 Kilometern, das entspricht etwa drei Vierteln der Größe Plutos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Sedna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8bf5bba0-3d1d-3475-8842-b3defd185107",
                                        "entry_id": "f2f8ed2b-d8b0-3cd6-b369-94292d223d08",
                                        "glosses": [
                                            "Meeresgöttin der Inuit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0b34d80-0617-4cbf-bb1b-378c5cec3ea9",
                                                "sense_id": "8bf5bba0-3d1d-3475-8842-b3defd185107",
                                                "text": "„Sedna bestimmte darüber, welche und wie viele Meerestiere gefangen und gegessen werden durften.“"
                                            },
                                            {
                                                "example_id": "a70ed489-114a-4723-96ed-d84ea922a223",
                                                "sense_id": "8bf5bba0-3d1d-3475-8842-b3defd185107",
                                                "text": "„Sie dankten gemeinsam der Meeresgöttin Sedna, denn diese hatte die verstorbenen Eltern bei sich aufgenommen und als Zeichen das Wasser mit Nahrung gefüllt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
