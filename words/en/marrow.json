{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff8991c8-2e74-3023-8775-22ec7109990b",
                    "sense_definition": "The soft, fatty substance inside bones which produces blood cells.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bone_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that the patient's bone <w>marrow</w> was healthy and producing enough red blood cells.",
                            "target_lang_translations": {
                                "pl": "Lekarz wyjaśnił, że <w>szpik kostny</w> pacjenta jest zdrowy i produkuje wystarczającą ilość czerwonych krwinek."
                            }
                        },
                        {
                            "text": "The cold wind was so intense that she felt chilled to the <w>marrow</w>.",
                            "target_lang_translations": {
                                "pl": "Zimny wiatr był tak silny, że poczuła się przemarznięta do <w>szpiku</w> kości."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bone marrow",
                        "chilled to the marrow"
                    ],
                    "target_lang_definitions": {
                        "pl": "Miękka, tłusta substancja wewnątrz kości, która wytwarza komórki krwi."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szpik kostny",
                                "target_lang_sense_clarification": "tkanka wewnątrz kości"
                            },
                            {
                                "target_lang_word": "szpik",
                                "target_lang_sense_clarification": "skrócona nazwa tkanki kostnej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20d10b0a-41e2-33ee-9245-1e1b5ed98369",
                    "sense_definition": "A large, elongated green vegetable with a thick skin, similar to a large zucchini.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vegetable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We harvested a giant <w>marrow</w> from our garden and decided to stuff it with rice and herbs.",
                            "target_lang_translations": {
                                "pl": "Zebraliśmy z naszego ogrodu gigantycznego <w>kabaczka</w> i postanowiliśmy nafaszerować go ryżem i ziołami."
                            }
                        },
                        {
                            "text": "She sliced the fresh <w>marrow</w> into thick rounds before roasting them in the oven.",
                            "target_lang_translations": {
                                "pl": "Pokroiła świeżego <w>kabaczka</w> na grube plastry przed upieczeniem ich w piekarniku."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vegetable marrow"
                    ],
                    "target_lang_definitions": {
                        "pl": "Duże, podłużne zielone warzywo o grubej skórce, podobne do dużej cukinii."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kabaczek",
                                "target_lang_sense_clarification": "warzywo, odmiana dyni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eccc42b9-d2f9-3a7a-b408-c14faa1ed6a5",
                    "sense_definition": "The essential or most vital part of something; the core or essence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "essence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His speech cut straight to the <w>marrow</w> of the issue, addressing the core problems directly.",
                            "target_lang_translations": {
                                "pl": "Jego przemówienie trafiało prosto w <w>sedno</w> sprawy, bezpośrednio poruszając kluczowe problemy."
                            }
                        },
                        {
                            "text": "To understand the <w>marrow</w> of the book, one must read between the lines.",
                            "target_lang_translations": {
                                "pl": "Aby zrozumieć <w>istotę</w> tej książki, trzeba czytać między wierszami."
                            }
                        }
                    ],
                    "synonyms": [
                        "core",
                        "essence",
                        "heart",
                        "kernel",
                        "pith",
                        "substance"
                    ],
                    "common_phrases": [
                        "pith and marrow"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in literary or figurative contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Istota, sedno lub najważniejsza część czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "sedno",
                                "target_lang_sense_clarification": "istota sprawy"
                            },
                            {
                                "target_lang_word": "szpik",
                                "target_lang_sense_clarification": "przenośnie, np. do szpiku kości"
                            },
                            {
                                "target_lang_word": "istota",
                                "target_lang_sense_clarification": "główny sens"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f258b73-12e3-3555-a3ec-3cda17599cd7",
                    "sense_definition": "The soft, spongy tissue or pith found inside the stems of certain plants.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "plant_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist carefully sliced the stem to examine the soft <w>marrow</w> inside.",
                            "target_lang_translations": {
                                "pl": "Botanik ostrożnie przekroił łodygę, aby zbadać miękki <w>rdzeń</w> w środku."
                            }
                        },
                        {
                            "text": "In some plant species, the inner <w>marrow</w> stores essential nutrients during dry seasons.",
                            "target_lang_translations": {
                                "pl": "U niektórych gatunków roślin wewnętrzny <w>rdzeń</w> magazynuje niezbędne składniki odżywcze podczas poru suchej."
                            }
                        }
                    ],
                    "synonyms": [
                        "pith"
                    ],
                    "target_lang_definitions": {
                        "pl": "Miękka, gąbczasta tkanka lub rdzeń wewnątrz łodyg niektórych roślin."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rdzeń",
                                "target_lang_sense_clarification": "tkanka wewnątrz łodygi rośliny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8520d9e6-1b4c-393a-901c-fd6937fc5fd8",
                    "sense_definition": "A friend, companion, or work partner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "friend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went down to the local pub to have a pint with his old <w>marrow</w>.",
                            "target_lang_translations": {
                                "pl": "Poszedł do lokalnego pubu, aby wypić piwo ze swoim starym <w>kamratem</w>."
                            }
                        },
                        {
                            "text": "The two miners worked side by side, each trusting his <w>marrow</w> completely.",
                            "target_lang_translations": {
                                "pl": "Dwaj górnicy pracowali ramię w ramię, a każdy z nich całkowicie ufał swojemu <w>koledze</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly used in Northern England and Scotland"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally among friends"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Przyjaciel, towarzysz lub partner z pracy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kolega",
                                "target_lang_sense_clarification": "towarzysz pracy lub znajomy"
                            },
                            {
                                "target_lang_word": "kamrat",
                                "target_lang_sense_clarification": "towarzysz, przyjaciel"
                            }
                        ]
                    }
                }
            ]
        },
        {
