    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a141108e-27d0-3716-8b27-93bd1a64acb1",
                    "sense_definition": "present participle and gerund of <w>surrender</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The enemy forces are finally <w>surrendering</w> after a long and exhausting battle.",
                            "target_lang_translations": {
                                "ru": "Вражеские войска наконец <w>сдаются</w> после долгой и изнурительной битвы."
                            }
                        },
                        {
                            "text": "By <w>surrendering</w> his passport, he complied with the strict bail conditions set by the judge.",
                            "target_lang_translations": {
                                "ru": "<w>Сдав</w> свой паспорт, он выполнил строгие условия залога, установленные судьей."
                            }
                        }
                    ],
                    "synonyms": [
                        "yielding",
                        "capitulating",
                        "conceding"
                    ],
                    "antonyms": [
                        "resisting"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «surrender»: сдаваться, капитулировать или добровольно отдавать/передавать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдаваться",
                                "target_lang_sense_clarification": "о капитуляции или прекращении сопротивления"
                            },
                            {
                                "target_lang_word": "капитулировать",
                                "target_lang_sense_clarification": "о признании поражения"
                            },
                            {
                                "target_lang_word": "сдавать",
                                "target_lang_sense_clarification": "добровольно передавать документы, оружие или права"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e26f45f-9b66-3679-937c-ae45b3c463ca",
                    "sense_definition": "An instance or act of yielding, submitting, or giving up control to another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His continuous <w>surrendering</w> of power to the committee gradually weakened his executive position.",
                            "target_lang_translations": {
                                "ru": "Его постоянная <w>уступка</w> власти комитету постепенно ослабила его руководящую позицию."
                            }
                        },
                        {
                            "text": "The treaty documented the formal <w>surrendering</w> of the disputed border territories.",
                            "target_lang_translations": {
                                "ru": "Договор зафиксировал официальную <w>сдачу</w> спорных приграничных территорий."
                            }
                        }
                    ],
                    "synonyms": [
                        "surrender",
                        "capitulation",
                        "relinquishment"
                    ],
                    "antonyms": [
                        "resistance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или процесс уступки, сдачи, подчинения или передачи контроля кому-либо другому."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдача",
                                "target_lang_sense_clarification": "акт капитуляции или передачи контроля, территории"
                            },
                            {
                                "target_lang_word": "уступка",
                                "target_lang_sense_clarification": "передача власти или прав другому лицу"
                            },
                            {
                                "target_lang_word": "капитуляция",
                                "target_lang_sense_clarification": "официальное прекращение сопротивления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}