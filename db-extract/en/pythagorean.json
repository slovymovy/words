                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe23995-931b-40c9-b65b-fe3ba6850bb3",
                                "sense_id": "80e04456-b677-31df-b8dd-723e2b5927f5",
                                "text": "Plato could still speak the language of archaic myth. He could speak it, because he was a Pythagorean, and myth was their technical language."
                            },
                            {
                                "example_id": "123fefaa-75e7-488d-921c-3fc1adb81cd3",
                                "sense_id": "80e04456-b677-31df-b8dd-723e2b5927f5",
                                "text": "Plato clearly distinguished the Orphics and the Pythagoreans."
                            }
                        ]
