                        "cross_references": [
                            {
                                "target_word": "либертарианство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "906337b6-ac60-3c41-9642-01167a884dbb",
                                        "entry_id": "1d945caa-a5a3-3763-8d2c-1503bf1cbcae",
                                        "glosses": [
                                            "совокупность взглядов и убеждений, отстаивающих свободу в выборе способов удовлетворения чувственной страсти и полового партнёра из лиц своего пола"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28e9a7cc-c134-395b-8bad-44cd6007e8a7",
                                        "entry_id": "1d945caa-a5a3-3763-8d2c-1503bf1cbcae",
                                        "glosses": [
                                            "экон. экономическая философия, которая уделяла особое внимание личной свободе в экономической и политической деятельности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58f7fd49-6b11-4679-9b42-1f7619706230",
                                                "sense_id": "28e9a7cc-c134-395b-8bad-44cd6007e8a7",
                                                "text": "У современного понимания коммерческого права и контрактных юрисдикций существуют общие идейные корни — философия экономической свободы, получившая наименование либертарианства."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a58a2b6-9902-3efc-9c38-487b425db856",
                                        "entry_id": "1d945caa-a5a3-3763-8d2c-1503bf1cbcae",
                                        "glosses": [
                                            "полит. идеологическое течение широкого спектра, отстаивающее максимальные права индивидуума и ограничение влияния государства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e43bffcf-0a8d-4f58-88b3-66f248bbf622",
                                                "sense_id": "2a58a2b6-9902-3efc-9c38-487b425db856",
                                                "text": "Американское либертарианство — справа и европейский анархизм — слева вообще подвергают сомнению само право государства на существование, утверждая, что существование человеческого общества возможно без государства."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
