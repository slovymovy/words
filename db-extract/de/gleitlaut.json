                ],
                "senses": [
                    {
                        "sense_id": "760ee70a-8817-39ce-a396-99ed1ae52c0e",
                        "entry_id": "489463da-edd3-3409-9007-4e7ccb854805",
                        "glosses": [
                            "Halbvokal/Halbkonsonant; zweiter Teil eines Diphthongs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4971449a-0300-4dae-bb8b-3bc4cfe047d3",
                                "sense_id": "760ee70a-8817-39ce-a396-99ed1ae52c0e",
                                "text": "Im Deutschen sind als Gleitlaute vor allem die Laute [i̯, ʊ̯] in Diphthongen und in Fremdwörtern zu beachten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1faf165a-8b13-301b-b7ac-391be51b78b4",
                        "entry_id": "489463da-edd3-3409-9007-4e7ccb854805",
                        "glosses": [
                            "Lauteinschub, Epenthese"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79305628-0886-4709-af7f-d06611ff9e84",
                                "sense_id": "1faf165a-8b13-301b-b7ac-391be51b78b4",
                                "text": "In manchen Wörtern dienen Gleitlaute als Epenthesen der Vermeidung von Hiaten (Vokalfolgen) wie im Falle von [n] in \"afrika-n-isch\". Auch [t] in Wörtern wie \"eigen-t-lich\", \"willen-t-lich\" wird als Gleitlaut angesehen."
                            },
                            {
                                "example_id": "f76b696c-694b-4ebb-9168-37fe0e510e00",
                                "sense_id": "1faf165a-8b13-301b-b7ac-391be51b78b4",
                                "text": "„Es sind ‚Fugenelemente‘ der Komposita, Gleitlaute, die der Ausspracheerleichterung dienen.“"
                            },
                            {
                                "example_id": "ba7d6676-3efb-4063-983b-98d60172116d",
                                "sense_id": "1faf165a-8b13-301b-b7ac-391be51b78b4",
                                "text": "„Nach unbetonter Silbe erscheint t als Gleitlaut zwischen n und l vor allem auf mitteldeutschem Boden seit mittelhochdeutscher Zeit häufig und wird schriftsprachlich fest, vergleiche eigentlich, namentlich, ordentlich undsoweiter.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "99c75389-69ea-37b2-ac3e-e120ad18ec24",
                        "entry_id": "489463da-edd3-3409-9007-4e7ccb854805",
                        "glosses": [
                            "in älteren Werken zur Phonetik Oberbegriff für die Übergangsphasen zwischen zwei Lauten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2177c13b-62c4-4004-9bc6-6e66accae91f",
                                "sense_id": "99c75389-69ea-37b2-ac3e-e120ad18ec24",
                                "text": "Bei Jespersen steht Gleitlaut im Index mit Verweis auf \"Anglitt\" und \"Abglitt\" (= Bewegung der Artikulationsorgane hin zum beabsichtigten Laut (= Anglitt) und weg von ihm (= Abglitt))."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6b71b0c-1652-427b-b87d-04cd2d71b62e",
                        "source_entry_id": "489463da-edd3-3409-9007-4e7ccb854805",
                        "source_sense_id": "760ee70a-8817-39ce-a396-99ed1ae52c0e",
                        "source_sense_description": "Linguistik: Halbvokal/Halbkonsonant; zweiter Teil eines Diphthongs",
                        "target_lang_word": "glide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                        "entry_id": "7cebde08-75e5-335b-b82e-ae819456da9c",
                                        "glosses": [
                                            "To move softly, smoothly, or effortlessly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e99af96-d036-43f5-aec0-e0d27c1598b6",
                                                "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                                "text": "The river glideth at his own sweet will:"
                                            },
                                            {
                                                "example_id": "107c0741-19cd-47d4-adb5-587cacc21218",
                                                "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                                "text": "It is odd how easily the common-places of morality or of sentiment glide off in conversation. Well, they are \"exceedingly helpful,\" and so Lord Avonleigh found them."
                                            },
                                            {
                                                "example_id": "126f4aed-cffa-4fad-8ebc-81c71a4def0c",
                                                "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                                "text": "The water over which the boats glided was black and smooth, rising into huge foamless billows, the more terrible because they were silent."
                                            },
                                            {
                                                "example_id": "187ceac6-f2ce-4a45-ae44-678a405c5957",
                                                "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                                "text": "But it was 37-year-old Giggs who looked like a care-free teenager as he glided across the pitch he knows so well to breathtaking effect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c9d5b32-1d76-3a08-925b-d345a36e7039",
                                        "entry_id": "7cebde08-75e5-335b-b82e-ae819456da9c",
                                        "glosses": [
                                            "To fly unpowered, as of an aircraft. Also relates to gliding birds and flying fish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "022507fa-3c3d-40db-85d2-04867e856d90",
                                                "sense_id": "9c9d5b32-1d76-3a08-925b-d345a36e7039",
                                                "text": "The tide was out, and we drew up amid the strong bracing smell of seaweed, with gulls screeching, wheeling around, and gliding on the wind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f357a393-8dc0-309d-a7d6-d78f2282d84c",
                                        "entry_id": "7cebde08-75e5-335b-b82e-ae819456da9c",
                                        "glosses": [
                                            "To cause to glide."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9389a0b-a587-351c-b292-7a646b56b138",
                                        "entry_id": "7cebde08-75e5-335b-b82e-ae819456da9c",
                                        "glosses": [
                                            "To pass with a glide, as the voice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
