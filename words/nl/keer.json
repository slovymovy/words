    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e45220b2-8204-3f69-81ca-48e06caddd90",
                    "sense_definition": "Een specifiek moment of een gelegenheid waarbij iets gebeurt.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "gelegenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is de eerste <w>keer</w> dat ik naar Parijs reis.",
                            "target_lang_translations": {
                                "en": "This is the first <w>time</w> that I am traveling to Paris.",
                                "ru": "Это первый <w>раз</w>, когда я еду в Париж."
                            }
                        },
                        {
                            "text": "Ik heb die film al een <w>keer</w> gezien.",
                            "target_lang_translations": {
                                "en": "I have seen that movie <w>once</w> already.",
                                "ru": "Я уже видел этот фильм один <w>раз</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "maal"
                    ],
                    "common_phrases": [
                        "een keer",
                        "volgende keer",
                        "vorige keer",
                        "elke keer"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific moment or an occasion when something happens.",
                        "ru": "Конкретный момент или случай, когда что-то происходит."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "an instance or occurrence"
                            },
                            {
                                "target_lang_word": "occasion",
                                "target_lang_sense_clarification": "a particular time or event"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "раз",
                                "target_lang_sense_clarification": "случай или повторение действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adeb2084-7092-33cb-a11c-f6b37f78cce7",
                    "sense_definition": "Een verandering van richting of een omslag in een situatie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na veel tegenslagen hoopten ze op een <w>keer</w> van geluk.",
                            "target_lang_translations": {
                                "en": "After many setbacks, they hoped for a <w>turn</w> of luck.",
                                "ru": "После многих неудач они надеялись на <w>поворот</w> удачи."
                            }
                        },
                        {
                            "text": "Zijn optreden markeerde een belangrijke <w>keer</w> in de wedstrijd.",
                            "target_lang_translations": {
                                "en": "His performance marked an important <w>turning point</w> in the match.",
                                "ru": "Его выступление ознаменовало важный <w>поворот</w> в матче."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een keer ten goede"
                    ],
                    "target_lang_definitions": {
                        "en": "A change of direction or a turning point in a situation.",
                        "ru": "Изменение направления или переломный момент в ситуации."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "a change in course or circumstances"
                            },
                            {
                                "target_lang_word": "turning point",
                                "target_lang_sense_clarification": "a decisive change in a situation"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "поворот",
                                "target_lang_sense_clarification": "изменение в ходе событий или обстоятельств"
                            },
                            {
                                "target_lang_word": "перемена",
                                "target_lang_sense_clarification": "значительное изменение ситуации"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7756f8d-315e-3a1f-98d4-120d76ba1bf2",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>keren</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>keer</w> de auto in de smalle straat.",
                            "target_lang_translations": {
                                "en": "I <w>turn</w> the car in the narrow street.",
                                "ru": "Я <w>разворачиваю</w> машину на узкой улице."
                            }
                        },
                        {
                            "text": "Ik <w>keer</w> me om als ik mijn naam hoor.",
                            "target_lang_translations": {
                                "en": "I <w>turn</w> around when I hear my name.",
                                "ru": "Я <w>оборачиваюсь</w>, когда слышу своё имя."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of 'keren' (to turn).",
                        "ru": "Форма первого лица единственного числа настоящего времени глагола 'keren' (поворачивать)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "to change direction or rotate"
                            }
                        ],
                        "ru": [
