        "fr-extract.jsonl": [
            {
                "entry_id": "fc82360e-6065-3c8c-b20f-bcaf4fe1e238",
                "word": "folâtre",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9604c333-04d7-4ed2-b1d0-b455ef810328",
                        "entry_id": "fc82360e-6065-3c8c-b20f-bcaf4fe1e238",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "folâtres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3bcd020e-a391-3db2-bf7e-a2517f5d2144",
                        "entry_id": "fc82360e-6065-3c8c-b20f-bcaf4fe1e238",
                        "glosses": [
                            "Qui aime à badiner, à jouer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49bccbd4-caf3-4bd8-818b-2b22c4a2c25b",
                                "sense_id": "3bcd020e-a391-3db2-bf7e-a2517f5d2144",
                                "text": "À une petite distance de la bicoque de Dieu le père, le Pape-Dieu rencontra une troupe folâtre de femmes et de jeunes filles, parées d’étoffes voyantes et bigarrées."
                            },
                            {
                                "example_id": "ab8acdf8-ca54-468b-9cb6-7fbe4eb8b956",
                                "sense_id": "3bcd020e-a391-3db2-bf7e-a2517f5d2144",
                                "text": "On ne pouvait rien voir de plus gracieux que cette svelte blondine, jeune, gaie, folâtre ; pas un homme qui eût résisté à ses agaceries."
                            },
                            {
                                "example_id": "b6d6d6d5-e64d-4525-a4c8-f6a1ecb30fad",
                                "sense_id": "3bcd020e-a391-3db2-bf7e-a2517f5d2144",
                                "text": "[…], je vois bien dans Boccace des plaisanteries folâtres et des narrations badines; […]."
                            },
                            {
                                "example_id": "718879d9-1108-4705-a041-89e7122834ef",
                                "sense_id": "3bcd020e-a391-3db2-bf7e-a2517f5d2144",
                                "text": "Parfois la douairière réveillait chez sa jeune parente des élans de gaieté, ou des rires folâtres bientôt réprimés par une pensée importune."
                            },
                            {
                                "example_id": "b8077b85-e997-40ab-8593-684c7df94c9f",
                                "sense_id": "3bcd020e-a391-3db2-bf7e-a2517f5d2144",
                                "text": "Ah! cette ville imbécile et mortelle […]. Elle prend des aspects de nécropole où les macchabées folâtres auraient licence de grimacer et de gesticuler sous un ciel putride, gonflé comme un égout."
                            },
                            {
                                "example_id": "fbce04ac-bb25-4691-9479-7a4bec22e80c",
                                "sense_id": "3bcd020e-a391-3db2-bf7e-a2517f5d2144",
                                "text": "Oui, que le cerf blessé fuie et pleure,\nLe chevreuil épargné folâtres !\nCar les uns doivent rire et les autres pleurer.\nAinsi va le monde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbfb3c89-8d54-485f-bed9-ad815336de69",
                        "source_entry_id": "fc82360e-6065-3c8c-b20f-bcaf4fe1e238",
                        "source_sense_id": "3bcd020e-a391-3db2-bf7e-a2517f5d2144",
                        "target_lang_word": "mutwillig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutwillig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fafaeda0-f28f-31a5-bfa7-f8e3d678c174",
                                        "entry_id": "d3df9d7a-7916-3b9c-b7d0-71ae2da401bd",
                                        "glosses": [
                                            "nicht an Gefahren (Risiken) und/oder Folgen (Konsequenzen) denkend"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2480a9d5-a3af-4d2c-a88f-2aeefcc61d9b",
                                                "sense_id": "fafaeda0-f28f-31a5-bfa7-f8e3d678c174",
                                                "text": "Durch mutwillige Übertreibungen gelang es ihm, die Diskussion zu beenden."
                                            },
                                            {
                                                "example_id": "7bca2ca3-afb8-4d22-89f1-abfda933a756",
                                                "sense_id": "fafaeda0-f28f-31a5-bfa7-f8e3d678c174",
                                                "text": "Sie setzte sein Leben mutwillig aufs Spiel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6724d1e5-9714-3acb-bdac-61bc5baacc96",
