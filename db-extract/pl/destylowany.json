                        "target_lang_word": "дистиллированный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дистиллированный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1fa79f45-03b8-3865-8ae5-05146727142a",
                                        "entry_id": "e4bba127-fa72-397c-a5eb-3ab2d47f7560",
                                        "glosses": [
                                            "хим. полученный путем дистилляции; очищенный от примесей с помощью перегонки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "122af8a5-c5ff-4d91-837d-1627783270df",
                                                "sense_id": "1fa79f45-03b8-3865-8ae5-05146727142a",
                                                "text": "Дистиллированная вода."
                                            },
                                            {
                                                "example_id": "3772cc65-bce0-4c72-b2b2-a8a1de691c9a",
                                                "sense_id": "1fa79f45-03b8-3865-8ae5-05146727142a",
                                                "text": "Дистиллированный спирт."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3fcc36d-8fc9-3c1e-81b6-7b7950c41b3e",
                                        "entry_id": "e4bba127-fa72-397c-a5eb-3ab2d47f7560",
                                        "glosses": [
                                            "перен. лишённый индивидуальности, идеально чистый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b500676d-c5a9-42f5-9a70-ac9722101895",
                                                "sense_id": "b3fcc36d-8fc9-3c1e-81b6-7b7950c41b3e",
                                                "text": "К его переводам вполне применим термин: дистиллированные, так как эти переводы действительно очищены от всех элементов художественности."
                                            },
                                            {
                                                "example_id": "d6f91d59-b50e-4918-aa1a-d2f6a512d317",
                                                "sense_id": "b3fcc36d-8fc9-3c1e-81b6-7b7950c41b3e",
                                                "text": "Надо бы что-нибудь попроще для дня сегодняшнего, чем чистая, дистиллированная совестливость."
                                            },
                                            {
                                                "example_id": "adfebf97-eb13-47f5-8392-c5117965ab21",
                                                "sense_id": "b3fcc36d-8fc9-3c1e-81b6-7b7950c41b3e",
                                                "text": "В другом — лампы дневного света, дистиллированная пустота и прохлада."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
