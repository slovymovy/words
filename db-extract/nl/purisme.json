                "translations": [
                    {
                        "translation_id": "22f4cc4a-329c-419e-bb6b-f0a35c633030",
                        "source_entry_id": "e85292d1-9cc1-378e-a6fb-26fb447dc384",
                        "source_sense_id": "dd93145a-2ff6-392f-a3d4-e240faadd216",
