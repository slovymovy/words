                "senses": [
                    {
                        "sense_id": "d5ef5caf-9799-3f7e-b9d4-9142e7c40699",
                        "entry_id": "c36b0240-385d-37c4-aa81-5a0e785dc9a5",
                        "glosses": [
                            "Peuple d’Afrique, de la région des Grands Lacs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1441b649-a41a-4f14-a646-703c9924b661",
                                "sense_id": "d5ef5caf-9799-3f7e-b9d4-9142e7c40699",
                                "text": "La biologiste kényane Wangari Maathai, qui reçut le prix Nobel de la paix 2004 pour ses engagements écologistes et féministes à travers le Mouvement de la Ceinture verte, rappelle les blessures infligées à la Terre par les entreprises coloniales soutenues par des disciples chrétiens, qui dévalorisèrent les pratiques des peuples indigènes tels que les Kikuyus du Kenya, pratiques reconnues aujourd’hui pour leur rôle protecteur de la biodiversité."
                            },
                            {
                                "example_id": "22cfdcd3-6b92-4740-af12-bf5bb8785b00",
                                "sense_id": "d5ef5caf-9799-3f7e-b9d4-9142e7c40699",
                                "text": "Les Kikuyus distinguent les morts selon leur statut social : les « achevés » (il s’agit des vieillards respectés, ayant laissé derrière eux une lignée) et les « inachevés » (les disparus sans descendance, par accident, par meurtre, par le maléfice d’un sorcier ou par la malédiction d’un parent)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8638842d-66c1-46ba-b826-4b483c7960a6",
                        "source_entry_id": "c36b0240-385d-37c4-aa81-5a0e785dc9a5",
                        "source_sense_id": "d5ef5caf-9799-3f7e-b9d4-9142e7c40699",
                        "target_lang_word": "Kikuyu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kikuyu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22ab714c-b957-39aa-bdde-aa6055a162d4",
                                        "entry_id": "2784473e-5fda-35ca-8ba2-e388327f9e9b",
                                        "glosses": [
                                            "eine in Kenia gesprochene Bantusprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e08e74b1-d392-4e7a-9391-dd6b07359331",
                                                "sense_id": "22ab714c-b957-39aa-bdde-aa6055a162d4",
                                                "text": "„Ich werde Eskimo, Kikuyu (aus der Familie der Bantusprachen) und Englisch zum Sprachvergleich heranziehen.“"
                                            },
                                            {
                                                "example_id": "5544f459-ccfe-441d-899c-474c84b7a0fc",
                                                "sense_id": "22ab714c-b957-39aa-bdde-aa6055a162d4",
                                                "text": "„Sie geben sich betreten die Hand, dann stimmen sie mit den Neuankömmlingen gemeinsam ein Kirchenlied an – nicht in der Sprache der Luo, schon gar nicht auf Kikuyu, sondern auf Suaheli.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
