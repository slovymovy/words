{
    "word_family": [
        "compile",
        "compiler",
        "compilatory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "26397c37-d484-3487-b118-362e0fc21523",
                    "sense_definition": "A collection of items, such as songs, stories, or data, gathered together into a single book, document, or recording.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the weekend listening to a <w>compilation</w> of her favorite songs from the nineties.",
                            "target_lang_translations": {
                                "ru": "Она провела все выходные, слушая <w>сборник</w> своих любимых песен девяностых."
                            }
                        },
                        {
                            "text": "The author released a new <w>compilation</w> album featuring tracks from various underground artists.",
                            "target_lang_translations": {
                                "ru": "Автор выпустил новый <w>компиляционный</w> альбом, в который вошли треки различных андеграундных исполнителей."
                            }
                        }
                    ],
                    "synonyms": [
                        "anthology",
                        "collection"
                    ],
                    "common_phrases": [
                        "compilation album",
                        "video compilation",
                        "music compilation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сборник предметов, таких как песни, рассказы или данные, собранных вместе в одну книгу, документ или запись."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сборник",
                                "target_lang_sense_clarification": "музыкальный или литературный"
                            },
                            {
                                "target_lang_word": "компиляция",
                                "target_lang_sense_clarification": "результат объединения материалов"
                            },
                            {
                                "target_lang_word": "собрание",
                                "target_lang_sense_clarification": "коллекция текстов или произведений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cb5c4f3-2703-33bc-9eae-57d312ea4206",
                    "sense_definition": "The act or process of gathering and organizing information or materials from various sources.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>compilation</w> of data for the annual report took several weeks to complete.",
                            "target_lang_translations": {
                                "ru": "<w>Сбор</w> данных для годового отчета занял несколько недель."
                            }
                        },
                        {
                            "text": "Effective data <w>compilation</w> is essential for accurate scientific research and analysis.",
                            "target_lang_translations": {
                                "ru": "Эффективное <w>составление</w> базы данных необходимо для точных научных исследований и анализа."
                            }
                        }
                    ],
                    "synonyms": [
                        "compilement"
                    ],
                    "common_phrases": [
                        "data compilation",
                        "compilation process",
                        "report compilation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс сбора и организации информации или материалов из различных источников."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составление",
                                "target_lang_sense_clarification": "процесс подготовки документа или отчета"
                            },
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "процесс накопления данных"
                            },
                            {
                                "target_lang_word": "компиляция",
                                "target_lang_sense_clarification": "процесс объединения чужих трудов или данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c3820d4-249e-3df3-9712-fa77debb0527",
                    "sense_definition": "The process by which a computer translates source code written in a programming language into machine-readable object code.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer noticed a <w>compilation</w> error that prevented the software from running correctly.",
                            "target_lang_translations": {
                                "ru": "Программист заметил ошибку <w>компиляции</w>, которая мешала правильной работе программы."
                            }
                        },
                        {
                            "text": "During the <w>compilation</w> time, the system checks for syntax errors in the code.",
                            "target_lang_translations": {
                                "ru": "Во время <w>компиляции</w> система проверяет код на наличие синтаксических ошибок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "compilation error",
                        "compilation time",
                        "successful compilation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс, при котором компьютер переводит исходный код, написанный на языке программирования, в машиночитаемый объектный код."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компиляция",
                                "target_lang_sense_clarification": "в программировании"
                            },
                            {
                                "target_lang_word": "компилирование",
                                "target_lang_sense_clarification": "процесс преобразования кода"
                            }
                        ]
                    }
                }
            ]
        }
    ]
