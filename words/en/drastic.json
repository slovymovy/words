{
    "word_family": [
        "drastically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ab82cfb2-bf75-3d24-b07d-0f8b2cd22826",
                    "sense_definition": "Having a strong, extreme, or far-reaching effect; severe.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "extreme_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company had to take <w>drastic</w> measures to avoid going bankrupt.",
                            "target_lang_translations": {
                                "ru": "Компании пришлось принять <w>радикальные</w> меры, чтобы избежать банкротства."
                            }
                        },
                        {
                            "text": "If our third attempt fails, we may need to consider <w>drastic</w> changes to our strategy.",
                            "target_lang_translations": {
                                "ru": "Если наша третья попытка не удастся, нам, возможно, придется рассмотреть <w>кардинальные</w> изменения в нашей стратегии."
                            }
                        }
                    ],
                    "synonyms": [
                        "draconian"
                    ],
                    "antonyms": [
                        "mild",
                        "moderate"
                    ],
                    "common_phrases": [
                        "drastic measures",
                        "drastic changes",
                        "drastic action"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывающий сильное, крайнее или далеко идущее воздействие; решительный, радикальный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радикальный",
                                "target_lang_sense_clarification": "о мерах, изменениях"
                            },
                            {
                                "target_lang_word": "решительный",
                                "target_lang_sense_clarification": "о действиях, шагах"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о переменах, спаде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fed947dd-15de-39da-8ab8-15535542547b",
                    "sense_definition": "Acting rapidly or violently, especially of a medicine or treatment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor warned that the drug could have a <w>drastic</w> effect on his digestive system.",
                            "target_lang_translations": {
                                "ru": "Врач предупредил, что препарат может оказать <w>резкое</w> воздействие на его пищеварительную систему."
                            }
                        },
                        {
                            "text": "In the past, physicians used <w>drastic</w> purgatives to treat severe illnesses.",
                            "target_lang_translations": {
                                "ru": "В прошлом врачи использовали <w>сильнодействующие</w> слабительные средства для лечения тяжелых заболеваний."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly used in older medical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действующий быстро или сильно (особенно о лекарствах или методах лечения); сильнодействующий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сильнодействующий",
                                "target_lang_sense_clarification": "о лекарствах, средствах"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "об эффекте препарата"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd3845e7-acea-3a77-8c12-e795649ef657",
                    "sense_definition": "A powerful, fast-acting purgative medicine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The apothecary prepared a strong <w>drastic</w> to relieve the patient's condition.",
                            "target_lang_translations": {
                                "ru": "Аптекарь приготовил сильное <w>слабительное</w>, чтобы облегчить состояние пациента."
                            }
                        },
                        {
                            "text": "He avoided prescribing <w>drastics</w> due to their harsh side effects.",
                            "target_lang_translations": {
                                "ru": "Он избегал назначать <w>сильнодействующие слабительные</w> из-за их тяжелых побочных эффектов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly used in historical medical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильнодействующее, быстрое слабительное средство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сильнодействующее слабительное",
                                "target_lang_sense_clarification": "медицинский термин, устаревшее"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}