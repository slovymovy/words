                    {
                        "translation_id": "bbc805ed-7de0-4ad7-a005-b21c7d92da5f",
                        "source_entry_id": "1b890ccf-2887-387c-9920-2e49e0876153",
                        "source_sense_id": "2f020c88-8724-3261-ab4c-77fe63dc0363",
                        "source_sense_description": "körperliche und geistige Kraft oder Vitalität",
                        "target_lang_word": "vitalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vitalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fddc1657-c4e1-3c18-9ce4-9aabc31b9f16",
                                        "entry_id": "4f3cc2e1-5cdb-358d-b5a3-225904a1d1fa",
                                        "glosses": [
                                            "Disposition des corps organisés à opérer les mouvements, les actions qui constituent la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9ee34ea-d799-4a52-9548-756d060e468e",
                                                "sense_id": "fddc1657-c4e1-3c18-9ce4-9aabc31b9f16",
                                                "text": "La vitalité d’un tissu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbc3fb4d-cc24-3e6c-844a-1659d4872eab",
                                        "entry_id": "4f3cc2e1-5cdb-358d-b5a3-225904a1d1fa",
                                        "glosses": [
                                            "Force de vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cb260d4-d58c-444d-b905-16bcf0b0c324",
                                                "sense_id": "dbc3fb4d-cc24-3e6c-844a-1659d4872eab",
                                                "text": "Il y avait chez cet homme une grande vitalité."
                                            },
                                            {
                                                "example_id": "e6378e0a-ff07-4dac-90a1-ce2f06e72cd0",
                                                "sense_id": "dbc3fb4d-cc24-3e6c-844a-1659d4872eab",
                                                "text": "Il est doué d’une vitalité singulière."
                                            },
                                            {
                                                "example_id": "f5d40ec4-8fd8-4493-8cbd-491703ae2181",
                                                "sense_id": "dbc3fb4d-cc24-3e6c-844a-1659d4872eab",
                                                "text": "L’on reste vraiment atterré en présence de pareilles œuvres, et l’on se demande avec inquiétude si la vitalité se retire chaque siècle du monde vieillissant."
                                            },
                                            {
                                                "example_id": "b43632ed-badb-4cae-a3f5-1cf7927fa35d",
                                                "sense_id": "dbc3fb4d-cc24-3e6c-844a-1659d4872eab",
                                                "text": "« Eh bien ! ce n’est pas pour demain mon enterrement ! Je vivrai jusqu’à cent ans : il faudra me tuer. » Le docteur P. était perplexe. « Avec elle on ne peut faire aucune prévision : elle a une telle vitalité ! » J’ai rapporté à maman ce dernier mot : « Oui, j’ai de la vitalité ! » a-t-elle constaté avec satisfaction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "629501e8-276a-3ca0-8dd0-18c7b7c331d7",
                                        "entry_id": "4f3cc2e1-5cdb-358d-b5a3-225904a1d1fa",
                                        "glosses": [
                                            "Dynamisme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15c584d6-7e4a-4f0e-9904-c0ec8d2f5174",
                                                "sense_id": "629501e8-276a-3ca0-8dd0-18c7b7c331d7",
                                                "text": "Les petits districts très différents qui se trouvent soudés artificiellement dans le Tarn-et-Garonne retrouveront leur vitalité quand, échappés à un compartimentage mal conçu, ils seront de nouveau mêlés aux vastes divisions provinciales commandées par la nature des choses."
                                            },
                                            {
                                                "example_id": "78e19152-4a6b-420d-a675-0b956716340a",
                                                "sense_id": "629501e8-276a-3ca0-8dd0-18c7b7c331d7",
                                                "text": "Ma présence lui avait redonné de la vitalité, il doit avoir un faible pour mes fesses, car le voilà qui bande comme un cerf."
                                            },
                                            {
                                                "example_id": "fdb3080e-35e9-4e60-a076-abada27c7d87",
                                                "sense_id": "629501e8-276a-3ca0-8dd0-18c7b7c331d7",
                                                "text": "Partout, l’idée anti-germanique prend corps, et l’esprit slave, si longuement tenu sous séquestre, affirme sa vitalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
