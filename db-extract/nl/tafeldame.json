                "senses": [
                    {
                        "sense_id": "01a3c1c3-6567-3333-b2f0-30a8ba7b64ad",
                        "entry_id": "5336a932-bb04-33ad-a130-831cfd78a100",
                        "glosses": [
                            "vaste serveerster voor een bepaalde tafel in een restaurant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "078adb05-60c6-47a0-b049-68256a5d0e04",
                                "sense_id": "01a3c1c3-6567-3333-b2f0-30a8ba7b64ad",
                                "text": "Het spleetje was doorslaggevend. \"Toen ik dat zag, wist ik zeker dat het Madonna was.\" Eileen, die de tafeldame was van Madonna en Timor, bracht haar collega's via een briefje op de hoogte van het bezoek van het bekende stel. In eerste instantie geloofden zij haar niet, maar toen Madonna haar jas uitdeed konden ook zij er niet meer omheen."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfe55adf-6eb4-3093-af9a-1923948d87a7",
                        "entry_id": "5336a932-bb04-33ad-a130-831cfd78a100",
                        "glosses": [
                            "vrouw die de presentator van een talkshow assisteert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff9618a0-79d4-435a-b6d5-96fbb51794ad",
                                "sense_id": "dfe55adf-6eb4-3093-af9a-1923948d87a7",
                                "text": "Dionne is het afgelopen half jaar vooral veel genoemd in combinatie met de onderwerpen 'tafeldame' (ze was een paar keer tafeldame bij DWDD), 'debat' (ze leidde voor de NOS een aantal politieke debatten) en 'mooie vrouw'."
                            }
                        ]
                    },
                    {
                        "sense_id": "b827ee69-c83a-3774-942b-2768f2d82460",
                        "entry_id": "5336a932-bb04-33ad-a130-831cfd78a100",
                        "glosses": [
                            "vrouw waarmee men aan één tafel zit om de maaltijd te gebruiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc2a7b34-b310-43ea-a5cf-95cf51336e4e",
                                "sense_id": "b827ee69-c83a-3774-942b-2768f2d82460",
                                "text": "En dan was er nog de roddel dat Rutte Halina Reijn als tafeldame had gevraagd. Niks van waar, zegt de premier. \"We zitten wel aan tafel bij elkaar geloof ik, maar daar ben ik van tevoren niet bij betrokken geweest. Het is volgens mij een tafel met Twan Huys en de meest recente deelnemers aan College Tour.\""
                            }
                        ]
                    }
