                "translations": [
                    {
                        "translation_id": "7c4e52f8-d74a-4b45-954f-a028978698bd",
                        "source_entry_id": "1e2107e3-144e-3491-a7f2-7f4bf7f9af02",
                        "source_sense_id": "a080d099-11c2-353d-bfa9-6e9b009860c7",
                        "target_lang_word": "exigence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exigence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32a1227c-477c-3ac3-a9af-0dec89944275",
                                        "entry_id": "60a3f809-a347-3215-8825-2cabd39f8f1e",
                                        "glosses": [
                                            "Ce que l’on attend, ce que l’on exige de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bb15f9d-5aaf-46e4-b7be-00c5b0f7fef5",
                                                "sense_id": "32a1227c-477c-3ac3-a9af-0dec89944275",
                                                "text": "C’est ce qui fait qu’une femme par toute nouvelle souffrance qu’elle nous inflige, souvent sans le savoir, augmente son pouvoir sur nous, mais aussi nos exigences envers elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d7da87e-a6a9-3a09-a58f-cbb800b00345",
                                        "entry_id": "60a3f809-a347-3215-8825-2cabd39f8f1e",
                                        "glosses": [
                                            "Ce que l’on attend, ce que l’on exige de quelqu’un.",
                                            "Exigences légales"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b476d53b-2a0d-4ccd-b3ec-9771dd64c5a7",
                                                "sense_id": "8d7da87e-a6a9-3a09-a58f-cbb800b00345",
                                                "text": "En l’absence de droit de l’Union en la matière, des approches nationales divergentes sur l’amélioration de la durabilité environnementale des produits ont déjà vu le jour, qu’il s’agisse d’ exigences en matière d’information sur la durée de compatibilité logicielle des dispositifs électroniques ou d’obligations de déclaration relatives à la manipulation de biens durables invendus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "518ecdb0-ac5c-3d69-ab9d-e055dedabe99",
                                        "entry_id": "60a3f809-a347-3215-8825-2cabd39f8f1e",
                                        "glosses": [
                                            "Ce que l’on attend, ce que l’on exige de quelqu’un.",
                                            "Caractère ou prétention de celui qui exige, qui se montre exigeant."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10941770-c4bb-4ff3-bfd6-91d635e36d19",
                                                "sense_id": "518ecdb0-ac5c-3d69-ab9d-e055dedabe99",
                                                "text": "Il est d’une exigence insupportable, ridicule, d’une extrême exigence."
                                            },
                                            {
                                                "example_id": "93e09714-6df9-4143-b559-6839c5de6d65",
                                                "sense_id": "518ecdb0-ac5c-3d69-ab9d-e055dedabe99",
                                                "text": "Il pousse trop loin l’exigence."
                                            },
                                            {
                                                "example_id": "47e64577-80fe-432a-821b-11ac1e04c23f",
                                                "sense_id": "518ecdb0-ac5c-3d69-ab9d-e055dedabe99",
                                                "text": "Rien ne peut satisfaire son exigence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82c56706-9d3c-3008-a6f0-a056c5a627c2",
                                        "entry_id": "60a3f809-a347-3215-8825-2cabd39f8f1e",
                                        "glosses": [
                                            "Ce que l’on attend, ce que l’on exige de quelqu’un.",
                                            "Attentes et critères élevés de résultat ou de comportement qu’entretient ordinairement une personne envers elle-même, ainsi qu’envers d’autres personnes, notamment en contexte professionnel ou artistique."
                                        ],
                                        "tags": [
                                            "Mélioratif"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2536f06-8208-4be2-9d58-3a346126e3c5",
                                                "sense_id": "82c56706-9d3c-3008-a6f0-a056c5a627c2",
                                                "text": "Travailler avec Camille [Chaplain] m’a montré que le talent et l’exigence peuvent coexister sans paradoxe avec le respect et la douceur. Elle restera pour moi une mentor, un modèle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4503391-66e3-3b7c-a7dd-2a8a66e6ab8d",
                                        "entry_id": "60a3f809-a347-3215-8825-2cabd39f8f1e",
                                        "glosses": [
                                            "Ce qu’exigent ou requièrent les circonstances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e6843b6-3d11-43d2-9468-5b97413c005c",
                                                "sense_id": "b4503391-66e3-3b7c-a7dd-2a8a66e6ab8d",
                                                "text": "Une telle articulation conduit à moraliser le royaume futur et à téléologiser les exigences de la morale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
