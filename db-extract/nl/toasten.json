                                                "sense_id": "2ca34b14-584d-3b61-af25-8f0fb242ef5c",
                                                "text": "We used to enjoy toasting marshmallows around the campfire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d149545-ec26-393e-9fb8-ad1681f0245b",
                                        "entry_id": "58e8676e-c80f-3e86-8181-323db866d23e",
                                        "glosses": [
                                            "to cook lightly by browning under a grill or in a toaster; to grill"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "154e979f-4bb2-4050-b69b-67ef915137b4",
                                                "sense_id": "2d149545-ec26-393e-9fb8-ad1681f0245b",
                                                "text": "Top with cheese and toast under the grill for a few minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e23a565-1f4a-339e-ae32-421f89245415",
                                        "entry_id": "58e8676e-c80f-3e86-8181-323db866d23e",
                                        "glosses": [
                                            "To engage in a salutation, often with raising of the drinking vessel, while drinking an alcoholic beverage in honor of someone or something."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81186038-d303-4884-a61f-f2b1002cecdb",
                                                "sense_id": "9e23a565-1f4a-339e-ae32-421f89245415",
                                                "text": "We toasted the happy couple many times over the course of the evening."
                                            },
                                            {
                                                "example_id": "0b323840-9cf4-4aa1-96d5-f61916c3d137",
                                                "sense_id": "9e23a565-1f4a-339e-ae32-421f89245415",
                                                "text": "You all have achieved so much together thus far, so I think that deserves a toast! Let's toast!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7711600d-8a33-318c-8e34-3d26e245f504",
                                        "entry_id": "58e8676e-c80f-3e86-8181-323db866d23e",
                                        "glosses": [
                                            "To warm thoroughly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b18957f-fd33-4dde-abd8-da4bced492d8",
                                                "sense_id": "7711600d-8a33-318c-8e34-3d26e245f504",
                                                "text": "I toasted my feet by the fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9afd0e0-cc45-3563-aac2-dfcea7691f99",
                                        "entry_id": "58e8676e-c80f-3e86-8181-323db866d23e",
                                        "glosses": [
                                            "To perform an extemporaneous narrative poem or rap."
                                        ],
