                    {
                        "translation_id": "44ef4da4-8ebe-4321-9c10-f42b6d6f0010",
                        "source_entry_id": "d11f73d0-2776-3cdd-b99a-8501074cd66e",
                        "source_sense_description": "отслужившие свой срок изделия из бумаги и картона, бумажные отходы",
                        "target_lang_word": "Makulatur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Makulatur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fb93e1b-8373-31da-bbb0-ac2b781a2e44",
                                        "entry_id": "bdead508-5d07-3c53-a28a-c20f059cf072",
                                        "glosses": [
                                            "schadhafte Druckbogen oder unbrauchbar gewordene Druckerzeugnisse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5646b4e-2929-41c2-945d-fb4f8d05d651",
                                                "sense_id": "5fb93e1b-8373-31da-bbb0-ac2b781a2e44",
                                                "text": "Wir wollen alle eine fehlerfreie Produktion grafischer Drucksachen, aber Makulatur gibt es immer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24cea556-49d7-3278-a9b1-50cc2d838535",
                                        "entry_id": "bdead508-5d07-3c53-a28a-c20f059cf072",
                                        "glosses": [
                                            "Altpapier, Abfall in der Papierindustrie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8398643-ca96-44ce-917e-cf50146eeb3f",
                                                "sense_id": "24cea556-49d7-3278-a9b1-50cc2d838535",
                                                "text": "Das Papier für die Auflage wird auf jeden Fall benötigt, daher kann man nur versuchen, die Makulatur zu verringern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e65a50d3-bfd7-3dd9-bd68-d80d4b5952df",
                                        "entry_id": "bdead508-5d07-3c53-a28a-c20f059cf072",
                                        "glosses": [
                                            "Unsinn"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f218c96b-8e7b-4147-a18a-25e0aa6a1d4c",
                                                "sense_id": "e65a50d3-bfd7-3dd9-bd68-d80d4b5952df",
                                                "text": "Ich habe mir soviel Arbeit gemacht, aber jetzt ist alles Makulatur (d. h. es war alles vergebens)."
                                            },
                                            {
                                                "example_id": "47738341-f571-4abb-8133-00e16069245a",
                                                "sense_id": "e65a50d3-bfd7-3dd9-bd68-d80d4b5952df",
                                                "text": "„Ich glaubte, alles von und über Kant zu kennen, in diesem Text aber stieß ich auf eine scheinbar unbedeutende Notiz, die meine Dissertation zur Makulatur werden ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6d83dc8-4a1e-4c80-93af-87faaa49946a",
                        "source_entry_id": "d11f73d0-2776-3cdd-b99a-8501074cd66e",
                        "source_sense_description": "отслужившие свой срок изделия из бумаги и картона, бумажные отходы",
                        "target_lang_word": "maculature",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maculature",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6d1d287-8e57-328f-aedb-d98ece47e097",
                                        "entry_id": "065c221f-a29c-3d02-9b40-310fda6a7b7d",
                                        "glosses": [
                                            "Action de maculer ou résultat de cette action."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d7b24aa-1c6c-4074-abde-8c344b524c51",
                                                "sense_id": "a6d1d287-8e57-328f-aedb-d98ece47e097",
                                                "text": "Quand un relieur bat un livre fraîchement imprimé, il risque de faire des maculatures."
                                            },
                                            {
                                                "example_id": "bff9cf63-104e-41b9-81f1-93fde3d1608b",
                                                "sense_id": "a6d1d287-8e57-328f-aedb-d98ece47e097",
                                                "text": "La pierre d'évier qui venait d'apparaître en pleine lumière, était tachée de sang et une serviette souillée de maculatures suspectes gisait à terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a6b83f4-adf3-3d7c-a9c2-b65038a6836b",
                                        "entry_id": "065c221f-a29c-3d02-9b40-310fda6a7b7d",
                                        "glosses": [
                                            "Feuille de papier tachée au tirage et qui n'est bonne qu'à envelopper."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1159c78-395f-457d-8ea4-20b36a73ef21",
                                                "sense_id": "0a6b83f4-adf3-3d7c-a9c2-b65038a6836b",
                                                "text": "Maculature grise, feuille de papier gris qui sert d’enveloppe à une rame de papier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de20bae7-502c-3cce-ae37-a63e086b6eb0",
                                        "entry_id": "065c221f-a29c-3d02-9b40-310fda6a7b7d",
                                        "glosses": [
                                            "Feuilles de papier que l'on intercale entre des pages fraîchement typographiées."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f2c7d6a-ce1c-3c15-8a02-654ab32c6340",
                                        "entry_id": "065c221f-a29c-3d02-9b40-310fda6a7b7d",
                                        "glosses": [
                                            "Tache provoquée par un excès d'encre ou de peinture."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f78a54a-9c6b-4edd-950a-1f33dcb49199",
                                                "sense_id": "2f2c7d6a-ce1c-3c15-8a02-654ab32c6340",
                                                "text": "Des nuages sombres, s’élargissant de minute en minute, commencèrent à tacher le ciel ; on eût dit que l’aquarelliste de l’infini avait trop chargé son pinceau d’encre de Chine, et qu’il essayait d’affaiblir la maculature en la lavant à grande eau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
