                    "sense_definition": "Wat met bewijzen ondersteund kan worden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewijsbaarheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is een <w>aantoonbaar</w> verband tussen roken en longziekten.",
                            "target_lang_translations": {
