                ],
                "senses": [
                    {
                        "sense_id": "60ad6fa9-95e7-3b18-9c48-9a4fac005885",
                        "entry_id": "f92b47e7-96f8-38f1-adc6-6d0c5066608b",
                        "glosses": [
                            "свойство по значению прилагательного неуверенный"
                        ],
                        "tags": [],
