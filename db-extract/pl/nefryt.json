        "pl-extract.jsonl": [
            {
                "entry_id": "fe7ea5cf-7d1d-3d1d-ba94-afedc7d18e91",
                "word": "nefryt",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9f2a736c-1cf4-33d2-b867-f1333994d2f4",
                        "entry_id": "fe7ea5cf-7d1d-3d1d-ba94-afedc7d18e91",
                        "glosses": [
                            "minerał z gromady krzemianów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f17ee146-8d2d-4663-b74e-002f3ab8f101",
                                "sense_id": "9f2a736c-1cf4-33d2-b867-f1333994d2f4",
                                "text": "Karawany objuczonych wielbłądów kroczyły jedwabnym szlakiem niosąc jedwab, nefryt i złoto."
                            },
                            {
                                "example_id": "b520a833-d6b6-41d3-9ba1-8226922703e1",
                                "sense_id": "9f2a736c-1cf4-33d2-b867-f1333994d2f4",
                                "text": "Celem przyświecającym twórcom celadonu było stworzenie taniej imitacji drogiego nefrytu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5ee1206c-6a84-3f40-ab0a-6f4648d002f7",
                        "entry_id": "fe7ea5cf-7d1d-3d1d-ba94-afedc7d18e91",
                        "glosses": [
                            "odmiana grochu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54c142d6-a679-4018-9878-f7698dab4c14",
                        "source_entry_id": "fe7ea5cf-7d1d-3d1d-ba94-afedc7d18e91",
                        "source_sense_id": "9f2a736c-1cf4-33d2-b867-f1333994d2f4",
                        "target_lang_word": "nephrite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nephrite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "932a0b39-af50-39d3-a291-33d952e17e55",
                                        "entry_id": "9f1ee4cb-83e6-36ef-97ed-bd95bf132ec6",
                                        "glosses": [
                                            "A semi-precious stone, one of the two types of stone commonly referred to as jade (the other being jadeite)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c229d799-1f4c-4f80-b568-25d26822b6b3",
                                                "sense_id": "932a0b39-af50-39d3-a291-33d952e17e55",
                                                "text": "Occurrences of nephrite are more numerous. China’s most important source throughout its history has been the region of Khotan (Ho-t‘ien) and Yarkand in Central Asia. In more recent times the Chinese have also imported nephrite from the neighbourhood of Lake Baikal in Eastern Siberia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7f4ab9c-8b7b-413f-a286-1cad13c0207a",
                        "source_entry_id": "fe7ea5cf-7d1d-3d1d-ba94-afedc7d18e91",
                        "source_sense_id": "9f2a736c-1cf4-33d2-b867-f1333994d2f4",
                        "target_lang_word": "нефрит",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нефрит",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cc74cd8c-8c78-3eb6-a656-a9baee2f4222",
                                        "entry_id": "c50f45e9-2b8a-3fd1-9789-6cfb62911156",
                                        "glosses": [
                                            "мед. воспалительное заболевание почек, вызывающее локальные или диффузные пролиферативные или деструктивные процессы, вовлекающие почечные клубочки, почечные канальцы или интерстициальную почечную ткань"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65a31a4a-8eff-409d-8e1f-27207c109167",
                                                "sense_id": "cc74cd8c-8c78-3eb6-a656-a9baee2f4222",
                                                "text": "Нефрит ― болезнь почек ― выражается особою бледностью, одутловатостью тела."
                                            },
                                            {
                                                "example_id": "970f49e7-8902-4e84-ab9c-ddf506fd1e50",
                                                "sense_id": "cc74cd8c-8c78-3eb6-a656-a9baee2f4222",
                                                "text": "Об этом заботился Сулер и отдавал этому делу свою душу и нервы, что стоило ему здоровья, которым он, к сожалению, не мог похвастаться, так как доктора уже констатировали у него запущенный нефрит, полученный им в Канаде."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "нефрит",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "79916831-915d-3506-b373-bc3e5cbcceb8",
                                        "entry_id": "45b98391-27a8-3e31-88db-318021c1b9f5",
                                        "glosses": [
                                            "геол., минер. мономинеральная горная порода из спутанно-волокнистых амфиболов тремолит-актинолитового ряда с характерной структурой; минерал отличается исключительно высокой вязкостью, из-за чего обломки нефрита очень сложно расколоть на куски; поделочный камень"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10aa0fb9-ba29-485e-8343-1a1882175648",
                                                "sense_id": "79916831-915d-3506-b373-bc3e5cbcceb8",
                                                "text": "Это мог быть скатившийся сверху неоценимый нефрит ― материал для топоров необычайной прочности."
                                            },
                                            {
                                                "example_id": "4c738f2a-37fb-49c0-8c1c-0f80cbab5787",
                                                "sense_id": "79916831-915d-3506-b373-bc3e5cbcceb8",
                                                "text": "При раздавливании саянского нефрита также порождаются звуки, но уже более мощные ― типа пистолетных выстрелов."
                                            },
                                            {
                                                "example_id": "bf513af2-238b-4bb5-b957-8ec83fa2a8fb",
                                                "sense_id": "79916831-915d-3506-b373-bc3e5cbcceb8",
                                                "text": "Из такого же молочно-зелёного нефрита вырезан саркофаг Тимура."
                                            },
                                            {
                                                "example_id": "baa3f1c5-1b16-4c9f-902f-b9ce1365e31b",
                                                "sense_id": "79916831-915d-3506-b373-bc3e5cbcceb8",
                                                "text": "В Китае сложилась уникальная традиция обработки нефрита, поэтому при подборе предметов для императорской коллекции особое внимание уделялось нефритовым изделиям."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41b44216-82fd-38a1-9554-2b749e4d490b",
                                        "entry_id": "45b98391-27a8-3e31-88db-318021c1b9f5",
                                        "glosses": [
                                            "ювел. украшения из такого минерала"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b124bcab-63c2-4ff4-8d07-068e8bc15447",
                                                "sense_id": "41b44216-82fd-38a1-9554-2b749e4d490b",
                                                "text": "Короче сказать, по части буддизма ― нефриты, изделия из слоновой кости ― за истекшие три месяца мною ничего не добыто!"
                                            },
                                            {
                                                "example_id": "b13964c1-4b88-4a88-8b09-061466404626",
                                                "sense_id": "41b44216-82fd-38a1-9554-2b749e4d490b",
                                                "text": "Сначала она взяла бюллетень по травме, а потом её муж получил назначение военным советником за границу, и она отбыла в великую страну на востоке, где покупала себе шелк, нефриты и изумруды, а по штату им полагался повар, двое слуг, садовник и шофер, и все, разумеется, китайцы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
