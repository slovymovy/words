{
    "word_family": [
        "ächzen",
        "Achlaut"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "2dc98f5b-658b-3fd7-8027-6853a2ec186b",
                    "sense_definition": "Dient der Verstärkung eines nachfolgenden Wortes oder drückt plötzliches Verstehen und Erkennen aus.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ausruf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ach</w> so, jetzt verstehe ich endlich die ganze Aufgabe."
                        },
                        {
                            "text": "<w>Ach</w> ja, das hatte ich vorhin total vergessen zu erwähnen."
                        }
                    ],
                    "common_phrases": [
                        "ach so",
                        "ach ja",
                        "ach bitte"
                    ]
                },
                {
                    "sense_id": "afe2f9c8-c5fb-38c0-8f63-b3d7d9971751",
                    "sense_definition": "Drückt spontanes Erstaunen, Überraschung oder Verwunderung aus.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ausruf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ach</w>, du bist ja heute schon so früh nach Hause gekommen!"
                        },
                        {
                            "text": "<w>Ach</w>, wer hätte gedacht, dass wir uns hier zufällig treffen."
                        }
                    ],
                    "synonyms": [
                        "ei"
                    ],
                    "common_phrases": [
                        "ach du meine Güte",
                        "ach du liebe Zeit"
                    ]
                },
                {
                    "sense_id": "4a0239a7-ee82-3b31-851e-e8c3af6ee6c9",
                    "sense_definition": "Bringt Abwinken, Belanglosigkeit oder mangelndes Interesse zum Ausdruck.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "ausruf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ach</w> was, mach dir wegen dieser Kleinigkeit doch keine Sorgen!"
                        },
                        {
                            "text": "<w>Ach</w> woher, das war bestimmt keine böse Absicht von ihm."
                        }
                    ],
                    "common_phrases": [
                        "ach was",
                        "ach woher"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "häufig in der Umgangssprache als abwertende oder abwiegelnde Partikel"
                        }
                    ]
                },
                {
                    "sense_id": "3e5aaba7-c58d-3a2b-9de9-85452f51d83b",
                    "sense_definition": "Bringt Schmerz, Trauer, Bedauern oder anhaltendes Leiden zum Ausdruck.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ausruf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ach</w>, wie weh mir mein verletzter Fuß nach dem Sturz tut!"
                        },
                        {
                            "text": "<w>Ach</w>, es ist wirklich unendlich schade um diese schöne Gelegenheit."
                        }
                    ],
                    "antonyms": [
                        "juhu"
                    ]
                },
                {
                    "sense_id": "704e4cc3-82e9-3df0-9eae-b76d03d5a15a",
                    "sense_definition": "Bringt Fassungslosigkeit, Bestürzung oder einen plötzlichen Schrecken zum Ausdruck.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ausruf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ach</w> du Schreck, ich habe meinen Hausschlüssel im Büro vergessen!"
                        },
                        {
                            "text": "<w>Ach</w> Gott, was ist denn Schreckliches mit dem Wagen passiert?"
                        }
                    ],
                    "common_phrases": [
                        "ach du Schreck",
                        "ach Gott"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8829de75-e40b-3417-bc94-16931c142602",
                    "sense_definition": "Ausruf, Seufzer oder Klagelaut des Bedauerns, des Schmerzes oder der Betroffenheit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ausruf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sein ständiges Seufzen und jedes laute <w>Ach</w> gingen den Kollegen auf die Nerven."
                        },
                        {
                            "text": "Mit einem tiefen <w>Ach</w> ließ sich der alte Mann in den Sessel fallen."
                        }
                    ]
                }
            ]
        }
    ]
}