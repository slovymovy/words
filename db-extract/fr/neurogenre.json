                "senses": [
                    {
                        "sense_id": "4d16e9f3-4d04-3674-a129-cadabed19f69",
                        "entry_id": "cc5ea123-b483-3955-8751-c5c97be31311",
                        "glosses": [
                            "Identité de genre influencée ou liée au neuroatypisme et/ou à la neurodivergence."
                        ],
                        "tags": [
                            "Genres humains et identités de genre",
                            "Non-binarité"
                        ],
                        "examples": [
                            {
                                "example_id": "435c0207-9ce5-47e9-8245-a951cb01921f",
                                "sense_id": "4d16e9f3-4d04-3674-a129-cadabed19f69",
                                "text": "Un neurogenre est un genre perçu grace/à cause d'une neuroatypie (autisme, TDI, TDA(H), etc.)\nToutes les personnes Neuroatypique n'ont pas de neurogenre."
                            },
                            {
                                "example_id": "2cc10c67-e411-4d9d-9f0a-a15232e3659e",
                                "sense_id": "4d16e9f3-4d04-3674-a129-cadabed19f69",
                                "text": "Le neurogenre est un terme parapluie qui décrit le lien entre le genre d'une personne et son neurotype, sa maladie mentale ou ses conditions neurologiques. Donc le neurogenre ne s'applique qu'aux personnes neuroatypiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e50c57f-b448-32fc-a28c-c36b8e39909b",
                        "entry_id": "cc5ea123-b483-3955-8751-c5c97be31311",
                        "glosses": [
                            "Personne qui possède ce type d’identité de genre."
                        ],
                        "tags": [
                            "Genres humains et identités de genre",
                            "Non-binarité"
                        ],
                        "examples": []
