                "senses": [
                    {
                        "sense_id": "69d0e50f-965c-3ab9-a86d-94dc457dc880",
                        "entry_id": "eddcad09-6bb9-344d-9295-291c1f4008f4",
                        "glosses": [
                            "нехватка корма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f7246db-1d05-41d5-a673-befdefd00a21",
                                "sense_id": "69d0e50f-965c-3ab9-a86d-94dc457dc880",
                                "text": "Бескормица и безводие сильно истомляют наших верблюдов и лошадей."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ac38b52-a1ad-3f78-8f65-822131f6c1cf",
                        "entry_id": "eddcad09-6bb9-344d-9295-291c1f4008f4",
                        "glosses": [
                            "время, когда не хватает корма для животных"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e850d316-a2b7-4940-8593-ff489404a1b4",
                                "sense_id": "3ac38b52-a1ad-3f78-8f65-822131f6c1cf",
                                "text": "А теперь из-за глубоких снегов и больших морозов в горах наступила бескормица."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59ed26d1-5263-4cc9-b3d6-426ceeafdf90",
                        "source_entry_id": "eddcad09-6bb9-344d-9295-291c1f4008f4",
                        "target_lang_word": "fodder shortage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
