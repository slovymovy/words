                ],
                "senses": [
                    {
                        "sense_id": "e831a132-2c79-3a30-9102-e846cb2314af",
                        "entry_id": "cc29ce64-559e-380b-b910-fd04e9f67df4",
                        "glosses": [
                            "Mettre en fagots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1d6f2d6-5fe9-422a-84c9-c4075aa31548",
                                "sense_id": "e831a132-2c79-3a30-9102-e846cb2314af",
                                "text": "Pour les autres, il creusait des fossés, fagottait, écorçait des arbres ou les abattait."
                            },
                            {
                                "example_id": "30a066b9-1b49-478c-894c-06e45e40cb5e",
                                "sense_id": "e831a132-2c79-3a30-9102-e846cb2314af",
                                "text": "Nous avons les couvreurs ; le fermier qui va avec ses 2 bœufs labourer le potager et 2 journaliers qui abattent et fagottent."
                            }
                        ]
                    },
                    {
                        "sense_id": "dcb87da0-777e-3174-9157-fa0d4b634c77",
                        "entry_id": "cc29ce64-559e-380b-b910-fd04e9f67df4",
                        "glosses": [
                            "Habiller mal et avec un mauvais goût."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "50d706e8-2024-48fc-8dea-011218075f7e",
                                "sense_id": "dcb87da0-777e-3174-9157-fa0d4b634c77",
                                "text": "Cependant nous ne pouvions nous faire à leurs robes traînantes qui les fagottent plutôt qu’elles ne les drapent."
                            }
                        ]
                    },
                    {
                        "sense_id": "63e108d4-ee5d-3541-b48c-a0f134c8fc98",
                        "entry_id": "cc29ce64-559e-380b-b910-fd04e9f67df4",
                        "glosses": [
                            "Ramasser du bois et en faire des fagots."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "50c90b1c-314d-4cbf-8705-dc7e87fc74c4",
                                "sense_id": "63e108d4-ee5d-3541-b48c-a0f134c8fc98",
                                "text": "Pour la veuve qui grelotte\nSous ses guenilles de deuil\nEt, pour se chauffer, fagotte\nGarde et finaud ferment l’œil."
                            }
                        ]
                    },
                    {
                        "sense_id": "a14c1d02-4002-3d9b-92a4-1b5690347898",
                        "entry_id": "cc29ce64-559e-380b-b910-fd04e9f67df4",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d344f07a-4099-4677-b681-56716f7c3410",
                                "sense_id": "a14c1d02-4002-3d9b-92a4-1b5690347898",
                                "text": "Les couturières fagottent toujours des plis à la façon anglaise, elles n’emploient presque que des mousselines."
                            }
                        ]
                    }
                ],
