                    {
                        "sense_id": "144d33b9-cc33-386f-b716-6aac12ae58fe",
                        "entry_id": "8ec55733-f937-3cb9-b4e3-421a9a2f8261",
                        "glosses": [
                            "Relatif à l’Empire romulanais, à ses habitants et à sa culture, dans l’univers de Star Trek."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ce90fe-1112-4627-9a3f-f2423eff7627",
                                "sense_id": "144d33b9-cc33-386f-b716-6aac12ae58fe",
                                "text": "Un des plus célèbres vaisseaux spatiaux romulanais est l’« Oiseau de proie » du 23ᵉ siècle."
                            },
                            {
                                "example_id": "b76cfbab-e1d4-4570-b7da-65adea2782e9",
                                "sense_id": "144d33b9-cc33-386f-b716-6aac12ae58fe",
                                "text": "La bière romulanaise est interdite sur le territoire de la Fédération."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d666d0cf-c41f-4430-b7cf-ae5ecc9ed6ad",
                        "source_entry_id": "8ec55733-f937-3cb9-b4e3-421a9a2f8261",
                        "source_sense_id": "144d33b9-cc33-386f-b716-6aac12ae58fe",
                        "target_lang_word": "Romulan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Romulan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62b55cfe-b1ab-3b19-875e-2c4645966e03",
                                        "entry_id": "f7936ed1-44f0-3880-8435-964e3cfc3e9d",
                                        "glosses": [
                                            "A member of a fictional alien race, described as being cunning and opportunistic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbfa4df7-881b-4bce-a177-f16141d8dab6",
                                                "sense_id": "62b55cfe-b1ab-3b19-875e-2c4645966e03",
                                                "text": "\"Some sort of Romulan game,\" Riker said thoughtfully. \"Trying to make us guess what they're up to.\""
                                            },
                                            {
                                                "example_id": "661cd645-618a-41a8-84d1-95b2bef9558c",
                                                "sense_id": "62b55cfe-b1ab-3b19-875e-2c4645966e03",
                                                "text": "\"He looks like a Romulan.\" Suddenly, her attention is focused on him and she calls across the street, \"Hey, monkey Romulan, sort it out!\""
                                            },
                                            {
                                                "example_id": "e998e6c4-4e54-446f-a495-a22f98043952",
                                                "sense_id": "62b55cfe-b1ab-3b19-875e-2c4645966e03",
                                                "text": "...the law vaporizes like a Romulan warrior into the ions of space."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Romulan",
                                "target_lang_code": "en",
                                "target_senses": [
