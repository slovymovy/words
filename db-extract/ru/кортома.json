                "senses": [
                    {
                        "sense_id": "b8128f88-98f0-3dcb-9598-0d22aa1c6863",
                        "entry_id": "530e4390-d7ef-3985-b619-3bb24f6675eb",
                        "glosses": [
                            "устар., диал. наём, аренда земельных участков, лесных и водных угодий и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84edd026-b028-4992-9201-1836c945c450",
                                "sense_id": "b8128f88-98f0-3dcb-9598-0d22aa1c6863",
                                "text": "Распустил кой-кого из людей на оброки да отдал свои угодья в кортомы, только и доходу в том-с."
                            },
                            {
                                "example_id": "7686b822-398c-4406-a8c7-3bf32da8ba94",
                                "sense_id": "b8128f88-98f0-3dcb-9598-0d22aa1c6863",
                                "text": "Полеводство она нарушила, отдала землю в кортому крестьянам, а за собой оставила усадьбу с небольшим лоскутком земли, на котором был разведен садик с небольшим огородцем."
                            }
                        ]
                    }
