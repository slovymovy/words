        "fr-extract.jsonl": [
            {
                "entry_id": "9e53b6d6-d655-3671-9004-6252615e05dc",
                "word": "chloroforme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2ef51a81-0b83-4bee-9ae5-1e384f0c91a4",
                        "entry_id": "9e53b6d6-d655-3671-9004-6252615e05dc",
                        "tags": [
                            "plural"
                        ],
                        "form": "chloroformes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d53fe16-7e6e-36ed-a90b-3d6760bf15bc",
                        "entry_id": "9e53b6d6-d655-3671-9004-6252615e05dc",
                        "glosses": [
                            "Nom usuel du trichlorométhane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc23a2bb-69b8-447c-a1c4-643054cce0f0",
                                "sense_id": "1d53fe16-7e6e-36ed-a90b-3d6760bf15bc",
                                "text": "Le chloroforme ou formène trichloré a été découvert en 1831 par Soubeyran en France et par Liebig en Allemagne."
                            },
                            {
                                "example_id": "c9ed82de-4e08-49b8-b4be-7422afa5ac30",
                                "sense_id": "1d53fe16-7e6e-36ed-a90b-3d6760bf15bc",
                                "text": "La mère envoya de l’argent, mais elle joignit à son envoi un flacon de chloroforme en lui recommandant de le boire pour échapper au déshonneur."
                            },
                            {
                                "example_id": "b9b2a29a-9fb7-40d1-83cf-bd40b7d9a946",
                                "sense_id": "1d53fe16-7e6e-36ed-a90b-3d6760bf15bc",
                                "text": "Il n’est pas pensable qu’on homme puisse supporter qu’on lui ouvre le ventre, qu’on l’ampute d’un bras, qu’on le trépane sans chloroforme."
                            },
                            {
                                "example_id": "acd9cd87-0886-4043-915c-6528c9e0983f",
                                "sense_id": "1d53fe16-7e6e-36ed-a90b-3d6760bf15bc",
                                "text": "Je fus frappé en entrant par une odeur pharmaceutique rappelant celle du chloroforme. Il s’agissait, en effet, d’un anesthésique."
                            },
                            {
                                "example_id": "67889a5e-2f1b-4bdb-8c84-9f227c64a613",
                                "sense_id": "1d53fe16-7e6e-36ed-a90b-3d6760bf15bc",
                                "text": "Il imbiba de chloroforme le coton qu’il tenait dans sa poche et pressa le tout sur son nez - de quoi le laisser plusieurs heures sur le carreau…"
                            },
                            {
                                "example_id": "6db13036-ea84-4eb9-9478-74b290610411",
                                "sense_id": "1d53fe16-7e6e-36ed-a90b-3d6760bf15bc",
                                "text": "L’homme devrait être mis K.-O. avec du chloroforme ou de l’éther, ce serait la seule manière de pratiquer l’opération à son insu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e72d2c18-f8c7-448a-b502-920c842bc904",
                        "source_entry_id": "9e53b6d6-d655-3671-9004-6252615e05dc",
                        "source_sense_id": "1d53fe16-7e6e-36ed-a90b-3d6760bf15bc",
                        "source_sense_description": "Substance",
                        "target_lang_word": "Chloroform",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chloroform",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                        "entry_id": "cb6d736b-8840-39a8-bc4e-1a896ec5b971",
                                        "glosses": [
                                            "ein 1831 erstmals hergestellter chlorierter Kohlenwasserstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3651edf5-a996-4eee-ba32-fe86eae125c9",
                                                "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                                "text": "„Ihm gelang 1831 die Herstellung von Chloroform, unabhängig von Justus von Liebig und Eugene Souberain.“"
                                            },
                                            {
                                                "example_id": "c0bfc149-47e8-45e6-aafa-df03e3fa5bda",
                                                "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                                "text": "„Am Abend des 4. November 1847 testete er mit zwei Freunden in einer privaten Runde Chloroform als Narkosemittel.“"
                                            },
                                            {
                                                "example_id": "f19f081f-8001-492f-b5b9-85931ba9bc14",
                                                "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                                "text": "„Die Vorteile des neuen Medikamentes lagen darin, dass es leicht herstellbar war, gut sedativ wirkte und wenig Nebenwirkungen aufwies, auch nicht den vom Chloroform bekannten und gefürchteten Rausch.“"
                                            },
                                            {
                                                "example_id": "bc0f6239-d29c-4819-9bf6-146e099260e5",
                                                "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                                "text": "„Aus der spanischen Fliege, einem Käfer, der zu den Forstschädlingen gehört, wird durch Ausziehn mit Chloroform eine organische Substanz, das Kantharidin, gewonnen, die offizinell ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a739dbf5-f9b1-4e7d-8bd2-07a729f70809",
