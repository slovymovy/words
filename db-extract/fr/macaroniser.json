                        "sense_id": "f05d911f-28b0-3445-bb4c-183258944990",
                        "entry_id": "d4dc017e-af2f-3c2b-8722-3f5544bdfb6f",
                        "glosses": [
                            "Mettre du latin macaronique dans ses textes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08c26ce9-ff43-41fb-9f41-293655c8b8ab",
                                "sense_id": "f05d911f-28b0-3445-bb4c-183258944990",
                                "text": "Il me vient des envies de macaroniser, après pareille lecture."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3835a78-6617-3821-8bae-6438a040caab",
                        "entry_id": "d4dc017e-af2f-3c2b-8722-3f5544bdfb6f",
                        "glosses": [
