                    "sense_definition": "An image of a computer or smartphone screen output at a given moment in time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I grabbed a <w>screenshot</w> of my desktop to show the new wallpaper.",
                            "target_lang_translations": {
                                "ru": "Я сделал <w>скриншот</w> рабочего стола, чтобы показать новые обои.",
                                "nl": "Ik heb een <w>screenshot</w> van mijn bureaublad gemaakt om de nieuwe achtergrond te laten zien.",
                                "pl": "Zrobiłem <w>zrzut ekranu</w> mojego pulpitu, aby pokazać nową tapetę.",
                                "de": "Ich habe einen <w>Screenshot</w> von meinem Desktop gemacht, um das neue Hintergrundbild zu zeigen.",
                                "fr": "J'ai fait une <w>capture d'écran</w> de mon bureau pour montrer le nouveau fond d'écran.",
                                "it": "Ho fatto uno <w>screenshot</w> del mio desktop per mostrare il nuovo sfondo.",
                                "cs": "Udělal jsem <w>snímek obrazovky</w> své plochy, abych ukázal novou tapetu.",
                                "tr": "Yeni duvar kağıdını göstermek için masaüstümün bir <w>ekran görüntüsünü</w> aldım.",
                                "es": "Hice una <w>captura de pantalla</w> de mi escritorio para mostrar el nuevo fondo de pantalla."
                            }
                        },
                        {
                            "text": "Please take a <w>screenshot</w> of the error message and send it to technical support.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, сделайте <w>снимок экрана</w> с сообщением об ошибке и отправьте его в техподдержку.",
                                "nl": "Maak alstublieft een <w>schermafbeelding</w> van de foutmelding en stuur deze naar de technische ondersteuning.",
                                "pl": "Proszę zrobić <w>zrzut ekranu</w> komunikatu o błędzie i wysłać go do pomocy technicznej.",
                                "de": "Bitte machen Sie ein <w>Bildschirmfoto</w> von der Fehlermeldung und senden Sie es an den technischen Support.",
                                "fr": "Veuillez prendre une <w>capture d'écran</w> du message d'erreur et l'envoyer au support technique.",
                                "it": "Per favore, fai una <w>cattura dello schermo</w> del messaggio di errore e inviala al supporto tecnico.",
                                "cs": "Prosím, udělejte <w>screenshot</w> té chybové zprávy a pošlete ho na technickou podporu.",
                                "tr": "Lütfen hata mesajının bir <w>ekran görüntüsünü</w> alın ve teknik desteğe gönderin.",
                                "es": "Por favor, haz una <w>captura de pantalla</w> del mensaje de error y envíala al soporte técnico."
                            }
                        }
                    ],
                    "synonyms": [
                        "screen capture",
                        "screengrab",
                        "screencap"
                    ],
                    "common_phrases": [
                        "take a screenshot",
