{
    "word_family": [
        "instinctif",
        "instinctivement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29855deb-8a44-346d-8c20-eee8eb003ecc",
                    "sense_definition": "Intuition spontanée ou pressentiment qui incite à porter un jugement ou à agir sans passer par un raisonnement logique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intuition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu devrais toujours suivre ton <w>instinct</w> quand une situation te semble suspecte."
                        },
                        {
                            "text": "Dès la première rencontre, mon <w>instinct</w> m'a dit que nous deviendrions de très bons amis."
                        }
                    ],
                    "synonyms": [
                        "intuition",
                        "flair",
                        "pressentiment"
                    ],
                    "antonyms": [
                        "raisonnement",
                        "logique"
                    ],
                    "common_phrases": [
                        "suivre son instinct",
                        "se fier à son instinct"
                    ]
                },
                {
                    "sense_id": "cde60b6b-632f-37c0-b97d-68f778861aac",
                    "sense_definition": "Ensemble des dispositions innées et héréditaires qui poussent les animaux ou les humains à accomplir des actes indispensables à leur survie ou reproduction sans apprentissage préalable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les oiseaux migrateurs s'orientent vers le sud grâce à un puissant <w>instinct</w> naturel."
                        },
                        {
                            "text": "En entendant l'alarme, les habitants ont agi par <w>instinct</w> et ont quitté le bâtiment."
                        }
                    ],
                    "antonyms": [
                        "raison",
                        "réflexion"
                    ],
                    "common_phrases": [
                        "instinct de survie",
                        "instinct maternel",
                        "agir par instinct"
                    ]
                },
                {
                    "sense_id": "68eee2c0-a5dc-368b-8bac-dce8cbd8ac44",
                    "sense_definition": "Impulsion spontanée, penchant naturel ou tendance primitive qui guide la conduite d'une personne de manière irréfléchie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>instinct</w> grégaire pousse souvent les individus à suivre aveuglément les décisions de la majorité."
                        },
                        {
                            "text": "Il a su contrôler ses bas <w>instincts</w> pour privilégier le dialogue et la tolérance."
                        }
                    ],
                    "synonyms": [
                        "pulsion",
                        "penchant",
                        "propension"
                    ],
                    "common_phrases": [
                        "instinct grégaire",
                        "bas instincts"
                    ]
                }
            ]
        }
    ]
}