                        "glosses": [
                            "Maßnahme zur Verringerung allzu heftiger Auswirkungen von Beschlüssen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "5fa75c06-1cc0-45c8-9776-77241c8b2a4d",
                                "sense_id": "811be3b8-9760-3fac-a91a-f12967d89baa",
                                "text": "Zwecks Abfederung der Auswirkungen neuer Steuern können Ausnahmen beschlossen werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4d0863bc-c96d-31af-897e-cc9a69b5e493",
                        "entry_id": "035b9b5d-8c6f-34b4-9f9e-aae449030c4f",
                        "glosses": [
                            "technische Vorrichtung zur Verringerung von Stößen, zum Beispiel beim Fahrwerk von Fahrzeugen oder Flugzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62de991b-3225-4a55-9f52-39694df73f61",
                                "sense_id": "4d0863bc-c96d-31af-897e-cc9a69b5e493",
                                "text": "Bei Fahrzeugen dient der Einbau von Stoßdämpfern der Abfederung von Unebenheiten der Fahrbahn."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
