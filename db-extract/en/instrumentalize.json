                "senses": [
                    {
                        "sense_id": "6cc7be88-0f92-33c9-a24c-55105e011334",
                        "entry_id": "3d8b4668-b066-3ab3-a2c8-cf2133f646b9",
                        "glosses": [
                            "To make into an instrument for achieving a goal."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cf88fee2-b321-4227-999e-f4b80e4c8a4b",
                                "sense_id": "6cc7be88-0f92-33c9-a24c-55105e011334",
                                "text": "[…] they also instrumentalize race to reinstate nostalgic, vanguard notions of political activism […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "6db26aa3-494f-3bcc-a591-33814743c047",
                        "entry_id": "3d8b4668-b066-3ab3-a2c8-cf2133f646b9",
                        "glosses": [
