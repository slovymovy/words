                "senses": [
                    {
                        "sense_id": "957722cf-b58f-3e46-9b89-fa77269e2de0",
                        "entry_id": "d23b6508-dba2-341f-9f83-7108fb6114aa",
                        "glosses": [
                            "Mesurer régulièrement en utilisant un baromètre (au sens figuré du mot)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34ce25ac-044d-4a21-8465-49accff5fe45",
                                "sense_id": "957722cf-b58f-3e46-9b89-fa77269e2de0",
                                "text": "Donc étant plus proche de la retraite que de mes 20 ans, je \"barométrise\" ma fatigue car je veux profiter de ma future retraite......."
                            },
                            {
                                "example_id": "c297e6d5-4565-417c-b782-819a9e26bde9",
                                "sense_id": "957722cf-b58f-3e46-9b89-fa77269e2de0",
                                "text": "Barométrisé un certain nombre de questions relatives à la publicité afin de pouvoir mesurer les évolutions dans les attitudes et les opinions."
                            },
                            {
                                "example_id": "cdb5de5a-f6b8-4e45-b2b6-45e058df005e",
                                "sense_id": "957722cf-b58f-3e46-9b89-fa77269e2de0",
                                "text": "A propos d’enquête, le Cercle des Décideurs en Santé lance un indice de confiance auprès des professionnels du secteur, indice qui sera \"barométrisé\" plusieurs fois dans l’année."
                            },
                            {
                                "example_id": "03277874-017e-4cac-982e-285f7f100711",
                                "sense_id": "957722cf-b58f-3e46-9b89-fa77269e2de0",
                                "text": "L’offre électorale est publicisée sur les chaînes de télévision et barométrisée selon les courbes des instituts de sondage d’après des procédés qui relèvent d’une marchandisation grandissante de la politique, notamment en la désins­titutionnalisant."
                            }
                        ]
                    }
