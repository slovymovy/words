                                        "entry_id": "535cf008-81e0-3833-b200-2e5c6e7c1963",
                                        "glosses": [
                                            "comparative form of old: more old, elder, senior"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "284c067f-77b0-4668-9faf-e83e43c971de",
                                                "sense_id": "fc912b42-f3f9-3334-b45a-0f4a0b64723b",
                                                "text": "My older brother and I are Catholic twins. He’s older by eleven months, not quite a year older than me."
                                            },
                                            {
                                                "example_id": "da0273ae-0e6c-4249-b3a8-6db8a8d4d209",
                                                "sense_id": "fc912b42-f3f9-3334-b45a-0f4a0b64723b",
                                                "text": "I feel a hot wind on my shoulder / And the touch of a world that is older"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
