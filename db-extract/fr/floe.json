                "senses": [
                    {
                        "sense_id": "d7da0d58-a644-31a9-a2ec-e1a0a25ae13d",
                        "entry_id": "5a218610-028d-32b0-9364-ad486ef3ea65",
                        "glosses": [
                            "Bloc de glace en mer, de 10 à 20 mètres de large pour 2 à 3 mètres d'épaisseur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7506caa5-b4e3-4cce-809b-8c46185d822c",
                                "sense_id": "d7da0d58-a644-31a9-a2ec-e1a0a25ae13d",
                                "text": "Cette glace, recouverte d’eau, forme une véritable brouelle. Elle est constituée de floes, souvent de très faibles dimensions, serrés les uns contre les autres."
                            },
                            {
                                "example_id": "44e3b0f5-6850-48ea-bb14-f958aaa57546",
                                "sense_id": "d7da0d58-a644-31a9-a2ec-e1a0a25ae13d",
                                "text": "Lorsqu’un relâchement se manifeste, et surtout pendant l’été, les champs de glace se brisent, et les hummocks, suivant qu’ils sont plus ou moins élevés et volumineux, deviennent des floes ou des floebergs."
                            },
                            {
                                "example_id": "a0498b37-4794-4b77-bfa2-bd3727314bcd",
                                "sense_id": "d7da0d58-a644-31a9-a2ec-e1a0a25ae13d",
                                "text": "À l’aide de la sonde géologique, Arctowski mesure l’épaisseur de la glace en divers points du floe; à cent mètres environ du navire, près d’un hummock, il trouve plus de huit mètres."
                            }
                        ]
                    }
