    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9b3b584a-d2b7-3884-84f8-783e97c12567",
                    "sense_definition": "Het proces van groter, langer of volwassener worden van een levend organisme.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ontwikkeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>groei</w> van deze planten is opmerkelijk snel deze zomer.",
                            "target_lang_translations": {
                                "en": "The <w>growth</w> of these plants is remarkably fast this summer."
                            }
                        },
                        {
                            "text": "Planten hebben water en zonlicht nodig voor hun <w>groei</w>.",
                            "target_lang_translations": {
                                "en": "Plants need water and sunlight for their <w>growth</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wasdom"
                    ],
                    "antonyms": [
                        "krimp"
                    ],
                    "common_phrases": [
                        "snelle groei",
                        "groei van planten"
                    ],
                    "target_lang_definitions": {
                        "en": "The process of a living organism becoming larger, longer, or more mature."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "growth",
                                "target_lang_sense_clarification": "biological development"
                            },
                            {
                                "target_lang_word": "maturation",
                                "target_lang_sense_clarification": "process of becoming mature"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e51fb3ba-43d6-3f72-a07d-7a93e41696e5",
                    "sense_definition": "De toename in omvang, hoeveelheid, waarde of intensiteit van iets niet-levends, zoals de economie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "toename",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Politici streven nog altijd naar een zo hoog mogelijke jaarlijkse <w>economische</w> <w>groei</w>.",
                            "target_lang_translations": {
                                "en": "Politicians still strive for the highest possible annual economic <w>growth</w>."
                            }
                        },
                        {
                            "text": "De stad heeft een snelle <w>groei</w> doorgemaakt in de afgelopen decennia.",
                            "target_lang_translations": {
                                "en": "The city has experienced rapid <w>growth</w> in recent decades."
                            }
                        }
                    ],
                    "antonyms": [
                        "afname",
                        "daling"
                    ],
                    "common_phrases": [
                        "economische groei",
                        "grenzen aan de groei"
                    ],
                    "target_lang_definitions": {
                        "en": "The increase in size, quantity, value, or intensity of something non-living, such as the economy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "growth",
                                "target_lang_sense_clarification": "increase in size or value"
                            },
                            {
                                "target_lang_word": "expansion",
                                "target_lang_sense_clarification": "becoming larger in scope"
                            },
                            {
                                "target_lang_word": "increase",
                                "target_lang_sense_clarification": "rise in amount"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1730f362-95ac-3569-8b2a-abf3f6bc0d6a",
                    "sense_definition": "Een numerieke toename in aantal of populatie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toename",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het Verenigd Koninkrijk zie je een nog grotere <w>groei</w> van Chinese auto's op de weg.",
                            "target_lang_translations": {
                                "en": "In the United Kingdom, you see an even greater <w>increase</w> of Chinese cars on the road."
                            }
                        },
                        {
                            "text": "De <w>groei</w> van het aantal inwoners zorgt voor een tekort aan woningen.",
                            "target_lang_translations": {
                                "en": "The <w>growth</w> in the number of inhabitants is causing a housing shortage."
                            }
                        }
                    ],
                    "common_phrases": [
                        "groei van het aantal"
                    ],
                    "target_lang_definitions": {
                        "en": "A numerical increase in number or population."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "growth",
                                "target_lang_sense_clarification": "increase in numbers"
                            },
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "upward trend in quantity"
                            },
                            {
                                "target_lang_word": "surge",
                                "target_lang_sense_clarification": "sudden large increase"
                            }
                        ]
                    }
                }
            ]
        },
        {
