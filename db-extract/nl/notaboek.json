                "senses": [
                    {
                        "sense_id": "9917325b-0466-319f-bd9f-5522d58b5d36",
                        "entry_id": "ec21b83a-81b8-3547-97b0-e26da643003d",
                        "glosses": [
                            "een schrift in boekvorm voor het maken van aantekeningen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fc696be-2b93-420e-8980-237f9cb7bc4d",
                                "sense_id": "9917325b-0466-319f-bd9f-5522d58b5d36",
                                "text": "\"Ik lees de absurde verhalen die pagina na pagina mijn notaboeken vullen, niet meer in staat ze in te passen in een westerse logica van oorzaak en gevolg, van goed en kwaad en redelijkheid. Het is alsof de Somalische realiteit je voortdurend op het verkeerde been zet.\""
                            },
                            {
                                "example_id": "afd73785-6a7d-4356-b9e9-c3936c34c875",
                                "sense_id": "9917325b-0466-319f-bd9f-5522d58b5d36",
                                "text": "\"De Moleskine-agenda's en -notablokken vind je hier dan weer wel. In principe zou dat ook niet mogen, maar er is nog altijd een vage boekenlink.\" (op de Moleskineproducten staat \"het notaboek van Hemingway, Picasso en Chatwin\", nvdr)."
                            }
                        ]
                    }
