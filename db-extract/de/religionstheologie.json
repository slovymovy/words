                                "target_senses": [
                                    {
                                        "sense_id": "3cc2c146-7632-3b4a-a3d8-1c120abd17cd",
                                        "entry_id": "a1e87c67-4c81-3bde-ad86-5104f6a04bca",
                                        "glosses": [
                                            "The study of God, a god, or gods; and of the truthfulness of religion in general."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a4e0d54-de5d-3f38-858b-fd02e51041c9",
                                        "entry_id": "a1e87c67-4c81-3bde-ad86-5104f6a04bca",
                                        "glosses": [
                                            "Synonym of religious studies."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57fe9ba3-3b61-436a-bff9-f44c9bb2897c",
                                                "sense_id": "1a4e0d54-de5d-3f38-858b-fd02e51041c9",
                                                "text": "Theology is a study, but religion is an experience. Theology is the study of religion, and when we study theology we are studying religion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5c82a17-482c-353e-af2b-280db4a00c6d",
                                        "entry_id": "a1e87c67-4c81-3bde-ad86-5104f6a04bca",
                                        "glosses": [
                                            "An organized method of interpreting spiritual works and beliefs into practical form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3887daf3-f7b4-3764-96e2-2544aabee266",
                                        "entry_id": "a1e87c67-4c81-3bde-ad86-5104f6a04bca",
                                        "glosses": [
                                            "A particular belief within a religion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57879a74-babf-470d-85c6-1f62bf2a7448",
                                                "sense_id": "3887daf3-f7b4-3764-96e2-2544aabee266",
                                                "text": "In this context, one could conceivably hold onto the theology that baptism is essential for salvation."
                                            },
                                            {
                                                "example_id": "db145ece-2f07-4101-9387-79fc413eb3c6",
                                                "sense_id": "3887daf3-f7b4-3764-96e2-2544aabee266",
                                                "text": "Most Muslims reject the theology that Jesus died on a cross and was resurrected from the dead (though there is some ambiguity in the Qur'an on the matter), but they do hold that he ascended to heaven and will return again."
                                            },
                                            {
                                                "example_id": "b0b9ca2d-f4cb-452c-acaa-2cb65ba0400f",
                                                "sense_id": "3887daf3-f7b4-3764-96e2-2544aabee266",
                                                "text": "Another problem with the theology that Jews are chosen for a universal ethical mission is that one does not need to be Jewish to be a beacon of light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b616a1ac-db8c-3352-9914-8e77c7e46734",
                                        "entry_id": "a1e87c67-4c81-3bde-ad86-5104f6a04bca",
                                        "glosses": [
                                            "Subjective marginal details."
                                        ],
