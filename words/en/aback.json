{
    "word_family": [
        "back",
        "backward",
        "backwards"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "20688839-e659-3c7d-8d2d-8e9925b1efbf",
                    "sense_definition": "By surprise; startled; dumbfounded.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden news of the company's closure really took the employees <w>aback</w>.",
                            "target_lang_translations": {
                                "pl": "Nagła wiadomość o zamknięciu firmy naprawdę <w>zaskoczyła</w> pracowników."
                            }
                        },
                        {
                            "text": "She was completely taken <w>aback</w> by his unexpected and rude comment during the meeting.",
                            "target_lang_translations": {
                                "pl": "Była całkowicie <w>zbita z tropu</w> jego nieoczekiwanym i niegrzecznym komentarzem podczas spotkania."
                            }
                        }
                    ],
                    "synonyms": [
                        "unawares"
                    ],
                    "common_phrases": [
                        "taken aback"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zaskoczony, zbity z tropu, zdumiony."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zaskoczony",
                                "target_lang_sense_clarification": "odczuwający zdziwienie w wyniku nagłego zdarzenia"
                            },
                            {
                                "target_lang_word": "zbity z tropu",
                                "target_lang_sense_clarification": "zdezorientowany, wytrącony z równowagi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c69b1d4f-4363-3ba1-9cfd-c522f7225292",
                    "sense_definition": "Towards the back or rear; backwards.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stepped <w>aback</w> to avoid the falling debris from the construction site.",
                            "target_lang_translations": {
                                "pl": "Cofnął się <w>do tyłu</w>, aby uniknąć spadającego gruzu z placu budowy."
                            }
                        },
                        {
                            "text": "The horse suddenly jumped <w>aback</w> when it heard the loud thunderclap.",
                            "target_lang_translations": {
                                "pl": "Koń nagle odskoczył <w>do tyłu</w>, gdy usłyszał głośny grzmot."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "W kierunku tylnym, do tyłu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "do tyłu",
                                "target_lang_sense_clarification": "w kierunku przeciwnym do przodu"
                            },
                            {
                                "target_lang_word": "wstecz",
                                "target_lang_sense_clarification": "w kierunku odwrotnym do ruchu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4393b2d-86c5-342c-aeae-0a7b3db1bc11",
                    "sense_definition": "In the rear; a distance behind.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers left the tools <w>aback</w> in the field while they went for lunch.",
                            "target_lang_translations": {
                                "pl": "Robotnicy zostawili narzędzia <w>z tyłu</w> pola, gdy poszli na lunch."
                            }
                        },
                        {
                            "text": "The house stands <w>aback</w> from the main road, hidden by tall trees.",
                            "target_lang_translations": {
                                "pl": "Dom stoi <w>z tyłu</w> za główną drogą, ukryty przez wysokie drzewa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in Caribbean English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Z tyłu, w tylnej części, w oddali za czymś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "z tyłu",
                                "target_lang_sense_clarification": "w miejscu znajdującym się za obiektem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "366089b1-564a-36a3-b4ca-f6760e0bbeae",
                    "sense_definition": "Backward against the mast; said of sails pressed by wind from the forward side.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship was caught <w>aback</w> when the wind shifted suddenly during the storm.",
                            "target_lang_translations": {
                                "pl": "Statek został <w>wzięty na wstecz</w>, gdy wiatr nagle zmienił kierunek podczas sztormu."
                            }
                        },
                        {
                            "text": "The captain ordered the crew to adjust the sails before they were blown <w>aback</w>.",
                            "target_lang_translations": {
                                "pl": "Kapitan rozkazał załodze wyregulować żagle, zanim zostaną <w>wzięte na wstecz</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "caught aback"
                    ],
                    "target_lang_definitions": {
                        "pl": "W żeglarstwie: o żaglach, na które wiatr wieje od strony dziobu, hamując statek."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wzięty na wstecz",
                                "target_lang_sense_clarification": "o żaglach pracujących pod wiatr"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a00bebd9-1501-3680-9799-1b8c84db422c",
                    "sense_definition": "An inscribed stone square.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient monument featured a decorative <w>aback</w> with Latin inscriptions.",
                            "target_lang_translations": {
                                "pl": "Starożytny pomnik posiadał dekoracyjną <w>płytę inskrypcyjną</w> z łacińskimi napisami."
                            }
                        },
                        {
                            "text": "Archaeologists discovered a weathered <w>aback</w> buried beneath the temple ruins.",
                            "target_lang_translations": {
                                "pl": "Archeolodzy odkryli zwietrzałą <w>płytę inskrypcyjną</w> pogrzebaną pod ruinami świątyni."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical architectural contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Architektoniczny element dekoracyjny w kształcie kwadratowej płyty z inskrypcją."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "płyta inskrypcyjna",
                                "target_lang_sense_clarification": "kamienna tablica z wyrytym napisem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}