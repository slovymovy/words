                "senses": [
                    {
                        "sense_id": "5e0be865-27b4-3103-8bc6-bafe96a38ca6",
                        "entry_id": "67b162c2-621b-309b-acb8-b277793e32ba",
                        "glosses": [
                            "water waarin zouten opgelost zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20b40f12-0f88-495e-ab3b-8e82aed8d7e1",
                                "sense_id": "5e0be865-27b4-3103-8bc6-bafe96a38ca6",
                                "text": "Vanwege de verwachte hogere neerslaghoeveelheden in de bekkens van Rijn, Maas en Schelde moet een hogere afvoer van zoetwater via de Nederlandse rivierendelta gerealiseerd worden, en vanwege de verwachte stijging van de zeespiegel moet de verdediging tegen zoutwater vanuit de Noordzee opnieuw bekeken worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34e5d312-1e8f-402b-a28d-14a145f955f4",
                        "source_entry_id": "67b162c2-621b-309b-acb8-b277793e32ba",
                        "source_sense_id": "5e0be865-27b4-3103-8bc6-bafe96a38ca6",
                        "target_lang_word": "Salzwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salzwasser",
