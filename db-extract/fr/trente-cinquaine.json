                        "entry_id": "118ac7e8-5360-3de1-ba23-79237908a355",
                        "glosses": [
                            "Âge proche de trente-cinq ans."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "f3a69e79-cae4-43f5-8ab3-8302717e051d",
                                "sense_id": "38157d33-c74d-39a3-a481-44897afb5a72",
                                "text": "Imaginez une personne d’une trente-cinquaine d’années (mais qui ne les paraît pas), carrossée comme Vénus au temps de sa jeunesse …."
                            },
                            {
                                "example_id": "b728a923-7fe6-489f-a122-2f608dcf2590",
                                "sense_id": "38157d33-c74d-39a3-a481-44897afb5a72",
                                "text": "La crise de la trente-cinquaine... Qui suis-je ? Où vais-je ? Qui sucerai-je ?"
                            },
                            {
                                "example_id": "1ed2180e-3630-475c-9893-c3ab6ddb6014",
                                "sense_id": "38157d33-c74d-39a3-a481-44897afb5a72",
                                "text": "Le flicaillon avait la trente-cinquaine juvénile, un blouson de cuir noir et un vieux calepin de la même couleur avec une tête de Chewbacca imprimée sur la tranche."
                            },
                            {
                                "example_id": "f96ab5d3-f487-440f-82f3-996e19112ef5",
                                "sense_id": "38157d33-c74d-39a3-a481-44897afb5a72",
                                "text": "Cela fait deux fois que je lis : « Il avait la trente-cinquaine » , je trouve que c’est pénible à l’oreille, mais je me demande surtout s’il est correct d’employer ce terme."
                            }
                        ]
                    }
