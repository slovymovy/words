                                                "example_id": "e566bd25-1911-49b7-b041-5b914f5abac2",
                                                "sense_id": "f3c08fcf-490f-342d-b3d5-021546d9dcf5",
                                                "text": "V červenci roku 2016 Městský soud v Praze odmítl návrh na předběžné opatření, jímž by byla činnost Uberu zakázána."
                                            }
                                        ]
