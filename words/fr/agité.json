    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cd860c81-9251-38c5-aa37-3fbacae0ff2d",
                    "sense_definition": "Qui est animé d'un mouvement vif, irrégulier ou tumultueux.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent souffle fort et le lac devient très <w>agité</w> ce soir.",
                            "target_lang_translations": {
                                "en": "The wind is blowing hard and the lake is getting very <w>choppy</w> tonight.",
                                "ru": "Ветер сильно дует, и сегодня вечером озеро становится очень <w>неспокойным</w>.",
                                "de": "Der Wind weht stark, und heute Abend wird der See sehr <w>bewegt</w>.",
                                "es": "El viento sopla fuerte y esta noche el lago se pone muy <w>agitado</w>.",
                                "zh": "今晚风刮得很猛，湖面变得非常<w>汹涌</w>。"
                            }
                        },
                        {
                            "text": "Après une nuit particulièrement <w>agitée</w>, il s'est réveillé avec un grand mal de tête.",
                            "target_lang_translations": {
                                "en": "After a particularly <w>restless</w> night, he woke up with a terrible headache.",
                                "ru": "После особенно <w>беспокойной</w> ночи он проснулся с сильной головной болью.",
                                "de": "Nach einer besonders <w>unruhigen</w> Nacht wachte er mit heftigen Kopfschmerzen auf.",
                                "es": "Después de una noche particularmente <w>agitada</w>, se despertó con un fuerte dolor de cabeza.",
                                "zh": "度过了一个特别<w>不安</w>的夜晚，他醒来时头疼得厉害。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mouvementé",
                        "tumultueux",
                        "houleux"
                    ],
                    "antonyms": [
                        "calme",
                        "paisible",
                        "tranquille"
                    ],
                    "common_phrases": [
                        "mer agitée",
                        "nuit agitée",
                        "sommeil agité"
                    ],
                    "target_lang_definitions": {
                        "en": "Moving vigorously, irregularly or turbulently, especially of water, wind or the sea.",
                        "ru": "Находящийся в резком, неравномерном или бурном движении, особенно о воде, ветре или море.",
                        "de": "In heftiger, unregelmäßiger oder stürmischer Bewegung, besonders bei Wasser, Wind oder Meer.",
                        "es": "Que se mueve con fuerza, de forma irregular o turbulenta, especialmente el agua, el viento o el mar.",
                        "zh": "形容海面、湖面或水流等因风力而剧烈翻腾、起伏不平静。"
                    },
