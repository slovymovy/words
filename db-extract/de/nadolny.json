                "senses": [
                    {
                        "sense_id": "52943a0b-e5ff-3228-a7da-6cc2e4219c15",
                        "entry_id": "14623902-8ed3-329a-9f99-513251601279",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38884529-b3cc-436c-b17c-35d925cac6a7",
                                "sense_id": "52943a0b-e5ff-3228-a7da-6cc2e4219c15",
                                "text": "Frau Nadolny ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8ea19dff-7b1e-4c74-96d2-206692f935d3",
                                "sense_id": "52943a0b-e5ff-3228-a7da-6cc2e4219c15",
                                "text": "Herr Nadolny wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3dab5baf-2fb8-4b13-a73b-ef7d46e6b6af",
                                "sense_id": "52943a0b-e5ff-3228-a7da-6cc2e4219c15",
                                "text": "Die Nadolnys fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "d28dff64-0133-4162-8e80-c6d0218b5009",
                                "sense_id": "52943a0b-e5ff-3228-a7da-6cc2e4219c15",
                                "text": "Der Nadolny trägt nie die Pullover, die die Nadolny ihm strickt."
                            },
                            {
                                "example_id": "001f53a2-2d01-47ee-8174-f0135d88cd37",
                                "sense_id": "52943a0b-e5ff-3228-a7da-6cc2e4219c15",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Nadolny kommt, geht der Herr Nadolny.“"
                            },
                            {
                                "example_id": "d42189df-c824-4608-8cbc-dcd5bf4a9a46",
                                "sense_id": "52943a0b-e5ff-3228-a7da-6cc2e4219c15",
                                "text": "Nadolny kommt und geht."
                            },
                            {
                                "example_id": "b412991c-5de6-4da8-a20d-9bf5aa53762a",
                                "sense_id": "52943a0b-e5ff-3228-a7da-6cc2e4219c15",
                                "text": "Nadolnys kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
