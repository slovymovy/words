{
    "word_family": [
        "kidder",
        "kiddo"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70665cb0-0070-363b-a49f-deb0b307ba7a",
                    "sense_definition": "A child, adolescent, or young adult.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "human_young",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is just a <w>kid</w>, so it is normal for her to play with toys.",
                            "target_lang_translations": {
                                "ru": "Она всего лишь <w>ребёнок</w>, поэтому для неё нормально играть с игрушками.",
                                "zh": "她只是个<w>孩子</w>，所以玩玩具是很正常的。"
                            }
                        },
                        {
                            "text": "The <w>kids</w> are playing soccer in the park right now.",
                            "target_lang_translations": {
                                "ru": "<w>Дети</w> играют в футбол в парке прямо сейчас.",
                                "zh": "<w>孩子们</w>现在正在公园里踢足球。"
                            }
                        }
                    ],
                    "synonyms": [
                        "child",
                        "youngster",
                        "youth",
                        "juvenile",
                        "minor",
                        "adolescent"
                    ],
                    "antonyms": [
                        "adult",
                        "grown-up"
                    ],
                    "common_phrases": [
                        "just a kid",
                        "little kid",
                        "cool kid",
                        "poor kid"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Standard informal word for a child."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ребёнок, подросток или молодой человек (обычно в разговорной речи).",
                        "zh": "儿童、青少年或年轻人（通常用于口语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ребёнок",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "мальчишка",
                                "target_lang_sense_clarification": "мальчик (разг.)"
                            },
                            {
                                "target_lang_word": "девчонка",
                                "target_lang_sense_clarification": "девочка (разг.)"
                            },
                            {
                                "target_lang_word": "пацан",
                                "target_lang_sense_clarification": "мальчик, парень (простореч.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "孩子",
                                "target_lang_sense_clarification": "通用称呼"
                            },
                            {
                                "target_lang_word": "小孩",
                                "target_lang_sense_clarification": "指年幼者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a365bf85-854d-325a-81e9-bd636b313245",
                    "sense_definition": "One's son or daughter, regardless of age.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "human_young",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you have any <w>kids</w> of your own?",
                            "target_lang_translations": {
                                "ru": "У тебя есть свои <w>дети</w>?",
                                "zh": "你有自己的<w>孩子</w>吗？"
                            }
                        },
                        {
                            "text": "He wants to take his <w>kids</w> to the zoo this weekend.",
                            "target_lang_translations": {
                                "ru": "Он хочет сводить своих <w>детей</w> в зоопарк в эти выходные.",
                                "zh": "他想这个周末带他的<w>孩子</w>去动物园。"
                            }
                        }
                    ],
                    "synonyms": [
                        "child",
                        "son",
                        "daughter"
                    ],
                    "antonyms": [
                        "parent"
                    ],
                    "common_phrases": [
                        "have kids",
                        "my kid",
                        "our kids",
                        "raise kids"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Standard informal word for offspring."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сын или дочь, независимо от возраста.",
                        "zh": "某人的子女，不分年龄。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ребёнок",
                                "target_lang_sense_clarification": "сын или дочь"
                            },
                            {
                                "target_lang_word": "дети",
                                "target_lang_sense_clarification": "множественное число"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "孩子",
                                "target_lang_sense_clarification": "指子女"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "002c9c8c-6b03-3520-92ef-1ac00944603c",
                    "sense_definition": "Used as a form of address for a child, teenager, or young adult.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "human_young",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>kid</w>, can you help me carry these bags?",
                            "target_lang_translations": {
                                "ru": "Эй, <w>парень</w>, можешь помочь мне донести эти сумки?",
                                "zh": "嘿，<w>小家伙</w>，能帮我提一下这些袋子吗？"
                            }
                        },
                        {
                            "text": "Here's looking at you, <w>kid</w>.",
                            "target_lang_translations": {
                                "ru": "За тебя, <w>малыш</w>.",
                                "zh": "敬你一杯，<w>孩子</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма обращения к ребёнку, подростку или кому-то моложе говорящего.",
                        "zh": "对儿童、青少年或比自己年轻的人的称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малыш",
                                "target_lang_sense_clarification": "ласковое или снисходительное обращение"
                            },
                            {
                                "target_lang_word": "парень",
                                "target_lang_sense_clarification": "обращение к юноше"
                            },
                            {
                                "target_lang_word": "детка",
                                "target_lang_sense_clarification": "фамильярное обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小家伙",
                                "target_lang_sense_clarification": "亲昵或随意的称呼"
                            },
                            {
                                "target_lang_word": "孩子",
                                "target_lang_sense_clarification": "长辈对晚辈的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a9830f6-b749-3f26-b0fb-b7091800087c",
                    "sense_definition": "A young goat.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "goat_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother goat fed her <w>kid</w> in the grassy field.",
                            "target_lang_translations": {
                                "ru": "Коза покормила своего <w>козлёнка</w> на зеленом лугу.",
                                "zh": "母山羊在草地上喂养它的<w>小山羊</w>。"
                            }
                        },
                        {
                            "text": "A young <w>kid</w> can stand up and walk shortly after birth.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>козлёнок</w> может вставать и ходить вскоре после рождения.",
                                "zh": "<w>小山羊</w>出生后不久就能站立行走。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "goat kid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Детёныш козы.",
                        "zh": "小山羊。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "козлёнок",
                                "target_lang_sense_clarification": "животное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小山羊",
                                "target_lang_sense_clarification": "动物幼崽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20b699dd-5f1f-3861-9127-4d3370298e6c",
                    "sense_definition": "Soft leather made from the skin of a young goat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "goat_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a pair of elegant white <w>kid</w> gloves to the opera.",
                            "target_lang_translations": {
                                "ru": "Она надела пару элегантных белых <w>лайковых</w> перчаток в оперу.",
                                "zh": "她戴着一双优雅的白色<w>小羊皮</w>手套去听歌剧。"
                            }
                        },
                        {
                            "text": "These expensive shoes are made of the finest <w>kid</w>.",
                            "target_lang_translations": {
                                "ru": "Эти дорогие туфли сделаны из лучшей <w>лайки</w>.",
                                "zh": "这些昂贵的鞋子是用最好的<w>小羊皮</w>制成的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kidskin"
                    ],
                    "common_phrases": [
                        "kid gloves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая кожа, выделанная из шкуры козлёнка.",
                        "zh": "用小山羊皮制成的柔软皮革。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лайка",
                                "target_lang_sense_clarification": "вид кожи"
                            },
                            {
                                "target_lang_word": "шевро",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小羊皮",
                                "target_lang_sense_clarification": "皮革材质"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ba1dde3-14c1-3c4e-9fa4-273bcce00226",
                    "sense_definition": "To make jokes or say things that are not serious.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deception_humor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was only <w>kidding</w> when I said I didn't like the gift.",
                            "target_lang_translations": {
                                "ru": "Я просто <w>шутил</w>, когда сказал, что мне не нравится подарок.",
                                "zh": "我说不喜欢这份礼物只是在<w>开玩笑</w>。"
                            }
                        },
                        {
                            "text": "You must be <w>kidding</w> if you think that is true.",
                            "target_lang_translations": {
                                "ru": "Ты, должно быть, <w>шутишь</w>, если думаешь, что это правда.",
                                "zh": "如果你觉得那是真的，那你一定是在<w>开玩笑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "joke",
                        "jest",
                        "tease"
                    ],
                    "common_phrases": [
                        "just kidding",
                        "no kidding",
                        "you're kidding",
                        "only kidding"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шутить или говорить несерьёзно.",
                        "zh": "开玩笑或说话不严肃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шутить",
                                "target_lang_sense_clarification": "говорить ради забавы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开玩笑",
                                "target_lang_sense_clarification": "言语戏谑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14268068-ba77-3952-ab29-a8e3bc8e2568",
                    "sense_definition": "To deceive, trick, or tease someone, often playfully.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deception_humor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't <w>kid</w> yourself into thinking this will be easy.",
                            "target_lang_translations": {
                                "ru": "Не <w>обманывай</w> себя, думая, что это будет легко.",
                                "zh": "别<w>欺骗</w>自己，以为这会很容易。"
                            }
                        },
                        {
                            "text": "I <w>kid</w> you not, the fish was as big as my arm.",
                            "target_lang_translations": {
                                "ru": "Я тебе <w>не вру</w>, рыба была размером с мою руку.",
                                "zh": "我没<w>骗</w>你，那条鱼有我的手臂那么大。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trick",
                        "tease",
                        "fool",
                        "dupe"
                    ],
                    "common_phrases": [
                        "kid yourself",
                        "kid you not"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обманывать, разыгрывать или дразнить кого-то.",
                        "zh": "欺骗、戏弄或捉弄某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обманывать",
                                "target_lang_sense_clarification": "вводить в заблуждение"
                            },
                            {
                                "target_lang_word": "разыгрывать",
                                "target_lang_sense_clarification": "подшучивать"
                            },
                            {
                                "target_lang_word": "надувать",
                                "target_lang_sense_clarification": "обманывать (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "欺骗",
                                "target_lang_sense_clarification": "误导他人"
                            },
                            {
                                "target_lang_word": "戏弄",
                                "target_lang_sense_clarification": "捉弄他人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fff761a0-90c1-37e6-b765-c7cfd96c3cab",
                    "sense_definition": "Of a goat: to give birth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "goat_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nanny goat <w>kidded</w> early this morning in the barn.",
                            "target_lang_translations": {
                                "ru": "Коза <w>окотилась</w> сегодня рано утром в сарае.",
                                "zh": "那只母山羊今天清早在谷仓里<w>产仔</w>了。"
                            }
                        },
                        {
                            "text": "They expect the herd to <w>kid</w> twice this year.",
                            "target_lang_translations": {
                                "ru": "Они ожидают, что стадо будет <w>котиться</w> дважды в этом году.",
                                "zh": "他们预计羊群今年会<w>产仔</w>两次。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О козе: рожать, приносить потомство.",
                        "zh": "指山羊：分娩、产仔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "котиться",
                                "target_lang_sense_clarification": "рожать (о животных)"
                            },
                            {
                                "target_lang_word": "окотиться",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "产仔",
                                "target_lang_sense_clarification": "动物分娩"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
