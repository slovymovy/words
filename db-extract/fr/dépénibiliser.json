                "senses": [
                    {
                        "sense_id": "c73ea1d1-7f56-3666-9224-5a8cff6e6f05",
                        "entry_id": "12425d64-69d7-3264-808c-db5a4f228c55",
                        "glosses": [
                            "Faire perdre son caractère pénible à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f697f765-9ef4-4147-98bb-5919543dc16a",
                                "sense_id": "c73ea1d1-7f56-3666-9224-5a8cff6e6f05",
                                "text": "Couteau énergisé pour dépénibiliser les tâches de parrage et de découpe répétitives."
                            },
                            {
                                "example_id": "ddfded4b-4f85-4ad0-b671-f6ea00a3f1b7",
                                "sense_id": "c73ea1d1-7f56-3666-9224-5a8cff6e6f05",
                                "text": "Il est possible de « dépénibiliser » des tâches par des actions de prévention, mais des relais doivent être mis en place au sein des entreprises."
                            },
                            {
                                "example_id": "cc834eca-4772-4e35-b5a0-1ec8738ae609",
                                "sense_id": "c73ea1d1-7f56-3666-9224-5a8cff6e6f05",
                                "text": "Grâce à la Wii, on a enfin un moyen de dépénibiliser les tâches ménagères!"
                            }
                        ]
                    }
