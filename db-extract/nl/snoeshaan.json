                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "4d9c4c89-8d1a-4726-859e-1aae803a51c8",
                        "entry_id": "7a33092e-96c2-3ee0-84cf-bcc7339048e0",
                        "tags": [
