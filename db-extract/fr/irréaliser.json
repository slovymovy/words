                        "sense_id": "290664a5-715d-38ac-964a-fbe5099df371",
                        "entry_id": "3e38ccf2-c6bb-3b4e-952e-84c85b10356d",
                        "glosses": [
                            "Ne pas réaliser, ne pas accomplir quelque chose."
