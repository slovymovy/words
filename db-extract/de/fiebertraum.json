                "senses": [
                    {
                        "sense_id": "cb064374-0fb2-3e64-bf6b-2157a9e1e43f",
                        "entry_id": "197fef04-d68b-3b30-81f0-3c5ca821db0d",
                        "glosses": [
                            "Wahnvorstellungen und gestörte Sinneswahrnehmung, die im Fieber auftreten können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a81d3cd-3c54-48f9-8b5e-de00b3356a77",
                                "sense_id": "cb064374-0fb2-3e64-bf6b-2157a9e1e43f",
                                "text": "„Ich bejahte kurz und fand, dass das alles hier ein Fiebertraum war.“"
                            },
                            {
                                "example_id": "5dfb8970-591f-4c22-9f56-13227ee5465b",
                                "sense_id": "cb064374-0fb2-3e64-bf6b-2157a9e1e43f",
                                "text": "„Für einen winzigen Moment glaube ich, die vergangene Nacht war nichts als ein Fiebertraum.“"
                            },
                            {
                                "example_id": "d96bd49f-af13-4ed7-98cb-b8d79160f736",
                                "sense_id": "cb064374-0fb2-3e64-bf6b-2157a9e1e43f",
                                "text": "„Da fragte ich schnell: »Und was habe ich im Fiebertraum alles geredet?«“"
                            },
                            {
                                "example_id": "40ed4153-f69d-45de-8928-f482dbd61974",
                                "sense_id": "cb064374-0fb2-3e64-bf6b-2157a9e1e43f",
                                "text": "„Nach der Feier ging ich zurück ins Lazarett und versank in meinem Fiebertraum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
