                        "sense_id": "b8bf62da-96c8-3c35-a688-68bcd796bc18",
                        "entry_id": "0ff20943-2128-3bbc-98ee-e524b40c6596",
                        "glosses": [
                            "To profess falsely; to teach incorrectly or make an incorrect claim."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "aaa6bf2c-9eb1-49bc-aaf1-b1eaad86ec9b",
                                "sense_id": "b8bf62da-96c8-3c35-a688-68bcd796bc18",
                                "text": "Keep me back, O Lord, from them who misprofess arts of healing the soul, or of the body, by means not imprinted by thee in the church for the soul, or not in nature for the body."
                            },
                            {
                                "example_id": "aab79ae6-4eae-445b-99dd-66754927c308",
                                "sense_id": "b8bf62da-96c8-3c35-a688-68bcd796bc18",
                                "text": "Consequently, such actions miseducate the public and misprofess what dentistry is about, and they violate the dentist's obligations to integrity and education."
                            }
                        ]
                    }
