                            {
                                "example_id": "e22cc53c-b0f7-4783-be3e-0c3c8d6b3bdd",
                                "sense_id": "289ab666-6eb8-3c43-a888-11fe7c7f14de",
                                "text": "You may find in the first few months that your budgeted estimates are only noddingly close to your actual expenses."
                            },
