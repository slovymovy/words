{
    "word_family": [
        "determine",
        "determined",
        "determinate",
        "determinant",
        "determiner",
        "determinism",
        "deterministic",
        "indetermination",
        "predetermination"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3312b23b-f880-356e-add0-0822f16f34d1",
                    "sense_definition": "The quality of being resolute and having a firm purpose to achieve something despite difficulties.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "resoluteness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Through sheer <w>determination</w>, we managed to escape from the tornado.",
                            "target_lang_translations": {
                                "ru": "Благодаря одной лишь <w>решительности</w>, нам удалось спастись от торнадо.",
                                "zh": "凭借纯粹的<w>决心</w>，我们成功逃离了龙卷风。"
                            }
                        },
                        {
                            "text": "She showed great <w>determination</w> to succeed in her new career despite the initial setbacks.",
                            "target_lang_translations": {
                                "ru": "Она проявила огромную <w>решимость</w> добиться успеха в своей новой карьере, несмотря на первоначальные неудачи.",
                                "zh": "尽管起初遭遇挫折，她仍表现出极大的<w>毅力</w>，要在新事业中取得成功。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resoluteness",
                        "persistence",
                        "tenacity",
                        "resolve",
                        "fortitude"
                    ],
                    "common_phrases": [
                        "sheer determination",
                        "show determination",
                        "grim determination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество человека, проявляющееся в твердости и непоколебимом намерении достичь цели, несмотря на трудности.",
                        "zh": "指在困难面前仍能保持坚定意志并致力于实现目标的品质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решительность",
                                "target_lang_sense_clarification": "смелость и быстрота в принятии решений"
                            },
                            {
                                "target_lang_word": "решимость",
                                "target_lang_sense_clarification": "отсутствие боязни в осуществлении решений"
                            },
                            {
                                "target_lang_word": "целеустремленность",
                                "target_lang_sense_clarification": "направленность на достижение цели"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "决心",
                                "target_lang_sense_clarification": "坚定不移的意志"
                            },
                            {
                                "target_lang_word": "毅力",
                                "target_lang_sense_clarification": "坚持不懈的品质"
                            },
                            {
                                "target_lang_word": "坚韧",
                                "target_lang_sense_clarification": "面对困难时的顽强"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8961ec1-0a41-31e4-8cfa-1eb33a1a4228",
                    "sense_definition": "A formal decision or conclusion reached after a process of deliberation or investigation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tribunal has reached a <w>determination</w> in respect of this matter.",
                            "target_lang_translations": {
                                "ru": "Трибунал вынес <w>определение</w> по данному вопросу.",
                                "zh": "法庭已就此事作出了<w>裁定</w>。"
                            }
                        },
                        {
                            "text": "The committee will make a final <w>determination</w> on the budget by the end of the week.",
                            "target_lang_translations": {
                                "ru": "Комитет примет окончательное <w>решение</w> по бюджету к концу недели.",
                                "zh": "委员会将在本周末前对预算作出最终<w>决定</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "decision",
                        "conclusion",
                        "judgment",
                        "verdict",
                        "resolution"
                    ],
                    "common_phrases": [
                        "reach a determination",
                        "final determination",
                        "make a determination"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in legal or official contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное решение или заключение, принятое после обсуждения или расследования.",
                        "zh": "经过审议或调查后所作出的正式决定或结论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решение",
                                "target_lang_sense_clarification": "официальное постановление"
                            },
                            {
                                "target_lang_word": "определение",
                                "target_lang_sense_clarification": "юридическая форма решения суда"
                            },
                            {
                                "target_lang_word": "вердикт",
                                "target_lang_sense_clarification": "судебное или окончательное решение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "决定",
                                "target_lang_sense_clarification": "正式的结论或选择"
                            },
                            {
                                "target_lang_word": "裁定",
                                "target_lang_sense_clarification": "法律或正式程序中的判决"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "527546be-c6b1-3d21-be3c-eaf70f6a0375",
                    "sense_definition": "The act or process of calculating, measuring, or identifying something precisely.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>determination</w> of the oxygen in the air requires specialized laboratory equipment.",
                            "target_lang_translations": {
                                "ru": "<w>Определение</w> содержания кислорода в воздухе требует специального лабораторного оборудования.",
                                "zh": "空气中氧含量的<w>测定</w>需要专业的实验室设备。"
                            }
                        },
                        {
                            "text": "Accurate <w>determination</w> of the level of salt in sea water is vital for the study.",
                            "target_lang_translations": {
                                "ru": "Точное <w>установление</w> уровня соли в морской воде жизненно важно для исследования.",
                                "zh": "准确<w>测量</w>海水中盐分的含量对这项研究至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "calculation",
                        "measurement",
                        "assessment",
                        "evaluation"
                    ],
                    "common_phrases": [
                        "accurate determination",
                        "determination of level"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс точного вычисления, измерения или идентификации чего-либо.",
                        "zh": "对某事物进行精确计算、测量或识别的行为或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определение",
                                "target_lang_sense_clarification": "выяснение или вычисление чего-либо"
                            },
                            {
                                "target_lang_word": "установление",
                                "target_lang_sense_clarification": "выявление факта или значения"
                            },
                            {
                                "target_lang_word": "измерение",
                                "target_lang_sense_clarification": "процесс нахождения величины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "测定",
                                "target_lang_sense_clarification": "通过实验确定数值"
                            },
                            {
                                "target_lang_word": "测量",
                                "target_lang_sense_clarification": "确定物理量的大小"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "092765ac-bec4-32a1-a923-69407407cf10",
                    "sense_definition": "The process of identifying the genus and species of an organism or the type of a mineral.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "classification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am indebted to a friend for the <w>determination</w> of most of these shells.",
                            "target_lang_translations": {
                                "ru": "Я обязан другу за <w>определение</w> видов большинства этих раковин.",
                                "zh": "多亏了一位朋友帮我<w>鉴定</w>了大部分贝壳，我对此感激不尽。"
                            }
                        },
                        {
                            "text": "The botanist spent hours on the <w>determination</w> of the rare plant species found in the valley.",
                            "target_lang_translations": {
                                "ru": "Ботаник провел часы за <w>идентификацией</w> редкого вида растения, найденного в долине.",
                                "zh": "植物学家花了数小时对在山谷中发现的稀有植物物种进行<w>鉴定</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "classification",
                        "identification",
                        "categorization"
                    ],
                    "antonyms": [
                        "generalization"
                    ],
                    "common_phrases": [
                        "species determination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс идентификации рода и вида организма или типа минерала.",
                        "zh": "识别生物的属和种或矿物类型的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определение",
                                "target_lang_sense_clarification": "научная идентификация вида"
                            },
                            {
                                "target_lang_word": "идентификация",
                                "target_lang_sense_clarification": "распознавание объекта"
                            },
                            {
                                "target_lang_word": "классификация",
                                "target_lang_sense_clarification": "отнесение к определенной группе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鉴定",
                                "target_lang_sense_clarification": "科学上的识别与分类"
                            },
                            {
                                "target_lang_word": "识别",
                                "target_lang_sense_clarification": "辨认出事物的种类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85e01986-00bd-379c-abe5-1d6ffa2de7eb",
                    "sense_definition": "The act of bringing something to an end, especially a legal agreement or lease.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "termination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All incumbrances will normally end automatically with the <w>determination</w> of the lease.",
                            "target_lang_translations": {
                                "ru": "Все обременения обычно прекращаются автоматически с <w>истечением</w> срока аренды.",
                                "zh": "所有负担通常会随着租赁合同的<w>终止</w>而自动结束。"
                            }
                        },
                        {
                            "text": "The contract provided for the <w>determination</w> of the agreement upon thirty days' notice.",
                            "target_lang_translations": {
                                "ru": "Контракт предусматривал <w>расторжение</w> соглашения при условии уведомления за тридцать дней.",
                                "zh": "合同规定，在提前三十天通知的情况下，可以<w>解除</w>协议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "termination",
                        "expiration",
                        "conclusion",
                        "end"
                    ],
                    "common_phrases": [
                        "determination of the lease"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт прекращения чего-либо, особенно юридического соглашения или договора аренды.",
                        "zh": "使某事终止的行为，尤指法律协议或租赁合同的终止。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прекращение",
                                "target_lang_sense_clarification": "остановка действия договора"
                            },
                            {
                                "target_lang_word": "расторжение",
                                "target_lang_sense_clarification": "официальное аннулирование соглашения"
                            },
                            {
                                "target_lang_word": "истечение",
                                "target_lang_sense_clarification": "окончание срока действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "终止",
                                "target_lang_sense_clarification": "合同或协议的结束"
                            },
                            {
                                "target_lang_word": "解除",
                                "target_lang_sense_clarification": "正式废除合同关系"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}