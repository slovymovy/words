                        "entry_id": "acb5bb76-57a6-332d-9e6b-2a159b22f3ee",
                        "glosses": [
                            "Qui est connu, vérifié ou vrai."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42c7f1a0-b58e-4469-8cff-4635cf43ea85",
                                "sense_id": "572ef8c3-1a97-32a5-acae-88e54f0030c4",
                                "text": "[…] ; sa mère est une cyclothymique avérée passant, sans motifs apparents, d'un sentiment profond d'ennui à celui d'une gaîté plus ou moins exubérante."
                            },
                            {
                                "example_id": "e462fcb1-e121-4ec9-9596-e46b63496361",
                                "sense_id": "572ef8c3-1a97-32a5-acae-88e54f0030c4",
                                "text": "Le président et le secrétaire général de la Fédération albanaise ont été sanctionnés ce mercredi par l'AIU - l'Athletic Integrity Unit, une instance internationale qui lutte contre le dopage et la tricherie dans la discipline - à cinq et quatre années de suspension en raison d'un cas avéré de falsification de résultat."
                            }
                        ]
                    }
                ],
