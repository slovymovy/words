                ],
                "senses": [
                    {
                        "sense_id": "e0c0cd6c-3a3e-3b98-9cb0-c0e7a3860c37",
                        "entry_id": "11cad394-1f79-3ea3-bfaf-3e0274063c26",
                        "glosses": [
                            "зоол. пресноводная рыба семейства карповых (лат. Scardinius erythrophthalmus) с красными плавниками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64705f26-583e-4a8c-86a4-0f6112e19a85",
                                "sense_id": "e0c0cd6c-3a3e-3b98-9cb0-c0e7a3860c37",
                                "text": "Краснопёрка гораздо шире обыкновенной плотицы; кругловатой своей фигурой и складом совершенно похожа на подлещика, покрыта чешуёй жёлто-золотистого блестящего цвета; края этой чешуи как будто оторочены золотисто-коричневой каёмочкой; перья, особенно нижние, яркого красного цвета, отчего она и получила своё имя, глаза коричневые; всё это вместе делает её одною из самых красивых рыб."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9b4d103-144d-3f57-8256-fe8359d98703",
                        "entry_id": "11cad394-1f79-3ea3-bfaf-3e0274063c26",
                        "glosses": [
                            "мясо такой рыбы, употребляемое в пищу"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2da45c69-fc43-369d-b63a-e6f016bea55a",
                        "entry_id": "11cad394-1f79-3ea3-bfaf-3e0274063c26",
                        "glosses": [
                            "кушанье, приготовленное из такого мяса"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b95c62d9-5269-4111-bacd-d72025fbdbfe",
                        "source_entry_id": "11cad394-1f79-3ea3-bfaf-3e0274063c26",
                        "target_lang_word": "gardí",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gardí",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "09e6ce76-9ff3-36ba-9875-ccf4ddcfeb2b",
                                        "entry_id": "bd552f44-7e40-335f-8cbb-500ed9848764",
                                        "glosses": [
                                            "(Scardinius erythrophthalmus) Pez ciprínido (Cyprinidae), dulceacuícola, gregario, de unos 2 kg de peso, de hábitos pelágicos y bentónicos y distribución amplia por Europa, de donde es nativo, y buena parte de Asia además de otras muchas áreas del mundo donde ha sido introducido."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f6ef0e-3b27-4db8-9411-87db16f3c25e",
                                                "sense_id": "09e6ce76-9ff3-36ba-9875-ccf4ddcfeb2b",
                                                "text": "El gardí es más oscuro en la parte posterior que en el vientre, adoptando una coloración verde-rojiza."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
