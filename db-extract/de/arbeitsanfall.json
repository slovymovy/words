                "senses": [
                    {
                        "sense_id": "f4028690-8aac-3553-a048-351f87528ff6",
                        "entry_id": "3f91886c-9304-31db-adfd-3bef01bb4809",
                        "glosses": [
                            "das Anfallen von Arbeit, das Vorhandensein von unbearbeiteten Aufträgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df61f3f-7a0f-4c8b-ab0e-caa1576688f5",
                                "sense_id": "f4028690-8aac-3553-a048-351f87528ff6",
                                "text": "Abhängig vom Arbeitsanfall werden wir noch Zeitpersonal einstellen müssen."
                            },
                            {
                                "example_id": "0a5dd222-3fed-46f4-a48f-5a2e849a3a67",
                                "sense_id": "f4028690-8aac-3553-a048-351f87528ff6",
                                "text": "Der Arbeitsanfall wird am Wochenende hoffentlich nicht so hoch werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0b1231a8-2284-3cd4-a6c2-9bed1c1db7b5",
                        "entry_id": "3f91886c-9304-31db-adfd-3bef01bb4809",
                        "glosses": [
                            "eine plötzliche, für eine Person untypische Neigung, eine gewisse Arbeitsaufgabe in Angriff zu nehmen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "912cb479-180f-45cc-abb2-36e21218465e",
                                "sense_id": "0b1231a8-2284-3cd4-a6c2-9bed1c1db7b5",
                                "text": "Du und ein Staubsauger? Hast du einen Arbeitsanfall?"
                            },
                            {
                                "example_id": "1200e491-47f2-4f03-aade-dd7325ea97ac",
                                "sense_id": "0b1231a8-2284-3cd4-a6c2-9bed1c1db7b5",
                                "text": "Die Nähmaschine mit einem Stapel reparaturbedürftiger Kleidung daneben rundete das Bild eines Zimmers ab, das Frau möglichst schnell wieder verlassen sollte, wollte sie kein schlechtes Gewissen oder einen Arbeitsanfall bekommen."
                            },
                            {
                                "example_id": "bb3ca115-d76b-44c5-9607-8ed92abaa604",
                                "sense_id": "0b1231a8-2284-3cd4-a6c2-9bed1c1db7b5",
                                "text": "Die hatte sowieso in der letzten Zeit einen Arbeitsanfall nach dem anderen, wenn sie der Zorn über ihre Auseinandersetzung mit dem Peter erneut übermannte."
                            },
                            {
                                "example_id": "ef6bfc4a-59d2-4930-8400-83e987757f60",
                                "sense_id": "0b1231a8-2284-3cd4-a6c2-9bed1c1db7b5",
                                "text": "Der spontan Arbeitssüchtige: Er verhält sich scheinbar normal - bis er spontan einen Arbeitsanfall bekommt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
