                                        "sense_id": "36f66d08-4f8a-3a68-90c5-1170b5527e8c",
                                        "entry_id": "bad5b4a6-cb89-38f0-8a95-224d540f0007",
                                        "glosses": [
                                            "Stress provoqué sur un être vivant par un brusque changement de température."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
