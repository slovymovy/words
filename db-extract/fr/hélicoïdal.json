                        "glosses": [
                            "En forme d’hélice, disposé en hélice, en colimaçon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49dbf047-304a-4e10-b48f-bbb0bf784335",
                                "sense_id": "d6ca8334-a3c0-37b0-a8a5-75e60ec6837f",
                                "text": "Les trous seront effectués à la tarière hélicoïdale ou à la barre à mine avec comme objectif d’enfoncer la tige à 1 mètre de profondeur."
                            },
                            {
                                "example_id": "8cbe39cb-e4c4-41ee-b570-c4311204e6fc",
                                "sense_id": "d6ca8334-a3c0-37b0-a8a5-75e60ec6837f",
                                "text": "Enfin, derrière un battant, nous manquons de chuter dans un escalier hélicoïdal qui plonge vers une cave."
                            }
                        ]
