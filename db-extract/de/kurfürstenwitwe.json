                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f642207a-42e6-4fe1-be72-f811a7ff0772",
                                "sense_id": "224c6528-28f3-3905-adac-7dc4ff60e0bf",
                                "text": "„Bei der Kurfürstenwitwe von Sachsen mußte ich die beiden letzten Male, die ich mit ihr zu sprechen die Ehre hatte, den empfindlichsten Tadel einstecken.“"
                            },
                            {
                                "example_id": "f09a97ff-0e08-4fee-b216-bd93fc5d03f1",
                                "sense_id": "224c6528-28f3-3905-adac-7dc4ff60e0bf",
                                "text": "„Die Kurfürstenwitwe, die adligen Landstände, die lutherische Geistlichkeit und der als Administrator eingesetzte ernestinische Herzog Friedrich Wilhelm von Sachsen-Weimar-Altenburg (* 1562, 1586 bis 1602) restituierten das Luthertum im Land.“"
                            }
                        ],
