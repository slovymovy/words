                    {
                        "translation_id": "7bacf057-851e-4c40-baec-ec66eda72532",
                        "source_entry_id": "f60e1e54-5d87-3d9a-8431-3ecdcef875a8",
                        "source_sense_id": "f3bab2e6-7350-3a09-bdd6-2c6a5940b6f5",
                        "source_sense_description": "(Informatique) Constructions propres à un langage de programmation.",
                        "target_lang_word": "idiom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a29f182-75be-3b5b-baa1-c50b7c4fbb3c",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "A manner of speaking, a mode of expression peculiar to a language, language family, or group of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59d87e37-8c8d-4f6d-8ecf-ad670d282f6c",
                                                "sense_id": "6a29f182-75be-3b5b-baa1-c50b7c4fbb3c",
                                                "text": "In English, idiom requires the indefinite article in a phrase such as \"she's an engineer\", whereas in Spanish, idiom forbids it."
                                            },
                                            {
                                                "example_id": "251e739c-fe54-45ed-9e43-37d875570181",
                                                "sense_id": "6a29f182-75be-3b5b-baa1-c50b7c4fbb3c",
                                                "text": "Some of the usage prescriptions improved clarity and were kept; others that yielded discordant violations of idiom were eventually revised."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ce0d470-657d-39f6-a17f-9844b552116d",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "A manner of speaking, a mode of expression peculiar to a language, language family, or group of people.",
                                            "A programming construct or phraseology that is characteristic of the language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83ed047a-020a-4bdf-92d8-b8bd6707f9af",
                                                "sense_id": "1ce0d470-657d-39f6-a17f-9844b552116d",
                                                "text": "I have to use the same assignment and call to raw_input in two places. How can I avoid that? I can use the while True/break idiom: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85542318-9dde-3c72-949f-c9dfffd01684",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "A language or language variety; specifically, a restricted dialect used in a given historical period, context etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "694ce1c5-20d5-41ca-94e1-4514efdf8a2d",
                                                "sense_id": "85542318-9dde-3c72-949f-c9dfffd01684",
                                                "text": "In the idiom of the day, they were sutlers, although today they'd probably be called vendors."
                                            },
                                            {
                                                "example_id": "9364d6fd-b949-416f-bd8f-3126dd3dee8c",
                                                "sense_id": "85542318-9dde-3c72-949f-c9dfffd01684",
                                                "text": "Many parents and teachers have become irritated to the point of distraction at the way the weed-style growth of \"like\" has spread through the idiom of the young."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ede583ed-43b7-3680-9f82-2d38a0609ddd",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "An established phrasal expression whose meaning may not be deducible from the literal meanings of its component words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db5e533-89e7-4d96-996a-2da4bc4ae757",
                                                "sense_id": "ede583ed-43b7-3680-9f82-2d38a0609ddd",
                                                "text": "She often spoke in idioms, pining for salad days and complaining about pots calling the kettle black."
                                            },
                                            {
                                                "example_id": "4d267c6a-d6ab-4038-a898-cb5fa85f273c",
                                                "sense_id": "ede583ed-43b7-3680-9f82-2d38a0609ddd",
                                                "text": "You’re history, we say […]. Surely it is an American idiom. Impossible to imagine a postwar European saying, “You’re history. . . . That’s history,” meaning fuhgeddaboudit, pal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0668da73-7b3a-3a29-9a5a-03b1d5ee14d3",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "An artistic style (for example, in art, architecture, or music); an instance of such a style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "416762a8-e688-4c82-9ce0-cf636b403e6a",
                                                "sense_id": "0668da73-7b3a-3a29-9a5a-03b1d5ee14d3",
                                                "text": "the idiom of the expressionists"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
