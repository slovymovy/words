                "senses": [
                    {
                        "sense_id": "12897344-608a-369c-a6e1-b04deb48640d",
                        "entry_id": "7e643141-1610-3393-a12b-ab04aae02d8b",
                        "glosses": [
                            "Faire perdre son caractère archaïque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2b5de55-0120-43b1-8b1d-f79c970fffed",
                                "sense_id": "12897344-608a-369c-a6e1-b04deb48640d",
                                "text": "Par delà les conceptions extensionnelles, il semble nécessaire de réhabiliter (de désarchaïser) la logique taxinomique de la spécialisation et cela est possible sur de nouvelles bases car elle est devenue opératoire dans la conceptualité mathématique contemporaine."
                            },
                            {
                                "example_id": "db9b10c4-3aa3-4bc9-b7e0-64b9514f82f0",
                                "sense_id": "12897344-608a-369c-a6e1-b04deb48640d",
                                "text": "Il fallait éliminer toute trace de religion, désarchaïser la langue pour mieux la rapprocher du parler des prolétaires juifs."
                            }
                        ]
                    }
                ],
