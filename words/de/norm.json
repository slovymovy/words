            "pos": "noun",
            "senses": [
                {
                    "sense_id": "068d1ca0-32d9-3755-a810-3bd9aa75ca45",
                    "sense_definition": "Verbindliche Verhaltensregel oder Richtlinie innerhalb einer Gesellschaft oder Gruppe.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "gesellschaftliche_regel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zu den <w>Normen</w> des gesellschaftlichen Umgangs gehört es, höflich miteinander zu sprechen."
                        },
                        {
                            "text": "In jeder Kultur existieren eigene moralische Werte und <w>Normen</w>."
                        }
                    ],
                    "synonyms": [
                        "Regel",
                        "Richtschnur",
                        "Maßstab"
                    ],
                    "common_phrases": [
                        "gesellschaftliche Normen",
                        "soziale Normen"
                    ]
                },
                {
                    "sense_id": "52e5200d-2eb3-3d64-bdf8-dfc09abb3e69",
                    "sense_definition": "Das Übliche, Gewohnte oder dem Durchschnitt Entsprechende.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "durchschnitt_standard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit seinen Leistungen weicht der Schüler deutlich von der <w>Norm</w> ab."
                        },
                        {
                            "text": "Sein Blutdruck liegt glücklicherweise wieder im Bereich der <w>Norm</w>."
                        }
                    ],
                    "synonyms": [
                        "Durchschnitt",
                        "Standard"
                    ],
                    "antonyms": [
                        "Ausnahme"
                    ],
                    "common_phrases": [
                        "von der Norm abweichen",
                        "der Norm entsprechen"
                    ]
                },
                {
                    "sense_id": "8a44e0e0-aa6e-36c5-b5ab-dc32b53897b4",
                    "sense_definition": "Gesetzlich oder behördlich festgelegter technischer Standard für Produkte oder Verfahren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technischer_standard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das neue Gerät entspricht allen europäischen <w>Normen</w> für Sicherheit."
                        },
                        {
                            "text": "Die Europäische Union legt strenge <w>Normen</w> für den Umweltschutz fest."
                        }
                    ],
                    "synonyms": [
                        "Standard",
                        "Vorschrift"
                    ],
                    "common_phrases": [
                        "geltende Normen",
                        "neue Normen festlegen"
                    ]
                },
                {
                    "sense_id": "16f22b45-9c89-3648-85db-13b8aad579ce",
                    "sense_definition": "Zu erbringende Mindestleistung im Arbeitsleben oder als Qualifikation im Sport.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "leistungsvorgabe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Athletin hat die geforderte <w>Norm</w> für die Weltmeisterschaft knapp erreicht."
                        },
                        {
                            "text": "Wer den vollen Bonus erhalten möchte, muss die vereinbarte <w>Norm</w> erfüllen."
                        }
                    ],
                    "synonyms": [
                        "Mindestleistung",
                        "Vorgabe"
                    ],
                    "common_phrases": [
                        "die Norm erfüllen"
                    ]
                }
            ]
        }
    ]
