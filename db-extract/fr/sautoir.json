                "entry_id": "4237d1b8-c5db-301a-a4cf-7039e3ac54ab",
                "word": "sautoir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fb713b5e-1dc3-44ad-86ec-aa1dca89ed23",
                        "entry_id": "4237d1b8-c5db-301a-a4cf-7039e3ac54ab",
                        "tags": [
                            "plural"
                        ],
                        "form": "sautoirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2a6b2e5-d1f9-3f3f-ba3c-bbab37261dc6",
                        "entry_id": "4237d1b8-c5db-301a-a4cf-7039e3ac54ab",
                        "glosses": [
                            "Pièce de harnais de chevalier qui était attachée à la selle de son cheval."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "489ee062-7ba7-4ae9-bf7f-0964df5952b5",
                                "sense_id": "b2a6b2e5-d1f9-3f3f-ba3c-bbab37261dc6",
                                "text": "Le sautoir servait au chevalier d'étrier pour sauter sur son cheval."
                            }
                        ]
                    },
                    {
                        "sense_id": "518973d6-6523-39b8-b4d5-c1fe77992082",
                        "entry_id": "4237d1b8-c5db-301a-a4cf-7039e3ac54ab",
                        "glosses": [
                            "Disposition de deux objets en X, en croix de saint André. On ne l’emploie guère que dans la locution en sautoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cdc7c3a-4228-453c-bb84-fb49aa47f0e8",
                                "sense_id": "518973d6-6523-39b8-b4d5-c1fe77992082",
                                "text": "Deux pièces de bois mises en sautoir."
                            },
                            {
                                "example_id": "3fc7c2f1-ccea-420a-99f0-9448b6157975",
                                "sense_id": "518973d6-6523-39b8-b4d5-c1fe77992082",
                                "text": "Deux épées étaient placées en sautoir sur le cercueil."
                            },
                            {
                                "example_id": "a7f752bb-e52b-402e-8e7f-519b2e9dc4c0",
                                "sense_id": "518973d6-6523-39b8-b4d5-c1fe77992082",
                                "text": "Un quart d’heure plus tard, accompagné de Graventout, le brigadier, et de Bellot, le gendarme, chacun ayant le sabre au côté et le revolver en sautoir, il entrait chez M. Pellissier."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9e6aaeb-571f-3c86-a804-2ec878b57bc9",
                        "entry_id": "4237d1b8-c5db-301a-a4cf-7039e3ac54ab",
                        "glosses": [
                            "Pièce honorable, réunion de la bande et de la barre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f40d7cd-f356-4af4-8f01-4de68e25e4cd",
                                "sense_id": "f9e6aaeb-571f-3c86-a804-2ec878b57bc9",
                                "text": "Porter d’argent au sautoir d’azur."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1b0eb52-0dac-3c5d-b611-693e728163d4",
                        "entry_id": "4237d1b8-c5db-301a-a4cf-7039e3ac54ab",
                        "glosses": [
                            "Long collier de perles ou d'autres matières qui descend très bas sur la poitrine (par analogie de forme avec la pièce de harnais du même nom)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb09cc59-dd21-406a-8cb9-35db67bd8fe7",
                                "sense_id": "c1b0eb52-0dac-3c5d-b611-693e728163d4",
                                "text": "Tout me parut simple : écrire, c’est augmenter d’une perle le sautoir des Muses, […]"
                            },
                            {
                                "example_id": "6f197e8e-be21-4a19-a6b6-931c93364eec",
                                "sense_id": "c1b0eb52-0dac-3c5d-b611-693e728163d4",
                                "text": "À son cou, un sautoir interminable, que l’éprouve du regard exceptionnellement lourd, est entouré quatre fois. Des breloques d’or y pendent : lions assis, cachets, « cieux » sphériques incrustés de pierres de couleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "025bc415-7ade-341f-846c-2d60a890c640",
                        "entry_id": "4237d1b8-c5db-301a-a4cf-7039e3ac54ab",
                        "glosses": [
                            "Espèce de casserole à bords droits et peu hauts, tourtière."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "16cccfcd-fa78-4beb-9b69-6b57b6cf3cb9",
                                "sense_id": "025bc415-7ade-341f-846c-2d60a890c640",
                                "text": "Placer un morceau de lapereau dans le sautoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "70f5fb1f-daf6-32dc-be2f-b077b9a9b0ba",
                        "entry_id": "4237d1b8-c5db-301a-a4cf-7039e3ac54ab",
                        "glosses": [
                            "Piste d’élan pour le saut en hauteur ou en longueur, le saut à la perche ou le triple saut."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68e563a4-d669-42ea-836e-70b710a92ee9",
                                "sense_id": "70f5fb1f-daf6-32dc-be2f-b077b9a9b0ba",
                                "text": "Le club de l'US Arradon athlétisme a inauguré ce dimanche son nouveau sautoir en hauteur."
                            }
                        ]
                    },
                    {
                        "sense_id": "e04c6bee-2fce-3610-8edd-1e6d838843cd",
                        "entry_id": "4237d1b8-c5db-301a-a4cf-7039e3ac54ab",
                        "glosses": [
                            "Tremplin pour le saut à ski."
                        ],
                        "tags": [
                            "Sports de glisse"
                        ],
                        "examples": [
                            {
                                "example_id": "7c52823d-a8d1-4233-8026-3a221d44627b",
                                "sense_id": "e04c6bee-2fce-3610-8edd-1e6d838843cd",
                                "text": "Sur le sautoir des JO-1972, le champion du monde de vol à skis a planté deux gros sauts […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
