                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a639eba-daf4-47c0-b493-c2f2822cc394",
                                "sense_id": "8471f431-0298-3ca4-b539-da72f25286e0",
                                "text": "De wijk bij het station staat bekend als een buurt waar drugs worden gehandeld. Bewoners zeiden NOS-correspondent Joris van Poppel dat de gebeurtenissen van vandaag vermoedelijk het gevolg zijn van een drugsruzie."
                            },
                            {
                                "example_id": "f3000788-d0fd-42f7-abcd-e65ca739a94e",
                                "sense_id": "8471f431-0298-3ca4-b539-da72f25286e0",
                                "text": "De politie hoopt door de uitzending in contact te komen met mensen die meer weten over de drugsruzie, de schutters en de opdrachtgevers van de liquidaties."
                            },
                            {
                                "example_id": "47e6a01f-195b-4199-8484-413b412ed985",
                                "sense_id": "8471f431-0298-3ca4-b539-da72f25286e0",
                                "text": "Twee van hen worden gezocht wegens moord. Een van hen zou in juli 2015 een tiener hebben doodgeschoten in Liverpool, mogelijk na een drugsruzie. De ander wordt ervan verdacht een man te hebben neergestoken in een kroeg."
                            }
                        ]
                    }
