                        "source_entry_id": "53df790a-a8e9-363f-96a9-cf58f1e19f80",
                        "source_sense_id": "964a5e38-3124-3efa-a127-536bc5a3c175",
                        "target_lang_word": "handicap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handicap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ede2d4a1-c95a-38e1-8068-be261bfad25a",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "Something that prevents, hampers, or hinders."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbaea73d-8a1d-48ae-af1e-aff6170090a5",
                                                "sense_id": "ede2d4a1-c95a-38e1-8068-be261bfad25a",
                                                "text": "Age is often a handicap."
                                            },
                                            {
                                                "example_id": "2ad4a5a7-5db0-422c-ae84-985eb873fee7",
                                                "sense_id": "ede2d4a1-c95a-38e1-8068-be261bfad25a",
                                                "text": "Captain Edward Carlisle[…]felt a curious sensation of helplessness seize upon him as he met her steady gaze,[…]; he could not tell what this prisoner might do. He cursed the fate which had assigned such a duty, cursed especially that fate which forced a gallant soldier to meet so superb a woman as this under handicap so hard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad6a714c-1d7e-3e74-8440-0f179cb85491",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "An allowance of a certain amount of time or distance in starting, granted in a race (or other contest of skill) to the competitor possessing disadvantages; or an additional weight or other hindrance imposed upon the one possessing advantages, in order to equalize, as much as possible, the chances of success."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eab7bf2c-4383-4205-b54b-c10184cade4a",
                                                "sense_id": "ad6a714c-1d7e-3e74-8440-0f179cb85491",
                                                "text": "The older boy won, even though his opponent had been granted a handicap of five meters."
                                            },
                                            {
                                                "example_id": "ff2e065f-920c-4ec7-8f76-eb4544b82c55",
                                                "sense_id": "ad6a714c-1d7e-3e74-8440-0f179cb85491",
                                                "text": "A handicap in chess often involves removal of the queen's rook."
                                            },
                                            {
                                                "example_id": "05245edf-16e8-488d-9f58-49e815f1de16",
                                                "sense_id": "ad6a714c-1d7e-3e74-8440-0f179cb85491",
                                                "text": "Eventually the elephant and camel were depatched by themselves with two laps start of the bicyclist and horse, the motor car being scratch. It was a sensational race owing to the conduct of the field, but on the handicap the elephant won, bicycle second, motor car third."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baa05bf8-d42f-382b-8f62-79b17724b471",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "The disadvantage itself, in particular physical or mental disadvantages of people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "403de27e-71b0-3d19-9e07-0308d1f4be11",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "A race or similar contest in which there is an allowance of time, distance, weight, or other advantage, to equalize the chances of the competitors."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0edd0c94-d43d-346e-981a-a7d6b626a6bb",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "An old card game, similar to lanterloo."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bb76d35-0873-41cc-877b-6eba6e9eb4db",
                                                "sense_id": "0edd0c94-d43d-346e-981a-a7d6b626a6bb",
                                                "text": "Here some of us fell to handicap, a sport that I never knew before, which was very good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f462b6b-f912-3bbb-a6b0-a8d8825e0a96",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "Synonym of hand-in-cap (“old English trading game”)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
