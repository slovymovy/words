{
    "word_family": [
        "tintement",
        "tintamarre",
        "tintouin"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "db0007fc-d339-3939-bfb4-dc8b7a1260f5",
                    "sense_definition": "Produire un son aigu et clair en parlant d'objets en verre ou en métal qui s'entrechoquent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les verres à pied <w>tintent</w> joyeusement lorsque les invités portent un toast au dîner."
                        },
                        {
                            "text": "Dans sa poche, les pièces de monnaie <w>tintaient</w> au rythme de ses pas pressés."
                        }
                    ],
                    "synonyms": [
                        "résonner",
                        "carillonner"
                    ],
                    "common_phrases": [
                        "faire tinter les verres",
                        "tinter dans la poche"
                    ]
                },
                {
                    "sense_id": "cede8b62-d5b5-3217-a678-9e8bd0d50ebc",
                    "sense_definition": "Sonner à coups lents et espacés, en parlant d'une cloche.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La cloche du village <w>tinte</w> lentement pour accompagner le cortège dans la rue déserte."
                        },
                        {
                            "text": "Dans le silence de la nuit, nous pouvions entendre <w>tinter</w> les cloches au loin."
                        }
                    ],
                    "synonyms": [
                        "sonner",
                        "glas"
                    ],
                    "common_phrases": [
                        "entendre tinter la cloche",
                        "cloche qui tinte"
                    ]
                },
                {
                    "sense_id": "9674f966-2790-335c-abc9-f71ae83bca0e",
                    "sense_definition": "Produire dans l'oreille une sensation auditive de bourdonnement ou de sonnerie continue.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après ce concert particulièrement bruyant, mes oreilles n'ont pas cessé de <w>tinter</w>."
                        },
                        {
                            "text": "Une oreille me <w>tinte</w> depuis le réveil sans que je sache pourquoi."
                        }
                    ],
                    "synonyms": [
                        "bourdonner",
                        "siffler"
                    ],
                    "common_phrases": [
                        "avoir les oreilles qui tintent",
                        "oreille qui tinte"
                    ]
                },
                {
                    "sense_id": "2c278d9b-6440-3c0f-a7c9-d215b4f3c616",
                    "sense_definition": "Faire sonner une cloche à coups lents ou faire résonner un objet de manière délibérée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sacristain est monté au sommet de la tour afin de <w>tinter</w> la grosse cloche."
                        },
                        {
                            "text": "Le prêtre <w>tinta</w> la petite clochette en bronze pour rappeler le calme dans la chapelle."
                        }
                    ],
                    "synonyms": [
                        "actionner"
                    ],
                    "common_phrases": [
                        "tinter la cloche"
                    ]
                }
            ]
        }
    ]
}