                "senses": [
                    {
                        "sense_id": "afa95cfd-78df-318c-bac4-518c161b19c1",
                        "entry_id": "d69ee03d-b88a-30e4-84bf-8c624903a518",
                        "glosses": [
                            "Möbel zum Abstellen von Telekommunikationsgeräten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6ee7195-90aa-4a99-b94e-9ec8e1fc1c9e",
                                "sense_id": "afa95cfd-78df-318c-bac4-518c161b19c1",
                                "text": "„Ihre Zimmertür stand normalerweise einen Spalt offen, und das Nachtlicht im Flur war so hell, dass sie am Telefontisch vorbei zum Badezimmer gelangen konnte.“"
                            },
                            {
                                "example_id": "fb2218b5-169b-474b-8669-1af1111d6472",
                                "sense_id": "afa95cfd-78df-318c-bac4-518c161b19c1",
                                "text": "„Dazu ein Stuhl, ein Telefontisch und ein Schubladenschrank, der gleichzeitig als Ablage für Scheren und Bürsten dient.“"
                            },
                            {
                                "example_id": "50cd1d6a-5ee4-4100-bac2-e6f0bc504a8e",
                                "sense_id": "afa95cfd-78df-318c-bac4-518c161b19c1",
                                "text": "„Ina hat einmal einen Sektkorken mit einer Schnur an den Sessel beim Telefontisch gebunden, für unsere Katze.“"
                            },
                            {
                                "example_id": "eeeb75d4-1086-4d58-baf7-00fd96745a6a",
                                "sense_id": "afa95cfd-78df-318c-bac4-518c161b19c1",
                                "text": "„In der Pförtnerloge, unter dem Zimmer-Nummern-Kasten, saß ein Mann am Telefontisch; vor sich Patientenbuch und Zeitungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
