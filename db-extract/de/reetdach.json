                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06d742b4-bf66-4fa8-a208-c40db88cf7fb",
                                "sense_id": "ec8bfc39-b648-301b-b788-18a4e208cdb0",
                                "text": "Unter einem Reetdach wohnt es sich sehr angenehm."
                            },
                            {
                                "example_id": "f860c9f7-0012-44d4-bb24-bbede9f50018",
                                "sense_id": "ec8bfc39-b648-301b-b788-18a4e208cdb0",
                                "text": "„Mehrere Bauernhäuser hatten ihr graues Reetdach mit leuchtendem Ziegelrot vertauscht.“"
                            }
