{
    "word_family": [
        "rammel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43986530-bf6f-3887-8152-96fe70ac72f8",
                    "sense_definition": "Een tikkend of schurend geluid maken doordat onderdelen loszitten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude auto <w>rammelt</w> bij elke hobbel in de weg.",
                            "target_lang_translations": {
                                "ru": "Старая машина <w>дребезжит</w> на каждой кочке.",
                                "fr": "La vieille voiture <w>cliquette</w> à chaque bosse sur la route."
                            }
                        },
                        {
                            "text": "Er <w>rammelt</w> iets in de motor van de fiets.",
                            "target_lang_translations": {
                                "ru": "Что-то <w>дребезжит</w> в двигателе велосипеда.",
                                "fr": "Quelque chose <w>cliquette</w> dans le moteur du vélo."
                            }
                        }
                    ],
                    "synonyms": [
                        "ratelen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать стучащий или дребезжащий звук из-за того, что детали плохо закреплены.",
                        "fr": "Produire un bruit sec, métallique ou de cliquetis causé par des pièces mal fixées."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дребезжать",
                                "target_lang_sense_clarification": "о звуке, издаваемом неплотно пригнанными деталями"
                            },
                            {
                                "target_lang_word": "грохотать",
                                "target_lang_sense_clarification": "о громком, неприятном звуке"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "cliqueter",
                                "target_lang_sense_clarification": "produire un bruit répété de pièces métalliques ou mobiles"
                            },
                            {
                                "target_lang_word": "faire du bruit",
                                "target_lang_sense_clarification": "vibrer en faisant un bruit de ferraille ou de pièces desserrées"
                            },
                            {
                                "target_lang_word": "balloter",
                                "target_lang_sense_clarification": "s'agiter en faisant du bruit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40944993-33c3-3179-9b23-2384ce390abf",
                    "sense_definition": "Iets krachtig heen en weer bewegen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>rammelde</w> aan de deur om te kijken of deze op slot zat.",
                            "target_lang_translations": {
                                "ru": "Он <w>дергал</w> дверь, чтобы проверить, заперта ли она.",
                                "fr": "Il a <w>secoué</w> la porte pour vérifier si elle était verrouillée."
                            }
                        },
                        {
                            "text": "De dief <w>rammelde</w> hard aan het hek om binnen te komen.",
                            "target_lang_translations": {
                                "ru": "Вор сильно <w>тряс</w> ворота, чтобы пробраться внутрь.",
                                "fr": "Le voleur a violemment <w>secoué</w> le portail pour entrer."
                            }
                        }
                    ],
                    "synonyms": [
                        "schudden"
                    ],
                    "common_phrases": [
                        "aan de deur rammelen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно трясти что-либо, двигая туда-сюда.",
                        "fr": "Secouer vigoureusement d'avant en arrière ou de haut en bas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трясти",
                                "target_lang_sense_clarification": "интенсивно двигать из стороны в сторону"
                            },
                            {
                                "target_lang_word": "дергать",
                                "target_lang_sense_clarification": "резко тянуть или трясти предмет"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "secouer",
                                "target_lang_sense_clarification": "agiter vigoureusement un objet comme une porte ou une barrière"
                            },
                            {
                                "target_lang_word": "ébranler",
                                "target_lang_sense_clarification": "faire bouger avec force"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67d4ac08-388b-3eb2-9fc6-92040926dab1",
                    "sense_definition": "Een knorrend geluid maken door honger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn maag <w>rammelt</w> omdat ik de hele dag nog niets heb gegeten.",
                            "target_lang_translations": {
                                "ru": "У меня <w>урчит</w> в животе, потому что я весь день ничего не ел.",
                                "fr": "Mon ventre <w>gargouille</w> car je n'ai encore rien mangé de la journée."
                            }
                        },
                        {
                            "text": "Ik <w>rammel</w> van de honger na die lange wandeling.",
                            "target_lang_translations": {
                                "ru": "Я <w>умираю</w> от голода после той долгой прогулки.",
                                "fr": "Je <w>meurs</w> de faim après cette longue promenade."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rammelen van de honger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать урчащий звук из-за голода.",
                        "fr": "Gargouiller ou ressentir une faim intense."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "урчать",
                                "target_lang_sense_clarification": "о звуке в животе от голода"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "gargouiller",
                                "target_lang_sense_clarification": "en parlant de l'estomac ou du ventre vide"
                            },
                            {
                                "target_lang_word": "mourir de faim",
                                "target_lang_sense_clarification": "avoir excessivement faim (rammelen van de honger)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea19ef75-c8af-325b-8f1f-a9e8c8f66134",
                    "sense_definition": "Niet logisch of correct in elkaar zitten.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "logica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het hele plan <w>rammelt</w> aan alle kanten.",
                            "target_lang_translations": {
                                "ru": "Весь план <w>трещит</w> по швам.",
                                "fr": "Tout le plan <w>prend l'eau</w> de toutes parts."
                            }
                        },
                        {
                            "text": "Die juridische onderbouwing <w>rammelt</w> behoorlijk.",
                            "target_lang_translations": {
                                "ru": "Это юридическое обоснование сильно <w>хромает</w>.",
                                "fr": "Cette argumentation juridique <w>cloche</w> sérieusement."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть нелогичным, иметь изъяны или быть плохо продуманным.",
                        "fr": "Être bancal, incohérent ou mal ficelé."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трещать по швам",
                                "target_lang_sense_clarification": "о плане или системе, которая разваливается"
                            },
                            {
                                "target_lang_word": "быть шитым белыми нитками",
                                "target_lang_sense_clarification": "о плохо продуманном или нелогичном аргументе"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "clocher",
                                "target_lang_sense_clarification": "manquer de cohérence, être mal conçu"
                            },
                            {
                                "target_lang_word": "ne pas tenir debout",
                                "target_lang_sense_clarification": "à propos d'une théorie, d'un plan ou d'une argumentation"
                            },
                            {
                                "target_lang_word": "battre de l'aile",
                                "target_lang_sense_clarification": "montrer de sérieuses faiblesses"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5aa51122-9b00-310f-8799-40748513adfe",
                    "sense_definition": "Iemand fysiek mishandelen of slaan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geweld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boze menigte <w>rammelde</w> de indringer het pand uit.",
                            "target_lang_translations": {
                                "ru": "Разъяренная толпа <w>вышвырнула</w> нарушителя из здания.",
                                "fr": "La foule en colère a <w>chassé sans ménagement</w> l'intrus hors du bâtiment."
                            }
                        },
                        {
                            "text": "Hij werd door de bewakers flink <w>gerammeld</w>.",
                            "target_lang_translations": {
                                "ru": "Охранники его хорошенько <w>отколотили</w>.",
                                "fr": "Il a été copieusement <w>tabassé</w> par les gardes."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Wordt in deze betekenis nauwelijks nog gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически избивать или грубо обращаться с кем-либо.",
                        "fr": "Battre, frapper ou maltraiter physiquement quelqu'un."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колотить",
                                "target_lang_sense_clarification": "сильно бить"
                            },
                            {
                                "target_lang_word": "отдубасить",
                                "target_lang_sense_clarification": "сильно избить (разговорное)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "tabasser",
                                "target_lang_sense_clarification": "frapper violemment quelqu'un (familier)"
                            },
                            {
                                "target_lang_word": "rouer de coups",
                                "target_lang_sense_clarification": "frapper répétitivement"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}