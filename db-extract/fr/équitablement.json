                "forms": [],
                "senses": [
                    {
                        "sense_id": "0936975a-0fd0-3c93-b714-9c91e8588217",
                        "entry_id": "1ae807fc-bd4e-3ee3-a42e-93189477893c",
                        "glosses": [
                            "D’une manière équitable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06b46ffe-09d9-4d96-9c80-02602dc90d86",
                                "sense_id": "0936975a-0fd0-3c93-b714-9c91e8588217",
                                "text": "Il a jugé équitablement."
                            },
                            {
                                "example_id": "8250db8f-2a31-4803-9fcd-d143ebd6d76b",
                                "sense_id": "0936975a-0fd0-3c93-b714-9c91e8588217",
                                "text": "… nous trouvons qu’une littérature étrangère l’emporte sur nous en quelque point, nous reconnaîtrons, nous proclamerons équitablement cet avantage ; nous sommes trop riches en gloire pour être tentés de celle de personne, nous sommes trop fiers pour ne pas être justes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea0ec815-5551-44fb-a1f7-e4bf8113f8ff",
