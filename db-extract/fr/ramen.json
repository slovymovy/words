                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ec28c452-8990-427a-bd71-339f0433f4bb",
                        "entry_id": "1abb3c3b-9e2e-3c9b-bb0f-ec40f1118116",
                        "tags": [
                            "plural"
                        ],
                        "form": "ramens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f519ee7a-d743-377d-ba86-11a06bc4679e",
                        "entry_id": "1abb3c3b-9e2e-3c9b-bb0f-ec40f1118116",
                        "glosses": [
                            "Mets japonais d’origine chinoise constitué de nouilles dans un bouillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bdb719b-d54b-458a-973c-09c104980e23",
                                "sense_id": "f519ee7a-d743-377d-ba86-11a06bc4679e",
                                "text": "Les ramen sont une préparation à base de nouilles et de bouillon d’origine chinoise, mais que les Japonais mangent couramment le midi, est en train de dire M. Ozu en élevant dans les airs une quantité impressionnante de pâtes qu’il vient de tremper dans l’eau froide."
                            },
                            {
                                "example_id": "0df4ab0b-6b1d-43a3-bd51-d7d9e9bb7b6a",
                                "sense_id": "f519ee7a-d743-377d-ba86-11a06bc4679e",
                                "text": "Marie avait si faim qu’elle se sentait défaillir. Jason accepta d’avaler en vitesse des ramen dans une gargote de la gare de Chiba."
                            },
                            {
                                "example_id": "a48b59ba-fd98-41a7-a655-2c80bdf8502d",
                                "sense_id": "f519ee7a-d743-377d-ba86-11a06bc4679e",
                                "text": "Plus il y a d’ingrédients, plus le ramen est savoureux et plus le pli rapporte de points de victoire."
                            },
                            {
                                "example_id": "e70472ad-542a-47dc-a571-31f8dced3032",
                                "sense_id": "f519ee7a-d743-377d-ba86-11a06bc4679e",
                                "text": "Poulet karaage (prononcez kara-a-gué) comme dans Makanai, dorayaki des Délices de Tokyo, ramen de Tampopo, chirashi sushi de La Famille Asada… plus aucun basique de la cuisine japonaise n’aura de secret pour vous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcc8d326-ab0b-419b-bd13-539d4dcea8dd",
                        "source_entry_id": "1abb3c3b-9e2e-3c9b-bb0f-ec40f1118116",
                        "source_sense_id": "f519ee7a-d743-377d-ba86-11a06bc4679e",
                        "target_lang_word": "ramen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ramen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e5d13ee-9354-390b-9b26-3945aa6e3241",
                                        "entry_id": "d7f91a63-f5cd-3bde-baf2-51d81eaffb3e",
                                        "glosses": [
                                            "Soup noodles of wheat, with various ingredients (Japanese-Chinese style)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "353d4920-4735-45fc-a3c7-dea362222ec3",
                                                "sense_id": "2e5d13ee-9354-390b-9b26-3945aa6e3241",
                                                "text": "A founder’s first goal, Graham wrote, is becoming “ramen profitable”: spending thriftily and making just enough to afford ramen noodles for dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eba98b6-7b58-37eb-9e0e-e2d5cad4abbf",
                                        "entry_id": "d7f91a63-f5cd-3bde-baf2-51d81eaffb3e",
                                        "glosses": [
                                            "A type of instant noodles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ramen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a4c2b2d-1832-38c1-9e1c-e7e88ec8ea31",
                                        "entry_id": "4412ade4-547d-34c4-bbbd-1b418d92e2e6",
                                        "glosses": [
                                            "amen"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da135981-db05-44ec-94f4-e8d80ad3dfdf",
                                                "sense_id": "9a4c2b2d-1832-38c1-9e1c-e7e88ec8ea31",
                                                "text": "[...] For thine is the colander, the noodle, and the sauce, forever and ever. RAmen."
                                            },
                                            {
                                                "example_id": "aa6a16a4-348c-4f32-8ca9-24a1f946be8e",
                                                "sense_id": "9a4c2b2d-1832-38c1-9e1c-e7e88ec8ea31",
                                                "text": "… For thine are Meatballs, and the beer, and the strippers, for ever and ever. RAmen."
                                            },
                                            {
                                                "example_id": "50970152-944e-4e6a-bd37-2522bdb297f7",
                                                "sense_id": "9a4c2b2d-1832-38c1-9e1c-e7e88ec8ea31",
                                                "text": "They will let me wear The Chosen Attire at work, however. Ramen."
                                            },
                                            {
                                                "example_id": "1e8e4650-4021-4c83-84ec-2f4d51396436",
                                                "sense_id": "9a4c2b2d-1832-38c1-9e1c-e7e88ec8ea31",
                                                "text": "No, no, no! Until YOU stand before His Noodliness when you die. And if you do not believe in the Flying Spaghetti Monster (RAmen brother!) then you will not get to partake of the beer volcanoes, nor enjoy the strippers in Heaven."
                                            },
                                            {
                                                "example_id": "02f3e927-4af1-4bfb-b68e-d566b44d62d4",
                                                "sense_id": "9a4c2b2d-1832-38c1-9e1c-e7e88ec8ea31",
                                                "text": "YHWH\" = tetragrammaton. \"FSM\" = tetrazziniton. Ramen."
                                            },
                                            {
                                                "example_id": "ead96ea3-fda5-45ee-87e7-526588a3e05d",
                                                "sense_id": "9a4c2b2d-1832-38c1-9e1c-e7e88ec8ea31",
                                                "text": "May the Fork be with you... RAmen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
