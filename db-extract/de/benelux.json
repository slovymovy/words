                        ],
                        "form": "das Benelux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                        "entry_id": "1d3d2931-7a7d-3dce-bc6f-0dc9288a3ca7",
                        "glosses": [
                            "Union aus den drei Staaten Belgien, Niederlande und Luxemburg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdaf4874-b269-42f2-9fa9-550d4c8f8c70",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Die Bundesrepublik und der Benelux, so Marjolin im Rückblick, hätten des Gemeinsamen Marktes aus wirtschaftlichen Gründen nicht unbedingt bedurft.“"
                            },
                            {
                                "example_id": "f32b5ff1-4784-4324-9280-bc55041820c3",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Der Benelux ist ein regierungsübergreifender Kooperationsverband zwischen Belgien, den Niederlanden und Luxemburg.“"
                            },
                            {
                                "example_id": "fa5b526d-cd31-4ee2-b335-010b7c5456cb",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Der Benelux hat oft als Modell für die Vertiefung der europäischen Kooperation gedient.“"
                            },
                            {
                                "example_id": "c5e162af-506e-485e-9fbb-5712404d5899",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Der luxemburgische Premierminister Xavier Bettel zeigt sich sehr zufrieden mit dem Verlauf des Benelux-Gipfels: ‚Der Benelux lebt.‘“"
                            },
                            {
                                "example_id": "45e19230-2aa9-4586-8501-6f3f8a251acc",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Der Benelux ist eine Arbeitsgemeinschaft, die von Belgien, den Niederlanden und Luxemburg gebildet wird.“"
                            },
                            {
                                "example_id": "c082e0f9-9465-437e-999e-e609f35df5fa",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Ferner unterstrich sie die Notwendigkeit einer Übersicht über die Kompetenzen der Bürgermeister, lokalen Verwaltungen und Aufsichtsdienste in der Benelux.“"
                            },
                            {
                                "example_id": "126de968-1da9-4871-b3da-5a0292db121c",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„In diesem Kapitel gehen wir auf politische Initiativen von nationalen und regionalen Behörden in der Benelux und in Nordrhein-Westfalen ein, um die oben aufgeführten Barrieren einzureißen und energiebezogene Renovierungen in größerem Umfang zu realisieren.“"
                            },
                            {
                                "example_id": "bc8defeb-9cf6-49aa-858b-8c6c60bd1e7e",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Die Benelux war nun eher eine Organisation auf der politischen als auf der wirtschaftlichen Bühne, welche ihre eigentliche Existenzberechtigung darstellte.“"
                            },
                            {
                                "example_id": "cffa4e88-9efc-444d-9d65-03632f19777a",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Diese aufgeschlossene Haltung der belgischen Agrarverbände wurde durch einen Liberalisierungsprozeß, den die belgische Landwirtschaft in der Benelux unter niederländischem Konkurrenzdruck durchlaufen hatte, vorbereitet.“"
                            },
                            {
                                "example_id": "80a198cd-d1e6-462d-8ad3-26be7c5c570e",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Im Jahre 1960 wurde die Benelux zu einer Wirtschaftsunion erweitert und damit ein weiterer Schritt in Richtung auf eine allgemeine wirtschaftliche Integration unternommen.“"
                            },
                            {
                                "example_id": "f1e80447-7a36-4b62-bc40-40a13643c40e",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Immerhin ist die Benelux die viertgrößte Handelsmacht der Welt nach den USA, der Bundesrepublik Deutschland und Japan.“"
                            },
                            {
                                "example_id": "5e59fa49-c9e2-4562-b4d7-d0cee0fbef30",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Das Konzept einer umfassenden Freihandelszone passte hervorragend zum Selbstverständnis von Benelux, das sich zur viertgrößten Handelsmacht weltweit mauserte.“"
                            },
                            {
                                "example_id": "b900a65b-36c0-4d40-ac25-7c544a46f6c6",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Die Holzzellstoffindustrie in Benelux ist mit über 80 % des Faserholzbedarfes auf Einfuhren insbesondere aus Finnland angewiesen und vermag lediglich etwa ein Drittel des Inlandsbedarfs an Zellstoff zu decken.“"
                            },
                            {
                                "example_id": "a2ecaf4d-1223-4b6b-b922-362da6db09dc",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Ein Vertreter des Generalsekretariats von Benelux nahm ebenfalls an dem Treffen teil.“"
                            },
                            {
                                "example_id": "e776d2a4-3959-49f7-8588-9fff1312735d",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Am 10. August 1952 in Luxemburg haben wir – Franz Etzel, ein Italiener, ein Mann aus Benelux und ich selbst – als Mitglieder der Hohen Behörde der Montanunion damit begonnen, das Fundament zu legen, auf dem jetzt sehr langsam und mit vielen Schwierigkeiten aber trotzdem sehr fest Europa gebaut wird.“"
                            },
                            {
                                "example_id": "08f678be-ecf9-47cd-a083-fe9b0b222ce8",
                                "sense_id": "4279b486-ce13-3af8-a7e4-67f2a09db6a3",
                                "text": "„Benelux kann als Teil einer breiteren Strategie der Netzwerkbildung innerhalb der EU angesehen werden.“"
                            },
                            {
                                "example_id": "4fbd07e9-bf2f-4003-9c39-d0b9283fe72c",
