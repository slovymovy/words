                "senses": [
                    {
                        "sense_id": "1015395e-31df-30ce-9ee2-b0b3830ec093",
                        "entry_id": "d300cfa2-f725-328b-b170-c6f6d14aef63",
                        "glosses": [
                            "произвольное или принудительно вызываемое нарушение устойчивого состояния массива горных пород, обвал"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b87cfd45-2000-4d00-ad0e-1dd586a31538",
                                "sense_id": "1015395e-31df-30ce-9ee2-b0b3830ec093",
                                "text": "Обрушение горных пород на полотно Транскавказской магистрали произошло в 14.35 по московскому времени."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5966689-21ac-3ed0-b40f-c523094d0bec",
                        "entry_id": "d300cfa2-f725-328b-b170-c6f6d14aef63",
                        "glosses": [
                            "разрушение зданий, сооружений"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8a6fae2b-cd30-3796-86d4-79f5584289d5",
                        "entry_id": "d300cfa2-f725-328b-b170-c6f6d14aef63",
                        "glosses": [
                            "резкое снижение, понижение уровня"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2fb72da-b862-4514-8577-67464f321037",
                        "source_entry_id": "d300cfa2-f725-328b-b170-c6f6d14aef63",
                        "target_lang_word": "effondrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effondrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d381fd31-b883-3030-99a9-e5578712b80e",
                                        "entry_id": "e9200b85-4d09-31cf-ae5f-9844697dc23c",
                                        "glosses": [
                                            "Action d’effondrer ou de s’effondrer ou état d’une chose effondrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5f39b2e-e77d-4a11-8f88-c6cb40a53a90",
                                                "sense_id": "d381fd31-b883-3030-99a9-e5578712b80e",
                                                "text": "Bitche n'est plus qu'une vaste fournaise : le sifflement des obus, les craquements de l’incendie, l’effondrement des maisons, […], toutes les terreurs, tous les fracas emplissent l'air."
                                            },
                                            {
                                                "example_id": "5aaba4f9-ae04-48ab-91a1-74a15e797c0e",
                                                "sense_id": "d381fd31-b883-3030-99a9-e5578712b80e",
                                                "text": "Et tous mes modèles indiquent un effondrement écologique mondial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d7f277b-2f9a-34d6-82df-ad4b4e51d5c7",
                                        "entry_id": "e9200b85-4d09-31cf-ae5f-9844697dc23c",
                                        "glosses": [
                                            "Réduction drastique, voire totale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60418ea3-c04a-4013-ab73-e33b75c8b5f0",
                                                "sense_id": "3d7f277b-2f9a-34d6-82df-ad4b4e51d5c7",
                                                "text": "La question soulevée par Hoffman est plutôt celle de l’effondrement des barrières entre les sphères économiques, politiques et culturelles avec la militarisation de la vie elle-même."
                                            },
                                            {
                                                "example_id": "2921782c-db49-4eaa-81f5-6235dbd122c8",
                                                "sense_id": "3d7f277b-2f9a-34d6-82df-ad4b4e51d5c7",
                                                "text": "Mais quand l'Église, profitant de l'effondrement de la puissance romaine et du désarroi provoqué à travers les Gaules par les invasions barbares, s'installa dans le pays sans que nul n'y prît garde, son premier soin fut de s'assurer de la possession des terres."
                                            },
                                            {
                                                "example_id": "76e055bc-4682-412b-a0d5-3c222393afac",
                                                "sense_id": "3d7f277b-2f9a-34d6-82df-ad4b4e51d5c7",
                                                "text": "Les griots de la nouvelle économie ont déchanté. La hausse continue des marchés boursiers a laissé place à un effondrement spectaculaire."
                                            },
                                            {
                                                "example_id": "0e35f120-ca54-42eb-920b-5d8e1b86ef73",
                                                "sense_id": "3d7f277b-2f9a-34d6-82df-ad4b4e51d5c7",
                                                "text": "La sécheresse prolongée au Sahel, entre 1968 et 1973, et la famine meurtrière qui s'ensuit semblent apporter une confirmation brutale des thèses néomalthusiennes sur l’effondrement de la production agricole."
                                            },
                                            {
                                                "example_id": "40410e5c-f73c-4e5f-94b5-e7acc8263cd3",
                                                "sense_id": "3d7f277b-2f9a-34d6-82df-ad4b4e51d5c7",
                                                "text": "Car, selon l'ambassade russe à Washington, les \"déclarations irréfléchies de responsables américains risquent d'entraîner l'effondrement de relations déjà excessivement conflictuelles\"."
                                            },
                                            {
                                                "example_id": "cff6cf72-3f0b-411e-aa62-685b75be3c3d",
                                                "sense_id": "3d7f277b-2f9a-34d6-82df-ad4b4e51d5c7",
                                                "text": "« Une situation catastrophique pour l’avenir de la nation » : le porte-parole du Kremlin, Dmitri Peskov, n’a pas mâché ses mots, récemment, pour décrire l’ effondrement démographique en Russie. « Nous vivons dans le plus grand pays du monde et nous sommes de moins en moins nombreux chaque année », a également déploré le fidèle communicant de Poutine, avant d’indiquer, sans surprise, la voie à suivre : « La seule façon d’y remédier est d’accroître la natalité. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd2072fc-14e5-4a35-bfd6-afb97c54748f",
                        "source_entry_id": "d300cfa2-f725-328b-b170-c6f6d14aef63",
                        "target_lang_word": "éboulement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éboulement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70e7a35c-6a76-3b3d-861f-0224d717d88b",
                                        "entry_id": "1e3e2288-87aa-34ad-803e-e4c9c07fbad0",
                                        "glosses": [
                                            "Chute d’une chose qui s’éboule ou état d’une chose éboulée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23a5c1eb-fd44-4679-addb-9d83837b0600",
                                                "sense_id": "70e7a35c-6a76-3b3d-861f-0224d717d88b",
                                                "text": "Le village de Vouvray se trouve comme niché dans les gorges et les éboulements de ces roches, …."
                                            },
                                            {
                                                "example_id": "f8f3adb1-6a92-470f-93eb-4e3e77926ea6",
                                                "sense_id": "70e7a35c-6a76-3b3d-861f-0224d717d88b",
                                                "text": "Après un tel paroxysme, l’éboulement des côtés du cratère obstrue encore plus l’orifice du volcan, et l’oblitère entièrement. On peut alors procéder à des observations […]."
                                            },
                                            {
                                                "example_id": "cb911c3e-5c38-43b4-a810-bb070cdc685e",
                                                "sense_id": "70e7a35c-6a76-3b3d-861f-0224d717d88b",
                                                "text": "Cette berge, […], émergeait d’une dizaine de pieds. Elle était absolument accore, sans talus, et quelques portions, quelques tranches plus fraîches, attestaient des éboulements récents."
                                            },
                                            {
                                                "example_id": "422a7825-2f04-4986-a106-264a23508cbd",
                                                "sense_id": "70e7a35c-6a76-3b3d-861f-0224d717d88b",
                                                "text": "Au mois de février suivant, on entendit fréquemment des bruits sourds provenant d’éboulements et de mouvements intérieurs dans le sol; un fondis, remblayé autrefois, se manifesta de nouveau, au haut de la montagne ; […]."
                                            },
                                            {
                                                "example_id": "63e259f1-1f70-4d68-a616-a1a1db5bb8b8",
                                                "sense_id": "70e7a35c-6a76-3b3d-861f-0224d717d88b",
                                                "text": "Il m’est dit à chaque instant que l’un des grands soucis des autorités départementales, c’est l’entretien des routes, souvent emportées par des torrents, par les coulées de boue, par les éboulements, par des chutes de blocs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
