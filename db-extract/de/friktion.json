                        ],
                        "form": "die Friktionen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a01aa08-b5ec-33c1-bbdd-23ab83208cbd",
                        "entry_id": "91b75264-9dc5-301e-bb01-03f08d87c00a",
                        "glosses": [
                            "Reibung"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "6f416290-986d-4e0e-8a07-519af850231d",
                                "sense_id": "8a01aa08-b5ec-33c1-bbdd-23ab83208cbd",
                                "text": "Die Friktionen zwischen den rauen Oberflächen führt zu einer Wärmeentwicklung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "633f1a40-bcba-3428-bdad-4766461fb410",
                        "entry_id": "91b75264-9dc5-301e-bb01-03f08d87c00a",
                        "glosses": [
                            "das Auftreten von Koordinations- oder Transaktionshemmnissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe3b2043-db35-482b-ad43-b48a3eb23cbd",
                                "sense_id": "633f1a40-bcba-3428-bdad-4766461fb410",
                                "text": "Friktionen und Verzögerungen entstehen oft, weil hektische Änderungen umgesetzt werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3605473e-94ca-323e-9bd6-090b3fcb5c35",
                        "entry_id": "91b75264-9dc5-301e-bb01-03f08d87c00a",
                        "glosses": [
                            "eine Methode in der Massage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91bdb7f8-00e0-4486-a2d5-94e0650ea210",
                                "sense_id": "3605473e-94ca-323e-9bd6-090b3fcb5c35",
                                "text": "Bei der Friktion der Fußsohle beschreibt der Daumen kleine zum Fußaußenrand hingerichtete Kreise."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "cfa4ebde-cfb2-341a-846c-ab375612b8ed",
                        "entry_id": "91b75264-9dc5-301e-bb01-03f08d87c00a",
                        "glosses": [
                            "Auftreten von Unstimmigkeiten oder Schwierigkeiten, die zu Konflikten führen können"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "1dc162bc-a0a9-4230-836f-d9d67cd7228c",
                                "sense_id": "cfa4ebde-cfb2-341a-846c-ab375612b8ed",
                                "text": "„In einem System, in dem alle Akteure, ganz gleich, wie groß sie sind, von einer Unzahl anderer Akteure abhängen, können sich solche Friktionen am Rand rasch zu einem universellen Katastrophenszenario aufschaukeln.“"
                            },
                            {
                                "example_id": "c5befb21-1fb1-4748-8234-559648c146a6",
                                "sense_id": "cfa4ebde-cfb2-341a-846c-ab375612b8ed",
                                "text": "Es geht nicht ohne Friktionen zwischen den verschiedenen Abteilungen ab."
                            },
                            {
                                "example_id": "c0e0d2c0-4704-4d0f-a50b-fe27793aa9e6",
                                "sense_id": "cfa4ebde-cfb2-341a-846c-ab375612b8ed",
                                "text": "„Im „Cyrus“ ist er trotz der Friktionen, die der Hexameter nun einmal mit sich bringt, diesem Ideal erstaunlich nahe gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7915cd28-54e7-470f-ac88-72ee6393fab9",
                        "source_entry_id": "91b75264-9dc5-301e-bb01-03f08d87c00a",
                        "source_sense_id": "8a01aa08-b5ec-33c1-bbdd-23ab83208cbd",
                        "source_sense_description": "Technik, Physik: Reibung",
                        "target_lang_word": "friction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "friction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f4c7229-1fd5-31a1-a39b-bc48c0aaa115",
                                        "entry_id": "2b187067-c9c8-3049-b2d7-a1db148b972c",
                                        "glosses": [
                                            "The rubbing of one object or surface against another."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14eacb19-8d6b-40de-b196-d770b90f29a0",
                                                "sense_id": "8f4c7229-1fd5-31a1-a39b-bc48c0aaa115",
                                                "text": "Energy has seldom been found where we need it when we want it. Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73871f3d-8a24-3199-b231-1e902a27a279",
                                        "entry_id": "2b187067-c9c8-3049-b2d7-a1db148b972c",
                                        "glosses": [
                                            "A force that resists the relative motion or tendency to such motion of two bodies in contact."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28f6a118-2c7a-46a7-bab1-8189b997f218",
                                                "sense_id": "73871f3d-8a24-3199-b231-1e902a27a279",
                                                "text": "Secondly, When a body is once in motion it will continue to move forever, unless something stops it. When a ball is struck on the surface of the earth, the friction of the earth and the resistance of the air soon stop its motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71dbc22e-652e-3739-ad93-1fd3424e24ba",
                                        "entry_id": "2b187067-c9c8-3049-b2d7-a1db148b972c",
                                        "glosses": [
                                            "Massage of the body to restore circulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f43a74a6-3e9b-4815-914b-d3757cd273d1",
                                                "sense_id": "71dbc22e-652e-3739-ad93-1fd3424e24ba",
                                                "text": "The frictions should at first be very gentle, and performed with a view to restore heat, and not to force the blood towards the heart, which in drowned persons is already too much distended with it."
                                            },
                                            {
                                                "example_id": "ee3b7256-a9b3-4301-b1bc-c92db1da2742",
                                                "sense_id": "71dbc22e-652e-3739-ad93-1fd3424e24ba",
                                                "text": "The frictions are made at bedtime, on a limited portion of the body, and on one side only—the calf of the leg by preference, or the thigh, groin, or axilla. It is enough to continue rubbing for from three to five minutes at most."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe6f639-6405-3be8-9a5d-5996145793fb",
                                        "entry_id": "2b187067-c9c8-3049-b2d7-a1db148b972c",
                                        "glosses": [
                                            "Conflict, as between persons having dissimilar ideas or interests; clash."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05199340-e129-43e5-b62d-32716754dc53",
                                                "sense_id": "dfe6f639-6405-3be8-9a5d-5996145793fb",
                                                "text": "Once finances are stabilised, getting Crossrail finished is Byford's most obvious task. Late and over budget, it is causing unwanted headlines and friction between the London Mayor and the Department for Transport that both sides would rather live without."
                                            },
                                            {
                                                "example_id": "27c25ddc-6fe9-43e1-9d2f-aa895f857cf5",
                                                "sense_id": "dfe6f639-6405-3be8-9a5d-5996145793fb",
                                                "text": "Thais have been watching for signs of friction between the armed forces and the monarchy—the country's two biggest sources of political power—since the death in October of Bhumibol Adulyadej, King Vajiralongkorn's long-reigning father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4315e42a-87d1-3b02-8f6e-26f872be8b7f",
                                        "entry_id": "2b187067-c9c8-3049-b2d7-a1db148b972c",
