        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b66542b-dd31-315f-a08f-d71564de64ae",
                    "sense_definition": "To falsely produce or forge a copy of something with the intent to deceive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_imitate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal syndicate attempted to <w>counterfeit</w> foreign currency using modern printers.",
                            "target_lang_translations": {
                                "ru": "Преступный синдикат попытался <w>подделать</w> иностранную валюту с помощью современных принтеров.",
                                "nl": "Het criminele syndicaat probeerde met moderne printers buitenlandse valuta te <w>vervalsen</w>."
                            }
                        },
                        {
                            "text": "It is a serious crime to <w>counterfeit</w> government documents or signatures.",
                            "target_lang_translations": {
                                "ru": "<w>Подделывать</w> государственные документы или подписи — тяжкое преступление.",
                                "nl": "Het is een ernstig misdrijf om officiële documenten of handtekeningen te <w>vervalsen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "forge",
                        "fake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изготовлять фальшивую копию чего-либо с целью обмана.",
                        "nl": "Iets namaken of nabootsen met de bedoeling om te misleiden of te bedriegen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подделывать",
                                "target_lang_sense_clarification": "фальсифицировать вещи, деньги, подписи (несов. вид)"
                            },
                            {
                                "target_lang_word": "подделать",
                                "target_lang_sense_clarification": "сделать фальшивую копию (сов. вид)"
                            },
                            {
                                "target_lang_word": "фальсифицировать",
                                "target_lang_sense_clarification": "изготавливать подделки"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vervalsen",
                                "target_lang_sense_clarification": "namaken van geld, papieren of kunst"
                            },
                            {
                                "target_lang_word": "namaken",
                                "target_lang_sense_clarification": "kopiëren om voor echt te laten doorgaan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "061491ed-b510-302c-9e42-1c81a6983bf8",
                    "sense_definition": "To simulate, feign, or mimic an emotion, action, or voice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_imitate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>counterfeit</w> sleep until the intruders left the bedroom.",
                            "target_lang_translations": {
                                "ru": "Ему удавалось <w>притворяться</w> спящим, пока незваные гости не покинули спальню.",
                                "nl": "Hij slaagde erin om te <w>doen alsof</w> hij sliep totdat de indringers de slaapkamer verlieten."
                            }
                        },
                        {
                            "text": "She tried to <w>counterfeit</w> amusement at his crude jokes, but her smile was strained.",
                            "target_lang_translations": {
                                "ru": "Она попыталась <w>сымитировать</w> веселье в ответ на его грубые шутки, но её улыбка была натянутой.",
                                "nl": "Ze probeerde vermaak te <w>veinzen</w> om zijn grove grappen, maar haar glimlach was geforceerd."
                            }
