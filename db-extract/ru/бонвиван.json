                    },
                    {
                        "translation_id": "1387e738-91d3-47bc-b7b5-b15f606bf610",
                        "source_entry_id": "2ed1f00b-cba6-3407-a774-01c51fb673e3",
                        "source_sense_id": "f694b756-3f73-36d0-9927-7f171eab4d7c",
                        "target_lang_word": "Bonvivant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bonvivant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29419c31-a310-3a0c-97a2-8c535b4cf772",
                                        "entry_id": "5e580d42-97e0-3fb2-a761-bda19fa7a2c0",
                                        "glosses": [
                                            "männliche Person, die es sich in übertriebener Weise gut gehen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a09faf4-1a0d-4c40-b3f5-28411c8942fb",
                                                "sense_id": "29419c31-a310-3a0c-97a2-8c535b4cf772",
                                                "text": "„Der Bonvivant folgte ihr.“"
                                            },
                                            {
                                                "example_id": "dbbe0b95-20b9-4ed7-9703-e1a6b5298305",
                                                "sense_id": "29419c31-a310-3a0c-97a2-8c535b4cf772",
                                                "text": "„Er war ein eleganter Bonvivant geworden und schien eine echte Begabung für die Leitung eines Hotels zu haben.“"
                                            },
                                            {
                                                "example_id": "18143b64-5f8d-49b1-a9fa-88cb0e81955f",
                                                "sense_id": "29419c31-a310-3a0c-97a2-8c535b4cf772",
                                                "text": "„Auch der Verfasser der Blutliste war dabei, ein besonders rachedurstiger, stellungsloser Bonvivant, der Koller hieß.“"
                                            },
                                            {
                                                "example_id": "d4641342-1364-4649-ae9a-cebe38ad2caf",
                                                "sense_id": "29419c31-a310-3a0c-97a2-8c535b4cf772",
                                                "text": "„Athelney Jones erwies sich als eine umgängliche Seele in einer Stunde der Erholung und Entspannung und befaßte sich mit seinem Dinner wie ein Bonvivant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e7f0010-dd6e-4dc4-ab47-61984cdeca9f",
                        "source_entry_id": "2ed1f00b-cba6-3407-a774-01c51fb673e3",
                        "source_sense_id": "f694b756-3f73-36d0-9927-7f171eab4d7c",
                        "target_lang_word": "Lebemann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lebemann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                                        "entry_id": "02a91e48-e94f-30a3-9356-e051396cf6b2",
                                        "glosses": [
                                            "Mann, der möglichst viele Genüsse jeglicher Art für sich in Anspruch nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6210874-e2b1-42b6-857e-da3c24209716",
                                                "sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                                                "text": "„Er war ein Lebemann und kannte sich aus.“"
                                            },
                                            {
                                                "example_id": "1cae14e4-62cc-4272-9e5d-3529442171d8",
                                                "sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                                                "text": "„Pückler bewundert ihn sehr dafür, aber auch, daß Barras es geschafft hat, als Lebemann und homme à femme die schwierigsten Zeitläufte zu überstehen.“"
                                            },
                                            {
                                                "example_id": "cf55bfc0-9175-4596-bde2-d4cec084d54b",
                                                "sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                                                "text": "„Im Park von Sanssouci machte der große Friedrich dem großen Lebemann seine Aufwartung und weckte in ihm die Hoffnung auf eine Anstellung bei Hofe.“"
                                            },
                                            {
                                                "example_id": "ee157aac-c5d5-4fce-82e7-86af1e45f6f3",
                                                "sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                                                "text": "„Der Dichter setzte sich als flamboyanter Lebemann in Szene.“"
                                            },
                                            {
                                                "example_id": "d9fc8972-b33e-44f7-ae73-6334f3e063b2",
                                                "sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                                                "text": "„Trotz des Eintretens für einen Staat der Muslime auf dem Indischen Subkontinent war Jinnah selbst ein überzeugter Säkularist, privat war er nicht besonders religiös und galt eher als Lebemann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d01d186-e0b1-4c39-8587-e0c4a595ac23",
                        "source_entry_id": "2ed1f00b-cba6-3407-a774-01c51fb673e3",
                        "source_sense_id": "f694b756-3f73-36d0-9927-7f171eab4d7c",
                        "target_lang_word": "Genießer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genießer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bf4a894-f0f3-3123-ab4b-e58ca43f2b60",
                                        "entry_id": "d377a729-e110-38b0-91be-d61dd191faa4",
                                        "glosses": [
                                            "Person, die zu genießen weiß; jemand, der es liebt, bestimmte Dinge zu genießen (wie etwa gutes Essen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45f9ebc7-02ab-41f5-a7f9-3880456cada6",
                                                "sense_id": "2bf4a894-f0f3-3123-ab4b-e58ca43f2b60",
                                                "text": "„Egal ob Oster- oder Adventsbackwerk, ob Obst-, Geburtstagskuchen oder Mehlspeisen – jeder Genießer wird etwas Gutes finden.“"
                                            },
                                            {
                                                "example_id": "be972a79-8e95-4622-8a22-5bff130356a4",
                                                "sense_id": "2bf4a894-f0f3-3123-ab4b-e58ca43f2b60",
                                                "text": "„Ein Genießer kann nicht verzichten – zumindest, wenn das, was geboten wird, erlesen, lecker und besonders ist.“"
                                            },
                                            {
                                                "example_id": "f0f5dc4d-88bf-4145-bcf7-8c58e58a95db",
                                                "sense_id": "2bf4a894-f0f3-3123-ab4b-e58ca43f2b60",
                                                "text": "„Der überwiegende Teil der Schoko-Hasen, rund 107 Millionen Stück, verbleiben in Deutschland und erfreuen kleine und große Genießer zum Osterfest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea019bce-3362-4141-bda1-b92d31c59973",
                        "source_entry_id": "2ed1f00b-cba6-3407-a774-01c51fb673e3",
                        "source_sense_id": "f694b756-3f73-36d0-9927-7f171eab4d7c",
