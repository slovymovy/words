                                                "sense_id": "b17a54d4-e266-327a-a90f-a3b2d7eaf49b",
                                                "text": "Sein Vater stammt aus Andorra."
                                            },
                                            {
                                                "example_id": "e037470c-a567-4294-afab-b7a72aed2894",
                                                "sense_id": "b17a54d4-e266-327a-a90f-a3b2d7eaf49b",
                                                "text": "Andorra la Vella ist die Hauptstadt von Andorra."
                                            },
                                            {
                                                "example_id": "2bc9cf46-844e-474d-b700-e3b9bd7c10a4",
                                                "sense_id": "b17a54d4-e266-327a-a90f-a3b2d7eaf49b",
                                                "text": "„Dieser Besuch führt Sie zurück in das Andorra des 19. und 20. Jahrhunderts.“"
