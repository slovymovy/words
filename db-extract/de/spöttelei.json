                "senses": [
                    {
                        "sense_id": "597d9d56-67d4-317b-afa8-3108eac171f2",
                        "entry_id": "7de1e981-242a-3fc7-b2d1-55eae18ebd00",
                        "glosses": [
                            "harmloses, wenig aggressives Spotten über jemanden oder etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc4ab2b1-a2c3-497d-a3f6-4b2085315f7f",
                                "sense_id": "597d9d56-67d4-317b-afa8-3108eac171f2",
                                "text": "„Meistens handelt es sich um Spötteleien zwischen Nachbarn;…“"
                            },
                            {
                                "example_id": "8415e578-a27f-47ec-9668-dba11b492802",
                                "sense_id": "597d9d56-67d4-317b-afa8-3108eac171f2",
                                "text": "„Aber ein wenig Stolz ist damals doch mitgeschwungen in Jakobs Spöttelei…“"
                            },
                            {
                                "example_id": "26c9c632-007f-44d3-8a75-827bc10863af",
                                "sense_id": "597d9d56-67d4-317b-afa8-3108eac171f2",
                                "text": "„Sie erfanden jede Mange Scherze und Wortspiele über Hündchen und andere Tiere sowie einige herrliche gotteslästerliche Spötteleien über ihren falschen Jesus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
