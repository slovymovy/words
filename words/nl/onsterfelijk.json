{
    "word_family": [
        "onsterfelijkheid",
        "sterfelijk",
        "sterven",
        "sterfte"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6e444252-1d17-3e6a-b8a3-60374f34ece4",
                    "sense_definition": "niet de eigenschap hebbend te zullen sterven; eeuwig levend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eeuwig leven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In veel oude verhalen worden de goden als <w>onsterfelijk</w> beschreven.",
                            "target_lang_translations": {
                                "en": "In many ancient stories, the gods are described as <w>immortal</w>."
                            }
                        },
                        {
                            "text": "De legende vertelt over een <w>onsterfelijke</w> ziel die nooit zal vergaan.",
                            "target_lang_translations": {
                                "en": "The legend tells of an <w>immortal</w> soul that will never perish."
                            }
                        }
                    ],
                    "synonyms": [
                        "eeuwig",
                        "onvergankelijk"
                    ],
                    "antonyms": [
                        "sterfelijk"
                    ],
                    "common_phrases": [
                        "onsterfelijke ziel",
                        "onsterfelijke goden"
                    ],
                    "target_lang_definitions": {
                        "en": "not having the property of dying; living forever"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "immortal",
                                "target_lang_sense_clarification": "living forever; never dying"
                            },
                            {
                                "target_lang_word": "undying",
                                "target_lang_sense_clarification": "everlasting or eternal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "678ec6fd-f80e-358c-812f-cbc80170de2d",
                    "sense_definition": "onvergetelijk of blijvend van aard; spectaculair",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onvergetelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De componist maakte zichzelf <w>onsterfelijk</w> met zijn negende symfonie.",
                            "target_lang_translations": {
                                "en": "The composer made himself <w>immortal</w> with his ninth symphony."
                            }
                        },
                        {
                            "text": "Zijn <w>onsterfelijke</w> woorden worden nog steeds door iedereen geciteerd.",
                            "target_lang_translations": {
                                "en": "His <w>immortal</w> words are still quoted by everyone."
                            }
                        }
                    ],
                    "synonyms": [
                        "onvergetelijk",
                        "legendarisch"
                    ],
                    "common_phrases": [
                        "zichzelf onsterfelijk maken",
                        "onsterfelijke woorden"
                    ],
                    "target_lang_definitions": {
                        "en": "unforgettable or lasting in nature; spectacular"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "immortal",
                                "target_lang_sense_clarification": "never to be forgotten; legendary"
                            },
                            {
                                "target_lang_word": "unforgettable",
                                "target_lang_sense_clarification": "impossible to forget"
                            },
                            {
                                "target_lang_word": "timeless",
                                "target_lang_sense_clarification": "not affected by the passage of time"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}