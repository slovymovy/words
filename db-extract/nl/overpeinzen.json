        "nl-extract.jsonl": [
            {
                "entry_id": "faaf1ba6-cc7f-3067-9f0c-d58e7ed7b618",
                "word": "overpeinzen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "21654a5d-69d8-3a35-b8e7-50dbbf3f96a6",
                        "entry_id": "faaf1ba6-cc7f-3067-9f0c-d58e7ed7b618",
                        "glosses": [
                            "ergens langere tijd ernstig over nadenken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4339e088-46d6-41ad-811f-8f805a1b0dce",
                                "sense_id": "21654a5d-69d8-3a35-b8e7-50dbbf3f96a6",
                                "text": "De speler zelf postte gisteren een veelzeggende foto op Instagram: liggend op een veld in Verenigde Staten, waar Barça op tournee is, zijn toekomst overpeinzend, inclusief een twijfelende emoticon. De Franse krant Le Parisien meldde vandaag dat Neymar op dat trainingskamp al enkele ploeggenoten zou hebben ingelicht over zijn nakende vertrek."
                            },
                            {
                                "example_id": "b8f6f03e-4052-4200-8a74-571c9dc193d3",
                                "sense_id": "21654a5d-69d8-3a35-b8e7-50dbbf3f96a6",
                                "text": "Ik telde mijn zegeningen, overpeinsde de alledaagse moeilijkheden van mijn werk en de onrust in de wereld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de2933f9-7644-4ef9-8c62-b13db0083a18",
                        "source_entry_id": "faaf1ba6-cc7f-3067-9f0c-d58e7ed7b618",
                        "source_sense_id": "21654a5d-69d8-3a35-b8e7-50dbbf3f96a6",
                        "source_sense_description": "ergens langere tijd ernstig over nadenken",
                        "target_lang_word": "contemplate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contemplate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f997927-2d61-3835-922d-af27756e19cb",
                                        "entry_id": "b68c6b26-d95e-382f-b33a-97bcc8bef5ac",
                                        "glosses": [
                                            "To look at on all sides or in all its aspects; to view or consider with continued attention; to regard with deliberate care; to meditate on; to study, ponder, or consider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b303ed5-937d-44cc-8635-2fa258e8e01a",
                                                "sense_id": "6f997927-2d61-3835-922d-af27756e19cb",
                                                "text": "To love, at least contemplate and admire, / What I see excellent."
                                            },
                                            {
                                                "example_id": "792c1bac-c62e-4a2c-a8c4-c0cf845d1939",
                                                "sense_id": "6f997927-2d61-3835-922d-af27756e19cb",
                                                "text": "We thus dilate / Our spirits to the size of that they contemplate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a36cb22e-3252-330e-9bb7-9adce247faab",
                                        "entry_id": "b68c6b26-d95e-382f-b33a-97bcc8bef5ac",
                                        "glosses": [
                                            "To consider as a possibility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "096d3416-853c-4b98-8138-b00a18144ac1",
                                                "sense_id": "a36cb22e-3252-330e-9bb7-9adce247faab",
                                                "text": "I contemplated doing the project myself, but it would have taken too long."
                                            },
                                            {
                                                "example_id": "8bd4ba2b-379c-41f9-82a7-9406e09aaa51",
                                                "sense_id": "a36cb22e-3252-330e-9bb7-9adce247faab",
                                                "text": "There remain some particulars to complete the information contemplated by those resolutions."
                                            },
                                            {
                                                "example_id": "f5c36cb6-cde0-409c-a7ea-22ccf18e47c9",
                                                "sense_id": "a36cb22e-3252-330e-9bb7-9adce247faab",
                                                "text": "If a treaty contains any stipulations which contemplate a state of future war."
                                            },
                                            {
                                                "example_id": "95fd6fcb-4011-48d9-b945-3a9ddc15c732",
                                                "sense_id": "a36cb22e-3252-330e-9bb7-9adce247faab",
                                                "text": "In Calcutta, season tickets are issued only for the calendar month, with a different colour for each month, so that this problem does not arise. The merest whisper of an idea to change Bombay to the Calcutta system brought such a howl of protest in the Press, that it was never seriously contemplated."
                                            },
                                            {
                                                "example_id": "1fbefeba-61ae-4d6f-b6ed-d2288c1e5025",
                                                "sense_id": "a36cb22e-3252-330e-9bb7-9adce247faab",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
