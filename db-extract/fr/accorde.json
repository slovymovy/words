                        "entry_id": "a4c6acb1-aecf-3b40-8b35-457e79dbb625",
                        "glosses": [
                            "Première personne du singulier de l’indicatif présent du verbe accorder."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "ac8417c5-0eee-4da9-806c-76d8b3b25d3a",
                                "sense_id": "77280831-ebfc-3459-bda2-b5274f36388a",
                                "text": "Mais je ne vous accorde que dix minutes, après je dois troncher mon petit saule."
                            }
                        ]
                    },
                    {
                        "sense_id": "e69e5403-856d-3d06-8ed1-de2b104664d3",
                        "entry_id": "a4c6acb1-aecf-3b40-8b35-457e79dbb625",
                        "glosses": [
                            "Troisième personne du singulier de l’indicatif présent du verbe accorder."
