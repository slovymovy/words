                                "target_senses": [
                                    {
                                        "sense_id": "d998ce08-7c5c-3f7b-8779-897c4fabe9ed",
                                        "entry_id": "379c14ac-62e5-38cb-b364-8dbfe72450ac",
                                        "glosses": [
                                            "Something which ails one; a disease; sickness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d6a417d-635c-40d9-aed9-650db550a449",
                                                "sense_id": "d998ce08-7c5c-3f7b-8779-897c4fabe9ed",
                                                "text": "He had always been remarkably immune from such little ailments, and had only once in his life been ill, of a vicious pneumonia long ago at school. He hadn't the faintest idea what to with a cold in the head, he just took quinine and continued to blow his nose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4d2697e-42b7-4496-ab79-0133aa364dd7",
                        "source_entry_id": "74b0ea55-f107-3c26-8695-4dcc09c396b7",
                        "source_sense_id": "16ea1df5-46f6-3be0-9a3d-5dff12018a48",
                        "target_lang_word": "disease",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disease",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7c7c695-5e2d-335f-b345-d3073fda4c46",
                                        "entry_id": "35e18628-d3ac-3a20-87e5-8a3f3e7c98b7",
                                        "glosses": [
                                            "An abnormal condition of a human, animal or plant that causes discomfort or dysfunction; distinct from injury insofar as the latter is usually instantaneously acquired."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65e527e5-feca-4bf3-887e-f42daff3833a",
                                                "sense_id": "f7c7c695-5e2d-335f-b345-d3073fda4c46",
                                                "text": "The tomato plants had some kind of disease that left their leaves splotchy and fruit withered."
                                            },
                                            {
                                                "example_id": "06978ee3-50e1-4607-973d-abc486fd6b48",
                                                "sense_id": "f7c7c695-5e2d-335f-b345-d3073fda4c46",
                                                "text": "[…] diſeaſes deſperate growne,\n By deſperate appliance are releeued,\n Or not at all."
                                            },
                                            {
                                                "example_id": "ff849cfc-b28e-4cc8-8096-941f71e527d2",
                                                "sense_id": "f7c7c695-5e2d-335f-b345-d3073fda4c46",
                                                "text": "The instability, injustice, and confusion, introduced into the public councils, have, in truth, been the mortal diseases under which popular governments have every where perished; […]"
                                            },
                                            {
                                                "example_id": "c8e5a240-18a1-496f-a243-de0f16566357",
                                                "sense_id": "f7c7c695-5e2d-335f-b345-d3073fda4c46",
                                                "text": "Of all the queer collections of humans outside of a crazy asylum, it seemed to me this sanitarium was the cup winner. […] When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose."
                                            },
                                            {
                                                "example_id": "4943e791-f785-4d0e-a21c-e19e198b1b1e",
                                                "sense_id": "f7c7c695-5e2d-335f-b345-d3073fda4c46",
                                                "text": "[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes […] And then, when you see [the senders], you probably find that they are the most melancholy old folk with malignant diseases."
                                            },
                                            {
                                                "example_id": "6c62834e-ac46-4331-af8d-82cb5fc927c9",
                                                "sense_id": "f7c7c695-5e2d-335f-b345-d3073fda4c46",
                                                "text": "Conditions were horrendous aboard most British naval vessels at the time. Scurvy and other diseases ran rampant, killing more seamen each year than all other causes combined, including combat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9bc328d-c8bb-3435-98d8-72ba55264bd9",
                                        "entry_id": "35e18628-d3ac-3a20-87e5-8a3f3e7c98b7",
                                        "glosses": [
                                            "Any abnormal or harmful condition, as of society, people's attitudes, way of living etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d84af51e-0af2-447a-8e80-56678a50337f",
                                                "sense_id": "b9bc328d-c8bb-3435-98d8-72ba55264bd9",
                                                "text": "War is not man's great and terrible disease; war is a symptom, a result. The real disease is the virus of national sovereignty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00976ac3-e880-3a3d-bc5c-697b3691f81a",
                                        "entry_id": "35e18628-d3ac-3a20-87e5-8a3f3e7c98b7",
                                        "glosses": [
                                            "A lack of ease; uneasiness; trouble; vexation; disquiet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "298910fb-1d40-42a6-9f6d-f328025c29ff",
                                                "sense_id": "00976ac3-e880-3a3d-bc5c-697b3691f81a",
                                                "text": "To ſhield thee from diſeaſes of the world, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disease",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c88de7b-4225-397a-8032-4923b8ccd57a",
                                        "entry_id": "a4d4992e-a6eb-3a6e-b459-876592e54d5d",
                                        "glosses": [
                                            "To cause unease; to annoy, irritate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3fb4ae7-5f3c-427a-891b-daafb76a4a7a",
                                                "sense_id": "8c88de7b-4225-397a-8032-4923b8ccd57a",
                                                "text": "Whyll he yett ſpeake\n there cam won from the rulers off the ſynagogis houſſe\n which ſayde to hym: Thy doughter is deed\n diſeaſe not the maſter."
                                            },
                                            {
                                                "example_id": "45417c54-088f-4f58-875a-f93073f8884f",
                                                "sense_id": "8c88de7b-4225-397a-8032-4923b8ccd57a",
                                                "text": "[…]mote he ſoft himſelfe appeaſe,\n And fairely fare on foot, how euer loth;\n His double burden did him ſore diſeaſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57fe137c-1782-327d-810a-bb0e9b980c6c",
                                        "entry_id": "a4d4992e-a6eb-3a6e-b459-876592e54d5d",
                                        "glosses": [
                                            "To infect with a disease."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e1208d4-54d8-4075-b8f3-bcfbcdb92e38",
                        "source_entry_id": "74b0ea55-f107-3c26-8695-4dcc09c396b7",
                        "source_sense_id": "16ea1df5-46f6-3be0-9a3d-5dff12018a48",
                        "target_lang_word": "illness",
