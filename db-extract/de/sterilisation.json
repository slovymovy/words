                        "form": "die Sterilisation"
                    },
                    {
                        "form_id": "1f6e0905-8e11-4ce6-9e36-3d80839ddf58",
                        "entry_id": "acdd1977-7d0c-3288-90ff-10811b441c65",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sterilisationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f81bf95c-aa5e-31e9-9d47-db1050470f9d",
                        "entry_id": "acdd1977-7d0c-3288-90ff-10811b441c65",
                        "glosses": [
                            "hocheffektive Vernichtung schädlicher Keime durch Technikeinsatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c9ce1f-8769-4ae5-9d82-4108d2985f10",
                                "sense_id": "f81bf95c-aa5e-31e9-9d47-db1050470f9d",
                                "text": "„Wir betrachten uns als „technologisch neutral“ und stellen sicher, dass wir die jeweils beste Technologie für die Sterilisation des Produktes unseres Kunden bereitstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "01687902-e6be-37c6-8f35-0df7bc8b515a",
                        "entry_id": "acdd1977-7d0c-3288-90ff-10811b441c65",
                        "glosses": [
                            "durch Unterbrechung der Ausführungsgänge der Geschlechtsdrüsen oder auch Entfernung der Eierstöcke hergestellte Unfruchtbarkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e97bdfe6-16e9-427d-8074-8a85406a3904",
                                "sense_id": "01687902-e6be-37c6-8f35-0df7bc8b515a",
                                "text": "„Obwohl die Sterilisation des Mannes eine der sichersten Methoden zur Verhinderung einer ungewollten Schwangerschaft ist, entschließen sich nach wie vor nur relativ wenige Männer zu diesem Eingriff.“"
                            },
                            {
                                "example_id": "303c6315-0073-4336-a6bd-807853d8beb3",
                                "sense_id": "01687902-e6be-37c6-8f35-0df7bc8b515a",
                                "text": "„Für Frauen, die ihre Familienplanung abgeschlossen oder keinen Kinderwunsch haben, ist die Sterilisation eine sichere Methode der Empfängnisverhütung.“"
                            },
                            {
                                "example_id": "235fbe7d-c414-4cab-be2b-b0258982ab10",
                                "sense_id": "01687902-e6be-37c6-8f35-0df7bc8b515a",
                                "text": "„Viele deutsche Psychiater waren an den NS-Verbrechen zwar nicht mit Taten beteiligt, wohl aber mit Worten, indem sie Sterilisation und zum Teil auch Euthanasie befürworteten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85d2ef1c-d299-4737-9bdc-e65df7e5f0bd",
                        "source_entry_id": "acdd1977-7d0c-3288-90ff-10811b441c65",
                        "source_sense_id": "f81bf95c-aa5e-31e9-9d47-db1050470f9d",
                        "source_sense_description": "Medizin: hocheffektive Vernichtung schädlicher Keime durch Technikeinsatz",
                        "target_lang_word": "stérilisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stérilisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16a3318b-41dc-3fe1-9873-1aa49974028b",
                                        "entry_id": "3c345ed7-4308-36ff-a34d-7e3da010baf8",
                                        "glosses": [
                                            "Action de stériliser ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ca5944-f0b6-4395-9ef8-1e96167b85b3",
                                                "sense_id": "16a3318b-41dc-3fe1-9873-1aa49974028b",
                                                "text": "Dans la laiterie, les technologies utilisables pour la conservation du lait sont … la stérilisation qui consiste à chauffer le lait à 110-120°C pendant 15-30 minutes ou à 135-140°C pendant 2-4 secondes (lait UHT). — (Cirad/Gret/MAE, Mémento de l'Agronome, 1 692 pages, page 1307, 2002, Paris, France, Cirad/Gret/Ministère des Affaires Étrangères)"
                                            },
                                            {
                                                "example_id": "70eb5d95-5b6f-47f3-a113-db0f455bd16e",
                                                "sense_id": "16a3318b-41dc-3fe1-9873-1aa49974028b",
                                                "text": "Il n’y a pas de stérilisation possible des instruments; le verre d’eau du robinet où trempent les abaisse-langues; la gamelle d’aluminium contenant l’huile à lubrifier les spéculums, huile qui est renouvelée tous les trois jours,…"
                                            },
                                            {
                                                "example_id": "27ea8ea8-9caa-4e85-8a58-47abd0f568ed",
                                                "sense_id": "16a3318b-41dc-3fe1-9873-1aa49974028b",
                                                "text": "L'autonomie ? Le repliement de l’Alsace sur elle-même ? On aboutirait à la stérilisation et à la mort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf7c9428-63f1-496a-a590-8f904dd76a43",
