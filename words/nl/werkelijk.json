                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "realiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>werkelijke</w> reden van zijn vertrek is nog steeds niet bekend.",
