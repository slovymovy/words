                                        "entry_id": "b0b0890d-4b79-3be0-ba5c-06fbf91fbb80",
                                        "glosses": [
                                            "One of the casks stowed in the wings of a vessel's hold, being smaller than such as are stowed more amidships."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23e561d0-c22b-4c5f-ba38-292755d69210",
                                                "sense_id": "7971f099-0fdb-3bcc-8130-9661192ccaac",
                                                "text": "We hauled out a winger of grog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cff58e8-4e9b-38f5-b6e1-1c5a804fb2c9",
                                        "entry_id": "b0b0890d-4b79-3be0-ba5c-06fbf91fbb80",
                                        "glosses": [
                                            "An offensive player who plays on either side of the center."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b818d312-2b51-4eb9-8ade-9a4dba585d1b",
                                                "sense_id": "6cff58e8-4e9b-38f5-b6e1-1c5a804fb2c9",
                                                "text": "The center passed to the left winger, who shot and scored."
                                            },
                                            {
                                                "example_id": "471fbed2-b1bf-4caa-be51-606bf12b25a3",
                                                "sense_id": "6cff58e8-4e9b-38f5-b6e1-1c5a804fb2c9",
                                                "text": "\"The pattern of the game could have been different if Anthony Pilkington had taken one of two chances either side of United's opener.\nBut the Norwich winger shot wide when clean through and saw another effort hit the post on 75 minutes."
                                            }
                                        ]
                                    }
