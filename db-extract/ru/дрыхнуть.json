                "senses": [
                    {
                        "sense_id": "1691de8c-bd2d-31c0-af9f-086290318598",
                        "entry_id": "5a86f8a6-fea9-3d66-9d61-2f1497bf8888",
                        "glosses": [
                            "to sleep"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "f244dfb8-570a-4e35-a5bb-7c9f0a1fc0ca",
                                "sense_id": "1691de8c-bd2d-31c0-af9f-086290318598",
                                "text": "Дры́хнешь как суро́к, — засмея́лась тётка, — вторы́е су́тки пошли́!",
                                "translation": "You're sleeping like a log (literally, a marmot), the auntie laughed - it's the second day now!",
                                "english": "You're sleeping like a log (literally, a marmot), the auntie laughed - it's the second day now!"
                            }
                        ]
                    }
                ],
