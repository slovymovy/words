                "senses": [
                    {
                        "sense_id": "39e645de-d2c2-33ac-a87c-037722824aae",
                        "entry_id": "2a50e937-8d76-39c5-b175-4842daf8b9fe",
                        "glosses": [
                            "Verkehrsverbindung, die von einer Eisenbahn bedient wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ccf2e9-b9e0-4c9f-8841-321cc90baa3b",
                                "sense_id": "39e645de-d2c2-33ac-a87c-037722824aae",
                                "text": "„Reisen vor dem Bau der Eisenbahnlinien ist teuer, mühsam und nicht ungefährlich.“"
                            },
                            {
                                "example_id": "8a175d65-da75-40fe-9aca-8bc98601b5aa",
                                "sense_id": "39e645de-d2c2-33ac-a87c-037722824aae",
                                "text": "„Draußen auf dem Land, zwei Kilometer von der nächsten Eisenbahnlinie entfernt, im dunklen Reich der russischen Anarchie, zahlt man nach wie vor nichts für Strom.“"
                            },
                            {
                                "example_id": "0d853016-8d9f-43f6-9708-96b2d0ddaf44",
                                "sense_id": "39e645de-d2c2-33ac-a87c-037722824aae",
                                "text": "„Die Amerikaner wollten damit vermeiden, daß die Eisenbahnlinie Göttingen-Eschwege streckenweise durch die russische Bestzungszone führt.“"
                            },
                            {
                                "example_id": "d0299880-3332-433b-8573-f6b1095e3d71",
                                "sense_id": "39e645de-d2c2-33ac-a87c-037722824aae",
                                "text": "„Eine Eisenbahnlinie aus Dschibuti am Roten Meer erreicht Addis Abeba, ausländische Mächte errichten dort Residenzen, ebenso einheimische Fürsten.“"
                            },
                            {
                                "example_id": "d94df034-0eb2-44a8-9db2-4f52cf3343bf",
                                "sense_id": "39e645de-d2c2-33ac-a87c-037722824aae",
                                "text": "„Schon sein Urgroßvater war am Bau der ersten Eisenbahnlinie beteiligt gewesen und hatte außerdem in der Mine gearbeitet.“"
                            },
                            {
                                "example_id": "78ebfeee-a4c8-42f9-b14b-a03b84deb972",
                                "sense_id": "39e645de-d2c2-33ac-a87c-037722824aae",
                                "text": "[2. Dezember 1910:] „Die russische Regierung unter Ministerpräsident Pjotr A. Stolypin schlägt China den Bau einer Eisenbahnlinie vom Baikalsee durch die Wüste Gobi nach Peking vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
