                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spin",
                                "target_lang_sense_clarification": "extracting honey using centrifugal force"
                            },
                            {
                                "target_lang_word": "extract",
                                "target_lang_sense_clarification": "removing honey from the comb"
                            }
                        ]
                    }
                }
            ]
        }
