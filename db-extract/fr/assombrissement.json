                        "translation_id": "18a11d26-ddb9-4fbd-9c04-f13ea2e276bf",
                        "source_entry_id": "38f603ea-4e54-3c3b-bbcd-9c53fec5ffe2",
                        "source_sense_description": "programmation informatique",
                        "target_lang_word": "obfuscation",
