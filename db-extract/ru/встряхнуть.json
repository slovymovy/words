                        "glosses": [
                            "безл. о сотрясении, о сильном толчке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22d9a222-7524-4afb-b817-3e155da86486",
                                "sense_id": "2d43f46b-25cd-319b-8436-b14b92044265",
                                "text": "При въезде на мост телегу с седоком сильно встряхнуло."
                            }
                        ]
