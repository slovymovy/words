                                        "entry_id": "30e2939f-2906-302f-ab7f-12b682b75c15",
                                        "glosses": [
                                            "senza dubbio"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aab73cf1-5ff6-45cd-a191-023a7aa814b1",
                                                "sense_id": "55444ec3-06d6-3845-849c-f6145a52b700",
                                                "text": "quello morirà sicuramente"
                                            },
                                            {
                                                "example_id": "bdaa7392-ae19-4af9-ad56-5f40c8d95881",
                                                "sense_id": "55444ec3-06d6-3845-849c-f6145a52b700",
                                                "text": "sicuramente ci sono stati incroci tra Homo sapiens e Neandertal, tra Homo sapiens e Denisova e tra Neandertal e Denisova"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0b542f5-5446-437b-a214-104e56ed0ee5",
                        "source_entry_id": "22e25589-5ecc-394a-ade0-4367a947af92",
                        "source_sense_id": "9a7d8bd5-b528-3eba-9ee3-942a5adfad03",
                        "source_sense_description": "Probablement, sans doute",
                        "target_lang_word": "sicherlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
