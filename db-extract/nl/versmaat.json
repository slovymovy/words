                                        "sense_id": "8b248634-b245-304c-a911-eb5ca53e6da1",
                                        "entry_id": "b4518417-2f06-3789-910e-85d145d8c0e0",
                                        "glosses": [
                                            "The basic unit of length in the International System of Units (SI: Système International d'Unités), equal to the distance travelled by light in a vacuum in 1/299 792 458 seconds. The metre is equal to 39+⁴⁷⁄₁₂₇ (approximately 39.37) imperial inches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b14cf3f-3dd1-42bc-b724-a2e55f3d1905",
                                                "sense_id": "8b248634-b245-304c-a911-eb5ca53e6da1",
                                                "text": "Holonyms: kilometre < megametre < gigametre < terametre < petametre"
                                            },
                                            {
                                                "example_id": "6b2d8659-60aa-496b-a006-90f6731aa94d",
                                                "sense_id": "8b248634-b245-304c-a911-eb5ca53e6da1",
                                                "text": "Meronyms: picometre < nanometre < micrometre < millimetre < centimetre < decimetre"
                                            },
                                            {
                                                "example_id": "2b5f27a1-ac2e-4754-aeb9-a3037a312fc2",
                                                "sense_id": "8b248634-b245-304c-a911-eb5ca53e6da1",
                                                "text": "The measures of length above the metre are ten times ... greater than the metre."
                                            },
                                            {
                                                "example_id": "7e7b2abd-50a8-464d-80ed-914e2857becf",
                                                "sense_id": "8b248634-b245-304c-a911-eb5ca53e6da1",
                                                "text": "A dress length of 8 metres of the best quality costs 58 francs."
                                            },
                                            {
                                                "example_id": "8e9667ee-9b26-4dd6-ba8f-9d5d9a7304cc",
                                                "sense_id": "8b248634-b245-304c-a911-eb5ca53e6da1",
                                                "text": "The 12-metre yachts ... can be sailed efficiently with four paid hands."
                                            }
                                        ]
                                    }
