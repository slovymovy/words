                                        "entry_id": "3deffbd3-c497-3389-9ac6-8b4d932a95b1",
                                        "glosses": [
                                            "Eigenschaft, unausweichlich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8156f903-2b69-4640-85dc-4b0a966475f4",
                                                "sense_id": "0771fc93-8bd6-346c-91fc-3be926b5c490",
                                                "text": "„Sie und Sylvia hatten bereits über diese Unausweichlichkeit gesprochen und ausgerechnet, wie viel mehr Sylvia sich leisten konnte.“"
                                            }
