                        ],
                        "form": "den Überhang"
                    },
                    {
                        "form_id": "663419ea-9d3a-4177-814f-9c6460f97b0c",
                        "entry_id": "0fb3fc74-438a-3be5-9581-0cf452f19167",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Überhänge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "193a805a-ec8c-32a4-bd5f-b9b4cbc1bb93",
                        "entry_id": "0fb3fc74-438a-3be5-9581-0cf452f19167",
                        "glosses": [
                            "zahlenmäßige Überschreitung, speziell beim über den prozentualen Anteil des Wahlerfolgs hinausgehende Anzahl der Stimmen; über den Anteil der Zweitstimmen hinausgehende Anzahl der Erststimmen"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "bf183b8d-5e64-4132-b860-9ae6f73e3023",
                                "sense_id": "193a805a-ec8c-32a4-bd5f-b9b4cbc1bb93",
                                "text": "„Er sah einen Zusammenhang zwischen einem Überhang von jungen Männern in einer Gesellschaft, einem ‚youth bulge‘, und der zunehmenden Bereitschaft zu Revolution und Bürgerkrieg.“"
                            },
                            {
                                "example_id": "d7d2f5bf-5d47-4338-8a76-a2439612d549",
                                "sense_id": "193a805a-ec8c-32a4-bd5f-b9b4cbc1bb93",
                                "text": "„Wenn man die 50 Felder noch dazunimmt und jetzt von 138 ausgeht, liegt diese Zahl immer noch unter dem durchschnittlichen Überhang der Jahre 2000 bis 2011 von 148.“"
                            },
                            {
                                "example_id": "4ae89649-1f7b-4331-8de1-4441b7e43787",
                                "sense_id": "193a805a-ec8c-32a4-bd5f-b9b4cbc1bb93",
                                "text": "„Da auch an der zweiten Station eine hohe Bearbeitungszeit vorliegt, wird der Überhang am Ende der zweiten Station noch größer, so daß sich die Bearbeitung an der dritten Station noch weiter verspätet.“"
                            },
                            {
                                "example_id": "47aa451d-e60b-4ca5-8c09-83ceeb5aacd6",
                                "sense_id": "193a805a-ec8c-32a4-bd5f-b9b4cbc1bb93",
                                "text": "„Der Hedgefonds-Manager kann einen Überhang an Long-Positionen oder einen Überhang an Short-Positionen halten.“"
                            },
                            {
                                "example_id": "c29f4e5c-49d3-4f4d-8d39-e04c869786f6",
                                "sense_id": "193a805a-ec8c-32a4-bd5f-b9b4cbc1bb93",
                                "text": "„Wie verhält es sich mit dem Überhang von Stimmen – und tendiert nicht auch das proportionierteste Gesäß dazu, vermittels Masse nach unten zu deuten?“"
                            },
                            {
                                "example_id": "875cfbcd-5a51-4e7d-a437-1961cc4c2c40",
                                "sense_id": "193a805a-ec8c-32a4-bd5f-b9b4cbc1bb93",
                                "text": "„So kam die Operation Überhang nach der Bundestagswahl 2005 auf sehr leisen Sohlen daher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1807158c-0954-334a-b246-5b1f78a507a9",
                        "entry_id": "0fb3fc74-438a-3be5-9581-0cf452f19167",
                        "glosses": [
                            "etwas Hinausragendes, zum Beispiel eine hinausragende Felspartie, ein die Grundstücksgrenze überschreitendes Pflanzenwachstum, ein Fahrzeugteil (gemessen an der Differenz zwischen Achsabstand und Gesamtlänge eines Fahrzeugs), ein hinausragender Bauteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0ef73f9-a1c0-41c7-8632-d69eaf884603",
                                "sense_id": "1807158c-0954-334a-b246-5b1f78a507a9",
                                "text": "„[Der harmonische Stapel] ermöglicht es zum Beispiel, mit 30 Blöcken einen Überhang von knapp zwei Blocklängen aufzuschichten.“"
                            },
                            {
                                "example_id": "3abe5f3d-aae0-4aad-b243-879e212874dc",
                                "sense_id": "1807158c-0954-334a-b246-5b1f78a507a9",
                                "text": "„Muss der Baum aufgrund seiner Länge aus dem Kofferraum herausragen, brauchen ihn die Autofahrer bis zu einem Meter Überhang nicht zu kennzeichnen.“"
                            },
                            {
                                "example_id": "cd6f291b-3f64-4330-ac77-57cf950f28ba",
                                "sense_id": "1807158c-0954-334a-b246-5b1f78a507a9",
                                "text": "„Der Freikletterer bewegt sich in steiler Wand: Er verzichtet auch bei höchsten Schwierigkeitsgraden auf technische Hilfsmittel und setzt sich mit seiner reinen Körperlichkeit, der Kraft und Geschmeidigkeit seiner Muskeln, der Haltefähigkeit seiner Finger und Zehen, dem natürlichen Fels, seinen glatten Wänden, gefurchten Rillen, sperrigen Überhängen aus.“"
                            },
                            {
                                "example_id": "f3cf684e-fb7a-4dbf-9a5d-ce9c2f7bf9b3",
                                "sense_id": "1807158c-0954-334a-b246-5b1f78a507a9",
                                "text": "„[Jürgen Mühling:] Springe ich aber von einer Felswand, die wenig Überhang hat, dann weiß ich: Wenn ich das nicht sauber ausführe, wird mich der Berg treffen.“"
                            },
                            {
                                "example_id": "295f22fe-ec49-4583-a531-8e826edf65f5",
                                "sense_id": "1807158c-0954-334a-b246-5b1f78a507a9",
                                "text": "„Entlang des auffälligen Verschneidungssystems, das etwa in Wandmitte am linken Rand eines großen schwarzen Überhangs vorbeizieht.“"
                            },
                            {
                                "example_id": "b5071a20-5b1e-46bd-9941-68e4a61ca442",
                                "sense_id": "1807158c-0954-334a-b246-5b1f78a507a9",
                                "text": "„Über das in § 422 ABGB normierte Selbsthilferecht hinaus hat der Nachbar nicht die Möglichkeit, ein auf sein Eigentumsrecht gestütztes Begehren zur Beseitigung des Überhanges durch den Eigentümer des Baumes oder Strauches zu stellen.“"
                            },
                            {
                                "example_id": "4d4bdc9a-109e-43fe-92fe-b1e4cffde629",
                                "sense_id": "1807158c-0954-334a-b246-5b1f78a507a9",
                                "text": "„Die zweiachsigen Wagen haben den Achsabstand c = 5,8 m, die Länge über Puffer l_(ÜP) = 10,6 m, den Überhang ü = 2,4 m und die Gesamtmasse m_F = 20 t (G_F = 196,2 kN).“"
                            },
                            {
                                "example_id": "08de29e2-e1e5-4587-92c2-26d826cd6ca3",
                                "sense_id": "1807158c-0954-334a-b246-5b1f78a507a9",
                                "text": "„Der Überhang über dem 1. Obergeschoß wird durch Knaggen gestützt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "324fdb98-a592-314f-95c6-c1ace817e999",
                        "entry_id": "0fb3fc74-438a-3be5-9581-0cf452f19167",
                        "glosses": [
                            "obendrüber hängender Stoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c815ac5f-c08f-4915-a88d-744de5390204",
                                "sense_id": "324fdb98-a592-314f-95c6-c1ace817e999",
                                "text": "„Der Kommandant der Wachen trug einen Überhang mit dem kaiserlichen Wappen.“"
                            },
                            {
                                "example_id": "482ef891-b6ff-4adf-8927-ebd44adc7ea9",
                                "sense_id": "324fdb98-a592-314f-95c6-c1ace817e999",
                                "text": "„Die Schultern dieses Mädchens werden von einem Überhang bedeckt, dessen emporgerichteter Kragen bis in die Höhe des Ohres reicht.“"
                            },
                            {
                                "example_id": "e5b84394-d278-4ca3-8d0a-e76451f0c9dc",
                                "sense_id": "324fdb98-a592-314f-95c6-c1ace817e999",
                                "text": "„Das ist ein Grund, weßhalb man sie nicht selten den farbigen Vorhängen vorziehen mag, alsdann sollten sie aber wenigstens einen farbigen Ueberhang erhalten, der den Uebergang zu der übrigen auf Farbe berechneten Harmonie des Zimmers bildet.“"
                            },
                            {
                                "example_id": "c8102c75-145f-4a0e-a214-a669dcd3ccc8",
                                "sense_id": "324fdb98-a592-314f-95c6-c1ace817e999",
                                "text": "„Von gleicher Musterung sind die Vorhänge und baldachinartigen Überhänge und die Decken der Feldbetten.“"
                            },
                            {
                                "example_id": "13c4a6f3-d637-45f4-9c84-902a9e92bec8",
                                "sense_id": "324fdb98-a592-314f-95c6-c1ace817e999",
                                "text": "„In der Mitte des Raumes war ein riesiges Himmelbett mit schwarzem Überhang, das sehr gemütlich aussah.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "3351a754-7a90-381e-910c-087f57edab09",
                        "entry_id": "0fb3fc74-438a-3be5-9581-0cf452f19167",
                        "glosses": [
                            "Nachwirkung von Medikamenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "072e7ed3-80d9-4c23-ba51-e6eb0e7ec738",
                                "sense_id": "3351a754-7a90-381e-910c-087f57edab09",
                                "text": "„Hypoventilation kann durch einen Überhang von Relaxanzien und Opiaten hervorgerufen werden.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "2663656e-c193-35e5-9c3a-2be4dd6310b7",
                        "entry_id": "0fb3fc74-438a-3be5-9581-0cf452f19167",
                        "glosses": [
                            "Möglichkeit der Doppelbestrafung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c070d13-5df2-448c-a0c0-1eddc2f127a2",
                                "sense_id": "2663656e-c193-35e5-9c3a-2be4dd6310b7",
                                "text": "„Allein mit der im Strafverfahren über den Disziplinarbeschuldigten verhängten Strafe, die im untersten Bereich des Strafrahmens angesiedelt ist, ist der disziplinarrechtliche Überhang im Verhältnis zur Straftat keinesfalls abgegolten, sodass die vom Disziplinarbeschuldigten beantragte Strafe eines Verweises keinesfalls in Frage kommt.“"
                            },
                            {
                                "example_id": "e66e16af-7df3-425c-b443-18eb16f55665",
                                "sense_id": "2663656e-c193-35e5-9c3a-2be4dd6310b7",
                                "text": "„Theoretisch könnte sie einen sogenannten disziplinären Überhang feststellen.“"
                            },
                            {
                                "example_id": "736c4ecd-2b31-4fb7-932e-050b3a5bef5b",
                                "sense_id": "2663656e-c193-35e5-9c3a-2be4dd6310b7",
                                "text": "„Wir müssen feststellen, ob es da einen disziplinären Überhang gibt, ob also den Kollegen etwas vorzuwerfen ist, was über die im Urteil getroffenen Feststellungen hinausgeht.“"
                            },
                            {
                                "example_id": "4dbe692c-2278-46e8-a3db-204be3769cc4",
                                "sense_id": "2663656e-c193-35e5-9c3a-2be4dd6310b7",
                                "text": "„Bei einem sachgleichen Vorwurf ohne disziplinären Überhang sind deshalb nach der Aussetzung lediglich ergänzende Ermittlungen möglich, die in dem anderen gesetzlich geregelten Verfahren nicht zu erwarten sind.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "317597aa-71bc-4c5f-805d-627048f8c976",
                        "source_entry_id": "0fb3fc74-438a-3be5-9581-0cf452f19167",
