        "nl-extract.jsonl": [
            {
                "entry_id": "fab3d00d-3baa-3ad3-999d-d5a45bde9b85",
                "word": "zogeheten",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "62740870-cbf5-3953-bef8-2ed3d3e894fd",
                        "entry_id": "fab3d00d-3baa-3ad3-999d-d5a45bde9b85",
                        "glosses": [
                            "zoals dit genoemd wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c2898b3-937b-465d-81a3-a8d955648149",
                                "sense_id": "62740870-cbf5-3953-bef8-2ed3d3e894fd",
                                "text": "Dit wordt toegeschreven aan de zogeheten islamofobie."
                            },
                            {
                                "example_id": "aa3cd284-e052-45d5-8906-09b6dc736a7a",
                                "sense_id": "62740870-cbf5-3953-bef8-2ed3d3e894fd",
                                "text": "Een cirkelvormige racebaan van 100 kilometer waarbinnen deeltjes zo onder het meer van Genève doorschieten. Dat is het plan dat Cern onthulde in een nieuwe ontwerpstudie voor de zogeheten Future Circular Collider (FCC)."
                            },
                            {
                                "example_id": "efbc8708-aa7e-43b0-9bdf-5c7be6533b40",
                                "sense_id": "62740870-cbf5-3953-bef8-2ed3d3e894fd",
                                "text": "De zogeheten 'paddenstoelenmoordzaak' heeft Australië én mensen ver daarbuiten de afgelopen maanden in een greep gehouden."
                            },
                            {
                                "example_id": "ba495be9-ba33-4a14-bdd0-9e83f8c8c2bd",
                                "sense_id": "62740870-cbf5-3953-bef8-2ed3d3e894fd",
                                "text": "In de Rotterdamse wijk Carnisse worden vuilniszakken te vaak naast de containers geplaatst, met als gevolg dat ratten zich tegoed doen aan de inhoud. De gemeente hoopt daar verandering in te brengen door een bewegende rat op de container te projecteren. Zo worden de bewoners herinnerd aan de gevolgen van het zogeheten 'naastplaatsen' van de vuilniszak."
                            }
                        ]
                    }
