                ],
                "senses": [
                    {
                        "sense_id": "dd436c74-e6e4-35bf-898b-6b48bf1b5d46",
                        "entry_id": "9ab03c45-7dbe-3812-aee7-ed15e9ece3fa",
                        "glosses": [
                            "Verwendung von Schriftzeichen, die ohne Rücksicht auf ihre mögliche Bedeutung lediglich einen bestimmten Lautwert anzeigen"
                        ],
                        "tags": [
                            "speziell Schriftlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "53559cca-ed3f-484f-8487-421ca81617d9",
                                "sense_id": "dd436c74-e6e4-35bf-898b-6b48bf1b5d46",
                                "text": "„Das Schreiben nach dem Rebusprinzip besagt, daß einem Piktogramm ein Bildzeichen beigefügt wird, welches dessen Lautwert bezeichnet.“"
                            },
                            {
                                "example_id": "0dfbb494-4473-4de8-a602-ef0a37bd021b",
                                "sense_id": "dd436c74-e6e4-35bf-898b-6b48bf1b5d46",
                                "text": "„Die Zeichen werden nach dem Rebusprinzip (…) verwendet, das heißt sie sind entsemantisiert. Erhalten bleibt nur ihre Ausdrucksseite..“"
                            },
                            {
                                "example_id": "57d9b722-38e7-4dd2-a3bd-ef3603029d73",
                                "sense_id": "dd436c74-e6e4-35bf-898b-6b48bf1b5d46",
                                "text": "„Die Perser entwickelten die Keilschrift weiter und schufen mit Hilfe des Rebusprinzips die Brücke zum Laut: Das Rebusprinzip kennt man aus Rebusrätseln: (Augensymbol - nicht eye - sondern \"I\" (ich)“"
                            },
                            {
                                "example_id": "c2324c72-b791-458c-be11-75d9b34bc8cf",
                                "sense_id": "dd436c74-e6e4-35bf-898b-6b48bf1b5d46",
                                "text": "„Historisch hat sich das silbenbasierte Verschriftungsprinzip aus den Wortschriften entwickelt, und zwar über ein Verfahren, das man Rebusprinzip nennt und das dem einen oder anderen noch heute als kalauernde Beigabe von Rätselheften bekannt sein dürfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
