                        "sense_id": "f614c0cd-657d-35e9-ae9b-f093d542bfbb",
                        "entry_id": "f7226937-eaff-3cfb-9712-29dbe74fc26a",
                        "glosses": [
                            "Se décrire soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29870d9e-909a-4ade-bf57-94f7af8d015c",
                                "sense_id": "f614c0cd-657d-35e9-ae9b-f093d542bfbb",
                                "text": "Certains informaticiens pensent qu’une machine de Turing capable de s’auto-décrire est dotée de la faculté d’introspection."
                            },
                            {
                                "example_id": "d78a8b17-14ca-4e82-b88c-de6b346f9397",
                                "sense_id": "f614c0cd-657d-35e9-ae9b-f093d542bfbb",
                                "text": "Ces conditions de complexité forcent un brusque réveil des dormants, ceux qui sont restés dans l’illusion d'une production sémantique exclusivement référée au sujet, dans une modernité qui éprouve des difficultés à s’auto-décrire."
                            }
                        ]
                    }
