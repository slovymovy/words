                        "source_entry_id": "936037cd-b651-3ed5-837e-633621f4ec7b",
                        "source_sense_description": "преисполнившись гармонии, являя собой гармонию",
                        "target_lang_word": "harmonisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harmonisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60b5bc55-0028-33bb-9dda-0582c1ee81e4",
                                        "entry_id": "5349706b-2f3f-3f72-ba4d-e3861993b188",
                                        "glosses": [
                                            "in Bezug auf Töne, Farben, Gerüche, Geschmack gut zueinander passend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c21e44f-f34e-4e4e-bb99-42451ef0b92d",
                                                "sense_id": "60b5bc55-0028-33bb-9dda-0582c1ee81e4",
                                                "text": "Interview: „Und wovon hängt ab, ob wir Musik als harmonisch oder dissonant empfinden?“ - „Das scheint biologisch festzuliegen: Harmonische und dissonante Klänge erzeugen unterschiedliche Schwingungen im Ohr.“"
                                            },
                                            {
                                                "example_id": "e93c6396-5919-4d2d-a3f3-17dfc2eff51c",
                                                "sense_id": "60b5bc55-0028-33bb-9dda-0582c1ee81e4",
                                                "text": "Teil des Faszinosums ist auch, dass sie [Renaissance- und Barock-Instrumente wie Gambe, Laute, Traversflöte] \"mitteltönig\" gestimmt sind. Das ist eine Frequenz, die wir als besonders \"rein\" und harmonisch wahrnehmen."
                                            },
                                            {
                                                "example_id": "01237ea6-60db-4108-94be-20bd9171f21f",
                                                "sense_id": "60b5bc55-0028-33bb-9dda-0582c1ee81e4",
                                                "text": "Manche sahen in dem Bild sogar den sogenannten Goldenen Schnitt - die fotografierten Menschen seien perfekt angeordnet, die Proportionen besonders harmonisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2ae6af5f-e7b3-36fb-a2a2-feb0a0a51ca5",
                                        "entry_id": "5349706b-2f3f-3f72-ba4d-e3861993b188",
                                        "glosses": [
                                            "freundlich und friedlich, miteinander; ohne Unstimmigkeiten oder Streit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1088a67c-b365-40db-a9b4-b5a9ebef586e",
                                                "sense_id": "2ae6af5f-e7b3-36fb-a2a2-feb0a0a51ca5",
                                                "text": "Weihnachten gilt als das wichtigste Familienfest. Manche Feier läuft aber nicht so harmonisch ab wie gewünscht."
                                            },
                                            {
                                                "example_id": "93096e04-5634-4ae0-96c5-7f941f6629cb",
                                                "sense_id": "2ae6af5f-e7b3-36fb-a2a2-feb0a0a51ca5",
                                                "text": "Öffentlich geben sie sich harmonisch, doch intern finden Diplomaten der EU und den USA deutliche Worte. Die im Netz verbreiteten vertraulichen Telefongespräche sorgen für Zwist in einem ohnehin angespannten Verhältnis."
                                            },
                                            {
                                                "example_id": "8b2658b3-67ef-4ee1-9747-4ca8a5bb4e15",
                                                "sense_id": "2ae6af5f-e7b3-36fb-a2a2-feb0a0a51ca5",
                                                "text": "In Berlin aber propagieren selbst die Grünen Radschnellwege nur als Teil eines Gesamtkonzeptes, in dem Fußgänger, Auto- und Radfahrer harmonisch miteinander leben. Klingt nett."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
