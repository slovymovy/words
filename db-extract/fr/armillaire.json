                    {
                        "translation_id": "3003700b-5127-422b-8206-71de80e8503e",
                        "source_entry_id": "79160962-2157-34a0-8f2c-52a47fd34333",
                        "source_sense_id": "0e159362-f859-3733-903e-e8d7d1395f02",
                        "target_lang_word": "honey fungus",
