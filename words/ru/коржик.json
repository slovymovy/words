{
    "word_family": [
        "корж",
        "коржевой"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bdbbfd72-dd9d-387f-8711-d8b195f8bcdd",
                    "sense_definition": "Кондитерское изделие из сдобного сладкого теста в виде плоской лепёшки.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "выпечка",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В школьной столовой на перемене мы часто покупали свежий молочный <w>коржик</w>.",
                            "target_lang_translations": {
                                "en": "In the school cafeteria during recess, we often bought a fresh milk <w>shortbread</w>."
                            }
                        },
                        {
                            "text": "Бабушка испекла к чаю ароматный медовый <w>коржик</w> по старинному рецепту.",
                            "target_lang_translations": {
                                "en": "Grandmother baked a fragrant honey <w>cookie-cake</w> for tea using an old recipe."
                            }
                        }
                    ],
                    "synonyms": [
                        "печенье"
                    ],
                    "common_phrases": [
                        "молочный коржик",
                        "медовый коржик"
                    ],
                    "target_lang_definitions": {
                        "en": "A confectionery product made from rich sweet dough in the form of a flat cake or thick cookie."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shortbread cookie",
                                "target_lang_sense_clarification": "a thick, crumbly sweet biscuit"
                            },
                            {
                                "target_lang_word": "flatbread cookie",
                                "target_lang_sense_clarification": "a flat, round baked good"
                            },
                            {
                                "target_lang_word": "scone-like cookie",
                                "target_lang_sense_clarification": "referring to the texture and shape"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01028a48-a927-3f34-aedf-21ffdb902d29",
                    "sense_definition": "Уменьшительная или ласкательная форма к слову <w>корж</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "выпечка",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот маленький <w>коржик</w> идеально подойдёт для украшения верхушки торта.",
                            "target_lang_translations": {
                                "en": "This small <w>cake layer</w> will be perfect for decorating the top of the cake."
                            }
                        },
                        {
                            "text": "Она аккуратно разрезала каждый <w>коржик</w> пополам, чтобы пропитать его кремом.",
                            "target_lang_translations": {
                                "en": "She carefully cut each <w>layer</w> in half to soak it with cream."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "diminutive"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A diminutive or affectionate form of the word 'korzh' (a cake layer or flatbread)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "small cake layer",
                                "target_lang_sense_clarification": "diminutive of a sponge or dough layer"
                            },
                            {
                                "target_lang_word": "little flatbread",
                                "target_lang_sense_clarification": "diminutive of a thick dough base"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e5cec00-a673-3bf9-b8f7-004da97247dd",
                    "sense_definition": "Собака породы корги.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "собаки",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "По парку бегал забавный рыжий <w>коржик</w> на коротких лапках.",
                            "target_lang_translations": {
                                "en": "A funny ginger <w>corgi</w> on short legs was running around the park."
                            }
                        },
                        {
                            "text": "Мой сосед недавно завёл щенка, и теперь этот маленький <w>коржик</w> радует весь двор.",
                            "target_lang_translations": {
                                "en": "My neighbor recently got a puppy, and now this little <w>corgi-loaf</w> brings joy to the whole yard."
                            }
                        }
                    ],
                    "synonyms": [
                        "корги"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "slang term for corgi dogs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A dog of the Corgi breed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "corgi",
                                "target_lang_sense_clarification": "the dog breed"
                            },
                            {
                                "target_lang_word": "corgi-loaf",
                                "target_lang_sense_clarification": "slang/affectionate term for a corgi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}