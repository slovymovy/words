    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a6873fe9-d232-3dea-a2a9-72ecf369dd06",
                    "sense_definition": "Достигнуть зрелости, стать взрослым.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "взросление",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За годы учёбы в университете он заметно <w>возмужал</w> и стал принимать самостоятельные решения.",
                            "target_lang_translations": {
                                "nl": "Tijdens zijn studiejaren aan de universiteit is hij merkbaar <w>volwassen geworden</w> en begon hij zelfstandige beslissingen te nemen."
                            }
                        },
                        {
                            "text": "Юноша быстро <w>возмужал</w> на военной службе.",
                            "target_lang_translations": {
                                "nl": "De jongeman is tijdens zijn militaire dienst snel <w>mannelijker en sterker geworden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "повзрослеть",
                        "созреть"
                    ],
                    "common_phrases": [
                        "заметно возмужал",
                        "быстро возмужать"
                    ],
                    "target_lang_definitions": {
                        "nl": "Volwassen worden, de volwassenheid bereiken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "volwassen worden",
                                "target_lang_sense_clarification": "de volwassen leeftijd bereiken"
                            },
                            {
                                "target_lang_word": "rijpen",
                                "target_lang_sense_clarification": "geestelijk of lichamelijk volwassen worden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "318fcd53-8fa3-35a0-8d91-0d94738b763e",
                    "sense_definition": "Стать мужественнее, выносливее, окрепнуть физически или духовно.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "укрепление",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Трудности только помогли ему, его характер закалился, а сам он духовно <w>возмужал</w>.",
                            "target_lang_translations": {
                                "nl": "De moeilijkheden hielpen hem alleen maar, zijn karakter werd gehard en hij is er spiritueel door <w>gesterkt</w>."
                            }
                        },
                        {
                            "text": "После тяжёлых тренировок молодой спортсмен физически <w>возмужал</w>.",
                            "target_lang_translations": {
                                "nl": "Na zware trainingen is de jonge atleet fysiek <w>sterker geworden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "закалиться"
                    ],
                    "common_phrases": [
                        "духовно возмужать",
                        "физически возмужать"
                    ],
                    "target_lang_definitions": {
                        "nl": "Mannelijker, sterker of weerbaarder worden, zowel fysiek als mentaal."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "sterker worden",
                                "target_lang_sense_clarification": "fysiek of mentaal aan kracht winnen"
                            },
                            {
                                "target_lang_word": "manhaftiger worden",
                                "target_lang_sense_clarification": "mannelijker en moediger worden"
                            },
                            {
                                "target_lang_word": "zich harden",
                                "target_lang_sense_clarification": "weerbaarder worden door beproevingen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4da58c5e-f38d-31a8-a69b-1f189a522336",
                    "sense_definition": "Переносное значение: усилиться, возрасти, окрепнуть в своём развитии (о чувствах, таланте, силе).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "развитие",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его писательский талант заметно <w>возмужал</w> за последние годы, что отразилось в новом романе.",
                            "target_lang_translations": {
                                "nl": "Zijn schrijftalent is de afgelopen jaren merkbaar <w>gerijpt</w>, wat weerspiegeld wordt in zijn nieuwe roman."
                            }
                        },
                        {
                            "text": "Когда чувство свободы окончательно <w>возмужало</w> в обществе, перемены стали неизбежными.",
                            "target_lang_translations": {
                                "nl": "Toen het gevoel van vrijheid in de samenleving eenmaal volledig <w>tot wasdom was gekomen</w>, werden veranderingen onvermijdelijk."
                            }
                        }
                    ],
                    "synonyms": [
                        "сложиться",
                        "созреть"
                    ],
                    "common_phrases": [
                        "талант возмужал"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative meaning"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Figuurlijk: sterker worden, groeien, tot volle bloei of ontwikkeling komen (van talent, gevoelens, kracht)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "rijpen",
                                "target_lang_sense_clarification": "tot volle ontwikkeling komen van talent"
                            },
                            {
                                "target_lang_word": "sterker worden",
                                "target_lang_sense_clarification": "toenemen in kracht of invloed"
                            },
                            {
                                "target_lang_word": "tot wasdom komen",
                                "target_lang_sense_clarification": "volledig ontwikkeld raken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}