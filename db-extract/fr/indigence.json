                                "sense_id": "8f6c8d4f-afbd-3127-8b07-b0988d4236e8",
                                "text": "Certificat d’indigence."
                            }
                        ]
                    },
                    {
                        "sense_id": "76500541-f1f9-34bc-886b-421a874f31d5",
                        "entry_id": "53b1f4be-0d1e-3c69-ba7c-e3db44338f1e",
