                        "entry_id": "7874e97e-2956-3514-98fe-8976bfefaa64",
                        "glosses": [
                            "A young female horse."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9c0b8618-503f-3457-a523-8de46089f768",
                        "entry_id": "7874e97e-2956-3514-98fe-8976bfefaa64",
                        "glosses": [
                            "A young, attractive woman."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b355fa02-5f3c-4fa3-a789-d4cf248140d7",
                                "sense_id": "9c0b8618-503f-3457-a523-8de46089f768",
                                "text": "Hey, Homer, get a load of the gams on that filly!"
                            },
                            {
                                "example_id": "498ddce3-c20f-4f30-acff-28b71f8116ba",
                                "sense_id": "9c0b8618-503f-3457-a523-8de46089f768",
                                "text": "Betty Lou began to think of Bobby Jo. That feisty filly still brought up sexual connotations, even though the two had been going together for almost three weeks now."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb16e39a-08c5-45c3-8493-a9291290f9af",
                        "source_entry_id": "7874e97e-2956-3514-98fe-8976bfefaa64",
                        "source_sense_description": "young female horse",
                        "target_lang_word": "kobylka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
