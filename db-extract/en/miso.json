                    {
                        "sense_id": "110283b3-10d4-3fd7-928a-f7ea86059144",
                        "entry_id": "2870746f-2c6d-3bfd-9e75-b0ae89c66262",
                        "glosses": [
                            "A thick paste made by fermentation of soybeans with the mold Aspergillus oryzae, used in making soups and sauces."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9f58980f-eb7f-4b0c-9cf6-cd74bee08a72",
                                "sense_id": "110283b3-10d4-3fd7-928a-f7ea86059144",
                                "text": "Substances float around each other until you crush them all with a blender. Add a bit of white miso, lemon juice, truffle oil, chives: survey your wreckage, which will be the wrong colour (cream with a hint of grey) and the wrong consistency (gluey)."
                            }
                        ]
                    }
                ],
