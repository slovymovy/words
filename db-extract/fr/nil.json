                            {
                                "target_word": "Нил",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "54da432e-5fbd-33e0-9be0-c68166661f45",
                                        "entry_id": "39b8e3b7-9fc1-3c73-82b3-faeba2c2bf5a",
                                        "glosses": [
                                            "русское мужское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2963a867-e803-4e74-b180-0f0adadeadc0",
                                                "sense_id": "54da432e-5fbd-33e0-9be0-c68166661f45",
                                                "text": "Благословенна память старца Нила Сорского, великого нестяжателя!"
                                            },
                                            {
                                                "example_id": "be69a733-3286-4fea-845e-68b43272d5c9",
                                                "sense_id": "54da432e-5fbd-33e0-9be0-c68166661f45",
                                                "text": "Мы беседуем с настоятелем монастыря иеромонахом Нилом."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Нил",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4a245084-5394-346b-9541-2aa51f4aa424",
                                        "entry_id": "33c41b34-e038-3ff6-95af-c4d6f25e321f",
                                        "glosses": [
                                            "английское мужское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00cf87d0-7a3b-4e9d-ae7d-3c225eb68f1c",
                                                "sense_id": "4a245084-5394-346b-9541-2aa51f4aa424",
                                                "text": "Нил Армстронг, вспомнив, что сейчас за ним в прямом эфире наблюдают миллионы телезрителей, остановился на последней ступеньке трапа и произнес первое, что пришло в голову."
                                            }
                                        ]
                                    }
                                ]
                            }
