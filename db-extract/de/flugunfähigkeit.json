                "senses": [
                    {
                        "sense_id": "f8ff0632-822b-3fbd-ac4a-1d8a32472c7e",
                        "entry_id": "a27382d3-81be-38b4-857f-33192e1f769c",
                        "glosses": [
                            "Zustand, in dem Fliegen unmöglich ist, obwohl dies grundsätzlich erwartbar ist (etwa bei Vögeln, Insekten, Flugzeugen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d2c6900-8051-476c-ae4e-6347ec04e924",
                                "sense_id": "f8ff0632-822b-3fbd-ac4a-1d8a32472c7e",
                                "text": "„Aufgrund mangelnder Feinde entwickelten sich die Flügel vieler Vogelarten bis zur Flugunfähigkeit zurück.“"
                            },
                            {
                                "example_id": "a5bceff5-d7f9-4b44-971b-0e93c81cb7a4",
                                "sense_id": "f8ff0632-822b-3fbd-ac4a-1d8a32472c7e",
                                "text": "„Durch ihre Flugunfähigkeit war die Schnepfenralle eine leichte Beute für die Pazifische Ratte, die ab dem 13. Jahrhundert in Neuseeland eingeschleppt wurde.“"
                            },
                            {
                                "example_id": "b8a0a19a-a5b6-43a9-9630-e8d97a41fa27",
                                "sense_id": "f8ff0632-822b-3fbd-ac4a-1d8a32472c7e",
                                "text": "„Flugunfähigkeit bei Vögeln entwickelte sich viele Male auf Inseln rund um den Globus.“"
                            },
                            {
                                "example_id": "6884d279-6e13-43c1-b86d-e8708869e6c6",
                                "sense_id": "f8ff0632-822b-3fbd-ac4a-1d8a32472c7e",
                                "text": "„Der Evolutionsbiologe Charles Darwin […] sah in der Entwicklung von Flugunfähigkeit bei Vögeln einen Beleg für seine Theorie der natürlichen Selektion.“"
                            },
                            {
                                "example_id": "36171dc7-8249-4801-8a2c-c041e0a3ef54",
                                "sense_id": "f8ff0632-822b-3fbd-ac4a-1d8a32472c7e",
                                "text": "Wegen der Flugunfähigkeit vieler Bundeswehr-Hubschrauber verlieren immer wieder Piloten ihre Fluglizenzen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
