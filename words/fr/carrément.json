                    ]
                },
                {
                    "sense_id": "48c3fac6-38ad-346f-b358-575f041fc4a4",
                    "sense_definition": "D'une manière carrée, à angles droits.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geometrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers ont taillé les pierres bien <w>carrément</w> pour stabiliser les fondations de l'édifice."
                        },
                        {
                            "text": "Les tours sont rondes vers l'extérieur et se terminent <w>carrément</w> du côté de la cour."
