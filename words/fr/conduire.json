            "senses": [
                {
                    "sense_id": "472ed853-7e36-34df-8ad8-161e9d130282",
                    "sense_definition": "Piloter ou diriger un véhicule à moteur ou un attelage.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère apprend à <w>conduire</w> une voiture depuis deux mois."
                        },
                        {
                            "text": "Elle <w>conduit</w> prudemment lorsqu'il commence à pleuvoir sur l'autoroute."
                        }
                    ],
                    "synonyms": [
                        "piloter"
                    ],
                    "common_phrases": [
                        "conduire une voiture",
                        "permis de conduire",
                        "apprendre à conduire"
                    ]
                },
                {
                    "sense_id": "5d2b393b-cda7-3d56-bb7b-09805fc7d3d8",
                    "sense_definition": "Mener, guider ou accompagner une personne vers un endroit précis.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "accompagnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le guide nous <w>conduit</w> avec beaucoup de gentillesse à travers le musée."
                        },
                        {
                            "text": "Chaque matin, mon père <w>conduit</w> les enfants à l'école du village."
                        }
                    ],
                    "synonyms": [
                        "accompagner"
                    ],
                    "common_phrases": [
                        "conduire à l'école",
                        "conduire à la gare"
                    ]
                },
                {
                    "sense_id": "988bcd86-b53e-3488-bc66-27326506afd9",
                    "sense_definition": "Agir d'une certaine façon, adopter une manière d'être ou un comportement moral.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves doivent se <w>conduire</w> poliment en classe avec leurs professeurs."
                        },
                        {
                            "text": "Il s'est mal <w>conduit</w> lors de la dernière réunion avec ses collègues."
                        }
                    ],
                    "synonyms": [
                        "se comporter"
                    ],
                    "common_phrases": [
                        "se conduire bien",
                        "se conduire mal"
                    ]
                },
                {
                    "sense_id": "12fa25ed-4d67-3c35-a7ed-4f11c3802551",
                    "sense_definition": "Mener à un endroit déterminé ou aboutir à un résultat précis.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aboutissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce petit sentier dans la forêt <w>conduit</w> directement au bord du lac."
                        },
                        {
                            "text": "Cette mauvaise gestion risque de <w>conduire</w> l'entreprise tout droit à la faillite."
                        }
                    ],
                    "common_phrases": [
                        "conduire au succès",
                        "conduire à l'échec"
                    ]
                },
                {
                    "sense_id": "d1c634ba-c707-36d1-b45f-6309de1cd876",
                    "sense_definition": "Inciter ou déterminer quelqu'un à faire quelque chose ou à changer d'avis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les nouveaux indices ont <w>conduit</w> la police à interroger ce témoin clé."
                        },
                        {
                            "text": "Sa grande curiosité intellectuelle l'a <w>conduit</w> à explorer plusieurs domaines scientifiques."
                        }
                    ],
                    "common_phrases": [
                        "conduire à penser",
                        "conduire à croire"
                    ]
                },
                {
                    "sense_id": "e7daa0aa-6ab1-3a8a-a0b1-b1c3f8d5ab3e",
                    "sense_definition": "Diriger, superviser ou mener à bien un projet, des affaires ou des travaux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La nouvelle directrice a su <w>conduire</w> ce projet complexe avec un immense succès."
                        },
                        {
                            "text": "Il a été officiellement chargé de <w>conduire</w> les négociations avec nos partenaires."
                        }
                    ],
                    "common_phrases": [
