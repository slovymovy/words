                        "tags": [],
                        "examples": [
                            {
                                "example_id": "491eddb4-1e36-4722-b867-46f77bfdbeb6",
                                "sense_id": "68c4334a-50e3-373e-a790-a89a1b8bcaa8",
                                "text": "Elle présentait à ses yeux l’avantage d’augustiniser saint Thomas et, par conséquent, de thomistiser saint Bonaventure."
                            },
                            {
                                "example_id": "7aa6db8c-ab42-4562-b316-33e5b1569d22",
                                "sense_id": "68c4334a-50e3-373e-a790-a89a1b8bcaa8",
                                "text": "C’est déjà une marque sûre que vous commencez à thomistiser spontanément d’interpréter comme vous le faites Ia, CXII, 1, in corp."
                            }
                        ]
