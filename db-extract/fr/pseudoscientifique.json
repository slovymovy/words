                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seudocientífico",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "fe1e7c52-6cf5-3757-8a2c-495c94754e0f",
                                        "entry_id": "a4efb522-bdee-3e44-9cad-ef107349367f",
                                        "glosses": [
                                            "Que pretende ser científico sin serlo. Propio de la seudociencia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8cd1bfb-2cdc-449b-9708-70e828dbed2c",
                                                "sense_id": "fe1e7c52-6cf5-3757-8a2c-495c94754e0f",
                                                "text": "Sin embargo, pocas personas están en posibilidad de distinguir si se trata de una propuesta seudocientífica o, bien, de algún tipo de especulación de vanguardia por completo válida."
                                            }
                                        ],
