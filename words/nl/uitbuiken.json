{
    "word_family": [
        "buik",
        "buikig",
        "uitbuiking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c191685c-7dd0-3b51-977e-faee76212b18",
                    "sense_definition": "Rustig ontspannen of uitrusten na het eten van een uitgebreide maaltijd.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rusten_na_eten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het uitgebreide kerstdiner moesten we allemaal even lekker <w>uitbuiken</w> op de bank.",
                            "target_lang_translations": {
                                "ru": "После обильного рождественского ужина нам всем нужно было немного <w>отдохнуть после еды</w> на диване."
                            }
                        },
                        {
                            "text": "We gaan eerst rustig <w>uitbuiken</w> na de maaltijd voordat we aan de afwas beginnen.",
                            "target_lang_translations": {
                                "ru": "Мы сначала спокойно <w>отдохнем после еды</w>, прежде чем приступим к мытью посуды."
                            }
                        }
                    ],
                    "synonyms": [
                        "na-eten"
                    ],
                    "common_phrases": [
                        "uitbuiken op de bank",
                        "lekker uitbuiken",
                        "rustig uitbuiken",
                        "uitbuiken na de maaltijd"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спокойно отдыхать или расслабляться после плотной еды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдыхать после еды",
                                "target_lang_sense_clarification": "общее описание процесса отдыха после приема пищи"
                            },
                            {
                                "target_lang_word": "переваривать пищу",
                                "target_lang_sense_clarification": "в значении спокойного времяпрепровождения для облегчения пищеварения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae0fc9a5-dcf6-376b-815e-e1be3cfd686b",
                    "sense_definition": "Een korte wandeling maken na het eten om het eten te laten zakken.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rusten_na_eten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de maaltijd gingen we lekker <w>uitbuiken</w> tijdens een wandeling in het park.",
                            "target_lang_translations": {
                                "ru": "После еды мы с удовольствием <w>прогулялись</w> в парке."
                            }
                        },
                        {
                            "text": "Mijn grootouders houden ervan om na het avondeten nog even een halfuurtje te <w>uitbuiken</w> buiten.",
                            "target_lang_translations": {
                                "ru": "Мои бабушка и дедушка любят после ужина еще полчаса <w>прогуливаться</w> на свежем воздухе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uitbuiken tijdens een wandeling"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать короткую прогулку после еды, чтобы помочь пищеварению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогуливаться после еды",
                                "target_lang_sense_clarification": "активный отдых после приема пищи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a22f0355-8314-3323-b765-0e562829f730",
                    "sense_definition": "Naar buiten bolbollen of uitsteken van een oppervlak.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de enorme druk begon de oude muur gevaarlijk uit te <w>buiken</w>.",
                            "target_lang_translations": {
                                "ru": "Из-за огромного давления старая стена начала опасно <w>выпячиваться</w>."
                            }
                        },
                        {
                            "text": "Het zeil bolde op door de sterke wind en bleef bol <w>uitbuiken</w>.",
                            "target_lang_translations": {
                                "ru": "Парус надулся от сильного ветра и продолжал <w>выпячиваться</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitbollen",
                        "uitsteken"
                    ],
                    "common_phrases": [
                        "bol uitbuiken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпячиваться или выдаваться наружу (о поверхности или материале)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпячиваться",
                                "target_lang_sense_clarification": "о деформации поверхности или материала"
                            },
                            {
                                "target_lang_word": "выдаваться",
                                "target_lang_sense_clarification": "о выступающей части конструкции"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}