                                                "example_id": "ef9049e7-bfae-4abb-8bd6-7980fdf6c616",
                                                "sense_id": "7d031d55-6e43-330e-9e5b-ff640e4a8bc4",
                                                "text": "You might have stumbled upon discussions of Bloodborne's lore - there are plenty of discussions about Bloodborne's lore - which can be more than a little dense and, to the outsider, off-putting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71a22420-ea6e-38e9-bf6d-173b70aa940f",
                                        "entry_id": "3ccdeba5-c69a-316d-b0e6-b97f99f0fe4d",
                                        "glosses": [
                                            "The backstory, especially for a character or setting, created around a fictional universe.",
                                            "Trivia shared by a person about themself."
                                        ],
                                        "tags": [
