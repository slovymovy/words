                "senses": [
                    {
                        "sense_id": "816ff249-66be-3354-a1e9-db1f974b34c7",
                        "entry_id": "99d5033d-6e32-3163-9cd2-b18f9713ce80",
                        "glosses": [
                            "Fachärztin für Erkrankungen von Hals, Nase und Ohren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c303d08-85b9-4e66-9a5e-cc520ec8dbe7",
                                "sense_id": "816ff249-66be-3354-a1e9-db1f974b34c7",
                                "text": "„Gehör und Sprachentwicklung waren dort gründlich untersucht worden, nachdem die HNO-Ärztin zu dem Ergebnis gelangt war, dass dort vermutlich Beeinträchtigungen bestanden.“"
                            },
                            {
                                "example_id": "080198f9-def3-48ad-aa84-be01c1de44c0",
                                "sense_id": "816ff249-66be-3354-a1e9-db1f974b34c7",
                                "text": "„Die Patientin kommt auf Empfehlung ihrer HNO-Ärztin zur Behandlung, da wegen sehr schmerzhafter Ohrenentzündungen eine Operation […] erforderlich sei […].“"
                            },
                            {
                                "example_id": "ccf56818-8d81-4934-8bc2-da3ca843eadc",
                                "sense_id": "816ff249-66be-3354-a1e9-db1f974b34c7",
                                "text": "„Um diesen geschulten Blick müssen sich die HNO-Ärztinnen und -Ärzte kümmern, da sie – ähnlich wie bei der Betrachtung eines Nebenhöhlen-CT – eigene Interpretationen berücksichtigen müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
