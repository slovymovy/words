                                        "entry_id": "e9076671-566c-3470-b0c0-148adb32204c",
                                        "glosses": [
                                            "Instrument dont on se sert pour projeter sur un même point fixe les rayons du soleil, malgré les mouvements de cet astre."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a879730b-ba78-4b8e-8603-6bfec252b8c4",
                                                "sense_id": "6c3a3cc8-f776-3949-84c4-a38d149901bf",
                                                "text": "L’héliostat de Foucault."
                                            },
                                            {
                                                "example_id": "82db7497-dcdc-412e-aedd-c15290f2e9ee",
                                                "sense_id": "6c3a3cc8-f776-3949-84c4-a38d149901bf",
                                                "text": "Le principe de l’héliostat est de capter un faisceau lumineux solaire pour le renvoyer dans une direction fixe malgré le mouvement apparent du Soleil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
