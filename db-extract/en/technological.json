                    {
                        "translation_id": "c626bcaa-00e5-49a4-ac44-397973e95eef",
                        "source_entry_id": "ebdb8ccb-b0d6-3374-85d0-33dc0a299395",
                        "source_sense_id": "cc93658a-69e6-3e6f-a420-30e6612e1151",
                        "source_sense_description": "of, relating to, or involving technology",
                        "target_lang_word": "technologisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technologisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ed5aa109-4a80-311d-a053-4d320b915936",
                                        "entry_id": "5e39a987-eabe-3d3b-a9b6-202199ad39dc",
                                        "glosses": [
                                            "met betrekking tot stelselmatig ontwikkelde kennis over werkwijzen en hulpmiddelen om dingen te produceren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14691e6d-d0cc-49a1-a089-433d1976e4d8",
                                                "sense_id": "ed5aa109-4a80-311d-a053-4d320b915936",
                                                "text": "Ons leven verandert door de technologische ontwikkeling."
                                            },
                                            {
                                                "example_id": "9e6554b5-e555-4003-9e11-33a1b518bfd8",
                                                "sense_id": "ed5aa109-4a80-311d-a053-4d320b915936",
                                                "text": "Het groeiend gebrek aan technologisch talent is in Nederland een groot knelpunt, zo staat omschreven in het nieuwste rapport over de bekostiging van hoger onderwijs en onderzoek, dat afgelopen week werd aangeboden aan minister Ingrid van Engelshoven (Onderwijs, Cultuur en Wetenschap)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8eb16277-ce60-37cd-8993-2145a31de486",
                                        "entry_id": "5e39a987-eabe-3d3b-a9b6-202199ad39dc",
                                        "glosses": [
                                            "vanuit de kennis hoe en met welke hulpmiddelen iets gemaakt wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1761ab36-68cb-4095-841b-815a8eebb313",
                                                "sense_id": "8eb16277-ce60-37cd-8993-2145a31de486",
                                                "text": "De nieuwe machine was een technologische mislukking omdat hij te snel versleet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b853393-90c2-43f0-8367-a506aca0994d",
                        "source_entry_id": "ebdb8ccb-b0d6-3374-85d0-33dc0a299395",
                        "source_sense_id": "cc93658a-69e6-3e6f-a420-30e6612e1151",
                        "source_sense_description": "of, relating to, or involving technology",
                        "target_lang_word": "technologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1e90a9c-95a4-3c65-b48d-e57087664f2d",
                                        "entry_id": "731f9ff6-2843-3449-bd47-60be4bdc13cd",
                                        "glosses": [
                                            "Relatif à la technologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d588bffd-2d4d-463f-b1b4-9a9795f1bb12",
                                                "sense_id": "a1e90a9c-95a4-3c65-b48d-e57087664f2d",
                                                "text": "[…]; elle estime, comme G. de Molinari, que le progrès moral du prolétariat est aussi nécessaire que le progrès matériel de l'outillage, pour porter l'industrie moderne au niveau toujours plus élevé que la science technologique permet d'atteindre; […]."
                                            },
                                            {
                                                "example_id": "2bdd90c8-39c9-4c8f-a914-ec0ad560a7c8",
                                                "sense_id": "a1e90a9c-95a4-3c65-b48d-e57087664f2d",
                                                "text": "En dépit de sa réussite, l’Europe connaissait d'intenses frustrations. Cette réussite était pourtant éclatante. Les progrès scientifiques, technologiques et industriels y étaient impressionnants."
                                            },
                                            {
                                                "example_id": "a5a3531d-989f-44c2-9dc6-a5b9eae39e4f",
                                                "sense_id": "a1e90a9c-95a4-3c65-b48d-e57087664f2d",
                                                "text": "Ce n’est pas la première fois (et pas la dernière) que le progrès technologique est remis en cause en raison d’une peur irrationnelle, elle-même engendrée par l’incertitude concernant les risques d’une technologie perçue comme invasive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d1fa917-2e35-4c0d-8085-ce3c97ebc938",
                        "source_entry_id": "ebdb8ccb-b0d6-3374-85d0-33dc0a299395",
                        "source_sense_id": "cc93658a-69e6-3e6f-a420-30e6612e1151",
                        "source_sense_description": "of, relating to, or involving technology",
                        "target_lang_word": "technologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
