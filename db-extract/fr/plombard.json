                        "examples": [
                            {
                                "example_id": "a7c0be21-94c7-4685-812e-1133ee0e37dd",
                                "sense_id": "fe6509a4-b44f-3340-a131-5d525aee42df",
                                "text": "Je bricole mes sculptures comme des chansonnettes, en plombard appliqué."
                            },
                            {
                                "example_id": "e73a8d79-2aca-45d5-a92a-1507899e5849",
                                "sense_id": "fe6509a4-b44f-3340-a131-5d525aee42df",
                                "text": "Elle avait passé sa vie à vaquer aux soins du ménage, à choisir minutieusement ses marques de lessive, à appeler le plombard quand un robicot fuyait, elle milita activement à « SOS femmes battues » et pondit en passant quatre lardons […]."
                            },
                            {
                                "example_id": "ac60012f-83cd-42df-bb9d-4891a6ef645e",
                                "sense_id": "fe6509a4-b44f-3340-a131-5d525aee42df",
                                "text": "Le binôme de plombards délégué par l’entreprise ne prend guère que deux jours pour le travail et à peine plus au printemps pour remonter le tout."
                            }
                        ]
                    }
