                        "examples": [
                            {
                                "example_id": "b54739f9-3b7b-45a6-b6a8-2ea697d5bead",
                                "sense_id": "d791fa92-1228-38e1-877e-6c37a63930f0",
                                "text": "„Es wächst hienieden Brot genug / Für alle Menschenkinder, / Auch Rosen und Myrten, Schönheit und Lust, / Und Zuckererbsen nicht minder.“"
                            },
                            {
                                "example_id": "fbdfd17c-9287-4613-a904-57bd5b91324c",
                                "sense_id": "d791fa92-1228-38e1-877e-6c37a63930f0",
                                "text": "Der Clochard wurde verspottet, da er hienieden in Lumpen wandelte."
                            },
                            {
                                "example_id": "649f5069-7d2a-4922-994b-2633d8e0ef70",
                                "sense_id": "d791fa92-1228-38e1-877e-6c37a63930f0",
                                "text": "„Heilige uns in der Beobachtung deiner göttlichen Gebote, daß wir würdig und theilhaftig werden eines langen, glücklichen Lebens hienieden und des ewigen zukünftigen Seins.“"
                            }
                        ],
