                    },
                    {
                        "translation_id": "a0a9e834-9894-4cd5-9a4d-bd36fb6b9747",
                        "source_entry_id": "5617ef12-30c6-36c6-a6b7-52c19f4e7c64",
                        "source_sense_description": "Ionic, of Ionia",
                        "target_lang_word": "ionique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ionique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "291332f5-3442-3f21-b0b8-fe590bb7997d",
                                        "entry_id": "612143c9-1f5a-3e20-bf0f-95ae3d4ed4d9",
                                        "glosses": [
                                            "Relatif à l’Ionie ; ou qui est imité des Ioniens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bb154cc-ec6e-4db7-b19b-e97393e8c2f7",
                                                "sense_id": "291332f5-3442-3f21-b0b8-fe590bb7997d",
                                                "text": "Le portail encadré dans une ordonnance de colonnes ioniques est surmonté d'un fronton."
                                            },
                                            {
                                                "example_id": "8a52b010-4177-43fd-8bd4-d74b82d959fb",
                                                "sense_id": "291332f5-3442-3f21-b0b8-fe590bb7997d",
                                                "text": "La moulure E est une scotie, nommée rond creux ou nacelle ; elle sert aux bases des colonnes Ionique, Composite & Corinthien, pour faire opposition aux tores qui sont des moulures convexes ; ce qui forme une agréable diversité lorsqu'elles sont séparées par des listeaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0c65b12-dc44-33cd-85fc-7c8ea9b699e2",
                                        "entry_id": "612143c9-1f5a-3e20-bf0f-95ae3d4ed4d9",
                                        "glosses": [
                                            "Relatif à l'ordre architectural grécolatin caractérisé notamment par des colonnes à chapiteau aux volutes, dont le fût est orné de vingt-quatre cannelures et avec une base moulourée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bf27ba4-2b0d-4486-bd98-52d39c723dde",
                                                "sense_id": "b0c65b12-dc44-33cd-85fc-7c8ea9b699e2",
                                                "text": "L’ordre ionique."
                                            },
                                            {
                                                "example_id": "1fa7863f-7973-4c09-82f1-caee6f6fee99",
                                                "sense_id": "b0c65b12-dc44-33cd-85fc-7c8ea9b699e2",
                                                "text": "Une colonne ionique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f77f0f7-c658-3fab-bc95-870ac53bb6d8",
                                        "entry_id": "612143c9-1f5a-3e20-bf0f-95ae3d4ed4d9",
                                        "glosses": [
                                            "Qui est composé de six unités de durée."
                                        ],
                                        "tags": [
                                            "Versification"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f65cedba-96cb-4ea9-b700-92cc290cfe29",
                                                "sense_id": "3f77f0f7-c658-3fab-bc95-870ac53bb6d8",
                                                "text": "Mètre ionique mineur : mètre composé de deux brèves suivies de deux longues."
                                            },
                                            {
                                                "example_id": "765ea28b-67b5-4331-a709-2d8ddd6f374d",
                                                "sense_id": "3f77f0f7-c658-3fab-bc95-870ac53bb6d8",
                                                "text": "Mètre ionique majeur : mètre compisé de deux longues suivies de deux brèves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ionique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee4caa3f-7fe9-3ade-9e01-94cf77e66e9c",
                                        "entry_id": "91a9dd31-bfe0-30d8-8871-7455ce9a72f9",
                                        "glosses": [
                                            "Relatif aux ions ou qui contient des ions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2208b2c1-a34b-44c8-8bae-daec63c486ad",
                                                "sense_id": "ee4caa3f-7fe9-3ade-9e01-94cf77e66e9c",
                                                "text": "Quand le courant passe dans la solution ionique, les électrons vont de la cathode vers l’anode en traversant l’électrolyte."
                                            },
                                            {
                                                "example_id": "d671786b-30e3-4724-9eca-64a86c84455d",
                                                "sense_id": "ee4caa3f-7fe9-3ade-9e01-94cf77e66e9c",
                                                "text": "Et son œil est fixé tel un phare ionique / Sur la voûte du ciel où rebondit l'unique/Voie où sont les trois grains, horloge, pierre et ciel,/Que les petits enfants mélangent à du miel."
                                            },
                                            {
                                                "example_id": "83b63cd1-ab7b-45db-b1fd-8d31697976c8",
                                                "sense_id": "ee4caa3f-7fe9-3ade-9e01-94cf77e66e9c",
                                                "text": "« Le (SCC) dispose d'un certain nombre d'outils pour prévenir l'introduction de drogue dans ses établissements [dont] des détecteurs ioniques et des chiens détecteurs de drogue pour la fouille des édifices, des biens personnels, des détenus et des visiteurs », précise l’organisation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ionique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6df1dee5-a437-306e-9511-71022ac37a79",
                                        "entry_id": "01a3004b-17d7-3a91-8bb6-ce8bb122769d",
                                        "glosses": [
                                            "Mètre ionique, c’est-à-dire un mètre de six unités de durée."
                                        ],
                                        "tags": [
                                            "Versification"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6a45135-7d43-4b9e-a390-96a0432aaa3f",
                                                "sense_id": "6df1dee5-a437-306e-9511-71022ac37a79",
                                                "text": "Disons ici en quoi consiste le çloka, et qu’on nous permette de l’exposer en termes à nous […] On sait déjà que c’est un distique dont chaque vers a 16 syllabes groupées en 2 pâdas, les mêmes quant au nombre de syllabes, divers quant au rhythme. À présent, voici comment se comporte ce rhythme. Coupons le vers en groupes quadrisyllabes. Alors le 4ᵉ est invariablement un diïambe ou (toute finale de vers étant indifférente) un péon 2ᵉ ; le 2ᵈ, au contraire, repousse invariablement ces 2 pieds, plus les 2 ioniques et ce qu’ils deviennent en changeant la dernière […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
