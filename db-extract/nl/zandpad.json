                                                "sense_id": "d98a624f-ada1-3607-90a2-a6c5bd2127b2",
                                                "text": "Herr Sandweg wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "8dd1509e-185c-4472-b442-304e64e71de5",
                                                "sense_id": "d98a624f-ada1-3607-90a2-a6c5bd2127b2",
                                                "text": "Die Sandwegs fliegen heute nach Kanada."
                                            },
                                            {
                                                "example_id": "15d4207f-5380-4a3b-8840-5c5a45f4ef1c",
                                                "sense_id": "d98a624f-ada1-3607-90a2-a6c5bd2127b2",
                                                "text": "Der Sandweg trägt nie die Pullover, die die Sandweg ihm strickt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
