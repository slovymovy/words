                ],
                "senses": [
                    {
                        "sense_id": "46544d0f-2576-3a9d-9b6c-228b2eec0793",
                        "entry_id": "d9867aaa-eeef-3173-9ab3-970a223b4edd",
                        "glosses": [
                            "in einem blassen, hellen Grünton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0938b149-87c4-478f-bd1b-bf6178f4fea0",
                                "sense_id": "46544d0f-2576-3a9d-9b6c-228b2eec0793",
                                "text": "„Die Tischplatte leuchtete pastellgrün.“"
                            },
                            {
                                "example_id": "cbad446b-9458-4f78-96d9-43fa8a1bda27",
                                "sense_id": "46544d0f-2576-3a9d-9b6c-228b2eec0793",
                                "text": "„Einer der Besitzer hatte anscheinend pastellgrüne Farbe zum Schnäppchenpreis gekauft, denn sie zierte gleich mehrere Gebäude.“"
                            },
                            {
                                "example_id": "0ef00ae4-eaa6-46ee-9043-55ee7f59a9d0",
                                "sense_id": "46544d0f-2576-3a9d-9b6c-228b2eec0793",
                                "text": "„Und auch die Tapete selbst ist nicht übel, pastellgrüne Streifen mit Reihen rosa Zentifolien dazwischen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
