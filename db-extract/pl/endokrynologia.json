                        ]
                    },
                    {
                        "translation_id": "dc49e62d-592e-49e2-ab8c-45f9ecb79a65",
                        "source_entry_id": "a8ad4de1-b93b-3952-bcec-f1dbf756e1a6",
                        "source_sense_id": "bb845b3e-3423-3a6c-ae00-95999de653d6",
                        "target_lang_word": "Endokrinologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Endokrinologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58e3ccb0-851c-3689-a21b-2f0bb6113be3",
                                        "entry_id": "9af2ba3f-fee8-3697-8714-cc1aa1a012b6",
                                        "glosses": [
                                            "Lehre von den Hormonen und den Hormondrüsen (hormonbildende Drüsen) sowie deren Erkrankungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77bd477f-7486-4efb-9029-24f8b0476ae6",
                                                "sense_id": "58e3ccb0-851c-3689-a21b-2f0bb6113be3",
                                                "text": "Die Endokrinologie beschäftigt sich unter anderem mit den sogenannten Endokrinopathien."
                                            },
                                            {
                                                "example_id": "834174d2-ad60-42cf-8491-516045d4ebc6",
                                                "sense_id": "58e3ccb0-851c-3689-a21b-2f0bb6113be3",
                                                "text": "„Am nächsten Tag begann er mit ›The Breast‹ und suchte die Bibliothek des nahe gelegenen Skidmore College auf, um sich ein wenig mit Endokrinologie vertraut zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d58739cf-d3bb-40f9-845e-f29a06b3877e",
                        "source_entry_id": "a8ad4de1-b93b-3952-bcec-f1dbf756e1a6",
                        "source_sense_id": "bb845b3e-3423-3a6c-ae00-95999de653d6",
                        "target_lang_word": "эндокринология",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эндокринология",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2848815d-ea7d-3912-804f-55c034778aae",
                                        "entry_id": "582f1406-d762-36e2-a85a-765c7544423d",
                                        "glosses": [
                                            "наука о строении и функции желёз внутренней секреции (эндокринных желез), вырабатываемых ими гормонах, путях их образования и действия на организм животных и человека"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e8e2d17-65d4-49d7-99e8-11db9d7d0ee8",
                                                "sense_id": "2848815d-ea7d-3912-804f-55c034778aae",
                                                "text": ".. в результате работ Кохера и др. над патологией щитовидной железы, перед глазами исследователей открылась обширная группа фактов, положившая основание для новой науки — эндокринологии."
                                            },
                                            {
                                                "example_id": "b0e3d68b-4402-4f7c-93b7-5f766dfba398",
                                                "sense_id": "2848815d-ea7d-3912-804f-55c034778aae",
                                                "text": "Синтез гормонов в лимфоцитах и клетках тимуса многие специалисты рассматривают как доказательство существования связи между эндокринной и иммунной системами. Но это ещё и весьма показательная иллюстрация современного состояния эндокринологии: нельзя сказать, что некий гормон синтезируется там-то и делает то-то. Мест его синтеза может быть много, функций тоже, и часто они зависят именно от места образования гормона."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
