                            {
                                "example_id": "c1b2dae8-5d68-4779-a7f9-1a40b60bbb86",
                                "sense_id": "0c913134-3d27-3cb1-af04-73936318fc49",
                                "text": "Die Insel Murano in der Lagune ist für ihre Glaskunst bekannt."
                            },
                            {
                                "example_id": "c1a37eed-4003-49b5-8d4b-015f7c7b573f",
                                "sense_id": "0c913134-3d27-3cb1-af04-73936318fc49",
                                "text": "„Sie haben mich auf dem Ausflug nach Murano begleitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
