                "senses": [
                    {
                        "sense_id": "fd33aced-8fd4-370a-b29b-fb46e14d795e",
                        "entry_id": "ded3a1f4-975c-37df-a0d1-4c356fb9814f",
                        "glosses": [
                            "Donner un caractère tzigane à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce0dc85f-fdbe-492d-929f-264438310fa6",
                                "sense_id": "fd33aced-8fd4-370a-b29b-fb46e14d795e",
                                "text": "Leur dernier album Maškarada (Crammed) convoque ainsi pour les «tziganiser», Bartók ou Khachaturian."
                            },
                            {
                                "example_id": "8802d046-d339-4abd-9133-3a90428f2418",
                                "sense_id": "fd33aced-8fd4-370a-b29b-fb46e14d795e",
                                "text": "Hello les amis, Costel et les Balkanos de retour au Chat Noir pour vous les amis ! une fois par mois on va se tziganiser dans la joie et la bonne humeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "62312c8e-bc43-33c9-b8c8-9f1a96dee125",
                        "entry_id": "ded3a1f4-975c-37df-a0d1-4c356fb9814f",
                        "glosses": [
                            "Pratiquer quelque chose à la manière tzigane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "767a2935-6503-469c-813a-1f7282030747",
                                "sense_id": "62312c8e-bc43-33c9-b8c8-9f1a96dee125",
                                "text": "On soulignera les jolis accelerando de son final en sautillé qu'il mène sans tziganiser outre mesure comme le faisait Ivry Gitlis."
                            }
                        ]
                    }
