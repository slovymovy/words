                        "examples": [
                            {
                                "example_id": "541d6176-9e10-4736-9d18-a886a9d825f5",
                                "sense_id": "7ade526d-60de-3c32-a9f4-1f7c06383cc2",
                                "text": "It is prepared, according to Dr. Shaw, as follows: take six ounces of copper, melting it in a wind furnace; add to it one ounce of zink: then stirring the whole well together, pour out the metal immediately."
                            },
                            {
                                "example_id": "99f22b0a-7324-4938-a57e-c2a822658ffe",
                                "sense_id": "7ade526d-60de-3c32-a9f4-1f7c06383cc2",
                                "text": "Zink plates cannot be steel-faced, but they can be copper-faced."
                            }
                        ]
                    }
