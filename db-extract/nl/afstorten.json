        "nl-extract.jsonl": [
            {
                "entry_id": "aa032600-f6f0-3f29-9cfe-7988e0e22bf1",
                "word": "afstorten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "36bacea1-4a40-3b4a-8dde-773634c76b3e",
                        "entry_id": "aa032600-f6f0-3f29-9cfe-7988e0e22bf1",
                        "glosses": [
                            "al de ontvangen contanten bij een bank inwisselen om ze te laten bijschrijven op een bankrekening"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e70d33f5-0207-4bf2-a225-1674255cee5b",
                                "sense_id": "36bacea1-4a40-3b4a-8dde-773634c76b3e",
                                "text": "Vaak komt de ondernemer er pas achter bij het afstorten van het geld bij de bank, waar het valse geld ontdekt wordt, aldus politiewoordvoerder Anton de Ronde."
                            },
                            {
                                "example_id": "99c8c962-03a3-467c-bef9-8c95d88e9ffb",
                                "sense_id": "36bacea1-4a40-3b4a-8dde-773634c76b3e",
                                "text": "Ondernemers die een pincontract hebben bij Rabobank, of kasgeld bij die bank afstorten, kunnen vanaf komend weekeinde altijd binnen 24 uur over hun omzet beschikken. Ook op dagen dat de bank gesloten is, wordt het geld binnen een etmaal bijgeschreven."
                            }
                        ]
                    },
                    {
                        "sense_id": "cef1c73c-1e47-3d2c-b91f-d29e710722b3",
                        "entry_id": "aa032600-f6f0-3f29-9cfe-7988e0e22bf1",
                        "glosses": [
                            "iets met kracht vullen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90443522-1c64-4761-8391-692b52c32804",
                                "sense_id": "cef1c73c-1e47-3d2c-b91f-d29e710722b3",
                                "text": "Bron kreeg daarbij assistentie van Sanne Elferdink (projectdirecteur Hart van Zuid) en André van der Vegt van aannemer Dura Vermeer. Dat ging nog op de ouderwetse manier: met de schop. Het echte werk gebeurt straks met een pomp, anders zou het afstorten veel te lang gaan duren. De palen gaan namelijk tot een diepte van 18 meter de grond in."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5a54ea7-689e-3539-bcbb-83e6df366c08",
                        "entry_id": "aa032600-f6f0-3f29-9cfe-7988e0e22bf1",
                        "glosses": [
                            "iets naar een eindbestemming brengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "243849e6-70bb-4ba4-b167-af459f19de6c",
                                "sense_id": "b5a54ea7-689e-3539-bcbb-83e6df366c08",
                                "text": "De vaten bevatten een onbekende stof. De adviseur gevaarlijke stoffen van de brandweer is ter plekke geweest om de stof te analyseren. Wat er precies in de vaten zit, of heeft gezeten, kon een woordvoerder van de brandweer nog niet zeggen. Wel zorgt de brandweer ervoor dat het afval wordt opgeruimd. De brandweer verzorgt het correct afstorten van dit afval."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
