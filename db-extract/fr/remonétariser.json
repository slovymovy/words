                "senses": [
                    {
                        "sense_id": "f0c3814a-3534-3434-9467-27efcf3e3ea9",
                        "entry_id": "d6ec4d2e-b150-320e-932a-d2abe4d414c7",
                        "glosses": [
                            "Monétariser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a166917-a5a8-49b3-91a3-f33aaaf90f9c",
                                "sense_id": "f0c3814a-3534-3434-9467-27efcf3e3ea9",
                                "text": "Il s'agit là des conséquences des grandes frappes des années 330 à 348 destinées à remonétariser les échanges."
                            },
                            {
                                "example_id": "8dc70af9-77de-4318-9e73-caeb7d5335c5",
                                "sense_id": "f0c3814a-3534-3434-9467-27efcf3e3ea9",
                                "text": "De la même manière, la dévaluation du kwanza (une mesure indispensable pour remonétariser l'économie et stabiliser le marché) ne fut pas mise à l'ordre du jour, puisque le taux surévalué du kwanza permet aux détenteurs de monnaies fortes de réaliser de fabuleux profits."
                            }
                        ]
                    }
                ],
