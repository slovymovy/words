                        ],
                        "form": "die Kreiszahl"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "544d2f9c-3f0d-3f0c-8577-0b2542b4d52d",
                        "entry_id": "fbff3538-b824-399b-b41c-fa577e092cf1",
                        "glosses": [
                            "die Zahl π, definiert als das Verhältnis vom Umfang eines Kreises zu seinem Durchmesser, etwa 3,1415…"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3b4ed04-93e4-4aab-a733-e0ad04bc2616",
                                "sense_id": "544d2f9c-3f0d-3f0c-8577-0b2542b4d52d",
                                "text": "Die Kreiszahl ist eindeutig –- das Verhältnis von Umfang zu Durchmesser ist bei jedem Kreis gleich."
                            },
                            {
                                "example_id": "26b86b10-9838-4857-b203-4faf3f9e30d9",
                                "sense_id": "544d2f9c-3f0d-3f0c-8577-0b2542b4d52d",
                                "text": "Archimedes bestimmte für die Kreiszahl einen Wert von etwa 3,14185."
                            },
                            {
                                "example_id": "e0a5a8ed-a3c7-4fda-9eff-6306d00f68f6",
                                "sense_id": "544d2f9c-3f0d-3f0c-8577-0b2542b4d52d",
                                "text": "Mit modernen Computern lassen sich Millionen von Nachkommastellen der Kreiszahl berechnen."
                            },
                            {
                                "example_id": "20f146b3-7a6a-4f7c-bb6a-4e29e600874c",
                                "sense_id": "544d2f9c-3f0d-3f0c-8577-0b2542b4d52d",
                                "text": "„Bislang scheint alles dafür zu sprechen, dass die Kreiszahl Pi tatsächlich eine normale Zahl ist, ebenso übrigens wie die Eulersche Zahl e (=2,7182818…) und die Quadratwurzel aus 2 (=1,4142135…).“"
                            },
                            {
                                "example_id": "82ae4251-193d-470c-8e01-0188ae8d56a7",
                                "sense_id": "544d2f9c-3f0d-3f0c-8577-0b2542b4d52d",
                                "text": "„Und weil im Englischen pi und pie (zu Deutsch: Kuchen) gleich klingen, wird am Pi Day in Laboren, Seminaren und Geek-WGs Selbstgebackenes verzehrt, das mit den ersten Stellen der Kreiszahl verziert ist: 3,14159…“"
                            },
                            {
                                "example_id": "918a9eed-a872-4ac7-bd66-26c362ec292b",
                                "sense_id": "544d2f9c-3f0d-3f0c-8577-0b2542b4d52d",
                                "text": "„Dann tauchten auch so geheimnisvolle Objekte auf wie die Kreiszahl π oder die Euler'sche Zahl e.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
