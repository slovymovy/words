                                        "examples": [
                                            {
                                                "example_id": "8f8fa31d-04ef-47fe-960e-e0f9447815ca",
                                                "sense_id": "859e0c58-1af4-3db2-b45b-98053be44b56",
                                                "text": "„Also geht er in die Tierhandlung und sagt dem Verkäufer, dass er ein ungewöhnliches Haustier haben will.“"
                                            },
                                            {
                                                "example_id": "ebf9ecd8-90b6-4df8-b3f1-5c8a1529fba5",
                                                "sense_id": "859e0c58-1af4-3db2-b45b-98053be44b56",
                                                "text": "„Ein Kunde betritt eine Tierhandlung und fragt nach einem unterhaltsamen Haustier."
                                            },
                                            {
                                                "example_id": "7b7fe702-327e-4326-93a9-2af0a998f7f2",
                                                "sense_id": "859e0c58-1af4-3db2-b45b-98053be44b56",
                                                "text": "„Auf der einen Seite waren Korsetts für ältere, füllige Damen ausgestellt, über die die Blitze zuckten; auf der anderen befand sich ein Aquariengeschäft mit einer Tierhandlung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
