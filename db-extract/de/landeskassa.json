                "senses": [
                    {
                        "sense_id": "42e7b713-cd14-3bee-bd78-6ece55d0f072",
                        "entry_id": "474617ef-279a-33fe-abdd-3220de832456",
                        "glosses": [
                            "symbolisches Behältnis der Mittel eines Landes und die Behörde, welche selbige verwaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1145d04-74dc-403a-860a-6216c4966787",
                                "sense_id": "42e7b713-cd14-3bee-bd78-6ece55d0f072",
                                "text": "„Und mag die Landeskassa noch so leer sein, ein bisserl was geht immer noch: Nach dem nächtlichen Gefeilsche um die Hypo-Rettung zeigte sich Gerhard Dörfler auch in Wien spendabel wie eh und je.“"
                            },
                            {
                                "example_id": "8eca7197-a5f5-4a1c-9210-7ae0fe80d08f",
                                "sense_id": "42e7b713-cd14-3bee-bd78-6ece55d0f072",
                                "text": "„Die Besorgung der Kassageschäfte dieser Anstalt wurde ebenfalls der Landeskassa übertragen.“"
                            },
                            {
                                "example_id": "f376f491-0243-4573-ae78-836761cda6a4",
                                "sense_id": "42e7b713-cd14-3bee-bd78-6ece55d0f072",
                                "text": "„Er eignete sich kurzerhand die mährische Landeskassa mit 100.000 Gulden aus dem Rentamt zu Olmütz an und marschierte damit nach Wien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
