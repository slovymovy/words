                "entry_id": "8bc234de-a2ae-3cbb-bc3f-bbfcfc9adbb7",
                "word": "supergrass",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8f592a3b-247f-4f60-8afe-cc705ae347bc",
                        "entry_id": "8bc234de-a2ae-3cbb-bc3f-bbfcfc9adbb7",
                        "tags": [
                            "plural"
                        ],
                        "form": "supergrasses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "232978de-24d5-31a9-a424-5ff0d832080f",
                        "entry_id": "8bc234de-a2ae-3cbb-bc3f-bbfcfc9adbb7",
                        "glosses": [
                            "An informer providing substantial quantities of information on criminal or terrorist activities to the police."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7da7260e-4cb4-4420-b5f6-ac0620c9ed7a",
                                "sense_id": "232978de-24d5-31a9-a424-5ff0d832080f",
                                "text": "I have to tell the hon. and learned Gentleman that I do not know the facts which led to that decision. On the other hand, although it is an unpleasant fact of life, there are now and again occasions on which, in order to achieve convictions against really bad villains, it is necessary to use people who are termed supergrasses."
                            },
                            {
                                "example_id": "9cb8c6d1-56a8-4fd6-b162-89c0ee27bb35",
                                "sense_id": "232978de-24d5-31a9-a424-5ff0d832080f",
                                "text": "In several cases the supergrass spent days in the witness box giving evidence of scores of offences allegedly committed by many individuals over a period of years."
                            }
                        ]
                    }
                ],
