                ],
                "senses": [
                    {
                        "sense_id": "7627c7d5-b37e-38e2-8779-9b6d88fdd83b",
                        "entry_id": "d6291aa8-c663-31dc-87e2-f0fa95e635a6",
                        "glosses": [
                            "äußerst böse und in keinerlei Hinsicht gutartig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d49feacc-cfe4-4227-90b6-b1237e96831a",
                                "sense_id": "7627c7d5-b37e-38e2-8779-9b6d88fdd83b",
                                "text": "„Es muß vorzeiten böse, erzböse Frauen gegeben haben, die auch den bravsten Mann zur Verzweifelung brachten.“"
                            },
                            {
                                "example_id": "fe80e932-76f0-41a8-b748-ef5c89bc9959",
                                "sense_id": "7627c7d5-b37e-38e2-8779-9b6d88fdd83b",
                                "text": "„Für den erzbösen Feind gibt es kein Pardon und keine Rettung. Er muß hinein ins Fegefeuer der Apokalypse und verbrannt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
