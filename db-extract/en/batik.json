                        "sense_id": "8001d1b0-9038-367a-9ef2-44b37cc3e809",
                        "entry_id": "c48cca41-b21d-307c-830f-d247ca246986",
                        "glosses": [
                            "A wax-resist method of dyeing fabric."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f0f67364-36bb-4ee7-9cba-72688314d73a",
                                "sense_id": "8001d1b0-9038-367a-9ef2-44b37cc3e809",
                                "text": "There were batik dresses in which mingled indigo, orange, green, vermilion, and black; dresses of velvet and chiffon in screaming colors, blood-red, sulphur-yellow, sea-green; and one black and white thing in striking combination."
                            }
                        ]
                    }
                ],
