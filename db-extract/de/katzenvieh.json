                "senses": [
                    {
                        "sense_id": "67510682-e9b1-3d9f-89a6-ad3079fea0df",
                        "entry_id": "6c2757ed-a1ef-38ff-9a37-72942e3eb021",
                        "glosses": [
                            "abfällige Bezeichnung für eine Katze"
                        ],
                        "tags": [
                            "Schimpfwort"
                        ],
                        "examples": [
                            {
                                "example_id": "baee372f-d355-4f84-9e6c-e1ecd2641621",
                                "sense_id": "67510682-e9b1-3d9f-89a6-ad3079fea0df",
                                "text": "„Was meinen Haß gegen das Katzenvieh zweifellos genährt hatte, war eine Entdeckung gewesen, die ich sofort, nachdem ich es zu mir genommen, gemacht hatte – die Entdeckung, daß es, wie die erste Katze, um eins seiner Augen beraubt war.“"
                            },
                            {
                                "example_id": "1c2e3222-8fd8-446f-89ee-e40a281c9566",
                                "sense_id": "67510682-e9b1-3d9f-89a6-ad3079fea0df",
                                "text": "„Sie langsam verrecken lassen vor Hunger? Sie einem Katzenvieh vorwerfen? Nein, verflucht, – vierzehn Jahre war sie mein Kamerad!“"
                            },
                            {
                                "example_id": "f21577e3-b959-47ca-9347-dd8eae06beb2",
                                "sense_id": "67510682-e9b1-3d9f-89a6-ad3079fea0df",
                                "text": "„Aber weißt du, ich habe den Verdacht, das Katzenvieh, dieser einäugige Pirat, hat sich über die Flasche hergemacht, denn soweit ich sehe, rackert er sich damit ab, ein Liebesgedicht an die Hennen zu verfassen, das er ihnen wohl morgen vormaunzen will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
