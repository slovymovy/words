                "forms": [
                    {
                        "form_id": "2795fa5f-2852-413b-9ae5-f4b35aeb5e03",
                        "entry_id": "aa32cd7d-da7d-3879-9ad1-cee2fde435da",
                        "tags": [
                            "plural"
                        ],
                        "form": "homespuns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c68549f-9d1f-3b21-be19-2a192b8e5b66",
                        "entry_id": "aa32cd7d-da7d-3879-9ad1-cee2fde435da",
                        "glosses": [
                            "Sorte de tissu de laine fabriqué à l'origine à domicile, en Écosse, et employé pour la confection de vêtements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49fe8972-4a65-404e-994f-7789862015fa",
                                "sense_id": "4c68549f-9d1f-3b21-be19-2a192b8e5b66",
                                "text": "Dédaigneuse, je ne condescends pas à quitter mes courtes jupes d’homespun, ni les chemisettes chaudes et souples dont les nuances unies, orange vif, rose chinois, vert turquoise, m’embellissent et tachent agréablement les pelouses rouillées."
                            },
                            {
                                "example_id": "8aafddae-c249-4a19-a928-14a16fbadfc5",
                                "sense_id": "4c68549f-9d1f-3b21-be19-2a192b8e5b66",
                                "text": "Du côté du couloir, un Anglais en tenue de golf, homespun granité épinard et terre de Sienne, ouvrit un guide de Karlsbad et ignora le reste du monde."
                            },
                            {
                                "example_id": "186681c1-d04a-427c-abb4-e71166d36829",
                                "sense_id": "4c68549f-9d1f-3b21-be19-2a192b8e5b66",
                                "text": "Un jour, il y avait dix ans, Edmée avait voulu que Pierre se commandât un homespun avec points rouges."
                            },
                            {
                                "example_id": "1ef3b2e7-b8c9-43d3-9ab1-d009eef3b792",
                                "sense_id": "4c68549f-9d1f-3b21-be19-2a192b8e5b66",
                                "text": "Enfin, contre une bouteille vide, un paquet de boîtes d’allumettes et un savon, j’obtiens cinq brasses de cet admirable homespun des montagnes, dont les femmes filent la laine et tissent les manteaux des hommes."
                            }
                        ]
                    }
                ],
