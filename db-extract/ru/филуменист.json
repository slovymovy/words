                        "translation_id": "41792396-4161-4076-8c35-18e6da0ca100",
                        "source_entry_id": "6e1b7b02-7933-3786-b6e2-32f4f45dc8a4",
                        "source_sense_id": "17da2f70-f320-39ab-b42f-28fd9de6f59a",
                        "target_lang_word": "phillumenist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phillumenist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "637af66b-c7b4-30a4-a48a-2029399d2eae",
                                        "entry_id": "b7f12b1b-5efc-34b4-b8ec-6f2e33006843",
                                        "glosses": [
                                            "A person who collects match-related items, like matchbox labels, matchboxes, matchbooks, or matchbook covers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eb12b4a-0457-4622-8a1d-d887dc73f9c3",
                                                "sense_id": "637af66b-c7b4-30a4-a48a-2029399d2eae",
                                                "text": "There is a new and happy breed, the Phillumenists, better known as Match-box Label collectors."
                                            },
                                            {
                                                "example_id": "131ce25f-0920-444e-8a74-91e4bb8f2a2a",
                                                "sense_id": "637af66b-c7b4-30a4-a48a-2029399d2eae",
                                                "text": "To be a real phillumenist, however, requires that one take his assorted books and \"shuck\" them, \"press\" them, and then categorize them according to subject, era, size, and maker."
                                            },
                                            {
                                                "example_id": "a5d02072-a1eb-4790-8b9d-a0d4a511adfd",
                                                "sense_id": "637af66b-c7b4-30a4-a48a-2029399d2eae",
                                                "text": "This matchbox is a Swedish safety match from the Jönköping match factory. It's manufactured in 1858, just in time for the American Civil War. I like it very much. I guess that makes me something of a phillumenist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
