                "senses": [
                    {
                        "sense_id": "bbbf5ac7-7ac3-3402-819d-d1afb6076b1c",
                        "entry_id": "e114c997-c87d-388b-af76-85c8dcb8112d",
                        "glosses": [
                            "Petit insigne le plus souvent métallique qu’on fixe à un vêtement."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "9f786488-a921-42af-b00f-74433514ac50",
                                "sense_id": "bbbf5ac7-7ac3-3402-819d-d1afb6076b1c",
                                "text": "Al Capin’s méritait son nom. Essayer de me vendre, à ce prix, un pin’s de chat ! Parole, en me prenant pour un pigeon, il tombait mal, cet escroc."
                            },
                            {
                                "example_id": "0c0a282d-08f1-4585-a953-2999bf15dfd6",
                                "sense_id": "bbbf5ac7-7ac3-3402-819d-d1afb6076b1c",
                                "text": "Comme à son habitude, Guillaume Pepy arbore un pin’s aux couleurs de la SNCF. Un orange vif « carmillon », un mélange de carmin et de vermillon créé spécialement pour l'entreprise, qui tranche avec le gris anthracite de son costume."
                            },
                            {
                                "example_id": "d4cf32f2-77ee-4f5f-b4d5-2225599186b5",
                                "sense_id": "bbbf5ac7-7ac3-3402-819d-d1afb6076b1c",
                                "text": "L’acteur arbore un pin’s en lien avec le mouvement “Don’t Look Up”, lancé au milieu du film. La journaliste lui fait remarquer que son badge ne ressemble à aucun autre, puisqu’il est composé d’une flèche pointée vers le haut et une autre pointée vers le bas."
                            }
                        ]
                    }
