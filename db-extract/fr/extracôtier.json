                        "entry_id": "3835f009-32f6-3a13-91aa-e3d371ee70bf",
                        "glosses": [
                            "Au large de la côte, en mer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54db0602-4d1e-4bd9-ab88-a1567fbc3a58",
                                "sense_id": "d946fa5c-3769-3de0-90a9-e47909aa264e",
                                "text": "La société norvégienne Equinor saura bientôt si son projet d’exploitation pétrolière extracôtier, nommé Bay du Nord, sera approuvé par le gouvernement fédéral."
                            },
                            {
                                "example_id": "d4e6d0e1-312c-497c-9c9f-fb6c0c9be6b4",
                                "sense_id": "d946fa5c-3769-3de0-90a9-e47909aa264e",
                                "text": "La Marine royale canadienne (MRC) reçoit actuellement le navire de patrouille extracôtier et de l’Arctique (NPEA) de classe Harry DeWolf, sa première plateforme conçue pour les opérations dans l’Arctique de son histoire."
                            }
                        ]
