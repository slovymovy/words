{
    "word_family": [
        "consolidation",
        "consolidator",
        "consolidative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a8c7af8-f51f-30f1-9970-5ba0c88519fe",
                    "sense_definition": "To make a position of power or success stronger and more likely to continue.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "strengthen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new prime minister took several steps to <w>consolidate</w> his power within the party.",
                            "target_lang_translations": {
                                "ru": "Новый премьер-министр предпринял несколько шагов, чтобы <w>укрепить</w> свою власть внутри партии."
                            }
                        },
                        {
                            "text": "After winning the first set, the tennis player worked hard to <w>consolidate</w> her lead.",
                            "target_lang_translations": {
                                "ru": "Выиграв первый сет, теннисистка приложила все усилия, чтобы <w>закрепить</w> свое преимущество."
                            }
                        }
                    ],
                    "synonyms": [
                        "strengthen",
                        "secure",
                        "solidify",
                        "reinforce"
                    ],
                    "antonyms": [
                        "weaken",
                        "undermine"
                    ],
                    "common_phrases": [
                        "consolidate power",
                        "consolidate a lead",
                        "consolidate gains"
                    ],
                    "target_lang_definitions": {
                        "ru": "Укреплять положение власти или успеха, делая его более стабильным и долгосрочным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрепить",
                                "target_lang_sense_clarification": "сделать позицию или успех более прочными"
                            },
                            {
                                "target_lang_word": "закрепить",
                                "target_lang_sense_clarification": "зафиксировать достигнутый результат"
                            },
                            {
                                "target_lang_word": "консолидировать",
                                "target_lang_sense_clarification": "сплотить или упрочить (часто о власти)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64da0f9b-e895-3169-a479-509579101f7d",
                    "sense_definition": "To combine several things into a single, more effective or coherent whole.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "combine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>consolidate</w> its various departments into one central office.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>объединить</w> свои различные отделы в одном центральном офисе."
                            }
                        },
                        {
                            "text": "He managed to <w>consolidate</w> luggage from three small bags into one large suitcase.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>собрать</w> багаж из трех маленьких сумок в один большой чемодан."
                            }
                        }
                    ],
                    "synonyms": [
                        "combine",
                        "merge",
                        "unite",
                        "amalgamate",
                        "integrate"
                    ],
                    "antonyms": [
                        "separate",
                        "divide",
                        "split"
                    ],
                    "common_phrases": [
                        "consolidate departments",
                        "consolidate resources",
                        "consolidate information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединять несколько элементов в единое, более эффективное или целостное целое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединить",
                                "target_lang_sense_clarification": "собрать части в единое целое"
                            },
                            {
                                "target_lang_word": "сгруппировать",
                                "target_lang_sense_clarification": "собрать вместе для удобства"
                            },
                            {
                                "target_lang_word": "укрупнить",
                                "target_lang_sense_clarification": "сделать более масштабным за счет слияния"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d131d037-bbc6-36bc-91bd-5bd79c510aac",
                    "sense_definition": "To replace several separate debts with a single loan, often with a lower interest rate.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is often easier to <w>consolidate</w> debt into one monthly payment to manage finances better.",
                            "target_lang_translations": {
                                "ru": "Часто проще <w>консолидировать</w> задолженность в один ежемесячный платеж, чтобы лучше управлять финансами."
                            }
                        },
                        {
                            "text": "The bank offered a plan to <w>consolidate</w> student loans into a single manageable package.",
                            "target_lang_translations": {
                                "ru": "Банк предложил план по <w>объединению</w> студенческих кредитов в единый удобный пакет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "consolidate debt",
                        "consolidate loans"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business and finance context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заменять несколько отдельных долгов одним кредитом, часто с более низкой процентной ставкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рефинансировать",
                                "target_lang_sense_clarification": "объединить долги для улучшения условий"
                            },
                            {
                                "target_lang_word": "консолидировать",
                                "target_lang_sense_clarification": "объединить несколько кредитов в один"
                            },
                            {
                                "target_lang_word": "объединить",
                                "target_lang_sense_clarification": "собрать задолженности в один платеж"
                            }
                        ]
                    }
                }
            ]
        },
        {
