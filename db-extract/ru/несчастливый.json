                ],
                "senses": [
                    {
                        "sense_id": "db99ee28-6ef4-3418-b5ff-5d17604436e7",
                        "entry_id": "76b184c2-a237-31cc-90d4-380a4b81fba5",
                        "glosses": [
                            "не обладающий счастьем, удачей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aa30bd5-2265-4981-bd9f-331175409e55",
                                "sense_id": "db99ee28-6ef4-3418-b5ff-5d17604436e7",
                                "text": "Все счастливые семьи похожи друг на друга, каждая несчастливая семья несчастлива по-своему."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60a46560-5b38-4222-a151-fb0900f58692",
                        "source_entry_id": "76b184c2-a237-31cc-90d4-380a4b81fba5",
                        "source_sense_id": "db99ee28-6ef4-3418-b5ff-5d17604436e7",
                        "target_lang_word": "unhappy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unhappy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e54d1644-b449-3db5-b67a-143c12133c4b",
                                        "entry_id": "562aa1af-d5c4-3d1f-8318-2e9a059977b9",
                                        "glosses": [
                                            "Not happy; sad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b480d52-5db8-4f20-8bcb-102ab3a55464",
                                                "sense_id": "e54d1644-b449-3db5-b67a-143c12133c4b",
                                                "text": "I am unhappy."
                                            },
                                            {
                                                "example_id": "65a91464-bbc1-49c0-991f-188d053eea53",
                                                "sense_id": "e54d1644-b449-3db5-b67a-143c12133c4b",
                                                "text": "A moment of time may make us unhappy forever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67e0019e-ee67-30b7-8567-4d2a4b8849d6",
                                        "entry_id": "562aa1af-d5c4-3d1f-8318-2e9a059977b9",
                                        "glosses": [
                                            "Not satisfied; unsatisfied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea57c31b-ceb0-4988-9f74-5d1cc41f7593",
                                                "sense_id": "67e0019e-ee67-30b7-8567-4d2a4b8849d6",
                                                "text": "An unhappy customer is unlikely to return to your shop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92eed8fa-4462-3995-86dd-34bb63f9f5c9",
                                        "entry_id": "562aa1af-d5c4-3d1f-8318-2e9a059977b9",
                                        "glosses": [
                                            "Not lucky; unlucky."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be757073-ef16-4bae-bdfc-19e421d2089a",
                                                "sense_id": "92eed8fa-4462-3995-86dd-34bb63f9f5c9",
                                                "text": "The doomed lovers must have been born under an unhappy star."
                                            },
                                            {
                                                "example_id": "eb4893c8-6da3-4a2a-9fb3-43cf400b820c",
                                                "sense_id": "92eed8fa-4462-3995-86dd-34bb63f9f5c9",
                                                "text": "The pointed shaft of the cart had entered the breast of the unhappy Prince like a sword, and from the wound his life's blood was spouting in a stream, and falling with a hiss into the road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da4ab044-3f3a-3273-b907-ad4d5cb4fab6",
                                        "entry_id": "562aa1af-d5c4-3d1f-8318-2e9a059977b9",
                                        "glosses": [
                                            "Not suitable; unsuitable."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce2bd7bb-614a-4196-9d6e-3bd420959837",
                                                "sense_id": "da4ab044-3f3a-3273-b907-ad4d5cb4fab6",
                                                "text": "The people, if they are not strangely bent\nAgainst our welfare, never will consent\nTo this unhappy match, foreboding ill:\nWhat's it to us, if th' adverse nation will?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unhappy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36dc1c18-55bf-3c01-b0d6-d8537afd655d",
                                        "entry_id": "e0e9061b-3b40-3a84-affe-2bc069344423",
                                        "glosses": [
                                            "A person who is not happy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb08dd08-a3cb-4b82-af8d-c84c15ffb74c",
                                                "sense_id": "36dc1c18-55bf-3c01-b0d6-d8537afd655d",
                                                "text": "Leduc, as is true of many other unhappies, is largely a confessional writer: her subject is herself, and her gift is a driving, vivacious power that turns her incurable, inveterate unhappiness into a series of dramas […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unhappy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd70544-d3db-339f-9a60-0cf5178bcbc4",
                                        "entry_id": "5acfbe9e-bfed-3955-a0de-3c2ef7b80f2b",
                                        "glosses": [
                                            "To make or become unhappy; to sadden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b201926-2ed1-451e-9596-bfe846e4ca13",
                                                "sense_id": "1fd70544-d3db-339f-9a60-0cf5178bcbc4",
                                                "text": "A happy gentleman in blood and lineaments,\nBy you unhappied and disfigured clean"
                                            },
                                            {
                                                "example_id": "fbc767dc-f8b5-4841-93b6-5803df5f0a21",
                                                "sense_id": "1fd70544-d3db-339f-9a60-0cf5178bcbc4",
                                                "text": "In the greate desire I have unto your grace's service, nothing has more unhappied me than the wante of opportunitie in which I might expresse the character of my harte that onlie takes of your impressions."
                                            },
                                            {
                                                "example_id": "d89287f2-adce-43cf-80b6-8b1ff8e72544",
                                                "sense_id": "1fd70544-d3db-339f-9a60-0cf5178bcbc4",
                                                "text": "They unhappied their estates by sinning against God, and of glorious Angels became unclean devils: there is not part of the work of Gods hands so eternally cast away, reserved in chains of darknesse for the judgement of the last day."
                                            },
                                            {
                                                "example_id": "f02d6685-a34e-47de-b760-e1bfa318e230",
                                                "sense_id": "1fd70544-d3db-339f-9a60-0cf5178bcbc4",
                                                "text": "Nor do these unhappying beings, after they become the property of Europeans (from whom as a more civilized people, more humanity might naturally be expected), find their situation in the least amended."
                                            },
                                            {
                                                "example_id": "bfd3a6b0-3b72-428d-a111-9b75a4bc4eef",
                                                "sense_id": "1fd70544-d3db-339f-9a60-0cf5178bcbc4",
                                                "text": "Most unhappying! I had to get up, have a nice hot bath and then go out into the cold rain to Ted's for breakfast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
