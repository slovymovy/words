                "senses": [
                    {
                        "sense_id": "db279c56-9923-3f72-8b4f-a0ff34dc1d3b",
                        "entry_id": "bc2dcd37-3bbc-3d43-a55d-c50ef02f4734",
                        "glosses": [
                            "Stuhl, der im Büro als Sitzgelegenheit während der Arbeit dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9609fa5c-4027-4402-b0b8-963f12e972d6",
                                "sense_id": "db279c56-9923-3f72-8b4f-a0ff34dc1d3b",
                                "text": "Unsere Bürostühle sind alt und klapprig, aber der Chef möchte kein Geld für neue ausgeben."
                            },
                            {
                                "example_id": "0729aec0-71e8-4aaa-9407-c96e65ae1b39",
                                "sense_id": "db279c56-9923-3f72-8b4f-a0ff34dc1d3b",
                                "text": "„Alles das ließ Tom Revue passieren, als er sich mit einem tiefen Seufzer nach hinten in seinen Bürostuhl fallen ließ.“"
                            },
                            {
                                "example_id": "661d51ca-69a3-4b80-a60e-3f99a56db6f9",
                                "sense_id": "db279c56-9923-3f72-8b4f-a0ff34dc1d3b",
                                "text": "„Über der hohen Lehne des Bürostuhls leuchtete im Halbdunkel ihr helles Haar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
