                                "target_lang_sense_clarification": "буйство стихии"
                            },
                            {
                                "target_lang_word": "ярость",
                                "target_lang_sense_clarification": "сильная эмоция или интенсивность"
                            },
                            {
                                "target_lang_word": "сила",
                                "target_lang_sense_clarification": "мощь воздействия"
                            }
                        ],
                        "zh": [
                            {
