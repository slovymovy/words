                "senses": [
                    {
                        "sense_id": "c51172b8-b495-3c62-8194-fe27e84bf71f",
                        "entry_id": "8ecf4312-5db7-392c-80cb-638a6ff56565",
                        "glosses": [
                            "Of or pertaining to pitch (“a sticky, dark brown substance obtained from distilling turpentine or wood tar, or crude oil or tar”); having a quality like pitch."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4f481549-2708-428e-baed-164185991e29",
                                "sense_id": "c51172b8-b495-3c62-8194-fe27e84bf71f",
                                "text": "I do not therefore require of you to believe, that the ancient rocks and compact bodies were diſſolved, but that many new ones were formed by the deluge, which had incloſed the ſpoils of the ſea within them. […] What other rational account will you give of that ſhell of a nautilus, which was found buried in a ſtratum of a piceous ſubstance below the bed of the river Arbis, where Artaxerxes commanded a bridge to be built over it?"
                            }
                        ]
                    },
                    {
                        "sense_id": "055d287f-b6bb-383c-80ad-d65e014f40f6",
                        "entry_id": "8ecf4312-5db7-392c-80cb-638a6ff56565",
                        "glosses": [
                            "Resembling pitch in colour; a very dark brown."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b091d3c-68cb-4f7b-92e8-8631eea8918c",
                                "sense_id": "055d287f-b6bb-383c-80ad-d65e014f40f6",
                                "text": "Piciroſtris. Oblong, black: ſilvery-ſilky: ſnout half way and legs piceous."
                            },
                            {
                                "example_id": "91d0af7a-58a6-4073-a104-ed02fdf498d4",
                                "sense_id": "055d287f-b6bb-383c-80ad-d65e014f40f6",
                                "text": "The colour of the upper part is a mixture of yellowish-white and piceous disposed in dots, exactly resembling mosaic work, […]"
                            },
                            {
                                "example_id": "f8d384de-6220-4d07-9195-3c5d4a7474cb",
                                "sense_id": "055d287f-b6bb-383c-80ad-d65e014f40f6",
                                "text": "Abdomen with shining cinereous tomentum, and with five lines of piceous spots; […] Tibiæ piceous towards the tips; tarsi piceous."
                            },
                            {
                                "example_id": "ca671f07-6964-4402-9449-e40200a33b93",
                                "sense_id": "055d287f-b6bb-383c-80ad-d65e014f40f6",
                                "text": "Front and middle legs yellow, coxae black behind, femora piceous posteriorly; […]"
                            },
                            {
                                "example_id": "10602ebc-08e4-485b-af2b-0b34a29c733e",
                                "sense_id": "055d287f-b6bb-383c-80ad-d65e014f40f6",
                                "text": "Agabus elongatus […] Legs rufous; metafemur piceous."
                            },
                            {
                                "example_id": "e891e649-6210-4e58-8263-d58c95a0ffff",
                                "sense_id": "055d287f-b6bb-383c-80ad-d65e014f40f6",
                                "text": "From the year of its establishment, darkness seemed to have found a home in Beet College. Dark pink for the brick buildings, dark green for the doorjambs and the benches, dark iron for the hinges, dark stone for Nathaniel's Tomb; darkness in the piceous roots of trees that broke through the earth like bones through skin."
                            },
                            {
                                "example_id": "2f64f2f7-b98d-4afd-84d8-bc42576a6d74",
                                "sense_id": "055d287f-b6bb-383c-80ad-d65e014f40f6",
                                "text": "Gyrophaenia uteana Casey […] [H]ead piceous, pronotum dark rufo-testaceous to piceous; elytra reddish-brown with sutural region and posterior angles piceous, abdomen yellowish- or reddish-brown, apical portion often darker, piceous; […]"
                            }
                        ]
                    }
