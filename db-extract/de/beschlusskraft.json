                        "sense_id": "75170f56-7c6d-3130-ac2f-d94289e2fc3b",
                        "entry_id": "bbeb0efa-b530-3fa1-9bc8-ac806668f981",
                        "glosses": [
                            "Befugnis, Möglichkeit, Entscheidungen zu treffen, Beschlüsse zu fassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2ff5a7d-0f28-48dc-a026-38dfe93bd840",
                                "sense_id": "75170f56-7c6d-3130-ac2f-d94289e2fc3b",
                                "text": "„Die Versammlung des Volkes hatte Beschlusskraft über alle ihr vorgelegten Anträge: Krieg und Frieden, Gesetze, Verträge.“"
                            },
                            {
                                "example_id": "357a98e2-3b03-4cc4-89bf-e117c31ac243",
                                "sense_id": "75170f56-7c6d-3130-ac2f-d94289e2fc3b",
                                "text": "„Ohne die eigene Beschlusskraft können wir keine Ziele finden und umsetzen.“"
                            },
                            {
                                "example_id": "24a3125e-57dc-4d94-bb2f-a8b9e0cd0ca1",
                                "sense_id": "75170f56-7c6d-3130-ac2f-d94289e2fc3b",
                                "text": "„Effektiv wird aber ein Unternehmen durch hohes Vertrauen in die Beschlusskraft der einzelnen Kreise.“"
                            },
                            {
                                "example_id": "8d9ac3ad-f775-4853-b7d4-fc5276d99aa6",
                                "sense_id": "75170f56-7c6d-3130-ac2f-d94289e2fc3b",
                                "text": "„Freiheit meine nichts anderes als die Beschlusskraft des Staates, welche in seinem System nur der Repräsentation des Volkes zukomme.“"
                            },
                            {
                                "example_id": "0366e2c7-dde0-4a1d-a5b9-413ad46daa44",
                                "sense_id": "75170f56-7c6d-3130-ac2f-d94289e2fc3b",
                                "text": "„Baden-Württemberg und Saarland gestanden dem Gremium zwar Beschlusskraft bei Zielvereinbarungen und Entwicklungsplänen zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
