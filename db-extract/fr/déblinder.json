                "senses": [
                    {
                        "sense_id": "1df98e8b-002f-3a33-a265-e7e5e88e6716",
                        "entry_id": "81ea0073-4166-3c6f-a251-2935adb4dde2",
                        "glosses": [
                            "Faire perdre son caractère blindé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f24df165-c6b6-4f80-8c90-bf3559746441",
                                "sense_id": "1df98e8b-002f-3a33-a265-e7e5e88e6716",
                                "text": "Peu m'importait ; j'avais retrouvé assez de force et de courage pour ne me laisser déblinder par quiconque."
                            },
                            {
                                "example_id": "7755294e-51ae-440d-b0c5-e75668496bd9",
                                "sense_id": "1df98e8b-002f-3a33-a265-e7e5e88e6716",
                                "text": "Malgré le secret qu'on essaya de garder, et le mystère avec lequel furent conduits les travaux qui s'exécutaient autour du vaisseau pour le déblinder cl le réarmer, les insurgés furent avertis qu'il appareillerait au premier jour."
                            },
                            {
                                "example_id": "25d5a074-d3a7-4fc0-ba96-ae1b860dc5be",
                                "sense_id": "1df98e8b-002f-3a33-a265-e7e5e88e6716",
                                "text": "Et bien sûr c'est le devoir de l'homme en évolution consciente, de se « déblinder » mentalement, mais comment faire quand il n'en a pas conscience pour cause de conscience trop mentalisée donc bloquée sur elle-même ?"
                            }
                        ]
                    }
