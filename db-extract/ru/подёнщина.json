                ],
                "senses": [
                    {
                        "sense_id": "e5b1708b-25e4-38f6-98b6-b940d637221b",
                        "entry_id": "9ada7204-b83d-3b52-a384-ae4b98d54bb1",
                        "glosses": [
                            "подённая работа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d35908af-8794-4aa7-b0cb-efea1cbbea18",
                                "sense_id": "e5b1708b-25e4-38f6-98b6-b940d637221b",
                                "text": "Он учил детей своего прихода читать и писать и этой подёнщиной едва снискивал себе пропитание."
                            },
                            {
                                "example_id": "af089bb1-f8cc-4260-bff3-8e4eeccb875e",
                                "sense_id": "e5b1708b-25e4-38f6-98b6-b940d637221b",
                                "text": "На пятерых в день намывали до двух золотников золота, что составляло подёнщину рубля в полтора."
                            },
                            {
                                "example_id": "2dbba71d-1011-41d4-b2cd-d1941f7635b8",
                                "sense_id": "e5b1708b-25e4-38f6-98b6-b940d637221b",
                                "text": "Узнавалась жизнь Шихана через женщин, ходивших на подёнщину: полоть огороды, мыть полы в городских учреждениях, продавать ягоды и грибы на базаре и по домам."
                            }
                        ]
                    },
                    {
                        "sense_id": "561acd2e-2e58-3419-b79f-9dd64bcd2c83",
                        "entry_id": "9ada7204-b83d-3b52-a384-ae4b98d54bb1",
                        "glosses": [
                            "перен., неодобр. рутинная, не творческая работа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89455833-6038-49d5-a30c-9cdfa7aa1ba5",
                                "sense_id": "561acd2e-2e58-3419-b79f-9dd64bcd2c83",
                                "text": "А желания такого не испытываем; какая-то обязанность, какая-то подёнщина в этом, а жажды нету."
                            },
                            {
                                "example_id": "bc85e5cb-59fd-4d7b-bbbb-0ba006353456",
                                "sense_id": "561acd2e-2e58-3419-b79f-9dd64bcd2c83",
                                "text": "Мне бы только оклематься маленько, с текучкой разделаться и пописать, в охотку пописать, не подёнщину бы эту треклятую тянуть."
                            }
                        ]
                    }
                ],
