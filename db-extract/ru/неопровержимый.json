                                            "taki, którego nie da się podważyć"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0416eb92-7303-4626-b9eb-b5a74367b716",
                                                "sense_id": "20fa0bb1-1d73-3c8b-89b1-7fca14f5a4d9",
                                                "text": "Wtedy, choć z pozoru sytuacja wydawała się ewidentna, opozycja miała kłopoty z dostarczeniem do sądu niepodważalnych dowodów"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
