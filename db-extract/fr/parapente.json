            {
                "entry_id": "fc54ce91-0977-39db-9a37-504eb8eb9332",
                "word": "parapente",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "206571bf-d8e9-40da-a929-b8d63dbc25d9",
                        "entry_id": "fc54ce91-0977-39db-9a37-504eb8eb9332",
                        "tags": [
                            "plural"
                        ],
                        "form": "parapentes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b59b0b0-d7e8-37e3-a3e7-006f33f63c38",
                        "entry_id": "fc54ce91-0977-39db-9a37-504eb8eb9332",
                        "glosses": [
                            "Aéronef en forme de parachute en plus allongé, auquel est attaché un siège appelé sellette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d1c5cf3-aec3-4cdd-80a2-914bce194ab1",
                                "sense_id": "2b59b0b0-d7e8-37e3-a3e7-006f33f63c38",
                                "text": "Le parapente a bien failli partir en décrochage quand son pilote a trop tiré sur les freins."
                            },
                            {
                                "example_id": "e96ada29-edaa-419b-a851-b23987be5bbc",
                                "sense_id": "2b59b0b0-d7e8-37e3-a3e7-006f33f63c38",
                                "text": "Il replie son parapente et le range dans son sac."
                            },
                            {
                                "example_id": "41e61025-daa6-44ce-8ffd-f54445d440c3",
                                "sense_id": "2b59b0b0-d7e8-37e3-a3e7-006f33f63c38",
                                "text": "Dans ce cas le constructeur n’a que le choix d’agir sur l’instabilité de l’aile s’il ne veut pas avoir un parapente impossible à faire tourner."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2901274-863a-3de4-81f4-0f31bac8310f",
                        "entry_id": "fc54ce91-0977-39db-9a37-504eb8eb9332",
                        "glosses": [
                            "Sport de vol libre utilisant un parapente, parapentisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f348e22-ac53-4fd0-8d94-38228b9be0d5",
                                "sense_id": "f2901274-863a-3de4-81f4-0f31bac8310f",
                                "text": "Elle fait du parapente tous les samedis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b2fddc6-ddbc-46e2-b7c8-1165e26e3ffe",
                        "source_entry_id": "fc54ce91-0977-39db-9a37-504eb8eb9332",
                        "source_sense_id": "2b59b0b0-d7e8-37e3-a3e7-006f33f63c38",
                        "source_sense_description": "Aéronef en forme de parachute en plus allongé, auquel est attaché un siège appelé sellette.",
                        "target_lang_word": "Gleitschirm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gleitschirm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8150353-9e3a-33dc-a016-5bf285ba7c1a",
                                        "entry_id": "37d7c799-21c4-3abc-9d35-4556582cca0c",
                                        "glosses": [
                                            "spezielles, zum Fliegen gebautes und genutztes Luftsportgerät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a344100-2262-4fa7-bff8-147646fa33d8",
                                                "sense_id": "c8150353-9e3a-33dc-a016-5bf285ba7c1a",
                                                "text": "„Der Hängegleiter wird auch als Drachen, das Gleitsegel auch als Gleitschirm oder Paragleiter bezeichnet.“"
                                            },
                                            {
                                                "example_id": "573313dc-98a7-43f2-b7c6-4628dcd1e267",
                                                "sense_id": "c8150353-9e3a-33dc-a016-5bf285ba7c1a",
                                                "text": "Ein Gleitschirm besteht aus nicht viel mehr als Obersegel und Untersegel mit Profilrippen, Zugbändern und den Tragegurten."
                                            },
                                            {
                                                "example_id": "be4edf45-fc72-4e64-b13e-b7deadca07a1",
                                                "sense_id": "c8150353-9e3a-33dc-a016-5bf285ba7c1a",
                                                "text": "„Deltafliegen, die ursprüngliche Art des Hängegleitens, ist mit dem Aufkommen des Gleitschirmes etwas in Vergessenheit geraten.“"
                                            },
                                            {
                                                "example_id": "795c7376-5212-40f0-8fe1-e45af2a30b1f",
                                                "sense_id": "c8150353-9e3a-33dc-a016-5bf285ba7c1a",
                                                "text": "„Der Gleitschirmflieger spielt mit den technischen Möglichkeiten seines Fluggeräts und mit seinen Fertigkeiten: […] Er spielt mit den Leinen, den Bremsen, den Kräften des Windes in seinem Gleitschirm.“"
                                            },
                                            {
                                                "example_id": "c1543727-1ff0-44cc-8d26-f42f2428405b",
                                                "sense_id": "c8150353-9e3a-33dc-a016-5bf285ba7c1a",
                                                "text": "„Beim gemeinsamen Kreisen in der Thermik mit den ständigen Abstandsänderungen der Gleitschirme zueinander gilt in besonderem Maße Sehen und Gesehenwerden, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
