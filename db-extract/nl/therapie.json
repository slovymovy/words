                "senses": [
                    {
                        "sense_id": "02493c1d-7c07-3fbc-a2c3-571221177937",
                        "entry_id": "824dd59f-b912-3991-be03-d4fd64eaa085",
                        "glosses": [
                            "een methode om aan de genezing van zieken te werken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39a15011-a417-4dd7-8a05-094bfc697a42",
                                "sense_id": "02493c1d-7c07-3fbc-a2c3-571221177937",
                                "text": "Hij krijgt drie dagen per week therapie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf3dff9c-1c1d-41d1-a2ac-fd1a4c50cc76",
                        "source_entry_id": "824dd59f-b912-3991-be03-d4fd64eaa085",
                        "source_sense_id": "02493c1d-7c07-3fbc-a2c3-571221177937",
                        "source_sense_description": "een methode om aan de genezing van zieken te werken",
                        "target_lang_word": "Therapie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Therapie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26be1fb6-c124-3918-9456-7579f97ece2e",
                                        "entry_id": "e0759f07-3bf4-3f04-9812-db64c62b6f39",
                                        "glosses": [
                                            "Gesamtheit der Maßnahmen zur Behandlung einer Krankheit"
                                        ],
                                        "tags": [
                                            "Humanmedizin",
                                            "Veterinärmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e65ba4d3-3e74-4c52-9981-769b25741b94",
                                                "sense_id": "26be1fb6-c124-3918-9456-7579f97ece2e",
                                                "text": "Bei manchen Erkrankungen sind verschiedene Therapien möglich."
                                            },
                                            {
                                                "example_id": "be0da77f-b568-412a-868c-302ebd356beb",
                                                "sense_id": "26be1fb6-c124-3918-9456-7579f97ece2e",
                                                "text": "„Morgen würde ein anstrengender Tag werden, denn morgen würden die Therapien beginnen.“"
                                            },
                                            {
                                                "example_id": "2b1bc5e7-2bbe-4667-a480-e7be10273530",
                                                "sense_id": "26be1fb6-c124-3918-9456-7579f97ece2e",
                                                "text": "„Die Überlebensrate nach der neuen Therapie liegt durchweg über derjenigen der Standardbehandlung.“"
                                            },
                                            {
                                                "example_id": "64490d18-48b8-4ad5-a4c4-cf412adc9776",
                                                "sense_id": "26be1fb6-c124-3918-9456-7579f97ece2e",
                                                "text": "„Die frühzeitige Erkennung von Tumoren oder von Erkrankungen wie Alzheimer oder Parkinson hat für die Therapie eine sehr große Bedeutung.“"
                                            },
                                            {
                                                "example_id": "a90c4e25-efb3-44e8-8265-783c8e66971f",
                                                "sense_id": "26be1fb6-c124-3918-9456-7579f97ece2e",
                                                "text": "„Das soll sogar Teil meiner Therapie sein, nicht das Saufen, sondern das darüber Reden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1aefbd34-e5a4-4422-811c-13e8132f527b",
                        "source_entry_id": "824dd59f-b912-3991-be03-d4fd64eaa085",
                        "source_sense_id": "02493c1d-7c07-3fbc-a2c3-571221177937",
                        "source_sense_description": "een methode om aan de genezing van zieken te werken",
                        "target_lang_word": "therapy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "therapy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d5b0123-3135-315c-aa5e-6e87b6220146",
                                        "entry_id": "3b5bdf7e-31c9-3511-9c10-88602276e8ca",
                                        "glosses": [
                                            "Attempted remediation of a health problem following a diagnosis, usually synonymous with treatment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8aa502b-d1b7-4ae9-95b8-56b343283295",
                                                "sense_id": "5d5b0123-3135-315c-aa5e-6e87b6220146",
                                                "text": "inclined bed therapy"
                                            },
                                            {
                                                "example_id": "d20e5975-244d-4389-8b76-621d5f275c15",
                                                "sense_id": "5d5b0123-3135-315c-aa5e-6e87b6220146",
                                                "text": "It will be seen that we are introducing to our readers the subject of Kinesitherapy, in common with other therapies, and it is very proper that we should do so."
                                            },
                                            {
                                                "example_id": "55bafd00-5a44-4ff9-96f0-9fa3602cc1d2",
                                                "sense_id": "5d5b0123-3135-315c-aa5e-6e87b6220146",
                                                "text": "[…] second, its formidable features prompt the average physician at an early period to consult the dermatologist respecting its nature and therapy […]"
                                            },
                                            {
                                                "example_id": "b9701c68-009a-4a4d-b7c0-34aa459cf5d1",
                                                "sense_id": "5d5b0123-3135-315c-aa5e-6e87b6220146",
                                                "text": "Lahmann's unprecedented success proved beyond doubt the correctness of his teachings and the fallacy of the germ theory of disease, vaccinations and serum therapy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d0148ab-6bfc-3e19-a36b-c53e05795470",
                                        "entry_id": "3b5bdf7e-31c9-3511-9c10-88602276e8ca",
                                        "glosses": [
                                            "Attempted remediation of a health problem following a diagnosis, usually synonymous with treatment.",
                                            "Specifically, psychotherapy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "057b96b1-dd1a-475c-add8-b192ab74dd0c",
                                                "sense_id": "8d0148ab-6bfc-3e19-a36b-c53e05795470",
                                                "text": "As a methodology, it provides a useful framework for evaluating the outcomes of therapy."
                                            },
                                            {
                                                "example_id": "f6627b52-e3b4-4681-ac33-359a483388f6",
                                                "sense_id": "8d0148ab-6bfc-3e19-a36b-c53e05795470",
                                                "text": "The existential approach to therapy is philosophical, involving exploration of what it means to be alive."
                                            },
                                            {
                                                "example_id": "512c40bc-938a-4c26-9af2-0175b6af3b6f",
                                                "sense_id": "8d0148ab-6bfc-3e19-a36b-c53e05795470",
                                                "text": "Because it is often confused with psychoanalysis, psychodynamics has at times been considered an outdated and outmoded approach to therapy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27fd5abc-f5ed-3594-841d-525b548d3428",
                                        "entry_id": "3b5bdf7e-31c9-3511-9c10-88602276e8ca",
                                        "glosses": [
                                            "Healing power or quality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "therapy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2ce0c1f-3879-3ec6-abb4-7c31c495add0",
                                        "entry_id": "4c328c32-be3e-3a29-852a-dc00bd729e06",
                                        "glosses": [
                                            "To treat with a therapy."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2126322e-5610-4131-8cbc-ccd31e9744e5",
                                                "sense_id": "f2ce0c1f-3879-3ec6-abb4-7c31c495add0",
                                                "text": "As is the case for therapying ectopic ACTH production, very high serum cortisol levels necessitate adrenolytic therapy with o,p'DDD (mitotane), metopirone, or aminogluthetimide."
                                            },
                                            {
                                                "example_id": "0c93673b-b98c-4888-bcce-79345bdc8fb7",
                                                "sense_id": "f2ce0c1f-3879-3ec6-abb4-7c31c495add0",
                                                "text": "There was no cytogenetic damage to the therapied or non-therapied regions in the buccal mucosa cells, as determined cytomorphologically."
                                            },
                                            {
                                                "example_id": "ac468252-1799-4ca2-8d84-12cbe05d9b53",
                                                "sense_id": "f2ce0c1f-3879-3ec6-abb4-7c31c495add0",
                                                "text": "I was therapying her for some gene-based subroutine screwups that prevented easeful sexuality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff4fb89b-c000-3c3c-bae7-4f0318c47bc4",
                                        "entry_id": "4c328c32-be3e-3a29-852a-dc00bd729e06",
                                        "glosses": [
                                            "To undergo a therapy."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a151857e-cecb-4709-b2fa-e9af674b020e",
                                                "sense_id": "ff4fb89b-c000-3c3c-bae7-4f0318c47bc4",
                                                "text": "Therapy has almost eliminated violence, and people are divided into groups — the \"therapied\" and the \"un-therapied.\""
                                            },
                                            {
                                                "example_id": "deb7a5b4-7be0-4884-bebf-92a9a49a79de",
                                                "sense_id": "ff4fb89b-c000-3c3c-bae7-4f0318c47bc4",
                                                "text": "After a few years of talking about musicking, healthing, therapying, and so forth, most of us will have enough, I assume, and will not necessarily be in a new place."
                                            },
                                            {
                                                "example_id": "2719910a-8ab6-40c5-83e0-586cac86b917",
                                                "sense_id": "ff4fb89b-c000-3c3c-bae7-4f0318c47bc4",
                                                "text": "In the mail were: $9 in orders for Eating at Arby's; a delightful New Wave story by Susan Mernit, who's finishing one novel and working on the next, all while adjuncting, therapying, and getting ready to divorce Spencer (though she doesn't know that yet); The Village Voice; a BC Alumni Association Board of Directors notice; and a xerox of a review of George's Modern Times."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d68e6d80-ce5f-4ede-991a-374e9a3f3011",
                        "source_entry_id": "824dd59f-b912-3991-be03-d4fd64eaa085",
                        "source_sense_id": "02493c1d-7c07-3fbc-a2c3-571221177937",
                        "source_sense_description": "een methode om aan de genezing van zieken te werken",
                        "target_lang_word": "treatment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treatment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5170d31-c668-3df7-bc4e-f2fa60d4ccce",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "The process or manner of treating someone or something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd3d4cb6-5ca9-4204-9ecf-e3216ac4a734",
                                                "sense_id": "a5170d31-c668-3df7-bc4e-f2fa60d4ccce",
                                                "text": "He still has nightmares resulting from the abusive treatment he received from his captors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61a6615a-5d22-34d5-95a7-9f3c53ebf739",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "Medical care for an illness or injury."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89f4b971-68cd-43ef-b98f-3520290a22a3",
                                                "sense_id": "61a6615a-5d22-34d5-95a7-9f3c53ebf739",
                                                "text": "A treatment or cure is applied after a medical problem has already started."
                                            },
                                            {
                                                "example_id": "c4f9a85e-08ec-4d5c-a10b-919c261c8306",
                                                "sense_id": "61a6615a-5d22-34d5-95a7-9f3c53ebf739",
                                                "text": "Cancer survivors who got radiation treatments as children have nearly twice the risk of developing diabetes as adults."
                                            },
                                            {
                                                "example_id": "7b3d26e4-3a3f-44db-b568-d52cb57f084b",
                                                "sense_id": "61a6615a-5d22-34d5-95a7-9f3c53ebf739",
                                                "text": "The change is due largely to the increased availability of antiretroviral treatment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23e052ea-6bfc-3f2e-980d-35dbeeb79dca",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "The use of a substance or process to preserve or give particular properties to something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1b92c1d-f164-3a4e-b3a6-f49c9cc5faaf",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "A treatise; a formal written description or characterization of a subject."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d4c68f8-42e2-42db-9296-faa3464f8d6b",
                                                "sense_id": "b1b92c1d-f164-3a4e-b3a6-f49c9cc5faaf",
                                                "text": "Firstly, I continue to base most species treatments on personally collected material, rather than on herbarium plants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4a50667-6da3-3037-bcd8-3c3a9950ef02",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "A brief, third-person, present-tense summary of a proposed film."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f2ea36c-785b-332a-838e-0f14d612baa6",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "entertainment; treat"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49c6d1f4-c7f2-4de2-bbfd-e8819c451146",
                                                "sense_id": "4f2ea36c-785b-332a-838e-0f14d612baa6",
                                                "text": "Accept such treatment as a swain affords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40466a1b-4477-329d-b903-3b5ed9164c35",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "harsh punishment; retribution"
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e12bff6a-3832-47dc-b9a9-3f35ea793297",
                                                "sense_id": "40466a1b-4477-329d-b903-3b5ed9164c35",
                                                "text": "He’s been a naughty boy, so give him a good treatment."
                                            },
                                            {
                                                "example_id": "52a4e5f0-9d14-4185-b04a-89b8dc0c126e",
                                                "sense_id": "40466a1b-4477-329d-b903-3b5ed9164c35",
                                                "text": "Even if you supported the socialist regime, your class background often meant you were going to get the treatment regardless."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50ad59d4-b8bd-4dc2-80b3-f7225f866d30",
                        "source_entry_id": "824dd59f-b912-3991-be03-d4fd64eaa085",
                        "source_sense_id": "02493c1d-7c07-3fbc-a2c3-571221177937",
                        "source_sense_description": "een methode om aan de genezing van zieken te werken",
                        "target_lang_word": "thérapie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thérapie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3db7b58-cd66-388b-9839-cdbc89c0c0b3",
                                        "entry_id": "4ee7dc9a-85e2-3641-88cd-d11e6aba7a0c",
                                        "glosses": [
                                            "Traitement pour guérir une personne malade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15b57441-3956-4734-9f44-d3c971b50aad",
                                                "sense_id": "e3db7b58-cd66-388b-9839-cdbc89c0c0b3",
                                                "text": "Ce qui m’amène à dire que nous jouons à la loto-santé lorsque nous décidons de recourir aux thérapies alternatives qui peuvent utiliser l’un ou l’autre des titres suivants : aimantothérapie, auriculothérapie, bioénergie, magnétothérapie, catharsis, champs magnétiques, chromothérapie, jeûne, électrophysiologie, clairvoyance, emplâtres, guérison spirituelle, médiumnité, holothérapie, homéopathie, hypnothérapie, iridologie, irrigation du côlon, kinésithérapie, lasérothérapie, radiesthésie, massothérapie, naturopathie, orthothérapie, ostéopathie, phytothérapie, polarité, pulsologie, ramancheur/rebouteur, réflexologie, sophrologie, technique morontielle, sympathicothérapie, spiralogie, tropologie, urinothérapie…"
                                            },
                                            {
                                                "example_id": "7a211cde-509e-4f8e-ae6d-27e2748d2048",
                                                "sense_id": "e3db7b58-cd66-388b-9839-cdbc89c0c0b3",
                                                "text": "Sue et ses parents ont sillonné les États-Unis et le Canada de long en large en quête de thérapeutes, ou d’une thérapie, qui la guérirait."
                                            },
                                            {
                                                "example_id": "b4568afb-3e41-478c-84d0-6b024419f3ea",
                                                "sense_id": "e3db7b58-cd66-388b-9839-cdbc89c0c0b3",
                                                "text": "On serait livré par drone et soigné avec le dernier cri de la technologie médicale : robots chirurgiens, thérapies cellulaires et thérapies géniques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d7f4bf2-c5f9-3dc9-bbff-b9ec0c593624",
                                        "entry_id": "4ee7dc9a-85e2-3641-88cd-d11e6aba7a0c",
                                        "glosses": [
                                            "(Par aphérèse) Psychothérapie."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3010f6b1-a5af-425a-b0d0-5d47246b1a7f",
                                                "sense_id": "6d7f4bf2-c5f9-3dc9-bbff-b9ec0c593624",
                                                "text": "Les thérapies comportementales et cognitives utilisent un certain nombre de méthodes pour produire un changement cognitif afin d’obtenir un changement comportemental et émotionnel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
