                "senses": [
                    {
                        "sense_id": "f0370ec6-aa79-3de6-b7a0-959d6ba33024",
                        "entry_id": "b2c90aec-89aa-3b72-b9ef-2eaf1b58bcb7",
                        "glosses": [
                            "das Belüften eines Tunnels zur Lufterneuerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8232717b-b6eb-4b1a-ba10-fa2bbe675739",
                                "sense_id": "f0370ec6-aa79-3de6-b7a0-959d6ba33024",
                                "text": "„Als jemand, der dem Bergbau und hier insbesondere der Wetter- und Klimatechnik in besonderem Maße verbunden ist, ist es mir ein besonderes Anliegen, das Wissen auf dem Gebiet der Grubenbewetterung sowie der Tunnelbelüftung zu bewahren und interessierten Ingenieuren sowie Studenten zur Kenntnis zu bringen.“"
                            },
                            {
                                "example_id": "2ad83aba-6352-40b6-ae22-2f5c8cf0df1e",
                                "sense_id": "f0370ec6-aa79-3de6-b7a0-959d6ba33024",
                                "text": "„Durch die Entwicklung eines neuen Antriebskonzepts für die Laufschaufeln und eine somit deutlich verbesserte Dynamik und Reaktionsgeschwindigkeit des Systems konnten neue Maßstäbe in der Tunnelbelüftung gesetzt und somit die Sicherheit deutlich erhöht werden.“"
                            },
                            {
                                "example_id": "189fa472-5ca1-49a2-ba49-b95bdef2f1d4",
                                "sense_id": "f0370ec6-aa79-3de6-b7a0-959d6ba33024",
                                "text": "„Für die Weltstraßenvereinigung PIARC liefert die TU Graz Grundlagendaten für Tunnelbelüftung.“"
                            },
                            {
                                "example_id": "377e9f8f-5e8c-4a80-b72c-9c98d0d1c5b5",
                                "sense_id": "f0370ec6-aa79-3de6-b7a0-959d6ba33024",
                                "text": "„Der Verbesserung der Sicherheit im Brandfall durch eine Tunnelbelüftung wird heute eine weit höhere Bedeutung zugemessen als noch vor wenigen Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
