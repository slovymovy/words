            {
                "entry_id": "5c4fe3cd-9ef7-3954-9578-5bb92b8a7b45",
                "word": "Canopus",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "30dcaea6-9656-3105-8527-e0fa7d3273d9",
                        "entry_id": "5c4fe3cd-9ef7-3954-9578-5bb92b8a7b45",
                        "glosses": [
                            "Nom latin de Canope, dieu de l’eau des Égyptiens."
                        ],
                        "tags": [
                            "Divinité"
                        ],
                        "examples": [
                            {
                                "example_id": "6f7b30c7-6588-44d7-b15c-2b408334dbe9",
                                "sense_id": "30dcaea6-9656-3105-8527-e0fa7d3273d9",
                                "text": "Canopus était le pilote d’Osiris, si l’on en croit Plutarque : selon d’autres, le pilote de Ménélas, qui ayant fait naufrage sur la côte d’Égypte, y fut honoré comme Dieu. On lui bâtit un temple : il passa pour être un Dieu des eaux, & fut même appelé Neptune Canope."
                            }
                        ]
                    },
                    {
                        "sense_id": "3748d85c-051b-3add-abbd-75bbdf4bbcf1",
                        "entry_id": "5c4fe3cd-9ef7-3954-9578-5bb92b8a7b45",
                        "glosses": [
                            "Ville d’Égypte à 120 stades d’Alexandrie."
                        ],
                        "tags": [
                            "Toponymie"
                        ],
                        "examples": [
                            {
                                "example_id": "c3451483-b39d-4304-8a4a-0d44167dc6eb",
                                "sense_id": "3748d85c-051b-3add-abbd-75bbdf4bbcf1",
                                "text": "Il y avoit à Canopus une école célèbre, où étoit la source de toute la Théologie Egyptienne, & où l’on enseignoit les lettres sacrées, ou les hiéroglyphes."
                            }
                        ]
                    },
                    {
                        "sense_id": "531df9f8-9d18-37bd-b1aa-225b4fa702da",
                        "entry_id": "5c4fe3cd-9ef7-3954-9578-5bb92b8a7b45",
                        "glosses": [
                            "Étoile la plus brillante de la constellation australe de la Carène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72461dd2-ae66-47bf-aa4c-55c1f66c4ffc",
                                "sense_id": "531df9f8-9d18-37bd-b1aa-225b4fa702da",
                                "text": "Le Canopus ne se voit ni en Grèce ni en Italie."
                            },
                            {
                                "example_id": "17c9a680-8dfb-47e1-b867-9dc1b8e422f7",
                                "sense_id": "531df9f8-9d18-37bd-b1aa-225b4fa702da",
                                "text": "La nuit, des observations de Canopus, Sirius et Achernar fixèrent ma position."
                            }
                        ]
                    }
                ],
