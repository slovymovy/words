                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bd1348f-78c5-4ccf-a1d7-73e8496bbb4d",
                                "sense_id": "7c846ac4-384d-3572-9bbd-ad63e6e798a7",
                                "text": "Dobiegł go buczący dźwięk i pojawiła się przed nim holograficzna postać, nie większa niż jego dłoń. Miniatura lorda Vadera"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b18d47af-9f94-3a96-a887-6ee8a92f55c1",
