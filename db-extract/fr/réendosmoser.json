                "senses": [
                    {
                        "sense_id": "903e2937-1a1f-3aaf-9aa7-2ee392079c5d",
                        "entry_id": "e8e9cebd-d7d0-392c-bae0-b960a4944af0",
                        "glosses": [
                            "Endosmoser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5638bbf-1b14-4372-aa52-7faeec48f9fc",
                                "sense_id": "903e2937-1a1f-3aaf-9aa7-2ee392079c5d",
                                "text": "Ce que personne ne consentira à admettre, ce sont des enveloppes qui, laissant les animalcules se réendosmoser en quelques minutes lorsqu'on les réhumecte, empêchent au contraire assez énergiquement le même liquide de s'exhaler, pour que ces mêmes animalcules conservent l'humidité de leurs tissus, et vivent pendant deux heures entre 80 et 90 degrés."
                            }
                        ]
                    }
