                "senses": [
                    {
                        "sense_id": "30fd5f4e-00a9-3c1c-9ca0-bb11b696aef3",
                        "entry_id": "b748b6e2-3b9c-32cc-a617-2e37e6e5a00b",
                        "glosses": [
                            "Spitze eines Speeres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac386244-1c0c-40c7-9362-f60f7c97b1e6",
                                "sense_id": "30fd5f4e-00a9-3c1c-9ca0-bb11b696aef3",
                                "text": "„Der Speer trat etwa einen Zentimeter über dem rechten Auge in Yassers Schädel ein und durchbohrte seine rechte Gehirnhälfte, bevor die Speerspitze an der Rückseite seines Kopfes wieder austrat, erklärte das Ärzteam bei der Pressekonferenz.“"
                            },
                            {
                                "example_id": "76db157a-29ac-4e5d-9c05-178be3f86a6f",
                                "sense_id": "30fd5f4e-00a9-3c1c-9ca0-bb11b696aef3",
                                "text": "„Die eigentliche Sensation aber steckte zwischen den Rippen: eine Speerspitze.“"
                            },
                            {
                                "example_id": "0eadcb05-8695-4595-9f9f-ad64b43ff12a",
                                "sense_id": "30fd5f4e-00a9-3c1c-9ca0-bb11b696aef3",
                                "text": "„Sie fertigten Fibeln, Hals-, Arm- und Ohrringe, Gürtelschnallen, Dolche, Pfeil-, Lanzen- und Speerspitzen, Messer, Sicheln, Pinzetten, Nähnadeln, Nägel, Beschläge für Pferdegeschirr, Fleischgabeln, Kesselketten und Geschirr, nicht nur für den Eigenbedarf der Heuneburg, sondern auch für den Export.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "483d7f8f-7a4b-377f-a8ac-30dea7621202",
                        "entry_id": "b748b6e2-3b9c-32cc-a617-2e37e6e5a00b",
                        "glosses": [
                            "wichtigster Teil, treibende Kraft einer Bewegung"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "af337f57-ca88-4eea-8543-64a0b7d8a44c",
                                "sense_id": "483d7f8f-7a4b-377f-a8ac-30dea7621202",
                                "text": "„Als ein Land, das nach der Unabhängigkeit Mitglied des Commonwealth geworden war, nutzte Ghana auch diese Plattform, um für die Entkolonialisierung einzutreten und sich als Speerspitze der afrikanischen Revolution zu präsentieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25d43959-b44e-48e7-ba01-35170e723e9f",
                        "source_entry_id": "b748b6e2-3b9c-32cc-a617-2e37e6e5a00b",
                        "source_sense_id": "30fd5f4e-00a9-3c1c-9ca0-bb11b696aef3",
                        "source_sense_description": "Spitze eines Speeres",
                        "target_lang_word": "spearhead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spearhead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1d0cb8a-71c8-343b-86c4-59ec5b2d3c61",
                                        "entry_id": "90c525c5-2aa6-3c95-ba5e-f6042bfd4e9b",
                                        "glosses": [
                                            "The pointed head, or end, of a spear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "892aa091-3dd6-43a2-883d-b920164bdb9e",
                                                "sense_id": "a1d0cb8a-71c8-343b-86c4-59ec5b2d3c61",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out.[…]. Ikey the blacksmith had forged us a spearhead after a sketch from a picture of a Greek warrior; and a rake-handle served as a shaft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d76db12-4059-3ef9-9f64-3a7c33ef6cee",
                                        "entry_id": "90c525c5-2aa6-3c95-ba5e-f6042bfd4e9b",
                                        "glosses": [
                                            "One who leads or initiates an activity (such as an attack or a campaign)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3278795-b67b-4319-bf47-0f36b91fda41",
                                                "sense_id": "5d76db12-4059-3ef9-9f64-3a7c33ef6cee",
                                                "text": "Spearheads of the NER bargain fares attack this year have been the introduction of weekend fares at a 7s 6d in the £ discount on ordinary rates between principal stations throughout the Region—[...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0129754-f194-3a11-bbfa-96e726800fe6",
                                        "entry_id": "90c525c5-2aa6-3c95-ba5e-f6042bfd4e9b",
                                        "glosses": [
                                            "The leading military unit in an attack."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "011898bd-0c28-378d-85f6-6b4337cf55c4",
                                        "entry_id": "90c525c5-2aa6-3c95-ba5e-f6042bfd4e9b",
                                        "glosses": [
                                            "A player who initiates attacking moves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d811eb5c-8be2-4ba2-b730-96cc0eea4c73",
                                                "sense_id": "011898bd-0c28-378d-85f6-6b4337cf55c4",
                                                "text": "England played at a tempo in attack that was too much for Bulgaria, with width provided at various times by Walcott, Young and Stewart Downing and Rooney acting as the potent spearhead."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spearhead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92105415-ce29-3120-b1d8-b959f4fe1a7c",
                                        "entry_id": "002b93f5-6d46-3447-afa9-e6ee6f613cca",
                                        "glosses": [
                                            "To drive or campaign ardently for, as an effort, project, etc.; to direct."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "091738b4-1da9-4e98-9d7d-bff4a137c039",
                                                "sense_id": "92105415-ce29-3120-b1d8-b959f4fe1a7c",
                                                "text": "He spearheaded the entire project from day one."
                                            },
                                            {
                                                "example_id": "eeb403f7-5234-4846-9c69-e8c98cfa80db",
                                                "sense_id": "92105415-ce29-3120-b1d8-b959f4fe1a7c",
                                                "text": "Newcastle have put themselves within touching distance after a fantastic run which has been spearheaded by the goals of Senegal striker Cisse."
                                            },
                                            {
                                                "example_id": "90b909ce-d635-41c8-b038-c4fb8b4bac39",
                                                "sense_id": "92105415-ce29-3120-b1d8-b959f4fe1a7c",
                                                "text": "George Monks spearheaded the project to solve this problem with a funicular, and work on the Lynton & Lynmouth Cliff Railway (L&LCR) began in 1887."
                                            },
                                            {
                                                "example_id": "ad3ac726-96cb-4056-9c25-710314b0fa7b",
                                                "sense_id": "92105415-ce29-3120-b1d8-b959f4fe1a7c",
                                                "text": "Musk is betting that lonely users will trade their cash (and last shreds of their connection to human life) for a bot that is explicitly designed to flirt with sad men, as the saddest man on Earth spearheaded it."
                                            },
                                            {
                                                "example_id": "bfc97d3e-d00d-4b5c-94d0-0c6515d69eb4",
                                                "sense_id": "92105415-ce29-3120-b1d8-b959f4fe1a7c",
                                                "text": "Bessent has also been spearheading trade negotiations. Last week he traveled to Sweden to meet with Chinese trade officials to discuss extending the current tariff rates in place on both countries’ goods. This comes as there’s a looming August 12 deadline for the two sides to extend rates or face higher tariffs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c775bd1-5dab-474f-a5fb-1383814d3280",
                        "source_entry_id": "b748b6e2-3b9c-32cc-a617-2e37e6e5a00b",
                        "source_sense_id": "30fd5f4e-00a9-3c1c-9ca0-bb11b696aef3",
                        "source_sense_description": "Spitze eines Speeres",
                        "target_lang_word": "fer de lance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fer de lance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1feaee6b-1ebd-3e35-b6df-eb02018a7390",
                                        "entry_id": "4bf927d0-01f9-355b-b775-95d6f7763c4b",
                                        "glosses": [
                                            "Pointe en fer, attachée au bout d’une flèche, d’une lance, ou d’une pique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deea6cc9-1ee1-4ed2-9ef5-d0fffd3c29b0",
                                                "sense_id": "1feaee6b-1ebd-3e35-b6df-eb02018a7390",
                                                "text": "Cependant, son cou portait l’empreinte du sang, la cicatrice triangulaire d’un fer de lance, la marque de la blessure qui me ravit Polémon au siége ^([sic : siège]) de Corinthe, quand ce fidèle ami se précipita sur mon cœur, au-devant de la rage effrénée du soldat déjà victorieux, mais jaloux de donner au champ de bataille un cadavre de plus."
                                            },
                                            {
                                                "example_id": "956b2de5-a49b-4dca-bbfa-eb2bfc6af3b2",
                                                "sense_id": "1feaee6b-1ebd-3e35-b6df-eb02018a7390",
                                                "text": "On entre au Chalet par une petite porte en fer, treillissée, et dont les fers de lance s’élèvent de quelques pouces au-dessus du palis et de la haie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e62e619b-1a10-356d-a5d4-dcd38b05f7f6",
                                        "entry_id": "4bf927d0-01f9-355b-b775-95d6f7763c4b",
                                        "glosses": [
                                            "Élément le plus dynamique ou actif d’un groupe."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ab34f4b-5d4c-4bd7-a34b-6f20a17b8a09",
                                                "sense_id": "e62e619b-1a10-356d-a5d4-dcd38b05f7f6",
                                                "text": "Vingt ans plus tard, la galaxie illibérale s’est étoffée. En Europe, la Pologne et la Hongrie sont devenues les fers de lance de ce mouvement, mais d’autres pays d’Europe centrale semblent prêts à leur emboîter le pas."
                                            },
                                            {
                                                "example_id": "31be04e8-b9ec-403a-92fc-a0adc1a459a6",
                                                "sense_id": "e62e619b-1a10-356d-a5d4-dcd38b05f7f6",
                                                "text": "Emma Cantal Gorrochategui sera toujours l’une des fers de lance des Maritimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cf81991-b1f5-375b-96e0-01b92d15c70f",
                                        "entry_id": "4bf927d0-01f9-355b-b775-95d6f7763c4b",
                                        "glosses": [
                                            "Celui qui est le plus représentatif."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bfd5c6d-d966-4cb4-bc9e-45a6d12e0a9c",
                                                "sense_id": "5cf81991-b1f5-375b-96e0-01b92d15c70f",
                                                "text": "Être le fer de lance d’une organisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7941f79-2871-3594-a5a7-e788d48d9c73",
                                        "entry_id": "4bf927d0-01f9-355b-b775-95d6f7763c4b",
                                        "glosses": [
                                            "Espèce de serpent, de nom scientifique Bothrops atrox."
                                        ],
                                        "tags": [
                                            "Ophiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a90c214-4808-457b-a3fb-217254aad921",
                                                "sense_id": "f7941f79-2871-3594-a5a7-e788d48d9c73",
                                                "text": "Le fer de lance doit son nom à la forme de sa tête triangulaire qui lui a aussi valu le nom de « trigonocéphale » (tête triangulaire en grec)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "100b0501-5f0a-3186-9f03-529a3c1dc6aa",
                                        "entry_id": "4bf927d0-01f9-355b-b775-95d6f7763c4b",
                                        "glosses": [
                                            "Meuble représentant l’arme du même nom dans les armoiries. Elle est généralement représentée en pal, pointe vers le chef. À rapprocher de bocquet, fer de dard, fer de flèche, fer de pique et phéon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93cacaa0-1657-42f0-8daf-41bb551498da",
                                                "sense_id": "100b0501-5f0a-3186-9f03-529a3c1dc6aa",
                                                "text": "De gueules au sautoir d’or, un écusson d’argent au fer de lance de sable ajouré du champ posé en abîme, qui est de la commune de Petit-Landau du Haut-Rhin"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bdb5e50-ad90-31d1-ae3a-e7c1d71a8527",
                                        "entry_id": "4bf927d0-01f9-355b-b775-95d6f7763c4b",
                                        "glosses": [
                                            "Dont la forme évoque celle d’un fer de lance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b1561dd-4ce6-4482-a75c-e58e74755f25",
                                                "sense_id": "3bdb5e50-ad90-31d1-ae3a-e7c1d71a8527",
                                                "text": "Angelo vit un petit visage en fer de lance encadré de lourds cheveux noirs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
