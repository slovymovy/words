                ],
                "translations": [
                    {
                        "translation_id": "6840e2ec-ea87-43c0-97c0-df773f71bc77",
                        "source_entry_id": "147bb012-4ba5-3b0a-8524-89119411e2f9",
                        "source_sense_id": "be4362a8-eb7b-3f20-91e3-4048d5d8fbd5",
                        "source_sense_description": "een bak waarin men huisvuil verzamelt",
                        "target_lang_word": "Mülleimer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mülleimer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                        "entry_id": "6838c096-d10e-306e-b610-dbda82c6738c",
                                        "glosses": [
                                            "Behältnis, in dem Abfall gesammelt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66e5cd62-0c37-4e61-8eca-7ad166b93edb",
                                                "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                                "text": "Der Mülleimer müsste mal wieder geleert werden."
                                            },
                                            {
                                                "example_id": "127cae13-c384-437f-9910-fbba3cdebac1",
                                                "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                                "text": "Bitte stellen Sie die Mülleimer vor sechs Uhr an den Straßenrand."
                                            },
                                            {
                                                "example_id": "779430ba-a64f-47b0-bb03-3f60408ec795",
                                                "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                                "text": "„Zu Beginn wird ein junger Mann überfahren, der sturzbetrunken nach seinem Junggesellenabschied eine Tasche mit Scheinen aus einem Mülleimer zieht und dabei unwissentlich die Geldübergabe bei einer Entführung stört.“"
                                            },
                                            {
                                                "example_id": "8cc11075-186c-4b02-a5d6-817ff6912d0a",
                                                "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                                "text": "„Er war aufgestanden, um die Brötchentüte in den Mülleimer zu werfen.“"
                                            },
                                            {
                                                "example_id": "232973af-e996-4738-b4a2-4f6b58a3eeb1",
                                                "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                                "text": "„Ich lege also meine Wagenschlüssel auf den Tisch, werfe die Werbung in den Mülleimer und bemerke, dass er voll ist.“"
                                            },
                                            {
                                                "example_id": "2f47e7de-43f3-4905-bf5b-622184f20bd2",
                                                "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                                "text": "„Er zwängte sich zwischen dem Wagen und einem Mülleimer durch, schloß auf und ging die Treppe hinauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "057d2eae-2993-47bc-80f8-4b5e0c7d9a39",
                        "source_entry_id": "147bb012-4ba5-3b0a-8524-89119411e2f9",
                        "source_sense_id": "be4362a8-eb7b-3f20-91e3-4048d5d8fbd5",
                        "source_sense_description": "een bak waarin men huisvuil verzamelt",
                        "target_lang_word": "Mülltonne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mülltonne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5bfdd00a-49c5-3908-b80f-dd60173e55c0",
                                        "entry_id": "8548c112-9696-32f5-9e55-179d61d16ca0",
                                        "glosses": [
                                            "großes Behältnis, um Abfall zu lagern, bis er von der Müllabfuhr abgeholt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c2196f5-e3d2-4b2c-a581-1563a68a0230",
                                                "sense_id": "5bfdd00a-49c5-3908-b80f-dd60173e55c0",
                                                "text": "Hast du die Mülltonne nach draußen gestellt?"
                                            },
                                            {
                                                "example_id": "5b98fa58-290d-4bd2-9d61-ff00de2be2b5",
                                                "sense_id": "5bfdd00a-49c5-3908-b80f-dd60173e55c0",
                                                "text": "„Eine Katze wühlte in den Mülltonnen, Kindergeschrei drang aus einem Hauseingang, die Straßenkehrer fluchten, weil sich das Blut nicht entfernen ließ.“"
                                            },
                                            {
                                                "example_id": "b7930340-4402-45e9-8ee8-2a7865ad466e",
                                                "sense_id": "5bfdd00a-49c5-3908-b80f-dd60173e55c0",
                                                "text": "„Der Ostfriese schaut in die Mülltonne.“"
                                            },
                                            {
                                                "example_id": "6c7c9190-02b5-4cdf-b4f4-65ab94b1d168",
                                                "sense_id": "5bfdd00a-49c5-3908-b80f-dd60173e55c0",
                                                "text": "„In den Mülltonnen im Hof raschelte es.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68106d5a-4c6d-4893-8af9-5c5b8a5635d8",
                        "source_entry_id": "147bb012-4ba5-3b0a-8524-89119411e2f9",
