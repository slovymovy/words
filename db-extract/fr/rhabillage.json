                            {
                                "example_id": "e1b4374b-dace-488e-a8c1-43d6bf9fc2a2",
                                "sense_id": "085c0e65-49cf-3bc6-999d-5589c4a191f3",
                                "text": "On doit aider au rhabillage en visant à rendre l’enfant progressivement autonome."
                            },
                            {
                                "example_id": "b1ffa40f-daad-48c6-9e95-ccec8e85f1d6",
                                "sense_id": "085c0e65-49cf-3bc6-999d-5589c4a191f3",
                                "text": "Quand venait l’heure de nous coucher et de nous mettre en pyjama, il restait près de nous et nous apprenait à disposer nos vêtements dans l’ordre très exact du rhabillage."
                            }
                        ]
                    },
                    {
