                                        "entry_id": "fae4fcfc-e283-3862-9a6f-d01f63568b0f",
                                        "glosses": [
                                            "The flat layer of construction materials to which the weather impervious layers are attached to a form a roof. It is known as the \\\"roof deck\\\", and they may be either level (for a \\\"flat\\\" rooftop) or sloped."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45941eff-4c5c-48e7-8941-915f2e0ebe6e",
                                                "sense_id": "eac39995-3c52-34eb-a2b0-926cf0e079bb",
                                                "text": "In multi-story commercial construction, the dominant form of deck (including roof deck) construction is composite steel deck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feb55333-46a7-3a72-9196-1999700427af",
                                        "entry_id": "fae4fcfc-e283-3862-9a6f-d01f63568b0f",
                                        "glosses": [
                                            "An upper deck of a ship that provides shelter for another deck underneath."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da5d805d-f70d-460c-b008-91715e9301cf",
                                                "sense_id": "feb55333-46a7-3a72-9196-1999700427af",
                                                "text": "There are four decks under the main deck and three above, which are named the roof deck, the promenade deck, and the boat deck"
                                            }
                                        ]
                                    }
                                ]
                            }
