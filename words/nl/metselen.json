                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij lieten een prachtige open haard in de woonkamer <w>metselen</w>.",
                            "target_lang_translations": {
                                "en": "They had a beautiful fireplace <w>built</w> in the living room."
                            }
                        },
                        {
                            "text": "De arbeiders moesten een stevig fundament <w>metselen</w> voor het monument.",
