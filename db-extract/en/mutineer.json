                                                "sense_id": "02fca360-f52c-3066-9dc1-26affc1d9fa8",
                                                "text": "„In Kiel verbreitete sich das Gerücht über die Inhaftierung der Meuterer in Windeseile unter den unzufriedenen Marineangehörigen.“"
                                            },
                                            {
                                                "example_id": "14739980-de87-434a-9861-ed19209cd0bd",
                                                "sense_id": "02fca360-f52c-3066-9dc1-26affc1d9fa8",
                                                "text": "„Von den Meuterern war kaum etwas zu hören.“"
                                            },
                                            {
                                                "example_id": "557f89d2-7205-46db-b9f3-97318aee1ca8",
                                                "sense_id": "02fca360-f52c-3066-9dc1-26affc1d9fa8",
                                                "text": "„Die Männer wurden als Meuterer ins Gefängnis gesteckt, und wir beluden das Schiff mit Frischwasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
