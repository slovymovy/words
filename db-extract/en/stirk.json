                "senses": [
                    {
                        "sense_id": "20d6ac6a-9089-366a-a69e-36c88776392a",
                        "entry_id": "54844a93-15ab-3769-9c4b-5fce6b34bdee",
                        "glosses": [
                            "A yearling cow; a young bullock or heifer."
                        ],
                        "tags": [
                            "British",
                            "Scotland",
                            "dated",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "2912617d-832b-4b85-b76d-5fcdd27fe8b9",
                                "sense_id": "20d6ac6a-9089-366a-a69e-36c88776392a",
                                "text": "But beware of MacPhadraick, my son; for when he called himself the friend of your father, he better loved the most worthless stirk in his herd, than he did the life-blood of MacTavish Mhor."
                            },
                            {
                                "example_id": "c38253f1-1dd1-41fd-887a-69fcf5b8b7e8",
                                "sense_id": "20d6ac6a-9089-366a-a69e-36c88776392a",
                                "text": "Comprising eleven calved and in-calf cows and heifers, three barren cows, four fat cows and heifers, two sturks and three yearlings; fifteen in-lamb ewes and theaves, […]"
                            },
                            {
                                "example_id": "7009fe63-3f9b-4b6b-a137-5a03ec710bb8",
                                "sense_id": "20d6ac6a-9089-366a-a69e-36c88776392a",
                                "text": "he could stop a running stirk by the horns, so strong he was in the wrist-bones."
                            }
                        ]
                    }
                ],
