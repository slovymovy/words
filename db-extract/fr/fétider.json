                "senses": [
                    {
                        "sense_id": "154058f5-a2b4-3a53-9cc2-e027f8498726",
                        "entry_id": "7b7ceb0e-2975-3438-ab98-be1eada68a4a",
                        "glosses": [
                            "Exhaler une odeur fétide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "720e33f7-da5c-4ff6-82ff-867c8b95a2ce",
                                "sense_id": "154058f5-a2b4-3a53-9cc2-e027f8498726",
                                "text": "Les murs des maisons ont des sueurs noires et leurs soupiraux fétident"
                            },
                            {
                                "example_id": "89c3bcb4-ef17-44a2-a675-7c524e1ff73e",
                                "sense_id": "154058f5-a2b4-3a53-9cc2-e027f8498726",
                                "text": "Enfin, en descendant plus bas, en fréquentant les purs mannezingues ou les bibines de dernier ordre, la compagnie était répulsive et la saleté stupéfiante ; la carne fétidait, les verres avaient des ronds de bouches encore marqués, les couteaux était dépolis et gras et les couverts conservaient dans leurs filets le jaune des œufs mangés."
                            }
                        ]
                    }
