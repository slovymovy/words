{
    "word_family": [
        "vacation",
        "vacancy",
        "vacant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "db0ce57c-e14b-335b-820a-2c3f922a7c14",
                    "sense_definition": "To move out of a house, apartment, or other property.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leave_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tenants must <w>vacate</w> the apartment by the end of the month.",
                            "target_lang_translations": {
                                "zh": "租户必须在月底前<w>搬出</w>公寓。"
                            }
                        },
                        {
                            "text": "We had to <w>vacate</w> the premises quickly because of the fire alarm.",
                            "target_lang_translations": {
                                "zh": "由于火警警报，我们必须迅速<w>撤离</w>现场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "evacuate",
                        "depart",
                        "leave"
                    ],
                    "antonyms": [
                        "occupy",
                        "inhabit"
                    ],
                    "common_phrases": [
                        "vacate the premises",
                        "vacate the property"
                    ],
                    "target_lang_definitions": {
                        "zh": "搬出房屋、公寓或其他房产。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "搬出",
                                "target_lang_sense_clarification": "指从居住地迁出。"
                            },
                            {
                                "target_lang_word": "腾出",
                                "target_lang_sense_clarification": "指清理出空间或房产。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0002261d-6c7b-3219-bdad-e24532c027b5",
                    "sense_definition": "To leave an area, often due to an emergency or official order.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leave_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Residents were told to <w>vacate</w> the area immediately due to the approaching flood.",
                            "target_lang_translations": {
                                "zh": "由于洪水逼近，居民被告知立即<w>撤离</w>该地区。"
                            }
                        },
                        {
                            "text": "Police ordered the crowd to <w>vacate</w> the area during the protest.",
                            "target_lang_translations": {
                                "zh": "抗议期间，警方命令人群<w>疏散</w>该区域。"
                            }
                        }
                    ],
                    "synonyms": [
                        "evacuate",
                        "clear"
                    ],
                    "common_phrases": [
                        "vacate the area"
                    ],
                    "target_lang_definitions": {
                        "zh": "离开某区域，通常是由于紧急情况或官方命令。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "撤离",
                                "target_lang_sense_clarification": "指因危险而离开某地。"
                            },
                            {
                                "target_lang_word": "疏散",
                                "target_lang_sense_clarification": "指官方组织人员离开危险区域。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d41619c-ec7f-3740-8c53-ecd34030e413",
                    "sense_definition": "To resign from or give up an office, job, or position.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director decided to <w>vacate</w> his position after many years of service.",
                            "target_lang_translations": {
                                "zh": "这位主管在任职多年后决定<w>卸任</w>。"
                            }
                        },
                        {
                            "text": "She will <w>vacate</w> the office at the end of the term.",
                            "target_lang_translations": {
                                "zh": "她将在任期结束时<w>离职</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resign",
                        "relinquish"
                    ],
                    "common_phrases": [
                        "vacate a position",
                        "vacate an office"
                    ],
                    "target_lang_definitions": {
                        "zh": "辞去或放弃职位、工作或职务。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "离职",
                                "target_lang_sense_clarification": "指离开工作岗位。"
                            },
                            {
                                "target_lang_word": "卸任",
                                "target_lang_sense_clarification": "指放弃担任的职务。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb1c08fb-b02e-3a1b-84f1-e99430b57917",
                    "sense_definition": "To officially cancel or annul a court judgment or legal decision.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to <w>vacate</w> the conviction due to new evidence.",
                            "target_lang_translations": {
                                "zh": "法官因新证据决定<w>撤销</w>定罪。"
                            }
                        },
                        {
                            "text": "The court chose to <w>vacate</w> the previous ruling after the appeal.",
                            "target_lang_translations": {
                                "zh": "上诉后，法院选择<w>撤销</w>先前的裁决。"
                            }
                        }
                    ],
                    "synonyms": [
                        "annul",
                        "overturn",
                        "cancel"
                    ],
                    "antonyms": [
                        "uphold",
                        "confirm"
                    ],
                    "common_phrases": [
                        "vacate a conviction",
                        "vacate a judgment"
                    ],
                    "target_lang_definitions": {
                        "zh": "正式取消或废除法院判决或法律裁定。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "撤销",
                                "target_lang_sense_clarification": "指取消法律判决或决定。"
                            },
                            {
                                "target_lang_word": "废除",
                                "target_lang_sense_clarification": "指使法律裁定失效。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}