                ],
                "senses": [
                    {
                        "sense_id": "f4431db5-86b0-3b91-a6a3-98b917f0dc67",
                        "entry_id": "b59dba8b-3cf8-32eb-bf6a-6d2cad00367c",
                        "glosses": [
                            "iemand die op het platteland per dag in dienst wordt genomen tegen een op dat moment afgesproken vergoeding"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5783598a-bcd5-4493-a187-1797f3b7022e",
                                "sense_id": "f4431db5-86b0-3b91-a6a3-98b917f0dc67",
                                "text": "De gewone daggelder verdiende 's winters acht en 's zomers twaalf stuivers."
                            },
                            {
                                "example_id": "36aeeaca-fb27-4aa6-bc39-275fe7e67ef1",
                                "sense_id": "f4431db5-86b0-3b91-a6a3-98b917f0dc67",
                                "text": "Het klinkt alles heel fraai om tegen een onbemiddelden daggelder, met zeer veel aanleg om een uitmuntend rijder te worden, te zeggen: kerel, wat heb jij een mooie actie, je hebt een besten tijd gemaakt, je moest je gaan trainen! Je moet een stevig ontbijt gebruiken: rund- en lamsvleesch (geen varkens of kalfsvleesch); het middageten bestaat uit gebraden rund- of lamsvleesch kip, wild of visch en versche (geen ingemaakte) groenten. Doch dat zijn lekkernijen, die een arbeider of polderwerker niet in zijn rechtmatig bezit kan krijgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a05c66c-9700-3ad1-854c-f0fdfbb43742",
                        "entry_id": "b59dba8b-3cf8-32eb-bf6a-6d2cad00367c",
                        "glosses": [
                            "iemand die zonder vaste aanstelling werkt tegen een vergoeding per dag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b2c6806-5bbb-42e5-a467-f42fbd35bb38",
                                "sense_id": "0a05c66c-9700-3ad1-854c-f0fdfbb43742",
                                "text": "Wies Perelaer zal Du Perron in het begin met scheve ogen hebben aangekeken, want zelf was zij met ingang van 1 januari 1938 ook aangenomen als daggelder, maar op een loon van slechts vier gulden per dag."
                            }
                        ]
                    }
