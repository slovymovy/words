                                "target_senses": [
                                    {
                                        "sense_id": "2b8d8567-6ab2-33c5-bf85-5dd0430c47f5",
                                        "entry_id": "4d5a347e-3fa0-330c-a97a-314d7eca19eb",
                                        "glosses": [
                                            "mit Nachteilen verbunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b1387b-87c0-444d-b9a6-b7ee014d48ba",
                                                "sense_id": "2b8d8567-6ab2-33c5-bf85-5dd0430c47f5",
                                                "text": "„Unfälle sind keine Zufälle, wie so manche Zeitungsnotiz verharmlosend wahrhaben möchte. Unfälle entstehen stets im Zusammenlaufen mehrerer Kausallinien, im Schnittpunkt einer Reihe ungünstiger Umstände und Fehlverhaltensweisen.“"
                                            },
                                            {
                                                "example_id": "956a4eef-df72-46fa-9326-938b3c04f075",
                                                "sense_id": "2b8d8567-6ab2-33c5-bf85-5dd0430c47f5",
                                                "text": "Das ist eine ungünstige Einbausituation."
                                            },
                                            {
                                                "example_id": "12bed7c9-643f-463c-8760-d9c16a5d354f",
                                                "sense_id": "2b8d8567-6ab2-33c5-bf85-5dd0430c47f5",
                                                "text": "Die Gelegenheit ist ungünstig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "383addba-3893-466d-9c72-af81b88d6e85",
                        "source_entry_id": "1e923da5-f74f-366f-afaf-f3782003b8c1",
                        "source_sense_id": "86652a38-f89f-3e29-a6ae-9421885ca0e9",
                        "target_lang_word": "inauspicious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inauspicious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39b7839c-f3a1-31c7-8d5f-201dfbbb77bf",
                                        "entry_id": "ca54a653-3234-3630-a1fb-0a061adb8b38",
                                        "glosses": [
                                            "Not auspicious; ill-omened"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77e1d07d-0608-42d4-9ed0-1a169af4a82f",
                                                "sense_id": "39b7839c-f3a1-31c7-8d5f-201dfbbb77bf",
                                                "text": "And shake the yoke of inauspicious stars."
                                            },
                                            {
                                                "example_id": "ced730a8-e0ad-4065-a015-0f2ca09da732",
                                                "sense_id": "39b7839c-f3a1-31c7-8d5f-201dfbbb77bf",
                                                "text": "Inauspicious love."
                                            },
                                            {
                                                "example_id": "efcfc793-fc25-4221-9abb-d2e7ea8ba69e",
                                                "sense_id": "39b7839c-f3a1-31c7-8d5f-201dfbbb77bf",
                                                "text": "1788, John Jay, as Publius, The Federalist, II\nIt is not to be wondered at that a government instituted in times so inauspicious, should on experiment be found greatly deficient and inadequate to the purpose it was intended to answer."
                                            },
                                            {
                                                "example_id": "802c8149-48a9-4f10-86c3-23e66da6fd50",
                                                "sense_id": "39b7839c-f3a1-31c7-8d5f-201dfbbb77bf",
                                                "text": "Class 745/1s suffered an inauspicious entry into traffic on the Stansted Express route on July 28, when the two units supplied (745103/106) both failed, as did a train sent to cover them (745108)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebff66ca-aa2a-41f9-b4a2-c2d4e14cce6f",
                        "source_entry_id": "1e923da5-f74f-366f-afaf-f3782003b8c1",
                        "source_sense_id": "86652a38-f89f-3e29-a6ae-9421885ca0e9",
                        "target_lang_word": "foreboding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foreboding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa698d85-43b7-34eb-b51c-bd8656e4a32e",
                                        "entry_id": "2cb54fa3-4559-3d75-8b9f-6e63d321236c",
                                        "glosses": [
                                            "A sense of evil to come."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbd45189-59a9-46b3-b6af-7d0a121da6ee",
                                                "sense_id": "fa698d85-43b7-34eb-b51c-bd8656e4a32e",
                                                "text": "To me there is something sad in his life, and sometimes I have a sort of foreboding about him. I don't know why, but I fancy he will have some great trouble—perhaps an unhappy end."
                                            },
                                            {
                                                "example_id": "2772270a-7b20-4ba2-b633-3710f5254224",
                                                "sense_id": "fa698d85-43b7-34eb-b51c-bd8656e4a32e",
                                                "text": "A sense of foreboding, the like of which he had never known before, hung heavily on him."
                                            },
                                            {
                                                "example_id": "000d585d-86ff-42b6-a9c4-24adf65f57b5",
                                                "sense_id": "fa698d85-43b7-34eb-b51c-bd8656e4a32e",
                                                "text": "I feel a slight foreboding about going home this year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a70def-5469-3b20-8c83-2d5279120e4f",
                                        "entry_id": "2cb54fa3-4559-3d75-8b9f-6e63d321236c",
                                        "glosses": [
                                            "An evil omen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26994d4a-3076-4bcd-9b69-26f94cdf8f13",
                                                "sense_id": "16a70def-5469-3b20-8c83-2d5279120e4f",
                                                "text": "The news possessed me with foreboding."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "foreboding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b319c9d-91d3-3af7-83f8-152a22b70b8f",
                                        "entry_id": "5df84ce0-b34c-37a2-8b46-83e7b6624401",
                                        "glosses": [
                                            "Of ominous significance; serving as an ill omen; foretelling of harm or difficulty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3043e7fa-eea9-4a97-93b8-491a31de42e8",
                                                "sense_id": "5b319c9d-91d3-3af7-83f8-152a22b70b8f",
                                                "text": "Blood on the street / Foreboding god complex / She never knew she was next"
