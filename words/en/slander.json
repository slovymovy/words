{
    "word_family": [
        "slanderous",
        "slanderer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a9c4d178-5a1d-3b4a-8053-6878633c5c65",
                    "sense_definition": "A false and malicious spoken statement that damages a person's reputation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "defamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician sued his former colleague for <w>slander</w> after she made false claims about his business at a public meeting.",
                            "target_lang_translations": {
                                "tr": "Siyasetçi, halka açık bir toplantıda işi hakkında asılsız iddialarda bulunduktan sonra eski meslektaşına <w>iftira</w> davası açtı."
                            }
                        },
                        {
                            "text": "She felt that the rumors spread by her coworker were nothing more than malicious <w>slander</w>.",
                            "target_lang_translations": {
                                "tr": "İş arkadaşı tarafından yayılan söylentilerin kötü niyetli bir <w>iftiradan</w> başka bir şey olmadığını düşünüyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "defamation",
                        "calumny",
                        "disparagement"
                    ],
                    "antonyms": [
                        "glorification"
                    ],
                    "common_phrases": [
                        "commit slander",
                        "slander suit"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir kişinin itibarını zedelemek amacıyla söylenen asılsız ve kötü niyetli sözlü beyan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "iftira",
                                "target_lang_sense_clarification": "Birine asılsız suç yükleme anlamında genel terim."
                            },
                            {
                                "target_lang_word": "sözle iftira",
                                "target_lang_sense_clarification": "Özellikle sözlü olarak yapılan karalama."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fa2af364-b8f1-3f4f-a07f-d08c9d638894",
                    "sense_definition": "To make false and damaging spoken statements about someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "defamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was angry because his rival tried to <w>slander</w> his character during the public debate.",
                            "target_lang_translations": {
                                "tr": "Rakibi halka açık tartışma sırasında kişiliğini <w>karalamaya</w> çalıştığı için öfkeliydi."
                            }
                        },
                        {
                            "text": "It is wrong to <w>slander</w> innocent people just to gain a professional advantage.",
                            "target_lang_translations": {
                                "tr": "Sırf mesleki bir avantaj elde etmek için masum insanlara <w>iftira atmak</w> yanlıştır."
                            }
                        }
                    ],
                    "synonyms": [
                        "defame"
                    ],
                    "antonyms": [
                        "glorify"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birisi hakkında asılsız ve zarar verici sözlü beyanlarda bulunmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "iftira atmak",
                                "target_lang_sense_clarification": "Birine asılsız suçlama yöneltmek eylemi."
                            },
                            {
                                "target_lang_word": "karalamak",
                                "target_lang_sense_clarification": "Birinin itibarını zedeleyici sözler söylemek."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}