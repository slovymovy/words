                    },
                    {
                        "sense_id": "109a211b-9999-34e0-83c0-42ad072f0574",
                        "entry_id": "03152330-25b7-3509-9dc3-8ff48ff6e13e",
                        "glosses": [
                            "The business and work that a milliner engages in."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "70e04e44-89e3-47e1-9eb3-f6e51c242d1c",
                                "sense_id": "109a211b-9999-34e0-83c0-42ad072f0574",
                                "text": "They used to tell one about a kid asking his grumpy old man when they were walking to the park, \"What's the name of this flower, Papa?\" And the old guy is peevish and he yells, \"How should I know? Am I in the milinery business?\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48c45598-8a54-424e-9468-e0adfb52fdfb",
                        "source_entry_id": "03152330-25b7-3509-9dc3-8ff48ff6e13e",
                        "source_sense_description": "A shop with women's hats",
                        "target_lang_word": "Hutgeschäft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hutgeschäft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "185375a4-e3af-3a98-96c9-7e5f7d4959c5",
                                        "entry_id": "e4a0da04-3f8c-31dc-86f8-00a0d05319c7",
                                        "glosses": [
                                            "Geschäft, das Hüte verkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d2b9390-8907-4a0d-84f9-8541c6b91d69",
                                                "sense_id": "185375a4-e3af-3a98-96c9-7e5f7d4959c5",
                                                "text": "„Die Kränze lagen daneben, übereinandergschichtet, wie Hüte in einem Hutgeschäft.“"
                                            },
                                            {
                                                "example_id": "8abf844e-69a5-4655-8fc8-b7df7a880228",
                                                "sense_id": "185375a4-e3af-3a98-96c9-7e5f7d4959c5",
                                                "text": "„Eines Tages begleitete Adam Nina in ein Hutgeschäft am Hanover Square und sah zu seiner Erbauung auf allen Stühlen und Tischchen Bänderschachteln umherliegen, die ostentativ Mrs. Andrew Quests Adresse trugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10db8122-b5b5-4f28-b4cb-d51037f3db99",
                        "source_entry_id": "03152330-25b7-3509-9dc3-8ff48ff6e13e",
