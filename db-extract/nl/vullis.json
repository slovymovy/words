                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "27c98037-2d75-438e-878a-fc1b5c258ac5",
                                "sense_id": "c2f6863d-cdf7-3cf7-b346-536feaef2698",
                                "text": "De ambtenaren verzinnen steeds deftiger namen voor ons - gemeentereiniger en duobakbeladers en zo -, maar wat wij doen, is en blijft gewoon vullis ophalen."
                            }
                        ]
                    },
                    {
                        "sense_id": "9012e6fc-c036-3c78-9992-1c3079f84e31",
                        "entry_id": "cdc8d394-42b1-36c1-8aa6-85c39c526626",
                        "glosses": [
                            "iets of iemand zonder waarde waarvan je je beter kunt ontdoen"
                        ],
                        "tags": [
