                                "target_senses": [
                                    {
                                        "sense_id": "b11f07a2-34fd-3647-9860-dd65128337e3",
                                        "entry_id": "05134996-0beb-3ea0-a798-680674da3a82",
                                        "glosses": [
                                            "A biting fly of the genus Oestrus; a botfly."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c454751-3472-4cec-8301-a1ff14a222d5",
                                                "sense_id": "b11f07a2-34fd-3647-9860-dd65128337e3",
                                                "text": "[…] and which is produced by the larvae of oestri and particularly of Oestrus hemorrhoidalis."
                                            },
                                            {
                                                "example_id": "7f792f44-85af-46f7-9744-f7920262705c",
                                                "sense_id": "b11f07a2-34fd-3647-9860-dd65128337e3",
                                                "text": "If this is inseparable from the oeconomy of nature, it necessarily follows that man must be subject to the depredations of oestri, ichneumons, . . . and perhaps, thousands of others, which the senses, aided by the directions of a correct understanding, may be able to trace in a way that will fall very little short of absolute demonstration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb541a12-0482-30aa-b426-991605aa6491",
                                        "entry_id": "05134996-0beb-3ea0-a798-680674da3a82",
                                        "glosses": [
                                            "A bite or sting."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "929a3182-40b2-3b65-a015-db179dd72c64",
                                        "entry_id": "05134996-0beb-3ea0-a798-680674da3a82",
                                        "glosses": [
                                            "A passion or frenzy."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "647a3e87-de53-3c06-80eb-17b6fdceea17",
                                        "entry_id": "05134996-0beb-3ea0-a798-680674da3a82",
                                        "glosses": [
                                            "A female animal's readiness to mate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4490935b-cce7-4714-a0a9-199e82e41cf5",
                                                "sense_id": "647a3e87-de53-3c06-80eb-17b6fdceea17",
                                                "text": "In those monoestrous species in which the male is capable all the year round, it is found that the oestri of individual females come at different seasons."
                                            },
                                            {
                                                "example_id": "ca4b3244-6152-40a6-bd3f-a2bd33c3d051",
                                                "sense_id": "647a3e87-de53-3c06-80eb-17b6fdceea17",
                                                "text": "A vasectomized Philippine carabao bull was used as a teaser to determine the occurrence and recurrence of oestri."
                                            },
                                            {
                                                "example_id": "6e3cde0b-fde0-407e-b80c-02cf77c0bed7",
                                                "sense_id": "647a3e87-de53-3c06-80eb-17b6fdceea17",
                                                "text": "An evaluation was carried out so that the mean number of oestri per one animal was calculated for 14 days in the three periods: […]"
                                            },
                                            {
                                                "example_id": "4eb45490-a67b-4cef-a9b8-bdb6952160fc",
                                                "sense_id": "647a3e87-de53-3c06-80eb-17b6fdceea17",
                                                "text": "Intervals between oestri and between ovulations in dairy cows within 100 days post partum"
                                            },
                                            {
                                                "example_id": "75f92928-1ebb-4c93-9de5-4fbf5cbc85d6",
                                                "sense_id": "647a3e87-de53-3c06-80eb-17b6fdceea17",
                                                "text": "It’s the supremely human act, freely to fuck, not because you are on heat, or in oestrus, like an animal, but to give and receive pleasure."
                                            },
                                            {
                                                "example_id": "02c0f202-7789-4066-85ba-4a1944da3ed2",
                                                "sense_id": "647a3e87-de53-3c06-80eb-17b6fdceea17",
                                                "text": "The substantial genital swelling of [female chimpanzees] during oestrus may facilitate transmission of viruses by making the mucosa more fragile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
