    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "29cd0d7e-1171-30a2-a28a-25d4ce64cbe9",
                    "sense_definition": "Переместить что-либо волоком или с усилием вниз или с какой-либо поверхности.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рабочие <w>стащили</w> тяжелый ящик с лестницы.",
                            "target_lang_translations": {
                                "en": "The workers <w>dragged</w> the heavy box down the stairs.",
                                "es": "Los trabajadores <w>bajaron</w> la caja pesada de la escalera.",
                                "fr": "Les ouvriers ont <w>fait glisser</w> la lourde caisse de l'escalier."
                            }
                        },
                        {
                            "text": "Он <w>стащил</w> одеяло с кровати, когда проснулся.",
                            "target_lang_translations": {
                                "en": "He <w>pulled</w> the blanket off the bed when he woke up.",
                                "es": "Él <w>quitó</w> la manta de la cama cuando se despertó.",
                                "fr": "Il a <w>tiré</w> la couverture du lit en se réveillant."
                            }
                        }
                    ],
                    "antonyms": [
                        "натянуть",
                        "надеть"
                    ],
                    "common_phrases": [
                        "стащить с полки",
                        "стащить со стола"
                    ],
                    "target_lang_definitions": {
                        "en": "To move something by dragging or pulling it down from a surface or position.",
                        "es": "Mover algo arrastrando o con esfuerzo hacia abajo o desde una superficie.",
                        "fr": "Déplacer quelque chose en le tirant ou avec effort vers le bas ou depuis une surface."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drag off",
                                "target_lang_sense_clarification": "To pull something away from a surface or location."
                            },
                            {
                                "target_lang_word": "pull down",
                                "target_lang_sense_clarification": "To move something from a higher position to a lower one."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "bajar",
                                "target_lang_sense_clarification": "mover algo desde una posición alta hacia abajo"
                            },
                            {
                                "target_lang_word": "arrastrar",
                                "target_lang_sense_clarification": "mover algo tirando de ello por el suelo"
                            },
                            {
                                "target_lang_word": "quitar",
                                "target_lang_sense_clarification": "retirar algo de una superficie"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "faire glisser",
                                "target_lang_sense_clarification": "déplacer un objet le long d'une surface"
                            },
                            {
                                "target_lang_word": "tirer",
                                "target_lang_sense_clarification": "action de déplacer en exerçant une force"
                            },
                            {
                                "target_lang_word": "descendre",
                                "target_lang_sense_clarification": "faire passer quelque chose d'un niveau supérieur à un niveau inférieur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "626e9aee-3f91-30b7-8943-62adad55c7e6",
                    "sense_definition": "Снять с себя или с кого-то плотно прилегающую одежду или обувь.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мальчик с трудом <w>стащил</w> мокрые сапоги после прогулки.",
                            "target_lang_translations": {
                                "en": "The boy struggled to <w>pull off</w> his wet boots after the walk.",
                                "es": "El niño se <w>quitó</w> con dificultad las botas mojadas después del paseo.",
                                "fr": "Le garçon a eu du mal à <w>enlever</w> ses bottes mouillées après la promenade."
                            }
                        },
                        {
                            "text": "Она <w>стащила</w> тесную перчатку с руки.",
                            "target_lang_translations": {
                                "en": "She <w>pulled off</w> the tight glove from her hand.",
                                "es": "Ella se <w>quitó</w> el guante ajustado de la mano.",
                                "fr": "Elle a <w>retiré</w> son gant serré de sa main."
                            }
                        }
                    ],
                    "synonyms": [
                        "снять",
                        "стянуть"
                    ],
                    "antonyms": [
                        "надеть"
                    ],
                    "common_phrases": [
                        "стащить сапоги",
                        "стащить перчатку"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To remove tight-fitting clothing or footwear from oneself or someone else.",
                        "es": "Quitarse o quitar a alguien una prenda de vestir o calzado que queda ajustado.",
                        "fr": "Retirer un vêtement ou une chaussure serrée de soi-même ou de quelqu'un d'autre."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pull off",
                                "target_lang_sense_clarification": "To remove clothing or accessories by pulling."
                            },
                            {
                                "target_lang_word": "take off",
                                "target_lang_sense_clarification": "General term for removing clothing or footwear."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "quitarse",
                                "target_lang_sense_clarification": "retirar una prenda de vestir"
                            },
                            {
                                "target_lang_word": "despojarse",
                                "target_lang_sense_clarification": "quitarse algo con esfuerzo o de forma decidida"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "enlever",
                                "target_lang_sense_clarification": "terme général pour retirer un vêtement"
                            },
                            {
                                "target_lang_word": "retirer",
                                "target_lang_sense_clarification": "action de se dévêtir ou de déchausser"
                            },
                            {
                                "target_lang_word": "ôter",
                                "target_lang_sense_clarification": "terme un peu plus soutenu pour retirer un vêtement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04af259c-812a-36d8-9407-98c4c7c4c2f5",
                    "sense_definition": "Тайно присвоить чужую вещь.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Кто-то <w>стащил</w> мой кошелек в автобусе.",
                            "target_lang_translations": {
                                "en": "Someone <w>pinched</w> my wallet on the bus.",
                                "es": "Alguien <w>robó</w> mi cartera en el autobús.",
                                "fr": "Quelqu'un a <w>volé</w> mon portefeuille dans le bus."
                            }
                        },
                        {
                            "text": "Собака <w>стащила</w> кусок мяса со стола, пока никто не видел.",
                            "target_lang_translations": {
                                "en": "The dog <w>swiped</w> a piece of meat from the table while no one was looking.",
                                "es": "El perro <w>robó</w> un trozo de carne de la mesa mientras nadie miraba.",
                                "fr": "Le chien a <w>dérobé</w> un morceau de viande sur la table pendant que personne ne regardait."
                            }
                        }
                    ],
                    "synonyms": [
                        "украсть",
                        "своровать",
                        "спереть",
                        "стибрить"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To secretly take someone else's property; to steal.",
                        "es": "Apoderarse secretamente de algo ajeno.",
                        "fr": "S'approprier secrètement un objet appartenant à autrui."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pinch",
                                "target_lang_sense_clarification": "Informal term for stealing something small or inconsequential."
                            },
                            {
                                "target_lang_word": "swipe",
                                "target_lang_sense_clarification": "Informal term for snatching or stealing something quickly."
                            },
                            {
                                "target_lang_word": "filch",
                                "target_lang_sense_clarification": "To steal something of low value, often in a sneaky way."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "robar",
                                "target_lang_sense_clarification": "tomar algo ajeno sin permiso"
                            },
                            {
                                "target_lang_word": "hurtar",
                                "target_lang_sense_clarification": "robar algo sin usar violencia"
                            },
                            {
