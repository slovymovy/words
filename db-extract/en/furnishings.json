                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "978531c8-3a70-3f28-a94f-3fce0725947a",
                                        "entry_id": "99e699bf-fb5b-3ef4-ab31-33118ffbbfdb",
                                        "glosses": [
