                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2db9f7a0-5333-4f5c-92e7-c69b730ed87a",
                                "sense_id": "219716bf-0755-3807-8fad-9ddfd6a1ff27",
                                "text": "„Roman beobachtete die atemberaubende Kletterei vom Balkon der Bertinis aus, vier Meter tiefer, wobei er weit über das Geländer gebeugt war und innige Gebete zugunsten des Kletterers gen Himmel sandte.“"
                            },
                            {
                                "example_id": "37c359b3-8c35-461e-bb70-0ac6b7cf38db",
                                "sense_id": "219716bf-0755-3807-8fad-9ddfd6a1ff27",
                                "text": "„Nach einer anstrengenden Kletterei über ein paar Felsen und durch den Fluss sahen wir ein weiteres »Kunstwerk« und machten wieder anerkennende Geräusche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
