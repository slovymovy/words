                "senses": [
                    {
                        "sense_id": "9542e786-f348-3682-ab8b-4b80c7fcefeb",
                        "entry_id": "96c68867-eb1a-3267-932d-08fd05d57fe0",
                        "glosses": [
                            "Prendre tout d’un coup avec la gueule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97a058cf-9f08-4a9a-ae51-ecaf56c4bc2c",
                                "sense_id": "9542e786-f348-3682-ab8b-4b80c7fcefeb",
                                "text": "Ce chien engoule tout ce qu’on lui jette."
                            },
                            {
                                "example_id": "e40e9b28-a314-4eb6-9f8e-c8bdaad7fc57",
                                "sense_id": "9542e786-f348-3682-ab8b-4b80c7fcefeb",
                                "text": "Je ne suis pas, comme le triste duc de Milan, une misérable guivre engoulant un nourrisson !"
                            },
                            {
                                "example_id": "31988b40-707e-44e2-8b39-a33328b4c0ed",
                                "sense_id": "9542e786-f348-3682-ab8b-4b80c7fcefeb",
                                "text": "Un bossu passe, un glouton engoule sa pitance, un monsieur sérieux esquisse une grimace, une grosse dame tombe et rebondit, – sources de rires…"
                            }
                        ]
                    }
