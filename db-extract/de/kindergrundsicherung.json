                ],
                "senses": [
                    {
                        "sense_id": "4b6c2cf7-641b-326b-a0fa-0679a8107cd7",
                        "entry_id": "a119c187-7876-34ac-889d-d774adad445c",
                        "glosses": [
                            "Transferleistung des Staates an Eltern zur Sicherstellung des Lebensunterhaltes ihrer Kinder und Jugendlichen (bis zum 18. Lebensjahr)"
                        ],
                        "tags": [
                            "Germany",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e3abc6b9-a0ec-492c-b352-a9055829227d",
                                "sense_id": "4b6c2cf7-641b-326b-a0fa-0679a8107cd7",
                                "text": "„Wir wollen mit der Kindergrundsicherung bessere Chancen für Kinder und Jugendliche schaffen und konzentrieren uns auf die, die am meisten Unterstützung brauchen.“"
                            },
                            {
                                "example_id": "56936185-95d6-4ed0-baaf-e6db7c414a22",
                                "sense_id": "4b6c2cf7-641b-326b-a0fa-0679a8107cd7",
                                "text": "„2 Milliarden oder 12 Milliarden: Was darf die Kindergrundsicherung, das Prestigevorhaben der Grünen, kosten? Die Bundesregierung ist sich uneins.“"
                            },
                            {
                                "example_id": "55fd8059-0ca2-40a9-bdd1-ea8c19132d34",
                                "sense_id": "4b6c2cf7-641b-326b-a0fa-0679a8107cd7",
                                "text": "„Die Kindergrundsicherung gilt als das wichtigste sozialpolitische Vorhaben der Bundesregierung.“"
                            },
                            {
                                "example_id": "9dd3f468-5e72-4590-869b-62f772c62235",
                                "sense_id": "4b6c2cf7-641b-326b-a0fa-0679a8107cd7",
                                "text": "[Schlagzeile:] „Familienpolitik – Streit um Kindergrundsicherung“"
                            },
                            {
                                "example_id": "77dbf128-4363-4b6f-ae7a-1befd52274af",
                                "sense_id": "4b6c2cf7-641b-326b-a0fa-0679a8107cd7",
                                "text": "„2,4 Milliarden Euro will die Bundesregierung 2025 ausgeben, um die Kindergrundsicherung zu finanzieren.“"
                            },
                            {
                                "example_id": "529313ab-f02a-40ba-b5e3-6853976ec672",
                                "sense_id": "4b6c2cf7-641b-326b-a0fa-0679a8107cd7",
                                "text": "„Die Kindergrundsicherung besteht demnach aus einem einkommensunabhängigen \"Kindergarantiebetrag\" (bisher bekannt als Kindergeld) sowie einem altersabhängigen \"Kinderzusatzbetrag\", der vom Einkommen abhänge.“"
                            },
                            {
                                "example_id": "63a71031-ba0d-4494-94ac-32f23729c807",
                                "sense_id": "4b6c2cf7-641b-326b-a0fa-0679a8107cd7",
                                "text": "[Bundesfinanzminister Lindner suggerierte,] „Eltern mit Migrationshintergrund könnten sich wegen einer zu hohen Kindergrundsicherung auf die faule Haut legen.“"
                            },
                            {
                                "example_id": "9a404c0c-03c5-48a6-af8c-bfb17224396c",
                                "sense_id": "4b6c2cf7-641b-326b-a0fa-0679a8107cd7",
                                "text": "„Kinderschutz- und Sozialverbände hatten den geplanten Umfang der Kindergrundsicherung von 2,4 Milliarden Euro als unzureichend bezeichnet.“"
                            },
                            {
                                "example_id": "6d8686a3-3913-4554-99d2-d9f895300e9a",
                                "sense_id": "4b6c2cf7-641b-326b-a0fa-0679a8107cd7",
                                "text": "[Marcel Fratzscher:] „Die verhandelte Lösung zur Kindergrundsicherung ist ein enttäuschender Kompromiss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
