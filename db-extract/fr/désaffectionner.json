                ],
                "senses": [
                    {
                        "sense_id": "2be1b215-2265-3755-9356-89146fa18c28",
                        "entry_id": "f1a6c804-bd0b-3219-b661-52508d129e93",
                        "glosses": [
                            "Faire perdre son affection à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67e14e4b-52c0-4fa6-8a83-a096e8683998",
                                "sense_id": "2be1b215-2265-3755-9356-89146fa18c28",
                                "text": "La morgue de la noblesse de cour désaffectionna du trône la noblesse de province, autant que celle-ci désaffectionnait la bourgeoisie en en froissant toutes les vanités."
                            },
                            {
                                "example_id": "e17ac171-9bba-41ea-9c96-510b8785ea03",
                                "sense_id": "2be1b215-2265-3755-9356-89146fa18c28",
                                "text": "Rose-Marie-Victoire craignait tant, en déplaisant à son époux, en le heurtant, de le désaffectionner, d’être privée de sa compagnie, qu’elle lui aurait sacrifié tout, même son oncle."
                            }
                        ]
                    },
                    {
                        "sense_id": "c307ec50-3f5f-3afd-b65c-532835ec76d0",
                        "entry_id": "f1a6c804-bd0b-3219-b661-52508d129e93",
                        "glosses": [
                            "Cesser d’avoir de l’affection pour quelqu’un ou pour quelque chose."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "d0364b5c-0a2a-4d13-a16a-804b22480a90",
                                "sense_id": "c307ec50-3f5f-3afd-b65c-532835ec76d0",
                                "text": "Beaucoup s’en vont. Ceux qui restent se désaffectionnent de leur champ ; ils traînent leurs ennuis sur la glèbe, tourmentés par des aspirations vagues, des idées confuses d’ambitions nouvelles et de jouissances qu’ils ne connaîtront jamais."
                            }
                        ]
                    }
                ],
