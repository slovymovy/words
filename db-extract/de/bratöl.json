                ],
                "senses": [
                    {
                        "sense_id": "1591a991-2cf2-36d4-a927-473950dcc611",
                        "entry_id": "95528380-97dc-33ed-a103-0670293aaa10",
                        "glosses": [
                            "Öl aus pflanzlichen oder tierischen Quellen, das sich zum Braten eignet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4cfba75-969a-4903-a438-c093715b5b12",
                                "sense_id": "1591a991-2cf2-36d4-a927-473950dcc611",
                                "text": "„Als Bratöl ist es aufgrund seiner Hitzeempfindlichkeit ungeeignet.“"
                            },
                            {
                                "example_id": "82b9bfa2-cc46-4ea2-b48b-cc6dae93a53b",
                                "sense_id": "1591a991-2cf2-36d4-a927-473950dcc611",
                                "text": "„Die Bezeichnung Bratöl verdienten sie hingegen nicht.“"
                            },
                            {
                                "example_id": "26030131-6e6f-485d-8dab-918359a1326f",
                                "sense_id": "1591a991-2cf2-36d4-a927-473950dcc611",
                                "text": "„Aufgrund des hohen Ölsäuregehaltes ist das Bratöl hocherhitzbar und daher ideal zum Braten, Backen, Kochen, Dünsten und Frittieren geeignet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
