                        "examples": [
                            {
                                "example_id": "8210cc2b-79ca-4fa1-bab9-8ea5aaabc49b",
                                "sense_id": "0843f85b-dfbb-3cb0-9998-e42a9fc6cfa1",
                                "text": "Qui nous dira le juste nom\nDe Van Hasselt, le vieux pédoque,\nQuatre fortins à munitions\nOn fait au bled quatre breloques."
                            },
                            {
                                "example_id": "1eaae3f1-4d2e-4ebf-b488-680cfd67fdd3",
                                "sense_id": "0843f85b-dfbb-3cb0-9998-e42a9fc6cfa1",
                                "text": "Le genre de mignon cul pommé que tu ne peux pas t’empêcher de regarder circonvoluer, même quand t’es pédoque, retraité des chemins de fer, académicien, sportif endurci, bandeur mou, phallocrate, boy-scout, pasteur, vérolé ou autres."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae26ce7d-e42f-32d8-b7ee-98b31f20e391",
                        "entry_id": "85fa8d7d-0f5f-3d7b-a27e-fcd7f2bb1b76",
