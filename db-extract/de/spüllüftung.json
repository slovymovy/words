                "senses": [
                    {
                        "sense_id": "0697cfe4-2bba-338c-b98c-ac155701003f",
                        "entry_id": "dfb2d34d-21ec-3261-bef8-86b07d98b41c",
                        "glosses": [
                            "Technik: Lüftungsart und Lüftungstechnik zur kurzzeitigen spülenden Lüftung eines Raumes oder Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8bf8ee8-bb57-4f0a-b38c-934a8d1099f9",
                                "sense_id": "0697cfe4-2bba-338c-b98c-ac155701003f",
                                "text": "„Die Spüllüftung muss automatisch in Betrieb gesetzt werden.“"
                            },
                            {
                                "example_id": "2b029174-9dc0-4a49-93bf-2d1135a37ad3",
                                "sense_id": "0697cfe4-2bba-338c-b98c-ac155701003f",
                                "text": "„Der Mindestvolumenstrom einer Rauch-Druck-Anlage zur Spüllüftung beträgt 10.000m³/h.“"
                            },
                            {
                                "example_id": "7243188f-8341-48d1-a5b6-548a13929516",
                                "sense_id": "0697cfe4-2bba-338c-b98c-ac155701003f",
                                "text": "„Fürsorgliche Eigentümer rüsten, wie beschrieben, rechtzeitig die oft bestehende RWA zur sogenannten Spüllüftung auf.“"
                            },
                            {
                                "example_id": "82968b84-6e9e-4883-8a09-d32f31b438dc",
                                "sense_id": "0697cfe4-2bba-338c-b98c-ac155701003f",
                                "text": "„Die beiden Treppenhäuser im Hof werden als „sichere Treppenräume“ mit Spüllüftung gemäß Brandschutzkonzept ausgebildet.“"
                            },
                            {
                                "example_id": "7219b831-1cbb-4306-b60c-da68888becb9",
                                "sense_id": "0697cfe4-2bba-338c-b98c-ac155701003f",
                                "text": "„In den heißeren Monaten können die Häuser geöffnet und durch Spüllüftung gekühlt werden, während interne und externe Überwachungssysteme helfen, den solaren Wärmegewinn zu kontrollieren, sodass ein angenehmes Raumklima entsteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
