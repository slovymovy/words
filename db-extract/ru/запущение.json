                "senses": [
                    {
                        "sense_id": "78a11705-ecfc-3843-b830-b58c549f3f2e",
                        "entry_id": "76565c6c-e13e-35f6-8946-4a8d17cd7487",
                        "glosses": [
                            "действие по значению гл. запускать II, a также результат такого действия; заброшенность, запустение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d41caeb-fa48-4663-aa20-05534905e8e3",
                                "sense_id": "78a11705-ecfc-3843-b830-b58c549f3f2e",
                                "text": "…и на террасе самый дворец. Он запущен, но и в запущении изумляет странника остатками великолепия."
                            },
                            {
                                "example_id": "80378658-3d8e-4f62-8427-b4eb181981a1",
                                "sense_id": "78a11705-ecfc-3843-b830-b58c549f3f2e",
                                "text": "Вот здешний почтмейстер совершенно ничего не делает: все дела в большом запущении, посылки задерживаются… извольте сами нарочно разыскать."
                            }
                        ]
                    }
