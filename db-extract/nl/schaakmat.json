                                                "example_id": "2f2fc803-a760-4813-91ba-058b91e07c0d",
                                                "sense_id": "d443d185-929e-34c1-bf56-b2de76ddb61a",
                                                "text": "The game is won by the player who has checkmated his/her opponent’s king."
                                            }
