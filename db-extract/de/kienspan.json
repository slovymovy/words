                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b61a8ce-7cce-333a-a850-8e15c289149d",
                        "entry_id": "0c708d06-6d21-3ec8-8f0a-e2bc800cccfb",
                        "glosses": [
                            "Span aus harzhaltigem Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "375ae152-d133-4646-979a-1db1088a07ef",
                                "sense_id": "2b61a8ce-7cce-333a-a850-8e15c289149d",
                                "text": "„Die Kienspäne waren fast heruntergebrannt.“"
                            },
                            {
                                "example_id": "853a0635-ca72-48be-9dae-bfe5ab1775e5",
                                "sense_id": "2b61a8ce-7cce-333a-a850-8e15c289149d",
                                "text": "„Morgens füttert und putzt er das Pferd, und die Anderthalbmeter-Großmutter facht mit Kienspänen ein Feuer im flachen Küchenherd an.“"
                            },
                            {
                                "example_id": "a49a225c-8ce8-48c6-b16d-20ef398ded33",
                                "sense_id": "2b61a8ce-7cce-333a-a850-8e15c289149d",
                                "text": "„Vielleicht verstanden sich die alten Germanen auf die Herstellung ihrer Kienspäne doch besser.“"
                            },
                            {
                                "example_id": "7e08decc-f68f-4a98-9f50-1aa7fb1a8899",
                                "sense_id": "2b61a8ce-7cce-333a-a850-8e15c289149d",
                                "text": "„Im Leutehause hatte man Kienspäne und Lichter angezündet, und niemand wollte sich schlafen legen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
