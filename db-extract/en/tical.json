                                                "sense_id": "32675470-ec96-3eb5-9db2-fc9affcab786",
                                                "text": "Die Gattung Cannabis wurde ursprünglich anhand von \"Cannabis sativa\" als monotypische Gattung von Carl von Linne 1753 erstbeschrieben."
                                            },
                                            {
                                                "example_id": "86226301-7ff8-46e3-896c-603047d33ee9",
                                                "sense_id": "32675470-ec96-3eb5-9db2-fc9affcab786",
                                                "text": "„Auf insgesamt 47 Hektaren wird ab sofort Cannabis für medizinische Einsatzzwecke angebaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86992200-2b21-3fba-b9e5-58d0870d223c",
                                        "entry_id": "ea3adc85-2245-3754-b448-3422674c9923",
                                        "glosses": [
                                            "Sammelbezeichnung für verschiedene Rauschmittel, die aus Hanfsorten gewonnen werden"
                                        ],
                                        "tags": [
