                "senses": [
                    {
                        "sense_id": "6d7f6063-13ff-3f1c-9974-0396eba6b69c",
                        "entry_id": "92402514-b912-39d1-93c6-981b521edc79",
                        "glosses": [
                            "Glücksspiel um Geld in gewerblichem Rahmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c51ddbc0-a6cb-4c66-b6f3-6dd793534472",
                                "sense_id": "6d7f6063-13ff-3f1c-9974-0396eba6b69c",
                                "text": "„Eine Urform des Casinospiels mit der Kugel könnte auch das Hoca-Spiel gewesen sein, das Hobby des mächtigen Kardinals Mazarin […], mit dem er als Staatsmann den ständig leeren Beutel des Sonnenkönigs füllte und dabei natürlich auch die eigenen Taschen nicht vergaß.“"
                            },
                            {
                                "example_id": "1bb6d68f-2a83-4903-a36f-abbf4f6a26e1",
                                "sense_id": "6d7f6063-13ff-3f1c-9974-0396eba6b69c",
                                "text": "„Blackjack ist als Casinospiel noch verhältnismäßig jung und wenig erprobt.“"
                            },
                            {
                                "example_id": "f7327c04-4cc6-445e-8e01-6b6a4eeaceb4",
                                "sense_id": "6d7f6063-13ff-3f1c-9974-0396eba6b69c",
                                "text": "„Poker- und Casinospiele im Internet sollen nicht erlaubt werden.“"
                            },
                            {
                                "example_id": "cfbd5189-4494-428c-b812-0c3ede3452f1",
                                "sense_id": "6d7f6063-13ff-3f1c-9974-0396eba6b69c",
                                "text": "„Casinospiele und Poker im Internet werde es nicht geben - Kiel hingegen erlaubt es.“"
                            },
                            {
                                "example_id": "ee0d3563-066c-4dba-8013-14d3f4022032",
                                "sense_id": "6d7f6063-13ff-3f1c-9974-0396eba6b69c",
                                "text": "„Anders verhält es sich mit Black Jack, dem weltweit einzigen Casinospiel, bei dem die Bank auf mathematischer Grundlage dauerhaft zu schlagen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
