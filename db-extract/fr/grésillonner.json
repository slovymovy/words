                        "glosses": [
                            "Pousser son cri, en parlant du grillon, de la sauterelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "496dee54-1320-4ad2-a06a-b3152aff8485",
                                "sense_id": "6a30eda8-a22c-391c-bd6a-823074eb4a06",
                                "text": "Déjà les étincelles de lumière que jettent les vers luisants commençaient à pâlir ; les grillons, les lézards avaient cessé de grésillonner ; je n’entendais plus les monotones croassements de la grenouille, ni le cri sinistre du tigre."
                            }
                        ]
