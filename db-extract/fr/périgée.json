        "fr-extract.jsonl": [
            {
                "entry_id": "bc133746-fa27-3335-9be9-9d2bdce5241a",
                "word": "périgée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fe37a911-48a9-4b3f-a05d-c2e57160d5ee",
                        "entry_id": "bc133746-fa27-3335-9be9-9d2bdce5241a",
                        "tags": [
                            "plural"
                        ],
                        "form": "périgées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e215feb4-dc7a-3c8a-9a3f-56967285a1ba",
                        "entry_id": "bc133746-fa27-3335-9be9-9d2bdce5241a",
                        "glosses": [
                            "Sur une orbite ayant pour foyer la Terre, point le plus proche de celle-ci ; autrement dit, le périapside d’une orbite géocentrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fcc7525-0daf-4572-8528-ece5daa02966",
                                "sense_id": "e215feb4-dc7a-3c8a-9a3f-56967285a1ba",
                                "text": "La Lune arrive au périgée de son orbite autour de la Terre. La Lune arrive à son périgée."
                            },
                            {
                                "example_id": "412e6d99-e931-4b51-bc4e-7b3ed8f2ca85",
                                "sense_id": "e215feb4-dc7a-3c8a-9a3f-56967285a1ba",
                                "text": "Lancé le 1ᵉʳ décembre, à onze heures moins treize minutes et vingt secondes du soir, il devait rencontrer la Lune quatre jours après son départ, le 5 décembre, à minuit précis, à l’instant même où elle se trouverait dans son périgée, c’est-à-dire à sa distance la plus rapprochée de la Terre, soit exactement quatre-vingt-six mille quatre cent dix lieues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99b56f53-c5ad-49be-be63-65dcf3f7e13b",
                        "source_entry_id": "bc133746-fa27-3335-9be9-9d2bdce5241a",
                        "source_sense_id": "e215feb4-dc7a-3c8a-9a3f-56967285a1ba",
                        "target_lang_word": "Erdnähe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0b795988-f319-4c11-8b4f-b8498879c77c",
                        "source_entry_id": "bc133746-fa27-3335-9be9-9d2bdce5241a",
                        "source_sense_id": "e215feb4-dc7a-3c8a-9a3f-56967285a1ba",
                        "target_lang_word": "perigee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perigee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e4d16b7-23e2-3298-8dfd-157ee25ee334",
                                        "entry_id": "983ea263-e38b-315a-baf9-4b68987fb747",
                                        "glosses": [
                                            "The point, in an orbit about the Earth, that is closest to the Earth: the periapsis of an Earth orbiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b41bc2f7-ad18-41a1-b236-99479c8bd49d",
                                                "sense_id": "7e4d16b7-23e2-3298-8dfd-157ee25ee334",
                                                "text": "As the moon wheels around Earth every 28 days and shows us a progressively greater and then stingier slice of its sun-lightened face, the distance between the moon and Earth changes, too. At the nearest point along its egg-shaped orbit, its perigee, the moon may be 26,000 miles closer to us than it is at its far point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b75e211-7b9e-3b69-b8d8-6338ec9da2dc",
                                        "entry_id": "983ea263-e38b-315a-baf9-4b68987fb747",
                                        "glosses": [
                                            "The point, in an orbit about any planet, that is closest to the planet: the periapsis of any satellite."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb68f5e3-1246-48e3-9cbb-c5972bdb4bdb",
                                                "sense_id": "8b75e211-7b9e-3b69-b8d8-6338ec9da2dc",
                                                "text": "Conjunctions of I and II [Io and Europa] occur when they are near perigee and apogee respectively; conjunctions of II and III [Europa and Ganymede] occur when II [Europa] is near perigee."
                                            },
                                            {
                                                "example_id": "da6dbb7c-5cc3-4c9c-a818-9b7882c8f5ae",
                                                "sense_id": "8b75e211-7b9e-3b69-b8d8-6338ec9da2dc",
                                                "text": "The resolution of the images obtained by this American probe [Messenger] will depend on its altitude [above Mercury] at any one time: about ten meters at perigee (200km altitude), but only one 1 km at apogee (15000km)."
                                            },
                                            {
                                                "example_id": "a852d1ed-e570-43c1-9d1c-681332e4da39",
                                                "sense_id": "8b75e211-7b9e-3b69-b8d8-6338ec9da2dc",
                                                "text": "[Nereid’s] apogee—farthest point from Neptune—is five times the distance of its perigee—its closest point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b79bd0ba-7ff1-3950-a920-d9fdcc309552",
                                        "entry_id": "983ea263-e38b-315a-baf9-4b68987fb747",
                                        "glosses": [
                                            "The point, in any trajectory of an object in space, where it is closest to the Earth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eda6d79a-e386-4cd8-b344-cda521c53bf7",
                        "source_entry_id": "bc133746-fa27-3335-9be9-9d2bdce5241a",
