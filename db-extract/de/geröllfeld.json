                "senses": [
                    {
                        "sense_id": "a5bdfe10-2f29-3050-8e23-11896bffc635",
                        "entry_id": "4609372e-97d2-3198-9438-e5dfd1dd5a79",
                        "glosses": [
                            "Gelände, das mit Geröll bedeckt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "588be961-eced-4a4c-9d05-856457ab407c",
                                "sense_id": "a5bdfe10-2f29-3050-8e23-11896bffc635",
                                "text": "„Sie traten in eine der mit Platten bedeckten Steinhütten, die sich, dem Wesen der Landschaft abgepaßt, zahlreich über das Geröllfeld hin verstreuten.“"
                            },
                            {
                                "example_id": "f40be8e0-abf6-47b5-8372-fae7fa5067bd",
                                "sense_id": "a5bdfe10-2f29-3050-8e23-11896bffc635",
                                "text": "„Er hatte zwar hin und wieder daran gedacht, dass es schön wäre, sich die Gegend anzuschauen, aber der Weg dorthin war nicht zu unterschätzen, eine lange Wanderung über Geröllfelder und Lawinengebiete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
