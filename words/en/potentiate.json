    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb77a2c9-6b54-35e3-8464-28a8e6808bd2",
                    "sense_definition": "To increase the potency, effectiveness, or activity of a drug or biochemical agent.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "enhance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These antidepressants <w>potentiate</w> the analgesic action of opiates."
                        },
                        {
                            "text": "Alcohol can strongly <w>potentiate</w> the sedative effects of certain medications."
                        }
                    ],
                    "common_phrases": [
                        "potentiate the effect",
                        "potentiate the action"
                    ]
                },
                {
                    "sense_id": "d8555929-e364-3977-af91-26de7a0e25b0",
                    "sense_definition": "To enhance, promote, or make more effective.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enhance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy may <w>potentiate</w> economic growth across the entire region."
                        },
                        {
                            "text": "Strategic investments could further <w>potentiate</w> their chances of long-term success."
                        }
                    ],
                    "synonyms": [
                        "enhance",
                        "boost",
                        "heighten"
                    ],
                    "antonyms": [
                        "inhibit",
                        "diminish"
                    ]
                },
                {
                    "sense_id": "150aa3a1-312a-3739-b0de-ed2d824cbe93",
                    "sense_definition": "To endow or invest something with power or authority.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constitution sought to <w>potentiate</w> the legislative assembly with ultimate governing authority."
                        },
                        {
                            "text": "New democratic reforms helped to <w>potentiate</w> local councils across the country."
                        }
                    ],
                    "synonyms": [
                        "empower"
                    ]
                }
            ]
        }
    ]
