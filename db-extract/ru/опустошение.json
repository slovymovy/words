                    {
                        "form_id": "737b3f4b-7dc6-4012-bbaa-81d7c0236f6b",
                        "entry_id": "2c64598f-859e-3ef6-b637-af7136d4d1a2",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "опустоше́ниях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bef8093a-911f-3c0b-84c9-cf0392a60f39",
                        "entry_id": "2c64598f-859e-3ef6-b637-af7136d4d1a2",
                        "glosses": [
                            "действие по значению гл. опустошать, опустошить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0697b06e-7636-4e89-a736-de0d4adccaa5",
                                "sense_id": "bef8093a-911f-3c0b-84c9-cf0392a60f39",
                                "text": "Казалось, тяжело вооружённая сила, произведя опустошения и взявши страшную дань, стремилась к новым победам…"
                            }
                        ]
                    },
                    {
                        "sense_id": "69a219f7-2916-3efb-aad5-0fd54dd8e7fd",
                        "entry_id": "2c64598f-859e-3ef6-b637-af7136d4d1a2",
                        "glosses": [
                            "результаты такого действия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "299ae911-cac3-486c-95f3-c294b097aa04",
                                "sense_id": "69a219f7-2916-3efb-aad5-0fd54dd8e7fd",
                                "text": "Он смотрел на повсеместное опустошение не для того, чтобы проливать слезы, но чтобы лучшими и скорейшими средствами загладить следы оного."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cea0121-d260-3535-a22a-c469932c39ce",
                        "entry_id": "2c64598f-859e-3ef6-b637-af7136d4d1a2",
                        "glosses": [
                            "то же, что опустошённость; чувство внутренней пустоты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62f5e7ae-6050-4118-b018-eb1ddc203a1e",
                                "sense_id": "4cea0121-d260-3535-a22a-c469932c39ce",
                                "text": "Всюду, внутри и вне человека, опустошение, расшатанность, хаос и следы какого-то длительного Мамаева побоища."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9380eca-8842-49e7-b397-d1c883b119d0",
                        "source_entry_id": "2c64598f-859e-3ef6-b637-af7136d4d1a2",
                        "source_sense_description": "чувство внутренней пустоты",
                        "target_lang_word": "exhaustion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exhaustion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1988f4f5-feba-3421-94e1-9498e001d91d",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "The point of complete depletion, of the state of being used up."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "768b21e8-36e2-46ab-b010-cc7a95c40aa5",
                                                "sense_id": "1988f4f5-feba-3421-94e1-9498e001d91d",
                                                "text": "We worked the mine to exhaustion, there's nothing left to extract."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "663e6e66-c490-3b8a-9676-9c7264729437",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "Supreme tiredness; having exhausted energy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a6fa4f0-c62c-4a02-8ad3-1a5a261e094a",
                                                "sense_id": "663e6e66-c490-3b8a-9676-9c7264729437",
                                                "text": "I ran in the marathon to exhaustion, then I collapsed and had to be carried away."
                                            },
                                            {
                                                "example_id": "99900432-3d94-419a-8db7-cb3871848968",
                                                "sense_id": "663e6e66-c490-3b8a-9676-9c7264729437",
                                                "text": "As soon as Julia returned with a constable, Timothy, who was on the point of exhaustion, prepared to give over to him gratefully. The newcomer turned out to be a powerful youngster, fully trained and eager to help, and he stripped off his tunic at once."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bfcc54a-22b5-3a62-afa7-44028aa37c60",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "The removal (by percolation etc) of an active medicinal constituent from plant material."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1acd3017-1c85-371e-8501-31544a8c3141",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "The removal of all air from a vessel (the creation of a vacuum)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de9cc18b-7a27-3c62-a5c7-68139ca81829",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "An exhaustive procedure"
                                        ],
