                "entry_id": "3e1fa061-202a-3c5e-9e0c-1083e104e904",
                "word": "weeds",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "42aed845-e39b-35ee-a8ef-7b21f2929c6a",
                        "entry_id": "3e1fa061-202a-3c5e-9e0c-1083e104e904",
                        "glosses": [
                            "Clothes."
                        ],
                        "tags": [
                            "obsolete",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "a2b8e2ff-53ac-4d54-bbed-994a6b8a144d",
                                "sense_id": "42aed845-e39b-35ee-a8ef-7b21f2929c6a",
                                "text": "Come, let us hence, and put on other weeds;"
                            },
                            {
                                "example_id": "96902beb-70f2-4d51-bae1-cd8bcb2372d1",
                                "sense_id": "42aed845-e39b-35ee-a8ef-7b21f2929c6a",
                                "text": "Nor can the judicious reader be at a greater loss on account of Mrs Bridget Blifil, who, he may be assured, conducted herself through the whole season in which grief is to make its appearance on the outside of the body, with the strictest regard to all the rules of custom and decency, suiting the alterations of her countenance to the several alterations of her habit: for as this changed from weeds to black, from black to grey, from grey to white, so did her countenance change from dismal to sorrowful, from sorrowful to sad, and from sad to serious, till the day came in which she was allowed to return to her former serenity."
                            },
                            {
                                "example_id": "56c9ab4f-9484-4525-a22e-64663edfa417",
                                "sense_id": "42aed845-e39b-35ee-a8ef-7b21f2929c6a",
                                "text": "What sight is this? What company of women\nIs wending hitherward, in sable weeds\nConspicuous?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
