                ],
                "senses": [
                    {
                        "sense_id": "77925ab5-2906-3b5c-99b6-7900438d479b",
                        "entry_id": "a6f75026-1ae2-35f7-9954-df17e0510b59",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8129eff5-5714-4046-a838-efde4bf2fafb",
                                "sense_id": "77925ab5-2906-3b5c-99b6-7900438d479b",
                                "text": "Frau Ulreich ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "773457bb-bcfe-4dfb-b051-dae64b847dca",
                                "sense_id": "77925ab5-2906-3b5c-99b6-7900438d479b",
                                "text": "Herr Ulreich wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "186156f4-93f2-42c4-938a-2b4effb609ef",
                                "sense_id": "77925ab5-2906-3b5c-99b6-7900438d479b",
                                "text": "Die Ulreichs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a85a7af6-1afa-4106-b424-da26a148f37c",
                                "sense_id": "77925ab5-2906-3b5c-99b6-7900438d479b",
                                "text": "Der Ulreich trägt nie die Schals, die die Ulreich ihm strickt."
                            },
                            {
                                "example_id": "979fba81-92ac-4de6-bb33-0c340da5a810",
                                "sense_id": "77925ab5-2906-3b5c-99b6-7900438d479b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ulreich kommt, geht der Herr Ulreich.“"
                            },
                            {
                                "example_id": "1f55fcbc-f52c-4429-a205-7216318273f2",
                                "sense_id": "77925ab5-2906-3b5c-99b6-7900438d479b",
                                "text": "Ulreich kommt und geht."
                            },
                            {
                                "example_id": "37ce8e7f-68c3-4cc8-a055-44507114d77f",
                                "sense_id": "77925ab5-2906-3b5c-99b6-7900438d479b",
                                "text": "Ulreichs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
