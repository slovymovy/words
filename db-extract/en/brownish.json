                        "examples": [
                            {
                                "example_id": "e10da040-14ba-4974-a658-3973bfa13ac4",
                                "sense_id": "19203d7f-291c-39fa-b483-7f03e30fb2af",
                                "text": "Two pumps stood side by side in our kitchen. One was for well water and one was a cistern pump—water from the former was hard and clear, from the cistern it was brownish and soft."
                            },
                            {
                                "example_id": "14937f7f-ebef-4cd1-a690-c2d44f6dbfa3",
                                "sense_id": "19203d7f-291c-39fa-b483-7f03e30fb2af",
                                "text": "The Giraffe and the Zebra and the Eland and the Koodoo and the Hartebeest lived there; and they were 'sclusively sandy-yellow-brownish all over […]"
                            },
                            {
                                "example_id": "facac98e-b166-4b4e-94e1-5d68b205cbf7",
                                "sense_id": "19203d7f-291c-39fa-b483-7f03e30fb2af",
                                "text": "Watt wore, on his feet, a boot, brown in colour, and a shoe, happily of a brownish colour also."
                            }
                        ]
                    }
