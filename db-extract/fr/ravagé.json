                    {
                        "sense_id": "a445c9bd-be4f-3aec-ac98-6a9f7340123c",
                        "entry_id": "1e9e8928-d482-3428-b81f-cc2ef9270bd3",
                        "glosses": [
                            "Gravement perturbé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "026089a0-1d87-45fc-87ec-c9321e7cf3e8",
                                "sense_id": "a445c9bd-be4f-3aec-ac98-6a9f7340123c",
                                "text": "Blanche Frontenac, si maigre naguère, devenait épaisse, s’inquiétait de sa santé, croyait avoir un cancer et, ravagée par cette angoisse, pensait au sort de ses enfants lorsqu’elle aurait disparu."
                            }
