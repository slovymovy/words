                                            {
                                                "example_id": "eeadc43b-3d22-4b9e-8e64-8f2f305b8827",
                                                "sense_id": "39fecccc-a403-335d-a24c-a24ab48b8819",
                                                "text": "Θεωρώ ότι φραστικά έμεινε ασαφές, δεν το ξεκαθαρίσατε (από άποψη εκλογής φράσεων ή λέξεων ή σύνταξης)"
                                            },
                                            {
                                                "example_id": "409fb5ef-dba6-444e-b39c-50f47d56236c",
                                                "sense_id": "39fecccc-a403-335d-a24c-a24ab48b8819",
                                                "text": "Το διάβασα, καλή ιδέα, αλλά στην τελευταία πράγραφο κάτι δεν μου πάει φραστικά (συντακτικά, νοηματικά, λεκτικά, εκφραστικά)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd1af103-6beb-35ef-8857-994bf45593b7",
                                        "entry_id": "fa61d6d6-d93b-32f6-bb0e-8fe85016ae6a",
                                        "glosses": [
                                            "προφορικά ή λεκτικά, με λέξεις (σπανίως γραπτές), σε αντιδιαστολή προς το έμπρακτα, ή προς επιρρήματα/ρήματα που δηλώνουν άλλες ενέργειες, πιο δραστικές από την ομιλία"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fe2e883-6d7a-40a3-ae51-93cf9c355885",
                                                "sense_id": "cd1af103-6beb-35ef-8857-994bf45593b7",
                                                "text": "Μα διαπληκτίσθηκαν φραστικά, δεν τράβηξαν δα και μαχαίρι"
                                            },
                                            {
                                                "example_id": "6d53ea84-ffa1-40ab-948b-2f1806c03877",
                                                "sense_id": "cd1af103-6beb-35ef-8857-994bf45593b7",
                                                "text": "Η λεκτική κακοποίηση των παιδιών είναι όρος της ψυχολογίας -δεν λέγεται η φράση \"το παιδί κακοποιήθηκε φραστικά\""
                                            }
                                        ]
                                    }
