                        "entry_id": "2a7bdf49-df3c-3f93-ac2c-e902908ff039",
                        "glosses": [
                            "Wohnheim/Wohngemeinschaft für katholische Schüler oder Studenten, die Priester werden sollen/wollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "392762bf-046f-42c4-9c9d-3b2188829007",
                                "sense_id": "89a87663-e35b-3502-bd25-92a10ad5eaf7",
                                "text": "„Im Konvikt habe er neben klassischer Musik auch Freizeit-Jazz gemacht.“"
                            },
                            {
                                "example_id": "a8447979-d5d9-4560-9447-177a5cf32b34",
                                "sense_id": "89a87663-e35b-3502-bd25-92a10ad5eaf7",
                                "text": "„Fast hätte ich den schwerhörigen alten Pfeifenraucher in Leos Konvikt noch einmal angerufen: Ich hätte mich gern mit ihm über das fleischliche Verlangen unterhalten.“"
                            }
