                "senses": [
                    {
                        "sense_id": "65c67466-d03e-3d8e-a4e3-c1487c999c6c",
                        "entry_id": "f90c722b-f49e-33cd-a868-e3de8ac02262",
                        "glosses": [
                            "De façon macabre, sinistrement, lugubrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "908a2215-1ea0-4237-9efe-16d0f200f61d",
                                "sense_id": "65c67466-d03e-3d8e-a4e3-c1487c999c6c",
                                "text": "Une des plus terribles impressions de sa vie, ça avait été de voir le farceur du Palais-Royal, avec sa tête de mort, prier, prier et ne pouvant s’empêcher de rendre sa prière macabrement comique par ses gnouf ! gnouf !"
                            },
                            {
                                "example_id": "208be855-d67e-47a1-881f-879097ed4518",
                                "sense_id": "65c67466-d03e-3d8e-a4e3-c1487c999c6c",
                                "text": "Il s’exhalait d’elle [la Lanterne de Rochefort], à peine entr’ouverte, une odeur de tombeau, où des os maxillaires riaient, macabrement."
                            }
                        ]
                    }
                ],
