{
    "word_family": [
        "тогда",
        "тотчас",
        "только"
    ],
    "entries": [
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "9ffeb492-1613-3239-b383-867b195fe781",
                    "sense_definition": "Указывает на предмет или лицо, находящееся далеко от говорящего.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "указание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я живу вон там, в <w>том</w> доме.",
                            "target_lang_translations": {
                                "en": "I live over there, in <w>that</w> house."
                            }
                        },
                        {
                            "text": "Посмотри на <w>ту</w> гору вдали.",
                            "target_lang_translations": {
                                "en": "Look at <w>that</w> mountain in the distance."
                            }
                        }
                    ],
                    "synonyms": [
                        "другой"
                    ],
                    "antonyms": [
                        "этот"
                    ],
                    "common_phrases": [
                        "в том доме"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates an object or person located far from the speaker."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "Demonstrative determiner used for objects or people at a distance."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7875ca3b-2966-38f1-9713-beb7f20e4f32",
                    "sense_definition": "Указывает на предмет или время, о которых уже шла речь ранее.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "указание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы встретились в <w>тот</w> день, когда пошел дождь.",
                            "target_lang_translations": {
                                "en": "We met on <w>that</w> day when it started to rain."
                            }
                        },
                        {
                            "text": "В <w>то</w> время мы еще учились в школе.",
                            "target_lang_translations": {
                                "en": "At <w>that</w> time, we were still in school."
                            }
                        }
                    ],
                    "common_phrases": [
                        "в тот день",
                        "в то время"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates an object or time that has already been mentioned."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "Used to refer back to a previously mentioned time or entity."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4394034-af83-349b-94bc-db0951085150",
                    "sense_definition": "Указывает на ошибочный или не подходящий предмет.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "отрицание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я случайно набрал не <w>тот</w> номер телефона.",
                            "target_lang_translations": {
                                "en": "I accidentally dialed <w>the wrong</w> phone number."
                            }
                        },
                        {
                            "text": "Кажется, это не <w>то</w> место, где мы договорились встретиться.",
                            "target_lang_translations": {
                                "en": "It seems this is <w>not the</w> place where we agreed to meet."
                            }
                        }
                    ],
                    "synonyms": [
                        "неверный",
                        "неправильный"
                    ],
                    "antonyms": [
                        "правильный"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates an incorrect or unsuitable object."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the wrong",
                                "target_lang_sense_clarification": "Used to specify that an object is not the correct one."
                            },
                            {
                                "target_lang_word": "not that",
                                "target_lang_sense_clarification": "Used to negate the identity of an object."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "d0af076e-fb99-34ea-9ae7-66c0800ad49d",
                    "sense_definition": "Указывает на человека или людей, обладающих определенным качеством.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "личность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я спрошу у <w>того</w>, кто хорошо знает дорогу.",
                            "target_lang_translations": {
                                "en": "I will ask <w>the one</w> who knows the way well."
                            }
                        },
                        {
                            "text": "Это подарок для <w>тех</w>, кто любит читать книги.",
                            "target_lang_translations": {
                                "en": "This is a gift for <w>those</w> who love reading books."
                            }
                        }
                    ],
                    "synonyms": [
                        "кто-то",
                        "люди"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates a person or people possessing a certain quality."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "those",
                                "target_lang_sense_clarification": "Used as a pronoun to refer to a group of people defined by a following clause."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05f4de56-8658-3beb-8d45-be731f733bb7",
                    "sense_definition": "Указывает на последнего упомянутого человека в предложении.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "личность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель задал ученику вопрос, а <w>тот</w> промолчал.",
                            "target_lang_translations": {
                                "en": "The teacher asked the student a question, but <w>the latter</w> remained silent."
                            }
                        },
                        {
                            "text": "Он помог другу, за что <w>тот</w> был ему очень благодарен.",
                            "target_lang_translations": {
                                "en": "He helped his friend, for which <w>the latter</w> was very grateful."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates the last mentioned person in a sentence."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the latter",
                                "target_lang_sense_clarification": "Used to refer to the second of two people or things previously mentioned."
                            },
                            {
                                "target_lang_word": "he/she",
                                "target_lang_sense_clarification": "Often translated simply as a pronoun when the context is clear."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4be0bfdd-60af-3256-94ce-fc7289cf0db5",
                    "sense_definition": "Древнеегипетский бог мудрости и знаний.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "мифология",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "В египетской мифологии бог <w>Тот</w> считался покровителем писцов.",
                            "target_lang_translations": {
                                "en": "In Egyptian mythology, the god <w>Thoth</w> was considered the patron of scribes."
                            }
                        },
                        {
                            "text": "Изображения бога <w>Тота</w> часто встречаются в древних храмах.",
                            "target_lang_translations": {
                                "en": "Images of the god <w>Thoth</w> are often found in ancient temples."
                            }
                        }
                    ],
                    "synonyms": [
                        "Теут",
                        "Тут",
                        "Туут",
                        "Тоут",
                        "Техути",
                        "Джехути"
                    ],
                    "target_lang_definitions": {
                        "en": "Ancient Egyptian god of wisdom and knowledge."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Thoth",
                                "target_lang_sense_clarification": "The standard English name for the Egyptian deity."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}