                ],
                "senses": [
                    {
                        "sense_id": "75991346-573e-3ec7-9e05-0be10c751f8c",
                        "entry_id": "f67158a7-5d82-3af1-9909-19cf9b6d626a",
                        "glosses": [
                            "Datentyp für eine eindeutige Kennzeichnung von Datensätzen"
                        ],
                        "tags": [
                            "Datenbanken"
                        ],
                        "examples": [
                            {
                                "example_id": "ada6440a-5f60-4c00-ad9d-bc1ab281125b",
                                "sense_id": "75991346-573e-3ec7-9e05-0be10c751f8c",
                                "text": "„Datenbankschlüssel bilden eine Menge von Attributen, die Datenzeilen (Tupel) in Tabellen eindeutig identifizieren."
                            },
                            {
                                "example_id": "b4c18b38-e294-49d1-89ce-092269c6c598",
                                "sense_id": "75991346-573e-3ec7-9e05-0be10c751f8c",
                                "text": "„Ein Surrogatschlüssel (Stellvertreterschlüssel, englisch surrogate key wörtlich ‚Ersatzschlüssel‘, auch künstlicher Schlüssel oder synthetischer Schlüssel genannt) ist ein Datenbankschlüssel in einer Datenbanktabelle.“"
                            },
                            {
                                "example_id": "1ad6ad29-54e1-4c43-949b-b18ad862df5e",
                                "sense_id": "75991346-573e-3ec7-9e05-0be10c751f8c",
                                "text": "„Die in diesem Kapitel vorgestellten Muster unterstützen Sie bei Entwurf und Implementierung von Datenbankschlüsseln: Identity Field, Sequenzblock sowie UUID.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
