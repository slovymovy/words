                                    {
                                        "sense_id": "9cc1930a-a644-3cd3-b62d-eab299fd639b",
                                        "entry_id": "7a8e2231-a7a1-3399-b46d-952e9a4e0cdd",
                                        "glosses": [
                                            "Avec certitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bd9342d-b534-41cb-b18c-5366f0088878",
                                                "sense_id": "9cc1930a-a644-3cd3-b62d-eab299fd639b",
                                                "text": "C’est là, sans aucun doute, que près de cinquante navires anglais, danois et hollandais furent écrasés par les glaces en 1777."
                                            },
                                            {
                                                "example_id": "bf8edd0e-74ef-4d99-8fbe-1d547479f20c",
                                                "sense_id": "9cc1930a-a644-3cd3-b62d-eab299fd639b",
                                                "text": "Le plus ennuyeux pour les agriculteurs fut sans aucun doute le défaut d’essence et de ficelle pour les lieuses. On voyait ressortir les anciens matériels mis au rebut comme les javeleuses et les batteuses à tripot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b4e2f27-a56f-43f9-b599-856f3f0a640c",
                        "source_entry_id": "c765d208-4c5e-32dd-9549-1f8c430d2e6c",
                        "source_sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                        "source_sense_description": "without doubt",
                        "target_lang_word": "sans nul doute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans nul doute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24717cec-0249-3b25-9a59-44045172a2be",
                                        "entry_id": "d3efe178-b9eb-3325-aa6a-efda72e24713",
                                        "glosses": [
                                            "Avec certitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "861b8da7-10b1-417d-9bcb-d82b7e5ee902",
                                                "sense_id": "24717cec-0249-3b25-9a59-44045172a2be",
                                                "text": "Pour avoir quelque chance de tracer un tableau fidèle de la généalogie des Vers, il faudrait d'abord laisser de côté toutes les formes parasites, qui, sans nul doute, ont été produites par la dégénération de formes libres, plus élevées."
                                            },
                                            {
                                                "example_id": "07ab6f2a-f6ca-4f82-9876-1a84e4597f1f",
                                                "sense_id": "24717cec-0249-3b25-9a59-44045172a2be",
                                                "text": "Ce qui impliquait qu'il avait, sans nul doute comme je l'avais déjà pensé, une double vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "463f4693-d6e8-4b98-92ec-ed13e8a9eab0",
                        "source_entry_id": "c765d208-4c5e-32dd-9549-1f8c430d2e6c",
                        "source_sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
