                        "sense_id": "0ea05bba-8241-3624-bb65-09914b7d7921",
                        "entry_id": "a9e1dab9-c4b2-3aae-865c-21fe509ec9b9",
                        "glosses": [
                            "役畜，牲口"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76a95e94-2850-4bce-a7a4-f6feadd71674",
                                "sense_id": "0ea05bba-8241-3624-bb65-09914b7d7921",
                                "text": "Ochsen wurden hauptsächlich als Arbeitstiere gehalten.",
                                "translation": "公牛曾经主要被当作役畜。"
                            }
                        ]
                    },
                    {
                        "sense_id": "06b916d5-9fa1-3059-b519-8ddd2a8021f1",
                        "entry_id": "a9e1dab9-c4b2-3aae-865c-21fe509ec9b9",
                        "glosses": [
                            "工作狂"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c383b462-b150-4e0c-849a-75866510b1f3",
                                "sense_id": "06b916d5-9fa1-3059-b519-8ddd2a8021f1",
                                "text": "Er ist so ein Arbeitstier, dass er seine Tabellen noch als Bettlektüre benutzt.",
                                "translation": "他工作认真到上床时都一直盯着平板电脑。"
                            }
                        ]
                    },
                    {
                        "sense_id": "78484e84-9bcc-3c86-8940-57aba714fee1",
                        "entry_id": "a9e1dab9-c4b2-3aae-865c-21fe509ec9b9",
                        "glosses": [
                            "（因缺乏天赋而）用功的人，苦干的人"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48f01508-13e2-48b9-921c-78dfd839373c",
                                "sense_id": "78484e84-9bcc-3c86-8940-57aba714fee1",
                                "text": "Es gibt drei Arten von guten Schülern: die Genies, die Schleimer und die Arbeitstiere.",
                                "translation": "在学校有三种好学生：天才，会拍马屁的人，以及埋头用功的人。"
                            }
                        ]
                    },
                    {
                        "sense_id": "4d03391d-d018-3b66-9529-f3ac08a3d6f4",
                        "entry_id": "a9e1dab9-c4b2-3aae-865c-21fe509ec9b9",
                        "glosses": [
                            "（实用的而非用作显摆的）机器，工具"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "06c1ebb3-ccbd-4e08-a22f-52ea00b0c384",
                                "sense_id": "4d03391d-d018-3b66-9529-f3ac08a3d6f4",
                                "text": "Der Kombi ist ein reines Arbeitstier. Für den Rest hab ich den Porsche.",
                                "translation": "旅行轿车是真的要用的时候用的。其他时候我就用保时捷。"
                            }
                        ]
                    }
