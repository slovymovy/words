                    {
                        "sense_id": "8cf1e8cd-80e6-39aa-a47a-76d5ba9c8efe",
                        "entry_id": "c0fb5a57-c328-3157-95f5-b95f6d4b74db",
                        "glosses": [
                            "(Codicologie) Dans un codex, cahier composé de sept feuilles doubles (bifeuillets), soit 14 folios et 28 pages."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "7a9c6016-eea1-4b78-8f30-339dda21472a",
                                "sense_id": "8cf1e8cd-80e6-39aa-a47a-76d5ba9c8efe",
                                "text": "Pour un cahier de six bifeuillets, on parle de sénion. Pour un cahier de sept bifeuillets de septénion, et d’octonion pour un cahier de huit bifeuillets."
                            },
                            {
                                "example_id": "258c5eca-b183-4a52-99cf-e0cc1200ec4a",
                                "sense_id": "8cf1e8cd-80e6-39aa-a47a-76d5ba9c8efe",
                                "text": "\"Hector et Herculès\" remplissent un septénion, de sorte que le \"Roman de Troie\" commence par un nouveau cahier, également un septénion."
                            },
                            {
                                "example_id": "17dacb0e-4d70-4307-a41b-bd5f63784aca",
                                "sense_id": "8cf1e8cd-80e6-39aa-a47a-76d5ba9c8efe",
                                "text": "Le texte commence avec un nouveau cahier; 9 sénions réguliers, suivis d’un cahier de 11 feuillets et d’un septénion."
                            }
                        ]
                    }
                ],
