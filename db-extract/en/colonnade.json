                "translations": [
                    {
                        "translation_id": "1a625de7-8088-41fa-9b56-3e353359bdec",
                        "source_entry_id": "6a8a42c7-032e-3ff4-afc5-111616907748",
                        "source_sense_description": "a series of columns at regular intervals",
                        "target_lang_word": "colonnade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
