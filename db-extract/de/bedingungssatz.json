                "senses": [
                    {
                        "sense_id": "d8df0d9b-c246-390b-acd2-72f0135ce988",
                        "entry_id": "fabc5e58-9733-32b8-9678-b2b005dca8f2",
                        "glosses": [
                            "Gliedsatz, speziell Adverbialsatz, der angibt, unter welcher Bedingung etwas geschieht"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "8c0048d4-2f82-4188-b167-48381eafc900",
                                "sense_id": "d8df0d9b-c246-390b-acd2-72f0135ce988",
                                "text": "„Perlmann wußte, sie war absurd, diese Orgie von irrealen Bedingungssätzen, und nicht nur das, sie fraß auch die Erleichterung auf, so daß er sich jetzt in die Tränen der ersten Erlösung zurücksehnte.“"
                            },
                            {
                                "example_id": "ddec2159-bc9d-4792-8d2a-1ee42b321d9d",
                                "sense_id": "d8df0d9b-c246-390b-acd2-72f0135ce988",
                                "text": "„Als ob man kein Geld brauchte, wenn man vernünftig war, kein Geld brauchte, wenn man wusste, dass man unerfüllbare Wünsche im Konjunktiv II ausdrücken musste. Wenn man wusste, dass solche Wünsche der Form nach mit Bedingungssätzen identisch sind, jedoch keine Schlussfolgerung haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
