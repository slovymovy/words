    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b8323f97-e78e-3511-8c3b-533db354a934",
                "word": "contrariety",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8ad5fa2f-8440-4862-85a4-bcf435bc591f",
                        "entry_id": "b8323f97-e78e-3511-8c3b-533db354a934",
                        "tags": [
                            "plural"
                        ],
                        "form": "contrarieties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d94250e3-27cd-3dfe-894b-989489503815",
                        "entry_id": "b8323f97-e78e-3511-8c3b-533db354a934",
                        "glosses": [
                            "Opposition or contrariness; cross-purposes, marked contrast."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8f6831f9-e655-4bec-a392-93b3c96e0123",
                                "sense_id": "d94250e3-27cd-3dfe-894b-989489503815",
                                "text": "What differences of sense and reason, what contrarietie of imaginations doth the diversitie of our passions present unto us?"
                            },
                            {
                                "example_id": "6164a941-a423-47cb-a33f-dcc49f88eda0",
                                "sense_id": "d94250e3-27cd-3dfe-894b-989489503815",
                                "text": "This contrariety of humours betwixt my father and my uncle, was the source of many a fraternal squabble."
                            },
                            {
                                "example_id": "d44d4a47-b48c-4695-baf5-858750251634",
                                "sense_id": "d94250e3-27cd-3dfe-894b-989489503815",
                                "text": "Thy ſenate is a ſcene of civil jar, / Chaos of contrarieties at vvar, / VVhere ſharp and ſolid, phlegmatic and light, / Diſcordant atoms meet, ferment and fight, […]"
                            },
                            {
                                "example_id": "290a9759-70a7-48ed-8a5c-3f28e856afd6",
                                "sense_id": "d94250e3-27cd-3dfe-894b-989489503815",
                                "text": "The contrariety of views and designs, the concertative, dilatory conferences of a numerous assembly (rent and divided as such assemblies are ever found to be), render it expedient that the prerogative of commencing war be confided to the advised discretion of the executory power."
                            },
                            {
                                "example_id": "2348a956-6f86-46fe-8bcc-01add3fcd027",
                                "sense_id": "d94250e3-27cd-3dfe-894b-989489503815",
                                "text": "Yet however within my reach, however tempting they may appear, when I think upon the contrarieties, the restraints, the uncertainties that in this sublunary temporary sojourn would interpose their bane, the scene appears joyless, and I fly, rejoicing fly, to rest my hopes, faith, confidence on that base which is immutable, never-changing, never-ending; in a word, I fly to repose myself on the bosom of my God."
                            },
                            {
                                "example_id": "b4cc6f1e-3f61-4bb1-bd87-7f622a8dbb3a",
                                "sense_id": "d94250e3-27cd-3dfe-894b-989489503815",
                                "text": "The wind blowing steady and gentle from the south, there was no contrariety between that and the current, and the billows rose and fell unbroken."
                            },
                            {
                                "example_id": "d5209cd3-eaef-4679-889a-b562dce763f7",
                                "sense_id": "d94250e3-27cd-3dfe-894b-989489503815",
                                "text": "This book puts forward a clearer understanding of Diderot's perplexities by taking into account the dynamics of his thought processes, especially the mode, peculiar to him, of thinking via contrarieties."
                            },
                            {
                                "example_id": "44d7d318-66e5-4c53-a153-8a762bf9f1a7",
                                "sense_id": "d94250e3-27cd-3dfe-894b-989489503815",
                                "text": "At the heart of his argument is the contrariety between day and night, light and dark."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
