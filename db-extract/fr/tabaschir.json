                        "sense_id": "772f8e27-0515-3f90-8a50-092827e1356a",
                        "entry_id": "4be7cb13-b372-3129-9764-8cbf7e0c25d8",
                        "glosses": [
                            "Sève épaisse et sucrée qui se solidifie sur l’extérieur des tiges de canne à sucre."
                        ],
