                        "glosses": [
                            "Gold, das für die Herstellung von Zahnersatz und Zahnkronen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3f70be2-7854-4896-b8c0-ca8d6f6233b0",
                                "sense_id": "5f43b875-8f32-3f0f-90de-834940435c24",
                                "text": "„Eine Studie aus Deutschland zeige, dass private Investoren 2,8 Prozent ihres Vermögens in Gold halten (inklusive Schmuck und Zahngold).“"
                            },
                            {
                                "example_id": "096b143c-a78c-4563-8270-ff3b547110bc",
                                "sense_id": "5f43b875-8f32-3f0f-90de-834940435c24",
                                "text": "„Wenn man tot ist und falls man sich verbrennen lässt - wem gehört eigentlich das Zahngold, das von einem übrig bleibt?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
