                                        "examples": [
                                            {
                                                "example_id": "1cb05ae0-f8ab-4039-aa60-592e34559755",
                                                "sense_id": "1b1b91dd-6f9b-3f15-bd6f-953911f2e212",
                                                "text": "Under this map, any two values in the fiber of a given point on the circle differ by 2π."
