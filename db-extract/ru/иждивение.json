                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "434223f5-ec86-3daf-955d-7e1c19bffe4c",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
                                            "Wealth."
                                        ],
                                        "tags": [
