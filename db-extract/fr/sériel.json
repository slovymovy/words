                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9fc981c-267b-4d77-b2fd-5da3456c3763",
                                                "sense_id": "83cb904e-98dd-3893-8060-a65efaabf7e2",
                                                "text": "These singular ribs have a very different direction from that of the serial teeth of the hinge, and cannot be taken for teeth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99d2c0d2-cdf4-3da0-8e1d-8de9c2a913c6",
                                        "entry_id": "8af3d50b-cb71-362a-b946-d9469305d435",
                                        "glosses": [
                                            "Who performs a specified action or course of action repeatedly or regularly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b9428a8-23bb-4ec9-ae6c-d2b0ea71a144",
                                                "sense_id": "99d2c0d2-cdf4-3da0-8e1d-8de9c2a913c6",
                                                "text": "The serial killer had a string of victims across seven states."
                                            },
                                            {
                                                "example_id": "7ac0845b-f992-4f5d-b5ac-72fc7ae5abe2",
                                                "sense_id": "99d2c0d2-cdf4-3da0-8e1d-8de9c2a913c6",
                                                "text": "He was a serial entrepreneur, always coming up with a new way to make cash."
                                            },
                                            {
                                                "example_id": "4f58fbbd-7092-447b-9eb5-5a9166fbc2f2",
                                                "sense_id": "99d2c0d2-cdf4-3da0-8e1d-8de9c2a913c6",
                                                "text": "\"No I could not!\" Kate looked at Max sternly. \"I am not a cheat and I am not a serial monogamist.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d668f5f-e95c-3836-bd93-3161fb225d84",
