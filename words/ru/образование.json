            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13e4853c-eddb-3b6f-a7cd-24593f86cdf2",
                    "sense_definition": "Процесс усвоения знаний, обучение, а также совокупность знаний, полученных в результате этого процесса.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой старший брат хочет получить высшее <w>образование</w> в университете.",
                            "target_lang_translations": {
                                "en": "My older brother wants to get a higher <w>education</w> at the university.",
                                "tr": "Ağabeyim üniversitede yükseköğrenim yani <w>eğitim</w> almak istiyor.",
                                "zh": "我哥哥想在大学里接受高等<w>教育</w>。"
                            }
                        },
                        {
                            "text": "В современном мире хорошее <w>образование</w> помогает найти интересную работу.",
                            "target_lang_translations": {
                                "en": "In the modern world, a good <w>education</w> helps find an interesting job.",
                                "tr": "Modern dünyada iyi bir <w>eğitim</w> ilginç bir iş bulmaya yardımcı olur.",
                                "zh": "在现代社会，良好的<w>教育</w>有助于找到一份有趣的工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "просвещение",
                        "обучение",
                        "учёба"
                    ],
                    "common_phrases": [
                        "высшее образование",
                        "получить образование",
                        "система образования",
                        "министерство образования"
                    ],
                    "target_lang_definitions": {
                        "en": "The process of acquiring knowledge, learning, and the body of knowledge obtained through this process.",
                        "tr": "Bilgi edinme süreci, öğrenim ve bu süreç sonucunda elde edilen bilgi birikimi.",
                        "zh": "获取知识的过程、学习，以及通过该过程所获得的知识体系。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "education",
                                "target_lang_sense_clarification": "process of teaching or learning"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "eğitim",
                                "target_lang_sense_clarification": "öğrenim süreci ve genel bilgi birikimi"
                            },
                            {
                                "target_lang_word": "öğrenim",
                                "target_lang_sense_clarification": "okulda veya bir kurumda alınan eğitim"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "教育",
                                "target_lang_sense_clarification": "指学校教育或培养过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bee06554-1113-379f-a278-a6000e8c44b7",
                    "sense_definition": "Процесс создания, возникновения или формирования чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На <w>образование</w> этих гор ушли миллионы лет.",
                            "target_lang_translations": {
                                "en": "The <w>formation</w> of these mountains took millions of years.",
                                "tr": "Bu dağların <w>oluşumu</w> milyonlarca yıl sürdü.",
                                "zh": "这些山脉的<w>形成</w>经历了数百万年。"
                            }
                        },
                        {
                            "text": "<w>Образование</w> новых слов происходит в языке постоянно.",
                            "target_lang_translations": {
                                "en": "The <w>formation</w> of new words happens in language constantly.",
                                "tr": "Dilde yeni kelimelerin <w>oluşumu</w> sürekli gerçekleşir.",
                                "zh": "语言中新词的<w>形成</w>一直在持续进行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "возникновение",
                        "формирование"
                    ],
                    "common_phrases": [
                        "процесс образования",
                        "образование государства",
                        "образование цен",
                        "год образования"
                    ],
                    "target_lang_definitions": {
                        "en": "The process of creating, originating, or forming something.",
                        "tr": "Bir şeyin meydana gelme, oluşma veya şekillenme süreci.",
                        "zh": "某事物产生、形成或构建的过程。"
                    },
                    "translations": {
