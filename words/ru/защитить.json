{
    "word_family": [
        "защита",
        "защитник",
        "защитный",
        "беззащитный",
        "защищаться"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed8c50eb-27f2-3840-8eb6-fa6a799285a6",
                    "sense_definition": "Оберечь, оградить от посягательств, враждебных действий, опасности или вреда.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "protection_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Армия должна <защитить> страну от любого нападения.",
                            "target_lang_translations": {
                                "en": "The army must <defend> the country from any attack.",
                                "tr": "Ordu, ülkeyi her türlü saldırıya karşı <savunmak> zorundadır."
                            }
                        },
                        {
                            "text": "Тёплая куртка поможет <защитить> тебя от холодного ветра.",
                            "target_lang_translations": {
                                "en": "A warm jacket will help <protect> you from the cold wind.",
                                "tr": "Sıcak bir ceket seni soğuk rüzgardan <korumaya> yardımcı olur."
                            }
                        }
                    ],
                    "synonyms": [
                        "уберечь",
                        "оборони́ть",
                        "обезопасить"
                    ],
                    "common_phrases": [
                        "защитить родину",
                        "защитить права",
                        "защитить от врагов",
                        "защитить от холода"
                    ],
                    "target_lang_definitions": {
                        "en": "To keep safe from harm, attack, or danger.",
                        "tr": "Saldırı, tehlike veya zarardan korumak, muhafaza etmek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "protect",
                                "target_lang_sense_clarification": "keep safe from harm"
                            },
                            {
                                "target_lang_word": "defend",
                                "target_lang_sense_clarification": "ward off an attack"
                            },
                            {
                                "target_lang_word": "shield",
                                "target_lang_sense_clarification": "screen from danger or elements"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "korumak",
                                "target_lang_sense_clarification": "zarar veya tehlikeden uzak tutmak"
                            },
                            {
                                "target_lang_word": "savunmak",
                                "target_lang_sense_clarification": "saldırıya karşı koymak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac067bc2-fdf4-3f7e-9035-2a5f55e738ae",
                    "sense_definition": "Отстоять чьи-либо интересы или мнение, выступить в поддержку кого-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я готов <защитить> свою точку зрения в любом споре.",
                            "target_lang_translations": {
                                "en": "I am ready to <defend> my point of view in any dispute.",
                                "tr": "Herhangi bir tartışmada kendi bakış açımı <savunmaya> hazırım."
                            }
                        },
                        {
                            "text": "Брат всегда старался <защитить> сестру перед родителями.",
                            "target_lang_translations": {
                                "en": "The brother always tried to <defend> his sister in front of their parents.",
                                "tr": "Erkek kardeş, anne babasının önünde kız kardeşini her zaman <savunmaya> çalışırdı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "защитить мнение",
                        "защитить честь",
                        "защитить идею"
                    ],
                    "target_lang_definitions": {
                        "en": "To argue in support of an opinion or person; to uphold.",
                        "tr": "Bir fikri, görüşü veya kişiyi desteklemek, arkasında durmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "defend",
                                "target_lang_sense_clarification": "support an opinion or person"
                            },
                            {
                                "target_lang_word": "stand up for",
                                "target_lang_sense_clarification": "support someone"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "savunmak",
                                "target_lang_sense_clarification": "bir fikri veya kişiyi desteklemek"
                            },
                            {
                                "target_lang_word": "arkasında durmak",
                                "target_lang_sense_clarification": "destek çıkmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61263890-4a31-3068-b5b5-b3aacd00dbea",
                    "sense_definition": "Публично доказать достоинства выполненной научной или учебной работы для получения степени или квалификации.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студент должен <защитить> диплом, чтобы закончить университет.",
                            "target_lang_translations": {
                                "en": "The student must <defend> their thesis to graduate from the university.",
                                "tr": "Öğrenci, üniversiteden mezun olmak için diplomasını (tezini) <savunmak> zorundadır."
                            }
                        },
                        {
                            "text": "Она успешно <защитила> докторскую диссертацию в прошлом году.",
                            "target_lang_translations": {
                                "en": "She successfully <defended> her doctoral dissertation last year.",
                                "tr": "Geçen yıl doktora tezini başarıyla <savundu>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "защитить диссертацию",
                        "защитить диплом",
                        "защитить проект"
                    ],
                    "target_lang_definitions": {
                        "en": "To present and justify an academic work to a committee to obtain a degree.",
                        "tr": "Akademik bir derece almak için tez veya projeyi jüri önünde başarıyla sunmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "defend",
                                "target_lang_sense_clarification": "a thesis or dissertation"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "savunmak",
                                "target_lang_sense_clarification": "tez veya diplomayı jüri önünde sunmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc425fae-5b75-32d8-8f89-f16f9ac07a3d",
                    "sense_definition": "Выступать защитником обвиняемого в судебном процессе.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Адвокат сделал всё возможное, чтобы <защитить> своего клиента.",
                            "target_lang_translations": {
                                "en": "The lawyer did everything possible to <defend> his client.",
                                "tr": "Avukat, müvekkilini <savunmak> için elinden gelen her şeyi yaptı."
                            }
                        },
                        {
                            "text": "Ему было трудно <защитить> подсудимого из-за наличия серьёзных улик.",
                            "target_lang_translations": {
                                "en": "It was difficult for him to <defend> the accused due to the presence of serious evidence.",
                                "tr": "Ciddi delillerin olması nedeniyle sanığı <savunması> onun için zordu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "защитить в суде",
                        "защитить обвиняемого"
                    ],
                    "target_lang_definitions": {
                        "en": "To represent a defendant in a court of law.",
                        "tr": "Mahkemede sanığın avukatlığını yapmak, onu savunmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "defend",
                                "target_lang_sense_clarification": "represent in court"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "savunmak",
                                "target_lang_sense_clarification": "mahkemede müvekkili temsil etmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}