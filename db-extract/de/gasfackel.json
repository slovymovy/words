                "senses": [
                    {
                        "sense_id": "a64fdea5-d2d6-3cab-8420-3350b5c174bc",
                        "entry_id": "9e288352-fe7d-3d5c-8bb9-b14f264b925d",
                        "glosses": [
                            "Einrichtung zur gezielten Abfackelung von brennbaren Gasen, die nicht energetisch oder stofflich genutzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8159c391-ec8b-42fa-9b82-074597fe5e25",
                                "sense_id": "a64fdea5-d2d6-3cab-8420-3350b5c174bc",
                                "text": "„Ihre Flüsse waren bereits vergiftet und taugten nicht mehr zum Fischen, und das Land brachte nur noch Gasfackeln und Pipelines hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c833eecc-9970-4c29-88a9-3662cd20c44f",
                        "source_entry_id": "9e288352-fe7d-3d5c-8bb9-b14f264b925d",
                        "source_sense_id": "a64fdea5-d2d6-3cab-8420-3350b5c174bc",
