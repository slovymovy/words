                "senses": [
                    {
                        "sense_id": "53b8e410-675f-3b76-944c-20b050723660",
                        "entry_id": "3f628eb9-dd0e-3066-a1c5-f7a252aaadba",
                        "glosses": [
                            "tot een bepaald land behorende persoon"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "336499a2-3a4f-4cc7-9247-5443454684d8",
                                "sense_id": "53b8e410-675f-3b76-944c-20b050723660",
                                "text": "Na den dood van den stadhouder Joost van Lalaing werd heer Jan, ingevolge het van Maximiliaan verkregen privilegie, dat de stadhouder een landsman moest zijn, zijn opvolger."
                            }
                        ]
                    },
                    {
                        "sense_id": "72347540-6b32-38ad-8f00-0aad844c8128",
                        "entry_id": "3f628eb9-dd0e-3066-a1c5-f7a252aaadba",
                        "glosses": [
                            "landgenoot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fde1ace-fb14-45e1-811e-cc04c3afe521",
                                "sense_id": "72347540-6b32-38ad-8f00-0aad844c8128",
                                "text": "Rorik vertrok toen met zijn landsman Godfried naar Denemarken om een gooi te doen naar het koningschap."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c9d2840-74a0-3ee0-b998-eccc793bfffc",
                        "entry_id": "3f628eb9-dd0e-3066-a1c5-f7a252aaadba",
