                    {
                        "translation_id": "5c1ad213-9c76-4848-9d43-e79e02a51f67",
                        "source_entry_id": "c24ce73b-3a73-354b-8352-82679b3aa467",
                        "source_sense_id": "84e6fefc-435b-3e68-97c8-5c9fe0d3c18c",
                        "target_lang_word": "Irritabilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Irritabilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74707916-1617-3704-b334-ab2234e7e56f",
                                        "entry_id": "bd90486b-1065-3bf9-a40e-e46d592e20ee",
                                        "glosses": [
                                            "Eigenschaft, reizbar (irritabel) zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c0517c0-36e1-4b19-898a-449dae121f6d",
                                                "sense_id": "74707916-1617-3704-b334-ab2234e7e56f",
                                                "text": "„Untersucht werden soll, ob die Irritabilität und die Regeneration der Haut vom Verlauf des weiblichen Zyklus abhängig ist, das heißt, ob Frauen zu unterschiedlichen Zyklusphasen eine unterschiedliche Irritabilität und Regeneration der Hautbarriere aufweisen.“"
                                            },
                                            {
                                                "example_id": "3f8f1bf0-d4f8-4e93-8244-27974aa393e7",
                                                "sense_id": "74707916-1617-3704-b334-ab2234e7e56f",
                                                "text": "„Die Depression, die sich auch schon initial präsentieren kann, ist neben Traurigkeit und Pessimismus durch Dysphorie, Gereiztheit oder Irritabilität charakterisiert.“"
                                            },
                                            {
                                                "example_id": "0b53889c-3972-49a1-8919-16b32f3db457",
                                                "sense_id": "74707916-1617-3704-b334-ab2234e7e56f",
                                                "text": "„Es kann im sozialen System also auch dieser Bereich der wechselseitigen Bezogenheit, der Irritabilitäten und Effekte, die durch die Operationen des je anderen Systems angestoßen werden, beobachtet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
