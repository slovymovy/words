                "senses": [
                    {
                        "sense_id": "4cb498b1-c38a-389b-a67d-c608ee231ddb",
                        "entry_id": "4640327e-b818-3d90-8976-e02fb151c9f7",
                        "glosses": [
                            "betrekking hebbend op een vergadering van de hoge geestelijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aef1ff6d-a945-4df1-9dc9-b14d5bfcc40e",
                                "sense_id": "4cb498b1-c38a-389b-a67d-c608ee231ddb",
                                "text": "De plannen van de Protestantse Gemeente Enschede stuiten op veel onbegrip en kritiek. De kerkelijke gemeente van de voormalige hervormde en synodaal-gereformeerde christenen is voornemens om vier van de zes kerkgebouwen in de verkoop te zetten, het huren van nog een andere kerk te staken en de zeven wijkgemeenten te vervangen door vier wijkgemeenschappen voor het pastoraat."
                            },
                            {
                                "example_id": "d040f4c7-48b5-458e-a076-22a4510ca167",
                                "sense_id": "4cb498b1-c38a-389b-a67d-c608ee231ddb",
                                "text": "Het zou een soort conciliair of synodaal proces zijn, al wil ik daarmee nog niets over de gewenste juridische vormgeving zeggen."
                            }
                        ]
                    }
