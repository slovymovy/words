                        "tacky decorations"
                    ]
                },
                {
                    "sense_id": "93c60e21-d2a4-37fe-821f-3545bf5a8ee3",
                    "sense_definition": "Cheaply made or of shoddy, poor quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bad_taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seaside gift shop was filled with <w>tacky</w> plastic trinkets that broke easily."
                        },
                        {
                            "text": "He bought a <w>tacky</w> watch on the street that stopped working the very next day."
                        }
