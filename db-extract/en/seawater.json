                "translations": [
                    {
                        "translation_id": "857d8b91-ac5c-4ee7-a421-00750d2d08c9",
                        "source_entry_id": "3bc233bb-b819-3500-880f-30593142b060",
                        "source_sense_id": "95d81ce2-6927-37d5-9edb-e32fd8693c52",
                        "source_sense_description": "salt water of a sea or ocean",
                        "target_lang_word": "zeewater",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zeewater",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c6698120-3ff0-3ec2-8851-77749c6c5cd9",
                                        "entry_id": "6b2bd504-9bf6-3581-8841-0548837d7c1d",
                                        "glosses": [
                                            "water waarin diverse zouten zijn opgelost en waarmee de zeeën gevuld zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e069c163-fde6-4f9f-b671-10d5790a0a13",
                                                "sense_id": "c6698120-3ff0-3ec2-8851-77749c6c5cd9",
                                                "text": "Zeebiologen waarschuwden begin vorig jaar al dat de aanhoudende recordtemperaturen van het zeewater tot grootschalige verbleking van het koraal zou leiden. Die hoge temperaturen zijn het gevolg van de klimaatverandering en het periodieke weerfenomeen El Niño, dat gepaard gaat met opwarming van het zeewater in de Stille Oceaan. De daarop volgende La Niña die op haar beurt voor afkoeling zorgt, duurde korter dan normaal, waardoor de riffen geen tijd hadden om te herstellen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "184765f4-1173-4b0e-b039-43ca4931f456",
                        "source_entry_id": "3bc233bb-b819-3500-880f-30593142b060",
                        "source_sense_id": "95d81ce2-6927-37d5-9edb-e32fd8693c52",
                        "source_sense_description": "salt water of a sea or ocean",
                        "target_lang_word": "eau de mer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eau de mer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25d6bebc-3754-3a33-8ecb-973f86d464e9",
                                        "entry_id": "10ce225f-3349-37c5-af6f-260160ff67c3",
                                        "glosses": [
                                            "Eau salée des mers et des océans de la Terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8aaac40-ba69-4abd-a4c1-86e7bf46de5e",
                                                "sense_id": "25d6bebc-3754-3a33-8ecb-973f86d464e9",
                                                "text": "Quand il fut bien clair que rien d’autres ne serait sauvé, ils revinrent à la rive, tout ruisselants d’eau de mer."
                                            },
                                            {
                                                "example_id": "f98f637d-585c-4c45-9dd2-42e8b979dce3",
                                                "sense_id": "25d6bebc-3754-3a33-8ecb-973f86d464e9",
                                                "text": "La salinité moyenne de l'eau de mer est de 35 g/L."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd02d9fa-46b0-4379-8e20-cc229fc08933",
                        "source_entry_id": "3bc233bb-b819-3500-880f-30593142b060",
                        "source_sense_id": "95d81ce2-6927-37d5-9edb-e32fd8693c52",
                        "source_sense_description": "salt water of a sea or ocean",
                        "target_lang_word": "Meerwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meerwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                        "entry_id": "c461ab2c-8b83-3a7c-973f-0a9decf422f9",
                                        "glosses": [
                                            "das salzhaltige Wasser, aus dem die Meere bestehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1007e9b3-994c-48da-b920-4df25ef86f7c",
                                                "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                                "text": "„Auf der frühen Erde wurden die Kontinente durch Vulkanausbrüche erschüttert und jeder komplexe chemische Stoff wäre auf dem Land bald zerstört worden. Meerwasser hingegen löst chemische Stoffe gut auf und ermöglicht es ihnen, zu reagieren.“"
                                            },
                                            {
                                                "example_id": "82f84503-87a1-4188-935e-aff999430789",
                                                "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                                "text": "„In größeren Mengen genossen führt das Meerwasser zu schweren gesundheitlichen Störungen, die bei verdurstenden Personen im Wahnsinn enden.“"
                                            },
                                            {
                                                "example_id": "06cec1b3-9d39-47d0-af15-d7d4aaacff7e",
                                                "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                                "text": "„Die Festung liegt am Rande der Stadt, direkt neben einer Dattelpalmenplantage, und sieht aus wie eine Sandburg, die jemand mit viel Ehrgeiz erbaut hat und über die schon etliche Wellen Meerwasser geschwappt sind.“"
                                            },
                                            {
                                                "example_id": "92443fbf-24e9-4be4-a3bf-ba5e04e0f74d",
                                                "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                                "text": "„Das warme, salzhaltige Meerwasser hat bei ihr die Wirkung einer Heilquelle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "018de5ca-94b1-4262-8ab2-4d136834da9b",
                        "source_entry_id": "3bc233bb-b819-3500-880f-30593142b060",
                        "source_sense_id": "95d81ce2-6927-37d5-9edb-e32fd8693c52",
                        "source_sense_description": "salt water of a sea or ocean",
                        "target_lang_word": "Salzwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salzwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "705b95d1-663b-3d5f-90de-1d93281d99fd",
                                        "entry_id": "b3606b0c-ab3a-390d-93f3-3338ee3cd805",
                                        "glosses": [
                                            "Wasser, in dem Salz (meist Natriumchlorid) in mehr oder weniger hoher Konzentration gelöst ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11cc5c0e-b0e0-4661-a919-05cd4dedc00e",
                                                "sense_id": "705b95d1-663b-3d5f-90de-1d93281d99fd",
                                                "text": "„Eine Spritze haben wir nicht, also wird mir lauwarmes Salzwasser eingeflößt.“"
                                            },
                                            {
                                                "example_id": "e1d73aeb-be6e-45ee-8875-e25a419c1c3a",
                                                "sense_id": "705b95d1-663b-3d5f-90de-1d93281d99fd",
                                                "text": "Wenn man Salzwasser trinkt, bekommt man noch mehr Durst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5847333-2dad-37ac-a277-26bc61606907",
                                        "entry_id": "b3606b0c-ab3a-390d-93f3-3338ee3cd805",
                                        "glosses": [
                                            "andere Bezeichnung für Meerwasser (siehe [1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eed8fd2-953b-4f08-a79a-ffe245d90045",
                                                "sense_id": "d5847333-2dad-37ac-a277-26bc61606907",
                                                "text": "Wenn man Salzwasser trinkt, bekommt man noch mehr Durst."
                                            },
                                            {
                                                "example_id": "83887273-46a2-4f6d-a9ba-e582bd35f9a2",
                                                "sense_id": "d5847333-2dad-37ac-a277-26bc61606907",
                                                "text": "„Und wenn es etwas gab, was Helgoland das ganze Jahr hindurch im Überfluss hatte, dann kaltes Salzwasser.“"
                                            },
                                            {
                                                "example_id": "d6bc6337-cc2e-4521-a2fe-07a80556a5da",
                                                "sense_id": "d5847333-2dad-37ac-a277-26bc61606907",
                                                "text": "„Sieben Tage zwischen Strandliege und Salzwasser haben mich verwandelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
