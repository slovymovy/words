                ],
                "senses": [
                    {
                        "sense_id": "41072d73-2286-3bd1-8acb-518965f26379",
                        "entry_id": "dbcb0d98-3c61-3163-80c0-db16938073c5",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a9be55d-08c5-413f-b6e2-13205ad96dc3",
                                "sense_id": "41072d73-2286-3bd1-8acb-518965f26379",
                                "text": "Frau Wörner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c9cdaa6c-74c6-4c97-b58a-840723984fa2",
                                "sense_id": "41072d73-2286-3bd1-8acb-518965f26379",
                                "text": "Herr Wörner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "58c3382e-738d-4f08-b442-7dc239ce7831",
                                "sense_id": "41072d73-2286-3bd1-8acb-518965f26379",
                                "text": "Die Wörners fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4b4a0654-29fb-4441-9a2b-e07a16295fc6",
                                "sense_id": "41072d73-2286-3bd1-8acb-518965f26379",
                                "text": "Der Wörner trägt nie die Schals, die die Wörner ihm strickt."
                            },
                            {
                                "example_id": "6bacb3a9-420d-4e8f-af31-e41799f33eb3",
                                "sense_id": "41072d73-2286-3bd1-8acb-518965f26379",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wörner kommt, geht der Herr Wörner.“"
                            },
                            {
                                "example_id": "05622ea9-72a6-41ca-acb1-6125693d8bed",
                                "sense_id": "41072d73-2286-3bd1-8acb-518965f26379",
                                "text": "Wörner kommt und geht."
                            },
                            {
                                "example_id": "fa1ed94b-73ba-4bf1-9c40-ba1cc98a3251",
                                "sense_id": "41072d73-2286-3bd1-8acb-518965f26379",
                                "text": "Wörners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
