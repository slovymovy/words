                            {
                                "example_id": "d6964777-0587-4cdc-b082-01811358aa70",
                                "sense_id": "734a0788-d53d-39b9-a3f2-a63c1a87022c",
                                "text": "„Gemahlene Walnussschalen werden teilweise in Form von Granulat als Strahlmittel für Oberflächenbehandlungen eingesetzt.“"
                            },
                            {
                                "example_id": "c37ffd63-4385-4f84-a589-8b58b803460f",
                                "sense_id": "734a0788-d53d-39b9-a3f2-a63c1a87022c",
                                "text": "„In süddeutschen Pfahlbauten fand man Anfang des 20. Jahrhunderts einzelne Walnussschalen.“"
                            }
