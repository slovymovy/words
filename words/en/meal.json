{
    "word_family": [
        "bonemeal",
        "cornmeal",
        "fishmeal",
        "mealtime",
        "mealy",
        "oatmeal",
        "piecemeal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e95ea01c-cd78-3288-aced-6e79d26f82c2",
                    "sense_definition": "Food that is prepared and eaten, usually at a specific time, and usually in a comparatively large quantity (as opposed to a snack).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Breakfast is the morning <w>meal</w>, lunch is the noon <w>meal</w>, and dinner is the evening <w>meal</w>.",
                            "target_lang_translations": {
                                "ru": "Завтрак — это утренний <w>приём пищи</w>, обед — дневной <w>приём пищи</w>, а ужин — вечерний <w>приём пищи</w>."
                            }
                        },
                        {
                            "text": "After the <w>meal</w>, he rinsed the cans they had eaten from and put them away.",
                            "target_lang_translations": {
                                "ru": "После <w>еды</w> он сполоснул банки, из которых они ели, и убрал их."
                            }
                        },
                        {
                            "text": "I am looking for a recipe to turn a lone cheese into a <w>satisfying</w> <w>meal</w>.",
                            "target_lang_translations": {
                                "ru": "Я ищу рецепт, чтобы превратить один только сыр в сытную <w>трапезу</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "repast",
                        "refection"
                    ],
                    "common_phrases": [
                        "satisfying meal",
                        "hearty meal",
                        "cooked meal",
                        "daily meal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пища, приготовленная и съедаемая обычно в определенное время и в сравнительно большом количестве (в отличие от перекуса)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приём пищи",
                                "target_lang_sense_clarification": "процесс или событие"
                            },
                            {
                                "target_lang_word": "еда",
                                "target_lang_sense_clarification": "приготовленная пища"
                            },
                            {
                                "target_lang_word": "трапеза",
                                "target_lang_sense_clarification": "книжное или формальное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "164144b1-e381-32a7-8187-5ba58a6d3496",
                    "sense_definition": "Food served or eaten as a repast.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food_consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vast numbers of insects made for good <w>meals</w> for birds and small mammals.",
                            "target_lang_translations": {
                                "ru": "Огромное количество насекомых служило хорошей <w>пищей</w> для птиц и мелких млекопитающих."
                            }
                        },
                        {
                            "text": "This is the <w>meal</w> pleasantly set for natural hunger.",
                            "target_lang_translations": {
                                "ru": "Это <w>еда</w>, приятно приготовленная для естественного голода."
                            }
                        }
                    ],
                    "synonyms": [
                        "repast"
                    ],
                    "common_phrases": [
                        "good meal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пища, подаваемая или употребляемая в качестве трапезы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пища",
                                "target_lang_sense_clarification": "питание"
                            },
                            {
                                "target_lang_word": "еда",
                                "target_lang_sense_clarification": "кушанье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b83275e6-e7b6-3d31-8648-9f0a31f6c941",
                    "sense_definition": "A break taken by a police officer in order to eat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "work_break",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was <w>on</w> <w>meal</w> when I heard the call on the radio and recognized the address.",
                            "target_lang_translations": {
                                "ru": "Я был на <w>обеденном перерыве</w>, когда услышал вызов по рации и узнал адрес."
                            }
                        },
                        {
                            "text": "Tape recorders can be turned off while officers are <w>on</w> <w>meal</w> to protect their privacy.",
                            "target_lang_translations": {
                                "ru": "Диктофоны можно выключать, пока офицеры находятся на <w>перерыве</w>, чтобы защитить их частную жизнь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on meal"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used specifically within police jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перерыв, который делает полицейский, чтобы поесть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обеденный перерыв",
                                "target_lang_sense_clarification": "в полиции"
                            },
                            {
                                "target_lang_word": "перерыв на обед",
                                "target_lang_sense_clarification": "служебный жаргон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27111764-e319-39c4-b9b6-99316dc91f93",
                    "sense_definition": "A time or an occasion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time_occasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Of all the day throughout, keep I no better <w>meal</w> than on her to think.",
                            "target_lang_translations": {
                                "ru": "Во всем дне нет для меня лучшего <w>времени</w>, чем то, когда я думаю о ней."
                            }
                        },
                        {
                            "text": "They would weep at every <w>meal</w>, but for my son they never weep at all.",
                            "target_lang_translations": {
                                "ru": "Они плакали при каждом <w>случае</w>, но о моем сыне они не плачут вовсе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Время или случай."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "время",
                                "target_lang_sense_clarification": "устаревшее"
                            },
                            {
                                "target_lang_word": "случай",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b940606f-40b5-3ed0-a818-51aa2b39effd",
                    "sense_definition": "The ground-up edible part of various grains, used as a basis of food or feed; either flour or a coarser blend than flour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "granular_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Animals were harnessed to capstans to turn <w>grist</w> <w>into</w> <w>meal</w>.",
                            "target_lang_translations": {
                                "ru": "Животных запрягали в кабестаны, чтобы превращать зерно в <w>муку</w>."
                            }
                        },
                        {
                            "text": "The recipe requires a cup of coarse <w>corn</w> <w>meal</w> for the bread.",
                            "target_lang_translations": {
                                "ru": "Для хлеба по рецепту требуется чашка кукурузной <w>муки</w> грубого помола."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grist into meal",
                        "coarse meal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размолотая съедобная часть различных зерен, используемая как основа для пищи или корма; мука или смесь более грубого помола, чем мука."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мука",
                                "target_lang_sense_clarification": "грубого помола"
                            },
                            {
                                "target_lang_word": "крупа",
                                "target_lang_sense_clarification": "измельченное зерно"
                            },
                            {
                                "target_lang_word": "шрот",
                                "target_lang_sense_clarification": "кормовой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cd0b2f6-d4b9-360e-98b6-3f02e94e81d4",
                    "sense_definition": "Any of various similarly granular materials prepared from other sources, such as bones or wood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "granular_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener added <w>bone</w> <w>meal</w> to the soil to provide extra phosphorus for the plants.",
                            "target_lang_translations": {
                                "ru": "Садовник добавил в почву костную <w>муку</w>, чтобы обеспечить растения дополнительным фосфором."
                            }
                        },
                        {
                            "text": "The factory produces <w>wood</w> <w>meal</w> as a byproduct of the sanding process.",
                            "target_lang_translations": {
                                "ru": "Завод производит древесную <w>муку</w> как побочный продукт процесса шлифовки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bone meal",
                        "wood meal",
                        "fish meal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любые аналогичные гранулированные материалы, приготовленные из других источников, таких как кости или древесина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мука",
                                "target_lang_sense_clarification": "костная, древесная и т.д."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c606e6bb-47d6-38c1-821d-a372ca2f7a1f",
                    "sense_definition": "To yield or be plentiful in meal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "yield_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ears of grain being well filled, it <w>mealed</w> well despite the small harvest.",
                            "target_lang_translations": {
                                "ru": "Колосья были полными, поэтому зерно <w>дало много муки</w>, несмотря на небольшой урожай."
                            }
                        },
                        {
                            "text": "Farmers hoped the new variety of corn would <w>meal</w> better than the old one.",
                            "target_lang_translations": {
                                "ru": "Фермеры надеялись, что новый сорт кукурузы будет <w>давать больше муки</w>, чем старый."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mealed well"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать или быть обильным на муку (при помоле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать муку",
                                "target_lang_sense_clarification": "о зерне"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}