                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "986abbae-edb6-4788-92c7-5202e27248d5",
                                                "sense_id": "e709ccf8-5347-39bc-8518-58b3b68de768",
                                                "text": "My abhorrence of this fiend cannot be conceived."
                                            },
                                            {
                                                "example_id": "176ef0cc-888a-4e22-8949-b42e39aae351",
                                                "sense_id": "e709ccf8-5347-39bc-8518-58b3b68de768",
                                                "text": "The recognition of what pollutes evidently reflects deep-seated abhorrences, whose cause and origin are difficult to discover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71da6c5a-240c-3f20-86b5-297d8d1b55ac",
                                        "entry_id": "426e106a-2478-3f5a-8a08-a40f1fd5f955",
                                        "glosses": [
                                            "An expression of abhorrence, in particular any of the parliamentary addresses dictated towards Charles II."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff3061b6-5c98-3c7b-80e4-881398c78b06",
                                        "entry_id": "426e106a-2478-3f5a-8a08-a40f1fd5f955",
                                        "glosses": [
                                            "A person or thing that is loathsome; a detested thing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61e6e6c2-0943-4938-bc99-e68e4d27ef91",
                                                "sense_id": "ff3061b6-5c98-3c7b-80e4-881398c78b06",
                                                "text": "All of them are תובעות abhorrences or abominations, although “adultery and bestiality” are branded as “unclean” (אמט) activities. Because “homosexuality” is classified as one of the “abhorrences,” Milgrom believes the practice was “widespread.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "208652d4-d79e-4dae-bdb7-d08247a55e39",
                        "source_entry_id": "7dcdcea1-e89c-3510-9f7c-a2ad291ae115",
                        "source_sense_id": "88cbe2df-d6e8-3aaf-bd64-bd5dbcdd4bd7",
                        "target_lang_word": "abomination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abomination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72c40462-2dc7-3f91-91ba-43b33d8a4147",
                                        "entry_id": "f14aaf5f-dcea-363f-8729-4d42819bb6aa",
                                        "glosses": [
                                            "An abominable act; a disgusting vice; a despicable habit."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48e304d8-61a1-44c1-85fa-c348edfa87a1",
                                                "sense_id": "72c40462-2dc7-3f91-91ba-43b33d8a4147",
                                                "text": "Onely th’adulterous Anthony, most large / In his abhominations, turnes you off"
                                            },
                                            {
                                                "example_id": "6688ee4a-a186-4d3f-b0bf-372be0e49c42",
                                                "sense_id": "72c40462-2dc7-3f91-91ba-43b33d8a4147",
                                                "text": "Religious sodomy was practised by male prostitutes in the Hebrew temple groves, which was one of the abominations of Israel that Josiah cleared away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e13e11a-cc87-3cd8-851a-478417079ace",
                                        "entry_id": "f14aaf5f-dcea-363f-8729-4d42819bb6aa",
                                        "glosses": [
                                            "The feeling of extreme disgust and hatred"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34e29b6e-4faf-337d-adb1-906b2525f6fa",
                                        "entry_id": "f14aaf5f-dcea-363f-8729-4d42819bb6aa",
                                        "glosses": [
                                            "A state that excites detestation or abhorrence; pollution."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "582f3037-1370-336e-a6ee-c63a6309ced0",
                                        "entry_id": "f14aaf5f-dcea-363f-8729-4d42819bb6aa",
                                        "glosses": [
                                            "That which is abominable, shamefully vile; an object that excites disgust and hatred (often with religious undertones)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "165c0245-11fa-4af7-8e8a-0881f8175df2",
                                                "sense_id": "582f3037-1370-336e-a6ee-c63a6309ced0",
                                                "text": "Appalled by a child she found hideous, Philyra begged the gods to free her from having to rear such an abomination."
                                            },
                                            {
                                                "example_id": "ce642071-7ba8-46f4-86d9-4836f56ed9f4",
                                                "sense_id": "582f3037-1370-336e-a6ee-c63a6309ced0",
                                                "text": "Elon Musk, the billionaire tech entrepreneur, has opened a new rift with Donald Trump by denouncing the US president’s tax and spending bill as a “disgusting abomination”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42ce0a6b-6e65-47c9-a23f-62ab7b25a610",
                        "source_entry_id": "7dcdcea1-e89c-3510-9f7c-a2ad291ae115",
                        "source_sense_id": "88cbe2df-d6e8-3aaf-bd64-bd5dbcdd4bd7",
                        "target_lang_word": "atrocity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atrocity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                        "entry_id": "35a41e01-ba4c-3a43-b3e4-6ca7f1a98403",
                                        "glosses": [
                                            "An extremely cruel act; a horrid act of injustice."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9e199cf-34a3-4a6b-820d-84d325055483",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "to carry out / commit / perpetrate an atrocity"
                                            },
                                            {
                                                "example_id": "ec7e0eba-d732-4f52-ae6a-ee53bb8f2512",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "The regime is guilty of mass atrocities including forced displacement and the use of chemical weapons."
                                            },
                                            {
                                                "example_id": "a5941f00-6ad7-40d9-9e0e-a54e06fae6f1",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "[…] it seemed an atrocity or cruelty to Narses a good General, to take punishment of innoxious Hostages:"
                                            },
                                            {
                                                "example_id": "3f74793e-1142-4466-b1c5-388825206b0a",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "It was impossible for the convention to suffer the crimes they had committed, and the still greater atrocities which they had meditated, to pass unnoticed."
                                            },
                                            {
                                                "example_id": "1eed3845-31a9-43a5-87c7-2759ca23cd69",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "This devilish outrage, this fiendish murder, produced, as it was well calculated to do, a tremendous sensation. […] The atrocity roused my old master, and he spoke out, in reprobation of it;"
                                            },
                                            {
                                                "example_id": "5c1b7ce1-2c7f-4b9b-a44b-fa5efbe963e2",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "“Any delay in arresting the assassin,” I observed, “might give him time to perpetrate some fresh atrocity.”"
                                            },
                                            {
                                                "example_id": "85f15751-bdfa-4716-b2a0-7d20be7ef6b1",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "The United Kingdom, the United States and the Soviet Union have received from many quarters evidence of atrocities, massacres and cold-blooded mass executions which are being perpetrated by Hitlerite forces in many of the countries they have overrun and from which they are now being steadily expelled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d86685-4aa8-35cc-91ff-4cb44ae9adfb",
                                        "entry_id": "35a41e01-ba4c-3a43-b3e4-6ca7f1a98403",
                                        "glosses": [
                                            "The quality or state of being atrocious; enormous wickedness; extreme criminality or cruelty."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e4d3dd5-9f70-40a0-b437-b22abd521723",
                                                "sense_id": "f6d86685-4aa8-35cc-91ff-4cb44ae9adfb",
                                                "text": "1553, John Bradford, letter, in Miles Coverdale (ed.), Certain Most Godly, Fruitful, and Comfortable letters, London: John Day, 1564, pp. 481-482,\nThys wil I muse on, & way with my self, [tha]t I may dulye knowe, both in me and in al other things, the atrocitie and bitternesse of synne which dwelleth in me, & so may the more hartely geue ouer my self wholy to [th]e lord Christ my Sauiour,"
                                            },
                                            {
                                                "example_id": "b5fbe989-9639-4b3c-bef1-946be2921154",
                                                "sense_id": "f6d86685-4aa8-35cc-91ff-4cb44ae9adfb",
                                                "text": "What character is so detestable as that of one who takes pleasure to sow dissention among friends, and to turn their most tender love into mortal hatred? Yet wherein does the atrocity of this so much abhorred injury consist? […] It is in depriving them of that friendship itself, in robbing them of each others affections […]"
                                            },
                                            {
                                                "example_id": "bb00af2e-dcc5-49cc-9622-2b87f5625c97",
                                                "sense_id": "f6d86685-4aa8-35cc-91ff-4cb44ae9adfb",
                                                "text": "an apology devised after the commission of the deed, to cover up its atrocity"
                                            },
                                            {
                                                "example_id": "45296e7b-8047-4eb1-aa37-748a4acb066f",
                                                "sense_id": "f6d86685-4aa8-35cc-91ff-4cb44ae9adfb",
                                                "text": "Here was one who had spent his life in lying to the world, and who was in his very heart shocked at the atrocity of a man who had lied to him!"
                                            },
                                            {
                                                "example_id": "4098df83-3af7-43ac-a911-796183cd44b1",
                                                "sense_id": "f6d86685-4aa8-35cc-91ff-4cb44ae9adfb",
                                                "text": "Hernandez […] had been an inoffensive, small ranchero, kidnapped with circumstances of peculiar atrocity from his home during one of the civil wars, and forced to serve in the army."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c3cc715-cc6d-338b-8db4-60956ef7a70c",
                                        "entry_id": "35a41e01-ba4c-3a43-b3e4-6ca7f1a98403",
                                        "glosses": [
                                            "An object considered to be extremely unattractive or undesirable."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a3ab2f-543a-4f13-bdc5-5bba341be2b9",
                                                "sense_id": "3c3cc715-cc6d-338b-8db4-60956ef7a70c",
                                                "text": "[S]ome of the printers were good singers and others good performers on the guitar and on that atrocity the accordeon—[…]"
                                            },
                                            {
                                                "example_id": "c8a6e7d2-5870-47dc-b5ec-0d88afe81ca9",
                                                "sense_id": "3c3cc715-cc6d-338b-8db4-60956ef7a70c",
                                                "text": "The Pools had given them a “hanging lamp,” coveted by the farmer’s wife; a hideous atrocity in yellow, with pink roses on its shade and prisms dangling and tinkling all around the edge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b1e65a7-9cfd-4593-8736-13e3765786aa",
                        "source_entry_id": "7dcdcea1-e89c-3510-9f7c-a2ad291ae115",
                        "source_sense_id": "88cbe2df-d6e8-3aaf-bd64-bd5dbcdd4bd7",
                        "target_lang_word": "horror",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horror",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "946a998d-ceaa-393c-9c25-71b4d28b3132",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "An intense distressing emotion of fear or repugnance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35e4f4e9-aaeb-4e78-ac38-5dc92a7e68ae",
                                                "sense_id": "946a998d-ceaa-393c-9c25-71b4d28b3132",
                                                "text": "Their swarthy Hosts wou'd darken all our Plains, / Doubling the native Horror of the War, / And making Death more grim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90d6cfd0-e58b-38ce-8bcd-8f11a95329d4",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "Something horrible; that which excites horror."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46517ae4-ec80-4e24-85cc-dce3b660c9d2",
                                                "sense_id": "90d6cfd0-e58b-38ce-8bcd-8f11a95329d4",
                                                "text": "I saw many horrors during the war."
                                            },
                                            {
                                                "example_id": "3de8c5e0-0402-478c-9909-830ae45deaec",
                                                "sense_id": "90d6cfd0-e58b-38ce-8bcd-8f11a95329d4",
                                                "text": "The Home Magazine for July (Binghamton and New York) contains ‘The Patriots' War Chant,’ a poem by Douglas Malloch; ‘The Story of the War,’ by Theodore Waters; ‘A Horseman in the Sky,’ by Ambrose Bierce, with a portrait of Mr. Bierce, whose tales of horror are horrible of themselves, not as war is horrible; ‘A Yankee Hero,’ by W. L. Calver; ‘The Warfare of the Future,’ by Louis Seemuller; ‘Florence Nightingale,’ by Susan E. Dickenson, with two rare portraits, etc."
                                            },
                                            {
                                                "example_id": "cb7ddbc1-55d3-48eb-837d-879641fd8b4f",
                                                "sense_id": "90d6cfd0-e58b-38ce-8bcd-8f11a95329d4",
                                                "text": "Could there be stories with more horror than these?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da2b6084-b161-3b40-b222-6d5cccb33531",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "Intense dislike or aversion; an abhorrence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c0bcdf3-6a67-4d98-8ccd-8888907878df",
                                                "sense_id": "da2b6084-b161-3b40-b222-6d5cccb33531",
                                                "text": "“Mrs. Yule's chagrin and horror at what she called her son's base ingratitude knew no bounds ; at first it was even thought that she would never get over it. […] ”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd05c32-4859-310a-9193-8fc798ca6b83",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "A genre of fiction designed to evoke a feeling of fear and suspense."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "482ae9b7-9600-484a-962e-7d90be6d1565",
                                                "sense_id": "1dd05c32-4859-310a-9193-8fc798ca6b83",
                                                "text": "Those who enjoy horror, stories overflowing with blood and black mystery, will be grateful to Richard Marsh for writing ‘The Beetle.’"
                                            },
                                            {
                                                "example_id": "a41f7892-5df0-460f-885c-2f939daa1b08",
                                                "sense_id": "1dd05c32-4859-310a-9193-8fc798ca6b83",
                                                "text": "A well-received Johnny Fuller R & B horror called \"Haunted House.\""
                                            },
                                            {
                                                "example_id": "a08870ad-4d06-4803-8d12-8c4879383d06",
                                                "sense_id": "1dd05c32-4859-310a-9193-8fc798ca6b83",
                                                "text": "[…] there were hastily produced B movies, such as the peplums, the spaghetti westerns, the detective stories, the horrors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aba2599-43f1-354d-a876-ae4e59d96c0b",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "A genre of fiction designed to evoke a feeling of fear and suspense.",
                                            "An individual work in this genre."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f673c6b-aff7-3cb9-bbf9-c3019beb0b8d",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "A nasty or ill-behaved person; a rascal or terror."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20d3908f-5ffb-455a-811f-5dd45cd91aad",
                                                "sense_id": "2f673c6b-aff7-3cb9-bbf9-c3019beb0b8d",
                                                "text": "The neighbour's kids are a pack of little horrors!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e670ef-bc45-3959-b8f0-7ec23c9f7e8d",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "An intense anxiety or a nervous depression; often the horrors."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17614222-7e8b-3c2c-b499-a0628c89a6db",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "Delirium tremens."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "218ac332-7393-4e06-bd51-7b3c93ad844f",
                                                "sense_id": "17614222-7e8b-3c2c-b499-a0628c89a6db",
                                                "text": "`My belief is that he had the horrors without knowin' it.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e074eeda-ea22-42fe-8ed6-8d9eb57299d5",
                        "source_entry_id": "7dcdcea1-e89c-3510-9f7c-a2ad291ae115",
                        "source_sense_id": "88cbe2df-d6e8-3aaf-bd64-bd5dbcdd4bd7",
                        "target_lang_word": "atrocité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atrocité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39ec41bf-d6d3-33af-99a6-a45c33ea7d23",
                                        "entry_id": "82dbc2b1-4f89-388b-a9c8-2e78e3a8ed2e",
                                        "glosses": [
                                            "Extrême cruauté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7de7e296-4544-4b62-8dbc-4dee54422f96",
                                                "sense_id": "39ec41bf-d6d3-33af-99a6-a45c33ea7d23",
                                                "text": "Le vieux tyran, pour garder sa puissance, n’est plus à une atrocité près."
                                            },
                                            {
                                                "example_id": "6058f6b3-a606-4877-9138-f2b337b57780",
                                                "sense_id": "39ec41bf-d6d3-33af-99a6-a45c33ea7d23",
                                                "text": "L’atrocité d’un supplice, d’un tyran."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5536e34e-c8bb-31b6-9051-731b51bc8908",
                                        "entry_id": "82dbc2b1-4f89-388b-a9c8-2e78e3a8ed2e",
                                        "glosses": [
                                            "Action très cruelle."
                                        ],
                                        "tags": [],
                                        "note": "Ce terme est généralement utilisé au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "5e982419-b169-46ae-a3c3-43990866ef17",
                                                "sense_id": "5536e34e-c8bb-31b6-9051-731b51bc8908",
                                                "text": "Commettre des atrocités."
                                            },
                                            {
                                                "example_id": "2c5aa6ae-fd2e-4132-ad82-b9c9bb9c40ac",
                                                "sense_id": "5536e34e-c8bb-31b6-9051-731b51bc8908",
                                                "text": "L’armée d’invasion se livra à mille atrocités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed234a27-5b4b-37ed-87cf-dda145c8f9c1",
                                        "entry_id": "82dbc2b1-4f89-388b-a9c8-2e78e3a8ed2e",
                                        "glosses": [
                                            "Propos blessants ou calomnieux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1f7d5d6-db45-4bfa-b40f-d959e1bca7b0",
                                                "sense_id": "ed234a27-5b4b-37ed-87cf-dda145c8f9c1",
                                                "text": "Il ne cesse de débiter des atrocités sur tout le monde."
                                            }
