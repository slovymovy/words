                    }
                ],
                "senses": [
                    {
                        "sense_id": "486336cb-d123-3e54-bd99-07923eb6917f",
                        "entry_id": "9ee80440-1566-3b5e-a0f7-560570fbd212",
                        "glosses": [
                            "Something capable of self-replication, like a gene or meme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d531f661-995e-4cba-9d7d-39bf8998077d",
                                "sense_id": "486336cb-d123-3e54-bd99-07923eb6917f",
                                "text": "We, alone on earth, can rebel against the tyranny of the selfish replicators."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb61b178-9898-30bd-a561-cc4f745599cf",
                        "entry_id": "9ee80440-1566-3b5e-a0f7-560570fbd212",
                        "glosses": [
                            "A technological device that replicates physical objects."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96cb7729-8b29-430e-ac3e-8f9d27803fce",
                                "sense_id": "bb61b178-9898-30bd-a561-cc4f745599cf",
                                "text": "Why, this planet was still centuries away from developing such necessities as personal replicators or portable nano-intelligences..."
                            },
                            {
                                "example_id": "c41d1d2b-bb34-4a8a-a0a1-8ffce435fd4c",
                                "sense_id": "bb61b178-9898-30bd-a561-cc4f745599cf",
                                "text": "either there is not such thing as a concept known as 'spacecraft' (inwhich case, any talk of spacecraft, warp drives, inertial dampers, replicators, and the like would be pointless), or indeed there is."
                            },
                            {
                                "example_id": "85a5858d-a63e-4a13-b394-7d70b1bbd91d",
                                "sense_id": "bb61b178-9898-30bd-a561-cc4f745599cf",
                                "text": "The scanner here on Earth will destroy my brain and body, while recording the exact states of all of my cells. It will the transmit this information by radio. Travelling at the speed of light, the message will take three minutes to reach the Replicator on Mars. This will then create, out of new matter, a brain and body exactly like mine. It will be in this body that I shall wake up."
                            }
                        ]
                    }
                ],
