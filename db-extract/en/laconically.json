                                                "example_id": "aee679af-9e0b-49cb-811e-0529db479822",
                                                "sense_id": "22fb85e7-faad-3127-a942-4b317a0cba1f",
                                                "text": "Allons, plaidez, ma sœur, exposez laconiquement le fait en peu de paroles."
                                            },
                                            {
                                                "example_id": "7fab55f3-c1da-437d-a0ea-aea05ba7603d",
                                                "sense_id": "22fb85e7-faad-3127-a942-4b317a0cba1f",
                                                "text": "« On ne peut pas prévoir les conditions de circulation, Madame », répond-il laconiquement."
                                            }
                                        ]
                                    }
