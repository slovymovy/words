{
    "word_family": [
        "important",
        "importantissime",
        "importer",
        "inimportance"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                    "sense_definition": "Caractère de ce qui est d'un grand intérêt, d'une grande valeur ou qui entraîne de lourdes conséquences.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "valeur_et_signification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décision aura une grande <w>importance</w> pour l'avenir de notre entreprise."
                        },
                        {
                            "text": "Le médecin souligne l'<w>importance</w> d'avoir une alimentation saine et équilibrée."
                        }
                    ],
                    "synonyms": [
                        "gravité",
                        "intérêt",
                        "portée",
                        "valeur"
                    ],
                    "common_phrases": [
                        "avoir de l'importance",
                        "attacher de l'importance",
                        "sans importance"
                    ]
                },
                {
                    "sense_id": "16071726-4f3f-3eef-91a3-b22ffe77abf1",
                    "sense_definition": "Caractère de ce qui est considérable en quantité, en volume, en nombre ou en étendue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "taille_et_quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>importance</w> des dégâts causés par la tempête est difficile à évaluer avec précision."
                        },
                        {
                            "text": "Ce port a vu son <w>importance</w> commerciale croître rapidement au fil des années."
                        }
                    ],
                    "synonyms": [
                        "ampleur",
                        "dimension",
                        "envergure",
                        "taille",
                        "volume"
                    ],
                    "common_phrases": [
                        "importance numérique",
                        "prendre de l'importance"
                    ]
                },
                {
                    "sense_id": "cdb1fad2-fd86-33b5-b716-60ced935fa59",
                    "sense_definition": "Autorité, crédit ou influence qu'une personne possède dans un groupe social ou politique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "statut_et_influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son nouveau poste ministériel lui confère une grande <w>importance</w> au sein du gouvernement."
                        },
                        {
                            "text": "Ce scientifique jouit d'une <w>importance</w> majeure auprès de la communauté internationale."
                        }
                    ],
                    "synonyms": [
                        "autorité",
                        "crédit",
                        "influence",
                        "notoriété",
                        "poids"
                    ],
                    "common_phrases": [
                        "homme d'importance",
                        "gagner en importance"
                    ]
                },
                {
                    "sense_id": "67654ab0-a551-3570-8287-7e2c916ba829",
                    "sense_definition": "Attitude prétentieuse d'une personne qui cherche à paraître supérieure à ce qu'elle est en réalité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pretention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il parlait avec un ton plein d'<w>importance</w> qui agaçait tous ses collègues de travail."
                        },
                        {
                            "text": "Elle aime se donner des airs d'<w>importance</w> dès qu'elle rencontre de nouvelles personnes."
                        }
                    ],
                    "synonyms": [
                        "arrogance",
                        "suffisance",
                        "vanité"
                    ],
                    "common_phrases": [
                        "se donner de l'importance",
                        "air d'importance",
                        "ton d'importance"
                    ]
                }
            ]
        }
    ]
}