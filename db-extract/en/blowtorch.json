                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c2058093-627b-42b0-81e4-ae78bcff9780",
                                "sense_id": "e3539289-0f0a-33a1-9914-797e1c882c7f",
                                "text": "When the firecan jockeys have flown their blowtorches some 100,000 miles, the doctors take over for the ground physical."
                            }
