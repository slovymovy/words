                                "example_id": "408c8392-6360-4add-b727-bccc827291ad",
                                "sense_id": "0ba5902e-7482-392a-a266-fee351c23de3",
                                "text": "„Darum stieg der Norbert auch, nachdem der polnische Suderant unter ihm endlich eingeschlafen war, von seinem Bett hinunter und brunzte ihm auf seine Tuchent.“"
                            },
                            {
                                "example_id": "46a6c10b-2839-4018-9542-e33d481d5bdd",
                                "sense_id": "0ba5902e-7482-392a-a266-fee351c23de3",
                                "text": "„Suderanten in rund 40 Ländern kamen der Aufforderung nach.“"
                            }
                        ],
