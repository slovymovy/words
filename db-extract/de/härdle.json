                "senses": [
                    {
                        "sense_id": "191af59b-e52b-31fe-9630-bf18d9f70e3a",
                        "entry_id": "131a8bcb-9e22-3a96-a788-c9cafb186634",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f8470d4-f5d6-43dc-b455-9ab2dd1ba89a",
                                "sense_id": "191af59b-e52b-31fe-9630-bf18d9f70e3a",
                                "text": "Frau Härdle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f837a2c2-71f0-4ed9-8283-6810f2f8d99f",
                                "sense_id": "191af59b-e52b-31fe-9630-bf18d9f70e3a",
                                "text": "Herr Härdle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "627bcd9b-41be-4fe9-a410-5facce35cb21",
                                "sense_id": "191af59b-e52b-31fe-9630-bf18d9f70e3a",
                                "text": "Die Härdles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "128c9a18-cf0a-4bf1-a989-43defb363373",
                                "sense_id": "191af59b-e52b-31fe-9630-bf18d9f70e3a",
                                "text": "Der Härdle trägt nie die Schals, die die Härdle ihm strickt."
                            },
                            {
                                "example_id": "5e53f11d-aa42-48c0-883b-ab8cd51e2f9f",
                                "sense_id": "191af59b-e52b-31fe-9630-bf18d9f70e3a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Härdle kommt, geht der Herr Härdle.“"
                            },
                            {
                                "example_id": "65219aee-55a7-4457-8993-53768fb7a35c",
                                "sense_id": "191af59b-e52b-31fe-9630-bf18d9f70e3a",
                                "text": "Härdle kommt und geht."
                            },
                            {
                                "example_id": "e2bf0668-cac6-4a73-ac21-8e058980b6f7",
                                "sense_id": "191af59b-e52b-31fe-9630-bf18d9f70e3a",
                                "text": "Härdles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
