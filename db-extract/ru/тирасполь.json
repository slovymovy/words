                                        "entry_id": "8a9db831-b782-37c0-97b5-7ccc257e0cc6",
                                        "glosses": [
                                            "am Dnister gelegene Großstadt in Moldawien beziehungsweise im De-facto-Regime Transnistrien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a9cc19d-d5ab-4f4d-92a8-4b183fbdd540",
                                                "sense_id": "75e23593-c416-36e9-8906-b6aa7556f8de",
                                                "text": "„Hinter Tiraspol fährt man durch Apfelbaumplantagen, frischgeschnittenen Weingärten und Werbetafeln für Regenrinnen nach Norden.“"
                                            }
                                        ],
