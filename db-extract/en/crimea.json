                                        "entry_id": "a41acba7-9cc7-30f8-9203-b3333a604537",
                                        "glosses": [
                                            "półwysep na Morzu Czarnym, połączony z lądem tylko wąskim Przesmykiem Perekopskim; terytorium sporne między Ukrainą a Rosją"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "976e9339-907f-4947-bdea-e3ca4baca4da",
                                                "sense_id": "0fa7c15d-6e5f-39bd-9ad8-4da754d5065e",
                                                "text": "Jeżdżę na Krym do mojej tatarskiej rodziny."
                                            },
                                            {
                                                "example_id": "362e2d7f-dd00-47ae-a547-0b26e2f0cf7a",
                                                "sense_id": "0fa7c15d-6e5f-39bd-9ad8-4da754d5065e",
                                                "text": "Dodatkowo broniący się na Krymie Rosjanie ponieśli większe straty w ludziach od atakujących, co dowiodło dużych dysproporcji w umiejętności organizacji działań wojennych"
                                            }
