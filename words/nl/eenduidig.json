    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "36f638cd-4b11-3a1c-8f90-6a258e68081d",
                    "sense_definition": "Wat slechts op één manier kan worden uitgelegd en geen twijfel laat bestaan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De regels van de school moeten heel <w>eenduidig</w> zijn voor iedereen.",
                            "target_lang_translations": {
                                "en": "The school rules must be very <w>unambiguous</w> for everyone."
                            }
                        },
                        {
                            "text": "De directeur gaf een <w>eenduidig</w> antwoord op al onze vragen.",
                            "target_lang_translations": {
                                "en": "The director gave an <w>unequivocal</w> answer to all our questions."
                            }
                        }
                    ],
                    "synonyms": [
                        "duidelijk",
                        "ondubbelzinnig"
                    ],
                    "common_phrases": [
                        "een eenduidig antwoord"
                    ],
                    "target_lang_definitions": {
                        "en": "That which can only be interpreted in one way and leaves no room for doubt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unambiguous",
                                "target_lang_sense_clarification": "clear and leaving no room for doubt or multiple interpretations"
                            },
                            {
                                "target_lang_word": "unequivocal",
                                "target_lang_sense_clarification": "expressed in a way that is clear, explicit, and leaves no doubt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3736ea26-bbd8-3046-b0fb-6ffd262802b1",
                    "sense_definition": "Op een manier die maar op één wijze begrepen kan worden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De uitslag van het onderzoek werd <w>eenduidig</w> geformuleerd.",
                            "target_lang_translations": {
                                "en": "The results of the study were <w>unambiguously</w> formulated."
                            }
                        },
                        {
                            "text": "Hij sprak heel <w>eenduidig</w> over de plannen voor de toekomst.",
                            "target_lang_translations": {
