                    {
                        "sense_id": "ed667569-dbc1-3f83-815c-7cace4f29f20",
                        "entry_id": "a975c6d1-755b-3f89-8c1c-d31cd9a59821",
                        "glosses": [
                            "Pflanzenart aus der Familie der Aronstabgewächse (Araceae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aafa41b-9707-41a1-9c93-5317d79190ed",
                                "sense_id": "ed667569-dbc1-3f83-815c-7cace4f29f20",
                                "text": "In meiner Blumenecke fehlt auch der Philodendron nicht."
                            },
                            {
                                "example_id": "4696fd3d-53e4-4299-bbff-74b2f1e5da37",
                                "sense_id": "ed667569-dbc1-3f83-815c-7cace4f29f20",
                                "text": "„Gordon verneigte sich, und einen Augenblick später traten beide nach Passierung eines schon im Seitenflügel gelegenen und mit Philodendron und anderen Blattpflanzen fast überfüllten Raumes auf einen Vorbau hinaus, der, aus Stein aufgeführt, mehr einem nach vorn hin offenen Zimmer als einem Balkon glich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
