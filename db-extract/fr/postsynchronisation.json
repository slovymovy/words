                "senses": [
                    {
                        "sense_id": "38bdf409-47ed-3659-a8fa-2691a3708a18",
                        "entry_id": "76aff170-1c36-356e-8e4a-3b81dc3d446f",
                        "glosses": [
                            "Opération qui consiste à synchroniser, postérieurement au tournage d’un film, les images et certains éléments sonores, musique, dialogues, bruitages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "530d382c-aa3a-4b75-bd15-cd4c7322c45b",
                                "sense_id": "38bdf409-47ed-3659-a8fa-2691a3708a18",
                                "text": "Sera autorisée la projection en France de quinze films allemands de grand métrage postsynchronisés en langue française, à la condition expresse que la postsynchronisation ait été réalisée dans des studios situés en territoire français."
                            },
                            {
                                "example_id": "a4acf000-62aa-4277-a7f6-2413f29795e5",
                                "sense_id": "38bdf409-47ed-3659-a8fa-2691a3708a18",
                                "text": "C’est bien, la postsynchronisation. Bien sûr, on sait que les vrais amateurs préfèrent la bande originale. Mais pour les béotiens, cette façon de vivre les films n’est pas désagréable. Elle ajoute au cinéma un mélange impondérable de mystère et de familiarité. Sans tout à fait savoir comment, on habite la pellicule."
                            }
                        ]
                    }
                ],
                "translations": [
