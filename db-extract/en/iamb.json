                        "target_lang_word": "Jambus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jambus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51071b13-9bed-3b33-a4ea-fc378b8d3a76",
                                        "entry_id": "b457c736-0fa0-3f1a-899d-6fa782be2cb2",
                                        "glosses": [
                                            "rhythmische Einheit, bei der erst eine kurze oder unbetonte, dann eine lange oder betonte Silbe auftritt"
                                        ],
                                        "tags": [
                                            "Lyrik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "468a56a6-fcb3-4009-a9b3-88b5c678fab1",
                                                "sense_id": "51071b13-9bed-3b33-a4ea-fc378b8d3a76",
                                                "text": "Die Struktur der Wörter Verstand, Ersatz, genau, Vernunft ist immer ein Jambus."
                                            },
                                            {
                                                "example_id": "6db0f8aa-ff5e-4346-bb6f-a63e92dc7a63",
                                                "sense_id": "51071b13-9bed-3b33-a4ea-fc378b8d3a76",
                                                "text": "„Das Heft wimmelte von Ausdrücken wie Skandieren, Spondeus, Jambus, Molossus und anderen antiken Versfüßen, das alles sorgfältig, fast schon kalligraphisch eingetragen.“"
                                            },
                                            {
                                                "example_id": "d7a669de-2769-43a6-857f-807f487f4213",
                                                "sense_id": "51071b13-9bed-3b33-a4ea-fc378b8d3a76",
                                                "text": "„Das Versmaß des Gedichts ist, fürs erste Lesen, nicht anspruchsvoll, ein fünfhebiger Jambus, doch dieser verlangt, je nach Zeile, eine genaue, dem Gesprochenen gemäße Rhythmisierung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
