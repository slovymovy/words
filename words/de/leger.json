                    "frequency": "Low",
                    "semantic_group_id": "verhalten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Professor pflegt im Seminar einen sehr <w>legeren</w> Umgangston mit den Studierenden.",
                            "target_lang_translations": {
