                "senses": [
                    {
                        "sense_id": "10aa54c5-c4e9-3e87-ab34-b794c2ddea79",
                        "entry_id": "3302d59d-0a77-3430-8761-2bca88dcce54",
                        "glosses": [
                            "морск. извещение о полной готовности судна к погрузке или выгрузке"
                        ],
                        "tags": [],
