{
    "word_family": [
        "emprunt",
        "emprunteur",
        "emprunteuse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb64229a-e12b-3cb0-8210-6715025bee83",
                    "sense_definition": "Demander et recevoir un bien ou de l'argent à titre de prêt avec l'intention de le restituer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai <w>emprunté</w> ce roman captivant à la bibliothèque municipale pour le week-end."
                        },
                        {
                            "text": "Il doit <w>emprunter</w> une somme importante à la banque pour financer ses études universitaires."
                        }
                    ],
                    "antonyms": [
                        "prêter"
                    ],
                    "common_phrases": [
                        "emprunter de l'argent",
                        "emprunter un livre",
                        "emprunter à la banque"
                    ]
                },
                {
                    "sense_id": "dfa9dd27-3a4e-3102-9013-38e0aa1ede5f",
                    "sense_definition": "Suivre une voie, un chemin, ou prendre une direction déterminée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "trajet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour éviter les embouteillages du centre-ville, nous <w>empruntons</w> souvent cette petite route de campagne."
                        },
                        {
                            "text": "Les randonneurs ont décidé d'<w>emprunter</w> un sentier balisé qui mène directement au sommet de la colline."
                        }
                    ],
                    "synonyms": [
                        "prendre",
                        "suivre"
                    ],
                    "common_phrases": [
                        "emprunter un chemin",
                        "emprunter la route",
                        "emprunter une ruelle"
                    ]
                },
                {
                    "sense_id": "f2782b4b-9f00-364c-8871-17fea2514170",
                    "sense_definition": "Reprendre ou tirer parti d'idées, de styles ou d'éléments créés par autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appropriation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce réalisateur aime <w>emprunter</w> des techniques narratives au cinéma classique pour ses nouveaux films."
                        },
                        {
                            "text": "Le compositeur a <w>emprunté</w> plusieurs mélodies traditionnelles pour enrichir son nouvel album symphonique."
                        }
                    ],
                    "synonyms": [
                        "puiser",
                        "adopter"
                    ],
                    "common_phrases": [
                        "emprunter des idées",
                        "emprunter un style"
                    ]
                },
                {
                    "sense_id": "c9285279-b4d0-30a1-ad6c-1348b99616f9",
                    "sense_definition": "Adopter un mot ou une expression issue d'une langue étrangère.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La langue française a <w>emprunté</w> de nombreux termes culinaires à l'italien à cette époque."
                        },
                        {
                            "text": "L'anglais <w>emprunte</w> constamment de nouveaux mots aux langues du monde entier."
                        }
                    ],
                    "common_phrases": [
                        "emprunter un mot",
                        "emprunter une expression"
                    ]
                }
            ]
        }
    ]
}