                    {
                        "sense_id": "28dbe84d-4852-3c36-9d66-45ab0b3d3dbe",
                        "entry_id": "4f8fa2f5-c051-3f8a-90a2-f1fa7363fe06",
                        "glosses": [
                            "Dilatation des vaisseaux sanguins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54522e2e-b015-4101-92b7-f91e9fc8acb2",
                                "sense_id": "28dbe84d-4852-3c36-9d66-45ab0b3d3dbe",
                                "text": "La première conséquence est la possibilité d'un flush facial qui correspond à une vasodilatation apparaissant après une infiltration locale ; cette manifestation disparaît toujours rapidement."
                            },
                            {
                                "example_id": "172f4358-aa40-44ac-970a-14bec3f482f9",
                                "sense_id": "28dbe84d-4852-3c36-9d66-45ab0b3d3dbe",
                                "text": "Malgré l’élévation des taux de catécholamines et d'angiotensine II, la vasodilatation persiste du fait d’une hyporéactivité aux vasoconstricteurs."
                            }
                        ]
                    }
