                "senses": [
                    {
                        "sense_id": "891ca6bf-687a-3d5e-9b23-dfbf7e6bdfff",
                        "entry_id": "6a7792a5-3a28-35bf-813f-e7bcf4fe2f7a",
                        "glosses": [
                            "weibliche Person, die einen Hund zur Haustierhaltung besitzt, die sich einen Hund hält"
                        ],
                        "tags": [
