                        "fonder une entreprise",
                        "fonder une famille"
                    ]
                },
                {
                    "sense_id": "3ea19cae-ae07-3ae5-8396-2c85947dd50d",
                    "sense_definition": "Faire reposer une opinion, un raisonnement ou une théorie sur des faits ou des principes.",
