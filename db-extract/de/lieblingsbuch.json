                ],
                "senses": [
                    {
                        "sense_id": "67d442be-9c6e-3071-82b3-364d40150ebb",
                        "entry_id": "b0e46e24-50ce-37f5-bbc5-a4d68df4e821",
                        "glosses": [
                            "Buch, das eine Person(engruppe) am meisten mag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "914d9648-8a57-472f-85f2-a78331423041",
                                "sense_id": "67d442be-9c6e-3071-82b3-364d40150ebb",
                                "text": "„Entweder haben sie ihre Kinder im Schlepptau, die ihnen mit leuchtenden Augen ihre Lieblingsbücher präsentieren, oder aber sie haben kleine Zettelchen, auf die die Sprösslinge die Nummern ihrer Wunschbücher gekritzelt haben.“"
                            },
                            {
                                "example_id": "c8edf839-100a-4ae7-b5f5-e7fe95d949b9",
                                "sense_id": "67d442be-9c6e-3071-82b3-364d40150ebb",
                                "text": "„Bei einer warmen Buchstabensuppe könnte man sich sein Lieblingsbuch quasi auf der Zunge zergehen lassen.“"
                            },
                            {
                                "example_id": "6c6629e8-e9d7-4b27-9177-650163a3ced4",
                                "sense_id": "67d442be-9c6e-3071-82b3-364d40150ebb",
                                "text": "„An den beiden Längsseiten stehen in dichten Reihen nach ganz eigenem Aufstellungsprinzip die Lieblingsbücher nebeneinander.“"
                            },
                            {
                                "example_id": "b4c888ce-4d75-4c8d-8619-e883a8b7a91a",
                                "sense_id": "67d442be-9c6e-3071-82b3-364d40150ebb",
                                "text": "„Er zeigte mir seinen schönen Stall, in dem herrliche Pferde standen, dann seine Gemäldegallerie, dann seine Bibliothek, schließlich seine Privatgemächer und seine Lieblingsbücher, die alle verboten waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
