                            {
                                "example_id": "b258cf0f-5487-4b1f-a11a-13ff8e48eec4",
                                "sense_id": "b722984a-5204-33e3-bf61-83d06f83a896",
                                "text": "De belastingverlaging treedt in werking zodra de inkomens boven een bepaalde drempelwaarde uitkomen.",
                                "translation": "The tax reduction takes effect once incomes exceed a certain threshold value.",
                                "english": "The tax reduction takes effect once incomes exceed a certain threshold value."
