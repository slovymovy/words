                "translations": [
                    {
                        "translation_id": "579f91c8-6ff9-442d-8e07-1906ba2b0f1a",
                        "source_entry_id": "126ff0be-e704-3355-9708-431974895ec9",
                        "source_sense_id": "d7d61c12-2a57-3e3c-9f83-990b7e3f22da",
                        "target_lang_word": "педрила",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "педрила",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "25ff4b57-5ce4-3dcd-bf95-48355b35e768",
                                        "entry_id": "89eb40a8-a5e2-3eaa-b475-af070aff9f45",
                                        "glosses": [
                                            "вульг., бран. гомосексуалист, гомосексуал"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41be0b81-f7a3-4cee-8726-cd7193fd9dd6",
                                                "sense_id": "25ff4b57-5ce4-3dcd-bf95-48355b35e768",
                                                "text": "Слушай, я не педрила, но у меня нет бабы, давай поможем друг другу…"
                                            },
                                            {
                                                "example_id": "74599efb-2623-4ccd-82e5-563b40482e2d",
                                                "sense_id": "25ff4b57-5ce4-3dcd-bf95-48355b35e768",
                                                "text": "Но никто никогда не говорил, что нехорошо называть людей иной ориентации «педрилами»."
                                            },
                                            {
                                                "example_id": "8504bd34-1d7b-4093-8eb5-1ad5d37bd96b",
                                                "sense_id": "25ff4b57-5ce4-3dcd-bf95-48355b35e768",
                                                "text": "Владимир поморщился, однако номер набрал и тут же услышал тонкий и противный голос Лёхи Цыбина, педрилы, которого терпеть не мог и по возможности избегал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b50db402-795d-376c-87b4-72d3e3b7d67c",
                                        "entry_id": "89eb40a8-a5e2-3eaa-b475-af070aff9f45",
                                        "glosses": [
                                            "перен., вульг. плохой, неприятный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe4850d8-4011-44e9-a7a1-5153d01d2c58",
                                                "sense_id": "b50db402-795d-376c-87b4-72d3e3b7d67c",
                                                "text": "— Без руля и без ветрил Нанесло на нас педрил! — Смешно, ― сказал водитель."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
