                "senses": [
                    {
                        "sense_id": "9f8621f1-d3ce-36af-a974-b85f7e71ec01",
                        "entry_id": "222304ca-e2a5-3639-9dbd-3ac4fea3b168",
                        "glosses": [
                            "зоол. мн. ч. тип первичноротых животных, образующих колонии в виде кустиков, наростов"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6914013c-7767-3467-878e-cf94c756d9b2",
                        "entry_id": "222304ca-e2a5-3639-9dbd-3ac4fea3b168",
                        "glosses": [
                            "зоол. представитель этого типа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e308c4ac-9674-4754-a324-5b23d27dc649",
                                "sense_id": "6914013c-7767-3467-878e-cf94c756d9b2",
                                "text": "Форма колонии, как показывают наблюдения над современными мшанками, находится в зависимости от химического состава той водной среды, в которой обитает мшанка, и от химического состава скелета самой мшанки."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b393d80-4703-3b5c-8131-14c6392c2075",
                        "entry_id": "222304ca-e2a5-3639-9dbd-3ac4fea3b168",
                        "glosses": [
                            "ботан. род цветковых растений семейства гвоздичных"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a1f7c0f-e027-4cd9-af13-1df02a1cb0d0",
                                "sense_id": "6b393d80-4703-3b5c-8131-14c6392c2075",
                                "text": "Мы использовали мшанку, тимьян ползучий, камнеломки, веронику распростёртую и др."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0544b644-e371-4516-ac9e-9ce945c451d7",
                        "source_entry_id": "222304ca-e2a5-3639-9dbd-3ac4fea3b168",
                        "source_sense_description": "животное",
                        "target_lang_word": "bryozoan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bryozoan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "616c1a31-396a-317e-8eca-ba5187d9f515",
                                        "entry_id": "b34c6bda-7fd9-3969-b675-51384e876811",
                                        "glosses": [
                                            "A member of the phylum Bryozoa of aquatic, usually colonial invertebrates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4182a82f-4ceb-4e84-accc-8918dc3efbf2",
                                                "sense_id": "616c1a31-396a-317e-8eca-ba5187d9f515",
                                                "text": "The blanket of bryozoans also blocks out some of the light needed by the blade for photosynthesis."
                                            },
                                            {
                                                "example_id": "1af67aa7-1deb-4f34-93de-58b027400987",
                                                "sense_id": "616c1a31-396a-317e-8eca-ba5187d9f515",
                                                "text": "Every microscopic individual in a bryozoan colony is a clone of the original animal that settled on the lake floor, and is a hermaphrodite, both male and female."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bryozoan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b49d15c6-4af3-3fc1-a83a-3a5638b827e2",
                                        "entry_id": "aae51383-ba53-3ef2-8ed0-32806175fd00",
                                        "glosses": [
                                            "Pertaining to the Bryozoa."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
