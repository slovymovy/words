                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e23a877-a489-49c0-ada3-f14a0bd5eb70",
                                "sense_id": "0fc185e0-6e12-3955-9ed3-633e6fe47160",
                                "text": "„Im Allgäu ist fast nur reine Graswirtschaft, die jedoch infolge der intensiven Düngung mit Stallmist, Jauche und Kunstdünger außerordentlich hohe Erträge liefert.“"
                            },
                            {
                                "example_id": "2e223cab-73f0-4f4a-b756-f22932853c68",
                                "sense_id": "0fc185e0-6e12-3955-9ed3-633e6fe47160",
                                "text": "„An die Stelle eines ungeregelten Wechsels von Ackerbau und Graswirtschaft trat nun eine geregelte und systematische Bewirtschaftung.“"
                            }
                        ],
