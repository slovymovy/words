                    {
                        "sense_id": "c951c15e-0b99-3f98-b6d8-c4f220c7f8af",
                        "entry_id": "f6595e5d-b167-3aae-9693-a6d16db2285f",
                        "glosses": [
                            "dilated (used when describing convolutions) https://arxiv.org/pdf/1606.00915.pdf"
                        ],
                        "tags": [
                            "not-comparable",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "c6df7465-6c9a-4d8f-aeda-293b3a0710a9",
                                "sense_id": "c951c15e-0b99-3f98-b6d8-c4f220c7f8af",
                                "text": "Atrous convolution allows us to explicitly control the resolution."
                            },
                            {
                                "example_id": "a6f15023-eb03-41fa-9813-3e2e149efc7f",
                                "sense_id": "c951c15e-0b99-3f98-b6d8-c4f220c7f8af",
                                "text": "The new approach is executed by using atrous and gabor wavelets that work effectively on image and video."
                            },
                            {
                                "example_id": "2002d7ee-69d9-4e60-87e7-8db4fd9e09f6",
                                "sense_id": "c951c15e-0b99-3f98-b6d8-c4f220c7f8af",
                                "text": "In order to further illustrate the effect of \"atrous\" convolution, we compare it with standard convolution using a simple example in Figure 4."
                            },
                            {
                                "example_id": "449675ae-6bc5-47d8-ae2f-8dee07640160",
                                "sense_id": "c951c15e-0b99-3f98-b6d8-c4f220c7f8af",
                                "text": "As the frameworks based on atrous convolution and ASPP module have proved their success, we implement an encoder with similar structure of [5], using a pretrained ResNetV2 as backbone network."
                            }
                        ]
                    }
