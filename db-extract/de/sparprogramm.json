                "senses": [
                    {
                        "sense_id": "11a736f8-3624-3374-a0c3-a643d959cd61",
                        "entry_id": "aac77d85-944e-3a53-8380-9cefbcc3483e",
                        "glosses": [
                            "Konzept zur Senkung von Kosten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91609265-6688-475d-afb0-947770588616",
                                "sense_id": "11a736f8-3624-3374-a0c3-a643d959cd61",
                                "text": "„Mit Notverordnungen setzte Brüning sein Sparprogramm teilweise gegen die parlamentarische Mehrheit durch.“"
                            },
                            {
                                "example_id": "28c70cb8-1549-4924-a35a-69ba4fb05e9b",
                                "sense_id": "11a736f8-3624-3374-a0c3-a643d959cd61",
                                "text": "„Denn sein Sparprogramm bezweckt mehr, als nur den Euro zu retten: Die politischen Auflagen verlangen Reformen von Griechenland und den anderen Ländern, die ihre gesellschaftliche Struktur auf lange Zeit verändern könnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "642e0af0-b3fb-3a88-af40-c7b5f62e29d8",
                        "entry_id": "aac77d85-944e-3a53-8380-9cefbcc3483e",
                        "glosses": [
                            "Funktion von Haushaltsgeräten, um den Energieverbrauch zu senken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81988ddd-9e9a-4ea7-84cb-375f986ccac5",
                                "sense_id": "642e0af0-b3fb-3a88-af40-c7b5f62e29d8",
                                "text": "Beim Wäschewaschen schalte ich oft das Sparprogramm der Waschmaschine ein, um weniger Stromkosten zu haben."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
