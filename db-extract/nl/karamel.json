                        "note": "oude schrijfwijze voor 1996"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46da887b-8d34-3732-8423-a344cee0618b",
                        "entry_id": "9c6ccfc0-6f78-3710-a48e-ad06c229f121",
                        "glosses": [
                            "gebrande suiker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21bf95e7-56f0-4e0b-876f-20ad1a347431",
                                "sense_id": "46da887b-8d34-3732-8423-a344cee0618b",
                                "text": "Ik kauwde zorgvuldig om optimaal te genieten van de nougat, pinda’s, karamel en melkchocolade."
                            }
                        ]
                    },
                    {
                        "sense_id": "0075ce28-fdf4-3290-a616-c9632d8f2f14",
                        "entry_id": "9c6ccfc0-6f78-3710-a48e-ad06c229f121",
                        "glosses": [
                            "snoepje gemaakt van gebrande suiker"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4131466-3b29-4fe4-8eac-77805d9224ca",
                        "source_entry_id": "9c6ccfc0-6f78-3710-a48e-ad06c229f121",
                        "source_sense_id": "46da887b-8d34-3732-8423-a344cee0618b",
                        "source_sense_description": "gebrande suiker",
                        "target_lang_word": "Karamell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karamell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b474d27-df75-37f3-b5f9-054bb0bd7af5",
                                        "entry_id": "47a8626a-83f8-373f-8cd7-385a7a804635",
                                        "glosses": [
                                            "gebrannter Zucker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30f8cb84-808f-46a2-992f-b21b48084142",
                                                "sense_id": "6b474d27-df75-37f3-b5f9-054bb0bd7af5",
                                                "text": "Gegen Ende in einer kleinen Pfanne aus Butter und Zucker einen leichten Karamell bereiten, mit Apfelbalsamico, Zitronensaft und gehacktem Ingwer vermischen."
                                            },
                                            {
                                                "example_id": "95766e4e-90c1-43f8-8688-2a1c5a5f832b",
                                                "sense_id": "6b474d27-df75-37f3-b5f9-054bb0bd7af5",
                                                "text": "Es gibt ihn mit aufgeschäumter Milch, mit Karamell oder Zimt parfümiert, mit weißer Schokolade oder Kakao gemischt, koffeinfrei oder höllisch schwarz und stark, ja sogar mit Fruchtsäften versetzt."
                                            },
                                            {
                                                "example_id": "1be2e656-2566-4a83-92cd-206ffdfc18f9",
                                                "sense_id": "6b474d27-df75-37f3-b5f9-054bb0bd7af5",
                                                "text": "Bohnen aus Ghana entfalten den schokoladigen Geschmack mit Noten von Karamell und Malz."
                                            },
                                            {
                                                "example_id": "2c55a973-027d-46db-9ab5-0ebfcb09fb5d",
                                                "sense_id": "6b474d27-df75-37f3-b5f9-054bb0bd7af5",
                                                "text": "„Das eigentliche Karamellisieren, das Farbe und Geschmack verändert, setzt bei Temperaturen um 150 °C ein, für goldbraunen Karamell, den starken Bruch, sind Temperaturen von 180 °C bis 200 °C notwendig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4676432-22c5-4848-a25a-6b5134bd152f",
                        "source_entry_id": "9c6ccfc0-6f78-3710-a48e-ad06c229f121",
                        "source_sense_id": "46da887b-8d34-3732-8423-a344cee0618b",
                        "source_sense_description": "gebrande suiker",
                        "target_lang_word": "caramel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caramel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac328cdf-e271-3482-90e6-d274c13a9197",
                                        "entry_id": "aa8be1f3-913c-328a-bb3a-e40a7655e5f3",
                                        "glosses": [
                                            "A smooth, chewy, sticky confection made by heating sugar and other ingredients until the sugars polymerize and become sticky."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06949f1f-789f-4760-9400-de5d2d5a2dc6",
                                                "sense_id": "ac328cdf-e271-3482-90e6-d274c13a9197",
                                                "text": "The usual technique for making caramel is to mix table sugar with some water, then heat until the water has boiled off and the molten sugar colors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ea67b20-4ccf-3f18-8ff0-ae02cc69b728",
                                        "entry_id": "aa8be1f3-913c-328a-bb3a-e40a7655e5f3",
                                        "glosses": [
                                            "A (sometimes hardened) piece of this confection."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df79133-a0c3-431f-a49b-e84c848303b9",
                                                "sense_id": "0ea67b20-4ccf-3f18-8ff0-ae02cc69b728",
                                                "text": "Caramel has a rich, complex flavor and consistency, viscous and sticky and creamy all at once, that works well with most sweets and fruits, with coffee and chocolate, and even with salt: the prized caramels of Brittany are made with a notable dose of sea salt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9a771b1-ec3a-371e-a500-e04be6967565",
                                        "entry_id": "aa8be1f3-913c-328a-bb3a-e40a7655e5f3",
                                        "glosses": [
                                            "A yellow-brown color, like that of caramel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "caramel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ace78b66-2b96-30c1-bad4-a1b9309a069a",
                                        "entry_id": "df25ddbe-e8da-3bb9-aab8-4cd01eb668fd",
                                        "glosses": [
                                            "Of a yellow-brown color."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9628c97-fec3-4784-820f-d66983a3cfce",
                                                "sense_id": "ace78b66-2b96-30c1-bad4-a1b9309a069a",
                                                "text": "Every time I saw this caramel cutie, she was working on a new proposal or business plan or flyer to promote herself and her event coordinating business."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "caramel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "691548fd-7149-3ee8-873f-9db5e3002328",
                                        "entry_id": "10cc1726-6bba-39df-a27c-876739f62ee8",
                                        "glosses": [
                                            "To caramelize."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d78a31c2-84dd-4293-93a5-7f53f70bf550",
                                                "sense_id": "691548fd-7149-3ee8-873f-9db5e3002328",
                                                "text": "To turn out, place the dish over the mould, and invert both together, when, if the caramelling has been complete, the pudding should slip out without any difficulty at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "687e4a4b-f868-4656-8f73-2591586c48b2",
                        "source_entry_id": "9c6ccfc0-6f78-3710-a48e-ad06c229f121",
                        "source_sense_id": "46da887b-8d34-3732-8423-a344cee0618b",
                        "source_sense_description": "gebrande suiker",
                        "target_lang_word": "caramel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caramel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ae44c91-3855-3879-ba34-ad2fe498d5a9",
                                        "entry_id": "55b10299-d750-3b6d-b973-c5c7841c95a3",
                                        "glosses": [
                                            "Produit brun, solide ou liquide, utilisé en pâtisserie et en confiserie, ou comme colorant, qui s’obtient en faisant brunir du sucre en le faisant chauffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5945a146-1d09-4bbb-88dd-361f37c1c546",
                                                "sense_id": "2ae44c91-3855-3879-ba34-ad2fe498d5a9",
                                                "text": "Les mélasses, dont on extrait encore du sucre blanc […] servent aussi à la fabrication du caramel ; souvent même on les utilise en guise de sucre."
                                            },
                                            {
                                                "example_id": "63fb1db8-b491-4a0f-9d79-88dd4aa6e334",
                                                "sense_id": "2ae44c91-3855-3879-ba34-ad2fe498d5a9",
                                                "text": "Une fois débarrassé de son papier, le pirouli avait une couleur brune flamboyante et mordorée, irisée de bulles d'air. Le caramel était si translucide qu'on pouvait l'utiliser comme des lunettes ou une lentille pour regarder au travers […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd0ec59b-bde4-3ae6-9a41-35227322151f",
                                        "entry_id": "55b10299-d750-3b6d-b973-c5c7841c95a3",
                                        "glosses": [
                                            "Bonbon fabriqué à partir de sucre et de lait, au goût de caramel et de couleur caramel."
                                        ],
                                        "tags": [
                                            "Confiserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2fcd6f3-51cd-47a0-8da8-5dbfbb33309b",
                                                "sense_id": "dd0ec59b-bde4-3ae6-9a41-35227322151f",
                                                "text": "Ils avaient des billes plein les poches, ils suçaient des caramels mous (ceux du « Chien qui Saute ») ou des pastilles de réglisse à la violette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d8cceb-c81a-3528-b06a-9a3ff68a008c",
                                        "entry_id": "55b10299-d750-3b6d-b973-c5c7841c95a3",
                                        "glosses": [
                                            "Brun clair, qui rappelle la couleur du caramel. #B67233"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "263a4257-7e74-4f6e-97a2-58b2fe5a8a80",
                                                "sense_id": "23d8cceb-c81a-3528-b06a-9a3ff68a008c",
                                                "text": "L'extérieur [de l'église de Notre-Sauveur à Copenhague] est en brique, de cette belle brique foncée qui me rappelle nos églises du Sud et prend avec le temps toutes les chaudes couleurs qui vont du caramel clair à l'orange brûlée et du chaudron à un mordoré qui tourne progressivement au prune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4218df0-1602-3e16-9e56-822da230f3fe",
                                        "entry_id": "55b10299-d750-3b6d-b973-c5c7841c95a3",
                                        "glosses": [
                                            "Plaquage violent ou spectaculaire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6eb26347-7ee2-3d28-bd2c-899d4b57aa3d",
                                        "entry_id": "55b10299-d750-3b6d-b973-c5c7841c95a3",
                                        "glosses": [
                                            "Nom donné aux jetons par les scrabbleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16faab96-2f54-44e3-9a59-7a4377d4375b",
                                                "sense_id": "6eb26347-7ee2-3d28-bd2c-899d4b57aa3d",
                                                "text": "Lorsqu'un « scrabbleur » parle de caramels, ne pensez pas nécessairement qu’il est gourmand. Le terme de « caramel » désigne en effet couramment le jeton de Scrabble."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "caramel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c915395-3bd2-3bf8-b13a-61838023de2c",
                                        "entry_id": "a0b6caba-6783-3807-97a4-60ef6d186ff1",
                                        "glosses": [
                                            "D’une couleur roux clair rappelant celle du caramel. #B67233"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c14d59-b9f8-4c0b-b79a-a6284ea421c3",
                                                "sense_id": "3c915395-3bd2-3bf8-b13a-61838023de2c",
                                                "text": "Sous le gaz verdâtre, ma rue, à cette heure, est un gâchis crémeux, praliné, marron-moka et jaune caramel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
