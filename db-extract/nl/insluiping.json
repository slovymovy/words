                        "sense_id": "cd5208a9-518f-3ccd-b277-68c843a3500b",
                        "entry_id": "f4951599-cfbc-3482-8b00-6d066fe68c2b",
                        "glosses": [
                            "ergens ongeoorloogd naar binnendringen zonder schade te veroorzaken bij dit binnendringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1de5ae80-ae9c-4e77-849a-675d4307c71c",
                                "sense_id": "cd5208a9-518f-3ccd-b277-68c843a3500b",
                                "text": "Van een asielzoeker die voor misdrijven als openlijke geweldpleging en herhaaldelijke tasjesroof of insluiping tot zes maanden gevangenisstraf of meer wordt veroordeeld, kan de verblijfsvergunning worden ingetrokken of geweigerd. Nu ligt die grens nog bij anderhalf jaar."
                            },
                            {
                                "example_id": "75724e1d-4a1f-46d4-bbfa-09411af83311",
                                "sense_id": "cd5208a9-518f-3ccd-b277-68c843a3500b",
                                "text": "Een kwart van de inbraken is eenvoudig te voorkomen door de deur op slot te doen, meldt het ministerie. Te vaak komen inbrekers gemakkelijk binnen door middel van flipperen, hengelen en insluiping."
                            },
                            {
                                "example_id": "a8f66342-cadd-412a-9ef1-dda729697a7f",
                                "sense_id": "cd5208a9-518f-3ccd-b277-68c843a3500b",
                                "text": "Actie Witte Huis na insluiping: Het Witte Huis in Washington heeft de beveiliging verscherpt. Een man klom vrijdag over het hek en kon een van de kamers van de ambtswoning van president Obama binnenkomen."
                            }
                        ]
                    }
