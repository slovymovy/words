        "de-extract.jsonl": [
            {
                "entry_id": "11e02098-4bc5-3c78-ace4-74b1ba8fd93b",
                "word": "Aba",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cfee9804-edb5-3bdb-9dee-81d4c1fbb3d4",
                        "entry_id": "11e02098-4bc5-3c78-ace4-74b1ba8fd93b",
                        "glosses": [
                            "Stadt im Südosten Nigerias; Aba"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11995bdd-ac59-4690-ae0a-c14078523e9e",
                        "source_entry_id": "11e02098-4bc5-3c78-ace4-74b1ba8fd93b",
                        "source_sense_id": "cfee9804-edb5-3bdb-9dee-81d4c1fbb3d4",
                        "source_sense_description": "Stadt im Südosten Nigerias",
                        "target_lang_word": "Aba",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aba",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a51e901-66b5-3516-9773-20099ad39037",
                                        "entry_id": "d57ae5e7-2773-34c4-b6c8-27cedb2dd7ce",
                                        "glosses": [
                                            "weiter Umhang der Araber in sackartigem Zuschnitt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8df4b7ae-cff5-4817-928a-b23193bf4680",
                                                "sense_id": "8a51e901-66b5-3516-9773-20099ad39037",
                                                "text": "Er hatte weiter nichts an als seine Aba."
                                            },
                                            {
                                                "example_id": "b2d92323-7120-418d-8f3a-4697994945e5",
                                                "sense_id": "8a51e901-66b5-3516-9773-20099ad39037",
                                                "text": "„Zum Schutze gegen die Kälte der Sommernächte passend, kann ein in eine Aba gehüllter Reisender sich trotz mehrstündigen Regens trocken erhalten […].“"
                                            },
                                            {
                                                "example_id": "e72756ab-298c-4f52-969b-d86badc0815d",
                                                "sense_id": "8a51e901-66b5-3516-9773-20099ad39037",
                                                "text": "„Haupttracht der Araber ist die Aba oder Abadjeh, ein Mantelumhang aus dunkelbraunem oder -blauem „Abastoff\" oder in reicherer Ausstattung mit Zierstreifen, der immer über einem weitärmeligen gegürteten Hemd getragen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "203f2c37-c9fe-3d36-a8a2-973caff18026",
                                        "entry_id": "d57ae5e7-2773-34c4-b6c8-27cedb2dd7ce",
                                        "glosses": [
                                            "grober Wollstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cb0088f-c570-459f-8c89-7987d8b5ab29",
                                                "sense_id": "203f2c37-c9fe-3d36-a8a2-973caff18026",
                                                "text": "„Aba ist ein grober, Schajek dagegen etwas feinerer wollener Stoff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Aba",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64d857b9-12fd-3e99-afdf-b521043a7877",
                                        "entry_id": "deb8c45d-dfdf-3462-b41b-4cb070046533",
                                        "glosses": [
                                            "selten vorkommender, deutscher Familienname, Nachname (häufigstes Vorkommen in Deutschland im Stadtkreis Kaufbeuren in Bayern)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bddf97b7-2b48-411d-a005-47c4e63f47f6",
                                                "sense_id": "64d857b9-12fd-3e99-afdf-b521043a7877",
                                                "text": "Hast du Herrn Aba getroffen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Aba",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fd85060-a034-3bbd-8c14-e95f053a3d26",
                                        "entry_id": "8122a27e-f0ea-3f5c-8b59-9c18d4cbf043",
                                        "glosses": [
                                            "Stadt im südlichen Nigeria"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aebb0555-c78c-429f-82be-36c0497660d9",
                                                "sense_id": "7fd85060-a034-3bbd-8c14-e95f053a3d26",
                                                "text": "„Das hier ist Okriki, nicht irgendeine finstere Ecke auf dem Großmarkt von Aba.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Aba",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4aa3d8b-bd28-32b6-8408-fce54ded89f6",
                                        "entry_id": "4232e11d-6277-3229-b1c2-2860541231f7",
                                        "glosses": [
                                            "afrikanischer Vorname, häufig in Ghana zu finden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f166f01c-e67b-4928-aa6e-e6e6ed0cf481",
                                                "sense_id": "d4aa3d8b-bd28-32b6-8408-fce54ded89f6",
                                                "text": "He, Aba, komm mal her, ich möchte ein Wörtchen mit dir reden!"
                                            },
                                            {
                                                "example_id": "08413fc9-e1a9-4b70-980a-a37756720e41",
                                                "sense_id": "d4aa3d8b-bd28-32b6-8408-fce54ded89f6",
                                                "text": "Das ist Abas teuerster Mantel."
                                            },
                                            {
                                                "example_id": "b67bf45f-274f-4ba5-a79e-6b242d10a71b",
                                                "sense_id": "d4aa3d8b-bd28-32b6-8408-fce54ded89f6",
                                                "text": "Mit Aba darüber zu sprechen, kann sehr frustrierend werden."
                                            },
                                            {
                                                "example_id": "7b183ad6-17f0-407a-9ffc-2d64737f7ab3",
                                                "sense_id": "d4aa3d8b-bd28-32b6-8408-fce54ded89f6",
                                                "text": "Ohne Aba einen Ausflug zu machen, ist nur halb so spaßig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
