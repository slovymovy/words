                        ],
                        "zh": [
                            {
                                "target_lang_word": "波",
                                "target_lang_sense_clarification": "物理学概念"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b560f09-3b7b-34de-bcde-93d4ec9403fa",
                    "sense_definition": "A group activity where people in a crowd stand up and sit down in sequence to create a ripple effect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "crowd_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fans started a <w>wave</w> that went around the entire stadium.",
                            "target_lang_translations": {
                                "ru": "Болельщики запустили <w>волну</w>, которая обошла весь стадион.",
                                "zh": "球迷们发起了一场绕全场一周的<w>人浪</w>。"
                            }
                        },
                        {
                            "text": "We all joined the <w>wave</w> during the football match.",
                            "target_lang_translations": {
                                "ru": "Мы все присоединились к <w>волне</w> во время футбольного матча.",
                                "zh": "足球赛期间，我们都参与了<w>人浪</w>。"
                            }
                        }
