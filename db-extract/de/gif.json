                "senses": [
                    {
                        "sense_id": "4c8d637e-628f-3915-a6d3-86f1eb855832",
                        "entry_id": "9c084031-8a7a-3d2b-9be8-2ddbf37ca4e0",
                        "glosses": [
                            "Grafikformat für Bilder (auch mehrere Bilder in Reihe) mit Farbpalette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5c448fd-fdec-4759-8047-407950a91f76",
                                "sense_id": "4c8d637e-628f-3915-a6d3-86f1eb855832",
                                "text": "\"Im Internet wird alles immer schneller, größer und bunter. Doch mit die größten Erfolge feiert ausgerechnet das uralte Dateiformat GIF – und revolutioniert ganz nebenbei auch noch die Kunstszene. Wie ist das möglich?\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7beddcbc-a622-48a3-8bb2-25ee682313d4",
                        "source_entry_id": "9c084031-8a7a-3d2b-9be8-2ddbf37ca4e0",
                        "source_sense_id": "4c8d637e-628f-3915-a6d3-86f1eb855832",
                        "target_lang_word": "GIF",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "GIF",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ae8810f-b1b6-38a0-9d77-53bf91b82695",
                                        "entry_id": "8d0d3164-6c72-321e-900f-f2be148551a0",
                                        "glosses": [
                                            "A bitmap image in a particular format with support for multiple images per file or animations, and up to 256 distinct colors per frame, including a fully transparent color."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3a874da-6037-4e90-b5b6-a2f4b2a79f11",
                                                "sense_id": "7ae8810f-b1b6-38a0-9d77-53bf91b82695",
                                                "text": "I'll send you a GIF of the proposed logo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a382862-2aab-3b56-9e64-59b8fbc55060",
                                        "entry_id": "8d0d3164-6c72-321e-900f-f2be148551a0",
                                        "glosses": [
                                            "Any short video without audio, usually one which loops."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e54d92-c5c9-40d1-85e0-459aa5c85891",
                                                "sense_id": "0a382862-2aab-3b56-9e64-59b8fbc55060",
                                                "text": "Crying Dawson ruled the internet comment sections of the late ’00s and early ’10s. It’s “on the Mount Rushmore of GIFs,” says TV critic Sarah D. Bunting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4292c973-4cac-3a88-8e4b-b7934735c6fb",
                                        "entry_id": "8d0d3164-6c72-321e-900f-f2be148551a0",
                                        "glosses": [
                                            "Any short video, in a format directly supported by HTML5 (ie. GIF, MP4, WebM)"
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "GIF",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbacc540-7106-369c-b917-0a896dd9e39e",
                                        "entry_id": "a3cfa841-6c8b-3fe7-bdbe-2f7a4ce4776f",
                                        "glosses": [
                                            "To create a GIF file of; (inexact) to create a similar animated image file of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8d25527-6fc5-4fd3-8f52-df8c9685e460",
                                                "sense_id": "cbacc540-7106-369c-b917-0a896dd9e39e",
                                                "text": "He GIFed the highlights of the debate"
                                            },
                                            {
                                                "example_id": "93637aad-65e2-40b1-8ea9-7892800e1a74",
                                                "sense_id": "cbacc540-7106-369c-b917-0a896dd9e39e",
                                                "text": "In fact, it seems this latest round of interest in the 2011 cover was sparked by the GIF-ing of Lawrence’s pre- and post-Photoshopped image, which made the rounds on Tumblr before seeping out to blogs like Crushable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5ca4a41-d6d8-4f10-bbf8-4033ae204692",
                        "source_entry_id": "9c084031-8a7a-3d2b-9be8-2ddbf37ca4e0",
                        "source_sense_id": "4c8d637e-628f-3915-a6d3-86f1eb855832",
                        "target_lang_word": "GIF",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "GIF",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83dab3a1-4375-351f-856d-aed622229ca2",
                                        "entry_id": "071948f5-fc22-39fa-9b21-789ba0bf90a4",
                                        "glosses": [
                                            "Format d’image numérique couramment utilisé sur le Web, qui supporte une palette de 2 à 256 couleurs chacune desquelles est représentée par 24 bits (8 bits pour le rouge, pour le vert et pour le bleu)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f2742e-e751-4934-9d8d-ea30b4050411",
                                                "sense_id": "83dab3a1-4375-351f-856d-aed622229ca2",
                                                "text": "… GIF permet de faire des animations, mais n'offre qu'un nombre limité de couleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fce8847-1f01-3a88-922d-aed46348f84c",
                                        "entry_id": "071948f5-fc22-39fa-9b21-789ba0bf90a4",
                                        "glosses": [
                                            "Image dans ce format."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
