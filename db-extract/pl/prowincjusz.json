                                        "sense_id": "7f56d253-0b1b-34ef-abc5-2103e600e4cf",
                                        "entry_id": "a4b3567d-1736-3944-ac08-730ee9b3e67e",
                                        "glosses": [
                                            "Of or pertaining to a province."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a668851-a04d-4cbd-95b0-fe7350e10671",
                                                "sense_id": "7f56d253-0b1b-34ef-abc5-2103e600e4cf",
                                                "text": "a provincial government"
                                            },
                                            {
                                                "example_id": "8a9ee298-f838-401d-8521-07d9bd8bf251",
                                                "sense_id": "7f56d253-0b1b-34ef-abc5-2103e600e4cf",
                                                "text": "a provincial dialect"
                                            },
                                            {
                                                "example_id": "7bb82c2e-5248-466c-93be-006256955fed",
                                                "sense_id": "7f56d253-0b1b-34ef-abc5-2103e600e4cf",
                                                "text": "More than 100 provincial and municipal firefighters were brought in, with helicopters and aircraft used to drop water and fire retardant, while bulldozers were digging firebreaks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8209832a-02a6-30fb-b3b7-05e725629383",
                                        "entry_id": "a4b3567d-1736-3944-ac08-730ee9b3e67e",
                                        "glosses": [
                                            "Constituting a province."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93ba8fb9-0fa3-33ea-9c3c-df51f25e98b1",
                                        "entry_id": "a4b3567d-1736-3944-ac08-730ee9b3e67e",
                                        "glosses": [
                                            "Exhibiting the ways or manners of a province; characteristic of the inhabitants of a province."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "902fc7d7-0086-467a-ad10-6664034beb36",
                                                "sense_id": "93ba8fb9-0fa3-33ea-9c3c-df51f25e98b1",
                                                "text": "[…] fond of exhibiting provincial airs and graces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e28b21f-241d-3585-afac-c79141179df1",
                                        "entry_id": "a4b3567d-1736-3944-ac08-730ee9b3e67e",
                                        "glosses": [
                                            "Not cosmopolitan; backwoodsy, hick, yokelish, countrified; not polished; rude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db9549b-a3c6-4f1e-b751-fcda89269ba0",
                                                "sense_id": "9e28b21f-241d-3585-afac-c79141179df1",
                                                "text": "That awful little Cedar Whatever is no thriving megalopolis, and you people are so provincial, it's appalling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "824c4a41-2ee2-3fde-a98b-fda040092593",
                                        "entry_id": "a4b3567d-1736-3944-ac08-730ee9b3e67e",
                                        "glosses": [
                                            "Narrow; illiberal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1403ff0-42f8-378d-9cd6-9d1becaa1c49",
                                        "entry_id": "a4b3567d-1736-3944-ac08-730ee9b3e67e",
                                        "glosses": [
                                            "Of or pertaining to an ecclesiastical province, or to the jurisdiction of an archbishop; not ecumenical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7390e78e-1494-490f-b0b8-57a03da86e01",
                                                "sense_id": "a1403ff0-42f8-378d-9cd6-9d1becaa1c49",
                                                "text": "a provincial synod"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa1e4f64-4716-33b0-a33f-445cc440f781",
                                        "entry_id": "a4b3567d-1736-3944-ac08-730ee9b3e67e",
                                        "glosses": [
                                            "Limited in outlook; narrow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "provincial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bc1f4b4-67bd-35ed-a2b3-ae0e1a653a79",
                                        "entry_id": "fee876e4-1f1f-3571-aaef-9f604dd66ca9",
                                        "glosses": [
                                            "A person belonging to a province; one who is provincial."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9fd33c8-3e9c-368c-8dcc-84f943d58a38",
                                        "entry_id": "fee876e4-1f1f-3571-aaef-9f604dd66ca9",
                                        "glosses": [
                                            "A monastic superior, who, under the general of his order, has the direction of all the religious houses of the same fraternity in a given district, called a province of the order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b461077-1ae1-4864-a770-3cedf1b6ef20",
                                                "sense_id": "d9fd33c8-3e9c-368c-8dcc-84f943d58a38",
                                                "text": "The Franciscan provincial Diego de Landa set up a local Inquisition which unleashed a campaign of interrogation and torture on the Indio population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0388ae03-85cb-392f-ba66-10d55e1deaec",
                                        "entry_id": "fee876e4-1f1f-3571-aaef-9f604dd66ca9",
                                        "glosses": [
                                            "A constitution issued by the head of an ecclesiastical province."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1858aa52-a6b9-4b8d-ac18-829bf8d3ed0c",
                                                "sense_id": "0388ae03-85cb-392f-ba66-10d55e1deaec",
                                                "text": "Or els is thys Goddis law,\nDecrees or decretals,\nOr holy sinodals,\nOr els provincyals,\nThus within the wals\nOf holy church to deale […]?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6180078-af85-3546-a2c5-b0f6e90f48dc",
                                        "entry_id": "fee876e4-1f1f-3571-aaef-9f604dd66ca9",
                                        "glosses": [
                                            "A country bumpkin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae184195-d44a-48e1-98f0-4459901250f8",
                        "source_entry_id": "55601e97-c151-38be-a6ec-1e1bb52ddf4b",
                        "source_sense_id": "2cfa037c-fb88-3004-9e9a-5f0e04fb50ae",
                        "target_lang_word": "провинциал",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "провинциал",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a2aa55f7-1114-38d5-9683-665b5d923a15",
                                        "entry_id": "2c9c4fde-01eb-3f8d-ac37-3960ca28e189",
                                        "glosses": [
                                            "уроженец или житель провинции, а не столицы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01e8301c-0ceb-4748-b2dd-3f328c2febfa",
                                                "sense_id": "a2aa55f7-1114-38d5-9683-665b5d923a15",
                                                "text": "Тяжелы первые впечатления провинциала в Петербурге."
                                            },
                                            {
                                                "example_id": "c5f31e2c-65d0-4363-8fef-40bbb6f7b4fd",
                                                "sense_id": "a2aa55f7-1114-38d5-9683-665b5d923a15",
                                                "text": "— Если кто-нибудь из вас, господа, живал постоянно в Москве, — начал так рассказывать Черемухин, положа к стороне свою трубку, — то, верно, заметил, что периодические нашествия нашей братьи, провинциалов, на матушку Москву белокаменную начинаются по большей части перед рождеством."
                                            },
                                            {
                                                "example_id": "02e2c42b-4910-4f1f-9bfe-12997ba4d08a",
                                                "sense_id": "a2aa55f7-1114-38d5-9683-665b5d923a15",
                                                "text": "По коридорам монастыря бродили вновь поступавшие члены клуба, вероятно провинциалы."
                                            },
                                            {
                                                "example_id": "5a789119-35d2-4ccb-9407-09c3515f9e8e",
                                                "sense_id": "a2aa55f7-1114-38d5-9683-665b5d923a15",
                                                "text": "— В случае чего мы — не нашедшие выхода из театра провинциалы."
                                            },
                                            {
                                                "example_id": "0c7cb32b-bbc5-4b8c-981e-d8c18c83cf52",
                                                "sense_id": "a2aa55f7-1114-38d5-9683-665b5d923a15",
                                                "text": "Фарисеи привыкли считать себя мерилом правоверия, и вдруг явился какой-то неведомый провинциал и покушается на их привилегии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "596d9e20-908d-375f-ae9f-e2a116036605",
                                        "entry_id": "2c9c4fde-01eb-3f8d-ac37-3960ca28e189",
                                        "glosses": [
                                            "перен. разг. пренебр. наивно-простоватый человек, поведением и привычками, указывающий на провинциальный уклад жизни"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf132f23-9164-4692-aeb1-c935ad018c47",
                                                "sense_id": "596d9e20-908d-375f-ae9f-e2a116036605",
                                                "text": "Он был в поношенном коричневом сюртуке с воротником, какого именно тогда не носили, с бамбуковой палкой в руках и, как мы сказали, с видом решительного провинциала."
                                            },
                                            {
                                                "example_id": "8846d98c-9ce1-47f1-92dd-168dcc5f991a",
                                                "sense_id": "596d9e20-908d-375f-ae9f-e2a116036605",
                                                "text": "…извините меня, я провинциал, правду-матку режу прямо."
                                            },
                                            {
                                                "example_id": "a38cdad9-40fc-4fea-8b01-40765b9ba47f",
                                                "sense_id": "596d9e20-908d-375f-ae9f-e2a116036605",
                                                "text": "Мы до сих пор смотрим на европейцев и Европу в том роде, как провинциалы смотрят на столичных жителей, — с подобострастием и чувством собственной вины, принимая каждую разницу за недостаток, краснея своих особенностей, скрывая их, подчиняясь и подражая."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e335848-b2d0-307d-8a7d-afcc002191d6",
                                        "entry_id": "2c9c4fde-01eb-3f8d-ac37-3960ca28e189",
                                        "glosses": [
                                            "религ. руководитель провинции католического ордена"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4c0eb62-8b34-4b55-846e-cedab56e55e5",
                                                "sense_id": "1e335848-b2d0-307d-8a7d-afcc002191d6",
                                                "text": "Монастырь Почаева славится во всей Полше, лежит на высокой горе, управляется провинциалом. Сей монастырь униятской…"
                                            },
                                            {
                                                "example_id": "00174964-ee1f-4c76-bfa8-762600040243",
                                                "sense_id": "1e335848-b2d0-307d-8a7d-afcc002191d6",
                                                "text": "Скажу мимоходом, что хотя дядя мой управлял богатыми монастырями и потом был провинциалом (так называется глава Доминиканского ордена), но не оставил наследства своей фамилии."
                                            },
                                            {
                                                "example_id": "e9e7bba7-c405-437a-8d37-0f361a72d4b4",
                                                "sense_id": "1e335848-b2d0-307d-8a7d-afcc002191d6",
                                                "text": "Настоятель согласился, но францисканский провинциал в просьбе отказал, и Игнатий вновь вернулся в Барселону."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
