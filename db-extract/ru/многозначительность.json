                                        "sense_id": "e6911af8-1b6f-3694-9367-6e0a21ea46da",
                                        "entry_id": "0ba44ab8-c847-3212-b5cf-09ca3f1680df",
                                        "glosses": [
                                            "The extent to which something matters; importance"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f4cc102-1bc4-4af9-bc07-0cecb6d3285c",
                                                "sense_id": "e6911af8-1b6f-3694-9367-6e0a21ea46da",
                                                "text": "As a juror your opinion is of great significance for the outcome of the trial."
                                            },
                                            {
                                                "example_id": "1c0c165b-f6c7-44ef-ad96-b782111068fe",
                                                "sense_id": "e6911af8-1b6f-3694-9367-6e0a21ea46da",
                                                "text": "Of more significance in the nature of branch development; in the Jubulaceae, as in the Porellaceae, branches are acroscopic and normally replace a ventral leaf lobe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a30bd58-5833-33b5-9cb1-70882f2d3657",
                                        "entry_id": "0ba44ab8-c847-3212-b5cf-09ca3f1680df",
                                        "glosses": [
                                            "Meaning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
