                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf7c5ee9-83fb-4217-87c0-da600b3dfcdb",
                                                "sense_id": "0d2797ff-bfd7-3a36-8300-6a54e2042efa",
                                                "text": "Officials in San Bernardino, California, report what is feared to be one of the most uneradicable dangers to gay people yet: the armoured crab. Armoured crabs […] are impervious to not only traditional commercial remedies but to unorthodox cures as well, such as sand blasting, nitroglycerin, and plastic surgery."
                                            },
                                            {
                                                "example_id": "81167c58-3adc-490d-bd27-1ebee14bbe42",
                                                "sense_id": "0d2797ff-bfd7-3a36-8300-6a54e2042efa",
                                                "text": "The observation that topical application of nitroglycerin to the penis may lead to erection adequate for sexual intercourse (Talley and Crawley 1985) has stimulated several investigations on the efficacy of this potential mode of treatment of erectile dysfunction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72126df9-de91-4ad4-bfa3-c179218c729e",
                        "source_entry_id": "e60257ec-678e-3a63-be33-c4a05eb4a5d4",
                        "source_sense_id": "83135708-ba60-3132-8ba2-51168c3f6047",
