                    }
                ],
                "senses": [
                    {
                        "sense_id": "98969f4d-a0e9-32d5-bec2-e99062add4a8",
                        "entry_id": "ee506d97-51ce-3d6e-9a11-850966864c88",
                        "glosses": [
                            "weibliche Person mit beeinträchtigtem Mitgefühl und Gewissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca46fa9-af8c-45bb-8b67-2f83e0db2a8b",
                                "sense_id": "98969f4d-a0e9-32d5-bec2-e99062add4a8",
                                "text": "Der Gutachter stufte sie als Psychopathin ein."
                            },
                            {
                                "example_id": "dabffe60-f6fb-46c4-81c4-5237fe201143",
                                "sense_id": "98969f4d-a0e9-32d5-bec2-e99062add4a8",
                                "text": "„Die Psychopathin untergräbt oft das Selbstwertgefühl anderer. Sie tut dies, indem sie Gerüchte verbreitet, das Umfeld des Opfers einschüchtert und gegen es aufbringt.“"
                            },
                            {
                                "example_id": "49e52704-3c45-44db-af76-3fb03a36a502",
                                "sense_id": "98969f4d-a0e9-32d5-bec2-e99062add4a8",
                                "text": "„Psychopathinnen sind ihr zufolge zudem schwerer zu entlarven, da bei ihnen häufig eine Borderline-Persönlichkeitsstörung festgestellt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3d411782-965d-316f-8ce0-6aef16e9d7d7",
                        "entry_id": "ee506d97-51ce-3d6e-9a11-850966864c88",
                        "glosses": [
                            "unter einer Persönlichkeits- oder Verhaltensstörung leidende weibliche Person; gelegentlich auch nur eine (extrem) eigenwillige Person"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7efea4f6-b5f8-456a-9818-7cffa5756b0b",
                                "sense_id": "3d411782-965d-316f-8ce0-6aef16e9d7d7",
                                "text": "Die Frau ist doch echt ne Psychopathin!"
                            },
                            {
                                "example_id": "a246465b-b6f8-4135-8e8b-37b243d114ca",
                                "sense_id": "3d411782-965d-316f-8ce0-6aef16e9d7d7",
                                "text": "„Was mich angeht: Ich habe mich in Beziehungen vielleicht hin und wieder verantwortungslos und selbstsüchtig verhalten, doch die Tatsache, dass ich Gewissensbisse habe, zeigt, dass ich keine Psychopathin bin.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "126b70dc-1d2c-4afd-9918-d19f4f103aac",
                        "source_entry_id": "ee506d97-51ce-3d6e-9a11-850966864c88",
