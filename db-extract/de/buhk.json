                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0c99081-1866-4870-9887-5822096b0934",
                                "sense_id": "74d410d0-d240-3a8c-b3d5-74fcfa599170",
                                "text": "Frau Buhk ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1ae7840d-6517-48c6-a8fb-a6d435ef1163",
                                "sense_id": "74d410d0-d240-3a8c-b3d5-74fcfa599170",
                                "text": "Herr Buhk wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f073d182-bd74-4ca2-97e2-f115a111c80d",
                                "sense_id": "74d410d0-d240-3a8c-b3d5-74fcfa599170",
                                "text": "Die Buhks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1d8099da-c25d-4301-8aba-8654a2ba53f1",
                                "sense_id": "74d410d0-d240-3a8c-b3d5-74fcfa599170",
                                "text": "Der Buhk trägt nie die Schals, die die Buhk ihm strickt."
                            },
                            {
                                "example_id": "54ca95af-48d1-47ee-86fb-4231ea148f1d",
                                "sense_id": "74d410d0-d240-3a8c-b3d5-74fcfa599170",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Buhk kommt, geht der Herr Buhk.“"
                            },
                            {
                                "example_id": "5d4cb52c-98f8-4b05-ad69-b1a396e72c51",
                                "sense_id": "74d410d0-d240-3a8c-b3d5-74fcfa599170",
                                "text": "Buhk kommt und geht."
                            },
                            {
                                "example_id": "78421991-8977-498d-a908-608366572581",
                                "sense_id": "74d410d0-d240-3a8c-b3d5-74fcfa599170",
                                "text": "Buhks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
