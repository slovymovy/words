                        ],
                        "form": "негра́мотно"
                    },
                    {
                        "form_id": "ff59cf2e-b923-4fee-97b6-9194644a882b",
                        "entry_id": "689d9885-5999-3fdc-986d-53252c568bda",
                        "tags": [
                            "singular",
                            "feminine",
