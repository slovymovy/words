                ],
                "senses": [
                    {
                        "sense_id": "916636fc-7926-32d8-b450-bc4d1e89e9d6",
                        "entry_id": "dc381be9-a67a-30c6-8d1e-79e2b6d3b1f2",
                        "glosses": [
                            "Raspberry liqueur."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "107ffbd1-1171-4ce1-9b87-9f8af9c78a52",
                                "sense_id": "916636fc-7926-32d8-b450-bc4d1e89e9d6",
                                "text": "The krieks and framboises are fine accompaniments to salads or main dishes made with fruits."
                            },
                            {
                                "example_id": "226f2fda-9b64-46ed-9792-45f2c49a232d",
                                "sense_id": "916636fc-7926-32d8-b450-bc4d1e89e9d6",
                                "text": "Ruthe poured another round of coffee, this time with a shot glass of the framboise Dina made from their raspberry patch every fall."
                            },
                            {
                                "example_id": "5fbf1ff8-fde3-49d1-85c8-a824103d0a8c",
                                "sense_id": "916636fc-7926-32d8-b450-bc4d1e89e9d6",
                                "text": "Drizzle in (down the sides of the glass, for optimum streaky lines) some framboise (or creme d'cassis, if that's what you have, or some other dark, sticky, red liqueur)."
                            },
                            {
                                "example_id": "fddf11e8-ba40-4a75-93d2-4c05279c0788",
                                "sense_id": "916636fc-7926-32d8-b450-bc4d1e89e9d6",
                                "text": "When the egg and sugar mixture is ready, lower the speed to low and add the vanilla seeds, framboise (if using), and the cocoa powder and flour mixture."
                            },
                            {
                                "example_id": "1e511992-c416-4a59-9601-85e4e2bc9d6e",
                                "sense_id": "916636fc-7926-32d8-b450-bc4d1e89e9d6",
                                "text": "An Irish pub, McCaul’s serves the Guinness, Harp and Bass you'd expect plus a rotating lineup of raspberry framboises and coffee porters."
                            },
                            {
                                "example_id": "e2bce36a-d5f4-4276-8eab-44dc5bc8004b",
                                "sense_id": "916636fc-7926-32d8-b450-bc4d1e89e9d6",
                                "text": "Note that another Belgian sour ale, oud bruin, is sometimes used as the base beer for krieks and framboises."
                            },
                            {
                                "example_id": "ccebc25e-2e47-4f65-934d-a683aeef39dd",
                                "sense_id": "916636fc-7926-32d8-b450-bc4d1e89e9d6",
                                "text": "There, we muscled our way into the bar, and I ordered us framboises on tap."
                            }
                        ]
                    }
                ],
