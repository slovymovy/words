                                    {
                                        "sense_id": "83b8984c-0ca7-30dc-9841-16e3f73509d5",
                                        "entry_id": "cd629505-daca-36c8-89dd-e1e5ffc51119",
                                        "glosses": [
                                            "Person, die Elefanten führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b667a0a5-18f5-42c0-a3d4-45b63520c0d3",
                                                "sense_id": "83b8984c-0ca7-30dc-9841-16e3f73509d5",
                                                "text": "„Der Elefantentreiber (mahout) war meist ein Stammesangehöriger aus dem Waldland, aus dem die Elefanten stammten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
