            "senses": [
                {
                    "sense_id": "c2746341-358d-32fd-827c-630a415adcba",
                    "sense_definition": "zonder zichtbare of voelbare naad vervaardigd of aan elkaar bevestigd",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_structuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze <w>naadloze</w> sokken zitten veel lekkerder omdat ze nergens schuren.",
                            "target_lang_translations": {
                                "en": "These <w>seamless</w> socks are much more comfortable because they don't chafe anywhere."
                            }
                        },
                        {
                            "text": "De fabriek produceert <w>naadloze</w> stalen buizen voor de olie-industrie.",
                            "target_lang_translations": {
                                "en": "The factory produces <w>seamless</w> steel pipes for the oil industry."
                            }
