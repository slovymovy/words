                "senses": [
                    {
                        "sense_id": "f417098e-764a-34d5-8464-8425246c6642",
                        "entry_id": "d15bc8ba-7708-3ab3-a9f1-239ce9da031a",
                        "glosses": [
                            "een onzalig idee is een heel slecht idee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30cde0bd-87db-4080-82d3-0376d72406ff",
                                "sense_id": "f417098e-764a-34d5-8464-8425246c6642",
                                "text": "De burgemeester had het onzalige plan om een weg dwars door de stad te laten aanleggen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a53c2623-6b60-4759-92cc-e02c25e571df",
                        "source_entry_id": "d15bc8ba-7708-3ab3-a9f1-239ce9da031a",
                        "source_sense_id": "f417098e-764a-34d5-8464-8425246c6642",
                        "target_lang_word": "miserable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miserable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bcd85be-ea9e-3f0a-b92e-05b1db0ea516",
                                        "entry_id": "0df968f0-5a77-3a1a-a9b7-de8392a183d5",
                                        "glosses": [
                                            "In a state of misery: very sad, ill, or poor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53990d29-ae71-4eda-b209-6194bb8d985e",
                                                "sense_id": "4bcd85be-ea9e-3f0a-b92e-05b1db0ea516",
                                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                                            },
                                            {
                                                "example_id": "a9986369-7811-4522-967c-e905eeab265c",
                                                "sense_id": "4bcd85be-ea9e-3f0a-b92e-05b1db0ea516",
                                                "text": "With some of it on the south and more of it on the north of the great main thoroughfare that connects Aldgate and the East India Docks, St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London."
                                            },
                                            {
                                                "example_id": "a5a60591-aff7-4ec9-86a6-9c6a25c7e8a4",
                                                "sense_id": "4bcd85be-ea9e-3f0a-b92e-05b1db0ea516",
                                                "text": "The secret of being miserable is to have leisure to bother about whether you are happy or not. The cure for it is occupation, because occupation means pre-occupation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fd0d5eb-939f-3f1d-80e4-263e648ff757",
                                        "entry_id": "0df968f0-5a77-3a1a-a9b7-de8392a183d5",
                                        "glosses": [
                                            "Very bad (at something); unskilled, incompetent; hopeless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d53c8f0-1cb8-40e8-a17d-b9395087e774",
                                                "sense_id": "5fd0d5eb-939f-3f1d-80e4-263e648ff757",
                                                "text": "He's good at some sports, like tennis, but he's just miserable at football."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "130f47aa-061a-31c7-a8d0-3a7303b900c8",
                                        "entry_id": "0df968f0-5a77-3a1a-a9b7-de8392a183d5",
                                        "glosses": [
                                            "Of the weather, extremely unpleasant due to being cold, wet, overcast, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbe2164c-5630-36b6-803c-61a08a1eb548",
                                        "entry_id": "0df968f0-5a77-3a1a-a9b7-de8392a183d5",
                                        "glosses": [
                                            "Wretched; worthless; mean; contemptible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdd4424c-6ee2-417d-8b8d-3759dfaf197c",
                                                "sense_id": "dbe2164c-5630-36b6-803c-61a08a1eb548",
                                                "text": "a miserable sinner"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ce7245d-b858-366d-8dd6-c0822b2ee0b0",
                                        "entry_id": "0df968f0-5a77-3a1a-a9b7-de8392a183d5",
                                        "glosses": [
                                            "Causing unhappiness or misery."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3170302b-5b3e-4a4e-a652-031ecc8f19f8",
                                                "sense_id": "0ce7245d-b858-366d-8dd6-c0822b2ee0b0",
                                                "text": "For what's more miserable than discontent?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfa0f050-02ab-3872-8fc5-83f15640ffcd",
                                        "entry_id": "0df968f0-5a77-3a1a-a9b7-de8392a183d5",
                                        "glosses": [
                                            "Avaricious; niggardly; miserly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81b4725e-aa69-4d3a-8e9a-2db6d7ce4951",
                                                "sense_id": "bfa0f050-02ab-3872-8fc5-83f15640ffcd",
                                                "text": "the liberal-hearted man is by the opinion of the prodigal miserable, and by the judgment of the miserable lavish"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "miserable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66f1d275-7b43-3fdf-9886-5174cac2f6f0",
                                        "entry_id": "6793997e-a9f1-3c2c-bd91-779650114fe1",
                                        "glosses": [
                                            "A miserable person; a wretch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d9d5587-82a6-4518-adfc-4811586848c7",
                                                "sense_id": "66f1d275-7b43-3fdf-9886-5174cac2f6f0",
                                                "text": "Dona Carmen repaired to the balcony to chat and jest with, and at, these miserables, who stopped before the door to rest in their progress. All pretended poverty while literally groaning under the weight of their riches."
                                            },
                                            {
                                                "example_id": "c1ae1dfa-3cc0-412b-8f98-0b53f1a8b812",
                                                "sense_id": "66f1d275-7b43-3fdf-9886-5174cac2f6f0",
                                                "text": "The charge that those who played Jesus in these representations were treated badly by the plays' Jews and Romans left one commissioner cold: in his view, these miserables were beaten much less severely by the players than they were by their actual lords or curacas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "875bd803-04fd-3d30-83c4-dfa1f5dc1bf8",
                                        "entry_id": "6793997e-a9f1-3c2c-bd91-779650114fe1",
                                        "glosses": [
                                            "A state of misery or melancholy."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "informal",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9c963ca-92a7-4f95-8081-d8189751b3c7",
                                                "sense_id": "875bd803-04fd-3d30-83c4-dfa1f5dc1bf8",
                                                "text": "By 3:00 P.M. both DeeDee and Sandra's pants were thoroughly soaked, and this unhappy circumstance gave DeeDee a bad case of the miserables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
