                "senses": [
                    {
                        "sense_id": "16ed8203-9919-3720-8b90-7810a1cf387d",
                        "entry_id": "b699c1a1-4614-3e6d-8119-2ae026ae0fa7",
                        "glosses": [
                            "A collection of flowers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f919cb47-3447-4ad4-8ec1-0f7178011c24",
                                "sense_id": "16ed8203-9919-3720-8b90-7810a1cf387d",
                                "text": "Rich owners of private gardens commissioned large-format florilegiums to immortalize their personal taste and power of acquisition, and the drawn pages burned with the urgency and excitement of explaining every plant’s form, color, and beauty."
                            },
                            {
                                "example_id": "776f5d7b-6ec9-4414-a246-34e3b03900b5",
                                "sense_id": "16ed8203-9919-3720-8b90-7810a1cf387d",
                                "text": "Two centuries of German poetry lived in this old German flower garden, from the crude florilegiums of Baroque lyric to Eichendorff, who in its after-life, while looking back on so much by-gone glory, became its truest expression, as formulated by a new spirit, since poetry is the first and final need of the human soul, for which reality does not suffice."
                            },
                            {
                                "example_id": "a21bb03f-a516-4d95-a5b6-675ec67adb60",
                                "sense_id": "16ed8203-9919-3720-8b90-7810a1cf387d",
                                "text": "There was a considerable overlap between florilegiums, with their wealth of botanical illustration and exotic collections, and embroiderers’ source books. Crispin van de Passe’s A Garden of Flowers or Hortus Floridus (1614) contained engravings and descriptions of all types of garden flowers, and proved as invaluable to the embroiderer as to the gardener."
                            }
                        ]
                    },
                    {
                        "sense_id": "a24d0597-9cb1-3839-b20b-1d5231c6a41d",
                        "entry_id": "b699c1a1-4614-3e6d-8119-2ae026ae0fa7",
                        "glosses": [
