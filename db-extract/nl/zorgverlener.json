                "translations": [
                    {
                        "translation_id": "331d15a5-441b-4af3-99b1-b7f9f2a97675",
                        "source_entry_id": "aa7f1dba-006f-37bd-8588-a2b8891a02e1",
                        "source_sense_id": "1305e215-f25f-32f7-a5a8-290cb4986684",
                        "target_lang_word": "Betreuer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betreuer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "291caef1-7085-3800-8c97-3698edad5ad3",
                                        "entry_id": "7757e71e-e6d1-344f-881f-f730d98dccfb",
                                        "glosses": [
                                            "jemand, der die Aufgabe hat, eine oder mehrere andere Personen zu begleiten, pflegen oder ihnen zu helfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ac3d50-a4ae-4f32-90ff-aa2aa46c950e",
                                                "sense_id": "291caef1-7085-3800-8c97-3698edad5ad3",
                                                "text": "Als Betreuer der Fußballmannschaft kümmert er sich um die medizinische Versorgung der Spieler."
                                            },
                                            {
                                                "example_id": "173281ae-f4ff-487c-9fc9-771cc31c650a",
                                                "sense_id": "291caef1-7085-3800-8c97-3698edad5ad3",
                                                "text": "Ehrenamtliche Betreuer in speziellen Organisationen kümmern sich um Jugendliche, die unter Drogenproblemen leiden."
                                            },
                                            {
                                                "example_id": "2d5acc0a-d61f-4a4b-a436-fb528570d429",
                                                "sense_id": "291caef1-7085-3800-8c97-3698edad5ad3",
                                                "text": "Wenn ich schon kleiner bin als du, dann sei du mein Beschützer und Betreuer."
                                            },
                                            {
                                                "example_id": "af32f129-5849-4cae-89fe-a7bcd9b57cf0",
                                                "sense_id": "291caef1-7085-3800-8c97-3698edad5ad3",
                                                "text": "„Dann ging sie, von einem Hotelpagen und von ihrem Betreuer begleitet, zum Lift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0090333f-c136-33b0-b78d-81a5c2e54b80",
                                        "entry_id": "7757e71e-e6d1-344f-881f-f730d98dccfb",
                                        "glosses": [
                                            "gesetzlicher Vertreter von Volljährigen, die nicht für ihre gesamten eigenen Angelegenheiten sorgen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17846347-af47-438d-aa80-9b149c2be3d7",
                                                "sense_id": "0090333f-c136-33b0-b78d-81a5c2e54b80",
                                                "text": "„So erfahren rechtliche Betreuer und Bevollmächtigte, Aufgaben und Möglichkeiten rund um die Vertretung einer Person, die ihre Aufgaben nicht mehr selbst regeln kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c7e5a20-04d3-4d31-8cb9-a09e6bc4d70a",
                        "source_entry_id": "aa7f1dba-006f-37bd-8588-a2b8891a02e1",
                        "source_sense_id": "1305e215-f25f-32f7-a5a8-290cb4986684",
                        "target_lang_word": "Bezugsperson",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bezugsperson",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7dc8b257-4c3c-3c29-b8df-70b6288a98ec",
                                        "entry_id": "48e7344f-4230-35e2-8e50-b26b7b0b947f",
                                        "glosses": [
                                            "Person, mit der man eine persönliche Beziehung hat und an der man sich orientiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3b14696-7e3b-4075-9f58-01f5caf34dd1",
                                                "sense_id": "7dc8b257-4c3c-3c29-b8df-70b6288a98ec",
                                                "text": "Eltern und Geschwister sind die wichtigsten Bezugspersonen für ein kleines Kind."
                                            },
                                            {
                                                "example_id": "a4856af7-5c09-4f34-845b-e61e4b9dd114",
                                                "sense_id": "7dc8b257-4c3c-3c29-b8df-70b6288a98ec",
                                                "text": "„Die Kinderpsychoanalytikerin Anna Freud beobachtete, dass Kriegskinder die Trennung von ihrer Bezugsperson als genauso traumatisch erlebten wie zum Beispiel Luftangriffe.“"
                                            },
                                            {
                                                "example_id": "04b7af57-1831-420e-a99b-ed23ac51adad",
                                                "sense_id": "7dc8b257-4c3c-3c29-b8df-70b6288a98ec",
                                                "text": "„Ein Kind, das zuerst nicht-reaktive Laute bildet, imitiert Laute, für die es durch Zuwendung der Bezugspersonen belohnt wird.“"
                                            },
                                            {
                                                "example_id": "acffd952-ebd2-4d88-8c94-79d84be6ad4a",
                                                "sense_id": "7dc8b257-4c3c-3c29-b8df-70b6288a98ec",
                                                "text": "„Damit wurde er zu einer zentralen Bezugsperson für viele, er beschäftigte sich selbst und die übrigen Gefangenen, trug zur Aufrechterhaltung der Moral bei und machte sich einen Namen als Intellektueller unter den ZANU-Führern.“"
                                            },
                                            {
                                                "example_id": "2b846170-359e-493e-a574-d59808c1cd86",
                                                "sense_id": "7dc8b257-4c3c-3c29-b8df-70b6288a98ec",
                                                "text": "„Neben Amalia und Milena waren die Figuren in den Büchern meine ersten Bezugspersonen, meine ersten Freunde, die ersten, für die ich schwärmte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f350b01b-5bb6-48d8-af26-f14b65507349",
                        "source_entry_id": "aa7f1dba-006f-37bd-8588-a2b8891a02e1",
                        "source_sense_id": "1305e215-f25f-32f7-a5a8-290cb4986684",
                        "target_lang_word": "caregiver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caregiver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef6738dc-517b-327d-8dd1-10f6334d484d",
                                        "entry_id": "1bfb52a6-9a5a-306b-9e9a-266a917596a1",
                                        "glosses": [
                                            "A carer; a person who looks after another person."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d7ceb96-b8a0-4927-a432-2fcf4c63ba5c",
                                                "sense_id": "ef6738dc-517b-327d-8dd1-10f6334d484d",
                                                "text": "‘Caregivers in this role can suffer as much as the patients. It can be very stressful.’"
                                            },
                                            {
                                                "example_id": "810525a9-2ff3-40c1-98fc-c224c9f7a7ce",
                                                "sense_id": "ef6738dc-517b-327d-8dd1-10f6334d484d",
                                                "text": "The coronavirus has turned caregivers around the world into homeschoolers."
                                            },
                                            {
                                                "example_id": "00136011-1db1-4a3e-82e2-526ea9d4dcab",
                                                "sense_id": "ef6738dc-517b-327d-8dd1-10f6334d484d",
                                                "text": "Taking care of an elderly parent or seriously ill spouse or family member can be physically and emotionally draining — and expensive for the caregiver in more ways than one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "805f9b3f-3a4d-4fef-8246-a2aaa6425371",
                        "source_entry_id": "aa7f1dba-006f-37bd-8588-a2b8891a02e1",
                        "source_sense_id": "1305e215-f25f-32f7-a5a8-290cb4986684",
                        "target_lang_word": "caretaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caretaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20bdc9ce-a519-3e59-ae4a-4ca41c0e606c",
                                        "entry_id": "45595e22-7d55-37f6-a33c-07396504de35",
                                        "glosses": [
                                            "Someone who takes care of a place or thing; someone looking after a place, or responsible for keeping it in good repair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8705490d-e57e-48dc-9784-dc822b228699",
                                                "sense_id": "20bdc9ce-a519-3e59-ae4a-4ca41c0e606c",
                                                "text": "Her dad was a cemetery caretaker for many years. There was a lot of landscaping work. The gravedigging itself was done with backhoes."
                                            },
                                            {
                                                "example_id": "04f40265-70ce-4f45-a135-72aea3c9108e",
                                                "sense_id": "20bdc9ce-a519-3e59-ae4a-4ca41c0e606c",
                                                "text": "‘Miss Brindle must be very rich to live in such a big house,’ went on Jessamy. ‘Miss Brindle rich?’ said Aunt Maggie. ‘Bless you, she hasn’t tuppence to rub together. She’s only the caretaker.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b978d59c-54ae-3525-b28d-0b5f6c4d36bc",
                                        "entry_id": "45595e22-7d55-37f6-a33c-07396504de35",
                                        "glosses": [
                                            "Synonym of caregiver (“a person who provides care to another”)."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "caretaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66ad94c6-04ae-33ff-8aeb-deba8abbb714",
                                        "entry_id": "84cb3ca7-5373-3cf1-8831-ec01f1c8c411",
                                        "glosses": [
                                            "Temporary, on a short term basis."
                                        ],
                                        "tags": [
                                            "UK",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "591b3906-e85d-4301-b80f-617ea1cf6d8f",
                                                "sense_id": "66ad94c6-04ae-33ff-8aeb-deba8abbb714",
                                                "text": "Johnson had to be drafted in as the caretaker manager after Hewlett resigned without warning the day before the final."
                                            },
                                            {
                                                "example_id": "4bd2cc66-4324-4d75-94d4-b6b9a165ccfb",
                                                "sense_id": "66ad94c6-04ae-33ff-8aeb-deba8abbb714",
                                                "text": "Sources within Sánchez’s caretaker administration claim the amnesty law is perfectly in keeping with the Socialist-led government’s efforts to calm tensions and find a political solution to the so-called Catalan question."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58d57641-a04a-49fc-ac1a-d9dae8e6a944",
                        "source_entry_id": "aa7f1dba-006f-37bd-8588-a2b8891a02e1",
                        "source_sense_id": "1305e215-f25f-32f7-a5a8-290cb4986684",
                        "target_lang_word": "concierge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concierge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                        "entry_id": "0fbe4f9e-9db1-36a4-a1dd-908711d503e8",
                                        "glosses": [
                                            "Celui, celle qui a la garde d’un immeuble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fd48066-8356-49c8-b725-372c64f52b01",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "Au lieu de cette poésie, un affreux chien qui m’aboyait aux jambes, et une femme comme les autres, sans cervelle, sans idées, uniquement occupée de plaisirs, bornant son rêve au théâtre des Variétés et aux caresses de son Spy, son Spy !… ah ! ah ! ah ! son Spy, cet animal ridicule qu’elle aimait avec des tendresses et des mots de concierge !"
                                            },
                                            {
                                                "example_id": "b18fedea-00b5-40e7-8b89-c2d5e44bf36c",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "Un gros concierge, un secrétaire rose, nous acclament avec la joie d’un poitrinaire devenu cent kilos, d’un bilieux devenu poupin."
                                            },
                                            {
                                                "example_id": "4b980853-a7df-4524-be5e-6e66efe934e9",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "La loge du concierge figure une tour carrée, avec une plate-forme à créneaux, garnie d’échauguettes."
                                            },
                                            {
                                                "example_id": "ca4fa000-d096-41ce-a903-ae03cac9bf85",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "Jamalou, le concierge, s’apercevant que la voûte se trouvait éclairée, alla se rendre compte du fait et ne vit rien d’abord qui l’étonnât."
                                            },
                                            {
                                                "example_id": "d9eca25f-52ff-40ed-8517-6f4ec429fc02",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "Une supériorité incontestable de New-York sur Paris, c’est qu’il n’y a pas de concierges, cette race abominable qui épluche votre courrier, épie vos allées et venues, potine avec votre voisin de palier et réussit souvent à vous mettre à couteaux tirés avec les propres membres de votre famille."
                                            },
                                            {
                                                "example_id": "082dd4a6-357b-4f49-b2b0-9bd5f1085e1a",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "La loge du concierge était enfouie dans les ténèbres. Autrefois je me serais étonné de la constance avec laquelle Paris maintient ses concierges dans la nuit. Maintenant j’en comprenais la raison. Le métier des concierges exige une telle tension nerveuse qu’une lumière trop vive leur fatiguerait les yeux. D’autre part, du fond de la pénombre, ils voient mieux ce qui se passe à l’extérieur. Leurs yeux gagnent en finesse, comme ceux des chats."
                                            },
                                            {
                                                "example_id": "2e845d15-6ddf-4e82-94f8-cf4f61922402",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "La concierge logeait au premier. Elle ne pouvait pas entendre. D’ailleurs elle n'était pas là, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "940a0f13-cb08-31ca-ba5b-964f0be80135",
                                        "entry_id": "0fbe4f9e-9db1-36a4-a1dd-908711d503e8",
                                        "glosses": [
                                            "Commère, bavard."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f371c43-f390-4521-ae71-40e2cbefba61",
                                                "sense_id": "940a0f13-cb08-31ca-ba5b-964f0be80135",
                                                "text": "Quelle concierge, celle-là... — Tu vois que tu utilises ce mot dans son acception péjorative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6f77bc6-b098-340f-91ef-dfa108bfb2e1",
                                        "entry_id": "0fbe4f9e-9db1-36a4-a1dd-908711d503e8",
                                        "glosses": [
                                            "Employé, dans le secteur de l’hôtellerie de luxe (4 ou 5 étoiles et palaces), dont les principales fonctions sont d’accueillir, de renseigner et de conseiller les clients."
                                        ],
                                        "tags": [
                                            "Hôtellerie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96aa2bc7-924c-46bf-8509-085cac46b238",
                        "source_entry_id": "aa7f1dba-006f-37bd-8588-a2b8891a02e1",
                        "source_sense_id": "1305e215-f25f-32f7-a5a8-290cb4986684",
                        "target_lang_word": "gardien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gardien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                        "entry_id": "58fceac1-c769-3eed-8acb-ea7ba6ce8500",
                                        "glosses": [
                                            "Celui qui garde, surveille quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49f1c93d-0816-4677-bccc-062158f4fde8",
                                                "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                                "text": "Les bêtes levèrent leur mufle humide et, dociles à l’invite de leur jeune gardien, gravirent le coteau pour reprendre, […], le chemin de terre bordé de haies vives aboutissant au village."
                                            },
                                            {
                                                "example_id": "e5f8ae53-9261-4b00-8146-526c65cbc53f",
                                                "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                                "text": "Il pense au gardien de la mine d’Ichmoul mettant en fuite les bandits avec les quatre cartouches de son vieux mousqueton."
                                            },
                                            {
                                                "example_id": "aa62c904-5acc-4233-9a8f-51a41ef46e4d",
                                                "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                                "text": "Il fit état de la tendresse et de l’affection que le couple de lions manifestait à leur gardien."
                                            },
                                            {
