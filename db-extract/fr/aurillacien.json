                        "glosses": [
                            "Relatif à la commune d'Aurillac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d2428e-a4d7-4e62-8432-aac474268bb6",
                                "sense_id": "7af65f4b-ef1a-3989-9a1d-3b8ba0ae9e6c",
                                "text": "Chantre prédestiné des édifices aurillaciens, je regardais avec mélancolie ces autres monuments : le sous-main, le piano, la pendule qui seraient eux aussi – pourquoi pas ? – immortalisés par mes pensums futurs."
                            },
                            {
                                "example_id": "77d7de6b-1b78-4b75-af8d-713d857463d3",
                                "sense_id": "7af65f4b-ef1a-3989-9a1d-3b8ba0ae9e6c",
                                "text": "De toute manière, en admettant que ma jeune épouse aurillacienne disparût dans un accident, ce malheur ne suffirait pas à m’élire : il était à la fois fortuit et trop commun."
                            }
                        ]
                    }
