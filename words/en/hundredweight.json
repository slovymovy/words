{
    "word_family": [
        "hundred"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ebd78884-9fd1-3e27-bd89-2bf2134f0b89",
                    "sense_definition": "A unit of weight equal to 100 avoirdupois pounds, primarily used in the United States.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weight_units",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipment was measured in a <w>hundredweight</w> of 100 pounds for easier calculation.",
                            "target_lang_translations": {
                                "zh": "为了方便计算，这批货物以100磅的<w>美担</w>为单位进行测量。"
                            }
                        },
                        {
                            "text": "Farmers often sell grain by the <w>short</w> <w>hundredweight</w> in local markets.",
                            "target_lang_translations": {
                                "zh": "农民经常在当地市场上按<w>美担</w>出售谷物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "short hundredweight",
                        "centner",
                        "cental"
                    ],
                    "common_phrases": [
                        "short hundredweight"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种重量单位，等于100磅，主要在美国使用。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "美担",
                                "target_lang_sense_clarification": "指美国使用的100磅重量单位。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68338866-a87c-3e86-aca2-142c54821fee",
                    "sense_definition": "A unit of weight equal to 112 avoirdupois pounds, primarily used in the United Kingdom.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weight_units",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>long</w> <w>hundredweight</w> is still occasionally referenced in historical British trade documents.",
                            "target_lang_translations": {
                                "zh": "在英国历史贸易文件中，偶尔还会提到<w>英担</w>。"
                            }
                        },
                        {
                            "text": "Heavy goods were traditionally weighed using the <w>imperial</w> <w>hundredweight</w> of 112 pounds.",
                            "target_lang_translations": {
                                "zh": "重型货物传统上使用112磅的<w>英担</w>来称重。"
                            }
                        }
                    ],
                    "synonyms": [
                        "long hundredweight",
                        "imperial hundredweight"
                    ],
                    "common_phrases": [
                        "long hundredweight",
                        "imperial hundredweight"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种重量单位，等于112磅，主要在英国使用。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "英担",
                                "target_lang_sense_clarification": "指英国使用的112磅重量单位。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a94bb76-0b5c-3d2f-9197-abeb731d47e8",
                    "sense_definition": "A unit of measurement equivalent to a quintal, representing various amounts depending on the context.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weight_units",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some agricultural contexts, the term is used as a <w>hundredweight</w> equivalent to a metric quintal.",
                            "target_lang_translations": {
                                "zh": "在某些农业语境下，该术语被用作相当于一<w>公担</w>的重量单位。"
                            }
                        },
                        {
                            "text": "The <w>quintal</w> serves as a <w>hundredweight</w> in several international trade systems.",
                            "target_lang_translations": {
                                "zh": "在一些国际贸易体系中，<w>公担</w>被用作重量单位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quintal"
                    ],
                    "target_lang_definitions": {
                        "zh": "相当于公担的计量单位，根据语境代表不同的重量。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "公担",
                                "target_lang_sense_clarification": "公制重量单位，等于100公斤。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a1c63b8-6816-3f5e-bb73-ef13b4692da5",
                    "sense_definition": "Various historical units of measurement consisting of 100 base units.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weight_units",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient records describe a <w>hundredweight</w> as a collection of 100 smaller units of grain.",
                            "target_lang_translations": {
                                "zh": "古代记录将<w>百单位</w>描述为100个较小的谷物单位的集合。"
                            }
                        },
                        {
                            "text": "The <w>centenary</w> system often defined a <w>hundredweight</w> based on local standards of the time.",
                            "target_lang_translations": {
                                "zh": "百年系统通常根据当时的当地标准来定义<w>百单位</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "centenary"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical measurement systems."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "各种由100个基本单位组成的古代计量单位。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "百单位",
                                "target_lang_sense_clarification": "指代历史上以100为基数的计量系统。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
