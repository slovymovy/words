                                        "sense_id": "1425e13d-96ed-3f42-8946-e3804312b434",
                                        "entry_id": "fb89e21b-69fc-35de-a7da-0c3aafa19376",
                                        "glosses": [
                                            "dickfleischige Pflanze der Tropen und Subtropen; eine Gattung in der Pflanzenfamilie der Spargelgewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3899eec1-d6a6-48dc-a649-b2219d2df56c",
                                                "sense_id": "1425e13d-96ed-3f42-8946-e3804312b434",
                                                "text": "Agaven blühen nur einmal in ihrem Lebenszyklus."
                                            }
