{
    "word_family": [
        "accomplissement",
        "inaccompli"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fdab77d6-c56a-3c18-a01a-6144a9aea963",
                    "sense_definition": "Mettre à exécution, mener à bien une tâche, une action ou un projet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "réalisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe a réussi à <w>accomplir</w> cette mission difficile en seulement quelques jours."
                        },
                        {
                            "text": "Chaque matin, il s'efforce d'<w>accomplir</w> ses tâches avant de faire une courte pause."
                        }
                    ],
                    "synonyms": [
                        "réaliser",
                        "exécuter",
                        "effectuer"
                    ],
                    "antonyms": [
                        "abandonner",
                        "négliger"
                    ],
                    "common_phrases": [
                        "accomplir une tâche",
                        "accomplir une mission",
                        "accomplir un exploit"
                    ]
                },
                {
                    "sense_id": "fc657734-5d46-3967-b87a-41eedd62490f",
                    "sense_definition": "Remplir ses obligations, satisfaire à un devoir moral ou légal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "devoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les citoyens sont invités à <w>accomplir</w> leur devoir civique lors des élections."
                        },
                        {
                            "text": "Ce médecin veille toujours à <w>accomplir</w> ses obligations professionnelles avec le plus grand soin."
                        }
                    ],
                    "synonyms": [
                        "remplir",
                        "honorer"
                    ],
                    "antonyms": [
                        "enfreindre",
                        "faillir"
                    ],
                    "common_phrases": [
                        "accomplir son devoir",
                        "accomplir ses obligations"
                    ]
                },
                {
                    "sense_id": "f866b137-4903-3ba9-824d-f02bfd2062e7",
                    "sense_definition": "En parlant d'une personne, se réaliser pleinement et trouver son épanouissement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "épanouissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a trouvé un métier passionnant dans lequel elle peut pleinement s'<w>accomplir</w>."
                        },
                        {
                            "text": "Certains artistes ont besoin de créer régulièrement pour s'<w>accomplir</w> sur le plan personnel."
                        }
                    ],
                    "synonyms": [
                        "s'épanouir"
                    ],
                    "common_phrases": [
                        "s'accomplir dans son travail"
                    ]
                },
                {
                    "sense_id": "11152d41-39d5-3c30-b63a-a43773bbda43",
                    "sense_definition": "Se produire, arriver à son terme en parlant d'un événement, d'une prédiction ou d'un vœu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "avènement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon la légende, cette ancienne prophétie devait s'<w>accomplir</w> après un siècle de paix."
                        },
                        {
                            "text": "Leurs vœux les plus secrets finirent par s'<w>accomplir</w> au terme d'une longue attente."
                        }
                    ],
                    "synonyms": [
                        "se réaliser",
                        "se produire"
                    ]
                }
            ]
        }
    ]
}