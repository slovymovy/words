    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ae9b1ec-4d7b-34b5-978b-abcfad9d9a87",
                    "sense_definition": "Résultat chiffré ou succès obtenu par un athlète ou une équipe dans une compétition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à un entraînement rigoureux, la jeune nageuse a amélioré sa <w>performance</w> de plusieurs secondes."
                        },
                        {
                            "text": "Toute l'équipe a célébré cette magnifique <w>performance</w> sportive après la finale du tournoi régional."
                        }
                    ],
                    "synonyms": [
                        "résultat",
                        "score"
                    ],
                    "antonyms": [
                        "contre-performance"
                    ],
                    "common_phrases": [
                        "belle performance",
                        "réaliser une performance",
                        "performance sportive"
                    ]
                },
                {
                    "sense_id": "e65547b3-2a6c-3213-9895-8fec4f6bde2e",
                    "sense_definition": "Exploit ou réussite remarquable accomplie dans un domaine particulier.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exploit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Terminer la rédaction de cette thèse en six mois représente une véritable <w>performance</w> intellectuelle."
                        },
                        {
                            "text": "Le médecin a salué la <w>performance</w> des chirurgiens qui ont opéré ce patient durant dix heures."
                        }
                    ],
                    "synonyms": [
                        "exploit",
                        "prouesse",
                        "réussite"
                    ],
                    "antonyms": [
                        "échec",
                        "fiasco"
                    ],
                    "common_phrases": [
                        "véritable performance",
                        "saluer la performance"
                    ]
                },
                {
                    "sense_id": "9d83d9f6-0b99-3341-913c-40cfdbe88794",
                    "sense_definition": "Ensemble des capacités techniques, de la vitesse ou de la puissance d'une machine ou d'un appareil.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>performances</w> de ce nouvel ordinateur permettent de traiter des calculs complexes très rapidement."
                        },
                        {
                            "text": "Le constructeur automobile vante la haute <w>performance</w> de son nouveau moteur hybride sur autoroute."
                        }
                    ],
                    "synonyms": [
                        "capacité",
                        "puissance",
                        "rendement"
                    ],
                    "common_phrases": [
                        "haute performance",
                        "performances d'un ordinateur",
                        "gain de performance"
                    ]
                },
                {
                    "sense_id": "b96a59b4-d8a1-30dc-9adc-9c17f6f17147",
                    "sense_definition": "Efficacité, rentabilité ou niveau de résultat obtenu par une entreprise ou un travailleur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction évalue la <w>performance</w> financière de la société chaque trimestre afin d'ajuster les investissements."
                        },
                        {
                            "text": "Une prime sera versée aux salariés en fonction de leur <w>performance</w> individuelle au cours de l'année."
                        }
                    ],
                    "synonyms": [
                        "compétitivité",
                        "efficacité",
                        "productivité"
                    ],
                    "antonyms": [
                        "inefficacité"
                    ],
                    "common_phrases": [
                        "indicateur de performance",
                        "critère de performance",
                        "performance économique"
                    ]
                },
                {
                    "sense_id": "34a23e80-a509-3b49-bf52-dd897b024cff",
                    "sense_definition": "Manifestation artistique en direct, souvent interdisciplinaire, où l'acte même constitue l'œuvre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le musée d'art moderne a invité des créateurs pour une <w>performance</w> captivante devant le public."
                        },
                        {
                            "text": "Cette <w>performance</w> mêlant danse contemporaine et poésie a suscité de vives réactions parmi les spectateurs."
                        }
                    ],
                    "synonyms": [
                        "happening"
                    ],
                    "common_phrases": [
                        "performance artistique"
                    ]
                },
                {
                    "sense_id": "8dbb3e8e-0854-3af2-b213-2c1c7dbcef84",
                    "sense_definition": "Comportement et résultat d'un cheval lors d'une course hippique passée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hippisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parieurs étudient attentivement les dernières <w>performances</w> des pur-sang avant de placer leurs mises."
                        },
                        {
                            "text": "La mauvaise <w>performance</w> de ce cheval favori a surpris tous les spécialistes de la discipline."
                        }
                    ],
                    "common_phrases": [
                        "performances passées"
                    ]
                },
                {
                    "sense_id": "a0ccd315-9214-3151-8b0f-c0184bc88d76",
                    "sense_definition": "En linguistique générative, utilisation effective et concrète de la langue par un locuteur en situation d'énonciation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Noam Chomsky établit une distinction célèbre entre la compétence linguistique et la <w>performance</w> réelle du locuteur."
                        },
                        {
                            "text": "La fatigue ou les hésitations affectent directement la <w>performance</w> sans altérer la compétence sous-jacente."
                        }
                    ],
                    "antonyms": [
                        "compétence"
                    ],
                    "common_phrases": [
                        "compétence et performance"
                    ]
                }
            ]
        }
    ]
}