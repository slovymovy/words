                        "glosses": [
                            "Garrot, appareil de supplice par strangulation, le supplice lui-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cb58c31-6b40-4778-b2d8-252cfdd2b0bb",
                                "sense_id": "9b0c735f-0fe7-3337-8515-e0827c07fd34",
                                "text": "Sa bouche desséchée, aride, n’avait plus de salive ; un carcan de fer étreignait sa gorge comme le garote espagnol fait d’un criminel, et de sa cervelle les mots qu’il devait prononcer s’envolaient effarés, tumultueux, se heurtant et s’enchevêtrant comme des oiseaux qui fuient de leur cage ouverte."
                            },
                            {
                                "example_id": "219686bb-518e-435d-8a1c-2f4a10b1204b",
                                "sense_id": "9b0c735f-0fe7-3337-8515-e0827c07fd34",
                                "text": "[…] les eux plus turbulents ont subit le supplice de la garote, et les autres, d’un naturel plus sage, sont aujourd'hui intimidés et contrits."
                            }
                        ]
                    }
