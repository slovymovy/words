                "translations": [
                    {
                        "translation_id": "e6a78b91-bc57-4b20-b8f4-b4ea006a41cf",
                        "source_entry_id": "dd293f15-43d0-3929-bafc-7b37958fd76e",
                        "source_sense_id": "b909ba78-8391-3520-b732-31f1c49b58f7",
                        "target_lang_word": "hideur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hideur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "405fad5c-aba9-37d7-9ffb-368695902166",
                                        "entry_id": "e5b6b6c6-0e29-3fd6-92db-4979babcaae2",
                                        "glosses": [
                                            "Qualité, état, fait d’être hideux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ac5cf7e-2b42-4c1e-86aa-b22818bf14a6",
                                                "sense_id": "405fad5c-aba9-37d7-9ffb-368695902166",
                                                "text": "Marseille, quand elle est belle, est extrêmement belle, mais, dans ses hideurs, elle va au paroxysme."
                                            },
                                            {
                                                "example_id": "545c95d3-8161-4a72-b184-b2d973d103bd",
                                                "sense_id": "405fad5c-aba9-37d7-9ffb-368695902166",
                                                "text": "…il allait se venger, sans assumer sur lui la responsabilité d’une action dont il avait compris toute la hideur, mais à laquelle il avait eu le talent d’associer les chefs de sa nation sous une apparence de justice."
                                            },
                                            {
                                                "example_id": "6de18d32-1dc5-4b23-ad83-4d5ebf4b7bab",
                                                "sense_id": "405fad5c-aba9-37d7-9ffb-368695902166",
                                                "text": "Je dois avouer que j'éprouve une certaine gêne à exercer la fonction professionnelle de verbicruciste, mot fort laid qui a l'on ne sait quoi du petit crustacé des mers australes. Il est vrai que cruciverbiste ne vaut pas mieux ; nous voilà donc, lui et moi, réconciliés (provisoirement) dans une même hideur terminologique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c65a025f-d6c7-3adf-8b52-8bcd28ed4a90",
                                        "entry_id": "e5b6b6c6-0e29-3fd6-92db-4979babcaae2",
                                        "glosses": [
                                            "Chose hideuse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dfdc59a-86dc-4ff6-9b74-2a2acc67981b",
                                                "sense_id": "c65a025f-d6c7-3adf-8b52-8bcd28ed4a90",
                                                "text": "La plupart du temps, notre cour n’offrait que des hideurs sans relief, surtout l’été."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
