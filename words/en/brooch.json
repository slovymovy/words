{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c293be0-7692-3e46-90d1-1ccda2e920ad",
                    "sense_definition": "A decorative piece of jewellery with a pin at the back, worn attached to clothing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "jewellery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She fastened a silver <w>brooch</w> to the lapel of her winter jacket.",
                            "target_lang_translations": {
                                "de": "Sie befestigte eine silberne <w>Brosche</w> am Revers ihrer Winterjacke.",
                                "zh": "她在冬装外套的翻领上别了一枚银质<w>胸针</w>。"
                            }
                        },
                        {
                            "text": "Her grandmother left her an antique gold <w>brooch</w> shaped like a flower.",
                            "target_lang_translations": {
                                "de": "Ihre Großmutter hinterließ ihr eine antike goldene <w>Brosche</w> in Form einer Blume.",
                                "zh": "祖母留给她一枚花朵形状的古董金<w>胸针</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "breastpin"
                    ],
                    "common_phrases": [
                        "gold brooch",
                        "silver brooch",
                        "antique brooch",
                        "wear a brooch"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein dekoratives Schmuckstück mit einer Nadel auf der Rückseite, das an der Kleidung befestigt getragen wird.",
                        "zh": "一种背面带有别针、别在衣服上佩戴的装饰性首饰。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Brosche",
                                "target_lang_sense_clarification": "Schmucknadel für Kleidung"
                            },
                            {
                                "target_lang_word": "Anstecknadel",
                                "target_lang_sense_clarification": "Nadel zum Anstecken"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胸针",
                                "target_lang_sense_clarification": "饰品，别在衣襟上"
                            },
                            {
                                "target_lang_word": "别针",
                                "target_lang_sense_clarification": "饰针、装饰别针"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eee713b1-5dc7-38ca-b4ee-16d352e8197d",
                    "sense_definition": "A monochrome painting executed entirely in a single colour, such as sepia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist presented a small <w>brooch</w> painted using only sepia tones.",
                            "target_lang_translations": {
                                "de": "Der Künstler präsentierte ein kleines <w>Monochromgemälde</w>, das ausschließlich in Sepiatönen gemalt war.",
                                "zh": "画家展示了一幅仅用深褐色调绘制的小型<w>单色画</w>。"
                            }
                        },
                        {
                            "text": "The gallery featured a rare eighteenth-century <w>brooch</w> rendered entirely in grey.",
                            "target_lang_translations": {
                                "de": "Die Galerie zeigte eine seltene <w>Grisaille</w> aus dem 18. Jahrhundert, die ganz in Grau gehalten war.",
                                "zh": "画廊展出了一幅罕见的18世纪全灰调<w>单色画</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Rare or obsolete term in art"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein monochromes Gemälde, das vollständig in einer einzigen Farbe (wie etwa Sepia) ausgeführt ist; Grisaille oder Camaieu.",
                        "zh": "完全用单一颜色（如深褐色）绘制的单色画。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Monochromie",
                                "target_lang_sense_clarification": "einfarbiges Gemälde"
                            },
                            {
                                "target_lang_word": "Grisaille",
                                "target_lang_sense_clarification": "Grauin-Grau-Malerei"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单色画",
                                "target_lang_sense_clarification": "单色绘画作品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31eb926f-f0ef-3963-bd7e-e2b1e7ed71ef",
                    "sense_definition": "To adorn or fasten as if with a brooch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A gleaming buckle served to <w>brooch</w> his velvet cloak at the shoulder.",
                            "target_lang_translations": {
                                "de": "Eine glänzende Schnalle diente dazu, seinen Samtumhang an der Schulter <w>zusammenzuhalten</w>.",
                                "zh": "一枚闪亮的搭扣在肩部将他的天鹅绒斗篷<w>别住</w>。"
                            }
                        },
                        {
                            "text": "Fine jewels seemed to <w>brooch</w> the collar of her royal gown.",
                            "target_lang_translations": {
                                "de": "Edle Juwelen schienen den Kragen ihres königlichen Gewandes zu <w>zieren</w>.",
                                "zh": "精美的珠宝似乎<w>缀饰</w>着她那件华丽礼袍的衣领。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Wie mit einer Brosche schmücken oder zusammenheften.",
                        "zh": "（如用胸针般）别住、固定或装饰。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "anheften",
                                "target_lang_sense_clarification": "mit einer Nadel befestigen"
                            },
                            {
                                "target_lang_word": "schmücken",
                                "target_lang_sense_clarification": "mit Schmuck versehen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "别住",
                                "target_lang_sense_clarification": "用别针或扣子扣住"
                            },
                            {
                                "target_lang_word": "缀饰",
                                "target_lang_sense_clarification": "装饰、点缀"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}