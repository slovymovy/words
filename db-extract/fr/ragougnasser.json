                ],
                "senses": [
                    {
                        "sense_id": "ed047938-7c8f-300e-a417-9f2cdc9e3f87",
                        "entry_id": "cfa3c3d7-1e03-3918-8894-b5e32dc6885d",
                        "glosses": [
                            "Cuisiner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55249a7a-3704-41c7-a22a-28ba421fc6d0",
                                "sense_id": "ed047938-7c8f-300e-a417-9f2cdc9e3f87",
                                "text": "Lorsque je mitonne, ragougnasse, fait mijoter..."
                            },
                            {
                                "example_id": "415cb43e-6b98-44f7-b826-357e70f76c42",
                                "sense_id": "ed047938-7c8f-300e-a417-9f2cdc9e3f87",
                                "text": "Il ne nous reste plus qu’à ragougnasser une bonne daube à domicile en regardant un racé DVD."
                            },
                            {
                                "example_id": "30ed1c70-18f0-4bac-9182-b3ccc61272db",
                                "sense_id": "ed047938-7c8f-300e-a417-9f2cdc9e3f87",
                                "text": "Organisées en chapitres (cuisiner la veille, cuisiner au quotidien, avec les enfants, ou pour recevoir), chaque recette met l’eau à la bouche et donne des envies de « civeter », « bain-mariser », « ragougnasser », comme disait Michel Audiard."
                            },
                            {
                                "example_id": "ca5252d5-cc3b-4efc-95e5-1f45ccae800d",
                                "sense_id": "ed047938-7c8f-300e-a417-9f2cdc9e3f87",
                                "text": "Je vois, on civette, on bain-marise, on ragougnasse."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a5549b0-e409-35e9-bb80-6a0be198a6be",
                        "entry_id": "cfa3c3d7-1e03-3918-8894-b5e32dc6885d",
                        "glosses": [
                            "Tenir des propos incohérents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1c04808-1a6f-4dd0-a096-ddb64d4029ae",
                                "sense_id": "6a5549b0-e409-35e9-bb80-6a0be198a6be",
                                "text": "Je radote, je ragougnasse, mais l’essentiel n’est pas politique, pour l’heure, mais amoureux."
                            }
                        ]
                    }
                ],
