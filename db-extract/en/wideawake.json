                        "examples": [
                            {
                                "example_id": "625fa346-4f92-45f4-9485-5929cf8292ad",
                                "sense_id": "05ce99a0-6f38-30c6-84d3-22a82315b5fe",
                                "text": "1912, Katherine Mansfield, \"The Woman At The Store\", from \"Selected Short Stories\"\nWisps of white hair straggled from under his wideawake […]"
                            },
                            {
                                "example_id": "6d0af921-be3a-404a-9504-d1a993b31d97",
                                "sense_id": "05ce99a0-6f38-30c6-84d3-22a82315b5fe",
                                "text": "1884, Henry James, \"The Author of Beltraffio\" in The English Illustrated Magazine 1 (9–10) (June–July 1884).\n\"He carried his benevolence to the point of coming to meet me at the little station at which I was to alight, and my heart beat very fast as I saw his handsome face, surmounted with a soft wide-awake, and which I knew by a photograph long since enshrined upon my mantel shelf, scanning the carriage windows as the train rolled up.\""
                            }
                        ]
                    }
