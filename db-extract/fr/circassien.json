                        "cross_references": [
                            {
                                "target_word": "черкес",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d2c0cdca-ef43-3816-9645-a590ce86f9a5",
                                        "entry_id": "4a08648f-47a7-3216-808c-492dafcfbe52",
                                        "glosses": [
                                            "в узком смысле — представитель адыгского народа, проживающий в Карачаево-Черкесской Республике"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65f23dc-9df3-4e53-a4ab-635e9c7d4d2e",
                                                "sense_id": "d2c0cdca-ef43-3816-9645-a590ce86f9a5",
                                                "text": "В красных клетушках вагонов, у расседланных полуголодных лошадей, толпились полуголодные донские, уссурийские, оренбургские, нерчинские и амурские казаки, ингуши, черкесы, кабардинцы, осетины, дагестанцы."
                                            },
                                            {
                                                "example_id": "cfc8e9b0-5ff8-4ce7-872d-67b95868363c",
                                                "sense_id": "d2c0cdca-ef43-3816-9645-a590ce86f9a5",
                                                "text": "Из северокавказских горцев, не привлекавшихся к воинской повинности (чеченцы, ингуши, черкесы, дагестанцы), была сформирована на добровольческих началах Кавказская Туземная дивизия, известная больше под названием «Дикая»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe63e0e0-2a99-3866-b818-69532b4b969c",
                                        "entry_id": "4a08648f-47a7-3216-808c-492dafcfbe52",
                                        "glosses": [
                                            "собир. в широком смысле — наиболее известное название адыгского народа, коренного населения Северо-Западного Кавказа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23881d1f-ee32-4590-a83a-54fbc5dcc4b4",
                                                "sense_id": "fe63e0e0-2a99-3866-b818-69532b4b969c",
                                                "text": "Черкесы вслед за мной спешили // И казаков моих убили, // И верный конь под мною пал!"
                                            },
                                            {
                                                "example_id": "f57d8882-45ea-4158-95be-e1815b5e7397",
                                                "sense_id": "fe63e0e0-2a99-3866-b818-69532b4b969c",
                                                "text": "Черкесы вообще умели хорошо владеть конем и оружием, но и наши линейские казаки не уступали им в этом деле."
                                            },
                                            {
                                                "example_id": "0513c754-1024-47e5-8e5a-a03f739a8cb5",
                                                "sense_id": "fe63e0e0-2a99-3866-b818-69532b4b969c",
                                                "text": "— Кстати, мне недавно рассказывал один болгарин в Москве, — продолжал Иван Фёдорович, как бы и не слушая брата, — как турки и черкесы там у них, в Болгарии, повсеместно злодействуют, опасаясь поголовного восстания славян, — то есть жгут, режут, насилуют женщин и детей, прибивают арестантам уши к забору гвоздями и оставляют так до утра, а поутру вешают — и проч., всего и вообразить невозможно."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
