                                "target_senses": [
                                    {
                                        "sense_id": "bdab5bce-a54e-3320-98b2-b99d3c7d00f2",
                                        "entry_id": "83237379-d041-316a-b60f-6344a5e3bad2",
                                        "glosses": [
                                            "A thing that holds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "351d67b5-463b-4cea-bb20-af78dfe10072",
                                                "sense_id": "bdab5bce-a54e-3320-98b2-b99d3c7d00f2",
                                                "text": "Put your umbrella in the umbrella holder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78cd15f7-a529-3ffb-afcf-51b1f08dd74b",
                                        "entry_id": "83237379-d041-316a-b60f-6344a5e3bad2",
                                        "glosses": [
                                            "A person who temporarily or permanently possesses something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de41150c-20ef-4c6c-99f3-1342a00a9a13",
                                                "sense_id": "78cd15f7-a529-3ffb-afcf-51b1f08dd74b",
                                                "text": "He's been an account holder with us since 2004."
                                            },
                                            {
                                                "example_id": "7c74a1bc-2458-4531-ad61-2e931b7c7d96",
                                                "sense_id": "78cd15f7-a529-3ffb-afcf-51b1f08dd74b",
                                                "text": "In 2012, there were 28 living holders of the Victoria Cross or the George Cross."
                                            },
                                            {
                                                "example_id": "4c264312-07ab-45c4-8264-a46bf383a999",
                                                "sense_id": "78cd15f7-a529-3ffb-afcf-51b1f08dd74b",
                                                "text": "Davenant, the last holder of the laureateship, had died two years previously, and Howell, the well known author of the Epistolæ Ho-Elianæ, and the late holder of the historiographership, four years before."
                                            },
                                            {
                                                "example_id": "cf5d2cbc-4a2f-419c-875c-86ce76a52f7d",
                                                "sense_id": "78cd15f7-a529-3ffb-afcf-51b1f08dd74b",
                                                "text": "How many of these gafolgelders by contract were to be found on Saxon manors, whether on the lord’s demesne or holding virgates in the open fields, libere tenentes or free holders of villain holdings, as I have elsewhere stated we cannot tell, but if we may take the experience of the interval between the Domesday survey and the hundred rolls as any guide to the natural multiplication of libere tenentes on the lord’s demesne, the class may have become numerous on many, and perhaps mostly on royal manors, without giving ground, I think, for any inference in favour of the original freedom of the Saxon village community."
                                            },
                                            {
                                                "example_id": "8bbf6cf0-a764-4fa3-806d-3f6e746cf836",
                                                "sense_id": "78cd15f7-a529-3ffb-afcf-51b1f08dd74b",
                                                "text": "A request for a nonreviewable ruling must be submitted by an issuer or holder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40aa3b28-3f00-3405-b2f5-8d0ed3c9429a",
                                        "entry_id": "83237379-d041-316a-b60f-6344a5e3bad2",
                                        "glosses": [
                                            "One who is employed in the hold of a vessel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff29defb-d91d-380a-b887-61728a2dee63",
                                        "entry_id": "83237379-d041-316a-b60f-6344a5e3bad2",
                                        "glosses": [
                                            "The defending champion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
