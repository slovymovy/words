                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7186a930-2579-4e39-b9db-a77aa98044ba",
                                "sense_id": "ce83b025-cac5-3910-b562-bd4c2752338f",
                                "text": "„Bei diesen Worten erhob er sich und schritt, sich auf sein Weichselrohr stützend, auf einen in den Fels gehauenen Zickzackweg zu, der nach dem Aussichtstempelchen hinaufführte.“"
                            },
                            {
                                "example_id": "fbcf4a0a-5744-42b4-837a-afbbb93ed146",
                                "sense_id": "ce83b025-cac5-3910-b562-bd4c2752338f",
                                "text": "„Die Männer, denen wir auf den Fersen waren, schienen einen merkwürdigen Zickzackweg genommen zu haben, vermutlich mit dem Gedanken, Verfolger abzuschütteln und unbeobachtet zu entkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
