                        ],
                        "examples": [
                            {
                                "example_id": "06616744-30c9-45c5-8c7b-1d7e9498fecb",
                                "sense_id": "a1e87617-4453-3585-9485-b0fdd77b0744",
                                "text": "For a heady moment I wanted to fling the notebook down and say to them: you write about geniuses and ungeniuses if you like, but don't teach me how to do it, I won't be able to do it anyway. I'd be better acting instead of you."
                            },
                            {
