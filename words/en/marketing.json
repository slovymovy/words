                {
                    "sense_id": "ffb8197b-ad12-3e43-a463-21fd28bdc7ac",
                    "sense_definition": "The act of bringing goods, especially agricultural produce, to a market to sell them.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "selling_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>marketing</w> of fresh produce requires careful timing to ensure quality.",
                            "target_lang_translations": {
                                "ru": "<w>Сбыт</w> свежей продукции требует тщательного выбора времени для обеспечения качества.",
                                "zh": "生鲜农产品的<w>销售</w>需要精准把握时机以确保质量。"
                            }
                        },
                        {
                            "text": "Farmers often work together to improve the <w>marketing</w> of their crops.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто работают вместе, чтобы улучшить <w>сбыт</w> своего урожая.",
                                "zh": "农民们经常合作以改善他们农作物的<w>分销</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс доставки товаров, особенно сельскохозяйственной продукции, на рынок для продажи.",
                        "zh": "指将商品（特别是农产品）运送到市场进行销售的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
