            "senses": [
                {
                    "sense_id": "91836c4d-8d91-32fa-b35a-f897314addda",
                    "sense_definition": "To change from a liquid to a solid state, often due to cooling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "solidify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fat began to <w>congeal</w> on the surface of the soup as it cooled down."
                        },
                        {
                            "text": "If you leave the gravy out, it will <w>congeal</w> into a thick mass."
                        }
                    ],
                    "synonyms": [
                        "solidify",
                        "harden",
                        "freeze"
                    ],
                    "antonyms": [
                        "melt",
                        "liquefy"
                    ],
                    "common_phrases": [
                        "fat congeals"
                    ]
                },
                {
                    "sense_id": "8c8868f7-8f4e-3e17-a9d9-187883aadb51",
                    "sense_definition": "To coagulate or become semi-solid, like jelly or curdled liquid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "solidify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Blood will <w>congeal</w> quickly when exposed to the air after a cut."
                        },
                        {
                            "text": "The mixture started to <w>congeal</w> into a thick jelly after sitting for an hour."
                        }
                    ],
                    "synonyms": [
                        "coagulate",
                        "clot",
                        "thicken"
                    ],
                    "common_phrases": [
                        "blood congeals"
                    ]
                },
                {
                    "sense_id": "5d31e893-27f7-320e-8488-9a9e558af36c",
                    "sense_definition": "To become rigid, immobile, or fixed in form.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "solidify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must act before the opposition to our plans begins to <w>congeal</w>."
                        },
                        {
                            "text": "His ideas started to <w>congeal</w> into a firm strategy after weeks of discussion."
                        }
                    ],
                    "synonyms": [
