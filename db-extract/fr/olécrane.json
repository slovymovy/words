                "senses": [
                    {
                        "sense_id": "3727ba5a-73ce-3735-b954-43ae3477ea5e",
                        "entry_id": "38ad3dcb-f7bf-399c-8642-3cf9997976fc",
                        "glosses": [
                            "Apophyse de l’extrémité supérieure du cubitus, qui contribue à former le coude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acc71da3-2e5f-4be4-ba74-0ff2a876f7d7",
                                "sense_id": "3727ba5a-73ce-3735-b954-43ae3477ea5e",
                                "text": "Fracture de l’olécrane."
                            },
                            {
                                "example_id": "044c268c-5bfa-46d6-a69d-b557910126dc",
                                "sense_id": "3727ba5a-73ce-3735-b954-43ae3477ea5e",
                                "text": "Lors de l’extension répétée des avant-bras, l’olécrane vient buter dans la fosse olécranienne de l’humérus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e257cd4-45d4-4eb1-bbbf-a92f83b59934",
                        "source_entry_id": "38ad3dcb-f7bf-399c-8642-3cf9997976fc",
                        "source_sense_id": "3727ba5a-73ce-3735-b954-43ae3477ea5e",
                        "target_lang_word": "olecranon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "olecranon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "431f106b-be57-3c84-8917-768d8061ac72",
                                        "entry_id": "d6cb4ac5-07a6-3df3-abdc-1af31953f6d4",
                                        "glosses": [
                                            "The bony process at the top of the ulna forming the point of the elbow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5a59a6-caa4-46ca-9fd8-1d494e4a47be",
                                                "sense_id": "431f106b-be57-3c84-8917-768d8061ac72",
                                                "text": "Mr. Fletcher, of Liverpool, reported a case of bony union of both olecranons, verified by examination after death. The patient, a boy 16 years old, was admitted to the hospital May 19, 1850, having fractured both olecranons a short time before by falling over some timber."
                                            },
                                            {
                                                "example_id": "77e97f65-82b0-4f73-ae98-fc80fe69cc9f",
                                                "sense_id": "431f106b-be57-3c84-8917-768d8061ac72",
                                                "text": "Suspensory animals have extremely small olecrana, because of a minimal need for forearm extension, which is achieved by gravity."
                                            },
                                            {
                                                "example_id": "36673bed-94d5-430e-84b6-810e490ad496",
                                                "sense_id": "431f106b-be57-3c84-8917-768d8061ac72",
                                                "text": "The subcutaneous location of the olecranon makes it vulnerable to trauma.⁷ Isolated fractures of the olecranon comprise approximately 10% of fractures about the elbow,^(26,38) with an estimated incidence of 1.08 per 10,000 person-years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
