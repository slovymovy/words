                    {
                        "sense_id": "8c96dbc3-3331-3ed6-a44b-06c355826457",
                        "entry_id": "f7392d8c-9ede-3e02-a19d-9d58f987eb60",
                        "glosses": [
                            "A type of men's felt fedora; a stiff felt hat similar to a trilby."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "650084d1-559b-4cbb-82f0-71a580d034d2",
                                "sense_id": "8c96dbc3-3331-3ed6-a44b-06c355826457",
                                "text": "The man was about thirty-five, very handsome, extremely well-dressed, with striped trousers, a black Homburg and a Burberry raincoat."
                            },
                            {
                                "example_id": "b7a6f69f-ae59-4615-b104-d97d9a7a4350",
                                "sense_id": "8c96dbc3-3331-3ed6-a44b-06c355826457",
                                "text": "He was a tall lean man with a voice like a rasping crow. Impeccably dressed and hatted with a dark Homburg."
                            },
                            {
                                "example_id": "8d70b399-36a9-438a-b802-ae49d7359cdb",
                                "sense_id": "8c96dbc3-3331-3ed6-a44b-06c355826457",
                                "text": "Harold Gould as Kid Twist (with a great mustache) wore the best Homburg in recent memory, and Redford always kept his fedora atilt at just the right, rakish angle."
                            }
                        ]
                    }
                ],
                "translations": [],
