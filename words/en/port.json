                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took the team six months to <w>port</w> the application to the new platform.",
                            "target_lang_translations": {
