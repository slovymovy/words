            "senses": [
                {
                    "sense_id": "0439c061-c0b3-33c2-9ac4-4ab954951684",
                    "sense_definition": "gekenmerkt door een diepgevoelde, warme en oprechte emotie of verbondenheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotionele verbondenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hebben na 25 jaar huwelijk nog steeds een <w>innige</w> en liefdevolle relatie met elkaar.",
                            "target_lang_translations": {
                                "en": "After 25 years of marriage, they still have an <w>intimate</w> and loving relationship with each other."
                            }
                        },
                        {
                            "text": "De twee vrienden namen met een <w>innige</w> omhelzing afscheid op het vliegveld.",
                            "target_lang_translations": {
                                "en": "The two friends said goodbye at the airport with a <w>heartfelt</w> embrace."
                            }
                        }
                    ],
                    "synonyms": [
                        "hartelijk",
                        "intiem",
                        "warm",
                        "vurig"
                    ],
                    "antonyms": [
