                        "glosses": [
                            "Insecte lépidoptère de la famille des papilionidés, grand papillon diurne vivement coloré (jaune, noir, rouge et bleu), et pourvu d’une queue aux ailes postérieures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d262a0a-9fb7-4284-bc71-9fa1336e2d5f",
                                "sense_id": "da0433b3-1a16-327b-8076-d80c056b9063",
                                "text": "La chenille de l’ alexanor se nourrit d'ombellifères (apiacées)."
                            },
                            {
                                "example_id": "8695f5ed-fbe6-4e60-a515-7de45d5b0807",
                                "sense_id": "da0433b3-1a16-327b-8076-d80c056b9063",
                                "text": "Et nous voyons défiler devant nos yeux et parmi les plus connus, chez les diurnes ; le machaon ou grand porte queue, dont les ailes inférieures se terminent ainsi que chez l’alexanor et le podalirius par des queues fort gracieuses de ligne, et pouvant former un très joli motif de décoration pour broche ou peigne."
                            }
                        ]
                    }
