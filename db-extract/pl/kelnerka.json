                        ]
                    },
                    {
                        "translation_id": "7931392c-3454-4bad-a124-b39a3752db55",
                        "source_entry_id": "3a1cfb62-055f-33a9-bcfe-22cddc364bdf",
                        "source_sense_id": "9445e258-b5c0-3aca-83fe-b715c14c7717",
                        "target_lang_word": "Kellnerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kellnerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21e176d4-3fab-3b25-a313-b046855e53f8",
                                        "entry_id": "b12a078b-3477-3c3f-8dd3-716151ef12c7",
                                        "glosses": [
                                            "Angestellte in der Gastronomie, deren Aufgabe die Bedienung der Gäste ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a715a1ee-a5d8-41f9-ad3d-4bb37ac1e499",
                                                "sense_id": "21e176d4-3fab-3b25-a313-b046855e53f8",
                                                "text": "„Eine junge Kellnerin erzählte beispielsweise, wie sie kurz nach der Maueröffnung von einem Filmteam interviewt wurde.“"
                                            },
                                            {
                                                "example_id": "1111c9f0-8a11-40e3-8488-626aaaeb7d28",
                                                "sense_id": "21e176d4-3fab-3b25-a313-b046855e53f8",
                                                "text": "„Nach dem sehr guten Essen, für das wir komischerweise sehr viel mehr Zeit brauchten als sonst für das Essen, fragte uns die Kellnerin noch, ob wir ein Dessert wünschten.“"
                                            },
                                            {
                                                "example_id": "75d6b0d1-7026-426b-8a1c-fc112af27120",
                                                "sense_id": "21e176d4-3fab-3b25-a313-b046855e53f8",
                                                "text": "„Als wir fertig waren, brachte die Kellnerin vier kleine Gäser und deutete auf die Bar.“"
                                            },
                                            {
                                                "example_id": "0449b461-58b3-4727-8220-f193a281f0f5",
                                                "sense_id": "21e176d4-3fab-3b25-a313-b046855e53f8",
                                                "text": "„Es ändert nichts daran, daß ihr Blick dem der Kellnerin für kurze Zeit begegnet ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03af9448-f2e4-4d6a-9075-4bc61962847c",
                        "source_entry_id": "3a1cfb62-055f-33a9-bcfe-22cddc364bdf",
                        "source_sense_id": "9445e258-b5c0-3aca-83fe-b715c14c7717",
                        "target_lang_word": "официантка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "официантка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "78a1eda7-bf91-3043-b4f0-4db8a1be0f34",
                                        "entry_id": "f3353c40-688f-3337-8dfb-bafbb7805700",
                                        "glosses": [
                                            "женск. к официант"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebd40d29-01f6-42ee-92cf-a5936997e0e9",
                                                "sense_id": "78a1eda7-bf91-3043-b4f0-4db8a1be0f34",
                                                "text": "Но уйти было невозможно, потому что подошла официантка с заказом."
                                            },
                                            {
                                                "example_id": "86026f58-7910-499a-ba4c-b6f21b1553fa",
                                                "sense_id": "78a1eda7-bf91-3043-b4f0-4db8a1be0f34",
                                                "text": "Хочет без конца задавать мне вопрос: «Как то, о чём я просил?»… Официантка приняла заказ. Мы закурили, и я поинтересовался..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
