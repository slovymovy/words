                        "sense_id": "d605cf3f-4bee-37e0-a994-ba288d5ce61f",
                        "entry_id": "ea7f0373-d1e0-3900-b978-bbad5addb7b6",
                        "glosses": [
                            "Playful; frolicsome."
                        ],
                        "tags": [
                            "dated",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "904e5dfa-e170-4b41-b933-6c79078f3f91",
                                "sense_id": "d605cf3f-4bee-37e0-a994-ba288d5ce61f",
                                "text": "I have heard his brother Edm and M'r Wayte his schoole fellow &c, say that when he was a Boy he was playsome enough: but withall he had even then a contemplative Melancholinesse."
                            },
                            {
                                "example_id": "1fdba29d-c001-4f8f-81d6-a85e12083141",
                                "sense_id": "d605cf3f-4bee-37e0-a994-ba288d5ce61f",
                                "text": "Sweet Frankie lives in Elfindale;\nWhere all the flowers are fair, and frail\n(Like her fair self,) a slender fairy,\nAnd like a zephyr, playsome, airy,\nBut lovelier far, than buxom Mary."
                            },
                            {
                                "example_id": "81a6dfd6-a1c2-41a2-9ea4-e969d04ed0f5",
                                "sense_id": "d605cf3f-4bee-37e0-a994-ba288d5ce61f",
                                "text": "An' down below's the cloty brook\nWhere I did vish with line an' hook,\nAn' beat, in playsome dips and zwims,\nThe foamy stream, wi' white-skinned lim's."
                            }
                        ]
                    }
