                            {
                                "example_id": "3275e8bb-95aa-4172-94f9-d59aa9f73c0e",
                                "sense_id": "c79a2d37-4d3a-3d0f-a88b-a83da6cc10ea",
                                "text": "We may put the Exposition it self to the same Test, and judge by that, whether the Anonymus had reason to upbraid the Author of this Exposition with those rambling and general Terms in which (says he) he entanglingly wraps up the most difficult matters."
                            },
