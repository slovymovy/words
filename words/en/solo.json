                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The saxophonist will <w>solo</w> during the bridge of the song.",
                            "target_lang_translations": {
                                "ru": "Саксофонист будет <w>солировать</w> во время бриджа песни.",
                                "zh": "萨克斯手将在歌曲的过渡段进行<w>独奏</w>。"
                            }
                        },
                        {
                            "text": "He <w>soloed</w> beautifully over the jazz progression.",
                            "target_lang_translations": {
                                "ru": "Он прекрасно <w>солировал</w> под джазовую гармонию.",
                                "zh": "他在爵士乐的和弦进行上<w>独奏</w>得非常美妙。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять сольную партию.",
                        "zh": "进行独奏表演。"
                    },
                    "translations": {
