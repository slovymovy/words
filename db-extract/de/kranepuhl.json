                ],
                "senses": [
                    {
                        "sense_id": "3ee2905a-8f53-365e-b050-2737d8dd1aa6",
                        "entry_id": "30f8a712-3792-3d8e-9e73-2ed120291c27",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "771bfe7f-3d24-48e9-8660-eba3df3797c2",
                                "sense_id": "3ee2905a-8f53-365e-b050-2737d8dd1aa6",
                                "text": "Frau Kranepuhl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f4a901d4-5b0a-4652-88d6-af914744dc7c",
                                "sense_id": "3ee2905a-8f53-365e-b050-2737d8dd1aa6",
                                "text": "Herr Kranepuhl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "019308dc-f684-47d4-9640-8f99abc2d7d9",
                                "sense_id": "3ee2905a-8f53-365e-b050-2737d8dd1aa6",
                                "text": "Die Kranepuhls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4a1f82ca-7fe4-4635-86a6-7cb4465a98ec",
                                "sense_id": "3ee2905a-8f53-365e-b050-2737d8dd1aa6",
                                "text": "Der Kranepuhl trägt nie die Schals, die die Kranepuhl ihm strickt."
                            },
                            {
                                "example_id": "999f7c2e-996c-4b2f-8f55-f9b629577f70",
                                "sense_id": "3ee2905a-8f53-365e-b050-2737d8dd1aa6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kranepuhl kommt, geht der Herr Kranepuhl.“"
                            },
                            {
                                "example_id": "42bd9532-6ac0-4c8e-a213-8fffb70ea7a2",
                                "sense_id": "3ee2905a-8f53-365e-b050-2737d8dd1aa6",
                                "text": "Kranepuhl kommt und geht."
                            },
                            {
                                "example_id": "7185eaa4-a945-4ce7-9db9-c214acad669f",
                                "sense_id": "3ee2905a-8f53-365e-b050-2737d8dd1aa6",
                                "text": "Kranepuhls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
