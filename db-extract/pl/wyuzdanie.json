                                "target_senses": [
                                    {
                                        "sense_id": "fb348175-4a9e-3843-8ac5-9e80a0d7dc8f",
                                        "entry_id": "d3c4e4f1-86c8-38e6-9136-7d33ebf8b2f0",
                                        "glosses": [
                                            "The property of being licentious."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f20d710-f6f1-4f4a-bd21-1d87bb4ee89d",
                                                "sense_id": "fb348175-4a9e-3843-8ac5-9e80a0d7dc8f",
                                                "text": "... and well considered, me thinks this is one of the most censurable parts of this licentiousnesse, in regard it laboureth to taint the whole body of conversation, as it corrupteth the nature of words, which are the Publique Faith, whereupon all innocent discourse must needs trust it selfe, so that this perversion seemeth a publick impediment to the commerce of all vertuous communication ..."
                                            },
                                            {
                                                "example_id": "adafb97d-bfbc-4344-86db-b1eac6b9ab81",
                                                "sense_id": "fb348175-4a9e-3843-8ac5-9e80a0d7dc8f",
                                                "text": "Early mentality, in initiating phallic worship, was never in any way guilty of licentiousness or obscenity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d8d2ff6-9e3c-4285-a11b-1d07dceab06f",
                        "source_entry_id": "33cad3d9-4be9-36ac-9b65-efeee22bfb21",
                        "source_sense_id": "f9631511-8ea1-358f-9f42-1813a8e74821",
                        "target_lang_word": "Hemmungslosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hemmungslosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3bb6f36-19ab-3bd7-bf1f-7cc6484758fd",
                                        "entry_id": "44f4e497-0e71-3cfe-b1f3-762a8cf79be1",
                                        "glosses": [
                                            "Haltung/Verhalten, die von keinen moralischen, rechtlichen oder sonstigen, allgemein akzeptierten Prinzipien kontrolliert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f38cc82-8fe5-4b74-9299-96940a83a0dc",
                                                "sense_id": "b3bb6f36-19ab-3bd7-bf1f-7cc6484758fd",
                                                "text": "„Dann schleicht sich Bewunderung ein für diese Hemmungslosigkeit.“"
                                            },
                                            {
                                                "example_id": "9cad8780-89e1-47ed-8efc-3a94f05c0a7d",
                                                "sense_id": "b3bb6f36-19ab-3bd7-bf1f-7cc6484758fd",
                                                "text": "„Die Neurose Rétifs, bestehend in der Hemmungslosigkeit eines Durchgängers, brachte keine Verwicklungen, weil er keine Anlage um Bösewicht hatte, wie er selber weiß.“"
                                            },
                                            {
                                                "example_id": "c63bc6ee-c642-43e1-9669-02c549fa47c1",
                                                "sense_id": "b3bb6f36-19ab-3bd7-bf1f-7cc6484758fd",
                                                "text": "„Dem war keineswegs so, da in derselben Zeit führende Politiker sich dem kapitalistischen Wirtschaften mit der größten Hemmungslosigkeit hingaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b0428fb-b330-41c2-89f2-c5536d2bad6d",
                        "source_entry_id": "33cad3d9-4be9-36ac-9b65-efeee22bfb21",
                        "source_sense_id": "f9631511-8ea1-358f-9f42-1813a8e74821",
                        "target_lang_word": "Zügellosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zügellosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e423a6c-c22b-32a0-8d62-2111249a1ccf",
                                        "entry_id": "4a8b30d5-605e-3341-9c28-ec440b2810ff",
                                        "glosses": [
                                            "Haltung/Verhalten, die von keinen moralischen, rechtlichen oder sonstigen, allgemein akzeptierten Prinzipien kontrolliert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f89e9d3e-02fa-4593-805c-700c8ee6f9d4",
                                                "sense_id": "9e423a6c-c22b-32a0-8d62-2111249a1ccf",
                                                "text": "„Jedes Mal, wenn so eine Druckwelle der Sittlichkeit stoßweise das Land erschütterte, ging es auch der Rockmusik an den Kragen, die sich ohnehin von Natur aus verdächtig machte, Unmoral, Zügellosigkeit und Sittenverfall Vorschub zu leisten.“"
                                            },
                                            {
                                                "example_id": "919b4ddf-4748-4fce-a236-2294888f9c03",
                                                "sense_id": "9e423a6c-c22b-32a0-8d62-2111249a1ccf",
                                                "text": "„Auch grundsätzliche Zügellosigkeit entspricht nicht ihrem Naturell.“"
                                            },
                                            {
                                                "example_id": "5f27e90e-58c6-480e-a7eb-dbc810e23234",
                                                "sense_id": "9e423a6c-c22b-32a0-8d62-2111249a1ccf",
                                                "text": "„Trotz dieser Verbote, ja gerade wegen dieser Verbote, herrscht in Madrid eine jedes Maß überschreitende Zügellosigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a4ae1b4-f98a-465b-9c1b-a450cb204593",
                        "source_entry_id": "33cad3d9-4be9-36ac-9b65-efeee22bfb21",
                        "source_sense_id": "f9631511-8ea1-358f-9f42-1813a8e74821",
                        "target_lang_word": "Ausschweifung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausschweifung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18d5f793-2558-3a8c-906a-876a950b94e2",
                                        "entry_id": "d698cb98-585a-369d-93b4-d7c4e65573b0",
                                        "glosses": [
                                            "Maßlosigkeit in sexueller Hinsicht oder sonstigen Genüssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fa114c5-6ade-4902-bd5e-7045d02c32ce",
                                                "sense_id": "18d5f793-2558-3a8c-906a-876a950b94e2",
                                                "text": "„Berichte über Ausschweifungen in der Heimat, während Ehemänner und Väter an der Front weilten, waren über fast jeden größeren Ort in Deutschland im Umlauf.“"
                                            },
                                            {
                                                "example_id": "f62e3bf0-83e8-4d13-a42a-f5db6b9b373c",
                                                "sense_id": "18d5f793-2558-3a8c-906a-876a950b94e2",
                                                "text": "„Napoleon setzte den Ausschweifungen der Bourbonen ein Ende, als er 1799 den neapolitanischen Teil des Königreichs eroberte.“"
                                            },
                                            {
                                                "example_id": "71cdf678-d0ce-4fce-9a41-4591e8345f77",
                                                "sense_id": "18d5f793-2558-3a8c-906a-876a950b94e2",
                                                "text": "„Die Ausschweifungen hatten mich ausgelaugt, und ich wollte zu einer Reise aufbrechen, die lang dauerte, damit ich nicht so bald auf denselben Weg der Torheit und des Lasters zurückfallen würde.“"
                                            },
                                            {
                                                "example_id": "77ad6fe6-d20b-426f-9685-a2860fd0d9c9",
                                                "sense_id": "18d5f793-2558-3a8c-906a-876a950b94e2",
                                                "text": "„Es ist unmöglich, die Ausschweifungen, die ich sah, im einzelnen zu beschreiben; ein großer Libertin kann sie sich immerhin vorstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
