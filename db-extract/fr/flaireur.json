                ],
                "senses": [
                    {
                        "sense_id": "64418500-649d-318e-9660-8af2f95fcd51",
                        "entry_id": "f45f127e-cc14-3490-ae5a-b65496c220ab",
                        "glosses": [
                            "Celui qui flaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33f6f66c-474a-4abf-a603-8fcc804f2bb3",
                                "sense_id": "64418500-649d-318e-9660-8af2f95fcd51",
                                "text": "Un flaireur de cuisine, un parasite."
                            },
                            {
                                "example_id": "c49161c0-22eb-4c97-ac31-b826b860c5f0",
                                "sense_id": "64418500-649d-318e-9660-8af2f95fcd51",
                                "text": "Et l’abstention de Cardailhac, ce flaireur de succès, donnait bien à Jansoulet la mesure de sa disgrâce."
                            },
                            {
                                "example_id": "2f166283-5fd6-433b-afd4-5ca80d72f779",
                                "sense_id": "64418500-649d-318e-9660-8af2f95fcd51",
                                "text": "Docile, mais sans hâte, j’allais en faire autant, quand de la ville haute un bruit joyeux de voix, des sonneries de cors, et le gai carillon de la tour Saint-Martin me firent, vieux flaireur, renifler l’air, en quête d’un spectacle nouveau."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
