                "senses": [
                    {
                        "sense_id": "1c0302d1-fa75-369e-ac9a-4a617c41ff65",
                        "entry_id": "4d6490f7-2494-3028-a37f-c02470673430",
                        "glosses": [
                            "weibliche Person, die in einem Betrieb ausgebildet wird, weiblicher Lehrling"
                        ],
                        "tags": [
                            "colloquial",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "5c0a0ccd-493f-467a-8ee5-6a74bb4b3438",
                                "sense_id": "1c0302d1-fa75-369e-ac9a-4a617c41ff65",
                                "text": "„Lisa und Sonja waren noch nicht da, und Yvette, die obercoole Azubiene[,] hatte an diesem Tag Berufsschule.“"
                            },
                            {
                                "example_id": "a39eb919-e74d-45e8-b8f3-8bc99f20aeaa",
                                "sense_id": "1c0302d1-fa75-369e-ac9a-4a617c41ff65",
                                "text": "„Am Ende der Geschichte wird verraten: unsere hippe Azubiene ist Fan der Kunsthalle.“"
                            },
                            {
                                "example_id": "ffc83d0f-9175-4cc7-9618-15da45351bff",
                                "sense_id": "1c0302d1-fa75-369e-ac9a-4a617c41ff65",
                                "text": "„Wurden die Päckchen nicht innerhalb des Tages verkauft, nahm die Azubiene Manuela die Päckchen aus der Verkaufstheke entpackte die Wurst oder Schinkenpäkchen [sic!] vorsichtig und dann konnte das Verfahrensspiel wieder von vorn beginnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
