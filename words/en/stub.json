                {
                    "sense_id": "6e6e1702-b3e8-335d-8ed1-1bfb79c76fe2",
                    "sense_definition": "A length of transmission line or waveguide that is connected at one end only.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An open-circuited <w>stub</w> can be used to match impedance in high-frequency circuits.",
                            "target_lang_translations": {
                                "ru": "Разомкнутый <w>шлейф</w> может использоваться для согласования импеданса в высокочастотных цепях.",
                                "zh": "开路<w>短截线</w>可用于高频电路中的阻抗匹配。"
                            }
