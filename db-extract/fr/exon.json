                                "example_id": "73175541-ec26-4441-97cd-e7961bc973ca",
                                "sense_id": "b95ce5a0-a83a-3ec4-9b91-bb7bb04b6513",
                                "text": "Beaucoup de gènes semblent présenter, à côté de séquences actives qualifiées d’exons, des séquences muettes : les introns."
                            }
                        ]
                    },
                    {
                        "sense_id": "9576433e-243c-3781-9ab4-0e78d1cd8c5e",
                        "entry_id": "0f561647-d58d-3797-9494-76d8dbbc3ae1",
                        "glosses": [
                            "Partie de l’ADN correspondant à ce segment."
