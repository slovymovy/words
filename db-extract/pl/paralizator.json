                                        "sense_id": "f1c36524-ec9c-3048-9771-d0b994a7d645",
                                        "entry_id": "a7003083-eb22-387b-a058-001e8784e6c5",
                                        "glosses": [
                                            "A weapon intended to immobilize, usually through delivery of an electric shock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25a6071c-1bc8-478c-a9d2-cb3ba1e5a106",
                                                "sense_id": "f1c36524-ec9c-3048-9771-d0b994a7d645",
                                                "text": "Lodner tossed the stun gun on a flange between the stills and the fluxing panels."
                                            },
                                            {
                                                "example_id": "acadd953-35d2-42fd-97bf-1ae5b9d349d0",
                                                "sense_id": "f1c36524-ec9c-3048-9771-d0b994a7d645",
                                                "text": "The removable pages are organized in strict military fashion and include complete data on the Commlock, Stun Gun, Laser Cannon, Communications Post, Uniforms, and several fold-out blueprints of the various levels and areas of Moonbase Alpha."
                                            },
                                            {
                                                "example_id": "a43b7a82-b7c5-43a5-a37b-3b4b2bb78c59",
                                                "sense_id": "f1c36524-ec9c-3048-9771-d0b994a7d645",
                                                "text": "A stun gun disguised as a mobile phone has been seized from a 14-year-old boy in Manchester."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
