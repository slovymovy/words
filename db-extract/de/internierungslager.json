                        ],
                        "form": "die Internierungslager"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "92fe984f-baf7-3011-8ff0-b944b9b07ed1",
                        "entry_id": "8ba03663-5c46-36a0-a1fa-4198c1a494df",
                        "glosses": [
                            "Lager, in das Gefangene des Militärs interniert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63c7a429-893e-4c92-ad62-f7b766804433",
                                "sense_id": "92fe984f-baf7-3011-8ff0-b944b9b07ed1",
                                "text": "Viele Nazis wurden nach dem zweiten Weltkrieg in Internierungslagern gefangen gehalten."
                            },
                            {
                                "example_id": "a2e91624-9358-41c2-9c14-2905d75db47f",
                                "sense_id": "92fe984f-baf7-3011-8ff0-b944b9b07ed1",
                                "text": "„Penibel ausgearbeitete Pläne für Internierungslager und Listen mit Namen der zur Internierung vorgesehenen Systemkritiker lagen tatsächlich längst vor.“"
                            },
                            {
                                "example_id": "1a80d384-6fa8-40c2-8aa4-5d30444acb33",
                                "sense_id": "92fe984f-baf7-3011-8ff0-b944b9b07ed1",
                                "text": "„Seit seiner Rückkehr aus dem Internierungslager war mein Vater kein einziges Mal auf Bleekenwarf gewesen, hatte mit dem Maler weder Wort noch Gruß gewechselt, er hatte sich nicht einmal erkundigt, ob auf Bleekenwarf noch alles so war, wie er es kannte.“"
                            },
                            {
                                "example_id": "0907769e-e94d-441f-bf73-ffacdbe51272",
                                "sense_id": "92fe984f-baf7-3011-8ff0-b944b9b07ed1",
                                "text": "„Endlich sicher in Dänemark gelandet, wurde die Familie wie viele andere deutsche Flüchtlinge in Dänemark nach Kriegsende in ein Internierungslager eingesperrt.“"
                            },
                            {
                                "example_id": "d9083acc-a907-4e93-893f-5f72212ba870",
                                "sense_id": "92fe984f-baf7-3011-8ff0-b944b9b07ed1",
                                "text": "„Sie kamen zunächst zum verschärften Verhör ins britische Internierungslager Bad Nenndorf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2880bc9-9033-47a5-86c9-e193400f0820",
                        "source_entry_id": "8ba03663-5c46-36a0-a1fa-4198c1a494df",
                        "source_sense_id": "92fe984f-baf7-3011-8ff0-b944b9b07ed1",
                        "source_sense_description": "Lager, in das Gefangene des Militärs interniert werden",
                        "target_lang_word": "internment camp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "internment camp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34461d60-9e7b-3b8f-8544-a23caf5ac8a0",
                                        "entry_id": "fb2ad151-b1fb-3b57-a747-db585b92dd6c",
                                        "glosses": [
                                            "a concentration camp, especially a non-Nazi one from before or during WWII; a detention center; a relocation camp."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a5f4111-0bbe-45d3-8f31-3ab653df6482",
                                                "sense_id": "34461d60-9e7b-3b8f-8544-a23caf5ac8a0",
                                                "text": "Historical references describe the camps as internment camps, although others favor the name relocation camps. Others, more critical of this action, refer to them as detention camps or concentration camps."
                                            },
                                            {
                                                "example_id": "d26c7f93-6fd8-4039-bc1b-c765ade763a7",
                                                "sense_id": "34461d60-9e7b-3b8f-8544-a23caf5ac8a0",
                                                "text": "People assigned to the factories appear to be subject to a less stringent regime than those in the main internment camps, as they are allowed to receive monitored monthly visits and short calls from family members."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "375beb4e-5a1b-4cb4-baa0-f0465a293efd",
                        "source_entry_id": "8ba03663-5c46-36a0-a1fa-4198c1a494df",
                        "source_sense_id": "92fe984f-baf7-3011-8ff0-b944b9b07ed1",
