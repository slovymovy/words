                ],
                "senses": [
                    {
                        "sense_id": "2bb8474c-0e11-3633-8cf0-f203831ee911",
                        "entry_id": "f71ba053-b0b3-3548-b44e-d008da40bcf2",
                        "glosses": [
                            "One who suffers from claustrophobia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9e6ca95-efd0-4827-8d6e-95576b61f7c6",
                                "sense_id": "2bb8474c-0e11-3633-8cf0-f203831ee911",
                                "text": "She has never considered herself either a claustrophobe or an agoraphobe but, well, this was different. This was both fears together – the fear of wide-open spaces jammed shoulder to shoulder with angry people."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61720c37-57b2-4c5c-8647-29107117bbce",
                        "source_entry_id": "f71ba053-b0b3-3548-b44e-d008da40bcf2",
                        "source_sense_id": "2bb8474c-0e11-3633-8cf0-f203831ee911",
                        "source_sense_description": "one who suffers from claustrophobia",
                        "target_lang_word": "claustrophobe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "claustrophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6c84518-3137-3068-962e-0aea7cb960ea",
                                        "entry_id": "1002bc17-cb5d-3daa-9ca5-3f5772930ed8",
                                        "glosses": [
                                            "Personne atteinte de claustrophobie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b81678c-56c2-4f77-8b18-acbf0a5fd1ba",
                                                "sense_id": "f6c84518-3137-3068-962e-0aea7cb960ea",
                                                "text": "On a constaté que lorsqu’on emprisonne un claustrophobe (quelqu’un qui ne supporte pas d’être enfermé dans un espace exigu), il souffre très fort durant les premiers jours, mais qu’ensuite il s’adapte et est alors définitivement guéri."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "claustrophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe4178b3-2803-355b-bed2-f3bdbbe1dae8",
                                        "entry_id": "d980f7dd-1941-3e75-adf7-3738d0c4a385",
                                        "glosses": [
                                            "Atteint de claustrophobie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b7eb050-97c4-401b-9e5a-3b010341ae9e",
                                                "sense_id": "fe4178b3-2803-355b-bed2-f3bdbbe1dae8",
                                                "text": "Par contre, soyez gentils et ouvrez vite la boîte, ôtez le couvercle, car j’ai peur de souffrir d’angoisse claustrophobe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
