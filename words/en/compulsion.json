{
    "word_family": [
        "compel",
        "compulsive",
        "compulsory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b6d4d5fa-e7b2-3e50-bd10-4757b6e85c8b",
                    "sense_definition": "An irrational need or irresistible urge to perform an action despite negative consequences.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "urge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a sudden <w>compulsion</w> to check his phone every few minutes during the meeting.",
                            "target_lang_translations": {
                                "zh": "开会时，他感到一种突如其来的<w>冲动</w>，每隔几分钟就想看一眼手机。"
                            }
                        },
                        {
                            "text": "The patient struggled to control the <w>compulsion</w> to wash his hands repeatedly throughout the day.",
                            "target_lang_translations": {
                                "zh": "病人努力克制自己一天内反复洗手的<w>强迫行为</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "urge",
                        "impulse",
                        "craving"
                    ],
                    "common_phrases": [
                        "sudden compulsion",
                        "irresistible compulsion"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种无法抗拒的冲动或非理性的心理需求，即使明知会有负面后果也要去做某事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冲动",
                                "target_lang_sense_clarification": "指心理上难以抑制的欲望或行动倾向。"
                            },
                            {
                                "target_lang_word": "强迫行为",
                                "target_lang_sense_clarification": "指心理学中反复出现的、非理性的行为模式。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fe95c50-018c-346a-a96f-42e25a5b1681",
                    "sense_definition": "The use of authority or force to make someone act against their will.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agreement was signed under <w>compulsion</w> rather than through genuine negotiation between the parties.",
                            "target_lang_translations": {
                                "zh": "这份协议是在<w>胁迫</w>下签署的，而非双方真诚协商的结果。"
                            }
                        },
                        {
                            "text": "Citizens should follow the law out of respect, not because of the <w>compulsion</w> of the state.",
                            "target_lang_translations": {
                                "zh": "公民遵守法律应出于尊重，而非因为国家的<w>强制</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coercion",
                        "force",
                        "duress"
                    ],
                    "antonyms": [
                        "volition",
                        "choice"
                    ],
                    "common_phrases": [
                        "under compulsion"
                    ],
                    "target_lang_definitions": {
                        "zh": "利用权威或武力强迫某人违背其意愿行事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "强迫",
                                "target_lang_sense_clarification": "指施加压力使人违背意愿。"
                            },
                            {
                                "target_lang_word": "胁迫",
                                "target_lang_sense_clarification": "指通过威胁或武力手段强迫他人。"
                            },
                            {
                                "target_lang_word": "强制",
                                "target_lang_sense_clarification": "指以国家或制度的力量迫使服从。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f70b60cc-d825-3d9f-abf8-fd885aadaf89",
                    "sense_definition": "The legal or official use of force by an administration or government.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The state maintains the right to use <w>compulsion</w> to ensure public safety during emergencies.",
                            "target_lang_translations": {
                                "zh": "国家保留在紧急情况下使用<w>强制力</w>以确保公共安全的权利。"
                            }
                        },
                        {
                            "text": "The police are granted the power of <w>compulsion</w> to enforce court orders when necessary.",
                            "target_lang_translations": {
                                "zh": "警方被授予在必要时执行法院命令的<w>强制执行</w>权。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enforcement"
                    ],
                    "target_lang_definitions": {
                        "zh": "政府或行政机构在法律框架内行使的强制力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "强制力",
                                "target_lang_sense_clarification": "指国家机关依法行使的强制手段。"
                            },
                            {
                                "target_lang_word": "强制执行",
                                "target_lang_sense_clarification": "指通过法律手段确保命令得到落实。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}