                        "target_lang_word": "tiriton",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "502d0f59-6f2d-4d62-8d60-d97cecd262fe",
                        "source_entry_id": "2ad4fe7c-102e-3c0d-a77c-26f1edb4b1f2",
                        "source_sense_description": "a shiver",
                        "target_lang_word": "Schauder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schauder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f77e5083-d70b-3386-b09f-a04f65e76b43",
                                        "entry_id": "7e234672-d00b-30bf-acf2-715286c53372",
                                        "glosses": [
                                            "plötzliches Gespür von Kälte"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0513a2be-b222-3f6e-aab4-6eca16030136",
                                        "entry_id": "7e234672-d00b-30bf-acf2-715286c53372",
                                        "glosses": [
                                            "plötzliches Gefühl des Abscheus, der Angst, des Entsetzens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa0c595-1613-4966-ba95-4ae1c61cada3",
                                                "sense_id": "0513a2be-b222-3f6e-aab4-6eca16030136",
                                                "text": "„Ein Schauder kroch mir über die Kopfhaut.“"
                                            },
                                            {
                                                "example_id": "4aa205c2-dad4-48c9-8061-9254718c4c2e",
                                                "sense_id": "0513a2be-b222-3f6e-aab4-6eca16030136",
                                                "text": "„Kaum noch verhüllt mischt sich da in den Schauder ein Stolz aufs Geleistete ein.“"
                                            },
                                            {
                                                "example_id": "9fca4241-b7d7-4782-aace-8b119e602c07",
                                                "sense_id": "0513a2be-b222-3f6e-aab4-6eca16030136",
                                                "text": "„In diesem Augenblick empfanden alle Anwesenden etwas wie einen Schauder.“"
                                            },
                                            {
                                                "example_id": "6dce8c44-3b12-4981-9d1a-930f98733106",
                                                "sense_id": "0513a2be-b222-3f6e-aab4-6eca16030136",
                                                "text": "„Die anderen Gäste betrachteten sie mit Schauder und Abscheu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "caac1cb8-6457-4f96-84ca-fed103145463",
                        "source_entry_id": "2ad4fe7c-102e-3c0d-a77c-26f1edb4b1f2",
                        "source_sense_description": "a shiver",
                        "target_lang_word": "Schauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6458621c-f302-3bb3-a382-dca2c6b90743",
                                        "entry_id": "801aeca2-6265-352b-94d9-853294535a35",
                                        "glosses": [
                                            "Regenschauer: kurzer, heftiger Niederschlag analog: Schneeschauer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a20ffbab-edd6-4c63-a87e-2cf7c311c2cb",
                                                "sense_id": "6458621c-f302-3bb3-a382-dca2c6b90743",
                                                "text": "Es wird mit Schauern gerechnet."
                                            },
                                            {
                                                "example_id": "0be08762-caf3-44d1-98fc-389870fbe58c",
                                                "sense_id": "6458621c-f302-3bb3-a382-dca2c6b90743",
                                                "text": "„Als uns plötzlich ein Schauer überrascht, entfaltet sich ein Dach aus Regenschirmen über den Köpfen.“"
                                            },
                                            {
                                                "example_id": "1ce2e713-9b39-4169-84d6-e0b4517abc22",
                                                "sense_id": "6458621c-f302-3bb3-a382-dca2c6b90743",
                                                "text": "„Das hatte ich grad noch am Nachmittag gedacht, als mich ein Schauer überraschte.“"
                                            },
                                            {
                                                "example_id": "df8107b4-fc11-4db0-b75c-0286586eda28",
                                                "sense_id": "6458621c-f302-3bb3-a382-dca2c6b90743",
                                                "text": "„Der wilde Westwind, der in voriger Nacht getobt, ballte, ehe der Morgen hereinbrach, mit letzter, verzweifelter Kraftanstrengung noch einen Arm voll dunkler, gewitterschwangerer Wolken zusammen, die er in fliegenden Schauern über die Erde ausschüttete.“"
                                            },
                                            {
                                                "example_id": "2bf6d87f-e0f8-4fa7-8fc3-f7a6f5018d52",
                                                "sense_id": "6458621c-f302-3bb3-a382-dca2c6b90743",
                                                "text": "„Es waren vorbeiziehende Schauer, die einen länger, die anderen kürzer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9690f391-70b4-3b6c-b1e5-512d2f8a7b15",
                                        "entry_id": "801aeca2-6265-352b-94d9-853294535a35",
                                        "glosses": [
                                            "Angstschauer: körperliche Reaktion (zum Beispiel Hautzucken) infolge starker Angstgefühle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b482dfe-a5d1-4ece-8f4b-8d098824e091",
                                                "sense_id": "9690f391-70b4-3b6c-b1e5-512d2f8a7b15",
                                                "text": "Kalte Schauer laufen mir über den Rücken."
                                            },
                                            {
                                                "example_id": "d10c3f1a-7af7-43c0-9457-6c000721830e",
                                                "sense_id": "9690f391-70b4-3b6c-b1e5-512d2f8a7b15",
                                                "text": "„Ein kalter Schauer überläuft mich.“"
                                            },
                                            {
                                                "example_id": "89d0a66b-1291-40b4-9d21-22b411a02211",
                                                "sense_id": "9690f391-70b4-3b6c-b1e5-512d2f8a7b15",
                                                "text": "„Elma lief ein Schauer über den Rücken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70b6afa2-c597-3df9-b8d6-85948882eb35",
                                        "entry_id": "2df40596-859b-3042-afcd-10df88de8f8e",
                                        "glosses": [
                                            "offener Schuppen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
