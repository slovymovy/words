                "forms": [
                    {
                        "form_id": "f8116469-f5eb-4eb5-ad8f-45e58247ae38",
                        "entry_id": "675f01cd-0db4-336d-a060-9bb61327804b",
                        "tags": [
                            "plural"
                        ],
                        "form": "échangeurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c3db31a-a953-34e7-ae3c-e8529cfcdb55",
                        "entry_id": "675f01cd-0db4-336d-a060-9bb61327804b",
                        "glosses": [
                            "Ensemble de bretelles d’autoroute permettant de raccorder plusieurs autoroutes ou routes entre elles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afa209be-8f32-4ccc-a196-92d3c5779302",
                                "sense_id": "9c3db31a-a953-34e7-ae3c-e8529cfcdb55",
                                "text": "Après l’échangeur du Ring de Charleroi-Ouest et le pont inférieur 28, on aborde l'entité de Chapelle-lez-Herlaimont qui commence bien : par une réserve naturelle située sur les bords du Piéton, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "169c8998-4397-3fd4-9158-917b0a205edf",
                        "entry_id": "675f01cd-0db4-336d-a060-9bb61327804b",
                        "glosses": [
                            "Dispositif destiné à effectuer un transfert, souvent de chaleur, entre deux milieux sans que ces milieux soient en contact direct."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f09fcbb-6abd-4157-aefe-b7163c47af66",
                                "sense_id": "169c8998-4397-3fd4-9158-917b0a205edf",
                                "text": "En conclusion, seuls les échangeurs EAS, qui sont de toute façon requis, sont utilisables en cas de primaires, dans la mesure où la défaillance totale de l’aspersion redondée est hors dimensionnement et du fait que l’imbrication des circuits RRA et RIS défiabilise l’installation sans gain évident (on dépasse même avec refroidissement par le RRA les caractéristiques des pompes IS en température d’eau)."
                            },
                            {
                                "example_id": "e3a6327a-9c63-46c2-84da-eac262cff1c5",
                                "sense_id": "169c8998-4397-3fd4-9158-917b0a205edf",
                                "text": "Échangeur thermique intermédiaire."
                            },
                            {
                                "example_id": "055e9ebf-c476-4e93-bab7-9d09907ca134",
                                "sense_id": "169c8998-4397-3fd4-9158-917b0a205edf",
                                "text": "On s’intéresse à un échangeur de chaleur, composé de deux circuits appelés primaire et secondaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df4413e3-b320-4a96-adf7-649ad8dd242e",
                        "source_entry_id": "675f01cd-0db4-336d-a060-9bb61327804b",
                        "source_sense_id": "9c3db31a-a953-34e7-ae3c-e8529cfcdb55",
