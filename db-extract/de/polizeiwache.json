                ],
                "senses": [
                    {
                        "sense_id": "4ca0e67f-2ba5-3f6b-b9cb-d65f4d464328",
                        "entry_id": "e2b31877-ddfb-3b13-a80c-a80dd4cb97c0",
                        "glosses": [
                            "ein Gebäude oder die Diensträume in einem Gebäude, die von einer Abteilung der Polizei genutzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "427e8d8e-43a2-4896-aa2f-6f731e1da86c",
                                "sense_id": "4ca0e67f-2ba5-3f6b-b9cb-d65f4d464328",
                                "text": "Die Beamten brachten den betrunkenen Jugendlichen auf die Polizeiwache."
                            },
                            {
                                "example_id": "125a973a-2862-4d3e-a272-1f3f88e667e0",
                                "sense_id": "4ca0e67f-2ba5-3f6b-b9cb-d65f4d464328",
                                "text": "„Die Mau-Mau-Krieger stürmen Polizeiwachen und Gefängnisse, erschießen weiße Siedlerfamilien.“"
                            },
                            {
                                "example_id": "ff605556-3b14-4114-81a3-2b1f2a4579ba",
                                "sense_id": "4ca0e67f-2ba5-3f6b-b9cb-d65f4d464328",
                                "text": "„Die Polizeiwache war ein kleines, mit Stuck verkleidetes Haus am Ende des Parkplatzes, gleich neben der Promenade und in der Nähe des Pavillons.“"
                            },
                            {
                                "example_id": "81422e59-fd44-4df7-a847-d5d16a130f8d",
                                "sense_id": "4ca0e67f-2ba5-3f6b-b9cb-d65f4d464328",
                                "text": "„Auf der Polizeiwache hatten sie ihnen gedroht, und die Fürsorgerin versuchte es mit freundlichem Zureden, aber sie hatten durchgehalten.“"
                            },
                            {
                                "example_id": "4867ee3b-6ebd-4f15-8d65-d0f3836af364",
                                "sense_id": "4ca0e67f-2ba5-3f6b-b9cb-d65f4d464328",
                                "text": "„Er hatte jetzt den Chefposten inne, war der Herr der Polizeiwache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ec7a663-f2bd-4f36-958e-1196c08cee79",
                        "source_entry_id": "e2b31877-ddfb-3b13-a80c-a80dd4cb97c0",
                        "source_sense_id": "4ca0e67f-2ba5-3f6b-b9cb-d65f4d464328",
                        "source_sense_description": "Gebäude oder Diensträume in einem Gebäude der Polizei",
                        "target_lang_word": "police station",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "police station",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa8a0fc2-7ec8-32f3-8857-bdc078e302f2",
                                        "entry_id": "11cb6928-dd57-3fcc-8a58-3071692449d2",
                                        "glosses": [
                                            "A building serving as the headquarters of a branch of the police force, and sometimes as a temporary place of confinement for offenders."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e86f4f2-9ec9-4b6e-a57b-80f1dd9e657c",
                                                "sense_id": "fa8a0fc2-7ec8-32f3-8857-bdc078e302f2",
                                                "text": "When the ballots were opened on 19 November, Hsu Hsin-liang’s supporters at a polling station in Chungli City suspected fraud. As the crowd swelled to approximately a thousand, rioting erupted. One protester was killed and the Chungli police station was burned."
                                            },
                                            {
                                                "example_id": "eddfb0b7-c85e-4ece-9e99-11c327fc2a01",
                                                "sense_id": "fa8a0fc2-7ec8-32f3-8857-bdc078e302f2",
                                                "text": "In trying to stop him from exploiting more children, I was ensuring my parents and my siblings would be ostracised. She begged me not to go to the police station."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
