                                                "sense_id": "ddf2282a-38d3-3aab-9626-24d3ba01f3dc",
                                                "text": "She saw him walking on the opposite side of the road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32699b68-3809-3603-9579-093b54dff2e5",
