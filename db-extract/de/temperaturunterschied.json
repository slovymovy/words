                "senses": [
                    {
                        "sense_id": "c347ca05-e34f-35f0-886d-42bb7b9af177",
                        "entry_id": "60b9c75f-929a-3358-950c-c5fcb838313b",
                        "glosses": [
                            "Abweichung/Unterschied in der Temperatur von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bb53a07-b236-48f6-82c9-3d570a3c830c",
                                "sense_id": "c347ca05-e34f-35f0-886d-42bb7b9af177",
                                "text": "„Durch den geringeren Temperaturunterschied zwischen beiden Bauteilen kommt es zu einer geringeren gegenseitigen Behinderung.“"
                            },
                            {
                                "example_id": "c74e8856-8a4e-485e-bbca-79f5cde0786b",
                                "sense_id": "c347ca05-e34f-35f0-886d-42bb7b9af177",
                                "text": "„Die in der Zeiteinheit abgeführte Wärmemenge kann mit für unsero Zweck genügender Genauigkeit dem Temperaturunterschied proportional gesetzt werden.“"
                            },
                            {
                                "example_id": "f3d55da4-e380-403d-9a2e-0358e22605d8",
                                "sense_id": "c347ca05-e34f-35f0-886d-42bb7b9af177",
                                "text": "„Auch hier ist der große Temperaturunterschied zwischen der Dampftemperatur über dem obersten Boden und dem Ablauf nachteilig.“"
                            },
                            {
                                "example_id": "4ef2c54c-a18d-4447-8565-f1e420ba880e",
                                "sense_id": "c347ca05-e34f-35f0-886d-42bb7b9af177",
                                "text": "„Um den Temperaturunterschied zwischen der Haut und dem Wasser zu verringern, tragen Taucher einen Anzug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
