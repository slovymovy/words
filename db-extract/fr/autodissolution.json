                "senses": [
                    {
                        "sense_id": "4cd5c672-f469-3043-9eb2-81ef036b6fec",
                        "entry_id": "5f387cca-148c-3b51-affb-99a69354a458",
                        "glosses": [
                            "Fait de s’autodissoudre, de se dissoudre soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9fe68c1-9238-4f4f-8089-d0ae82c2ee0f",
                                "sense_id": "4cd5c672-f469-3043-9eb2-81ef036b6fec",
                                "text": "Si de telles représailles étaient décidées, cela pourrait amener l’Autorité palestinienne à annoncer son autodissolution, forçant le gouvernement Netanyahu à reprendre en main l’administration de toute la Cisjordanie, ce dont Israël se passerait bien."
                            },
                            {
                                "example_id": "ede66f12-4787-40cd-92d2-2cf886330816",
                                "sense_id": "4cd5c672-f469-3043-9eb2-81ef036b6fec",
                                "text": "La Chambre des députés a voté jeudi soir son autodissolution, suivi par le Sénat quelques minutes plus tard."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e09879b-3fc8-31e2-94c5-a88b4e6d30c8",
                        "entry_id": "5f387cca-148c-3b51-affb-99a69354a458",
                        "glosses": [
                            "Se perdre dans ses pensées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a11ca43-4e63-46d9-92ca-571fcf9b2ed2",
                                "sense_id": "0e09879b-3fc8-31e2-94c5-a88b4e6d30c8",
                                "text": "Je crois bien m’être endormi à l’instant même où je m’affalais dans le lit. C’était une sorte de chute, insensible, dans un flot sombre et profond, un abîme de complète autodissolution."
                            }
                        ]
                    }
