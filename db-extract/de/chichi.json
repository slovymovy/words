                "senses": [
                    {
                        "sense_id": "b263b3b0-d4ca-334d-a977-6337ad21d69a",
                        "entry_id": "8fd34d31-5794-3540-a684-16df72bc7083",
                        "glosses": [
                            "gekünsteltes oder affektiertes Benehmen/Verhalten"
                        ],
                        "tags": [
                            "derogatory",
                            "formal",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ec18c945-e542-4a01-86d7-986a9477bd0d",
                                "sense_id": "b263b3b0-d4ca-334d-a977-6337ad21d69a",
                                "text": "Das Chichi von diesem Galleristen geht mir sowas von auf den Senkel! Ich will nur ein Bild kaufen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "39daa3a9-42ce-30af-988d-5d7b4128eaa9",
                        "entry_id": "8fd34d31-5794-3540-a684-16df72bc7083",
                        "glosses": [
                            "unnötige Verzierung/unnötiger Zierrat"
                        ],
                        "tags": [
                            "derogatory",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "820f5218-be62-469a-ab8e-b507002847e2",
                                "sense_id": "39daa3a9-42ce-30af-988d-5d7b4128eaa9",
                                "text": "[Jil Sander:] „Doch die Mode dieser Zeit überzeugte die junge Frau nicht: zu viele Schnörkel, zu viele Rüschen, zu viel \"Chichi\".“"
                            },
                            {
                                "example_id": "6bb67358-6c4a-4dfb-851e-667900773299",
                                "sense_id": "39daa3a9-42ce-30af-988d-5d7b4128eaa9",
                                "text": "„Cornelia Junge erinnert sich bei der Arbeit noch gut an das letzte richtige Kostüm, das sie im vergangenen Monat in ihren Händen hatte: »Das letzte war ein großer Rock mit viel Rüschen. Mit viel Chichi und Glitzer und ein bisschen frivol.«“"
                            },
                            {
                                "example_id": "a13faa62-ccb7-4a6e-a33b-de9c2e8e194e",
                                "sense_id": "39daa3a9-42ce-30af-988d-5d7b4128eaa9",
                                "text": "Das ist mal ein Brot ohne Chichi: nur Sauerteig, Wasser, Salz und ein bisschen Kümmel, kein Weizen, kein Vorteig, kein Brühstück, ganz einfach. Und es schmeckt phantastisch!"
                            },
                            {
                                "example_id": "cdecc102-2777-4fbf-986f-c0975fa2426a",
                                "sense_id": "39daa3a9-42ce-30af-988d-5d7b4128eaa9",
                                "text": "„Der Hauptgang an diesem Abend: Kalbfleisch mit gelben Karotten und Rotweinsoße, hübsch dekoriert, ohne Schäumchen und Chichi, bodenständig und doch sehr fein.“"
                            },
                            {
                                "example_id": "f12a253c-fda1-489f-91e5-ca5838555c6d",
                                "sense_id": "39daa3a9-42ce-30af-988d-5d7b4128eaa9",
                                "text": "[Kneipe Laidak/Berlin-Neuköln:] „Kein Chichi, dafür Alkohol in allen Varianten und sogar Berliner Weiße mit Schuss zu akzeptablen Preisen, das ist hier das Programm.“"
                            },
                            {
                                "example_id": "56997a8b-6353-4b97-95d1-155c9e7243e2",
                                "sense_id": "39daa3a9-42ce-30af-988d-5d7b4128eaa9",
                                "text": "„Keine weißen Tischdecken, kein Chichi: Das „Papa Enj“ am Opernplatz will nicht so recht zu den anderen Restaurants dort passen.“"
                            },
                            {
                                "example_id": "c287bc5c-be9d-47cc-a149-d99b878f70a2",
                                "sense_id": "39daa3a9-42ce-30af-988d-5d7b4128eaa9",
                                "text": "„Mit der Tristesse eines \"Fish-and-Chips\"-Lokals hat die Moskauer Cocktail-Schickeria nichts am Hut. Russlands Millionäre mögen lieber das Chichi-Ambiente teurer Clubs.“"
                            },
                            {
                                "example_id": "94212ff7-5922-4238-88d8-17b8a271d437",
                                "sense_id": "39daa3a9-42ce-30af-988d-5d7b4128eaa9",
                                "text": "„Anliker schuf mit seinem kleinen, mit viel Chichi eingerichteten Club Mokka ein wertvolles Kulturhaus.“"
                            },
                            {
                                "example_id": "1089a9fb-441b-4a9f-8d0d-6961699f70ce",
                                "sense_id": "39daa3a9-42ce-30af-988d-5d7b4128eaa9",
                                "text": "[Hamburg, St. Pauli:] Seit 175 Jahren gibt es das Theater am Spielbudenplatz, […]. Großes technisches Chichi gibt es hier nicht, […]."
                            },
                            {
                                "example_id": "4a3e50ca-9c4e-417c-93df-b8620c133535",
                                "sense_id": "39daa3a9-42ce-30af-988d-5d7b4128eaa9",
                                "text": "„Tatsächlich gibt es mittlerweile auch schon Socken, die integrierte Druckknöpfe haben. So kann man die Paare mit den Druckknöpfen aneinanderheften und ohne Probleme wieder gemeinsam aus der Waschmaschine fischen. Wer auf diesen Chichi verzichten möchte, der kann auch einfach zum Wäschenetz greifen.“"
                            },
                            {
                                "example_id": "02ce45da-b34b-49b6-ab7e-dd20dc967ec1",
                                "sense_id": "39daa3a9-42ce-30af-988d-5d7b4128eaa9",
                                "text": "„Viel geschmäht und bis heute eher vernachlässigt oder oft mit der Drittbesetzung am Theater lieblos dahin-inszeniert und - musiziert, genießt die Operette ganz allmählich wieder die Aufmerksamkeit, die ihr gebührt. Dass sie weit mehr ist, als billiges Chichi, dass sie vielmehr ein ziemlich raffiniertes und komplexes Kunstwesen ist - das hat Prof. Gier in seinem gut 400-seitigen Kompendium an zahlreichen Werken minutiös dargestellt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8db56e53-ef77-4c5d-8f4c-9cf7c5bb90eb",
                        "source_entry_id": "8fd34d31-5794-3540-a684-16df72bc7083",
                        "source_sense_id": "39daa3a9-42ce-30af-988d-5d7b4128eaa9",
                        "source_sense_description": "unnötige Verzierung",
                        "target_lang_word": "chichi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chichi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "275d5e07-bb41-3644-9b03-2624ef773e4f",
                                        "entry_id": "a4ba51d1-3faa-3efe-a607-a10bf9cb7641",
                                        "glosses": [
                                            "Affectedly trendy; chic and stylish in a pretentious way."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "mildly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "597762ac-d714-4f16-942a-19377b2ca868",
                                                "sense_id": "275d5e07-bb41-3644-9b03-2624ef773e4f",
                                                "text": "Going in gangs to those chichi clubs at Maidenhead."
                                            },
                                            {
                                                "example_id": "fa5375bd-85da-4bc2-9892-7090ca3ab0ea",
                                                "sense_id": "275d5e07-bb41-3644-9b03-2624ef773e4f",
                                                "text": "We drove up the mountain and found the narrow streets chock full of chichi tourists."
                                            },
                                            {
                                                "example_id": "cbecb007-9bcb-4266-b3c8-6759f03aedd1",
                                                "sense_id": "275d5e07-bb41-3644-9b03-2624ef773e4f",
                                                "text": "The sort of real delicious Italian country cooking that is a revelation after so much chichi Italian food dished up in London."
                                            },
                                            {
                                                "example_id": "5d673efe-f4b7-4748-bf50-2db0c6ccdefc",
                                                "sense_id": "275d5e07-bb41-3644-9b03-2624ef773e4f",
                                                "text": "Not since a journalist morphed into Al Pacino in The Devil’s Advocate has a metamorphosis been so jarring. Of course, there were clues: Michael kicked a puppy in the very second episode, and no self-respecting Elysium so closely resembles a chichi outdoor mall in Pasadena."
                                            },
                                            {
                                                "example_id": "5cc62ff1-ea74-404f-9cf8-72805239ef34",
                                                "sense_id": "275d5e07-bb41-3644-9b03-2624ef773e4f",
                                                "text": "If this was in Cornwall, which it so closely resembles, it would have become the most chichi of gentrified enclaves, colonised by big-name chefs and celebrity regulars."
                                            },
                                            {
                                                "example_id": "250dc914-af11-407f-8faf-6231739862b2",
                                                "sense_id": "275d5e07-bb41-3644-9b03-2624ef773e4f",
                                                "text": "But if the mix is no longer about life's essentials, and instead a new wave of chichi cafés, artisan bakers and fancy nail bars—are we right to ask, not how useful is your high street, but how bougie?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chichi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9363b60-4e8b-3be4-92fd-40808dda85b5",
                                        "entry_id": "c663f7e0-668a-39f8-9309-c0c77e79a7c4",
                                        "glosses": [
                                            "A woman's breast."
                                        ],
                                        "tags": [
                                            "Latin-America",
                                            "in-plural",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "856b673b-577c-4f90-b5db-de389d6b26b7",
                                                "sense_id": "c9363b60-4e8b-3be4-92fd-40808dda85b5",
                                                "text": "[H]e rubbed [his hands] with Bag Balm to help the cuts heal and keep the skin soft, a trick he'd learned from his grandmother, who told him when he was eighteen and getting ready for a date that no woman wanted to feel rough hands scratching up her chichis."
                                            },
                                            {
                                                "example_id": "e1b1b719-1ef8-492e-a02a-920e6c0e98e1",
                                                "sense_id": "c9363b60-4e8b-3be4-92fd-40808dda85b5",
                                                "text": "And later, in Latin Grill Express, Jesus makes sure to compliment her accent, her vocabulary, to express admiration for the way her chichis looked in the last dress all over again, then Sarah asks about his plans for work, what he will do when they all leave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
