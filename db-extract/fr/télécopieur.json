                                        ],
                                        "examples": [
                                            {
                                                "example_id": "720319f0-ff2c-43bc-a297-cf670afc67b5",
                                                "sense_id": "e8795744-3d7c-3150-8b64-f9055a70c069",
                                                "text": "The fillok hyr deformyt fax wald haue a fair face."
                                            }
