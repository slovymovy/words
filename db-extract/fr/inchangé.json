                ],
                "senses": [
                    {
                        "sense_id": "2463ea95-2dbc-3097-95a9-f47f95596b93",
                        "entry_id": "2160dd2c-1669-3f95-9f20-7aeed4b07070",
                        "glosses": [
                            "Qui est resté toujours le même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b7566f1-c0da-4c31-9dcc-3ce8dc6d7808",
                                "sense_id": "2463ea95-2dbc-3097-95a9-f47f95596b93",
                                "text": "Vous me trouverez inchangé. Et pourquoi changerais-je puisque j'ai trouvé le bonheur qui me convient ?"
                            },
                            {
                                "example_id": "900f2e42-30e7-492e-bc89-5fe64a027512",
                                "sense_id": "2463ea95-2dbc-3097-95a9-f47f95596b93",
                                "text": "La loi du 21 mars 1991 est venue considérablement bouleverser le régime du transport ferroviaire intérieur, resté pratiquement inchangé depuis 1891."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3c6d05b-6e5b-4fe1-9abb-c35552ab6589",
                        "source_entry_id": "2160dd2c-1669-3f95-9f20-7aeed4b07070",
                        "source_sense_id": "2463ea95-2dbc-3097-95a9-f47f95596b93",
                        "target_lang_word": "unchanged",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unchanged",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66a4cad7-106b-31dd-a675-c8d7b8ba07f2",
                                        "entry_id": "c500ea94-e61a-3c47-9542-ac51d870fa5c",
                                        "glosses": [
                                            "Not changed or altered; remaining in an original state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "464855c8-2ec0-4e28-8b6c-a5808782ebcd",
                                                "sense_id": "66a4cad7-106b-31dd-a675-c8d7b8ba07f2",
                                                "text": "\"A first love is not easily extinguished, Mr. Allanson,\" said she. \"You may guess from my appearance, that I have been fortunate in life; but, for all that, my first love for you has continued the same, unaltered and unchanged, and you must forgive the little freedoms I used to-day to try your affections, and the effects my appearance would have on you.\""
                                            },
                                            {
                                                "example_id": "f6dea7bb-c3ba-4949-a73b-ec8fddb6b6b3",
                                                "sense_id": "66a4cad7-106b-31dd-a675-c8d7b8ba07f2",
                                                "text": "All seven cities saw an increase in air pollution during January-May. Readings assessed showed an average concentration of hazardous airborne particles - known as PM2.5 - up by as much as 14.8% in Taiyuan, the provincial capital, and by 16.3% in Shuozhou.[…]\nAccording to the latest data, average rates of PM2.5 in 337 cities nationwide stood at 44 micrograms per cubic meter in the first five months of the year, unchanged from 2018, with 118 cities reaching the national standard of 35 micrograms or below."
                                            },
                                            {
                                                "example_id": "94119ea9-db4d-44c9-a480-e71e9fc87f8d",
                                                "sense_id": "66a4cad7-106b-31dd-a675-c8d7b8ba07f2",
                                                "text": "Adults disapprove of the way Trump is handling tariffs by a nearly 2-to-1 margin, unchanged from the poll in April, which was done days after Trump first announced far-reaching tariffs and promised they would soon force trade agreements that would boost the economy."
                                            }
                                        ]
                                    }
                                ]
                            },
