                            {
                                "example_id": "af9d37fb-2de3-4847-9430-31e19822e294",
                                "sense_id": "9c9a0b44-802f-3b79-9a2e-96172e2989de",
                                "text": "„»Inschallah,« sagte der Kalif zu sich selbst, »ich werde endlich doch noch mit Dir quitt werden.«“"
                            },
                            {
                                "example_id": "c00f4acf-026c-4079-a9e9-ef6e8c36322b",
                                "sense_id": "9c9a0b44-802f-3b79-9a2e-96172e2989de",
                                "text": "„Nachdem es gelungen, sie zu überzeugen, daß das Brot auch bei Nacht gebacken werden könne, versprechen sie endlich, morgen bei Tagesgrauen auf dem Boot zu sein – »inschallah!« (»wenn es Gottes Wille ist!«) – ein unter Umständen ebenso frommer als bedenklicher Beisatz.“"
                            }
                        ],
