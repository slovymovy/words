                "translations": [
                    {
                        "translation_id": "b13d89f2-bee5-49b7-ac73-2410bfe6e30f",
                        "source_entry_id": "dbb772f1-bf0c-30af-b74e-8b474d31a985",
                        "target_lang_word": "tarantella",
