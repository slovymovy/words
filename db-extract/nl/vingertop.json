                    }
                ],
                "senses": [
                    {
                        "sense_id": "178efc11-048e-3171-ae9f-729857852d9d",
                        "entry_id": "64e64f34-58c5-3dd8-be44-fde61e65bccc",
                        "glosses": [
                            "topje van een vinger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1fc9852-8f88-4a68-8309-2a8c99b652a0",
                                "sense_id": "178efc11-048e-3171-ae9f-729857852d9d",
                                "text": "De vingertop is zeer gevoelig."
                            },
                            {
                                "example_id": "b28e2e08-7762-42b4-b8e0-3f41e57eae50",
                                "sense_id": "178efc11-048e-3171-ae9f-729857852d9d",
                                "text": "De ober balanceerde een zilveren dienblad op de vingertoppen van zijn gehandschoende hand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26137667-89af-4696-9c6e-80643ad72ccf",
                        "source_entry_id": "64e64f34-58c5-3dd8-be44-fde61e65bccc",
                        "source_sense_id": "178efc11-048e-3171-ae9f-729857852d9d",
                        "source_sense_description": "topje van een vinger",
                        "target_lang_word": "Fingerspitze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fingerspitze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14dc6cb5-8865-31e4-9371-dd3048eeef8c",
                                        "entry_id": "cb956eba-7ff7-3c34-97fe-bf6850fa0369",
                                        "glosses": [
                                            "der vordere Teil des Fingers, das letzte Glied des Fingers"
                                        ],
                                        "tags": [
                                            "häufig nur Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4bccb54-2ff3-491c-a150-765e12f623b8",
                                                "sense_id": "14dc6cb5-8865-31e4-9371-dd3048eeef8c",
                                                "text": "Die Fingerspitzen sind für die haptische Wahrnehmung sehr wichtig."
                                            },
                                            {
                                                "example_id": "87ec7729-fa9d-48b8-851a-5d03be784bd2",
                                                "sense_id": "14dc6cb5-8865-31e4-9371-dd3048eeef8c",
                                                "text": "„Ihre Fingerspitzen waren in Henna getunkt.“"
                                            },
                                            {
                                                "example_id": "f142d966-403f-48f4-99fc-b16861e5b4b0",
                                                "sense_id": "14dc6cb5-8865-31e4-9371-dd3048eeef8c",
                                                "text": "„Er streicht mit den Fingerspitzen leicht über ihre Haut.“"
                                            },
                                            {
                                                "example_id": "24e3ac9c-b7c9-4dd2-bd71-6abc5e4471c7",
                                                "sense_id": "14dc6cb5-8865-31e4-9371-dd3048eeef8c",
                                                "text": "„In den Fingerspitzen fühlte er das Klopfen des fremden Pulses.“"
                                            },
                                            {
                                                "example_id": "79a47d4d-9a67-4003-b1d2-afa18179b34a",
                                                "sense_id": "14dc6cb5-8865-31e4-9371-dd3048eeef8c",
                                                "text": "„Noby stellte seinen Zeigefinger senkrecht und ließ die Fingerspitze imaginäre Kreise im Raum vollführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56bf41e7-dd60-474d-82f2-d653aadfbfa7",
                        "source_entry_id": "64e64f34-58c5-3dd8-be44-fde61e65bccc",
                        "source_sense_id": "178efc11-048e-3171-ae9f-729857852d9d",
                        "source_sense_description": "topje van een vinger",
                        "target_lang_word": "Fingerkuppe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fingerkuppe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28bfdf3d-168b-364e-aa6e-94e083ae6167",
                                        "entry_id": "b88b7cd1-8734-3dae-824a-45a97818db47",
                                        "glosses": [
                                            "das rundliche Ende eines Fingers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8330bac4-5c95-4e07-9b3c-b8ff776b9b72",
                                                "sense_id": "28bfdf3d-168b-364e-aa6e-94e083ae6167",
                                                "text": "„Ich spiele Nylonsaiten. Nach einer Tournee hab ich links an den Fingerkuppen so dicke Hornhaut, daß ich damit auf glühendes Eisen tippen kann.“"
                                            },
                                            {
                                                "example_id": "d0fea663-4ca2-47fb-bff9-1d98757bfd89",
                                                "sense_id": "28bfdf3d-168b-364e-aa6e-94e083ae6167",
                                                "text": "„Beim Spielen mit Feuerwerkskörpern ist Montagmorgen einem Elfjährigen eine Fingerkuppe abgerissen worden.“"
                                            },
                                            {
                                                "example_id": "2a927d1e-f14f-458c-af1a-a908dcecb43c",
                                                "sense_id": "28bfdf3d-168b-364e-aa6e-94e083ae6167",
                                                "text": "„Schon länger wusste man, dass die Papillarlinien an den Fingerkuppen jedes Menschen einzigartig waren.“"
                                            },
                                            {
                                                "example_id": "6fbc2fa9-edc1-4270-ad40-028303004c53",
                                                "sense_id": "28bfdf3d-168b-364e-aa6e-94e083ae6167",
                                                "text": "„Die Lehrerin strich mit den Fingerkuppen über das Holz, das überraschend hell und leicht war und schwach duftete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8eaebde-f6f6-4043-9984-8a73e17784da",
                        "source_entry_id": "64e64f34-58c5-3dd8-be44-fde61e65bccc",
                        "source_sense_id": "178efc11-048e-3171-ae9f-729857852d9d",
                        "source_sense_description": "topje van een vinger",
                        "target_lang_word": "fingertip",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fingertip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2de0c77-c2bf-35e9-a670-6853167a2e03",
                                        "entry_id": "30779328-7fab-33a8-bca4-3bafeb813969",
                                        "glosses": [
                                            "The tip of the human finger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cf53ae1-0376-47f2-9950-a8ed00afea33",
                                                "sense_id": "e2de0c77-c2bf-35e9-a670-6853167a2e03",
                                                "text": "The traditional Thai greeting, the wai, is generally offered first by the youngest of the two people meeting, with their hands pressed together, fingertips pointing upwards as the head is bowed to touch their face to the hands."
                                            },
                                            {
                                                "example_id": "cdcac497-a4a2-44fa-9aa4-80ea94f9de2e",
                                                "sense_id": "e2de0c77-c2bf-35e9-a670-6853167a2e03",
                                                "text": "They were all professional to their fingertips, knew each other very well, and knew their disciplines backwards."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fingertip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90a772cf-632b-3542-94f8-5d3dbf7d9092",
                                        "entry_id": "2da1b93a-5fd3-3cae-b855-e825ef08b9c4",
                                        "glosses": [
                                            "To move or deflect with the fingertips."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d030196-7fd9-4199-accb-a9792d4c5caa",
                                                "sense_id": "90a772cf-632b-3542-94f8-5d3dbf7d9092",
                                                "text": "Then Rogne released Forrest with a diagonal ball and the winger tormented Broadfoot again before blasting a shot which McGregor managed to fingertip over his bar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
