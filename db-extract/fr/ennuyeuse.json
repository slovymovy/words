                        "examples": [
                            {
                                "example_id": "92d648a3-f891-43a5-8d1d-abc8ea15ceac",
                                "sense_id": "20c32c5a-0de0-3335-acb5-bb0848d554c1",
                                "text": "Nous avons tous des complaisances masochiques dans le romanesque « amour de l’amour », cette perversion affective si banale et si \"\"\"ennuyeuse\"\"\", qu’on dé-romantise la passion amoureuse – toutes les passions – pourquoi pas ?"
                            }
                        ]
                    }
