{
    "word_family": [
        "embrace",
        "bracelet",
        "bracing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a6c4811-995d-32c2-b932-8ee20be0dbe5",
                    "sense_definition": "To prepare oneself physically or mentally for something difficult or unpleasant, such as an impact, shock, or bad news.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "preparation_steadiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot told the passengers to <w>brace</w> for an emergency landing.",
                            "target_lang_translations": {
                                "ru": "Пилот велел пассажирам <w>приготовиться</w> к аварийной посадке.",
                                "zh": "飞行员让乘客为紧急迫降<w>做好准备</w>。"
                            }
                        },
                        {
                            "text": "You need to <w>brace</w> yourself before you hear the results of the exam.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>собраться с духом</w>, прежде чем ты услышишь результаты экзамена.",
                                "zh": "你在听到考试结果之前，得先<w>做好心理准备</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "brace for impact",
                        "brace yourself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подготовиться физически или морально к чему-то трудному или неприятному, например, к удару, потрясению или плохим новостям.",
                        "zh": "使自己在身体或心理上为困难、不愉快或突然发生的事情预先做好准备，如撞击、打击或坏消息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приготовиться",
                                "target_lang_sense_clarification": "к чему-то неприятному"
                            },
                            {
                                "target_lang_word": "собраться с духом",
                                "target_lang_sense_clarification": "морально подготовиться"
                            },
                            {
                                "target_lang_word": "сгруппироваться",
                                "target_lang_sense_clarification": "физически перед ударом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "做好准备",
                                "target_lang_sense_clarification": "为困难、冲击或坏消息预先准备"
                            },
                            {
                                "target_lang_word": "做好心理准备",
                                "target_lang_sense_clarification": "心理上先准备好"
                            },
                            {
                                "target_lang_word": "打起精神",
                                "target_lang_sense_clarification": "在压力或危险来临前振作起来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f33d410-4d10-3eba-9c58-222307709ccd",
                    "sense_definition": "To press one's body or part of it firmly against something to stay steady or resist pressure.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "preparation_steadiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>brace</w> her back against the door to keep it shut.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>упереться</w> спиной в дверь, чтобы удержать её закрытой.",
                                "zh": "为了把门顶住，她不得不把后背<w>顶住</w>门。"
                            }
                        },
                        {
                            "text": "He <w>braced</w> his feet on the rocks to stop himself from slipping.",
                            "target_lang_translations": {
                                "ru": "Он <w>упёрся</w> ногами в камни, чтобы не поскользнуться.",
                                "zh": "他用脚<w>抵住</w>岩石，以免自己滑倒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "twosome"
                    ],
                    "common_phrases": [
                        "brace against"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно прижать тело или его часть к чему-либо для сохранения устойчивости или сопротивления давлению.",
                        "zh": "把身体或身体的一部分紧紧顶在某物上，以保持稳定或抵抗压力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упереться",
                                "target_lang_sense_clarification": "прислониться для опоры"
                            },
                            {
                                "target_lang_word": "упереть",
                                "target_lang_sense_clarification": "прижать что-то для фиксации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顶住",
                                "target_lang_sense_clarification": "把身体某部位顶在某物上以保持稳定"
                            },
                            {
                                "target_lang_word": "抵住",
                                "target_lang_sense_clarification": "用力抵着某物防止移动或滑倒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b65383cb-b735-3527-ad38-7cc73e42f338",
                    "sense_definition": "To make a structure stronger or firmer by adding supports.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "support_reinforce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers used steel beams to <w>brace</w> the old tunnel roof.",
                            "target_lang_translations": {
                                "ru": "Рабочие использовали стальные балки, чтобы <w>укрепить</w> крышу старого туннеля.",
                                "zh": "工人们用钢梁来<w>加固</w>旧隧道的顶部。"
                            }
                        },
                        {
                            "text": "We need to <w>brace</w> the shelf so it can hold the heavy books.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>подпереть</w> полку, чтобы она выдержала тяжелые книги.",
                                "zh": "我们得先把这个架子<w>加固</w>一下，这样它才能承受这些重书。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать конструкцию более прочной или устойчивой, добавив опоры.",
                        "zh": "通过增加支撑物使某个结构更牢固、更稳定。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укреплять",
                                "target_lang_sense_clarification": "делать прочнее"
                            },
                            {
                                "target_lang_word": "подпирать",
                                "target_lang_sense_clarification": "ставить подпорки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加固",
                                "target_lang_sense_clarification": "通过增加支撑使结构更稳固"
                            },
                            {
                                "target_lang_word": "支撑",
                                "target_lang_sense_clarification": "用支撑物托住、稳住"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eba75073-9a8a-3750-90e6-a95e36c4d9da",
                    "sense_definition": "A medical device made of wires and brackets attached to teeth to straighten them.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "support_reinforce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenager was unhappy because he had to wear <w>braces</w> for two years.",
                            "target_lang_translations": {
                                "ru": "Подросток был несчастен, потому что ему пришлось носить <w>брекеты</w> два года.",
                                "zh": "因为他得戴两年<w>牙套</w>，那个少年很不开心。"
                            }
                        },
                        {
                            "text": "After her <w>braces</w> were removed, she had a perfect smile.",
                            "target_lang_translations": {
                                "ru": "После того как ей сняли <w>брекеты</w>, у неё стала идеальная улыбка.",
                                "zh": "她的<w>牙套</w>拆掉以后，就有了一口很完美的笑容。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dental braces",
                        "wear braces"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинское приспособление из проволоки и замочков, прикрепляемое к зубам для их выравнивания.",
                        "zh": "一种固定在牙齿上的医疗矫正装置，由金属丝和托槽等组成，用来把牙齿排整齐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брекеты",
                                "target_lang_sense_clarification": "стоматологические"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牙套",
                                "target_lang_sense_clarification": "用于矫正牙齿的口腔装置"
                            },
                            {
                                "target_lang_word": "牙箍",
                                "target_lang_sense_clarification": "口语中也可这样说，指牙齿矫正器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83f4cb80-943f-3fe8-bbdf-757178cd3003",
                    "sense_definition": "A device or object used to support something, hold it in place, or prevent it from moving, often used for injured body parts.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "support_reinforce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a neck <w>brace</w> for several weeks after the car accident.",
                            "target_lang_translations": {
                                "ru": "Он носил шейный <w>фиксатор</w> несколько недель после автомобильной аварии.",
                                "zh": "车祸后，他戴了几个星期的颈部<w>支具</w>。"
                            }
                        },
                        {
                            "text": "The carpenter added a metal <w>brace</w> to the corner of the table.",
                            "target_lang_translations": {
                                "ru": "Плотник добавил металлическую <w>скобу</w> на угол стола.",
                                "zh": "木匠在桌角加了一个金属<w>支架</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "knee brace",
                        "neck brace",
                        "back brace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство или предмет, используемый для поддержки чего-либо, фиксации или предотвращения движения, часто используется для травмированных частей тела.",
                        "zh": "一种用来支撑、固定或防止移动的装置或部件，常见于受伤身体部位，也可用于结构物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фиксатор",
                                "target_lang_sense_clarification": "медицинский (ортез, бандаж)"
                            },
                            {
                                "target_lang_word": "скоба",
                                "target_lang_sense_clarification": "строительная деталь"
                            },
                            {
                                "target_lang_word": "подпорка",
                                "target_lang_sense_clarification": "опора"
                            },
                            {
                                "target_lang_word": "распорка",
                                "target_lang_sense_clarification": "для удержания расстояния"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支具",
                                "target_lang_sense_clarification": "医疗上用于固定、支撑受伤部位"
                            },
                            {
                                "target_lang_word": "支架",
                                "target_lang_sense_clarification": "支撑或固定物体的构件"
                            },
                            {
                                "target_lang_word": "加固件",
                                "target_lang_sense_clarification": "机械或结构上的加固、固定部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e497a700-aace-3967-a5bf-914782a34eb6",
                    "sense_definition": "A punctuation mark { or } used to group words, lines, or mathematical elements together.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "symbol_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this programming language, you must use a curly <w>brace</w> to start a function.",
                            "target_lang_translations": {
                                "ru": "В этом языке программирования нужно использовать открывающую <w>фигурную скобку</w>, чтобы начать функцию.",
                                "zh": "在这种编程语言里，你必须用左<w>大括号</w>来开始一个函数。"
                            }
                        },
                        {
                            "text": "The teacher drew a <w>brace</w> on the board to connect the three related items.",
                            "target_lang_translations": {
                                "ru": "Учитель нарисовал на доске <w>фигурную скобку</w>, чтобы объединить три связанных пункта.",
                                "zh": "老师在黑板上画了一个<w>花括号</w>，把这三个相关项目连在一起。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "curly brace",
                        "closing brace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знак препинания { или }, используемый для группировки слов, строк или математических элементов.",
                        "zh": "标点或符号 { 或 }，用于把词语、行或数学元素归为一组。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фигурная скобка",
                                "target_lang_sense_clarification": "знак препинания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大括号",
                                "target_lang_sense_clarification": "编程、数学中常用说法，指 { 或 }"
                            },
                            {
                                "target_lang_word": "花括号",
                                "target_lang_sense_clarification": "强调形状像花形的括号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91c4f01a-54e7-3c61-823a-1e7b44936fd9",
                    "sense_definition": "Straps worn over the shoulders to hold up trousers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man snapped his <w>braces</w> and sat down in his armchair.",
                            "target_lang_translations": {
                                "ru": "Старик щелкнул <w>подтяжками</w> и сел в кресло.",
                                "zh": "老人弹了弹自己的<w>背带</w>，然后坐进了扶手椅。"
                            }
                        },
                        {
                            "text": "In the United States, <w>braces</w> are more commonly called suspenders.",
                            "target_lang_translations": {
                                "ru": "В Соединенных Штатах <w>подтяжки</w> чаще называют \"suspenders\".",
                                "zh": "在美国，<w>背带</w>更常被叫作 suspenders。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pair of braces"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        },
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лямки, надеваемые через плечи для поддержания брюк.",
                        "zh": "穿在肩上的带子，用来把裤子提住不下滑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтяжки",
                                "target_lang_sense_clarification": "элемент одежды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "背带",
                                "target_lang_sense_clarification": "穿在肩上，用来提住裤子"
                            },
                            {
                                "target_lang_word": "吊裤带",
                                "target_lang_sense_clarification": "较传统的说法，指裤子的肩带"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d243067c-2c7e-3599-b3dd-f3d6b65b4e10",
                    "sense_definition": "A pair of something, typically used for game birds or goals scored in sports.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pair_quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter returned home with a <w>brace</w> of pheasants for dinner.",
                            "target_lang_translations": {
                                "ru": "Охотник вернулся домой с <w>парой</w> фазанов к ужину.",
                                "zh": "猎人带着一<w>对</w>野鸡回家做晚饭。"
                            }
                        },
                        {
                            "text": "The striker scored a <w>brace</w> in the first half to give his team the lead.",
                            "target_lang_translations": {
                                "ru": "Нападающий оформил <w>дубль</w> в первом тайме, выведя свою команду вперед.",
                                "zh": "那名前锋上半场打进<w>两球</w>，帮助球队取得领先。"
                            }
                        }
                    ],
                    "synonyms": [
                        "duo"
                    ],
                    "common_phrases": [
                        "brace of pheasants",
                        "score a brace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пара чего-либо, обычно используется по отношению к дичи или голам в спорте.",
                        "zh": "一对、两个，常用于猎获的野禽，或在体育中指一名球员进两球。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пара",
                                "target_lang_sense_clarification": "два предмета"
                            },
                            {
                                "target_lang_word": "дубль",
                                "target_lang_sense_clarification": "два гола в спорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对",
                                "target_lang_sense_clarification": "一双、一组中的两个"
                            },
                            {
                                "target_lang_word": "两球",
                                "target_lang_sense_clarification": "体育中指同一名球员进两个球"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d74c060-f1f1-3f99-ba90-6efc84327e20",
                    "sense_definition": "A hand tool with a crank handle, used with a bit to drill holes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before electric drills were common, carpenters used a <w>brace</w> and bit.",
                            "target_lang_translations": {
                                "ru": "До того как электрические дрели стали обычным явлением, плотники использовали <w>коловорот</w> и сверло.",
                                "zh": "在电钻普及之前，木匠用的是<w>手摇钻</w>和钻头。"
                            }
                        },
                        {
                            "text": "He turned the handle of the <w>brace</w> slowly to bore through the wood.",
                            "target_lang_translations": {
                                "ru": "Он медленно вращал ручку <w>коловорота</w>, чтобы просверлить дерево.",
                                "zh": "他慢慢转动<w>手摇钻</w>的手柄，在木头上钻孔。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "brace and bit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ручной инструмент с коленчатой рукояткой, используемый со сверлом для сверления отверстий.",
                        "zh": "一种带曲柄手柄的手动工具，要配合钻头使用，用来钻孔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коловорот",
                                "target_lang_sense_clarification": "инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手摇钻",
                                "target_lang_sense_clarification": "带曲柄、配合钻头使用的旧式手动钻孔工具"
                            },
                            {
                                "target_lang_word": "曲柄钻",
                                "target_lang_sense_clarification": "较书面或专业的名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5462d1dd-1a07-3068-82af-73cb7462a3d6",
                    "sense_definition": "A surname of Old French origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Brace</w> has been working at the company for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Брейс</w> работает в компании уже более двадцати лет.",
                                "zh": "<w>布雷斯</w>先生在这家公司工作二十多年了。"
                            }
                        },
                        {
                            "text": "We invited the <w>Brace</w> family to the neighborhood dinner.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили семью <w>Брейс</w> на соседский ужин.",
                                "zh": "我们邀请了<w>布雷斯</w>一家来参加社区聚餐。"
                            }
                        }
