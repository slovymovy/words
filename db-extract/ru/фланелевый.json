                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb451984-d87e-4b14-ba65-4bb7610806a0",
                                                "sense_id": "46300fc6-2791-3a7c-823c-2322a9b7dd43",
                                                "text": "I got a little cross and asked him to stop flannelling and to tell me what was holding me back. Were my annual assessments below par? Was there something I had done – or not done?"
