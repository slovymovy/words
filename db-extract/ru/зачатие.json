                    }
                ],
                "translations": [
                    {
                        "translation_id": "506efc0f-f956-4ef6-99cf-5a0a75f8d464",
                        "source_entry_id": "3ee71825-02b3-3eb5-8f8e-947e607bb027",
                        "source_sense_id": "6a90cb8b-d992-3f40-be6e-0b5af94c722d",
                        "target_lang_word": "conception",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conception",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52312b29-05fc-371b-b34e-0928eb47fb5f",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "The act of conceiving."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19848c42-e055-3d4a-ab34-9c71af636d39",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "The state of being conceived; the beginning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a2af9bb-6155-3e3f-b575-67110d4d6407",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "The fertilization of an ovum by a sperm to form a zygote."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "340744d0-2d8b-4308-b7fe-540a95ebbc0e",
                                                "sense_id": "3a2af9bb-6155-3e3f-b575-67110d4d6407",
                                                "text": "Some powers diuine, or els infernall, mixt\nTheir angry ſeedes at his conception:\nFor he was neuer ſprong of humaine race,\nSince with the ſpirit of his fearefull pride,\nHe dares so doubtleſly reſolue of rule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d21c89a3-9355-3d6b-8ec2-496950f5cb6f",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "The start of pregnancy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82556de4-8ed9-3483-8aee-d3869d6c7b70",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "The formation of a conceptus or an implanted embryo."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "034de16e-015d-3724-8eb2-b262553e95eb",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "The power or faculty of apprehending of forming an idea in the mind; the power of recalling a past sensation or perception; the ability to form mental abstractions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a8df411-1558-40b2-a922-e96537fe8ae1",
                                                "sense_id": "034de16e-015d-3724-8eb2-b262553e95eb",
                                                "text": "What the school books say about the united efforts of the two great Rossums is all a fairy tale. They used to have dreadful rows. The old atheist hadn't the slightest conception of industrial matters, and the end of it was that young Rossum shut him up in some laboratory or other and let him fritter the time away with his monstrosities, while he himself started on the business from an engineer's point of view."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69469130-763e-3f6d-8350-7055ee8d9234",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "An image, idea, or notion formed in the mind; a concept, plan or design."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "802cc9ae-1742-45af-94b4-99ddafb85d17",
                                                "sense_id": "69469130-763e-3f6d-8350-7055ee8d9234",
                                                "text": "Elegant brick and stone buildings, with iron and glass canopies and decorative wooden scalloping and fencing—all evidencing care on the part of the architect to produce a pleasing, well-planned building—were submerged beneath a profusion of ill-conceived additions and camouflaged by vulgar paint schemes; and the original conception was lost."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a450bbaf-615a-4db1-9e1d-21977572f762",
                        "source_entry_id": "3ee71825-02b3-3eb5-8f8e-947e607bb027",
                        "source_sense_id": "6a90cb8b-d992-3f40-be6e-0b5af94c722d",
                        "target_lang_word": "conception",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conception",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd6e586c-ece4-3ec8-87f2-a849eed4fa8a",
                                        "entry_id": "b3a74ba9-3c32-31b1-8b61-8d0c51bc39da",
                                        "glosses": [
                                            "Action par laquelle un enfant est conçu dans le sein de sa mère quand l’embryon se forme par la rencontre d’un ovule et d’un spermatozoïde. → voir fécondation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92f6d9a8-53b4-40ed-b011-29ecbfb005c2",
                                                "sense_id": "dd6e586c-ece4-3ec8-87f2-a849eed4fa8a",
                                                "text": "Loin de favoriser la conception des femmes, le mariage n'est souvent qu'une école mutuelle de stérilité volontaire."
                                            },
                                            {
                                                "example_id": "dec44e4b-38a2-484d-96b0-a45c6729df62",
                                                "sense_id": "dd6e586c-ece4-3ec8-87f2-a849eed4fa8a",
                                                "text": "La conception nécessite l’atteinte et la pénétration par le spermatozoïde de l’ovocyte, qui complète sa méiose II avant la fusion des deux noyaux lors de la fécondation ([…])."
                                            },
                                            {
                                                "example_id": "89757631-629d-44b6-93ac-1078968680dd",
                                                "sense_id": "dd6e586c-ece4-3ec8-87f2-a849eed4fa8a",
                                                "text": "Dictionnaire : « Matrice (ou utérus) : viscère où a lieu la conception ». À noter que cette définition convient aussi bien au cerveau."
                                            },
                                            {
                                                "example_id": "7d25ff3c-2835-4cf6-83ee-0866dde09dc5",
                                                "sense_id": "dd6e586c-ece4-3ec8-87f2-a849eed4fa8a",
                                                "text": "L’immaculée conception : abréviation de l’immaculée conception de la Vierge Marie, dogme catholique selon lequel la Vierge Marie a été exempte du péché originel dès sa conception."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "968e8a2c-18cf-3402-b979-40325cd08037",
                                        "entry_id": "b3a74ba9-3c32-31b1-8b61-8d0c51bc39da",
                                        "glosses": [
                                            "Faculté de comprendre et de concevoir les choses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a153e711-e84a-4839-9ddb-89ce08f0a7d6",
                                                "sense_id": "968e8a2c-18cf-3402-b979-40325cd08037",
                                                "text": "Il a la conception vive, facile, lente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8346cbb-692d-3d26-8903-54daffe0165f",
                                        "entry_id": "b3a74ba9-3c32-31b1-8b61-8d0c51bc39da",
                                        "glosses": [
                                            "Pensée résultant de cette faculté, idée, production de l’intelligence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "742ddbd2-a258-4b60-8338-6f169dfe29f6",
                                                "sense_id": "a8346cbb-692d-3d26-8903-54daffe0165f",
                                                "text": "Trévise, quant à elle, est formelle, c’est à la signora Alba, épouse du restaurateur Campeol, que revient la onception, dans les années 1960, de l’actuel tiramisu : la finaude sut transformer une erreur, du mascarpone versé par inadvertance dans un sabayon, en recette miraculeuse enrichie au cacao et au café."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93b41b10-fb06-312f-b0bf-975f2afd6d81",
                                        "entry_id": "b3a74ba9-3c32-31b1-8b61-8d0c51bc39da",
                                        "glosses": [
                                            "Manière de voir les choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc73d040-4446-4157-b854-290162f1f411",
                                                "sense_id": "93b41b10-fb06-312f-b0bf-975f2afd6d81",
                                                "text": "Tu as une curieuse conception de la vie !"
                                            },
                                            {
                                                "example_id": "a5bce4cb-2b5c-42bb-a5c2-5f1dcc44ebd6",
                                                "sense_id": "93b41b10-fb06-312f-b0bf-975f2afd6d81",
                                                "text": "Se faire une conception personnelle de telle ou telle chose."
                                            },
                                            {
                                                "example_id": "15f76eeb-90a5-4a37-8ff4-623070c49c4a",
                                                "sense_id": "93b41b10-fb06-312f-b0bf-975f2afd6d81",
                                                "text": "La férocité des conventionnels s'explique facilement par l'influence des conceptions que le Tiers État avait puisées dans les pratiques détestables de l'Ancien Régime."
                                            },
                                            {
                                                "example_id": "edaa0171-76da-40de-9bcb-2b6b7341a704",
                                                "sense_id": "93b41b10-fb06-312f-b0bf-975f2afd6d81",
                                                "text": "Beaucoup de mes interlocuteurs me signalent encore, […], la conception qu'on a du suffrage universel en ces contrées, où l'homme politique doit accepter d'être, dans la métropole, le protecteur, le soutien, le truchement de ses mandants."
                                            },
                                            {
                                                "example_id": "8234dd4d-0e8f-4fdc-9fe0-fb057eeecdda",
                                                "sense_id": "93b41b10-fb06-312f-b0bf-975f2afd6d81",
                                                "text": "La conception coranique de la politique n'est pas irénique. Elle est d'affrontement, ou plutôt manichéenne, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "427817c5-07d3-308e-977b-80e837b2cd13",
                                        "entry_id": "b3a74ba9-3c32-31b1-8b61-8d0c51bc39da",
                                        "glosses": [
                                            "Élaboration d’une idée ou d’un projet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8480be1c-e79c-3606-9ea8-7049977bf818",
                                        "entry_id": "b3a74ba9-3c32-31b1-8b61-8d0c51bc39da",
                                        "glosses": [
                                            "Manière dont une chose est conçue."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60bc822b-fd58-4b89-b788-a47be5f1dc44",
                                                "sense_id": "8480be1c-e79c-3606-9ea8-7049977bf818",
                                                "text": "En outre, la conception de l’autodéschisteur doit être telle que le blocage des dispositifs d’évacuation par la matière à éliminer soit impossible. Il doit être parfaitement automatique."
                                            },
                                            {
                                                "example_id": "e836b6bd-4fda-404a-b41c-508f905676b9",
                                                "sense_id": "8480be1c-e79c-3606-9ea8-7049977bf818",
                                                "text": "Pourquoi ne s'en prenaient-ils pas à ceux qui infligeaient des chocs électriques atroces à des chiens mais qui cafouillaient tellement dans la conception de leurs tests qu'on ne pouvait tirer aucune conclusion de leurs résultats ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1798a59-54cc-382d-b4cc-8fabf2065d74",
                                        "entry_id": "b3a74ba9-3c32-31b1-8b61-8d0c51bc39da",
                                        "glosses": [
                                            "Ensemble des études préliminaires à la fabrication d’un produit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
