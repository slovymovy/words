                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier a étalé une épaisse couche de <w>fumier</w> pour nourrir la terre avant l'hiver."
                        },
                        {
                            "text": "Dans cette ferme biologique, on utilise uniquement du <w>fumier</w> de cheval comme engrais."
                        }
                    ],
                    "common_phrases": [
                        "tas de fumier",
                        "épandre du fumier"
                    ]
                },
                {
                    "sense_id": "0860a677-8f3e-35a0-9ec7-96fa017915ca",
