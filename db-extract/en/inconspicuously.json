                                "example_id": "7a032dad-11f7-4a43-a1ff-d8ee3b42d436",
                                "sense_id": "23e928b3-ce3a-3fe2-8321-481846c4a8ee",
                                "text": "The detective sat inconspicuously in her car, across the parking lot, pretending to read the newspaper."
