                        "source_entry_id": "9e88fd7b-36ca-33cf-be02-de9025291d04",
                        "source_sense_id": "67b14106-eca4-39fe-bc88-b0f7033483ec",
                        "target_lang_word": "Begehung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begehung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbbae6cf-f982-3728-8693-1c4a6491d12b",
                                        "entry_id": "5e63ecd8-0db5-3ee4-834e-f83d1308b7b8",
                                        "glosses": [
                                            "das Betreten/Begehen (und Besichtigen) einer Fläche oder auch eines Raumes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e2c7802-b59e-437c-8cba-6402b6531322",
                                                "sense_id": "dbbae6cf-f982-3728-8693-1c4a6491d12b",
                                                "text": "Die Begehung der Freiflächen um das Klärwerk, also die Geruchsbegehung, erfolgte vom TüV genau in der Windschneise Richtung Neubaugebiet, aus der die Klagen zur Geruchsbelästigung stammen."
                                            },
                                            {
                                                "example_id": "4592281c-30ed-41e7-b6c4-8220bc817d94",
                                                "sense_id": "dbbae6cf-f982-3728-8693-1c4a6491d12b",
                                                "text": "Bei der Begehung der Räume stellte sich heraus, dass die Fenster der Räume zu wenig Sonnenlicht einlassen und viel zu dunkel sind."
                                            },
                                            {
                                                "example_id": "fbcb2cf4-9f67-4d3c-8aca-239017d6c128",
                                                "sense_id": "dbbae6cf-f982-3728-8693-1c4a6491d12b",
                                                "text": "„Alex Honnold, der wohl beste Freikletterer der aktuellen Kletterer-Generation hat sich im Sommer 2017 geistig und körperlich auf die Begehung der 975 Meter hohen Route ‚Freerider’ am El Capitan allein und ohne jegliche Hilfsmittel vorbereitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "76e7200b-c3f7-3d1f-824a-c3b844a37d81",
                                        "entry_id": "5e63ecd8-0db5-3ee4-834e-f83d1308b7b8",
                                        "glosses": [
                                            "Durchführung eines Festaktes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c05f1db8-b697-48fc-8d9c-099313f3631b",
                                                "sense_id": "76e7200b-c3f7-3d1f-824a-c3b844a37d81",
                                                "text": "Es fand eine öffentliche Feier zur Begehung des Todestages statt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9db1c8ab-3ac5-33fc-a4a6-a4e6a58df788",
                                        "entry_id": "5e63ecd8-0db5-3ee4-834e-f83d1308b7b8",
                                        "glosses": [
                                            "Realisierung einer verbotenen Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2530d64c-353d-4c6b-b1d1-86a45637124f",
                                                "sense_id": "9db1c8ab-3ac5-33fc-a4a6-a4e6a58df788",
                                                "text": "Die Begehung der Tat geschah unter Drogeneinfluss."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
