                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de908838-9c32-4031-a8ed-86f38da2d580",
                                "sense_id": "1c754897-ab16-3b56-be54-faf341230d54",
                                "text": "„Auch ließ Nader Schah in der konstitutionellen Verfassung von 1931 den Anspruch seiner Familie auf den afghanischen Thron festschreiben, um die Thronansprüche seines Clans gegenüber denen des Familienzweigs Amanullahs abzusichern.“"
                            },
                            {
                                "example_id": "b930bc13-5d55-4bc3-8d6d-e5b690b927bf",
                                "sense_id": "1c754897-ab16-3b56-be54-faf341230d54",
                                "text": "„Einen festen Entschluss hatte ich bereits gefasst: Ich würde niemals heiraten, und damit, da es ja keinen weiteren Familienzweig gab, würde ich den Fluch mit mir ins Grab nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
