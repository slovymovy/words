                "senses": [
                    {
                        "sense_id": "0574ab14-24bc-3dea-ac81-9d979a246901",
                        "entry_id": "bb11282b-b2d8-3594-8d2e-23e58ecc9e2e",
                        "glosses": [
                            "Autre orthographe, moins fréquente, de réutiliser (utiliser à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27faf5ac-5db3-4f78-bcaa-e5fc7898d64e",
                                "sense_id": "0574ab14-24bc-3dea-ac81-9d979a246901",
                                "text": "Vous pouvez donc entrer du texte grâce aux boîtes de dialogue et leur option default answer, mais vous ne pouvez pas récupérer le texte saisi et le ré-utiliser dans votre script."
                            },
                            {
                                "example_id": "baa50fa8-78b4-40d1-bca8-8071fa712744",
                                "sense_id": "0574ab14-24bc-3dea-ac81-9d979a246901",
                                "text": "Enfin dans les TRANSPOSITIONS, il pourra ré-utiliser celles-ci dans un autre contexte, d’autres situations, un autre environnement lexical, tout en révisant systématiquement les acquisitions antérieures."
                            },
                            {
                                "example_id": "7390c9e0-b369-490b-835c-9b769660dd7f",
                                "sense_id": "0574ab14-24bc-3dea-ac81-9d979a246901",
                                "text": "Mais pourquoi la démarche « néo-romantique », appelée parfois « post-moderne », se contente-t-elle de ré-utiliser ?"
                            }
                        ]
                    }
                ],
