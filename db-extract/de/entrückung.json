                "senses": [
                    {
                        "sense_id": "d82f0a58-2bcf-3af4-afd6-55cebe70b8c1",
                        "entry_id": "8974fcc3-51fc-39f2-8111-846472adf5d5",
                        "glosses": [
                            "das Entrücken, das Entrücktwerden; Entfernung/Versetzung in eine andere Welt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99857eb4-a7a8-4950-beb7-92cdff0e7b23",
                                "sense_id": "d82f0a58-2bcf-3af4-afd6-55cebe70b8c1",
                                "text": "„Anders die Anachoreten und Mystiker, die sich traditionell an einsame Orte zurückzuziehen pflegten und für die dem Berggang weiterhin die Bedeutung einer religiös motivierten Entrückung und Vereinzelung zukommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76d7ea48-b97f-4205-ba7b-68f6f532b1ae",
                        "source_entry_id": "8974fcc3-51fc-39f2-8111-846472adf5d5",
                        "source_sense_id": "d82f0a58-2bcf-3af4-afd6-55cebe70b8c1",
                        "source_sense_description": "das Entrücken, das Entrücktwerden; Entfernung/Versetzung in eine andere Welt",
                        "target_lang_word": "rapture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rapture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f45c400-7077-32e0-b7ec-068f97a0bc6b",
                                        "entry_id": "10e95f81-7bea-3846-b802-9f82c587b970",
                                        "glosses": [
                                            "Extreme pleasure, happiness or excitement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad745881-ec41-405f-9060-9d8dc5ae9594",
                                                "sense_id": "3f45c400-7077-32e0-b7ec-068f97a0bc6b",
                                                "text": "Music, when thus applied, raises noble hints in the mind of the hearer, and fills it with great conceptions. It strengthens devotion, and advances praise into rapture[…]"
                                            },
                                            {
                                                "example_id": "5fe34757-1a6b-49d3-8879-290e5e5a34c1",
                                                "sense_id": "3f45c400-7077-32e0-b7ec-068f97a0bc6b",
                                                "text": "Sunderland’s right-back, Santiago Vergini, inadvertently gave Southampton the lead by lashing the ball into his own net in the 12th minute, and that signalled the start of a barmy encounter that had home fans in raptures and Sunderland in tatters."
                                            },
                                            {
                                                "example_id": "822d2c35-0676-4c12-881d-9015645bd5d0",
                                                "sense_id": "3f45c400-7077-32e0-b7ec-068f97a0bc6b",
                                                "text": "My heart filled with rapture then, and it fills now as it has each of the countless times I have recalled those dear words, as it shall fill always until death has claimed me. I may never see her again; she may not know how I love her--she may question, she may doubt; but always true and steady, and warm with the fires of love my heart beats for the girl who said that night: \"I love you beyond all conception.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2337e0f4-6df7-3ec5-a6e1-7940111e4fe7",
                                        "entry_id": "10e95f81-7bea-3846-b802-9f82c587b970",
                                        "glosses": [
                                            "Alternative letter-case form of Rapture."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b02efda-3c7d-49d0-8ae0-ed7a78889a8f",
                                                "sense_id": "2337e0f4-6df7-3ec5-a6e1-7940111e4fe7",
                                                "text": "In the last week, believers have linked Charlie Kirk’s assassination to the rapture theory: some on TikTok have suggested that Kirk, who in death became a martyr for Christian nationalists and whose memorial service veered into religious revival territory, could be resurrected during the rapture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9480681a-18fa-3049-9b3c-0b58166e7d24",
                                        "entry_id": "10e95f81-7bea-3846-b802-9f82c587b970",
                                        "glosses": [
                                            "The act of kidnapping or abducting, especially the forceful carrying off of a woman."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6151a335-2cca-3a52-8d55-8361b72410a4",
                                        "entry_id": "10e95f81-7bea-3846-b802-9f82c587b970",
                                        "glosses": [
                                            "Rape; ravishment; sexual violation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b05d9612-0153-3ab7-a90e-52f48a1d56c9",
                                        "entry_id": "10e95f81-7bea-3846-b802-9f82c587b970",
                                        "glosses": [
                                            "The act of carrying, conveying, transporting or sweeping along by force of movement; the force of such movement; the fact of being carried along by such movement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa265ade-d555-41d1-9e3d-35f99e1f88e1",
                                                "sense_id": "b05d9612-0153-3ab7-a90e-52f48a1d56c9",
                                                "text": "That 'gainst a rock, or flat, her keel did dash / With headlong rapture."
                                            },
                                            {
                                                "example_id": "25fa6ab9-5b96-4b9a-84b1-c25799b30243",
                                                "sense_id": "b05d9612-0153-3ab7-a90e-52f48a1d56c9",
                                                "text": "With the rapture of great winds to blow / About earth's shaken coignes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "015e08c6-9f1d-30cb-9c1b-bfb7e92bcd9a",
                                        "entry_id": "10e95f81-7bea-3846-b802-9f82c587b970",
                                        "glosses": [
                                            "A spasm; a fit; a syncope; delirium."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73bd1ce6-3d81-4a2b-b96e-b85332272205",
                                                "sense_id": "015e08c6-9f1d-30cb-9c1b-bfb7e92bcd9a",
                                                "text": "Your pratling nurse\nInto a rapture lets her baby cry"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rapture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7f021bd-9cdc-31ca-b259-3737270838cf",
                                        "entry_id": "e1dfada5-ef71-3d34-ae1b-3dd05b8bd7cf",
                                        "glosses": [
                                            "To cause to experience great happiness or excitement."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c125cd6-1937-4740-a12f-09f20a4aa91d",
                                                "sense_id": "f7f021bd-9cdc-31ca-b259-3737270838cf",
                                                "text": "She raptured me in summer by giving me Fitzgerald's flawed and gorgeous masterpiece, the book that held his tortured heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15b80e37-5588-3065-b58c-1fd73829f981",
                                        "entry_id": "e1dfada5-ef71-3d34-ae1b-3dd05b8bd7cf",
                                        "glosses": [
                                            "To experience great happiness or excitement."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0333c47-45ed-3bbc-a602-17468ae2639a",
                                        "entry_id": "e1dfada5-ef71-3d34-ae1b-3dd05b8bd7cf",
                                        "glosses": [
                                            "To take (someone) off the Earth and bring (them) to Heaven as part of the Rapture."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "872d4dfa-3e90-47d1-a162-bb92d95b5e16",
                                                "sense_id": "e0333c47-45ed-3bbc-a602-17468ae2639a",
                                                "text": "\"If she's raptured,\" Ellen said to them on the fifth night after Marylee's disappearance, as they sat on the roof of the building on their old beanbags and rusting garden furniture hauled up from the Museum, \"if that's what happened to her, then […]\""
                                            },
                                            {
                                                "example_id": "fa5a2601-9d56-4abc-a28f-f6af1cc03ce3",
                                                "sense_id": "e0333c47-45ed-3bbc-a602-17468ae2639a",
                                                "text": "These fiction books told the story of some church people who were raptured but focused on the people who were not raptured."
                                            },
                                            {
                                                "example_id": "06dd0c15-8203-4350-9830-a38ac8ecdf9e",
                                                "sense_id": "e0333c47-45ed-3bbc-a602-17468ae2639a",
                                                "text": "The third person raptured by God into heaven was Elijah […]"
                                            },
                                            {
                                                "example_id": "84faa40d-dff7-4317-bede-d85608835131",
                                                "sense_id": "e0333c47-45ed-3bbc-a602-17468ae2639a",
                                                "text": "“Praise the Lord, he's been raptured.” Good grief. “I don't think so, Mrs. Farris. 'Course, I'm Episcopalian, and I'm pretty sure we don't get raptured. But, Baptists get raptured, don't they?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3c4d9c9-9c1f-320b-a575-60bcf131eb5c",
                                        "entry_id": "e1dfada5-ef71-3d34-ae1b-3dd05b8bd7cf",
                                        "glosses": [
                                            "To take part in the Rapture; to leave Earth and go to Heaven as part of the Rapture."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "071de4a6-5db9-3e11-9d60-2d3b8927818c",
                                        "entry_id": "e1dfada5-ef71-3d34-ae1b-3dd05b8bd7cf",
                                        "glosses": [
                                            "To state (something, transitive) or talk (intransitive) rapturously."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec5d5e7b-8ed2-4745-88a1-ff9cf4d58c8d",
                                                "sense_id": "071de4a6-5db9-3e11-9d60-2d3b8927818c",
                                                "text": "And then the flowers! May-day indeed. Hester had been in Switzerland at the end of June, years on years before, and often had she raptured to Effie about the day's ride, in which they collected a hundred varieties of flowers, most of them new to them."
                                            },
                                            {
                                                "example_id": "f2a27842-fad0-4d65-b41c-b271583a4fdf",
                                                "sense_id": "071de4a6-5db9-3e11-9d60-2d3b8927818c",
                                                "text": "Pulling her leggings down over unshaven legs, she raptured \"I'm dry!\" to her audience."
                                            },
                                            {
                                                "example_id": "6cc4c748-669f-4a11-988b-b49250c3535d",
                                                "sense_id": "071de4a6-5db9-3e11-9d60-2d3b8927818c",
                                                "text": "They're called angora with wonderfully long, soft fleece,” she raptured on about her first venture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
