                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f40d0f6-7fe9-4cdc-b92d-a2c3a9c176a9",
                                                "sense_id": "04c5117d-00d0-3ea0-a229-a95ae1f1d2d1",
                                                "text": "„An der Spitze der Kolonne trabt der dicke Feldwebel.“"
                                            },
                                            {
                                                "example_id": "526218db-8294-4150-8819-24f47b3d2bcd",
                                                "sense_id": "04c5117d-00d0-3ea0-a229-a95ae1f1d2d1",
                                                "text": "„Fabian kam mit dem Feldwebel und setzte sich dazu.“"
                                            },
                                            {
                                                "example_id": "cc885d1a-bf71-4ef8-98ac-c1d1cdd7a41e",
                                                "sense_id": "04c5117d-00d0-3ea0-a229-a95ae1f1d2d1",
                                                "text": "„Dieser Reisende heißt Wagner und ist ein ehemaliger Feldwebel von den Zweiundfünfzigern, die vor dem Kriege in Cottbus kaserniert waren.“"
                                            },
                                            {
                                                "example_id": "84e9cad1-85ba-4743-8207-0801c1c157c8",
                                                "sense_id": "04c5117d-00d0-3ea0-a229-a95ae1f1d2d1",
                                                "text": "„Ein deutscher Feldwebel stand draußen – und neben ihm zwei Riesenkerle in Uniformen des SD.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b1b00ec0-03b3-38bb-b19e-f3e2feea59d0",
