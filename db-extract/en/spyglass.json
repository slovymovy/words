                    },
                    {
                        "translation_id": "ae5df7f3-2910-4876-a7a0-6adab7fddc1c",
                        "source_entry_id": "1e5f197b-73d7-3ef5-8b93-36488d94fb3a",
                        "source_sense_description": "portable telescope",
                        "target_lang_word": "longue-vue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "longue-vue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a8b9a78-af6c-31f4-8cd8-03b5bc1b6947",
                                        "entry_id": "d082287d-7c33-3df1-9c6f-9be7f5eafff6",
                                        "glosses": [
                                            "Instrument d’optique monoculaire destiné à obtenir une vision rapprochée des objets éloignés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9df520e-8fd4-4493-8109-b1c991e8d481",
                                                "sense_id": "2a8b9a78-af6c-31f4-8cd8-03b5bc1b6947",
                                                "text": "Tout est dit, s’écria dans un accent de désespoir le capitaine, qui, ayant braqué sa longue-vue, ne distingua rien du côté de la terre…"
                                            },
                                            {
                                                "example_id": "452b275e-f512-4a82-b60d-fab472abf2f8",
                                                "sense_id": "2a8b9a78-af6c-31f4-8cd8-03b5bc1b6947",
                                                "text": "la fameuse longue-vue de Paganel ne lui donna qu’une vague idée de ces rivages américains."
                                            },
                                            {
                                                "example_id": "3469b682-7997-4eda-b6e0-f5041afefafc",
                                                "sense_id": "2a8b9a78-af6c-31f4-8cd8-03b5bc1b6947",
                                                "text": "[…] du capitaine commandant le fort qui, revêtu de son grand uniforme, une longue-vue à la main et les bras derrière le dos, se promenait à grands pas sur les glacis du fortin."
                                            },
                                            {
                                                "example_id": "8e845db4-af7a-412d-a33f-610aba6a930d",
                                                "sense_id": "2a8b9a78-af6c-31f4-8cd8-03b5bc1b6947",
                                                "text": "Du reste, pour mieux me tromper moi-même, j’avais soin de cacher, avec mes doigts repliés en longue-vue, tout ce qui pouvait me gâter cet ensemble désert : une vieille ferme là-bas, avec un coin de vigne labourée et un bout de chemin."
                                            },
                                            {
                                                "example_id": "f3221177-ac06-404f-bf15-b6463d45c925",
                                                "sense_id": "2a8b9a78-af6c-31f4-8cd8-03b5bc1b6947",
                                                "text": "[…] la longue-vue de marine qui avait dû souffrir des tempêtes du cap Horn, car on entendait tinter ses lentilles comme autant de grelots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b12898b-7e30-4afa-8839-148652fc737a",
                        "source_entry_id": "1e5f197b-73d7-3ef5-8b93-36488d94fb3a",
