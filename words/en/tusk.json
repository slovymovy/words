{
    "word_family": [
        "tusked",
        "tusker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9ae67f5c-ebbc-31d3-9c94-221b2f823654",
                    "sense_definition": "One of a pair of long, pointed teeth that grow outside the mouth of animals like elephants or walruses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elephant used its long <w>tusks</w> to dig for water in the dry ground.",
                            "target_lang_translations": {
                                "ru": "Слон использовал свои длинные <w>бивни</w>, чтобы выкопать воду в сухой земле."
                            }
                        },
                        {
                            "text": "Poachers often hunt elephants illegally just to sell their valuable ivory <w>tusks</w>.",
                            "target_lang_translations": {
                                "ru": "Браконьеры часто незаконно охотятся на слонов только ради того, чтобы продать их ценные <w>бивни</w> из слоновой кости."
                            }
                        }
                    ],
                    "synonyms": [
                        "ivory"
                    ],
                    "common_phrases": [
                        "elephant tusks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из пары длинных заостренных зубов, выступающих изо рта у таких животных, как слоны или моржи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бивень",
                                "target_lang_sense_clarification": "основной термин для обозначения длинных выступающих зубов слонов, моржей и нарвалов"
                            },
                            {
                                "target_lang_word": "клык",
                                "target_lang_sense_clarification": "используется как синоним бивня в разговорной речи или для обозначения крупных зубов хищников"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcc607eb-4a30-3fb7-ad47-ba61c38dab73",
                    "sense_definition": "A sharp, pointed projection.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rock formation had a sharp <w>tusk</w> of stone pointing toward the sky.",
                            "target_lang_translations": {
                                "ru": "Скальное образование имело острый каменный <w>шип</w>, направленный в небо."
                            }
                        },
                        {
                            "text": "He climbed over the jagged <w>tusk</w> of metal sticking out from the wall.",
                            "target_lang_translations": {
                                "ru": "Он перелез через острый металлический <w>выступ</w>, торчащий из стены."
                            }
                        }
                    ],
                    "synonyms": [
                        "spike",
                        "point"
                    ],
                    "target_lang_definitions": {
                        "ru": "Острый, заостренный выступ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шип",
                                "target_lang_sense_clarification": "острый, колючий выступ"
                            },
                            {
                                "target_lang_word": "острие",
                                "target_lang_sense_clarification": "заостренная часть предмета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7b99d4d-d3a6-3f7c-9591-b22f90393ec8",
                    "sense_definition": "A type of fish, also known as the torsk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>tusk</w> is a deep-water fish often found in the North Atlantic.",
                            "target_lang_translations": {
                                "ru": "<w>Менёк</w> — это глубоководная рыба, часто встречающаяся в Северной Атлантике."
                            }
                        },
                        {
                            "text": "Local fishermen caught a large <w>tusk</w> while fishing near the rocky coast.",
                            "target_lang_translations": {
                                "ru": "Местные рыбаки поймали крупного <w>менька</w> во время рыбалки у скалистого побережья."
                            }
                        }
                    ],
                    "synonyms": [
                        "torsk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид рыбы, также известный как менёк."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "менёк",
                                "target_lang_sense_clarification": "название морской рыбы семейства тресковых"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "95a59864-cdae-3ee3-9e2f-4f8efecb958f",
                    "sense_definition": "To pierce or wound someone or something using tusks.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry boar tried to <w>tusk</w> the hunter who had cornered it.",
                            "target_lang_translations": {
                                "ru": "Разъяренный кабан попытался <w>пронзить бивнями</w> охотника, который загнал его в угол."
                            }
                        },
                        {
                            "text": "The wild animal <w>tusked</w> the fence, leaving deep holes in the wood.",
                            "target_lang_translations": {
                                "ru": "Дикое животное <w>пробило бивнями</w> забор, оставив глубокие дыры в дереве."
                            }
                        }
                    ],
                    "synonyms": [
                        "gore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проткнуть или ранить кого-либо или что-либо с помощью бивней."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пронзить бивнем",
                                "target_lang_sense_clarification": "описание действия нанесения раны бивнем"
                            },
                            {
                                "target_lang_word": "забодать",
                                "target_lang_sense_clarification": "удар рогами или бивнями"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "79bc492a-9e52-32fe-b157-30e09cbea9cb",
                    "sense_definition": "A surname of Kashubian origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Donald <w>Tusk</w> is a well-known European politician.",
                            "target_lang_translations": {
                                "ru": "Дональд <w>Туск</w> — известный европейский политик."
                            }
                        },
                        {
                            "text": "The family name <w>Tusk</w> has roots in the Kashubian region.",
                            "target_lang_translations": {
                                "ru": "Фамилия <w>Туск</w> имеет корни в кашубском регионе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия кашубского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Туск",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}