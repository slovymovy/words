                        "rêver en dormant"
                    ]
                },
                {
                    "sense_id": "f72f70dc-72e0-3764-b27c-19d6a23337cd",
                    "sense_definition": "Désirer ardemment, souhaiter profondément la réalisation de quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "desir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'elle est petite, elle <w>rêve</w> de devenir médecin."
                        },
                        {
                            "text": "Les magnifiques plages de cette île font <w>rêver</w> beaucoup de touristes."
                        }
                    ],
                    "common_phrases": [
