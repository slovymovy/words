                                "example_id": "45b38548-8ea5-4a6f-941f-40322557b453",
                                "sense_id": "779b8a11-2d4d-3d25-9d4e-54a61b9a2e1b",
                                "text": "The noisemakers spread from soccer to the N.B.A. and other sports."
                            },
