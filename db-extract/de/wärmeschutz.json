                "senses": [
                    {
                        "sense_id": "7af84908-b97b-355d-a69b-c68a2d476f09",
                        "entry_id": "b8d92277-79d1-3fb2-82f7-9942d501f409",
                        "glosses": [
                            "Gesamtheit aller Maßnahmen, die dem Erhalt von Wärme dienen"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "ba166aa3-2ac6-4de2-b364-c6e3094a96fd",
                                "sense_id": "7af84908-b97b-355d-a69b-c68a2d476f09",
                                "text": "Um die Heizkosten eines Hauses in moderater Höhe zu gestalten, sollte der Wärmeschutz bereits bei der Planung und späteren Realisierung beachtet werden."
                            },
                            {
                                "example_id": "bd51c0b9-208f-4b1c-9a27-d6c717a19780",
                                "sense_id": "7af84908-b97b-355d-a69b-c68a2d476f09",
                                "text": "Es ist die Aufgabe des Wärmeschutzes um einen Warmwasserspeicher, den Wärmeverlust zu minimieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "703ae68c-fb4d-3f7c-b3ca-4fa06c81b925",
                        "entry_id": "b8d92277-79d1-3fb2-82f7-9942d501f409",
                        "glosses": [
                            "Gesamtheit aller Maßnahmen, die dem Schutz vor Wärme dienen"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "31c85836-07d6-4289-bdb1-0141d6053c31",
                                "sense_id": "703ae68c-fb4d-3f7c-b3ca-4fa06c81b925",
                                "text": "Eine Kühltruhe sollte eine möglichst gute Isolierung haben, denn dieser Wärmeschutz minimiert die Stromkosten für die nötige Kälteerzeugung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
