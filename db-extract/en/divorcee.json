                    {
                        "translation_id": "d228160d-5dfb-4a99-ac57-2fcd7161c308",
                        "source_entry_id": "1240c301-586f-35ce-8520-f5b22213488c",
                        "source_sense_id": "eed83c29-4d55-33c0-acbd-56acc3a55c1c",
