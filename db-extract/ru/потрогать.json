                ],
                "senses": [
                    {
                        "sense_id": "3c143d47-9eba-35d0-b1b3-9404aa71eda5",
                        "entry_id": "f9433179-3518-3dff-9f2c-0039f5f311fa",
                        "glosses": [
                            "совершить действие, выраженное гл. трогать; провести некоторое время, совершая такое действие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b73f35ee-4383-4b9c-bc56-bea9066f1cf2",
                                "sense_id": "3c143d47-9eba-35d0-b1b3-9404aa71eda5",
                                "text": "Кто-то подошёл к витрине, взглянул на меня и потрогал висячий замочек."
                            },
                            {
                                "example_id": "37c2b598-b9d9-4841-a16b-05c12cc1773a",
                                "sense_id": "3c143d47-9eba-35d0-b1b3-9404aa71eda5",
                                "text": "Но зато твои волосы так чисты и тонки и сходятся сзади в узел с таким аккуратным, наивным и деловитым выражением, что хочется тихонько потрогать их пальцами."
                            }
                        ]
                    }
