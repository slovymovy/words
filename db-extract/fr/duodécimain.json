                ],
                "senses": [
                    {
                        "sense_id": "5230538d-1609-3d18-9fcb-8c034dd031e8",
                        "entry_id": "bb0a5197-3093-3ed1-bde8-fe3dce7c2ca2",
                        "glosses": [
                            "Partisan du chiisme duodécimain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3acea6a-a93b-48cf-b8e2-16cf4e81b8ca",
                                "sense_id": "5230538d-1609-3d18-9fcb-8c034dd031e8",
                                "text": "Ces chiites ont choisi de suivre Mousa, le fils cadet de Jafar alSadiq, le sixième imam mort en 765. Mousa est donc le septième imam des duodécimains."
                            },
                            {
                                "example_id": "b476ef86-9d0b-48a4-8c3d-dc67208dc76c",
                                "sense_id": "5230538d-1609-3d18-9fcb-8c034dd031e8",
                                "text": "Quant à la majorité des chiites, elle accepte l'existence de douze imams, constituant le troisième et principal courant du chiisme : les duodécimains."
                            }
                        ]
                    }
                ],
