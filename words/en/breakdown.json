{
    "word_family": [
        "break",
        "breakage",
        "breaker",
        "breakup",
        "breakout",
        "breakthrough",
        "breakaway",
        "break-in"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00af0104-7fbc-336c-ae1c-304c7cc3642a",
                    "sense_definition": "A mechanical failure, particularly of a vehicle or machine, causing it to stop working.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We missed the start of the concert because of a <w>breakdown</w> on the highway.",
                            "target_lang_translations": {
                                "ru": "Мы пропустили начало концерта из-за <w>поломки</w> на шоссе.",
                                "zh": "因为高速公路上车辆<w>抛锚</w>，我们错过了音乐会的开场。"
                            }
                        },
                        {
                            "text": "Regular maintenance is essential to prevent a sudden <w>breakdown</w> of the heating system.",
                            "target_lang_translations": {
                                "ru": "Регулярное обслуживание необходимо для предотвращения внезапной <w>поломки</w> системы отопления.",
                                "zh": "定期维护对于防止供暖系统突然<w>故障</w>至关重要。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "car breakdown",
                        "mechanical breakdown",
                        "breakdown service",
                        "breakdown truck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическая неисправность, особенно транспортного средства или машины, приводящая к остановке работы.",
                        "zh": "机械故障，尤指车辆或机器停止工作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поломка",
                                "target_lang_sense_clarification": "механическая неисправность"
                            },
                            {
                                "target_lang_word": "авария",
                                "target_lang_sense_clarification": "серьезное повреждение или сбой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "故障",
                                "target_lang_sense_clarification": "机器或系统运行异常"
                            },
                            {
                                "target_lang_word": "抛锚",
                                "target_lang_sense_clarification": "车辆因故障停驶"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fbbc250-1732-30de-8302-c1af9700fb2c",
                    "sense_definition": "A detailed list or analysis that shows the separate parts, figures, or costs that make up a whole.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invoice provides a clear <w>breakdown</w> of all the charges included in the total price.",
                            "target_lang_translations": {
                                "ru": "В счете представлена четкая <w>детализация</w> всех расходов, включенных в общую стоимость.",
                                "zh": "发票提供了总价中所有费用的清晰<w>明细</w>。"
                            }
                        },
                        {
                            "text": "Can you send me a detailed <w>breakdown</w> of the survey results by age group?",
                            "target_lang_translations": {
                                "ru": "Можете ли вы прислать мне подробную <w>разбивку</w> результатов опроса по возрастным группам?",
                                "zh": "你能发给我一份按年龄组划分的调查结果详细<w>细分</w>吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cost breakdown",
                        "detailed breakdown",
                        "breakdown of expenses",
                        "budget breakdown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подробный список или анализ, показывающий отдельные части, цифры или расходы, составляющие целое.",
                        "zh": "详细的列表或分析，显示构成整体的各个部分、数字或成本。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбивка",
                                "target_lang_sense_clarification": "разделение на категории или части"
                            },
                            {
                                "target_lang_word": "детализация",
                                "target_lang_sense_clarification": "подробный отчет"
                            },
                            {
                                "target_lang_word": "анализ",
                                "target_lang_sense_clarification": "исследование составных частей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "明细",
                                "target_lang_sense_clarification": "详细的清单或分类"
                            },
                            {
                                "target_lang_word": "细分",
                                "target_lang_sense_clarification": "将整体拆解为部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dce9cefe-0145-3030-addc-fb65cbe666f0",
                    "sense_definition": "A sudden collapse in a person's mental health, often caused by severe stress or emotional pressure.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After months of overwork and lack of sleep, he suffered a nervous <w>breakdown</w>.",
                            "target_lang_translations": {
                                "ru": "После месяцев переработки и недосыпания у него случился <w>нервный срыв</w>.",
                                "zh": "经过几个月的过度劳累和睡眠不足，他<w>精神崩溃</w>了。"
                            }
                        },
                        {
                            "text": "She took a long holiday to recover fully from her recent mental <w>breakdown</w>.",
                            "target_lang_translations": {
                                "ru": "Она взяла длинный отпуск, чтобы полностью восстановиться после недавнего <w>нервного срыва</w>.",
                                "zh": "她休了一个长假，以便从最近的<w>精神崩溃</w>中完全恢复。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nervous breakdown",
                        "mental breakdown",
                        "suffer a breakdown",
                        "have a breakdown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное ухудшение психического здоровья человека, часто вызванное сильным стрессом или эмоциональным давлением.",
                        "zh": "人的心理健康突然崩溃，通常由严重的压力或情绪负担引起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нервный срыв",
                                "target_lang_sense_clarification": "психологическое расстройство"
                            },
                            {
                                "target_lang_word": "срыв",
                                "target_lang_sense_clarification": "краткая форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精神崩溃",
                                "target_lang_sense_clarification": "心理状态严重失调"
                            },
                            {
                                "target_lang_word": "神经衰弱",
                                "target_lang_sense_clarification": "心理压力导致的健康问题"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "717cd497-a8e8-35a6-a5b7-9fed9684ddab",
                    "sense_definition": "A failure of a relationship, discussion, or system to continue or function correctly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strike was caused by a complete <w>breakdown</w> in talks between the union and the management.",
                            "target_lang_translations": {
                                "ru": "Забастовка была вызвана полным <w>срывом</w> переговоров между профсоюзом и руководством.",
                                "zh": "这次罢工是由工会与管理层之间谈判的彻底<w>破裂</w>引起的。"
                            }
                        },
                        {
                            "text": "A <w>breakdown</w> of law and order occurred in the city following the disaster.",
                            "target_lang_translations": {
                                "ru": "После катастрофы в городе произошел <w>развал</w> правопорядка.",
                                "zh": "灾难发生后，城市里的治安陷入了<w>瘫痪</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "breakdown in communication",
                        "marriage breakdown",
                        "breakdown of negotiations",
                        "breakdown of order"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекращение отношений, переговоров или правильного функционирования системы.",
                        "zh": "关系、讨论或系统的失败，无法继续或正常运作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срыв",
                                "target_lang_sense_clarification": "переговоров или планов"
                            },
                            {
                                "target_lang_word": "развал",
                                "target_lang_sense_clarification": "системы или порядка"
                            },
                            {
                                "target_lang_word": "распад",
                                "target_lang_sense_clarification": "отношений или семьи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "破裂",
                                "target_lang_sense_clarification": "关系或谈判的终止"
                            },
                            {
                                "target_lang_word": "瘫痪",
                                "target_lang_sense_clarification": "系统停止运作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5db399bc-f3a5-37f9-8de8-2246bcee39fe",
                    "sense_definition": "The chemical or biological process of separating a substance into simpler compounds or elements.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bacteria are responsible for the <w>breakdown</w> of organic matter in the soil.",
                            "target_lang_translations": {
                                "ru": "Бактерии отвечают за <w>разложение</w> органических веществ в почве.",
                                "zh": "细菌负责土壤中有机物质的<w>分解</w>。"
                            }
                        },
                        {
                            "text": "Enzymes in the stomach assist in the rapid <w>breakdown</w> of food into energy.",
                            "target_lang_translations": {
                                "ru": "Ферменты в желудке способствуют быстрому <w>расщеплению</w> пищи для получения энергии.",
                                "zh": "胃里的酶有助于将食物快速<w>分解</w>为能量。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chemical breakdown",
                        "breakdown of glucose",
                        "breakdown of proteins"
                    ],
                    "target_lang_definitions": {
                        "ru": "Химический или биологический процесс разделения вещества на более простые соединения или элементы.",
                        "zh": "将物质分离成更简单化合物或元素的化学或生物过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расщепление",
                                "target_lang_sense_clarification": "химических связей или веществ"
                            },
                            {
                                "target_lang_word": "разложение",
                                "target_lang_sense_clarification": "распад органики"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分解",
                                "target_lang_sense_clarification": "物质的化学或生物降解"
                            },
                            {
                                "target_lang_word": "降解",
                                "target_lang_sense_clarification": "有机物的化学分解"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4ee3989-3f4a-3278-afc0-85c884ccfc60",
                    "sense_definition": "A section of a piece of music where the arrangement is stripped down or the rhythm changes, often featuring a solo or a heavy beat.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd cheered wildly when the band played the heavy <w>breakdown</w> at the end of the song.",
                            "target_lang_translations": {
                                "ru": "Толпа дико ликовала, когда группа заиграла тяжелый <w>брейкдаун</w> в конце песни.",
                                "zh": "当乐队在歌曲结尾演奏那段强烈的<w>间奏</w>时，人群疯狂欢呼。"
                            }
                        },
                        {
                            "text": "The drummer performed an impressive solo during the instrumental <w>breakdown</w>.",
                            "target_lang_translations": {
                                "ru": "Барабанщик исполнил впечатляющее соло во время инструментального <w>проигрыша</w>.",
                                "zh": "鼓手在器乐<w>间奏</w>期间表演了一段令人印象深刻的独奏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "percussion break"
                    ],
                    "common_phrases": [
                        "heavy breakdown",
                        "guitar breakdown",
                        "instrumental breakdown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть музыкального произведения, где аранжировка упрощается или меняется ритм, часто с соло или тяжелым битом.",
                        "zh": "音乐作品中编曲简化或节奏改变的部分，通常包含独奏或强烈的节拍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брейк",
                                "target_lang_sense_clarification": "музыкальный термин"
                            },
                            {
                                "target_lang_word": "проигрыш",
                                "target_lang_sense_clarification": "инструментальная вставка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "间奏",
                                "target_lang_sense_clarification": "乐曲中的过渡或独奏部分"
                            },
                            {
                                "target_lang_word": "变奏",
                                "target_lang_sense_clarification": "节奏或编曲的改变"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "537cace4-66d1-35f7-9f75-2ec4e78ad1b3",
                    "sense_definition": "The period of play in rugby immediately after a tackle when players compete for possession of the ball.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team needs to improve their discipline and speed at the <w>breakdown</w> to win the match.",
                            "target_lang_translations": {
                                "ru": "Команде нужно улучшить дисциплину и скорость на <w>брейкдауне</w>, чтобы выиграть матч.",
                                "zh": "球队需要提高在<w>争球</w>时的纪律性和速度才能赢得比赛。"
                            }
                        },
                        {
                            "text": "The referee penalized the defending player for not rolling away at the <w>breakdown</w>.",
                            "target_lang_translations": {
                                "ru": "Судья оштрафовал защитника за то, что тот не откатился в сторону на <w>брейкдауне</w>.",
                                "zh": "裁判因防守球员在<w>争球</w>时没有滚开而对其进行了处罚。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "at the breakdown",
                        "win the breakdown",
                        "dominate the breakdown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игровой момент в регби сразу после захвата, когда игроки борются за владение мячом.",
                        "zh": "橄榄球中擒抱后球员争夺球权的比赛阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брейкдаун",
                                "target_lang_sense_clarification": "термин в регби"
                            },
                            {
                                "target_lang_word": "борьба за мяч",
                                "target_lang_sense_clarification": "описание действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "争球",
                                "target_lang_sense_clarification": "橄榄球中的球权争夺"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}