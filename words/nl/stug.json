{
    "word_family": [
        "stugheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd64c792-8eee-310f-84d9-91575f8aec83",
                    "sense_definition": "moeilijk te buigen of te bewerken; niet soepel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het valt niet mee om die <w>stugge</w> vacht van de hond goed te borstelen.",
                            "target_lang_translations": {
                                "en": "It is not easy to properly brush that <w>stiff</w> coat of the dog.",
                                "pl": "Nie jest łatwo dobrze wyszczotkować tę <w>sztywną</w> sierść psa.",
                                "de": "Es ist gar nicht so einfach, das <w>steife</w> Fell des Hundes gründlich zu bürsten."
                            }
                        },
                        {
                            "text": "Nieuwe leren schoenen kunnen in het begin erg <w>stug</w> aanvoelen aan je voeten.",
                            "target_lang_translations": {
                                "en": "New leather shoes can feel very <w>rigid</w> on your feet at first.",
                                "pl": "Nowe skórzane buty mogą na początku wydawać się bardzo <w>sztywne</w> na stopach.",
                                "de": "Neue Lederschuhe können sich am Anfang an den Füßen sehr <w>starr</w> anfühlen."
                            }
                        }
                    ],
                    "synonyms": [
                        "stijf",
                        "onbuigzaam",
                        "weerbarstig"
                    ],
                    "antonyms": [
                        "flexibel"
                    ],
                    "common_phrases": [
                        "stugge vacht",
                        "stug leer"
                    ],
                    "target_lang_definitions": {
                        "en": "difficult to bend or work with; not flexible or supple",
                        "pl": "trudny do zgięcia lub obróbki; nieelastyczny",
                        "de": "schwer zu biegen oder zu bearbeiten; nicht geschmeidig oder flexibel"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stiff",
                                "target_lang_sense_clarification": "not easily bent or changed in shape"
                            },
                            {
                                "target_lang_word": "rigid",
                                "target_lang_sense_clarification": "unable to bend or be forced out of shape"
                            },
                            {
                                "target_lang_word": "tough",
                                "target_lang_sense_clarification": "strong and difficult to cut or break, like leather or hair"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sztywny",
                                "target_lang_sense_clarification": "niepodatny na zginanie, twardy"
                            },
                            {
                                "target_lang_word": "twardy",
                                "target_lang_sense_clarification": "trudny do przecięcia lub złamania, np. o skórze lub włosach"
                            },
                            {
                                "target_lang_word": "nieelastyczny",
                                "target_lang_sense_clarification": "niepodatny na odkształcenia"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "steif",
                                "target_lang_sense_clarification": "unbiegsam, fest, wenig elastisch"
                            },
                            {
                                "target_lang_word": "starr",
                                "target_lang_sense_clarification": "nicht biegsam oder nachgiebig"
                            },
                            {
                                "target_lang_word": "hart",
                                "target_lang_sense_clarification": "fest, zäh (z. B. Leder oder Fell)"
                            },
                            {
                                "target_lang_word": "spröde",
                                "target_lang_sense_clarification": "ungeschmeidig, rau"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9256a31-6b9f-3a30-8343-214f028db7c4",
                    "sense_definition": "niet erg vriendelijk of bereid om mee te werken; gereserveerd in de omgang",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>stugge</w> houding van de vakbonden maakte de onderhandelingen erg lastig.",
                            "target_lang_translations": {
                                "en": "The <w>unyielding</w> attitude of the unions made the negotiations very difficult.",
                                "pl": "<w>Nieustępliwa</w> postawa związków zawodowych sprawiła, że negocjacje były bardzo trudne.",
                                "de": "Die <w>unbeugsame</w> Haltung der Gewerkschaften machte die Verhandlungen sehr schwierig."
                            }
                        },
                        {
                            "text": "Hij gaf een <w>stug</w> antwoord en keek de andere kant op.",
                            "target_lang_translations": {
                                "en": "He gave a <w>sullen</w> answer and looked the other way.",
                                "pl": "Odpowiedział <w>szorstko</w> i odwrócił wzrok.",
                                "de": "Er gab eine <w>mürrische</w> Antwort und schaute in die andere Richtung."
                            }
                        }
                    ],
                    "synonyms": [
                        "stuurs",
                        "onvriendelijk",
                        "onbuigzaam",
                        "stijf"
                    ],
                    "antonyms": [
                        "inschikkelijk",
                        "toegeeflijk",
                        "welwillend"
                    ],
                    "common_phrases": [
                        "stugge houding",
                        "stugge man"
                    ],
                    "target_lang_definitions": {
                        "en": "not very friendly or willing to cooperate; reserved in social interaction",
                        "pl": "mało przyjazny lub niechętny do współpracy; powściągliwy w kontaktach",
                        "de": "wenig freundlich oder kooperationsbereit; verschlossen und unnahbar im Umgang"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sullen",
                                "target_lang_sense_clarification": "bad-tempered and sulky; gloomy"
                            },
                            {
                                "target_lang_word": "unyielding",
                                "target_lang_sense_clarification": "not giving way to pressure; hard or inflexible in attitude"
                            },
                            {
                                "target_lang_word": "stiff",
                                "target_lang_sense_clarification": "formal and not friendly"
                            },
                            {
                                "target_lang_word": "surly",
                                "target_lang_sense_clarification": "bad-tempered and unfriendly"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "szorstki",
                                "target_lang_sense_clarification": "nieprzyjazny, opryskliwy w obejściu"
                            },
                            {
                                "target_lang_word": "nieustępliwy",
                                "target_lang_sense_clarification": "trudny do przekonania, niechętny do kompromisów"
                            },
                            {
                                "target_lang_word": "skryty",
                                "target_lang_sense_clarification": "powściągliwy, zamknięty w sobie"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "unnahbar",
                                "target_lang_sense_clarification": "distanziert und schwer zugänglich"
                            },
                            {
                                "target_lang_word": "mürrisch",
                                "target_lang_sense_clarification": "schlecht gelaunt, unfreundlich"
                            },
                            {
                                "target_lang_word": "unbeugsam",
                                "target_lang_sense_clarification": "nicht zu Kompromissen bereit, starrköpfig"
                            },
                            {
                                "target_lang_word": "steif",
                                "target_lang_sense_clarification": "förmlich, distanziert im Auftreten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab35ef23-b174-382a-909d-afe7bf512a19",
                    "sense_definition": "moeilijk te geloven of onwaarschijnlijk",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waarschijnlijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat lijkt me echt <w>stug</w>, want hij is normaal gesproken altijd op tijd.",
                            "target_lang_translations": {
                                "en": "That seems <w>highly unlikely</w> to me, because he is normally always on time.",
                                "pl": "Wydaje mi się to <w>mało prawdopodobne</w>, bo zazwyczaj zawsze jest na czas.",
                                "de": "Das halte ich für wirklich <w>unwahrscheinlich</w>, denn normalerweise ist er immer pünktlich."
                            }
                        },
                        {
                            "text": "Het zou me <w>stug</w> lijken als zij die prijs zou winnen zonder te oefenen.",
                            "target_lang_translations": {
                                "en": "It would seem <w>hard to believe</w> to me if she were to win that prize without practicing.",
                                "pl": "Wydawałoby mi się <w>mało prawdopodobne</w>, gdyby wygrała tę nagrodę bez ćwiczeń.",
                                "de": "Es schiene mir <w>schwer vorstellbar</w>, wenn sie diesen Preis ohne Übung gewinnen würde."
                            }
                        }
                    ],
                    "synonyms": [
                        "onwaarschijnlijk",
                        "ongeloofwaardig"
                    ],
                    "antonyms": [
                        "waarschijnlijk"
                    ],
                    "common_phrases": [
                        "dat lijkt me stug"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in de uitdrukking 'dat lijkt me stug'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "difficult to believe or unlikely",
                        "pl": "trudny do uwierzenia lub mało prawdopodobny",
                        "de": "schwer zu glauben oder unwahrscheinlich"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unlikely",
                                "target_lang_sense_clarification": "not probable"
                            },
                            {
                                "target_lang_word": "hard to believe",
                                "target_lang_sense_clarification": "implausible or improbable"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "mało prawdopodobny",
                                "target_lang_sense_clarification": "wątpliwy, mało realny"
                            },
                            {
                                "target_lang_word": "niewiarygodny",
                                "target_lang_sense_clarification": "trudny do przyjęcia za prawdę"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "unwahrscheinlich",
                                "target_lang_sense_clarification": "kaum zu erwarten, unglaubhaft"
                            },
                            {
                                "target_lang_word": "schwer zu glauben",
                                "target_lang_sense_clarification": "kaum vorstellbar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b98a600d-6311-3db6-b7ff-cce4c44edca9",
                    "sense_definition": "op een volhoudende manier, zonder zich door anderen te laten stoppen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "volharding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ondanks de regen bleef de wandelaar <w>stug</w> doorlopen naar de top.",
                            "target_lang_translations": {
                                "en": "Despite the rain, the hiker <w>doggedly</w> kept walking to the summit.",
                                "pl": "Mimo deszczu wędrowiec <w>uparcie</w> szedł dalej w stronę szczytu.",
                                "de": "Trotz des Regens ging der Wanderer <w>unbeirrt</w> weiter zum Gipfel."
                            }
                        },
                        {
                            "text": "Het is een kwestie van <w>stug</w> doorzoeken tot je de juiste informatie vindt.",
                            "target_lang_translations": {
                                "en": "It is a matter of <w>persistently</w> searching until you find the right information.",
                                "pl": "To kwestia <w>wytrwałego</w> szukania, aż znajdziesz właściwe informacje.",
                                "de": "Es ist eine Frage des <w>beharrlichen</w> Weitersuchens, bis man die richtigen Informationen findet."
                            }
                        }
                    ],
                    "synonyms": [
                        "onverstoorbaar",
                        "volhardend"
                    ],
                    "common_phrases": [
                        "stug doorgaan",
                        "stug volhouden",
                        "stug doorzoeken"
                    ],
                    "target_lang_definitions": {
                        "en": "in a persistent manner, without being stopped by others",
                        "pl": "w sposób wytrwały, nie dający się powstrzymać przez innych",
                        "de": "auf beharrliche Art und Weise, ohne sich beirren oder aufhalten zu lassen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "persistently",
                                "target_lang_sense_clarification": "continuing firmly in a course of action"
                            },
                            {
                                "target_lang_word": "doggedly",
                                "target_lang_sense_clarification": "with grim persistence"
                            },
                            {
                                "target_lang_word": "steadfastly",
                                "target_lang_sense_clarification": "in a resolute and unwavering manner"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "uparcie",
                                "target_lang_sense_clarification": "konsekwentnie, mimo przeszkód"
                            },
                            {
                                "target_lang_word": "wytrwale",
                                "target_lang_sense_clarification": "z determinacją, nie przerywając działania"
                            },
                            {
                                "target_lang_word": "nieustępliwie",
                                "target_lang_sense_clarification": "z niezachwianą konsekwencją"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "hartnäckig",
                                "target_lang_sense_clarification": "ausdauernd und unnachgiebig"
                            },
                            {
                                "target_lang_word": "beharrlich",
                                "target_lang_sense_clarification": "geduldig und unermüdlich weitermachend"
                            },
                            {
                                "target_lang_word": "unbeirrt",
                                "target_lang_sense_clarification": "ohne sich ablenken oder abbringen zu lassen"
                            }
                        ]
                    }
                }
            ]
