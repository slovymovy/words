                            {
                                "example_id": "40f9d369-3501-41d4-be24-1e2ce806e678",
                                "sense_id": "3495563a-caf1-369c-aed7-857aa6acef7f",
                                "text": "Het stimuleringspakket wordt deels bekostigd door de staatsschuld toe te laten nemen. Op dit moment heeft Japan al een van de hoogste staatsschulden ter wereld, namelijk 237% van het Bruto Nationaal Product. Ook wil Abe dat de Japanse Centrale Bank een ruimer beleid gaat voeren wat betreft het bijdrukken van yen. De 0% inflatiedoelstelling zou dan los gelaten kunnen worden om de inflatie met 2% te laten toenemen waardoor het spaargeld minder waard wordt en de Japanners weer meer zullen gaan uitgeven."
                            },
                            {
                                "example_id": "233b6a05-3b37-49b1-b278-bdcc16269185",
                                "sense_id": "3495563a-caf1-369c-aed7-857aa6acef7f",
                                "text": "De Europese Centrale Bank heeft de inflatiedoelstelling verhoogd naar 2 procent. Hiervoor was het onder - maar vlak bij - 2 procent. De laatste keer dat de ECB op deze manier haar strategie veranderde is 18 jaar geleden."
                            }
                        ]
                    }
