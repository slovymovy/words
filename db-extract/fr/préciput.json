                                "sense_id": "13164a4d-d25b-33eb-adde-67bbe34b7890",
                                "text": "Elle a pris telle chose pour son préciput."
                            },
                            {
                                "example_id": "2637f890-ef4a-400a-85a0-f5a4396f062a",
                                "sense_id": "13164a4d-d25b-33eb-adde-67bbe34b7890",
                                "text": "Elle a pris son préciput en argent, en meubles."
                            },
                            {
