                                        "glosses": [
                                            "starożytny obrzędowy instrument muzyczny związany z kultem bogini Izydy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d27e913-71a0-4624-bef0-ccee41ef6ab5",
                                                "sense_id": "4fb04da6-23f8-36b4-b1ff-cfd6a768ea0b",
                                                "text": "Wróć do ołtarza i potrząsając sistrum, wypowiedz słowa: Wiej wiatrem, Bastet, pani kotów. Wiej wiatrem, bogini ziemskich przyjemności"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
