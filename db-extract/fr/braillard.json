                                                "sense_id": "38e81b67-1b81-36b8-a4f5-2e49314d5879",
                                                "text": "She lingered for a few moments, and was garrulous over some detail of the household."
                                            },
                                            {
                                                "example_id": "b491fd27-b9ad-41bb-a333-2eb00755bd31",
                                                "sense_id": "38e81b67-1b81-36b8-a4f5-2e49314d5879",
