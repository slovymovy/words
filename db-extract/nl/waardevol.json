                            {
                                "example_id": "4b949951-2e72-417f-8823-69bd6074f112",
                                "sense_id": "a2a0a82b-e4ec-389e-acdc-21680d5baab7",
                                "text": "Dit schilderij is zeer waardevol, het wordt geschat op miljoenen euro's.",
                                "translation": "This painting is very valuable, it is estimated to be worth millions of euros.",
                                "english": "This painting is very valuable, it is estimated to be worth millions of euros."
                            },
                            {
                                "example_id": "0218b891-19e3-4d1e-8178-539ea003d781",
                                "sense_id": "a2a0a82b-e4ec-389e-acdc-21680d5baab7",
                                "text": "Haar bijdrage aan het team is waardevol, ze heeft veel kennis en ervaring.",
                                "translation": "Her contribution to the team is valuable, she has a lot of knowledge and experience.",
                                "english": "Her contribution to the team is valuable, she has a lot of knowledge and experience."
                            },
                            {
                                "example_id": "eff37e11-7e76-4c5a-876e-05e029ed277f",
                                "sense_id": "a2a0a82b-e4ec-389e-acdc-21680d5baab7",
                                "text": "Tijd is een waardevol bezit, dus gebruik het verstandig.",
                                "translation": "Time is a precious possession, so use it wisely.",
                                "english": "Time is a precious possession, so use it wisely."
                            }
                        ]
