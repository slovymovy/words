                                "target_lang_sense_clarification": "отплата за поражение"
                            },
                            {
                                "target_lang_word": "удовлетворение",
                                "target_lang_sense_clarification": "чувство после восстановления справедливости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a471f699-3131-3e55-85fc-a6d6e30619b3",
                    "sense_definition": "Iets wat schriftelijk is vastgelegd of een grafische voorstelling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "registratie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de taalkunde kijkt men soms naar het <w>gram</w> als kleinste eenheid van schrift.",
                            "target_lang_translations": {
                                "en": "In linguistics, one sometimes looks at the <w>gram</w> as the smallest unit of writing.",
                                "ru": "В лингвистике <w>графему</w> иногда рассматривают как наименьшую единицу письма."
                            }
