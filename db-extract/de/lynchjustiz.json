                "senses": [
                    {
                        "sense_id": "6b06095b-8f66-308e-a164-ab8c8dce7ddb",
                        "entry_id": "53799616-c1d4-3d1b-b427-e07135a25cfe",
                        "glosses": [
                            "ungesetzliche schwere Bestrafung (durch Misshandeln oder Töten) ohne Rechtfertigung durch ein Gerichtsurteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d37fd69a-518b-4de5-9d1c-66386a6e5a56",
                                "sense_id": "6b06095b-8f66-308e-a164-ab8c8dce7ddb",
                                "text": "„Wenn so etwas wie die Drohung einer Lynchjustiz in der Luft gelegen hatte, jetzt war sie völlig verflogen.“"
                            },
                            {
                                "example_id": "e08dd928-99b6-48ab-b4a8-ce9253f2fc51",
                                "sense_id": "6b06095b-8f66-308e-a164-ab8c8dce7ddb",
                                "text": "„Es kam zu Lynchjustiz, häufig in Form von necklacing.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de7dd894-5f8d-4b41-8071-5ba4c46333f5",
                        "source_entry_id": "53799616-c1d4-3d1b-b427-e07135a25cfe",
                        "source_sense_id": "6b06095b-8f66-308e-a164-ab8c8dce7ddb",
                        "target_lang_word": "lynch law",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lynch law",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4463b6ed-fde2-3636-a6eb-00e39bf90e3f",
                                        "entry_id": "61528fec-c23e-395e-a107-2e3a7d41bd4b",
                                        "glosses": [
                                            "The practice of condemning and punishing a person by mob action without a proper trial."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4aa6e21-a854-4bc1-9472-4419c0e31e1e",
                                                "sense_id": "4463b6ed-fde2-3636-a6eb-00e39bf90e3f",
                                                "text": "Anarchy still reigns in this new country;—not only have the miners to defend their persons and their acquisitions against the incursions from Indian tribes; not only are crimes and offences common (lynch law maintaining a permitted existence instead of laws and police); but every one appears to hold his property by right of first comer: a miner choses the spot he likes best; a strong arm and a carbine, with a steady eye, are his title deeds. To seize upon a rich \"placer\" from a miner too weak to resist, is called in the slang of the district, to \"jump a claim.\" The President of the United States himself, stated in his last message, that \"The mineral lands should remain free to every citizen;\" and the Secretary of State has added, \"that the right of occupancy should be submitted only to such laws as the miners themselves thought fit to make.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14adf869-5bc9-4e20-b999-7488332fc017",
                        "source_entry_id": "53799616-c1d4-3d1b-b427-e07135a25cfe",
