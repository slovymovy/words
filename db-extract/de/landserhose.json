                ],
                "senses": [
                    {
                        "sense_id": "6d6e3f3b-5ad1-3a9b-9a49-9dca59d5a743",
                        "entry_id": "d37d09fb-d036-3f3b-a3af-b6b8422646e1",
                        "glosses": [
                            "Hose, wie sie von Landsern getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3da5f12-bcfe-440b-84bf-62f6a9e29209",
                                "sense_id": "6d6e3f3b-5ad1-3a9b-9a49-9dca59d5a743",
                                "text": "„Willi lief jetzt im Turnhemd herum, einer Landserhose, einer Amimütze und trug zu dieser Ausrüstung die alten Sandalen seines Vaters aus dem Jahre 1938, weil seine eigenen nicht mehr paßten.“"
                            },
                            {
                                "example_id": "588f3cee-e041-4d27-a8fe-a6f2cc9d8e8a",
                                "sense_id": "6d6e3f3b-5ad1-3a9b-9a49-9dca59d5a743",
                                "text": "„Oben trug er den Colani, die blaue Jacke der Seeleute, auf dem Kopf eine Schirmmütze, eine feldgraue Landserhose, seine Füße steckten in hohen Schnürschuhen.“"
                            },
                            {
                                "example_id": "07e01ecb-8afb-469a-8c25-c88e77486b96",
                                "sense_id": "6d6e3f3b-5ad1-3a9b-9a49-9dca59d5a743",
                                "text": "„Ich sah an meiner abgetragenen Offiziersbluse herunter, verdeckte mit verschränkten Beinen ein Loch am Knie meiner Landserhose.“"
                            },
                            {
                                "example_id": "f9330527-2b32-4cdb-a429-01bdc51e8046",
                                "sense_id": "6d6e3f3b-5ad1-3a9b-9a49-9dca59d5a743",
                                "text": "„Das muss schon ein komisches Bild gewesen sein, wie ich in meiner halb zerfetzten Landserhose, darüber einen olivgrünen Pullover, den die Briten mir geschenkt htten, das Schild unter dem Arm haltend wie eine Mappe mit Kostbarkeiten, durch diese Steinwüste strich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
