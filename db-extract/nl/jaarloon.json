                "senses": [
                    {
                        "sense_id": "b16c7ea1-31a9-3624-9778-e256ab98615c",
                        "entry_id": "8aa6f1ec-44e0-37d5-8c9e-b6ab9e352363",
                        "glosses": [
                            "salaris dat men per jaar ontvangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e224825b-1ff8-409b-bf23-25d27fb1583b",
                                "sense_id": "b16c7ea1-31a9-3624-9778-e256ab98615c",
                                "text": "Teneinde zich 's zomers vrijuit aan alle takken van de Georgica te kunnen wijden nam vader het beheer weer terug; de boer kreeg in plaats van de pacht een dienstverband tegen jaarloon en Zijne ed. schilderde zelf de witte zandloper terug op de groene deur van de grote stal, dat trotse teken waaraan de eigenerfden zich hier in Hemelumer Oldeferd laten kennen."
                            },
                            {
                                "example_id": "bb5b64f8-2151-41fc-9da0-695b1736aff6",
                                "sense_id": "b16c7ea1-31a9-3624-9778-e256ab98615c",
                                "text": "Een actie van een Albert Heijn-vakkenvuller bij de aandeelhoudersvergadering van Ahold leverde Young & United veel publiciteit op. Young & United-lid Soufian Afkir vertelde daar dat hij 299 jaar zou moeten werken om het jaarloon van de Ahold-topman te verdienen."
                            }
                        ]
                    }
