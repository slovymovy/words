                    {
                        "translation_id": "7540f9c0-416f-4d21-949b-59326653fb14",
                        "source_entry_id": "f6282fab-e15e-3aa0-9580-0ed73c2f0551",
                        "source_sense_description": "capital city of Romania",
                        "target_lang_word": "Бухаре́ст",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Бухаре́ст",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "deccdff7-d195-36aa-a7af-293357bbc4c1",
                                        "entry_id": "731d82f2-00e0-3c7b-9d80-b5cdce3abe07",
                                        "glosses": [
                                            "город, столица Румынии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b77c8214-489d-42a8-9105-8b8ff9b0e11c",
                                                "sense_id": "deccdff7-d195-36aa-a7af-293357bbc4c1",
                                                "text": "Почему Чаушеску 18 декабря столь недальновидно уехал с визитом в Иран, хотя в стране было очень неспокойно? Кто посоветовал ему организовать 21 декабря самоубийственный митинг, завершившийся, как известно, массовым восстанием жителей Бухареста?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f8436b4-c7b5-3c8c-92af-6681a4ab9e2d",
                                        "entry_id": "731d82f2-00e0-3c7b-9d80-b5cdce3abe07",
                                        "glosses": [
                                            "перен. полит. правительство Румынии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf403f9c-b3e9-40c1-8ff1-2b3d5796ab4b",
                                                "sense_id": "6f8436b4-c7b5-3c8c-92af-6681a4ab9e2d",
                                                "text": "Со своей стороны Москва занимала традиционную позицию по отношению к Бухаресту. Выступая на вечернем заседании VI сессии Верховного Совета СССР 29 марта 1940 года, председатель СНК СССР и нарком иностранных дел В. М. Молотов заявил, что «у нас нет пакта о ненападении с Румынией. Это объясняется наличием нерешённого спорного вопроса о Бессарабии, захват которой Румынией Советский Союз никогда не признавал, хотя и никогда не ставил вопрос о возвращении Бессарабии военным путём. Поэтому нет никаких оснований к какому-либо ухудшению и советско-румынских отношений»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
