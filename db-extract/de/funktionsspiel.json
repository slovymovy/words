                "senses": [
                    {
                        "sense_id": "e5b575e5-5564-3d6b-96a7-759e8f1b6ebc",
                        "entry_id": "0e0bd2d0-f73c-398e-9edb-e2b2eaf6dc8e",
                        "glosses": [
                            "Spiel, bei dem Gegenstände der Umwelt ausprobiert und die eigenen Körpergegebenheiten erlebt und entwickelt werden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4af1618-f8cf-4a1d-81e1-8c40757e505c",
                                "sense_id": "e5b575e5-5564-3d6b-96a7-759e8f1b6ebc",
                                "text": "„Das Funktionsspiel, das reine Manipulieren mit Gegenständen, ist bereits beim Kleinkind zu beobachten.“"
                            },
                            {
                                "example_id": "81eeb372-801c-4586-b235-289b027747b5",
                                "sense_id": "e5b575e5-5564-3d6b-96a7-759e8f1b6ebc",
                                "text": "„Jedes senso-motorische Spiel baut auf den Spielerfahrungen der frühen Kinderspielformen auf: Körperfunktionen und ihre zielorientierte Koordination werden in den Funktionsspielen entwickelt.“"
                            },
                            {
                                "example_id": "ff0e99dc-b9a5-4878-b94f-ce657028a9b2",
                                "sense_id": "e5b575e5-5564-3d6b-96a7-759e8f1b6ebc",
                                "text": "„Auf Geben und Nehmen, Haschen, Versteckspielen und andere Unterhaltungen, die Kinder normalerweise vom zehnten bis zwölften Lebensmonat an erfreuen, folgen einfache Funktionsspiele wie Turmbauen und Perlenauffädeln.“"
                            },
                            {
                                "example_id": "dbcc7a46-8d31-4b83-80d5-1115a5051c4e",
                                "sense_id": "e5b575e5-5564-3d6b-96a7-759e8f1b6ebc",
                                "text": "„Das Funktionsspiel (auch sensomotorisches Spiel genannt) ist die erste Form des Spielens bei Kindern von 0 bis etwa 2 Jahre. Die Motivation im Funktionsspiel ist die Funktionslust und das Wiederholungsprinzip.“"
                            },
                            {
                                "example_id": "0e99b279-9228-47ca-8671-26b89cc7f313",
                                "sense_id": "e5b575e5-5564-3d6b-96a7-759e8f1b6ebc",
                                "text": "„Als Funktionsspiel wird das lustvolle Erproben der eigenen körperlichen Fähigkeiten, die um ihrer selbst willen durchgeführte Bewegung, bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
