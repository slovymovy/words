                "senses": [
                    {
                        "sense_id": "04fc64c7-af3a-386a-871c-4084ed7c9b86",
                        "entry_id": "b53de02b-801b-3a40-9213-a606a90f0920",
                        "glosses": [
                            "Rendre plus puissant."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e9a0b038-5107-4ff7-96d3-55689119676b",
                                "sense_id": "04fc64c7-af3a-386a-871c-4084ed7c9b86",
                                "text": "Cette notion est évidemment essentielle, car nos comportements changeraient grandement si nous cherchions toujours à potentialiser l’autre, voire à le « puissantiser », à travers nos rapports avec lui."
                            },
                            {
                                "example_id": "d521e50a-9efa-4dbb-8ed2-34448d795808",
                                "sense_id": "04fc64c7-af3a-386a-871c-4084ed7c9b86",
                                "text": "Le circuit Macaulay permet au synthétiseur non seulement d'interpréter toute musique génialement (avec les ultra-sons pour la « puissantiser »), mais encore de créer sa propre musique ; or, l'art est la manifestation par excellence de l'être intelligent ; donc l'homme a créé son successeur."
                            },
                            {
                                "example_id": "bcbdb363-98bd-4c4c-b687-9baff5149dd0",
                                "sense_id": "04fc64c7-af3a-386a-871c-4084ed7c9b86",
                                "text": "(Je suis en train de me demander quelle serait mon identité à moi, à quelle ou quelles identités je m'accroche, en vue de me puissantiser)."
                            }
                        ]
                    }
                ],
