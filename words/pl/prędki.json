                {
                    "sense_id": "7ba624fb-6f48-332a-8576-a15eb464dd6a",
                    "sense_definition": "Szybki, odznaczający się dużą szybkością poruszania się lub działania.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "szybki-ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego <w>prędki</w> krok zdradzał, że bardzo się spieszy na spotkanie.",
                            "target_lang_translations": {
                                "ru": "Его <w>быстрый</w> шаг выдавал, что он очень спешит на встречу."
                            }
                        },
                        {
                            "text": "Musimy podjąć <w>prędki</w> krok, aby zdążyć przed zachodem słońca.",
                            "target_lang_translations": {
                                "ru": "Мы должны сделать <w>быстрый</w> шаг, чтобы успеть до захода солнца."
                            }
                        }
                    ],
                    "synonyms": [
                        "szybki",
                        "chyży",
                        "wartki"
                    ],
                    "antonyms": [
                        "powolny",
                        "wolny"
                    ],
                    "common_phrases": [
                        "prędki krok",
                        "prędki nurt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый, отличающийся высокой скоростью движения или действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быстрый",
                                "target_lang_sense_clarification": "о движении или действии"
                            },
                            {
                                "target_lang_word": "скорый",
                                "target_lang_sense_clarification": "о темпе, шаге"
                            },
                            {
                                "target_lang_word": "стремительный",
                                "target_lang_sense_clarification": "очень быстрый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df04b3c9-c10d-3d60-a814-bb9d01aca8e5",
                    "sense_definition": "Taki, który ma nastąpić w bardzo bliskiej przyszłości, bez zbędnej zwłoki.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bliski-czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mamy nadzieję na <w>prędki</w> powrót do zdrowia naszego przyjaciela.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся на <w>скорое</w> выздоровление нашего друга."
                            }
                        },
                        {
                            "text": "Wysłałem list i liczę na <w>prędki</w> odzew z ich strony.",
                            "target_lang_translations": {
                                "ru": "Я отправил письмо и рассчитываю на <w>быстрый</w> отклик с их стороны."
                            }
                        }
                    ],
                    "synonyms": [
                        "bezzwłoczny",
                        "błyskawiczny",
                        "szybki"
                    ],
                    "antonyms": [
                        "powolny"
                    ],
                    "common_phrases": [
                        "prędki powrót",
                        "prędki odzew"
                    ],
                    "target_lang_definitions": {
