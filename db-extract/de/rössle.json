                ],
                "senses": [
                    {
                        "sense_id": "911f7a71-1e62-3c89-a485-73b2038e8054",
                        "entry_id": "2910e1d2-f7fa-3aaf-9b1d-1b22a3c6f7d3",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6958c61-1820-4543-a11e-3d4cce1814ca",
                                "sense_id": "911f7a71-1e62-3c89-a485-73b2038e8054",
                                "text": "Frau Rössle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "958437db-422b-44e7-9451-d09e33a2f170",
                                "sense_id": "911f7a71-1e62-3c89-a485-73b2038e8054",
                                "text": "Herr Rössle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d6e5ccdc-a5bc-4bb1-9f19-89c696775967",
                                "sense_id": "911f7a71-1e62-3c89-a485-73b2038e8054",
                                "text": "Die Rössles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "14bcc71d-4742-4312-ad1d-75a5efe5e715",
                                "sense_id": "911f7a71-1e62-3c89-a485-73b2038e8054",
                                "text": "Der Rössle trägt nie die Pullover, die die Rössle ihm strickt."
                            },
                            {
                                "example_id": "8756d154-7c8c-4f99-9f73-7a63c8466aa8",
                                "sense_id": "911f7a71-1e62-3c89-a485-73b2038e8054",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rössle kommt, geht der Herr Rössle.“"
                            },
                            {
                                "example_id": "9604f88c-cd3e-4714-9ece-20094ab77b02",
                                "sense_id": "911f7a71-1e62-3c89-a485-73b2038e8054",
                                "text": "Rössle kommt und geht."
                            },
                            {
                                "example_id": "c4b0b147-eeec-4dae-a3d6-a4822b5ad14c",
                                "sense_id": "911f7a71-1e62-3c89-a485-73b2038e8054",
                                "text": "Rössles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
