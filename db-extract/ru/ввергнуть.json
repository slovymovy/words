                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9580d043-3306-3db6-b4f2-ea9fd7fd384d",
                                        "entry_id": "9c2170ac-2571-30a5-b4f0-0907f7d82388",
                                        "glosses": [
                                            "To entangle or embarrass (mostly used in past participle)."
                                        ],
                                        "tags": [
