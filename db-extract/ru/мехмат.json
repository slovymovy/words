                "senses": [
                    {
                        "sense_id": "461611eb-0581-3c2c-81cb-0256315c8491",
                        "entry_id": "4bf636c5-c3b4-3a6c-a689-1679c89d6a6b",
                        "glosses": [
                            "разг. механико-математический факультет университета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bd59a9b-8f34-48cb-a837-5dea37bdc958",
                                "sense_id": "461611eb-0581-3c2c-81cb-0256315c8491",
                                "text": "Конечно, требовать от гуманитария знаний по математике на уровне абитуриента мехмата бессмысленно."
                            },
                            {
                                "example_id": "33d1c379-dca8-43b5-9651-9e8d915975c3",
                                "sense_id": "461611eb-0581-3c2c-81cb-0256315c8491",
                                "text": "Я же по образованию математик, закончил мехмат МГУ, чем горжусь."
                            },
                            {
                                "example_id": "30410163-bcb7-4af8-91ee-2f8803468b43",
                                "sense_id": "461611eb-0581-3c2c-81cb-0256315c8491",
                                "text": "Наиболее престижными традиционно остаются факультеты иностранных языков, биоинженерии, естественных наук, мехмат."
                            }
                        ]
                    }
