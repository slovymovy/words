                        "pulsing"
                    ],
                    "common_phrases": [
                        "pounding headache",
                        "pounding rain"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyznačující se silnými nebo hlasitými údery či pulzováním."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bušící",
                                "target_lang_sense_clarification": "intenzivní pocit pulzování"
                            },
                            {
                                "target_lang_word": "prudký",
                                "target_lang_sense_clarification": "o dešti nebo bolesti"
                            }
                        ]
                    }
                }
            ]
        },
        {
