                                "example_id": "748c7981-fdb1-4ea4-ba97-0aacf23f7d24",
                                "sense_id": "5c424cd0-afb4-31cd-b4e1-c5d6beff0601",
                                "text": "„Der Vorstoß kam auf Initiative der Kanzlerpartei ÖVP zustande, die FPÖ zog mit, auch wenn es intern Gegrummel gab.“"
                            }
