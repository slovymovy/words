                                                "sense_id": "3ffd15e4-c18e-3976-b28c-dac0c18614ba",
                                                "text": "I can make the changes, but it will impact the schedule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8124d7-f0c9-3c9d-8cec-73f65c8f99f4",
                                        "entry_id": "52b2fde0-10b0-388a-a479-75e36a8a83bf",
