                "senses": [
                    {
                        "sense_id": "ca3ec533-3e5f-3266-8542-92f93c161772",
                        "entry_id": "e5621a84-4dc8-32c6-a82e-f1a7ba2504a1",
                        "glosses": [
                            "Zigarre einer Schweizer Marke, die eine längliche, schlanke und leicht gekrümmte Form aufweist und deren Mundstück aus Stroh ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b00c2c-030c-4e6a-a7d1-4be8e1fefa43",
                                "sense_id": "ca3ec533-3e5f-3266-8542-92f93c161772",
                                "text": "„Was wir brauchen, ist ein eiserner Vorrat an Brissagos und Havannas, eine Karte der Grotti, Canvetti und Bocciabahnen sowie einen Stammplatz in einem Nightclub.“"
                            },
                            {
                                "example_id": "fd9cf29d-23df-481c-a801-e18f7a35aa6e",
                                "sense_id": "ca3ec533-3e5f-3266-8542-92f93c161772",
                                "text": "„Er fand Streichhölzer in der Jackentasche, zündete die Brissago an, stieß Rauch aus und faßte sein Gegenüber jetzt genau ins Auge.“"
                            },
                            {
                                "example_id": "29df4364-0d46-446f-9cf4-c3c98d1ed9b8",
                                "sense_id": "ca3ec533-3e5f-3266-8542-92f93c161772",
                                "text": "„«Aber starken Tabak, den ich nicht vertrage, habe ich hier nicht gefunden», sagt er und nuckelt genüsslich an seiner Brissago.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
