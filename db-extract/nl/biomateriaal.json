                            {
                                "example_id": "6fc7eedd-87c6-4d27-ba0b-a56b1492dccf",
                                "sense_id": "5455ce2b-3ae2-3b16-9e68-d06e18d6126e",
                                "text": "Het gaat om een speciaal stofje in de zuignap-tanden van de inktvis: suckerine. Dat eiwit is een bijzonder veelzijdig biomateriaal, dat onder meer brandwonden zou moeten kunnen genezen."
                            },
                            {
                                "example_id": "db3eed0b-865b-47bc-a85e-3ff4ab555ee3",
                                "sense_id": "5455ce2b-3ae2-3b16-9e68-d06e18d6126e",
                                "text": "In Nederland zijn er al eerder soortgelijke initiatieven geweest. Zo verrees in Amsterdam een 3D-geprinte micro-woning van biomateriaal. Maar in Eindhoven komt nu voor het eerst een betonnen, bewoonbaar huis. De gemeente, de universiteit en vier bedrijven ondertekenden vandaag een samenwerkingsovereenkomst voor de bouw van de vijf woningen."
                            }
                        ]
