                ],
                "translations": [
                    {
                        "translation_id": "e31786ca-ab78-411b-946f-d7a9f8350456",
                        "source_entry_id": "eb25b910-b124-34df-85e7-7e5ab25955fd",
                        "source_sense_id": "d649cb46-e19e-3df1-a5f6-169cae1dd2ca",
                        "target_lang_word": "choir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "choir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "327aab60-9800-3c8b-8f66-10e320acbd14",
                                        "entry_id": "59f746ab-2a15-39aa-a7ee-974bd5c191ee",
                                        "glosses": [
                                            "A group of people who sing together; a company of people who are trained to sing together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf692933-05e8-420c-8882-dcab1f39e8d2",
                                                "sense_id": "327aab60-9800-3c8b-8f66-10e320acbd14",
                                                "text": "The church choir practices Thursday nights."
                                            },
                                            {
                                                "example_id": "521643bb-cd3b-46ca-adcc-94a81c6a84a8",
                                                "sense_id": "327aab60-9800-3c8b-8f66-10e320acbd14",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly, […], down the nave to the western door. […] At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            },
                                            {
                                                "example_id": "d9c4407a-37d3-40b0-9535-b044047d8cde",
                                                "sense_id": "327aab60-9800-3c8b-8f66-10e320acbd14",
                                                "text": "Army choirs and troupes perform at some of North Korea's biggest state events."
                                            },
                                            {
                                                "example_id": "3ff3066a-cebf-4d1f-bc48-f7b6fa21053b",
                                                "sense_id": "327aab60-9800-3c8b-8f66-10e320acbd14",
                                                "text": "Public health officials studying the Covid-19 outbreak among members of a Washington choir found numerous ways the virus could have spread, according to a report published by the Centers for Disease Control and Prevention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2895d4f6-f4b0-3f58-b405-094413e6e330",
                                        "entry_id": "59f746ab-2a15-39aa-a7ee-974bd5c191ee",
                                        "glosses": [
                                            "Uncommon form of quire (“one quarter of a cruciform church, or the architectural area of a church used by the choir, often near the apse”)."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1effa73e-53be-45b5-b57e-2d366b12c0be",
                                                "sense_id": "2895d4f6-f4b0-3f58-b405-094413e6e330",
                                                "text": "Here, in the transept and choir, where the service was being held, one was conscious every moment of an increasing brightness; colours glowing vividly beneath the circular chandeliers, and the rows of small lights on the choristers' desks flashed and sparkled in front of the boys' faces, deep linen collars, and red neckbands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "937cfa09-76be-30fa-a9da-8a754bdcc438",
                                        "entry_id": "59f746ab-2a15-39aa-a7ee-974bd5c191ee",
                                        "glosses": [
                                            "One of the nine ranks or orders of angels."
                                        ],
                                        "tags": [
                                            "Christian"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a42f3720-3d6f-476a-b43b-a36526182ba7",
                                                "sense_id": "937cfa09-76be-30fa-a9da-8a754bdcc438",
                                                "text": "Seraphim, Cherubim, and Thrones are three of the choirs of angels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b1ad06a-c70b-371e-89ab-4f84f1585487",
                                        "entry_id": "59f746ab-2a15-39aa-a7ee-974bd5c191ee",
                                        "glosses": [
                                            "Set of strings (one per note) for a harpsichord."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "choir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18136813-1e11-31e2-bcc1-a985abb841aa",
                                        "entry_id": "2cc8161f-5d6d-3cc5-8886-7b9299a2bce9",
                                        "glosses": [
                                            "To sing in concert."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c89958c5-c8b5-4253-9b87-f3fcab0e059d",
                                                "sense_id": "18136813-1e11-31e2-bcc1-a985abb841aa",
                                                "text": "The great aim of this book is to secure congregational singing, which the churches must come to, at last, after a long interval of choiring."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0c4eb9f-0963-48d3-aa00-83da88b1f214",
                        "source_entry_id": "eb25b910-b124-34df-85e7-7e5ab25955fd",
