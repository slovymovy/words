                                        "entry_id": "1a29099d-bcad-3996-bdc0-3a931692b3f4",
                                        "glosses": [
                                            "een vetoplossend oplosmiddel dat uit de sappen van bepaalde dennensoorten gewonnen kan worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "406e0c76-54ca-4826-a019-f5fc905fbf24",
                                                "sense_id": "54df173d-e64b-3c8c-bf19-61810e8ec534",
                                                "text": "Aardolieproducten zoals terpentine hebben terpentijn vrijwel geheel verdrongen."
