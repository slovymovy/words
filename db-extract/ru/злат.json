                        "tags": [],
                        "examples": [
                            {
                                "example_id": "727d4306-be5c-40fe-aae4-9b2a1561ae84",
                                "sense_id": "64230cf3-057b-3215-87f8-dde6b79f87d0",
                                "text": "Денежная единица Буковины XV–XVII вв именовалась злат."
                            },
                            {
                                "example_id": "b2f6c31e-96fb-46d7-ace2-0d2ffb545b6c",
                                "sense_id": "64230cf3-057b-3215-87f8-dde6b79f87d0",
                                "text": "Один злат равнялся тридцати грошам."
                            },
                            {
                                "example_id": "b65ee4a5-fc80-4c51-b9e1-25751688e164",
                                "sense_id": "64230cf3-057b-3215-87f8-dde6b79f87d0",
                                "text": "Златами назывались золотые дукаты венгерского, турецкого или итальянского происхождения."
                            }
                        ]
