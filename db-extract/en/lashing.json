        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9fc2cbe4-9c02-348e-85cc-0ab876c7bc22",
                "word": "lashing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4d7d07c4-2bce-40c5-ba4d-74d83eb421c5",
                        "entry_id": "9fc2cbe4-9c02-348e-85cc-0ab876c7bc22",
                        "tags": [
                            "plural"
                        ],
                        "form": "lashings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "23a8bce6-f9b0-367d-9f3c-0d37feb8db69",
                        "entry_id": "9fc2cbe4-9c02-348e-85cc-0ab876c7bc22",
                        "glosses": [
                            "Something used to tie something or lash it to something."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c277a9ba-5f6e-45cd-9771-e1c934bd46b1",
                                "sense_id": "23a8bce6-f9b0-367d-9f3c-0d37feb8db69",
                                "text": "The lashings, which had been holding the chest to the deck of the storm-tossed ship, broke, and it went overboard."
                            }
                        ]
                    },
                    {
                        "sense_id": "01802133-42ab-3cae-b627-06b974d50adf",
                        "entry_id": "9fc2cbe4-9c02-348e-85cc-0ab876c7bc22",
                        "glosses": [
                            "The act of one who, or that which, lashes; castigation, chastisement."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c40ea5fd-2e5e-4518-919b-3826a843268a",
                                "sense_id": "01802133-42ab-3cae-b627-06b974d50adf",
                                "text": "the lashings out of his luxur"
                            }
                        ]
                    },
                    {
                        "sense_id": "64df28cd-cf24-316d-af7d-491ad7de9491",
                        "entry_id": "9fc2cbe4-9c02-348e-85cc-0ab876c7bc22",
                        "glosses": [
                            "The or an act of lashing; a heavy falling or downpour (of rain)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "18126746-bfb1-4e55-8b10-f4cd1d06eb3b",
                                "sense_id": "64df28cd-cf24-316d-af7d-491ad7de9491",
                                "text": "[It] came from the sea, that wind, and soon enough, it would bring lashings of rain. The captain opened the door just as the first patters of rain began to fall."
                            }
                        ]
                    },
                    {
                        "sense_id": "eae1d0df-06c4-3556-bcc7-dedb7f9540bd",
                        "entry_id": "9fc2cbe4-9c02-348e-85cc-0ab876c7bc22",
                        "glosses": [
                            "Lots; a great amount."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "countable",
                            "in-plural",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7198da78-9133-43fa-9d6f-d75fa1a41062",
                                "sense_id": "eae1d0df-06c4-3556-bcc7-dedb7f9540bd",
                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes like\n Here's rattling good luck and roaring good cheer, / With lashings of food and great hogsheads of beer. […]”"
                            },
                            {
                                "example_id": "c4fb52fe-d1cd-4142-a6c6-d095bdfac57c",
                                "sense_id": "eae1d0df-06c4-3556-bcc7-dedb7f9540bd",
                                "text": "You bring happiness to my heart\nLike a freshly baked apple tart\nWith lashings of piping-hot custard"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efcb6d75-7dc8-42b5-893d-d7e9eafb9b68",
