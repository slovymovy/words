                "senses": [
                    {
                        "sense_id": "4f008d4b-a5b5-39b6-8ca1-a0a90c72052e",
                        "entry_id": "e0b0e0ce-27b4-3831-b9bf-d419bfd4f046",
                        "glosses": [
                            "Pokerspiel, bei dem der Verlierer oder die Verliererin ein Kleidungsstück ausziehen muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fbd1c63-8b97-4973-a653-6a61ef837f0a",
                                "sense_id": "4f008d4b-a5b5-39b6-8ca1-a0a90c72052e",
                                "text": "Juliane ist süchtig nach Strip-Poker."
                            },
                            {
                                "example_id": "437050a7-8aa9-4644-b650-8ce79fa20b90",
                                "sense_id": "4f008d4b-a5b5-39b6-8ca1-a0a90c72052e",
                                "text": "„Als das irische Wettbüro Paddy Power am 1. April dieses Jahres aus Spaß eine Weltmeisterschaft im Strip-Poker ankündigte, hätten wohl nicht einmal die Buchmacher selbst Wetten auf diese Idee abgeschlossen.“"
                            },
                            {
                                "example_id": "3621f48d-2438-4d4f-a1fc-a31cce1d8c62",
                                "sense_id": "4f008d4b-a5b5-39b6-8ca1-a0a90c72052e",
                                "text": "„Sie berichtete unter anderem vom Zwang zum Strip-Poker in dem Internat.“"
                            },
                            {
                                "example_id": "070ce629-23bd-4e64-b6f3-efa341854061",
                                "sense_id": "4f008d4b-a5b5-39b6-8ca1-a0a90c72052e",
                                "text": "„Gespielt wird eine unfaire Variante des Strip-Pokers, denn nur die Frau auf dem Bildschirm muss sich nackt machen, wenn sie verliert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
