                            {
                                "example_id": "eec3650f-3f28-4c8e-8e99-ff8382c4d445",
                                "sense_id": "d1edeffc-dc8f-3890-a5f7-b4a2e9389a09",
                                "text": "Haar lichtblonde lokken glanzen als een stralenkrans door de donkere schaduwen van het glas, en de vrouw legt haar handpalm op de ruit."
                            },
                            {
                                "example_id": "34bdbd8b-06cf-4d79-b0f3-cf83750cba53",
                                "sense_id": "d1edeffc-dc8f-3890-a5f7-b4a2e9389a09",
                                "text": "' Nella zoekt in haar zak naar een gulden en legt die op zijn vuile handpalm."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45f256af-03a3-484c-a472-47ade316ca46",
                        "source_entry_id": "d4770ba3-fbcf-35cd-a613-13c95d014d21",
                        "source_sense_id": "d1edeffc-dc8f-3890-a5f7-b4a2e9389a09",
                        "source_sense_description": "binnenzijde van de hand",
                        "target_lang_word": "Handfläche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handfläche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5755da88-5cf2-3a27-bbc4-eca830114aa1",
                                        "entry_id": "bf33c04a-ad11-3608-b1ac-01ac8cf84ec6",
                                        "glosses": [
                                            "innere Fläche der Hand ohne Finger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab9674aa-7230-4072-affe-f56049e4ff2a",
                                                "sense_id": "5755da88-5cf2-3a27-bbc4-eca830114aa1",
                                                "text": "Manche Leute glauben, dass man das Schicksal einer Person aus den Linien ihrer Handfläche ablesen kann."
                                            },
                                            {
                                                "example_id": "96ef57e2-3545-4147-9440-f2ef6105824c",
                                                "sense_id": "5755da88-5cf2-3a27-bbc4-eca830114aa1",
                                                "text": "„Ich höre, wie die Handflächen an die Handgelenke schlagen.“"
                                            },
                                            {
                                                "example_id": "5d1a7202-eb76-49f0-8a42-2311a46b2d6a",
                                                "sense_id": "5755da88-5cf2-3a27-bbc4-eca830114aa1",
                                                "text": "„Magnussons Finger drückte auf eine Stelle in seiner Handfläche, bis sie schmerzte.“"
                                            },
                                            {
                                                "example_id": "790d3e50-703c-450e-8999-b4eb5983c8ed",
                                                "sense_id": "5755da88-5cf2-3a27-bbc4-eca830114aa1",
                                                "text": "„Dann löste Fabiola die Hände vom Gesicht und schaute auf ihre feuchten Handflächen.“"
                                            },
                                            {
                                                "example_id": "ecfe1787-e220-459e-9b9c-855ae777f7d8",
                                                "sense_id": "5755da88-5cf2-3a27-bbc4-eca830114aa1",
                                                "text": "„Ich streichle ihr über den Rücken, mit den Fingern, nicht mit der Handfläche, und setze den Weg fort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a948bf2e-48ef-42c4-bf3e-6b2eca54bbca",
