                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fb9b074-2e3d-4f40-804f-aed1190fa8da",
                                                "sense_id": "623abc4f-357a-3d5a-8de7-ff43720209a6",
                                                "text": "„Als er gefragt wurde, was er auf seine Crêpe haben wolle, deutete er auf das Glas mit der Haselnusscreme und rief: ‚Nuteja!‘“"
                                            },
                                            {
                                                "example_id": "e4ed2d71-89f4-414f-aff8-400537a7cfbd",
                                                "sense_id": "623abc4f-357a-3d5a-8de7-ff43720209a6",
                                                "text": "„Die Crêpes waren mit einer Menge Cognac flambiert gewesen, aber sie trank doch noch einen kleinen Cognac zum Café Noir, und einen winzigen, allerletzten, bevor man in den Wagen stieg.“"
                                            },
                                            {
                                                "example_id": "44d58fca-0fe9-4835-b84f-07b45475ff73",
                                                "sense_id": "623abc4f-357a-3d5a-8de7-ff43720209a6",
                                                "text": "„Eleanor erlöste Julie für ein paar Stunden von ihren Mutterpflichten und strahlte genauso wie Amélie, wenn sie nach einem Spaziergang durch den Jardin du Luxembourg, einem Puppenspiel, einer Runde Ponyreiten oder einem Crêpe mit Erdbeermarmelade zu Shakespeare and Company zurückkehrten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
