        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "86b149db-03e8-37ce-be3d-5899a9b6ba0f",
                    "sense_definition": "Qui manque d'instruction ou de culture générale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manque_de_savoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune homme est travailleur, mais il reste très <w>ignorant</w> dans plusieurs matières fondamentales.",
                            "target_lang_translations": {
                                "en": "This young man is hardworking, but he remains very <w>ignorant</w> in several core subjects.",
                                "ru": "Этот молодой человек трудолюбив, но в нескольких основных предметах он остаётся очень <w>невежественным</w>.",
                                "de": "Dieser junge Mann ist fleißig, doch in mehreren Grundlagenfächern bleibt er sehr <w>unwissend</w>.",
                                "es": "Este joven es trabajador, pero sigue siendo muy <w>ignorante</w> en varias materias fundamentales.",
                                "zh": "这个年轻人很勤奋，但在几门基础学科上仍然十分<w>无知</w>。"
                            }
                        },
                        {
                            "text": "Il se sentait souvent <w>ignorant</w> au milieu de tous ces universitaires réputés.",
                            "target_lang_translations": {
                                "en": "He often felt <w>ignorant</w> among all those renowned academics.",
                                "ru": "Он часто чувствовал себя <w>невежественным</w> среди всех этих известных учёных.",
                                "de": "Inmitten all dieser renommierten Akademiker fühlte er sich oft <w>unwissend</w>.",
                                "es": "Se sentía a menudo <w>ignorante</w> entre todos aquellos académicos de renombre.",
                                "zh": "在那些有名的学者中间，他常常觉得自己很<w>无知</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "instruit",
                        "cultivé",
                        "érudit"
                    ],
                    "common_phrases": [
                        "rester ignorant"
                    ],
                    "target_lang_definitions": {
                        "en": "Lacking education or general knowledge.",
                        "ru": "Не имеющий достаточного образования или общих знаний.",
                        "de": "Ohne ausreichende Bildung oder allgemeines Wissen.",
                        "es": "Que carece de instrucción o de cultura general.",
                        "zh": "指缺乏教育或一般文化知识的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uneducated",
                                "target_lang_sense_clarification": "without formal schooling"
                            },
                            {
                                "target_lang_word": "ignorant",
                                "target_lang_sense_clarification": "general knowledge, derogatory"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "невежественный",
                                "target_lang_sense_clarification": "о знаниях, пренебрежительно"
                            },
                            {
                                "target_lang_word": "необразованный",
                                "target_lang_sense_clarification": "без формального школьного образования"
                            }
                        ],
