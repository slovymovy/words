                        "sense_id": "70f8020c-f931-38b1-b03e-1e4ee8c1985d",
                        "entry_id": "bf9f8a35-c96d-3510-9407-a578233dba54",
                        "glosses": [
                            "lectern, stand for books, especially one in a church"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "31abe844-af16-4825-af57-afbb4751b85a",
                                "sense_id": "70f8020c-f931-38b1-b03e-1e4ee8c1985d",
                                "text": "De spreker plaatste zijn aantekeningen op de lezenaar voordat hij zijn toespraak begon.",
                                "translation": "The speaker placed his notes on the lectern before starting his speech.",
                                "english": "The speaker placed his notes on the lectern before starting his speech."
                            },
                            {
                                "example_id": "0a4f680a-2fc2-4e09-a6f2-c0749344b3a9",
                                "sense_id": "70f8020c-f931-38b1-b03e-1e4ee8c1985d",
                                "text": "De priester las de Bijbel vanaf de lezenaar in de kerk.",
                                "translation": "The priest read the Bible from the lectern in the church.",
                                "english": "The priest read the Bible from the lectern in the church."
                            },
                            {
                                "example_id": "3cff9451-0c5a-4cf0-8e22-0d09da3a6042",
                                "sense_id": "70f8020c-f931-38b1-b03e-1e4ee8c1985d",
                                "text": "De oude kerk heeft een prachtige houten lezenaar met gedetailleerde gravures.",
                                "translation": "The old church has a beautiful wooden lectern with intricate engravings.",
                                "english": "The old church has a beautiful wooden lectern with intricate engravings."
                            }
                        ]
                    }
                ],
