                    }
                ],
                "senses": [
                    {
                        "sense_id": "17ab56c4-bd30-3a91-98ca-a60996eb3929",
                        "entry_id": "232b2558-46c3-3e8a-9232-2008ae628309",
                        "glosses": [
                            "A weapon that causes fire; an incendiary weapon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1772299-ee65-441e-8c3d-d42fca5ebe99",
                                "sense_id": "17ab56c4-bd30-3a91-98ca-a60996eb3929",
                                "text": "A Molotov cocktail is a simple firebomb."
                            },
                            {
                                "example_id": "481e4caa-a0f8-48aa-a2be-9ed75bdd39b6",
                                "sense_id": "17ab56c4-bd30-3a91-98ca-a60996eb3929",
                                "text": "The firebombs were small, and burst into flames when they hit the ground."
                            },
                            {
                                "example_id": "0be66c70-e81f-4e4e-9d7f-e6251ae7b33d",
                                "sense_id": "17ab56c4-bd30-3a91-98ca-a60996eb3929",
                                "text": "As many as 100,000 Japanese people were killed and another million injured, most of them civilians, when more than 300 American B-29 bombers dropped 1,500 tons of firebombs on the Japanese capital that night."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0a53d55-f9be-457e-ab6c-ac182ef3d91b",
                        "source_entry_id": "232b2558-46c3-3e8a-9232-2008ae628309",
                        "source_sense_id": "17ab56c4-bd30-3a91-98ca-a60996eb3929",
                        "source_sense_description": "weapon",
                        "target_lang_word": "Brandbombe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brandbombe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58058dbc-1303-3472-80ce-b42f020c9603",
                                        "entry_id": "b80c54f3-7352-3b86-85bb-7892b9cf3238",
                                        "glosses": [
                                            "Bombe, die ein möglichst großes Schadfeuer entfachen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c93a2ee-8a15-4b3c-bdf3-9f4fb78fd15a",
                                                "sense_id": "58058dbc-1303-3472-80ce-b42f020c9603",
                                                "text": "Berlin war durch Brandbomben 1945 praktisch komplett zerstört."
                                            },
                                            {
                                                "example_id": "2c57f296-1531-4500-a565-5c664a5fd404",
                                                "sense_id": "58058dbc-1303-3472-80ce-b42f020c9603",
                                                "text": "Bei einem Anschlag mit einer Brandbombe auf einen Bus voller schlafender Fahrgäste sind am Dienstag in Bangladesch mindestens sieben Menschen getötet worden."
                                            },
                                            {
                                                "example_id": "3793330c-c3dd-48b9-b732-892daa7b0627",
                                                "sense_id": "58058dbc-1303-3472-80ce-b42f020c9603",
                                                "text": "„Aber als die englischen und amerikanischen Bombergeschwader Tag für Tag kamen und Brandbomben Hitlers Wohnräume in der Alten Reichskanzlei unbewohnbar machten, zog er im Februar ganz in das katakombenhafte Kellerquartier.“"
                                            },
                                            {
                                                "example_id": "7f8ce42c-6e68-4e16-89b2-c002c4bf92f4",
                                                "sense_id": "58058dbc-1303-3472-80ce-b42f020c9603",
                                                "text": "„Das Haus Elisabeths war nicht getroffen worden; aber eine Brandbombe war in das übernächste Haus gefallen, der Wind hatte die Flammen herübergeweht, und jetzt brannten die Dächer aller drei Häuser.“"
                                            },
                                            {
                                                "example_id": "a7638e68-dee3-4692-8465-460088fe42fb",
                                                "sense_id": "58058dbc-1303-3472-80ce-b42f020c9603",
                                                "text": "„Mehr als zwanzig Minuten lang zitterten sie im Keller, während sechs amerikanische Bomberstaffeln mehr als 500 Tonnen Spreng- und Brandbomben über der Stadt abwarfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
