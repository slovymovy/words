                ],
                "senses": [
                    {
                        "sense_id": "6d8e53b5-5fa3-37e0-a08a-6d9b99826df9",
                        "entry_id": "4ebec4e3-f5f0-3153-a327-19796aebdcf9",
                        "glosses": [
                            "To transport by, or as if by, lorry."
                        ],
                        "tags": [
                            "also",
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "07f131eb-9011-41d5-8d5c-ef4d418f9a24",
                                "sense_id": "6d8e53b5-5fa3-37e0-a08a-6d9b99826df9",
                                "text": "[S]he had bought three jars of baby food, for convenience, and was busy lorrying them into me when I unintentionally spurted a huge mouthful all over her magnificent blouse and skirt."
                            },
                            {
                                "example_id": "25fdb0ce-95ed-443c-9857-9b6e20af10d1",
                                "sense_id": "6d8e53b5-5fa3-37e0-a08a-6d9b99826df9",
                                "text": "At a lamplit corner I signalled a cross-bearing transport, and to low salutations of 'Evening, sir,' was hoisted up, bag and all, and swiftly lorried away."
                            },
                            {
                                "example_id": "b079210a-c168-49dd-9433-79663d783a80",
                                "sense_id": "6d8e53b5-5fa3-37e0-a08a-6d9b99826df9",
                                "text": "He lorried away with a whole pile of things, and cheated the bailiffs."
                            },
                            {
                                "example_id": "7aa634df-0ca0-437d-a94b-5e19ccd80d77",
                                "sense_id": "6d8e53b5-5fa3-37e0-a08a-6d9b99826df9",
                                "text": "The midday meal at 1230hrs for 'C' and 'D' Companies would be followed by them parading at the camp gates for lorrying to Hazebrouck."
                            }
                        ]
                    }
                ],
