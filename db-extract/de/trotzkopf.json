                        "glosses": [
                            "Mensch, der Ansprüche/Wünsche, die an ihn gerichtet sind, ablehnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b275cf5a-51a1-4548-8137-5e62dc5ba52a",
                                "sense_id": "0a7dfde7-063c-3c9c-95c3-818854701332",
                                "text": "„Er nötigte mich, mit ihm zum Souper hinunterzugehen, um die Gemütsruhe dieses Trotzkopfes zu bewundern.“"
                            },
                            {
                                "example_id": "1b643231-ef2b-41f6-b34d-2ffc0085d908",
                                "sense_id": "0a7dfde7-063c-3c9c-95c3-818854701332",
                                "text": "„War er doch selber ein Trotzkopf und von einem Selbstgefühle, das dem seines Gegners unter Umständen die Spitze bieten konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
