                ],
                "senses": [
                    {
                        "sense_id": "54d80957-c03e-3014-807e-9dd722f19bd5",
                        "entry_id": "4af23603-67c3-3f8c-9123-9ae24d53f976",
                        "glosses": [
                            "устар. то же, что злопамятный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf25ecb-3e59-45cf-9994-84dbdb0ef366",
                                "sense_id": "54d80957-c03e-3014-807e-9dd722f19bd5",
                                "text": "И тут стала еще одна перемена: он стал осторожен к людям, и хоть был гневлив и памятозлобен, но после гнева, если тот кланялся низко и со смирением, он ему отдавал поклон."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfce37cb-c061-4bdd-9ad1-ecc90cb48f27",
                        "source_entry_id": "4af23603-67c3-3f8c-9123-9ae24d53f976",
                        "source_sense_id": "54d80957-c03e-3014-807e-9dd722f19bd5",
                        "target_lang_word": "unforgiving",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unforgiving",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8af0e2c-2f15-3d7c-978f-a905b687345a",
                                        "entry_id": "292cf26c-5f2b-33d5-b47a-b3e4212e3a33",
                                        "glosses": [
                                            "Unwilling or unable to forgive or show mercy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9afcb603-392d-4209-84d9-42f9524ebbcc",
                                                "sense_id": "d8af0e2c-2f15-3d7c-978f-a905b687345a",
                                                "text": "The electorate was in an unforgiving mood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ed29371-be13-3b1a-a010-618b1b6c29df",
                                        "entry_id": "292cf26c-5f2b-33d5-b47a-b3e4212e3a33",
                                        "glosses": [
                                            "Having no allowance for weakness."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b58183b9-4acf-406c-b139-2635984cdfc8",
                                                "sense_id": "3ed29371-be13-3b1a-a010-618b1b6c29df",
                                                "text": "The unforgiving Arctic climate makes short work of the unprepared."
                                            },
                                            {
                                                "example_id": "1f229d55-19b0-4404-8805-f59532f5f1b0",
                                                "sense_id": "3ed29371-be13-3b1a-a010-618b1b6c29df",
                                                "text": "In a raucous atmosphere, it was an unforgiving and physical contest from the start. Grant Hanley conceded the first free-kick within the opening 20 seconds, setting the tone for a busy and thankless evening for Serbian referee Milorad Mazic."
                                            },
                                            {
                                                "example_id": "1a573edd-653b-407a-9153-59bff0287356",
                                                "sense_id": "3ed29371-be13-3b1a-a010-618b1b6c29df",
                                                "text": "The line may be very scenic, but it runs through areas exposed to some extreme and unforgiving weather that does its worst on station buildings and the infrastructure!"
                                            },
                                            {
                                                "example_id": "9172ebfd-dcac-4eab-9e8f-595e9a080843",
                                                "sense_id": "3ed29371-be13-3b1a-a010-618b1b6c29df",
                                                "text": "The terrain in Ukraine’s south is unforgiving for attackers, with wide open fields and little high ground, and Ukrainian troops are meeting staunch resistance from Russian forces."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
