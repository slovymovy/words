                                        "examples": [
                                            {
                                                "example_id": "6de666ab-cd9a-4ce4-a6d0-9fbf26981433",
                                                "sense_id": "2b6d12bf-3a02-3326-a21d-51ac7db1b110",
                                                "text": "He advanced, touched the covers with his fingers as if to identify and greet the author of each, and then progressed towards the group of Tanagra figures in their glass case."
                                            }
