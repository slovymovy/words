{
    "word_family": [
        "felid",
        "felinity",
        "felinely"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "adee05ba-ebef-3f31-add5-ca7e22a1f8e5",
                    "sense_definition": "Of or pertaining to cats.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cat-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veterinarian specializes in <w>feline</w> health and common diseases of domestic cats.",
                            "target_lang_translations": {
                                "ru": "Ветеринар специализируется на <w>кошачьем</w> здоровье и распространенных заболеваниях домашних кошек."
                            }
                        },
                        {
                            "text": "The tiger is a powerful <w>feline</w> predator that hunts in the dense jungle.",
                            "target_lang_translations": {
                                "ru": "Тигр — это мощный хищник из семейства <w>кошачьих</w>, который охотится в густых джунглях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "feline behavior",
                        "feline expert",
                        "feline health"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к кошкам или семейству кошачьих."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кошачий",
                                "target_lang_sense_clarification": "принадлежащий кошкам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0b75c18-f662-3af9-b4d3-5cbab966c7b7",
                    "sense_definition": "Resembling a cat, especially in being sleek, graceful, or cunning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cat-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She moved across the dance floor with <w>feline</w> grace and absolute confidence.",
                            "target_lang_translations": {
                                "ru": "Она двигалась по танцполу с <w>кошачьей</w> грацией и абсолютной уверенностью."
                            }
                        },
                        {
                            "text": "The detective noticed his <w>feline</w> movement as he quietly slipped out of the room.",
                            "target_lang_translations": {
                                "ru": "Детектив заметил его <w>кошачью</w> походку, когда тот тихо выскользнул из комнаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "catly"
                    ],
                    "common_phrases": [
                        "feline grace",
                        "feline movement",
                        "feline agility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий кошку, особенно грациозностью, ловкостью или хитростью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кошачий",
                                "target_lang_sense_clarification": "о грации или движениях"
                            },
                            {
                                "target_lang_word": "грациозный",
                                "target_lang_sense_clarification": "плавный и ловкий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa883176-a823-3a33-b260-e63b67c179d7",
                    "sense_definition": "A cat or any member of the biological family Felidae.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cat-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lions and leopards are among the most dangerous <w>felines</w> found in the wild.",
                            "target_lang_translations": {
                                "ru": "Львы и леопарды входят в число самых опасных <w>кошачьих</w>, встречающихся в дикой природе."
                            }
                        },
                        {
                            "text": "The sanctuary provides a safe home for every <w>feline</w> rescued from the illegal trade.",
                            "target_lang_translations": {
                                "ru": "Заповедник предоставляет безопасный дом для каждого представителя <w>кошачьих</w>, спасенного от незаконной торговли."
                            }
                        }
                    ],
                    "synonyms": [
                        "cat",
                        "felid"
                    ],
                    "common_phrases": [
                        "large feline",
                        "domestic feline",
                        "wild feline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кошка или любое животное из семейства кошачьих."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кошачье",
                                "target_lang_sense_clarification": "представитель семейства"
                            },
                            {
                                "target_lang_word": "кошка",
                                "target_lang_sense_clarification": "в широком смысле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57eb9043-b79b-39a8-89f6-80be8452fdb8",
                    "sense_definition": "Any member of Felinae, one of the two extant subdivisions of the cat family.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cat-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Biologists distinguish between a pantherine and a <w>feline</w> based on specific skeletal structures.",
                            "target_lang_translations": {
                                "ru": "Биологи различают пантеровых и <w>малых кошек</w> на основе специфического строения скелета."
                            }
                        },
                        {
                            "text": "The cougar is technically a large <w>feline</w> rather than a member of the Panthera genus.",
                            "target_lang_translations": {
                                "ru": "Пума технически является крупной <w>малой кошкой</w>, а не представителем рода пантер."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific classification"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель подсемейства малых кошек (Felinae)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малая кошка",
                                "target_lang_sense_clarification": "биологическая классификация"
                            },
                            {
                                "target_lang_word": "фелина",
                                "target_lang_sense_clarification": "научный термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}