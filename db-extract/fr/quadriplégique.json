                                "sense_id": "f5cd8055-aa8f-3925-aa6d-4274313ee3fb",
                                "text": "En 2019, Jen Leitch a eu un gros accident de la route qui l’a laissée quadriplégique."
                            },
                            {
                                "example_id": "50ea0230-57e6-42f6-949c-4c3319b09e3e",
                                "sense_id": "f5cd8055-aa8f-3925-aa6d-4274313ee3fb",
                                "text": "Née à Oshawa en 1949, Judith Snow a été déclarée quadriplégique à l’âge de sept mois."
                            }
                        ]
                    }
