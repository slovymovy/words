                        "zur Frau nehmen",
                        "Mann und Frau"
                    ]
                },
                {
                    "sense_id": "2bc70d48-4a47-323a-8dff-6bc782f12189",
                    "sense_definition": "Höfliche Anrede oder Namenszusatz vor dem Nachnamen einer weiblichen Person",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "anrede",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sehr geehrte <w>Frau</w> Schmidt, wir laden Sie herzlich zu unserem Vorstellungsgespräch ein."
                        },
                        {
                            "text": "Guten Morgen, <w>Frau</w> Müller, haben Sie die neuen Unterlagen schon bekommen?"
