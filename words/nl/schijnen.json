                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vandaag <w>schijnt</w> de zon de hele dag fel.",
                            "target_lang_translations": {
                                "en": "Today the sun is <w>shining</w> brightly all day.",
                                "ru": "Сегодня солнце ярко <w>светит</w> весь день.",
                                "fr": "Aujourd'hui, le soleil <w>brille</w> intensément toute la journée.",
                                "pl": "Dzisiaj słońce mocno <w>świeci</w> przez cały dzień.",
                                "de": "Heute <w>scheint</w> die Sonne den ganzen Tag kräftig.",
                                "it": "Oggi il sole <w>splende</w> forte tutto il giorno.",
                                "cs": "Dnes po celý den jasně <w>svítí</w> slunce.",
                                "tr": "Bugün güneş bütün gün boyunca parlak bir şekilde <w>parlıyor</w>.",
                                "es": "Hoy el sol <w>brilla</w> con fuerza todo el día."
                            }
                        },
                        {
                            "text": "De maan <w>scheen</w> door de bomen in het donkere bos.",
                            "target_lang_translations": {
                                "en": "The moon <w>shone</w> through the trees in the dark forest.",
                                "ru": "Луна <w>светила</w> сквозь деревья в темном лесу.",
                                "fr": "La lune <w>brillait</w> à travers les arbres dans la forêt sombre.",
                                "pl": "Księżyc <w>świecił</w> przez drzewa w ciemnym lesie.",
                                "de": "Der Mond <w>schien</w> durch die Bäume im dunklen Wald.",
                                "it": "La luna <w>risplendeva</w> tra gli alberi nella foresta oscura.",
                                "cs": "Měsíc <w>svítil</w> skrze stromy v temném lese.",
                                "tr": "Karanlık ormanda ay, ağaçların arasından <w>parlıyordu</w>.",
                                "es": "La luna <w>brillaba</w> a través de los árboles en el bosque oscuro."
                            }
