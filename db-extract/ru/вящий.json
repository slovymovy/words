                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e47c91-c90e-40e1-8056-4927ce0bee68",
                                                "sense_id": "4d276228-a20d-3090-8e54-535a9eb48c5d",
                                                "text": "The San Juan market is Mexico City's most famous deli of exotic meats, where an adventurous shopper can hunt down hard-to-find critters such as ostrich, wild boar and crocodile. Only the city zoo offers greater species diversity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "greater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63f42b6a-34ef-3382-9a47-f29ea3184ef5",
                                        "entry_id": "05bc2f7a-3206-3e87-ad84-094ba6b0f94a",
                                        "glosses": [
                                            "Of two (or, rarely, more than two) things: the larger in size (bigger), in value, in importance etc."
