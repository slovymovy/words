                "senses": [
                    {
                        "sense_id": "7ec9f06b-52d9-3e90-8f2d-e127637d7b7c",
                        "entry_id": "e7dff4e0-a210-3d2c-a765-e3095ec57ac0",
                        "glosses": [
                            "trouble"
                        ],
                        "tags": [
                            "colloquial",
                            "dated",
                            "feminine",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "020751c1-d05c-4e8e-aba1-fefe4dcbe78d",
                                "sense_id": "7ec9f06b-52d9-3e90-8f2d-e127637d7b7c",
                                "text": "Die Aufgabenstellung hat mich in beträchtliche Schwulitäten versetzt.",
                                "translation": "The task at hand was seriously troublesome for me.",
                                "english": "The task at hand was seriously troublesome for me."
                            },
                            {
                                "example_id": "47059539-69d6-4731-9c18-1b3d490e0f2b",
                                "sense_id": "7ec9f06b-52d9-3e90-8f2d-e127637d7b7c",
                                "text": "„Es ist aber ein Menschenbedürfnis,“ sagte Wehsal kläglich, „ein Menschenbedürfnis, lieber Castorp, zu reden und sich das Herz zu erleichtern, wenn man in solchen Schwulitäten sitzt wie ich.“",
                                "translation": "“But it is a human need,” Wehsal said miserably “a human need, my dear Castorp, to talk and speak your heart, when you're in such trouble as I am.”",
                                "english": "“But it is a human need,” Wehsal said miserably “a human need, my dear Castorp, to talk and speak your heart, when you're in such trouble as I am.”"
                            }
                        ]
                    }
                ],
