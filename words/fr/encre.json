                    "sense_definition": "Liquide coloré utilisé pour écrire, dessiner ou imprimer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai acheté une nouvelle cartouche d'<w>encre</w> pour mon imprimante de bureau."
                        },
                        {
                            "text": "Mon stylo plume n'a plus d'<w>encre</w> pour écrire ce long paragraphe."
                        }
                    ],
                    "common_phrases": [
