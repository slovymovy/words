        "pl-extract.jsonl": [
            {
                "entry_id": "f1b6d1a4-2bd0-3cdf-a8f3-209d41a7cb0d",
                "word": "wystrzał",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9bb92803-6188-381e-9b28-67b473e2dee3",
                        "entry_id": "f1b6d1a4-2bd0-3cdf-a8f3-209d41a7cb0d",
                        "glosses": [
                            "efekt wyrzucenia pocisku z broni miotającej lub broni palnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6d07102-c313-43db-a6f2-4f85c516ffac",
                                "sense_id": "9bb92803-6188-381e-9b28-67b473e2dee3",
                                "text": "Oddalały się od skutej lodem powierzchni Hoth, gdy wstrząsy wtórne wystrzału działa jonowego sprawiały, że przez bazę niosły się warkoty i trzaski"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2e4f107b-d6e5-3495-b3dc-88d49d9f9949",
                        "entry_id": "f1b6d1a4-2bd0-3cdf-a8f3-209d41a7cb0d",
                        "glosses": [
                            "niemal poziomy maszt wystający na rufie żaglowca"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a8f0de2-83fd-4188-9550-6bec4c67da42",
                        "source_entry_id": "f1b6d1a4-2bd0-3cdf-a8f3-209d41a7cb0d",
                        "source_sense_id": "2e4f107b-d6e5-3495-b3dc-88d49d9f9949",
                        "target_lang_word": "boomkin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boomkin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "feb69801-6a6d-3b2e-82ba-d4a1b5af9066",
                                        "entry_id": "e2aeab30-1f95-34b5-b2f4-06c733b82152",
                                        "glosses": [
                                            "Alternative form of bumkin."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f70ed14e-f0b2-499b-ba13-2a15584779f5",
                                                "sense_id": "feb69801-6a6d-3b2e-82ba-d4a1b5af9066",
                                                "text": "If one refers to af chapman one finds that while only three drawings of comparable ships show boomkins fitted, all drawings of bluff-headed ships show either an extra timberhead or a half-round cutting in the top of the hawse piece to accommodate this spar when needed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b486cd4-b3d0-4577-a893-7d6f693d4eb7",
                        "source_entry_id": "f1b6d1a4-2bd0-3cdf-a8f3-209d41a7cb0d",
                        "source_sense_id": "9bb92803-6188-381e-9b28-67b473e2dee3",
                        "target_lang_word": "Schuss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b309288e-479f-3aec-ba74-2845d6c89d8a",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "Abfeuern einer Waffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9b87e02-359f-4da5-87e7-53c2221e1041",
                                                "sense_id": "b309288e-479f-3aec-ba74-2845d6c89d8a",
                                                "text": "Zur Warnung gab die Polizei einen Schuss ab."
                                            },
                                            {
                                                "example_id": "7187a674-9275-4dac-adeb-f1e1bb2d5beb",
                                                "sense_id": "b309288e-479f-3aec-ba74-2845d6c89d8a",
                                                "text": "„Nur noch vereinzelt waren Schüsse zu hören.“"
                                            },
                                            {
                                                "example_id": "3e7c2b4a-eec4-4551-9e28-b87cb03a132a",
                                                "sense_id": "b309288e-479f-3aec-ba74-2845d6c89d8a",
                                                "text": "„Sie hatten die Autos noch nicht erreicht, als ein Schuss durch die klare Nachtluft hallte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5444f5e3-8ecb-3697-97c0-c14e01390b82",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "der Vorgang des Schießens, vom Abfeuern bis zum Eindringen des Geschosses ins Ziel (oder daneben)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e052ca49-f7c4-4e87-928a-098cf1fbeddc",
                                                "sense_id": "5444f5e3-8ecb-3697-97c0-c14e01390b82",
                                                "text": "Ein Schuss traf ihn ins Bein, ein anderer in die rechte Hand."
                                            },
                                            {
                                                "example_id": "b1293921-1813-44a1-94f3-e00488da89c1",
                                                "sense_id": "5444f5e3-8ecb-3697-97c0-c14e01390b82",
                                                "text": "Stauffacher: „Gott sei gelobt!“ Leuthold: „Das war ein Schuss! Davon / Wird man noch reden in den spätsten Zeiten.“ (Schiller)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9f73cd5c-2eae-3822-8517-78be0eecf96f",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "Mengenangabe des jeweiligen Geschosses"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d56a0d1a-72c2-4da6-9b2e-b404dea8fa31",
                                                "sense_id": "9f73cd5c-2eae-3822-8517-78be0eecf96f",
                                                "text": "„Wieviel Schuss hast du noch“, fragte er unsicher. „Ein Magazin und zwei Kugeln im Lauf!“, sagte der andere."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ebcd06f1-6649-3261-b9ee-ea95647adddb",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "Treten eines Balles"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f085150a-1a32-411c-8fe3-3ecb1838f5b5",
                                                "sense_id": "ebcd06f1-6649-3261-b9ee-ea95647adddb",
                                                "text": "Michael Ballack setzt zum Schuss an, schießt und … leider Ecke."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f9491588-0eb2-3eb7-b670-6ff4036d82f4",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "etwas, eine kleinere Menge (in Bezug auf Flüssigkeiten)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae5940c8-8d68-46f5-bd4a-94a9abe86ba3",
                                                "sense_id": "f9491588-0eb2-3eb7-b670-6ff4036d82f4",
                                                "text": "Ich hätte gern Tee mit einem Schuss Rum."
                                            },
                                            {
                                                "example_id": "4fc08c7f-fb31-493c-94cc-4c1c3ee140c4",
                                                "sense_id": "f9491588-0eb2-3eb7-b670-6ff4036d82f4",
                                                "text": "Berliner Weiße mit Schuss"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "2f5d22ab-76cf-392c-8e60-c40f16ffe688",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "Injektion einer Droge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b30b8a1-e374-4716-b475-8ed93b1ab62c",
                                                "sense_id": "2f5d22ab-76cf-392c-8e60-c40f16ffe688",
                                                "text": "Sie setzte sich einen Schuss mit einer rostigen Spritze."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "98bdfae7-4a10-3165-a7ff-d105a4524a89",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "die Aufzeichnung eines bewegten Bildes (Video / Film)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49909af8-fc0d-40a8-ab90-29d5eb697994",
                                                "sense_id": "98bdfae7-4a10-3165-a7ff-d105a4524a89",
                                                "text": "Eine Kamera übernimmt den Schuss auf den Moderator, die andere den Gegenschuss auf den Gast."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "c55333eb-e45c-3332-b038-487b7b33661b",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "Weberei: der beim Weben durch die Kette geführte Faden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e51e2c42-1813-4df8-84c2-2869e2bb3783",
                                                "sense_id": "c55333eb-e45c-3332-b038-487b7b33661b",
                                                "text": "Beim Halbleinen ist entweder die Kette oder der Schuss aus Baumwolle."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "a982a2d6-1ae0-3fdf-862a-22c81153162c",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "leichte Verrücktheit"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17fa4d50-5e2c-4b19-a613-a0116476a8f1",
                                                "sense_id": "a982a2d6-1ae0-3fdf-862a-22c81153162c",
                                                "text": "Hör doch auf, du hast ja einen Schuss!"
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "b0680cf5-51f8-3b0d-b3fa-7c422dc609ca",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "besonders schnelles Wachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fbe9151-41ec-41cc-af78-bb46e0b8b10c",
                                                "sense_id": "b0680cf5-51f8-3b0d-b3fa-7c422dc609ca",
                                                "text": "Bei günstiger Witterung machen die Pflanzen im Frühjahr einen Schuss."
                                            },
                                            {
                                                "example_id": "be6a60c9-faab-41eb-8098-34b541723383",
                                                "sense_id": "b0680cf5-51f8-3b0d-b3fa-7c422dc609ca",
                                                "text": "„Du meine Güte, Junge, hast Du einen Schuss gemacht! Du kannst mir jetzt ja auf den Kopf spucken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "237424ff-356e-4ccc-b619-1fc3a8f9a2c2",
                        "source_entry_id": "f1b6d1a4-2bd0-3cdf-a8f3-209d41a7cb0d",
                        "source_sense_id": "9bb92803-6188-381e-9b28-67b473e2dee3",
                        "target_lang_word": "Knall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59edd629-dae1-38a3-a8f7-5bdb01803b34",
                                        "entry_id": "0dfb0ce3-fd8e-3854-86e4-50b4894f8bac",
                                        "glosses": [
                                            "sehr kurzes, lautes Geräusch, wie von einer Detonation erzeugt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2279e713-b622-443d-9bd6-ed1cbab554c6",
                                                "sense_id": "59edd629-dae1-38a3-a8f7-5bdb01803b34",
                                                "text": "Der Knall von Feuerwerkskörpern kann sehr laut sein."
                                            },
                                            {
                                                "example_id": "72ff100a-ce67-499c-845f-53de356710ee",
                                                "sense_id": "59edd629-dae1-38a3-a8f7-5bdb01803b34",
                                                "text": "„Sein Herz schlug heftig, und der scharfe Knall der nahen Wasserbomben dröhnte noch in den Ohren.“"
                                            },
                                            {
                                                "example_id": "db9b776d-5049-49e2-9f58-0b678df4b38f",
                                                "sense_id": "59edd629-dae1-38a3-a8f7-5bdb01803b34",
                                                "text": "„Er durchbrach in aufreizender Unverschämtheit die über meinem Haus befindliche Schallmauer und verursachte dabei einen Knall, der als überwältigend bezeichnet werden muss.“"
                                            },
                                            {
                                                "example_id": "fb13f979-af16-4b18-9deb-ff9d4c6a8f44",
                                                "sense_id": "59edd629-dae1-38a3-a8f7-5bdb01803b34",
                                                "text": "„Auf einmal platzte der Destillierkolben mit dem Knall einer Granate in zwanzig Stücke, die bis an die Decke flogen, die Kochtöpfe zersplitterten, die Schaumlöffel plattschlugen und die Gläser zerbrachen; Kohlenstücke spritzten herum, der Ofen war zertrümmert – und am nächsten Tage fand Germaine einen Spatel auf dem Hof.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a7af7c4-6ed3-42f1-b19c-267dab69e6ee",
                        "source_entry_id": "f1b6d1a4-2bd0-3cdf-a8f3-209d41a7cb0d",
                        "source_sense_id": "9bb92803-6188-381e-9b28-67b473e2dee3",
                        "target_lang_word": "выстрел",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "выстрел",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a15573b2-8bb1-3e58-87d9-3ac20875121f",
                                        "entry_id": "fc1ead00-3b42-3c52-8099-acccfef718ea",
                                        "glosses": [
                                            "действие по значению гл. стрелять, выстреливать; выбрасывание снаряда метательным оружием или выбрасывание боеприпаса из канала ствола огнестрельного оружия; также выбрасывание чего-либо, воспринимаемого как снаряд, с помощью какого-либо устройства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a47ef3-435b-41ed-973b-697270a21619",
                                                "sense_id": "a15573b2-8bb1-3e58-87d9-3ac20875121f",
                                                "text": "Вы снимаете с плеча ружьё, прицеливаетесь в зайца и производите выстрел."
                                            },
                                            {
                                                "example_id": "495ec53a-db5c-4621-9468-f40350217aef",
                                                "sense_id": "a15573b2-8bb1-3e58-87d9-3ac20875121f",
                                                "text": "Особенностью выстрела из олимпийского лука является то, что стрела в момент выстрела не направлена в сторону мишени, а смещена немного влево."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db0778b4-1164-338f-931f-8c79513859fa",
                                        "entry_id": "fc1ead00-3b42-3c52-8099-acccfef718ea",
                                        "glosses": [
                                            "звук, сопровождающий выстрел [1] из огнестрельного оружия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec47df4e-6fb3-4fb4-a4d2-f813d901fd1c",
                                                "sense_id": "db0778b4-1164-338f-931f-8c79513859fa",
                                                "text": "Он взвёл опять курок, прицелился в фуражку, висевшую над окном; выстрел раздался — дым наполнил комнату."
                                            },
                                            {
                                                "example_id": "e9922447-4a30-42f3-b866-42fbbcb5dfca",
                                                "sense_id": "db0778b4-1164-338f-931f-8c79513859fa",
                                                "text": "Сухо щёлкнул выстрел, и Рыбаков упал между кочек лицом вниз."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304dafbe-2e57-348e-871c-2b1f8295b281",
                                        "entry_id": "fc1ead00-3b42-3c52-8099-acccfef718ea",
                                        "glosses": [
                                            "расстояние, которое может быть преодолено боеприпасом, выпущенным при стрельбе; дальность стрельбы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27913be6-28f5-4c26-9e4b-b90544797ddf",
                                                "sense_id": "304dafbe-2e57-348e-871c-2b1f8295b281",
                                                "text": "Этого петуха я видел не раз на боровом болоте Блюдечке, только на выстрел глухарь меня не подпускал: старый был, умный."
                                            },
                                            {
                                                "example_id": "459a9cfe-9112-410f-8b1d-512e1acfb9c2",
                                                "sense_id": "304dafbe-2e57-348e-871c-2b1f8295b281",
                                                "text": "А Ушаков приказал трем фрегатам приблизиться на картечный выстрел к обоим городам Кефалонии и в случае грабежей и буйств и невозможности остановить народ «лаской» стрелять сперва холостыми зарядами, а затем картечью."
                                            },
                                            {
                                                "example_id": "792437ec-0f15-455e-beb4-e4333c5e93d8",
                                                "sense_id": "304dafbe-2e57-348e-871c-2b1f8295b281",
                                                "text": "Я вооружился и, возлегши у дуба великого, ожидал восхода солнечного за три выстрела из лука от стен города."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e995f10-b792-351d-a5c5-8793424c604a",
                                        "entry_id": "fc1ead00-3b42-3c52-8099-acccfef718ea",
                                        "glosses": [
                                            "воен. боеприпас к артиллерийскому орудию, гранатомёту"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4465ca00-2b2d-45ef-b344-6eec2624bf87",
                                                "sense_id": "2e995f10-b792-351d-a5c5-8793424c604a",
                                                "text": "Гранатомет РПГ-7 и выстрелы к нему прошли модернизацию в направлении дальнейшего повышения кучности, ветроустойчивости и бронепробиваемости."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7555c2d-378e-3296-83a4-75859aea7f69",
                                        "entry_id": "fc1ead00-3b42-3c52-8099-acccfef718ea",
                                        "glosses": [
                                            "морск. горизонтальное рангоутное дерево, подвешенное над водой перпендикулярно борту судна"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2a56d3e-a13f-4bf3-af0b-d31a3a909875",
                                                "sense_id": "b7555c2d-378e-3296-83a4-75859aea7f69",
                                                "text": "На кораблях личному составу без предварительного разрешения запрещается: а) ходить по наружным трапам, садиться в корабельные шлюпки и катера, подниматься на мачты, ходить по выстрелам или спускаться за борт корабля…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
