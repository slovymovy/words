                                        "examples": [
                                            {
                                                "example_id": "d8cc3d9c-3dca-467d-9fa5-8f580f12e38c",
                                                "sense_id": "b44dbffb-a035-37ab-9e09-7719e890d737",
                                                "text": "For its French readers, Paris' Le Jazz Hot review was trying to explain the artistry of U.S. bebopper Charlie (\"Yard-bird\") Parker."
                                            },
                                            {
                                                "example_id": "ed98861b-73e2-431f-ac0f-9109bc0af972",
                                                "sense_id": "b44dbffb-a035-37ab-9e09-7719e890d737",
                                                "text": "A bebopper whose spare, rhythmic style was shaped by his love of Thelonious Monk, he performed at countless clubs, bars and cafes in North Beach and other San Francisco neighborhoods."
                                            }
                                        ]
