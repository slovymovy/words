                        "glosses": [
                            "Pollution de l’air sévère en Chine ou en Inde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "339d182c-e997-4ca8-84e8-3c5dec64f280",
                                "sense_id": "f40d5941-088e-311f-a867-4d7026e3c707",
                                "text": "Deux mois après l’airpocalypse de Pékin, ce sont 16 000 cadavres de porcs qui étaient repêchés dans le Huangpu, le fleuve qui traverse Shanghai."
                            },
                            {
                                "example_id": "7cb6f150-ec77-4d6c-92f3-683f6cc1b6e0",
                                "sense_id": "f40d5941-088e-311f-a867-4d7026e3c707",
                                "text": "La capitale de l'Inde se retrouve sous un épais brouillard toxique dû à la concentration de particules fines. Une pollution surnommée \"airpocalypse\", qui dès le début novembre fait suffoquer les habitants pendant plusieurs mois."
                            }
                        ]
                    }
