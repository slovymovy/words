                    {
                        "form_id": "cba3047b-6abd-4c64-860b-4c224446887c",
                        "entry_id": "c4e0a52c-072a-39ff-8dce-7d0e8a618491",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kolchosen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "968d6b57-727f-3ee3-a8ee-4ea092660590",
                        "entry_id": "c4e0a52c-072a-39ff-8dce-7d0e8a618491",
                        "glosses": [
                            "zu Zeiten der Sowjetunion bestehende landwirtschaftliche Produktionsgenossenschaft, deren Mitglieder formal die gemeinsamen Eigentümer der Produktionsmittel waren, während der bewirtschaftete Boden dem Staat gehörte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df3c86a-4f7e-41d0-a2f6-1d353b0f4d19",
                                "sense_id": "968d6b57-727f-3ee3-a8ee-4ea092660590",
                                "text": "„Nina Chruschtschowa begleitete ihren Mann Nikita, KPdSU-Generalsekretär von 1953 bis 1964, auf Staatsbesuchen rund um die Welt - in ihren Blümchenkleidern wirkte sie jedoch neben anderen Politikerfrauen wie Stilikone Jackie Kennedy wie eine Bäuerin von der Kolchose, nicht wie eine First Lady.“"
                            },
                            {
                                "example_id": "38288490-0098-4676-8a2d-54f3891d79db",
                                "sense_id": "968d6b57-727f-3ee3-a8ee-4ea092660590",
                                "text": "„Früher war Tadas Suraucius Lkw-Fahrer in der Kolchose Svendubre.“"
                            },
                            {
                                "example_id": "4f16afea-7adf-489a-bf7a-527268694c7e",
                                "sense_id": "968d6b57-727f-3ee3-a8ee-4ea092660590",
                                "text": "„Die Arbeit in der Kolchose war nach Sklavenprinzipien organisiert.“"
                            },
                            {
                                "example_id": "7a5d4c55-f122-488c-9274-d5ce43d97793",
                                "sense_id": "968d6b57-727f-3ee3-a8ee-4ea092660590",
                                "text": "„Die Bauern waren ja praktisch Kolchosniki, sie waren ihrer Kolchose zugeordnet.“"
                            },
                            {
                                "example_id": "a68ac371-f92c-4fab-b32b-5c700e5a444b",
                                "sense_id": "968d6b57-727f-3ee3-a8ee-4ea092660590",
                                "text": "„Mit knapp 20 verlässt Ruth Deske den Hof der Tamutis, um fortan in der Kolchose zu arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
