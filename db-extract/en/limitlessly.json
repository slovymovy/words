                                            "o uczuciu bezmiernie, ogromnie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a4381a6-2a41-427b-a7a7-48258f81619b",
                                                "sense_id": "2e138c24-4d42-3306-9d69-b3a8c33935c0",
                                                "text": "Czuła się tak znudzoną bezbrzeżnie, że żałosnym głosem prosiła wciąż uparcie, jak dziecko"
