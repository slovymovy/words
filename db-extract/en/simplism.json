                                        "entry_id": "eea2e2fe-75de-34fb-b386-ba110f2d5d65",
                                        "glosses": [
                                            "Idée, doctrine très ou trop simple, qui ignore volontairement les complications et la complexité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "328d3930-a97a-4969-b30f-f3e54c2a334c",
                                                "sense_id": "791595ed-fc63-3af5-a07b-fb4d150a424d",
                                                "text": "L’idée d’une relation linéaire entre la découverte et l’innovation, appelée « modèle linéaire de l’innovation » est aujourd’hui vivement critiquée pour son simplisme."
                                            }
                                        ]
                                    }
                                ]
