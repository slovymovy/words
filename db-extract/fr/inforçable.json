                        "glosses": [
                            "Qu’on ne peut forcer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65bc390c-1643-4b46-9911-0eac6273950c",
                                "sense_id": "26775517-2088-38a4-a6e6-a8006f09afe7",
                                "text": "Toutes les attaques de l’ennemi ne faisaient qu’augmenter le courage de l’armée dont la position paraissait inforçable."
                            },
                            {
                                "example_id": "0939e33d-5fb8-4630-891b-066d9a2f05b9",
                                "sense_id": "26775517-2088-38a4-a6e6-a8006f09afe7",
                                "text": "Devant elle, le poste des Islettes est le seul qui soit vraiment fort, sans être inforçable."
                            },
                            {
                                "example_id": "be08b316-d669-4291-8983-fc188349d810",
                                "sense_id": "26775517-2088-38a4-a6e6-a8006f09afe7",
                                "text": "S’il commettait la moindre erreur, il se retrouverait prisonnier de cette cabine qui servait également à bloquer les cambrioleurs battant en retraite. La nasse était inforçable, et sa cellule avait un désagréable avant-goût de prison."
                            }
                        ]
                    }
