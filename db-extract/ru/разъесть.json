                    },
                    {
                        "form_id": "40257b2d-81da-4d27-867a-810d49d8c381",
                        "entry_id": "63b02d49-3ea1-3d8a-956d-042659da5500",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "разъе́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3fdc9462-d89f-30fa-9c2f-dbec1f1aca52",
                        "entry_id": "63b02d49-3ea1-3d8a-956d-042659da5500",
                        "glosses": [
                            "растравить, вызвать в чем-нибудь окисление, гниение (о чем-нибудь едком, кислом, остром)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8c313ec-3649-4100-849f-8830a6225330",
                                "sense_id": "3fdc9462-d89f-30fa-9c2f-dbec1f1aca52",
                                "text": "Ржавчина разъела железо. Серная кислота разъела ткань."
                            }
                        ]
                    },
                    {
                        "sense_id": "156d2077-9b1f-3b56-874d-de877187a0bc",
                        "entry_id": "63b02d49-3ea1-3d8a-956d-042659da5500",
                        "glosses": [
                            "прост. сесть всё сообща"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d394a4ff-adc1-42ca-8e7b-bff92d21b806",
                                "sense_id": "156d2077-9b1f-3b56-874d-de877187a0bc",
                                "text": "Пришли ко мне в комнатенку… и начали пировать. «Когда всё разъели, Вера и говорит…»"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e101c091-8c4e-4117-8c9d-0e3aeaa0f16d",
                        "source_entry_id": "63b02d49-3ea1-3d8a-956d-042659da5500",
                        "target_lang_word": "corroder",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corroder",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "811c9143-717b-3216-a93f-3a970cf78481",
                                        "entry_id": "ed6de5c2-7cfe-3807-afce-a4fa65e0dd90",
                                        "glosses": [
                                            "Ronger. Il se dit des substances qui, en vertu d’une qualité caustique, rongent, brûlent quelque partie du corps vivant ou de quelque autre corps solide."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd5e0581-cb29-43da-aa07-810aaf2ca0aa",
                                                "sense_id": "811c9143-717b-3216-a93f-3a970cf78481",
                                                "text": "Le poison lui a corrodé les intestins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2834bd0a-a418-3d17-bcf3-0027491f2387",
                                        "entry_id": "ed6de5c2-7cfe-3807-afce-a4fa65e0dd90",
                                        "glosses": [
                                            "Action de dégrader une pièce métallique par une réaction d'oxydation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29a9ced3-652c-4ee9-a5ed-02419fbe274a",
                                                "sense_id": "2834bd0a-a418-3d17-bcf3-0027491f2387",
                                                "text": "La rouille corrode le fer."
                                            },
                                            {
                                                "example_id": "a5335edf-6694-4c0c-8b67-2f3357628813",
                                                "sense_id": "2834bd0a-a418-3d17-bcf3-0027491f2387",
                                                "text": "Cet acide, ce dissolvant n’a fait que corroder légèrement la surface du métal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e413997f-dab7-38da-904d-d658110b2f4c",
                                        "entry_id": "ed6de5c2-7cfe-3807-afce-a4fa65e0dd90",
                                        "glosses": [
                                            "Ronger."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ad2757-7f79-472b-9f70-ac9bc0e72bf7",
                                                "sense_id": "e413997f-dab7-38da-904d-d658110b2f4c",
                                                "text": "Oh ! que la haine est douloureuse ! comme elle corrode le cœur qui la distille !"
                                            },
                                            {
                                                "example_id": "efaa39b1-2136-4630-8d23-0047d32cc2f8",
                                                "sense_id": "e413997f-dab7-38da-904d-d658110b2f4c",
                                                "text": "Elles expliquèrent en outre à ma mère que la philosophie corrodait mortellement les âmes : en un an de Sorbonne, je perdrais ma foi et mes mœurs."
                                            },
                                            {
                                                "example_id": "750273d0-5e8e-4953-aaa3-0640f2e80968",
                                                "sense_id": "e413997f-dab7-38da-904d-d658110b2f4c",
                                                "text": "J’ai changé depuis : l’admiration a fait place à une pitié tragique pour cet homme [Saint-Just] corrodé, semble-t-il, avant de s’accomplir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
