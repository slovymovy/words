                "senses": [
                    {
                        "sense_id": "293de0df-1469-3536-ae5b-d312dd898025",
                        "entry_id": "a6dce5c1-dad5-3d98-b28d-e5b6093ffbb1",
                        "glosses": [
                            "Mann, der öffentlich zugängliche Toiletten sauber hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86155bf8-8c8d-4467-a805-39660d48e199",
                                "sense_id": "293de0df-1469-3536-ae5b-d312dd898025",
                                "text": "„Irgendwann geht Gary auf die Toilette und als er fertig ist und zum Waschbecken geht, steht da plötzlich dieser Toilettenmann vor ihm.“"
                            },
                            {
                                "example_id": "c825ab26-3a25-486c-8f56-fd7f0547f41a",
                                "sense_id": "293de0df-1469-3536-ae5b-d312dd898025",
                                "text": "„Sie sind in zwei Stämme aufgeteilt, den Toilettenmann und den Kameramann, […]. Doch in diesem dunklen Moment erwachte eine uralte Prophezeiung. Sie besagt, dass, wenn der Heilige Sohn geboren wird, göttliche Macht kommen wird und er die Fähigkeit besitzt, Waffen einen Mutbonus zu verleihen. Dieser Heilige Sohn ist dazu bestimmt, die von den Toilettenleuten und Fotografen besetzte Stadt zurückzuerobern […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
