                                        "sense_id": "6d00dddd-de57-3dab-bb55-cc8dae3cc122",
                                        "entry_id": "5dfdeab5-915a-3543-9435-fc6b8efb1e35",
                                        "glosses": [
                                            "A grey mineral, Sb₂S₃, that is the main ore of antimony; in powdered form, used as the cosmetic called kohl."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5adce4d-7da3-4560-898a-b478b274a6ad",
                                                "sense_id": "6d00dddd-de57-3dab-bb55-cc8dae3cc122",
                                                "text": "The eye-paint used from immemorial times in Egypt is usually held to be stibnite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb845639-84cf-4dd4-b087-5eb36d96c7c7",
