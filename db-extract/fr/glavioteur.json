                        "entry_id": "6b33f9b2-8be3-3544-a1bd-2333dabd81b1",
                        "glosses": [
                            "Celui projette des glaviots."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e83b0985-b95b-4c6f-abcb-dc1252a57621",
                                "sense_id": "2ddcbef1-afbf-310c-9723-5a604d72e22c",
                                "text": "On se laissait baratiner par ce glavioteur de Prophète-béquillard avec des histoires à la lèche-moi le cul."
                            },
                            {
                                "example_id": "bb87a194-eb7d-4f5e-827d-44cb38461de2",
                                "sense_id": "2ddcbef1-afbf-310c-9723-5a604d72e22c",
                                "text": "On souriait comme des benêts quand une vieille dame chinoise lui a balancé un glaviot sur la chaussure en passant. « Salope ! » a hurlé Ben. À ma grande surprise, j'étais – secrètement – du côté de la glavioteuse."
                            }
                        ]
                    }
