        "ru-extract.jsonl": [
            {
                "entry_id": "92870c07-d496-3e5a-b2e5-613f9c696a47",
                "word": "тпру",
                "pos": "intj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "202d0ebf-a14d-3415-8005-d4a95db2d555",
                        "entry_id": "92870c07-d496-3e5a-b2e5-613f9c696a47",
                        "glosses": [
                            "окрик для остановки лошади"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dd5c76d-79fa-4c5b-9a99-05cd11cb940d",
                                "sense_id": "202d0ebf-a14d-3415-8005-d4a95db2d555",
                                "text": "Тпру, тпру! ― кричал взбудораженный дружко и хлестанул остановившихся лошадей кнутовищем."
                            },
                            {
                                "example_id": "347a74ad-ee38-4f91-8ed3-87c6245a66d4",
                                "sense_id": "202d0ebf-a14d-3415-8005-d4a95db2d555",
                                "text": "Например, некоторые лица затруднялись произносить междометие „тпру“, которым русские возницы останавливают лошадей... эти люди выговаривали [его] не по [его] действительному произношению, а так, как здесь напечатано..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0681ee98-782f-446e-9f63-d0db7146da36",
                        "source_entry_id": "92870c07-d496-3e5a-b2e5-613f9c696a47",
                        "source_sense_id": "202d0ebf-a14d-3415-8005-d4a95db2d555",
                        "target_lang_word": "whoa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whoa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e569ceed-df4b-3c73-96e2-d71af7f0ac00",
                                        "entry_id": "b21e2f2c-7ce5-3e1d-a8eb-c206730db180",
                                        "glosses": [
                                            "Stop (especially when commanding a horse or imitative thereof); calm down; slow down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d717c965-e50f-4d4b-856d-8915c5f5b9e1",
                                                "sense_id": "e569ceed-df4b-3c73-96e2-d71af7f0ac00",
                                                "text": "Whoa, Nelly!"
                                            },
                                            {
                                                "example_id": "b978a670-4ce0-4df6-b00c-db5110c202ae",
                                                "sense_id": "e569ceed-df4b-3c73-96e2-d71af7f0ac00",
                                                "text": "I can see Mickie getting hot, I'm about to grab his arm, hold him back, say, Whoa, whoa, Mick, not here, it ain't worth it what happened inside just now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dea964a7-d37f-3088-b95a-8250daece38d",
                                        "entry_id": "b21e2f2c-7ce5-3e1d-a8eb-c206730db180",
                                        "glosses": [
                                            "An expression of surprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44faaf63-de30-400d-9154-9ad0274abe67",
                                                "sense_id": "dea964a7-d37f-3088-b95a-8250daece38d",
                                                "text": "Whoa, are you serious?"
                                            },
                                            {
                                                "example_id": "5261117e-06b5-43ae-abab-8d728d87980a",
                                                "sense_id": "dea964a7-d37f-3088-b95a-8250daece38d",
                                                "text": "Whoa. Wait a minute, Doc. Are you trying to tell me that my mother has got the hots for me?"
                                            },
                                            {
                                                "example_id": "bed3186f-dace-42c7-84a8-9dd1779294e8",
                                                "sense_id": "dea964a7-d37f-3088-b95a-8250daece38d",
                                                "text": "Jen: Douglas has asked me to be his PA.\nMoss: Oh. My. God! Well, that is something and a half. His PA? How... Whoa! His PA... Shut up! His PA!\nJen: It means \"personal assistant\".\nMoss: Thank you. Right, OK."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b98054d-8dca-3b3a-9100-6c1c50e51f2f",
                                        "entry_id": "b21e2f2c-7ce5-3e1d-a8eb-c206730db180",
                                        "glosses": [
                                            "Used as a meaningless filler in song lyrics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d96ac3-a2e6-4416-81f0-03ffdd2637bb",
                                                "sense_id": "7b98054d-8dca-3b3a-9100-6c1c50e51f2f",
                                                "text": "I am the type who is liable to snipe you\nWith two seconds left to go, whoa."
                                            },
                                            {
                                                "example_id": "ef88987b-a809-48e6-a1eb-de7756414ce5",
                                                "sense_id": "7b98054d-8dca-3b3a-9100-6c1c50e51f2f",
                                                "text": "And oh whoa girl, it's a shame.\nOh whoa girl, it's a doggone shame."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whoa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c66a110-3999-32ba-b87a-7a0eb288fb83",
                                        "entry_id": "b988bad8-55a4-37bb-b1a3-041c093a02ef",
                                        "glosses": [
                                            "To attempt to slow (an animal) by crying \\\"whoa\\\"."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "851343bd-b7cd-47de-9674-1ed90225e9c5",
                                                "sense_id": "4c66a110-3999-32ba-b87a-7a0eb288fb83",
                                                "text": "He was whoaing the horses loudly, and they did seem to be going faster than usual—in fact, they were galloping."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
