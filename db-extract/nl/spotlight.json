                                "target_senses": [
                                    {
                                        "sense_id": "d57d2dc9-d536-3075-a69e-58ad18f36697",
                                        "entry_id": "2b03a497-5978-3668-a561-580c773f99d4",
                                        "glosses": [
                                            "To illuminate with a spotlight."
