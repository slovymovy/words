                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "8008da44-7ff0-4fbb-8543-6ac7df297ed7",
                        "entry_id": "193e20b3-bbd9-3663-af65-c09b36697aa7",
