                                    {
                                        "sense_id": "cceffe6e-5296-3456-b496-ade722ef5b78",
                                        "entry_id": "6ab4f5d1-e050-3785-938f-2269098da2b1",
                                        "glosses": [
                                            "Bakterium, das im Darm von Mensch und Tier lebt und oft Krankheiten wie Typhus und Durchfall bewirkt"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ac6c93d-8c0d-472e-8b10-d93090fc0c13",
                                                "sense_id": "cceffe6e-5296-3456-b496-ade722ef5b78",
                                                "text": "Aufgrund der Lebensweise von Enten besteht jedoch eine erhöhte Gefahr des Befalls mit Salmonellen und weiteren Erregern"
                                            },
                                            {
                                                "example_id": "0db30b47-54fc-4d50-ad1d-caacb09bb88c",
                                                "sense_id": "cceffe6e-5296-3456-b496-ade722ef5b78",
                                                "text": "„Das wiederum lag an Thomas, der fürchtete, er und die Kinder könnten von den Tieren Salmonellen und eine Magen-Darm-Infektion bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0651efc-debb-431d-8b38-6235d9a57ebf",
