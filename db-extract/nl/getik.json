                "entry_id": "2391c9d1-377b-3a47-a9fb-859e8070057e",
                "word": "getik",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "29f95973-87d3-320d-88bd-357d0de3c83e",
                        "entry_id": "2391c9d1-377b-3a47-a9fb-859e8070057e",
                        "glosses": [
                            "aanhoudend een tikkend geluid maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3964da38-0da1-4bb6-ae51-89482d8a49a0",
                                "sense_id": "29f95973-87d3-320d-88bd-357d0de3c83e",
                                "text": "Ik word gek van het getik van klok."
                            },
                            {
                                "example_id": "d41636e1-a92b-40d3-a205-e59ca524bde3",
                                "sense_id": "29f95973-87d3-320d-88bd-357d0de3c83e",
                                "text": "Op de Utrechtse regioredactie mag ze aan de slag als telexiste, die is toch nodig. Met de telex worden artikelen naar de eindredactie in Amsterdam ‘gefaxt’. „Een vreselijke herrie maakte dat ding, het getik klonk door het hele gebouw."
                            }
                        ]
                    },
                    {
                        "sense_id": "08aa8c8d-111b-3b5f-85fe-9b819f2fd78c",
                        "entry_id": "2391c9d1-377b-3a47-a9fb-859e8070057e",
                        "glosses": [
                            "aanhoudend typen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52275d16-e0de-4a80-88af-6b76dc6246e7",
                                "sense_id": "08aa8c8d-111b-3b5f-85fe-9b819f2fd78c",
                                "text": "Gisteren zat ik met de computer op schoot in de stiltecoupé. Dat was dan fijn aan deze tijd; je hoefde niet zoals vroeger te wachten tot je ergens was om actief te worden. Ik moest een heel stuk tikken en tikte de ene zin na de andere. Het ging, excuus voor de woordgrap, eigenlijk als een trein. Net toen ik dacht dat ik misschien vaker met mijn laptop in zomaar een trein moest stappen, meldde zich een medereiziger. Hij probeerde zich te beheersen, maar aan alles was te zien dat hem dat grote moeite kostte. „Dat getik. Ik heb al sinds Amersfoort last. U haalt me totaal uit mijn concentratie. Dit is een stiltecoupé”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1670e84b-eba9-47b0-b626-822c2ef21d8d",
                        "source_entry_id": "2391c9d1-377b-3a47-a9fb-859e8070057e",
                        "source_sense_id": "29f95973-87d3-320d-88bd-357d0de3c83e",
                        "target_lang_word": "ticking of a clock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1a568617-46a4-4107-b9e7-27556f61a114",
                        "source_entry_id": "2391c9d1-377b-3a47-a9fb-859e8070057e",
                        "source_sense_id": "29f95973-87d3-320d-88bd-357d0de3c83e",
                        "target_lang_word": "tick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe8004d2-d81e-3a2c-af6e-911f7af8830c",
                                        "entry_id": "3aac2da1-7b5c-327c-9cc8-e3993862f0c3",
                                        "glosses": [
                                            "A tiny woodland arachnid of the suborder Ixodida."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45ad6236-977a-4f25-88ed-8fe6b5b54461",
                                                "sense_id": "fe8004d2-d81e-3a2c-af6e-911f7af8830c",
                                                "text": "Sucking up all you can / Sucking up all you can suck and suck / Working up under my patience like a little tick / Fat little parasite (parasite) / Suck me dry / My fruit is bruised and borrowed / You thieving bastards / You have turned my blood cold and bitter"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4832dc3-06ed-3a76-b92a-53d395515c96",
                                        "entry_id": "259e8889-8c6d-3251-adcc-e66a31feb284",
                                        "glosses": [
                                            "A relatively quiet but sharp sound generally made repeatedly by moving machinery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bac534c-8468-427c-b4ff-e6aebaa4e158",
                                                "sense_id": "e4832dc3-06ed-3a76-b92a-53d395515c96",
                                                "text": "The steady tick of the clock provided a comforting background for the conversation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "721f627c-29fa-387a-a3fc-b1cd101bf968",
                                        "entry_id": "259e8889-8c6d-3251-adcc-e66a31feb284",
                                        "glosses": [
                                            "A mark on any scale of measurement; a unit of measurement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a6fb40c-d8f5-4e23-bb52-af6f0b33e177",
                                                "sense_id": "721f627c-29fa-387a-a3fc-b1cd101bf968",
                                                "text": "At midday, the long bond is up a tick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "953d8a99-4f42-38c6-ad6d-2217420841c2",
                                        "entry_id": "259e8889-8c6d-3251-adcc-e66a31feb284",
                                        "glosses": [
                                            "A jiffy (unit of time defined by basic timer frequency)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0dc5aac-ff49-3d2b-9195-88979922dbb9",
                                        "entry_id": "259e8889-8c6d-3251-adcc-e66a31feb284",
                                        "glosses": [
                                            "A short period of time, particularly a second."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9beb12f-b455-454f-9436-a23472bed548",
                                                "sense_id": "f0dc5aac-ff49-3d2b-9195-88979922dbb9",
                                                "text": "I'll be back in a tick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80663037-0659-3b36-9e0d-bc68c1d63923",
                                        "entry_id": "259e8889-8c6d-3251-adcc-e66a31feb284",
                                        "glosses": [
                                            "A periodic increment of damage or healing caused by an ongoing status effect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d3d74e2-954a-30ef-b604-69fa4815b26c",
                                        "entry_id": "259e8889-8c6d-3251-adcc-e66a31feb284",
                                        "glosses": [
                                            "Each of the fixed time periods, in a tick-based game, in which players or characters may perform a set number of actions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96b1c9fb-d641-397b-9d8c-bb2db8a99db2",
                                        "entry_id": "259e8889-8c6d-3251-adcc-e66a31feb284",
                                        "glosses": [
                                            "A mark (✓) made to indicate agreement, correctness or acknowledgement."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Ireland",
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32876fe6-94a2-4b40-a26d-e5eee31977ef",
                                                "sense_id": "96b1c9fb-d641-397b-9d8c-bb2db8a99db2",
                                                "text": "Indicate that you are willing to receive marketing material by putting a tick in the box"
                                            },
                                            {
                                                "example_id": "829f00c9-3d2d-495a-b07f-f312088eb33c",
                                                "sense_id": "96b1c9fb-d641-397b-9d8c-bb2db8a99db2",
                                                "text": "Kate's choice to don her pink suit again now, at the height of the Barbiecore trend, shows the royal really does have her finger on the pulse. That, paired with her statement belt and the fact pearls are having a real fashion moment (courtesy of the Met Gala) is three big ticks from us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b45f1122-5ae3-39d5-8fd8-19049a69f01d",
                                        "entry_id": "259e8889-8c6d-3251-adcc-e66a31feb284",
                                        "glosses": [
                                            "A bird seen (or heard) by a birdwatcher, for the first time that day, year, trip, etc., and thus added to a list of observed birds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5b2413d-75e5-4c19-ac9b-1aea281aca28",
                                                "sense_id": "b45f1122-5ae3-39d5-8fd8-19049a69f01d",
                                                "text": "There are few birders who have not had stringy ticks on their lists at some stage."
                                            },
                                            {
                                                "example_id": "07fb8e46-560c-482b-92ff-7fd78dde1240",
                                                "sense_id": "b45f1122-5ae3-39d5-8fd8-19049a69f01d",
                                                "text": "A twitcher's list is very democratic. Each bird counts as one tick. There are no extra points for beauty or rarity. The humble sparrow counts just as much as a Wedge-tailed Eagle or a Paradise Parrot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7871151-2f9d-3688-a8ec-123009c7ca97",
                                        "entry_id": "259e8889-8c6d-3251-adcc-e66a31feb284",
                                        "glosses": [
                                            "A whinchat (Saxicola rubetra)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
