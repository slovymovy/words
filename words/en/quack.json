{
    "word_family": [
        "quackery",
        "quackish"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9210f85-2407-33ee-827c-bd6f7220d886",
                    "sense_definition": "The characteristic sound made by a duck.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "duck_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The duck let out a loud <w>quack</w> when it saw the bread.",
                            "target_lang_translations": {
                                "cs": "Kachna vydala hlasité <w>kváknutí</w>, když uviděla chleba."
                            }
                        },
                        {
                            "text": "Did you hear that duck make a <w>quack</w>?",
                            "target_lang_translations": {
                                "cs": "Slyšel jsi tu kachnu <w>kváknout</w>?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Charakteristický zvuk, který vydává kachna."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kvákání",
                                "target_lang_sense_clarification": "zvuk vydávaný kachnou"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c76647a-f77e-39a7-b80c-7a252684f6eb",
                    "sense_definition": "A person who dishonestly claims to have medical skills or sells worthless treatments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fraudulent_healer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That doctor is nothing but a dangerous <w>quack</w> who sells fake medicine.",
                            "target_lang_translations": {
                                "cs": "Ten doktor není nic jiného než nebezpečný <w>šarlatán</w>, který prodává falešné léky."
                            }
                        },
                        {
                            "text": "Many people were fooled by the <w>quack</w> and his false promises of a cure.",
                            "target_lang_translations": {
                                "cs": "Mnoho lidí bylo napáleno tím <w>šarlatánem</w> a jeho falešnými sliby o vyléčení."
                            }
                        }
                    ],
                    "synonyms": [
                        "snake-oil salesman",
                        "medicaster",
                        "quacksalver",
                        "pharmacopole"
                    ],
                    "common_phrases": [
                        "medical quack"
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba, která nepoctivě tvrdí, že má lékařské dovednosti, nebo prodává bezcennou léčbu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šarlatán",
                                "target_lang_sense_clarification": "podvodný léčitel"
                            },
                            {
                                "target_lang_word": "mastičkář",
                                "target_lang_sense_clarification": "osoba prodávající pochybné léky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fd156a3-1f10-3307-a713-e274d2ce9a3f",
                    "sense_definition": "A derogatory term for any doctor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fraudulent_healer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient called the surgeon a <w>quack</w> because he disagreed with the diagnosis.",
                            "target_lang_translations": {
                                "cs": "Pacient nazval chirurga <w>fušerem</w>, protože nesouhlasil s diagnózou."
                            }
                        },
                        {
                            "text": "That <w>quack</w> wants me to quit smoking and start exercising, but I do not trust him.",
                            "target_lang_translations": {
                                "cs": "Ten <w>šarlatán</w> po mně chce, abych přestal kouřit a začal cvičit, ale já mu nevěřím."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in a derogatory or dismissive manner."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hanlivý výraz pro jakéhokoli lékaře."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "fušer",
                                "target_lang_sense_clarification": "neschopný lékař"
                            },
                            {
                                "target_lang_word": "šarlatán",
                                "target_lang_sense_clarification": "hanlivé označení lékaře"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fa690bc-8d3e-3d1f-8099-1aca5cb7be08",
                    "sense_definition": "A person who pretends to have skills or knowledge they do not possess.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fraudulent_healer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a total <w>quack</w> who claims to be an expert in finance but knows nothing.",
                            "target_lang_translations": {
                                "cs": "Je to naprostý <w>podvodník</w>, který tvrdí, že je finanční expert, ale neví nic."
                            }
                        },
                        {
                            "text": "The industry is full of <w>quack</w> consultants who offer useless advice.",
                            "target_lang_translations": {
                                "cs": "Průmysl je plný <w>šarlatánských</w> poradců, kteří nabízejí k ničemu rady."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba, která předstírá, že má dovednosti nebo znalosti, které nemá."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "podvodník",
                                "target_lang_sense_clarification": "osoba předstírající odbornost"
                            },
                            {
                                "target_lang_word": "šarlatán",
                                "target_lang_sense_clarification": "v přeneseném smyslu kdokoli předstírající odbornost"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "168e99f4-a1f6-346b-b4ae-adf276571f86",
                    "sense_definition": "To make the characteristic sound of a duck.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "duck_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ducks began to <w>quack</w> loudly when they saw the food.",
                            "target_lang_translations": {
                                "cs": "Kachny začaly hlasitě <w>kvákat</w>, když uviděly jídlo."
                            }
                        },
                        {
                            "text": "Do you hear the ducks <w>quack</w> in the pond?",
                            "target_lang_translations": {
                                "cs": "Slyšíš ty kachny <w>kvákat</w> v rybníku?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat charakteristický zvuk kachny."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kvákat",
                                "target_lang_sense_clarification": "vydávat zvuk jako kachna"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6a4b600-a378-32ec-af97-3eeb6aa3a646",
                    "sense_definition": "To practice fraudulent medicine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fraudulent_healer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his career <w>quacking</w> and selling useless tonics to the public.",
                            "target_lang_translations": {
                                "cs": "Strávil svou kariéru <w>šarlatánstvím</w> a prodejem zbytečných toniků veřejnosti."
                            }
                        },
                        {
                            "text": "The authorities shut down the clinic for <w>quacking</w> without a license.",
                            "target_lang_translations": {
                                "cs": "Úřady zavřely kliniku kvůli <w>provozování šarlatánství</w> bez licence."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Provozovat podvodnou medicínu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šarlatánství",
                                "target_lang_sense_clarification": "provozování podvodné léčby"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b84f4f50-682f-3c12-8d06-1dbce5989204",
                    "sense_definition": "To make vain and loud claims about one's abilities.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fraudulent_healer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He continues to <w>quack</w> about his supposed success despite having no evidence.",
                            "target_lang_translations": {
                                "cs": "Pokračuje ve <w>vychloubání se</w> svým údajným úspěchem, přestože pro něj nemá žádné důkazy."
                            }
                        },
                        {
                            "text": "It is annoying to hear him <w>quack</w> about his achievements all day long.",
                            "target_lang_translations": {
                                "cs": "Je otravné ho celý den slyšet <w>vychloubat se</w> svými úspěchy."
                            }
                        }
                    ],
                    "synonyms": [
                        "boast"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vychloubačně a hlasitě mluvit o svých schopnostech."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vychloubat se",
                                "target_lang_sense_clarification": "přehnaně mluvit o svých úspěších"
                            },
                            {
                                "target_lang_word": "vytahovat se",
                                "target_lang_sense_clarification": "neformální výraz pro vychloubání"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9177e66f-9596-310e-a31a-12fd354cffcd",
                    "sense_definition": "To make a high-pitched sound, specifically referring to a queen bee.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "duck_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young queen bee will <w>quack</w> inside her cell before emerging.",
                            "target_lang_translations": {
                                "cs": "Mladá včelí matka bude uvnitř své buňky <w>kvákat</w>, než se vylíhne."
                            }
                        },
                        {
                            "text": "Beekeepers can hear the queen <w>quack</w> when she is ready to swarm.",
                            "target_lang_translations": {
                                "cs": "Včelaři mohou slyšet matku <w>kvákat</w>, když je připravena k rojení."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Technical term used in beekeeping."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat vysoký zvuk, specificky u včelí matky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kvákat",
                                "target_lang_sense_clarification": "zvuk včelí matky"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3fd543a9-4f4a-35b7-afe9-90caf7b3ac49",
                    "sense_definition": "Describing something falsely presented as having medicinal powers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fraudulent_healer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not waste your money on that <w>quack</w> medicine; it does not work.",
                            "target_lang_translations": {
                                "cs": "Neutrácejte peníze za ty <w>šarlatánské</w> léky; nefungují."
                            }
                        },
                        {
                            "text": "The advertisement was full of <w>quack</w> claims about curing every disease.",
                            "target_lang_translations": {
                                "cs": "Reklama byla plná <w>podvodných</w> tvrzení o vyléčení každé nemoci."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quack medicine"
                    ],
                    "target_lang_definitions": {
                        "cs": "Popisující něco, co je falešně prezentováno jako léčivé."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šarlatánský",
                                "target_lang_sense_clarification": "týkající se podvodné léčby"
                            },
                            {
                                "target_lang_word": "podvodný",
                                "target_lang_sense_clarification": "falešný, klamavý"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "57bb6aa8-7f13-332c-a0ab-51d30714c33a",
                    "sense_definition": "The sound made by a duck.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "duck_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Quack</w>! The duck swam across the lake.",
                            "target_lang_translations": {
                                "cs": "<w>Kvá</w>! Kachna přeplavala jezero."
                            }
                        },
                        {
                            "text": "I heard a loud <w>quack</w> coming from the bushes.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem hlasité <w>kvá</w> vycházející z křoví."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zvuk, který vydává kachna."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kvá",
                                "target_lang_sense_clarification": "citoslovce pro zvuk kachny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}