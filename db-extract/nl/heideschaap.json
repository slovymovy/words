                        "examples": [
                            {
                                "example_id": "f5d70634-4592-4b21-a5d5-d525dff5891b",
                                "sense_id": "74d9ead4-4118-32c2-b7b4-f6dc209f42c6",
                                "text": "De schaapskudde in Drenthe heeft een streng fokprogramma om het ras Drents heideschaap zo goed mogelijk in stand te houden. Mannetjes worden daarom als ze zes à zeven maanden zijn, weggehaald bij hun moeders."
                            },
                            {
                                "example_id": "1492a711-bfc9-4206-980b-828726706c83",
                                "sense_id": "74d9ead4-4118-32c2-b7b4-f6dc209f42c6",
                                "text": "De aanvraag was gedaan door het Gilde van Traditionele Schaapherders. Volgens het gilde wordt het ambacht van scheper met oude Nederlandse rassen zoals het Drents Heideschaap, het Groot Heideschaap en de Schoonebeeker steeds minder vaak uitgevoerd en is het een bedreigd erfgoed."
                            }
                        ]
                    }
