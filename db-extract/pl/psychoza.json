                                "target_senses": [
                                    {
                                        "sense_id": "319bb409-fdf8-387d-a453-4947cc60f425",
                                        "entry_id": "af07bdcf-30d8-38df-b641-94990e5c8d04",
                                        "glosses": [
                                            "Enfermedad mental caracterizada por síntomas como delirios o alucinaciones, perdida de contacto con la realidad."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2440b968-05f9-3dba-af24-85123707d2b6",
                                        "entry_id": "af07bdcf-30d8-38df-b641-94990e5c8d04",
                                        "glosses": [
                                            "Enfermedad mental severa como la esquizofrenia o la paranoia."
                                        ],
                                        "tags": [],
