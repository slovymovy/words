                        "entry_id": "c52daf63-1bb9-3343-888c-672c932f221e",
                        "glosses": [
                            "Qui émet dans les délibérations d’une assemblée, d’un tribunal, un suffrage qui compte."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "d2e56c4f-e1f8-47da-9b6b-78440c0c3174",
                                "sense_id": "2d6ff8bf-bf52-3816-a55d-bd2704c948da",
                                "text": "Les gentilshommes furent convoqués par lettres particulières, y compris ceux qui, comme moi, étaient trop jeunes pour avoir voix délibérative."
                            }
                        ]
                    }
                ],
