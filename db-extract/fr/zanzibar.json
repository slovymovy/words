        "fr-extract.jsonl": [
            {
                "entry_id": "0884c185-4a22-3f06-a4b7-c0ae361539a0",
                "word": "Zanzibar",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "df4b0ff3-ef56-32ab-b322-d0d5c4c1028f",
                        "entry_id": "0884c185-4a22-3f06-a4b7-c0ae361539a0",
                        "glosses": [
                            "Archipel tanzanien."
                        ],
                        "tags": [
                            "Îles"
                        ],
                        "examples": [
                            {
                                "example_id": "1527c41f-88c8-4c22-a251-18b237f907de",
                                "sense_id": "df4b0ff3-ef56-32ab-b322-d0d5c4c1028f",
                                "text": "Le crassispina est connu habiter, hors l’Inde archipélagique, la Mer rouge, les côtes de Zanzibar, des Seychelles, de Madras, de Chine et de la Nouvelle-Hollande septentrionale."
                            },
                            {
                                "example_id": "a65dfb2c-f6fe-4ea8-9128-8dcc84e176fd",
                                "sense_id": "df4b0ff3-ef56-32ab-b322-d0d5c4c1028f",
                                "text": "Zanzibar… Je n’aurais plus jamais loisir de m’y rendre. Zanzibar, paradis dans l’océan Indien, embaumé de clous de girofle."
                            },
                            {
                                "example_id": "66dd7a90-f75d-421d-b57b-031e431f1c10",
                                "sense_id": "df4b0ff3-ef56-32ab-b322-d0d5c4c1028f",
                                "text": "La Tanzanie, pays de 58 millions d’habitants connu pour ses parcs naturels, l’île de Zanzibar et le Kilimandjaro, a longtemps été considérée comme un havre de stabilité dans une région particulièrement volatile."
                            }
                        ]
                    },
                    {
                        "sense_id": "03582750-f495-34f6-a78c-3dee4257b669",
                        "entry_id": "0884c185-4a22-3f06-a4b7-c0ae361539a0",
                        "glosses": [
                            "Sultanat de Zanzibar."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "85ea0503-d7e7-3949-90be-a2bb2b3b545e",
                        "entry_id": "0884c185-4a22-3f06-a4b7-c0ae361539a0",
                        "glosses": [
                            "Protectorat de Zanzibar."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "997aabc5-0040-3a69-b32e-4015c795680c",
                        "entry_id": "0884c185-4a22-3f06-a4b7-c0ae361539a0",
                        "glosses": [
                            "Pays indépendant, situé dans l’archipel de Zanzibar et ayant existé entre le 10 septembre 1963 et le 26 avril 1964."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9c45f78b-3830-310b-bb62-76d754d25388",
                        "entry_id": "0884c185-4a22-3f06-a4b7-c0ae361539a0",
                        "glosses": [
                            "Ville de Zanzibar, localité la plus importante de l’archipel du même nom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4a33527-c498-40cd-8b72-e5665c574def",
                                "sense_id": "9c45f78b-3830-310b-bb62-76d754d25388",
                                "text": "En passant d’un monument à l’autre, vous conviendrez que Zanzibar est un musée, un livre d’histoire à ciel ouvert."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f01c477a-c960-4c99-b097-d9a30bd026cf",
                        "source_entry_id": "0884c185-4a22-3f06-a4b7-c0ae361539a0",
                        "target_lang_word": "Sansibar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sansibar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab70efd0-3d4e-3034-9aff-4f49ca7a635a",
                                        "entry_id": "db0c9fa0-ea47-33e4-8444-76818826d15f",
                                        "glosses": [
                                            "Insel an der ostafrikanischen Küste"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "83add580-f3db-30c3-93bc-053c244d3f62",
                                        "entry_id": "db0c9fa0-ea47-33e4-8444-76818826d15f",
                                        "glosses": [
                                            "ehemaliges Sultanat und britisches Protektorat und heutiger halbautonomer Teilstaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68bad748-c077-4d96-8389-a17a43fdc405",
                                                "sense_id": "83add580-f3db-30c3-93bc-053c244d3f62",
                                                "text": "„Es gelang ihm, alle wichtigen Leute zu treffen, vom Vizepräsidenten der Burenrepublik Transvaal über den Sultan von Sansibar bis zum Khediven von Ägypten.“"
                                            },
                                            {
                                                "example_id": "ce020a87-8880-4d92-8310-dd325860b539",
                                                "sense_id": "83add580-f3db-30c3-93bc-053c244d3f62",
                                                "text": "„1861 kommt es im Zuge eines Erbfolgestreits zunächst zur Teilung in das Sultanat Sansibar und das eigentliche Sultanat Oman.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e725831f-72f2-45b4-9200-156f162323e8",
                        "source_entry_id": "0884c185-4a22-3f06-a4b7-c0ae361539a0",
                        "target_lang_word": "Zanzibar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zanzibar",
