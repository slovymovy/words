                                "target_senses": [
                                    {
                                        "sense_id": "22bab989-3c5f-3eac-b580-f161da51af8a",
                                        "entry_id": "8288d137-1e75-3d0c-ad00-d71ab9a061f4",
                                        "glosses": [
                                            "A fundamental principle or skill, especially in a field of learning."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b05e851-a303-4b4e-9189-74f933501dd8",
                                                "sense_id": "22bab989-3c5f-3eac-b580-f161da51af8a",
                                                "text": "We'll be learning the rudiments of thermodynamics next week."
                                            },
                                            {
                                                "example_id": "34e7e6b6-2076-4096-b7fc-5d1294c13db6",
                                                "sense_id": "22bab989-3c5f-3eac-b580-f161da51af8a",
                                                "text": "This boy is forest-born, / And hath been tutored in the rudiments / Of many desperate studies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caa8f425-b18c-332f-a8f0-88fe53ae4b88",
                                        "entry_id": "8288d137-1e75-3d0c-ad00-d71ab9a061f4",
                                        "glosses": [
                                            "A form that lacks full or complex development."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e79155f0-f784-4ee1-a782-ed2202613e35",
                                                "sense_id": "caa8f425-b18c-332f-a8f0-88fe53ae4b88",
                                                "text": "I have the rudiments of an escape plan."
                                            },
                                            {
                                                "example_id": "96d9ba66-c3aa-4e9f-ad53-f1ee4535a7e4",
                                                "sense_id": "caa8f425-b18c-332f-a8f0-88fe53ae4b88",
                                                "text": "But I will bring thee where thou soon shalt quit / Those rudiments, and see before thine eyes / The monarchies of the earth."
                                            },
                                            {
                                                "example_id": "4418a6e4-a04f-4115-88e7-fad64b12a5d2",
                                                "sense_id": "caa8f425-b18c-332f-a8f0-88fe53ae4b88",
                                                "text": "The single leaf is the rudiment of beauty in landscape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56241d7d-f69e-370c-a6cd-2e9c83cf4c2a",
                                        "entry_id": "8288d137-1e75-3d0c-ad00-d71ab9a061f4",
                                        "glosses": [
                                            "A body part that no longer has a function"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eae5fcaf-2f2e-353a-9c26-7e171a07d538",
                                        "entry_id": "8288d137-1e75-3d0c-ad00-d71ab9a061f4",
                                        "glosses": [
                                            "In percussion, one of a selection of basic drum patterns learned as an exercise."
