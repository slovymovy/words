                                        "examples": [
                                            {
                                                "example_id": "827add35-1abb-4b8d-9576-8bcfc92f4be2",
                                                "sense_id": "752bd5c9-ca83-3009-8184-beb0aa204f3c",
                                                "text": "Nach der Vorspeise tischte sie das Wildbret auf."
                                            },
                                            {
                                                "example_id": "aeb29552-4f09-4a2f-854b-6ff44e86c4d1",
                                                "sense_id": "752bd5c9-ca83-3009-8184-beb0aa204f3c",
                                                "text": "„Die Wirtin, die mich als freigebig kennengelernt hatte, gab mir Wildbret und Stör.“"
                                            },
                                            {
                                                "example_id": "a9093f56-b03e-4a22-abe0-ee1a3f3510bc",
                                                "sense_id": "752bd5c9-ca83-3009-8184-beb0aa204f3c",
                                                "text": "„Ihrer gab es in der Nähe der Siedlung immer noch genug für den Bedarf an Häuten und Wildbret, und aus der Umgebung des Dorfes war die Strecke leichter zu bergen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5867e273-4b7b-3ebc-900b-729d8fe94c8f",
                                        "entry_id": "d204cde2-a463-3b88-8218-6429b40c63b7",
                                        "glosses": [
                                            "lebendes Wild"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
