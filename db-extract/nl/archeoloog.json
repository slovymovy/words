                    },
                    {
                        "form_id": "fb59e5cc-5c81-471a-9bad-ef8e1b716cb5",
                        "entry_id": "cf54b8e1-0518-3c69-8dd2-41544cbe49fe",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "archeoloogje"
                    },
                    {
                        "form_id": "f25da2e1-6928-45cd-98bd-9e40e742d6c1",
                        "entry_id": "cf54b8e1-0518-3c69-8dd2-41544cbe49fe",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "archeoloogjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "82f8a708-dd52-38f6-b683-74594466e35e",
                        "entry_id": "cf54b8e1-0518-3c69-8dd2-41544cbe49fe",
                        "glosses": [
                            "iemand die archeologie heeft gestudeerd"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "de97c9c3-5274-48e6-9686-00c6c0cabc62",
                                "sense_id": "82f8a708-dd52-38f6-b683-74594466e35e",
                                "text": "Op de vindplaats zijn ook speren en resten gevonden uit de bronstijd van 1100 tot 800 voor Christus, aldus het schap dinsdag. Archeologen gaan de plek nu verder onderzoeken."
                            },
                            {
                                "example_id": "da89300f-60b2-4fec-be98-d4c5fdd4c98d",
                                "sense_id": "82f8a708-dd52-38f6-b683-74594466e35e",
                                "text": "De veel gepubliceerde bewering dat Homo naledi, een vroegere mensensoort met een klein brein, zijn overledenen begroef en rotskunst maakte, is volgens een groep onderzoekers volledig ongegrond. ‘Er is totaal geen bewijs voor’, zegt archeoloog en antropoloog Michael Petraglia van de Griffith-universiteit in Australië."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d04e9662-6be3-41eb-8c55-5668b1b6e893",
                        "source_entry_id": "cf54b8e1-0518-3c69-8dd2-41544cbe49fe",
                        "source_sense_id": "82f8a708-dd52-38f6-b683-74594466e35e",
                        "target_lang_word": "Archäologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Archäologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e79d7da-558a-35e6-a6d4-21b68148d304",
                                        "entry_id": "6dc8f13a-791b-3d43-a761-3861cb974b48",
                                        "glosses": [
                                            "Person, die in der Archäologie ausgebildet und bewandert ist, sich also mit den materiellen Überresten vor allem alter Kulturen befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96636de3-c9bb-4c24-b07b-1f0075e1e2ae",
                                                "sense_id": "1e79d7da-558a-35e6-a6d4-21b68148d304",
                                                "text": "Archäologen verschaffen uns Kenntnisse über die Kulturen, die in einer Zeit entstanden, als es noch keine Schrift gab."
                                            },
                                            {
                                                "example_id": "483ba80e-e0b4-4137-a178-29af52e37f73",
                                                "sense_id": "1e79d7da-558a-35e6-a6d4-21b68148d304",
                                                "text": "„Die Archäologen arbeiteten bei der Erforschung und Interpretation der Funde mit zahlreichen Kollegen aus Nachbardisziplinen zusammen.“"
                                            },
                                            {
                                                "example_id": "cd6067ab-dd28-4e43-ab45-7f1bd7578b4f",
                                                "sense_id": "1e79d7da-558a-35e6-a6d4-21b68148d304",
                                                "text": "„Gerade wird er im großen Stil saniert: ein Glücksfall für die Archäologen, die bei Erdarbeiten nicht nur auf Azelins Grundmauern, sondern auch auf alte Fußböden, Gräber und Reste der ersten Kapelle stießen, die hier um 815 nach Christus stand.“"
                                            },
                                            {
                                                "example_id": "614db77c-83a3-4ce8-a08a-970b91fa7095",
                                                "sense_id": "1e79d7da-558a-35e6-a6d4-21b68148d304",
                                                "text": "„Die persönlichen Gegenstände waren es, die den Archäologen schließlich die entscheidenden Hinweise auf die Herkunft der Angreifer gaben.“"
                                            },
                                            {
                                                "example_id": "37f32fab-a838-49e5-a835-ef67ef3dce60",
                                                "sense_id": "1e79d7da-558a-35e6-a6d4-21b68148d304",
                                                "text": "„Ein mir befreundeter Archäologe bat mich um meine Mitarbeit bei der Sektion an einer Mumie aus der Zeit der Ramsiden.“"
                                            },
                                            {
                                                "example_id": "2036f49e-6a15-468c-81c3-3ce427669264",
                                                "sense_id": "1e79d7da-558a-35e6-a6d4-21b68148d304",
                                                "text": "„Er zeigte den Fund seiner Lehrerin, die sofort die Archäologen informierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9047b4a-b7d6-40da-94fd-5c069a0dba77",
                        "source_entry_id": "cf54b8e1-0518-3c69-8dd2-41544cbe49fe",
                        "source_sense_id": "82f8a708-dd52-38f6-b683-74594466e35e",
