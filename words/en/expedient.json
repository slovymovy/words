                },
                {
                    "sense_id": "8617d1b9-8466-3078-98f1-14a1328d66ef",
                    "sense_definition": "Affording short-term benefit or utility, often at the expense of long-term correctness or ethics.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "practicality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government took <w>expedient</w> steps to keep the public happy before the election."
                        },
                        {
                            "text": "Treating the recruitment of foreign workers as an <w>expedient</w> measure solved the immediate labor shortage but caused long-term issues."
                        }
                    ],
                    "synonyms": [
