                    {
                        "translation_id": "ba0fb403-ed75-44f7-a3b0-041680710d6b",
                        "source_entry_id": "dcd1e144-a114-3349-92c0-4c8d31d986b9",
                        "source_sense_id": "24d58996-55a5-36b0-b0ac-b6909de88541",
                        "source_sense_description": "en 2. (zaden van) geslacht Lupinus",
                        "target_lang_word": "Lupine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lupine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8d5131d-d560-386e-83c2-15e1d4e78fa5",
                                        "entry_id": "8ce33fc4-3df6-3d24-992d-e430846b6f1f",
                                        "glosses": [
                                            "zur Familie der Schmetterlingsblütler gehörende Blütenpflanze, die als eiweißreiches Viehfutter angebaut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debb45b1-bdf4-4b61-9895-cad2dcb7e8e2",
                                                "sense_id": "c8d5131d-d560-386e-83c2-15e1d4e78fa5",
                                                "text": "Dagegen gedeihen Lupinen, Sonnenblumen und Serradella auf schwach sauren Böden am besten."
                                            },
                                            {
                                                "example_id": "8a08c7a5-18ed-46b9-8561-f1500ab33f07",
                                                "sense_id": "c8d5131d-d560-386e-83c2-15e1d4e78fa5",
                                                "text": "Ärmlich brennt das Licht der Lupinen."
                                            },
                                            {
                                                "example_id": "b44bb30e-ce73-4c77-acee-1b2c310f0e7d",
                                                "sense_id": "c8d5131d-d560-386e-83c2-15e1d4e78fa5",
                                                "text": "„Doch richtig schlimm wird es, wenn es um die Lupinen geht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2a7b3b4-863d-43c9-90f1-7dfea0437a20",
                        "source_entry_id": "dcd1e144-a114-3349-92c0-4c8d31d986b9",
                        "source_sense_id": "24d58996-55a5-36b0-b0ac-b6909de88541",
                        "source_sense_description": "en 2. (zaden van) geslacht Lupinus",
                        "target_lang_word": "lupin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lupin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b6c378f-2ffd-361d-a4f2-8869a213d7dc",
                                        "entry_id": "dbcadf03-b1d6-3e37-bfff-c09ac9619a7e",
                                        "glosses": [
                                            "Any member of the genus Lupinus in the family Fabaceae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edac9aa3-247f-40ee-8d52-9d6944f5a426",
                                                "sense_id": "7b6c378f-2ffd-361d-a4f2-8869a213d7dc",
                                                "text": "Lupins had been introduced into German agriculture in 1841 and had rapidly become a popular and useful feed for sheep as well as being used as a green manure plant for increasing soil fertility in poor-quality, sandy soils."
                                            },
                                            {
                                                "example_id": "46e40ca0-842d-41af-badc-5acb668b6b78",
                                                "sense_id": "7b6c378f-2ffd-361d-a4f2-8869a213d7dc",
                                                "text": "Amongst the herbs to be administered when the charm was sung over him were a yew-berry, lupin, helenium, marsh mallow, dock, elder, wormwood and strawberry leaves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9d912fa-1f37-326e-9216-4f82583f6331",
                                        "entry_id": "dbcadf03-b1d6-3e37-bfff-c09ac9619a7e",
                                        "glosses": [
                                            "A lupin bean, a yellow legume seed of a Lupinus plant (usually Lupinus luteus), used as feed for sheep and cattle and commonly eaten in the Mediterranean area and in Latin America although toxic if prepared improperly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b52919ac-1086-4b9f-a1db-9c72e91f9f17",
                                                "sense_id": "e9d912fa-1f37-326e-9216-4f82583f6331",
                                                "text": "Lupins contain less than 3% starch (Evans, 1994), the main fermentable carbohydrate involved in rumen acidosis when cereal grains are fed to ruminants. For this reason lupins have generally been regarded as a completely safe feed for sheep and cattle, and required no gradual introduction (Rowe, 1995)."
                                            },
                                            {
                                                "example_id": "9df4df96-61b3-4a99-8ae7-4988a70c9f29",
                                                "sense_id": "e9d912fa-1f37-326e-9216-4f82583f6331",
                                                "text": "Lupins, although a bean, are similar to olives aesthetically, and are equally good with breakfast. The trick is first to soak them overnight until rehydrated, then boil them for a few hours like any bean. They will not soften. Then soak them again, changing the water every day for several weeks until the bitterness is gone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52036db7-eb6c-4728-abe7-29a7303e92b1",
                        "source_entry_id": "dcd1e144-a114-3349-92c0-4c8d31d986b9",
                        "source_sense_id": "24d58996-55a5-36b0-b0ac-b6909de88541",
                        "source_sense_description": "en 2. (zaden van) geslacht Lupinus",
                        "target_lang_word": "lupin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lupin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5906bc8e-78b3-3009-a089-ce0adc6edbae",
                                        "entry_id": "30420139-2634-3082-a67a-1e0541b6b83e",
                                        "glosses": [
                                            "Fabacée à feuilles disposées en éventail. → voir Lupinus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58ec14f6-8891-48bd-bdf5-88e0ed9e44f5",
                                                "sense_id": "5906bc8e-78b3-3009-a089-ce0adc6edbae",
                                                "text": "Pour les vaches laitières, le lupin s’utilise en remplacement du concentré classique tourteaux de soja/céréales."
                                            },
                                            {
                                                "example_id": "e7138a90-8057-457c-88e5-27c2ee9e076f",
                                                "sense_id": "5906bc8e-78b3-3009-a089-ce0adc6edbae",
                                                "text": "Bref, on doit 'désamertumer' les lupins après cuisson."
                                            },
                                            {
                                                "example_id": "f9e91e24-0151-419d-aedc-58f428b69008",
                                                "sense_id": "5906bc8e-78b3-3009-a089-ce0adc6edbae",
                                                "text": "Côté santé, le café de lupin est riche en fibres, en minéraux et en vitamine E."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lupin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a7c9e89-b3b8-3a1f-816e-5a6ae7898114",
                                        "entry_id": "a0afe561-39ac-38d2-b260-7ec819eedeb7",
                                        "glosses": [
                                            "Loup-garou."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2ce060b-b20b-4d8b-8810-49c7f2589530",
                                                "sense_id": "6a7c9e89-b3b8-3a1f-816e-5a6ae7898114",
                                                "text": "Soit que ces esprits-bêtes fussent d’une race plus hardie que les lubins et lupins ordinaires, soit que le tailleur fût si laid, si laid, qu’il ne leur fit pas l’effet d'un chrétien, ils ne bougèrent tout le temps qu’il passa devant eux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lupin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d247f5b-856b-3e9e-a1a8-5df73d16dafe",
                                        "entry_id": "53feaf8b-d581-347f-8fe5-bd1cd8daf1d2",
                                        "glosses": [
                                            "Qui concerne le loup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64bb7c77-d44c-4a4f-9af2-e82a82eb274f",
                                                "sense_id": "9d247f5b-856b-3e9e-a1a8-5df73d16dafe",
                                                "text": "(…) ce qui a fragmenté et réduit drastiquement les dernières populations lupines."
                                            },
                                            {
                                                "example_id": "dfe000ed-5c2d-44df-9f6b-3ae906fac3b1",
                                                "sense_id": "9d247f5b-856b-3e9e-a1a8-5df73d16dafe",
                                                "text": "Puis mon loup a fermé les paupières d’un geste incroyable, qui allait à l’encontre de tout instinct lupin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
