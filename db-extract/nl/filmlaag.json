                        "sense_id": "d43390e2-80e8-35b3-90ee-a3febcd858a9",
                        "entry_id": "b7027bb9-acea-3d66-a53d-9d2f04504280",
                        "glosses": [
                            "een (zeer) dunne laag materiaal die op een voorwerp is aangebracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a4a1a04-e090-469b-a25b-d879c9e3cafc",
                                "sense_id": "d43390e2-80e8-35b3-90ee-a3febcd858a9",
                                "text": "Vader is als grootaandeelhouder echter nog altijd nauw betrokken bij de producent van machines voor de halfgeleider industrie. Deze worden gebruikt om via een chemisch proces filmlagen op wafers aan te brengen waarmee ze chips kleiner, sneller en goedkoper maken. Die technologie heet Atomic Layer Deposition (ALD)."
                            },
                            {
                                "example_id": "591418b2-bdff-408f-9424-3c9421c3e98d",
                                "sense_id": "d43390e2-80e8-35b3-90ee-a3febcd858a9",
                                "text": "De filmlaag die nu wordt aangebracht op het glas, weert wel de schadelijke uv-straling maar niet de warmte en dus moet er ook een nieuw en kostbaar airconditioningsysteem worden geïnstalleerd."
                            }
                        ]
                    }
