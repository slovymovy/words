                                    {
                                        "sense_id": "388c9e39-d3ec-300c-a11d-9bdf54800f49",
                                        "entry_id": "24eebd90-5b93-3f9e-a46d-cc2499728e83",
                                        "glosses": [
                                            "Lampe, die am hinteren Ende eines Fahrzeugs angebracht ist und vom nachfolgenden Verkehr gesehen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd3f319-c979-4134-8da9-ef97b03b02c7",
                                                "sense_id": "388c9e39-d3ec-300c-a11d-9bdf54800f49",
                                                "text": "„Die gesamte Linie wirkt durchaus dynamisch und auch die Heckleuchten übernehmen den Stil der Scheinwerfer.“ (Quelle: Der Tagesspiegel, 29.03.2002)"
