                "senses": [
                    {
                        "sense_id": "5575def5-e67e-350c-aeaa-5354c5772e6f",
                        "entry_id": "9b779dd8-b42e-3a65-8ca0-5d22884a1eec",
                        "glosses": [
                            "A valve, tap or faucet which regulates the flow of liquid or gas through a pipe."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5a0c51e5-c3a2-3539-b75a-66820791de37",
                        "entry_id": "9b779dd8-b42e-3a65-8ca0-5d22884a1eec",
                        "glosses": [
                            "A main shutoff for water to a home from a municipal supply. Usually these valves exist in pairs, one outside the property boundary and one inside the property boundary."
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "c3d0cad9-df5a-4f0d-9035-ad918a2a545b",
                                "sense_id": "5a0c51e5-c3a2-3539-b75a-66820791de37",
                                "text": "If you have a burst pipe, turn the water off at the stopcock."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c2dc2d1-5428-4909-9a89-9cef06c744e0",
