                                "target_senses": [
                                    {
                                        "sense_id": "db5845d4-2dd6-33e8-ab50-976f885437da",
                                        "entry_id": "b9c0fea1-e219-36d1-a333-756d943d611e",
                                        "glosses": [
                                            "To cover with a wimple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac37ef61-b37f-4864-ae24-d8b72642af33",
                                                "sense_id": "db5845d4-2dd6-33e8-ab50-976f885437da",
                                                "text": "this wimpled, whining, purblind, wayward boy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef8fa9bb-5ac0-3de0-990c-cbce0837a59a",
                                        "entry_id": "b9c0fea1-e219-36d1-a333-756d943d611e",
                                        "glosses": [
                                            "To draw down; to lower, like a veil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc05f1b-8bf6-49a6-8a08-2c792a517f86",
                                                "sense_id": "ef8fa9bb-5ac0-3de0-990c-cbce0837a59a",
                                                "text": "IV A lovely Ladie[*] rode him faire beside, Upon a lowly Asse more white then snow, Yet she much whiter, but the same did hide 30 Under a vele, that wimpled was full low, And over all a blacke stole she did throw, As one that inly mournd: so was she sad, And heavie sat upon her palfrey slow; Seemed in heart some hidden care she had, 35 And by her in a line a milke white lambe she lad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa99eec7-a145-3a8c-a54b-4a817b191313",
                                        "entry_id": "b9c0fea1-e219-36d1-a333-756d943d611e",
                                        "glosses": [
                                            "To cause to appear as if laid in folds or plaits; to cause to ripple or undulate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "248a4227-3c95-47af-8464-fdabdfe1333e",
                                                "sense_id": "fa99eec7-a145-3a8c-a54b-4a817b191313",
                                                "text": "The wind wimples the surface of water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34f7a0c2-fc55-3a3a-a52b-e497b6ccb549",
                                        "entry_id": "b9c0fea1-e219-36d1-a333-756d943d611e",
                                        "glosses": [
                                            "To flutter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7985e88e-c727-4ba2-8196-1a229f14dab5",
                                                "sense_id": "34f7a0c2-fc55-3a3a-a52b-e497b6ccb549",
                                                "text": "She wimpled about in the pale moonbeam, Like a feather that floats on a wind tossed-stream; And momently athwart her track The quarl upreared his island back, And the fluttering scallop behind would float, And patter the water about the boat; But he bailed her out with his colen-bell, And he kept her trimmed with a wary tread, While on every side like lightening fell"
                                            },
                                            {
                                                "example_id": "660153f2-5209-4454-aedd-faa14c0684ff",
                                                "sense_id": "34f7a0c2-fc55-3a3a-a52b-e497b6ccb549",
                                                "text": "Stars wavered and wimpled in the black waters of the Hudson as a launch put out in silence from the foot of Twenty-seventh Street."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
