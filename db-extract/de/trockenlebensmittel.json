                ],
                "senses": [
                    {
                        "sense_id": "9cae68ef-b6ce-374e-a5c6-3a5ea0e82ae0",
                        "entry_id": "1eca5244-d2fa-32d9-bb9d-8a2feebbfc82",
                        "glosses": [
                            "trocken und kühl gelagertes Nahrungsmittel (wie etwa Zerealien, Nüsse, Pulver)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab9deed4-3924-4855-a656-051a9b157c7e",
                                "sense_id": "9cae68ef-b6ce-374e-a5c6-3a5ea0e82ae0",
                                "text": "„Brot, löslicher Kaffee, Trockenlebensmittel und etwas Milch, liesse sich anfänglich und zur Not auf einfache Weise lagern.“"
                            },
                            {
                                "example_id": "00e479ab-a627-48d5-b1a9-2d238c978a2d",
                                "sense_id": "9cae68ef-b6ce-374e-a5c6-3a5ea0e82ae0",
                                "text": "„Zu finden unter anderem in Milchpulver und Kaffeeweißer, Trockenpulver für Desserts, Backmischungen, diverse Trockenlebensmittel in Pulverform.“"
                            },
                            {
                                "example_id": "67c9c600-7aaa-42d4-bfc6-13a1ab10bc93",
                                "sense_id": "9cae68ef-b6ce-374e-a5c6-3a5ea0e82ae0",
                                "text": "„Nachdem Irene nachgesehen hatte, ob es Kaffee und Müsliriegel gab, musste sie enttäuscht feststellen, dass Nachholbedarf an Trockenlebensmittel bestand.“"
                            },
                            {
                                "example_id": "993c3aaf-7d34-4795-b2d2-11e298cac137",
                                "sense_id": "9cae68ef-b6ce-374e-a5c6-3a5ea0e82ae0",
                                "text": "„Magnesiumphosphat ist auch für Backmischungen, Dessertirockenpulver, Trockenlebensmittel in Pulverform und Nahrungsergänzungsmittel zugelassen.“"
                            },
                            {
                                "example_id": "8f6d4145-d5d5-4b9a-895e-af1f46661623",
                                "sense_id": "9cae68ef-b6ce-374e-a5c6-3a5ea0e82ae0",
                                "text": "„Trockenlebensmittel in Schutzpackungen sind mikrobiologisch ebenfalls risikofrei.“"
                            },
                            {
                                "example_id": "a1d61375-23e5-4b08-bd54-ed83e43ec47b",
                                "sense_id": "9cae68ef-b6ce-374e-a5c6-3a5ea0e82ae0",
                                "text": "„Zu Verlusten kommt es bei starker Fettsäureautoxidation vor allem in Trockenlebensmitteln.“"
                            },
                            {
                                "example_id": "33704392-d4d5-4070-bf6b-c539a50e37fc",
                                "sense_id": "9cae68ef-b6ce-374e-a5c6-3a5ea0e82ae0",
                                "text": "„Das betreffe vor allem Trockenlebensmittel wie Nudeln und Reis sowie Konserven und Drogerieartikel, teilte ein Sprecher mit.“"
                            },
                            {
                                "example_id": "a304905d-f5f8-46a7-a648-0c4c4bc8d36f",
                                "sense_id": "9cae68ef-b6ce-374e-a5c6-3a5ea0e82ae0",
                                "text": "„Das Trinkwasser war schon nach wenigen Stunden weg, auch Kekse und andere Trockenlebensmittel waren schnell kaum mehr zu finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
