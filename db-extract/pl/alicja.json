                    },
                    {
                        "translation_id": "4832867b-4672-4094-af23-044926fcc7f3",
                        "source_entry_id": "b9e6487a-4d15-3d88-9182-86776f8b9574",
                        "source_sense_id": "b25af8eb-564c-3279-95ee-dba3abea63c9",
                        "target_lang_word": "Alice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d8f488f-1695-3f8c-b715-a06c97dfad8d",
                                        "entry_id": "eeac0189-6632-3d62-889b-70a4ec51ebc1",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "989378ae-95cd-4238-81ed-f5feec790c88",
                                                "sense_id": "2d8f488f-1695-3f8c-b715-a06c97dfad8d",
                                                "text": "Je me rappelle encore très bien l’une d’elles, Mlle Alice Chaine, qui demeurait rue Rodier, dans cette même maison, il me semble, en face de la nôtre, où l’on chantait toujours."
                                            },
                                            {
                                                "example_id": "6e9ee31b-0d3b-42a9-9a55-039d0fa575e5",
                                                "sense_id": "2d8f488f-1695-3f8c-b715-a06c97dfad8d",
                                                "text": "Une Alice heureuse, riche, qui oublia Lucky, qui se remaria, qui fit des enfants."
                                            },
                                            {
                                                "example_id": "08112b13-5d13-441d-ac7f-99450876c55c",
                                                "sense_id": "2d8f488f-1695-3f8c-b715-a06c97dfad8d",
                                                "text": "« Une grosse dizaine de projets territoriaux ont vu le jour depuis 2015 », souligne Alice Abbat, coordinatrice du Réseau consigne."
                                            },
                                            {
                                                "example_id": "ebcb632d-241f-461b-8c2a-f9e0c4bb46b8",
                                                "sense_id": "2d8f488f-1695-3f8c-b715-a06c97dfad8d",
                                                "text": "Cette sollicitude ne la surprenait guère : Alice avait toujours eu cette espèce de charité très chrétienne, qui attendait que l'on fût au fond du trou pour vous tendre la main."
                                            },
                                            {
                                                "example_id": "f9b55888-2d44-4f31-8449-d68d3734364e",
                                                "sense_id": "2d8f488f-1695-3f8c-b715-a06c97dfad8d",
                                                "text": "Sous la haie, évidemment, aucun Lapin blanc ne regarde sa montre. Mais il y a un terrier, qu’Alice n’a jamais vu. Un vrai. Immense, une grande béance, « pour un lapin géant ! » s’écrie Alice à haute voix. D’un seul coup, la voilà attirée, happée, aspirée, …\nSa chute est douce et lente. Exactement comme celle de l’Alice d’autrefois, dans l’air tiède et l’obscurité totale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
