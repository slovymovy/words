                                        "entry_id": "ec534b2b-db8b-34c3-8053-82d2677a85f7",
                                        "glosses": [
                                            "A broad-spectrum aminoglycoside antibiotic related to streptomycin that is produced by a streptomyces (Streptomyces fradiae) and used medically especially to treat local infections."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1355ca2f-a27b-4287-a049-993dc8854814",
                                                "sense_id": "aa1bfa42-587e-3eb1-a8e2-a66d0272db56",
                                                "text": "The bowel is prepared preoperatively with neomycin and sulfathalidine. A wide transverse lower abdominal incision is used."
                                            }
                                        ]
                                    }
