                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80e47124-b559-49c5-8e75-2762911bc09f",
                                "sense_id": "9e627616-0535-375b-8ea5-b48d472fdae2",
                                "text": "„Noch in den Achtzigern ging man in Alltagskluft auf die Wiesn. Wer in Tracht erschien, war vom Dorf oder ein Norddeutscher, der sich einschleimen wollte.“"
                            },
                            {
                                "example_id": "a7afbed0-8815-45d2-b596-0c2259f82f66",
                                "sense_id": "9e627616-0535-375b-8ea5-b48d472fdae2",
                                "text": "„Manche kamen in Tracht, andere in Abend- oder Cocktailkleidern, und ab und an stolzierte auch jemand in Alltagskluft mit stolzgeschwellter Brust auf die Bühne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
