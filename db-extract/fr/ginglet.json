                "senses": [
                    {
                        "sense_id": "467b9904-aa30-3682-92d7-636e85689af0",
                        "entry_id": "3241a863-f8f3-34eb-bc3f-75c0dd620e92",
                        "glosses": [
                            "Petit vin aigrelet."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "356dabdb-67e5-45c1-a1e1-5cc78f806dd9",
                                "sense_id": "467b9904-aa30-3682-92d7-636e85689af0",
                                "text": "On vit en famille, en s’empruntant son savon, et on a des appétits et des soifs qui vous font trouver bonne la médiocre ratatouille et aimable le ginglet."
                            },
                            {
                                "example_id": "6f844e87-b2bf-457a-8162-c0f380b66606",
                                "sense_id": "467b9904-aa30-3682-92d7-636e85689af0",
                                "text": "Quant ils eurent mangé leur omelette, arrosée d’un petit ginglet du Verdunois, dégusté un café médiocre et réglé leur écot, la matinée avançait."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8cb7a7a-8420-3bf7-bbbb-c7cf522ad99c",
                        "entry_id": "3241a863-f8f3-34eb-bc3f-75c0dd620e92",
                        "glosses": [
                            "Vin produit dans la vallée de l’Oise au nord de Paris."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "ae05b7f0-6c1d-4859-8e32-851037d74984",
                                "sense_id": "b8cb7a7a-8420-3bf7-bbbb-c7cf522ad99c",
                                "text": "Chaque année, à la Foire Saint-Martin de Pontoise, un traditionnel concours récompense les meilleurs ginglets, ce vin local produit dans la vallée de l’Oise, souvent aigrelet et pétillant."
                            }
                        ]
                    }
