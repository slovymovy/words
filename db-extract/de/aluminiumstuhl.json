                        "examples": [
                            {
                                "example_id": "93e8c110-9d68-456d-b6b7-9fd3bc169fdf",
                                "sense_id": "bf74d66b-0ac8-3bf8-8c6d-f0918bde208d",
                                "text": "„Franklin klappt einen Aluminiumstuhl auseinander und setzt sich an seinen kleinen Grundschulschreibtisch.“"
                            },
                            {
                                "example_id": "881aafbe-05eb-4674-90a6-fa0574ce0520",
                                "sense_id": "bf74d66b-0ac8-3bf8-8c6d-f0918bde208d",
                                "text": "„Der Aluminiumstuhl kratzte über den Steinboden, als der Neuankömmling ihn abrückte.“"
                            },
                            {
                                "example_id": "3bd59f2c-6dbc-4928-9d1b-095f723bc4ae",
                                "sense_id": "bf74d66b-0ac8-3bf8-8c6d-f0918bde208d",
                                "text": "„Dann bedeutete er seinen Jungs, sich in die Dunkelheit zurückzuziehen, rückte seinen quietschenden Aluminiumstuhl näher und beugte sich vertraulich zu mir.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
