{
    "word_family": [
        "duisternis",
        "verduisteren",
        "duisteren"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c6604b7d-f3fe-3b1e-8e19-cf094d9c50ec",
                    "sense_definition": "met weinig of geen licht; gehuld in schaduw",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichtsterkte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij viel over een krukje in die <w>duistere</w> gang.",
                            "target_lang_translations": {
                                "en": "He fell over a stool in that <w>dark</w> hallway."
                            }
                        },
                        {
                            "text": "In de winter zijn de dagen vaak kort en <w>duister</w>.",
                            "target_lang_translations": {
                                "en": "In winter, the days are often short and <w>gloomy</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "donker"
                    ],
                    "antonyms": [
                        "licht",
                        "helder"
                    ],
                    "common_phrases": [
                        "duistere kamer",
                        "duistere nacht"
                    ],
                    "target_lang_definitions": {
                        "en": "with little or no light; shrouded in shadow"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dark",
                                "target_lang_sense_clarification": "lacking light"
                            },
                            {
                                "target_lang_word": "dim",
                                "target_lang_sense_clarification": "poorly lit"
                            },
                            {
                                "target_lang_word": "obscure",
                                "target_lang_sense_clarification": "faint or indistinct due to lack of light"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d39fc2f-b606-32c9-a48d-8b22680d0a12",
                    "sense_definition": "geheimzinnig op een onheilspellende of gevaarlijke manier",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er lijken <w>duistere</w> krachten aan het werk te zijn in dit oude huis.",
                            "target_lang_translations": {
                                "en": "There seem to be <w>dark</w> forces at work in this old house."
                            }
                        },
                        {
                            "text": "Hij heeft een <w>duister</w> verleden waar niemand iets van afweet.",
                            "target_lang_translations": {
                                "en": "He has a <w>shady</w> past that no one knows about."
                            }
                        }
                    ],
                    "common_phrases": [
                        "duistere krachten",
                        "duister verleden",
                        "duistere plannen"
                    ],
                    "target_lang_definitions": {
                        "en": "mysterious in an ominous or dangerous way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dark",
                                "target_lang_sense_clarification": "sinister or evil"
                            },
                            {
                                "target_lang_word": "sinister",
                                "target_lang_sense_clarification": "threatening or ominous"
                            },
                            {
                                "target_lang_word": "shady",
                                "target_lang_sense_clarification": "suspicious or disreputable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93a64684-b65d-3b2c-9e26-463fe4971cd4",
                    "sense_definition": "moeilijk te begrijpen of te doorgronden; onduidelijk",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "begrip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die publicatie maakt daar alleen maar een <w>duistere</w> opmerking over.",
                            "target_lang_translations": {
                                "en": "That publication only makes an <w>obscure</w> remark about it."
                            }
                        },
                        {
                            "text": "De betekenis van deze oude tekst blijft voor velen <w>duister</w>.",
                            "target_lang_translations": {
                                "en": "The meaning of this ancient text remains <w>unclear</w> to many."
                            }
                        }
                    ],
                    "synonyms": [
                        "donker"
                    ],
                    "antonyms": [
                        "duidelijk",
                        "helder"
                    ],
                    "common_phrases": [
                        "duistere taal",
                        "in het duister tasten"
                    ],
                    "target_lang_definitions": {
                        "en": "difficult to understand or fathom; unclear"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obscure",
                                "target_lang_sense_clarification": "difficult to understand"
                            },
                            {
                                "target_lang_word": "unclear",
                                "target_lang_sense_clarification": "not easy to see or understand"
                            },
                            {
                                "target_lang_word": "vague",
                                "target_lang_sense_clarification": "not clearly expressed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b78871e2-57f6-3ee3-b6d4-8fdcf684d629",
                    "sense_definition": "somber en zonder hoop; deprimerend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De toekomst ziet er op dit moment erg <w>duister</w> uit voor het bedrijf.",
                            "target_lang_translations": {
                                "en": "The future looks very <w>bleak</w> for the company at the moment."
                            }
                        },
                        {
                            "text": "Hij zat in een <w>duistere</w> stemming na het slechte nieuws.",
                            "target_lang_translations": {
                                "en": "He was in a <w>dark</w> mood after the bad news."
                            }
                        }
                    ],
                    "antonyms": [
                        "rooskleurig"
                    ],
                    "common_phrases": [
                        "duistere vooruitzichten"
                    ],
                    "target_lang_definitions": {
                        "en": "gloomy and without hope; depressing"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bleak",
                                "target_lang_sense_clarification": "offering little hope"
                            },
                            {
                                "target_lang_word": "dark",
                                "target_lang_sense_clarification": "gloomy or pessimistic"
                            },
                            {
                                "target_lang_word": "grim",
                                "target_lang_sense_clarification": "depressing or worrying"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "749253c8-cfc0-37cb-8a97-0970a4232dd8",
                    "sense_definition": "een toestand van afwezigheid van licht",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichtsterkte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zit je hier nu in het <w>duister</w>? Doe het licht toch aan!",
                            "target_lang_translations": {
                                "en": "Are you sitting here in the <w>dark</w>? Turn on the light!"
                            }
                        },
                        {
                            "text": "De kat kan heel goed zien in het <w>duister</w>.",
                            "target_lang_translations": {
                                "en": "The cat can see very well in the <w>darkness</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "donker"
                    ],
                    "antonyms": [
                        "licht"
                    ],
                    "common_phrases": [
                        "in het duister",
                        "voor het duister"
                    ],
                    "target_lang_definitions": {
                        "en": "a state of absence of light"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "darkness",
                                "target_lang_sense_clarification": "the state of being dark"
                            },
                            {
                                "target_lang_word": "the dark",
                                "target_lang_sense_clarification": "absence of light"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
