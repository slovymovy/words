{
    "word_family": [
        "sin",
        "sinful",
        "sinfulness",
        "sinless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0eee29f3-aa93-3be4-a457-8173f4094073",
                    "sense_definition": "A person who transgresses against divine law by committing a sin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transgressor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preacher taught that every <w>sinner</w> could seek forgiveness through honest prayer.",
                            "target_lang_translations": {
                                "ru": "Проповедник учил, что каждый <w>грешник</w> может обрести прощение через искреннюю молитву."
                            }
                        },
                        {
                            "text": "He confessed that he was a repentant <w>sinner</w> seeking peace in his community.",
                            "target_lang_translations": {
                                "ru": "Он признался, что является раскаявшимся <w>грешником</w>, ищущим мира в своей общине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "repentant sinner",
                        "miserable sinner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, нарушающий религиозные заповеди и совершающий грех."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грешник",
                                "target_lang_sense_clarification": "мужчина"
                            },
                            {
                                "target_lang_word": "грешница",
                                "target_lang_sense_clarification": "женщина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4943910-1319-388e-9c3e-dcc947cb6929",
                    "sense_definition": "A person who commits bad deeds or has flawed moral character.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transgressor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The play contrasts the actions of a generous saint with those of a selfish <w>sinner</w>.",
                            "target_lang_translations": {
                                "ru": "В пьесе поступки щедрого праведника противопоставляются действиям эгоистичного <w>грешника</w>."
                            }
                        },
                        {
                            "text": "None of us is without fault, and each person can be a <w>sinner</w> at times.",
                            "target_lang_translations": {
                                "ru": "Никто из нас не безупречен, и каждый человек временами может быть <w>грешником</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "evildoer",
                        "offender"
                    ],
                    "common_phrases": [
                        "sinner or saint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с моральными изъянами, совершающий дурные поступки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грешник",
                                "target_lang_sense_clarification": "в переносном смысле, о небезгрешном человеке"
                            },
                            {
                                "target_lang_word": "грешница",
                                "target_lang_sense_clarification": "женский род, в переносном смысле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f0b8c758-31d5-3003-97b7-a611f090c5c7",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Sinner</w> arrived early this morning for his appointment at the local registry.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Зиннер</w> прибыл сегодня рано утром на прием в местный реестр."
                            }
                        },
                        {
                            "text": "Historians have traced the origins of the <w>Sinner</w> family back several generations.",
                            "target_lang_translations": {
                                "ru": "Историки проследили происхождение семьи <w>Зиннер</w> на несколько поколений назад."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Зиннер",
                                "target_lang_sense_clarification": "фамилия (немецкого происхождения)"
                            },
                            {
                                "target_lang_word": "Синнер",
                                "target_lang_sense_clarification": "фамилия (итальянская или англоязычная транслитерация)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}