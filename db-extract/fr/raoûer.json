                "senses": [
                    {
                        "sense_id": "26cd41d2-93dd-3bd3-a811-984470664a27",
                        "entry_id": "37ba26b5-1829-3f5b-adf9-5128904fff5f",
                        "glosses": [
                            "Aller draguer, se promener à la recherche de bonnes fortunes."
                        ],
                        "tags": [
                            "Lorraine"
                        ],
                        "examples": [
                            {
                                "example_id": "1d03b6fa-3f1c-4d39-9692-4e2368ae03a8",
                                "sense_id": "26cd41d2-93dd-3bd3-a811-984470664a27",
                                "text": "Les jeunes gens rebutés, s’en allaient « raoûer » à Crépey, à Germiny, à Bagneux, à Punerot et jusqu’à Soulosse-sous-Saint-Elophe pour y trouver chaussure à leur pied."
                            },
                            {
                                "example_id": "fbb99f2a-a7e7-4db8-895a-56ed8b034366",
                                "sense_id": "26cd41d2-93dd-3bd3-a811-984470664a27",
                                "text": "pis attend quand y'aura de la neige et que j'irai y raoûer de nuit, comment ça va dépoter…"
                            }
                        ]
                    }
