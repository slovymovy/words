                ],
                "senses": [
                    {
                        "sense_id": "0d6af398-dc94-3583-bd29-17fc32520421",
                        "entry_id": "551c07e8-6a19-3b8b-b1aa-fdb3e50d8fa5",
                        "glosses": [
                            "überwiegend schrille und dissonante, gleichzeitig von Trommeln begleitete Blasmusik auf Fasnachtsumzügen"
                        ],
                        "tags": [
                            "Alemannic",
                            "Swabian",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "782e833b-67e3-464c-a928-a03a26309ed1",
                                "sense_id": "0d6af398-dc94-3583-bd29-17fc32520421",
                                "text": "„Der Narrenbaum wurde durch die Stadt gezogen, vom Bockstorplatz bis zum Marktplatz, begleitet - natürlich - von Guggenmusik.“"
                            },
                            {
                                "example_id": "5d891b0b-c3f8-4cc9-9239-469b9c300519",
                                "sense_id": "0d6af398-dc94-3583-bd29-17fc32520421",
                                "text": "„Guggenmusik – das bedeutet nicht nur laute Töne und mitreißendes Schlagwerk, sondern vor allem Gemeinschaft, Humor und gelebte Leidenschaft für Musik.“"
                            },
                            {
                                "example_id": "2878156f-cb63-40e7-9184-c6df9ee89e38",
                                "sense_id": "0d6af398-dc94-3583-bd29-17fc32520421",
                                "text": "„Dieses Open Air ist für Fans dieser speziellen Musikform ein absolutes Muss, aber sicher auch für alle interessant, die bis jetzt noch nichts mit Guggenmusik zu tun hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c25f7af5-ef55-38fd-a690-186a48efdf45",
                        "entry_id": "551c07e8-6a19-3b8b-b1aa-fdb3e50d8fa5",
                        "glosses": [
                            "Musikverein, der auf Fasnachtsumzügen schrille, dissonante Blasmusik spielt"
                        ],
                        "tags": [
                            "Alemannic",
                            "Swabian"
                        ],
                        "examples": [
                            {
                                "example_id": "3ba5865e-df7e-4a4d-ae6e-b06e859ed03a",
                                "sense_id": "c25f7af5-ef55-38fd-a690-186a48efdf45",
                                "text": "„Bei der Adventsfenster-Aktion, an der sich auch die Guggenmusik mit einem Fenster beteiligte, kam ein stattlicher Betrag zusammen, der ans Kinderhospiz Kuckucksnest gespendet wurde.“"
                            },
                            {
                                "example_id": "8390d9de-72d6-4079-b0f1-325ecc400dd0",
                                "sense_id": "c25f7af5-ef55-38fd-a690-186a48efdf45",
                                "text": "„Zum großen Finale laden alle Guggenmusiken ab 16 Uhr zu einem großen Monsterkonzert ein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
