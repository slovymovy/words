                        "examples": [
                            {
                                "example_id": "cbe5d1ad-e5b9-4113-b542-d4dd6d227822",
                                "sense_id": "ae8fb3d0-ac24-3525-853a-8626c313c304",
                                "text": "His chronic lateness will cost him a promotion if not his job."
                            },
                            {
                                "example_id": "817f17bd-ba12-4c9d-99e4-d93cdef94121",
                                "sense_id": "ae8fb3d0-ac24-3525-853a-8626c313c304",
                                "text": "A 40 m.p.h. slack at West Ruislip, quickly followed by a 30 m.p.h. slack at Gerrards Cross, increased our lateness to four minutes at High Wycombe."
                            }
                        ]
                    }
