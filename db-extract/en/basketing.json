                        ],
                        "examples": [
                            {
                                "example_id": "71619f53-efff-42df-a358-e94e3ef12f3a",
                                "sense_id": "92e4fbd6-4673-3aae-acbd-6249afc622ff",
                                "text": "[…] such fillings of camphor and cologne bottles; such bagging of cloaks and India-rubbers; such basketings of cake and oranges, which both Mrs. Pell and the captain were convinced could not be obtained after once leaving New York!"
                            },
                            {
                                "example_id": "748204e5-df01-419b-aec4-42149233ced5",
                                "sense_id": "92e4fbd6-4673-3aae-acbd-6249afc622ff",
                                "text": "They are chippings and basketings of maxims and quotations, and of anecdotes, often classical, put together inductively, or rather by \"simple enumeration\" of the pros and cons."
                            }
                        ]
