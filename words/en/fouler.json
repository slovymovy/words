{
    "word_family": [
        "foul",
        "foully",
        "foulness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4ec15d35-a0fe-3bc5-b0dd-e76c13ff2570",
                    "sense_definition": "comparative form of <w>foul</w>: more foul",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comparative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air in the basement was even <w>fouler</w> than the air in the attic.",
                            "target_lang_translations": {
                                "pl": "Powietrze w piwnicy było jeszcze <w>brudniejsze</w> niż powietrze na strychu."
                            }
                        },
                        {
                            "text": "He had a <w>fouler</w> temper than anyone else I have ever met.",
                            "target_lang_translations": {
                                "pl": "Miał <w>gorszy</w> charakter niż ktokolwiek, kogo kiedykolwiek spotkałem."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Stopień wyższy przymiotnika 'foul': bardziej odrażający, brudniejszy lub gorszy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "brudniejszy",
                                "target_lang_sense_clarification": "w odniesieniu do stanu fizycznego lub higieny"
                            },
                            {
                                "target_lang_word": "bardziej odrażający",
                                "target_lang_sense_clarification": "w odniesieniu do zapachu, smaku lub charakteru"
                            },
                            {
                                "target_lang_word": "gorszy",
                                "target_lang_sense_clarification": "w odniesieniu do nastroju lub zachowania"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2b52b05b-e9ce-31f7-b46e-f29e35bd9a6c",
                    "sense_definition": "A person or organism that causes fouling, especially by accumulating on surfaces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marine <w>foulers</w> can significantly increase the drag on ship hulls.",
                            "target_lang_translations": {
                                "pl": "Morskie <w>organizmy porastające</w> mogą znacząco zwiększyć opór kadłubów statków."
                            }
                        },
                        {
                            "text": "The study identified several common <w>foulers</w> that damage underwater equipment.",
                            "target_lang_translations": {
                                "pl": "Badanie zidentyfikowało kilka powszechnych <w>czynników porastających</w>, które uszkadzają sprzęt podwodny."
                            }
                        }
                    ],
                    "common_phrases": [
                        "marine foulers"
                    ],
                    "target_lang_definitions": {
                        "pl": "Organizm lub czynnik powodujący porastanie powierzchni, np. kadłubów statków."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "organizmy porastające",
                                "target_lang_sense_clarification": "w kontekście biologicznym i morskim"
                            },
                            {
                                "target_lang_word": "czynnik powodujący osadzanie",
                                "target_lang_sense_clarification": "w kontekście technicznym"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}