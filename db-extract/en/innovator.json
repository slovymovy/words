                ],
                "senses": [
                    {
                        "sense_id": "801d6cc4-6c0d-3377-97d5-bec87cf9d3c3",
                        "entry_id": "e54028de-29c4-3d70-8178-6a6f7deabf69",
                        "glosses": [
                            "Someone who innovates; a creator of new ideas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9242a226-f9b6-46b7-afa5-afffe2b0a846",
                                "sense_id": "801d6cc4-6c0d-3377-97d5-bec87cf9d3c3",
                                "text": "Described by the judging panel as a \"Swiss army knife of the 21st century\", Apache Hadoop picked up the innovator of the year award for having the potential to change the face of media innovations."
                            },
                            {
                                "example_id": "f88c95ad-bb40-4691-a7f3-21950712cd46",
                                "sense_id": "801d6cc4-6c0d-3377-97d5-bec87cf9d3c3",
                                "text": "Competition gets thinner still when it comes to the 00s: Animal Collective and Joanna Newsom do one thing very well, Gaga and MIA are aggregators not innovators. Björk is peerless."
                            },
                            {
                                "example_id": "7275bbd4-c0ab-4959-a06a-38b474a4a497",
                                "sense_id": "801d6cc4-6c0d-3377-97d5-bec87cf9d3c3",
                                "text": "We now have good reason to question the pursuits of the vaunted innovators with whom Liu consorted in California – the blissed-out cultists at Google, whose only worry is over “the wrong kind of sparkling water in the microkitchens”, or the manic experts who specialise in “envisioning hyperplanes in n-dimensional space”."
                            }
                        ]
                    },
                    {
                        "sense_id": "969932e5-cf95-35fb-8d06-b9df832486ec",
                        "entry_id": "e54028de-29c4-3d70-8178-6a6f7deabf69",
                        "glosses": [
                            "An early adopter."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4c5a7da-5266-44ac-82b7-d7c0aedee3d7",
                        "source_entry_id": "e54028de-29c4-3d70-8178-6a6f7deabf69",
                        "source_sense_description": "someone who innovates",
                        "target_lang_word": "inovátor",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "98613fbe-fe16-4c6c-90bd-339d3dd124d3",
                        "source_entry_id": "e54028de-29c4-3d70-8178-6a6f7deabf69",
                        "source_sense_description": "someone who innovates",
                        "target_lang_word": "vernieuwer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vernieuwer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "df125cfa-9241-3d81-87a7-e6d487b16577",
                                        "entry_id": "bd3aa93f-4592-38e1-8e04-d41a5fe63701",
                                        "glosses": [
                                            "iemand die voor ingrijpende veranderingen zorgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8946769a-018e-4486-be84-d4b5a5e6e6ed",
                                                "sense_id": "df125cfa-9241-3d81-87a7-e6d487b16577",
                                                "text": "In zijn eerste document als vicepresident profileert Frans Timmermans zich als vernieuwer. Europa moet zich bezighouden met grote zaken, niet met onnodige regels, vindt de eurocommissaris."
                                            },
                                            {
                                                "example_id": "70d3d76f-3aa2-4b71-8cee-1bfae2d687ea",
                                                "sense_id": "df125cfa-9241-3d81-87a7-e6d487b16577",
                                                "text": "Ook in Zwolle is verslagen gereageerd. De restaurants van Boer in de stad die vanavond open waren sloten hun deuren om het personeel de mogelijkheid te geven om het nieuws van zijn dood te verwerken. \"Hij was meer dan een topkok\", zegt burgemeester van Zwolle Peter Snijders. \"Hij was een vernieuwer, een inspiratiebron en een trotse ambassadeur van onze stad.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e197b463-510a-47b4-8928-f070b01494b1",
                        "source_entry_id": "e54028de-29c4-3d70-8178-6a6f7deabf69",
                        "source_sense_description": "someone who innovates",
                        "target_lang_word": "innovator",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "innovator",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "97734cba-51e7-357c-a57e-82490f3d7164",
                                        "entry_id": "c3e3a223-18e6-3ec5-af76-8cc1f078ef3a",
