                "senses": [
                    {
                        "sense_id": "6d419549-6ec5-3d99-8498-7f99c264097a",
                        "entry_id": "1e46c80f-224b-386f-8f4f-7e8c0df38133",
                        "glosses": [
                            "das geplante Anpflanzen von Getreide"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "140d06b4-7954-4155-8b1d-efbb8e1741fa",
                                "sense_id": "6d419549-6ec5-3d99-8498-7f99c264097a",
                                "text": "„Dementsprechend muss auch der Getreidebau zunächst eine starke Zunahme auf Kosten der Weiden erfahren, später aber sich diese Zunahme verlangsamen.“"
                            },
                            {
                                "example_id": "7c8288f3-2b3f-48ff-b7f9-a42dda2c719c",
                                "sense_id": "6d419549-6ec5-3d99-8498-7f99c264097a",
                                "text": "„Wie sehr der Getreidebau im alten Italien verfiel, wie unvorteilhaft er für den Gutsherrn wurde, als ein Betrieb den Sklaven anheimfiel, davon haben die beiden Plinius und Columella Zeugnis abgelegt.“"
                            }
                        ],
