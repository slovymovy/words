                    {
                        "translation_id": "20bc383c-5923-4ef7-8d40-0dd14e1b2d23",
                        "source_entry_id": "9de026bf-656f-3c06-b576-b7e5bb153705",
                        "source_sense_id": "3808dd63-ec56-3949-99a8-a5093004579a",
                        "source_sense_description": "(Désuet) Lieu de débauche, bordel de bas étage.",
                        "target_lang_word": "Bordell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bordell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                        "entry_id": "170a0032-c752-328a-92c7-c118fa9cd33a",
                                        "glosses": [
                                            "Gebäude, in dem (meist) Frauen sexuelle Dienstleistungen gegen Entgelt anbieten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f53f59b2-fcc5-47e5-be61-f032f287bd7d",
                                                "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                                "text": "Mein Mann würde nie in ein Bordell gehen!"
                                            },
                                            {
                                                "example_id": "d5e10ad1-bda1-4bf4-a282-a9cf00b11f18",
                                                "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                                "text": "„Es gab noch ein einziges Bordell, um ein einziges weibliches Wesen herum.“"
                                            },
                                            {
                                                "example_id": "be6e3d55-acf7-4514-8d42-6816d3891f09",
                                                "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                                "text": "„Am Heiligabend lockt ein gewisser Mister Dick, ein Nachbar, sie mit einer Lüge in ein Bordell, wo er sie mit Hilfe der Puffmutter vergewaltigt.“"
                                            },
                                            {
                                                "example_id": "54caaff9-2b52-4fe6-b122-a10a3ce96b96",
                                                "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                                "text": "„Die abendliche Fahrt von Versmold nach Werther hat einen gewissen subkulturellen Reiz, weil auf dem Weg immerhin drei Bordelle rotes Licht ins Dunkel bringen.“"
                                            },
                                            {
                                                "example_id": "ccc19dda-435a-4350-91a2-827947516d66",
                                                "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                                "text": "„Die Suche nach ihm in Bordellen und sonstigen, der Militärpolizei bekannten Absteigen blieb erfolglos; dem Boot fehlte der Kapitän.“"
                                            },
                                            {
                                                "example_id": "45d83d2f-1239-4899-a61c-0a8b9e59a962",
                                                "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                                "text": "„Als junger Mann hatte er einmal einen Kapitän im Bordell auslösen müssen, dem hatten sie die Hosen ausgzogen, weil er nicht bezahlen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
