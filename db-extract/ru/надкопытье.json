                        "examples": [
                            {
                                "example_id": "548ec825-96a4-4a2a-abcc-c4149ded6c96",
                                "sense_id": "fef4e7e8-8a23-343b-92c5-9204274b463e",
                                "text": "Гривастый белолобый конь с мохнатыми надкопытьями лениво косился светящимся звериным зраком."
                            },
                            {
                                "example_id": "f179dc40-10a0-47a2-8e2e-143b09bd48ca",
                                "sense_id": "fef4e7e8-8a23-343b-92c5-9204274b463e",
                                "text": "Нога распухла так, что треснуло надкопытье. Сомнений больше не было — отходил свое конь…"
                            }
                        ]
                    }
