                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>loods</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "opslag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de <w>loodsen</w> heeft de politie de afgelopen jaren grondstoffen voor synthetische drugs gevonden.",
                            "target_lang_translations": {
                                "en": "In the <w>sheds</w>, the police have found raw materials for synthetic drugs in recent years.",
                                "ru": "В <w>ангарах</w> полиция в последние годы находила сырье для синтетических наркотиков."
                            }
                        },
                        {
                            "text": "De boer bewaart al zijn grote machines in de houten <w>loodsen</w> achter de boerderij.",
                            "target_lang_translations": {
                                "en": "The farmer keeps all his large machines in the wooden <w>sheds</w> behind the farm.",
                                "ru": "Фермер хранит все свои большие машины в деревянных <w>сараях</w> за фермой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'loods' (shed, warehouse)",
                        "ru": "множественное число существительного 'loods' (ангар, склад)"
                    },
                    "translations": {
