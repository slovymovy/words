                    {
                        "sense_id": "d4898789-bfab-3c12-bda8-140bdd306f8c",
                        "entry_id": "ed23ea4d-fce3-3b31-89a0-0a5d13fcf899",
                        "glosses": [
                            "Qualifie une personne sotte et solennelle."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "74405d4e-f660-4bef-94b4-b3e29b8ff70d",
                                "sense_id": "d4898789-bfab-3c12-bda8-140bdd306f8c",
                                "text": "DOUAI – […] Un grand sentiment de bien-être, quelque chose de semblable à la Flandre et à l’Angleterre. Rien qui sente l’ignoble petit bourgeois prud’homme, important et tracassier des villes du centre."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "321ac57b-fc3d-3167-ac8c-402bb0da526d",
                "word": "Prud'homme",
