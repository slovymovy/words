                "senses": [
                    {
                        "sense_id": "4ae35cf4-d77d-3f0e-8020-a2bddbf8bc36",
                        "entry_id": "d4b5be3e-657e-3352-9eaf-3601db333836",
                        "glosses": [
                            "A person who studies UFOs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93dd93b8-a812-41ab-81e0-53b2bea13666",
                                "sense_id": "4ae35cf4-d77d-3f0e-8020-a2bddbf8bc36",
                                "text": "Still, something strange was afoot in Rendlesham, and even if the file is unlikely to satisfy either ufologists or debunkers, it suggests that the truth is still out there."
                            },
                            {
                                "example_id": "636d0fde-d9c6-41c1-8cf7-958aa94cc9ea",
                                "sense_id": "4ae35cf4-d77d-3f0e-8020-a2bddbf8bc36",
                                "text": "But fear of abduction never stopped a good ufologist."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd7e5e54-fa70-451d-b2ea-f135786beed4",
                        "source_entry_id": "d4b5be3e-657e-3352-9eaf-3601db333836",
                        "source_sense_id": "4ae35cf4-d77d-3f0e-8020-a2bddbf8bc36",
                        "source_sense_description": "person who studies UFOs",
                        "target_lang_word": "ufologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ufologue",
