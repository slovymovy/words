                ],
                "senses": [
                    {
                        "sense_id": "f10cd3fb-926f-343a-bd72-a88c5cd90e0f",
                        "entry_id": "04e3781a-6550-3f55-9891-c4c3d460125f",
                        "glosses": [
                            "milchähnliches Getränk, Nebenprodukt der Butterherstellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b147b60d-46dd-4dfc-b889-943ab010344b",
                                "sense_id": "f10cd3fb-926f-343a-bd72-a88c5cd90e0f",
                                "text": "Die Buttermilch wird mit den pürierten Früchten vermischt."
                            },
                            {
                                "example_id": "58cc8141-a207-4f44-be5f-66620b34c3be",
                                "sense_id": "f10cd3fb-926f-343a-bd72-a88c5cd90e0f",
                                "text": "Milchhändler und Molkereien (Abnehmer) sind verpflichtet, Milch, entrahmte Milch, Buttermilch und geschlagene Buttermilch nur von Molkereien, die von der obersten Landesbehörde bestimmt werden, zu beziehen."
                            },
                            {
                                "example_id": "167b18dd-5008-46d2-a8ab-cff810371294",
                                "sense_id": "f10cd3fb-926f-343a-bd72-a88c5cd90e0f",
                                "text": "„Später gab es dicke weiße Bohnen, wie sie die Großmutter samstags in Buttermilch gekocht hatte, hier schwammen sie in Öl und Zitrone und schmeckten köstlich wie zu Hause.“"
                            },
                            {
                                "example_id": "642342b3-45a5-4774-93f2-5da4c6cd5506",
                                "sense_id": "f10cd3fb-926f-343a-bd72-a88c5cd90e0f",
                                "text": "„Otto Bambuss sieht mich an wie eine Eule, die mit Buttermilch gefüttert ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "792fa0a1-5922-4ea4-9918-b4670d8f3045",
                        "source_entry_id": "04e3781a-6550-3f55-9891-c4c3d460125f",
                        "source_sense_id": "f10cd3fb-926f-343a-bd72-a88c5cd90e0f",
                        "source_sense_description": "milchähnliches Getränk, Nebenprodukt der Butterherstellung",
                        "target_lang_word": "buttermilk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buttermilk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9075ae8a-6ca4-3a72-b4b8-f8e9f83f4ba3",
                                        "entry_id": "55bf682f-38a7-3091-81b0-a0857aeb142c",
                                        "glosses": [
                                            "The liquid left over after producing butter from full cream milk by the churning process, also called traditional buttermilk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2988568b-4c72-48c8-8fae-11ffe6ae5902",
                                                "sense_id": "9075ae8a-6ca4-3a72-b4b8-f8e9f83f4ba3",
                                                "text": "An anti-aphrodisiac, suggested in Hindu erotological literature as a way for women to negate amatory challenges, is to bathe in the buttermilk of a she-buffalo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377352df-883f-3361-950e-1780a78b6191",
                                        "entry_id": "55bf682f-38a7-3091-81b0-a0857aeb142c",
                                        "glosses": [
                                            "Cultured buttermilk, a fermented dairy product produced from cow's milk, with a characteristically sour taste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58cf331f-4dd6-3280-9801-ada14bea43c8",
                                        "entry_id": "55bf682f-38a7-3091-81b0-a0857aeb142c",
                                        "glosses": [
                                            "A light yellow color, like that of buttermilk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c063f489-5a7d-433a-b20c-08773d15a40d",
                        "source_entry_id": "04e3781a-6550-3f55-9891-c4c3d460125f",
                        "source_sense_id": "f10cd3fb-926f-343a-bd72-a88c5cd90e0f",
                        "source_sense_description": "milchähnliches Getränk, Nebenprodukt der Butterherstellung",
                        "target_lang_word": "babeurre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babeurre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff13e6f3-089d-3af2-9620-31ce2fb15210",
                                        "entry_id": "173aaffb-6de0-3d22-86f8-a144bbd4a4aa",
                                        "glosses": [
                                            "Liqueur séreuse et blanche que laisse le lait quand sa partie grasse est convertie en beurre, utilisée comme boisson et ingrédient pour différents mets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae55f156-2f77-4604-ad89-766c626dbdc4",
                                                "sense_id": "ff13e6f3-089d-3af2-9620-31ce2fb15210",
                                                "text": "On étala ses provisions : elles étaient frugales : trois œufs durcis, du fromage séché fort dur, et du pain de seigle. Jacquot et moi, nous avions de la vieille brebis en bœuf-à-la-mode, du fromage durci et un pain salé pétri avec du babeurre, que les paysans aiment beaucoup."
                                            },
                                            {
                                                "example_id": "75cb1f9d-3959-4ac7-9808-17473bb61eb8",
                                                "sense_id": "ff13e6f3-089d-3af2-9620-31ce2fb15210",
                                                "text": "À l’arrivée dans les grandes agglomérations, loin des centres de production, le babeurre se prête mal à la stérilisation par la chaleur. Industriellement, néanmoins, on prépare des babeurres concentrés et même des poudres de babeurre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05434870-dc35-3156-84f1-62a376e87d25",
                                        "entry_id": "173aaffb-6de0-3d22-86f8-a144bbd4a4aa",
                                        "glosses": [
                                            "Bâton dont on se sert pour battre la crème dans la baratte."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
