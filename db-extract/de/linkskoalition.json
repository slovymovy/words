                        "examples": [
                            {
                                "example_id": "88117c72-8a11-475d-8447-a1d9de222e17",
                                "sense_id": "b310b2e2-50bb-31ae-81ec-65f06bb49245",
                                "text": "„Nun müssen die Vertreter der Linkskoalition über eine Umstrukturierung der Landesregierung beraten.“"
                            },
                            {
                                "example_id": "3d992cbb-b669-4400-94af-eb94b419a7fb",
                                "sense_id": "b310b2e2-50bb-31ae-81ec-65f06bb49245",
                                "text": "„Am Freitag unterzeichnete der Sozialist, der einer in Minderheit regierenden Linkskoalition seiner Sozialisten und dem linksalternativen Bündnis vorstehen wird, das letzte Unterstützungsabkommen mit der baskischen Nationalistenpartei (PNV).“"
                            },
                            {
                                "example_id": "c3663bf3-3fb8-465b-83c3-95258264371c",
                                "sense_id": "b310b2e2-50bb-31ae-81ec-65f06bb49245",
                                "text": "„Die Union wirft der Linkskoalition Untätigkeit bei der Müllproblematik in Bielefeld vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
