                                "target_senses": [
                                    {
                                        "sense_id": "f92f60b9-635d-3bb9-839f-5cb86977e024",
                                        "entry_id": "7bbfd738-6f0d-314a-a094-56728cad7e3d",
                                        "glosses": [
                                            "Muet de stupéfaction ou d’émotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6169f7d7-0921-453a-b929-764a9379a495",
                                                "sense_id": "f92f60b9-635d-3bb9-839f-5cb86977e024",
                                                "text": "L’insolite mais \"sérieuse\" demande d’Emile Ratelband, inédite dans l’histoire judiciaire néerlandaise, a laissé sans voix les magistrats d’un tribunal du sud-est des Pays-Bas. L’homme veut que sa date de naissance soit modifiée dans son passeport, passant du 11 mars 1949 au 11 mars 1969."
                                            },
                                            {
                                                "example_id": "9c99a800-16f9-4419-a354-d8086ad25ed5",
                                                "sense_id": "f92f60b9-635d-3bb9-839f-5cb86977e024",
                                                "text": "Au moment de dire « oui », le marié est resté un moment sans voix."
                                            }
                                        ]
                                    }
                                ]
                            },
