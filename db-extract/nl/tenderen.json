                ],
                "senses": [
                    {
                        "sense_id": "99f00594-a52d-3822-a96a-e45bec683312",
                        "entry_id": "e35438c7-5d8d-3310-9f28-b2f845e3754c",
                        "glosses": [
                            "geleidelijk een neiging vertonen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "09d8adee-3494-4e65-b0ee-ee3ccf65c803",
                                "sense_id": "99f00594-a52d-3822-a96a-e45bec683312",
                                "text": "Amerikanen hebben de neiging hun falen op zichzelf te betrekken en tenderen, al tobbend, zo eerder naar neerslachtigheid."
                            },
                            {
                                "example_id": "13e5ef13-5eb5-4b24-b461-defe5c527a40",
                                "sense_id": "99f00594-a52d-3822-a96a-e45bec683312",
                                "text": "'Hoewel er internationaal steeds meer getendeerd wordt naar 4-4-2, ben ik nog steeds voorstander van een systeem met drie spitsen, met echte buitenspelers', vertelde Koeman in de zomer van 2000 in Voetbal International."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ccab4e8-7d2b-43db-a225-b24a7a9dfbcc",
                        "source_entry_id": "e35438c7-5d8d-3310-9f28-b2f845e3754c",
                        "source_sense_id": "99f00594-a52d-3822-a96a-e45bec683312",
                        "source_sense_description": "geleidelijk een neiging vertonen",
                        "target_lang_word": "tendre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tendre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a3bbd49-5480-31e3-b871-176f1df9ab6a",
                                        "entry_id": "5a33ddb5-e0d6-331c-a556-a793893d78f2",
                                        "glosses": [
                                            "Qui peut aisément être entamé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b62ed130-80bd-438b-88ec-8526d76374c0",
                                                "sense_id": "9a3bbd49-5480-31e3-b871-176f1df9ab6a",
                                                "text": "Le sapin, le saule et le peuplier sont des bois tendres. - Bâtir avec des pierres tendres."
                                            },
                                            {
                                                "example_id": "f06558c0-9017-42b3-803b-a934382cbc2f",
                                                "sense_id": "9a3bbd49-5480-31e3-b871-176f1df9ab6a",
                                                "text": "L’améthyste et l’émeraude sont des pierres tendres. - Le plomb et l’étain sont les plus tendres des métaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25e7e34c-1e64-353d-8de5-44a1c40bf98d",
                                        "entry_id": "5a33ddb5-e0d6-331c-a556-a793893d78f2",
                                        "glosses": [
                                            "Qualifie les aliments qui n’offrent pas de résistance quand on les coupe, quand on les mâche."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "977693b3-055b-4c8d-9a31-d42b5be6f085",
                                                "sense_id": "25e7e34c-1e64-353d-8de5-44a1c40bf98d",
                                                "text": "Une viande extrêmement tendre. - On ne peut rien manger de plus tendre. - La viande fraîche tuée n’est pas tendre."
                                            },
                                            {
                                                "example_id": "74140840-cb76-4cee-b197-c313a188ff0d",
                                                "sense_id": "25e7e34c-1e64-353d-8de5-44a1c40bf98d",
                                                "text": "Cette viande est tendre au couteau, est tendre sous le couteau, est tendre sous la dent. - Ces haricots verts sont très tendres."
                                            },
                                            {
                                                "example_id": "03a915a7-d726-4c3c-a6be-3a20292907fe",
                                                "sense_id": "25e7e34c-1e64-353d-8de5-44a1c40bf98d",
                                                "text": "Le poulet est si tendre"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4c9bb5b-c0f0-360a-a304-fa22a93ab5a8",
                                        "entry_id": "5a33ddb5-e0d6-331c-a556-a793893d78f2",
                                        "glosses": [
                                            "Qualifie également du pain nouvellement cuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d4cf7c4-5649-4151-9849-5353c5ac1aeb",
                                                "sense_id": "f4c9bb5b-c0f0-360a-a304-fa22a93ab5a8",
                                                "text": "Manger du pain tendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42dba20a-437c-3cc5-85bf-9f5eaf9df8b3",
                                        "entry_id": "5a33ddb5-e0d6-331c-a556-a793893d78f2",
                                        "glosses": [
                                            "Qui est sensible, délicat, qui est aisément pénétré par les impressions extérieures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a642afb7-281b-46b5-84ba-d3306df84f11",
                                                "sense_id": "42dba20a-437c-3cc5-85bf-9f5eaf9df8b3",
                                                "text": "Avoir la peau tendre. Les jeunes arbres ont l’écorce tendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce3904e5-8771-3992-ac18-71ca59e8187e",
                                        "entry_id": "5a33ddb5-e0d6-331c-a556-a793893d78f2",
                                        "glosses": [
                                            "Délicat et faible, en parlant de la vue, des yeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fa79f88-d481-4ab3-ae4e-b2a3fbe84f28",
                                                "sense_id": "ce3904e5-8771-3992-ac18-71ca59e8187e",
                                                "text": "Une vue, dite tendre, force le digne notaire à porter des lunettes vertes pour conserver ses yeux, constamment rouges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc5ef3a5-b47c-39cc-adda-09b43c2315d0",
                                        "entry_id": "5a33ddb5-e0d6-331c-a556-a793893d78f2",
                                        "glosses": [
                                            "Qui a de la tendresse, qui est sensible à l’amitié, à la compassion, et plus particulièrement à l’amour."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e800bd89-11fb-40bb-b27e-6928679c62fc",
                                                "sense_id": "cc5ef3a5-b47c-39cc-adda-09b43c2315d0",
                                                "text": "Adolphe pouvait d'ailleurs passer , au début, pour le modèle des amants, tendre, empressé, inquiet dans la juste mesure ; […]."
                                            },
                                            {
                                                "example_id": "60d92760-d67b-42d1-b5b0-5d2cfae06abb",
                                                "sense_id": "cc5ef3a5-b47c-39cc-adda-09b43c2315d0",
                                                "text": "Avoir l’âme tendre, le cœur tendre. - Il est d’un naturel tendre. - Il a une imagination vive et tendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b7acbb9-8ab9-3b02-8e96-46048c104a1d",
                                        "entry_id": "5a33ddb5-e0d6-331c-a556-a793893d78f2",
                                        "glosses": [
                                            "Qualifie les choses où se marque de l’amitié, de la compassion, où se manifeste de l’amour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaa1085c-37d9-4a2a-b5fa-8941f77c5380",
                                                "sense_id": "1b7acbb9-8ab9-3b02-8e96-46048c104a1d",
                                                "text": "Ce qu’elle chantait – ah ! la fatale et maudite chanson ! –, c’était une vieille romance larmoyante et tendre, pareille à celles que les aveugles nasillent dans les rues."
                                            },
                                            {
                                                "example_id": "d86b14e2-fc89-48aa-81bb-68d26c313a91",
                                                "sense_id": "1b7acbb9-8ab9-3b02-8e96-46048c104a1d",
                                                "text": "Vous recevez plein de gestes tendres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73096557-003b-3374-ad13-be6b21451a18",
                                        "entry_id": "5a33ddb5-e0d6-331c-a556-a793893d78f2",
                                        "glosses": [
                                            "Qualifie une couleur délicate, qui ne fatigue pas la vue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f150828-46e4-418a-9813-c356ae594156",
                                                "sense_id": "73096557-003b-3374-ad13-be6b21451a18",
                                                "text": "Ils remontaient au temps d'une certaine pègre pour qui la suprême élégance consistait à se pourvoir d'un couvre-chef de couleur tendre et de souliers vernis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "110bff72-2d2a-32a3-af54-4a4e087a232c",
                                        "entry_id": "5a33ddb5-e0d6-331c-a556-a793893d78f2",
                                        "glosses": [
                                            "Qualifie un son de voix touchant et gracieux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f72eb8b5-d391-4bb1-96d4-42a57c34ac4f",
                                                "sense_id": "110bff72-2d2a-32a3-af54-4a4e087a232c",
                                                "text": "Il est proche le jour où ton front s’inclinera vers le mien, où tu me diras de la voix tendre et basse et enivrée qui fait trembler mon âme : Tu es là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "310a5c73-c9e8-3c11-bbff-744ea3ca7ce4",
                                        "entry_id": "5a33ddb5-e0d6-331c-a556-a793893d78f2",
                                        "glosses": [
                                            "Qualifie un air touchant et passionné."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tendre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57848fa2-fdf8-3505-a56b-17e439fc2dc1",
                                        "entry_id": "d00a92e5-a047-3701-aa29-ef1517b60a82",
                                        "glosses": [
                                            "Partie tendre d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c9952db-9c48-4b76-af7d-8844828a3f32",
                                                "sense_id": "57848fa2-fdf8-3505-a56b-17e439fc2dc1",
                                                "text": "Le tendre d’une pierre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69bc14e6-d203-3e00-9e68-0f2f5e4724a9",
                                        "entry_id": "d00a92e5-a047-3701-aa29-ef1517b60a82",
                                        "glosses": [
                                            "Tendresse, amour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7b17cb5-2b3b-409b-b927-0f51e47a7a47",
                                                "sense_id": "69bc14e6-d203-3e00-9e68-0f2f5e4724a9",
                                                "text": "Il a du tendre, il a un tendre pour cette femme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tendre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d295678d-c6a5-3f76-b668-4e1fa03836b5",
                                        "entry_id": "3b439ebf-d7ee-3699-b1c8-9c4c8ce35cf5",
                                        "glosses": [
                                            "Étirer un fil, une corde, une surface; tirer une corde par plusieurs côtés pour la rendre raide ; étirer une peau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1256b009-8922-4f53-ab4c-c10d442e6703",
                                                "sense_id": "d295678d-c6a5-3f76-b668-4e1fa03836b5",
                                                "text": "Quatorze colonnes de bois, hautes de vingt-trois pieds, tendaient au-dessus de la salle un ciel d’étoffe écarlate."
                                            },
                                            {
                                                "example_id": "20381469-9c29-41a1-8eba-704be79897dd",
                                                "sense_id": "d295678d-c6a5-3f76-b668-4e1fa03836b5",
                                                "text": "Deux fils de même ténacité, mais de numéros différents, qui doivent être tendus conséquemment avec la même traction, ne peuvent donc pas, au dévidoir, prendre le même dispositif de tension."
                                            },
                                            {
                                                "example_id": "252ec9e7-5d25-4583-8e13-f63380176f87",
                                                "sense_id": "d295678d-c6a5-3f76-b668-4e1fa03836b5",
                                                "text": "C’est comme pour appeauter un tétras, rien de plus simple. Tu tends une feuille de chiendent entre tes deux pouces et tu souffles dans l’intervalle. Tu vois arriver le coq, la crête droite, écarlate et le collet ébouriffé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47251c30-9b6c-3ff5-b01e-a418d0260298",
                                        "entry_id": "3b439ebf-d7ee-3699-b1c8-9c4c8ce35cf5",
                                        "glosses": [
                                            "Installer et armer des pièges à petits animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08a4a734-a009-491c-b79a-966760fb8ec5",
                                                "sense_id": "47251c30-9b6c-3ff5-b01e-a418d0260298",
                                                "text": "La plupart de ces petits mammifères étant nocturnes, il faut tendre les pièges le soir et les visiter de bon matin."
                                            },
                                            {
                                                "example_id": "dfd699a7-5608-468f-8d98-27601bf804b8",
                                                "sense_id": "47251c30-9b6c-3ff5-b01e-a418d0260298",
                                                "text": "« Demain, dit Lili, je vais préparer les pièges à grives de Baptistin, et je tendrai demain soir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4906ef0-990b-3b91-b204-699da7603614",
                                        "entry_id": "3b439ebf-d7ee-3699-b1c8-9c4c8ce35cf5",
                                        "glosses": [
                                            "Étaler une tenture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12fbc326-7504-427c-aacc-63c1bd5a4cdb",
                                                "sense_id": "f4906ef0-990b-3b91-b204-699da7603614",
                                                "text": "Le palier est long et étroit, le mur est tendu d’une imitation de tapisserie à ramages vert sombre où brille le cuivre d’une applique à gaz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3de3807-dc87-3cfe-8527-13ac1407e47b",
                                        "entry_id": "3b439ebf-d7ee-3699-b1c8-9c4c8ce35cf5",
                                        "glosses": [
                                            "Porter vers un but."
                                        ],
                                        "tags": [],
                                        "note": "Il est alors suivi de la préposition à et d’un verbe à l'infinitif",
                                        "examples": [
                                            {
                                                "example_id": "7ad35ede-d5ca-4b37-921f-352a00cfad7e",
                                                "sense_id": "b3de3807-dc87-3cfe-8527-13ac1407e47b",
                                                "text": "Toutes les religions et toutes les morales ont tendu à jeter un voile sur la gesticulation fornicatoire qui est, cependant, à la base de la vie […]."
                                            },
                                            {
                                                "example_id": "afc97de0-42cd-407f-8c36-6df0d4833573",
                                                "sense_id": "b3de3807-dc87-3cfe-8527-13ac1407e47b",
                                                "text": "C’est ainsi, soit dit entre parenthèses, que pour ne rien trahir lui-même, le narrateur a tendu à l’objectivité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e411e8-2e9f-3717-8728-9cff49449eb9",
                                        "entry_id": "3b439ebf-d7ee-3699-b1c8-9c4c8ce35cf5",
                                        "glosses": [
                                            "Évoluer vers un état différent."
                                        ],
                                        "tags": [],
                                        "note": "Il est alors suivi de la préposition à et d'un verbe à l'infinitif",
                                        "examples": [
                                            {
                                                "example_id": "16ddae4f-dce5-429b-9408-ad756b1f2216",
                                                "sense_id": "e3e411e8-2e9f-3717-8728-9cff49449eb9",
                                                "text": "Prélavez le textile, qui tend à rétrécir au lavage, et prenez-en compte ce facteur au moment de votre achat : le retrait du denim peut être important."
                                            },
                                            {
                                                "example_id": "a2299f25-dc53-4297-ab6f-abd6bd342b11",
                                                "sense_id": "e3e411e8-2e9f-3717-8728-9cff49449eb9",
                                                "text": "Par-delà les débats idéologiques, on a déjà pointé les dérives potentielles d’une société ultra-gérée (de Gaulejac, 2005) dans laquelle la production se réoriente en fonction d’indicateurs et d’objectifs de plus en plus souvent détachés de la réalité, tandis que le non-mesurable tend à être négligé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b01723bd-f3c3-32ad-b2a6-cd52a79bdaa9",
                                        "entry_id": "3b439ebf-d7ee-3699-b1c8-9c4c8ce35cf5",
                                        "glosses": [
                                            "Avoir pour limite; avoir un comportement asymptotique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f65eb1d-9d75-479e-941d-8c064ea2b494",
                                                "sense_id": "b01723bd-f3c3-32ad-b2a6-cd52a79bdaa9",
                                                "text": "1/x tend vers l'infini quand x tend vers 0."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72dca02d-e81a-3285-ad75-5b37670a870f",
                                        "entry_id": "3b439ebf-d7ee-3699-b1c8-9c4c8ce35cf5",
                                        "glosses": [
                                            "Offrir ; mettre à disposition."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c482de85-665a-4b48-9b10-9dfe08b08510",
                                                "sense_id": "72dca02d-e81a-3285-ad75-5b37670a870f",
                                                "text": "Hurtaud alluma un cigare à la flamme d’une bougie qu’on lui tendit, et se rassit lourdement."
                                            },
                                            {
                                                "example_id": "3c62e391-6b31-46da-b38f-3334bf5f794a",
                                                "sense_id": "72dca02d-e81a-3285-ad75-5b37670a870f",
                                                "text": "On est venu nous offrir des bières par le toit ouvrant, alors que les gens qui nous les tendaient ne nous connaissaient pas."
                                            },
                                            {
                                                "example_id": "50303b6d-d005-4bff-9b44-e9e3fc5900c8",
                                                "sense_id": "72dca02d-e81a-3285-ad75-5b37670a870f",
                                                "text": "François s'exécuta, puis, d'un coup de pouce, il enflamma son briquet d'amadou et le tendit, en silence, à la fille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fc6492f-56d7-3538-b20c-241a41d61778",
                                        "entry_id": "3b439ebf-d7ee-3699-b1c8-9c4c8ce35cf5",
                                        "glosses": [
                                            "Devenir en situation de tension."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03554fa9-899f-484b-97fd-3c2000b05a6e",
                                                "sense_id": "5fc6492f-56d7-3538-b20c-241a41d61778",
                                                "text": "Pour sonder son frère, Aristide, qui n’osait paraître inquiet ouvertement, se contenta de lui demander :\n— As-tu lu mon article d’hier ? Qu’en penses-tu ?\nEugène eut un léger mouvement d’épaules.\n— Vous êtes un niais, mon frère, répondit-il simplement.\n— Alors, s’écria le journaliste en pâlissant, tu donnes raison à Vuillet, tu crois au triomphe de Vuillet.\n— Moi !… Vuillet…\nIl allait certainement ajouter : « Vuillet est un niais comme toi. » Mais en apercevant la face grimaçante de son frère qui se tendait anxieusement vers lui, il parut pris d’une subite défiance."
                                            },
                                            {
                                                "example_id": "ae469773-5828-4c1c-b336-e39fd3ce9139",
                                                "sense_id": "5fc6492f-56d7-3538-b20c-241a41d61778",
                                                "text": "Les rapports s’étaient tendus aussi entre les États-Unis et le Japon, à cause de l’éternelle question de la naturalisation des jaunes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
