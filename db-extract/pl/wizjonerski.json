                "senses": [
                    {
                        "sense_id": "d6b95141-3b88-3912-8db8-e5b5290d9a33",
                        "entry_id": "babdb9ad-8a75-38f9-ab28-751668736849",
                        "glosses": [
                            "właściwy wizjonerowi, charakteryzujący się wizjonerstwem"
                        ],
                        "tags": [],
