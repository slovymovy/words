                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3392d6c4-b5f9-4c41-a470-6c4bae47e832",
                                "sense_id": "9dcc2052-e47b-3320-8d6e-036386c79ad2",
                                "text": "But Powers, a former staff writer at The Washington Post who has written extensively on media and technology, is not simply an earnest foreteller of doom."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20eaca3d-5cad-4147-9457-89f5e721ae59",
                        "source_entry_id": "05840744-c3a6-3a15-b042-8b2314f78114",
                        "source_sense_id": "9dcc2052-e47b-3320-8d6e-036386c79ad2",
                        "source_sense_description": "someone who foretells",
                        "target_lang_word": "Wahrsager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wahrsager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2f09840-7646-3fcf-bd52-f6e938981b23",
                                        "entry_id": "9c4088e9-6124-3575-93f2-478681a8e519",
                                        "glosses": [
                                            "jemand, der versucht, die Zukunft vorherzusagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34ca7394-a725-47e3-bdad-85d900dc0337",
                                                "sense_id": "f2f09840-7646-3fcf-bd52-f6e938981b23",
                                                "text": "Die Prophezeiungen von Wahrsagern sind im Jahr 2002 zum größten Teil nicht eingetreten."
                                            },
                                            {
                                                "example_id": "74069325-a073-42b6-b6d7-36cc12ede7af",
                                                "sense_id": "f2f09840-7646-3fcf-bd52-f6e938981b23",
                                                "text": "„Gern hörte Martin den Wahrsagern zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41998853-a464-4591-a76f-84b65dbc9d23",
                        "source_entry_id": "05840744-c3a6-3a15-b042-8b2314f78114",
                        "source_sense_id": "9dcc2052-e47b-3320-8d6e-036386c79ad2",
                        "source_sense_description": "someone who foretells",
                        "target_lang_word": "Wahrsagerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wahrsagerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                        "entry_id": "f7799cf1-4e51-3516-9bd0-b4b7d72af9e6",
                                        "glosses": [
                                            "jemand, der versucht, die Zukunft vorherzusagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cb4e669-ac70-46d5-bbfe-1fcd0d807ced",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "Auf die Prophezeiungen von Wahrsagerinnen kann man sich nicht verlassen."
                                            },
                                            {
                                                "example_id": "8a276318-c86d-40ee-b0d1-394804af02aa",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "„Nachdenklich zieht er sein Portemonnaie hervor, nimmt zwei Zehnpfennigstücke heraus und zieht an einem grünen Automaten neben dem der Wahrsagerin eine Packung Pfefferminz.“"
                                            },
                                            {
                                                "example_id": "00178ae2-c7a5-438a-b50f-dea368cf7af8",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "„Tante Fatma sei die beste Wahrsagerin jenseits des Bosporus, sagte meine Schwester.“"
                                            },
                                            {
                                                "example_id": "f59771d0-d611-40f4-a07e-84c33c8fd6f6",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "„Denn die Wahrsagerin ist noch beschäftigt, oder sie braucht Zeit zur Meditation und zur Einstimmung auf den Gast.“"
                                            },
                                            {
                                                "example_id": "75e79e6c-cea9-4f29-a31b-653fbc087053",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "„In seiner Kindheit wurde Freud von einer Wahrsagerin vorausgesagt, er würde Minister werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b169db72-5899-431a-b97c-ca09040cd882",
                        "source_entry_id": "05840744-c3a6-3a15-b042-8b2314f78114",
                        "source_sense_id": "9dcc2052-e47b-3320-8d6e-036386c79ad2",
                        "source_sense_description": "someone who foretells",
                        "target_lang_word": "Hellseher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hellseher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8d83b6c-df89-3d1a-a757-670c0d8f2745",
                                        "entry_id": "a864e887-5b85-300c-8ff9-8ffbd3f53c8c",
                                        "glosses": [
                                            "(männliche) Person, die Dinge wahrnehmen kann, die für die Sinne zeitlich oder räumlich zu weit entfernt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eded7f35-d22e-49e5-b4cc-f24a3b967d0d",
                                                "sense_id": "a8d83b6c-df89-3d1a-a757-670c0d8f2745",
                                                "text": "Hast du gehört? Frank soll einen Hellseher gefragt haben, wie es um seine Zukunft steht."
                                            },
                                            {
                                                "example_id": "1689af76-23e4-4094-86ca-95a4951239b6",
                                                "sense_id": "a8d83b6c-df89-3d1a-a757-670c0d8f2745",
                                                "text": "„Dass Leinefelde aber sogar einmal die größte Ansiedlung im Obereichsfeld werden würde, konnte wohl selbst der befähigteste Hellseher nicht voraussehen.“"
                                            },
                                            {
                                                "example_id": "13ca15b2-2d61-48f5-9970-4b0cbb3c5744",
                                                "sense_id": "a8d83b6c-df89-3d1a-a757-670c0d8f2745",
                                                "text": "„Der Hellseher merkte kurz auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acbc1d75-cecc-49a7-8c7b-dbfca2dc052c",
                        "source_entry_id": "05840744-c3a6-3a15-b042-8b2314f78114",
                        "source_sense_id": "9dcc2052-e47b-3320-8d6e-036386c79ad2",
                        "source_sense_description": "someone who foretells",
                        "target_lang_word": "Hellseherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hellseherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3406bda-8474-3519-a519-bf2bfd5143b6",
                                        "entry_id": "ec297978-90b6-3092-92f2-5e7469121d91",
                                        "glosses": [
                                            "weibliche Person, die Dinge wahrnehmen kann, die zeitlich oder räumlich weit entfernt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3addb304-d5c9-4c11-8998-4b61ee2d2e58",
                                                "sense_id": "f3406bda-8474-3519-a519-bf2bfd5143b6",
                                                "text": "Die Hellseherin bemerkte die Gefahr in voraus und warnte alle, ohne etwas dafür zu verlangen."
                                            },
                                            {
                                                "example_id": "acde46e8-f11d-483f-a9dd-7b6728f63d63",
                                                "sense_id": "f3406bda-8474-3519-a519-bf2bfd5143b6",
                                                "text": "„Sie begann damit, daß eine mexikanische Hellseherin den siebenjährigen Michael vor unterirdischen Kräften warnte und ihn eindringlich ermahnte, Erdbebengebiete zu meiden, sonst würde er sein Leben aufs Spiel setzen.“"
                                            },
                                            {
                                                "example_id": "cc95a3d8-ba9a-467b-b51d-b473622de082",
                                                "sense_id": "f3406bda-8474-3519-a519-bf2bfd5143b6",
                                                "text": "„Sie war in dieser Beziehung eine Hellseherin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
