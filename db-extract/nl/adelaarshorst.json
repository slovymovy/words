                "senses": [
                    {
                        "sense_id": "7ca2baa2-6fe3-3055-a92a-19df6245d753",
                        "entry_id": "02ce15d6-1783-3e32-aef0-1b4faf15563d",
                        "glosses": [
                            "stadion van de Deventer voetbalclub Go Ahead Eagles"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17604653-79a2-443c-80d7-ed74a6ba626a",
                                "sense_id": "7ca2baa2-6fe3-3055-a92a-19df6245d753",
                                "text": "Go Ahead Eagles heeft thuis op de Adelaarshorst een eenvoudige overwinning geboekt tegen Willem II: 4-0. Go Ahead - voor even de nummer negen van de eredivisie - kijkt stiekem omhoog naar een plekje dat recht geeft op play-offs voor Europees voetbal. Willem II kijkt angstig naar beneden, degradatie komt akelig dichtbij."
                            },
                            {
                                "example_id": "69375aaa-2893-4e90-afed-868b15e2bacb",
                                "sense_id": "7ca2baa2-6fe3-3055-a92a-19df6245d753",
                                "text": "Nu doet United hetzelfde. Ten Hag werkte in de Adelaarshorst, de Galgenwaard en de Johan Cruijff Arena. Volgende stop: het Theatre of Dreams."
                            },
                            {
                                "example_id": "d52b8e45-143b-4b97-842b-b780dc734d38",
                                "sense_id": "7ca2baa2-6fe3-3055-a92a-19df6245d753",
                                "text": "Toeters en vlaggen: Volgens de regionale omroep RTV Oost was het ook druk in de omgeving van het stadion van de club, De Adelaarshorst. Voorbijkomende auto's toeterden erop los en mensen hingen met vlaggen uit het raam."
                            }
                        ]
                    }
