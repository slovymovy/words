                        "cross_references": [
                            {
                                "target_word": "Nominalismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c964c24-a470-3bcd-982a-2e393dcf0267",
                                        "entry_id": "6162c589-45a5-337b-8e20-886ff7b9b9b8",
                                        "glosses": [
                                            "spätmittelalterliche erkenntnistheoretische Ansicht, dass die Bedeutung von allgemeinen Begriffen des Denkens außerhalb ihres formalen Geltungsbereiches nur in ihrem Namens- und Zeichencharakter liegt und ihnen nichts Wirkliches entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca65fee0-1eac-433d-b0e7-8ffb3defa1e7",
                                                "sense_id": "7c964c24-a470-3bcd-982a-2e393dcf0267",
                                                "text": "„Aller kirchlichen Gegenwehr zum Trotz wird der Nominalismus das philosophische und politische Denken der Neuzeit dominieren.“"
                                            },
                                            {
                                                "example_id": "6b348689-97cb-4823-8c7d-475e0426a0a8",
                                                "sense_id": "7c964c24-a470-3bcd-982a-2e393dcf0267",
                                                "text": "„Die erkenntniskritischen Tendenzen des Nominalismus führten zur Entwicklung des modernen empiristischen Wissenschaftsbegriffs, der mit seinem Ausgang vom sinnlich wahrnehmbaren einzelnen im Grunde immer individualistisch denkt, zur Metaphysikkritik, zur Trennung von Wissen und Glauben und zu einer Höherstellung des Willens gegenüber dem Denken […] vor allem in der Theologie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "da63ba2e-9621-3976-9f19-4c8cfa5dc53c",
                                        "entry_id": "6162c589-45a5-337b-8e20-886ff7b9b9b8",
                                        "glosses": [
                                            "Ablehnung der Vorstellung, die zu beurteilenden Dinge, Sachverhalte oder Ideen hätten eine Art universale Realität und Höherbewertung der rechtlich zu verarbeitenden Sachverhalte"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "64681553-4b2a-32da-b7f2-427ca16e4331",
                                        "entry_id": "6162c589-45a5-337b-8e20-886ff7b9b9b8",
                                        "glosses": [
                                            "volkswirtschaftlicher Ansatz, nach dem das Geld nur einen Wert repräsentiert, diesen aber selbst nicht innehat"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
