                "senses": [
                    {
                        "sense_id": "0b1cec1f-a1a0-3c56-916f-07549809ebf5",
                        "entry_id": "aac14c9c-5b89-3c29-94e5-311b7e66c865",
                        "glosses": [
                            "ein Gebiet, in dem ein niedrigerer Luftdruck herrscht als in dessen großräumiger Umgebung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fd6f5b6-ae4b-4969-8185-5f4504f9fc65",
                                "sense_id": "0b1cec1f-a1a0-3c56-916f-07549809ebf5",
                                "text": "Von Norden her schiebt sich ein Tiefdruckgebiet über Deutschland."
                            },
                            {
                                "example_id": "cf68ecd5-6c88-4ce4-8b8a-aeca831aa034",
                                "sense_id": "0b1cec1f-a1a0-3c56-916f-07549809ebf5",
                                "text": "„Für Deutschland breitet sich ein Tiefdruckgebiet aus, das in seinem ganzen Bereich dem bisherigen Wetter ein Ende bereitet hat.“"
                            },
                            {
                                "example_id": "b9c642df-6ecd-41d9-9404-69abdf4defc5",
                                "sense_id": "0b1cec1f-a1a0-3c56-916f-07549809ebf5",
                                "text": "„In den meisten Fällen transportiert ein Tiefdruckgebiet den Saharastaub über das Mittelmeer nach Europa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
