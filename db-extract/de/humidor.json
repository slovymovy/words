                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea97a37c-d62c-465d-ab91-2414913b9368",
                                "sense_id": "b703a2d8-a30d-3262-8b3e-34a0deefc814",
                                "text": "Einige Rauchsalons und Zigarrenclubs haben sogar begehbare Humidore, in denen größere Mengen Zigarren gelagert werden können."
                            },
                            {
                                "example_id": "e584fb6b-bb28-4d93-872f-277ef29e7687",
                                "sense_id": "b703a2d8-a30d-3262-8b3e-34a0deefc814",
                                "text": "„Als Hoffman Hani eine Zigarre anbot, öffnete der Jordanier seinen Humidor und bestand darauf, das der Besucher eine von seinen probierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
