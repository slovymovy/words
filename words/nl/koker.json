                            "target_lang_translations": {
                                "en": "The architect kept the large blueprints neatly rolled up in a cardboard <w>tube</w>."
                            }
                        },
                        {
                            "text": "In de verborgen <w>koker</w> zat een geheim testament dat pas jaren later werd gevonden.",
                            "target_lang_translations": {
