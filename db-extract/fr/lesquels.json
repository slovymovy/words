                                "sense_id": "83d6758b-95a7-37cf-8730-07d0629f0b19",
                                "text": "Elle préfère les hommes avec lesquels tu sortais.",
                                "translation": "She prefers the men with whom you were going out.",
                                "english": "She prefers the men with whom you were going out."
                            },
                            {
                                "example_id": "28606659-06ad-45ca-8cc5-6193c45172ab",
                                "sense_id": "83d6758b-95a7-37cf-8730-07d0629f0b19",
                                "text": "Il se remet à travailler sur les projet pour lesquels il avait déjà passé tellement de temps.",
                                "translation": "He's starting to work on the projects on which he had already spent so much time.",
                                "english": "He's starting to work on the projects on which he had already spent so much time."
                            }
