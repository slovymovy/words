                "senses": [
                    {
                        "sense_id": "fd12d8e1-fb2e-3f73-a71b-d52fb7c10902",
                        "entry_id": "d53af36d-a8ff-3234-91e4-d6608ba4128f",
                        "glosses": [
                            "eine auf Yucatán (Mexiko) gesprochene Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ba9550-1aca-450f-a3b1-1fae4890db35",
                                "sense_id": "fd12d8e1-fb2e-3f73-a71b-d52fb7c10902",
                                "text": "Yukatekisch hat geschätzte 800.000 Sprecher."
                            },
                            {
                                "example_id": "a518e505-6919-4d9a-beaf-a58fa27a8539",
                                "sense_id": "fd12d8e1-fb2e-3f73-a71b-d52fb7c10902",
                                "text": "„Im modernen Yukatekisch kommen jedoch noch ganz andere Dinge zum Tragen.“"
                            },
                            {
                                "example_id": "cd018fc9-40fc-4a7b-8357-581e47492c8c",
                                "sense_id": "fd12d8e1-fb2e-3f73-a71b-d52fb7c10902",
                                "text": "„Aus der historischen Linguistik wissen wir, daß in diesen beiden Großregionen die verwandten, aber deutlich unterschiedenen Sprachen Yukatekisch im Norden und Proto-Cholisch im Süden gesprochen wurden[…]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
