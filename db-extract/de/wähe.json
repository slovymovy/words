                "senses": [
                    {
                        "sense_id": "d7823e17-4ee5-31f3-8c66-b5205fa2ace4",
                        "entry_id": "342d6ec8-a465-3b3e-bfbd-397c7b64b1d4",
                        "glosses": [
                            "meist aus Mürbeteig zubereiteter Blechkuchen mit (süßem/pikantem) Belag"
                        ],
                        "tags": [
                            "South German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "86afa83c-857a-4a12-9be5-dbc3a9aa337f",
                                "sense_id": "d7823e17-4ee5-31f3-8c66-b5205fa2ace4",
                                "text": "Eine pikante Wähe hat einen knuspriger Teigrand, ein währschaftes Innenleben und eine herzhaft gebräunte Kruste."
                            },
                            {
                                "example_id": "a3b650a0-c591-4655-8628-c76592e092c5",
                                "sense_id": "d7823e17-4ee5-31f3-8c66-b5205fa2ace4",
                                "text": "„Denn dieses Rezept für die schweizer Schwester der französischen Tarte schmeckt mit selbst gemachtem Kuchenteig schon fast so gut, wie die Wähe von damals bei unserem Grosi (Grossmutter) zu Hause.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
