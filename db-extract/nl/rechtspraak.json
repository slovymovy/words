                "translations": [
                    {
                        "translation_id": "0e451ace-806f-41fe-8d0d-c726060af69b",
                        "source_entry_id": "78b7b0cc-dede-3e87-8e59-0e8666778aa2",
                        "source_sense_id": "e2e68c05-9c72-323d-8573-6dacb60e4ce3",
                        "source_sense_description": "het proces waarin door een rechter een oordeel wordt gevormd over een rechtszaak",
                        "target_lang_word": "Rechtsprechung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechtsprechung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0cb9b4c-78bf-357e-a4c8-05923ff59577",
                                        "entry_id": "0ec9f068-6902-3f01-be75-a118fe7c81ea",
                                        "glosses": [
                                            "Menge und/oder Art der erfolgten Gerichtsurteile"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaa18424-161d-40bb-a627-0c71f8517aec",
                                                "sense_id": "b0cb9b4c-78bf-357e-a4c8-05923ff59577",
                                                "text": "Die Rechtsprechung hat sich im Lauf der Zeit geändert."
                                            },
                                            {
                                                "example_id": "f85c7fb1-9a3e-4834-a00d-e56dd4b772b5",
                                                "sense_id": "b0cb9b4c-78bf-357e-a4c8-05923ff59577",
                                                "text": "„Später, als ich etwas älter war und mich ernsthafter mit der deutschen Rechtsprechung beschäftigte, wurde mir die Bedeutung von Gesetzen und Rechten viel stärker bewusst.“"
                                            },
                                            {
                                                "example_id": "6e91eff9-03b9-40c5-85a8-a0e3a6e03844",
                                                "sense_id": "b0cb9b4c-78bf-357e-a4c8-05923ff59577",
                                                "text": "„Ich hörte, wie ein junger Abate mit lauter Stimme eine wahre oder erfundene Begebenheit erzählte, die unmittelbar, doch ohne Gehässigkeit, die Rechtsprechung des Heiligen Vaters angriff.“"
                                            },
                                            {
                                                "example_id": "5138c72b-5455-4688-82a3-04331ae15c1b",
                                                "sense_id": "b0cb9b4c-78bf-357e-a4c8-05923ff59577",
                                                "text": "[Die Ukraine] „hat sich aber in zwei Erklärungen von 2014 und 2015 der Rechtsprechung des IStGH für alle Verbrechen ab November 2013 unterworfen. Damit kann der IStGH zumindest Verbrechen auf ukrainischem Boden untersuchen.“"
                                            },
                                            {
                                                "example_id": "c8b0778a-701f-445b-8c5e-144a2db7754b",
                                                "sense_id": "b0cb9b4c-78bf-357e-a4c8-05923ff59577",
                                                "text": "„Wie immer man zu dieser Darstellung stehen mag, sie zeigt jedenfalls ein ganz anderes Verständnis von literarischer Urheberschaft, als es das unsre ist (auf dem, nota bene, unsere Rechtsprechung beruht).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "648b72e7-92f9-4118-b8cd-c8497b6885ab",
                        "source_entry_id": "78b7b0cc-dede-3e87-8e59-0e8666778aa2",
                        "source_sense_id": "e2e68c05-9c72-323d-8573-6dacb60e4ce3",
                        "source_sense_description": "het proces waarin door een rechter een oordeel wordt gevormd over een rechtszaak",
                        "target_lang_word": "jurisdiction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jurisdiction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc6c265e-d89d-396d-a590-a9b873c58ba1",
                                        "entry_id": "512ff3c8-398a-3919-9967-ce5c3fb8d072",
                                        "glosses": [
                                            "The power, right, or authority to interpret and apply the law."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ded67f36-0d65-3e83-bd63-7cbf57b26e46",
                                        "entry_id": "512ff3c8-398a-3919-9967-ce5c3fb8d072",
                                        "glosses": [
                                            "The power or right to exercise authority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f52b630-5017-3162-9c12-c3c046c2ac8d",
                                        "entry_id": "512ff3c8-398a-3919-9967-ce5c3fb8d072",
                                        "glosses": [
                                            "The power or right to perform some action as part of applying the law."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "781b9f66-0602-466a-b0f6-b8e8a54ea672",
                                                "sense_id": "0f52b630-5017-3162-9c12-c3c046c2ac8d",
                                                "text": "The Fife County Council, and other objectors, were successful in July [1950] in obtaining an interim interdict against this decision, but the Court of Session withdrew the interdict in January, and it was then stated that a civil court had no jurisdiction in the matter."
                                            },
                                            {
                                                "example_id": "f263f960-9650-42a8-865a-2e99e4457cd0",
                                                "sense_id": "0f52b630-5017-3162-9c12-c3c046c2ac8d",
                                                "text": "The Appeal Division of the Social Security Tribunal held that it was without jurisdiction to extend the statutorily established one-year time limit for a complainant to apply to rescind or amend a decision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5edc2d0-43e8-37a1-a070-a3b67b8b4542",
                                        "entry_id": "512ff3c8-398a-3919-9967-ce5c3fb8d072",
                                        "glosses": [
                                            "The authority of a sovereign power to govern or legislate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cdf3734-165a-4251-931f-52ae79715a18",
                                                "sense_id": "d5edc2d0-43e8-37a1-a070-a3b67b8b4542",
                                                "text": "Thus fell that glorious Minion of Edward the Second, who for a time appeared liked [sic.] a blazing Comet, and sway'd the jurisdiction of the state of England, and her Confederates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14f44eaf-8208-30f9-8f54-842f6538fbe1",
                                        "entry_id": "512ff3c8-398a-3919-9967-ce5c3fb8d072",
                                        "glosses": [
                                            "The limits or territory within which authority may be exercised."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef63b340-353d-4e6b-ba08-339f4d6c54b9",
                                                "sense_id": "14f44eaf-8208-30f9-8f54-842f6538fbe1",
                                                "text": "The ability to shift profits to low-tax countries by locating intellectual property in them[…]is often assumed to be the preserve of high-tech companies.[…]current tax rules make it easy for all sorts of firms to generate[…]“stateless income”: profit subject to tax in a jurisdiction that is neither the location of the factors of production that generate the income nor where the parent firm is domiciled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8ef8c4f-2a21-4128-8352-6cd70b5380b6",
                        "source_entry_id": "78b7b0cc-dede-3e87-8e59-0e8666778aa2",
                        "source_sense_id": "e2e68c05-9c72-323d-8573-6dacb60e4ce3",
