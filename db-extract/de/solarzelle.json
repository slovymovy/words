                                "target_senses": [
                                    {
                                        "sense_id": "ccbdf76a-0c47-3090-bdba-6a78d6346a73",
                                        "entry_id": "eb2c26d0-6b53-39b5-94d7-aa20140bee8b",
                                        "glosses": [
                                            "A semiconductor device that converts the radiant energy of sunlight into electrical energy"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21c8eb03-a6d9-40ab-9156-010c015fa438",
                        "source_entry_id": "e621b005-d9fe-3e0b-9d67-e7ebe431dbad",
                        "source_sense_id": "ea2ec105-f384-3cfc-9543-5589547f26ab",
                        "target_lang_word": "photopile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photopile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "320be79b-07db-3509-865a-11e8e40fcfdf",
                                        "entry_id": "6dabc70c-7334-381b-a14a-629d98ee860a",
                                        "glosses": [
                                            "Appareil transformant un rayonnement lumineux en électricité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d784c9eb-9828-45e6-9c60-452a68ec61c5",
                                                "sense_id": "320be79b-07db-3509-865a-11e8e40fcfdf",
                                                "text": "Avec sa centrale de photopiles, réparties en antennes brillantes de plusieurs centaines de mètres carrés de surface utile, le satellite représentait le sommet de la technique spatiale humaine et contrôlait à lui seul la faune de tout l’hémisphère Ouest."
                                            },
                                            {
                                                "example_id": "3a4dc1f6-2207-4a5c-b6f5-b57da8eff29a",
                                                "sense_id": "320be79b-07db-3509-865a-11e8e40fcfdf",
                                                "text": "Les photopiles sont couramment utilisées pour actionner des relais mettant en marche un système lorsque se trouve intercepté un faisceau lumineux atteignant l’appareil (mise en marche automatique d’escaliers mécaniques, de portes, d’un signal d’alarme, d’appareils de comptage)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f62a597f-c416-3aa4-a353-36f3ddee7530",
                                        "entry_id": "6dabc70c-7334-381b-a14a-629d98ee860a",
                                        "glosses": [
                                            "Organe qui transforme la lumière en signal électrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb8927bc-f1fc-4ea2-aa70-1ede6b5e1233",
                                                "sense_id": "f62a597f-c416-3aa4-a353-36f3ddee7530",
                                                "text": "La vitamine A est une vitamine importante pour la vision, grâce à ses différentes formes (rétinol/rétinal all-trans/9-cis/11-cis ; correspondant à une isomérie de la chaîne isoprénique) aussi appelés vitamères, elle intervient pour former une photopile dans les cellules nerveuses de l’œil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
