                        "sense_id": "1d6fb2ea-0d41-3b7f-8d0f-02acf10af49f",
                        "entry_id": "69a20ae7-32b6-3d81-be8b-32f5bd50313c",
                        "glosses": [
                            "Objet pour geek."
