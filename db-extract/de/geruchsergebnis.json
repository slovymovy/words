                "senses": [
                    {
                        "sense_id": "dd97331e-b3c1-39cc-9aa9-b1c62c1afd96",
                        "entry_id": "bda73fe2-ec13-35f9-98de-ea4643102ad5",
                        "glosses": [
                            "das, was bei dem Vorgang Riechen herauskommt; verbale Bewertung von Geruchsstoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cf2c263-4fda-4238-b197-273320686290",
                                "sense_id": "dd97331e-b3c1-39cc-9aa9-b1c62c1afd96",
                                "text": "„Um ein Urteil fällen zu können, kombinieren Sie jetzt Ihr Geruchsergebnis mit dem Geschmackserlebnis und Sie kommen auf Beschreibungen wie z.B. mild fruchtig, mittel fruchtig, intensiv fruchtig oder auf individuelle persönliche Beschreibungen.“"
                            },
                            {
                                "example_id": "7f7b97dd-2c97-4909-affb-ac8434466f07",
                                "sense_id": "dd97331e-b3c1-39cc-9aa9-b1c62c1afd96",
                                "text": "„Für die Diagnose ist vor allem ein feines Näschen gefragt; das Geruchsergebnis wird mit Hilfe der Rosenberg-Skala beurteilt.“"
                            },
                            {
                                "example_id": "a2c5f9f6-2920-4261-9dd2-1c73c580962c",
                                "sense_id": "dd97331e-b3c1-39cc-9aa9-b1c62c1afd96",
                                "text": "„Wobei man jeder Gruppe nur einen Zucker und ein Paar unterschiedliche Aminosäuren hinstellen müsste und die Geruchsergebnisse aus den unterschiedlichen Kombinationen können die Schüler selber festhalten.“"
                            },
                            {
                                "example_id": "cf790247-aa86-4271-a700-a3caf881a3ac",
                                "sense_id": "dd97331e-b3c1-39cc-9aa9-b1c62c1afd96",
                                "text": "„Aus der Zusammensetzung liefert die elektronische Nase Geruchsergebnisse.“"
                            },
                            {
                                "example_id": "aac1962f-5ceb-4fc4-8548-d2162e481914",
                                "sense_id": "dd97331e-b3c1-39cc-9aa9-b1c62c1afd96",
                                "text": "„Die Touren durch die Adalbertstraße, die vom Kottbusser Tor nach Norden führt, brachte den Forschern als Geruchsergebnis Hundehaufen und Döner ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
