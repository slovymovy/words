                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "536feb08-9ef7-45bd-9dc8-373acdc85e3c",
                                                "sense_id": "2d867b18-ae84-361b-aeee-6f2ac0cfdd89",
                                                "text": "„Seit sie ein kleines Mädchen war, hatte sie sich mit irrlevanten kleinen Flunkereien in Schwierigkeiten gebracht.“"
                                            }
