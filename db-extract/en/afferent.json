                        "cross_references": [
                            {
                                "target_word": "афферентный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f16760dd-33b8-3f4e-bc72-6a072f82bf00",
                                        "entry_id": "e7a07955-0e08-3e27-915c-b674d47e086e",
                                        "glosses": [
                                            "мед. приносящий, центростремительный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b3d7a98-a895-45b0-bd28-7f8545622277",
                                                "sense_id": "f16760dd-33b8-3f4e-bc72-6a072f82bf00",
                                                "text": "Кроме старых названий, употребляются еще новые — афферентные и эфферентные нервы, т. е. нервы, приносящие и относящие раздражение."
                                            },
                                            {
                                                "example_id": "5c59ab6c-6b14-4302-824a-a2f95cdc0155",
                                                "sense_id": "f16760dd-33b8-3f4e-bc72-6a072f82bf00",
                                                "text": "Однако у млекопитающих верхний мозговой придаток, оказавшись «погребённым» под разросшимися полушариями и мощным черепом, потерял непосредственные афферентные (центростремительные) и эфферентные (центробежные) связи с мозгом и превратился в железу внутренней секреции."
                                            },
                                            {
                                                "example_id": "31441b30-b588-44cd-a1cb-a5a9680fc2fc",
                                                "sense_id": "f16760dd-33b8-3f4e-bc72-6a072f82bf00",
                                                "text": "В нервной цепочке различают три типа нейронов: 1) чувствительный (рецепторный), или афферентный, нейрон; 2) вставочный, или ассоциативный, нейрон; 3) двигательный, или эфферентный, нейрон."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
