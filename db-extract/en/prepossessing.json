                "translations": [
                    {
                        "translation_id": "15dec45b-74a6-4969-9506-4e0e44aed9a6",
                        "source_entry_id": "18a8fa17-1b71-3820-b9d4-02fdf6e9f48a",
                        "source_sense_description": "tending to invite favour; attractive",
                        "target_lang_word": "aangenaam",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aangenaam",
