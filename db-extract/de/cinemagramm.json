                "senses": [
                    {
                        "sense_id": "1de94d0f-660e-3316-bba1-d4835a695e89",
                        "entry_id": "7e862cf3-3002-3e6f-9ae1-f820afebc048",
                        "glosses": [
                            "Standbild, welches eine oft kleine, sich unendlich oft wiederholende Bewegung enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d06e1ff-1305-44c0-bca6-2cf85ebfe90a",
                                "sense_id": "1de94d0f-660e-3316-bba1-d4835a695e89",
                                "text": "\"Ein Cinemagramm ist eine Aufnahme, die auf den ersten Blick wie ein Standbild wirkt – auf den zweiten Blick aber eine mehr oder weniger unauffällige, repetitive Bewegung enthält: Da bewegen sich in einer Landschaftsaufnahme sanft die Grashalme im Wind oder es werden einige Blätter in die Höhe gewirbelt.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b5e4490-58cd-4826-9027-32f0d1469e29",
                        "source_entry_id": "7e862cf3-3002-3e6f-9ae1-f820afebc048",
                        "source_sense_id": "1de94d0f-660e-3316-bba1-d4835a695e89",
                        "source_sense_description": "Standbild, welches eine oft kleine, sich unendlich oft wiederholende Bewegung enthält",
                        "target_lang_word": "cinemagraph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cinemagraph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce1f081c-b1e0-3570-905e-8d274b33288b",
                                        "entry_id": "0d24ae44-f401-3193-9849-58a58b9ae49b",
                                        "glosses": [
                                            "A digital image in which an element or small area is animated, such as in an animated GIF."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd0489bc-8ee2-4945-9f76-af354e50946d",
                                                "sense_id": "ce1f081c-b1e0-3570-905e-8d274b33288b",
                                                "text": "One creative form of advertising that has already created a stir in the Tumblrverse makes use of a new visual medium called a cinemagraph, a still photograph in which a minor and repeated movement occurs."
                                            },
                                            {
                                                "example_id": "5e4b3437-6308-4615-9299-74564d13fcab",
                                                "sense_id": "ce1f081c-b1e0-3570-905e-8d274b33288b",
                                                "text": "The camera will fire 18 JPEGs and then it will provide a preview image with a brush tool that you can use to specify the area that will be animated: depicted as moving in the cinemagraph."
                                            },
                                            {
                                                "example_id": "2d1f6931-27c6-4ac2-acae-1f7bb18549a8",
                                                "sense_id": "ce1f081c-b1e0-3570-905e-8d274b33288b",
                                                "text": "In fact, shooting and editing a cinemagraph can be easy; it is its content that will make it successful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b83934db-9b86-3f27-944e-3cf3851ce5f5",
                                        "entry_id": "0d24ae44-f401-3193-9849-58a58b9ae49b",
                                        "glosses": [
                                            "A movie, especially one from the silent era."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31ff98ae-7f73-4da2-9998-6459e34fd680",
                                                "sense_id": "b83934db-9b86-3f27-944e-3cf3851ce5f5",
                                                "text": "Intermittently might be heard the voice of the “barker” droning his droll catch-phrases, informing the inquisitive populace that for “one dime, ten cents or a tenth part of a dollar,\" they could see “the greatest wonder of the age, the cinemagraph showing -- MOV-ING PIC'-CHURES.\""
                                            },
                                            {
                                                "example_id": "985674cf-3e7c-474e-92ba-632d6c716041",
                                                "sense_id": "b83934db-9b86-3f27-944e-3cf3851ce5f5",
                                                "text": "At the end of each a sign is thrown from the cinemagraph on the canvas announcing that those who came late may stay for the next 'performance.'"
                                            },
                                            {
                                                "example_id": "a008a824-05ea-4ba3-a03a-b22a557d1d4c",
                                                "sense_id": "b83934db-9b86-3f27-944e-3cf3851ce5f5",
                                                "text": "Once they all went to a dance hall called the Rialto which she hadn't liked much, but when they went to the cinemagraph, she'd really enjoyed it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
