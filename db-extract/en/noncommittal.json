                                "example_id": "98fc16db-17fb-478e-a00f-978466b9c93f",
                                "sense_id": "e65f2990-57c1-30e0-a44c-d5ca08ee13fd",
                                "text": "The noncommittal Indians would give no counsel as to fording."
                            },
