{
    "word_family": [
        "pollute",
        "pollutant",
        "polluter",
        "unpolluted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "745af4c5-9c21-3a5c-8afc-7c2bdbf2d08e",
                    "sense_definition": "The process of making the environment dirty or harmful by adding waste, chemicals, noise, or other substances; the state of being dirty or contaminated.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "environmental_contamination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is introducing new laws to reduce air <w>pollution</w> in the city.",
                            "target_lang_translations": {
                                "ru": "Правительство вводит новые законы для снижения <w>загрязнения</w> воздуха в городе.",
                                "zh": "政府正在出台新法律以减少城市中的空气<w>污染</w>。"
                            }
                        },
                        {
                            "text": "Water <w>pollution</w> from the factory has killed many fish in the river.",
                            "target_lang_translations": {
                                "ru": "<w>Загрязнение</w> воды фабрикой привело к гибели множества рыбы в реке.",
                                "zh": "工厂造成的河水<w>污染</w>导致河里许多鱼死亡。"
                            }
                        }
                    ],
                    "antonyms": [
                        "purity"
                    ],
                    "common_phrases": [
                        "air pollution",
                        "water pollution",
                        "noise pollution",
                        "environmental pollution",
                        "light pollution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс загрязнения окружающей среды отходами, химикатами, шумом или другими веществами; состояние загрязненности.",
                        "zh": "指因添加废物、化学物质、噪音或其他物质而使环境变得肮脏或有害的过程；或指被污染的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загрязнение",
                                "target_lang_sense_clarification": "окружающей среды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "污染",
                                "target_lang_sense_clarification": "环境或物质的污染"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a6b64ec-3957-3b81-a7b1-8db8979796e7",
                    "sense_definition": "Moral or spiritual corruption; the state of being morally bad or impure.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "defilement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to protect his children from the moral <w>pollution</w> of the corrupt city.",
                            "target_lang_translations": {
                                "ru": "Он пытался оградить своих детей от моральной <w>скверны</w> порочного города.",
                                "zh": "他试图保护孩子们免受这座腐败城市道德<w>腐化</w>的影响。"
                            }
                        },
                        {
                            "text": "The priest spoke about the <w>pollution</w> of the soul caused by greed and hatred.",
                            "target_lang_translations": {
                                "ru": "Священник говорил об <w>осквернении</w> души, вызванном жадностью и ненавистью.",
                                "zh": "牧师谈到了由贪婪和仇恨引起的灵魂<w>玷污</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "purity"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often found in literary or religious contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Моральное или духовное разложение; состояние порочности или нечистоты.",
                        "zh": "道德或精神上的腐败；指处于道德败坏或不纯洁的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скверна",
                                "target_lang_sense_clarification": "моральная нечистота"
                            },
                            {
                                "target_lang_word": "развращение",
                                "target_lang_sense_clarification": "моральное разложение"
                            },
                            {
                                "target_lang_word": "осквернение",
                                "target_lang_sense_clarification": "души или морали"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腐化",
                                "target_lang_sense_clarification": "道德上的堕落"
                            },
                            {
                                "target_lang_word": "玷污",
                                "target_lang_sense_clarification": "指精神或名誉受损"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cf579dc-06df-30c6-83be-cc50af5989c8",
                    "sense_definition": "The act of disrespecting or damaging something holy or sacred.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "defilement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers were shocked by the <w>pollution</w> of their ancient temple by the invaders.",
                            "target_lang_translations": {
                                "ru": "Жители деревни были потрясены <w>осквернением</w> их древнего храма захватчиками.",
                                "zh": "村民们对入侵者<w>亵渎</w>他们古老寺庙的行为感到震惊。"
                            }
                        },
                        {
                            "text": "They considered the presence of weapons in the shrine to be a <w>pollution</w> of the sacred space.",
                            "target_lang_translations": {
                                "ru": "Они считали присутствие оружия в святилище <w>осквернением</w> священного пространства.",
                                "zh": "他们认为在圣殿中携带武器是对神圣空间的<w>亵渎</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "purity"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly literary or historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт неуважения или нанесения ущерба чему-либо святому или священному.",
                        "zh": "对神圣事物不尊重或造成损害的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осквернение",
                                "target_lang_sense_clarification": "святыни"
                            },
                            {
                                "target_lang_word": "поругание",
                                "target_lang_sense_clarification": "священного места"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亵渎",
                                "target_lang_sense_clarification": "对神圣事物的冒犯"
                            },
                            {
                                "target_lang_word": "玷污",
                                "target_lang_sense_clarification": "对圣洁之地的破坏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b40e7ba-bc09-3b4c-8d59-d17334e5fc73",
                    "sense_definition": "The involuntary release of semen, usually occurring during sleep.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In older medical texts, a wet dream was often referred to as nocturnal <w>pollution</w>.",
                            "target_lang_translations": {
                                "ru": "В старых медицинских текстах эротические сны часто назывались ночной <w>поллюцией</w>.",
                                "zh": "在旧时的医学文献中，梦遗常被称为夜间<w>遗精</w>。"
                            }
                        },
                        {
                            "text": "The doctor explained that <w>pollution</w> during sleep is a natural biological function.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что <w>поллюция</w> во время сна — это естественная биологическая функция.",
                                "zh": "医生解释说，睡眠中的<w>遗精</w>是一种自然的生理功能。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nocturnal pollution"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern English uses 'nocturnal emission' or 'wet dream'"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "medical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Непроизвольное семяизвержение, обычно происходящее во время сна.",
                        "zh": "指非自愿的精液排出，通常发生在睡眠期间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поллюция",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遗精",
                                "target_lang_sense_clarification": "医学术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}