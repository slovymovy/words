                "senses": [
                    {
                        "sense_id": "b9ce9d1a-7c2b-3dcd-aa24-8663e155fa65",
                        "entry_id": "6a9562c8-413a-34fd-b0ea-378335311c6b",
                        "glosses": [
                            "Responsabiliser en même temps (plusieurs personnes)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcd25898-d4ca-46f6-ae55-06804bca7271",
                                "sense_id": "b9ce9d1a-7c2b-3dcd-aa24-8663e155fa65",
                                "text": "Il est important pour éviter ces écueils de coresponsabiliser l’employée et l’employeur aux enjeux de la maternité et d’utiliser des outils de planification et de négociation avant, pendant et après le congé maternité pour mitiger le risque d’une rupture de contrat."
                            },
                            {
                                "example_id": "1c44f719-5852-47fe-bea2-66b56515ea7f",
                                "sense_id": "b9ce9d1a-7c2b-3dcd-aa24-8663e155fa65",
                                "text": "Les élites doivent s’engager et se coresponsabiliser pour la coopération."
                            }
                        ]
                    }
