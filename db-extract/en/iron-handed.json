                "senses": [
                    {
                        "sense_id": "bd760ab1-ccc9-346b-b9de-b9a2a7048a1c",
                        "entry_id": "7ac1991a-3930-3556-8132-555808f16c46",
                        "glosses": [
                            "Strict and dictatorial, exercising firm ruthless control."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "78591575-4558-4a6e-801a-1017f510ff0a",
                                "sense_id": "bd760ab1-ccc9-346b-b9de-b9a2a7048a1c",
                                "text": "Here I am not primarily concerned with the long-term effects of such separation, about which the advocates of iron-handed rule in Poland have always written with great glee."
                            },
                            {
                                "example_id": "ca106138-16cb-4d6b-9798-395f0d7e8ae1",
                                "sense_id": "bd760ab1-ccc9-346b-b9de-b9a2a7048a1c",
                                "text": "I couldn't believe that iron-handed old tyrant would have a son waho cared for nothing but praying."
                            },
                            {
                                "example_id": "49d44751-5733-43e9-86a0-71e854fb949b",
                                "sense_id": "bd760ab1-ccc9-346b-b9de-b9a2a7048a1c",
                                "text": "Celebration of the strong, powerful, bold, victorious, and iron-handed is presented as much more in tune with human nature, just as praise for the weak, feeble, humble, vanquished, and poor in spirit results from a foolish ignorance of true human desires."
                            }
                        ]
                    }
