                ],
                "translations": [
                    {
                        "translation_id": "032a1417-8c22-4281-a2c1-4d4de1fd90b7",
                        "source_entry_id": "85eb19c5-45ee-3b68-a4a5-e466c4038a18",
                        "source_sense_id": "5e6b2c63-32a2-31c4-86cd-44012e49f50f",
                        "target_lang_word": "substitute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "substitute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "298043c2-b849-32de-ada5-c9e6b5fd0a5d",
                                        "entry_id": "6254b6d9-8901-3805-b6c6-971f43517d94",
                                        "glosses": [
                                            "To use in place of something else, with the same function."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0296dbd-c566-4d4e-83ac-e990a9ca0c89",
                                                "sense_id": "298043c2-b849-32de-ada5-c9e6b5fd0a5d",
                                                "text": "I had no shallots so I substituted onion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "163f1c81-fd6e-3b5c-bdd9-412a541da3c9",
                                        "entry_id": "6254b6d9-8901-3805-b6c6-971f43517d94",
                                        "glosses": [
                                            "To use X in place of Y."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "408f12f9-da0f-4ae8-84df-1b43f8fc0369",
                                                "sense_id": "163f1c81-fd6e-3b5c-bdd9-412a541da3c9",
                                                "text": "I had to substitute new parts for the old ones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa0b57b-c0ee-301f-a3d4-d464866ab8ba",
                                        "entry_id": "6254b6d9-8901-3805-b6c6-971f43517d94",
                                        "glosses": [
                                            "To use Y in place of X; to replace X with Y."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f1a2077-57b7-44b8-9eac-2a493958d7ec",
                                                "sense_id": "3fa0b57b-c0ee-301f-a3d4-d464866ab8ba",
                                                "text": "I had to substitute old parts with the new ones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe67648-05ca-3ecd-a758-ef0d1b08be98",
                                        "entry_id": "6254b6d9-8901-3805-b6c6-971f43517d94",
                                        "glosses": [
                                            "To remove (a player) from the field of play and bring on another in his place."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3232c03f-0386-4b5b-9d12-cc9180255a63",
                                                "sense_id": "dfe67648-05ca-3ecd-a758-ef0d1b08be98",
                                                "text": "He was playing poorly and was substituted after twenty minutes"
                                            },
                                            {
                                                "example_id": "44ed6f22-efe4-4225-ba0d-526c3cc2f015",
                                                "sense_id": "dfe67648-05ca-3ecd-a758-ef0d1b08be98",
                                                "text": "Mario Balotelli replaced Tevez but his contribution was so negligible that he suffered the indignity of being substituted himself as time ran out, a development that encapsulated a wretched 90 minutes for City and boss Roberto Mancini."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d09ed6dc-468f-3819-947a-62b845061f8c",
                                        "entry_id": "6254b6d9-8901-3805-b6c6-971f43517d94",
                                        "glosses": [
                                            "To serve as a replacement (for someone or something)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbe7ebc2-4e55-4e7f-a513-e77eb0405324",
                                                "sense_id": "d09ed6dc-468f-3819-947a-62b845061f8c",
                                                "text": "Accumulation of wealth by this route may substitute for personal saving."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "substitute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "887ff48c-8c17-3d8f-afe8-d86ffd680b33",
                                        "entry_id": "13f1509a-7830-36af-9c30-e9b988f5df89",
                                        "glosses": [
                                            "A replacement or stand-in for something that achieves a similar result or purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bbf6f68-321d-4659-b2c7-41354313ca09",
                                                "sense_id": "887ff48c-8c17-3d8f-afe8-d86ffd680b33",
                                                "text": "Ladies [in William Shakespeare's age], again, universally wore masks as the sole substitute known to our ancestors for the modern parasol; a fact, perhaps, not generally known."
                                            },
                                            {
                                                "example_id": "571caae1-258d-490e-89b3-0562ba786135",
                                                "sense_id": "887ff48c-8c17-3d8f-afe8-d86ffd680b33",
                                                "text": "Since you left me, if you see me with another girl / Seeming like I'm having fun / Although she may be cute, she's just a substitute / Because you're the permanent one"
                                            },
                                            {
                                                "example_id": "ab25465e-a6ee-4e3e-9903-cddee0aa4243",
                                                "sense_id": "887ff48c-8c17-3d8f-afe8-d86ffd680b33",
                                                "text": "Here we go. AK-47. The very best there is. When you absolutely, positively got to kill every motherfucker in the room, accept no substitutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9615f433-6662-3f0d-8c7a-0eb4d1968953",
                                        "entry_id": "13f1509a-7830-36af-9c30-e9b988f5df89",
                                        "glosses": [
                                            "A substitute teacher."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4046c72a-3a1c-3142-9243-c2d8c3b9b71d",
                                        "entry_id": "13f1509a-7830-36af-9c30-e9b988f5df89",
                                        "glosses": [
                                            "A player who is available to replace another if the need arises, and who may or may not actually do so."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d32439e-ec74-4fab-9f0b-a5bbf89c6950",
                                                "sense_id": "4046c72a-3a1c-3142-9243-c2d8c3b9b71d",
                                                "text": "Dean Whitehead opened the scoring shortly after the break with a low finish and substitute Peter Crouch sealed the win with a tap-in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37b8883-d79f-3d15-93b6-28b76ebf53f7",
                                        "entry_id": "13f1509a-7830-36af-9c30-e9b988f5df89",
                                        "glosses": [
                                            "One who enlists for military service in the place of a conscript."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75d1aca0-aeac-3851-b7bf-38d9d47b6896",
                                        "entry_id": "13f1509a-7830-36af-9c30-e9b988f5df89",
                                        "glosses": [
                                            "Abbreviation of substitute good."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
