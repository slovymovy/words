        "fr-extract.jsonl": [
            {
                "entry_id": "0c9325f5-2994-3399-8b3a-235f361ba47b",
                "word": "satinette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6222268b-e625-4713-81e3-dbf78dbb26bf",
                        "entry_id": "0c9325f5-2994-3399-8b3a-235f361ba47b",
                        "tags": [
                            "plural"
                        ],
                        "form": "satinettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "efc97f9c-eb57-3244-a200-1acb9b9d9d83",
                        "entry_id": "0c9325f5-2994-3399-8b3a-235f361ba47b",
                        "glosses": [
                            "Étoffe où il entre du coton et qui imite le satin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0133c332-1340-4026-a7c7-e4403f9dbf6c",
                                "sense_id": "efc97f9c-eb57-3244-a200-1acb9b9d9d83",
                                "text": "Une seule boutique restait fermée. On avait enlevé simplement le volet de la porte et écarté à l’intérieur le rideau de satinette rose."
                            },
                            {
                                "example_id": "9894a904-85b7-4fe8-b8b7-2e857bad9df0",
                                "sense_id": "efc97f9c-eb57-3244-a200-1acb9b9d9d83",
                                "text": "« Ernest, tu n’oublieras pas de dire à Marie que j’ai pris pour la petite un mètre et demi d’une espèce de satinette, qu’elle m’envoie son vieux tablier, j’aime mieux ça que des mesures… »"
                            },
                            {
                                "example_id": "b9d5ff73-a6e8-4bf7-9cd5-eb1d81389baf",
                                "sense_id": "efc97f9c-eb57-3244-a200-1acb9b9d9d83",
                                "text": "Ma mère est debout, découragée, devant la fenêtre. Elle porte sa « robe de maison » en satinette à pois, sa broche d’argent qui représente deux anges penchés sur un portrait d’enfant, ses lunettes au bout d’une chaîne et son lorgnon au bout d’un cordonnet de soie noire, accroché à toutes les clés de porte, rompu à toutes les poignées de tiroir et renoué vingt fois."
                            },
                            {
                                "example_id": "da10d762-f7d2-461c-91bb-7c274ac9044b",
                                "sense_id": "efc97f9c-eb57-3244-a200-1acb9b9d9d83",
                                "text": "1ᵉʳ octobre 1940 – Le Tout-Paris s’est rencontré chez les marchands de tissu pour s’arracher la satinette noire, car il faudra désormais camoufler totalement ses lumières."
                            },
                            {
                                "example_id": "fc166ca0-77a0-4ce1-9020-c1423921c213",
                                "sense_id": "efc97f9c-eb57-3244-a200-1acb9b9d9d83",
                                "text": "Lorsque l’on entrait dans la mercerie d’autrefois, la bonne odeur de la satinette vous montait aux narines, magnifiée encore par l’arôme du café qui se glissait par la porte de la cuisine toujours entrouverte […]"
                            },
                            {
                                "example_id": "622e7999-5e40-4dab-94d8-6504841fb544",
                                "sense_id": "efc97f9c-eb57-3244-a200-1acb9b9d9d83",
                                "text": "La boutique est un long couloir ; au fond se dresse le comptoir. Dans le renfoncement qui lui succède, deux petites vieilles sont assises, l’une vêtue de satinette fermière, un chapeau de paille rubané sur les genoux, l’autre en tablier bleu, très écolière d’autrefois."
                            },
                            {
                                "example_id": "2ddf741e-2185-4273-864f-d8256af2d04c",
                                "sense_id": "efc97f9c-eb57-3244-a200-1acb9b9d9d83",
                                "text": "Les civils doivent aveugler toutes leurs fenêtre en les recouvrant de satinette noire, ou d’un coup de peinture, afin d’éviter le signalement des villes aux avions alliés."
                            }
                        ]
                    }
                ],
