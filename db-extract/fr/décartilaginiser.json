                "senses": [
                    {
                        "sense_id": "c1ce12e7-3f0e-3c14-b6ba-b9a13d13f3ab",
                        "entry_id": "becae536-5089-33a5-9bbb-6cfb9cca7bc5",
                        "glosses": [
                            "Extraire le cartilage, en dégarnir les parties osseuses du squelette par des moyens chirurgicaux ou physico-chimiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dac3a5b4-4cf8-4550-bdb3-05f9b16a7bdd",
                                "sense_id": "c1ce12e7-3f0e-3c14-b6ba-b9a13d13f3ab",
                                "text": "Les actions chimiques intra-buccales ne semblent pas davantage devoir être exclues, — bien qu’expérimentalement on n’ait pu réussir à décartilaginiser les dents."
                            },
                            {
                                "example_id": "d7ffe1af-806a-4451-92a8-24f3d3094956",
                                "sense_id": "c1ce12e7-3f0e-3c14-b6ba-b9a13d13f3ab",
                                "text": "L’incision externe de Bœckel associée à une ténotomie préalable du tendon d’Achille permet très bien de « décartilaginiser » les surfaces osseuses en contact avec astragale et mortaise tibio-tarsienne."
                            }
                        ]
                    }
