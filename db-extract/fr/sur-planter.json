                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b980e4e5-66df-42bd-a9b9-f54ca3c7c8ad",
                                "sense_id": "fdf6c58d-7ba4-3a52-8bbb-ccc71cf7d2ce",
                                "text": "Sur-filtrer, sur-planter et accentuer les changements d'eau aide."
                            },
                            {
                                "example_id": "e5bcf30c-46d5-421c-8e92-bb0134e69212",
                                "sense_id": "fdf6c58d-7ba4-3a52-8bbb-ccc71cf7d2ce",
                                "text": "Moi j'ai un peu tendance à sur-planter mes bacs, mais j'aime ça et mes Bettas ne s'en plaignent pas"
                            },
                            {
                                "example_id": "634bc9a0-7873-49b7-b5ed-09296a09133c",
                                "sense_id": "fdf6c58d-7ba4-3a52-8bbb-ccc71cf7d2ce",
                                "text": "Un an après, pour le second bac (240l) j’ai choisi l’option \"sur-planter\" (quasiment pas d’espace vide au sol) dès la mise en eau."
                            }
                        ]
