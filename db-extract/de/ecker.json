                        "entry_id": "09956a6e-f0eb-3879-b7a7-0f4352f5789b",
                        "glosses": [
                            "Nussfrucht eines Baumes, speziell von Buche und Eiche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "840240d2-0279-4db8-9bf5-f9100960dc45",
                                "sense_id": "9d499529-fa05-32fd-b7e1-62c4c99eca3c",
                                "text": "Gerade war noch Frühling, und nun sind schon wieder die Eckern reif."
