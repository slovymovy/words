                "senses": [
                    {
                        "sense_id": "c6c6c778-d5fc-3419-b114-85d3a939ce3c",
                        "entry_id": "028d73f5-bb5c-3912-8b7f-5eaef28cd660",
                        "glosses": [
                            "с кем, о чём в процессе переговоров приходить к соглашению"
                        ],
                        "tags": [],
