                "senses": [
                    {
                        "sense_id": "dfddde4a-3c90-36f4-9f1e-e77657a69345",
                        "entry_id": "e0a8df96-1f4f-3e88-88ce-29b9dededdfb",
                        "glosses": [
                            "Pflanze, deren große Blätter und weiße oder gelben Blüten auf der Wasseroberfläche schwimmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8147e1f-7aab-41c0-b049-85bdafd4c247",
                                "sense_id": "dfddde4a-3c90-36f4-9f1e-e77657a69345",
                                "text": "„Die Nymphäa [nymphäa] soll aus einer Nymphe entstanden sein, welche aus eifersüchtiger Liebe zum Herkules starb, weswegen die Pflanze auch Herakleios heißt.“"
                            },
                            {
                                "example_id": "60db3e52-1588-43aa-b281-d1758303c7c0",
                                "sense_id": "dfddde4a-3c90-36f4-9f1e-e77657a69345",
                                "text": "„Wie man sagt, ist kürzlich eine Nymphäa entdeckt worden, welche durch die untere Fläche der Blätter athmet, die sich rückwärts drehen um die kleinen Oeffnungen oder Stomata der Luft auszusetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
