{
    "word_family": [
        "stomachache",
        "stomacher",
        "stomachful"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9eb3cccc-21cc-3cb5-8d6d-54994edd1b1e",
                    "sense_definition": "An internal organ in the body where food is digested.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomy_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>stomach</w> started to hurt after I ate too much candy.",
                            "target_lang_translations": {
                                "ru": "У меня разболелся <w>живот</w> после того, как я съел слишком много конфет.",
                                "zh": "我吃了太多糖果后，<w>胃</w>就开始疼了。"
                            }
                        },
                        {
                            "text": "The doctor pressed gently on her <w>stomach</w> to check for pain.",
                            "target_lang_translations": {
                                "ru": "Врач мягко надавил ей на <w>живот</w>, чтобы проверить, где болит.",
                                "zh": "医生轻轻按压她的<w>肚子</w>来检查哪里疼痛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abdomen",
                        "belly",
                        "tummy"
                    ],
                    "common_phrases": [
                        "upset stomach",
                        "empty stomach",
                        "stomach cancer",
                        "stomach ache"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренний орган тела, в котором переваривается пища.",
                        "zh": "人体内消化食物的器官。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желудок",
                                "target_lang_sense_clarification": "анатомический орган"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胃",
                                "target_lang_sense_clarification": "解剖学上的消化器官"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c60ebf33-2270-3a97-b8b3-4009517d8316",
                    "sense_definition": "The front part of the body between the chest and the hips; the belly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anatomy_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was lying on his <w>stomach</w> while reading a book on the floor.",
                            "target_lang_translations": {
                                "ru": "Он лежал на <w>животе</w>, читая книгу на полу.",
                                "zh": "他<w>趴</w>在地上看书。"
                            }
                        },
                        {
                            "text": "She patted her flat <w>stomach</w> after finishing the workout.",
                            "target_lang_translations": {
                                "ru": "Она похлопала себя по плоскому <w>животу</w> после окончания тренировки.",
                                "zh": "锻炼结束后，她拍了拍自己平坦的<w>肚子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "belly",
                        "tummy",
                        "abdomen"
                    ],
                    "common_phrases": [
                        "lie on one's stomach",
                        "flat stomach",
                        "pit of the stomach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передняя часть тела между грудью и бедрами; живот.",
                        "zh": "身体胸部和臀部之间的前部；腹部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "живот",
                                "target_lang_sense_clarification": "часть тела"
                            },
                            {
                                "target_lang_word": "пузо",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "брюхо",
                                "target_lang_sense_clarification": "грубое или о животных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肚子",
                                "target_lang_sense_clarification": "身体部位"
                            },
                            {
                                "target_lang_word": "腹部",
                                "target_lang_sense_clarification": "较正式的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ac5176a-421e-36f7-a59d-46624c55d891",
                    "sense_definition": "The desire, courage, or determination to do something difficult or unpleasant.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have no <w>stomach</w> for a fight right now, so please leave me alone.",
                            "target_lang_translations": {
                                "ru": "У меня сейчас нет <w>желания</w> драться, так что, пожалуйста, оставь меня в покое.",
                                "zh": "我现在没<w>心情</w>吵架，所以请让我一个人待着。"
                            }
                        },
                        {
                            "text": "You need a strong <w>stomach</w> to watch horror movies with so much blood.",
                            "target_lang_translations": {
                                "ru": "Нужен крепкий <w>желудок</w>, чтобы смотреть фильмы ужасов с таким количеством крови.",
                                "zh": "看这种血腥的恐怖片，你需要有很强的<w>心理承受力</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "guts"
                    ],
                    "common_phrases": [
                        "have no stomach for",
                        "strong stomach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Желание, смелость или решимость сделать что-то трудное или неприятное.",
                        "zh": "做某事所需的勇气、决心或意愿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смелость",
                                "target_lang_sense_clarification": "храбрость"
                            },
                            {
                                "target_lang_word": "дух",
                                "target_lang_sense_clarification": "моральная сила"
                            },
                            {
                                "target_lang_word": "желание",
                                "target_lang_sense_clarification": "настроение что-то делать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勇气",
                                "target_lang_sense_clarification": "胆量"
                            },
                            {
                                "target_lang_word": "意愿",
                                "target_lang_sense_clarification": "做某事的心理准备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d2e38fa-7155-3729-b3b3-dd044f5e5408",
                    "sense_definition": "Appetite or desire for food.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long walk, he had a very good <w>stomach</w> for roast beef.",
                            "target_lang_translations": {
                                "ru": "После долгой прогулки у него был отличный <w>аппетит</w> к ростбифу.",
                                "zh": "长途跋涉后，他对烤牛肉很有<w>胃口</w>。"
                            }
                        },
                        {
                            "text": "The illness left him with little <w>stomach</w> for even his favorite meals.",
                            "target_lang_translations": {
                                "ru": "Из-за болезни у него почти не осталось <w>аппетита</w> даже к любимым блюдам.",
                                "zh": "生病让他连最喜欢的食物都没什么<w>胃口</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Modern usage prefers 'appetite'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аппетит или желание поесть.",
                        "zh": "食欲或进食的欲望。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аппетит",
                                "target_lang_sense_clarification": "желание еды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胃口",
                                "target_lang_sense_clarification": "食欲"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0911dc8-6c61-367d-a651-386e9821940f",
                    "sense_definition": "Pride, haughtiness, or arrogance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a man of unbounded <w>stomach</w>, always ranking himself with princes.",
                            "target_lang_translations": {
                                "ru": "Это был человек непомерной <w>гордыни</w>, всегда ставивший себя в один ряд с принцами.",
                                "zh": "他是个极其<w>傲慢</w>的人，总把自己和王子相提并论。"
                            }
                        },
                        {
                            "text": "Her high <w>stomach</w> would not allow her to apologize for the mistake.",
                            "target_lang_translations": {
                                "ru": "Ее <w>высокомерие</w> не позволяло ей извиниться за ошибку.",
                                "zh": "她的<w>自负</w>让她无法为自己的错误道歉。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гордость, высокомерие или надменность.",
                        "zh": "傲慢、自大或狂妄。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокомерие",
                                "target_lang_sense_clarification": "надменность"
                            },
                            {
                                "target_lang_word": "гордыня",
                                "target_lang_sense_clarification": "чрезмерная гордость"
                            },
                            {
                                "target_lang_word": "спесь",
                                "target_lang_sense_clarification": "устаревшее/книжное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "傲慢",
                                "target_lang_sense_clarification": "自大"
                            },
                            {
                                "target_lang_word": "自负",
                                "target_lang_sense_clarification": "过高估计自己"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb98ad3d-ad90-3ddd-977c-e8cff8bed5e9",
                    "sense_definition": "To accept or be able to endure something unpleasant, difficult, or offensive.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "tolerate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I simply cannot <w>stomach</w> his rude behavior during meetings anymore.",
                            "target_lang_translations": {
                                "ru": "Я просто больше не могу <w>переваривать</w> его грубое поведение на собраниях.",
                                "zh": "我实在无法<w>忍受</w>他在会议期间的粗鲁行为了。"
                            }
                        },
                        {
                            "text": "She found it hard to <w>stomach</w> the fact that she had been lied to.",
                            "target_lang_translations": {
                                "ru": "Ей было трудно <w>переварить</w> тот факт, что ей лгали.",
                                "zh": "她发现自己很难<w>接受</w>被欺骗的事实。"
                            }
                        }
                    ],
                    "synonyms": [
                        "put up with",
                        "brook"
                    ],
                    "common_phrases": [
                        "cannot stomach",
                        "hard to stomach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать или быть способным вынести что-то неприятное, трудное или оскорбительное.",
                        "zh": "能够忍受或接受令人不快、困难或冒犯的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переваривать",
                                "target_lang_sense_clarification": "разговорное, перен."
                            },
                            {
                                "target_lang_word": "выносить",
                                "target_lang_sense_clarification": "терпеть"
                            },
                            {
                                "target_lang_word": "терпеть",
                                "target_lang_sense_clarification": "мириться с чем-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忍受",
                                "target_lang_sense_clarification": "容忍"
                            },
                            {
                                "target_lang_word": "受得了",
                                "target_lang_sense_clarification": "能够承受"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}