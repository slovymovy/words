                                        "entry_id": "6db56bb3-8c82-33b0-9ef3-b231f9a660fb",
                                        "glosses": [
                                            "An estimate, judgment or opinion made by guessing, from limited information."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddf88100-b417-4ed8-b09b-be808134188e",
                                                "sense_id": "df939818-d5cb-328c-bb02-c857df469139",
                                                "text": "By a careful study of the figure we might suspect that when the rectangle becomes a square its area would be the greatest, but this would at best be mere guesswork. A better way would evidently be to plot the graph of the function (1) and note its behavior."
                                            }
