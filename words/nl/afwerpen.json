                    "sense_id": "98f4ca14-b6f7-308f-b224-eba0adc034a9",
                    "sense_definition": "winst, voordeel of resultaat opleveren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opleveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het werk van de brandweer lijkt eindelijk zijn vruchten <w>af</w> te <w>werpen</w>.",
                            "target_lang_translations": {
                                "en": "The work of the fire brigade finally seems to be <w>bearing</w> fruit."
                            }
                        },
                        {
                            "text": "Deze nieuwe investering zal op de lange termijn zeker winst <w>afwerpen</w>.",
                            "target_lang_translations": {
                                "en": "This new investment will certainly <w>yield</w> a profit in the long run."
                            }
                        }
                    ],
                    "synonyms": [
