                                    {
                                        "sense_id": "164c6b86-6a7d-32d3-8f18-f62ec9fc9df6",
                                        "entry_id": "f286f9c8-900b-3220-aed6-e12cecc68970",
                                        "glosses": [
                                            "Variante de kapo"
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d66fdac7-8498-45fa-996c-fea2cb9cb063",
                                                "sense_id": "164c6b86-6a7d-32d3-8f18-f62ec9fc9df6",
                                                "text": "D’abord l’administrateur du camping… on ne sait pas où ils sont allés le chercher, c’était plutôt un capo de camps allemands que le gérant d’un endroit pour le plaisir des gens chics."
                                            },
                                            {
                                                "example_id": "62a42fd0-6920-462b-a851-e062f2e9cd5d",
                                                "sense_id": "164c6b86-6a7d-32d3-8f18-f62ec9fc9df6",
                                                "text": "Les six SS ayant repris leur mitraillette se trouvaient à bonne distance. Le capo faisait, rang par rang, une reconnaissance."
                                            }
                                        ]
                                    }
                                ]
                            }
