    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e6c0aea-cb13-365f-b408-aa758aa3c47c",
                    "sense_definition": "het verwijderen van de peulenschillen van erwten, bonen, enzovoort",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "peulen_schoonmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De een <w>dopte</w> boontjes, de ander schilde aardappelen.",
                            "target_lang_translations": {
                                "en": "One was <w>shelling</w> beans, the other was peeling potatoes.",
                                "de": "Einer <w>enthülste</w> Böhnchen, der andere schälte Kartoffeln."
                            }
                        },
                        {
                            "text": "We moeten vanavond een hele emmer erwten <w>doppen</w> voor de soep.",
                            "target_lang_translations": {
                                "en": "We have to <w>shell</w> a whole bucket of peas tonight for the soup.",
                                "de": "Wir müssen heute Abend einen ganzen Eimer Erbsen für die Suppe <w>auspalen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pellen"
                    ],
                    "common_phrases": [
                        "boontjes doppen"
                    ],
                    "target_lang_definitions": {
                        "en": "removing the pods or shells from peas, beans, etc.",
                        "de": "das Entfernen der Hülsen von Erbsen, Bohnen usw."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shell",
                                "target_lang_sense_clarification": "to remove the outer covering of peas or beans"
                            },
                            {
                                "target_lang_word": "pod",
                                "target_lang_sense_clarification": "to remove peas or beans from their pods"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "enthülsen",
                                "target_lang_sense_clarification": "von der Fruchthülle befreien"
                            },
                            {
                                "target_lang_word": "pulen",
                                "target_lang_sense_clarification": "umgangssprachlich für Erbsen oder Bohnen auspalen/aus der Schale lösen"
                            },
                            {
                                "target_lang_word": "auspalen",
                                "target_lang_sense_clarification": "Erbsen aus der Hülse brechen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3f2f4cf-aa5d-3d2e-b40e-b213722dcde1",
                    "sense_definition": "het krijgen van een werkloosheidsuitkering omdat je geen betaald werk hebt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitkering_ontvangen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het faillissement van de fabriek moest hij maandenlang <w>doppen</w>.",
                            "target_lang_translations": {
                                "en": "After the factory went bankrupt, he had to <w>be on the dole</w> for months.",
                                "de": "Nach der Insolvenz der Fabrik musste er monatelang <w>stempeln gehen</w>."
                            }
                        },
                        {
                            "text": "Zij weigert te <w>doppen</w> en zoekt elke dag actief naar een nieuwe baan.",
                            "target_lang_translations": {
                                "en": "She refuses to <w>sign on</w> and actively looks for a new job every day.",
                                "de": "Sie weigert sich, <w>stempeln zu gehen</w>, und sucht jeden Tag aktiv nach einer neuen Stelle."
                            }
                        }
                    ],
                    "synonyms": [
                        "stempelen"
                    ],
                    "common_phrases": [
                        "gaan doppen"
                    ],
                    "traits": [
