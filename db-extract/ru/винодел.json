                                        "glosses": [
                                            "weibliche Person, die beruflich Wein an- und ausbaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d51c7ae7-3c64-4a61-b664-296039665789",
                                                "sense_id": "dfa0bde1-98e2-3411-aa5c-b54a88573216",
                                                "text": "„Eine schmucke Winzerin bringt die kräftige Weinbergskost und süßen Wein.“"
