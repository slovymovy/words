                        "glosses": [
                            "Extrêmement réactionnaire."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "4040ebb0-79b9-4577-8293-e65898d82249",
                                "sense_id": "37bf95f7-995b-37d4-adbd-761c319ebe07",
                                "text": "Notamment, tu t’en souviens très bien, un hebdomadaire ultra-réac, limite extrême-droite, qui s’appelait Aux écoutes."
                            },
                            {
                                "example_id": "3530abec-32ed-4d99-83cf-59402d9ad055",
                                "sense_id": "37bf95f7-995b-37d4-adbd-761c319ebe07",
                                "text": "Je ne crois pas que la voie soit du côté de l’idéologie ultra-catho et ultra-réac…"
                            },
                            {
                                "example_id": "919f4429-84ac-4b8c-a49a-cda8a1b80da2",
                                "sense_id": "37bf95f7-995b-37d4-adbd-761c319ebe07",
                                "text": "L’aînée des trois filles, Marie-Caroline, reproche à sa cadette sa désertion sur ce terrain tandis que la nièce Marion Maréchal-Le Pen s’en va faire prospérer sa popularité naissante en tête de ces cortèges ultra-réacs."
                            }
                        ]
                    }
