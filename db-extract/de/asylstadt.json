                ],
                "senses": [
                    {
                        "sense_id": "4161661e-cfb1-39d5-a350-91901c93d842",
                        "entry_id": "e5083882-7df0-3f98-8f79-e64f71844b8c",
                        "glosses": [
                            "(veraltet) Sonderrechtszone, in der Asyl gewährt wurde und Asylanten wohnen konnten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baac397f-34a7-4a30-9547-d3ec2ee9a693",
                                "sense_id": "4161661e-cfb1-39d5-a350-91901c93d842",
                                "text": "„Jeder, der in eine Freistadt floh, mußte sich trotzdem vor einem Gericht verantworten: a.) war er schuldig, so half ihm das Asyl nichts; b.) war er unschuldig, so mußte er in der Asylstadt leben, bis der derzeitige amtierende Hohepriester gestorben war.“"
                            },
                            {
                                "example_id": "9ee99896-29ab-4ec4-8652-415fbcf13c4d",
                                "sense_id": "4161661e-cfb1-39d5-a350-91901c93d842",
                                "text": "„Gemäß der Einheitsübersetzung der Thora sind von Gott Jahwe mindestens drei Asylstädte im Heiligen Land gewollt worden.“"
                            },
                            {
                                "example_id": "78f532df-696b-43f4-806d-ecd3e997f096",
                                "sense_id": "4161661e-cfb1-39d5-a350-91901c93d842",
                                "text": "„Die Gemeinde soll den, der getötet hat, vor der Gewalt des Bluträchers retten und ihn in die Asylstadt, in die er geflohen war, zurückbringen.“"
                            },
                            {
                                "example_id": "9a97ffbe-8730-4ca7-95b6-1e733b2dd730",
                                "sense_id": "4161661e-cfb1-39d5-a350-91901c93d842",
                                "text": "„Die Asylstadt, auch als Zufluchtsstadt oder Freistadt bekannt, ist in der Bibel ein wichtiges Rechtsinstitut, das als erste historisch bekannte Form eines Asylrechts anzusehen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
