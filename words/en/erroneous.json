{
    "word_family": [
        "error",
        "err"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3c7dfb64-66b4-3d73-b326-9c5a0d6e9451",
                    "sense_definition": "Containing an error or being inaccurate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incorrectness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student provided an <w>erroneous</w> answer to the complex math problem.",
                            "target_lang_translations": {
                                "zh": "那名学生对这道复杂的数学题给出了一个<w>错误的</w>答案。"
                            }
                        },
                        {
                            "text": "The report contained <w>erroneous</w> information that misled the public.",
                            "target_lang_translations": {
                                "zh": "该报告包含误导公众的<w>错误</w>信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inaccurate",
                        "incorrect",
                        "wrong"
                    ],
                    "antonyms": [
                        "errorless"
                    ],
                    "common_phrases": [
                        "erroneous information",
                        "erroneous belief",
                        "erroneous assumption"
                    ],
                    "target_lang_definitions": {
                        "zh": "包含错误或不准确的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "错误的",
                                "target_lang_sense_clarification": "含有差错的"
                            },
                            {
                                "target_lang_word": "不正确的",
                                "target_lang_sense_clarification": "不符合事实的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13e771a7-8c6e-33d0-b13c-7913b53503ec",
                    "sense_definition": "Derived from or based on a false assumption or error.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "incorrectness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His conclusion was <w>erroneous</w> because it relied on outdated data.",
                            "target_lang_translations": {
                                "zh": "他的结论是<w>错误的</w>，因为它是基于过时的数据得出的。"
                            }
                        },
                        {
                            "text": "The entire theory was built upon an <w>erroneous</w> premise.",
                            "target_lang_translations": {
                                "zh": "整套理论都建立在一个<w>谬误的</w>前提之上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fallacious",
                        "false",
                        "faulty",
                        "flawed"
                    ],
                    "common_phrases": [
                        "erroneous conclusion",
                        "erroneous premise"
                    ],
                    "target_lang_definitions": {
                        "zh": "基于错误假设或前提得出的；有谬误的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "错误的",
                                "target_lang_sense_clarification": "结论或推断有误的"
                            },
                            {
                                "target_lang_word": "谬误的",
                                "target_lang_sense_clarification": "逻辑或前提荒谬不实的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dffdb367-f7cf-3ec3-af73-c4b4affb6872",
                    "sense_definition": "Characterized by being mistaken or having made a wrong judgment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "incorrectness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She realized her <w>erroneous</w> judgment after hearing the full story.",
                            "target_lang_translations": {
                                "zh": "在听完整件事情后，她意识到了自己的<w>错误</w>判断。"
                            }
                        },
                        {
                            "text": "It was an <w>erroneous</w> choice to trust the stranger with the keys.",
                            "target_lang_translations": {
                                "zh": "把钥匙托付给陌生人是一个<w>错误的</w>抉择。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mistaken",
                        "wrong"
                    ],
                    "common_phrases": [
                        "erroneous judgment"
                    ],
                    "target_lang_definitions": {
                        "zh": "做出错误判断或选择的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "错误的",
                                "target_lang_sense_clarification": "判断或选择不妥当的"
                            },
                            {
                                "target_lang_word": "不当的",
                                "target_lang_sense_clarification": "欠妥的、不明智的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}