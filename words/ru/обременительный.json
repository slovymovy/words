{
    "word_family": [
        "бремя",
        "обременять",
        "обременение"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f94b4848-649e-3a17-94e9-478d250c243b",
                    "sense_definition": "Вызывающий чувство тяжести, требующий больших усилий или затрат.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "burdensome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для многих семей ипотека становится слишком <w>обременительной</w> финансовой ношей.",
                            "target_lang_translations": {
                                "de": "Für viele Familien wird die Hypothek zu einer allzu <w>belastenden</w> finanziellen Bürde."
                            }
                        },
                        {
                            "text": "Этот <w>обременительный</w> долг мешает компании развиваться дальше.",
                            "target_lang_translations": {
                                "de": "Diese <w>drückende</w> Schuld hindert das Unternehmen daran, sich weiterzuentwickeln."
                            }
                        }
                    ],
                    "synonyms": [
                        "тяжёлый",
                        "тяжкий"
                    ],
                    "antonyms": [
                        "лёгкий",
                        "необременительный"
                    ],
                    "common_phrases": [
                        "обременительный долг",
                        "обременительная обязанность"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas, das eine Last verursacht oder große Anstrengungen bzw. finanzielle Aufwendungen erfordert."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "belastend",
                                "target_lang_sense_clarification": "allgemein für eine schwere Last oder Anstrengung"
                            },
                            {
                                "target_lang_word": "beschwerlich",
                                "target_lang_sense_clarification": "im Sinne von mühsam oder anstrengend"
                            },
                            {
                                "target_lang_word": "drückend",
                                "target_lang_sense_clarification": "oft im Zusammenhang mit finanziellen Verpflichtungen oder Schulden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61ad774f-cfc4-397b-922b-e3cb6d8fbd6a",
                    "sense_definition": "Доставляющий много хлопот, затруднений или сложностей.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "troublesome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Процесс оформления документов оказался крайне <w>обременительным</w> для всех участников.",
                            "target_lang_translations": {
                                "de": "Der Prozess der Dokumentenabwicklung erwies sich für alle Beteiligten als äußerst <w>mühsam</w>."
                            }
                        },
                        {
                            "text": "Не стоит брать на себя <w>обременительные</w> обязательства перед незнакомыми людьми.",
                            "target_lang_translations": {
                                "de": "Man sollte keine <w>lästigen</w> Verpflichtungen gegenüber Fremden eingehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "хлопотный",
                        "затруднительный",
                        "проблемный"
                    ],
                    "antonyms": [
                        "простой"
                    ],
                    "common_phrases": [
                        "обременительные обязательства",
                        "обременительный процесс"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas, das viel Mühe, Umstände oder Komplikationen verursacht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "mühsam",
                                "target_lang_sense_clarification": "wenn ein Prozess viel Aufwand erfordert"
                            },
                            {
                                "target_lang_word": "lästig",
                                "target_lang_sense_clarification": "wenn etwas als störend oder unangenehm empfunden wird"
                            },
                            {
                                "target_lang_word": "umständlich",
                                "target_lang_sense_clarification": "wenn ein Vorgang kompliziert und zeitaufwendig ist"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}