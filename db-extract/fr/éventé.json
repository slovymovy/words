                                "target_senses": [
                                    {
                                        "sense_id": "c8e353f5-e266-3a4e-a71a-0100c440441f",
                                        "entry_id": "2df78b72-3d68-3573-bf45-84b9f993f243",
                                        "glosses": [
                                            "na povrchu porušený působením povětrnostních vlivů či času"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054ad384-e9c6-4bde-a545-8f3ad86c7940",
                                                "sense_id": "c8e353f5-e266-3a4e-a71a-0100c440441f",
                                                "text": "Zvětralé horniny se těží snadněji."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4861b550-f8f3-33be-a6c1-5c0773ef16bb",
                                        "entry_id": "2df78b72-3d68-3573-bf45-84b9f993f243",
                                        "glosses": [
                                            "takový, jenž prostřednictvím působení času ztratil své chuťové, aromatické či jiné vlastnosti či hodnoty"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93e131e0-983e-40ea-bb84-a236c93d0d39",
                                                "sense_id": "4861b550-f8f3-33be-a6c1-5c0773ef16bb",
                                                "text": "To pivo už je dávno zvětralé, už ho pít nebudu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
