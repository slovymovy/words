                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "392964f6-00c1-4275-94b1-e44616be88a6",
                                "sense_id": "5c3eb4a1-e830-3dbc-8235-b069d9cc1cd3",
                                "text": "Lorsqu'on ne peut disposer que d'une petite longueur de fil, on emploie des romaines micrométriques."
                            },
                            {
                                "example_id": "77fad6ff-2c27-437d-995d-e57524f76848",
                                "sense_id": "5c3eb4a1-e830-3dbc-8235-b069d9cc1cd3",
                                "text": "[…], et une vis de rappel micrométrique peut ensuite soulever ou abaisser la lunette par un mouvement doux et modérable , pour faire atteindre plus exactement à son axe optique la hauteur voulue."
                            }
                        ]
                    },
                    {
