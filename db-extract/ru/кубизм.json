                                        "sense_id": "1230b8fc-94fb-32fc-b9a9-34e7d544625f",
                                        "entry_id": "ac537468-f070-36c0-a96b-d18ffd785c99",
                                        "glosses": [
                                            "An artistic movement in the early 20th Century characterized by the depiction of natural forms as geometric structures of planes."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "873f163f-b4ce-48b0-8615-be705278beea",
                                                "sense_id": "1230b8fc-94fb-32fc-b9a9-34e7d544625f",
                                                "text": "Matisse coined the name Cubism as a derisive joke."
                                            },
                                            {
                                                "example_id": "915363c2-bb19-4154-ae78-cf6aeee48cb0",
                                                "sense_id": "1230b8fc-94fb-32fc-b9a9-34e7d544625f",
                                                "text": "A few recall that, in 1908, he [Matisse] inspired the coinage of the term “cubism,” in disparagement of a movement that would eclipse his leading influence on the Parisian avant-garde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
