                        "glosses": [
                            "Relatif à la tribu des Bordjiguines et à ses membres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ee49a35-85f7-43a0-b80d-adfb0c02bc64",
                                "sense_id": "dcee4494-b2d4-3001-b99e-72379e6a6d51",
                                "text": "Au reste la prétention de la tribu bordjiguine de se rattacher aux Turcs ne devait pas être dépourvue de tout fondement réel. Elle était leur voisine immédiate à l'Est, peu éloignée de leur campement principal, sur la rive de l'Orkhone."
                            },
                            {
                                "example_id": "05f12e0f-e2ba-4ee9-96aa-21c30ed9537e",
                                "sense_id": "dcee4494-b2d4-3001-b99e-72379e6a6d51",
                                "text": "Entretemps, la direction de la tribu bordjiguine et des clans apparentés passa entièrement dans les mains des chefs des Tayitchiout, fils de Ambakaï khan, Tarkoutaï-kiriltouk et Todoen-guirté."
                            }
                        ]
                    }
