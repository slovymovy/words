                        "entry_id": "bfc1af28-5b2e-315f-b416-8e931500f524",
                        "glosses": [
                            "Qui concerne le psychisme et les émotions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "018ea88d-8bdc-46d3-a757-97c9d1dc6864",
                                "sense_id": "b05b4129-bc03-3106-a486-6f4329b350e6",
                                "text": "Et « les thématiques psychoémotionnelles et juridiques ne sont quasiment pas abordées, laissant la place à une approche purement biologique de la vie affective et sexuelle »."
                            },
                            {
                                "example_id": "51e3ceb2-7e5f-4ec8-aeab-e5e75273693b",
                                "sense_id": "b05b4129-bc03-3106-a486-6f4329b350e6",
                                "text": "La plainte psychoémotionnelle se mélange au ralentissement physiologique."
                            },
                            {
                                "example_id": "d4f13776-1c29-4ad2-a50d-314287566ae8",
                                "sense_id": "b05b4129-bc03-3106-a486-6f4329b350e6",
                                "text": "Les stress psychoémotionnels sont également à prendre en compte ; car, lorsqu’ils entraînent un état de frustration, une compensation de type alimentaire peut survenir."
                            }
                        ]
                    }
