                                "en": "He started laughing <for no reason> during the meeting.",
                                "pl": "Zaczął się śmiać podczas spotkania <w>bez powodu</w>.",
                                "fr": "Il a commencé à rire <comme ça> pendant la réunion.",
                                "de": "Er fing während der Besprechung <w>einfach so</w> an zu lachen.",
                                "it": "Ha iniziato a ridere <w>così</w> durante la riunione.",
                                "cs": "Během schůze se <w>jen tak</w> začal smát.",
                                "tr": "Toplantı sırasında <w>durup dururken</w> gülmeye başladı.",
                                "es": "Empezó a reírse <w>sin más</w> durante la reunión.",
                                "zh": "他在开会时<w>无缘无故</w>地笑了起来。"
                            }
                        },
                        {
                            "text": "Ik heb <zomaar> een cadeautje voor je meegenomen.",
                            "target_lang_translations": {
                                "ru": "Я принес тебе подарок <просто так>.",
                                "en": "I brought you a gift <just because>.",
                                "pl": "Przyniosłem ci prezent <w>tak po prostu</w>.",
                                "fr": "Je t'ai apporté un cadeau <comme ça>.",
                                "de": "Ich habe dir <w>einfach so</w> ein Geschenk mitgebracht.",
                                "it": "Ti ho portato un regalo <w>così, senza motivo</w>.",
                                "cs": "Přinesl jsem ti <w>jen tak</w> dárek.",
                                "tr": "Sana <w>öylesine</w> bir hediye getirdim.",
                                "es": "Te he traído un regalo <w>porque sí</w>.",
                                "zh": "我<w>随便</w>给你带了个小礼物。"
                            }
                        }
