                        "examples": [
                            {
                                "example_id": "d9a2ce9d-18a3-433f-809d-4b756a7cce51",
                                "sense_id": "43aa24b5-4e62-3329-9ba2-b7cccfcf0b8b",
                                "text": "De bakker vindt het moeilijk te bevatten. \"In 2004 bestond onze bakkerij 25 jaar. We hielden toen verschillende activiteiten, waaronder een ballonnenwedstrijd.\" Dat er een ballon zo ver zou komen, had niemand verwacht."
                            },
                            {
                                "example_id": "2bbd912a-33a4-4de7-a872-bbe87750b6d1",
                                "sense_id": "43aa24b5-4e62-3329-9ba2-b7cccfcf0b8b",
                                "text": "Na twintig jaar is een briefje aan een ballon toch nog bij afzender Natasja Nijman (25) uit Enschede teruggekeerd. Als vijfjarig meisje deed ze mee aan een ballonnenwedstrijd. Dit weekend werd ze verrast; het kaartje dat ze aan haar ballon knoopte viel na al die jaren op de deurmat."
                            }
                        ]
