                    },
                    {
                        "form_id": "eb5ff36e-8138-45a0-88b8-c7b7ebfe6f6b",
                        "entry_id": "56100958-8723-34b4-8266-fcccee82a9c5",
                        "tags": [
                            "masculine"
                        ],
                        "form": "philosophe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9e1d45d-f376-35a0-9991-a3c0ed5673c2",
                        "entry_id": "56100958-8723-34b4-8266-fcccee82a9c5",
                        "glosses": [
                            "Femme qui pratique la philosophie."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3d52cf54-e199-4bb7-9d30-e13fc8de4e60",
                                "sense_id": "f9e1d45d-f376-35a0-9991-a3c0ed5673c2",
                                "text": "Une vieille nommée madame de Laid-Harnois voulut faire la philosophesse discrette […]."
                            },
                            {
                                "example_id": "19154557-6358-4629-9c50-331705bb8883",
                                "sense_id": "f9e1d45d-f376-35a0-9991-a3c0ed5673c2",
                                "text": "Et j’appris que Mˡˡᵉ Melliflue (qui probablement, en vraie philosophesse, ne faisait aucune différence entre deux hommes) regardait d’un même œil complaisant un jeune freluquet qui fréquentait la maison et le sieur Chrysostome, poussant ce dernier à mettre dans le même sac le freluquet, sa Melliflue, vous, moi et tout le genre humain — et certes à bon droit."
                            },
                            {
                                "example_id": "3b8666e3-8512-4349-97db-dc67582528fe",
                                "sense_id": "f9e1d45d-f376-35a0-9991-a3c0ed5673c2",
                                "text": "Parmi les tentatives de féminisation non-retenues par l’usage, mentionnons une philosophesse dans la Néologie de L.-S. Mercier (1801)."
                            },
                            {
                                "example_id": "ae89c897-b108-4ef2-87f6-6784910934f6",
                                "sense_id": "f9e1d45d-f376-35a0-9991-a3c0ed5673c2",
                                "text": "Aux xviiᵉ siècle et xviiiᵉ siècles, philosophesse a été vigoureusement attaqué pour une raison esthétique : on y entend le mot fesse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f65c964-81ea-4363-96da-abc2e1fbb3b0",
                        "source_entry_id": "56100958-8723-34b4-8266-fcccee82a9c5",
                        "source_sense_id": "f9e1d45d-f376-35a0-9991-a3c0ed5673c2",
                        "target_lang_word": "Philosophin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philosophin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64972bec-12c0-31fa-bc01-2c0dc173f48a",
                                        "entry_id": "3c21c6db-162c-3720-86d4-cfeb4e611d48",
                                        "glosses": [
                                            "eine Frau, die (beruflich, professionell) im Gebiet der Philosophie forscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9317e4af-1921-43ab-9383-9e6b71e4a8c9",
                                                "sense_id": "64972bec-12c0-31fa-bc01-2c0dc173f48a",
                                                "text": "Elizabeth Anscombe, Simone de Beauvoir und Hannah Arendt waren Philosophinnen."
                                            },
                                            {
                                                "example_id": "3fb21156-c288-4484-b5f2-5d2988f3608b",
                                                "sense_id": "64972bec-12c0-31fa-bc01-2c0dc173f48a",
                                                "text": "„Manch andere Kollegen haben umgekehrt wenig Verständnis dafür, wenn sich eine Philosophin so vieler heißer Eisen und einer Minderheit nach der anderen annimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa4800c3-8bf9-3971-afeb-8dfae5371d02",
                                        "entry_id": "3c21c6db-162c-3720-86d4-cfeb4e611d48",
                                        "glosses": [
                                            "eine weibliche Person mit nachdenklicher, philosophischer Veranlagung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff2c9831-f077-4610-ada6-d9db4e08394c",
                                                "sense_id": "fa4800c3-8bf9-3971-afeb-8dfae5371d02",
                                                "text": "Meine Tochter war schon immer eine Philosophin."
                                            },
                                            {
                                                "example_id": "c338290d-f815-4175-86ab-2445732537d5",
                                                "sense_id": "fa4800c3-8bf9-3971-afeb-8dfae5371d02",
                                                "text": "„Dreiviertel der Tischgenossen stießen Rufe der Bewunderung aus, und die schöne Philosophin freute sich, als sie mich vor Entzücken über den Beifall lachen sah.“"
                                            },
                                            {
                                                "example_id": "74806ede-a3f9-46dd-b665-6bead7a772e9",
                                                "sense_id": "fa4800c3-8bf9-3971-afeb-8dfae5371d02",
                                                "text": "„Sie ist eine Philosophin, und in ihren Deklamationen an die Natur schwingen uralte Lehren einer vorspiritualistischen Religion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f160476-7e1b-4947-9a1b-e60dcbe885ac",
                        "source_entry_id": "56100958-8723-34b4-8266-fcccee82a9c5",
