                                    {
                                        "sense_id": "3cf10012-f52a-37b3-96f6-8c368a608483",
                                        "entry_id": "c8086ece-4ef7-371e-a1e7-b8556fc814ae",
                                        "glosses": [
                                            "Anmerkungen am Rand eines Buches oder einer Handschrift"
