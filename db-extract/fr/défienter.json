                        "examples": [
                            {
                                "example_id": "928d40e9-e464-4096-96ce-33777b66edbc",
                                "sense_id": "47fdc469-11f0-3f2e-a435-82d0e007eeb9",
                                "text": "La constipation se guérit en insinuant du beurre dans l’anus de l’animal pour amollir la fiente ; la tirer ensuite avec le doigt, ce qui se nomme défienter : suppositoires de savon ; lavemens comme aux tranchées."
                            },
                            {
                                "example_id": "5923197a-4617-47b7-b23f-fea159a8721f",
                                "sense_id": "47fdc469-11f0-3f2e-a435-82d0e007eeb9",
                                "text": "Que les commandants veilleroient à ce que les écuries fussent bien nettoyées et défientées au moins deux fois par semaine à peine, contre ceux qui ne l’auraient pas fait, de cinq livres d’amende pour chaque fois qu’ils seroient surpris."
                            }
                        ]
