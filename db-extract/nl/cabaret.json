                    {
                        "translation_id": "710e2d8b-c58e-460b-96e5-149e33de9138",
                        "source_entry_id": "da017d0a-afc7-3f6a-8a51-f309da75dbda",
                        "source_sense_id": "04a0ad1a-f612-3e29-8734-5430a55eb15f",
                        "source_sense_description": "een kleinkunst, vermaak met toneel, zang, dans, en voordracht",
                        "target_lang_word": "cabaret",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabaret",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a1950d1-6e35-36c5-8945-3aec4984de44",
                                        "entry_id": "9f444345-11d6-3277-a2d5-e10b9c8e2258",
                                        "glosses": [
                                            "Taverne où l’on vend en détail du vin et des boissons spiritueuses et où l’on vend aussi à manger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4cdc97d-c062-42bf-a06f-209e75405e25",
                                                "sense_id": "3a1950d1-6e35-36c5-8945-3aec4984de44",
                                                "text": "La fréquentation du cabaret entraine des maux étranges ; on y mange, on y joue son bien, on y ruine sa santé : on s'y abandonne à toutes sortes de crimes, comme aux jeux excessifs, aux tromperies, aux juremens, aux querelles, aux médisances, aux paroles sales, enfin à l'ivrognerie, qui fait que l'homme n'est plus homme, dit Saint Grégoire."
                                            },
                                            {
                                                "example_id": "f7281bf4-6ee6-4418-96f9-eb1513c1157f",
                                                "sense_id": "3a1950d1-6e35-36c5-8945-3aec4984de44",
                                                "text": "Mon herbier et mes livres de botanique me coûtent déjà beaucoup de peine et d'argent à transporter de gîte en gite, et de cabaret en cabaret."
                                            },
                                            {
                                                "example_id": "b3977a65-48f8-48ce-b8e6-abd471455c6c",
                                                "sense_id": "3a1950d1-6e35-36c5-8945-3aec4984de44",
                                                "text": "Depuis huit jours, j’avais déchiré mes bottines\nAux cailloux des chemins. J’entrais à Charleroi.\n— Au Cabaret-Vert : je demandai des tartines\nDe beurre et du jambon qui fût à moitié froid."
                                            },
                                            {
                                                "example_id": "de769091-70a2-426d-bd90-306bc31a7078",
                                                "sense_id": "3a1950d1-6e35-36c5-8945-3aec4984de44",
                                                "text": "En un village de trois cents habitants, où il y avait autrefois cinq cabarets, il y en a quinze maintenant, et tous font leurs affaires."
                                            },
                                            {
                                                "example_id": "68e8001c-f0c9-4b31-956b-ed9c8b68aaa6",
                                                "sense_id": "3a1950d1-6e35-36c5-8945-3aec4984de44",
                                                "text": "Il attire mon attention sur ce fait que, très souvent ici, même dans les cabarets, on voit des crucifix et des images pieuses."
                                            },
                                            {
                                                "example_id": "ad50f718-4c48-4ccb-bd00-75f0e17cb216",
                                                "sense_id": "3a1950d1-6e35-36c5-8945-3aec4984de44",
                                                "text": "Ces hommes marqués dans le dos ne semblaient point en penser long ; ils allaient de cabaret en cabaret et semblaient mus par mécanique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cd9bd84-2446-305b-9cb8-cf1f4cfa226d",
                                        "entry_id": "9f444345-11d6-3277-a2d5-e10b9c8e2258",
                                        "glosses": [
                                            "Taverne où l’on vend en détail du vin et des boissons spiritueuses et où l’on vend aussi à manger.",
                                            "Lieu de réunion d’hommes de lettres ou d’artistes qui se tenait dans tel ou tel débit de vins."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a604170-3b31-4bab-9ebd-ccbc66204355",
                                                "sense_id": "2cd9bd84-2446-305b-9cb8-cf1f4cfa226d",
                                                "text": "Le soir il y eut un grand souper chez Joassant, qui représenta le dernier cabaret de la littérature. C'était un endroit où passaient la nuit ceux qui revenaient tard des théâtres et des journaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f937dd95-1f18-3856-bde7-b3228da072be",
                                        "entry_id": "9f444345-11d6-3277-a2d5-e10b9c8e2258",
                                        "glosses": [
                                            "Établissement où l’on se réunit pour entendre des chansons satiriques ou politiques."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "929dfe46-ef88-4783-95e3-e6229fb0e51a",
                                                "sense_id": "f937dd95-1f18-3856-bde7-b3228da072be",
                                                "text": "Le Chat noir fut l'un des premiers cabarets artistiques. Il fut créé en 1881 par Rodolphe Salis à Montmartre …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d52409ba-ba3a-3265-ae31-5c54263af11c",
                                        "entry_id": "9f444345-11d6-3277-a2d5-e10b9c8e2258",
                                        "glosses": [
                                            "Plateau à bord relevés ou petite table utilisé pour servir des boissons."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f204470-6493-488e-8508-d9b519c04b82",
                                                "sense_id": "d52409ba-ba3a-3265-ae31-5c54263af11c",
                                                "text": "On était auprès de plusieurs cabarets de thé et de café ; en prenait qui voulait."
                                            },
                                            {
                                                "example_id": "b94b6fb0-8c9f-4ce8-9185-b16f3cfbca5f",
                                                "sense_id": "d52409ba-ba3a-3265-ae31-5c54263af11c",
                                                "text": "À dix heures sonnantes, M. de Riquebourg entra dans la chambre de Leuwen, suivi de la fidèle Marion, qui portait un cabaret avec du café au lait, et Marion était elle-même suivie d'un petit jockey qui portait un autre cabaret avec du thé, du beurre et une bouilloire."
                                            },
                                            {
                                                "example_id": "8e142725-7aa2-429c-9cf9-e39112b0e9a1",
                                                "sense_id": "d52409ba-ba3a-3265-ae31-5c54263af11c",
                                                "text": "Pour finir, on apporte un cabaret avec du vin de Malaga, de Xéres et de l’eau-de-vie, aguardiente, qui ressemble à de l’anisette de France, et une petite coupe (fuego) remplie de braise pour allumer les cigarettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9db525f9-641a-3610-ad36-8524cf905007",
                                        "entry_id": "9f444345-11d6-3277-a2d5-e10b9c8e2258",
                                        "glosses": [
                                            "Plateau de self-service, tout particulièrement dans les cafétérias et autres établissements de restauration rapide."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4edebb9-179c-42ba-9930-6519350a8902",
                                                "sense_id": "9db525f9-641a-3610-ad36-8524cf905007",
                                                "text": "— Je peux m'occuper de ton cabaret, si tu veux, Lily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dda0278c-fa20-392f-b63e-aa8a3bd75b8c",
                                        "entry_id": "9f444345-11d6-3277-a2d5-e10b9c8e2258",
                                        "glosses": [
                                            "Porte-liqueurs, cave à liqueurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d80467ae-b555-4fdd-a0f9-41e1e511c9f0",
                                                "sense_id": "dda0278c-fa20-392f-b63e-aa8a3bd75b8c",
                                                "text": "Calyste refusa de prendre […] des liqueurs contenues dans un de ces magnifiques cabarets en bois précieux qui sont comme des tabernacles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daf11691-e92d-3c32-84c7-1b4e7b12f9bb",
                                        "entry_id": "9f444345-11d6-3277-a2d5-e10b9c8e2258",
                                        "glosses": [
                                            "Assortiment des tasses qu’on met sur le plateau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc4b8caf-5d54-433e-b977-44c40577096d",
                                                "sense_id": "daf11691-e92d-3c32-84c7-1b4e7b12f9bb",
                                                "text": "Berthe. – J’ai cassé un cabaret de porcelaine, vlan !"
                                            },
                                            {
                                                "example_id": "eab5215d-3cbb-4d91-b646-ca85b38cb073",
                                                "sense_id": "daf11691-e92d-3c32-84c7-1b4e7b12f9bb",
                                                "text": "En lui donnant ce conseil, il parlait dans l’intérêt d’un amas hétérogène de plateaux de pâtissier, de lampes, de cabarets garnis de verres, de banquettes à rouet, épars çà et là dans la salle, restes confus d’une soirée de la veille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f544a9af-94b2-3adf-9772-c43297202d69",
                                        "entry_id": "9f444345-11d6-3277-a2d5-e10b9c8e2258",
                                        "glosses": [
                                            "Sur un bateau, sorte de plateau destiné à fixer sur une table les assiettes et les couverts pour les empêcher de tomber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1056a1f-f08c-47d7-822b-2d81a87d0526",
                                                "sense_id": "f544a9af-94b2-3adf-9772-c43297202d69",
                                                "text": "Dans la salle à manger, tous les couverts sont fixés à table par des « cabarets », sorte de planchettes percées de trous pour y placer assiettes, verres, etc. Sans cela, ils seraient tous à terre en quelques secondes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cabaret",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "683365b5-e509-3fae-8ff3-e8bc3871fa9e",
                                        "entry_id": "b62d84f5-6130-3dfd-9be4-08c7b95ac6a5",
                                        "glosses": [
                                            "Nom vulgaire de l’asaret d’Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b428511-d0fc-45ed-8b7a-0dbdb8d4a710",
                                                "sense_id": "683365b5-e509-3fae-8ff3-e8bc3871fa9e",
                                                "text": "Cabaret des oiseaux."
                                            },
                                            {
                                                "example_id": "e8ffb011-d1d2-4d3e-96a1-fb70838af69a",
                                                "sense_id": "683365b5-e509-3fae-8ff3-e8bc3871fa9e",
                                                "text": "Cabaret de murailles, cynoglosse omphalode."
                                            },
                                            {
                                                "example_id": "47fa70b6-3947-41a1-8015-f4deb5becc5e",
                                                "sense_id": "683365b5-e509-3fae-8ff3-e8bc3871fa9e",
                                                "text": "Les feuilles & les racines du cabaret sont douées d’une odeur pénétrante, & d'un goût acre. Elles provoquent fortement le vomissement & les selles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cabaret",
                                "target_lang_code": "fr",
                                "target_senses": [
