                ],
                "senses": [
                    {
                        "sense_id": "0eefed0f-678d-3fe6-afe7-addadb1e0043",
                        "entry_id": "db437ca9-79e3-356e-a6b1-81fbb20021db",
                        "glosses": [
                            "Variante orthographique de galéjer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc960f15-8400-465a-a2b1-1ed1bcbd0472",
                                "sense_id": "0eefed0f-678d-3fe6-afe7-addadb1e0043",
                                "text": "Devant un homme ainsi, déclara Maurin, je t’assure qu’on n’a pas envie de galéger…"
                            },
                            {
                                "example_id": "e238d314-ce65-42fe-b8fe-ccf8545aa53b",
                                "sense_id": "0eefed0f-678d-3fe6-afe7-addadb1e0043",
                                "text": "Au milieu des autres, maigre comme un clou, Titine faisait galéger et s’esbaudir le populaire."
                            },
                            {
                                "example_id": "cf6c7526-61fc-4981-b20e-b9c4932768ca",
                                "sense_id": "0eefed0f-678d-3fe6-afe7-addadb1e0043",
                                "text": "Galabru, Henri Tisot, Mercadier, Francis Blanche, en dehors du tournage, passaient leur temps au café ou à galéger et faire des farces."
                            },
                            {
                                "example_id": "6dde9333-0c86-4565-a1aa-bd648c12fa15",
                                "sense_id": "0eefed0f-678d-3fe6-afe7-addadb1e0043",
                                "text": "À voir sa bedaine, impossible de penser que Luppi galégeait."
                            }
                        ]
                    }
                ],
