                    {
                        "sense_id": "77611faa-6b20-3506-baea-368e01695ce9",
                        "entry_id": "c87c525c-493a-38ef-9a2a-d7487a3ce802",
                        "glosses": [
                            "Latino-Américain, Latino-Américaine. Personne d’origine latino-américaine."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "4f4e295f-d8b0-4837-b6dc-c57d15f1d8a2",
                                "sense_id": "77611faa-6b20-3506-baea-368e01695ce9",
                                "text": "Latinx Americans can be from any racial group. There are large groups of Latinxs having African ancestry, as well as large groups having European ancestry. Many Latinxs are racially mixed."
                            }
                        ]
                    }
