                "senses": [
                    {
                        "sense_id": "9583ce32-c42e-3486-b14b-7b85cebd0b1f",
                        "entry_id": "d0da8915-4b7b-3e94-8ace-4ff4474be01b",
                        "glosses": [
                            "Ours en peluche, issu d’une ligne de jouets américaine commercialisée à partir des années 1980, notamment déclinée en dessins animés."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "2ba4463f-6748-4839-b31c-336198f39c8e",
                                "sense_id": "9583ce32-c42e-3486-b14b-7b85cebd0b1f",
                                "text": "A bien des égards, ce nouveau monde rappelle celui des Bisounours : un univers où tout le monde est gentil, et dont la candeur est la valeur cardinale."
                            }
                        ]
                    },
                    {
                        "sense_id": "142e2005-4abf-3f0d-923c-b25b9aa977b7",
                        "entry_id": "d0da8915-4b7b-3e94-8ace-4ff4474be01b",
                        "glosses": [
                            "Personne trop optimiste."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "443ea094-e389-4866-ac81-07537ae8ab71",
                                "sense_id": "142e2005-4abf-3f0d-923c-b25b9aa977b7",
                                "text": "[Laurent Fabius] Quand je vois les peignées qu’ils sont en train de se mettre – et encore je ne vois que l’aspect public –, je me dis que nous, au Parti socialiste, – nous sommes des Bisounours."
                            }
                        ]
                    }
