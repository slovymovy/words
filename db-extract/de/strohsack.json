                                    {
                                        "sense_id": "e87a6cd5-5f50-34fe-9bc9-aa3e515e1be3",
                                        "entry_id": "eaa0731f-63e2-3568-852c-d0fb4bc1cf10",
                                        "glosses": [
                                            "matrace vycpaná slámou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bae8b43-63fd-4e9d-8025-376a39459f15",
                                                "sense_id": "e87a6cd5-5f50-34fe-9bc9-aa3e515e1be3",
                                                "text": "„Slamník už nemohu dát do postele, je rozpárán, sláma by propadala skrz prkýnka —“"
                                            },
                                            {
                                                "example_id": "9d14a4f0-395e-40ae-83a2-2e370f3b0cf6",
                                                "sense_id": "e87a6cd5-5f50-34fe-9bc9-aa3e515e1be3",
                                                "text": "Chudší rodiny nemají matrací (žíněnek), nýbrž jen slamníky.",
                                                "translation": "Ärmere Familien haben keine Matratzen, sondern nur Strohsäcke."
                                            }
