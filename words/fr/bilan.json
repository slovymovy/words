{
    "word_family": [
        "bilanciel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4af58cc4-fc0c-36d3-bc89-711172973b92",
                    "sense_definition": "Évaluation globale ou récapitulation des résultats d'une action, d'une période ou d'un parcours.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la fin de chaque trimestre, l'équipe prend le temps de faire le <w>bilan</w> de ses projets."
                        },
                        {
                            "text": "Le directeur a dressé un <w>bilan</w> très positif des résultats obtenus pendant l'année écoulée."
                        }
                    ],
                    "synonyms": [
                        "récapitulatif",
                        "synthèse"
                    ],
                    "common_phrases": [
                        "faire le bilan",
                        "dresser un bilan",
                        "bilan positif"
                    ]
                },
                {
                    "sense_id": "9bf98db0-1da0-361c-869e-93994a51ae0a",
                    "sense_definition": "Décompte des victimes ou estimation des dégâts matériels après un accident ou une catastrophe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les autorités ont annoncé un <w>bilan</w> provisoire de dix blessés après le passage de la tempête."
                        },
                        {
                            "text": "Le <w>bilan</w> humain de cet accident de la route reste particulièrement lourd selon les secours."
                        }
                    ],
                    "common_phrases": [
                        "bilan humain",
                        "bilan provisoire",
                        "bilan lourd"
                    ]
                },
                {
                    "sense_id": "25e67a9b-0f9d-3a9c-9265-424bf9d9beaf",
                    "sense_definition": "Ensemble d'examens médicaux permettant d'évaluer l'état de santé général d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a recommandé un <w>bilan</w> de santé complet avant de reprendre le sport."
                        },
                        {
                            "text": "Elle se rend au laboratoire chaque année pour effectuer un <w>bilan</w> sanguin de contrôle."
                        }
                    ],
                    "synonyms": [
                        "check-up"
                    ],
                    "common_phrases": [
                        "bilan de santé",
                        "bilan sanguin",
                        "bilan médical"
                    ]
                },
                {
                    "sense_id": "c3ac16e4-98c0-35db-8277-08b9c7bf6e13",
                    "sense_definition": "Document comptable de synthèse qui présente l'actif et le passif d'une entreprise à la clôture de l'exercice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'expert-comptable a présenté le <w>bilan</w> annuel aux actionnaires lors de l'assemblée générale."
                        },
                        {
                            "text": "Faute de trésorerie suffisante, cette entreprise a été contrainte de déposer le <w>bilan</w> la semaine dernière."
                        }
                    ],
                    "common_phrases": [
                        "bilan comptable",
                        "déposer le bilan",
                        "dépôt de bilan"
                    ]
                }
            ]
        }
    ]
}