{
    "word_family": [
        "mold",
        "moldy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c0ac27cb-c9b5-3543-a37a-794933928732",
                    "sense_definition": "To slowly decay or disintegrate, often due to neglect or dampness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old book was left to <w>molder</w> until only the cover remained.",
                            "target_lang_translations": {
                                "tr": "Eski kitap, sadece kapağı kalana dek <w>çürümeye</w> terk edilmişti."
                            }
                        },
                        {
                            "text": "The abandoned house began to <w>molder</w> into decay after years of neglect.",
                            "target_lang_translations": {
                                "tr": "Terk edilmiş ev, yıllarca süren ihmalden sonra <w>çürüyüp</w> harabeye dönmeye başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "decay",
                        "rot",
                        "decompose"
                    ],
                    "antonyms": [
                        "flourish",
                        "thrive"
                    ],
                    "target_lang_definitions": {
                        "tr": "İhmal veya nem nedeniyle yavaşça çürümek veya dağılmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çürümek",
                                "target_lang_sense_clarification": "Genel olarak bozulma ve çürüme süreci."
                            },
                            {
                                "target_lang_word": "ufalanmak",
                                "target_lang_sense_clarification": "Zamanla parçalara ayrılarak dağılma durumu."
                            },
                            {
                                "target_lang_word": "çürüyüp gitmek",
                                "target_lang_sense_clarification": "İhmal sonucu yok olma sürecini vurgular."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "18f2c2c1-14a0-3cb6-a5ba-1678ec769e2f",
                    "sense_definition": "A person or thing that makes molds for casting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "craft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skilled <w>molder</w> prepared the sand cast for the molten metal.",
                            "target_lang_translations": {
                                "tr": "Usta <w>kalıpçı</w>, erimiş metal için kum kalıbı hazırladı."
                            }
                        },
                        {
                            "text": "Every <w>molder</w> in the factory followed strict safety protocols during the casting process.",
                            "target_lang_translations": {
                                "tr": "Fabrikadaki her <w>kalıpçı</w>, döküm işlemi sırasında katı güvenlik protokollerine uydu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Döküm için kalıp yapan kişi veya araç."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kalıpçı",
                                "target_lang_sense_clarification": "Kalıp yapma işiyle uğraşan zanaatkar."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6335f616-78e8-3617-bcf0-d72b045cc3fc",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The research paper was written by Dr. <w>Molder</w>.",
                            "target_lang_translations": {
                                "tr": "Araştırma makalesi Dr. <w>Molder</w> tarafından yazılmıştır."
                            }
                        },
                        {
                            "text": "The <w>Molder</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "tr": "<w>Molder</w> ailesi nesillerdir bu kasabada yaşamaktadır."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir soyadı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Molder",
                                "target_lang_sense_clarification": "Özel isim olduğu için Türkçede de aynı şekilde kullanılır."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}