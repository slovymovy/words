        "fr-extract.jsonl": [
            {
                "entry_id": "dcf43b54-228b-35ce-86c9-c11bdb0188e6",
                "word": "ici-bas",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "08b28fe0-6fdf-3deb-91a3-ba3c0f6d6f4c",
                        "entry_id": "dcf43b54-228b-35ce-86c9-c11bdb0188e6",
                        "glosses": [
                            "Sur cette Terre, dans le monde des vivants, par opposition au Paradis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a6894e3-98d8-48a9-bfe9-16bd46b220b8",
                                "sense_id": "08b28fe0-6fdf-3deb-91a3-ba3c0f6d6f4c",
                                "text": "Oh ! jeune homme, est-ce donc la providence divine qui m’a fait désirer de secouer par un peu d’exercice à pied le sommeil dont sont saisis au matin tous les voyageurs, afin que je pusse, en vous consolant, obéir à ma mission ici-bas ?…"
                            },
                            {
                                "example_id": "75f55fcc-17b5-4e5e-9144-b171fa043909",
                                "sense_id": "08b28fe0-6fdf-3deb-91a3-ba3c0f6d6f4c",
                                "text": "Ce sont d’abord les saints ayant foi en la révélation qui, prochainement et du jour au lendemain, disparaîtront tous de ce monde pour être transportés au ciel, sans laisser ici-bas aucune dépouille mortelle."
                            },
                            {
                                "example_id": "892222a3-4b2e-4fd2-a10a-620297974f86",
                                "sense_id": "08b28fe0-6fdf-3deb-91a3-ba3c0f6d6f4c",
                                "text": "Sa langue, d’une mobilité étonnante, courait amoureusement sur ses lèvres comme si elle se promettait de goûter à toutes les félicités d’ici-bas."
                            },
                            {
                                "example_id": "0367d988-aba9-416e-a4fb-31ebc513aba5",
                                "sense_id": "08b28fe0-6fdf-3deb-91a3-ba3c0f6d6f4c",
                                "text": "Les bords rouges de ses paupières ressortaient dans son visage pâle. Erica lui trouvait la tête d’un homme déjà mort mais qui continuait à errer ici-bas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a786dc3-93d7-459c-9ad4-2e6fd5422bb2",
                        "source_entry_id": "dcf43b54-228b-35ce-86c9-c11bdb0188e6",
                        "source_sense_id": "08b28fe0-6fdf-3deb-91a3-ba3c0f6d6f4c",
                        "source_sense_description": "1. Sur cette terre.",
                        "target_lang_word": "here below",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "here below",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc0a205e-9641-3934-9ff2-76bc93c3db5d",
                                        "entry_id": "861fa13f-7d56-3588-9839-f61774a5c05b",
                                        "glosses": [
                                            "In this world; in our mortal time on the earth."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f67d93f5-2ceb-4ff4-ba74-e7a59848163d",
                                                "sense_id": "cc0a205e-9641-3934-9ff2-76bc93c3db5d",
                                                "text": "Praise God, from whom all blessings flow / praise Him, all creatures here below / praise Him above, ye heavenly host / praise Father, Son, and Holy Ghost"
                                            },
                                            {
                                                "example_id": "71578a33-c4a0-4492-9e1b-b58ab689786c",
                                                "sense_id": "cc0a205e-9641-3934-9ff2-76bc93c3db5d",
                                                "text": "The earth shall soon dissolve like snow / The sun forbear to shine / but God who called me here below / will be forever mine."
                                            },
                                            {
                                                "example_id": "7440b9c2-644f-4eb2-9b31-3dfb4b398f2b",
                                                "sense_id": "cc0a205e-9641-3934-9ff2-76bc93c3db5d",
                                                "text": "And if the material of the firmament resembled that of bodies here below, a theory of motion built on experience with objects within our reach might apply also to the celestial regions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
