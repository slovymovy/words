                                "target_senses": [
                                    {
                                        "sense_id": "6ba38af0-ba01-3e01-b2a8-d5d9c5a7cdee",
                                        "entry_id": "79e5b328-e832-3e0d-b894-2d438e3d57fc",
                                        "glosses": [
                                            "in modo sperimentale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa8e5f35-46f4-4171-936a-d0be8c71cd86",
                                                "sense_id": "6ba38af0-ba01-3e01-b2a8-d5d9c5a7cdee",
                                                "text": "l’esistenza delle onde gravitazionali fu prevista nel 1916 da Albert Einstein come conseguenza della sua teoria della relatività generale, ed è stata confermata sperimentalmente nel 2016"
