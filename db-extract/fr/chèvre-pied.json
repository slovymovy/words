                    {
                        "sense_id": "a3acda14-e760-308a-826c-386cc89ae65a",
                        "entry_id": "1803ae4c-42eb-326f-aa59-0f3e9d2f969c",
                        "glosses": [
                            "Satyre, faune à pied de chèvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1b3f06f-34b3-423e-a169-4b119f08fcc7",
                                "sense_id": "a3acda14-e760-308a-826c-386cc89ae65a",
                                "text": "Le Chèvre-Pied a poursuivi jusqu’au fleuve\nLa Syrinx, fille de la source."
                            },
                            {
                                "example_id": "f7a9015c-bf72-4c81-8ac0-c62279b7f9de",
                                "sense_id": "a3acda14-e760-308a-826c-386cc89ae65a",
                                "text": "– Eh quoi ! faut-il nous livrer sans vergogne au premier satyre ?...\n– Je ne dis pas cela, ma toute belle ! Mais, du chèvre-pied lui-même, une nymphe habile peut se faire un amant passable…"
                            },
                            {
                                "example_id": "af550180-097e-47b1-87c2-d7a90fb55642",
                                "sense_id": "a3acda14-e760-308a-826c-386cc89ae65a",
                                "text": "Alice sourit au visage du chèvre-pied, qui avait les cheveux tournés en spirales, clairs et mêlés de fils blancs, et de très beaux yeux châtains, un peu saillants et chroniquement pleins de prière."
                            },
                            {
                                "example_id": "396ca271-f71b-4687-9b20-b78233698d77",
                                "sense_id": "a3acda14-e760-308a-826c-386cc89ae65a",
                                "text": "Bacchus se vautre sur les grappes, et, pour lui aider, il a permis à deux petits chèvre-pieds, de s’étaler sur le raisin…"
                            }
                        ]
                    }
