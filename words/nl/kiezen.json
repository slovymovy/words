                {
                    "sense_id": "2759d3da-eb68-346d-83f8-8d8abac5cc62",
                    "sense_definition": "uit meerdere mogelijkheden één nemen of een besluit nemen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "selectie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zal de blauwe trui <w>kiezen</w> voor het feest.",
                            "target_lang_translations": {
                                "en": "I will <w>choose</w> the blue sweater for the party.",
                                "de": "Ich werde den blauen Pullover für die Party <w>wählen</w>."
                            }
                        },
                        {
                            "text": "Je moet een van de opties <w>kiezen</w> die het beste bij je past.",
                            "target_lang_translations": {
                                "en": "You must <w>pick</w> one of the options that suits you best.",
                                "de": "Du musst eine der Optionen <w>auswählen</w>, die am besten zu dir passt."
                            }
                        }
                    ],
                    "synonyms": [
                        "selecteren",
                        "uitkiezen"
                    ],
                    "common_phrases": [
                        "een optie kiezen",
                        "moeilijk kunnen kiezen"
                    ],
                    "target_lang_definitions": {
                        "en": "To pick one from several possibilities or to make a decision.",
                        "de": "Aus mehreren Möglichkeiten eine auswählen oder eine Entscheidung treffen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "choose",
                                "target_lang_sense_clarification": "to select from options"
                            },
