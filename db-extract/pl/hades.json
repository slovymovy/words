                "senses": [
                    {
                        "sense_id": "4dac79ba-53ed-30eb-b3bd-3ad73c53fc28",
                        "entry_id": "c5bf359f-f9e4-36f4-bc55-6080e2efc7d0",
                        "glosses": [
                            "podziemny świat zmarłych, świat pozagrobowy"
                        ],
                        "tags": [
                            "Ancient-Greek",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "dc8ac078-3c3b-4f82-8487-30d3a0b77fdc",
                                "sense_id": "4dac79ba-53ed-30eb-b3bd-3ad73c53fc28",
                                "text": "Hades otaczały liczne rzeki, z których najsławniejszą był Styks"
                            },
                            {
                                "example_id": "3adda8bd-0483-42ee-961b-66db1acfb11f",
                                "sense_id": "4dac79ba-53ed-30eb-b3bd-3ad73c53fc28",
                                "text": "Do Hadesu prowadziło z ziemi kilka wejść, na ogół były to pieczary lub rozpadliny skalne"
                            },
                            {
                                "example_id": "ad3b0a01-ca05-4d74-a9c7-0f625f0e919a",
                                "sense_id": "4dac79ba-53ed-30eb-b3bd-3ad73c53fc28",
                                "text": "W Hadesie duchy zmarłych wiodły smętny i mdły żywot"
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
                ],
                "translations": [
