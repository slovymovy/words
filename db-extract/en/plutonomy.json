                        "sense_id": "6003e26b-5b96-35ad-bd29-9a03cc446694",
                        "entry_id": "af789f13-f5d0-3703-a336-8ac68a2b1a9b",
                        "glosses": [
                            "The study of the production and distribution of wealth, or a society seen as dominated by such concerns."
                        ],
                        "tags": [
                            "countable",
                            "derogatory",
                            "sometimes",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1ed4bc03-da64-46e8-b110-8983c1605bcd",
                                "sense_id": "6003e26b-5b96-35ad-bd29-9a03cc446694",
                                "text": "On this side it [Socialism] is a crude compromise between the claims of labour and of capital — the hybrid child of Plutonomy and Communism."
                            },
                            {
                                "example_id": "a27d0d44-0fee-4085-80ba-8efd1a70e388",
                                "sense_id": "6003e26b-5b96-35ad-bd29-9a03cc446694",
                                "text": "The [Citigroup] analysts argued that the United States was evolving into a “plutonomy”—a top-heavy economic system where growth is driven primarily by a tiny, prosperous elite who consume an ever larger fraction of everything the economy produces."
                            },
                            {
                                "example_id": "7d769932-6d3f-4d32-ad27-f75e58c60372",
                                "sense_id": "6003e26b-5b96-35ad-bd29-9a03cc446694",
                                "text": "Since his [Ajay Kapur's] very first paper in 2005—and he has kept publishing them, through a series of different employers—he has highlighted the fact that, in its essence, plutonomy is about inequality."
                            }
                        ]
                    }
