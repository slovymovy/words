                        "source_sense_id": "b68eb4be-6d6a-301e-97f5-3101cca75884",
                        "target_lang_word": "Reithose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reithose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59821ee6-ade9-3cb5-b84e-6767e157a4f1",
                                        "entry_id": "38ca83cf-60b0-3484-b88b-c803d9eab59e",
                                        "glosses": [
                                            "an den Waden eng anliegende, sehr feste, am Gesäß mit Lederbesatz verstärkte Hose, die mit Stiefeln getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc7cbda6-eab8-47b7-98af-ba8bf7a6a529",
                                                "sense_id": "59821ee6-ade9-3cb5-b84e-6767e157a4f1",
                                                "text": "In Reitstiefeln, Reithose und mit Reitkappe reden sie auf ihre Pferde ein, striegeln sie, streicheln sie und führen sie von der Koppel für den wöchentlichen Ausritt."
                                            },
                                            {
                                                "example_id": "a23ecd8a-eedb-45ee-aff6-790798a5ccb3",
                                                "sense_id": "59821ee6-ade9-3cb5-b84e-6767e157a4f1",
                                                "text": "Coco Chanel hat sich die Reithose noch von einem Mann klauen müssen."
                                            },
                                            {
                                                "example_id": "e3b8ac15-d3b7-4911-a15e-4645becec3bc",
                                                "sense_id": "59821ee6-ade9-3cb5-b84e-6767e157a4f1",
                                                "text": "Die argentinischen Reithosen, bombachas, und andere Reitsportartikel bekommt man in den talabarterías überall im Land."
                                            },
                                            {
                                                "example_id": "51f66e71-758c-47ce-81ad-578e7a7765b7",
                                                "sense_id": "59821ee6-ade9-3cb5-b84e-6767e157a4f1",
                                                "text": "Sie trägt eine Reithose, schwarze Stiefel und einen dicken Fleecepullover – richtige Reitklamotten."
                                            },
                                            {
                                                "example_id": "ee976b44-fb91-45f7-9359-39ad4ac6d020",
                                                "sense_id": "59821ee6-ade9-3cb5-b84e-6767e157a4f1",
                                                "text": "In unseren Reithosen und Funktionsjacken wirken wir wie Exoten zwischen den traditionellen Djellabas und den typischen Zipfelkapuzen, die von den Einwohnern getragen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
