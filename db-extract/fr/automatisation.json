                                "target_senses": [
                                    {
                                        "sense_id": "db0fdd0f-4d44-3ec5-8b7c-7a98d4b29e41",
                                        "entry_id": "88e59a1d-697f-3a60-bf26-10e37f406513",
                                        "glosses": [
                                            "The act or process of converting the controlling of a machine or device to a more automatic system, such as computer or electronic controls."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd577edf-4d55-49d9-9ae6-e29ffa0f0c89",
                                                "sense_id": "db0fdd0f-4d44-3ec5-8b7c-7a98d4b29e41",
                                                "text": "The presidential campaign has been more focused on Bain Capital and an “apology tour” than on the challenges created by globalization and automation."
                                            },
                                            {
                                                "example_id": "cddea5ba-c1e5-42c3-8752-aa39ec0731be",
                                                "sense_id": "db0fdd0f-4d44-3ec5-8b7c-7a98d4b29e41",
                                                "text": "When deployed by monopolies / cartels, automation institutionalizes mediocrity, and soon everyone forgets excellence and quality because they no longer have any experience of either one."
                                            }
                                        ]
                                    }
