        "fr-extract.jsonl": [
            {
                "entry_id": "e83a99c5-4669-3e67-b45e-fa574541f82f",
                "word": "larmier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5b0e2634-15a7-4ad9-b370-3d05bfcacce2",
                        "entry_id": "e83a99c5-4669-3e67-b45e-fa574541f82f",
                        "tags": [
                            "plural"
                        ],
                        "form": "larmiers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b5c5e35-d194-3a4a-80e7-27995572be9e",
                        "entry_id": "e83a99c5-4669-3e67-b45e-fa574541f82f",
                        "glosses": [
                            "Partie saillante en haut d’un édifice, d’un ouvrage de maçonnerie, destinée à écarter du mur les eaux pluviales en les faisant s’égoutter à distance convenable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "651b1072-a4a6-4638-bc41-93285e9584cc",
                                "sense_id": "5b5c5e35-d194-3a4a-80e7-27995572be9e",
                                "text": "Les cordons, consistant en chaînes horizontales isolées et peu profondes, font souvent office de larmiers."
                            },
                            {
                                "example_id": "22a835a8-de83-47ec-95ac-1d6087eec20d",
                                "sense_id": "5b5c5e35-d194-3a4a-80e7-27995572be9e",
                                "text": "Chaque section vivait une vie de rat, sans voir le ciel autrement que par le larmier, dans des pâtés de maisons percées, communiquant l’une avec l'autre par le dessous."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ed93942-1881-3d3a-989d-7bb8b245bf63",
                        "entry_id": "e83a99c5-4669-3e67-b45e-fa574541f82f",
                        "glosses": [
                            "Encoche pratiquée par exemple sous un appui de fenêtre, pour éviter que l’eau qui coule dessous suive l’appui jusqu’au mur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "045c35ef-9a3f-4ede-8be5-63df187a3c9c",
                                "sense_id": "6ed93942-1881-3d3a-989d-7bb8b245bf63",
                                "text": "Son autre main, en passant, glisse un doigt sous les appuis des fenêtres des rez-de-chaussée. Il vérifie s’il y a la goutte. La goutte d’eau. Le larmier. Enfin, quoi, la cannelure qui rejette la pluie dégoulinante loin du mur et l’empêche de dessiner à la longue d’horribles moustaches noires et de faire péter le ravalement au gel."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8911ca9-42ce-3f43-a9bf-b23bb9398a60",
                        "entry_id": "e83a99c5-4669-3e67-b45e-fa574541f82f",
                        "glosses": [
                            "Angle interne de l’œil d’où s’écoulent les larmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e407e8a2-b3c1-48ec-ab8d-2034ce9c3fb0",
                                "sense_id": "d8911ca9-42ce-3f43-a9bf-b23bb9398a60",
                                "text": "Il eût été malaisé de se prononcer, à voir sa chevelure en désordre, sa face machurée, sa barbe en broussailles, ses sourcils épais comme deux brosses à crins rougeâtres, ses yeux pers, entre le vert et le bleu, et dont le larmier humide était circonscrit du cercle sénile."
                            },
                            {
                                "example_id": "a01d94bb-bc37-468f-adfd-77855bc055a0",
                                "sense_id": "d8911ca9-42ce-3f43-a9bf-b23bb9398a60",
                                "text": "Mon Rêve s’aboucha souvent à sa ventouse ;\nMon âme, du coït matériel jalouse,\nEn fit son larmier fauve et son nid de sanglots."
                            }
                        ]
                    },
                    {
                        "sense_id": "c93b7267-649c-3036-a456-23844d9ec59b",
                        "entry_id": "e83a99c5-4669-3e67-b45e-fa574541f82f",
                        "glosses": [
                            "Glande située à l’angle interne de l’œil des cervidés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34e99b46-196d-4f6c-986a-f880151ef1e1",
                                "sense_id": "c93b7267-649c-3036-a456-23844d9ec59b",
                                "text": "… il suffoque dans l’odeur musquée du gibier aux abois, dans l’arôme du larmier, huileux et entêtant à l’époque des amours, …."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6a93dc6-086f-33f7-934f-7c91ce7b05a7",
                        "entry_id": "e83a99c5-4669-3e67-b45e-fa574541f82f",
                        "glosses": [
                            "Soupirail."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
