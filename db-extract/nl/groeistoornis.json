                        "examples": [
                            {
                                "example_id": "b2f1358e-4886-4564-a417-1f2c58cc470b",
                                "sense_id": "21d0a726-8e6b-36f8-bc27-e184b0384c3c",
                                "text": "Een reuzenpaling lijkt Winter „onwaarschijnlijk”. Ze worden niet langer dan 1,10 meter, vertelt hij. „De grootste die ooit is gevangen, in het Markermeer, was 1 meter 30 en zo dik als mijn dijbeen. Maar die had duidelijk een groeistoornis. Bovendien is dat nog steeds geen monster.”"
                            },
                            {
                                "example_id": "0471c06e-0278-45d8-ba52-851b2d9283da",
                                "sense_id": "21d0a726-8e6b-36f8-bc27-e184b0384c3c",
                                "text": "Zo kan je kinderen oestrogeen toedienen: dat wordt al ingezet om de botgroei vroegtijdig stil te zetten bij een groeistoornis."
                            },
                            {
                                "example_id": "1fc27e39-3898-4c54-8c92-216f84af8751",
                                "sense_id": "21d0a726-8e6b-36f8-bc27-e184b0384c3c",
                                "text": "Scott stond bekend om zijn hoge, kinderlijke stem, die het gevolg was van een groeistoornis. De zanger was lange tijd niet groter dan 1,50 meter. Tot hij op zijn 37ste nog 20 centimeter groeide."
                            }
                        ]
                    }
