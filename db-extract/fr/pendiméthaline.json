                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "52890e19-9cf4-4bea-b853-6eb9a9c8b24c",
                                "sense_id": "5abc1a22-6a96-348f-ac3f-fa9495ed3689",
                                "text": "Sur le plan anti-dicotylédone, BASF met sur la marché le picolinafen. Cette matière active est associée à la pendiméthaline constituant ainsi un herbicide à large spectre antidicotylédone, doté d'effets secondaires sur graminées."
                            }
                        ]
                    }
