                "senses": [
                    {
                        "sense_id": "d222f48c-65e9-35f9-8c1a-6764c77a27eb",
                        "entry_id": "a2d2d3a1-4319-3694-aefa-45f538f25e3a",
                        "glosses": [
                            "Raffiner, façonner, contourner avec préciosité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03f6692a-f1c4-4b37-8f22-5b3ac84f67b1",
                                "sense_id": "d222f48c-65e9-35f9-8c1a-6764c77a27eb",
                                "text": "Au surplus, c’est surtout au collier que je tiens, au collier en bois tarabiscoté que les bergers travaillent eux-mêmes."
                            },
                            {
                                "example_id": "55268ee2-1146-47fd-a5df-c0146663ceb1",
                                "sense_id": "d222f48c-65e9-35f9-8c1a-6764c77a27eb",
                                "text": "L’approbation du projet de loi 96 jusqu’au sommet même du pouvoir politique canadien tarabiscote les élites anglophones bien plus durement que les agissements d’un François Legault, dont ils n’attendent de toute manière que le pire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a58505e-fc6e-4c4e-90d7-754c77900284",
                        "source_entry_id": "a2d2d3a1-4319-3694-aefa-45f538f25e3a",
                        "source_sense_id": "d222f48c-65e9-35f9-8c1a-6764c77a27eb",
