                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bce6ffbc-f054-4c36-ae19-91d6144ca57d",
                                                "sense_id": "6808a91c-af7c-321d-849d-761807952dd8",
                                                "text": "Wenn ihr euch beeilt, erwischt ihr den Bus noch."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a7aced0e-7b45-36af-990c-c94eb8acdf85",
