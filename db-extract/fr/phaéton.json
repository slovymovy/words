                                            {
                                                "example_id": "176b4a7c-1a82-4869-91f9-842bbaeeac83",
                                                "sense_id": "16c205e4-c131-3f0f-9ffa-01989af7d51c",
                                                "text": "It had been settled that Lorraine was to drive Emily in his phaeton. It is true the sun was full in her eyes, the wind high, and the dust, which is just mud in high spirits, flew round them in clouds; but Emily found her ride delightful."
                                            },
                                            {
                                                "example_id": "64acca02-fe67-47f7-85aa-c9071d1295ac",
                                                "sense_id": "16c205e4-c131-3f0f-9ffa-01989af7d51c",
                                                "text": "...I saw the girls of Nob Hill on their way to school, kicking pebbles at each other and laughing; I saw young ladies coming home past curfew in their beaus' phaetons..."
                                            }
                                        ]
                                    },
