                ],
                "senses": [
                    {
                        "sense_id": "91ca0684-6db3-3fa3-a9aa-d9a23d421656",
                        "entry_id": "efb0610b-0b29-3e7e-8a81-76e205440c86",
                        "glosses": [
                            "Bücher- und Zeitschriftenbestand zum Spiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de4b5c23-484c-44d0-80f3-c71a84fc8bfd",
                                "sense_id": "91ca0684-6db3-3fa3-a9aa-d9a23d421656",
                                "text": "„Spielplätze in jedem Stadtteil, aber auch in Waldlichtungen, Spielgeräte und Spielzeuge aller Schattierungen, eine Flut pädagogischer Spielliteratur, Kinder- bzw. Spielsendungen im Fernsehen, extra eingerichtete Spielzimmer usw. umstellen wohlwollend die Welt der Kinder.“"
                            },
                            {
                                "example_id": "e9ac4d6f-b626-434f-86da-d8a2f1cc7123",
                                "sense_id": "91ca0684-6db3-3fa3-a9aa-d9a23d421656",
                                "text": "„Wir finden in der umfangreichen Spielliteratur der Interaktionspädagogik Verhaltenstechniken beschrieben, die neue Formen sozialen Lernens im Spiel ermöglichen.“"
                            },
                            {
                                "example_id": "49a28dd6-350a-4ea9-bec6-2c6386e28f6b",
                                "sense_id": "91ca0684-6db3-3fa3-a9aa-d9a23d421656",
                                "text": "„Immer wieder wird jedoch in der Diskussion um Musikklassenunterricht der Wunsch artikuliert, Spielliteratur und methodisch-didaktische Handreichungen enger miteinander zu verbinden.“"
                            },
                            {
                                "example_id": "a0c44cbb-3a19-4ffb-8ae5-285b49ba2b14",
                                "sense_id": "91ca0684-6db3-3fa3-a9aa-d9a23d421656",
                                "text": "„Die von ihm konstruierte Definition für den Terminus Spiel ist vermutlich die meist zitierte in der gesamten Spielliteratur.“"
                            },
                            {
                                "example_id": "8455b857-d77f-41a0-ac1c-00e6b698ae43",
                                "sense_id": "91ca0684-6db3-3fa3-a9aa-d9a23d421656",
                                "text": "„Auch hinsichtlich der Wahl der Spielliteratur im Unterricht gilt, dass die Entscheidung für oder gegen ein Stück freiwillig und ohne Zwang geschehen muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
