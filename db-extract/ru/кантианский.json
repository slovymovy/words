                                    {
                                        "sense_id": "1c2028fd-b303-37b9-89b3-a31e62ce12b1",
                                        "entry_id": "f1a48296-b841-30f9-b61b-cc051f636dd1",
                                        "glosses": [
                                            "auf Immanuel Kant ^(→ WP) bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "076f6e38-0591-4d5c-81e8-4a220f9b0278",
                                                "sense_id": "1c2028fd-b303-37b9-89b3-a31e62ce12b1",
                                                "text": "Die kantische Ethik ist eine der dominierenden praktischen Philosophien."
                                            }
