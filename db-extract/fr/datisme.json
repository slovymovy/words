                "senses": [
                    {
                        "sense_id": "3a7b8fc2-1f90-3a98-b197-7f9958bb7a56",
                        "entry_id": "4af3f7bc-481c-3177-9fdc-c40adc02fce3",
                        "glosses": [
                            "Tautologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a5a305d-57ac-4612-82ac-7d9c57dacfa6",
                                "sense_id": "3a7b8fc2-1f90-3a98-b197-7f9958bb7a56",
                                "text": "N'y a-t-il rien à reprocher à l’esprit de système, à la monotonie du rhythme, à l’excès de la plainte, à ce datisme perpétuel qui réitère la pensée sous mille expressions diverses sans la présenter toujours sous des aspects nouveaux ?"
                            },
                            {
                                "example_id": "b5ac02a3-a05d-4c10-98fa-8b9f3803c6be",
                                "sense_id": "3a7b8fc2-1f90-3a98-b197-7f9958bb7a56",
                                "text": "«C'est neuf, c’est tout nouveau, enfin ça vient juste de sortir» est un datisme, la même idée est répétée trois fois."
                            },
                            {
                                "example_id": "ba85d3b0-4ea5-4896-8fc0-269330632952",
                                "sense_id": "3a7b8fc2-1f90-3a98-b197-7f9958bb7a56",
                                "text": "Ces manières de parler, lorsqu’on en réunit plusieurs, forment des datismes."
                            }
                        ]
                    }
                ],
