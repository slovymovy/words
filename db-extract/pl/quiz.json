                                        "glosses": [
                                            "Frage-und-Antwort-Spiel, bei dem die Antworten meist innerhalb einer vorgeschriebenen Zeit gegeben werden müssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47d9e243-96c0-4a02-9d5f-623be741f7a0",
                                                "sense_id": "9e2db089-bf2b-303a-9c7a-1b13ddb8942c",
                                                "text": "Ich habe gestern bei einem Quiz über deutsche Geschichte 100 Euro gewonnen."
                                            },
                                            {
                                                "example_id": "33cc66bf-b45e-49ad-8aa6-75fedc0f5356",
                                                "sense_id": "9e2db089-bf2b-303a-9c7a-1b13ddb8942c",
                                                "text": "Er war bereit, an dem kniffligen Quiz teilzunehmen."
                                            },
                                            {
                                                "example_id": "d7c97619-84a9-4ce2-9fd4-c11ddc465aad",
                                                "sense_id": "9e2db089-bf2b-303a-9c7a-1b13ddb8942c",
                                                "text": "Ich habe für dich ein Quiz über die größten Städte Europas zusammengestellt."
                                            },
                                            {
                                                "example_id": "2672e0a6-30ab-4b91-8158-0822d9015122",
                                                "sense_id": "9e2db089-bf2b-303a-9c7a-1b13ddb8942c",
                                                "text": "„Zum Auswendiglernen hatte man ein Quiz entwickelt, das sich in Duellen untereinander per Mobiltelefon spielen ließ.“"
                                            },
                                            {
                                                "example_id": "3adb5392-e728-48f0-b952-54056c88118e",
                                                "sense_id": "9e2db089-bf2b-303a-9c7a-1b13ddb8942c",
                                                "text": "„Das Quiz mit 24 Fragen stellt sich aus Wichtigem, Interessantem und Verwunderlichem aus Leben und Werk Wolfgang Amadeus Mozarts zusammen.“"
                                            },
                                            {
                                                "example_id": "a2f82d77-cfe9-489e-aad7-1fcf6bee24dd",
                                                "sense_id": "9e2db089-bf2b-303a-9c7a-1b13ddb8942c",
                                                "text": "„Wissen Sie noch, welcher Song wann ein Hit in Charts und Clubs war? Zeigen Sie es hier im Quiz über die Topseller der vergangenen 25 Jahre.“"
                                            }
                                        ],
