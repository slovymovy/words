        "fr-extract.jsonl": [
            {
                "entry_id": "4a262ccf-4c79-3259-91c4-176a70111339",
                "word": "Tanger",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "87744c28-bbc2-3f19-8a78-072cdd40ff69",
                        "entry_id": "4a262ccf-4c79-3259-91c4-176a70111339",
                        "glosses": [
                            "Ville du Maroc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09e0fc30-bf17-4905-8c85-e3616ffc716b",
                                "sense_id": "87744c28-bbc2-3f19-8a78-072cdd40ff69",
                                "text": "Un steamer en partance emporta la missive du caïd Maclean à Tanger, d’où la légation d’Angleterre la transmit par le télégraphe à Gibraltar et au Foreign Office."
                            },
                            {
                                "example_id": "e3624dbb-1f9a-4a99-93e2-e7189b051e78",
                                "sense_id": "87744c28-bbc2-3f19-8a78-072cdd40ff69",
                                "text": "Malheureusement Raïssouli avait pris le large et, des montagnes où il s’était réfugié, il continua à terroriser Tanger, El-Kçar et Tetuan."
                            },
                            {
                                "example_id": "bc4d1798-bcea-4aa5-94b3-e38b0f5e5058",
                                "sense_id": "87744c28-bbc2-3f19-8a78-072cdd40ff69",
                                "text": "Ghania, originaire de Tanger, perpétue les gestes maintes fois répétés de sa mère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c35a66c0-d070-4a30-aa51-852190a315f7",
                        "source_entry_id": "4a262ccf-4c79-3259-91c4-176a70111339",
                        "source_sense_id": "87744c28-bbc2-3f19-8a78-072cdd40ff69",
                        "target_lang_word": "Tanger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tanger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae0a72f-8e30-38ef-aa58-cc80b3cd1c31",
                                        "entry_id": "27ce4385-57f6-3239-a2a2-812a4d33380b",
                                        "glosses": [
                                            "linker Nebenfluss der Elbe, der nach etwa 33 km in Tangermünde in die Elbe mündet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb1f99e-add7-438b-96d3-f4fd111498f0",
                                                "sense_id": "8ae0a72f-8e30-38ef-aa58-cc80b3cd1c31",
                                                "text": "„Mobile Ferienhäuser für das Camp stehen auf dem Platz am Tanger.“"
                                            },
                                            {
                                                "example_id": "91aa8353-96e6-45fb-a86f-f4d49d128392",
                                                "sense_id": "8ae0a72f-8e30-38ef-aa58-cc80b3cd1c31",
                                                "text": "„Neu ist deshalb, dass am Tanger und unterhalb der Schlossfreiheit Pkw maximal 9 Stunden parken dürfen.“"
                                            },
                                            {
                                                "example_id": "2ae58b1c-107b-406f-a5a9-645bfc9513c6",
                                                "sense_id": "8ae0a72f-8e30-38ef-aa58-cc80b3cd1c31",
                                                "text": "„Erstmals erwähnt wird die Burg im Jahr 1009 von Bischof Thietmar von Merseburg, der von der „civitas Tongeremuthi“ schreibt, von der Ansiedlung, wo der Tanger (Tongera) in die Elbe mündet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tanger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b98c959d-a6b0-36b7-97c8-60b79da58b4d",
                                        "entry_id": "a3b60be0-c363-32e0-8292-8f00ff88deb1",
                                        "glosses": [
                                            "Stadt in Marokko"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f350bbd9-f5f5-4f43-a38b-5af93f0bbfdb",
                                                "sense_id": "b98c959d-a6b0-36b7-97c8-60b79da58b4d",
                                                "text": "Tanger liegt in Marokkos Norden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
