                            {
                                "example_id": "a19e12b5-f8ad-4091-ac19-75b9fa765ea0",
                                "sense_id": "6c5dca40-743c-3e4b-a861-c9e6b7e740ee",
                                "text": "Minister van Buitenlandse Zaken Mike Pompeo richtte eerder al een speciale taskforce op om de 'onverklaarde gezondheidsincidenten' te onderzoeken."
                            },
                            {
                                "example_id": "1940552a-3f32-4705-b830-05e7ed17b6c4",
                                "sense_id": "6c5dca40-743c-3e4b-a861-c9e6b7e740ee",
                                "text": "De autoriteiten hebben ongeveer 2500 mensen geëvacueerd sinds het begin van de vulkaanuitbarsting, ruim een maand geleden. De autoriteiten roepen een taskforce in het leven die een herstelplan moet opstellen voor de zwaar getroffen gemeenschappen, maakten Kim en gouverneur David Ige bekend."
                            }
                        ]
                    },
                    {
