                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce84c541-6e97-450c-bfbf-cc92a7e28726",
                                "sense_id": "f3ee4420-5c49-3d5e-9ab6-0130f96852b2",
                                "text": "Après Jean-Marie Lacaux et ses romans policiers, c’est au tour d’Arlette Vergne-Roubertou de sortir son deuxième ouvrage grâce à un coup de vent qui a arraché un arbre du jardin familial."
                            }
                        ]
                    }
