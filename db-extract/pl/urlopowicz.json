                                "target_senses": [
                                    {
                                        "sense_id": "c48c1d4a-ca23-3d95-a991-3876fbc8679c",
                                        "entry_id": "e56e7341-820c-35ec-b315-ccfd1f9177cf",
                                        "glosses": [
                                            "Qui concerne les vacances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f09895c-680c-4262-86e2-2b26807fd451",
                                                "sense_id": "c48c1d4a-ca23-3d95-a991-3876fbc8679c",
                                                "text": "Souvenirs vacanciers."
                                            },
                                            {
                                                "example_id": "0857aea5-cfac-4c98-a047-f33948d807e7",
                                                "sense_id": "c48c1d4a-ca23-3d95-a991-3876fbc8679c",
                                                "text": "Les jumelles entrent en fonction. L'étrange plaisir que de voir ainsi sans être vu, de sauter de loin au visage des gens ! Je l'ai fait cent fois en vacances, mais au détriment de personnages de cartes postales, de baigneuses sortant de l'eau, de couples superposés dans l'herbe, bref d'anonymes dont la neutralité vacancière fait oublier que l'homme est un chasseur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vacancier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf041508-2cd6-31a2-a2f6-8073e05e6e90",
                                        "entry_id": "a525b10d-035f-3600-8f7a-7451a7f0792c",
                                        "glosses": [
                                            "Personne qui est en vacances, qui prend des vacances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6530250f-88f5-4829-96af-cb6088a1ad40",
                                                "sense_id": "cf041508-2cd6-31a2-a2f6-8073e05e6e90",
                                                "text": "Elle, elle était du côté des « vacanciers », des campeurs, de ceux qui vont et viennent, même les riches qui descendent dans les grands hôtels."
                                            },
                                            {
                                                "example_id": "155104e7-3142-4100-b00a-e61c2c9dfb04",
                                                "sense_id": "cf041508-2cd6-31a2-a2f6-8073e05e6e90",
                                                "text": "C’est pourquoi il faut bien distinguer vacances et voyages et par voie de conséquence le touriste du vacancier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03f951cb-dec7-4023-a15a-b8bd616a5572",
                        "source_entry_id": "109f23e0-bcf9-3fc4-bea8-999845db267e",
                        "source_sense_id": "8d992931-4e48-3bb5-8779-d12f28d40eb0",
                        "target_lang_word": "Urlaub",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urlaub",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d34c734c-f23c-35bf-9617-e5d974b1cd79",
                                        "entry_id": "8ea8b66e-5b4d-356b-8ea0-aabade1d4043",
                                        "glosses": [
                                            "die vom Arbeitgeber dem abhängig Beschäftigten oder Dienstherrn dem Unterstellten gewährte Freizeit in Höhe von einem oder meist mehreren Werktagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "857da9e8-4b6b-4161-8a3a-1cd4db741f66",
                                                "sense_id": "d34c734c-f23c-35bf-9617-e5d974b1cd79",
                                                "text": "Für den Umzug nehme ich mir Urlaub."
                                            },
                                            {
                                                "example_id": "1540e4d7-77b1-4af3-b17b-9a79efdd91cd",
                                                "sense_id": "d34c734c-f23c-35bf-9617-e5d974b1cd79",
                                                "text": "„Ihr Engagement jedenfalls hatte zur Folge gehabt, daß er sie in seinem Urlaub sehr wenig sah: sechs Abende in der Woche Vorstellung und obendrein zweimal Matinée, da blieb kaum Zeit für ihn übrig, …“"
                                            },
                                            {
                                                "example_id": "1e43c9cb-363f-4089-b6f9-100eeeb35907",
                                                "sense_id": "d34c734c-f23c-35bf-9617-e5d974b1cd79",
                                                "text": "„Und wenn er dem Bettelnden nichts gibt, weil er sich selbst den Urlaub oder die Wochenendfahrt vom Munde abgespart hat, weil er im Schweiße seines Angesichts sein Brot verdient und sich keiner für ihn und den anderen erbarmt, so bleiben doch beide ohne die Nächstenliebe.“"
                                            },
                                            {
                                                "example_id": "7844b3c8-d75c-44f4-b596-6d816c13cec8",
                                                "sense_id": "d34c734c-f23c-35bf-9617-e5d974b1cd79",
                                                "text": "„Die erregendste Seite des Berufslebens ist zweifellos der Urlaub.“"
                                            },
                                            {
                                                "example_id": "9d586ce6-e387-4e3a-9c84-249ab2748156",
                                                "sense_id": "d34c734c-f23c-35bf-9617-e5d974b1cd79",
                                                "text": "„Nikolai brachte seinen ganzen Urlaub bei seinen Angehörigen zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4391cef6-7389-3410-852d-5d3ba18f6c3a",
                                        "entry_id": "8ea8b66e-5b4d-356b-8ea0-aabade1d4043",
                                        "glosses": [
                                            "die vom Arbeitgeber dem abhängig Beschäftigten oder Dienstherrn dem Unterstellten gewährte Freizeit in Höhe von einem oder meist mehreren Werktagen",
                                            "im wirtschaftlichen, zivilen Bereich, in Behörden"
                                        ],
                                        "tags": [],
