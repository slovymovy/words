                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "doze",
                                "target_lang_sense_clarification": "to sleep lightly"
                            },
                            {
                                "target_lang_word": "nod off",
                                "target_lang_sense_clarification": "to fall asleep unintentionally"
                            }
                        ]
                    }
                }
            ]
        }
