                            {
                                "example_id": "b5069d9b-5177-4658-b76e-dc46a17504bf",
                                "sense_id": "ce3dfa3b-335d-3db4-84a2-e52f7aedd217",
                                "text": "Zij was een alleenstaande vrouw."
                            },
                            {
                                "example_id": "ba21df71-25ee-45df-b4f8-5fcd17922e57",
                                "sense_id": "ce3dfa3b-335d-3db4-84a2-e52f7aedd217",
                                "text": "Van Lohuijzen, biseksueel en alleenstaand, was naar eigen zeggen getrouwd met het Woord. Dat huwelijk had een schare vrienden opgeleverd van wie een aanzienlijk deel tijdens de Duitse bezetting lid was geweest van de Nederlandse Kultuurkamer."
                            }
                        ]
                    },
