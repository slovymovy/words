                    {
                        "sense_id": "057b3560-9ac4-38e3-97ce-e6f72158521b",
                        "entry_id": "e0df122c-194b-319c-b5dc-834ca76b0d1f",
                        "glosses": [
                            "Bien aller, bien se passer."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "579d1c2f-32bc-47da-b6ce-6df36491d66b",
                                "sense_id": "057b3560-9ac4-38e3-97ce-e6f72158521b",
                                "text": "Quand ça gaze à ce point, « ça cloppe » en Belgique, ça marche « comme sur de la soie » à Amsterdam, « comme sur des roulettes » à Paname, « comme sur du beurre » à Moscou, « tout bien huilé » à Rio : en somme, tout baigne et glisse joyeusement dans l’huile et le gras."
                            }
                        ]
