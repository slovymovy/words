                "senses": [
                    {
                        "sense_id": "f0e3445a-f404-32fa-9c1f-b8c59a02ad92",
                        "entry_id": "4ead4b39-5a31-3336-b1d6-5b7a16ad70c2",
                        "glosses": [
                            "Ancienne colonie française d’Indochine, correspondant à la partie septentrionale du Viêt Nam actuel (les deux autres parties étant l’Annam et la Cochinchine)."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "f0172f75-2284-4e90-872c-30cc3ea5d9a4",
                                "sense_id": "f0e3445a-f404-32fa-9c1f-b8c59a02ad92",
                                "text": "L’anis étoilé ou badiane croît au Tonkin, en Annam, dans la Chine du Sud."
                            },
                            {
                                "example_id": "33b8d76b-ebed-49da-9de3-375977aa9e01",
                                "sense_id": "f0e3445a-f404-32fa-9c1f-b8c59a02ad92",
                                "text": "Jean Golfier, capitaine, est mort au combat le 15 novembre 1952 à Boc Hen, secteur de Lai Than (Tonkin) à 35 ans."
                            },
                            {
                                "example_id": "3f862def-2c27-4e19-9cbc-d009e19379f4",
                                "sense_id": "f0e3445a-f404-32fa-9c1f-b8c59a02ad92",
                                "text": "Aucune grande opération n’était prochaine dans ce Tonkin, — pourtant les renforts qui arrivaient ne suffisaient pas, — alors on prenait à bord des navires tout ce qu’ils pouvaient encore donner pour compléter les compagnies de marins déjà débarquées."
                            }
                        ]
                    }
