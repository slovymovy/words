                        "glosses": [
                            "Le milieu de la nuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e32991a-8211-4753-b45a-50827962631c",
                                "sense_id": "8a15d8de-af36-3fca-b310-8c5635094733",
                                "text": "Mon père avait disparu. Je pense qu’il était allé se promener dans le quartier. On ne le revit que vers la mi-nuit."
                            },
                            {
                                "example_id": "b50f57c2-49b4-4b78-a6ca-4e01c742cda9",
                                "sense_id": "8a15d8de-af36-3fca-b310-8c5635094733",
                                "text": "Vers la mi-nuit, une rumeur qui lui sembla immense lui parvint : les bruits réguliers des pas d’une troupe approchaient."
                            }
                        ]
                    }
