                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9800fa3-df64-3e9e-a490-1e19e8c9fe07",
                        "entry_id": "648aba99-08ef-345c-b045-2e8a762d0522",
                        "glosses": [
                            "onomatopeja, cichy dźwięk towarzyszący poruszaniu się liści, kartek papieru, sztywnych tkanin itp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45fde814-80a2-4820-8a55-9a6b49901f25",
                                "sense_id": "c9800fa3-df64-3e9e-a490-1e19e8c9fe07",
                                "text": "Zabłysnęło światło latarki, dobiegły odgłosy rozmowy i szelest rozwijanego papieru."
                            },
                            {
                                "example_id": "55bd0f69-9e23-48aa-8234-c8fcdc7d7796",
                                "sense_id": "c9800fa3-df64-3e9e-a490-1e19e8c9fe07",
                                "text": "Pod koniec seansu prawie nic nie usłyszałem, jedynie sam szelest zwijanych torebek po popcornie i chipsach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57306ab1-a6c5-47f2-98b9-8371aeead63d",
                        "source_entry_id": "648aba99-08ef-345c-b045-2e8a762d0522",
                        "source_sense_id": "c9800fa3-df64-3e9e-a490-1e19e8c9fe07",
                        "target_lang_word": "rustle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rustle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f65910b-92f2-3c4e-9d27-2da44a013505",
                                        "entry_id": "1be8a3ea-6018-3138-a654-6c581f929481",
                                        "glosses": [
                                            "A soft crackling sound similar to the movement of dry leaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af3ee78-5880-4a76-a3d1-e7b51f4ef070",
                                                "sense_id": "2f65910b-92f2-3c4e-9d27-2da44a013505",
                                                "text": "He heard the silken rustle of a dressing-gown being drawn on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eeeac5c-9345-320e-9f70-819a801bb7bb",
                                        "entry_id": "1be8a3ea-6018-3138-a654-6c581f929481",
                                        "glosses": [
                                            "A movement producing such a sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rustle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3aff0598-2450-3b38-8563-fd6fb5f7f225",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To move (something) with a soft crackling sound."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd03a0fb-4128-4447-8a6f-9488e2ff46f5",
                                                "sense_id": "3aff0598-2450-3b38-8563-fd6fb5f7f225",
                                                "text": "The next day at three o'clock we were again at the door, and the footmen as before; we heard the silk dress rustle, and the lady came down the steps and in an imperious voice, she said, \"York, you must put those horses' heads higher, they are not fit to be seen.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d5be6e-daf2-3f3f-978e-215ab7d7a817",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To make or obtain in a lively, energetic way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "982d36d9-73ef-4d3e-9abb-6dd2ce90d938",
                                                "sense_id": "c3d5be6e-daf2-3f3f-978e-215ab7d7a817",
                                                "text": "When at last the lumber was piled again in its rightful place, and the boxes of food had been returned to the shelter from which they had been stolen, the two friends rustled a meal, and then set off on horseback […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb0de50-dfb9-3308-9d43-ff3a9af9c952",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To steal (cattle or other livestock)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3026251-df17-4930-8813-dbed5ad1542f",
                        "source_entry_id": "648aba99-08ef-345c-b045-2e8a762d0522",
                        "source_sense_id": "c9800fa3-df64-3e9e-a490-1e19e8c9fe07",
                        "target_lang_word": "Geraschel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8269badb-9c29-470a-917a-c47a3f664b18",
                        "source_entry_id": "648aba99-08ef-345c-b045-2e8a762d0522",
                        "source_sense_id": "c9800fa3-df64-3e9e-a490-1e19e8c9fe07",
                        "target_lang_word": "шелест",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шелест",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b7fb706c-6392-3ecc-9aaa-d0201da78738",
                                        "entry_id": "8834cf89-e540-3dcc-b0de-9e840b273800",
                                        "glosses": [
                                            "глухой звук, напоминающий шуршание листьев; шорох"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a6c2800-cdb6-41e9-bd1b-d8b16586a8d7",
                                                "sense_id": "b7fb706c-6392-3ecc-9aaa-d0201da78738",
                                                "text": "Точно напряжённый шёпот, не смолкает надо мною порывисто усиливающийся шум и шелест деревьев."
                                            },
                                            {
                                                "example_id": "90c797fc-02a1-47d3-b7f3-63b52e6b3f7d",
                                                "sense_id": "b7fb706c-6392-3ecc-9aaa-d0201da78738",
                                                "text": "Лёгкий шорох, подобный шелесту женского платья, поднимался по временам в верхушках близких деревьев и возбуждал в Берсеневе ощущение сладкое и жуткое, ощущение полустраха."
                                            },
                                            {
