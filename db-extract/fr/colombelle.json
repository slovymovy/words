                "senses": [
                    {
                        "sense_id": "cabfb2c6-ee75-3906-9422-79fc2d3d3ef2",
                        "entry_id": "8156e4fa-bd1a-3d4c-8bcb-8f8e7c401868",
                        "glosses": [
                            "Espace vertical séparant deux colonnes de texte."
