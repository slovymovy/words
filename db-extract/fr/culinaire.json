        "fr-extract.jsonl": [
            {
                "entry_id": "0b3b3a31-6e8d-36bf-9bda-34d52f6daeb4",
                "word": "culinaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f2782d28-7de8-43c1-b2ca-ddd0e415c837",
                        "entry_id": "0b3b3a31-6e8d-36bf-9bda-34d52f6daeb4",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "culinaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b33eeb5-15d2-36e5-a555-0243f1520aab",
                        "entry_id": "0b3b3a31-6e8d-36bf-9bda-34d52f6daeb4",
                        "glosses": [
                            "Qui a rapport à la cuisine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0078004f-4081-417c-85d4-b8ebaf24aa0d",
                                "sense_id": "6b33eeb5-15d2-36e5-a555-0243f1520aab",
                                "text": "Les femelles fournissaient un lait abondant à Mrs. Joliffe, qui l'employait journellement dans ses préparations culinaires."
                            },
                            {
                                "example_id": "6456888e-43a4-435f-b0c9-f719b2cf8269",
                                "sense_id": "6b33eeb5-15d2-36e5-a555-0243f1520aab",
                                "text": "Enfin, la rubrique Rencontre fait la part belle à l’art culinaire dont Guy Savoy, chef triplement étoilé, parle avec passion en nous racontant son parcours personnel et professionnel."
                            },
                            {
                                "example_id": "d16d7ca5-3ec1-4c8e-ac14-848bfe64f0f2",
                                "sense_id": "6b33eeb5-15d2-36e5-a555-0243f1520aab",
                                "text": "Unique aromate de la cuisson des grives, la sauge avait son petit buisson au jardin. Elle sortait du domaine culinaire pour entrer dans la pharmacopée domestique – au même titre que de nombreuses plantes aromatiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bb9d0b8-7655-4d65-8ba5-f3014393ccd5",
                        "source_entry_id": "0b3b3a31-6e8d-36bf-9bda-34d52f6daeb4",
                        "source_sense_id": "6b33eeb5-15d2-36e5-a555-0243f1520aab",
                        "target_lang_word": "Kochkunst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kochkunst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bd321c2-f548-3aca-8077-f5ba40158d46",
                                        "entry_id": "bf42035f-3420-3d7a-ba95-8760f0909ab1",
                                        "glosses": [
                                            "die Kunst, das Handwerk der Speisenzubereitung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2070f989-168d-4b7b-9d87-af26522c6690",
                                                "sense_id": "4bd321c2-f548-3aca-8077-f5ba40158d46",
                                                "text": "Er beherrscht die Kochkunst aus dem Effeff."
                                            },
                                            {
                                                "example_id": "c2346594-c75d-44c9-b53d-4eb73bd6ef76",
                                                "sense_id": "4bd321c2-f548-3aca-8077-f5ba40158d46",
                                                "text": "Die Kochkunst der Franzosen ist legendär."
                                            },
                                            {
                                                "example_id": "e64182ad-3bec-4c32-a0a7-1beaddbcc8c0",
                                                "sense_id": "4bd321c2-f548-3aca-8077-f5ba40158d46",
                                                "text": "„Die Kochkunst der französischen Hofküche übte ebenfalls einen großen Einfluss sowohl auf die Auswahl der Speisen in den Küchen der deutschen Fürstenhöfe als auch auf die Bezeichnungen der Gerichte selbst und sogar auf die zur Zubereitung benötigten Küchengeräte aus.“"
                                            },
                                            {
                                                "example_id": "53b22c3b-e5b0-4e86-bb28-0844dd3eac26",
                                                "sense_id": "4bd321c2-f548-3aca-8077-f5ba40158d46",
                                                "text": "„Der älteste Sohn wird Anfang des neuen Jahrhunderts jene Konservierungsmethode entdecken, die dann die Kochkunst revolutioniert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ba7ac9de-cf27-3484-b95b-0f3cc2d57c1d",
                                        "entry_id": "bf42035f-3420-3d7a-ba95-8760f0909ab1",
                                        "glosses": [
                                            "die Fähigkeit einer Person, schmackhafte und optisch ansprechende Speisen zuzubereiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57919d07-f716-45ef-854b-1d5766af254b",
                                                "sense_id": "ba7ac9de-cf27-3484-b95b-0f3cc2d57c1d",
                                                "text": "Meine Kochkünste sind eher mittelmäßig."
                                            },
                                            {
                                                "example_id": "11814945-33cb-4239-b774-5267a822ea63",
                                                "sense_id": "ba7ac9de-cf27-3484-b95b-0f3cc2d57c1d",
                                                "text": "„Ama leckte sich die Suppe von den Fingern und gestand, dass Mama Eko mit ihrem Lob auf die Kochkünste des Hausmädchens nicht übertrieben hatte.“"
                                            },
                                            {
                                                "example_id": "2304c9c9-c2a4-4924-9c92-564e0a394369",
                                                "sense_id": "ba7ac9de-cf27-3484-b95b-0f3cc2d57c1d",
                                                "text": "„Alle loben den Mann für seine Kochkünste.“"
                                            },
                                            {
                                                "example_id": "4ba4ad1b-c479-48f9-aa4b-4fea83c8739f",
                                                "sense_id": "ba7ac9de-cf27-3484-b95b-0f3cc2d57c1d",
                                                "text": "„Mit deinen Kochkünsten könntest du wahrscheinlich die Welt verändern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
