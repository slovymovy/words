                    },
                    {
                        "form_id": "d6751774-4428-4154-a480-34274fa244c7",
                        "entry_id": "32bc75ea-7e5c-33b1-858c-d086d185c20f",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most dreadfully"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94c395d4-d4c6-3f08-be36-32cc3b26b906",
                        "entry_id": "32bc75ea-7e5c-33b1-858c-d086d185c20f",
                        "glosses": [
                            "In a dreadful manner; terribly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "599e71ce-9c61-4317-9274-e7f60bad3536",
                                "sense_id": "94c395d4-d4c6-3f08-be36-32cc3b26b906",
                                "text": "You behaved dreadfully yesterday night"
                            },
                            {
                                "example_id": "5018de07-1c29-47a5-bf53-d8fd4acc26bd",
                                "sense_id": "94c395d4-d4c6-3f08-be36-32cc3b26b906",
                                "text": "The smellful old heathen was snoring dreadfully."
                            }
                        ]
                    },
                    {
                        "sense_id": "620d5562-5732-39f9-9326-ec1bdcfb3569",
                        "entry_id": "32bc75ea-7e5c-33b1-858c-d086d185c20f",
                        "glosses": [
                            "Exceptionally, eminently, very much."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "bc17c583-6508-4475-bd7c-5edbc5ecfe97",
                                "sense_id": "620d5562-5732-39f9-9326-ec1bdcfb3569",
                                "text": "That restaurant seems dreadfully expensive."
                            },
                            {
                                "example_id": "decabd5a-c069-4871-9803-4f4bd460a01f",
                                "sense_id": "620d5562-5732-39f9-9326-ec1bdcfb3569",
                                "text": "At that moment a curious crack sounded inside the statue, as if something had broken. The fact is that the leaden heart had snapped right in two. It certainly was a dreadfully hard frost."
                            },
                            {
                                "example_id": "1d5283ef-8d94-49c7-9d46-05132f5adfe5",
                                "sense_id": "620d5562-5732-39f9-9326-ec1bdcfb3569",
                                "text": "“Here it is,” said Eddie. “‘Why Must it Always be Tomato Soup?’ It's so deeply true, don't you feel? Tomato soup is so dreadfully eternal.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40aa959f-7254-4cd6-a93c-3f0b0f08c7c2",
                        "source_entry_id": "32bc75ea-7e5c-33b1-858c-d086d185c20f",
                        "source_sense_description": "in a dreadful manner",
                        "target_lang_word": "terriblement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terriblement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a674b1b8-035b-3c9c-bbcd-1cb95a79b75b",
                                        "entry_id": "7cbde7a4-c2ac-30f5-a357-17157b012ee6",
                                        "glosses": [
                                            "De manière à inspirer de la terreur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c059ef9a-9171-4401-8f4b-25cb69432aad",
                                                "sense_id": "a674b1b8-035b-3c9c-bbcd-1cb95a79b75b",
                                                "text": "Il tonnait terriblement."
                                            },
                                            {
                                                "example_id": "4592a336-91cd-42cb-a0b8-460e90d3a28e",
                                                "sense_id": "a674b1b8-035b-3c9c-bbcd-1cb95a79b75b",
                                                "text": "[…] : alors ou la licence excessive, ou la patience poussée à l’extrémité, menacent terriblement les maisons régnantes."
                                            },
                                            {
                                                "example_id": "29396a6b-6206-47dd-b2b3-da44b178b63e",
                                                "sense_id": "a674b1b8-035b-3c9c-bbcd-1cb95a79b75b",
                                                "text": "La jalousie naturelle des Espagnols n’est point éteinte, et on hasarde terriblement la vie du jeune roi, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1f37437-2a56-3dfc-ad62-d216d6bcd765",
                                        "entry_id": "7cbde7a4-c2ac-30f5-a357-17157b012ee6",
                                        "glosses": [
                                            "Extrêmement, excessivement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9d05eb6-a2e9-411b-8b03-588ce4571bdb",
                                                "sense_id": "e1f37437-2a56-3dfc-ad62-d216d6bcd765",
                                                "text": "Le baromètre a baissé terriblement pendant la nuit et la matinée. Je m'attends à du gros temps."
                                            },
                                            {
                                                "example_id": "ad0d0d65-15b2-49b2-b8ef-b6c5fdc900c2",
                                                "sense_id": "e1f37437-2a56-3dfc-ad62-d216d6bcd765",
                                                "text": "Une telle bonté me donne à vous terriblement, pour parler à la mode, […]"
                                            },
                                            {
                                                "example_id": "fab42e43-e4b6-42c8-a955-923230169355",
                                                "sense_id": "e1f37437-2a56-3dfc-ad62-d216d6bcd765",
                                                "text": "Pour moi, j’aime terriblement les énigmes, […]"
                                            },
                                            {
                                                "example_id": "dc441025-9e1e-4198-9d77-35b175251810",
                                                "sense_id": "e1f37437-2a56-3dfc-ad62-d216d6bcd765",
                                                "text": "Il faut un peu rapaiser votre sang, qui a été terriblement ému pendant le voyage, […]"
                                            },
                                            {
                                                "example_id": "d1f9a6d6-ac60-4dc7-95c9-2b00f7aabf87",
                                                "sense_id": "e1f37437-2a56-3dfc-ad62-d216d6bcd765",
                                                "text": "Notre lumière est éteinte ; je meurs de peur : la nuit est terriblement noire !"
                                            },
                                            {
                                                "example_id": "7df767e5-1d69-4bc2-a053-e0fcc9fb8959",
                                                "sense_id": "e1f37437-2a56-3dfc-ad62-d216d6bcd765",
                                                "text": "Un commissaire qui donne sa bourse est terriblement amoureux, […]"
                                            },
                                            {
                                                "example_id": "d4250ebb-8dc7-4bd4-ba07-a83ba6559303",
                                                "sense_id": "e1f37437-2a56-3dfc-ad62-d216d6bcd765",
                                                "text": "Adieu, mon cher ami ; je vieillis terriblement, je m’affaiblis ; mais l’âge et les maladies n’ont aucun pouvoir sur les sentiments du cœur, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6677bad-8d9a-3c22-b83e-96e3205cb797",
                                        "entry_id": "7cbde7a4-c2ac-30f5-a357-17157b012ee6",
                                        "glosses": [
                                            "Un nombre terrible de. Une quantité terrible de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb7201bb-4635-4d36-9dca-56fa549d3d63",
                                                "sense_id": "b6677bad-8d9a-3c22-b83e-96e3205cb797",
                                                "text": "Il y a terriblement d’années, je m’en allais chasser le gibier d’eau dans les marais de l’Ouest, — et comme il n’y avait pas alors de chemins de fer dans le pays où il me fallait voyager, je prenais la diligence de *** qui passait à la patte d’oie du château de Rueil et qui, pour le moment, n’avait dans son coupé qu’une seule personne."
                                            },
                                            {
                                                "example_id": "5f6d7534-acb8-4080-a256-2439cd044a63",
                                                "sense_id": "b6677bad-8d9a-3c22-b83e-96e3205cb797",
                                                "text": "Dame ! c’est que ça doit coûter terriblement d’argent, et ça ne se trouve qu’à la ville."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
