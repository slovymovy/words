                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seuil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "818bccd6-7660-3ee2-aee4-0e2176a5046b",
                                        "entry_id": "900e5ec1-2406-3d88-8450-7ee099ba6e8e",
                                        "glosses": [
                                            "Pièce de bois ou dalle de pierre qui est au bas de l’ouverture d’une porte qui l’affleure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e8b480c-9b93-43bb-81f1-05e65a46f446",
                                                "sense_id": "818bccd6-7660-3ee2-aee4-0e2176a5046b",
                                                "text": "La Moussotte allait de temps à autre jusqu’au seuil de la porte, interrogeant le coin du bois d’où la route s’échappait de la forêt, la main en abat-jour sur les yeux, […]."
                                            },
                                            {
                                                "example_id": "9971418f-09b5-4761-8aa2-3e119869f784",
                                                "sense_id": "818bccd6-7660-3ee2-aee4-0e2176a5046b",
                                                "text": "Autrefois, monsieur, il y avait à cette fontaine un seuil de pierre. Les cantonniers s'en sont servis comme de moellon pour la construction du pont qui est là-bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60f53ec0-4b0d-33a3-b6bd-cdff81976b18",
                                        "entry_id": "900e5ec1-2406-3d88-8450-7ee099ba6e8e",
                                        "glosses": [
                                            "Entrée d’une maison, d'un appartement ou de toute pièce de logement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57238c6b-08a0-4a86-b6eb-231e9d75a641",
                                                "sense_id": "60f53ec0-4b0d-33a3-b6bd-cdff81976b18",
                                                "text": "La porte était à peine fermée derrière le prince que le roi de Navarre, […], apparut souriant sur le seuil de la chambre."
                                            },
                                            {
                                                "example_id": "e1c501f1-9ab7-4b97-94f2-fe90e8672e38",
                                                "sense_id": "60f53ec0-4b0d-33a3-b6bd-cdff81976b18",
                                                "text": "Marx franchit le seuil sans prononcer un seul mot, se contentant d’observer l’habitation d’un œil inquisiteur."
                                            },
                                            {
                                                "example_id": "e387b389-ff32-468f-aee9-e6a0bf346bb3",
                                                "sense_id": "60f53ec0-4b0d-33a3-b6bd-cdff81976b18",
                                                "text": "Dors, ma pensée te berce, mon amour te garde et la nuit tranquille s’est couchée au seuil de la maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a20022f-2276-3069-ab81-ad4d7d7cc1aa",
                                        "entry_id": "900e5ec1-2406-3d88-8450-7ee099ba6e8e",
                                        "glosses": [
                                            "Petit barrage, courte section du lit d'un cours d'eau dont le fond est naturellement ou artificiellement fixé, conduisant à modifier la hauteur de la lame d'eau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "deb5e9e1-d654-3fdf-8204-65f95d7440a1",
                                        "entry_id": "900e5ec1-2406-3d88-8450-7ee099ba6e8e",
                                        "glosses": [
                                            "(au sens figuré) Entrée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a23c0f1c-c8fc-4caf-996d-2803acf04ceb",
                                                "sense_id": "deb5e9e1-d654-3fdf-8204-65f95d7440a1",
                                                "text": "Au seuil de la vieillesse."
                                            },
                                            {
                                                "example_id": "c9bf37ab-c8a5-4cb0-a65e-ade616e5cb87",
                                                "sense_id": "deb5e9e1-d654-3fdf-8204-65f95d7440a1",
                                                "text": "Au seuil de son ouvrage, l’auteur avertit ses lecteurs que…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05eeb141-7856-3603-be24-5b828727754a",
                                        "entry_id": "900e5ec1-2406-3d88-8450-7ee099ba6e8e",
                                        "glosses": [
                                            "Valeur limite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d71a1714-46bf-4e59-857b-406082fd77bc",
                                                "sense_id": "05eeb141-7856-3603-be24-5b828727754a",
                                                "text": "Ainsi, à Cognac, la somme des 20 PFAS réglementés « atteint presque 200 Ng/litre, soit le double du seuil réglementaire », selon les prélèvements effectués."
                                            },
