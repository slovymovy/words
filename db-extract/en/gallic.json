                    {
                        "translation_id": "ed7c3117-43ec-49e6-a1b5-39ffe7562245",
                        "source_entry_id": "e1dd268b-4790-39af-91e5-cf26e25f5f86",
                        "source_sense_description": "of or relating to ancient Gaul or its inhabitants",
                        "target_lang_word": "gaulois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaulois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35734f5b-6617-3135-a1ec-7cf2910e24fb",
                                        "entry_id": "97f4da29-1c53-3e1a-8886-a6ac283697f5",
                                        "glosses": [
                                            "En rapport avec la Gaule, la langue gauloise ou les peuples la parlant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43203007-ec63-4f71-af6e-1bd48cc4aa39",
                                                "sense_id": "35734f5b-6617-3135-a1ec-7cf2910e24fb",
                                                "text": "Nous croirions plutôt que le pur sang de la race gauloise primitive s’est conservé jusqu’à nos jours sans mélange, dans quelques tribus rustiques de nos provinces centrales."
                                            },
                                            {
                                                "example_id": "b52ae25e-6039-4099-b6bd-8cdcf18d7564",
                                                "sense_id": "35734f5b-6617-3135-a1ec-7cf2910e24fb",
                                                "text": "Mars, identifié avec le dieu grec Arès, l'a été aussi avec le dieu gaulois Toutatis; Minerve, confondue avec la déesse grecque Athéna, l'a été aussi avec la déesse gauloise Belisama, etc."
                                            },
                                            {
                                                "example_id": "a3faa191-d215-40b0-87ea-d4a20fe86037",
                                                "sense_id": "35734f5b-6617-3135-a1ec-7cf2910e24fb",
                                                "text": "Les Bretons, ces émigrants celtiques venus de Grande-Bretagne au Vᵉ siècle de notre ère, avaient ramené en Armorique une langue très analogue à ce parler gaulois que d’ailleurs employait encore à cette époque, la population d’Auvergne."
                                            },
                                            {
                                                "example_id": "4a186123-789b-4f49-b3f9-12382b6825ff",
                                                "sense_id": "35734f5b-6617-3135-a1ec-7cf2910e24fb",
                                                "text": "En réalité, au iᵉʳ siècle après Jésus on ne note encore sur le territoire gaulois, que la présence de quelques judéens de marque, déportés en Gaule par ordre de l’autorité romaine […]."
                                            },
                                            {
                                                "example_id": "3195e30e-1c15-48d2-9f44-6f79c419ce60",
                                                "sense_id": "35734f5b-6617-3135-a1ec-7cf2910e24fb",
                                                "text": "Les maisons gauloises, dans leur aspect extérieur, ressemblaient donc aux chaumières normandes : leur toiture était imposante, débordait largement des murs et descendait très bas, pour protéger ces derniers, vulnérables à la pluie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d9539b6-0426-36ad-a8ef-7d948f566f8f",
                                        "entry_id": "97f4da29-1c53-3e1a-8886-a6ac283697f5",
                                        "glosses": [
                                            "Français, originaire de France."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "061b1d0b-38ed-46fe-823c-5d020b6b08f4",
                                                "sense_id": "2d9539b6-0426-36ad-a8ef-7d948f566f8f",
                                                "text": "Le village gaulois, c’est peut-être moins Crépol que la France entière. Ce ne sont pas deux mondes qui s’affrontent. Mais le même qui s’effondre de l’intérieur."
                                            },
                                            {
                                                "example_id": "0366dcc9-892b-449f-b752-5c11ec016a30",
                                                "sense_id": "2d9539b6-0426-36ad-a8ef-7d948f566f8f",
                                                "text": "Vous planteriez, ô Melbournois !\nSur vos coteaux barbares,\nLes plus fins de nos ceps gaulois,\n Nos « pineaux » les plus rares…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gaulois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdb92f06-5a4a-3c0f-9526-acdaf21fb2fc",
                                        "entry_id": "64c32475-8585-30ff-b843-ced5683aea7b",
                                        "glosses": [
                                            "Qui se présente sous un jour libre, plaisant, grivois, licencieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46af9ef0-3b31-47cb-a582-ff324729c8c0",
                                                "sense_id": "bdb92f06-5a4a-3c0f-9526-acdaf21fb2fc",
                                                "text": "Sous la IIIᵉ république, les techniques d’élevage fabriquent en série de petits robots, respectueux des autorités, sexuellement refoulés, bon soldats, excellents travailleurs, anxieux, très portés au suicide. Mais les Français ont alors le droit compensatoire de faire des plaisanteries « gauloises » alors que les Allemands acceptent officiellement leur puritanisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0b52bec-12ae-32d0-a892-f747ce7222ef",
                                        "entry_id": "64c32475-8585-30ff-b843-ced5683aea7b",
                                        "glosses": [
                                            "Qui est d’une gaieté vive et assez libre, joyeux, libertin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "134f213f-4568-4bf0-9774-98fc25086c46",
                                                "sense_id": "b0b52bec-12ae-32d0-a892-f747ce7222ef",
                                                "text": "Bocace surtout, Jean Bocace, ce joyeux enfant de Paris, qui respira dès le berceau un air imprégné de malice et de vieille gaîté gauloise, garda toujours quelque chose de l’humeur joviale et moqueuse de ceux qu’un caprice prophétique du hasard avait faits ses compatriotes."
                                            },
                                            {
                                                "example_id": "69971687-6a94-4dbc-bfc4-511244ac5ee4",
                                                "sense_id": "b0b52bec-12ae-32d0-a892-f747ce7222ef",
                                                "text": "En fait, ils découvraient surtout un univers, celui de la presse, celui d’une certaine liberté de ton gauloise dont ils étaient curieux de savoir ce que j’avais à en dire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gaulois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed3bf455-efb6-3c5e-810e-40d8476942fa",
                                        "entry_id": "d2614ed0-6ec8-3eba-bb80-e1b5a316cb83",
                                        "glosses": [
                                            "Relatif au Gault-Saint-Denis, commune de l’Eure-et-Loir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gaulois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77a44ff1-3a52-3663-a387-75a64baa04f1",
                                        "entry_id": "644b09e6-b6f1-34c6-9705-a938320be15c",
                                        "glosses": [
                                            "Langue que parlaient les Gaulois, habitants des Gaules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0161114c-0012-4b78-b290-90e3d373cf82",
                                                "sense_id": "77a44ff1-3a52-3663-a387-75a64baa04f1",
                                                "text": "Déclaration, rapidement débitée en cinq langues diverses, grec, latin, gaulois, libyque et baléare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3c6698b-68f6-43ff-91b9-342802f99477",
                        "source_entry_id": "e1dd268b-4790-39af-91e5-cf26e25f5f86",
                        "source_sense_description": "of or relating to ancient Gaul or its inhabitants",
                        "target_lang_word": "gallisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gallisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04b3b4e6-698d-3289-a2f4-d8639af6e7c6",
                                        "entry_id": "2835ce89-b3f8-3c34-8524-9ab1c53894d2",
                                        "glosses": [
                                            "Gallien, die Gallier betreffend; von den Galliern stammend, zu ihnen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f031b857-4b57-47ce-97b3-b97f6daa9880",
                                                "sense_id": "04b3b4e6-698d-3289-a2f4-d8639af6e7c6",
                                                "text": "Mit den sächsischen Liberalen sei es ein bisschen wie mit Asterix und Obelix, sagt der Dresdner FDP-Kreisvorsitzende Johannes Lohmeyer. »Wir sind das gallische Dorf im Römischen Reich.«"
                                            },
                                            {
                                                "example_id": "b74e04b0-ec33-45ad-89ed-ca43da74fc85",
                                                "sense_id": "04b3b4e6-698d-3289-a2f4-d8639af6e7c6",
                                                "text": "Später schuf die französische Aufklärung den Mythos vom freiheitsliebenden gallischen Vorfahren – als Widerpart zum absolutistischen Ancien Régime."
                                            },
                                            {
                                                "example_id": "946f9bbd-933a-4e80-8888-c0868d54734b",
                                                "sense_id": "04b3b4e6-698d-3289-a2f4-d8639af6e7c6",
                                                "text": "„Eine wichtige Rolle spielten namentlich in den küstennahen Regionen des Südens und Südostens die Handelsbeziehungen zu den benachbarten Stämmen des gallischen Festlands.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dce514b8-5f8f-3119-8973-deb3a4af5041",
                                        "entry_id": "2835ce89-b3f8-3c34-8524-9ab1c53894d2",
                                        "glosses": [
                                            "in der Sprache der Gallier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75a183f3-7b1c-4fe9-a446-394d8d77419f",
                                                "sense_id": "dce514b8-5f8f-3119-8973-deb3a4af5041",
                                                "text": "Viele Songtexte sind gallisch, was schon deshalb bemerkenswert ist, als es sich dabei um eine sogenannte Trümmersprache handelt: Wortschatz wie Grammatik sind kaum erhalten."
                                            },
                                            {
                                                "example_id": "47646cce-9dc2-4911-ba43-e3f951c5d81a",
                                                "sense_id": "dce514b8-5f8f-3119-8973-deb3a4af5041",
                                                "text": "Der aber möchte, bitte schön, mit seinem gallischen Namen angesprochen werden: Taruas - der Stier."
                                            },
                                            {
                                                "example_id": "d825e8de-2998-4edf-96c6-f42261952df1",
                                                "sense_id": "dce514b8-5f8f-3119-8973-deb3a4af5041",
                                                "text": "„Feststeht, dass im 5./6. Jahrhundert die gallische Sprache kaum noch gesprochen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0a633f89-46df-3abd-9d31-d140856cc0ec",
                                        "entry_id": "2835ce89-b3f8-3c34-8524-9ab1c53894d2",
                                        "glosses": [
                                            "die Galle betreffend"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e6216e2-2b31-4eb2-b154-1fed1f5524b1",
                                                "sense_id": "0a633f89-46df-3abd-9d31-d140856cc0ec",
                                                "text": "Diese hatte das Pech, ca. weitere 10 Minuten auf ihre Pizza warten zu müssen und war deswegen leicht \"gallisch\" bzw. gallig."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
