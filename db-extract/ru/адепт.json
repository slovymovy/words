                    },
                    {
                        "sense_id": "147fdaf8-23ab-3263-9a93-e633908f8c81",
                        "entry_id": "7f21a3d9-462b-3468-a3e2-8f079ba6372a",
                        "glosses": [
                            "тот, кто посвящён в тайны какого-либо учения, какой-либо секты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "135fdda6-18c8-4f3e-b749-efa0c889dca8",
                                "sense_id": "147fdaf8-23ab-3263-9a93-e633908f8c81",
                                "text": "Это прозвище даётся здесь вообще всем адептам «тайных наук»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "639cce7e-0c71-4659-8ab8-2adaedd8017f",
                        "source_entry_id": "7f21a3d9-462b-3468-a3e2-8f079ba6372a",
                        "target_lang_word": "disciple",
