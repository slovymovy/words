                "senses": [
                    {
                        "sense_id": "0c2c40a7-732b-3564-ba0b-03d4f09c0118",
                        "entry_id": "4565c190-8579-3dea-9a64-37aff5c2d591",
                        "glosses": [
                            "Sprache oder spezifische Form der Muttersprache, die in der Familie verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbc29424-351a-4abf-ba70-7af763cac07c",
                                "sense_id": "0c2c40a7-732b-3564-ba0b-03d4f09c0118",
                                "text": "„Bereits während der Zeit der Musikreise und auch darüber hinaus ist das Kochum in einzelnen Familien Familiensprache.“"
                            },
                            {
                                "example_id": "362c012d-ed4c-415e-9103-6ec370e5684e",
                                "sense_id": "0c2c40a7-732b-3564-ba0b-03d4f09c0118",
                                "text": "„Die Volkssprache entfaltet sich für das Kind im Kreis der Familienangehörigen als Familiensprache und besitzt in diesem Milieu seinen eigentlichen Rückhalt.“"
                            },
                            {
                                "example_id": "828bf6cc-e867-45e0-88ce-e4a4d61cc0e2",
                                "sense_id": "0c2c40a7-732b-3564-ba0b-03d4f09c0118",
                                "text": "„Seinen ersten sprachlichen Rahmen kann aber gleichzeitig auch die Familiensprache bilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
