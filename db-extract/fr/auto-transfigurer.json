                        "examples": [
                            {
                                "example_id": "538c14ea-5725-4df0-8712-4ed508389c41",
                                "sense_id": "3c66f545-bdb8-361c-8af5-8c0dd48dc1fd",
                                "text": "Dans son état originel, la forme physique était censée s'auto-purifier, s'auto-régénérer et s'auto-transfigurer."
                            },
                            {
                                "example_id": "06aba77a-9350-45a2-9b59-9152d9a467ea",
                                "sense_id": "3c66f545-bdb8-361c-8af5-8c0dd48dc1fd",
                                "text": "Une captation, non seulement pour transfigurer la chose capturée, mais aussi s'en approprier les forces afin de s'auto-transfigurer."
                            },
                            {
                                "example_id": "3e345c57-e09d-4b28-bf25-170a0d2e47a8",
                                "sense_id": "3c66f545-bdb8-361c-8af5-8c0dd48dc1fd",
                                "text": "Le Corcas n’est qu’une avant-première configuration, qui sera appelée à évoluer, voire à s’auto-transfigurer pour intégrer toutes les bonnes volontés qui voudraient agir dans ce sens."
