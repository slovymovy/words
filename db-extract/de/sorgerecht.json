                "senses": [
                    {
                        "sense_id": "42e9752d-1a7f-3522-b141-051d5ad8f713",
                        "entry_id": "cd4c2b8e-2214-3753-be85-c33aac5b1edd",
                        "glosses": [
                            "Recht, alle wichtigen Entscheidungen für Minderjährige zu treffen, das in der Regel den Eltern zusteht, durch Gerichtsbeschluss aber auch anderen Personen zugewiesen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc780c3e-91f0-4608-b8bb-f52896e3b03f",
                                "sense_id": "42e9752d-1a7f-3522-b141-051d5ad8f713",
                                "text": "„Auf Wunsch ihres Sohnes wurde das Sorgerecht vor zwei Jahren wieder auf sie übertragen; …“"
                            },
                            {
                                "example_id": "9dc56687-d160-4e0b-9efc-9d0934ae518d",
                                "sense_id": "42e9752d-1a7f-3522-b141-051d5ad8f713",
                                "text": "„Wie Roth bald erfahren würde, hatte sie das Sorgerecht für ihre Kinder verloren, weil sie Alkoholikerin war und man sie mehrfach wegen Trunkenheit am Steuer verurteilt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65f7ee95-2471-48b0-bee1-eb0be875ed74",
                        "source_entry_id": "cd4c2b8e-2214-3753-be85-c33aac5b1edd",
                        "source_sense_id": "42e9752d-1a7f-3522-b141-051d5ad8f713",
