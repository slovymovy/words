                    {
                        "sense_id": "6166bb06-6418-3206-9008-e64ddeff2097",
                        "entry_id": "d60cc4f3-509e-3e6f-93c7-e50304eee309",
                        "glosses": [
                            "To run (a distance)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "68d433c5-66c4-4194-8772-4dd702c30ca4",
                                "sense_id": "6166bb06-6418-3206-9008-e64ddeff2097",
                                "text": "He hotfooted the four-and-a-half blocks across town to the New York Public Library on Fifth Avenue and checked out the books Patterson had mentioned—and everything else about China he could quickly think of."
                            },
                            {
                                "example_id": "03a6c682-4ecd-4398-a396-04d12c71047a",
                                "sense_id": "6166bb06-6418-3206-9008-e64ddeff2097",
                                "text": "The Ford was shot up heavily, so Larkin hotfooted the last mile to Ewa. Once there, he took cover beneath a truck as unchallenged Zeros strafed the neatly parked MAG-21 aircraft and the base facilities."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "beacce13-d4cc-4c23-9195-dd2caff28601",
                        "source_entry_id": "d60cc4f3-509e-3e6f-93c7-e50304eee309",
                        "source_sense_id": "6166bb06-6418-3206-9008-e64ddeff2097",
                        "source_sense_description": "To run",
                        "target_lang_word": "rennen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rennen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6366faad-a7b9-36be-951a-4f2cf98954a8",
                                        "entry_id": "2817bb34-09ef-38e8-a28e-57da12ef46a0",
                                        "glosses": [
                                            "sich schnell zu Fuß fortbewegen, schnell laufen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e252c0d7-4f51-46f3-9031-00d3ee161882",
                                                "sense_id": "6366faad-a7b9-36be-951a-4f2cf98954a8",
                                                "text": "So schnell wie Maik rennt niemand bei uns in der Klasse."
                                            },
                                            {
                                                "example_id": "f66b4023-6048-4c0f-a78e-f15f83b2d7ed",
                                                "sense_id": "6366faad-a7b9-36be-951a-4f2cf98954a8",
                                                "text": "Unbeeindruckt von dem Spielstand gaben die 22 Profis auf dem Rasen weiter alles. Bremen rannte, kämpfte und drängte auf die Führung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b69d0c61-5197-3a4a-97f3-7120ee7496ce",
                                        "entry_id": "2817bb34-09ef-38e8-a28e-57da12ef46a0",
                                        "glosses": [
                                            "etwas häufig machen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2584b681-32c6-4984-b691-99e5c29599ff",
                                                "sense_id": "b69d0c61-5197-3a4a-97f3-7120ee7496ce",
                                                "text": "Schon als Schuljunge rannte Jerzy Miskiewicz, so oft er konnte, ins Kino."
                                            },
                                            {
                                                "example_id": "fe09e288-3552-48d3-ba9d-99797adebd0d",
                                                "sense_id": "b69d0c61-5197-3a4a-97f3-7120ee7496ce",
                                                "text": "Warum rennen Mädchen auf Partys eigentlich immer zu zweit oder dritt aufs Klo?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
