                        "glosses": [
                            "Quantité de vin qui se fait à la fois dans une cuve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5459434d-ad8d-487c-9730-f87e14f94aa0",
                                "sense_id": "c5356015-12ed-344b-b097-798fcc09d848",
                                "text": "Il leur suffisait de tremper le bout des doigts dans une pipe de cidre ou une cuvée de vin pour changer cidre et vin en bouse liquide ; […]."
                            },
                            {
                                "example_id": "afebb5bf-a9c7-4897-8f3f-7925f4fd2174",
                                "sense_id": "c5356015-12ed-344b-b097-798fcc09d848",
                                "text": "Dans presque tous les cantons de la Grèce on fait plus ou moins infuser des pommes de pin au fond des cuvées."
                            }
                        ]
                    },
