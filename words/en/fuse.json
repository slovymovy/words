                    ]
                },
                {
                    "sense_id": "9f434816-ffa3-354d-b442-c71c1afe33c1",
                    "sense_definition": "To change from a solid to a liquid state by heating.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "melting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metal <w>fuses</w> at a very high temperature."
                        },
                        {
                            "text": "The heat was intense enough to <w>fuse</w> the glass."
