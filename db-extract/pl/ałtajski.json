                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ecac67-8eb6-4dac-b7aa-564426f71c93",
                                "sense_id": "9716395f-8daf-34a4-a578-6eb30cf763d8",
                                "text": "Tędy właśnie, poprzez doliny ałtajskie, przemieszczały się ludy z zachodu na wschód i ze wschodu na zachód"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
