                                            {
                                                "example_id": "814efbc0-1d5d-4f9e-80c4-775b1e7f15bc",
                                                "sense_id": "cfc02729-2515-3ffb-96c2-51fd2ff950d6",
                                                "text": "Loď asi půl hodiny po vyplutí zmizela za obzorem."
                                            },
                                            {
                                                "example_id": "b5455deb-f70e-4244-9d2b-943f289768d4",
                                                "sense_id": "cfc02729-2515-3ffb-96c2-51fd2ff950d6",
                                                "text": "Čpí tam pot koní a voní tymián, kouř obzor cloní jak dolinou je hnán.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8838d0c0-a9a4-32f6-9a76-29a00049ef0c",
                                        "entry_id": "4c291f22-648a-3ced-b465-e5db67705ae7",
                                        "glosses": [
                                            "soubor znalostí"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1712ac73-6605-4672-af6e-9b1c59dd032d",
                                                "sense_id": "8838d0c0-a9a4-32f6-9a76-29a00049ef0c",
                                                "text": "Tuto knihu ti musím doporučit, rozšíří ti obzor."
                                            }
                                        ]
