    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a7fe06d6-a8d3-39cb-9d90-88f1976dec84",
                    "sense_definition": "Commencer à chanter un air, un chant ou un hymne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les spectateurs rassemblés dans le stade ont commencé à <w>entonner</w> l'hymne national à l'unisson."
                        },
                        {
                            "text": "À la fin de la fête, tous les amis ont décidé d'<w>entonner</w> un chant joyeux autour du feu."
                        }
                    ],
                    "synonyms": [
                        "attaquer",
                        "chanter"
                    ],
                    "common_phrases": [
                        "entonner un chant",
                        "entonner un hymne",
                        "entonner un refrain"
                    ]
                },
                {
                    "sense_id": "6afcfc16-7bb6-3ac7-ba5b-323b2ddb536c",
                    "sense_definition": "Proclamer haut et fort ou répéter avec insistance des propos, des éloges ou des réclamations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le porte-parole continue d'<w>entonner</w> les mêmes arguments sans répondre directement aux critiques des journalistes."
                        },
                        {
                            "text": "Certains journaux <w>entonnent</w> les louanges du ministre après l'annonce de ces nouvelles mesures fiscales."
                        }
                    ],
                    "synonyms": [
                        "déclamer",
                        "proclamer"
                    ],
                    "common_phrases": [
                        "entonner les louanges"
                    ]
                },
                {
                    "sense_id": "d2dae220-e77d-37bd-8c65-92355b1ed72a",
                    "sense_definition": "Mettre un liquide, comme du vin ou du cidre, en tonneau au moyen d'un entonnoir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs semaines de vendanges, les vignerons s'activent pour <w>entonner</w> le vin dans les barriques."
                        },
                        {
                            "text": "Il convient de bien nettoyer les fûts de chêne avant d'<w>entonner</w> le cidre de la saison."
                        }
                    ],
                    "common_phrases": [
                        "entonner le vin",
                        "entonner du cidre"
                    ]
                },
                {
                    "sense_id": "6abbb4b8-19c1-3388-91cd-fa9ba7f969e6",
                    "sense_definition": "En parlant du vent ou d'un courant d'air, s'engouffrer avec force dans un conduit ou un espace étroit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la tempête nocturne, le vent violent s'<w>entonne</w> dans la cheminée du salon avec fracas."
                        },
                        {
                            "text": "L'air glacial s'<w>entonnait</w> dans le grenier par les interstices des vieilles tuiles disjointes."
                        }
                    ],
                    "synonyms": [
                        "s'engouffrer",
                        "s'infiltrer"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Emploi pronominal vieilli pour désigner le vent qui pénètre"
                        }
                    ]
                }
            ]
        }
    ]
}