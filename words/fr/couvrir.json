                    "frequency": "High",
                    "semantic_group_id": "protection_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>couvrir</w> la casserole pour faire bouillir l'eau plus rapidement."
                        },
                        {
                            "text": "Le jardinier va <w>couvrir</w> les plantes fragiles avant la première nuit de gel."
                        }
                    ],
                    "synonyms": [
