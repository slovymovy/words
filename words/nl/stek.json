{
    "word_family": [
        "stekken",
        "stekgrond",
        "stekpoeder"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4687e65b-ded3-3f27-bf70-b2a95209a792",
                    "sense_definition": "Een afgesneden deel van een plant, zoals een takje of blad, om een nieuwe plant te kweken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij zette de <w>stek</w> in een glas water totdat er wortels aan groeiden.",
                            "target_lang_translations": {
                                "ru": "Она поставила <w>черенок</w> в стакан с водой, пока не отросли корни."
                            }
                        },
                        {
                            "text": "Ik kreeg een mooie <w>stek</w> van de plant van mijn buurvrouw.",
                            "target_lang_translations": {
                                "ru": "Я получил красивый <w>отросток</w> от растения моей соседки."
                            }
                        }
                    ],
                    "synonyms": [
                        "loot",
                        "scheut"
                    ],
                    "common_phrases": [
                        "een nieuwe stek"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отрезанная часть растения (веточка или лист) для вегетативного размножения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черенок",
                                "target_lang_sense_clarification": "часть побега растения для размножения"
                            },
                            {
                                "target_lang_word": "отросток",
                                "target_lang_sense_clarification": "побег или побег для посадки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91523a91-d2ff-3688-9e14-d3abec31ee3d",
                    "sense_definition": "Een plek om te verblijven, wonen of vertoeven.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze hebben eindelijk een fijne <w>stek</w> gevonden in het centrum van de stad.",
                            "target_lang_translations": {
                                "ru": "Они наконец-то нашли прекрасное <w>местечко</w> в центре города."
                            }
                        },
                        {
                            "text": "De visser zat urenlang op zijn vaste <w>stek</w> langs de rivier.",
                            "target_lang_translations": {
                                "ru": "Рыбак часами сидел на своем привычном <w>месте</w> у реки."
                            }
                        }
                    ],
                    "synonyms": [
                        "plek",
                        "woonplek",
                        "woning"
                    ],
                    "common_phrases": [
                        "een vaste stek",
                        "een eigen stek"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruikt voor woonplek of vaste verblijfplaats"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место для проживания, пребывания или постоянного нахождения (разговорное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "местечко",
                                "target_lang_sense_clarification": "уютное или постоянное место"
                            },
                            {
                                "target_lang_word": "уголок",
                                "target_lang_sense_clarification": "место жительства или отдыха"
                            },
                            {
                                "target_lang_word": "пристанище",
                                "target_lang_sense_clarification": "место обитания или приют"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82a6afa4-62ab-3e8d-a575-e1ea6d2bf7c5",
                    "sense_definition": "Een voerplek of vislocatie waar men gaat vissen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij strooide wat aas op de <w>stek</w> om de vissen te lokken.",
                            "target_lang_translations": {
                                "ru": "Он бросил немного прикормки на <w>прикормленное место</w>, чтобы привлечь рыбу."
                            }
                        },
                        {
                            "text": "Vroeg in de ochtend voer de hengelaar naar zijn favoriete <w>stek</w> op het meer.",
                            "target_lang_translations": {
                                "ru": "Рано утром рыболов поплыл к своему любимому <w>рыбному месту</w> на озере."
                            }
                        }
                    ],
                    "synonyms": [
                        "visplek"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикормленное место или рыбная точка для ловли рыбы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыбное место",
                                "target_lang_sense_clarification": "точка для ловли рыбы"
                            },
                            {
                                "target_lang_word": "прикормленное место",
                                "target_lang_sense_clarification": "место ловли с прикормкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ece1fe67-e004-3a34-ae4a-fe5316fa1243",
                    "sense_definition": "Verouderde of dialectale vorm van <w>stok</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In sommige oude teksten leest men <w>stek</w> in plaats van een houten stok.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых текстах встречается <w>stek</w> вместо деревянной палки."
                            }
                        },
                        {
                            "text": "De oude herder leunde vermoeid op zijn houten <w>stek</w>.",
                            "target_lang_translations": {
                                "ru": "Старый пастух устало опирался на свой деревянный <w>посох</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stok"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historische nevenvorm van stok"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая или диалектная форма слова «палка» (stok)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "палка",
                                "target_lang_sense_clarification": "посох, деревянная палка (устар.)"
                            },
                            {
                                "target_lang_word": "посох",
                                "target_lang_sense_clarification": "трость, опора при ходьбе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aeb5a4c4-6496-370b-85e7-b274bd6f9729",
                    "sense_definition": "Eerste persoon enkelvoud van de tegenwoordige tijd van <w>stekken</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het voorjaar <w>stek</w> ik altijd mijn favoriete geraniums.",
                            "target_lang_translations": {
                                "ru": "Весной я всегда <w>черенкую</w> свои любимые герани."
                            }
                        },
                        {
                            "text": "Ik <w>stek</w> regelmatig planten om ze aan vrienden cadeau te doen.",
                            "target_lang_translations": {
                                "ru": "Я регулярно <w>размножаю черенками</w> растения, чтобы дарить их друзьям."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма первого лица единственного числа настоящего времени от глагола stekken (черенковать, размножать черенками)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черенкую",
                                "target_lang_sense_clarification": "1-е лицо ед. ч. от «черенковать»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fd71098-3c8e-35a5-a3ba-4c35b8097bd4",
                    "sense_definition": "Gebiedende wijs van <w>stekken</w>.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Stek</w> die plant voorzichtig voordat de winter invalt!",
                            "target_lang_translations": {
                                "ru": "<w>Черенкуй</w> это растение аккуратно до наступления зимы!"
                            }
                        },
                        {
                            "text": "<w>Stek</w> deze struik nu, want de omstandigheden zijn optimaal.",
                            "target_lang_translations": {
                                "ru": "<w>Размножай черенками</w> этот кустарник сейчас, потому что условия оптимальны."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повелительное наклонение от глагола stekken (черенковать, размножать черенками)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черенкуй",
                                "target_lang_sense_clarification": "повелительное наклонение (ед. ч.)"
                            },
                            {
                                "target_lang_word": "размножай черенками",
                                "target_lang_sense_clarification": "повелительное наклонение (описательно)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d924fa4-614b-3041-a21e-93476871ff7c",
                    "sense_definition": "Tweede persoon enkelvoud van de tegenwoordige tijd van <w>stekken</w> bij inversie.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Stek</w> je deze planten liever in aarde of gewoon in water?",
                            "target_lang_translations": {
                                "ru": "Ты <w>черенкуешь</w> эти растения скорее в земле или просто в воде?"
                            }
                        },
                        {
                            "text": "Waarom <w>stek</w> je die rozemarijn niet gewoon zelf in de tuin?",
                            "target_lang_translations": {
                                "ru": "Почему ты просто не <w>размножишь черенками</w> этот розмарин сам в саду?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tweede persoon enkelvoud tegenwoordige tijd bij inversie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма второго лица единственного числа настоящего времени от глагола stekken при инверсии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черенкуешь",
                                "target_lang_sense_clarification": "2-е лицо ед. ч. от «черенковать»"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}