    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17e75dac-442b-384f-ad97-ef4c7293ea60",
                    "sense_definition": "Something that is owned.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ownership_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique watch quickly became his most prized <w>possession</w>.",
                            "target_lang_translations": {
                                "ru": "Старинные часы быстро стали его самой ценной <w>вещью</w>.",
                                "zh": "那块古董表很快成了他最珍贵的<w>财产</w>。"
                            }
                        },
                        {
                            "text": "She packed all her worldly <w>possessions</w> into a single suitcase.",
                            "target_lang_translations": {
                                "ru": "Она упаковала все свои <w>пожитки</w> в один чемодан.",
                                "zh": "她把所有的<w>家当</w>都装进了一个手提箱里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "property",
                        "belongings",
                        "item",
                        "asset"
                    ],
                    "common_phrases": [
                        "prized possession",
                        "personal possessions",
                        "worldly possessions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Материальные ценности, вещи или объекты, принадлежащие кому-либо.",
                        "zh": "指某人拥有的物品或财产。"
