                "senses": [
                    {
                        "sense_id": "6f5ef699-7a1a-37e9-ac1a-149a3d69476b",
                        "entry_id": "5458c7ea-5db0-3966-a6d4-9af4772ba536",
                        "glosses": [
                            "Teflon."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f6448901-01a1-4642-a1a5-5729339699c0",
                                "sense_id": "6f5ef699-7a1a-37e9-ac1a-149a3d69476b",
                                "text": "Le téflon est doué de mémoire: lorsqu'on étire le téflon, il se déforme mais après relâchement de l'effort, il revient en grande partie vers sa position d'origine."
                            },
                            {
                                "example_id": "6c11a79d-c13e-4cc6-a7d3-b3e70a1eb35a",
                                "sense_id": "6f5ef699-7a1a-37e9-ac1a-149a3d69476b",
                                "text": "Lorsque le substrat est une solution aqueuse et le liquide mouillant un alcane, on peut s'affranchir de ce problème en utilisant les propriétés de surface d'un polymère fluoré industriel : le téflon, ou polytétrafluoroéthylène."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4494dc3-ee0f-3cb5-9772-db03fefadf66",
                        "entry_id": "5458c7ea-5db0-3966-a6d4-9af4772ba536",
                        "glosses": [
                            "Qualité ou concept sur lequel les arguments contraires n'ont pas prise."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "377d2f9b-4bf6-4669-b534-044ec4b13f29",
                                "sense_id": "e4494dc3-ee0f-3cb5-9772-db03fefadf66",
                                "text": "Tout comme PSPP sait que sa lettre n’égratignera en rien le téflon de M. Legault au sein de son électorat."
                            }
                        ]
                    },
                    {
                        "sense_id": "edd19a9e-766a-397e-b48b-d651ab77a382",
                        "entry_id": "5458c7ea-5db0-3966-a6d4-9af4772ba536",
                        "glosses": [
                            "Bande en Teflon utilisée pour rendre étanche un raccord par filetage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12a1e4aa-84cd-45e3-9b54-f5ac90ee3112",
                                "sense_id": "edd19a9e-766a-397e-b48b-d651ab77a382",
                                "text": "-ne pas faire dépasser le téflon du filetage extérieur."
                            }
                        ]
                    }
