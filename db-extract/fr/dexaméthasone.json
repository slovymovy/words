                    },
                    {
                        "translation_id": "355151d4-07be-40a3-9084-8be36a07480a",
                        "source_entry_id": "cc65ac08-aabb-3674-af44-b1777a384919",
                        "source_sense_id": "f9150e52-0b39-3abd-ba13-7143a07b15ea",
