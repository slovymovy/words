                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd6813be-2b9c-41e6-9bde-371c0fa1961b",
                                "sense_id": "2241176d-0972-3447-be03-a9dfee6421f1",
                                "text": "Wel was hij somtijds ten prooi aan zwaarmoedigheid, maar hij wist zichzelf te beheerschen, zich als het ware vastklemmende aande producten zijner rijke verbeelding."
                            },
                            {
                                "example_id": "7eda18c2-bdf7-4c90-9fbb-8a028556551d",
                                "sense_id": "2241176d-0972-3447-be03-a9dfee6421f1",
                                "text": "Hij had daarentegen een zekere aanleg voor depressies die samenhingen met slecht weer, en aangezien het nu al tien dagen bijna onafgebroken regende, had de zwaarmoedigheid aardig vat op hem gekregen."
                            }
                        ]
                    }
