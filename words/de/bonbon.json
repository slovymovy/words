                    "frequency": "High",
                    "semantic_group_id": "suessigkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das kleine Kind lutscht nach dem Mittagessen gerne ein fruchtiges <w>Bonbon</w>."
                        },
                        {
                            "text": "In dem alten Tante-Emma-Laden gab es bunte <w>Bonbons</w> in großen Gläsern zu kaufen."
                        }
                    ],
                    "synonyms": [
                        "Zuckerl",
                        "Bonschen",
                        "Zeltli"
                    ],
                    "common_phrases": [
