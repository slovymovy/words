                        "examples": [
                            {
                                "example_id": "bdafdba2-6343-4677-9d36-0f1966004a75",
                                "sense_id": "2d6639b8-96ac-352c-a6dc-b7ae89a4401b",
                                "text": "Are you a vampire... or are you a lycan... pledge your bloodoath to your coven or pack.."
                            },
                            {
                                "example_id": "cd78de68-25d2-4482-a396-78118d09ee91",
                                "sense_id": "2d6639b8-96ac-352c-a6dc-b7ae89a4401b",
                                "text": "Castlevania is Metroid Prime? So Gabriel and the lycans and Vampires have all grown suits and plasma weapons, can roll in to morph balls bombing eveything, and Gabriel is a woman in a space suit?"
                            },
                            {
                                "example_id": "fd8c2897-3ce8-4720-8558-951ea788fc7d",
                                "sense_id": "2d6639b8-96ac-352c-a6dc-b7ae89a4401b",
                                "text": "The other Lycan sprung towards her and she fought him as Drago shifted to his Lycan form and faced his adversary."
                            },
                            {
                                "example_id": "ef6a10e3-fa7a-46a8-83ec-ec0ae7810566",
                                "sense_id": "2d6639b8-96ac-352c-a6dc-b7ae89a4401b",
                                "text": "It was soon discovered that Lycans were now attacking humans for food."
                            },
                            {
                                "example_id": "0928e8a3-5473-42f6-b48e-fa4f879a671e",
                                "sense_id": "2d6639b8-96ac-352c-a6dc-b7ae89a4401b",
                                "text": "He staggered for a moment, then gritted his teeth, turning to face the Woodland lycan, his arms raised to block the next punch, and the next. The Woodland pack gathered close, shouting encouragement to their alpha prime."
                            }
                        ]
                    }
