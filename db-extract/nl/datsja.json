                "translations": [
                    {
                        "translation_id": "c0ad65f3-75e4-4500-af1a-a24130b24c1a",
                        "source_entry_id": "79fd2777-72c0-37a0-88fe-2ae4b90400d4",
                        "source_sense_id": "eb5278e5-6afd-3b48-b18b-bba6ffc7e8d1",
                        "source_sense_description": "Russisch buitenverblijf",
                        "target_lang_word": "Datscha",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Datscha",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d925c329-d2ed-3244-bdfa-beb5bd5dde3c",
                                        "entry_id": "0dad5076-1c93-3542-bd1c-7825e547138d",
                                        "glosses": [
                                            "kleines Wochenendhaus mit einem Garten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "308c7be1-1130-478f-af66-e4bccb04eeb6",
                                                "sense_id": "d925c329-d2ed-3244-bdfa-beb5bd5dde3c",
                                                "text": "„Sechs junge Offiziere des IR 9 sitzen 1943 in einer Datscha an der Ostfront, sie reden, trinken, diskutieren.“"
                                            },
                                            {
                                                "example_id": "bd8b8a26-7e7c-441a-8c49-8cc6579c8219",
                                                "sense_id": "d925c329-d2ed-3244-bdfa-beb5bd5dde3c",
                                                "text": "„Alle um uns herum hatten einen Garten, eine kleine Datscha, ein Stück Erde von elf Ar und eine Babuschka auf dem Land, wir aber nicht.“"
                                            },
                                            {
                                                "example_id": "d12fe64c-983d-4da5-ae68-33c42f1ec0c8",
                                                "sense_id": "d925c329-d2ed-3244-bdfa-beb5bd5dde3c",
                                                "text": "„Was für den Vermögenden eine Datscha am Seeufer war, war dem weniger Bemittelten ein leerstehendes Gehöft.“"
                                            },
                                            {
                                                "example_id": "b75837f1-bfbf-4fc6-b8bf-67d422ffaffd",
                                                "sense_id": "d925c329-d2ed-3244-bdfa-beb5bd5dde3c",
                                                "text": "„Der Kremlherr verbrachte den Silvesterabend in seiner Datscha bei Kunzewo, 32 Kilometer von Moskau entfernt.“"
                                            },
                                            {
                                                "example_id": "c31852a3-9050-4f3f-b4fa-742379f371a3",
                                                "sense_id": "d925c329-d2ed-3244-bdfa-beb5bd5dde3c",
                                                "text": "„Der Mann ging in den Wald. Petja blieb dichtauf. Dass er eine Datscha hatte, klang glaubhaft. Petja kannte zwar keinen, der reich genug gewesen wäre, sich ein Sommerhäuschen zu halten, aber wusste, dass solche Datschen oft in Wäldern, an Seen oder am Meer lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f53bda98-16d0-4e83-92fa-78f0bd49d102",
                        "source_entry_id": "79fd2777-72c0-37a0-88fe-2ae4b90400d4",
                        "source_sense_id": "eb5278e5-6afd-3b48-b18b-bba6ffc7e8d1",
                        "source_sense_description": "Russisch buitenverblijf",
                        "target_lang_word": "Datsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Datsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcfaeb6f-8bbb-31b9-ac78-f48ced3c0154",
                                        "entry_id": "8d79a35d-9d33-354d-a04e-cd89be7cb13a",
                                        "glosses": [
                                            "Grundstück mit einem meist kleinen Wochenendhaus, Sommerhaus oder ein Gartenhaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a30d9b4-133d-4d35-9a17-252ee1a3b81a",
                                                "sense_id": "bcfaeb6f-8bbb-31b9-ac78-f48ced3c0154",
                                                "text": "„In der Umgebung belebten sich halb verlassene Dörfer, die Prager entdeckten das Isergebirge als Erholungsgebiet, wandelten leere Häuser zu Datschen um.“"
                                            },
                                            {
                                                "example_id": "a52dca11-f89e-489b-8c63-c7c7a4927b05",
                                                "sense_id": "bcfaeb6f-8bbb-31b9-ac78-f48ced3c0154",
                                                "text": "„Meine Eltern hatten zu wenig Geld, um ein Grundstück zu pachten, dafür legten sie ihre Ersparnisse mit denen einer befreundeten Familie zusammen und mieteten eine fertige Datsche für drei Jahre.“"
                                            },
                                            {
                                                "example_id": "b9192220-57db-4a27-989e-d8a02bbf30fd",
                                                "sense_id": "bcfaeb6f-8bbb-31b9-ac78-f48ced3c0154",
                                                "text": "„In Meixners Datsche würden sie ungestört reden können.“"
                                            },
                                            {
                                                "example_id": "2f858a9d-4ac4-4cf2-9868-8b8c76d4006c",
                                                "sense_id": "bcfaeb6f-8bbb-31b9-ac78-f48ced3c0154",
                                                "text": "„Zum erstenmal blieben die Häuser der Fremden leer, alte und neue Gebäude in allen Lagen, Fischerhütten und Bungalows in den Wäldern, verrammelte Luxuspaläste und offene Datschen, verlassene Geisterhäuser an leeren Buchten, ein aufgelassenes Gefängnis, ein Restaurant – billig zu kaufen, billiger zu mieten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81cf97e0-3c50-415f-9c91-5d19b6e592a2",
                        "source_entry_id": "79fd2777-72c0-37a0-88fe-2ae4b90400d4",
                        "source_sense_id": "eb5278e5-6afd-3b48-b18b-bba6ffc7e8d1",
                        "source_sense_description": "Russisch buitenverblijf",
                        "target_lang_word": "dacha",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dacha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "554c0253-b6d0-3d0f-90a4-1b5c373be947",
                                        "entry_id": "45b01dcd-1b93-32ae-a56b-3922dbd87488",
                                        "glosses": [
                                            "A Russian villa or summer house in the countryside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76a1e56f-b527-453d-9069-5c67af6b7f38",
                                                "sense_id": "554c0253-b6d0-3d0f-90a4-1b5c373be947",
                                                "text": "The belt is full of dachi, i.e., summer villas, all now closed. […] Most of the dachi are small; but some large, sumptuous, and more securely fenced, a few with iron palisades to insure privacy. […] There are no roads in the environs of Odessa, except among the dachi by the shore."
                                            },
                                            {
                                                "example_id": "e49f5cae-9e8b-4536-a239-66d09f6b1f3e",
                                                "sense_id": "554c0253-b6d0-3d0f-90a4-1b5c373be947",
                                                "text": "This was a great rambling wooden house, fashioned, like most of the Muscovish dachi, or country houses, in the form of a square main building in the centre, flanked by a wing on each side which came forward in a semicircle, like a man’s outstretched arms, as though to embrace the approaching visitors."
                                            },
                                            {
                                                "example_id": "20f94ed0-336e-4b91-b86b-bcdf6f7d6ef0",
                                                "sense_id": "554c0253-b6d0-3d0f-90a4-1b5c373be947",
                                                "text": "Here the dachi are large and sumptuously furnished."
                                            },
                                            {
                                                "example_id": "34973249-5ed1-4614-8a7a-3c8743220a46",
                                                "sense_id": "554c0253-b6d0-3d0f-90a4-1b5c373be947",
                                                "text": "On the defensive side, Stalin had made equally thorough preparations. Lenin’s personal guard consisted of two men, later increased to four after the attempt on his life by Fanny Kaplan. Stalin’s was several thousand strong, and the NKVD in addition kept other units at a state of readiness. The road to his country dacha, some twenty miles away, was guarded by over 3,000 agents, with cars, telephone connections, etc. When Stalin was actually en route, the road was virtually under martial law."
                                            },
                                            {
                                                "example_id": "5457417f-730f-48d7-8de9-f42207ac245b",
                                                "sense_id": "554c0253-b6d0-3d0f-90a4-1b5c373be947",
                                                "text": "The Ambassador warned him of the consequences if his mission to Moscow were a failure, both to Churchill's position at home and to Russia's prospects in the war. He insisted that he should not allow himself to be offended 'by a peasant who didn't know any better'. Churchill listened in silence, then returned to the dacha leaving Clark Kerr outside."
                                            },
                                            {
                                                "example_id": "d7537f12-3f26-4740-af6b-7cd9e2473f8a",
                                                "sense_id": "554c0253-b6d0-3d0f-90a4-1b5c373be947",
                                                "text": "The impact of the city was evidenced by the growing number of summer dachi and rising land values, […]"
                                            },
                                            {
                                                "example_id": "4a6aa322-6f57-4f5c-ae1f-35fcc93bbe2b",
                                                "sense_id": "554c0253-b6d0-3d0f-90a4-1b5c373be947",
                                                "text": "The villages and holiday dacha settlements that hug the river reflect the divisions that have emerged here: Scattered amid the rundown houses of poor farmers and the modest weekend cottages of factory and office workers are the luxury getaways of those few who have made it big in the new world of “Wild East” capitalism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47358a09-b92b-4d5e-a9ab-11fd96b347ee",
                        "source_entry_id": "79fd2777-72c0-37a0-88fe-2ae4b90400d4",
                        "source_sense_id": "eb5278e5-6afd-3b48-b18b-bba6ffc7e8d1",
                        "source_sense_description": "Russisch buitenverblijf",
                        "target_lang_word": "datcha",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "datcha",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de77208b-6d00-3e96-b01e-46c1fe96d81b",
                                        "entry_id": "529dd9e8-8f73-305e-8550-514e9d177843",
                                        "glosses": [
                                            "Résidence secondaire dans la campagne russe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1afd0e94-32d9-4b94-b3a6-36d90b7445c2",
                                                "sense_id": "de77208b-6d00-3e96-b01e-46c1fe96d81b",
                                                "text": "Une petite datcha de rondins de bouleau."
                                            },
                                            {
                                                "example_id": "ec36b0b7-670a-4ccb-97dd-ddb5baa95c35",
                                                "sense_id": "de77208b-6d00-3e96-b01e-46c1fe96d81b",
                                                "text": "La luxueuse datcha d’un membre de la nomenklatura."
                                            },
                                            {
                                                "example_id": "ce193928-f41d-40eb-89b9-708db52b5dbd",
                                                "sense_id": "de77208b-6d00-3e96-b01e-46c1fe96d81b",
                                                "text": "À l’issue des projections, Staline invitait souvent les participants à dîner dans sa datcha."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fc96af9-99ec-43f6-b0cb-438a8a15aa93",
                        "source_entry_id": "79fd2777-72c0-37a0-88fe-2ae4b90400d4",
                        "source_sense_id": "eb5278e5-6afd-3b48-b18b-bba6ffc7e8d1",
                        "source_sense_description": "Russisch buitenverblijf",
                        "target_lang_word": "dacia",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dacia",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "09ff78c7-7b26-3e3f-b031-83fe6da3d7a4",
                                        "entry_id": "3d130a48-c3a4-333d-a5c3-5fb46b5f43c6",
