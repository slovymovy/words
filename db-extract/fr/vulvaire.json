                                        "examples": [
                                            {
                                                "example_id": "2bc1871f-f39b-4c3b-ad60-2cbe1809ec60",
                                                "sense_id": "10d81cba-ce2a-3672-8f2a-4ffae00b6c98",
                                                "text": "In John and Salomé, Salomé's nipples are angry blossoms, her black navel vulval, tendrilous, vaguely insectimorphic."
                                            },
                                            {
                                                "example_id": "b8584af9-3b35-4038-8d79-2fe1c7a6df32",
                                                "sense_id": "10d81cba-ce2a-3672-8f2a-4ffae00b6c98",
                                                "text": "Pythagoras, she suggests, venerated three-sided figures for their vaginal symbolism; Upper Palaeolithic dips in rock are chipped away by cavemen into vulval icons."
                                            }
                                        ]
                                    }
                                ]
