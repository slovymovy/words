                                    },
                                    {
                                        "sense_id": "8de121ba-928c-3fd9-8252-b2cb8bf009f4",
                                        "entry_id": "dcd14e6c-dd72-398b-9a9f-47ce3df46f1b",
                                        "glosses": [
                                            "übertriebener moralischer Anspruch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b511ecc0-9d16-43a6-8108-9759311f58c0",
                                                "sense_id": "8de121ba-928c-3fd9-8252-b2cb8bf009f4",
                                                "text": "„Man muss sie aber vor dem kostenlosen Moralismus Nachgeborener schützen, gelegentlich auch vor dem rechthaberischen Rigorismus von Zeitgenossen, die rechtzeitig beiseite springen konnten.“"
                                            }
                                        ],
