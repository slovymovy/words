{
    "word_family": [
        "column",
        "columnar"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e29bf51-82fd-3f9d-825b-c0387bd53b85",
                    "sense_definition": "A long row of columns placed at regular intervals, typically supporting a roof or structure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "architectural_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient temple was surrounded by a grand <w>colonnade</w> that stretched along the entire front.",
                            "target_lang_translations": {
                                "zh": "这座古庙被一排宏伟的<w>柱廊</w>环绕，延伸至整个正面。"
                            }
                        },
                        {
                            "text": "Visitors walked through the <w>colonnade</w> to escape the midday sun.",
                            "target_lang_translations": {
                                "zh": "游客们走过<w>柱廊</w>以躲避正午的烈日。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arcade",
                        "portico"
                    ],
                    "common_phrases": [
                        "grand colonnade",
                        "stone colonnade"
                    ],
                    "target_lang_definitions": {
                        "zh": "一排间隔均匀的柱子，通常用于支撑屋顶或结构。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "柱廊",
                                "target_lang_sense_clarification": "指建筑中由一排柱子支撑的走廊。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcc15227-f701-3d8d-b918-d2518dbe2a57",
                    "sense_definition": "A long, regular row of objects, such as trees or tall structures, resembling a series of columns.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "architectural_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A beautiful <w>colonnade</w> of oak trees lined the long driveway leading to the estate.",
                            "target_lang_translations": {
                                "zh": "一条美丽的橡树<w>林荫道</w>沿着通往庄园的长车道延伸。"
                            }
                        },
                        {
                            "text": "The garden path was framed by a natural <w>colonnade</w> of tall, slender poplars.",
                            "target_lang_translations": {
                                "zh": "花园小径两旁是高大纤细的杨树，形成了一道天然的<w>林荫道</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "row",
                        "avenue"
                    ],
                    "common_phrases": [
                        "colonnade of trees"
                    ],
                    "target_lang_definitions": {
                        "zh": "一排长而整齐的物体（如树木或高大结构），类似于一排柱子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "林荫道",
                                "target_lang_sense_clarification": "指两旁种满树木的道路，常用于形容树木排列如柱廊。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1aaf86b-55fb-34b8-a6cc-9b78a99872be",
                    "sense_definition": "A row of columns surrounding a building or an open courtyard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architectural_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The inner courtyard was enclosed by a graceful <w>colonnade</w> that provided shade for the residents.",
                            "target_lang_translations": {
                                "zh": "内庭院被一圈优雅的<w>回廊</w>环绕，为居民提供了遮荫。"
                            }
                        },
                        {
                            "text": "Archaeologists discovered the remains of a peristyle <w>colonnade</w> beneath the ruins of the villa.",
                            "target_lang_translations": {
                                "zh": "考古学家在别墅遗址下发现了柱廊式<w>回廊</w>的遗迹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peristyle"
                    ],
                    "target_lang_definitions": {
                        "zh": "环绕建筑物或露天庭院的一排柱子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "回廊",
                                "target_lang_sense_clarification": "指环绕庭院或建筑的带顶走廊。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98de21b3-cd5e-3987-823c-a84bd46e510f",
                    "sense_definition": "A roofed entrance or walkway supported by columns.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architectural_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entrance to the museum features a classical <w>colonnade</w> that leads into the main hall.",
                            "target_lang_translations": {
                                "zh": "博物馆的入口处设有一个古典风格的<w>柱廊门厅</w>，通向主大厅。"
                            }
                        },
                        {
                            "text": "Philosophers often gathered to discuss ideas under the shelter of the public <w>colonnade</w>.",
                            "target_lang_translations": {
                                "zh": "哲学家们经常聚集在公共<w>柱廊门厅</w>的遮蔽下讨论思想。"
                            }
                        }
                    ],
                    "synonyms": [
                        "portico",
                        "stoa"
                    ],
                    "target_lang_definitions": {
                        "zh": "由柱子支撑的带顶入口或走道。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "柱廊门厅",
                                "target_lang_sense_clarification": "指建筑入口处由柱子支撑的门廊。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}