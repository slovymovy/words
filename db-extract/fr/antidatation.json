                        "glosses": [
                            "Action d’antidater, de marquer d’une date antérieure à la véritable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e85cac3d-280a-4d70-9550-77d5e3cb945d",
                                "sense_id": "596158a8-5f73-39d1-8b51-c8c869fdc544",
                                "text": "Il y a tout lieu de croire que l’antidatation de vingt ans s’efforce en réalité de cacher l’auteur de la traduction qu’un simple examen formel autorise à attribuer avec assez de vraisemblance à Plantin lui-même."
                            },
                            {
                                "example_id": "cc9bb6ba-e16c-42d6-a28a-fafb5509c018",
                                "sense_id": "596158a8-5f73-39d1-8b51-c8c869fdc544",
                                "text": "L’Apocalypse selon Saint-Jean se démarque des autres textes apocalyptiques en ce qu’elle n'a pas recours à la pseudonymie et à l’antidatation traditionnelles du genre."
                            }
                        ]
