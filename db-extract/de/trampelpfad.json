                ],
                "senses": [
                    {
                        "sense_id": "fd6a76b0-04c8-3061-9d96-b673832a284c",
                        "entry_id": "9ea912e4-5804-3b06-9db3-fbbd2b10a80f",
                        "glosses": [
                            "schmaler unbefestigter Weg, der dadurch entsteht, dass eine bestimmte Strecke immer wieder begangen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "addebf5c-ae01-43a2-a709-648f382e8adc",
                                "sense_id": "fd6a76b0-04c8-3061-9d96-b673832a284c",
                                "text": "„Wir marschierten über einen Trampelpfad bergauf und machten zwischendurch an kleinen Lichtungen auf alten, verwitterten Holzbänken Rast.“"
                            },
                            {
                                "example_id": "93f20840-4b09-4a92-938d-a80458f8bd04",
                                "sense_id": "fd6a76b0-04c8-3061-9d96-b673832a284c",
                                "text": "„Ein Trampelpfad führte durch ein Wäldchen und hüfthohe Brennnesselsträucher die Böschung hinauf und endete an einer Felsfalte, die man als Einstieg nutzen und von wo man sich in wenigen Minuten bis auf die Spitze vorarbeiten konnte.“"
                            },
                            {
                                "example_id": "edb27d35-599e-481f-a7dc-73c825a353d7",
                                "sense_id": "fd6a76b0-04c8-3061-9d96-b673832a284c",
                                "text": "„An einer Stelle geht ein Trampelpfad ab.“"
                            },
                            {
                                "example_id": "209ddc78-9fec-4f78-95e3-6f9d48166c96",
                                "sense_id": "fd6a76b0-04c8-3061-9d96-b673832a284c",
                                "text": "„Der Trampelpfad zog sich wie ein breites Grinsen über das in Stein gehauene Gesicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56c0f58c-a4bb-4ee1-8d9e-4d4a06020fb1",
                        "source_entry_id": "9ea912e4-5804-3b06-9db3-fbbd2b10a80f",
                        "source_sense_id": "fd6a76b0-04c8-3061-9d96-b673832a284c",
                        "target_lang_word": "desire path",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desire path",
