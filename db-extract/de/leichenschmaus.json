                "senses": [
                    {
                        "sense_id": "f5d25c81-20eb-3057-bf6f-26b65f26ce7a",
                        "entry_id": "fe6f8ab9-61a0-341c-9352-312f18d04418",
                        "glosses": [
                            "Mahlzeit oder Kaffeetrinken für Angehörige und Trauergäste nach vollzogener Beerdigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92d2ce7c-2aa7-40e1-9d6e-3503ef7d6e19",
                                "sense_id": "f5d25c81-20eb-3057-bf6f-26b65f26ce7a",
                                "text": "„Bald schon vergaß Josef den Leichenschmaus.“"
                            },
                            {
                                "example_id": "88e524e4-0127-43e9-a5d6-7b1b45690e87",
                                "sense_id": "f5d25c81-20eb-3057-bf6f-26b65f26ce7a",
                                "text": "„Der Leichenschmaus fand im blumengeschmückten großen Salon statt.“"
                            },
                            {
                                "example_id": "7781c1a6-6c4d-4ced-ab5c-8a3279702dec",
                                "sense_id": "f5d25c81-20eb-3057-bf6f-26b65f26ce7a",
                                "text": "„Der Beerdigung schloss sich ein Leichenschmaus im Dorfgasthof an.“"
                            },
                            {
                                "example_id": "a8ce8acc-92a2-4f96-8b3e-e876fee5c55f",
                                "sense_id": "f5d25c81-20eb-3057-bf6f-26b65f26ce7a",
                                "text": "„Als Tóvó und das Dienstmädchen vom Leichenschmaus nach Hause kamen, saß Pole allein in der Wohnstube und rauchte Pfeife.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
