                    "sense_id": "2aad2f06-645f-3979-bdc3-31e868be0385",
                    "sense_definition": "zielig, meelijwekkend of jammer; een gevoel van medelijden of teleurstelling oproepend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zielig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is echt een <w>sneue</w> vertoning dat er bijna niemand naar zijn presentatie kwam kijken.",
                            "target_lang_translations": {
                                "en": "It is really a <w>sad</w> state of affairs that almost no one came to watch his presentation."
                            }
                        },
                        {
                            "text": "Ik vind het een <w>sneu</w> verhaal dat hij zijn verjaardag helemaal alleen moest vieren.",
                            "target_lang_translations": {
                                "en": "I think it is a <w>pitiful</w> story that he had to celebrate his birthday all alone."
                            }
                        }
                    ],
                    "synonyms": [
                        "deerniswekkend",
                        "meelijwekkend",
                        "bedroevend",
                        "jammer"
                    ],
                    "common_phrases": [
                        "een sneu verhaal",
                        "een sneue vertoning"
                    ],
                    "target_lang_definitions": {
                        "en": "sad, pathetic, or unfortunate; evoking a feeling of pity or disappointment"
                    },
                    "translations": {
