                                                "example_id": "92c174e3-4124-4c02-9d26-ca7147c64d38",
                                                "sense_id": "0221a2e0-e8c4-3d88-be69-aea5376719e9",
                                                "text": "pochi anni or sono è stata fatta dichiarazione di mercato libero anche in Europa"
                                            },
                                            {
                                                "example_id": "f768209a-455d-4992-bf20-e518e1154994",
                                                "sense_id": "0221a2e0-e8c4-3d88-be69-aea5376719e9",
                                                "text": "avete avuto molto coraggio entrando in quel mercato: state avendo successo"
                                            }
