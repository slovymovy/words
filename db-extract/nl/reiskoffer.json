                    {
                        "sense_id": "b11cb034-c966-3722-8778-f8a6a33305e7",
                        "entry_id": "e497ec55-82e9-3f77-9c1c-83d840db27eb",
                        "glosses": [
                            "koffer waarin een reiziger zijn reisbenodigdheden heeft opgeboren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c436b008-b06d-4198-a47b-b249c5c41c17",
                                "sense_id": "b11cb034-c966-3722-8778-f8a6a33305e7",
                                "text": "Er hing een lichte ochtendmist boven de kust op de dag dat Theo vertrok, en het was vloed. Cameron en Donald laadden zijn reiskoffer in de boot en Theo bleef even op de kiezels staan om achterom te kijken naar Beatrice, die met haar omslagdoek om zich heen geklemd stond te bibberen in de vochtige lucht."
                            },
                            {
                                "example_id": "3ec0c63f-42e8-4243-8de8-ef5007085a4b",
                                "sense_id": "b11cb034-c966-3722-8778-f8a6a33305e7",
                                "text": "In een woning in Rotterdam heeft de politie gisteren 1,1 miljoen euro aan contant geld aangetroffen. Het geld was verstopt in een reiskoffer en een plastic tas. Een 38-jarige Rotterdammer is aangehouden."
                            }
                        ]
                    }
