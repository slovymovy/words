                                    },
                                    {
                                        "sense_id": "feda7533-b6c5-3ebd-aa9f-af763c36084e",
                                        "entry_id": "dd93fae6-b5fa-36a4-b10b-69008302f350",
                                        "glosses": [
                                            "Improbable or unlikely."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32764741-0689-34a6-a4d5-252bb911c505",
                                        "entry_id": "dd93fae6-b5fa-36a4-b10b-69008302f350",
                                        "glosses": [
                                            "Suspicious, or of dubious character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64576d0e-f4bb-4320-9be1-adef4765d78d",
                                                "sense_id": "32764741-0689-34a6-a4d5-252bb911c505",
                                                "text": "Yet it is not the predominant views of the experts but the views of a minority, mostly of rather doubtful standing in their profession, which are taken up and spread by the intellectuals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7999907f-befb-31ba-91fc-1b13fd09767f",
                                        "entry_id": "dd93fae6-b5fa-36a4-b10b-69008302f350",
                                        "glosses": [
                                            "Unclear or unreliable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2533baf-e7f6-4fda-80ed-ede05491a089",
                                                "sense_id": "7999907f-befb-31ba-91fc-1b13fd09767f",
                                                "text": "The pupils of her great eyes were large in the doubtful lamplight, swallowing their green fires in deep pools of mystery and darkness."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doubtful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "225b93ef-2fe1-330f-a56a-11ce37bdf7e5",
                                        "entry_id": "b6503096-30d0-31dd-bc35-a83fad8e72b0",
                                        "glosses": [
                                            "A doubtful person or thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a9a30a6-f795-46a2-a5c2-aadab038d41f",
                                                "sense_id": "225b93ef-2fe1-330f-a56a-11ce37bdf7e5",
                                                "text": "They had their lists of Liberals and of the doubtfuls who still remained doubtful. As the election drew near, the force of the whole organization was turned upon these unrepentant doubtfuls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ff1e966-8e8c-40cf-86f6-55a2c607374c",
                        "source_entry_id": "b2c49972-f55b-3e70-b373-1556c90ae83c",
                        "source_sense_id": "b2837a51-927e-3612-8733-b004e4b5209e",
                        "target_lang_word": "douteux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "douteux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d42e3dee-d2c9-37bb-9940-ddb4d1405235",
                                        "entry_id": "3239e7d0-9b6b-3fe8-bdbb-33d57aa3689a",
                                        "glosses": [
                                            "Qui est l'objet d'un doute, faute d'éléments suffisants d'information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfbaf14b-8feb-4b69-953f-617d55ed54e8",
                                                "sense_id": "d42e3dee-d2c9-37bb-9940-ddb4d1405235",
                                                "text": "La validité des faits et des arguments rapportés dans de nombreux sites Web « amateurs » se révèle souvent douteuse ou carrément nulle."
                                            },
                                            {
                                                "example_id": "8beb2002-9335-44b2-b0a9-4d39c6ce612e",
                                                "sense_id": "d42e3dee-d2c9-37bb-9940-ddb4d1405235",
                                                "text": "Un succès douteux. — Une affaire douteuse. — Son droit est fort douteux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86dace9a-31e8-3200-9db9-3afea4c5de79",
                                        "entry_id": "3239e7d0-9b6b-3fe8-bdbb-33d57aa3689a",
                                        "glosses": [
                                            "Qualifie les personnes sur qui l’on ne peut pas trop compter, dont on n’est pas sûr."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1575ea4-fdca-4fbb-8400-1131e669c3d1",
                                                "sense_id": "86dace9a-31e8-3200-9db9-3afea4c5de79",
                                                "text": "Trois des membres du comité sont pour moi, trois contre, et les quatre autres douteux."
                                            },
                                            {
                                                "example_id": "f92e0eb3-a2f9-49f9-9c26-8744ca30888d",
                                                "sense_id": "86dace9a-31e8-3200-9db9-3afea4c5de79",
                                                "text": "Sur cette période, tout juste exprimerait-elle à l’avenir que, de douteux, son beau-frère est devenu franchement exécrable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8e49e3b-16b2-356f-b490-2d947b9f0319",
                                        "entry_id": "3239e7d0-9b6b-3fe8-bdbb-33d57aa3689a",
                                        "glosses": [
                                            "Qui est équivoque, ambigu, qui provoque le doute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "399b7963-5b28-4997-8852-6f54feb641c1",
                                                "sense_id": "e8e49e3b-16b2-356f-b490-2d947b9f0319",
                                                "text": "Une réponse douteuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9b03629-b99b-3210-9dba-a53e080f5991",
                                        "entry_id": "3239e7d0-9b6b-3fe8-bdbb-33d57aa3689a",
                                        "glosses": [
                                            "Qualifie un jour faible, le degré de lumière qui forme le passage du jour à la nuit ou de la nuit au jour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dff2f745-4e15-4b29-a92b-442e64183de3",
                                                "sense_id": "e9b03629-b99b-3210-9dba-a53e080f5991",
                                                "text": "Jour douteux. — Lumière, clarté douteuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caff95af-f3bf-3919-98f2-ad3797a1692c",
                                        "entry_id": "3239e7d0-9b6b-3fe8-bdbb-33d57aa3689a",
                                        "glosses": [
                                            "Qui est longue ou brève dans le vers, suivant la place qu’elle y occupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94c238fe-8f5f-4996-a83a-956ba4505537",
                                                "sense_id": "caff95af-f3bf-3919-98f2-ad3797a1692c",
                                                "text": "Voyelle douteuse, syllabe douteuse. — Le « I » final est douteux dans les mots latins mihi, tibi, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af103e62-b1df-30b0-8f14-e630966acac7",
                                        "entry_id": "3239e7d0-9b6b-3fe8-bdbb-33d57aa3689a",
                                        "glosses": [
                                            "Moralement mauvais."
                                        ],
                                        "tags": [
                                            "euphemism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e305fad-057a-4df5-9172-59a12dca8651",
                                                "sense_id": "af103e62-b1df-30b0-8f14-e630966acac7",
                                                "text": "Rien dans ses agissements, ses relations, n'était douteux. Plusieurs heures durant, vingt limiers du Bureau Central avaient travaillé d'arrache-pied sur cette matière, cherchant la faille par où pourrait s'insinuer le soupçon. Pour aboutir à délivrer vingt certificats de bonne vie et mœurs..."
                                            },
                                            {
                                                "example_id": "6b4efa72-7f4a-461d-b7b5-fb20a9a71173",
                                                "sense_id": "af103e62-b1df-30b0-8f14-e630966acac7",
                                                "text": "Non contente d'être une laissée-pour-compte et une cossarde frayant avec des personnages douteux, la fille illégitime du candidat au Sénat Laurence Jeffries était aussi une traînée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c02f269b-e2f8-3a27-b35b-9314b53381cc",
                                        "entry_id": "3239e7d0-9b6b-3fe8-bdbb-33d57aa3689a",
                                        "glosses": [
                                            "Qui n'est pas conforme au bon goût ou à la bienséance."
                                        ],
                                        "tags": [
                                            "euphemism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2253bc54-a9b4-44a1-9280-da403f31f224",
                                                "sense_id": "c02f269b-e2f8-3a27-b35b-9314b53381cc",
                                                "text": "Oui, le timide n’a jamais osé danser, du coup, il a eu le temps d’affûter son sens de la répartie pendant que ses petits camarades galochaient des nanas au look douteux et au maquillage ringard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "douteux",
                                "target_lang_code": "fr",
                                "target_senses": [
