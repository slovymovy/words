        "fr-extract.jsonl": [
            {
                "entry_id": "f1239d0a-77d5-3921-865f-f25c2508c16b",
                "word": "paranoïaque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9ebca605-26f0-4ecf-82dc-09515f6341d2",
                        "entry_id": "f1239d0a-77d5-3921-865f-f25c2508c16b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "paranoïaques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c81f2a24-1df4-3f4f-9eec-1bf500c0dd75",
                        "entry_id": "f1239d0a-77d5-3921-865f-f25c2508c16b",
                        "glosses": [
                            "Relatif à la paranoïa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf2ad44a-bfc0-4590-8e06-182966998cdd",
                                "sense_id": "c81f2a24-1df4-3f4f-9eec-1bf500c0dd75",
                                "text": "En d'autres formes de la maladie, la péjoration paranoïaque va jusqu'à brouiller la répartition des activités sociales où collaborent le sujet et le socius, et jusqu'a faire objectiver et attribuer au socius des actes ou des parties d'actes qui sont en réalité le fait du malade."
                            },
                            {
                                "example_id": "58e07654-d5c8-4fee-b9ad-ee5f859132fa",
                                "sense_id": "c81f2a24-1df4-3f4f-9eec-1bf500c0dd75",
                                "text": "(figuré) — L'habile mais féroce tyrannie du cœur exercée par Sand montre insensiblement ses limites; pourtant la “quarante-huitarde” qui se voudrait martyrisée n'en démord pas, solidement ancrée dans son égocentrisme paranoïaque: […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6be5906b-1b08-433b-be49-4757eb0f1741",
                        "source_entry_id": "f1239d0a-77d5-3921-865f-f25c2508c16b",
                        "source_sense_id": "c81f2a24-1df4-3f4f-9eec-1bf500c0dd75",
                        "target_lang_word": "paranoid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paranoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "360b5826-627c-36ef-8f70-d487a1b29955",
                                        "entry_id": "be1bd82f-a8a4-39fd-944f-cabc9dccbb4f",
                                        "glosses": [
                                            "Of, related to, or suffering from clinical paranoia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f390741c-056d-3ac6-b755-0719d063398a",
                                        "entry_id": "be1bd82f-a8a4-39fd-944f-cabc9dccbb4f",
                                        "glosses": [
                                            "Exhibiting excessive fear, suspicion, or distrust."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2aef70d-832b-42ed-9246-dd7778368329",
                                                "sense_id": "f390741c-056d-3ac6-b755-0719d063398a",
                                                "text": "But can the people on TV see me or am I just paranoid?"
                                            },
                                            {
                                                "example_id": "42b7b17a-01eb-483c-8e5f-378099252d50",
                                                "sense_id": "f390741c-056d-3ac6-b755-0719d063398a",
                                                "text": "People generally want to believe good news, and Max was so paranoid about germs that he'd really love to believe Plum Island was spewing antibiotics and vaccine into the air."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paranoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d39ce8a1-01ba-3627-8ee2-8f2b232f1f1a",
                                        "entry_id": "d01dcf2b-5453-3657-8d9c-c67a9eba088e",
                                        "glosses": [
                                            "A person suffering from paranoia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74e10947-f797-443a-87d0-732bfbf8e0a3",
                        "source_entry_id": "f1239d0a-77d5-3921-865f-f25c2508c16b",
                        "source_sense_id": "c81f2a24-1df4-3f4f-9eec-1bf500c0dd75",
                        "target_lang_word": "паранойяльный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "паранойяльный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f773736d-cfdc-3b88-adfd-08fc4a01b9ec",
                                        "entry_id": "a34bd16c-77a9-36cc-a792-d5e5e6a6d901",
                                        "glosses": [
                                            "психиатр. связанный, соотносящийся по значению с существительным паранойя; свойственный, характерный для неё"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc48aa1b-884d-4325-a3f6-7ed19c1ce850",
                                                "sense_id": "f773736d-cfdc-3b88-adfd-08fc4a01b9ec",
                                                "text": "Эгоцентрическая направленность эпилептиков иногда может быть истолкована как паранойяльный синдром; здесь нужно, как и всегда, сообразоваться с анамнезом и течением болезни."
                                            },
                                            {
                                                "example_id": "8eae8938-0050-4ec3-91ae-4b4d5532509f",
                                                "sense_id": "f773736d-cfdc-3b88-adfd-08fc4a01b9ec",
                                                "text": "В одних случаях паранойяльный бред ограничен содержанием ревности, или преследования, или реформаторства (монотематический бред), в других — бред разного содержания возникает у одного и того же больного последовательно или, что бывает значительно реже, почти одновременно (политематический бред)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
