{
    "word_family": [
        "drijven",
        "bijeenbrengen",
        "samendrijven"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d5e99f4-2225-3fed-b79e-c541b255d450",
                    "sense_definition": "Mensen of dieren dwingen om zich op één plaats te verzamelen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verzamelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De herdershond hielp om de schapen snel <w>bijeen</w> te <w>drijven</w>.",
                            "target_lang_translations": {
                                "en": "The sheepdog helped to quickly <w>round up</w> the sheep."
                            }
                        },
                        {
                            "text": "De politie probeerde de demonstranten in het park <w>bijeen</w> te <w>drijven</w>.",
                            "target_lang_translations": {
                                "en": "The police tried to <w>herd</w> the protesters in the park."
                            }
                        }
                    ],
                    "synonyms": [
                        "samendrijven",
                        "verzamelen"
                    ],
                    "antonyms": [
                        "uiteenjagen",
                        "verstrooien"
                    ],
                    "common_phrases": [
                        "vee bijeendrijven",
                        "schapen bijeendrijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To force people or animals to gather in one place."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to round up",
                                "target_lang_sense_clarification": "animals or people"
                            },
                            {
                                "target_lang_word": "to herd",
                                "target_lang_sense_clarification": "livestock or crowds"
                            },
                            {
                                "target_lang_word": "to drive together",
                                "target_lang_sense_clarification": "forcing to gather"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d3844bc-b5cb-3357-949a-3c46e02f94b3",
                    "sense_definition": "Door stroming of wind op het water naar elkaar toe drijven en zich verzamelen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verzamelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de sterke wind zagen we het drijfhout langzaam in de baai <w>bijeendrijven</w>.",
                            "target_lang_translations": {
                                "en": "Due to the strong wind, we saw the driftwood slowly <w>drift together</w> in the bay."
                            }
                        },
                        {
                            "text": "De ijsschotsen <w>dreven</w> door de stroming snel <w>bijeen</w>.",
                            "target_lang_translations": {
                                "en": "The ice floes quickly <w>drifted together</w> due to the current."
                            }
                        }
                    ],
                    "synonyms": [
                        "samendrijven"
                    ],
                    "antonyms": [
                        "uiteendrijven"
                    ],
                    "common_phrases": [
                        "ijsschotsen bijeendrijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To float together and accumulate due to currents or wind on the water."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to drift together",
                                "target_lang_sense_clarification": "floating objects on water"
                            },
                            {
                                "target_lang_word": "to float together",
                                "target_lang_sense_clarification": "accumulating on water"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}