                                    },
                                    {
                                        "sense_id": "21bf6d0e-c633-30ae-adb1-8ab55889247b",
                                        "entry_id": "9cf5843a-8b40-3248-90b2-9982c1272a90",
                                        "glosses": [
                                            "An article clipped from a newspaper (especially) or from a magazine."
