                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fb2350f7-cbf9-4cc9-a30e-440bbd8a671a",
                        "entry_id": "679fee89-baa9-359c-91ad-c1c1eb73b057",
                        "tags": [
                            "plural"
                        ],
                        "form": "legitimacies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58e71e95-641f-334c-99ab-e8f9ea927107",
                        "entry_id": "679fee89-baa9-359c-91ad-c1c1eb73b057",
                        "glosses": [
                            "The quality or state of being legitimate or valid; validity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9ef5f11f-3f2b-4791-9bd3-713eb1963034",
                                "sense_id": "58e71e95-641f-334c-99ab-e8f9ea927107",
                                "text": "The legitimacy based on a revolutionary essence was replaced by legitimacy with an ultranational, ultra-Yugoslav character."
                            }
                        ]
                    },
                    {
                        "sense_id": "b512e07e-95c1-3946-9698-4ab42f4fd9ed",
                        "entry_id": "679fee89-baa9-359c-91ad-c1c1eb73b057",
                        "glosses": [
                            "The quality or state of being legitimate or valid; validity.",
                            "Public acceptance of an institution, such as a polity or societal system."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0177e105-988a-4f17-b3a8-95a38c9b40db",
                                "sense_id": "b512e07e-95c1-3946-9698-4ab42f4fd9ed",
                                "text": "After decades of inequality and oppression, the regime had lost legitimacy with its own population."
                            },
                            {
                                "example_id": "38c2d484-7fbd-4b13-955e-077c2feb3093",
                                "sense_id": "b512e07e-95c1-3946-9698-4ab42f4fd9ed",
                                "text": "The fall of the Soviet Union in 1991 was seen by many as proof of capitalism’s legitimacy over communism."
                            },
                            {
                                "example_id": "6911b180-09f5-482f-b06d-d45d9cea0823",
                                "sense_id": "b512e07e-95c1-3946-9698-4ab42f4fd9ed",
                                "text": "Democracy’s legitimacy stems from the consent of the governed."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc2377d0-86f7-3f20-ab8e-a17dc72aceeb",
                        "entry_id": "679fee89-baa9-359c-91ad-c1c1eb73b057",
                        "glosses": [
                            "Lawfulness of birth or origin; directness of descent as affecting the royal succession."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbbb9954-504e-4611-a831-c67bbf5584d1",
                        "source_entry_id": "679fee89-baa9-359c-91ad-c1c1eb73b057",
                        "source_sense_description": "quality of being legitimate or valid; validity",
                        "target_lang_word": "légitimité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légitimité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84ac44c2-4efa-312c-ac1a-a5da350cff48",
                                        "entry_id": "a7a949db-1011-3514-bd7b-bd036692a378",
                                        "glosses": [
                                            "Qualité de ce qui est conforme à la loi, à la justice, à la raison, à la tradition ou aux règles établies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f895a2-6ca2-47d1-8c3b-701d8ba143c0",
                                                "sense_id": "84ac44c2-4efa-312c-ac1a-a5da350cff48",
                                                "text": "Une société qui nie toutes les légitimités, depuis celle du prêtre et du père de famille jusqu'à celle du souverain, ne répudie-t-elle pas toutes ses convictions d'existence ?"
                                            },
                                            {
                                                "example_id": "f79399de-3898-49e8-86e3-304d72bbdd96",
                                                "sense_id": "84ac44c2-4efa-312c-ac1a-a5da350cff48",
                                                "text": "L’interprétation chrétienne de la Genèse, quant à elle, a donné une légitimité théologique à l’autorité spirituelle de l’homme sur la femme, car Ève a été créée en tant qu’auxiliaire corporelle d’Adam (saint Augustin), en d’autres termes pour l’aider à avoir une descendance (saint Thomas d’Aquin)"
                                            },
                                            {
                                                "example_id": "5c8feebd-53d4-47de-8b60-c1345b359e9b",
                                                "sense_id": "84ac44c2-4efa-312c-ac1a-a5da350cff48",
                                                "text": "Il n’aurait pas fallu accueillir la parole des victimes telle qu’elle se donne ? Il faudrait passer cette parole au crible de l’analyse des « Gardiens du temple », de ceux qui ne lui « feront pas dire n’importe quoi » ? Une telle posture n’est qu’une manière d’écouter en conservant une position de surplomb, de pouvoir en somme. La légitimité et le sens de la parole des victimes sont ainsi suspendues au jugement d’un tiers présenté comme instance légitime de vérité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0647eb2d-496a-3f0b-a628-640f9c095cc5",
                                        "entry_id": "a7a949db-1011-3514-bd7b-bd036692a378",
                                        "glosses": [
                                            "État, qualité d’un enfant légitime."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a9925e-9a54-45e1-8ff4-1fb1f2abe3f7",
                                                "sense_id": "0647eb2d-496a-3f0b-a628-640f9c095cc5",
                                                "text": "Grégoire de Tours nous montre dans ses récits que les enfants naturels du Roi ont le même droit que les enfants légitimes; la succession de ces souverains se partage entre eux sans tenir compte spécialement de la légitimité de la naissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "475d11b8-4d02-3211-b19c-4c11ba6c1f91",
                                        "entry_id": "a7a949db-1011-3514-bd7b-bd036692a378",
                                        "glosses": [
                                            "Reconnaissance du droit à exercer le pouvoir."
                                        ],
                                        "tags": [
                                            "Science politique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72cd3c68-7c98-478b-add1-0ce4cbfd67ad",
                                                "sense_id": "475d11b8-4d02-3211-b19c-4c11ba6c1f91",
                                                "text": "En sciences politiques, il est usuel de distinguer la légitimité par le processus de décision (process legitimacy) et la légitimité par les résultats (output legitimacy). La première est essentielle pour les démocraties, la seconde l’est par exemple pour les organisations internationales. En démocratie, toute décision est à la limite légitime, si elle résulte d’un processus délibératif informé. Dans l’univers technocratique, les processus comptent aussi, mais moins en définitive que les résultats obtenus."
                                            },
                                            {
                                                "example_id": "9907d922-e7dc-40f9-aa82-349fc77d171f",
                                                "sense_id": "475d11b8-4d02-3211-b19c-4c11ba6c1f91",
                                                "text": "Pour le gaullisme, le renforcement du pouvoir exécutif était une sorte de clef institutionnelle, et la ratification par le suffrage universel la clef de la légitimité."
                                            },
                                            {
                                                "example_id": "4f3a8360-de81-41d8-bff4-00e242a1086c",
                                                "sense_id": "475d11b8-4d02-3211-b19c-4c11ba6c1f91",
                                                "text": "Au regard de sa base électorale de premier tour (18,5 % des inscrits au premier tour) comme du degré de conviction dans les urnes (Rouban, 2018), la légitimité d’Emmanuel Macron est d’emblée fragile."
                                            },
                                            {
                                                "example_id": "8b710711-1575-4608-9aff-f955062dbaaf",
                                                "sense_id": "475d11b8-4d02-3211-b19c-4c11ba6c1f91",
                                                "text": "Pétain et Vichy ont bénéficié, au début, d’une légitimité de fait auprès de l’opinion intérieure comme sur la scène internationale, mais ils ont dû céder progressivement le pas au général de Gaulle et à la Résistance. Si la transition politique a été simple en août 1944, le transfert d’une légitimité à l’autre s’est fait dans la violence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d02fbfb-28c3-339f-b52d-1bc7d0adee22",
                                        "entry_id": "a7a949db-1011-3514-bd7b-bd036692a378",
                                        "glosses": [
                                            "Reconnaissance du droit à exercer le pouvoir.",
                                            "Droit dont se réclament les chefs de la branche aînée des Bourbons."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed96d862-8919-4785-ab72-e0d639c97274",
                                                "sense_id": "6d02fbfb-28c3-339f-b52d-1bc7d0adee22",
                                                "text": "« Comte Génévray, petit bonhomme de dix-neuf ans, gros et trop serré dans un habit toujours trop étroit ; moustaches noires, répétant tous les soirs deux fois que, sans légitimité, il n’y a pas de bonheur pour la France »."
                                            },
                                            {
                                                "example_id": "9e8952c3-0d93-47f5-be07-929ce71dc316",
                                                "sense_id": "6d02fbfb-28c3-339f-b52d-1bc7d0adee22",
                                                "text": "Son parent, M. de Valqueyras, lui ayant défendu d’introduire des affiliés dans son hôtel, il avait choisi le salon jaune de Félicité. D’ailleurs, il ne tarda pas à trouver dans Pierre un aide précieux. Il ne pouvait aller prêcher lui-même la cause de la légitimité aux petits détaillants et aux ouvriers du vieux quartier ; on l’aurait hué."
                                            },
                                            {
                                                "example_id": "c1a5bdee-8aff-49a2-abd0-0f6aa1f0ee09",
                                                "sense_id": "6d02fbfb-28c3-339f-b52d-1bc7d0adee22",
                                                "text": "Durant toute sa vie, celui qui ne portait en exil que le titre de comte de Chambord, consacre l’essentiel de son temps à fourbir un programme de gouvernement. Il a compris que, désormais, la légitimité du sang ne suffisait pas à exercer le pouvoir, qu’il s’agissait moins d’occuper un trône que de savoir à quoi on l’utilisait"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0581d9a4-77ad-3e56-b20a-ff33a36c178e",
                                        "entry_id": "a7a949db-1011-3514-bd7b-bd036692a378",
                                        "glosses": [
                                            "Application du droit royal français tel qu'il est défini dans la théorie statutaire et les lois fondamentales du royaume."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd2cd289-6dbc-4afd-bae7-fe1f2ddfa7a8",
                        "source_entry_id": "679fee89-baa9-359c-91ad-c1c1eb73b057",
                        "source_sense_description": "quality of being legitimate or valid; validity",
                        "target_lang_word": "Rechtmäßigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechtmäßigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bae361d3-3e65-3dfa-98ea-f8744129543a",
                                        "entry_id": "bba27842-875c-3a24-9161-fda131f5f14e",
                                        "glosses": [
                                            "Übereinstimmung mit dem geltenden Recht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e538608d-1aa8-4e40-a5b4-9f1326ee03e8",
                                                "sense_id": "bae361d3-3e65-3dfa-98ea-f8744129543a",
                                                "text": "„Jedermann, der festgenommen oder angehalten wird, hat das Recht auf ein Verfahren, in dem durch ein Gericht oder durch eine andere unabhängige Behörde über die Rechtmäßigkeit des Freiheitsentzuges entschieden und im Falle der Rechtswidrigkeit seine Freilassung angeordnet wird.“"
                                            },
                                            {
                                                "example_id": "3076b3b8-f9a3-491e-b239-0c7dea7613b7",
                                                "sense_id": "bae361d3-3e65-3dfa-98ea-f8744129543a",
                                                "text": "„Das hartnäckige Führen eines Adelstitels (‚Reichsritter von Sickingen‘), dessen Rechtmäßigkeit er nicht zu erweisen vermochte, brachte ihn zusätzlich in Schwierigkeiten.“"
                                            },
                                            {
                                                "example_id": "87ebee3c-4426-497d-a784-d29ae5e5adc3",
                                                "sense_id": "bae361d3-3e65-3dfa-98ea-f8744129543a",
                                                "text": "„Bis heute stellen paschtunische Nationalisten die völkerrechtliche Rechtmäßigkeit der Grenze in Frage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5340fa75-b7a3-47f5-8dc8-191e1ff2cc62",
                        "source_entry_id": "679fee89-baa9-359c-91ad-c1c1eb73b057",
                        "source_sense_description": "quality of being legitimate or valid; validity",
                        "target_lang_word": "Legitimität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Legitimität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "431f92cb-500e-3fde-926d-65f97c954156",
                                        "entry_id": "7627f303-4acc-39ba-afb2-770258d858ab",
                                        "glosses": [
                                            "Eigenschaft, anerkennungswürdig (legitim) zu sein, weil gewisse moralische, aber auch gesetzliche Normen und Wertvorstellungen eingehalten sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a735aa15-233b-42fe-99fc-0d9e5c474984",
                                                "sense_id": "431f92cb-500e-3fde-926d-65f97c954156",
                                                "text": "„In der Zeit nachmetaphysischen Denkens stellt die Frage nach der Legitimität politischer Ordnungen, Herrschaftsträger und Entscheidungen moderner Massendemokratien eine große Herausforderung für (politische) Theoretiker dar.“"
                                            },
                                            {
                                                "example_id": "7cc44d05-d276-48d9-8f13-9fb642a80023",
                                                "sense_id": "431f92cb-500e-3fde-926d-65f97c954156",
                                                "text": "„Die Frage, was unter „politischer Legitimität“ zu verstehen ist, zu beantworten, fällt traditionell schwer, weil es eine Menge von Definitionsversuchen und Theorien gibt, die „politische Legitimität“ verschieden zu konzeptualisieren versuchen.“"
                                            },
                                            {
                                                "example_id": "1ffa49d4-c6f5-419d-b3c1-9b3551cd1347",
                                                "sense_id": "431f92cb-500e-3fde-926d-65f97c954156",
                                                "text": "„Mit Legitimität meinen wir im Sinne Seymour M. Lipsets, dass die Bürger eines Staates von der Rechtmäßigkeit einer bestehenden Herrschaftsordnung überzeugt sind.“"
                                            },
                                            {
                                                "example_id": "4a6f11ff-901a-4a90-a05e-57c3bc01ceab",
                                                "sense_id": "431f92cb-500e-3fde-926d-65f97c954156",
                                                "text": "„Die Begriffe „Legitimation“ und „Legitimität“ werden jeweils in unterschiedlichen Kontexten, in verschiedenen Wissenschaftsdisziplinen mit unterschiedlichen Bedeutungen genutzt.“"
                                            },
                                            {
                                                "example_id": "b2d52f64-d03e-4bd1-8af0-0e83906047ec",
                                                "sense_id": "431f92cb-500e-3fde-926d-65f97c954156",
                                                "text": "„Die deutsche Sprachwissenschaft wendet sich seit einigen Jahren, nachdem die Wellen des Prinzipienstreites verebbt sind und die Legitimität unterschiedlicher Verfahren und Methoden wieder außer Frage steht, gelassener und zugleich engagierter der Aufarbeitung der sprachgeschichtlichen Grundlagen des Deutschen zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
