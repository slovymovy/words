                    {
                        "sense_id": "6278d6b0-fb4c-33b6-bdf9-b0d41a0214e7",
                        "entry_id": "f4be9f18-1da8-374b-8406-adac05d597be",
                        "glosses": [
                            "toelage voor levensonderhoud na echtscheiding aan ex-partner en/of kind(eren)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60771bcc-a623-4028-8f68-32be55a8705f",
                                "sense_id": "6278d6b0-fb4c-33b6-bdf9-b0d41a0214e7",
                                "text": "Het is meestal de kostwinner die alimentatie moet betalen."
                            },
                            {
                                "example_id": "c9778d8c-3bfb-4944-a2bd-3441ab59f625",
                                "sense_id": "6278d6b0-fb4c-33b6-bdf9-b0d41a0214e7",
                                "text": "'Misschien had hij het nodig om de alimentatie te betalen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bacb18b9-743b-4bb3-9c7e-94f312809144",
                        "source_entry_id": "f4be9f18-1da8-374b-8406-adac05d597be",
                        "source_sense_id": "6278d6b0-fb4c-33b6-bdf9-b0d41a0214e7",
                        "target_lang_word": "Alimentation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alimentation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95d78696-c565-34f4-be84-3c4c0651ae45",
                                        "entry_id": "4f4d09a8-ece3-3a79-a65a-cfaecc3e48c9",
                                        "glosses": [
                                            "Versorgung mit Alimenten, Lebensunterhalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f40c869f-e3f9-4d79-bf14-88ee6405c5f0",
                                                "sense_id": "95d78696-c565-34f4-be84-3c4c0651ae45",
                                                "text": "„Die gewollte wie auch die ungewollte Theatralik der Präsentation von Macht in der DDR wurde ebenso thematisiert, präziser: visualisiert, wie das durchaus ambivalente Verhältnis der damaligen Akteure zur Macht: Nutznießer der Alimentationen des Systems zu sein und es gleichzeitig kritisieren zu wollen.“"
                                            },
                                            {
                                                "example_id": "f048842c-ceb5-4f97-a2f0-59850fc1f638",
                                                "sense_id": "95d78696-c565-34f4-be84-3c4c0651ae45",
                                                "text": "„Die Alimentation des Beamten und seiner Familie ist demgegenüber etwas qualitativ anderes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea4cf429-b5d5-4b73-8d19-f5a721079a42",
                        "source_entry_id": "f4be9f18-1da8-374b-8406-adac05d597be",
                        "source_sense_id": "6278d6b0-fb4c-33b6-bdf9-b0d41a0214e7",
                        "target_lang_word": "alimony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alimony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d07f25fd-7a09-3f96-9735-05cda83dca68",
                                        "entry_id": "c71db015-e846-385b-bcd0-e6f4f51eff0c",
                                        "glosses": [
                                            "A court-mandated allowance made to a former spouse by a divorced or legally separated person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b367ea63-4378-4ded-b579-1f0fc8b50e3b",
                                                "sense_id": "d07f25fd-7a09-3f96-9735-05cda83dca68",
                                                "text": "In that case he has to pay her alimony even if there are no children, and if she is one of those smart ones, interested in nothing but a good living and independence, she is set for life."
                                            },
                                            {
                                                "example_id": "01994b03-3ebd-42ef-9236-684a0d8972e0",
                                                "sense_id": "d07f25fd-7a09-3f96-9735-05cda83dca68",
                                                "text": "Who won, huh? Nobody. Used to be sex was the only free thing, No longer. Alimony… palimony… it's all financial. Love is an illusion."
                                            },
                                            {
                                                "example_id": "fc7faf39-0259-4771-93bd-3116b28065b4",
                                                "sense_id": "d07f25fd-7a09-3f96-9735-05cda83dca68",
                                                "text": "Audball's latest pickup didn't seem to care where they were, or anything at all about alimony, palimony, or child support […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f1cf79c-4eb3-3e4d-917c-c35e5cb7ce9e",
                                        "entry_id": "c71db015-e846-385b-bcd0-e6f4f51eff0c",
                                        "glosses": [
                                            "Nourishment, sustenance, especially for one's spirit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6edbb97b-763e-4405-9c4d-461a066ec3b5",
                                                "sense_id": "7f1cf79c-4eb3-3e4d-917c-c35e5cb7ce9e",
                                                "text": "[…]while we eate the bread of sorrow, drinking the wine of compunction, wee hunger and thirst after heauenly things, and shall be comforted. This is the constant alimonie of the righteous, at dinner and supper, in life and death[…]"
                                            },
                                            {
                                                "example_id": "a88af003-df2a-4a6f-b127-ede4516cf0e5",
                                                "sense_id": "7f1cf79c-4eb3-3e4d-917c-c35e5cb7ce9e",
                                                "text": "[…]What marvell if our corne faile us, when wee faile God in the good employment of our corne?[…]So that drunkennesse, gluttony, fraud, covetisme, the unworthy receiving, or not receiving of the Sacraments, and a million more are all in cause, why God denies this fruitfull alimonie, which formerlie he gave. And doe we then aske what is the cause? when as our sinnes so superabundant are."
                                            },
                                            {
                                                "example_id": "675c3d7e-f6f1-42d7-969b-d5dc5c717eb0",
                                                "sense_id": "7f1cf79c-4eb3-3e4d-917c-c35e5cb7ce9e",
                                                "text": "[…]having the advantage of this strange way of alimony, he sold his allowance of provant at great rates;[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5d3dd08-b8a1-483a-b41c-e0c519a4d177",
                        "source_entry_id": "f4be9f18-1da8-374b-8406-adac05d597be",
                        "source_sense_id": "6278d6b0-fb4c-33b6-bdf9-b0d41a0214e7",
                        "target_lang_word": "pension alimentaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pension alimentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "690521b5-0bb9-3551-9052-6d981273f858",
                                        "entry_id": "6e410f67-b372-32c3-a64a-77ebbd28922b",
                                        "glosses": [
                                            "Aide matérielle indispensable pour vivre, versée par un membre de sa famille, et réglée par autorité de justice ou par convention entre les parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e0a844d-8d21-4fa3-bb48-dfe3d73a6016",
                                                "sense_id": "690521b5-0bb9-3551-9052-6d981273f858",
                                                "text": "Mise en place après un divorce ou une séparation, la pension alimentaire est une contribution financière versée par l’un des parents à l’autre pour participer aux frais liés à « l’entretien et à l’éducation de l’enfant » (nourriture, vêtements, transport, frais de logement, loisirs, cantine, etc;)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43f1b506-4ec9-491d-8453-2aaa82cef9d0",
                        "source_entry_id": "f4be9f18-1da8-374b-8406-adac05d597be",
                        "source_sense_id": "6278d6b0-fb4c-33b6-bdf9-b0d41a0214e7",
                        "target_lang_word": "alimenty",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alimenty",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "6d4f2344-1c0f-3cb8-aa42-f1efc5ba9aaa",
                                        "entry_id": "9c2e3e65-340c-3324-a0c3-f4aa7232a149",
                                        "glosses": [
                                            "regularne, obligatoryjne świadczenia, na ogół pieniężne, na rzecz osób fizycznych, do których zobowiązywane są na drodze prawnej inne osoby fizyczne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c954de1-da58-4b47-bc56-0cf8fc89bff9",
                                                "sense_id": "6d4f2344-1c0f-3cb8-aa42-f1efc5ba9aaa",
                                                "text": "Joanna długo sądziła się z byłym mężem o alimenty."
                                            },
                                            {
                                                "example_id": "83b8cb9d-7f70-4faf-b69c-4a225568a7b7",
                                                "sense_id": "6d4f2344-1c0f-3cb8-aa42-f1efc5ba9aaa",
                                                "text": "Udało się to Marlenie, która dziś w internecie radzi nie tylko, jak złapać na dziecko, ale jak potem wywalczyć wysokie alimenty"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
