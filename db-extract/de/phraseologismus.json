                        "cross_references": [
                            {
                                "target_word": "慣用句",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "9f377739-b805-3722-8135-d3a5eec3a55e",
                                        "entry_id": "34a7d3d1-dbd5-3f82-92a4-311404977108",
                                        "glosses": [
                                            "句の一種で、構成する各単語の意味を繫げても作り出せない意味を持つことば。日本語では「油を売る」、英語では「piece of cake」など。構成する単語同士の固定が普通の句よりも強く、受け付けない統語的変化が多い。固定の度合いは段階的で、どの変化を受け付けないかは慣用句ごとに様々。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43df2e65-58e1-4b84-acc2-c2328e9e3a6c",
                                                "sense_id": "9f377739-b805-3722-8135-d3a5eec3a55e",
                                                "text": "そこで、君が彼女を見ることになる。 〇"
