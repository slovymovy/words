                "senses": [
                    {
                        "sense_id": "361e7ac5-c9d3-3d3a-a484-ec80a53360db",
                        "entry_id": "a9e1652d-b850-3577-99e5-d43dfd56c9e3",
                        "glosses": [
                            "Säule, die ein Gebäude, eine Brücke stützt, trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a1160f-3207-42e6-9197-33c9110ccb55",
                                "sense_id": "361e7ac5-c9d3-3d3a-a484-ec80a53360db",
                                "text": "Die Grundpfeiler der alten Brücke drohten einzustürzen."
                            },
                            {
                                "example_id": "c2d45fc5-2ff1-41f6-9c7e-efc77f037387",
                                "sense_id": "361e7ac5-c9d3-3d3a-a484-ec80a53360db",
                                "text": "„Die Grundpfeiler des Gebäudes waren mit Sprungfedern versehen, damit es einem Nuklearschock standhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "42c677aa-1f40-37c7-a8bd-c226b1e29726",
                        "entry_id": "a9e1652d-b850-3577-99e5-d43dfd56c9e3",
                        "glosses": [
                            "wichtige Grundlage, Basis von etwas"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "ec459f95-b9c9-4b99-b826-ef2011a0404f",
                                "sense_id": "42c677aa-1f40-37c7-a8bd-c226b1e29726",
                                "text": "„Das Recht, innerhalb der EU seinen Wohnort und Arbeitsplatz frei wählen zu können, gilt als Grundpfeiler der EU.“"
                            },
                            {
                                "example_id": "29e4c760-c8f5-4ddc-8d80-0bbb5598f8cd",
                                "sense_id": "42c677aa-1f40-37c7-a8bd-c226b1e29726",
                                "text": "„Ein Sprecher des Bundesinnenministeriums betonte, die freie Presse sei ein Grundpfeiler der Demokratie.“"
                            },
                            {
                                "example_id": "b1d17244-3db0-4427-9eef-f42c7a7ab0c2",
                                "sense_id": "42c677aa-1f40-37c7-a8bd-c226b1e29726",
                                "text": "[COVID-19-Pandemie:] „‚Erster Grundpfeiler‘ einer europäischen Impfstoffstrategie – so bezeichnet von der Leyen den Kauf von 300 Millionen Dosen eines möglichen Corona-Impfstoffs.“"
                            },
                            {
                                "example_id": "996320c4-228e-41ea-8004-bd7122f5700f",
                                "sense_id": "42c677aa-1f40-37c7-a8bd-c226b1e29726",
                                "text": "„Seit der Revolution ist die erbitterte Feindschaft mit Israel ein außenpolitischer Grundpfeiler der Islamischen Republik Iran.“"
                            },
                            {
                                "example_id": "7bef2c12-22ee-489c-a5a4-35143ffcb740",
                                "sense_id": "42c677aa-1f40-37c7-a8bd-c226b1e29726",
                                "text": "„Der Bundesgerichtshof hat ein Frage verhandelt, die an die Grundpfeiler der Judikative geht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
