                        "examples": [
                            {
                                "example_id": "4d606ff3-a898-450c-9ab3-c5cac69aab47",
                                "sense_id": "bf8d7c02-e20e-32ee-a15f-c990cdb2ee17",
                                "text": "Moi, ça m'a donné soif, crévindiou ! - Allez ! Buvons don un chti coup ! Houais ! ! !\nIls partent en riant et s'attablent à la terrasse."
                            },
                            {
                                "example_id": "1b61fd12-3ae4-47be-beb0-e8157313b3e6",
                                "sense_id": "bf8d7c02-e20e-32ee-a15f-c990cdb2ee17",
                                "text": "Craches-y moi ton souteneur, crévindiou ? On va pas y passer la Saint-Glinglin, s'agaça le flic. Malgré la lumière éblouissante de la lampe braquée sur elle, la finaude le soutenait d'un regard noir et défiant."
                            }
                        ]
