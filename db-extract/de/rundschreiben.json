                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7faeb10e-ffd6-499a-a704-f835f81cf965",
                                "sense_id": "c2b5e01c-62cb-3636-a41d-31d75c8c8060",
                                "text": "In einem internen Rundschreiben wurden die Mitarbeiter auf die neuen Richtlinien hingewiesen."
                            },
                            {
                                "example_id": "28bdbac4-ee22-4c19-b863-410005b10652",
                                "sense_id": "c2b5e01c-62cb-3636-a41d-31d75c8c8060",
                                "text": "„Ein andermal verteidigte Vaucorbeil die Rundschreiben Ledru-Rollins.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a52cd87e-7eae-4e02-886a-dd4b47ba9044",
