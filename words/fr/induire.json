{
    "word_family": [
        "induction",
        "inducteur",
        "inductif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "adf2245e-4602-3764-acd9-09b3e4c30634",
                    "sense_definition": "Amener ou pousser quelqu'un à un comportement, un état ou un jugement faux.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les explications confuses du guide risquent d'<w>induire</w> les visiteurs en erreur."
                        },
                        {
                            "text": "Cette ressemblance physique peut facilement <w>induire</w> les témoins en erreur."
                        }
                    ],
                    "synonyms": [
                        "tromper",
                        "égarer",
                        "pousser"
                    ],
                    "antonyms": [
                        "détromper"
                    ],
                    "common_phrases": [
                        "induire en erreur",
                        "induire en tentation"
                    ]
                },
                {
                    "sense_id": "06cc105e-3b41-3d8a-9060-1e1a1ee12ec3",
                    "sense_definition": "Entraîner, provoquer ou causer quelque chose comme conséquence nécessaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La réorganisation complète de l'entreprise va <w>induire</w> d'importants changements pour les salariés."
                        },
                        {
                            "text": "Ces nouveaux travaux risquent d'<w>induire</w> des dépenses imprévues pour la commune."
                        }
                    ],
                    "synonyms": [
                        "entraîner",
                        "provoquer",
                        "engendrer",
                        "causer"
                    ],
                    "antonyms": [
                        "empêcher",
                        "éviter"
                    ],
                    "common_phrases": [
                        "induire des changements",
                        "induire des coûts"
                    ]
                },
                {
                    "sense_id": "56243c75-85ca-303e-8b10-0dea617be594",
                    "sense_definition": "Tirer une conclusion générale ou une règle à partir de faits particuliers par induction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À partir de l'observation répétée de ces phénomènes, les chercheurs ont pu <w>induire</w> une loi générale."
                        },
                        {
                            "text": "Il est souvent difficile d'<w>induire</w> une règle universelle à partir de quelques exemples isolés."
                        }
                    ],
                    "synonyms": [
                        "inférer",
                        "conclure"
                    ],
                    "common_phrases": [
                        "induire une règle",
                        "induire une loi"
                    ]
                },
                {
                    "sense_id": "184fa37a-bedd-3fc3-80d7-fd3a75c87423",
                    "sense_definition": "Créer ou transmettre un phénomène électrique ou magnétique par induction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le déplacement de l'aimant permet d'<w>induire</w> un courant électrique dans la bobine."
                        },
                        {
                            "text": "Cette variation rapide du champ magnétique va <w>induire</w> une tension mesurable dans le circuit."
                        }
                    ],
                    "synonyms": [
                        "générer",
                        "produire"
                    ],
                    "common_phrases": [
                        "induire un courant",
                        "courant induit"
                    ]
                }
            ]
        }
    ]
}