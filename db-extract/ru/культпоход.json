                "senses": [
                    {
                        "sense_id": "f6a9fdf3-688c-3b56-bb3e-e2d4f3f4e399",
                        "entry_id": "1f294d5b-4891-32c8-9c1a-188fd030cf60",
                        "glosses": [
                            "коллективное посещение кино, театра, музея или другого культурно-просветительского учреждения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a52854c-28ce-4c53-adac-420dd0b629b3",
                                "sense_id": "f6a9fdf3-688c-3b56-bb3e-e2d4f3f4e399",
                                "text": "Раз в неделю в партийной школе устраивались культпоходы: в картинные галереи, на концерты, в музеи (дирекция школы заботилась о художественном воспитании своих учеников)."
                            },
                            {
                                "example_id": "0e71be9d-4ef3-48c8-b1fc-72bbbcc6288a",
                                "sense_id": "f6a9fdf3-688c-3b56-bb3e-e2d4f3f4e399",
                                "text": "В воскресенье идем культпоходом на «Евгения Онегина»."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbfcd480-60ef-3461-b39c-3d774f3d48e9",
                        "entry_id": "1f294d5b-4891-32c8-9c1a-188fd030cf60",
                        "glosses": [
                            "перен. шутл. совместное посещение чего-л."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0c1992c-55bb-4846-baed-b075f4090115",
                                "sense_id": "cbfcd480-60ef-3461-b39c-3d774f3d48e9",
                                "text": "После вчерашнего визита даже обыкновенный культпоход в кабак выглядел совсем иначе."
                            },
                            {
                                "example_id": "4742bc34-eae9-4882-8cf7-96c366a9e4c5",
                                "sense_id": "cbfcd480-60ef-3461-b39c-3d774f3d48e9",
                                "text": "Сегодня состоялся культпоход в баню."
                            }
                        ]
                    },
                    {
                        "sense_id": "459a4455-71eb-3cec-9d6d-827b726a9be0",
                        "entry_id": "1f294d5b-4891-32c8-9c1a-188fd030cf60",
                        "glosses": [
                            "устар. офиц. кампания по ликвидации неграмотности, культурному просвещению в раннем СССР"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "517df280-df99-4a69-9fc8-77b5c91f52c3",
                                "sense_id": "459a4455-71eb-3cec-9d6d-827b726a9be0",
                                "text": "Краевым и областным ОНО, штабам культпохода, всем культурно-просветительным учреждениям и всей культармии предложено включиться в подготовку к проведению массовой работы на основе заданий культэстафеты, выдвигая свой встречный план."
                            }
                        ]
                    }
