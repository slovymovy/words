                "senses": [
                    {
                        "sense_id": "67d6c90c-2bc5-3afe-bfac-28ef6bf8c590",
                        "entry_id": "418b4690-7e07-32de-84ff-4b5d9ed9e17d",
                        "glosses": [
                            "разг. полностью таять, исчезать под действием тепла"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80b49c99-ef02-457d-8d4b-b58dccc0ad5b",
                                "sense_id": "67d6c90c-2bc5-3afe-bfac-28ef6bf8c590",
                                "text": "Достигнув подножия горы, лёд вытаивает."
                            }
                        ]
                    },
                    {
                        "sense_id": "153d75a5-de25-3e7f-a0bc-e7ce9b2f31ac",
                        "entry_id": "418b4690-7e07-32de-84ff-4b5d9ed9e17d",
                        "glosses": [
                            "разг. становиться видимым, появляться из-под снега при таянии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65f2e5a8-f7b1-4505-a393-2e4519f73fde",
                                "sense_id": "153d75a5-de25-3e7f-a0bc-e7ce9b2f31ac",
                                "text": "Стали вытаивать молодые ребята, вроде бы ничем и не тронутые, вот-вот встанут с земли, улыбнутся и заговорят."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad897dc3-dd9a-39c2-bf9e-8b0df7ecab3c",
                        "entry_id": "418b4690-7e07-32de-84ff-4b5d9ed9e17d",
                        "glosses": [
                            "разг. освобождаться от снега"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47034552-c6e5-4436-b0ea-29b6e1c06fa0",
                                "sense_id": "ad897dc3-dd9a-39c2-bf9e-8b0df7ecab3c",
                                "text": "После двенадцати часов, в ясный день, нагретые прямыми лучами солнца, камни макушки начинают вытаивать изо льда и соскальзывать вниз."
                            }
                        ]
                    }
