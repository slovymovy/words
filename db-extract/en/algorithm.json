                                "target_senses": [
                                    {
                                        "sense_id": "f0e46578-d357-3c07-9b8f-31e26d8c8998",
                                        "entry_id": "b7a7723b-805d-3287-a58a-386a6c884fbb",
                                        "glosses": [
                                            "eine exakt beschriebene Vorgehensweise zum Lösen eines Problems in endlich vielen und eindeutig beschriebenen Schritten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f341544-1104-40fd-a38b-80e8a5655bb8",
                                                "sense_id": "f0e46578-d357-3c07-9b8f-31e26d8c8998",
                                                "text": "Es gibt rekursive und iterative Algorithmen."
                                            },
                                            {
                                                "example_id": "6f53b176-a354-43d0-ac04-48da7f7dde1c",
                                                "sense_id": "f0e46578-d357-3c07-9b8f-31e26d8c8998",
                                                "text": "„Insbesondere beruhen die meisten modernen Algorithmen auf mathematischen Strukturen.“"
                                            },
                                            {
                                                "example_id": "bc3e16bc-55c0-40e6-af1d-540715b5af37",
                                                "sense_id": "f0e46578-d357-3c07-9b8f-31e26d8c8998",
                                                "text": "Jedes mit einem Algorithmus lösbare mathematische Problem kann auch von einem Computer gelöst werden."
                                            },
                                            {
                                                "example_id": "fbd99e9f-9f59-48c5-b7e2-283500397e49",
                                                "sense_id": "f0e46578-d357-3c07-9b8f-31e26d8c8998",
                                                "text": "„Einen Algorithmus zur Steuerung einer Flugabwehrkanone, der die messbaren Daten des bisherigen Flugverhaltens nutzt, um vorauszusagen, wie sich der Pilot in den nächsten Sekunden verhalten wird.“"
                                            },
                                            {
                                                "example_id": "99e30d3a-e3ae-422f-aab5-f67c9d1d814d",
                                                "sense_id": "f0e46578-d357-3c07-9b8f-31e26d8c8998",
                                                "text": "„Doch nicht nur im Internet werden Algorithmen verwendet, auch in Krankenhäusern bei der Diagnosefindung, in Polizeistationen bei der Gesichtserkennung oder in Banken zur Einschätzung der Kreditwürdigkeit eines potenziellen Kreditnehmers kommen sie zum Einsatz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
