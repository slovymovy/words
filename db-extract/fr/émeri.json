        "fr-extract.jsonl": [
            {
                "entry_id": "c27391e8-6f3e-3110-8918-ba04c9cfcd26",
                "word": "émeri",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1a91c17d-b502-4982-a768-dcd264fea875",
                        "entry_id": "c27391e8-6f3e-3110-8918-ba04c9cfcd26",
                        "tags": [
                            "plural"
                        ],
                        "form": "émeris"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "20f0bf3b-c0ad-3913-9588-77f9009c3ec5",
                        "entry_id": "c27391e8-6f3e-3110-8918-ba04c9cfcd26",
                        "glosses": [
                            "Roche composée de spinelle et de corindon finement cristallisés, associés à la magnétite ou à l’hématite, employée sous forme de poudre pour polir les pierres, les métaux le verre et le cristal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6070e27-33dd-4eb5-bf64-9e118b3ed827",
                                "sense_id": "20f0bf3b-c0ad-3913-9588-77f9009c3ec5",
                                "text": "Polir un diamant avec de la poudre d’émeri."
                            },
                            {
                                "example_id": "c164dd54-04c6-48f3-b774-6cb473adea9e",
                                "sense_id": "20f0bf3b-c0ad-3913-9588-77f9009c3ec5",
                                "text": "Le même minerai [un minerai d’aluminium] se retrouve dans les Calabres, au Sénégal, dans l’archipel grec et dans les environs de Smyrne, où il forme l’émeri, résultat d’une altération métamorphique."
                            },
                            {
                                "example_id": "f5697b1f-24b8-4cad-9748-c627bb98c3c0",
                                "sense_id": "20f0bf3b-c0ad-3913-9588-77f9009c3ec5",
                                "text": "Boue ou potée d’émeri, matière qui se forme sous les roues ou meules dont les lapidaires se servent pour tailler les pierres"
                            }
                        ]
                    },
                    {
                        "sense_id": "58689da3-6f15-34fb-b88e-37f3a0ffe0b8",
                        "entry_id": "c27391e8-6f3e-3110-8918-ba04c9cfcd26",
                        "glosses": [
                            "Petites taches noires et dures qu’on rencontre dans certains marbres."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e1cd0bc-d3cf-46d2-8163-1ca4da5fe41b",
                        "source_entry_id": "c27391e8-6f3e-3110-8918-ba04c9cfcd26",
                        "target_lang_word": "Schmirgel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmirgel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c531d2d7-4c81-3617-bd6a-e977b269f819",
                                        "entry_id": "5e3c6e7f-4612-3087-904d-510fed18936f",
                                        "glosses": [
                                            "als Schleifmittel verwendetes feinkörniges Gestein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71224ad1-ea60-4242-852d-fd71df1f6ed2",
                                                "sense_id": "c531d2d7-4c81-3617-bd6a-e977b269f819",
                                                "text": "„Schmirgel ist ein extrem hartes Mineralgemenge aus Magneteisenstein, Glimmer und kristallinem Korund.“"
                                            },
                                            {
                                                "example_id": "e32494ef-b4b7-4614-a4ea-7cba90bf48d9",
                                                "sense_id": "c531d2d7-4c81-3617-bd6a-e977b269f819",
                                                "text": "„Die Gruppe der natürlichen Schleifmittel beinhaltet die Kornwerkstoffe Quarz (Flint), Korund, Schmirgel, Granat und Diamant.“"
                                            },
                                            {
                                                "example_id": "51f0ec62-1b75-480a-abb5-e02c48807e9c",
                                                "sense_id": "c531d2d7-4c81-3617-bd6a-e977b269f819",
                                                "text": "„Schmirgel und Alundum zerbröckeln auf diesen Materialien nicht so sehr und bleiben schleiffähig.“"
                                            },
                                            {
                                                "example_id": "56733010-f2e1-4a1c-bca9-435aefbe0942",
                                                "sense_id": "c531d2d7-4c81-3617-bd6a-e977b269f819",
                                                "text": "„Als Schleifmittel kommen heute fast nur mehr Schmirgel, natürlicher Korund, Kunstkorund und Silizium-Karbid in Betracht.“"
                                            },
                                            {
                                                "example_id": "ea86b7f8-6703-4ce1-8787-9560f01dfba8",
                                                "sense_id": "c531d2d7-4c81-3617-bd6a-e977b269f819",
                                                "text": "„Ein feinkörniges, inniges Gemenge von gemeinem Korund und verschiedenen Mineralien ist als Schmirgel bekannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b050a8f-3d03-4c4a-9892-13d2d008cdfa",
                        "source_entry_id": "c27391e8-6f3e-3110-8918-ba04c9cfcd26",
                        "target_lang_word": "emery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a94fd433-e075-34a6-8cb5-ba5bc7b7044f",
                                        "entry_id": "6ce32572-374c-30da-9d50-3cc5538c8ac8",
                                        "glosses": [
                                            "An impure type of corundum, often used for sanding or polishing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80d9fc6a-0f5b-4a7e-b24c-fdb202b32d8b",
                                                "sense_id": "a94fd433-e075-34a6-8cb5-ba5bc7b7044f",
                                                "text": "It took me from nine to ten days to grind and polish it ready for parabolising and silvering. I did this by hand labour with the aid of emery, but without a lathe. I finally used rouge instead of emery in grinding down the glass, until I could see my face in the mirror quite plain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
