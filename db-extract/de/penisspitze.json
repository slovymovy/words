                        "examples": [
                            {
                                "example_id": "30c99a64-5619-4a6a-9b13-b9b41c3f9c5c",
                                "sense_id": "ea9b9657-cf1f-3cc2-bef6-96695029be1e",
                                "text": "„Nach einer Weile wurde die teigige, von dicker Vorhaut umgebene Penisspitze weggezogen und Finger drückten ihre Lippen zurück.“"
                            },
                            {
                                "example_id": "baa9b359-a897-44ed-863c-f98b74eb8d6c",
                                "sense_id": "ea9b9657-cf1f-3cc2-bef6-96695029be1e",
                                "text": "„Sie sagte, wenn zwei Hunde kopulieren, schwillt die Penisspitze des Rüden an, und die Scheidenmuskeln der Hündin ziehen sich zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
