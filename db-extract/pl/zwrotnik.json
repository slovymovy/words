                                "target_senses": [
                                    {
                                        "sense_id": "ac44f0cb-e366-32f8-85e1-72dfd702b505",
                                        "entry_id": "b759e8eb-5aa3-357a-8597-3170bb287d6f",
                                        "glosses": [
                                            "Chacun des deux parallèles de la sphère terrestre qui dans l'hémisphère boréal ou austral séparent la zone torride de la zone tempérée. Le soleil y atteint le zénith une fois par an, lors des solstices et aux latitudes de ±23° 26′."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd0008f3-0f03-4756-83c4-85cedafca7f5",
                                                "sense_id": "ac44f0cb-e366-32f8-85e1-72dfd702b505",
                                                "text": "Le soleil des tropiques avait embelli sa blanche figure d’une teinte brune, d’un coloris merveilleux qui lui donnaient une expression de poésie ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d94d40c9-787a-33f7-86c2-7d4488d83895",
                                        "entry_id": "b759e8eb-5aa3-357a-8597-3170bb287d6f",
                                        "glosses": [
                                            "Chacun des deux parallèles de la sphère céleste qui passent par les points solsticiaux, c'est-à-dire à la verticale d’un tropique sur la Terre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
