                "senses": [
                    {
                        "sense_id": "d992fb72-5cd7-315a-8d73-28ee1c055c21",
                        "entry_id": "7e0f69cb-9b51-3fa4-b322-6a7913a8a4a7",
                        "glosses": [
                            "Considérer comme homologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a35d0a71-4c06-482c-bd4d-8c0f8b4e626d",
                                "sense_id": "d992fb72-5cd7-315a-8d73-28ee1c055c21",
                                "text": "W. K. Parker les interpréta comme des cartilages labiaux, „labial cartilage“, et il est disposé à les homologiser avec les conformations homonymes des Amphibiens anoures."
                            },
                            {
                                "example_id": "af58d38b-164a-4284-8011-79f8ffeb2de6",
                                "sense_id": "d992fb72-5cd7-315a-8d73-28ee1c055c21",
                                "text": "Homologiser ces deux organes serait, d’après lui, aussi monstrueux que si l’on voulait homologiser le conarium d'un animal vertébré avec le prolongement infundibulaire de l'autre."
                            },
                            {
                                "example_id": "a6f52d19-3cb8-45ce-9828-dedcd39a3d09",
                                "sense_id": "d992fb72-5cd7-315a-8d73-28ee1c055c21",
                                "text": "Vous connaissez le défaut d'un certain esprit débile qui se complait à \"homologiser\" l'Histoire..."
                            }
                        ]
                    }
