                                                "example_id": "c420c73b-e6ac-4ab4-a643-96138319355d",
                                                "sense_id": "cc96ec32-b889-33f6-a730-80997639eb21",
                                                "text": "My favorite sports organizations are the National Football League and the American League in baseball."
                                            },
                                            {
                                                "example_id": "e638ad97-32de-48e1-a455-a236278e6bcb",
                                                "sense_id": "cc96ec32-b889-33f6-a730-80997639eb21",
