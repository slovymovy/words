{
    "word_family": [
        "damnation",
        "damnable"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "98f1cdc6-7ff4-305c-b493-dce215ce53f9",
                    "sense_definition": "Used to express anger, irritation, disappointment, annoyance, contempt, or surprise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exclamation_intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh <w>damn</w>, I completely forgot to bring my wallet with me.",
                            "target_lang_translations": {
                                "ru": "О <w>чёрт</w>, я совсем забыл взять с собой кошелек.",
                                "zh": "噢<w>该死</w>，我完全忘了带钱包。",
                                "fr": "Oh <w>mince</w>, j'ai complètement oublié de prendre mon portefeuille."
                            }
                        },
                        {
                            "text": "<w>Damn</w> it, I cannot believe we missed the last train home.",
                            "target_lang_translations": {
                                "ru": "<w>Чёрт побери</w>, не могу поверить, что мы опоздали на последнюю электричку домой.",
                                "zh": "<w>见鬼</w>，真不敢相信我们错过了回家的末班车。",
                                "fr": "<w>Merde</w>, je n'arrive pas à croire qu'on ait raté le dernier train pour rentrer."
                            }
                        }
                    ],
                    "synonyms": [
                        "shoot",
                        "hell",
                        "shit",
                        "drat",
                        "blast"
                    ],
                    "common_phrases": [
                        "damn it",
                        "god damn"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения гнева, раздражения, разочарования или удивления.",
                        "zh": "用于表达愤怒、恼火、失望或惊讶的感叹词。",
                        "fr": "Utilisé pour exprimer la colère, l'agacement, la déception ou la surprise."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёрт побери",
                                "target_lang_sense_clarification": "выражение досады или гнева"
                            },
                            {
                                "target_lang_word": "проклятие",
                                "target_lang_sense_clarification": "эмоциональное восклицание"
                            },
                            {
                                "target_lang_word": "блин",
                                "target_lang_sense_clarification": "разговорный эвфемизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "该死",
                                "target_lang_sense_clarification": "表达愤怒或懊恼"
                            },
                            {
                                "target_lang_word": "见鬼",
                                "target_lang_sense_clarification": "表达惊讶或不满"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "mince",
                                "target_lang_sense_clarification": "atténué, pour exprimer le dépit ou la surprise"
                            },
                            {
                                "target_lang_word": "zut",
                                "target_lang_sense_clarification": "familier, marque l'impatience ou le dépit"
                            },
                            {
                                "target_lang_word": "merde",
                                "target_lang_sense_clarification": "vulgaire, exprime la colère ou la déception"
                            },
                            {
                                "target_lang_word": "putain",
                                "target_lang_sense_clarification": "très familier ou vulgaire, juron d'exaspération"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "568102cf-5aa5-32b2-aa2f-785968a640a7",
                    "sense_definition": "Used as an intensifier to express annoyance, anger, or emphasis.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exclamation_intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot find a single <w>damn</w> thing in this messy room.",
                            "target_lang_translations": {
                                "ru": "Я не могу найти ни одной <w>чёртовой</w> вещи в этой грязной комнате.",
                                "zh": "在这乱七八糟的房间里，我连一件<w>该死的</w>东西都找不到。",
                                "fr": "Je ne trouve pas une <w>foutue</w> chose dans ce bazar de chambre."
                            }
                        },
                        {
                            "text": "Turn off that <w>damn</w> music before I call the police.",
                            "target_lang_translations": {
                                "ru": "Выключи эту <w>проклятую</w> музыку, пока я не вызвал полицию.",
                                "zh": "在我报警之前，把那<w>该死的</w>音乐关掉。",
                                "fr": "Éteins cette <w>maudite</w> musique avant que j'appelle la police."
                            }
                        }
                    ],
                    "synonyms": [
                        "bloody",
                        "goddamn",
                        "fucking",
                        "blasted",
                        "fricking"
                    ],
                    "common_phrases": [
                        "damn fool",
                        "damn thing",
                        "whole damn time"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как усилитель для выражения раздражения, гнева или эмфазы.",
                        "zh": "用作强调词，以表达恼火、愤怒或加强语气。",
                        "fr": "Utilisé comme intensificateur pour exprimer l'agacement, la colère ou l'insistance."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёртов",
                                "target_lang_sense_clarification": "разговорное, выражает недовольство"
                            },
                            {
                                "target_lang_word": "проклятый",
                                "target_lang_sense_clarification": "более сильное выражение ненависти или раздражения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "该死的",
                                "target_lang_sense_clarification": "口语，表达不满"
                            },
                            {
                                "target_lang_word": "讨厌的",
                                "target_lang_sense_clarification": "表达厌恶"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "foutu",
                                "target_lang_sense_clarification": "familier, valeur péjorative ou emphatique devant un nom"
                            },
                            {
                                "target_lang_word": "maudit",
                                "target_lang_sense_clarification": "marque l'exaspération ou le rejet"
                            },
                            {
                                "target_lang_word": "sacré",
                                "target_lang_sense_clarification": "familier, intensificateur marquant l'énervement"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ee49b845-4994-39b3-8e75-b65fa5b88fe3",
                    "sense_definition": "Very or extremely; used to emphasize an adjective or adverb.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "exclamation_intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You know <w>damn</w> well that I did not say that to him.",
                            "target_lang_translations": {
                                "ru": "Ты <w>чертовски</w> хорошо знаешь, что я не говорил ему этого.",
                                "zh": "你<w>非常</w>清楚我没对他那样说。",
                                "fr": "Tu sais <w>pertinemment</w> bien que je ne lui ai pas dit ça."
                            }
                        },
                        {
                            "text": "That was a <w>damn</w> good movie we watched at the cinema yesterday.",
                            "target_lang_translations": {
                                "ru": "Это был <w>чертовски</w> хороший фильм, который мы смотрели вчера в кино.",
                                "zh": "我们昨天在电影院看的那部电影<w>极其</w>好看。",
                                "fr": "C'était un <w>sacrément</w> bon film qu'on a vu au cinéma hier."
                            }
                        }
                    ],
                    "synonyms": [
                        "awfully",
                        "extremely",
                        "terribly",
                        "incredibly",
                        "bloody"
                    ],
                    "common_phrases": [
                        "damn well",
                        "damn near",
                        "damn good"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень или чрезвычайно; используется для усиления прилагательного или наречия.",
                        "zh": "非常或极其；用于加强形容词或副词的语气。",
                        "fr": "Très ou extrêmement ; utilisé pour renforcer un adjectif ou un adverbe."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертовски",
                                "target_lang_sense_clarification": "разговорное, в значении «очень»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "口语中加强语气"
                            },
                            {
                                "target_lang_word": "极其",
                                "target_lang_sense_clarification": "程度副词"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "vachement",
                                "target_lang_sense_clarification": "familier, très ou extrêmement"
                            },
                            {
                                "target_lang_word": "rudement",
                                "target_lang_sense_clarification": "familier, au plus haut point"
                            },
                            {
                                "target_lang_word": "sacrément",
                                "target_lang_sense_clarification": "familier, très fortement"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "07b5ee10-d020-3d97-8fe3-430c1432469d",
                    "sense_definition": "To condemn someone to eternal punishment or a terrible fate.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "condemn_curse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient texts say the gods will <w>damn</w> the wicked for eternity.",
                            "target_lang_translations": {
                                "ru": "Древние тексты гласят, что боги <w>проклянут</w> грешников навечно.",
                                "zh": "古籍记载，神明将永远<w>诅咒</w>恶人。",
                                "fr": "Les textes anciens disent que les dieux vont <w>damner</w> les méchants pour l'éternité."
                            }
                        },
                        {
                            "text": "He felt that his past mistakes would <w>damn</w> him to a life of regret.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что прошлые ошибки <w>обрекут</w> его на жизнь, полную сожалений.",
                                "zh": "他觉得过去的错误会让他<w>注定</w>一生都在后悔中度过。",
                                "fr": "Il sentait que ses erreurs passées allaient le <w>condamner</w> à une vie de regrets."
                            }
                        }
                    ],
                    "synonyms": [
                        "condemn",
                        "doom",
                        "curse"
                    ],
                    "antonyms": [
                        "save",
                        "bless"
                    ],
                    "common_phrases": [
                        "damn to hell",
                        "be damned"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрекать кого-либо на вечные муки или ужасную участь.",
                        "zh": "判处某人遭受永恒的惩罚或可怕的命运。",
                        "fr": "Condamner quelqu'un aux peines éternelles ou à un sort funeste."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проклинать",
                                "target_lang_sense_clarification": "предавать анафеме, желать вечных мук"
                            },
                            {
                                "target_lang_word": "обрекать",
                                "target_lang_sense_clarification": "на страдания или гибель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诅咒",
                                "target_lang_sense_clarification": "使遭受厄运"
                            },
                            {
                                "target_lang_word": "注定",
                                "target_lang_sense_clarification": "命中注定遭受不幸"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "damner",
                                "target_lang_sense_clarification": "vouer aux supplices de l'enfer"
                            },
                            {
                                "target_lang_word": "condamner",
                                "target_lang_sense_clarification": "vouer à un châtiment ou à un sort terrible"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e53af48-71a6-3e2f-a75e-f44245caaafc",
                    "sense_definition": "To curse or express great anger toward someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "condemn_curse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>damn</w> the day I ever met that dishonest man.",
                            "target_lang_translations": {
                                "ru": "Я <w>проклинаю</w> тот день, когда встретил этого лживого человека.",
                                "zh": "我<w>诅咒</w>我遇见那个骗子的那一天。",
                                "fr": "Je <w>maudis</w> le jour où j'ai rencontré cet homme malhonnête."
                            }
                        },
                        {
                            "text": "The farmer started to <w>damn</w> the weather when the heavy rain destroyed his crops.",
                            "target_lang_translations": {
                                "ru": "Фермер начал <w>клясть</w> погоду, когда сильный дождь уничтожил его урожай.",
                                "zh": "当大雨毁了庄稼时，农民开始<w>咒骂</w>这鬼天气。",
                                "fr": "Le fermier a commencé à <w>maudire</w> la météo quand la pluie battante a détruit ses récoltes."
                            }
                        }
                    ],
                    "synonyms": [
                        "curse",
                        "execrate"
                    ],
                    "antonyms": [
                        "bless"
                    ],
                    "common_phrases": [
                        "damn you"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проклинать или выражать сильный гнев по отношению к кому-либо или чему-либо.",
                        "zh": "诅咒或对某人或某事表达强烈的愤怒。",
                        "fr": "Maudire ou manifester une vive colère contre quelqu'un ou quelque chose."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проклинать",
                                "target_lang_sense_clarification": "желать зла, сильно ругать"
                            },
                            {
                                "target_lang_word": "клясть",
                                "target_lang_sense_clarification": "бранить, ругать судьбу или обстоятельства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诅咒",
                                "target_lang_sense_clarification": "表达强烈不满"
                            },
                            {
                                "target_lang_word": "咒骂",
                                "target_lang_sense_clarification": "口头上的愤怒表达"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "maudire",
                                "target_lang_sense_clarification": "vouloir du malheur ou vouer à l'exécration"
                            },
                            {
                                "target_lang_word": "pester contre",
                                "target_lang_sense_clarification": "manifester son mécontentement ou sa mauvaise humeur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5997a55a-b85c-3515-90c4-94731692b2ab",
                    "sense_definition": "To criticize strongly or declare something as unfit or invalid.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "condemn_curse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics were quick to <w>damn</w> the new play as boring and uninspired.",
                            "target_lang_translations": {
                                "ru": "Критики поспешили <w>раскритиковать</w> новую пьесу как скучную и бездарную.",
                                "zh": "评论家们很快就<w>抨击</w>这部新剧枯燥乏味、毫无灵感。",
                                "fr": "Les critiques se sont empressés d'<w>éreinter</w> la nouvelle pièce, jugée ennuyeuse et sans éclat."
                            }
                        },
                        {
                            "text": "Do not <w>damn</w> the entire project just because of one small mistake.",
                            "target_lang_translations": {
                                "ru": "Не стоит <w>осуждать</w> весь проект только из-за одной маленькой ошибки.",
                                "zh": "不要仅仅因为一个小错误就<w>谴责</w>整个项目。",
                                "fr": "Ne va pas <w>condamner</w> tout le projet juste à cause d'une petite erreur."
                            }
                        }
                    ],
                    "synonyms": [
                        "condemn",
                        "criticize",
                        "censure"
                    ],
                    "antonyms": [
                        "praise",
                        "acclaim"
                    ],
                    "common_phrases": [
                        "damn with faint praise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко критиковать или признавать что-либо негодным.",
                        "zh": "强烈批评或宣布某事物不合格或无效。",
                        "fr": "Critiquer sévèrement ou condamner sans appel."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осуждать",
                                "target_lang_sense_clarification": "выражать неодобрение"
                            },
                            {
                                "target_lang_word": "порицать",
                                "target_lang_sense_clarification": "книжное, критиковать"
                            },
                            {
                                "target_lang_word": "критиковать",
                                "target_lang_sense_clarification": "давать негативную оценку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谴责",
                                "target_lang_sense_clarification": "严厉批评"
                            },
                            {
                                "target_lang_word": "抨击",
                                "target_lang_sense_clarification": "强烈反对"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "condamner",
                                "target_lang_sense_clarification": "désapprouver ou rejeter catégoriquement"
                            },
                            {
                                "target_lang_word": "éreinter",
                                "target_lang_sense_clarification": "critiquer impitoyablement"
                            },
                            {
                                "target_lang_word": "démolir",
                                "target_lang_sense_clarification": "familièrement, anéantir par la critique"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b67a7a8-48de-3245-a847-25b9c7425c83",
                    "sense_definition": "The smallest amount of concern, consideration, or value.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "negligible_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Frankly, my dear, I do not give a <w>damn</w> about your problems.",
                            "target_lang_translations": {
                                "ru": "Честно говоря, дорогая, мне <w>плевать</w> на твои проблемы.",
                                "zh": "亲爱的，坦白说，我一点也不<w>在乎</w>你的问题。",
                                "fr": "Franchement, ma chère, je n'en ai <w>rien à cirer</w> de vos problèmes."
                            }
                        },
                        {
                            "text": "This old broken radio is not worth a <w>damn</w> anymore.",
                            "target_lang_translations": {
                                "ru": "Это старое сломанное радио больше не стоит и <w>гроша</w>.",
                                "zh": "这台破旧的收音机已经<w>一文不值</w>了。",
                                "fr": "Cette vieille radio cassée ne vaut plus un <w>clou</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "jot",
                        "whit",
                        "rap",
                        "hoot"
                    ],
                    "common_phrases": [
                        "give a damn",
                        "worth a damn"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in negative idioms"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Малейшая доля беспокойства, внимания или ценности (обычно в отрицательных идиомах).",
                        "zh": "极小的关心、考虑或价值（通常用于否定句）。",
                        "fr": "La moindre marque d'intérêt, de considération ou de valeur (dans des contextes négatifs)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плевать",
                                "target_lang_sense_clarification": "в значении «все равно» (give a damn)"
                            },
                            {
                                "target_lang_word": "грош",
                                "target_lang_sense_clarification": "в значении «ничего не стоит» (worth a damn)"
                            },
                            {
                                "target_lang_word": "чёрт",
                                "target_lang_sense_clarification": "в идиомах (ни черта)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在乎",
                                "target_lang_sense_clarification": "用于否定句表示不在乎"
                            },
                            {
                                "target_lang_word": "一文不值",
                                "target_lang_sense_clarification": "形容毫无价值"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "rien",
                                "target_lang_sense_clarification": "dans le sens d'absolument rien ou pas grand-chose"
                            },
