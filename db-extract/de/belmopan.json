                ],
                "senses": [
                    {
                        "sense_id": "e98924ee-5fa8-30b9-a362-fd525aa5f1c1",
                        "entry_id": "b5b57e68-93d1-3e30-8b4b-3f2ee1b1860c",
                        "glosses": [
                            "Hauptstadt von Belize"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b58fc88-7080-4ee7-9745-b544d3f7e837",
                                "sense_id": "e98924ee-5fa8-30b9-a362-fd525aa5f1c1",
                                "text": "„Das Klima ist während des ganzen Jahres unangenehm heiß - so heiß, daß tagsüber kaum jemand auf den Straßen der am Reißbrett geplanten, ohnehin nicht sonderlich attraktiven Hauptstadt Belmopan anzutreffen ist.“"
                            },
                            {
                                "example_id": "0a6d5842-5305-4a8d-b093-ab1785bbda98",
                                "sense_id": "e98924ee-5fa8-30b9-a362-fd525aa5f1c1",
                                "text": "„Washington ist mit 26 Diplomaten in der Hauptstadt Belmopan vertreten, der Stab der früheren Kolonialmacht England umfaßt nur neun Mitarbeiter.“"
                            },
                            {
                                "example_id": "3623daff-d6f0-4f89-a184-9c907b8df0a4",
                                "sense_id": "e98924ee-5fa8-30b9-a362-fd525aa5f1c1",
                                "text": "„Sie hätten unbedingt „den Nervenkitzel eines Hurrikans erleben wollen“, sagte eine Sprecherin des Außenministerium [sic!] in Belmopan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
