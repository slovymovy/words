                "senses": [
                    {
                        "sense_id": "4f09cc6b-7eda-3bb0-9e7b-db2105cfc907",
                        "entry_id": "2d858da8-4bc7-381c-9064-43fd2ff1d133",
                        "glosses": [
                            "бросить вниз откуда-либо, с чего-либо; сбросить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cede044-26c1-4404-9d55-f81083186aee",
                                "sense_id": "4f09cc6b-7eda-3bb0-9e7b-db2105cfc907",
                                "text": "Денисов скинул обе подушки на пол."
                            }
                        ]
                    },
                    {
                        "sense_id": "28984846-ab03-3560-8c7f-cfa7404bb8d8",
                        "entry_id": "2d858da8-4bc7-381c-9064-43fd2ff1d133",
                        "glosses": [
                            "опустить (трап, сходни, канат и т. п.) одним концом вниз на причал, пристань и т. д."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ec088117-3ad4-32a4-989b-1cc02cdc5847",
                        "entry_id": "2d858da8-4bc7-381c-9064-43fd2ff1d133",
                        "glosses": [
                            "перен., разг. то же, что свергнуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b8edab0-d66b-4f71-a731-7c9acc1104d8",
                                "sense_id": "ec088117-3ad4-32a4-989b-1cc02cdc5847",
                                "text": "В маленький городок вихрем ворвалась ошеломляющая весть: «Царя скинули!»"
                            }
                        ]
                    },
                    {
                        "sense_id": "4226c8bd-3eba-3c53-9aa3-e6067a4ff561",
                        "entry_id": "2d858da8-4bc7-381c-9064-43fd2ff1d133",
                        "glosses": [
                            "разг. снять надетое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53836a63-e30b-41c8-a3c2-7238ea60aa0c",
                                "sense_id": "4226c8bd-3eba-3c53-9aa3-e6067a4ff561",
                                "text": "Скинуть шапку"
                            },
                            {
                                "example_id": "eac01460-5b87-4ef6-a2ee-5983791be754",
                                "sense_id": "4226c8bd-3eba-3c53-9aa3-e6067a4ff561",
                                "text": "Скинуть узду"
                            },
                            {
                                "example_id": "9a35484f-16d4-4ad4-9fa5-b5c157e1ffa3",
                                "sense_id": "4226c8bd-3eba-3c53-9aa3-e6067a4ff561",
                                "text": "Скинет крестьянин полушубок, выйдет в одной рубашке на воздух, и, прикрыв глаза рукой, долго любуется солнцем."
                            }
                        ]
                    },
                    {
                        "sense_id": "92e739c6-a5ec-3753-907f-9a75b0e4060b",
                        "entry_id": "2d858da8-4bc7-381c-9064-43fd2ff1d133",
                        "glosses": [
                            "биол. вылинять при сезонной линьке, сбросить листву и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36e2af0b-b7aa-4536-a35a-f34764f0f837",
                                "sense_id": "92e739c6-a5ec-3753-907f-9a75b0e4060b",
                                "text": "Лес скинул последнюю листву."
                            }
                        ]
                    },
                    {
                        "sense_id": "74d3070d-b944-3da4-a0ce-4b779ad2a3a0",
                        "entry_id": "2d858da8-4bc7-381c-9064-43fd2ff1d133",
                        "glosses": [
                            "перен. избавиться, освободиться от чего-либо, от какого-либо состояния (обычно неприятного, тягостного)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49e3d992-1a79-43d3-8338-6e109200ea4f",
                                "sense_id": "74d3070d-b944-3da4-a0ce-4b779ad2a3a0",
                                "text": "[Марья] как будто сразу скинула с себя лень и дурь."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4d9600f-d3ca-3717-8a54-fae4e13bd2be",
                        "entry_id": "2d858da8-4bc7-381c-9064-43fd2ff1d133",
                        "glosses": [
                            "прост. уменьшить что-либо на какое-либо количество, какую-либо величину; сбавить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ebc40cb-d3b5-4938-ba5d-063796d08da9",
                                "sense_id": "a4d9600f-d3ca-3717-8a54-fae4e13bd2be",
                                "text": "— Да хорошенько веничком попарь. Вот так-то я, глядишь, чуток и в весе скину."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d964f08-ca0c-3443-9c39-837188129589",
                        "entry_id": "2d858da8-4bc7-381c-9064-43fd2ff1d133",
                        "glosses": [
                            "разг. уменьшить на какую-либо сумму цену чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4281982d-945a-4499-a663-4368a67d9801",
                                "sense_id": "1d964f08-ca0c-3443-9c39-837188129589",
                                "text": "[Лабазник:] Ступайте прочь! Чего напёрли снова! // Ведь сказана цена вам: семь алтын // За полчетвёрки! // [Один из народа:] Батюшка, помилуй! // Скинь хоть алтын!"
                            }
                        ]
                    },
                    {
                        "sense_id": "4e63c919-8c5c-39b8-9142-08301b78b286",
                        "entry_id": "2d858da8-4bc7-381c-9064-43fd2ff1d133",
                        "glosses": [
                            "неол., разг. послать по интернету, СМС"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2759e9b3-5310-4d94-aae2-60dcbb427582",
                                "sense_id": "4e63c919-8c5c-39b8-9142-08301b78b286",
                                "text": "Я тебе на электронную почту скину."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d9143f6-c57f-3388-b90e-ae7748a3cbe8",
                        "entry_id": "2d858da8-4bc7-381c-9064-43fd2ff1d133",
                        "glosses": [
                            "прост. родить, произвести на свет раньше срока; выкинуть"
                        ],
                        "tags": [
                            "также без доп.,"
                        ],
                        "examples": [
                            {
                                "example_id": "9e529af4-c26e-47f7-9319-1efafd839fde",
                                "sense_id": "6d9143f6-c57f-3388-b90e-ae7748a3cbe8",
                                "text": "Ребёнка она скинула на шестом месяце."
                            }
                        ]
                    },
                    {
                        "sense_id": "766798c8-1122-3cec-954d-11252fc97734",
                        "entry_id": "2d858da8-4bc7-381c-9064-43fd2ff1d133",
                        "glosses": [
                            "карт. положить меньшую по достоинству карту, отдавая взятку противнику или партнёру"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f0184a90-1b45-3c63-9697-25fec494d540",
                        "entry_id": "2d858da8-4bc7-381c-9064-43fd2ff1d133",
                        "glosses": [
                            "устар., разг. при подсчёте на счётах и т. п. — снять какую-либо сумму со счёта, отодвинув косточки назад, в исходное положение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e093c38-446b-4c17-a079-5fab05c08f0b",
                                "sense_id": "f0184a90-1b45-3c63-9697-25fec494d540",
                                "text": "Он взял счёты, посмотрел на них и положил — двадцать копеек. Посмотрел ещё и — семнадцать скинул. Осталось три копейки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35b05a6a-c161-4157-a8ec-ee6dca2c1c35",
                        "source_entry_id": "2d858da8-4bc7-381c-9064-43fd2ff1d133",
                        "source_sense_description": "снять надетое",
                        "target_lang_word": "pull out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pull out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84993ed3-62d8-3cde-af0e-30da34d83298",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see pull, out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b7f1d69-89fa-4dc6-b057-65791cc26adb",
                                                "sense_id": "84993ed3-62d8-3cde-af0e-30da34d83298",
                                                "text": "I need to pull the splinter out of my hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01cb3729-eba5-39bb-b1a1-cdf9cc4e0230",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "To withdraw; especially of military forces; to retreat."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51ac0488-a05e-43ba-9627-609aaa94eaf9",
                                                "sense_id": "01cb3729-eba5-39bb-b1a1-cdf9cc4e0230",
                                                "text": "The troops pulled out of the conflict."
                                            },
                                            {
                                                "example_id": "ed2df8ef-58d9-40a1-a19b-4798f5e71da9",
                                                "sense_id": "01cb3729-eba5-39bb-b1a1-cdf9cc4e0230",
                                                "text": "The mayor pulled out of the race for Senate after numerous opinion polls had him polling at less than 10 percent."
                                            },
                                            {
                                                "example_id": "61572bb4-406a-44a5-bba9-e4cba354ea7b",
                                                "sense_id": "01cb3729-eba5-39bb-b1a1-cdf9cc4e0230",
                                                "text": "The racehorse pulled out of the Stakes with a hurt foot."
                                            },
                                            {
                                                "example_id": "2f647e5a-97e2-4291-bc44-57faaa039083",
                                                "sense_id": "01cb3729-eba5-39bb-b1a1-cdf9cc4e0230",
                                                "text": "Pulling out of Paris would cause serious diplomatic damage."
                                            },
                                            {
                                                "example_id": "52f1145e-e264-43e9-a1f7-99cf207219b0",
                                                "sense_id": "01cb3729-eba5-39bb-b1a1-cdf9cc4e0230",
                                                "text": "There is still time to find a buyer and for them to stabilise the operation, especially if the deal were done by 31 May – when the club’s special licence to carry on is due to expire. There remain plenty of interested parties, who can only see Chelsea’s price dropping as sponsors pull out or consider their associations; as revenue streams are hit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8269eb62-1c2d-3eaa-b8b9-f3b2382a38cc",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "To transition from a dive to level or climbing flight."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8ec917e-6c5b-4c4a-8b53-f4e26080c364",
                                                "sense_id": "8269eb62-1c2d-3eaa-b8b9-f3b2382a38cc",
                                                "text": "After releasing its bomb, the plane pulled out of its dive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5059e3af-bff9-3c7c-aa35-1cd331307a3f",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "To use coitus interruptus as a method of birth control."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfd36f06-3b59-4d54-ae64-88e5060c51ac",
                                                "sense_id": "5059e3af-bff9-3c7c-aa35-1cd331307a3f",
                                                "text": "Shortly before you ejaculate, you can pull out and use your hand (or hers) to push yourself over the edge. Some of my patients claim this is a more natural method of birth control[…]"
                                            },
                                            {
                                                "example_id": "b46e68dc-c7c5-4026-91e1-174704170ff2",
                                                "sense_id": "5059e3af-bff9-3c7c-aa35-1cd331307a3f",
                                                "text": "She'd long since caught the knack of moving with him, and closed her arms and legs around him. “You'll fly with me, Tiberius? Take the last fence with me?” He'd meant to pull out. Coitus interruptus was a term even the scholars failing their Latin knew before they left public school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c82de0e-90c3-3e71-8ed7-0a63397d9c41",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "To remove something from a container."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "216a0f5b-9494-4849-a430-a8abcfac8f29",
                                                "sense_id": "2c82de0e-90c3-3e71-8ed7-0a63397d9c41",
                                                "text": "He pulled his gun out before she had a chance to scream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84f4515-694e-3bf8-bd9e-552ff12efde0",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "To maneuver a vehicle from the side of a road onto the lane."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9176ba4-86a1-47a3-9a83-5635eb4b65eb",
                                                "sense_id": "e84f4515-694e-3bf8-bd9e-552ff12efde0",
                                                "text": "When joining a road, you should check for traffic before pulling out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da9f0a2f-be3e-34b5-ab76-a5e2c47502b2",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "To draw out or lengthen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
