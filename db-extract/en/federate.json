                "translations": [
                    {
                        "translation_id": "00fb20a0-b82d-43de-a427-a70e238ac902",
                        "source_entry_id": "ad142a60-5b42-34b2-8a62-e2724f4a00a1",
                        "source_sense_id": "1e28e61b-54f9-37a3-ab8e-504a1d55e18c",
                        "source_sense_description": "Translations",
                        "target_lang_word": "fédérer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fédérer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bbc9268d-a2e7-3fbb-b190-4ccb33fe6442",
                                        "entry_id": "27ff428a-f83d-3050-8190-701dda656fe1",
                                        "glosses": [
                                            "Réunir en fédération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a9543f-3e9a-41e8-a35f-8e5ddd185387",
                                                "sense_id": "bbc9268d-a2e7-3fbb-b190-4ccb33fe6442",
                                                "text": "Il fédéra ces divers états. On dit le plus souvent Se fédérer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d500532-64da-31ad-ac56-8959958ea427",
                                        "entry_id": "27ff428a-f83d-3050-8190-701dda656fe1",
                                        "glosses": [
                                            "Regrouper des personnes dans un but commun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80f019c-5220-454e-8632-a73bbdad149e",
                                                "sense_id": "7d500532-64da-31ad-ac56-8959958ea427",
                                                "text": "J’aimerais qu’ils réfléchissent à cette phrase toute bête : les réformes de structures ont toujours divisé les Français alors que les changements de pratiques peuvent les fédérer."
                                            },
                                            {
                                                "example_id": "43f80989-ff6b-4703-b45b-9bfe97c68f77",
                                                "sense_id": "7d500532-64da-31ad-ac56-8959958ea427",
                                                "text": "S’ils détestent les organisations pyramidales, les silos, les chefs control freak, ils veulent des manageurs qui fédèrent le collectif, en étant constructifs et attentifs à chacun."
                                            },
                                            {
                                                "example_id": "40a8ede7-9620-4ea8-a6c3-2712ffe6ca0e",
                                                "sense_id": "7d500532-64da-31ad-ac56-8959958ea427",
                                                "text": "Leurs intérêts ne sont pas toujours compatibles. Mais ils se fédèrent volontiers contre des ennemis communs : les élites politiques, économiques et médiatiques. Elles seraient la source principale de leurs « malheurs »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
