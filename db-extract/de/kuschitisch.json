                ],
                "senses": [
                    {
                        "sense_id": "6f64356c-ed9d-3d03-aed3-de4980422fb5",
                        "entry_id": "e03552e9-da11-3d7f-9dd8-1f0f09eae053",
                        "glosses": [
                            "den Kuschiten zugehörig, von Kuschiten stammend, auf die Sprachen der Kuschiten bezogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92162b01-e89a-4541-abb2-a049473f20d4",
                                "sense_id": "6f64356c-ed9d-3d03-aed3-de4980422fb5",
                                "text": "Da redeten Mirjam und Aaron gegen Mose um seiner Frau willen, der Kuschiterin, die er genommen hatte. Er hatte sich nämlich eine kuschitische Frau genommen."
                            },
                            {
                                "example_id": "b343796a-6c8b-4e4f-86a1-68e7b605b59c",
                                "sense_id": "6f64356c-ed9d-3d03-aed3-de4980422fb5",
                                "text": "Wie es scheint, war es im dritten Jahrtausend vor Christus, daß in das von den Akkadern bewohnte nachherige Chaldäa sowie in die umliegenden Lande kuschitische Semiten einwanderten, von denen die Nationalität, die Sprache und die Religion der Akkader allmählich mehr und mehr zurückgedrängt wurden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2946a841-4199-4b8c-a4e9-f6bc47320996",
