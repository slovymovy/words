                        "glosses": [
                            "Sammelbezeichnung für Personen, die nicht heterosexuell sind oder deren Geschlechtsidentität nicht dem binären Modell von männlich und weiblich entspricht"
                        ],
                        "tags": [],
                        "examples": [
