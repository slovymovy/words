                    {
                        "translation_id": "3e377660-4909-40af-b0d8-c2f5f8554b7f",
                        "source_entry_id": "22047bd4-0b4c-3db9-bd26-7a5d3b6315b0",
                        "source_sense_id": "b43aac30-61a3-3293-80a3-0823601b3271",
