{
    "word_family": [
        "pioneering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9337949d-0845-3e37-af48-0300e0c5c748",
                    "sense_definition": "To be the first to do or achieve something, preparing the way for others to follow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "innovation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young doctor <w>pioneered</w> a new life-saving surgical technique.",
                            "target_lang_translations": {
                                "ru": "Молодой врач <w>стал первопроходцем</w> в использовании новой спасительной хирургической техники."
                            }
                        },
                        {
                            "text": "Our company aims to <w>pioneer</w> new technology in the field of renewable energy.",
                            "target_lang_translations": {
                                "ru": "Наша компания стремится <w>внедрять</w> новые технологии в области возобновляемых источников энергии."
                            }
                        }
                    ],
                    "synonyms": [
                        "push the envelope",
                        "break new ground"
                    ],
                    "antonyms": [
                        "follow",
                        "imitate"
                    ],
                    "common_phrases": [
                        "pioneer new technology",
                        "pioneer a method"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть первым, кто сделал или достиг чего-либо, подготавливая почву для последователей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокладывать путь",
                                "target_lang_sense_clarification": "в переносном смысле, быть новатором"
                            },
                            {
                                "target_lang_word": "быть первопроходцем",
                                "target_lang_sense_clarification": "в какой-либо области"
                            },
                            {
                                "target_lang_word": "внедрять",
                                "target_lang_sense_clarification": "новые методы или технологии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "420cf265-6ed8-3b7b-a174-f35348d9bfcb",
                    "sense_definition": "A person or entity who is among the earliest in any field of inquiry, enterprise, or progress.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "innovator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certain politicians can be considered as <w>pioneers</w> of reform.",
                            "target_lang_translations": {
                                "ru": "Некоторых политиков можно считать <w>пионерами</w> реформ."
                            }
                        },
                        {
                            "text": "She was a <w>pioneer</w> in the field of computer science during the 1950s.",
                            "target_lang_translations": {
                                "ru": "В 1950-х годах она была <w>первопроходцем</w> в области компьютерных наук."
                            }
                        }
                    ],
                    "synonyms": [
                        "push the envelope",
                        "break new ground"
                    ],
                    "antonyms": [
                        "follower"
                    ],
                    "common_phrases": [
                        "pioneer in the field",
                        "pioneer of reform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или организация, стоящие у истоков какой-либо области знаний, предприятия или прогресса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пионер",
                                "target_lang_sense_clarification": "первооткрыватель в науке или технике"
                            },
                            {
                                "target_lang_word": "первопроходец",
                                "target_lang_sense_clarification": "тот, кто первым осваивает новое направление"
                            },
                            {
                                "target_lang_word": "новатор",
                                "target_lang_sense_clarification": "человек, вносящий новые идеи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e1d81f4-a269-3f51-b4d4-85580c5c7992",
                    "sense_definition": "One who goes before, as into the wilderness, preparing the way for others to follow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "explorer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The early <w>pioneers</w> faced many hardships while traveling across the rugged terrain.",
                            "target_lang_translations": {
                                "ru": "Первые <w>переселенцы</w> столкнулись со множеством трудностей, путешествуя по пересеченной местности."
                            }
                        },
                        {
                            "text": "They lived like true <w>pioneers</w> in a small wooden cabin far from the city.",
                            "target_lang_translations": {
                                "ru": "Они жили как настоящие <w>пионеры</w> в маленькой деревянной хижине вдали от города."
                            }
                        }
