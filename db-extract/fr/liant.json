            {
                "entry_id": "3d999c7a-78f6-3d18-9e57-c9ab3b31c1ae",
                "word": "liant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e5817414-a7d8-44b4-a574-1b364028c314",
                        "entry_id": "3d999c7a-78f6-3d18-9e57-c9ab3b31c1ae",
                        "tags": [
                            "plural"
                        ],
                        "form": "liants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc6c5cd9-573f-30f0-8649-2df295a1c9e7",
                        "entry_id": "3d999c7a-78f6-3d18-9e57-c9ab3b31c1ae",
                        "glosses": [
                            "Douceur, affabilité, disposition naturelle à former des liaisons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b500d6de-3c8d-4f51-b063-8357249f872c",
                                "sense_id": "cc6c5cd9-573f-30f0-8649-2df295a1c9e7",
                                "text": "Mettre du liant dans le commerce de la vie, dans la conduite des affaires."
                            },
                            {
                                "example_id": "4a069c9b-6700-453d-9113-c78cbc94b220",
                                "sense_id": "cc6c5cd9-573f-30f0-8649-2df295a1c9e7",
                                "text": "— Pourquoi, monsieur Brême, accaparez-vous toujours M. Moraire ? s’écria à travers la table le docteur qui se souciait de mettre du liant entre tous ses commensaux. Nous aimerions tous suivre votre discussion."
                            },
                            {
                                "example_id": "13968a79-bef9-4977-ab5d-fef7c2489e2e",
                                "sense_id": "cc6c5cd9-573f-30f0-8649-2df295a1c9e7",
                                "text": "Il a beaucoup de liant dans le caractère."
                            },
                            {
                                "example_id": "8965c294-7a4d-4752-a3c8-e292ce82fec4",
                                "sense_id": "cc6c5cd9-573f-30f0-8649-2df295a1c9e7",
                                "text": "Manquer de liant."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc75d346-f3da-30a4-ad0b-6bf0439f5e44",
                        "entry_id": "3d999c7a-78f6-3d18-9e57-c9ab3b31c1ae",
                        "glosses": [
                            "Produit dont le rôle est d’assurer la liaison entre deux autres produits difficilement miscibles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd898b0f-f250-4cde-983b-935713571d0c",
                                "sense_id": "fc75d346-f3da-30a4-ad0b-6bf0439f5e44",
                                "text": "Le répandage se fait sur une surface sèche et le gravillonnage suit d'aussi près que possible le répandage, de manière que la surface du gravillon soit bien mouillée par le liant fluide."
                            },
                            {
                                "example_id": "2af8a98c-4387-482e-9f20-709211b26e02",
                                "sense_id": "fc75d346-f3da-30a4-ad0b-6bf0439f5e44",
                                "text": "L'enduit monocouche à double gravillonnage, qui comporte une couche de liant et deux couches de granulats, la seconde étant de classe granulaire inférieure à celle de la première."
                            }
                        ]
                    },
                    {
                        "sense_id": "b435c41e-c449-3dfb-b2a4-b2206d9a1146",
                        "entry_id": "3d999c7a-78f6-3d18-9e57-c9ab3b31c1ae",
                        "glosses": [
                            "Médium liquide qui est mélangé avec un pigment pour créer une peinture."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": []
                    }
                ],
