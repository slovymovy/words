                "senses": [
                    {
                        "sense_id": "4557f862-a600-3df0-b1ab-c835b36c9822",
                        "entry_id": "1fca77d6-4320-3a8a-840f-427f278d970b",
                        "glosses": [
                            "Bruder eines Elternteils, von dem man im Falle seines Ablebens eine Erbschaft erwartet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6a27c6b-cce1-40f7-a9f5-000e08e24422",
                                "sense_id": "4557f862-a600-3df0-b1ab-c835b36c9822",
                                "text": "Ich habe einen Erbonkel in Amerika, der mit Immobiliengeschäften reich geworden ist."
                            },
                            {
                                "example_id": "6c66277c-ba1a-4399-961e-329f959ea6af",
                                "sense_id": "4557f862-a600-3df0-b1ab-c835b36c9822",
                                "text": "„Gewiß, meine Mutter war eine Pommersche, noch dazu von der Insel Usedom, und ihr Bruder, nun ja, der hieß Dubslav. Und so war denn gegen den Namen schon um des Onkels willen nicht viel einzuwenden, und um so weniger, als er ein Erbonkel war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
