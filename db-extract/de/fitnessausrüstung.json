                "senses": [
                    {
                        "sense_id": "4db17693-8721-3995-8e52-4d7d399cb105",
                        "entry_id": "27f8ecc5-9213-3ed3-85a8-cb99931d324c",
                        "glosses": [
                            "Gesamtheit von Gegenständen (Geräte, Zubehör, Hilfsmittel), die bei Fitnessübungen beziehungsweise sportlichen Aktivitäten verwendet werden, um das Training zu unterstützen"
                        ],
                        "tags": [
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "8eef75e1-4d66-4018-a850-d269b40dcc12",
                                "sense_id": "4db17693-8721-3995-8e52-4d7d399cb105",
                                "text": "„Zur Fitnessausrüstung zählen vor allem auch Trinkflaschen, Handschuhe oder auch Kettlebells.“"
                            },
                            {
                                "example_id": "47dff0ba-4732-4985-8578-75abb3827c6e",
                                "sense_id": "4db17693-8721-3995-8e52-4d7d399cb105",
                                "text": "„Durchaus kannst Du das Internet nach modernster Fitnessausrüstung und verschieden Trainingsmethoden durchsuchen.“"
                            },
                            {
                                "example_id": "2c66ec56-47df-46c6-88b6-8f879e758f92",
                                "sense_id": "4db17693-8721-3995-8e52-4d7d399cb105",
                                "text": "„Es gibt auch spezialisierte Fachgeschäfte für Fitnessausrüstung, die Boxstationen verkaufen.“"
                            },
                            {
                                "example_id": "15693805-9ff8-4edb-af3a-03ae34f83c1d",
                                "sense_id": "4db17693-8721-3995-8e52-4d7d399cb105",
                                "text": "„Vielleicht liegt es daran, weil man für das Training keine teure Fitnessausrüstung benötigt.“"
                            },
                            {
                                "example_id": "8e71f3c6-6b20-4406-9c21-cab7e9d96faa",
                                "sense_id": "4db17693-8721-3995-8e52-4d7d399cb105",
                                "text": "„Widerstandsbänder gehören dabei zu den traditionell ältesten Fitnessausrüstungen, sind bisher aber nie so richtig im Digitalzeitalter angekommen.“"
                            },
                            {
                                "example_id": "93b03b43-6a9f-4388-935f-338abdc80c42",
                                "sense_id": "4db17693-8721-3995-8e52-4d7d399cb105",
                                "text": "„Ihr sucht Fitnessgeräte und die passende Fitnessausrüstung für den Heimsport, Sportkleidung und Sportschuhe für euer Training im Fitnesstudio oder Outdoorbekleidung und Outdoorschuhe für eure nächste Wandertour?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
