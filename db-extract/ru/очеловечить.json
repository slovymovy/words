                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humaniser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4df19944-e7d6-3fba-8d48-5c59d7c9cd1d",
                                        "entry_id": "e7e57ffd-6061-36d1-ac29-539055b949e1",
                                        "glosses": [
                                            "Rendre bon, humain ; civiliser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed4dd0e5-2f6b-4798-aa7e-117659e7d05c",
                                                "sense_id": "4df19944-e7d6-3fba-8d48-5c59d7c9cd1d",
                                                "text": "Le commerce des européens humanisa ces peuples sauvages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9298a4de-ddc8-3f4d-8ecf-7c60dc0b3ff0",
                                        "entry_id": "e7e57ffd-6061-36d1-ac29-539055b949e1",
                                        "glosses": [
                                            "Rendre plus traitable, plus favorable."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09f3cddb-83d6-4fa5-bc0f-124ba5802066",
                                                "sense_id": "9298a4de-ddc8-3f4d-8ecf-7c60dc0b3ff0",
                                                "text": "Il se montre fort contraire à vos intérêts, mais on trouvera moyen de l’humaniser."
                                            },
                                            {
                                                "example_id": "007837cf-e9a1-43ad-a33d-29a84ac518ca",
                                                "sense_id": "9298a4de-ddc8-3f4d-8ecf-7c60dc0b3ff0",
                                                "text": "Il ne pouvait vivre avec personne, la société et l’expérience l’ont humanisé."
                                            },
                                            {
                                                "example_id": "db4617aa-2bb3-41e7-9f28-510910c59558",
                                                "sense_id": "9298a4de-ddc8-3f4d-8ecf-7c60dc0b3ff0",
                                                "text": "Il commence à s’humaniser."
                                            },
                                            {
                                                "example_id": "b5be7c06-9919-46b7-8f77-c46571600aba",
                                                "sense_id": "9298a4de-ddc8-3f4d-8ecf-7c60dc0b3ff0",
                                                "text": "Elle n’est plus aussi revêche, elle s’humanise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f3ee957-9db1-30f2-8fcb-f1a73095c989",
                                        "entry_id": "e7e57ffd-6061-36d1-ac29-539055b949e1",
                                        "glosses": [
                                            "Se dépouiller de certains sentiments et d’une certaine façon de vivre trop austère."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35827652-f3f6-490d-8e7d-d9cd3efec17f",
                                                "sense_id": "0f3ee957-9db1-30f2-8fcb-f1a73095c989",
                                                "text": "Il s’était jeté dans la retraite, mais il commence à s’humaniser."
                                            },
                                            {
                                                "example_id": "40b87737-bfd2-4382-9522-82f7c42cee9f",
                                                "sense_id": "0f3ee957-9db1-30f2-8fcb-f1a73095c989",
                                                "text": "Son grand nez rouge d’ancien capitaine noceur ne s’humanisait que dans les comptoirs tenus par des femmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddef2405-7fff-358b-ad9e-3ce392b8daca",
                                        "entry_id": "e7e57ffd-6061-36d1-ac29-539055b949e1",
                                        "glosses": [
                                            "Se conformer, s’accommoder à la portée des autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45735cf8-dfdf-4bab-963f-dc83ef90627d",
                                                "sense_id": "ddef2405-7fff-358b-ad9e-3ce392b8daca",
                                                "text": "Les terribles prêcheurs de Seize, les moines qui portaient le mousquet aux processions de la Ligue, s'humanisent tout à coup ; les voilà devenus bénins. C'est qu'il faut bien essayer d’endormir ceux qu'on n'a pas pu tuer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
