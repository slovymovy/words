                ],
                "senses": [
                    {
                        "sense_id": "52319a16-a56e-344a-9600-11860f0f49db",
                        "entry_id": "c8533cc5-2a2e-3287-83a2-19eb211d6b30",
                        "glosses": [
                            "Ersatzplural von Bergmann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef8cad0a-303b-4b2f-9322-3fd2b5b6a84b",
                                "sense_id": "52319a16-a56e-344a-9600-11860f0f49db",
                                "text": "„Da die Bergleute leicht verunglücken können, und mancherley Krankheiten ausgesetzt sind, so besteht für sie ein eignes Armen-Institut und Knappschafts-Aerzte und Chirurgen, und letztere beyde unter dem Oberberg-Arzt, Medicinalrat Mogalla.“"
                            },
                            {
                                "example_id": "3b753c93-04e3-469e-b3ac-d12f1abc3941",
                                "sense_id": "52319a16-a56e-344a-9600-11860f0f49db",
                                "text": "„Jahrelang lebte und arbeitete er als Vertrauensmann der Bergleute.“"
                            },
                            {
                                "example_id": "76672569-b669-43b8-ad19-086b5058bd67",
                                "sense_id": "52319a16-a56e-344a-9600-11860f0f49db",
                                "text": "„Als die ersten Bergleute in den Harz kamen und von Zellerfeld aus in die Umgebung gingen, um Erze zu suchen, kamen sie auch in das Innerstetal, dorthin, wo dann die Bergstadt Wildemann entstand.“"
                            },
                            {
                                "example_id": "5c0bcfe9-6b92-404a-af05-b701b9a1437f",
                                "sense_id": "52319a16-a56e-344a-9600-11860f0f49db",
                                "text": "„Von Massenschlägereien zwischen Bergleuten und Polizisten sprach man im gesamten Revier, und gewiss wurden manche Händel in späteren Erzählungen noch ausgeschmückt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
