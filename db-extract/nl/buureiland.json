                        "examples": [
                            {
                                "example_id": "b1ebc161-7092-470d-9e0b-4e5b5de21302",
                                "sense_id": "3f5bf6ef-fad3-3487-908c-100c7376d3b6",
                                "text": "Jansson, de man die je naar mij toe heeft gevaren, belde om te zeggen dat er een huis op een buureiland in brand staat."
                            },
                            {
                                "example_id": "4a986477-95ec-4bc8-8b99-5b5586ca5080",
                                "sense_id": "3f5bf6ef-fad3-3487-908c-100c7376d3b6",
                                "text": "Ook hield de Curaçaose staat vol dat homokoppels kunnen uitwijken naar buureiland Bonaire, waar het homohuwelijk wel geregeld is. Maar ook daarin ging de rechtbank niet mee. De huidige situatie is in strijd met de Staatsregeling (de grondwet van Curaçao), concludeerden de rechters."
                            }
                        ]
                    }
