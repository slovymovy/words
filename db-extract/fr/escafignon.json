                        "examples": [
                            {
                                "example_id": "7a35e67d-0aca-4fa9-ac98-6428fb03e62e",
                                "sense_id": "7e56fe0c-80f5-325a-84b8-f7bd0d522ced",
                                "text": "Sentir l'escafignon, sentir mauvais des pieds."
                            },
                            {
                                "example_id": "a9b7e274-d63d-4fa6-8ec0-0d2a69cb6410",
                                "sense_id": "7e56fe0c-80f5-325a-84b8-f7bd0d522ced",
                                "text": "Gousset, escafignon, faguenas, cambouis,\nQui formez ce présent, que mes yeux réjouis,\nSous l'aveu de mon nez, lorgnent comme un fromage,\nÀ qui la puanteur doit même rendre hommage,\nQue vous avez d'appas, que votre odeur me plaît !"
                            },
                            {
                                "example_id": "258d80d3-7223-4894-baac-5ae197294299",
                                "sense_id": "7e56fe0c-80f5-325a-84b8-f7bd0d522ced",
                                "text": "Alors, alors, où étiez-vous puanteurs charmantes, faguenas, escafignon, ondulants et capiteux remugles ?"
                            }
                        ]
                    }
