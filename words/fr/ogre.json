        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79b8b1cc-e718-3517-b0a8-34b7151beef8",
                    "sense_definition": "Monstre géant des contes de fées qui dévore les êtres humains, en particulier les enfants.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "creature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce conte traditionnel, l'<w>ogre</w> vit tout seul au cœur d'une forêt sombre."
                        },
                        {
                            "text": "Le Petit Poucet et ses frères tentent d'échapper à l'<w>ogre</w> cruel."
                        }
                    ],
                    "synonyms": [
                        "croquemitaine",
                        "géant"
                    ],
                    "common_phrases": [
                        "conte d'ogre"
                    ]
                },
                {
                    "sense_id": "2ea49557-cd84-3ad1-8102-13ded23f8748",
                    "sense_definition": "Personne très vorace qui mange en grande quantité et avec avidité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voracite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue randonnée en montagne, nous avions un appétit d'<w>ogre</w>."
                        },
                        {
                            "text": "Finis ton assiette calmement au lieu de manger comme un véritable <w>ogre</w>."
                        }
                    ],
                    "synonyms": [
                        "glouton",
                        "goinfre"
                    ],
                    "common_phrases": [
                        "appétit d'ogre",
                        "manger comme un ogre"
                    ]
                },
                {
                    "sense_id": "ee58d981-fa75-36dc-9ed3-47ebeeb9a194",
                    "sense_definition": "Personne tyrannique, dévorante ou excessivement possessive envers autrui.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce directeur d'entreprise se comporte comme un <w>ogre</w> impitoyable avec ses jeunes employés."
                        },
                        {
                            "text": "Par sa jalousie étouffante, elle est devenue un véritable <w>ogre</w> pour sa famille."
                        }
                    ]
                },
                {
                    "sense_id": "a11b5b20-dfe5-34a8-97ab-3de2d29b313c",
                    "sense_definition": "Repris de justice tenant un cabaret mal famé qui sert de repaire à des criminels.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "argot_ancien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce roman policier historique, l'<w>ogre</w> tenait un estaminet fréquenté par des brigands."
                        },
                        {
                            "text": "La police surveillait de près cet <w>ogre</w> qui hébergeait des fugitifs dans son arrière-boutique."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot criminel"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "XIXe siècle"
                        }
                    ]
                }
            ]
        },
