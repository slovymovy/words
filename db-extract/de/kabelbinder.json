                "senses": [
                    {
                        "sense_id": "72c07f99-17e3-3cf1-a194-59d496a0d5aa",
                        "entry_id": "dcb4849e-0c43-3e53-91fa-f7f3a1bea800",
                        "glosses": [
                            "Kunststoffstreifen mit Verschluss zum Bündeln von Kabeln und Drähten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfb143e5-254c-4df7-9bff-54c0c2c28764",
                                "sense_id": "72c07f99-17e3-3cf1-a194-59d496a0d5aa",
                                "text": "Man kann das Kabelchaos am Computer mit Kabelbindern in den Griff bekommen."
                            },
                            {
                                "example_id": "f4d15785-2c93-499d-8d08-191530e168d0",
                                "sense_id": "72c07f99-17e3-3cf1-a194-59d496a0d5aa",
                                "text": "Wir werden die Teile einfach mit Kabelbindern befestigen."
                            },
                            {
                                "example_id": "17cecd2d-fb52-4b3b-bb27-a64ffd5d38ed",
                                "sense_id": "72c07f99-17e3-3cf1-a194-59d496a0d5aa",
                                "text": "„Anschließend entfernte er ein Schutzblech und befestigte den Sicherheitsschalter mit einem Kabelbinder.“"
                            },
                            {
                                "example_id": "afb86614-b8a2-496a-afb1-3bde12b1e9da",
                                "sense_id": "72c07f99-17e3-3cf1-a194-59d496a0d5aa",
                                "text": "„Bei der Hausdurchsuchung haben sie unter anderem einen Rucksack gefunden, in welchem T. N. Kabelbinder, eine alte Armeepistole, Klebeband und Stricke für weitere ähnlich gelagerte Taten gepackt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
