                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists studied the properties of naturally <w>occurring</w> chemicals in the soil.",
