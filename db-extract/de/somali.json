                                        "sense_id": "ef52ee55-7b62-31ba-8471-455c02ff74cd",
                                        "entry_id": "4f28ed94-7df6-339e-ba75-90c99d938737",
                                        "glosses": [
                                            "A Cushitic language spoken mainly in Somalia, eastern Ethiopia, Djibouti, and eastern Kenya."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b9206fa-884d-4b2c-89c9-59f7892bc1ba",
                                                "sense_id": "ef52ee55-7b62-31ba-8471-455c02ff74cd",
                                                "text": "Somali is the primary language of Somalia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23e84383-99d9-3581-ac64-a16381331c0d",
                                        "entry_id": "4f28ed94-7df6-339e-ba75-90c99d938737",
                                        "glosses": [
                                            "Somali language and literature as an object of study."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "103a9641-53ae-40bb-8d85-90678b88e1c9",
                                                "sense_id": "23e84383-99d9-3581-ac64-a16381331c0d",
                                                "text": "I'm learning Somali."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Somali",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "367d93e1-cd0b-33dc-893e-5553b0cdc4bc",
                                        "entry_id": "49ead211-3b10-3dcb-b0db-e8f641588d32",
                                        "glosses": [
                                            "An ethnic group native to the Somali Peninsula; a Somali, a group of Somalis, the Somalis."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c911d83-7cc1-421d-a6db-1cf6545a2629",
                                                "sense_id": "367d93e1-cd0b-33dc-893e-5553b0cdc4bc",
                                                "text": "Historically, Somalis were a nomadic people herding camels, goats, and sheep. Nowadays, many if not most Somalis are urbanized people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfe1a546-dcd8-3047-9398-bed8a365c675",
                                        "entry_id": "49ead211-3b10-3dcb-b0db-e8f641588d32",
                                        "glosses": [
                                            "Pertaining to the Somali ethnic group on the whole; the Somali."
                                        ],
                                        "tags": [
                                            "collective",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb6c4bcb-1938-4d4d-a886-4d63ec8694c8",
                                                "sense_id": "bfe1a546-dcd8-3047-9398-bed8a365c675",
                                                "text": "The Somali are an ethnic group of Cushitic origin indigenous to the Somali Peninsula. Their language is called Somali."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d57783a2-98e9-3da1-b55e-5ec799e6f4c9",
                                        "entry_id": "49ead211-3b10-3dcb-b0db-e8f641588d32",
                                        "glosses": [
                                            "A citizen or resident from the country of Somalia. The term Somalian is sometimes used as an alternative to Somali to emphasize civic affiliations to the Republic of Somalia and de-emphasize ethnic affiliations. Using the term Somalian may be offensive to some Somalis as it is deemed nonstandard. Some Somali ethnonationalists do not consider all citizens of Somalia to be Somali. Some Somali separatists prefer terms such as Somalian or Somalilander in civic contexts over the ethnolinguistic connoted term Somali."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59aa603e-0100-37f7-8243-f38ad1f8283e",
                                        "entry_id": "49ead211-3b10-3dcb-b0db-e8f641588d32",
                                        "glosses": [
                                            "A person from Somali-majority republics, states, or regions, including but not limited to: the unrecognized Republic of Somaliland, the Somali region of Ethiopia (often called 'the Ogaden', but more neutrally 'the Somali region'), or autonomous states within Somalia's federal system such as Puntland."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afa5cad4-f85b-3837-84c6-25707e0aab29",
                                        "entry_id": "49ead211-3b10-3dcb-b0db-e8f641588d32",
                                        "glosses": [
                                            "A domestic cat breed derived from the 'Abyssinian cat'. This cat breed is alternatively called the 'long-haired Abyssinian cat' or the 'Fox cat'."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
