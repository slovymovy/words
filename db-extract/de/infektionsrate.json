                ],
                "senses": [
                    {
                        "sense_id": "c2a691a8-d5c7-352a-83e7-a994aa4608e5",
                        "entry_id": "d02b905a-2b16-3173-b68f-4d149b28ea3b",
                        "glosses": [
                            "Zahl der Neuinfektionen, Anzahl der Neuerkrankungen an einer Infektionskrankheit, Anzahl derjenigen Patienten, die sich nach einem Eingriff/Krankenhausaufenthalt infizieren"
                        ],
                        "tags": [
                            "Infektiologie",
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "f51e30e1-be9a-4b5e-9dd6-b482fd22b5b7",
                                "sense_id": "c2a691a8-d5c7-352a-83e7-a994aa4608e5",
                                "text": "Strenge Regeln haben dafür gesorgt, dass die Infektionsraten sinken."
                            },
                            {
                                "example_id": "652db03e-6d03-44c6-bd29-7c3faf7f037d",
                                "sense_id": "c2a691a8-d5c7-352a-83e7-a994aa4608e5",
                                "text": "„Auf einem WHO-Meeting in Graz wird klargestellt, daß nicht die AIDS-Fälle, sondern die HIV-Positiven den epidemiologisch relevanten Parameter der Epidemie darstellen. In den USA wächst die Infektionsrate der Heterosexuellen jetzt doppelt so schnell, wie die der klassischen Risikogruppen.“"
                            },
                            {
                                "example_id": "80de0cda-f9ee-43f2-bd47-f6145929cd58",
                                "sense_id": "c2a691a8-d5c7-352a-83e7-a994aa4608e5",
                                "text": "„Am 18. Juni 2020 belief sich die durchschnittliche Infektionsrate mit dem neuartigen Coronavirus (SARS-CoV-2) in Hamburg auf 280 Infektionen je 100.000 Einwohner.“"
                            },
                            {
                                "example_id": "4ec6c14d-3c2e-4f04-bc81-8e9e259115f0",
                                "sense_id": "c2a691a8-d5c7-352a-83e7-a994aa4608e5",
                                "text": "Die Infektionsrate liegt bei 1.3 pro 10.000 Entlassungen aus dem Krankenhaus."
                            },
                            {
                                "example_id": "d2bda72e-4baf-4e94-b95c-f08f053a3948",
                                "sense_id": "c2a691a8-d5c7-352a-83e7-a994aa4608e5",
                                "text": "Eine Infektionsrate in der Knochenchirurgie von über 3% muss als kritisch gesehen werden."
                            },
                            {
                                "example_id": "f3142588-099a-4167-9fb5-7c64e0298707",
                                "sense_id": "c2a691a8-d5c7-352a-83e7-a994aa4608e5",
                                "text": "Infektionsraten sind wichtige Marker für sowohl die klinische Qualitätssicherung als auch für die Krankenhauswahl."
                            },
                            {
                                "example_id": "80680db8-f520-4d22-8ece-8ce281ef174b",
                                "sense_id": "c2a691a8-d5c7-352a-83e7-a994aa4608e5",
                                "text": "„Die Infektionsrate gefäßrekonstruktiver Eingriffe wird zusätzlich zur Gefahr der intraoperativen Kontamination durch zahlreiche Variablen beeinflusst, wie dem Stadium der Erkrankung, der Lokalisation und Dimension des Eingriffs, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
