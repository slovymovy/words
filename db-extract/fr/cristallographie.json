                "senses": [
                    {
                        "sense_id": "d0267d89-ffb3-3d5b-a5af-6120ebaf0dfd",
                        "entry_id": "093cc968-3749-306e-a392-7554cbc2af35",
                        "glosses": [
                            "Science qui étudie la structure cristalline et les propriétés physiques des cristaux — naturels ou synthétiques — ainsi que les méthodes permettant de les caractériser, notamment par diffraction des rayons X, neutrons ou électrons."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "bc90ee97-41bd-4ec0-8de5-22ab037cd71f",
                                "sense_id": "d0267d89-ffb3-3d5b-a5af-6120ebaf0dfd",
                                "text": "La cristallographie est la branche des sciences exactes qui se consacre à l’étude de la structure de la matière à l’échelle atomique: détermination, classification et interprétation des structures géométriques des solides et en particulier celles des cristaux."
                            }
                        ]
                    }
                ],
