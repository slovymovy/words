                "senses": [
                    {
                        "sense_id": "cc5cc72d-a097-3e81-922d-44c27ab4406b",
                        "entry_id": "bffb1bca-ea7d-33d7-9b79-e89700a64833",
                        "glosses": [
                            "Gesamtheit der Bemühungen, sich das für das Leben Notwendige zu verschaffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f62c3447-c8c6-4242-b7b0-cadc6b5e28bc",
                                "sense_id": "cc5cc72d-a097-3e81-922d-44c27ab4406b",
                                "text": "„Solche Menschen ließen sich nie ein schönes Vergnügen entgehen, wenn der Existenzkampf ihnen eine kleine Pause gönnte.“"
                            },
                            {
                                "example_id": "892bf980-94b1-4236-b0f4-03da0b2cf6af",
                                "sense_id": "cc5cc72d-a097-3e81-922d-44c27ab4406b",
                                "text": "„Seine Patienten wollte er nicht dazu anleiten, ihre verborgenen Lüste auszuleben, er wollte ihnen nur in ihrem täglichen Existenzkampf beistehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "99f36f88-0074-3cc0-bf14-4bc7e1c3b144",
                        "entry_id": "bffb1bca-ea7d-33d7-9b79-e89700a64833",
                        "glosses": [
                            "Gesamtheit der Bemühungen, den Fortbestand (einer Institution, Organisation) zu sichern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60598c15-d5a6-4202-950b-e8c95d8fb901",
                                "sense_id": "99f36f88-0074-3cc0-bf14-4bc7e1c3b144",
                                "text": "Durch ungeschicktes Management kann der Existenzkampf einer Firma auch scheitern."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
