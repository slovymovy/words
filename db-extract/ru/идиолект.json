                "senses": [
                    {
                        "sense_id": "e09c3903-8ada-3490-93fe-d8aea26107c9",
                        "entry_id": "ed4b3f11-d02a-3d95-8c35-98595bb67549",
                        "glosses": [
                            "лингв., психол. совокупность особенностей речи, присущей конкретному индивиду в определённый момент времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0251e7a4-c476-4e54-9a7e-607a78aa8fb5",
                                "sense_id": "e09c3903-8ada-3490-93fe-d8aea26107c9",
                                "text": "Логопеды исследуют отдельные идиолекты больных афазией."
                            },
                            {
                                "example_id": "73f519a6-8733-459b-bc24-15a496f83b0a",
                                "sense_id": "e09c3903-8ada-3490-93fe-d8aea26107c9",
                                "text": "Идиолект характеризуется индивидуальными особенностями лексики, грамматики, идиоматики и фонетики речи индивида в определённый момент времени или в определённом коммуникативном контексте."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27e2cc29-fcbe-4e88-b354-87757d5ba1c5",
                        "source_entry_id": "ed4b3f11-d02a-3d95-8c35-98595bb67549",
                        "source_sense_id": "e09c3903-8ada-3490-93fe-d8aea26107c9",
                        "target_lang_word": "idiolect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiolect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "448c8657-4222-30ab-b0e8-ee297e01046e",
                                        "entry_id": "0aa2d6cf-de76-399f-aeff-f1424d57106f",
                                        "glosses": [
                                            "The language variant used by a specific individual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2375c30f-e71b-4621-96c0-aea3d1d131ca",
                                                "sense_id": "448c8657-4222-30ab-b0e8-ee297e01046e",
                                                "text": "She perfected the fictional idiolect, fashioning habits of speaking for even minor characters that rendered them utterly singular."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfd22ad2-654c-460d-858f-378095d43115",
                        "source_entry_id": "ed4b3f11-d02a-3d95-8c35-98595bb67549",
                        "source_sense_id": "e09c3903-8ada-3490-93fe-d8aea26107c9",
