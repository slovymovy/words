                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d06d7b5f-32f3-45c7-b4d8-fd21a2f6c657",
                                                "sense_id": "6ae5b7ae-98ae-3c75-8601-efcb515ceee9",
                                                "text": "The stupefied bus driver kept ranting and raving at him. “You could have been stuffed, mate! Once the water splits it would have been the most shithouse moment in your life, and the last one! This beach is for crocs only![…]”"
                                            },
                                            {
                                                "example_id": "9a9c92ad-70d2-497b-ad3e-a6ba63df2303",
                                                "sense_id": "6ae5b7ae-98ae-3c75-8601-efcb515ceee9",
                                                "text": "The story goes that when she applied for the job, they were fearful of hiring her because she was ‘much more shithouse than them’. I cannot imagine anyone being worse than those two but she did give it a good go."
                                            }
                                        ]
                                    }
                                ]
