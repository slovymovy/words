                "senses": [
                    {
                        "sense_id": "3f11b2ec-61c1-3178-973e-c7c19c6b5cf5",
                        "entry_id": "3a5c01c9-ab4b-3b41-ad2a-4ead30967609",
                        "glosses": [
                            "Donner un caractère chaldéen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fbef7a2-42d6-4be5-81ad-1a016ba359f8",
                                "sense_id": "3f11b2ec-61c1-3178-973e-c7c19c6b5cf5",
                                "text": "Elle rassemble aujourd’hui des Assyriens, des Arabes, des Kurdes : devons-nous les ’chaldéiser’? » se demande le Patriarche Sako."
                            },
                            {
                                "example_id": "9285608f-9ff9-4c73-8805-b90716fb330c",
                                "sense_id": "3f11b2ec-61c1-3178-973e-c7c19c6b5cf5",
                                "text": "La langue indigène en Mitanni est celle même du Hatti : preuve que le haut Euphrate n’avait pas encore été profondément sumérisé ou chaldéisé ; qu’il demeurait « anatolien » au sens vague d’asianique."
                            }
                        ]
                    }
