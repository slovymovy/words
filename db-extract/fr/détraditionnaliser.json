                "senses": [
                    {
                        "sense_id": "9f8112ed-5902-3884-a08e-c5286da65d59",
                        "entry_id": "d57f0abd-08e4-3689-a1d4-3bab3ffb37cf",
                        "glosses": [
                            "Faire perdre son caractère traditionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10a27ebb-a229-4ea7-a6a7-e93c0bdfbf48",
                                "sense_id": "9f8112ed-5902-3884-a08e-c5286da65d59",
                                "text": "La guerre « détraditionnalise » l’ordre européen tout autant que la société coloniale."
                            },
                            {
                                "example_id": "75fd1053-f971-4f3b-95bb-6bdcad47d656",
                                "sense_id": "9f8112ed-5902-3884-a08e-c5286da65d59",
                                "text": "C'est l'un des esprits les plus intéressants d'un groupe qui s'efforce à « détraditionnaliser » la littérature hollandaise."
                            },
                            {
                                "example_id": "04fd360e-66c4-4148-a227-e46323d8b017",
                                "sense_id": "9f8112ed-5902-3884-a08e-c5286da65d59",
                                "text": "Détraditionnaliser la gastronomie française par l'influence culinaire étrangère."
                            }
                        ]
                    }
