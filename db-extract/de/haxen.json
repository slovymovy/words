                        "examples": [
                            {
                                "example_id": "e5396c08-d241-428d-bab3-6e05535fce48",
                                "sense_id": "4782ae97-aff0-3a59-b311-9a93d646696a",
                                "text": "„Er ist jung, er ist temperamentvoll und er ist verfügbar. Dass er in Folge einer Kriegsverletzung den Haxen nachschleift, stört mich nicht.“"
                            },
                            {
                                "example_id": "a893942d-60d7-4b51-a921-011da12f7eee",
                                "sense_id": "4782ae97-aff0-3a59-b311-9a93d646696a",
                                "text": "„Ich deckte den rastlosen Haxen wieder zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
