                                "target_senses": [
                                    {
                                        "sense_id": "9fadf252-61cf-3f34-b18c-e3bb08a20a88",
                                        "entry_id": "e5a4f9d2-4d80-3f21-b377-d4981522d2eb",
                                        "glosses": [
                                            "Qui est favorable aux Juifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a424097-7bc9-4686-974f-4ad62d1166a8",
                                                "sense_id": "9fadf252-61cf-3f34-b18c-e3bb08a20a88",
                                                "text": "Hier, en France, il fallait être humanitaire, kantien, philosémite. Actuellement, la mode, chez nous, penche vers un christianisme édulcoré."
                                            }
                                        ]
                                    }
                                ]
                            },
