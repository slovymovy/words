                "senses": [
                    {
                        "sense_id": "18a07627-cbcd-3f4b-b6ce-95c409d7d2fb",
                        "entry_id": "7b1fd099-81e0-3217-a2c0-8adfb105cae9",
                        "glosses": [
                            "przyrząd lub urządzenie służące do określania stanu wody w rzece lub jeziorze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d361b264-85e9-4c05-a99d-5738fe73aaeb",
                                "sense_id": "18a07627-cbcd-3f4b-b6ce-95c409d7d2fb",
                                "text": "Na każdym z wodowskazów zanotowano spadki."
                            },
                            {
                                "example_id": "f0510eaf-6328-432d-8210-cba7ec8a6f79",
                                "sense_id": "18a07627-cbcd-3f4b-b6ce-95c409d7d2fb",
                                "text": "Na Opolszczyźnie stany alarmowe są przekroczone na 16 wodowskazach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3633a4e-6543-484a-b58f-3c87a8896b46",
                        "source_entry_id": "7b1fd099-81e0-3217-a2c0-8adfb105cae9",
                        "source_sense_id": "18a07627-cbcd-3f4b-b6ce-95c409d7d2fb",
                        "target_lang_word": "Pegel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pegel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa6155c9-161d-3144-8ca7-c2bbc335f62b",
                                        "entry_id": "222354f3-70ac-3dfa-84ee-3da296cd5a3c",
                                        "glosses": [
                                            "Niveauhöhe einer Flüssigkeit oder sonstiger Zahlenwert einer physikalischen Größe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dc6cac3-6ea8-4086-babc-e90a575b730d",
                                                "sense_id": "fa6155c9-161d-3144-8ca7-c2bbc335f62b",
                                                "text": "„Der Wasserstand selbst wird ebenfalls als Pegel (Wasserpegel) bezeichnet. Davon abgeleitet wird der Begriff Pegel in der Physik und Technik verwendet um Grössen von Wellen zu bezeichnen.“"
                                            },
                                            {
                                                "example_id": "04d8f22d-ac7f-436f-8072-a24619632e2a",
                                                "sense_id": "fa6155c9-161d-3144-8ca7-c2bbc335f62b",
                                                "text": "„Die Pegel stiegen immer höher, weil das Tal keinen Abfluss hatte.“"
                                            },
                                            {
                                                "example_id": "855a7701-6b3a-4ed3-a694-7b974a489de6",
                                                "sense_id": "fa6155c9-161d-3144-8ca7-c2bbc335f62b",
                                                "text": "„Eiríkur, der Pegel in der Flasche ist bedenklich gesunken, und ich sollte aufhören, bevor ich noch spürbar einen sitzen habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33c9b120-f107-3b72-9276-8bd83602a7e0",
                                        "entry_id": "222354f3-70ac-3dfa-84ee-3da296cd5a3c",
                                        "glosses": [
                                            "Vorrichtung zur Messung des Wasserstands"
                                        ],
                                        "tags": [
                                            "Wasserbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d5a8dd3-6959-43b3-a650-0733149a8c9e",
                                                "sense_id": "33c9b120-f107-3b72-9276-8bd83602a7e0",
                                                "text": "Normalnull (NN) ist die Basis für Nivellements und Höhemessungen, der mittlere Wasserstand eines Seepegels. (Amsterdamer Pegel)"
                                            },
                                            {
                                                "example_id": "5188d238-59db-45ed-913f-f5f7c6ed30b0",
                                                "sense_id": "33c9b120-f107-3b72-9276-8bd83602a7e0",
                                                "text": "„Der Pegelstand wird am Donaukai erfasst und kann von dem Pegel des Wasserwirtschaftsamtes Ingolstadt abweichen.“"
                                            },
                                            {
                                                "example_id": "4b10a36e-c2f2-462f-b9d4-e584e92a1c94",
                                                "sense_id": "33c9b120-f107-3b72-9276-8bd83602a7e0",
                                                "text": "„Der Pegel scheint weiter gestiegen zu sein.“"
                                            },
                                            {
                                                "example_id": "ffe228e9-d4fb-4422-b85d-a756a2f8156c",
                                                "sense_id": "33c9b120-f107-3b72-9276-8bd83602a7e0",
                                                "text": "„Der Meeresspiegel in der Elbemündung, am Pegel Cuxhaven, ist seit 1843 um etwa 40 cm gestiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1717a937-23b0-3a6e-86de-83d918ec130e",
                                        "entry_id": "222354f3-70ac-3dfa-84ee-3da296cd5a3c",
                                        "glosses": [
                                            "Logarithmus des Verhältnisses zweier Größen der gleichen Größenart"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
