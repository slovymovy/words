                "senses": [
                    {
                        "sense_id": "a625d055-576b-379f-ba39-b4f6da6322fc",
                        "entry_id": "6760a552-4e59-32c7-9f83-014634fbc870",
                        "glosses": [
                            "die malaiische Sprache der Minangkabau, auch als Dialekt des Malaiischen angesehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb70c9af-42ed-46c7-b35a-460156a9960b",
                                "sense_id": "a625d055-576b-379f-ba39-b4f6da6322fc",
                                "text": "Das Minangkabau ist eng mit dem Malaiischen verwandt."
                            },
                            {
                                "example_id": "5c4eae0a-eec7-4c32-9c31-01c3c2df894a",
                                "sense_id": "a625d055-576b-379f-ba39-b4f6da6322fc",
                                "text": "„Außerdem sind von Bedeutung das Makassarische, der Dialekt von Makassar und Umgebung, (Süd-Sulawesi) mit etwa 2 Millionen, die Dajak-Sprachen (Kalimantan) mit etwa ebensoviel Sprechern, das Minangkabau (West-Sumatra) mit 6,5 Millionen und das Balinesische (Bali und West-Lombok) mit 3,8 Millionen Sprechern, schließlich das Batakische /mit mehreren dialektalen Untergruppen/ (gesprochen in Zentral-Sumatra) mit 5,8 Millionen Sprechern“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
