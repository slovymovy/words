                                            {
                                                "example_id": "507261ad-a515-4895-ae47-d59f37cf2bd5",
                                                "sense_id": "368d186b-05bf-3530-94da-b9f18d6475a2",
                                                "text": "Please copy these reports for me."
                                            },
                                            {
                                                "example_id": "66d6efff-5681-41df-a464-5bc9d23dd81d",
                                                "sense_id": "368d186b-05bf-3530-94da-b9f18d6475a2",
                                                "text": "Don't copy that floppy!"
                                            },
                                            {
                                                "example_id": "ec77c5f6-877b-4c8e-b4a2-c331b50b9193",
                                                "sense_id": "368d186b-05bf-3530-94da-b9f18d6475a2",
                                                "text": "[Isaac Newton] was obsessed with alchemy. He spent hours copying alchemical recipes and trying to replicate them in his laboratory. He believed that the Bible contained numerological codes. The truth is that Newton was very much a product of his time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b048936-97a6-34eb-a90b-f2d64ffc4e7e",
                                        "entry_id": "7d3752f2-ee3d-329c-955b-0109e1a6a9c2",
                                        "glosses": [
                                            "To give or transmit a copy to (a person)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb77ad9e-8943-4cee-a6a9-2b2e11816a95",
                                                "sense_id": "1b048936-97a6-34eb-a90b-f2d64ffc4e7e",
                                                "text": "Make sure you copy me on that important memo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b959b08-baf4-3240-90be-05af46d8f76b",
                                        "entry_id": "7d3752f2-ee3d-329c-955b-0109e1a6a9c2",
                                        "glosses": [
                                            "To place a copy of an object in memory for later use."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97b1bed8-ca5d-4b7f-b5a9-b84fdfa80482",
                                                "sense_id": "9b959b08-baf4-3240-90be-05af46d8f76b",
                                                "text": "First copy the files, and then paste them in another directory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8370f360-463d-32be-ac4b-92cba8d338bd",
                                        "entry_id": "7d3752f2-ee3d-329c-955b-0109e1a6a9c2",
                                        "glosses": [
                                            "To imitate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3181370-6af9-4ca8-9287-7fd998d64cd0",
                                                "sense_id": "8370f360-463d-32be-ac4b-92cba8d338bd",
                                                "text": "Don't copy my dance moves."
                                            },
                                            {
                                                "example_id": "66c6fd20-c503-42fb-8df6-f3f169ce2ebe",
                                                "sense_id": "8370f360-463d-32be-ac4b-92cba8d338bd",
                                                "text": "Mom, he's copying me!"
                                            },
                                            {
                                                "example_id": "bc0fa257-e7f8-4c2f-b014-eb2998a96592",
                                                "sense_id": "8370f360-463d-32be-ac4b-92cba8d338bd",
                                                "text": "We copy instinctively the voices of our companions, their accents, and their modes of pronunciation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0442825e-0ca5-3ab6-9233-7c1558bd26e0",
                                        "entry_id": "7d3752f2-ee3d-329c-955b-0109e1a6a9c2",
                                        "glosses": [
                                            "To receive a transmission successfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53fbd17d-eb4b-4bc1-b1dc-cba5b69276d9",
                                                "sense_id": "0442825e-0ca5-3ab6-9233-7c1558bd26e0",
                                                "text": "Do you copy?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
