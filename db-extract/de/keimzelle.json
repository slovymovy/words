                        ],
                        "form": "die Keimzellen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "73dbcf32-ed75-302d-bddf-5de8f8ab81bb",
                        "entry_id": "224f763d-97f8-39e9-bff7-bc757a7d683e",
                        "glosses": [
                            "eine der Fortpflanzung dienende Geschlechtszelle bei Lebewesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5664305-3c2e-452a-9c09-f2d1ff35c9df",
                                "sense_id": "73dbcf32-ed75-302d-bddf-5de8f8ab81bb",
                                "text": "Das Ei geht aus Keimzellen hervor."
                            },
                            {
                                "example_id": "5bd336a1-e775-46b3-acbc-712ee14aebbf",
                                "sense_id": "73dbcf32-ed75-302d-bddf-5de8f8ab81bb",
                                "text": "„Wie das Atom, so hat auch die Keimzelle einen Kern, und auch hier gelten unvorstellbar kleine, kraftvolle Maßstäbe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3f7dc252-2e29-36a9-9355-349a6042d54d",
                        "entry_id": "224f763d-97f8-39e9-bff7-bc757a7d683e",
                        "glosses": [
                            "der Ursprung, der Beginn, die Quelle von Vorhaben, Projekten, Prozessen, Körperschaften, organisierten Gruppen von Personen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "8ff80a72-c201-4af0-a223-95a4d0c86fb9",
                                "sense_id": "3f7dc252-2e29-36a9-9355-349a6042d54d",
                                "text": "„In gewisser Weise hat Friedrich Engels wieder Recht: Die Familie ist die Keimzelle des Staates.“"
                            },
                            {
                                "example_id": "963894d0-51ec-4153-81f0-034dfd357abc",
                                "sense_id": "3f7dc252-2e29-36a9-9355-349a6042d54d",
                                "text": "„Die ägyptische Hauptstadt war zugleich Keimzelle der arianischen Kirche.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "842d5df8-d8a2-4449-8d22-6d6a35d9e8f8",
                        "source_entry_id": "224f763d-97f8-39e9-bff7-bc757a7d683e",
                        "source_sense_id": "73dbcf32-ed75-302d-bddf-5de8f8ab81bb",
                        "source_sense_description": "Biologie: eine der Fortpflanzung dienende Geschlechtszelle bei Lebewesen",
                        "target_lang_word": "gamète",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gamète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64b3a560-e2e2-3402-b536-39138c13624f",
                                        "entry_id": "2c0969cc-c5ec-3d68-aa01-6cf2ecbd808b",
                                        "glosses": [
                                            "Cellule sexuée haploïde permettant la reproduction sexuée des eucaryotes."
                                        ],
                                        "tags": [
                                            "Reproduction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f2d27e5-78ce-496a-a57f-c866fe5e36f3",
                                                "sense_id": "64b3a560-e2e2-3402-b536-39138c13624f",
                                                "text": "La période de fécondation est limitée au temps de vie des gamètes ; l’ovocyte a une durée de vie de 24 heures et le spermatozoïde de 48 à 72 heures."
                                            },
                                            {
                                                "example_id": "f6195380-b23f-49bd-9a5d-486b7ae6ce31",
                                                "sense_id": "64b3a560-e2e2-3402-b536-39138c13624f",
                                                "text": "Les Mousses que nous observons dans la nature sont donc des gamétophytes. Ces individus haploïdes possèdent des organes sexuels mâles (anthéridies) qui produisent des gamètes flagellés appelés anthérozoïdes."
                                            },
                                            {
                                                "example_id": "41e14ab5-d2de-4c46-9087-e8dcd5299a50",
                                                "sense_id": "64b3a560-e2e2-3402-b536-39138c13624f",
                                                "text": "Pour former la génération suivante, nous produisons des gamètes, les ovules pour les femmes, les spermatozoïdes pour les hommes. Dans chaque gamète ne se trouve qu’un seul collier, l’un venant du gamète mâle, l’autre du gamète femelle, s’uniront pour former un nouvel individu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f06074b-4405-4bb2-b3dd-e15b2b186317",
                        "source_entry_id": "224f763d-97f8-39e9-bff7-bc757a7d683e",
                        "source_sense_id": "73dbcf32-ed75-302d-bddf-5de8f8ab81bb",
