                "translations": [
                    {
                        "translation_id": "2f7eaa39-6203-44d9-bb31-46c6da5afda5",
                        "source_entry_id": "bcaa5cb5-aa93-3e3e-9a86-55fb4872adc9",
                        "source_sense_id": "d49f5c95-6f8d-32b5-a238-9cfff8b304b1",
                        "source_sense_description": "one who shnors",
                        "target_lang_word": "Schnorrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnorrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                        "entry_id": "ebe4404a-166a-3814-a1a1-a366f2aa913a",
                                        "glosses": [
                                            "(männliche) Person, die wiederholt um Gefälligkeiten (zum Beispiel Zigaretten oder Snacks) bittet, ohne die Absicht zu haben, eine Gegenleistung zu erbringen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aca51b18-7651-4d51-ad64-c93ec5a29cfd",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "„Er war empört gewesen, daß der Bankier Roest ihn als Schnorrer und Nebbich empfangen hatte, aber er sah bald, daß er in dieser Stadt, die in einem Millionentaumel lebte, wirklich ein Nebbich war.“"
                                            },
                                            {
                                                "example_id": "78bfe3c7-aecd-4d6d-8796-22966b38b6de",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "Er hatte nicht viel für Schnorrer übrig, aber ihm gefiel es, wenn jemand sein Talent in der Öffentlichkeit präsentierte, und er fand, dass eine kleine Gage gerechtfertigt war."
                                            },
                                            {
                                                "example_id": "3aca782b-aff2-4cd2-b092-554be12d119c",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "„Die Schnorrer, das heißt die Bettler, die auf Kosten reicher Gönner lebten, waren fester Bestandteil des durch die jüdische Religion geprägten Selbstverständnisses.“"
                                            },
                                            {
                                                "example_id": "37f8bb00-ef8d-41e0-b935-14dfa059fae4",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "„Denn einerseits entpuppt sich der Sabbatgast, der seinen Schwiegersohn ungebeten an den Tisch setzt, zwar als ein Schnorrer; andererseits aber folgen alle Beteiligten hier nur dem Gebot: Der Hausherr erfüllt seine Gastgeberpflicht, der Sabbatgast erfüllt seinen Vertrag mit den Eltern des Schwiegersohns, und indem er den Vater seiner Frau begleitet, hält sich auch der Schwiegersohn nur an die Regeln der Tradition.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62f40f26-c770-438a-96d4-a74954c65529",
                        "source_entry_id": "bcaa5cb5-aa93-3e3e-9a86-55fb4872adc9",
                        "source_sense_id": "d49f5c95-6f8d-32b5-a238-9cfff8b304b1",
                        "source_sense_description": "one who shnors",
                        "target_lang_word": "Bettler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bettler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                        "entry_id": "d62800d2-9e37-32a2-bd15-1cd5d96e20a2",
                                        "glosses": [
                                            "bedürftiger Mensch, der von Almosen lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aa24032-a9a3-4192-af44-44edcccf1157",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "Einen Dritteil der Einwohner machen privilegierte Bettler aus. (Johann Kaspar Riesbeck, Briefe eines reisenden Franzosen über Deutschland, Köln, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "cf0f0235-1bc8-4bc1-9a7f-c2618fc22f32",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "Vor dem Eingang zum Bahnhof saß ein Bettler und reckte den Passanten sein handgeschriebenes Schild entgegen."
                                            },
                                            {
                                                "example_id": "4eaaf31b-752e-4e98-8b45-c432f1701636",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Ein Bettler klingelte bei uns.“"
                                            },
                                            {
                                                "example_id": "331a6c2b-0207-439f-a3f1-02a452b209d9",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Im jüdischen Viertel gaben sich die Bettler als fromme Juden aus, ließen sich Bärte wachsen, warfen sich in lange schwarze Mäntel und segneten jeden, der ihnen unterkam.“"
                                            },
                                            {
                                                "example_id": "3e65e3fd-58b8-4b45-96ee-6abbc0288f8e",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Im September 1930 werden die Vorbereitungen hektischer, Maler streichen viele Fassaden neu, alte Hütten verschwinden hinter Zäunen aus Eukalyptusholz, Bettler und Leprakranke müssen die Stadt verlassen.“"
                                            },
                                            {
                                                "example_id": "addd2b6b-5489-4cf3-85f9-53d712185490",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Erst jetzt gab es in der antiken Welt Pauperismus in großem Ausmaße: Besitzlose, die als Bettler das Land durchstreiften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aea6a890-859c-3b59-a400-d1d5a10c1d72",
                                        "entry_id": "d62800d2-9e37-32a2-bd15-1cd5d96e20a2",
                                        "glosses": [
                                            "dringlich Bittender"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e790904a-08eb-4478-9c9e-8ce5edf72d1a",
                                                "sense_id": "aea6a890-859c-3b59-a400-d1d5a10c1d72",
                                                "text": "Ich stehe hier als Bittsteller und Bettler."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
