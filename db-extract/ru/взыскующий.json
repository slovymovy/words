                ],
                "senses": [
                    {
                        "sense_id": "f0a3fc6e-712f-3e70-93ba-ac4180dcbe6f",
                        "entry_id": "f5665e06-e10e-3535-b455-15ae059555c4",
                        "glosses": [
                            "книжн. ищущий чего-либо, надеющийся на что-либо, стремящийся к какому-либо идеалу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03e1cf36-8036-4729-a1aa-9b6e254e1dd4",
                                "sense_id": "f0a3fc6e-712f-3e70-93ba-ac4180dcbe6f",
                                "text": "Русский мессианизм опирается прежде всего на русское странничество, скитальчество и искание, на русскую мятежность и неутолимость духа, на Россию пророческую, на русских ― града своего не имеющих, града грядущего взыскующих."
                            },
                            {
                                "example_id": "b3b9834e-f99a-4434-8bdc-de2bcb37a6b9",
                                "sense_id": "f0a3fc6e-712f-3e70-93ba-ac4180dcbe6f",
                                "text": "Среди трудящейся молодежи бьются сердца, взыскующие подвига."
                            }
                        ]
                    },
                    {
                        "sense_id": "80cfe2bc-dac7-35b6-94f7-ab3db16a70c3",
                        "entry_id": "f5665e06-e10e-3535-b455-15ae059555c4",
                        "glosses": [
                            "устар. книжн. требовательный, строгий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e83ce067-1743-4d62-adab-e3a7cef66a71",
                                "sense_id": "80cfe2bc-dac7-35b6-94f7-ab3db16a70c3",
                                "text": "взыскующий человек"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5692aef3-637b-41a0-8183-f151a0debec9",
                        "source_entry_id": "f5665e06-e10e-3535-b455-15ae059555c4",
                        "target_lang_word": "searching",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "searching",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3463e3ea-d42d-386e-aaf6-bbd1babb92d5",
                                        "entry_id": "d0abd981-9b81-3a77-96e6-bfba35446e0b",
                                        "glosses": [
                                            "present participle and gerund of search"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "searching",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7495e9ad-261e-3d02-9807-3db882b2e1ea",
                                        "entry_id": "7051e484-5d92-3096-9305-11005de26cce",
                                        "glosses": [
                                            "Thorough."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80892368-1698-4ae4-9b16-df3bdc2c23ad",
                                                "sense_id": "7495e9ad-261e-3d02-9807-3db882b2e1ea",
                                                "text": "Einstein's photoelectric equation has been subjected to very searching tests and it appears in every case to predict exactly the observed results."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df2de5ae-9249-3fc0-8658-0f9d6602e431",
                                        "entry_id": "7051e484-5d92-3096-9305-11005de26cce",
                                        "glosses": [
                                            "Looking over closely; penetrating; severe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06e87eb1-31b4-45fd-aa22-89a54e09a926",
                                                "sense_id": "df2de5ae-9249-3fc0-8658-0f9d6602e431",
                                                "text": "a searching gaze; searching criticism"
                                            },
                                            {
                                                "example_id": "d2a52bdf-d458-40a3-b246-ea7e1874d610",
                                                "sense_id": "df2de5ae-9249-3fc0-8658-0f9d6602e431",
                                                "text": "‘So you are going out there. Famous. Interesting too.’ He gave me a searching glance, and made another note."
                                            },
                                            {
                                                "example_id": "0fbee501-8e28-4eea-b6f2-0f8a0d2ddde5",
                                                "sense_id": "df2de5ae-9249-3fc0-8658-0f9d6602e431",
                                                "text": "... a searching rain began to fall. In half an hour he was wet to the skin, and he fancied that Carteret, who sat amidships with the rain dripping from the light overcoat he had carried with him, could not be much drier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "searching",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fe77672-1408-3e53-ab0f-d8fbb5564053",
                                        "entry_id": "73b41a00-7680-3067-aed3-ac03bddbb210",
                                        "glosses": [
                                            "Search; hunt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "937dd412-2e1b-4236-ae87-d318ad4a10a1",
                                                "sense_id": "0fe77672-1408-3e53-ab0f-d8fbb5564053",
                                                "text": "Her songs take us through many mood changes from lighthearted lovesongs and social commentary to a serious searching for answers and understanding."
                                            },
                                            {
                                                "example_id": "ef3c3bee-7b05-48c8-bc51-a81384d1789f",
                                                "sense_id": "0fe77672-1408-3e53-ab0f-d8fbb5564053",
                                                "text": "Depending on whom you ask, Antony Flew is either a true convert whose lifelong intellectual searchings finally brought him to God or a senescent scholar possibly being exploited by his associates."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
