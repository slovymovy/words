    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "14150743-8da2-3af8-ae8a-eca6e7baa83f",
                "word": "fiendishly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "08ea985f-676a-4f32-9803-91662b88b299",
                        "entry_id": "14150743-8da2-3af8-ae8a-eca6e7baa83f",
