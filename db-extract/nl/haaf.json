                        "cross_references": [
                            {
                                "target_word": "estate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "796774d0-3ff7-3bc7-98c2-74ba6a9edbb7",
                                        "entry_id": "0b6be058-4968-3529-b55e-03018ddfd27e",
                                        "glosses": [
                                            "The collective property and liabilities of someone, especially a deceased person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c2b5fdd-7d68-332c-94c7-54456517d03d",
                                        "entry_id": "0b6be058-4968-3529-b55e-03018ddfd27e",
                                        "glosses": [
                                            "state; condition."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84f92db4-90fb-482f-919a-ec52827544b7",
                                                "sense_id": "2c2b5fdd-7d68-332c-94c7-54456517d03d",
                                                "text": "But when I came to mans eſtate,\nWith hey ho, [the winde and the raine],\nGainſt Knaues and Theeues men ſhut their gate."
                                            },
                                            {
                                                "example_id": "d6723818-59c3-4842-bd19-17dcf8273a9b",
                                                "sense_id": "2c2b5fdd-7d68-332c-94c7-54456517d03d",
                                                "text": "Mind not high things, but condescend to men of low estate."
                                            },
                                            {
                                                "example_id": "deeff23c-8791-4fb2-900f-210816e957df",
                                                "sense_id": "2c2b5fdd-7d68-332c-94c7-54456517d03d",
                                                "text": "To remove therfore if it be possible, this great and sad oppression which through the strictnes of a literall interpreting hath invaded and disturb’d the dearest and most peaceable estate of houshold society, to the over-burdening, if not the over-whelming of many Christians better worth then to be so deserted of the Churches considerate care, this position shall be laid down; first proving, then answering what may be objected either from Scripture or light of reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cda2715c-c233-30fe-98e0-63a218454c22",
                                        "entry_id": "0b6be058-4968-3529-b55e-03018ddfd27e",
                                        "glosses": [
                                            "Status, rank."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7c73049-b968-4c26-8374-8a3c58fd3a27",
                                                "sense_id": "cda2715c-c233-30fe-98e0-63a218454c22",
                                                "text": "God hath imprinted his authority in several parts, upon several estates of men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4a59273-a979-3f0d-9acc-b3cef29694c3",
                                        "entry_id": "0b6be058-4968-3529-b55e-03018ddfd27e",
                                        "glosses": [
                                            "The condition of one's fortunes; prosperity, possessions."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79ae85c4-534d-3d7f-9d30-e6140844484e",
                                        "entry_id": "0b6be058-4968-3529-b55e-03018ddfd27e",
                                        "glosses": [
                                            "A \\\"person of estate\\\"; a nobleman or noblewoman."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "318e9f4a-1a02-4926-bf5c-1b39b1fdaba4",
                                                "sense_id": "79ae85c4-534d-3d7f-9d30-e6140844484e",
                                                "text": "And anone came oute of a chamber to hym the fayrest lady that euer he sawe & more rycher bysene than euer he sawe Quene Gueneuer or ony other estat Lo sayd they syre Bors here is the lady vnto whome we owe alle oure seruyse / and I trowe she be the rychest lady and the fayrest of alle the world"
                                            },
                                            {
                                                "example_id": "f10927c1-b3ec-4a1a-bd22-5b386523c755",
                                                "sense_id": "79ae85c4-534d-3d7f-9d30-e6140844484e",
                                                "text": "Herod on his birthday made a supper to his lords, high captains, and chief estates of Galilee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c3f6f65-cea2-3df9-90e2-6f9110cc613d",
                                        "entry_id": "0b6be058-4968-3529-b55e-03018ddfd27e",
                                        "glosses": [
                                            "A major social class or order of persons regarded collectively as part of the body politic of the country and formerly possessing distinct political rights (Estates of the realm)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcdc28a1-b974-4b17-889b-1ddbbe4bc9b4",
                                                "sense_id": "2c3f6f65-cea2-3df9-90e2-6f9110cc613d",
                                                "text": "I am afraid that some of the nobles who are campaigning for it simply want to use the Estates to cut down the King's power and increase their own."
                                            },
                                            {
                                                "example_id": "9d13d9d7-92bc-428a-bb5a-5099d584a9cb",
                                                "sense_id": "2c3f6f65-cea2-3df9-90e2-6f9110cc613d",
                                                "text": "The three estates of feudal lords, clergy and royal officers met in separate chambers, and exercised an advisory role."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6db83217-78ed-3952-b11f-33e2b6671588",
                                        "entry_id": "0b6be058-4968-3529-b55e-03018ddfd27e",
                                        "glosses": [
                                            "The nature and extent of a person's interest in, or ownership of, land."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e2daede-e24e-39a0-9713-881eba5b4dc9",
                                        "entry_id": "0b6be058-4968-3529-b55e-03018ddfd27e",
                                        "glosses": [
                                            "An (especially extensive) area of land, under a single ownership."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a85b876-3709-4ab9-9a92-a3eb40278ad1",
                                                "sense_id": "0e2daede-e24e-39a0-9713-881eba5b4dc9",
                                                "text": "It has been a long time since new follies were springing up across the great estates of Britain. But the owners of Doddington Hall, in Lincolnshire, have brought the folly into the 21st century, by building a 30ft pyramid in the grounds of the Elizabethan manor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "663bec24-3701-3d63-b76e-9ddad75a83d8",
                                        "entry_id": "0b6be058-4968-3529-b55e-03018ddfd27e",
                                        "glosses": [
                                            "The landed property owned or controlled by a government or a department of government."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44d5dfbd-dab9-33cb-9d7c-dccdc63e4251",
                                        "entry_id": "0b6be058-4968-3529-b55e-03018ddfd27e",
                                        "glosses": [
                                            "A housing estate."
                                        ],
                                        "tags": [
                                            "UK",
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81b16c2e-510d-4407-99db-a6bb965ef341",
                                                "sense_id": "44d5dfbd-dab9-33cb-9d7c-dccdc63e4251",
                                                "text": "Professor Loretta Lees from King's College London's geography department says, \"The word 'estate' has become synonymous with the term 'ghetto'. It's become a dirty word. Back in the '20s and '30s it didn't carry the same stigma.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93e90ec9-d735-32f0-b859-696b1f67e860",
                                        "entry_id": "0b6be058-4968-3529-b55e-03018ddfd27e",
                                        "glosses": [
                                            "A station wagon; a car with a tailgate (or liftgate) and storage space to the rear of the seating which is coterminous with the passenger compartment (and often extensible into that compartment via folding or removable seating)."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e9f388a-1125-3fc8-9b57-b499839339a7",
                                        "entry_id": "0b6be058-4968-3529-b55e-03018ddfd27e",
                                        "glosses": [
                                            "The state; the general body politic; the common-wealth; the general interest; state affairs."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbf10e26-afc0-4605-ad2f-7de84391b889",
                                                "sense_id": "3e9f388a-1125-3fc8-9b57-b499839339a7",
                                                "text": "I call matter of estate not only the parts of sovereignty, but whatsoever[…]concerneth manifestly any great portion of people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f3f7dd-1445-3bcf-9aaa-ed5d04a9ebcc",
                                        "entry_id": "0b6be058-4968-3529-b55e-03018ddfd27e",
                                        "glosses": [
                                            "An organization's collective information technology resources."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c24269d1-67c9-4b08-94f3-ccb92253e4d3",
                                                "sense_id": "32f3f7dd-1445-3bcf-9aaa-ed5d04a9ebcc",
                                                "text": "This time, however, it only includes the static parameters that you expect to be consistent across your estate."
                                            }
                                        ]
                                    }
                                ]
