        "nl-extract.jsonl": [
            {
                "entry_id": "f9c3e13e-f565-3b65-82f6-ad1e4497c16f",
                "word": "vrijwel",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "40a2173e-05dc-36d3-953f-562c5d285fb9",
                        "entry_id": "f9c3e13e-f565-3b65-82f6-ad1e4497c16f",
                        "glosses": [
                            "zo goed als, verwaarloosbaar weinig schelend ten opzichte van iets anders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fb0a156-e25b-4c30-a107-d2667eac5007",
                                "sense_id": "40a2173e-05dc-36d3-953f-562c5d285fb9",
                                "text": "Mijn laatste waterfles was vrijwel leeg toen ik in de verte gelukkig het meertje zag."
                            },
                            {
                                "example_id": "faa0e353-5535-4907-b17b-766216164a48",
                                "sense_id": "40a2173e-05dc-36d3-953f-562c5d285fb9",
                                "text": "In Utrecht, dé fietsstad van Nederland, peddelen vrijwel alle fietsers nog rustig zonder helm door de straten. Ook ouderen, kinderen en hun ouders. Willem (63) is onderweg met een ov-fiets en denkt er \"wel eens over na\", maar gebruikt tot nu toe alleen een helm met mountainbiken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50c94385-1926-48e0-b0d7-a7ad173dea83",
                        "source_entry_id": "f9c3e13e-f565-3b65-82f6-ad1e4497c16f",
                        "source_sense_id": "40a2173e-05dc-36d3-953f-562c5d285fb9",
                        "source_sense_description": "zo goed als, verwaarloosbaar weinig schelend ten opzichte van iets anders",
                        "target_lang_word": "nahezu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nahezu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "acbfd5dc-421c-38bb-bfda-aa6312c82db3",
                                        "entry_id": "2a2c1787-6683-3ae3-a0f3-0ceaefaaad3d",
                                        "glosses": [
                                            "nicht ganz, aber fast vollständig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04f9f0bb-f095-4b61-9e2a-e6aa9cb10a21",
                                                "sense_id": "acbfd5dc-421c-38bb-bfda-aa6312c82db3",
                                                "text": "Sie hatten Ihre Verpflegung nahezu aufgebraucht, da kam endlich Rettung."
                                            },
                                            {
                                                "example_id": "609704de-dc1c-4cd0-b525-3a9af670d2ff",
                                                "sense_id": "acbfd5dc-421c-38bb-bfda-aa6312c82db3",
                                                "text": "„Ein nahezu flächendeckender Zusammenbruch der Industrie, massenhafte Arbeitslosigkeit und beständige Abwanderung erschütterten in den neunziger Jahren die ostdeutschen Bundesländer.“"
                                            },
                                            {
                                                "example_id": "bc4c1748-d2a6-49c5-8502-3c12d85713a5",
                                                "sense_id": "acbfd5dc-421c-38bb-bfda-aa6312c82db3",
                                                "text": "„Die Metallspitzen von Skistöcken schepperten auf dem Bahnsteig, und ein nahezu babylonisches Sprachengewirr erfüllte die Luft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "927e3bb2-c9b4-40d0-9a57-846bc7690ee6",
                        "source_entry_id": "f9c3e13e-f565-3b65-82f6-ad1e4497c16f",
                        "source_sense_id": "40a2173e-05dc-36d3-953f-562c5d285fb9",
                        "source_sense_description": "zo goed als, verwaarloosbaar weinig schelend ten opzichte van iets anders",
                        "target_lang_word": "almost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "almost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                        "entry_id": "43234f26-4a18-3e53-b9b9-77fafb9171f4",
                                        "glosses": [
                                            "Very close to, but not quite."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d58d07f-6b30-4f31-8577-3d020494e3a7",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "Almost all people went there."
                                            },
                                            {
                                                "example_id": "b84d6eea-bdbc-4a6a-9054-4da7f3390568",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "We almost missed the train."
                                            },
                                            {
                                                "example_id": "20643536-7061-49b2-82cc-63f358b0fd42",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "Nobody, or almost, noticed anything unusual."
                                            },
                                            {
                                                "example_id": "935e3112-e8d4-4430-8f52-95e4a5165a32",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                                            },
                                            {
                                                "example_id": "31f647d4-aaee-47c1-a3f0-f5ee4c81503d",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "This time was most dreadful for Lilian. Thrown on her own resources and almost penniless, she maintained herself and paid the rent of a wretched room near the hospital by working as a charwoman, sempstress, anything. In a moment she had dropped to the level of a casual labourer."
                                            },
                                            {
                                                "example_id": "241f62ba-1422-4343-97ee-975f405ec9bf",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "Eustace gaped at him in amazement. When his urbanity dropped away from him, as now, he had an innocence of expression which was almost infantile. It was as if the world had never touched him at all."
                                            },
                                            {
                                                "example_id": "d553541e-4db9-45c8-ab67-77b743d761f5",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "For some odd reason, Sherin has chosen to direct the play as a comedy — at times almost a farce."
                                            },
                                            {
                                                "example_id": "4949e741-6c56-4f13-a87e-08cc091a50d8",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. […] The public realm is privatised, the regulations restraining the ultra-wealthy and the companies they control are abandoned, and Edwardian levels of inequality are almost fetishised."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b60ea10-d68a-36c1-a569-6469c07ad6a2",
                                        "entry_id": "43234f26-4a18-3e53-b9b9-77fafb9171f4",
                                        "glosses": [
                                            "Up to, except for a negligible set (where negligible is not universally but contextually defined)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e36fe8c7-f16c-4a14-8db5-ac974072c0fb",
                                                "sense_id": "6b60ea10-d68a-36c1-a569-6469c07ad6a2",
                                                "text": "almost all"
                                            },
                                            {
                                                "example_id": "03656ee6-b498-4c25-aefd-fb1b9d51663d",
                                                "sense_id": "6b60ea10-d68a-36c1-a569-6469c07ad6a2",
                                                "text": "almost no"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55cffd57-7700-37fe-ad6b-4fab29491638",
                                        "entry_id": "43234f26-4a18-3e53-b9b9-77fafb9171f4",
                                        "glosses": [
                                            "Up to, except for a negligible set (where negligible is not universally but contextually defined).",
                                            "Up to a null set; except for a set of measure 0."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "606d69aa-15d8-42dc-8347-7729463808e9",
                                                "sense_id": "55cffd57-7700-37fe-ad6b-4fab29491638",
                                                "text": "almost everywhere"
                                            },
                                            {
                                                "example_id": "6f9ee126-fc5b-492f-aa07-74854cdac874",
                                                "sense_id": "55cffd57-7700-37fe-ad6b-4fab29491638",
                                                "text": "almost nowhere"
                                            },
                                            {
                                                "example_id": "f657da0d-b542-4694-8ea3-694050efc4b8",
                                                "sense_id": "55cffd57-7700-37fe-ad6b-4fab29491638",
                                                "text": "almost certain"
                                            },
                                            {
                                                "example_id": "c7b90752-4e78-464f-a44f-a13f49e3d24c",
                                                "sense_id": "55cffd57-7700-37fe-ad6b-4fab29491638",
                                                "text": "almost sure"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "almost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d90a62f8-953c-357e-8d92-1d180887c075",
                                        "entry_id": "8e9a092b-f7a4-3197-ab76-6b3b5d14390c",
                                        "glosses": [
                                            "Something or someone that doesn't quite make it."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c277477e-c93c-4eb5-bbdf-c61c72d42b21",
                                                "sense_id": "d90a62f8-953c-357e-8d92-1d180887c075",
                                                "text": "In all the submissions, they found four papers that were clearly worth publishing and another dozen almosts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
