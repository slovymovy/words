                        "glosses": [
                            "Gebäude zur Aufbewahrung von Fahrzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03a3c0a2-b1ac-43df-9495-772c7ac46ee0",
                                "sense_id": "2f2b9f00-3933-389e-93ca-f9199b931026",
                                "text": "„Vor einer Wagenremise fanden sie ein totes Pferd und zwei tote Kinder, die unter einem Wagen Schutz gesucht, aber vergessen hatten, hervorzukriechen, als das Feuer kam.“"
                            },
                            {
                                "example_id": "0fb0043d-5990-42b4-be17-a4279b55f42c",
                                "sense_id": "2f2b9f00-3933-389e-93ca-f9199b931026",
                                "text": "„Den Rückweg nahm sie vermutlich durch den Park, vorbei am Tennisplatz, denn dahinter lagen die Pferdeställe und die Wagenremisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
