                "senses": [
                    {
                        "sense_id": "904208ec-81ca-33bc-82cd-03145389c11f",
                        "entry_id": "2ff1497c-1f3d-339c-80a1-14978b99d35d",
                        "glosses": [
                            "рег. кость надкопытного сустава ноги барана или другого животного, употребляемая для игры; бабка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46822c50-f485-4a7a-8741-4819ac40a520",
                                "sense_id": "904208ec-81ca-33bc-82cd-03145389c11f",
                                "text": "Козны — бабки, известная и самая обычная игра деревенских мальчиков."
                            },
                            {
                                "example_id": "d7608c5f-ed32-4431-9aef-fefddb3657ba",
                                "sense_id": "904208ec-81ca-33bc-82cd-03145389c11f",
                                "text": "Разбивал он козны на расстоянии двадцати шагов и, к нашему изумлению и зависти, ни разу не промахнулся."
                            },
                            {
                                "example_id": "991fc883-7574-4e32-8f01-5a7cb5d96a5d",
                                "sense_id": "904208ec-81ca-33bc-82cd-03145389c11f",
                                "text": "Они вообще-то были неплохие ребята и когда участвовали в «громке» фруктовых садов или водили в казаки-разбойники, то лучше их и не найдёшь, но, скажем, играть с ними в козны или расшибалочку на интерес было скверно."
                            }
                        ]
                    }
