        "fr-extract.jsonl": [
            {
                "entry_id": "0b2aad59-bad3-30bc-a9ce-6c8f22865453",
                "word": "prostration",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "36cc63ec-baa3-4bdd-a1f2-2df8ec3a8781",
                        "entry_id": "0b2aad59-bad3-30bc-a9ce-6c8f22865453",
                        "tags": [
                            "plural"
                        ],
                        "form": "prostrations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                        "entry_id": "0b2aad59-bad3-30bc-a9ce-6c8f22865453",
                        "glosses": [
                            "Affaiblissement extrême ; profond abattement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0c36512-aae4-44fe-a62d-6cd4a908e4f9",
                                "sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                                "text": "Je lui racontai tout: cette étrange hallucination qui me prenait à cette heure où Kostaki avait dû mourir; cette terreur, cet engourdissement, ce froid de glace, cette prostration qui me couchait sur mon lit."
                            },
                            {
                                "example_id": "4960662a-607e-4a36-8676-35b6669cd786",
                                "sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                                "text": "Elle se perdait ainsi durant des jours dans ses rêves, qui se terminaient d’ordinaire par des accès de complète prostration."
                            },
                            {
                                "example_id": "bff153c5-991b-46fa-8e04-30ca2700fb77",
                                "sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                                "text": "Disons plus : la pieuse prostration de l’enfant qui a perdu sa vieille mère, par exemple, n’est-elle pas (de nos jours) un luxe que les indigents, harcelés par une tâche obligatoire, ne peuvent se permettre ? Le loisir de cette songerie morbide n’est donc pas de première nécessité : l’on peut, enfin, s’en passer ?"
                            },
                            {
                                "example_id": "9e5c98aa-0214-46ae-8e71-2efb25fa079a",
                                "sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                                "text": "Cependant ces accidents s’amendèrent, mais la prostration morale ne s’améliora pas, et au bout de quelques jours, il n’y eut plus qu’elle qui inquiéta le médecin."
                            },
                            {
                                "example_id": "f713cd3a-266a-4c78-96d8-6c1204356368",
                                "sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                                "text": "Mon père profita de cette prostration totale de mes forces pour me demander la promesse formelle de partir avec lui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d13e7a0c-f5b4-4150-8ed4-a441f2879871",
                        "source_entry_id": "0b2aad59-bad3-30bc-a9ce-6c8f22865453",
                        "source_sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                        "target_lang_word": "Niedergeschlagenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niedergeschlagenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6cd45d6-29ef-3ea8-a501-5ff8077a65cf",
                                        "entry_id": "a152aebd-3c33-31b6-8172-e0d0fbcb4eba",
                                        "glosses": [
                                            "traurige Gemütsstimmung, oft verbunden mit dem Gefühl körperlicher Erschöpfung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1c521f1-a88f-4cc2-b5cb-d4c8d0cf41fd",
                                                "sense_id": "a6cd45d6-29ef-3ea8-a501-5ff8077a65cf",
                                                "text": "Mich begleitet seit Tagen eine Niedergeschlagenheit, die ich mir nicht erklären kann."
                                            },
                                            {
                                                "example_id": "dc266a60-b143-4517-897a-07de0023d4de",
                                                "sense_id": "a6cd45d6-29ef-3ea8-a501-5ff8077a65cf",
                                                "text": "„Seine Niedergeschlagenheit war nun vollständig geworden.“"
                                            },
                                            {
                                                "example_id": "a1d38e83-774f-4025-878f-1f9f9abea3e7",
                                                "sense_id": "a6cd45d6-29ef-3ea8-a501-5ff8077a65cf",
                                                "text": "„Das aus dem Gefühl unserer Schwäche entstehende Unbehagen ist Niedergeschlagenheit.“"
                                            },
                                            {
                                                "example_id": "f2859d03-b215-4ff6-aace-8f9f1815e754",
                                                "sense_id": "a6cd45d6-29ef-3ea8-a501-5ff8077a65cf",
                                                "text": "„Sie waren viel zu sehr mit einem seltsam unbestimmten Gefühl der Sehnsucht beschäftigt, das eine große Niedergeschlagenheit in ihnen auslöste.“"
                                            },
                                            {
                                                "example_id": "4d16bd3d-eaef-4b5f-9731-77fe92034baa",
                                                "sense_id": "a6cd45d6-29ef-3ea8-a501-5ff8077a65cf",
                                                "text": "„Ich erwachte erst nach elf Stunden; aber in meiner Niedergeschlagenheit dämmerte ich weiter vor mich hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9ca9fb3-8f2a-4bf5-8c3d-bd223e57e370",
                        "source_entry_id": "0b2aad59-bad3-30bc-a9ce-6c8f22865453",
                        "source_sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                        "target_lang_word": "prostration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prostration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6be37ede-b195-32ca-8bb2-26d6cd57a724",
                                        "entry_id": "8e1d6963-e867-31d0-98d1-ea7679d76498",
                                        "glosses": [
                                            "The act or condition of prostrating oneself (lying face-down), as a sign of humility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5e07f15-b0f4-3315-bc02-6e1b8299f435",
                                        "entry_id": "8e1d6963-e867-31d0-98d1-ea7679d76498",
                                        "glosses": [
                                            "A part of the ordination of Catholic and Orthodox priests, in which the ordinand lies prostrate in a gesture of submission to the will of God."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f358b6e-f5e7-41b6-99a2-84c5b0960c97",
                                                "sense_id": "e5e07f15-b0f4-3315-bc02-6e1b8299f435",
                                                "text": "The ordination ceremony includes a variety of rituals, rich in meaning and history, e.g., the prostration, laying on of hands, anointing of hands, giving of the chalice and paten, and sign of peace. — Diocese of Rochester, NY"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7fdcabb-f412-32ef-b3a6-a411e58edb7a",
                                        "entry_id": "8e1d6963-e867-31d0-98d1-ea7679d76498",
                                        "glosses": [
                                            "The state of lying face down (prone)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdf429d2-043d-3c7a-a737-a604b93f7bde",
                                        "entry_id": "8e1d6963-e867-31d0-98d1-ea7679d76498",
                                        "glosses": [
                                            "The condition of being prostrated, as from heat; complete loss of strength."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "debce5ad-4056-46b4-bac9-714b4b274053",
                                                "sense_id": "cdf429d2-043d-3c7a-a737-a604b93f7bde",
                                                "text": "I slept after the prostration of the day, with a stringent and profound slumber which not even the nightmares that wrung me could avail to break."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4def3d91-de74-3407-8cbb-3523e98c945e",
                                        "entry_id": "8e1d6963-e867-31d0-98d1-ea7679d76498",
                                        "glosses": [
                                            "A reverential bow performed in Middle Eastern cultures."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ce91f26-6583-4363-8dd3-d244332b6136",
                                                "sense_id": "4def3d91-de74-3407-8cbb-3523e98c945e",
                                                "text": "Their faith can be seen in their mannerisms on the pitch – cupping hands in silent pre-kick-off prayer or prostration after hitting the back of the net."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
