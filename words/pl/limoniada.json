            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db0a29a6-4bb2-32e1-9c9b-1a02cb4209e6",
                    "sense_definition": "orzeźwiający napój chłodzący przygotowywany z soku z limonek, wody oraz cukru",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "napój",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W upalne letnie dni domowa <w>limoniada</w> doskonale gasi pragnienie.",
                            "target_lang_translations": {
                                "ru": "В жаркие летние дни домашний <w>лаймонад</w> прекрасно утоляет жажду."
                            }
                        },
                        {
                            "text": "Kelner przyniósł nam dzbanek, w którym była świeża <w>limoniada</w> z lodem i miętą.",
                            "target_lang_translations": {
                                "ru": "Официант принес нам кувшин, в котором был свежий <w>лаймовый лимонад</w> со льдом и мятой."
                            }
                        }
                    ],
                    "synonyms": [
                        "lemoniada"
                    ],
                    "common_phrases": [
                        "orzeźwiająca limoniada",
                        "domowa limoniada",
                        "dzbanek limoniady"
                    ],
                    "target_lang_definitions": {
                        "ru": "освежающий прохладительный напиток из сока лайма, воды и сахара"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лаймонад",
                                "target_lang_sense_clarification": "напиток из лайма"
                            },
                            {
                                "target_lang_word": "лаймовый лимонад",
                                "target_lang_sense_clarification": "лимонад на основе лайма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50810efa-8fff-3bea-b53a-f6d041d1d4ce",
                    "sense_definition": "porcja napoju z limonek, podawana zazwyczaj w szklance lub kubku",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "porcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poproszę jeszcze jedną zimną <w>limoniadę</w> bez dodatku cukru.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, еще один холодный <w>лаймонад</w> без добавления сахара."
                            }
                        },
                        {
                            "text": "Wypił całą <w>limoniadę</w> jednym haustem, ponieważ był bardzo spragniony po treningu.",
                            "target_lang_translations": {
                                "ru": "Он выпил весь <w>лаймонад</w> залпом, потому что очень хотел пить после тренировки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "szklanka limoniady",
                        "zamówić limoniadę"
                    ],
                    "target_lang_definitions": {
                        "ru": "порция лаймового напитка, подаваемая обычно в стакане или бокале"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лаймонад",
                                "target_lang_sense_clarification": "порция напитка"
                            },
                            {
                                "target_lang_word": "лаймовый лимонад",
                                "target_lang_sense_clarification": "порция лаймового лимонада"
                            },
