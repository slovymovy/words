                                        "sense_id": "1ef06afc-ba5d-3800-a555-4389b8416fc9",
                                        "entry_id": "48663a55-df3e-3c1a-ae89-e8539c580ed3",
                                        "glosses": [
                                            "Espèce de champignons à lames libres devenant noires et se liquéfiant, au chapeau cylindrique puis en forme de cloche, couvert de mèches blanches, et au pied avec anneau mobile, mais sans volve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c4cb9cf-b6e9-4e79-b485-6d5c8e3bb8fe",
                                                "sense_id": "1ef06afc-ba5d-3800-a555-4389b8416fc9",
                                                "text": "Un champignon comestible, le coprin chevelu, apprécie également les gazons neufs."
                                            },
                                            {
                                                "example_id": "8fb92ce6-cfb2-4e00-99d2-26a338cf2b5b",
                                                "sense_id": "1ef06afc-ba5d-3800-a555-4389b8416fc9",
                                                "text": "Flore : saule, mûrier, spirée, genévrier, viorne, laurier palme, frêne, oranger du Mexique, saule tortueux, herbe de la pampa, bouleau, laurier, if, cèdre, érable, plaqueminier (kaki), peuplier, aulne, sureau, buis, figuier, tilleul, fuseau, olivier, troène, marronnier, eleagnus, noisetier, néflier, mauve, rose trémière, pissenlit, picride fausse vipérine, géranium, trèfle pourpre, liseron des champs, ortie dioïque, fraise des bois, brunelle commune, laiteron, coquelicot, champignon (coprin chevelu)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
