        "fr-extract.jsonl": [
            {
                "entry_id": "e86eec1b-aa80-3229-828a-27de2a5ef06a",
                "word": "canonnière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "53dba95a-7eb3-4355-800c-8b4f797ac6fa",
                        "entry_id": "e86eec1b-aa80-3229-828a-27de2a5ef06a",
                        "tags": [
                            "plural"
                        ],
                        "form": "canonnières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1586dfe-7516-3e98-9c9c-2e2c394644ff",
                        "entry_id": "e86eec1b-aa80-3229-828a-27de2a5ef06a",
                        "glosses": [
                            "Petit bâtiment armé d’un ou de plusieurs canons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e42c223-0783-4098-bc49-95afa7be818e",
                                "sense_id": "c1586dfe-7516-3e98-9c9c-2e2c394644ff",
                                "text": "En m’approchant du bord, je finis par distinguer dans cette vague lueur qui monte de l’eau la plus noire une canonnière arrêtée au pont de Bercy et s’efforçant de remonter le courant."
                            },
                            {
                                "example_id": "bd894c5f-ea03-4009-b403-a26f278185de",
                                "sense_id": "c1586dfe-7516-3e98-9c9c-2e2c394644ff",
                                "text": "Quand je m'éveillai le lendemain, le Valdemar était mouillé dans la baie de Faxa, à quelques encablures de la terre, entre une canonnière danoise et l’aviso français le Dupleix."
                            },
                            {
                                "example_id": "db4f0497-7303-4c89-9c76-096c78db401e",
                                "sense_id": "c1586dfe-7516-3e98-9c9c-2e2c394644ff",
                                "text": "Mais, somme toute, les dirigeables n’étaient pas mieux fournis, en fait de cuirassement et d’armement, que la plus petite canonnière."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8b30639-540a-3a55-924b-10adb8667f4b",
                        "entry_id": "e86eec1b-aa80-3229-828a-27de2a5ef06a",
                        "glosses": [
                            "Embrasure pour tirer à couvert."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "22f18d12-870c-3f70-8b20-1120d42b6ff5",
                        "entry_id": "e86eec1b-aa80-3229-828a-27de2a5ef06a",
                        "glosses": [
                            "Ouverture dans un mur, au fond des écluses, pour l'écoulement des eaux."
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "acc61a62-7a70-3022-8cec-6f57bccca982",
                        "entry_id": "e86eec1b-aa80-3229-828a-27de2a5ef06a",
                        "glosses": [
                            "Tente, en pyramide, qui n'a que le toit."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5e3ee40b-9cb4-3ed5-b0fe-a00cf07e0b0c",
                        "entry_id": "e86eec1b-aa80-3229-828a-27de2a5ef06a",
                        "glosses": [
                            "Jouet qui consistait en un bâton de sureau dont on avait ôté la moelle, avec lequel les enfants chassaient des boules à l'aide d'un piston."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "09d9ad77-3723-44b3-8fd1-bf9d9f25a9e1",
                                "sense_id": "5e3ee40b-9cb4-3ed5-b0fe-a00cf07e0b0c",
                                "text": "Le sautériau, pour passer le temps, avait coupé une branche de sureau et il était en train de fabriquer une canonnière ou plutôt, comme on dit chez nous, une arbute, quand il avisa de loin le gros seigneur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f235a950-5fd1-44ea-acf6-47023465e79f",
                        "source_entry_id": "e86eec1b-aa80-3229-828a-27de2a5ef06a",
                        "source_sense_id": "c1586dfe-7516-3e98-9c9c-2e2c394644ff",
                        "source_sense_description": "Bâtiment armé de canons",
                        "target_lang_word": "Kanonenboot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanonenboot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                        "entry_id": "6a3d39e7-0e91-3e5e-b87a-30ece45d0d2c",
                                        "glosses": [
                                            "relativ kleines, mit Kanonen bewaffnetes Kriegsschiff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d6df51a-1d8c-4578-ac3a-b8063ae0966d",
                                                "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                                "text": "„Die Zeit der Kanonenboote ist vorbei, auch wenn einige Nationen tatsächlich Schiffe in Marsch setzen.“"
                                            },
                                            {
                                                "example_id": "b63c0c16-1f53-426b-8aa4-948ddffe37bb",
                                                "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                                "text": "„In der Hoffnung, über den Mekong den lukrativen chinesischen Markt zu erschließen, entsandte Kaiser Napoleon III. Kanonenboote nach Vietnam.“"
                                            },
                                            {
                                                "example_id": "8a0047d1-fe1c-4b0a-bb63-7f900f12524b",
                                                "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                                "text": "„Kanonenboote dringen sogar in brasilianische Häfen ein, um die Regierung der ehemaligen portugiesischen Kolonie zur Beendigung des Sklavenhandels zu zwingen.“"
                                            },
                                            {
                                                "example_id": "766b0821-df15-4300-8bc1-a4bd24e666e9",
                                                "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                                "text": "„Als wir Samdy Hook erreichten, wurden wir von einem Kanonenboot begrüßt und hörten vom »kleinen Embargo«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
