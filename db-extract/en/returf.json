                    {
                        "translation_id": "5bf71a79-fad8-4cb6-a5f4-78739a093545",
                        "source_entry_id": "2a4f0ccb-4b85-3817-9263-ac5dfc17971d",
                        "source_sense_id": "7d87bc2d-8844-3e4c-9c38-e243ade50e28",
                        "source_sense_description": "to lay turf again",
                        "target_lang_word": "rekultivieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rekultivieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27f22ca0-bd4a-3891-8f55-2fc6f49562ae",
                                        "entry_id": "cf3860e2-ead8-3ebb-bfe6-040298fd5a3f",
                                        "glosses": [
                                            "durch menschlichen Einfluss (meist Bergbau oder Deponien) unfruchtbar gewordenes Land erneut urbar machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "719c6cbd-5d79-4ef5-b61b-00873659eefa",
                                                "sense_id": "27f22ca0-bd4a-3891-8f55-2fc6f49562ae",
                                                "text": "„Der neue Eigentümer plant nun, die Löcher zu verfüllen und als Grünfläche zu rekultivieren.“"
                                            },
                                            {
                                                "example_id": "5ebcc932-a14c-4d3d-872b-1f73cd4e2341",
                                                "sense_id": "27f22ca0-bd4a-3891-8f55-2fc6f49562ae",
                                                "text": "„Kaum ein anderer hat sich so wie dieser Theologe und Publizist darum bemüht, den Boden abzusichern, auf dem die Deutschen nach dem Ende der Teilung stehen, seine Verwerfungen zu glätten und ihn für ihr gemeinsames Lebens zu rekultivieren.“"
                                            },
                                            {
                                                "example_id": "aa94d57a-9c1c-422f-b30b-0b2b48740912",
                                                "sense_id": "27f22ca0-bd4a-3891-8f55-2fc6f49562ae",
                                                "text": "„Daher hat die RWE Dea, Besitzer der Ölquelle, jetzt beschlossen, die ehemalige Bohrstelle zu verfüllen und die Fläche des Bohrgebietes, das in etwa die Ausmaße eines Tennisplatzes besitzt, zu rekultivieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
