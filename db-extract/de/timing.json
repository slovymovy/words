                "senses": [
                    {
                        "sense_id": "88f21f3b-57a1-3642-81c0-1c2aee3e8ffc",
                        "entry_id": "046fe25f-ac43-3c9e-8f8e-a234d158f117",
                        "glosses": [
                            "zeitliche Abstimmung, Anpassung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e8fd992-fd19-4bcc-84bb-9fe3b5f7bfc3",
                                "sense_id": "88f21f3b-57a1-3642-81c0-1c2aee3e8ffc",
                                "text": "Das Timing der Produktionsabläufe stimmte noch nicht."
                            },
                            {
                                "example_id": "aaa23b23-f7a9-489d-a6c2-a1158993bf2f",
                                "sense_id": "88f21f3b-57a1-3642-81c0-1c2aee3e8ffc",
                                "text": "„Wichtiger noch war sein Timing.“"
                            },
                            {
                                "example_id": "a49e48c9-29a1-4123-9149-b027655f9993",
                                "sense_id": "88f21f3b-57a1-3642-81c0-1c2aee3e8ffc",
                                "text": "Die Manager zeigten gutes Timing: kurz vor dem Crash trennten sich viele Vorstände von Aktien der eigenen Firma, jetzt steigen sie wieder ein."
                            },
                            {
                                "example_id": "20e2b482-3123-4c2c-a2cf-588507aaa417",
                                "sense_id": "88f21f3b-57a1-3642-81c0-1c2aee3e8ffc",
                                "text": "„Sein Timing war gut.“"
                            },
                            {
                                "example_id": "6b943bcc-bc58-43aa-bde1-e3fdc44fd0e7",
                                "sense_id": "88f21f3b-57a1-3642-81c0-1c2aee3e8ffc",
                                "text": "„Dank eines erstaunlich schlechten Timings schaffte ich es, mich noch kurz vor Antritt der Reise durch Amerika zu verlieben.“"
                            },
                            {
                                "example_id": "e4892c3d-b059-4eef-aec5-87dcba292937",
                                "sense_id": "88f21f3b-57a1-3642-81c0-1c2aee3e8ffc",
                                "text": "„Die Tasche in der Hand machte ich mich auf den Weg zur Haustür und riss sie energisch auf, einen Spruch für das schlechte Timing des Paketboten auf den Lippen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0c462cd-88a7-4a21-94c8-cb3103299344",
                        "source_entry_id": "046fe25f-ac43-3c9e-8f8e-a234d158f117",
