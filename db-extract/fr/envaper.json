                        "form": "s’envaper"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16514e56-a9f0-3049-9601-46998d71f9d9",
                        "entry_id": "83d3d1ad-8808-3588-a673-40579061fc26",
                        "glosses": [
                            "S’enivrer."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "a3e40181-eceb-4559-a6ff-700688000811",
                                "sense_id": "16514e56-a9f0-3049-9601-46998d71f9d9",
                                "text": "Débarquant dans les estaminets des ports français, les marins de la Grande Catherine disaient systématiquement «bistro, bistro !» (vite, vite!) car ils n'avaient que très peu de temps pour s’envaper avant de remonter à bord."
                            }
                        ]
                    },
                    {
                        "sense_id": "78fbdb04-ac13-3c89-ac33-71cd83658376",
                        "entry_id": "83d3d1ad-8808-3588-a673-40579061fc26",
                        "glosses": [
                            "S’enfumer."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "17e1f782-9648-478b-9b1b-c9faf444919d",
                                "sense_id": "78fbdb04-ac13-3c89-ac33-71cd83658376",
                                "text": "Depuis le soir du premier débat télévisé de la primaire, ce non fumeur de longtemps se retrouve dans ce clandé avec quelques potes pour faire glouglouter le narguilé et s'envaper les naseaux avec de la beuh de première bourre."
                            }
                        ]
                    },
                    {
                        "sense_id": "0867e1ef-9d1e-3392-9614-1b70c903fdf1",
                        "entry_id": "83d3d1ad-8808-3588-a673-40579061fc26",
                        "glosses": [
                            "Enfumer, manipuler psychologiquement dans un but précis."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f8b9f95c-49ff-431e-8414-47d4cacd09b6",
                                "sense_id": "0867e1ef-9d1e-3392-9614-1b70c903fdf1",
                                "text": "Il commençait par envaper Béru pour le faire avouer car il fallait que vous fussiez absolument convaincu de notre culpabilité."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0c0ca80-5c69-3c3b-9c92-c16a3b3516c7",
                        "entry_id": "83d3d1ad-8808-3588-a673-40579061fc26",
                        "glosses": [
                            "Endormir."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2c030c45-df3f-41ac-925b-22396d6f8a82",
                                "sense_id": "d0c0ca80-5c69-3c3b-9c92-c16a3b3516c7",
                                "text": "Je suppose que s’ils ont voulu m’envaper c’est parce qu’ils préparent un coup pour dans un peu de temps."
                            }
                        ]
                    }
                ],
