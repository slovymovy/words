                "senses": [
                    {
                        "sense_id": "eb5f7ef3-2833-37f1-b732-b6eb53282032",
                        "entry_id": "575c6e17-7570-32fe-b9f1-f7c20351bf14",
                        "glosses": [
                            "Piloter en agissant sur les commandes moins que ce qui est habituel et normal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b1c5501-cdda-4002-b2bc-ed8c9126eafd",
                                "sense_id": "eb5f7ef3-2833-37f1-b732-b6eb53282032",
                                "text": "Comme je disais, j'ai vraiment eu l'impression de plutôt sous-piloter que sur-piloter."
                            },
                            {
                                "example_id": "294ef540-86c1-49c4-8a72-49401c16aa64",
                                "sense_id": "eb5f7ef3-2833-37f1-b732-b6eb53282032",
                                "text": "Après, on est bien d'accord, il n'y a pas de recette miracle, mais en général, il vaut mieux sous-piloter que sur-piloter !"
                            },
                            {
                                "example_id": "c1fb1425-6cb0-4786-b9eb-8b88d6c89da4",
                                "sense_id": "eb5f7ef3-2833-37f1-b732-b6eb53282032",
                                "text": "Il vaut mieux la sous-piloter de toute façon que le contraire."
                            }
                        ]
                    }
