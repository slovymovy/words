                                "target_senses": [
                                    {
                                        "sense_id": "f191f2f4-1171-3eeb-88aa-cc723dd92610",
                                        "entry_id": "07e5ec7a-d40f-307c-9256-99d37bae4e12",
                                        "glosses": [
                                            "iemand die een machine bestuurt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba4de32e-9903-4f7a-8bdb-4a027b89eb0a",
                                                "sense_id": "f191f2f4-1171-3eeb-88aa-cc723dd92610",
                                                "text": "De bedienaar van de brug is vervangen door een geautomatiseerd computersysteem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "241b7dd2-c2ee-3b1d-a3d5-abf93a46059f",
                                        "entry_id": "07e5ec7a-d40f-307c-9256-99d37bae4e12",
                                        "glosses": [
                                            "geestelijke in een geloof zoals bijvoorbeeld een dominee of priester"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "566ff9e5-076d-40f4-9c5b-70869eed695b",
                                                "sense_id": "241b7dd2-c2ee-3b1d-a3d5-abf93a46059f",
                                                "text": "Hetgeen gebeurd is valt zeer te betreuren maar we mogen niet vergeten dat geloven mensenwerk is en dat ook de bedienaars van het geloof fouten kunnen maken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
