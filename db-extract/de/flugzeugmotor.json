                ],
                "senses": [
                    {
                        "sense_id": "68f6fde5-c520-350a-ac11-d053f8742ddb",
                        "entry_id": "f9268bad-41f9-38e6-854f-f37aa7cff150",
                        "glosses": [
                            "Motor, der für den Antrieb eines Flugzeugs verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2339351e-e538-4614-b487-3c69e8fc05e8",
                                "sense_id": "68f6fde5-c520-350a-ac11-d053f8742ddb",
                                "text": "„Am Donnerstag wurde in Gunskirchen ein neuer Flugzeugmotor präsentiert, der in Fachkreisen Aufsehen erregt.“"
                            },
                            {
                                "example_id": "c43b3451-e50a-47ba-a02b-ca43d7f65207",
                                "sense_id": "68f6fde5-c520-350a-ac11-d053f8742ddb",
                                "text": "„Nur gelegentlich übertönt das Stakkato von Flugzeugmotoren die Feier: Äthiopische Tiefflieger kreisen über der Kathedrale, zu Ehren des größten Flugzeugfans des Landes.“"
                            },
                            {
                                "example_id": "7c7bf8a4-ddb2-4990-afb6-c03d0b9591ce",
                                "sense_id": "68f6fde5-c520-350a-ac11-d053f8742ddb",
                                "text": "„Indessen heulen die Sirenen nicht nur bei Nacht, sondern immer häufiger schon am Tage; die Luft vibriert von den Flugzeugmotoren, vom Feuer der Flak und vom Einschlag der Bomben.“"
                            },
                            {
                                "example_id": "f3d992b1-35b2-4382-ae6b-1f0d6dd699db",
                                "sense_id": "68f6fde5-c520-350a-ac11-d053f8742ddb",
                                "text": "„Von fern kam das Summen von Flugzeugmotoren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
