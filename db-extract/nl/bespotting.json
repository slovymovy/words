                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ridicule",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "049061f5-5f83-3ce0-a9fb-b48fd87b49d6",
                                        "entry_id": "28df4ad0-1091-3bd5-af20-ffe8870f8304",
                                        "glosses": [
                                            "To criticize or disapprove of someone or something through scornful jocularity; to make fun of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc266c04-bc54-4689-9fea-dea177a96e94",
                                                "sense_id": "049061f5-5f83-3ce0-a9fb-b48fd87b49d6",
                                                "text": "His older sibling constantly ridiculed him with sarcastic remarks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ridicule",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6950807-a90e-3621-bf8f-6b4cdd91f079",
                                        "entry_id": "362abcb8-b48e-37d2-8cfe-fa43638e2786",
                                        "glosses": [
                                            "Derision; mocking or humiliating words or behavior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1efcd616-ce29-4310-9e76-b017d405adb3",
                                                "sense_id": "d6950807-a90e-3621-bf8f-6b4cdd91f079",
                                                "text": "Safe from the Bar, the Pulpit, and the Throne, / Yet touch'd and sham'd by Ridicule alone."
                                            },
                                            {
                                                "example_id": "4a94583b-5428-4175-8349-55243f0e950f",
                                                "sense_id": "d6950807-a90e-3621-bf8f-6b4cdd91f079",
                                                "text": "When he was young you'd not find him doing well in school,\nHis mind would turn unto the waters.\nAlways the focus of adolescent ridicule,\nHe has no time for farmer's daughters.\nAlienated from the clique society,\nA lonely boy finds peace in fishing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "385611c9-0567-3b11-8fb5-d687fd72d5e0",
                                        "entry_id": "362abcb8-b48e-37d2-8cfe-fa43638e2786",
                                        "glosses": [
                                            "An object of sport or laughter; a laughing stock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baeb650d-0194-4733-b6d6-724ee7f04a2d",
                                                "sense_id": "385611c9-0567-3b11-8fb5-d687fd72d5e0",
                                                "text": "[Marlborough] was so miserably ignorant, that his deficiencies made him the ridicule of his contemporaries."
                                            },
                                            {
                                                "example_id": "7507228a-75eb-45b5-9134-957a0c3a3309",
                                                "sense_id": "385611c9-0567-3b11-8fb5-d687fd72d5e0",
                                                "text": "To the people […] but a trifle, to the king but a ridicule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d38bc52-fff7-3c07-b7b1-2a2a486fde8c",
                                        "entry_id": "362abcb8-b48e-37d2-8cfe-fa43638e2786",
                                        "glosses": [
                                            "The quality of being ridiculous; ridiculousness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbfcdc9c-8086-4424-96a2-2f10caddbd3a",
                                                "sense_id": "5d38bc52-fff7-3c07-b7b1-2a2a486fde8c",
                                                "text": "to see the ridicule of this monstrous practice"
                                            },
                                            {
                                                "example_id": "da56acbd-4ea2-4024-bf1d-ce4256c1d959",
                                                "sense_id": "5d38bc52-fff7-3c07-b7b1-2a2a486fde8c",
                                                "text": "More keenly alive perhaps than any of her sisters to the little ridicules that belonged to Mrs. Palmer's character, she yet saw how small was their importance, and that Mrs. Palmer was not only a better but a happier person than most of those with whom she was acquainted."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ridicule",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71881fa9-8b55-370a-a6ce-7268e2bcb22b",
                                        "entry_id": "4adbab0f-37a0-3456-939d-8e816fe116c2",
                                        "glosses": [
                                            "ridiculous"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9271cf85-10c4-485c-94f7-7da66f684784",
                                                "sense_id": "71881fa9-8b55-370a-a6ce-7268e2bcb22b",
                                                "text": "late 17th century, John Aubrey, Brief Lives\nThis action […] became so ridicule."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ridicule",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b501afd-7146-3d88-b504-c74f6947b536",
                                        "entry_id": "ddfbffbb-e6d8-36df-8484-e42e2f208a17",
                                        "glosses": [
                                            "A small woman's handbag; a reticule."
                                        ],
                                        "tags": [
                                            "historical",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a90d4e90-5449-4014-8bc8-e33a28633f61",
                                                "sense_id": "5b501afd-7146-3d88-b504-c74f6947b536",
                                                "text": "[…] while paying her own compliments to Mrs. Bates, and appearing to attend to the good old lady’s replies, she saw her with a sort of anxious parade of mystery fold up a letter which she had apparently been reading aloud to Miss Fairfax, and return it into the purple and gold ridicule by her side, […]"
                                            },
                                            {
                                                "example_id": "864c67dd-3c08-4a11-a71c-34c1a233300e",
                                                "sense_id": "5b501afd-7146-3d88-b504-c74f6947b536",
                                                "text": "I hastily drew my empty hand from my Ridicule."
                                            },
                                            {
                                                "example_id": "606b879c-df5e-4a5d-8a9a-8bea566f0f93",
                                                "sense_id": "5b501afd-7146-3d88-b504-c74f6947b536",
                                                "text": "“Tills be blowed!” said Mr. Claypole; “there’s more things besides tills to be emptied.” “What do you mean?” asked his companion. “Pockets, women’s ridicules, houses, mailcoaches, banks,” said Mr. Claypole, rising with the porter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e02d196-cf38-487f-b003-c930847db395",
                        "source_entry_id": "92262a60-c24f-3822-9296-415d48b195af",
                        "source_sense_id": "39ca896a-7a37-3ea3-a3da-48cd3724dbbb",
                        "source_sense_description": "het iemand belachelijk maken",
                        "target_lang_word": "irony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e1efacb-27d2-37b2-a6aa-98be5437693e",
                                        "entry_id": "b9db7755-5c43-39c1-a84b-bf82e37babf5",
                                        "glosses": [
                                            "The quality of a statement that, when taken in context, may actually mean something different from, or the opposite of, what is written literally; the use of words expressing something other than their literal intention, often in a humorous context."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6998bb7-0de8-4a76-b500-af8a686372e2",
                                                "sense_id": "5e1efacb-27d2-37b2-a6aa-98be5437693e",
                                                "text": "Irony, saying what it ne'er intends,\nCensures with praise, and speaks to foes as friends."
                                            },
                                            {
                                                "example_id": "a9cb1998-5e79-4fd3-aa8b-9a68e96e2b2f",
                                                "sense_id": "5e1efacb-27d2-37b2-a6aa-98be5437693e",
                                                "text": "A principal virtue of Rorty's recognition of both the lightminded and the serious side of irony is to urge us in that direction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c17c2a7f-21dc-34d1-905e-bad79a13945f",
                                        "entry_id": "b9db7755-5c43-39c1-a84b-bf82e37babf5",
                                        "glosses": [
                                            "The quality of a statement that, when taken in context, may actually mean something different from, or the opposite of, what is written literally; the use of words expressing something other than their literal intention, often in a humorous context.",
                                            "An ironic statement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce9621ba-e13c-4eac-9bea-878ec6a8b64a",
                                                "sense_id": "c17c2a7f-21dc-34d1-905e-bad79a13945f",
                                                "text": "It is one of the ironies of capital cities that each acts as a symbol of its nation, and yet few are even remotely representative of it. London has always set itself apart from the rest of Britain — but political, economic and social trends are conspiring to drive that wedge deeper."
                                            },
                                            {
                                                "example_id": "f7e8b25d-c62d-41f2-a0a8-c5c23b915293",
                                                "sense_id": "c17c2a7f-21dc-34d1-905e-bad79a13945f",
                                                "text": "The second irony is that the only American who intuitively or otherwise grasps this reality and possesses a large enough ego potentially capable of governing in these circumstances is the president."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e6226bc-3a5f-308f-91a9-6c8e66b31f8c",
                                        "entry_id": "b9db7755-5c43-39c1-a84b-bf82e37babf5",
                                        "glosses": [
                                            "Dramatic irony: a theatrical effect in which the meaning of a situation, or some incongruity in the plot, is understood by the audience, but not by the characters in the play."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbdd0a07-bb3e-302c-abc5-2b2fe3533982",
                                        "entry_id": "b9db7755-5c43-39c1-a84b-bf82e37babf5",
                                        "glosses": [
                                            "Socratic irony: ignorance feigned for the purpose of confounding or provoking an antagonist."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14306e07-2652-3f53-a401-74f35277765a",
                                        "entry_id": "b9db7755-5c43-39c1-a84b-bf82e37babf5",
                                        "glosses": [
                                            "Contradiction between circumstances and expectations; condition contrary to what might be expected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "irony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f3506c4-cb4e-3cfa-b425-8baf39154f17",
                                        "entry_id": "ac8b4d32-dd7d-3a9e-83df-225a845e9d4a",
                                        "glosses": [
                                            "Of or pertaining to the metal iron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e4c2b61-cc14-43fe-aad6-a23bb1b521e7",
                                                "sense_id": "7f3506c4-cb4e-3cfa-b425-8baf39154f17",
                                                "text": "The food had an irony taste to it."
                                            },
                                            {
                                                "example_id": "44d3a61d-58ea-421d-ac11-54f514ce8700",
                                                "sense_id": "7f3506c4-cb4e-3cfa-b425-8baf39154f17",
                                                "text": "The scrap yard had bins marked for irony aluminum, such as aluminum engine blocks not wholly cleaned of bolts, studs, brackets, and so on."
                                            },
                                            {
                                                "example_id": "c0b06e2c-e9c6-4816-8140-19caede3cbcc",
                                                "sense_id": "7f3506c4-cb4e-3cfa-b425-8baf39154f17",
                                                "text": "Thus in Cornwall, and many parts of Germany and France, in mineral districts, an irony appearance of a vein, where seen at the crop, is regarded as favourable."
                                            },
                                            {
                                                "example_id": "e8272ff7-efd7-409c-ae0a-2b948ca76dca",
                                                "sense_id": "7f3506c4-cb4e-3cfa-b425-8baf39154f17",
                                                "text": "E. W. Baker, Main St. - No odor, good appearance, slight irony taste; pressure weak. But water which had stood in wash pitcher some three or four days showed pronounced odor."
                                            },
                                            {
                                                "example_id": "fead968c-948c-4c79-b8e5-126c13ced03e",
                                                "sense_id": "7f3506c4-cb4e-3cfa-b425-8baf39154f17",
                                                "text": "There can be no doubt that persistent biking robs the female limb of its graceful contour and substitutes therefore the rugged protrusive muscles, the ungainly and irony look of the masculine leg."
                                            },
                                            {
                                                "example_id": "23304d30-6292-43ea-88ed-56220eeb98ef",
                                                "sense_id": "7f3506c4-cb4e-3cfa-b425-8baf39154f17",
                                                "text": "It [overgrazing] eventually causes a particularly hard irony surface to the soil which is perfectly unmistakable once you have seen it , and also certain weeds which are also unmistakable once you have seen them."
                                            },
                                            {
                                                "example_id": "af58a486-3634-460b-8e31-b5dc93d86308",
                                                "sense_id": "7f3506c4-cb4e-3cfa-b425-8baf39154f17",
                                                "text": "Raspberries raw, stewing, jamming, pulping, take over my house during July, overlaying the richer, more irony smell of the blackcurrant – a contralto to a soprano."
                                            },
                                            {
                                                "example_id": "706b4ebf-ae28-4ea0-be4e-8342261f7f79",
                                                "sense_id": "7f3506c4-cb4e-3cfa-b425-8baf39154f17",
                                                "text": "There was nothing left, besides just the pile of files on my desk, and the irony look on Catherine's face."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "irony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "457d0e92-9d3c-3cf6-99c1-dd251165e02b",
