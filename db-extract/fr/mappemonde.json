        "fr-extract.jsonl": [
            {
                "entry_id": "7c2ce238-620e-3fd1-93c7-15adca3898ba",
                "word": "mappemonde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "eec8e0f7-1596-48a6-9669-f4cb2a871c9e",
                        "entry_id": "7c2ce238-620e-3fd1-93c7-15adca3898ba",
                        "tags": [
                            "plural"
                        ],
                        "form": "mappemondes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69ebdf33-3f26-3bda-baf2-ae2ecb503a35",
                        "entry_id": "7c2ce238-620e-3fd1-93c7-15adca3898ba",
                        "glosses": [
                            "Représentation cartographique plane de toutes les parties du globe terrestre divisé en deux hémisphères circonscrits chacun dans un grand cercle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b8b4222-0f06-403e-ae78-32fbb6ba6009",
                                "sense_id": "69ebdf33-3f26-3bda-baf2-ae2ecb503a35",
                                "text": "Elle prit, chez le libraire de la ville, une mappemonde qu’elle cloua près de son miroir, afin de suivre son cousin dans sa route vers les Indes."
                            },
                            {
                                "example_id": "44737a49-d17a-47df-a9b7-39fde1f9981a",
                                "sense_id": "69ebdf33-3f26-3bda-baf2-ae2ecb503a35",
                                "text": "Joignez encore un vieux bureau criblé d’encre et de coups de canif, une fort belle mappemonde datant d’un demi-siècle, et sur laquelle étaient tracés à la main de chimériques itinéraires à travers toutes les parties du monde."
                            },
                            {
                                "example_id": "e6dbc3c8-bb07-4ca0-bd2c-0facd07ca4b9",
                                "sense_id": "69ebdf33-3f26-3bda-baf2-ae2ecb503a35",
                                "text": "C’est Boukharine, président de l’Internationale Communiste. On évoque à partir de lui une hiérarchie organisée aux innombrables prolongements internationaux : […], et tout un système de rouages et d’hommes qui plonge dans les masses profondes de la mappemonde."
                            },
                            {
                                "example_id": "6fb19d3d-5267-4ab4-987d-ad3ec8496b9b",
                                "sense_id": "69ebdf33-3f26-3bda-baf2-ae2ecb503a35",
                                "text": "Mme Piccard m’acheta une mappemonde pour que je pusse fixer sans risque d’erreur l’itinéraire de mes globe-trotters."
                            },
                            {
                                "example_id": "8f6b2b11-0288-4dc0-9631-d21e0d92f729",
                                "sense_id": "69ebdf33-3f26-3bda-baf2-ae2ecb503a35",
                                "text": "Pourtant, mercredi 26 mars, certains de ses membres se sont offusqués d’une modification cartographique repérée sur la mappemonde en question"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc0ad753-f5b8-48d5-991f-5db8d57c0452",
                        "source_entry_id": "7c2ce238-620e-3fd1-93c7-15adca3898ba",
                        "source_sense_id": "69ebdf33-3f26-3bda-baf2-ae2ecb503a35",
                        "source_sense_description": "Carte divisant la Terre en deux hémisphères cerclés",
                        "target_lang_word": "Weltkarte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weltkarte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e307295-649c-347d-af78-1f29ee761847",
                                        "entry_id": "0875127e-e0b1-3d2d-9f38-2666f859d27f",
                                        "glosses": [
                                            "eine Landkarte, die die gesamte Erdoberfläche abbildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bed5aa7-4548-4c57-9e1f-e6f875db2f2f",
                                                "sense_id": "3e307295-649c-347d-af78-1f29ee761847",
                                                "text": "„Auf der Ulmer Weltkarte entspringen hier gemäß Ptolemaios mehrere kleine Flüsse, die nordwärts in zwei auf demselben Breitengrad liegende Seen fließen.“"
                                            },
                                            {
                                                "example_id": "485cd6d9-bf58-4527-a29b-a37ddeafd0f2",
                                                "sense_id": "3e307295-649c-347d-af78-1f29ee761847",
                                                "text": "„Auf dem Nachrichtensender war jetzt der Wettermann wieder aktiv, der breitbeinig vor einer Weltkarte stand und vertrauenerweckende Handbewegungen machte.“"
                                            },
                                            {
                                                "example_id": "76a39c5b-29bb-470b-9c8f-7ce3cdfa3170",
                                                "sense_id": "3e307295-649c-347d-af78-1f29ee761847",
                                                "text": "„Eine riesige Weltkarte im Marmorboden des Bürgersaals unterstrich das Selbstbewusstsein der Niederländer.“"
                                            },
                                            {
                                                "example_id": "a87c3705-b6cb-40e1-a464-bb8b103cb3b4",
                                                "sense_id": "3e307295-649c-347d-af78-1f29ee761847",
                                                "text": "„Die Weltkarte war in der DDR klar gegliedert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0138299b-2a37-4723-a01c-ceec48e17b25",
                        "source_entry_id": "7c2ce238-620e-3fd1-93c7-15adca3898ba",
