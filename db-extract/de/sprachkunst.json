                ],
                "senses": [
                    {
                        "sense_id": "e038cd66-8f00-3e74-bc2b-e702c118a1bc",
                        "entry_id": "38b115a5-0eed-3fc4-b104-b409dc9f4948",
                        "glosses": [
                            "kunstvolle sprachliche Ausdrucksweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50da0b20-68cb-44ad-960a-b58929f2810c",
                                "sense_id": "e038cd66-8f00-3e74-bc2b-e702c118a1bc",
                                "text": "„Einer Mundart kann man unterstellen, sie sei politisch unkorrekt - oder man kann sie als höhere Sprachkunst bewundern, denn was Witz, Poesie und Lautmalerei angeht, kann Hochdeutsch mit einer Mundart nicht mithalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5b6ad503-412e-31a6-8e89-e7e2501f6613",
                        "entry_id": "38b115a5-0eed-3fc4-b104-b409dc9f4948",
                        "glosses": [
                            "ehemals verbreitete Bezeichnung für Grammatik"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "8ee04d06-8d69-43d4-86d3-f46445c91625",
                                "sense_id": "5b6ad503-412e-31a6-8e89-e7e2501f6613",
                                "text": "„Für Gottsched und seine Zeit gehörte zur Einheit von Poetik und Rhetorik noch ein Drittes, nämlich die Grammatik oder, wie man seit Schottel gern sagte, die »Sprachkunst«.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
