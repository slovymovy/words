                    {
                        "sense_id": "dd610e10-6b30-31d6-9150-d185c899936c",
                        "entry_id": "36bcbc67-8f34-3786-a588-6373f2e4eaec",
                        "glosses": [
                            "förmlicher Zusatz-, Abänderungs-, Berichtigungs- oder Novellierungsvorschlag zu einem Gesetz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c6e245-aa02-4ecf-a3ca-54c8ffbc4455",
                                "sense_id": "dd610e10-6b30-31d6-9150-d185c899936c",
                                "text": "„Auf die Frage des Präsidenten Simson erklärte sich Fischer (Augsburg) einverstanden, daß über sein Amendement und ein Sous-Amendement zu demselben getrennt abgestimmt werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "beac9c3c-b205-49a6-8341-6ed5a396c158",
                        "source_entry_id": "36bcbc67-8f34-3786-a588-6373f2e4eaec",
                        "source_sense_id": "dd610e10-6b30-31d6-9150-d185c899936c",
                        "source_sense_description": "förmlicher Zusatz-, Abänderungs-, Berichtigungs- oder Novellierungsvorschlag zu einem Gesetz",
                        "target_lang_word": "amendment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amendment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03b109ea-88c6-34b2-98bd-0b2658ba69eb",
                                        "entry_id": "79ad40fa-b891-3e7a-912d-ede27d0d8010",
                                        "glosses": [
                                            "An alteration or change for the better; correction of a fault or of faults; reformation of life by quitting vices."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b81464c-1e83-398a-aa3f-ab1a5200cccd",
                                        "entry_id": "79ad40fa-b891-3e7a-912d-ede27d0d8010",
                                        "glosses": [
                                            "In public bodies, any alteration made or proposed to be made in a bill or motion that adds, changes, substitutes, or omits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35e6202b-8361-496b-9437-e548965c9075",
                                                "sense_id": "2b81464c-1e83-398a-aa3f-ab1a5200cccd",
                                                "text": "Arrests and prosecutions intensified after Isis captured Mosul in June, but the groundwork had been laid by an earlier amendment to Jordan’s anti-terrorism law."
                                            },
                                            {
                                                "example_id": "369a6ed8-ff88-4b4f-b238-eb50866836fd",
                                                "sense_id": "2b81464c-1e83-398a-aa3f-ab1a5200cccd",
                                                "text": "Almost half of MEPs wanted to remove the new provisions to expand the use of megatrucks but an amendment to do that failed to pass by just six votes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfa95918-8342-3813-aed2-415352b830ed",
                                        "entry_id": "79ad40fa-b891-3e7a-912d-ede27d0d8010",
                                        "glosses": [
                                            "Correction of an error in a writ or process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cb55495-e05d-320a-a409-40c5862f3f5d",
                                        "entry_id": "79ad40fa-b891-3e7a-912d-ede27d0d8010",
                                        "glosses": [
                                            "An addition to and/or alteration to the Constitution."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "398ad999-c960-4e7d-b872-eb4413595b3b",
                                                "sense_id": "0cb55495-e05d-320a-a409-40c5862f3f5d",
                                                "text": "The First Amendment guarantees freedom of religion, speech, press, assembly, and petition."
                                            },
                                            {
                                                "example_id": "c93b0263-ca77-4d39-9f79-282412974450",
                                                "sense_id": "0cb55495-e05d-320a-a409-40c5862f3f5d",
                                                "text": "The Thirteenth Amendment to the United States Constitution abolished slavery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61c9e827-fc1d-3680-b1d5-cd16b8169936",
                                        "entry_id": "79ad40fa-b891-3e7a-912d-ede27d0d8010",
                                        "glosses": [
                                            "That which is added; that which is used to increase or supplement something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f753a5-b1ce-4f02-9738-75f40c390e3f",
                                                "sense_id": "61c9e827-fc1d-3680-b1d5-cd16b8169936",
                                                "text": "a soil amendment"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58ba439c-b0ba-483f-a0c2-fa7d949fd4be",
                        "source_entry_id": "36bcbc67-8f34-3786-a588-6373f2e4eaec",
                        "source_sense_id": "dd610e10-6b30-31d6-9150-d185c899936c",
                        "source_sense_description": "förmlicher Zusatz-, Abänderungs-, Berichtigungs- oder Novellierungsvorschlag zu einem Gesetz",
                        "target_lang_word": "amendement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amendement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cae7a8d4-a7c2-3477-a11e-cf24868c4b34",
                                        "entry_id": "f46402c4-6c45-3108-a31d-b3035c9b82db",
                                        "glosses": [
                                            "Action d’amender et résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0a03943-5bf5-45db-afa6-5a97fbef6490",
                                                "sense_id": "cae7a8d4-a7c2-3477-a11e-cf24868c4b34",
                                                "text": "Ces homologations ont été prononcées en application du règlement 100 dans sa série 02 d’ amendement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6049ed77-6662-3c72-892a-f5607bcdd6d7",
                                        "entry_id": "f46402c4-6c45-3108-a31d-b3035c9b82db",
                                        "glosses": [
                                            "Fait d'amender ou de s'amender dans le sens où apparaît une résipiscence, une amélioration, un mieux."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "906178f8-da08-3442-a11e-275bfda16148",
                                        "entry_id": "f46402c4-6c45-3108-a31d-b3035c9b82db",
                                        "glosses": [
                                            "Diminution de l'intensité des symptômes d’une maladie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa666855-f7db-33ea-9a0d-747cbe5585ca",
                                        "entry_id": "f46402c4-6c45-3108-a31d-b3035c9b82db",
                                        "glosses": [
                                            "Opération visant à améliorer les propriétés physiques et chimiques d’un sol."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0017d19a-a147-4bfc-8874-8749fdcbfb24",
                                                "sense_id": "aa666855-f7db-33ea-9a0d-747cbe5585ca",
                                                "text": "L'affleurement de la marne inférieure est nettement prononcé dans toute cette région. Cette marne est exploitée pour l’amendement des terres, à Terron-les-Vendresse, Poix, etc."
                                            },
                                            {
                                                "example_id": "efdd8df1-921f-412f-b65f-670cc4377603",
                                                "sense_id": "aa666855-f7db-33ea-9a0d-747cbe5585ca",
                                                "text": "Sans cesse retournée, ameublie, sollicitée, stimulée, enrichie par les amendements les plus compliqués, cette terre roscovite ne cesse jamais de produire et il est des parcelles auxquelles on fait rendre trois ou quatre récoltes diverses en une année."
                                            },
                                            {
                                                "example_id": "bc3e3277-2b2e-422b-a142-55530eb17af2",
                                                "sense_id": "aa666855-f7db-33ea-9a0d-747cbe5585ca",
                                                "text": "Cependant, la surcapitalisation des peuplements pendant des décennies a favorisé la désaturation des sols les plus acides. Pour y remédier et pour restaurer la fertilité de ces sols ainsi que la vigueur des peuplements qui y croissent, les amendements calco-magnésiens sont recommandés […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba3393e6-5e70-32c8-8b01-f7bfddfb8658",
                                        "entry_id": "f46402c4-6c45-3108-a31d-b3035c9b82db",
                                        "glosses": [
                                            "Produit épandu sur le sol pour provoquer cette amélioration."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12c0b044-f0ac-4ddb-a47a-a5f417774855",
                                                "sense_id": "ba3393e6-5e70-32c8-8b01-f7bfddfb8658",
                                                "text": "D'après les estimations des professionnels, environ 3 millions de tonnes de composts contenant du déchet vert sont produites annuellement en France pour servir d’amendements organiques en espaces verts, dans les jardins et en agriculture."
                                            },
                                            {
                                                "example_id": "1bb4c88d-6380-4e76-bc4a-3b1d140f3b44",
                                                "sense_id": "ba3393e6-5e70-32c8-8b01-f7bfddfb8658",
                                                "text": "En plus d’un amendement, le fumier joue un rôle d’engrais. Si l’effet azoté est limité, la paille et les déchets végétaux qu’il contient offrent des teneurs en potassium non négligeables, identiques à un engrais du commerce."
                                            },
                                            {
                                                "example_id": "fd88bee0-9a25-407c-b7bb-78b0db9c2c4d",
                                                "sense_id": "ba3393e6-5e70-32c8-8b01-f7bfddfb8658",
                                                "text": "Le biochar, charbon produit par pyrolyse et utilisé comme amendement, présente plusieurs avantages et s’avère une avenue prometteuse pour une agriculture durable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca5ffe2b-c54d-3bf5-8aa7-23eba9c3f847",
                                        "entry_id": "f46402c4-6c45-3108-a31d-b3035c9b82db",
                                        "glosses": [
                                            "Texte modifiant un précédent texte de nature juridique."
                                        ],
                                        "tags": [
                                            "Législation"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c35d9cd-7314-36e7-a4c3-75f8e969e82e",
                                        "entry_id": "f46402c4-6c45-3108-a31d-b3035c9b82db",
                                        "glosses": [
                                            "Texte modifiant un précédent texte de nature juridique.",
                                            "En particulier, Modification faite à un projet de loi, d’arrêté, pour changer quelqu’une de ses dispositions, ou seulement pour lui donner plus de clarté, plus de précision."
                                        ],
                                        "tags": [
                                            "Législation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b1b43ce-ed08-4b56-bf2a-f959e0c56501",
                                                "sense_id": "5c35d9cd-7314-36e7-a4c3-75f8e969e82e",
                                                "text": "Par suite de l'amendement Riancey à la loi sur la presse, il était défendu aux journaux d'insérer ce que l'Assemblée s'est plue ^([sic]) à appeler le \"feuilleton-roman\"."
                                            },
                                            {
                                                "example_id": "b8f613b2-1894-4363-9442-d5fcc236dc36",
                                                "sense_id": "5c35d9cd-7314-36e7-a4c3-75f8e969e82e",
                                                "text": "Lors de l'examen du projet de loi d’orientation sur l'énergie, les députés ont voté en première lecture un amendement du rapporteur Serge Poignant (UMP), co-signé par Patrick Ollier (UMP), affirmant que la procédure actuelle de délivrance des permis est “lourde et est perçue comme entravante”."
                                            },
                                            {
                                                "example_id": "b2f46011-2817-4faf-ad25-b9031c14dd95",
                                                "sense_id": "5c35d9cd-7314-36e7-a4c3-75f8e969e82e",
                                                "text": "Dans la majorité, par exemple, vous déposez moins d’amendements que dans l’opposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39a61d7f-4dd2-3817-819c-ffe3a4fcc037",
                                        "entry_id": "f46402c4-6c45-3108-a31d-b3035c9b82db",
                                        "glosses": [
                                            "Texte modifiant un précédent texte de nature juridique.",
                                            "En particulier, texte juridique séparé complétant un texte juridique antérieur, à l'image des amendements de la constitution des États-Unis."
                                        ],
                                        "tags": [
                                            "Législation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ed1dba3-e306-47b0-b8e6-fd604e2b8e80",
                                                "sense_id": "39a61d7f-4dd2-3817-819c-ffe3a4fcc037",
                                                "text": "Cette semaine, un reporter d’ AP avait été privé d’accéder à la conférence de presse entre Donald Trump et le premier ministre indien, Narendra Modi, « une violation flagrante du premier amendement », avait déjà déclaré Julie Pace, la rédactrice en chef de l’agence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60d7e537-fa3c-3613-af9e-184a32706c6b",
                                        "entry_id": "f46402c4-6c45-3108-a31d-b3035c9b82db",
                                        "glosses": [
                                            "Modification d’un jugement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
