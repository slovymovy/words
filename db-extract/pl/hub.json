                                        "sense_id": "b7367f45-5976-365d-ae83-d22d0b4de335",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "The central part, usually cylindrical, of a wheel; the nave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e801a296-3ef9-4883-9937-250450d57f1e",
                                                "sense_id": "b7367f45-5976-365d-ae83-d22d0b4de335",
                                                "text": "If you need to reload film, the cassette can be rewound slightly by turning the hub located on one end of its spool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2cb5fa2-78ac-36af-8f62-ed5d3294e3e2",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "A point where many routes meet and traffic is distributed, dispensed, or diverted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55a88c1-cd15-4ca1-83fa-bb51e9c96252",
                                                "sense_id": "a2cb5fa2-78ac-36af-8f62-ed5d3294e3e2",
                                                "text": "Hong Kong International Airport is one of the most important air traffic hubs in Asia."
                                            },
                                            {
                                                "example_id": "8ea1f5b7-e066-49f7-802a-c9f56c3692c8",
                                                "sense_id": "a2cb5fa2-78ac-36af-8f62-ed5d3294e3e2",
                                                "text": "From the ground, Colombo's port does not look like much.[…] But viewed from high up in one of the growing number of skyscrapers in Sri Lanka's capital, it is clear that something extraordinary is happening: China is creating a shipping hub just 200 miles from India's southern tip."
                                            },
                                            {
                                                "example_id": "e90ad575-9772-484d-8768-0835c79e81fa",
                                                "sense_id": "a2cb5fa2-78ac-36af-8f62-ed5d3294e3e2",
                                                "text": "Doncaster is a rail hub in every sense. Passenger lines radiate in six directions, there are freight lines that bypass the station, extensive freight yards, a major works, and a rolling stock depot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2fe770b-3123-3ef7-b7d7-619bda6025e4",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "A central facility providing a range of related services, such as a medical hub or an educational hub."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2206c85-85b3-3a61-838b-7d98e37c197d",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "A computer networking device connecting several Ethernet ports. See switch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea54190b-aa13-3f2e-a64a-da5c800307c7",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "A stake with a nail in it, used to mark a temporary point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8aedd248-8228-3b66-9c8e-24533bebca15",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "A male weasel; a buck; a dog; a jack."
                                        ],
