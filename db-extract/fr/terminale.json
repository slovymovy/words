                        "entry_id": "264f857e-82d5-3230-9d7e-d4ff51b7b519",
                        "glosses": [
                            "Dernière classe du lycée, après la première, pour les enfants de 17-18 ans."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "beb77029-084f-41fa-9aa7-7e5b58dcf467",
                                "sense_id": "d3c20a62-42d3-3682-b6bd-98bd58d32cfe",
                                "text": "Quels bouffons ! Les garçons de terminale que j’ai connus lors de soirées ne me parlent plus dans l’enceinte du lycée parce que je ne suis qu’une première…"
                            },
                            {
                                "example_id": "d98f4c09-0282-4cc6-9728-8edf907a2a69",
                                "sense_id": "d3c20a62-42d3-3682-b6bd-98bd58d32cfe",
                                "text": "Sami, 19 ans, en terminale, veut devenir éducateur spécialisé."
                            }
                        ]
                    }
                ],
