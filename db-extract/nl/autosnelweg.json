                    }
                ],
                "senses": [
                    {
                        "sense_id": "493d80ef-db5c-3ce4-9a43-a846d1c739cd",
                        "entry_id": "72334875-01e2-3afa-aab1-932bd6d777de",
                        "glosses": [
                            "weg voor snelverkeer (dat sneller kan en mag rijden dan 60 km per uur), met gescheiden rijbanen, een middenberm en ongelijkvloerse kruisingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f47e3c26-b6db-4f51-8ca3-14e3ccf426b3",
                                "sense_id": "493d80ef-db5c-3ce4-9a43-a846d1c739cd",
                                "text": "De minister van Infrastructuur en Milieu wil op meer wegvakken van autosnelwegen de maximum snelheid verhogen naar 130 km per uur. Zie de A2 tussen Amsterdam en Utrecht, waar vanaf volgend jaar automobilisten ook overdag 130 km per uur mogen rijden. Daarmee benadeelt de minister veel weggebruikers."
                            },
                            {
                                "example_id": "283b48d1-995b-4ffc-a837-0087a41763f9",
                                "sense_id": "493d80ef-db5c-3ce4-9a43-a846d1c739cd",
                                "text": "Al decennia voor 1955 waren Nederlandse autobezitters bekend met het fenomeen file. Er is indirect bewijs dat er op 29 mei 1955 voor het eerst een file stond op een knooppunt voor autosnelwegen, maar dat is dus zeker niet de eerste file."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcb39515-3db4-4b0d-83d1-b628040922d3",
                        "source_entry_id": "72334875-01e2-3afa-aab1-932bd6d777de",
                        "source_sense_id": "493d80ef-db5c-3ce4-9a43-a846d1c739cd",
                        "source_sense_description": "weg voor snelverkeer (dat sneller kan en mag rijden dan 60 km per uur), met gescheiden rijbanen en ongelijkvloerse kruisingen",
                        "target_lang_word": "Autobahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autobahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                        "entry_id": "ec60252a-62ab-3c30-a453-dd67a390057d",
                                        "glosses": [
                                            "kreuzungsfrei gebaute, richtungsgetrennte Schnellstraße mit mindestens zwei Fahrspuren je Fahrtrichtung"
                                        ],
                                        "tags": [
                                            "Verkehrstechnik",
                                            "Verkehrswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "700c9e0f-78b5-4275-b91d-7cb79fa8255f",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "Die A 45 ist eine Autobahn von Norden nach Süden."
                                            },
                                            {
                                                "example_id": "6525e309-dfb4-4340-b001-4a8e84cc13b7",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "Nehmen Sie die Autobahn bis Freiburg."
                                            },
                                            {
                                                "example_id": "bb56481f-4736-444a-8d7f-18271db63a18",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "Aufgrund eines Verkehrsunfalls war gestern die Autobahn nach Berlin gesperrt."
                                            },
                                            {
                                                "example_id": "e9f04a6f-a298-4e08-97b8-55d6dd8b5ed5",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "In vielen Ländern wird für die Nutzung der Autobahn eine Maut erhoben."
                                            },
                                            {
                                                "example_id": "2cc8211b-f2e2-479b-a2c3-6d5410647b43",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "Besonders zu Beginn der Schulferien steht man auf der Autobahn häufig im Stau."
                                            },
                                            {
                                                "example_id": "01a7aea0-31b7-48f1-bd38-25c2a3ed74ea",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "„Die Autobahn schlägt eine Schneise durch einen Kiefernwald.“"
                                            },
                                            {
                                                "example_id": "8fcdb60e-cee5-4c19-a697-bb5d5bde6b9e",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "„Er las ihr vor, bis sie die Autobahn erreichten, deren heller Strich sich wie eine Neonröhre durch die Landschaft zog.“"
                                            },
                                            {
                                                "example_id": "9df82b3b-8274-4441-9f2d-f54c37c11b12",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "„Bevor ich die Autobahn sah, hörte ich sie.“"
                                            },
                                            {
                                                "example_id": "455dec8b-468b-4f1d-ab79-9bcb9a38b786",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "„Das Gerücht, dass die Erfindung der deutschen Autobahn auf Adolf Hitler zurückgeht, ist übrigens falsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c4025b5-07e1-491c-ba4e-6073c9e73351",
                        "source_entry_id": "72334875-01e2-3afa-aab1-932bd6d777de",
                        "source_sense_id": "493d80ef-db5c-3ce4-9a43-a846d1c739cd",
                        "source_sense_description": "weg voor snelverkeer (dat sneller kan en mag rijden dan 60 km per uur), met gescheiden rijbanen en ongelijkvloerse kruisingen",
                        "target_lang_word": "motorway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motorway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                        "entry_id": "c9f6b136-13f5-391a-9ed9-8b9fcd736ea1",
                                        "glosses": [
                                            "A highway with grade-separated crossings (rather than level crossings) and designed (and only permitted) for high-speed motor-traffic (in Europe motor vehicles with a higher speed limit than 40 km/h) running in two directions on one separate carriageway each."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "New-South-Wales",
                                            "New-Zealand",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34b9991f-feeb-4963-904f-8a7475004e1d",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "Charging stations for electric vehicles must be placed along the main European motorways at least every 60 kilometres from 2026, the European Parliament decided on Tuesday."
                                            },
                                            {
                                                "example_id": "2b9c44f7-9440-438a-80f6-ff67f5620047",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "All the R. R.'s of America will have to be furnished with a biking way and a motor way on each side of the rails."
                                            },
                                            {
                                                "example_id": "7baa5a72-8e00-4721-843c-4baaac520b71",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "Work of constructing the Texas Motorway, a stone highway which when completed will extend from Fort Worth to Del Rio, Tex., a distance of 500 miles, has been commenced and a section between 18 and 20 miles long running out from Glenrose, the county seat of Somervell County, has been completed."
                                            },
                                            {
                                                "example_id": "4e1f689f-20c8-4587-a492-01b4c1b18127",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "It is presumed that in the working out of the program the motor trucks will automatically have the major use of the local low-speed highways paralleling the motorway."
                                            },
                                            {
                                                "example_id": "8ef52f34-58e7-41d9-ab2a-abaec6aefe26",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "In 1959, Ernest Marples became the new Minister of Transport. His business career had been as a road builder and he saw the future in a network of motorways, whereas he believed there was serious overcapacity in the railway network."
                                            },
                                            {
                                                "example_id": "26874ec4-cc39-427d-a282-8dac0a0091f4",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "One national agency is responsible for developing and maintaining the national motorway system, which typically is a small fraction of the entire roadway network. (page 8)"
                                            },
                                            {
                                                "example_id": "45d68adf-0f02-4e1a-9dc7-045559478c7a",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "An alternative transit route that bypasses the metropolis’ traffic-filled streets, the 400-kilometer (248.5-mile) North Marmara Motorway starts on the western side of Istanbul and ends in the eastern Marmara province of Sakarya."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdab6b1b-b94a-36ea-a53f-9e9b4c440122",
                                        "entry_id": "c9f6b136-13f5-391a-9ed9-8b9fcd736ea1",
                                        "glosses": [
                                            "A racetrack venue designated especially for the sport of auto racing."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c73cb6f-34ae-4217-801b-d6cf67aa53fc",
                                                "sense_id": "fdab6b1b-b94a-36ea-a53f-9e9b4c440122",
                                                "text": "In December, track operators replaced the crushed rock with brick, earning the motorway the nickname, Brickyard."
                                            },
                                            {
                                                "example_id": "683b0cf3-4f29-47fb-86d7-eccf8e096393",
                                                "sense_id": "fdab6b1b-b94a-36ea-a53f-9e9b4c440122",
                                                "text": "The 9-degree banking you see in the Speedway’s four turns is believed to be the first intentionally banked motorway in the United States."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "624d2f28-be3a-4b0c-b70d-498a43f7d16c",
                        "source_entry_id": "72334875-01e2-3afa-aab1-932bd6d777de",
                        "source_sense_id": "493d80ef-db5c-3ce4-9a43-a846d1c739cd",
