                            {
                                "example_id": "de762c73-85c8-4a0d-8438-56bac5af0c45",
                                "sense_id": "eaf077b3-f1be-3f0d-a52c-2c91750d2b38",
                                "text": "Со временем Краевский задумал организовать кружок для атлетов."
                            },
                            {
                                "example_id": "447ecf19-d1c0-4f59-b731-6300fe6a26d7",
                                "sense_id": "eaf077b3-f1be-3f0d-a52c-2c91750d2b38",
                                "text": "Я видел нынче Краевского; он был у меня и рассказывал мне, что знает про твое дело."
                            }
                        ]
                    }
