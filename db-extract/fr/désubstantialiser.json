                ],
                "senses": [
                    {
                        "sense_id": "bf655633-8b45-3dee-b0e2-b5b984913ec9",
                        "entry_id": "9aa7e8d6-0421-3305-97e3-b2a0bfe4d1da",
                        "glosses": [
                            "Ne plus considérer la substance, le caractère matériel, de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf279cb-aef6-4472-8788-0cbf34c4adde",
                                "sense_id": "bf655633-8b45-3dee-b0e2-b5b984913ec9",
                                "text": "On est ainsi en droit de reprocher à la cybernétique sa tendance à « désubstantialiser » ses objets (Morin, 1977)."
                            },
                            {
                                "example_id": "933df58b-9e72-404d-8962-aba509fe4e24",
                                "sense_id": "bf655633-8b45-3dee-b0e2-b5b984913ec9",
                                "text": "Son effort consistera à désubstantialiser les faits sociaux."
                            },
                            {
                                "example_id": "0b945266-2e58-44dd-bacb-80b323e8abe3",
                                "sense_id": "bf655633-8b45-3dee-b0e2-b5b984913ec9",
                                "text": "La remarque de Descartes qui suit contribue à désubstantialiser ou à désessentialiser les textes : ce qui constitue un genre se situe à la fois dans l’écriture et dans la lecture."
                            }
                        ]
                    }
                ],
