{
    "word_family": [
        "screecher"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "daa8d9c6-7e23-3afd-ac76-e52218980b20",
                    "sense_definition": "A high-pitched piercing sound often caused by friction between two surfaces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>screech</w> of tires echoed through the empty street.",
                            "target_lang_translations": {
                                "zh": "空荡的街道上回荡着轮胎突然发出的<w>刺耳声</w>。"
                            }
                        },
                        {
                            "text": "The old door opened with a loud <w>screech</w> that startled everyone.",
                            "target_lang_translations": {
                                "zh": "那扇旧门打开时发出了一声巨大的<w>刺耳声</w>，吓了大家一跳。"
                            }
                        }
                    ],
                    "synonyms": [
                        "screak"
                    ],
                    "common_phrases": [
                        "screech of tires"
                    ],
                    "target_lang_definitions": {
                        "zh": "因摩擦而产生的尖锐刺耳的声音。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "刺耳声",
                                "target_lang_sense_clarification": "指物体摩擦产生的尖锐声音"
                            },
                            {
                                "target_lang_word": "尖叫声",
                                "target_lang_sense_clarification": "指物体发出的高频刺耳声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad5f27d7-624a-3b19-b6f4-fa6d3b5707d9",
                    "sense_definition": "A harsh, shrill cry caused by pain, fear, or excitement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird let out a sharp <w>screech</w> before flying away.",
                            "target_lang_translations": {
                                "zh": "那只鸟在飞走前发出了一声尖厉的<w>尖叫</w>。"
                            }
                        },
                        {
                            "text": "She let out a <w>screech</w> of surprise when she saw the spider.",
                            "target_lang_translations": {
                                "zh": "她看到蜘蛛时发出了一声惊讶的<w>尖叫</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "因疼痛、恐惧或兴奋而发出的尖厉叫声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尖叫",
                                "target_lang_sense_clarification": "指人或动物发出的尖厉叫声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cde702a-27ff-3d3c-9513-61728c993354",
                    "sense_definition": "A type of strong rum associated with Newfoundland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Visitors to the island are often invited to try a glass of <w>screech</w>.",
                            "target_lang_translations": {
                                "zh": "来岛上的游客经常会被邀请品尝一杯<w>斯克里奇酒</w>。"
                            }
                        },
                        {
                            "text": "The local pub is famous for serving traditional Newfoundland <w>screech</w>.",
                            "target_lang_translations": {
                                "zh": "当地的酒吧以供应传统的纽芬兰<w>斯克里奇酒</w>而闻名。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in Newfoundland"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种产自纽芬兰的烈性朗姆酒。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斯克里奇酒",
                                "target_lang_sense_clarification": "纽芬兰特产的烈性酒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04a34c53-6253-3dab-994b-b9a120457101",
                    "sense_definition": "A type of homemade rye whiskey.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old farmer distilled his own <w>screech</w> in the barn.",
                            "target_lang_translations": {
                                "zh": "老农夫在谷仓里蒸馏他自己酿的<w>自制黑麦威士忌</w>。"
                            }
                        },
                        {
                            "text": "He offered his guests a taste of the potent homemade <w>screech</w>.",
                            "target_lang_translations": {
                                "zh": "他让客人们尝了尝那种烈性的<w>自制黑麦威士忌</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种自制的黑麦威士忌。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "自制黑麦威士忌",
                                "target_lang_sense_clarification": "指家庭自酿的烈性酒"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a14b1370-6cc8-3af2-8cd9-ea0625879fa8",
                    "sense_definition": "To make a high-pitched, piercing sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brakes began to <w>screech</w> as the car slowed down.",
                            "target_lang_translations": {
                                "zh": "当汽车减速时，刹车开始<w>发出刺耳声</w>。"
                            }
                        },
                        {
                            "text": "The seagulls continued to <w>screech</w> above the crashing waves.",
                            "target_lang_translations": {
                                "zh": "海鸥在拍打的浪花上方不停地<w>尖叫</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "发出尖锐刺耳的声音。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发出刺耳声",
                                "target_lang_sense_clarification": "指物体发出尖锐的声音"
                            },
                            {
                                "target_lang_word": "尖叫",
                                "target_lang_sense_clarification": "指生物发出尖厉的叫声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a92842e-7404-3cb5-810a-09fb18770b03",
                    "sense_definition": "To move very quickly, often with a sound of friction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sports car <w>screeched</w> around the sharp corner.",
                            "target_lang_translations": {
                                "zh": "跑车<w>尖啸着</w>转过了急弯。"
                            }
                        },
                        {
                            "text": "The bus <w>screeched</w> to a halt at the red light.",
                            "target_lang_translations": {
                                "zh": "公交车在红灯前<w>尖啸着</w>停了下来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "screeched to a halt"
                    ],
                    "target_lang_definitions": {
                        "zh": "快速移动，通常伴随着摩擦声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尖啸着移动",
                                "target_lang_sense_clarification": "指车辆等快速移动时发出刺耳摩擦声"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}