                "senses": [
                    {
                        "sense_id": "4fedaf5b-6819-3869-9b09-27589738962b",
                        "entry_id": "861daf3f-8358-35a4-bf20-7544e23cd291",
                        "glosses": [
                            "Ensemble des réponses de croissance d’une plante à la suite d’une stimulation mécanique transitoire (vent, courant d’une rivière, piétinement, arrachement…)."
                        ],
                        "tags": [
                            "Physiologie végétale"
                        ],
                        "examples": [
                            {
                                "example_id": "52cce580-349e-4e3a-9854-b985d026d8fe",
                                "sense_id": "4fedaf5b-6819-3869-9b09-27589738962b",
                                "text": "Les physiologistes avaient entrepris depuis longtemps d’étudier certaines réponses des plantes aux forces mécaniques qui s’exercent sur elles, en particulier les réactions orientées de la croissance — gravitropisme — ou les réponses au toucher — thigmomorphogenèse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77641863-c562-440b-8643-2dff5550747c",
                        "source_entry_id": "861daf3f-8358-35a4-bf20-7544e23cd291",
                        "source_sense_id": "4fedaf5b-6819-3869-9b09-27589738962b",
                        "target_lang_word": "thigmomorphogenesis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thigmomorphogenesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12a098c0-967c-34af-a79b-aa8aeb8b2413",
                                        "entry_id": "247e1112-4bbc-3c5b-b0a2-54507e143341",
                                        "glosses": [
                                            "The response of a plant to touch or other mechanical sensation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "128ff468-9009-45b7-b283-0aae6c48b8ef",
                                                "sense_id": "12a098c0-967c-34af-a79b-aa8aeb8b2413",
                                                "text": "Some of these, such as thigmomorphogenesis, are quite well defined, but the basis of perception and response is poorly understood although some advances are being made at the molecular level."
                                            },
                                            {
                                                "example_id": "e6c3f80d-9bf4-4c75-a8e6-c38474d66445",
                                                "sense_id": "12a098c0-967c-34af-a79b-aa8aeb8b2413",
                                                "text": "This effect, called thigmomorphogenesis (see chap. 3), involves the motion-induced inhibition of growth. Thigmomorphogenesis can be expressed in plant organs either exhibiting or lacking secondary growth, as well as in organs that have indeterminate or determinate growth."
                                            },
                                            {
                                                "example_id": "82ae379d-419a-48a7-b53c-7959c65e0eab",
                                                "sense_id": "12a098c0-967c-34af-a79b-aa8aeb8b2413",
                                                "text": "Thigmomorphogenesis was first demonstrated by submitting plants to (artificial) mechanical bending."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
