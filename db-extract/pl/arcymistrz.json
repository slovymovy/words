                "senses": [
                    {
                        "sense_id": "8d26055f-66f3-3ae9-95aa-b1fcff971a44",
                        "entry_id": "e3d3d76c-275b-3f3a-ba66-7c22608592df",
                        "glosses": [
                            "osoba przewyższająca wszystkich swoimi umiejętnościami w danej dziedzinie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4b92542-5346-42d2-ba75-ee70604d319a",
                                "sense_id": "8d26055f-66f3-3ae9-95aa-b1fcff971a44",
                                "text": "W relacjach z mało mu dotąd znanym światem polityki raz po raz iskrzyło i dochodziło nawet do bardzo ostrych konfliktów, ale Rowecki, choć nie stał się arcymistrzem gry politycznej, szybko uczył się jej reguł."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "dcf99252-60f5-3dd8-b677-3d0799eb65be",
                        "entry_id": "e3d3d76c-275b-3f3a-ba66-7c22608592df",
                        "glosses": [
                            "szachista posiadający najwyższy tytuł przyznawany w szachach sportowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19711559-d7f1-4b9c-bc14-cc76b3a40e79",
                                "sense_id": "dcf99252-60f5-3dd8-b677-3d0799eb65be",
                                "text": "Trzy lata później w Rzymie Sofia doprowadziła do rozpaczy grupę arcymistrzów radzieckich — tylko jednemu z nich „podarowała” remis i osiągnęła jeden z najwspanialszych wyników rankingowych w historii szachów."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b54392c1-2691-4db6-963a-49aef160cdb5",
                        "source_entry_id": "e3d3d76c-275b-3f3a-ba66-7c22608592df",
                        "source_sense_id": "dcf99252-60f5-3dd8-b677-3d0799eb65be",
