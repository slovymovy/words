                                "example_id": "3fab589d-6159-4803-945d-e10d4e24e5bf",
                                "sense_id": "7f8fe312-ea3e-31bc-9232-7f6b91fe41c4",
                                "text": "Malgré la disparition de Chadwick Boseman, en août 2020, le tournage de Black Panther, Wakanda Forever, de Ryan Coogler, s’est poursuivi."
                            }
                        ]
