                                        "sense_id": "9aaf399e-b837-37a6-a2e9-744620eb584d",
                                        "entry_id": "ce2d1d13-23df-33ed-8aef-9fdcb7010c75",
                                        "glosses": [
                                            "A large snowstorm accompanied by strong winds and greatly reduced visibility caused by blowing snow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "033ce573-e18c-37f8-b697-a9afa707e842",
                                        "entry_id": "ce2d1d13-23df-33ed-8aef-9fdcb7010c75",
                                        "glosses": [
                                            "A large amount of paperwork."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90dc8bec-436c-3d34-9c46-a2b5ef627b48",
                                        "entry_id": "ce2d1d13-23df-33ed-8aef-9fdcb7010c75",
                                        "glosses": [
                                            "A large number of similar things; especially, such a group arriving as an inundation, thick and fast."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20cb9975-fe53-40b2-bbe9-edc9c905aeeb",
                                                "sense_id": "90dc8bec-436c-3d34-9c46-a2b5ef627b48",
                                                "text": "Near-synonyms: flood, inundation, torrent"
                                            },
                                            {
                                                "example_id": "a7fdf736-b12a-4a90-9ec9-2168aafc8c44",
                                                "sense_id": "90dc8bec-436c-3d34-9c46-a2b5ef627b48",
                                                "text": "a blizzard of political ads"
                                            },
                                            {
                                                "example_id": "a805117f-7902-4dd6-984f-1fd4d33728a4",
                                                "sense_id": "90dc8bec-436c-3d34-9c46-a2b5ef627b48",
                                                "text": "Risk is everywhere.[…]For each one there is a frighteningly precise measurement of just how likely it is to jump from the shadows and get you. “The Norm Chronicles”[…]aims to help data-phobes find their way through this blizzard of risks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blizzard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da2552bf-1a81-3690-bbc7-b82e0a8f26b9",
                                        "entry_id": "cfdaf95d-526d-3372-8c26-29a0d966693d",
                                        "glosses": [
                                            "To fall in windy conditions."
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
