                        "entry_id": "0179a906-07f2-3ceb-aa6c-8a608782d61c",
                        "glosses": [
                            "Donner un caractère lingual à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "985a9777-b4af-46f1-96f7-0a9ada1c5b53",
                                "sense_id": "9191aa0b-d035-38f6-9766-850371d1a008",
                                "text": "Si le nom est en construction avec le mot avec lequel il se trouve joint l'on peut ne lingualiser qu'à volonté."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f9e877c-88fa-3943-a867-9ee3b2a64cf4",
                        "entry_id": "0179a906-07f2-3ceb-aa6c-8a608782d61c",
                        "glosses": [
                            "Mettre en contact avec la langue."
                        ],
                        "tags": [
                            "définition à préciser ou à vérifier"
                        ],
                        "examples": [
                            {
                                "example_id": "0da3b229-38d1-4642-a3a9-127b26abae01",
                                "sense_id": "7f9e877c-88fa-3943-a867-9ee3b2a64cf4",
                                "text": "Cet arc applique une force aux incisives pour lingualiser le bord libre des couronnes par un mouvement de torque."
                            },
                            {
                                "example_id": "1d8de74d-a18a-4299-80ea-f4d81875b9b6",
                                "sense_id": "7f9e877c-88fa-3943-a867-9ee3b2a64cf4",
                                "text": "J'ai pensé à un traitement orthodontique qui permettrait de lingualiser la 44 qui actuellement est en articulé croisé complet avec non occlusion, et de retrouver de meilleurs contacts de 44 à 38"
                            },
                            {
                                "example_id": "e7b76cdc-a5ad-43f2-8a4f-4610e8acd8be",
                                "sense_id": "7f9e877c-88fa-3943-a867-9ee3b2a64cf4",
                                "text": "Moi aussi je me fais lingualiser prochainement (en haut du moins, en bas j'ai opté pour un céramique)."
                            }
                        ]
