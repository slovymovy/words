{
    "word_family": [
        "conventional",
        "unconventional",
        "convene",
        "convener",
        "conventionality",
        "conventionally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "496b17ef-8560-34b6-a0f7-f059180afb89",
                    "sense_definition": "A practice or procedure widely observed in a group, especially to facilitate social interaction; a custom.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "social_norms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a social <w>convention</w> to shake hands when meeting someone for the first time.",
                            "target_lang_translations": {
                                "ru": "Пожимать руки при первой встрече — это социальная <w>условность</w>."
                            }
                        },
                        {
                            "text": "The artist decided to defy social <w>convention</w> by using unusual materials for his sculptures.",
                            "target_lang_translations": {
                                "ru": "Художник решил бросить вызов общественным <w>устоям</w>, используя необычные материалы для своих скульптур."
                            }
                        }
                    ],
                    "synonyms": [
                        "custom",
                        "tradition",
                        "norm",
                        "practice"
                    ],
                    "common_phrases": [
                        "social convention",
                        "defy convention",
                        "by convention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общепринятая норма, обычай или правило поведения в обществе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "условность",
                                "target_lang_sense_clarification": "общепринятая норма поведения"
                            },
                            {
                                "target_lang_word": "традиция",
                                "target_lang_sense_clarification": "устоявшийся обычай"
                            },
                            {
                                "target_lang_word": "обычай",
                                "target_lang_sense_clarification": "привычный порядок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82afcdb9-1e23-31ad-a411-798d28c3d652",
                    "sense_definition": "A large meeting or gathering of people who share a common interest or professional background.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "meetings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thousands of fans traveled to the city to attend the annual comic book <w>convention</w>.",
                            "target_lang_translations": {
                                "ru": "Тысячи фанатов приехали в город, чтобы посетить ежегодный <w>конвент</w> любителей комиксов."
                            }
                        },
                        {
                            "text": "The political party held a national <w>convention</w> to nominate their candidate for president.",
                            "target_lang_translations": {
                                "ru": "Политическая партия провела национальный <w>съезд</w>, чтобы выдвинуть своего кандидата в президенты."
                            }
                        }
                    ],
                    "synonyms": [
                        "conference",
                        "assembly",
                        "gathering",
                        "congress"
                    ],
                    "common_phrases": [
                        "national convention",
                        "annual convention",
                        "attend a convention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное собрание или съезд людей, объединенных общими интересами или профессией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "съезд",
                                "target_lang_sense_clarification": "собрание представителей организации или партии"
                            },
                            {
                                "target_lang_word": "конвент",
                                "target_lang_sense_clarification": "встреча участников движения или фанатов"
                            },
                            {
                                "target_lang_word": "конгресс",
                                "target_lang_sense_clarification": "большое официальное совещание"
                            },
                            {
                                "target_lang_word": "собрание",
                                "target_lang_sense_clarification": "встреча группы людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f71d6cc-cabd-37fe-823d-288e81c3fcc9",
                    "sense_definition": "A formal agreement between states or organizations, often regarding international law or specific rules.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_agreements",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Geneva <w>Convention</w> establishes international standards for the humanitarian treatment of war victims.",
                            "target_lang_translations": {
                                "ru": "Женевская <w>конвенция</w> устанавливает международные стандарты гуманного обращения с жертвами войны."
                            }
                        },
                        {
                            "text": "Many countries have signed the international <w>convention</w> to protect endangered species.",
                            "target_lang_translations": {
                                "ru": "Многие страны подписали международную <w>конвенцию</w> по защите исчезающих видов."
                            }
                        }
                    ],
                    "synonyms": [
                        "treaty",
                        "pact",
                        "accord",
                        "agreement"
                    ],
                    "common_phrases": [
                        "international convention",
                        "sign a convention",
                        "vienna convention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное международное соглашение или договор по специальному вопросу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конвенция",
                                "target_lang_sense_clarification": "международный договор"
                            },
                            {
                                "target_lang_word": "соглашение",
                                "target_lang_sense_clarification": "взаимная договоренность"
                            },
                            {
                                "target_lang_word": "договор",
                                "target_lang_sense_clarification": "официальный документ"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}