                        "entry_id": "14fd8efd-3caf-3d7d-8f65-43cac431da52",
                        "glosses": [
                            "Féminin singulier de curieux."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a527b311-8eca-47a7-b451-abd93d507a83",
                                "sense_id": "0150f91e-1ebd-324d-b5ed-934655ab5913",
                                "text": "Une heure après, un lit de sangle complet arriva pour Mme Cardinal, à qui la curieuse portière offrit ses services pour lui donner à manger."
                            },
                            {
                                "example_id": "edc1aa4d-1f30-44b1-b10f-5c33eda273a5",
                                "sense_id": "0150f91e-1ebd-324d-b5ed-934655ab5913",
                                "text": "Chez le chien et le chat, le perforé présente cette particularité curieuse de recouvrir le cubital interne et d’être ainsi à découvert; son tendon passe au dehors de la gaine carpienne, ainsi que d’ailleurs chez le lapin, et se quadrifurque aussitôt."
                            }
                        ]
                    }
