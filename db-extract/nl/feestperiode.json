                        "glosses": [
                            "deel van het jaar met veel feesten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf29c09b-6638-4d89-a428-db293610025b",
                                "sense_id": "99552255-3f94-335a-855e-31be3d7744c5",
                                "text": "De organisaties wijzen naar de voorraadregeling van vorig jaar, toen de lockdown ook vlak voor de feestperiode inging. Toen kwam er, naast de vergoeding voor loonkosten en vaste lasten, een eenmalige voorraadvergoeding tot een maximum van ruim 20.000 euro. Nu heeft het kabinet daar nog niks over bekendgemaakt."
                            },
                            {
                                "example_id": "e98931a2-c0ee-4cfe-ae49-09dbf8a15401",
                                "sense_id": "99552255-3f94-335a-855e-31be3d7744c5",
                                "text": "Stoter: ,,Het is voor onze medewerkers een bijzonder en druk jaar geweest en daarom willen we graag iets terugdoen tijdens de feestperiode. Op tweede paas- en kerstdag trekken consumenten er altijd massaal op uit en die drukte willen we onze medewerkers dit jaar besparen. Zo is er tijd voor een welverdiende kerst, thuis met familie.”"
                            }
                        ]
                    }
