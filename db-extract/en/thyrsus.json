                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b1e1c325-a20c-4846-9502-aeeb3b602444",
                        "entry_id": "5b795a4c-8793-3eef-bb8c-150bf777a472",
