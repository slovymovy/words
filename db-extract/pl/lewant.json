                                "target_senses": [
                                    {
                                        "sense_id": "3ba27927-fca5-3dc5-a271-592a834e53ff",
                                        "entry_id": "42b54840-ad6c-3942-b4c5-3a725a305ed4",
                                        "glosses": [
                                            "Région du monde composée du Liban, de la Syrie, d’Israël, de la Palestine, et de la Jordanie."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3f8a6a7-3d2d-4915-92be-05b67b7412d6",
                                                "sense_id": "3ba27927-fca5-3dc5-a271-592a834e53ff",
                                                "text": "De Termes ne pouvant lui faire compter cette somme , lui envoya son neveu en otage , et il partit pour le Levant le 22 septembre , au moment où sa coopération eût été le plus nécessaire."
                                            },
                                            {
                                                "example_id": "a353467e-82bf-4700-bd04-43dfa4c25f3e",
                                                "sense_id": "3ba27927-fca5-3dc5-a271-592a834e53ff",
                                                "text": "Des lois répressives furent édictées ; c'est ainsi qu'on défendit d’entrer et de mettre en vente en France des étoffes des Indes, de la Chine et du Levant."
                                            },
                                            {
                                                "example_id": "7d70de8d-b22c-4afe-95fd-02ad15ba082b",
                                                "sense_id": "3ba27927-fca5-3dc5-a271-592a834e53ff",
                                                "text": "L'État […]: ses structures et la légitimité de ses souverains sont attaqués du Levant à l'Asie du Sud-Ouest. Un conflit intérieur et son corollaire d'instabilité régionale peuvent donc faire craindre la balkanisation de la région et, par suite, une refonte de sa carte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "050d2e04-5207-309b-a866-4e39d615bea1",
                                        "entry_id": "42b54840-ad6c-3942-b4c5-3a725a305ed4",
                                        "glosses": [
                                            "Vent d’est soufflant en mer Méditerranée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa0296f7-689b-426a-8f55-8b8d355c1ccb",
                                                "sense_id": "050d2e04-5207-309b-a866-4e39d615bea1",
                                                "text": "Par ordre de fréquence décroissante, on observe ensuite les vents d’est, parmi lesquels le \"Levant\" et le \"Grigal\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d046dd8-3870-3ae7-ba03-144fcf9f505c",
                                        "entry_id": "42b54840-ad6c-3942-b4c5-3a725a305ed4",
                                        "glosses": [
                                            "Petite île le plus à l´est de l’archipel des îles d’Hyères dans le Var."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
