                        "cross_references": [
                            {
                                "target_word": "unscrew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df1a215a-78bd-3ae2-9042-2f91992ca3f7",
                                        "entry_id": "dce91df2-a8c2-38f1-b49c-9b5459f4a0e1",
                                        "glosses": [
                                            "To loosen a screw or thing by turning it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "207c8318-e658-4215-b041-dd5a4eedc3a5",
                                                "sense_id": "df1a215a-78bd-3ae2-9042-2f91992ca3f7",
                                                "text": "I'm having some trouble unscrewing the lid of this jar."
                                            },
                                            {
                                                "example_id": "9a7521ea-cda0-4a3d-b9c7-206daa1a32ec",
                                                "sense_id": "df1a215a-78bd-3ae2-9042-2f91992ca3f7",
                                                "text": "It requires opening a complex lock with a key that also unscrews a bolt six inches long. Unscrewing the bolt itself takes six minutes."
                                            },
                                            {
                                                "example_id": "e47961c8-89dc-4d4f-ad5f-866717b4c501",
                                                "sense_id": "df1a215a-78bd-3ae2-9042-2f91992ca3f7",
                                                "text": "A young orangutan in the San Diego Zoo became famous for unbolting the screening of his crib, removing the wires, and moving through the zoo nursery, unscrewing lightbulbs."
                                            },
                                            {
                                                "example_id": "9f7e825b-0987-47cd-9ba2-c14d49b008bb",
                                                "sense_id": "df1a215a-78bd-3ae2-9042-2f91992ca3f7",
                                                "text": "Ms. Van Son unscrewed the pump’s handle and shoved it into her bra."
                                            },
                                            {
                                                "example_id": "4c89321e-182c-44ff-84d6-5ebbe2d2265f",
                                                "sense_id": "df1a215a-78bd-3ae2-9042-2f91992ca3f7",
                                                "text": "The challenge is how to unscrew the cap with a roundhouse kick without knocking the bottle over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99c760e4-6727-42da-ad8d-f7b10d0ecc7b",
                        "source_entry_id": "c4b6fd1b-eea4-3fdf-9f7e-64061a3b3b9b",
                        "source_sense_id": "5751d596-adc6-30f5-bf0a-2731718cda5c",
