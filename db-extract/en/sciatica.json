                                "target_senses": [
                                    {
                                        "sense_id": "353e2ffc-97e9-3168-ab3b-e52457e7324a",
                                        "entry_id": "be9f02ff-1a4a-3c9b-8e49-a8a0e70f4cab",
                                        "glosses": [
                                            "Schmerzen des Ischiasnervs"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fba495b6-9b03-4931-9711-c525d5c223d9",
                                                "sense_id": "353e2ffc-97e9-3168-ab3b-e52457e7324a",
                                                "text": "Herr Doktor, mein Ischias quält mich schon wieder."
                                            },
                                            {
                                                "example_id": "e4da6f15-fe31-4cbe-8c81-484c02b8eddd",
                                                "sense_id": "353e2ffc-97e9-3168-ab3b-e52457e7324a",
                                                "text": "Ich kann mich gar nicht rühren mit meinem Ischias."
                                            },
                                            {
                                                "example_id": "3d88bce7-8b56-47de-a858-d7db043d3891",
                                                "sense_id": "353e2ffc-97e9-3168-ab3b-e52457e7324a",
                                                "text": "„Wir fanden die Mutter im Bett, an das sie durch Ischias gefesselt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a2f6c88-7ad8-3472-927c-c64d7f3f5161",
                                        "entry_id": "be9f02ff-1a4a-3c9b-8e49-a8a0e70f4cab",
                                        "glosses": [
                                            "Nervus ischiadicus"
                                        ],
                                        "tags": [
                                            "umgangssprachliche Kurzform für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8545af45-914c-44b6-9097-a1895c908f34",
                                                "sense_id": "4a2f6c88-7ad8-3472-927c-c64d7f3f5161",
                                                "text": "Der Ischias kann starke Schmerzen verursachen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
