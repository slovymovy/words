                                            {
                                                "example_id": "90ebf243-a6f9-4dbc-ab8b-7a4b734ff762",
                                                "sense_id": "d98b4d1f-72fb-34e4-87be-31cbc8141993",
                                                "text": "On a également employé pour le même objet l’acide fluorhydrique, obtenu soit à l’état gazeux soit en dissolution, par la décomposition d’un fluorite naturel appelé cryolite."
                                            },
                                            {
                                                "example_id": "c8ef890a-8d42-436b-899a-59cc8594dc42",
                                                "sense_id": "d98b4d1f-72fb-34e4-87be-31cbc8141993",
                                                "text": "Des cabanes sordides rasaient le sol, écrasées, baignant dans le brouillard pâle et brûlant : la ville suait son brouillard, une vapeur débilitante, bouillon de culture à l’état gazeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "047c4fb8-8e6a-3fab-b618-90a178e038ec",
                                        "entry_id": "9b228a90-ed5b-3fd4-9978-0f1746ac553d",
                                        "glosses": [
                                            "Qui contient du gaz."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "200b9451-edfe-42b4-9903-6733df8c48ab",
                                                "sense_id": "047c4fb8-8e6a-3fab-b618-90a178e038ec",
                                                "text": "Eau gazeuse, boisson gazeuse."
                                            },
                                            {
                                                "example_id": "e1d03fd8-a41c-4cf8-82ee-7c5b2cd03983",
                                                "sense_id": "047c4fb8-8e6a-3fab-b618-90a178e038ec",
                                                "text": "Composé gazeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "679fa527-cb58-3412-baff-255ffef8e4fc",
                                        "entry_id": "9b228a90-ed5b-3fd4-9978-0f1746ac553d",
                                        "glosses": [
                                            "Aérien, léger."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19d64aa7-cc18-4f84-a620-3bd72aa8a392",
                                                "sense_id": "679fa527-cb58-3412-baff-255ffef8e4fc",
                                                "text": "Parfois, elle rêvait d’être l’une de ces créatures gazeuses, vêtues de pantalons blancs, fendant la foule, exhibant la force et la confiance d’être toujours remarquées.\nMais elle aimait manger, elle aimait dormir, et ne voulait pas se droguer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9105115c-ffde-4a7b-9d61-834a4a118553",
                        "source_entry_id": "c4a195c5-b13f-3a09-a5ad-dbd24a2cbdc1",
                        "source_sense_description": "пенистый, газированый",
                        "target_lang_word": "pétillant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pétillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e533aa1b-231c-32a8-8861-8bdbceb75863",
                                        "entry_id": "d9b2e5a7-f119-39f8-919c-f37916aaf248",
                                        "glosses": [
                                            "Qui pétille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a9a4695-e1b1-4bf1-924e-a0e6ab59ff43",
                                                "sense_id": "e533aa1b-231c-32a8-8861-8bdbceb75863",
                                                "text": "En bon Champenois, il célébra le vin de Champagne dans une ode en vers iambiques, dont le style vif et pétillant, présente la belle image de cette charmante liqueur."
                                            },
                                            {
                                                "example_id": "cf5e1117-e999-436a-b228-8a34d64cbbd1",
                                                "sense_id": "e533aa1b-231c-32a8-8861-8bdbceb75863",
                                                "text": "Du foyer avivé s’élevaient de belles flammes qui montaient en tourbillons jusqu’au toit, en jetant des étincelles pétillantes qui, seules, troublaient le silence."
                                            },
                                            {
                                                "example_id": "6fbb2b63-ef27-4623-8750-d31668ac0771",
                                                "sense_id": "e533aa1b-231c-32a8-8861-8bdbceb75863",
                                                "text": "Vin pétillant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5ca4d20-d256-38dc-ad03-1dd467b1c7ec",
                                        "entry_id": "d9b2e5a7-f119-39f8-919c-f37916aaf248",
                                        "glosses": [
                                            "Qui brille avec éclat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7aef038-9c2a-4d43-a008-f55c431c242e",
                                                "sense_id": "f5ca4d20-d256-38dc-ad03-1dd467b1c7ec",
                                                "text": "À l’affiche cette année, entre autres, le chanteur, guitariste et auteur-compositeur Gilberto Gil, le pétillant groupe de jazz-funk Earth Wind and Fire, la chanteuse Jane Birkin, l’organiste Rhoda Scott ou encore l’ensemble vocal de gospel Golden Gate Quartet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pétillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d839e4b9-75bc-3760-b5ee-b20c0b38bd97",
                                        "entry_id": "4ad44c09-3fbb-3a96-baa0-02f2047fe915",
                                        "glosses": [
                                            "Vin qui pétille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "238eccaf-1220-4dec-b6e3-597f105f24af",
                                                "sense_id": "d839e4b9-75bc-3760-b5ee-b20c0b38bd97",
                                                "text": "Main sur l’épaule, tapes dans le dos, sourires et lunch d’adieu avec petit pétillant frais, ses ex-coachs de Think Global firent part de leur regret de devoir se séparer de lui."
                                            },
                                            {
                                                "example_id": "41f4bb4b-0dc6-4cb4-8e56-eb0aa67f7902",
                                                "sense_id": "d839e4b9-75bc-3760-b5ee-b20c0b38bd97",
                                                "text": "Quoi de plus frais et de désaltérant l’été qu’un pétillant peu sucré ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pétillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3135d9da-117b-3eec-b1bb-7f6cf7a0fe71",
