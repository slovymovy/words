                        "entry_id": "b007c5c4-1863-3f64-bf2c-39129b436f45",
                        "glosses": [
                            "Qui est au sommet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb7ca417-2ce3-4fbc-bd70-9525acdd9532",
                                "sense_id": "fa06cac5-3031-320c-b90a-af8f0add5ff8",
                                "text": "L’objectif de l’expédition est aussi de mesurer la « calotte sommitale » afin d’obtenir une « cubature » (volume de glace et de neige au-dessus de 4 800 m) et de la comparer aux années précédentes."
                            },
                            {
                                "example_id": "7ff6b0bd-aa5a-4ba0-aaee-bc1b00874d87",
                                "sense_id": "fa06cac5-3031-320c-b90a-af8f0add5ff8",
                                "text": "Ce vénérable vieillard errait au sommet de la « Gabel ». (C’est une grand couloir qui aboutit à l’arête sommitale.)"
                            },
                            {
                                "example_id": "9a019b31-8b35-41de-b1b9-dacab00e0797",
                                "sense_id": "fa06cac5-3031-320c-b90a-af8f0add5ff8",
                                "text": "La plate-forme sommitale est assez large pour que nous puissions sans imprudence nous décorder."
                            }
                        ]
                    }
