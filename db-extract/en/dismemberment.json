                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb947184-7242-3046-b8bb-73bc51fa86d7",
                        "entry_id": "7c6df931-4776-356d-8ddd-ca0738d6b54b",
                        "glosses": [
                            "The act of dismembering."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "ffc7564b-a781-419d-81a7-b16d37791827",
                                "sense_id": "fb947184-7242-3046-b8bb-73bc51fa86d7",
                                "text": "The skill is shown by the neat way in which the dismemberment has been carried out. The parts have not been rudely hacked asunder, but have been separated at the joints."
                            },
                            {
                                "example_id": "2583cba8-2732-4b89-bba9-badab72179b7",
                                "sense_id": "fb947184-7242-3046-b8bb-73bc51fa86d7",
                                "text": "Modern romance, like Greek tragedy, celebrates the mystery of dismemberment, which is life in time."
                            },
                            {
                                "example_id": "2ad54a79-e256-4ae6-8c81-b097a5e2b1c3",
                                "sense_id": "fb947184-7242-3046-b8bb-73bc51fa86d7",
                                "text": "The metapodials appear to have been marked during dismemberment from the lower limbs."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec99d967-c079-30c5-8d76-e84be5981c9d",
                        "entry_id": "7c6df931-4776-356d-8ddd-ca0738d6b54b",
                        "glosses": [
                            "The state or condition of being dismembered."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2e5dc42b-eb45-4572-b428-07f071f97cc2",
                                "sense_id": "ec99d967-c079-30c5-8d76-e84be5981c9d",
                                "text": "[I]s not the fair fabric of Society itself, with all its royal mantles and pontifical stoles, whereby, from nakedness and dismemberment, we are organised into Polities, into nations, and a whole coöperating Mankind, the creation, as has here been often irrefragably evinced, of the Tailor alone?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a8e4ff3c-911d-3d24-9bf8-1aa8f92a8595",
                        "entry_id": "7c6df931-4776-356d-8ddd-ca0738d6b54b",
                        "glosses": [
                            "Removal from membership; detachment from an organization, group, etc."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "54f4c000-1bee-46dd-a187-ea3461d98385",
                                "sense_id": "a8e4ff3c-911d-3d24-9bf8-1aa8f92a8595",
                                "text": "1867, \"Supreme Court of the District of Columbia. Ex Parte Magruder,\" The American Law Register (1852-1891), vol. 15, no. 5, New Series Volume 6, (Mar.), p. 295,\nThe decision of the Supreme Court involved a dismemberment from the bar."
                            },
                            {
                                "example_id": "47fd66ca-6014-441a-b32f-a9a74e44573c",
                                "sense_id": "a8e4ff3c-911d-3d24-9bf8-1aa8f92a8595",
                                "text": "As the Italian East African Empire was on the verge of extinction in the autumn of 1941, East African Command was created by dismemberment from Middle East."
                            }
                        ]
                    }
                ],
