                ],
                "senses": [
                    {
                        "sense_id": "bf7800a7-b833-3bc3-a9dd-eb3890f626bb",
                        "entry_id": "6ba13c5d-b7af-31a7-8e26-805228410722",
                        "glosses": [
                            "D’une manière incongrue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8a55f7e-24dd-4271-9694-cefde23a30ef",
                                "sense_id": "bf7800a7-b833-3bc3-a9dd-eb3890f626bb",
                                "text": "Ce bruit de cuisine, accompagné d’une odeur composite où dominait celle d’un évier, mêlait incongrûment l’idée des nécessités de la vie réelle aux idées d’un pouvoir surnaturel."
                            },
                            {
                                "example_id": "50283e80-f12c-4a7c-b652-cdf47d1d53e1",
                                "sense_id": "bf7800a7-b833-3bc3-a9dd-eb3890f626bb",
                                "text": "Aussi peu paysanne et napolitaine que possible, incongrûment posée par le photographe parmi les plantes vertes d’un jardin d’hiver, elle fait songer à la Nora d’Ibsen s’apprêtant à danser la tarentelle dans un salon de Christiania."
                            },
                            {
                                "example_id": "1a9fdfb1-e52f-4c5f-a510-cd83bb4f42ef",
                                "sense_id": "bf7800a7-b833-3bc3-a9dd-eb3890f626bb",
                                "text": "Ayant attrait jusqu’au guéridon central l’une des dix-huit chaises rituellement disposées en ovale, Chicotte-l’Alambic, avachi, incongrûment déboutonné, tuait le temps en face d’une bouteille de rhum presque vidée."
                            }
                        ]
                    }
