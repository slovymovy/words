                        "form": "thermites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c23dc9c3-d0ce-3d77-abde-ce16f97bf6df",
                        "entry_id": "bf874498-bc04-3ea8-b0a6-a8836aff44d6",
                        "glosses": [
                            "A mixture of a metal and a metal oxide capable of producing a thermite reaction, such as aluminium metal and ferric oxide; used in incendiary devices."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "978fe543-24b9-42a4-9b8e-4eefe28a9600",
                        "source_entry_id": "bf874498-bc04-3ea8-b0a6-a8836aff44d6",
                        "source_sense_id": "c23dc9c3-d0ce-3d77-abde-ce16f97bf6df",
                        "source_sense_description": "mixture of aluminum and ferric oxide",
                        "target_lang_word": "thermiet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thermiet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ab44d177-398c-37cf-afdb-0ed316e668d7",
                                        "entry_id": "7335d722-cf04-3a05-b70a-7dc2f385ce54",
                                        "glosses": [
                                            "een poedermengsel van een onedel metaal, gewoonlijk aluminium, en een oxide van een edeler metaal, vaak ijzer of koper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "658eda46-12fa-46af-b0be-f99d7f7e60ed",
                                                "sense_id": "ab44d177-398c-37cf-afdb-0ed316e668d7",
                                                "text": "De redoxreactie die optreedt bij het ontsteken van thermiet doet veel hitte vrijkomen en valt niet te blussen."
                                            },
                                            {
                                                "example_id": "5c786adb-5703-4322-a7cf-df23bef3b431",
                                                "sense_id": "ab44d177-398c-37cf-afdb-0ed316e668d7",
                                                "text": "Wanneer men de empirische toestandsfuncties zal hebben bepaald voor een vrij groot aantal stoffen tusschen de laagste en hoogste in het laboratorium bereikbare temperaturen — heden die van vloeibare waterstof en ontbrandend thermiet — zal men eerst voor goed kunnen beslissen in hoeverre nog kleinere wijzigingen dienen te worden aangebracht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ae179c8-4e80-4de3-990b-7793beb12077",
                        "source_entry_id": "bf874498-bc04-3ea8-b0a6-a8836aff44d6",
                        "source_sense_id": "c23dc9c3-d0ce-3d77-abde-ce16f97bf6df",
                        "source_sense_description": "mixture of aluminum and ferric oxide",
                        "target_lang_word": "Thermit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thermit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cec9ab2-b8b4-31dc-8b8a-3ac011c6afe8",
                                        "entry_id": "c198338a-698b-39d1-b8ef-edaffeb79f79",
                                        "glosses": [
                                            "rieselfähiges Gemisch aus Aluminium und Eisenoxid, das dafür bekannt ist, unter großer Hitzeentwicklung zu reagieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10247da9-8e41-46fb-95f0-4a38e18bb4b0",
                                                "sense_id": "6cec9ab2-b8b4-31dc-8b8a-3ac011c6afe8",
                                                "text": "Thermit wird hauptsächlich im Gleisbau und zu militärischen Zwecken verwendet."
                                            },
                                            {
                                                "example_id": "daece3c2-d98a-414a-8893-2ada48dfb2a8",
                                                "sense_id": "6cec9ab2-b8b4-31dc-8b8a-3ac011c6afe8",
                                                "text": "„‚Thermit ist Aluminium und Eisenoxis,‘ sagte David. ‚Es wird sehr heiß — über fünfzehnhundert Grad — und so hell, dass du nicht direkt hineingucken kannst.‘“"
                                            },
                                            {
                                                "example_id": "b7bdace1-c3d9-4d1a-96e5-1303f1dc8083",
                                                "sense_id": "6cec9ab2-b8b4-31dc-8b8a-3ac011c6afe8",
                                                "text": "„Thermit lässt sich nur schwer löschen und die folgenden Brände entziehen der Luft Sauerstoff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca3cc8a9-79e8-4b91-81fd-d857f52dd8f0",
