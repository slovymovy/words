                {
                    "sense_id": "28ea5aee-0f49-37b6-b3a8-eee3b2bd1122",
                    "sense_definition": "Filled to capacity, especially with people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "full",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The subway was <w>rammed</w> during the morning rush hour.",
                            "target_lang_translations": {
                                "nl": "De metro zat <w>stampvol</w> tijdens de ochtendspits."
                            }
                        },
                        {
                            "text": "The concert venue was <w>rammed</w> with excited fans waiting for the band.",
                            "target_lang_translations": {
                                "nl": "De concertzaal zat <w>afgeladen</w> vol met enthousiaste fans die op de band wachtten."
                            }
                        }
                    ],
                    "synonyms": [
                        "crowded",
                        "packed"
                    ],
                    "common_phrases": [
                        "absolutely rammed"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Helemaal vol, vaak gebruikt voor ruimtes met veel mensen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "stampvol",
                                "target_lang_sense_clarification": "Zeer vol, vaak gebruikt voor drukke plekken."
                            },
                            {
                                "target_lang_word": "overvol",
                                "target_lang_sense_clarification": "Te vol, meer dan de bedoeling is."
                            },
                            {
                                "target_lang_word": "afgeladen",
                                "target_lang_sense_clarification": "Helemaal vol, vaak gebruikt voor voertuigen of ruimtes."
                            }
                        ]
                    }
                }
            ]
        },
        {
