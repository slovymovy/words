                        "entry_id": "e7669ba6-bc14-3529-ac45-c278f73d486e",
                        "glosses": [
                            "Celui, celle qui s’occupe de démographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97f14a83-0678-49f4-b107-7f5a15283fa2",
                                "sense_id": "e2298add-f217-38da-9f25-2b327d57f182",
                                "text": "Comme le note un démographe, « le XXᵉ siècle aura été pour l’homme celui de l’apprentissage de la maîtrise de son destin »."
                            },
                            {
                                "example_id": "6d63d259-0226-4973-a8e7-88f1aac3f210",
                                "sense_id": "e2298add-f217-38da-9f25-2b327d57f182",
                                "text": "Alors que nous devrions être 8 milliards de Terriens mardi, le démographe Jacques Véron analyse l’accroissement de la population et ses répercussions, notamment sur l’environnement."
                            }
                        ]
                    }
