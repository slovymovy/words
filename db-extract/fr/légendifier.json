                                "example_id": "3281d670-28cd-4508-a5ce-7f9eb1bc3f04",
                                "sense_id": "5c63bc03-e4e2-333f-8911-63fdc9f8fe35",
                                "text": "A quelle date les écrivains arabes ont-ils commencé à légendifier ?"
                            }
                        ]
