                    {
                        "translation_id": "79aa4adb-1979-4b5b-8a07-e603649e9b61",
                        "source_entry_id": "1c2a51bf-086a-31b2-bfd3-e2332140343d",
                        "source_sense_id": "71bbe1c3-d7fb-3eb1-a3f1-bef742712efb",
