{
    "word_family": [
        "hostile",
        "hostilely"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                    "sense_definition": "The state or feeling of being unfriendly, antagonistic, or full of hatred toward someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unfriendliness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd showed open <w>hostility</w> toward the referee after the controversial decision.",
                            "target_lang_translations": {
                                "ru": "Толпа проявила открытую <w>враждебность</w> по отношению к судье после спорного решения.",
                                "nl": "Het publiek toonde openlijke <w>vijandigheid</w> jegens de scheidsrechter na de controversiële beslissing."
                            }
                        },
                        {
                            "text": "There was a sense of deep <w>hostility</w> between the two rival families for generations.",
                            "target_lang_translations": {
                                "ru": "Между двумя враждующими семьями на протяжении поколений ощущалась глубокая <w>вражда</w>.",
                                "nl": "Er heerste generaties lang een diepe <w>vijandschap</w> tussen de twee rivaliserende families."
                            }
                        }
                    ],
                    "synonyms": [
                        "antagonism",
                        "enmity",
                        "animosity",
                        "antipathy",
                        "hatred",
                        "unfriendliness"
                    ],
                    "antonyms": [
                        "amity",
                        "friendliness"
                    ],
                    "common_phrases": [
                        "open hostility",
                        "deep hostility",
                        "show hostility",
                        "sense of hostility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или чувство недружелюбия, антагонизма или ненависти к кому-либо или чему-либо.",
                        "nl": "De toestand of het gevoel van onvriendelijk, antagonistisch of vol haat zijn jegens iemand of iets."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враждебность",
                                "target_lang_sense_clarification": "общее состояние неприязни"
                            },
                            {
                                "target_lang_word": "вражда",
                                "target_lang_sense_clarification": "длительные неприязненные отношения"
                            },
                            {
                                "target_lang_word": "неприязнь",
                                "target_lang_sense_clarification": "чувство нерасположения или недружелюбия"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vijandigheid",
                                "target_lang_sense_clarification": "het vijandig zijn of vijandige houding"
                            },
                            {
                                "target_lang_word": "vijandschap",
                                "target_lang_sense_clarification": "langdurige wederzijdse wrok of tegenstand"
                            },
                            {
                                "target_lang_word": "hostiliteit",
                                "target_lang_sense_clarification": "formeler woord voor vijandigheid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5de9e25f-7825-3008-a6f2-f917c727d100",
                    "sense_definition": "A hostile action, especially an act of warfare or military conflict.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two nations agreed to a ceasefire to end all <w>hostility</w> in the region.",
                            "target_lang_translations": {
                                "ru": "Две страны согласились на прекращение огня, чтобы положить конец всем <w>военным действиям</w> в регионе.",
                                "nl": "De twee landen kwamen een staakt-het-vuren overeen om een einde te maken aan alle <w>vijandelijkheden</w> in de regio."
                            }
                        },
                        {
                            "text": "The sudden outbreak of <w>hostility</w> caught the international community by surprise.",
                            "target_lang_translations": {
                                "ru": "Внезапная вспышка <w>враждебности</w> застала международное сообщество врасплох.",
                                "nl": "Het plotselinge uitbreken van <w>vijandelijkheden</w> overrompelde de internationale gemeenschap."
                            }
                        }
                    ],
                    "synonyms": [
                        "war",
                        "fighting",
                        "combat"
                    ],
                    "antonyms": [
                        "peace"
                    ],
                    "common_phrases": [
                        "outbreak of hostility",
                        "end hostility",
                        "military hostility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Враждебное действие, особенно акт войны или военный конфликт.",
                        "nl": "Een vijandige daad, vooral een oorlogshandeling of militair conflict."
                    },
