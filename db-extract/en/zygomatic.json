    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "79e32ef6-b14c-3463-ae8a-cb1e752ac4eb",
                "word": "zygomatic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5e561b25-129a-3fc4-9279-50171a3d7c41",
                        "entry_id": "79e32ef6-b14c-3463-ae8a-cb1e752ac4eb",
                        "glosses": [
                            "Of, relating to, or located in the area of the zygomatic bone or zygomatic arch."
                        ],
                        "tags": [
                            "not-comparable",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "e2f83526-44df-4752-aa9c-7791abb6af89",
                                "sense_id": "5e561b25-129a-3fc4-9279-50171a3d7c41",
                                "text": "They show (1) the left orbit and zygomatic arch of President Kennedy magnified from Zapruder frame 230"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61ea56b8-bd31-4541-b06c-9cb91282437f",
                        "source_entry_id": "79e32ef6-b14c-3463-ae8a-cb1e752ac4eb",
                        "source_sense_id": "5e561b25-129a-3fc4-9279-50171a3d7c41",
                        "source_sense_description": "pertaining to the zygoma",
                        "target_lang_word": "zygomatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zygomatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ae8627e-bd18-36f0-8ee9-e6742d043d5f",
                                        "entry_id": "a9f709c6-65c4-3947-996d-adfb0b0088e5",
                                        "glosses": [
                                            "Qui appartient au zygoma, à la pommette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30c8ecd2-7d30-4a8f-a1ef-be342e8b9246",
                                                "sense_id": "4ae8627e-bd18-36f0-8ee9-e6742d043d5f",
                                                "text": "Arcade zygomatique, arcade osseuse, formée au bas de la tempe par le zygoma et le temporal."
                                            },
                                            {
                                                "example_id": "d4900269-f634-44ac-a9ca-1fdc36003c7f",
                                                "sense_id": "4ae8627e-bd18-36f0-8ee9-e6742d043d5f",
                                                "text": "Apophyse zygomatique, longue apophyse qui, de la cavité glénoïde de l’os temporal se dirige transversalement en devant pour s’articuler avec l’os malaire."
                                            },
                                            {
                                                "example_id": "fa99ec24-a681-4c61-95b9-e75a5f1b8d40",
                                                "sense_id": "4ae8627e-bd18-36f0-8ee9-e6742d043d5f",
                                                "text": "Fosse zygomatique, espace compris entre le bord postérieur de l’aile externe de l’apophyse ptérygoïde et la crête qui descend de la tubérosité malaire au bord alvéolaire supérieur."
                                            },
                                            {
                                                "example_id": "6333f7f3-f304-4c20-91e4-288977fedcdb",
                                                "sense_id": "4ae8627e-bd18-36f0-8ee9-e6742d043d5f",
                                                "text": "Muscles zygomatiques, les deux muscles qui amènent les coins de la bouche vers les oreilles, et qui agissent principalement dans l’action du rire."
                                            },
                                            {
                                                "example_id": "818b9fdc-d4c1-486d-972c-cd2674213cfb",
                                                "sense_id": "4ae8627e-bd18-36f0-8ee9-e6742d043d5f",
                                                "text": "Nerf zygomatique, l’un des rameaux du facial."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zygomatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d53f9c86-db39-372b-b83b-2307ee4f7620",
                                        "entry_id": "53684a8c-4061-3b87-8026-18f72f19b454",
                                        "glosses": [
                                            "Muscles rubanés qui descendent obliquement de la pommette à la commissure des lèvres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1377a5ab-bc56-4178-b8d0-e079b4fd0b2c",
                                                "sense_id": "d53f9c86-db39-372b-b83b-2307ee4f7620",
                                                "text": "La première de ces remarques concerne la solidarité des quinze muscles du visage qui sont synergiquement contractés et dont les plus importants sont : le frontal, l’orbiculaire des paupières, le transverse du nez, l’élévateur de l’aile du nez et de la lèvre supérieure, le petit zygomatique, le grand zygomatique et le rieur ; tous plus ou moins congénères, en sorte que la contraction des uns facilite celle des autres."
                                            },
                                            {
                                                "example_id": "ab7ef816-32ad-45d8-9af4-96bbbf52b64d",
                                                "sense_id": "d53f9c86-db39-372b-b83b-2307ee4f7620",
                                                "text": "Nonobstant leur désastreuse destinée, les hittistes n'en rigolent pas moins une bonne partie de la journée. La nature les a faits comme ça, les muristes, le dos large et le zygomatique à la retrousse."
                                            },
                                            {
                                                "example_id": "e56832c8-a6dd-4d41-b246-5a5ee39f5d2b",
                                                "sense_id": "d53f9c86-db39-372b-b83b-2307ee4f7620",
                                                "text": "Gloussements, pouffements, puis les rires finissent par éclater. Forcés, produits artificiellement, ils n'en sont pas moins communicatifs. Les abdominos travaillent, les rieurs ont la banane, au point d'en avoir mal aux zygomatiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25cebdf5-0d3e-3397-9bd0-3ac509390196",
                                        "entry_id": "53684a8c-4061-3b87-8026-18f72f19b454",
                                        "glosses": [
                                            "Os de la pommette de la joue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92b5cbd4-bf9b-4932-993d-4aa5cde9d335",
                                                "sense_id": "25cebdf5-0d3e-3397-9bd0-3ac509390196",
                                                "text": "Parce que l’ours est parti avec un bout de ma mâchoire qu’il a gardée dans la sienne, et qu’il m’a cassé le zygomatique droit, il va falloir opérer à nouveau, bientôt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1aca015-66e6-4d7e-8b87-80076150b0de",
