                "senses": [
                    {
                        "sense_id": "48555055-ac04-3c8f-bec1-ea74d003552e",
                        "entry_id": "c0d6a366-1382-3805-951c-368c885d832a",
                        "glosses": [
                            "спортсмен, профессиональный участник автомобильных гонок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d42b6d2-f707-44a4-a8ee-a6e12f7ba058",
                                "sense_id": "48555055-ac04-3c8f-bec1-ea74d003552e",
                                "text": "Многие известные автогонщики 20―30-х ― Нуволари, Варци, Розмейер ― впервые испытали пьянящее ощущение скорости, состязаясь на двухколёсных машинах."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f9ac5a8-ec42-402a-b105-6c430bf30c2d",
                        "source_entry_id": "c0d6a366-1382-3805-951c-368c885d832a",
