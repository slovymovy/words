                            "Nomen Actionis"
                        ],
                        "examples": [
                            {
                                "example_id": "c3ad9a27-2be1-4adf-bced-26fd19b306f7",
                                "sense_id": "a3271609-64b6-35da-8fa0-fdab70b6a4ee",
                                "text": "Die Verätzung war kurz, aber schmerzhaft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "16b4c1b4-c9e6-3ca6-82eb-d2a3cacc838f",
                        "entry_id": "15de5681-3196-3a32-ac92-9dd306aa27eb",
                        "glosses": [
                            "durch Kontakt mit einer Lauge oder Säure entstandene Verletzung"
                        ],
                        "tags": [
                            "Nomen Acti"
                        ],
                        "examples": [
                            {
                                "example_id": "2cdeb576-08c4-4435-84f2-6a6b20617cf2",
                                "sense_id": "16b4c1b4-c9e6-3ca6-82eb-d2a3cacc838f",
                                "text": "„Gelingt es einem Krankheitserreger, durch eine Verletzung, Verbrennung oder Verätzung in die Haut einzudringen oder über die Schleimhaut in das Gewebe vorzustoßen, wird er von einer ganzen Armee von zellulären und chemischen Abwehrsoldaten erwartet.“"
                            },
                            {
                                "example_id": "b81efdf2-07eb-4476-aec1-f7644bfd602a",
                                "sense_id": "16b4c1b4-c9e6-3ca6-82eb-d2a3cacc838f",
                                "text": "„Die Einwirkung von Natronlauge auf Haut und Schleimhäute ruft schwere Verätzungen hervor.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
