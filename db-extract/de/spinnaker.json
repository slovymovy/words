                ],
                "senses": [
                    {
                        "sense_id": "6010e5ad-fbe6-3da7-8762-26ef21921ca7",
                        "entry_id": "e9f91e32-d790-315f-ad7f-f86266481e0d",
                        "glosses": [
                            "ein großes Vorsegel, welches von Halbwind- bis Vorwindkursen gefahren wird"
                        ],
                        "tags": [
                            "Segeln"
                        ],
                        "examples": [
                            {
                                "example_id": "5d34c3db-98d4-4fe2-99f4-63f0dbcff12c",
                                "sense_id": "6010e5ad-fbe6-3da7-8762-26ef21921ca7",
                                "text": "Steuermann zum Vorschoter: „Wenn da vorne an der Tonne die Halse mit dem Spinnaker klappt, dann werden wir diese Wettfahrt gewinnen! Es kommt jetzt also darauf an, dass du den Spibaum auf der anderen Seite wirklich schnell wieder drin hast.“"
                            },
                            {
                                "example_id": "7d189a7a-8961-4bca-b5f3-f50ce75aec15",
                                "sense_id": "6010e5ad-fbe6-3da7-8762-26ef21921ca7",
                                "text": "Der Spinnaker - auch kurz Spi genannt -, hat sich auch unter Fahrtenseglern etabliert, obwohl er als ein kompliziertes und schwierig zu handhabendes Segel gilt."
                            },
                            {
                                "example_id": "bd9259a5-0572-49a7-b658-3de40f3c4bf8",
                                "sense_id": "6010e5ad-fbe6-3da7-8762-26ef21921ca7",
                                "text": "Die meisten Spinnaker sind mit roten und grünen Liekbändern versehen, damit man die Lieken besser unterscheiden kann."
                            },
                            {
                                "example_id": "a5893c34-23d9-4cac-90f3-6717f5f7e17a",
                                "sense_id": "6010e5ad-fbe6-3da7-8762-26ef21921ca7",
                                "text": "Die Rubin XII ist weiß und rot lackiert wie alle ihre Vorgängerinnen, der Spinnaker ist weißrot, die Anzüge der Crew sind rot."
                            },
                            {
                                "example_id": "c77a0fdc-52cc-4de1-883c-41e375927f84",
                                "sense_id": "6010e5ad-fbe6-3da7-8762-26ef21921ca7",
                                "text": "Dann endlich liegt der Atlantik vor ihnen: zwölf Tage und 2400 Kilometer, ein über Bord gehender Spinnakerbaum, eine zerrissene Fock und ein zerrissener Spinnaker, der sich kurz vor Erreichen des Äquators in der Schraube verhängt - mit einem Messer in der Hand taucht Stefan unters Boot."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b514555-e25d-4f91-a728-a8044f34199f",
                        "source_entry_id": "e9f91e32-d790-315f-ad7f-f86266481e0d",
                        "source_sense_id": "6010e5ad-fbe6-3da7-8762-26ef21921ca7",
                        "source_sense_description": "Sport, Segeln: ein großes Vorsegel, welches von Halbwind- bis Vorwindkursen gefahren wird",
                        "target_lang_word": "spinnaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spinnaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4dff6d3-df1e-333e-aabf-b29f6d5984a9",
                                        "entry_id": "ef86cba2-fa94-3b27-a8a4-32eddb530805",
                                        "glosses": [
                                            "A sail supplemental to the mainsail, especially a triangular one, used on yachts for running before the wind."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spinnaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dae5f58-956e-319e-8e84-9a39dfc5b784",
                                        "entry_id": "a0e8779c-691a-3f27-9827-f123fc4cfc51",
                                        "glosses": [
                                            "To sail using a spinnaker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c320f27-9b54-489e-b9da-67826c9b3352",
                                                "sense_id": "9dae5f58-956e-319e-8e84-9a39dfc5b784",
                                                "text": "On the port tack layline , you're defenseless against starboard tackers — you have to dip them , no matter how much you may lose doing it — and the wind shadow of boats spinnakering away from the mark can cost you plenty."
                                            },
                                            {
                                                "example_id": "8c1c7c82-9142-439f-851d-d0a43e154711",
                                                "sense_id": "9dae5f58-956e-319e-8e84-9a39dfc5b784",
                                                "text": "We spinnakered out into the Atlantic and, fortunately, the wind died as night fell."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
