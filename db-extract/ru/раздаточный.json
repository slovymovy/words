                    {
                        "sense_id": "cd56e918-f95d-381c-a3ea-ca3bc854b96c",
                        "entry_id": "8e74c622-b048-379d-92af-05bbef8e41fd",
                        "glosses": [
                            "distribution, dispensing, dispensation"
