                "senses": [
                    {
                        "sense_id": "76439127-060d-3668-9027-18f52ad2c27a",
                        "entry_id": "177036dd-4119-3f91-a92d-e2377549a761",
                        "glosses": [
                            "een licht gele haarkleur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d0ed89d-5b7d-4705-a0d0-37f4f76ce50c",
                                "sense_id": "76439127-060d-3668-9027-18f52ad2c27a",
                                "text": "Langs haar oor vormde teer, lichtblond dons een fijnnervige bakkebaard, die alleen in vol zonlicht zichtbaar werd."
                            },
                            {
                                "example_id": "2e009528-83fe-4518-a74f-ac217ae2bf9d",
                                "sense_id": "76439127-060d-3668-9027-18f52ad2c27a",
                                "text": "Wel werd er rond 14.30 uur via Burgernet een melding verspreid die verband houdt met de overval. De politie gaf daarin aan op zoek te zijn naar een 35-jarige man met kort lichtblond haar en een snorretje. De man zou gekleed zijn in een blauw jasje en zich verplaatsen op een oude fiets met ‘bruin/blauwe’ fietstassen. Ook is de politie op zoek naar getuigen van de overval."
                            }
                        ]
                    }
                ],
