                "senses": [
                    {
                        "sense_id": "d7e2f100-ecb2-370f-8080-ea95c23f58c0",
                        "entry_id": "16c47d55-59ca-3faf-aa39-864e9359966e",
                        "glosses": [
                            "Person, die eine Farm besitzt und diese auch meist betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1a87aa7-805c-401f-aa88-030b815a79df",
                                "sense_id": "d7e2f100-ecb2-370f-8080-ea95c23f58c0",
                                "text": "Sein Vater arbeitet als Farmer."
                            },
                            {
                                "example_id": "5a65edbe-34c6-4f66-b09d-f4c05452efc0",
                                "sense_id": "d7e2f100-ecb2-370f-8080-ea95c23f58c0",
                                "text": "„Neben dem Tor, auf einem Holzklotz, saß der Farmer.“"
                            },
                            {
                                "example_id": "ed0a6269-7ef4-47d4-8ef0-f2efeb1bf850",
                                "sense_id": "d7e2f100-ecb2-370f-8080-ea95c23f58c0",
                                "text": "„Gleichzeitig arbeiten immer mehr weiße Farmer mit moderner Agrartechnik und entlassen ihre Helfer in die Arbeitslosigkeit.“"
                            },
                            {
                                "example_id": "29f8d902-bde2-402e-95c7-7339218126b1",
                                "sense_id": "d7e2f100-ecb2-370f-8080-ea95c23f58c0",
                                "text": "„Dort wurden sie im fruchtbaren Stellenbosch Valley von Farmern für die Obst- und Gemüseernte sowie für die Weinlese eingestellt, und auch von den Fabriken, die diese Produkte verarbeiteten und verpackten.\""
                            },
                            {
                                "example_id": "910481c2-530b-4256-85f2-a1a786e5e396",
                                "sense_id": "d7e2f100-ecb2-370f-8080-ea95c23f58c0",
                                "text": "„John Fletcher stand auf der einen Seite und wartete, bis Mr. Lane den Farmer fertig bedient hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0945dd40-ed35-428e-9923-64b2399b1bf5",
                        "source_entry_id": "16c47d55-59ca-3faf-aa39-864e9359966e",
