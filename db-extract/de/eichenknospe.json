                "senses": [
                    {
                        "sense_id": "07385a0f-2df8-3b2b-8b72-97e31101b8c2",
                        "entry_id": "cf374b9c-4f6f-3f1d-ad42-158f50064f33",
                        "glosses": [
                            "die noch nicht aufgegangene, knospenförmige Blüte der Eiche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23aaea01-129c-4cad-9a0a-35e4d153e52b",
                                "sense_id": "07385a0f-2df8-3b2b-8b72-97e31101b8c2",
                                "text": "„Die Bauern sagen, der kalte Wind im Spätfrühling bläst deshalb, weil dann die Blütenknospen der Eiche aufbrechen, und tatsächlich bläst jedes Frühjahr der kalte Wind gerade um die Zeit, in der die Eichenknospen aufbrechen.“"
                            },
                            {
                                "example_id": "7ca60c77-6cd3-4ff5-b3e9-88cebacacc17",
                                "sense_id": "07385a0f-2df8-3b2b-8b72-97e31101b8c2",
                                "text": "„Im Inneren des Gallapfels (auch Folii-Galle oder Blattgalle genannt) befindet sich eine Larve, aus der im Herbst dann das immer weibliche Insekt ausschlüpft, welches je ein unbefruchtetes Ei in den Vegetationskegel der Eichenknospe legt.“"
                            },
                            {
                                "example_id": "8417fe3f-4509-4c92-8d5f-0d205a4829be",
                                "sense_id": "07385a0f-2df8-3b2b-8b72-97e31101b8c2",
                                "text": "„Die Weibchen erklettern Eichen und legen ihre Eier in eine Eichenknospe ab.“"
                            },
                            {
                                "example_id": "e4515b4f-0afc-4d4d-91bb-9e499bad0381",
                                "sense_id": "07385a0f-2df8-3b2b-8b72-97e31101b8c2",
                                "text": "„Das Weibchen der Eichengallwespe legt im Herbst ein Ei in den Vegetationskegel der Eichenknospe, wo es überwintert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
