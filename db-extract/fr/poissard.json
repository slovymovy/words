                                "sense_id": "f64ea34a-7c63-36ec-bf1e-110590147e03",
                                "text": "Jean-Baptiste Wanecque est-il un poissard de première ou cherche-t-il toujours les ennuis ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f19be2fd-2656-39ee-b70f-0c97835e9ec1",
                        "entry_id": "f53130fa-151d-341f-9e95-41e4d3a5e138",
                        "glosses": [
                            "Malchanceux, poursuivi par la déveine, la poisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f86c9919-efea-4a6f-ade0-d8fb17293698",
                                "sense_id": "f19be2fd-2656-39ee-b70f-0c97835e9ec1",
                                "text": "On est des maudits, des poissards."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5f3a55d-3b41-4fb0-b1e6-68cff3c02e10",
                        "source_entry_id": "f53130fa-151d-341f-9e95-41e4d3a5e138",
                        "target_lang_word": "Pechvogel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pechvogel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9262007c-fc0e-3c91-9599-0ad223bbfa2c",
                                        "entry_id": "0fa7c723-f0ed-391c-bb74-b779e19c4972",
                                        "glosses": [
                                            "eine Person, die wenig Glück, stattdessen viel Pech hat"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba09e0a0-04c5-44a1-bc45-edbadb412804",
                                                "sense_id": "9262007c-fc0e-3c91-9599-0ad223bbfa2c",
                                                "text": "Dieter ist ein echter Pechvogel, er hatte diese Woche schon drei Autounfälle."
                                            },
                                            {
                                                "example_id": "be510b8a-8fde-48f4-9f61-41d23bb8c812",
                                                "sense_id": "9262007c-fc0e-3c91-9599-0ad223bbfa2c",
                                                "text": "„Denn in seiner Einsiedelei sollte der Pechvogel, der bisher kein Glück im Privatleben hatte, endlich eine Gefährtin für die guten und die schlechten Tage finden.“"
                                            },
                                            {
                                                "example_id": "a05017e6-d6dc-42a8-b2bd-70b4313de51f",
                                                "sense_id": "9262007c-fc0e-3c91-9599-0ad223bbfa2c",
                                                "text": "„Andere Witzfiguren, wie den Pechvogel und Unglücksraben, den Schüchternen, Groben oder auch den Faulen, den Naschhaften, Gefräßigen oder den Trunkenbold müssen wir hier übergehen, um uns einer größeren Gruppe noch etwas eingehender zuwenden zu können: Dem Dummenwitz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
