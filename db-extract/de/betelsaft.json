                        "examples": [
                            {
                                "example_id": "1a678c2a-b12f-4017-9842-735ee7948bf5",
                                "sense_id": "75ef7ebc-d16d-3ece-9682-bc597d281297",
                                "text": "„Sie bot auf der Straße Betelsaft und klebrigen Reis in Bananenblättern feil, und ich kaufte jeden Morgen zum Frühstück ein Päckchen, in dem sich eine in Plastik eingewickelte Botschaft befand oder auch nicht.“"
                            },
                            {
                                "example_id": "91f8bc1f-cec2-453e-ac7a-718325e3fc80",
                                "sense_id": "75ef7ebc-d16d-3ece-9682-bc597d281297",
                                "text": "„Schwester Hina Alvi schluckt etwas Betelsaft, leckt einen Tropfen auf, der über ihre Unterlippe zu rinnen droht, und beugt sich lächelnd nach vorn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
