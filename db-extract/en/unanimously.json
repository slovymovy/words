                    {
                        "translation_id": "57ff0870-38ed-48b1-b8ab-40ce9acbbb6b",
                        "source_entry_id": "b65cc3d3-d0f2-3a33-8d02-e81c9957cc5d",
                        "source_sense_id": "edd6196d-e205-32e9-a8b8-6079723d8f1f",
                        "source_sense_description": "von Meinungen: einstimmig",
                        "target_lang_word": "unanimement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unanimement",
