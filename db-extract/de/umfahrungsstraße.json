                                "example_id": "4d1d4d47-c313-4937-9140-ed090b2ead42",
                                "sense_id": "85bc147a-9fa1-30a3-9412-9661138f59e3",
                                "text": "„Die Umfahrungsstraße soll bis Ende Juli fertiggestellt sein. Die Kosten werden sich laut Land auf etwa 1,5 Millionen Euro belaufen.“"
                            },
                            {
                                "example_id": "3b0d22cd-53fc-4231-b35b-eb31cb29df12",
                                "sense_id": "85bc147a-9fa1-30a3-9412-9661138f59e3",
                                "text": "„Der Bau der Umfahrungsstraße schädigt die Kernstadt Wien und bringt mehr Autoverkehr mit sich.“"
                            }
                        ],
