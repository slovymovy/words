                "senses": [
                    {
                        "sense_id": "58ee2b83-92f1-38a7-af59-04ba00e904bb",
                        "entry_id": "7a1bbb91-b6c9-340f-b168-a8b9886e368f",
                        "glosses": [
                            "osoba, która tworzy lub opracowuje antologię"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a690d666-2004-474c-86d4-f7be02d0e771",
                                "sense_id": "58ee2b83-92f1-38a7-af59-04ba00e904bb",
                                "text": "Jako antologista zebrał utwory kilkudziesięciu poetów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47f6196e-8fa4-4b46-a631-015dc7888d56",
                        "source_entry_id": "7a1bbb91-b6c9-340f-b168-a8b9886e368f",
                        "source_sense_id": "58ee2b83-92f1-38a7-af59-04ba00e904bb",
                        "target_lang_word": "anthologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da131341-b7b9-343c-b5f1-d2e3b19c4bea",
                                        "entry_id": "e375559b-c1af-35a3-a8f8-e3f3bffcaee4",
