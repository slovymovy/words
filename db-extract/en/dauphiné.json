                        "glosses": [
                            "A former province in southeastern France, centred on Grenoble."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "09122ade-fdaa-495d-8d7f-40b1a2189fb6",
                                "sense_id": "c8da9579-f9d3-3bcf-ba56-71e6be0c9523",
                                "text": "At length this sect having spread from Dauphiny into several other provinces, became very numerous in Provence."
                            },
                            {
                                "example_id": "e930e15d-14dd-4ea5-a159-a7f2557267d2",
                                "sense_id": "c8da9579-f9d3-3bcf-ba56-71e6be0c9523",
                                "text": "Linen textile production was well-developed in the north-west and in the Dauphiné, and the manufacturing of silk cloths around Lyon and Nîmes."
                            }
                        ]
                    }
                ],
