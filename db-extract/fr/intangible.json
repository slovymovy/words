                "senses": [
                    {
                        "sense_id": "a0f42e2c-406c-3d9c-8dad-affef50a824d",
                        "entry_id": "a006d1f7-9f5c-31bf-9db1-6c3dd5dc47b3",
                        "glosses": [
                            "Qui échappe au sens du toucher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "353d8b9d-31e9-40b7-8e26-48ca492bce98",
                                "sense_id": "a0f42e2c-406c-3d9c-8dad-affef50a824d",
                                "text": "Un service est tout d’abord intangible, pas directement observable, par rapport à un produit qui a une forme, est visible, solide, peut être palpé et a fait l’objet d’une série de transformations physiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "db3f2d8e-ee93-3931-9de1-6c4f2a37ddc4",
                        "entry_id": "a006d1f7-9f5c-31bf-9db1-6c3dd5dc47b3",
                        "glosses": [
                            "Qui ne peut subir d'atteinte, d'altération ; qui doit rester intact."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9391b930-4951-4f08-aeca-783a4a251b12",
                                "sense_id": "db3f2d8e-ee93-3931-9de1-6c4f2a37ddc4",
                                "text": "Pour le Pakistan, la ligne Durand, qui le sépare de l'Afghanistan, est une frontière intangible."
                            },
                            {
                                "example_id": "5529180b-2907-4379-8d81-6e98c5169eae",
                                "sense_id": "db3f2d8e-ee93-3931-9de1-6c4f2a37ddc4",
                                "text": "Protégées par le prestige des guerres de la Liberté, les institutions nouvelles étaient devenues intangibles et l’idéologie qui fut construite pour les expliquer devint comme une foi qui sembla longtemps avoir pour les Français la valeur que la révélation de Jésus a pour les catholiques."
                            }
                        ]
                    }
                ],
