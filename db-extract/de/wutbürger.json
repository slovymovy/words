                                        "sense_id": "58ba27f7-3e4f-32e4-92fc-0b17c2621b47",
                                        "entry_id": "782ed92c-667f-3d64-be1b-4dec17e6d029",
                                        "glosses": [
                                            "Participe passé masculin singulier de enrager."
                                        ],
