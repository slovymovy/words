                "translations": [
                    {
                        "translation_id": "0c632df7-d5f3-47af-80c5-0430928443ff",
                        "source_entry_id": "d11c5aba-c5b9-3e3d-91d0-9fd1568f75d5",
                        "target_lang_word": "amuser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amuser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfccf329-02e6-33aa-a9e6-67a8ba280b84",
                                        "entry_id": "bd8a785a-fbc6-3662-9bd3-0cdb468b2fd5",
                                        "glosses": [
                                            "Divertir par des choses agréables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fbd0cf1-fb93-4222-b6f2-130ddfaf00f2",
                                                "sense_id": "cfccf329-02e6-33aa-a9e6-67a8ba280b84",
                                                "text": "[…] ils obtenaient les profits moraux et maté­riels que procure la célébrité à tous les virtuoses, dans une société qui est habituée à payer cher ce qui l’amuse."
                                            },
                                            {
                                                "example_id": "7f2ede90-9589-4b24-80b0-802beca58e05",
                                                "sense_id": "cfccf329-02e6-33aa-a9e6-67a8ba280b84",
                                                "text": "En attendant le souper, on amusa la société par un concert."
                                            },
                                            {
                                                "example_id": "fc19fffb-4cc8-4b42-ab08-84eb30e4594c",
                                                "sense_id": "cfccf329-02e6-33aa-a9e6-67a8ba280b84",
                                                "text": "C’est un homme qui a l’art d’amuser agréablement ceux qui vont chez lui."
                                            },
                                            {
                                                "example_id": "a4c280dc-cd62-4f4a-bd0c-8e3009609502",
                                                "sense_id": "cfccf329-02e6-33aa-a9e6-67a8ba280b84",
                                                "text": "Il ne pense qu’à s’amuser."
                                            },
                                            {
                                                "example_id": "5322713c-5e1b-4327-948c-f7bbcbf8c3ab",
                                                "sense_id": "cfccf329-02e6-33aa-a9e6-67a8ba280b84",
                                                "text": "À force de s’amuser, il a ruiné sa santé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3b6b4c4-980d-3e85-8264-e042c1e2920e",
                                        "entry_id": "bd8a785a-fbc6-3662-9bd3-0cdb468b2fd5",
                                        "glosses": [
                                            "Faire perdre le temps ; distraire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "573085f0-198d-45ea-8ca8-8a6485d8a2ef",
                                                "sense_id": "a3b6b4c4-980d-3e85-8264-e042c1e2920e",
                                                "text": "[…], des frères de charité avec leurs dalmatiques rouges, dont l’un portait une bannière et l’autre la lourde croix d’argent, riaient en dessous, s’amusaient à se bourrer le dos de coups de poing."
                                            },
                                            {
                                                "example_id": "d43bfb86-e069-4788-a23d-32f496a9cc6e",
                                                "sense_id": "a3b6b4c4-980d-3e85-8264-e042c1e2920e",
                                                "text": "Hélène, avec la patience mélancolique des malades, s’amusait à entortiller autour de ses doigts une chaînette d’argent qui lui servait de bracelet."
                                            },
                                            {
                                                "example_id": "0ae9e574-6026-427b-bdc2-9a33f1e77585",
                                                "sense_id": "a3b6b4c4-980d-3e85-8264-e042c1e2920e",
                                                "text": "Tavannes remit la pie sur son bâton, et s’amusa à rouler et à dérouler les oreilles d’un lévrier."
                                            },
                                            {
                                                "example_id": "0bc1a49b-f82d-4b65-a2a9-ea6d7c867230",
                                                "sense_id": "a3b6b4c4-980d-3e85-8264-e042c1e2920e",
                                                "text": "Ne vous amusez pas, on vous attend."
                                            },
                                            {
                                                "example_id": "e3725e17-b620-4127-b01e-004393ae86ff",
                                                "sense_id": "a3b6b4c4-980d-3e85-8264-e042c1e2920e",
                                                "text": "T’as donc pas fini de m’amuser avec tes âneries ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "542bcf99-5abb-3a8a-8de8-b251106fe8a7",
                                        "entry_id": "bd8a785a-fbc6-3662-9bd3-0cdb468b2fd5",
                                        "glosses": [
                                            "Repaître de vaines promesses, de fausses espérances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b82c0f5e-abe1-4e9f-8866-1c68d4b3e824",
                                                "sense_id": "542bcf99-5abb-3a8a-8de8-b251106fe8a7",
                                                "text": "Il l’amuse de belles paroles."
                                            },
                                            {
                                                "example_id": "5e2d2841-0a14-40cd-801b-5210c5fb0d62",
                                                "sense_id": "542bcf99-5abb-3a8a-8de8-b251106fe8a7",
                                                "text": "Il y a trois ans qu’il l’amuse de la sorte."
                                            },
                                            {
                                                "example_id": "e8f1f408-30ec-4da5-8615-5d8b2a85668d",
                                                "sense_id": "542bcf99-5abb-3a8a-8de8-b251106fe8a7",
                                                "text": "Amuser l’ennemi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ecf827d-00a6-3043-a5e0-a81a29c1507c",
                                        "entry_id": "bd8a785a-fbc6-3662-9bd3-0cdb468b2fd5",
                                        "glosses": [
                                            "S’occuper par simple divertissement."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc11d3e3-96b8-46eb-b596-72b4fc6c2f73",
                                                "sense_id": "7ecf827d-00a6-3043-a5e0-a81a29c1507c",
                                                "text": "Les enfants s’amuseront énormément à préparer les recettes présentées dans \" Les petits cuisiniers \", et ils se feront un plaisir de déguster leur chef-d’œuvre."
                                            },
                                            {
                                                "example_id": "a2b642cb-ddb7-4c17-9327-f8e75643e054",
                                                "sense_id": "7ecf827d-00a6-3043-a5e0-a81a29c1507c",
                                                "text": "Je me suis amusé à rechercher comment, tel journaliste sérieux et compétent, tel historien, tel psychologue, avaient pu reprendre à leur compte la fable du 80%; chacun en fait la répétait pour l'avoir trop souvent lue."
                                            },
                                            {
                                                "example_id": "d3b642ad-9be0-450c-81a7-c9fe559e07b3",
                                                "sense_id": "7ecf827d-00a6-3043-a5e0-a81a29c1507c",
                                                "text": "Gladys raconta que son mari, en reportage à Bucarest, « s’amusait sûrement là-bas avec de belles Roumaines » : aussi pourquoi ne « s'enjoyerait-elle » pas de son côté ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "601f06fc-19e2-39d5-8a90-2e8b8c98421f",
                                        "entry_id": "bd8a785a-fbc6-3662-9bd3-0cdb468b2fd5",
                                        "glosses": [
                                            "Se moquer de quelqu’un."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9727119d-7252-4225-8b3e-e6661ae3a643",
                                                "sense_id": "601f06fc-19e2-39d5-8a90-2e8b8c98421f",
                                                "text": "Il s’amuse de moi !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7171eb7d-555b-44ae-8d85-63ed29d76396",
                        "source_entry_id": "d11c5aba-c5b9-3e3d-91d0-9fd1568f75d5",
                        "target_lang_word": "divertir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divertir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be7b743b-e9c4-3c14-840b-9789d1d5df41",
                                        "entry_id": "fbb8f466-3607-38c2-a3d9-531d8ab0f676",
                                        "glosses": [
                                            "Détourner de ce qui préoccupe, fatigue, ennuie en amusant, en récréant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42b843fc-b026-4f24-8788-d838afb926a6",
                                                "sense_id": "be7b743b-e9c4-3c14-840b-9789d1d5df41",
                                                "text": "Dès que tout fut en ordre, les industrieux animaux [les castors] prirent un moment de récréation, se poursuivant dans l’étang, plongeant au fond de l’eau ou jouant à la surface, en frappant à grand bruit l’eau de leurs queues. […]. Tandis que les premiers se divertissaient ainsi, deux autres membres de la communauté parurent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ff35c47-cf62-310a-b9e3-86f9ecb126f0",
                                        "entry_id": "fbb8f466-3607-38c2-a3d9-531d8ab0f676",
                                        "glosses": [
                                            "Détourner d’une occupation, d’un dessein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4174a6b0-1c64-489d-a2ba-6114bceda59e",
                                                "sense_id": "0ff35c47-cf62-310a-b9e3-86f9ecb126f0",
                                                "text": "Divertir quelqu’un de ses travaux. - Il avait formé un projet peu raisonnable, je l’en ai diverti."
                                            },
                                            {
                                                "example_id": "12314b48-71ee-43b9-9aa0-edcca83af072",
                                                "sense_id": "0ff35c47-cf62-310a-b9e3-86f9ecb126f0",
                                                "text": "Ces gronderies, qui eurent un funeste résultat pour Pierrette, ramenèrent les deux célibataires vers l’ancienne ornière commerciale d’où leur établissement à Provins les avait divertis, et où leur nature allait s’épanouir et fleurir."
                                            },
                                            {
                                                "example_id": "43e71477-d439-46e3-91be-8229fb951070",
                                                "sense_id": "0ff35c47-cf62-310a-b9e3-86f9ecb126f0",
                                                "text": "Les larmes d’Yves jaillirent enfin, et Jean-Louis en éprouva du soulagement. Lui, demeurait calme, – diverti de sa douleur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c8e4120-78fd-3458-ac32-ebd1415921e7",
                                        "entry_id": "fbb8f466-3607-38c2-a3d9-531d8ab0f676",
                                        "glosses": [
                                            "Faire diversion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f76784f9-b700-36ed-a4fe-e58cdcd1c793",
                                        "entry_id": "fbb8f466-3607-38c2-a3d9-531d8ab0f676",
                                        "glosses": [
                                            "Soustraire, dérober, s’approprier illégitimement."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51da092c-d45c-47f7-88a6-823cb9a291cf",
                                                "sense_id": "f76784f9-b700-36ed-a4fe-e58cdcd1c793",
                                                "text": "Il avait diverti plusieurs des effets de la succession. - Divertir des papiers importants. - On l’accuse d’avoir diverti les fonds qui lui étaient confiés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
