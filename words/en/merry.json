                            }
                        },
                        {
                            "text": "I am meeting my friend <w>Merry</w> for lunch today.",
                            "target_lang_translations": {
                                "ru": "Я сегодня встречаюсь со своей подругой <w>Мерри</w> за обедом."
                            }
