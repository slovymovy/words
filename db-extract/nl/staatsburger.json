                ],
                "senses": [
                    {
                        "sense_id": "83095a75-f861-388a-9144-8a72fb787cdd",
                        "entry_id": "b3709d0c-bbeb-34af-84ad-6fcb178b38a9",
                        "glosses": [
                            "iemand die burgerrechten in een staat heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8ae0354-c892-4786-933e-8a23ac15c762",
                                "sense_id": "83095a75-f861-388a-9144-8a72fb787cdd",
                                "text": "De staatsburgers demonstreerden tegen de aanname van de nieuwe wet."
                            },
                            {
                                "example_id": "ae446ffa-aaf3-4fc4-80b6-94e73370a5d8",
                                "sense_id": "83095a75-f861-388a-9144-8a72fb787cdd",
                                "text": "Je heet, je moet me de uitspraak niet kwalijk nemen, ging hij verder, nog steeds met diezelfde vreemde blik, je heet Eric Henri Oscar Lauritz Letang. En je bent Frans staatsburger."
                            },
                            {
                                "example_id": "9907e672-f438-4518-91ed-3ee76e7aa29e",
                                "sense_id": "83095a75-f861-388a-9144-8a72fb787cdd",
                                "text": "Nieuwe socialistische wetten gaven deze instanties het recht om ook als de buitenlandreizigers onberispelijke staatsburgers waren naar smokkelgeld te zoeken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0eb8f349-f593-4aad-8a44-960c634a3110",
                        "source_entry_id": "b3709d0c-bbeb-34af-84ad-6fcb178b38a9",
                        "source_sense_id": "83095a75-f861-388a-9144-8a72fb787cdd",
                        "source_sense_description": "iemand die burgerrechten in een staat heeft",
                        "target_lang_word": "Staatsbürger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staatsbürger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fedd9371-65f5-30aa-aa8b-2e989a020954",
                                        "entry_id": "0d625a23-8961-3f2c-b587-16ae0f69addb",
                                        "glosses": [
                                            "Angehöriger eines Staates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90bac686-a5a4-4757-9917-585b895004d9",
                                                "sense_id": "fedd9371-65f5-30aa-aa8b-2e989a020954",
                                                "text": "Alle Staatsbürger sind aufgerufen, sich an den Wahlen zu beteiligen."
                                            },
                                            {
                                                "example_id": "3d5b6d6b-735f-4c0a-b25b-f67bb24f3fb7",
                                                "sense_id": "fedd9371-65f5-30aa-aa8b-2e989a020954",
                                                "text": "„[…] Ende Januar wurde zudem ein deutscher Staatsbürger entführt und wird seitdem von einem Stamm gefangen gehalten, der damit Druck auf die Regierung ausüben will, um zwei in Sanaa inhaftierte Stammesangehörige freizupressen.“"
                                            },
                                            {
                                                "example_id": "4647729e-15f5-4368-bf55-830720faf2c5",
                                                "sense_id": "fedd9371-65f5-30aa-aa8b-2e989a020954",
                                                "text": "„Jüngst veröffentlichten Daten zufolge verlassen täglich nahezu tausend türkische Staatsbürger das Land auf legalen Wegen.“"
                                            },
                                            {
                                                "example_id": "fb11cf1d-47a4-4eee-81db-390518f3ab43",
                                                "sense_id": "fedd9371-65f5-30aa-aa8b-2e989a020954",
                                                "text": "„Apropos Bürger: Im 15. und 16. Jahrhundert hat es den Staatsbürger in unserem Sinne noch gar nicht gegeben.“"
                                            },
                                            {
                                                "example_id": "68779624-1522-4335-935e-9646ab82cdcb",
                                                "sense_id": "fedd9371-65f5-30aa-aa8b-2e989a020954",
                                                "text": "„Natürlich hätte ich das wissen müssen, als erwachsener Staatsbürger und ›vollverantwortliche männliche Person‹, aber ich wußte es einfach nicht, so wie ich bis vor kurzem nicht wußte, daß man Weißwein kalt und Rotwein angewärmt serviert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b288cb5-82df-41e1-8646-42dc133469f2",
                        "source_entry_id": "b3709d0c-bbeb-34af-84ad-6fcb178b38a9",
                        "source_sense_id": "83095a75-f861-388a-9144-8a72fb787cdd",
                        "source_sense_description": "iemand die burgerrechten in een staat heeft",
                        "target_lang_word": "citizen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "citizen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da345249-1dd6-3114-9f19-497b24828b49",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A resident of a city or town, especially one with legally recognized rights or duties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d13012-078e-479c-9000-66ca7c0fcdad",
                                                "sense_id": "da345249-1dd6-3114-9f19-497b24828b49",
                                                "text": "[T]hat large body of the working men who were not counted as citizens and had not so much as a vote to serve as an anodyne to their stomachs were likely to get impatient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A legally recognized member of a state, with associated rights and obligations; a person considered in terms of this role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb44d00e-cc7f-4195-b9c0-eb8a20dd1cfe",
                                                "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                                "text": "I am a Roman citizen."
                                            },
                                            {
                                                "example_id": "ada4b222-0dd6-4f0e-8e09-3086b4b59b98",
                                                "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                                "text": "Assistant: You'll meet with the managing director and Dr Sinita Brahmachari, the engineer who designed the chair.\nPeter Mackenzie: Indian, is he?\nAssistant: She is a British citizen, Minister. Born in Coventry."
                                            },
                                            {
                                                "example_id": "20e989f2-1d1d-40e8-8d7c-aee57d9f43c9",
                                                "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                                "text": "Libertarian paternalism is the view that, because the way options are presented to citizens affects what they choose, society should present options in a way that “nudges” our intuitive selves to make choices that are more consistent with what our more deliberative selves would have chosen if they were in control."
                                            },
                                            {
                                                "example_id": "a8faac22-f95c-4c36-9297-17a0ee3cae2b",
                                                "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                                "text": "He is also a citizen of Antigua, because he purchased a home – where he now resides with his family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a51ccc71-2fd5-3085-800f-e01af95005cd",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "An inhabitant or occupant: a member of any place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fdafd5d-ba2c-48a1-accd-6a006de13e03",
                                                "sense_id": "a51ccc71-2fd5-3085-800f-e01af95005cd",
                                                "text": "Diogenes reckoned himself a citizen of the world."
                                            },
                                            {
                                                "example_id": "3d96c168-5fa4-4c8b-933f-f895b775fd95",
                                                "sense_id": "a51ccc71-2fd5-3085-800f-e01af95005cd",
                                                "text": "A jellyfish... carries poison cells that can sting other citizens of the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf5c5c64-3ca2-3add-bdfd-adb3a4e359d8",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A resident of the heavenly city or (later) of the kingdom of God: a Christian; a good Christian."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad3b978a-95d4-34a7-b748-2c7e56352fd4",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A civilian, as opposed to a police officer, soldier, or member of some other specialized (usually state) group."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6eb707cd-5377-36d0-9a2a-c7d455f6a489",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "An ordinary person, as opposed to nobles and landed gentry on one side and peasants, craftsmen, and laborers on the other."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec0162a3-fc2b-44f1-a36b-11a6676b669f",
                                                "sense_id": "6eb707cd-5377-36d0-9a2a-c7d455f6a489",
                                                "text": "[W]ould Mr. Delvile, who hardly ever spoke but to the high-born, without seeming to think his dignity somewhat injured, deign to receive for a daughter in law the child of a citizen and tradesman?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2436c10e-c0f9-3f80-9e66-8649890e4d87",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A term of address among supporters of the French Revolution in France or elsewhere; (later, dated) a term of address among socialists and communists."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "historical",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40b38505-a36c-47b2-ad0e-8a672d303113",
                                                "sense_id": "2436c10e-c0f9-3f80-9e66-8649890e4d87",
                                                "text": "Citizen, I desire nothing more than to get to Paris, though I could dispense with the escort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05426ce7-2511-35b4-90ae-898f4de551d1",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A notional inhabitant of a software system; an object or a software application."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ff3b5fe-d30b-4384-be71-be75784d5249",
                                                "sense_id": "05426ce7-2511-35b4-90ae-898f4de551d1",
                                                "text": "The HIG delivers Apple's design commandments, the company's definition of what it means to be a good iPhone citizen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3424261-3968-456a-ad3e-fb5e914843fb",
                        "source_entry_id": "b3709d0c-bbeb-34af-84ad-6fcb178b38a9",
                        "source_sense_id": "83095a75-f861-388a-9144-8a72fb787cdd",
                        "source_sense_description": "iemand die burgerrechten in een staat heeft",
                        "target_lang_word": "citoyen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "citoyen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12d06ff0-a7b2-3d58-a02e-93b2bc298a22",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Homme libre de l’Empire romain, doté de droits politiques dans une cité. En 212, l’empereur Caracalla étend le droit de citoyenneté romaine à l’ensemble des hommes libres de l’empire romain."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fce926e1-42cf-3fd0-93d9-d510ebe7fa0c",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Homme libre appartenant au corps civique dans les cités de la Grèce antique."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f916cf68-3f96-43cb-8a70-666f357b83cb",
                                                "sense_id": "fce926e1-42cf-3fd0-93d9-d510ebe7fa0c",
                                                "text": "Si les thètes sont citoyens d’Athènes, c’est parce que leurs parents étaient citoyens d’Athènes et ainsi de suite comme cela jusqu'à… Erichthonios."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Personne faisant partie de ceux qui, dans un État organisé, jouissent des mêmes droits et obéissent aux mêmes lois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6127c51-9104-46cb-a234-950b5d637db6",
                                                "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                                "text": "Il faut entrer de force dans le domicile du citoyen : il faut arrêter administrativement l’homme qui ne peut être arrêté qu’en vertu d’une loi ; il faut violer la liberté de l’opinion et la liberté individuelle ; il faut en un mot mettre en péril la constitution même de l’État."
                                            },
                                            {
                                                "example_id": "47c1fb76-7513-48bf-b897-59bfa1622da9",
                                                "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                                "text": "Nous sommes militaires, en France, et nous sommes citoyens. Autre motif d’orgueil, que d’être citoyen ! Cela consiste pour les pauvres à soutenir et à conserver les riches dans leur puissance et leur oisiveté. Ils y doivent travailler devant la majestueuse égalité des lois, qui interdit au riche comme au pauvre de coucher sous les ponts, de mendier dans les rues et de voler du pain. C’est un des bienfaits de la Révolution."
                                            },
                                            {
                                                "example_id": "114c75bd-15a0-4118-b55a-2406dd015ebb",
                                                "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                                "text": "Sumner Maine fait observer que les rapports des gouvernements et des citoyens ont été bouleversés de fond en comble depuis la fin du XVIIIᵉ siècle […]"
                                            },
                                            {
                                                "example_id": "55eea921-3305-4e01-8fe1-aeaf3ea6a153",
                                                "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                                "text": "À ce moment, la guerre tomba brutalement, sans crier gare. Le deuxième jour de mobilisation, Fagerolle se vit jeté dans un wagon à bestiaux, parmi les vomissures et les gueulements patriotiques d’un certain nombre de citoyens français."
                                            },
                                            {
                                                "example_id": "83e94972-b340-4220-a2fd-355c6df57459",
                                                "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                                "text": "Pourquoi ne ferions nous pas bûcher davantage nos citoyens afin de pouvoir dorloter nos citoyennes ? Cela serait profondément naturel et juste."
                                            },
                                            {
                                                "example_id": "61532504-8413-408f-b973-3f1b056a46b5",
                                                "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                                "text": "Les jurisconsultes civils donnèrent aussi leur avis et Valin dans son Commentaire sur l’Ordonnance de la Marine déclara « que les philosophes (sic) qui désapprouvaient la guerre de course étaient de mauvais citoyens. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55884138-6401-3218-879b-dd124bd91148",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Personne faisant partie de ceux qui, dans un État organisé, jouissent des mêmes droits et obéissent aux mêmes lois.",
                                            "En particulier, qualités civiques attendue de cette personne dans ses décisions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd1feab-3298-4238-84cf-de085a631b72",
                                                "sense_id": "55884138-6401-3218-879b-dd124bd91148",
                                                "text": "Moi je suis Français, j'agis, je pense, je me décide en tant que citoyen français, j'ai été élevé dans le culte de cette République qui ne reconnaît que des citoyens français et je suis profondément outré par cette réduction permanente dans un sens ou dans l'autre"
                                            },
                                            {
                                                "example_id": "c7d7eb32-b6e4-4f0e-b931-54f8614ace2a",
                                                "sense_id": "55884138-6401-3218-879b-dd124bd91148",
                                                "text": "Résister à la bêtise est donc un devoir fondamental du citoyen dont la dignité est étroitement liée au fait qu’il est un « être doué de raison et de conscience"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e014c70-073c-3071-9544-e2bc32aabc5b",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Celui qui habite dans une ville et y jouit du droit de cité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14ac9661-4098-4176-9c77-ca843c2d4c17",
                                                "sense_id": "6e014c70-073c-3071-9544-e2bc32aabc5b",
                                                "text": "Quant aux citoyens de Tours, ils accueillirent pacifiquement le général gallo-romain, qui prit possession de la place au nom du roi Sighebert."
                                            },
                                            {
                                                "example_id": "ea3ae037-f582-4224-a839-7ec576893f19",
                                                "sense_id": "6e014c70-073c-3071-9544-e2bc32aabc5b",
                                                "text": "\"Puisque j'ai essuyé, dit-il, un si cruel caprice d'une fille élevée à la cour, il faut que j'épouse une citoyenne.\" Il choisit Azora, la plus sage et la mieux née de la ville."
                                            },
                                            {
                                                "example_id": "658e6e8e-ca06-4446-93de-701d6563b518",
                                                "sense_id": "6e014c70-073c-3071-9544-e2bc32aabc5b",
                                                "text": "Quoiqu’il résidât dans la ville principale de Mars, Ulfète, nulle cité ne le réclamait comme citoyen."
                                            },
                                            {
                                                "example_id": "081e4228-271f-4de9-b3f2-cc56489a821b",
                                                "sense_id": "6e014c70-073c-3071-9544-e2bc32aabc5b",
                                                "text": "Ces tensions entre citoyens et élus traduisent le pourrissement de la situation depuis l’installation, le 24 septembre 2021, des consommateurs de crack du jardin d’Éole sur le site de Forceval, adjacent à la porte de la Villette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28136bcb-7c69-31a3-a5e9-33724b9b4bf0",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Appellation que, dans certains milieux, en particulier pendant la Révolution française, on substitue à monsieur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64cd5a65-5594-32db-b74d-757876ffe972",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Type, gars, individu."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3adb093b-aff3-4a31-a8a4-00bd0e5471c4",
                                                "sense_id": "64cd5a65-5594-32db-b74d-757876ffe972",
                                                "text": "– Eh bien ! dites donc ! Il est drôlement malade, le citoyen !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "citoyen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bdbc93a-0105-38d7-b6ad-2b386925cf83",
                                        "entry_id": "c0e3f69d-76f7-3992-96e5-37baa8cc5cc7",
                                        "glosses": [
                                            "(Par apposition) Qui est citoyen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0748fb35-f65d-4cc9-b2df-287a49b49f08",
                                                "sense_id": "9bdbc93a-0105-38d7-b6ad-2b386925cf83",
                                                "text": "Louis-Philippe, le roi-citoyen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d45b683a-6de1-316f-b9ae-26c202c55307",
                                        "entry_id": "c0e3f69d-76f7-3992-96e5-37baa8cc5cc7",
                                        "glosses": [
                                            "Qui se rapporte à la citoyenneté ou au civisme."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29822029-b434-4f64-8506-a3066e99ed8a",
                                                "sense_id": "d45b683a-6de1-316f-b9ae-26c202c55307",
                                                "text": "Un sursaut citoyen est nécessaire."
                                            },
                                            {
                                                "example_id": "701dfc50-bc9b-4c0a-8e55-bc98d405eb99",
                                                "sense_id": "d45b683a-6de1-316f-b9ae-26c202c55307",
                                                "text": "Le Mouvement républicain et citoyen (MRC) est un parti politique français de gauche républicaine qui a été fondé en 2003,"
                                            },
                                            {
                                                "example_id": "d4d2d3d5-f3c7-441b-bfcb-8cb6fb251215",
                                                "sense_id": "d45b683a-6de1-316f-b9ae-26c202c55307",
                                                "text": "Mais faire un petit effort pour écarter les fautes d'orthographe et de grammaire est un acte citoyen : il démontre un souci de l'autre, un respect pour la conversation en cours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
