                        "entry_id": "44ea9153-f941-3ec2-bd81-2a37cd9f61fc",
                        "glosses": [
                            "Réduction ou élimination des matières radioactives, chimiques ou biologiques déposées sur une installation, un espace découvert, un matériel ou du personnel."
                        ],
                        "tags": [
                            "Nucléaire"
                        ],
                        "examples": [
                            {
                                "example_id": "ab6acfe7-134b-4279-8e1e-87a9a5646d72",
                                "sense_id": "20fc0a2f-3e86-304c-a963-62cbef31f743",
                                "text": "Toutefois, il est évident que les relâchements de radioactivité seront considérablement réduits si, par un procédé continu de décontamination, on maintient dans le circuit primaire des concentrations en isotopes radioactifs aussi faibles que possible."
                            }
                        ]
                    }
