                    {
                        "translation_id": "9ebb2b2c-c75b-4b23-9289-44f37a178be5",
                        "source_entry_id": "f971f97e-a98d-3070-89c8-d9bba2509154",
                        "source_sense_description": "Suitable for cuddling",
                        "target_lang_word": "câlin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "câlin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a6e2f7b-b6d7-3a7a-9054-3c22dd8def02",
                                        "entry_id": "8978313a-9e6b-33cb-a41e-64b7d5dd6c60",
                                        "glosses": [
                                            "Étreinte affectueuse, câlinerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b8d9aad-c686-4396-81cd-0ff1a79c3480",
                                                "sense_id": "0a6e2f7b-b6d7-3a7a-9054-3c22dd8def02",
                                                "text": "Et à force de t’casser les couilles avec ses bisous, ses câlins tout ça, elle te transforme : t’étais le dernier des thugs, tu deviens le premier des caniches, laisse tomber ! C'est un truc de ouf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e87061a-bb0d-333f-9c7b-455cb5216c14",
                                        "entry_id": "8978313a-9e6b-33cb-a41e-64b7d5dd6c60",
