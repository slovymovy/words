                "senses": [
                    {
                        "sense_id": "e24fe424-fa8d-3318-9bb1-231a130f698b",
                        "entry_id": "5d8d95ff-b3e7-3dc3-bed8-00298cd22956",
                        "glosses": [
                            "Relatif à la mesure de la masse volumique."
                        ],
                        "tags": [
                            "obsolete",
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "191d3a96-1026-4d55-82a2-7949d97b7df3",
                                "sense_id": "e24fe424-fa8d-3318-9bb1-231a130f698b",
                                "text": "En égalisant les grains de cette espèce de poudre, on trouve les densités gravimétriques suivantes : […].\n La densité gravimétrique de la poudre augmente de plus en plus à mesure que les grains deviennent plus gros."
                            }
                        ]
                    },
                    {
                        "sense_id": "cacb1995-f75e-3c89-95ee-950c11dc7e09",
                        "entry_id": "5d8d95ff-b3e7-3dc3-bed8-00298cd22956",
                        "glosses": [
                            "Relatif à la gravimétrie : mesure de la gravité."
                        ],
                        "tags": [
                            "Géophysique"
                        ],
                        "examples": [
                            {
                                "example_id": "b0fada0e-4065-46f8-9cde-95ef725d4896",
                                "sense_id": "cacb1995-f75e-3c89-95ee-950c11dc7e09",
                                "text": "Il est souvent intéressant d’interpréter conjointement des cartes magnétiques et gravimétriques qui intéressent le même bassin."
                            },
                            {
                                "example_id": "66eb21b2-101f-4817-95f8-a3369c91df81",
                                "sense_id": "cacb1995-f75e-3c89-95ee-950c11dc7e09",
                                "text": "La méthode gravimétrique reste essentiellement une technique rapide et économique de reconnaissance des bassins. Lors d’une exploration plus détaillée, si l’on ne dispose pas de l'apport complémentaire d’une autre technique de reconnaissance, l’interprétation des cartes gravimétriques n’est jamais définitive."
                            }
                        ]
                    },
                    {
                        "sense_id": "a91955ea-829e-3ede-aa29-5b36116ddf68",
                        "entry_id": "5d8d95ff-b3e7-3dc3-bed8-00298cd22956",
                        "glosses": [
                            "Relatif à la gravimétrie : mesure de la masse."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "9662ac83-1614-4f61-bdac-8525eb715dc8",
                                "sense_id": "a91955ea-829e-3ede-aa29-5b36116ddf68",
                                "text": "Lors d’un titrage gravimétrique, un petit flacon en polyéthylène équipé d’un embout effilé est utilisé comme distributeur de solution."
                            }
                        ]
                    }
