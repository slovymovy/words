{
    "word_family": [
        "millennium",
        "millennialism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0a275d69-2da7-30e7-961c-7c16c059e406",
                    "sense_definition": "Relating to the generation born between the early 1980s and mid-1990s.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "generation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>millennial</w> generation grew up during the rapid rise of the internet.",
                            "target_lang_translations": {
                                "zh": "<w>千禧一代</w>是在互联网飞速发展时期成长起来的。"
                            }
                        },
                        {
                            "text": "Many companies are trying to understand the unique <w>millennial</w> work culture.",
                            "target_lang_translations": {
                                "zh": "许多公司正试图理解独特的<w>千禧一代</w>工作文化。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "millennial generation",
                        "millennial trend"
                    ],
                    "target_lang_definitions": {
                        "zh": "指代出生于20世纪80年代初至90年代中期的一代人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "千禧一代的",
                                "target_lang_sense_clarification": "形容词，用于描述与该世代相关的特征或文化。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5855b78-3139-37e1-a84d-b3f39da503d4",
                    "sense_definition": "Relating to the beginning or end of a millennium.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city hosted a large <w>millennial</w> celebration to mark the year 2000.",
                            "target_lang_translations": {
                                "zh": "这座城市举办了一场盛大的<w>千禧年</w>庆典以纪念2000年。"
                            }
                        },
                        {
                            "text": "There was a lot of anxiety about <w>millennial</w> computer bugs at the turn of the century.",
                            "target_lang_translations": {
                                "zh": "世纪之交时，人们对<w>千禧年</w>电脑故障感到非常焦虑。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与千禧年开始或结束相关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "千禧年的",
                                "target_lang_sense_clarification": "指代跨越千年交替时期的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edc7d7c4-8149-3c15-8886-37a0c23ce534",
                    "sense_definition": "Relating to the belief in a future thousand-year period of peace and righteousness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preacher spoke about the <w>millennial</w> kingdom promised in the scriptures.",
                            "target_lang_translations": {
                                "zh": "牧师讲述了经文中应许的<w>千禧年</w>王国。"
                            }
                        },
                        {
                            "text": "Some groups held strong <w>millennial</w> expectations as the century drew to a close.",
                            "target_lang_translations": {
                                "zh": "随着世纪临近结束，一些团体怀有强烈的<w>千禧年</w>期盼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "millenarian"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in historical or theological contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与相信未来会出现一千年和平与正义时期的信仰相关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "千禧年主义的",
                                "target_lang_sense_clarification": "宗教或神学语境下，指代关于千年王国的信仰。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d49ca088-05dc-37ed-8667-7f386a0db463",
                    "sense_definition": "Relating to a thousandth anniversary.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The town organized a <w>millennial</w> fair to celebrate its founding a thousand years ago.",
                            "target_lang_translations": {
                                "zh": "小镇组织了一场<w>千年</w>博览会，以庆祝其建镇一千年。"
                            }
                        },
                        {
                            "text": "A special coin was minted for the <w>millennial</w> anniversary of the cathedral.",
                            "target_lang_translations": {
                                "zh": "为纪念大教堂建成<w>千年</w>，特意铸造了一枚纪念币。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与一千周年纪念相关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "千年的",
                                "target_lang_sense_clarification": "指代一千周年纪念。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "097cd7b9-aa99-3ba0-a8f7-cb52e3e74b39",
                    "sense_definition": "Existing for a thousand years.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest is home to <w>millennial</w> trees that have stood since the Middle Ages.",
                            "target_lang_translations": {
                                "zh": "这片森林里生长着自中世纪以来就屹立不倒的<w>千年</w>古树。"
                            }
                        },
                        {
                            "text": "Archaeologists discovered <w>millennial</w> ruins buried deep beneath the desert sands.",
                            "target_lang_translations": {
                                "zh": "考古学家在沙漠深处发现了埋藏已久的<w>千年</w>遗迹。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary or formal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "存在了一千年的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "千年的",
                                "target_lang_sense_clarification": "形容事物历史悠久，持续时间长达千年。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "741f7904-1ab4-382d-904f-ff9042e7f829",
                    "sense_definition": "Occurring every thousand years.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are studying the <w>millennial</w> cycle of these rare geological events.",
                            "target_lang_translations": {
                                "zh": "科学家们正在研究这些罕见地质事件的<w>千年</w>周期。"
                            }
                        },
                        {
                            "text": "The comet follows a <w>millennial</w> orbit around the sun.",
                            "target_lang_translations": {
                                "zh": "这颗彗星绕太阳运行的轨道周期长达<w>千年</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "每千年发生一次的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "千年一次的",
                                "target_lang_sense_clarification": "指代周期为一千年的事件或现象。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d78f6cfb-aa76-3acf-a005-a6d64192881f",
                    "sense_definition": "A person born between the early 1980s and mid-1990s.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "generation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>millennials</w> are comfortable using new technology in their daily lives.",
                            "target_lang_translations": {
                                "zh": "许多<w>千禧一代</w>在日常生活中能自如地使用新技术。"
                            }
                        },
                        {
                            "text": "Economists often analyze the spending habits of <w>millennials</w> compared to their parents.",
                            "target_lang_translations": {
                                "zh": "经济学家经常分析<w>千禧一代</w>与他们父母相比的消费习惯。"
                            }
                        }
                    ],
                    "synonyms": [
                        "echo boomer"
                    ],
                    "target_lang_definitions": {
                        "zh": "出生于20世纪80年代初至90年代中期的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "千禧一代",
                                "target_lang_sense_clarification": "名词，指代该特定年龄段的人群。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9d8ab01-8c6e-3950-8df1-643443083fd3",
                    "sense_definition": "A thousandth anniversary or a celebration of one.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country prepared for the <w>millennial</w> of its independence with grand parades.",
                            "target_lang_translations": {
                                "zh": "这个国家通过盛大的游行来筹备其独立<w>千年庆典</w>。"
                            }
                        },
                        {
                            "text": "The museum exhibit was created to honor the city's <w>millennial</w>.",
                            "target_lang_translations": {
                                "zh": "这个博物馆展览是为了纪念该市的<w>千年</w>庆典而设立的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一千周年纪念日或相关的庆祝活动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "千年庆典",
                                "target_lang_sense_clarification": "指代庆祝一千周年的活动。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}