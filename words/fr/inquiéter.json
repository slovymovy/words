{
    "word_family": [
        "inquiet",
        "inquiétude",
        "inquiétant",
        "inquiétamment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4154453c-b737-3587-96fd-ea3709a8700d",
                    "sense_definition": "S'inquiéter : ressentir de l'inquiétude, se faire du souci pour quelqu'un ou pour quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inquiétude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'<w>inquiète</w> pas, je serai à la maison avant huit heures."
                        },
                        {
                            "text": "Ma mère s'<w>inquiète</w> toujours quand je rentre tard le soir."
                        },
                        {
                            "text": "Nous nous <w>inquiétons</w> pour notre grand-père, qui est malade depuis une semaine."
                        }
                    ],
                    "synonyms": [
                        "s'en faire"
                    ],
                    "common_phrases": [
                        "s'inquiéter pour quelqu'un",
                        "s'inquiéter pour rien",
                        "s'inquiéter de l'avenir",
                        "inutile de s'inquiéter"
                    ]
                },
                {
                    "sense_id": "1a315e5b-43d3-326e-a284-3d2a2b593ada",
                    "sense_definition": "Rendre inquiet, causer de l'inquiétude ou du souci à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inquiétude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le silence de mon fils m'<w>inquiète</w> beaucoup depuis ce matin."
                        },
                        {
                            "text": "La hausse des prix <w>inquiète</w> de plus en plus les familles."
                        }
                    ],
                    "antonyms": [
                        "rassurer"
                    ],
                    "common_phrases": [
                        "inquiéter les parents",
                        "inquiéter l'opinion publique"
                    ]
                },
                {
                    "sense_id": "a3bfb15b-ed6e-34c1-9184-17e2cc7c48c4",
                    "sense_definition": "Ne pas laisser en repos, harceler, importuner ou poursuivre quelqu'un (souvent employé à la forme négative ou au passif).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "importuner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef de la bande n'a jamais été <w>inquiété</w> par la justice."
                        },
                        {
                            "text": "Les soldats avançaient la nuit pour ne pas être <w>inquiétés</w> par l'ennemi."
                        }
                    ],
                    "common_phrases": [
                        "ne pas être inquiété",
                        "être inquiété par la police"
                    ]
                },
                {
                    "sense_id": "cde1792e-6276-388f-80f6-ab5b5b9051f4",
                    "sense_definition": "S'inquiéter de + infinitif : se préoccuper de faire quelque chose, s'occuper de quelque chose, s'en soucier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inquiétude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personne ne s'est <w>inquiété</w> de savoir si les invités avaient mangé."
                        },
                        {
                            "text": "Elle s'<w>inquiéta</w> de trouver un médecin pour l'enfant."
                        }
                    ],
                    "common_phrases": [
                        "s'inquiéter de savoir si"
                    ]
                },
                {
                    "sense_id": "8d2ae514-1fb2-31d1-91bc-852fa6727331",
                    "sense_definition": "Troubler quelqu'un dans la possession d'une chose, lui faire un procès ou lui chercher querelle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "importuner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personne n'a osé <w>inquiéter</w> le vieux propriétaire dans la jouissance de ses terres."
                        },
                        {
                            "text": "Après la Révolution, les nouveaux acquéreurs craignaient qu'on ne vienne <w>inquiéter</w> leur propriété."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "emploi juridique ancien"
                        }
                    ]
                }
            ]
        }
    ]
}