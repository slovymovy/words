                                    {
                                        "sense_id": "65d8c6cd-3aa8-3859-966e-5cec4a31d220",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "A non-Greek or a non-Roman citizen."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d374fc71-a7b9-322b-b3f2-6eb7eec0cfb2",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "An uncivilized or uncultured person, originally compared to the hellenistic Greco-Roman civilisation; usually associated with senseless violence and self-harm or other such shows of brute force and lack of mental faculty."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed3bdc45-bb40-3e5e-907a-bf5bb1e23a3a",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "A person destitute of culture; a Philistine."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30e89d1c-c73c-4fe2-9ca3-0681495b7e6d",
                                                "sense_id": "ed3bdc45-bb40-3e5e-907a-bf5bb1e23a3a",
                                                "text": "Shall a noble writer, and an inspired noble writer, be called a solecist, and barbarian, for giving a new turn to a word so agreeable to the analogy and genius of the Greek tongue?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7a36099-0ffa-3c90-a601-7d41fd223a5d",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "Someone from a developing country or backward culture."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "863ebaba-ed75-3369-a619-d023a259868c",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "A brutish warrior depicted in sword and sorcery and other fantasy works; typically clad in primitive furs or leather and usually favoring physical strength over intelligence while often possessing a bellicose temperament and disdain for laws."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "daf59d54-f6d4-36b7-b1fb-7bc075809da2",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "A cruel, savage, inhumane, brutal, violently aggressive person, particularly one who is unintelligent or dim-witted; one without pity or empathy."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31cd202a-91ab-47c8-80d1-519b15d30eab",
                                                "sense_id": "daf59d54-f6d4-36b7-b1fb-7bc075809da2",
                                                "text": "Thou fell barbarian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa0eb76c-5eb5-3e26-b29d-2e20a93cdc66",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "A foreigner, especially with barbaric qualities as in the above definitions."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
