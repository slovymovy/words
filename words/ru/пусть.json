                {
                    "sense_id": "b87ff55f-cda9-3ae5-b3d1-5d8cdba6ec2f",
                    "sense_definition": "Выражает согласие, разрешение или вынужденное примирение с ситуацией.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хорошо, <w>пусть</w> будет по-твоему!",
                            "target_lang_translations": {
                                "en": "Fine, <w>let</w> it be your way!",
                                "zh": "好吧，<w>随</w>你的便吧！",
                                "nl": "Goed, <w>laat</w> het dan op jouw manier zijn!",
                                "pl": "Dobrze, <w>niech</w> będzie po twojemu!",
                                "de": "Gut, <w>soll</w> es nach deinem Willen geschehen!",
                                "fr": "D'accord, <w>soit</w> comme tu veux !",
                                "it": "Va bene, <w>che</w> sia come dici tu!",
                                "cs": "Dobře, <w>ať</w> je po tvém!",
                                "tr": "Pekala, <w>olsun</w> senin dediğin gibi!",
                                "es": "Está bien, ¡<w>que</w> sea como tú digas!"
                            }
                        },
                        {
                            "text": "Если он хочет уйти, ну и <w>пусть</w> идёт.",
                            "target_lang_translations": {
                                "en": "If he wants to leave, well, <w>let</w> him go.",
                                "zh": "如果他想走，那就<w>由</w>他去吧。",
                                "nl": "Als hij weg wil, <w>laat</w> hem dan gaan.",
                                "pl": "Jeśli chce odejść, to <w>niech</w> idzie.",
                                "de": "Wenn er gehen will, dann <w>lass</w> ihn gehen.",
                                "fr": "S'il veut partir, eh bien <w>qu'</w>il parte.",
                                "it": "Se vuole andarsene, <w>che</w> vada pure.",
                                "cs": "Jestli chce odejít, tak <w>ať</w> jde.",
                                "tr": "Eğer gitmek istiyorsa, <w>bırak</w> gitsin.",
                                "es": "Si él quiere irse, pues <w>que</w> se vaya."
                            }
                        }
                    ],
                    "synonyms": [
                        "пускай",
                        "ладно"
                    ],
                    "common_phrases": [
                        "ну и пусть",
                        "пусть так"
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses agreement, permission, or forced acceptance of a situation.",
                        "zh": "表示同意、许可或被迫接受某种情况。",
                        "nl": "Drukt instemming, toestemming of berusting in een situatie uit.",
                        "pl": "Wyraża zgodę, przyzwolenie lub rezygnację z walki o swoje zdanie.",
                        "de": "Drückt Zustimmung, Erlaubnis oder die erzwungene Akzeptanz einer Situation aus.",
                        "fr": "Exprime l'accord, la permission ou l'acceptation résignée d'une situation.",
                        "it": "Esprime accordo, permesso o rassegnazione di fronte a una situazione.",
                        "cs": "Vyjadřuje souhlas, svolení nebo smíření se se situací.",
                        "tr": "Onay, izin veya bir duruma boyun eğmeyi ifade eder.",
                        "es": "Expresa acuerdo, permiso o la aceptación forzada de una situación."
                    },
