                        "translation_id": "3b36baba-a5a4-496a-bcf0-5ccc91f79075",
                        "source_entry_id": "87196bc6-ada5-3559-9326-e9c58037f559",
                        "source_sense_id": "b2d6b381-a05b-3507-a640-598c4487feca",
                        "source_sense_description": "paard dat gefokt is met het doel om aan paardenrennen deel te nemen",
                        "target_lang_word": "Rennpferd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rennpferd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fca60fe6-fee9-374a-9e67-76383b69ad50",
                                        "entry_id": "68a138a0-4eca-3503-9eb3-4e7ada63d810",
                                        "glosses": [
                                            "sehr schnelles Pferd, das speziell für den Einsatz bei Pferderennen gezüchtet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a63fb39b-b02a-421f-91f1-f7e539325475",
                                                "sense_id": "fca60fe6-fee9-374a-9e67-76383b69ad50",
                                                "text": "„Zwei Rennpferde sind vor dem Start eines Galopprennens in England unter mysteriösen Umständen tot zusammengebrochen.“"
                                            },
                                            {
                                                "example_id": "e4d4c408-dcb8-4c52-afad-c813f37d6db6",
                                                "sense_id": "fca60fe6-fee9-374a-9e67-76383b69ad50",
                                                "text": "„So werden etwa Trüffel, Hundefutter und Rennpferde mit 7 Prozent, Babywindeln hingegen mit 19 Prozent voll besteuert.“"
                                            },
                                            {
                                                "example_id": "d761fecb-7083-4bd0-a0e6-3857f61362da",
                                                "sense_id": "fca60fe6-fee9-374a-9e67-76383b69ad50",
                                                "text": "„Ein paar Arbeiter diskutierten über Rennpferde in Nizza, zwei Postschaffner studierten den Wetterbericht aus Paris, und ein Kutscher renommierte mit seinen Zeiten als Trabrennfahrer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d70c52e6-65aa-4e1a-bc10-423458bb1ee5",
                        "source_entry_id": "87196bc6-ada5-3559-9326-e9c58037f559",
                        "source_sense_id": "b2d6b381-a05b-3507-a640-598c4487feca",
                        "source_sense_description": "paard dat gefokt is met het doel om aan paardenrennen deel te nemen",
                        "target_lang_word": "racehorse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "racehorse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "245d76d1-bbd4-32a9-8070-fb1e3e6e2bfa",
                                        "entry_id": "1152d406-b123-3b2f-b638-ca52c8b6a247",
                                        "glosses": [
                                            "A horse that competes in races."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99eaf5f9-5fa5-4f87-9c9b-445aa099c621",
                                                "sense_id": "245d76d1-bbd4-32a9-8070-fb1e3e6e2bfa",
                                                "text": "They were bosker horses. Until I went to work for Bill I didn't know how good racehorses are."
                                            },
                                            {
                                                "example_id": "75f065f7-debc-4e0a-8bd2-c16f6a07ad09",
                                                "sense_id": "245d76d1-bbd4-32a9-8070-fb1e3e6e2bfa",
                                                "text": "Long before you see the lean, handsome heads peering mildly over the half-doors of the loose boxes, you know that East Ilsley's business is training racehorses."
                                            },
                                            {
                                                "example_id": "c440f79e-9f04-4179-a30f-ccdeaf953142",
                                                "sense_id": "245d76d1-bbd4-32a9-8070-fb1e3e6e2bfa",
                                                "text": "Picture yourself betting on a racehorse, seeing the animal take the lead, and then watching the horse suddenly stop because it pulled a muscle not properly warmed up by its trainers. You’d get pretty heated under the collar, and that’s not the kind of warm-up that’s very beneficial. Horseflesh and humanflesh alike need to be warmed up before strenuous activity."
                                            },
                                            {
                                                "example_id": "97a7e42e-41f6-4ef3-a2a6-08e59ed4d7eb",
                                                "sense_id": "245d76d1-bbd4-32a9-8070-fb1e3e6e2bfa",
                                                "text": "Clearly, it’s that Secretariat is overrated. OK, exhale. I’m not trolling you. I’m just being extremely nitty about the marginal shades of “really, really great.” By “overrated,” I certainly don’t mean to imply that Secretariat isn’t the best 3-year-old American racehorse in history – he is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
