                "senses": [
                    {
                        "sense_id": "a6952f00-a6ab-3504-bbf5-6cb5cd037186",
                        "entry_id": "00f34f99-9fa7-3a74-b128-27bd80f71188",
                        "glosses": [
                            "Se favoriser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8357f9d-ad04-4ade-b182-e2acdb837e8f",
                                "sense_id": "a6952f00-a6ab-3504-bbf5-6cb5cd037186",
                                "text": "En effet, dans le cas d'une comparaison interpersonnelle, l'individu tend à s'auto-favoriser et, lorsque la comparaison intergroupe est mise en relief, l'individu favorise son groupe d'appartenance."
                            },
                            {
                                "example_id": "96195ba3-6409-4b5a-bd60-32d77ca6b9ac",
                                "sense_id": "a6952f00-a6ab-3504-bbf5-6cb5cd037186",
                                "text": "Cette idée ne sera pas retenue à cause des multi-comptes qui permettrait de s'auto-favoriser en cas de quête."
                            }
                        ]
                    }
