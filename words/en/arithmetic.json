{
    "word_family": [
        "arithmetical",
        "arithmetician"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90bb4480-5573-326f-82d3-39c6765e11de",
                    "sense_definition": "The branch of mathematics dealing with the properties and manipulation of numbers using addition, subtraction, multiplication, and division.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students learn basic <w>arithmetic</w> in primary school.",
                            "target_lang_translations": {
                                "zh": "小学生在学校学习基础<w>算术</w>。"
                            }
                        },
                        {
                            "text": "He is very good at mental <w>arithmetic</w>.",
                            "target_lang_translations": {
                                "zh": "他非常擅长心<w>算</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "math",
                        "mathematics"
                    ],
                    "common_phrases": [
                        "mental arithmetic",
                        "basic arithmetic"
                    ],
                    "target_lang_definitions": {
                        "zh": "数学的一个分支，研究数字的加、减、乘、除等基本运算及其性质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "算术",
                                "target_lang_sense_clarification": "指基础的数字运算，如加减乘除。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cec554e-215b-35f5-a2fd-aa9e8a3ca12c",
                    "sense_definition": "The branch of pure mathematics devoted to the study of integers and their properties.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor specializes in higher <w>arithmetic</w> and number theory.",
                            "target_lang_translations": {
                                "zh": "这位教授专门研究高等<w>算术</w>和数论。"
                            }
                        },
                        {
                            "text": "Advanced <w>arithmetic</w> explores the deep structure of prime numbers.",
                            "target_lang_translations": {
                                "zh": "高等<w>算术</w>探索质数的深层结构。"
                            }
                        }
                    ],
                    "synonyms": [
                        "number theory"
                    ],
                    "target_lang_definitions": {
                        "zh": "纯数学的一个分支，专门研究整数及其性质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "数论",
                                "target_lang_sense_clarification": "指高等算术，即对整数性质的深入研究。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bdb4b4e2-8ebb-3721-8f22-8bd8b3bf8544",
                    "sense_definition": "Relating to a sequence or mean calculated by adding a constant value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sequence follows an <w>arithmetic</w> progression.",
                            "target_lang_translations": {
                                "zh": "该数列遵循<w>算术</w>级数。"
                            }
                        },
                        {
                            "text": "Calculate the <w>arithmetic</w> mean of these five numbers.",
                            "target_lang_translations": {
                                "zh": "计算这五个数字的<w>算术</w>平均数。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "arithmetic mean",
                        "arithmetic progression"
                    ],
                    "target_lang_definitions": {
                        "zh": "指通过增加一个常数值来计算的序列或平均值。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "算术",
                                "target_lang_sense_clarification": "用于数学术语，如算术平均数或算术级数。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f33d540c-6a9e-3c6b-8418-5b85dd0d91bd",
                    "sense_definition": "Relating to the study or practice of arithmetic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The problem requires an <w>arithmetic</w> approach to solve.",
                            "target_lang_translations": {
                                "zh": "这个问题需要用<w>算术</w>方法来解决。"
                            }
                        },
                        {
                            "text": "She applied <w>arithmetic</w> logic to the data set.",
                            "target_lang_translations": {
                                "zh": "她将<w>算术</w>逻辑应用于该数据集。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arithmetical"
                    ],
                    "target_lang_definitions": {
                        "zh": "与算术的研究或实践相关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "算术的",
                                "target_lang_sense_clarification": "形容词，表示与算术有关的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62c47d61-72df-349d-87f6-d7ad42c78e92",
                    "sense_definition": "Increasing or decreasing by a constant amount rather than by a percentage or ratio.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company expects <w>arithmetic</w> growth in the coming years.",
                            "target_lang_translations": {
                                "zh": "公司预计未来几年将出现<w>线性</w>增长。"
                            }
                        },
                        {
                            "text": "Unlike exponential growth, this is strictly <w>arithmetic</w>.",
                            "target_lang_translations": {
                                "zh": "与指数增长不同，这严格来说是<w>线性</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "linear"
                    ],
                    "antonyms": [
                        "exponential"
                    ],
                    "common_phrases": [
                        "arithmetic growth"
                    ],
                    "target_lang_definitions": {
                        "zh": "指以恒定数量而非百分比或比率增加或减少。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "线性",
                                "target_lang_sense_clarification": "指增长方式为恒定数值，而非指数级。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}