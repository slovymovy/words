        "fr-extract.jsonl": [
            {
                "entry_id": "5c1b0ca3-11fb-35d4-8e66-2472c3b97c2c",
                "word": "aster",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f492a447-6708-4028-a961-120a6557a2d2",
                        "entry_id": "5c1b0ca3-11fb-35d4-8e66-2472c3b97c2c",
                        "tags": [
                            "plural"
                        ],
                        "form": "asters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f512e466-05ae-3811-b7d2-35608d3f2b87",
                        "entry_id": "5c1b0ca3-11fb-35d4-8e66-2472c3b97c2c",
                        "glosses": [
                            "Genre de plantes de la famille des Astéracées (ou Composées), qui ressemblent à des étoiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db84ffd8-f23d-40ce-8507-6a008e98800b",
                                "sense_id": "f512e466-05ae-3811-b7d2-35608d3f2b87",
                                "text": "La dormeuse était donc blanche comme l’aster des prés et rosée comme la fleur de l’églantier."
                            },
                            {
                                "example_id": "a759b2dc-d7a2-485d-afa2-f4fa49a3eb62",
                                "sense_id": "f512e466-05ae-3811-b7d2-35608d3f2b87",
                                "text": "aster. Élégance. — Ses fleurs radiées, semblables à l’étoile, lui ont donné son nom. C’est parmi les asters qu’est née la jolie reine-marguerite, un des plus beaux ornements de nos jardins. Cette plante nous vient de la Chine et brille en automne; elle a des fleurs de toutes les couleurs, à l’exception du jaune. Elle s’élève en buissons et en gerbes élégantes."
                            },
                            {
                                "example_id": "cb6146d2-18e8-422f-9fd7-f215e9ef6dd5",
                                "sense_id": "f512e466-05ae-3811-b7d2-35608d3f2b87",
                                "text": "Alors elle s’approcha de la tombe à son tour, sortit de dessous son fichu un gros bouquet d’asters qu’elle posa, loin à l’écart des couronnes de la famille : puis resta longuement sous la pluie, ne regardant rien, ne pensant à rien, et pleurant faute de prières."
                            },
                            {
                                "example_id": "49babd62-f6f1-4c76-9f18-93ce5744bb93",
                                "sense_id": "f512e466-05ae-3811-b7d2-35608d3f2b87",
                                "text": "L’aster de vos parterres, mesdames, c’est... une reine-marguerite, tout simplement."
                            },
                            {
                                "example_id": "10a272d1-c83b-4153-b5e2-8622e628285f",
                                "sense_id": "f512e466-05ae-3811-b7d2-35608d3f2b87",
                                "text": "De petits sentiers droits se rejoignaient dans le centre même, et venaient aboutir à un parterre rond tout couvert d’asters enfouis dans une herbe épaisse."
                            }
                        ]
                    },
                    {
                        "sense_id": "14f873ec-5ea9-3d27-903f-9c12ad5394fa",
                        "entry_id": "5c1b0ca3-11fb-35d4-8e66-2472c3b97c2c",
                        "glosses": [
                            "Chacune des deux structures microscopiques d'apparence étoilée apparaissant lors de la mitose et situées à chacun des pôles du fuseau mitotique d'une cellule animale en division."
                        ],
                        "tags": [
                            "Biologie cellulaire"
                        ],
                        "examples": [
                            {
                                "example_id": "3a87f3f4-5444-4f41-9a3d-01ec0e294214",
                                "sense_id": "14f873ec-5ea9-3d27-903f-9c12ad5394fa",
                                "text": "L’aster et les centrioles sont typiques de la mitose animale."
                            },
                            {
                                "example_id": "f2c0f8d5-a22d-4ba8-9a92-f19477c4052b",
                                "sense_id": "14f873ec-5ea9-3d27-903f-9c12ad5394fa",
                                "text": "Ce même réseau d’actine peut limiter dans un milieu confiné le mouvement d’un aster de microtubules en agissant comme une matrice élastique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f10462a-0892-413a-9af4-318912a89357",
                        "source_entry_id": "5c1b0ca3-11fb-35d4-8e66-2472c3b97c2c",
