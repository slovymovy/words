                "senses": [
                    {
                        "sense_id": "2aee23b2-4fc3-312b-8cf3-60f43761095f",
                        "entry_id": "ae27e36f-d2d8-3fe4-9ada-3987a1b526f8",
                        "glosses": [
                            "w sposób totalny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4423b985-61c7-499b-8706-9e389c0802f3",
                                "sense_id": "2aee23b2-4fc3-312b-8cf3-60f43761095f",
                                "text": "(…) w niektórych krajach, zwłaszcza katolickich, Amway przyrównywany jest do sekty religijnej, totalnie uzależniającej swoich członków"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82e1a80b-3b04-4592-b82b-288049c132b9",
                        "source_entry_id": "ae27e36f-d2d8-3fe4-9ada-3987a1b526f8",
                        "source_sense_id": "2aee23b2-4fc3-312b-8cf3-60f43761095f",
                        "target_lang_word": "totally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "totally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b779100-9e74-3ed5-9605-e2360583ee35",
                                        "entry_id": "060d7882-7096-33e2-b57c-ebfa0fb06922",
                                        "glosses": [
                                            "To the fullest extent or degree."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58fd0e2a-fbd6-40b3-942e-6ed41cab4a0f",
                                                "sense_id": "4b779100-9e74-3ed5-9605-e2360583ee35",
                                                "text": "They've totally demolished the bank on Main Street."
                                            },
                                            {
                                                "example_id": "5687091c-a8d1-42f5-b4d8-408d16a1cd13",
                                                "sense_id": "4b779100-9e74-3ed5-9605-e2360583ee35",
                                                "text": "Antonio. He misses not much.\nSebastian. No; he doth but mistake the truth totally."
                                            },
                                            {
                                                "example_id": "68d3e029-a074-4da5-ae97-a7820241524b",
                                                "sense_id": "4b779100-9e74-3ed5-9605-e2360583ee35",
                                                "text": "The languages of different nations did not totally differ […] They were therefore easily learned;"
                                            },
                                            {
                                                "example_id": "728d69e9-e01d-49af-ae50-b759e7fbac51",
                                                "sense_id": "4b779100-9e74-3ed5-9605-e2360583ee35",
                                                "text": "Your conjecture is totally wrong, I assure you."
                                            },
                                            {
                                                "example_id": "0bb2be38-ade7-440e-b1f2-b5b282696293",
                                                "sense_id": "4b779100-9e74-3ed5-9605-e2360583ee35",
                                                "text": "I trust him totally and without reservation."
                                            },
                                            {
                                                "example_id": "de8b0ee4-cda7-4d2b-b92d-28e52ec5acc1",
                                                "sense_id": "4b779100-9e74-3ed5-9605-e2360583ee35",
                                                "text": "The project poses exceptional challenges, given that Antarctica is the coldest, windiest and driest continent on Earth, as well as the most remote and inaccessible, being almost totally covered by a vast ice sheet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b20f624-7924-39e5-82cd-6c95700aa63c",
                                        "entry_id": "060d7882-7096-33e2-b57c-ebfa0fb06922",
                                        "glosses": [
                                            "Very; extremely."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d62569f3-192d-4370-ab6a-316cc4a9882b",
                                                "sense_id": "7b20f624-7924-39e5-82cd-6c95700aa63c",
                                                "text": "That was totally wicked!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79f7b47b-b6a6-34a7-abca-b46865f544d4",
                                        "entry_id": "060d7882-7096-33e2-b57c-ebfa0fb06922",
                                        "glosses": [
                                            "Definitely; for sure."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "modal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcf5a1f0-584b-4f23-9ce3-373774604bf6",
                                                "sense_id": "79f7b47b-b6a6-34a7-abca-b46865f544d4",
                                                "text": "That was totally not what happened."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d4c93c1-8aa9-477d-98b7-d22e7b27b3a4",
                        "source_entry_id": "ae27e36f-d2d8-3fe4-9ada-3987a1b526f8",
                        "source_sense_id": "2aee23b2-4fc3-312b-8cf3-60f43761095f",
                        "target_lang_word": "totalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "totalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59ad20d2-978a-3ffd-beb7-241d54a55895",
                                        "entry_id": "47273283-4eb2-3e22-bb0c-0681f0e0de5b",
                                        "glosses": [
                                            "Entièrement ; tout à fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b8d5d8c-bed4-4f44-af73-c79e60e1010d",
                                                "sense_id": "59ad20d2-978a-3ffd-beb7-241d54a55895",
                                                "text": "Ma conduite dissipa totalement les inquiétudes de son père,"
                                            },
                                            {
                                                "example_id": "636c5a06-17ff-4c53-9b20-ac88d997c6f7",
                                                "sense_id": "59ad20d2-978a-3ffd-beb7-241d54a55895",
                                                "text": "Totalement crédible en Marylin Monroe, elle pourrait même décrocher un Oscar pour sa performance dans cette adaptation du best-seller de Joyce Caroll Oates."
                                            },
                                            {
                                                "example_id": "75949ef1-52f3-49b8-8b6e-b927346aac7c",
                                                "sense_id": "59ad20d2-978a-3ffd-beb7-241d54a55895",
                                                "text": "Tenez vos engagements. Cela découragera totalement vos adversaires."
                                            },
                                            {
                                                "example_id": "14871123-364a-45f6-9da2-b288af10788b",
                                                "sense_id": "59ad20d2-978a-3ffd-beb7-241d54a55895",
                                                "text": "Pour que le téléspectateur ne soit pas totalement abruti par des talk-shows et leurs têtes à clashs ou des téléréalités avec des personnages ignares et exubérants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
