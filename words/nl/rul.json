                    "sense_definition": "grof en goedkoop weefsel dat gemaakt is van textielafval",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude dekens waren geweven van een stugge, goedkope <w>rul</w>.",
                            "target_lang_translations": {
                                "en": "The old blankets were woven from a stiff, cheap <w>shoddy</w>.",
                                "ru": "Старые одеяла были сотканы из жесткой, дешевой <w>грубой ткани</w>."
                            }
                        },
                        {
                            "text": "Men gebruikte vroeger vaak <w>rul</w> voor het maken van eenvoudige zakken.",
                            "target_lang_translations": {
                                "en": "In the past, people often used <w>coarse waste fabric</w> to make simple sacks.",
                                "ru": "Раньше для изготовления простых мешков часто использовали <w>грубую ткань</w>."
                            }
