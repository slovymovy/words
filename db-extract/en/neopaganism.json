                                        "entry_id": "26614b97-7063-3e87-84fe-5dd03c2dbd05",
                                        "glosses": [
                                            "Retour au paganisme antique, au chamanisme, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6f1a89d-4044-4110-ab0f-0fc3c7b48335",
                                                "sense_id": "5902d39e-f62c-345f-85d1-722108c09211",
                                                "text": "Que pensez-vous de l'éventuelle émergence d'un néopaganisme que l'on pourrait qualifier d’archéo-futuriste : soirée rave, musique techno, marquages physiques néotribaux comme les tatouages ou les piercings, etc. ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42df6885-b5f2-4277-8501-ed077625a92e",
                        "source_entry_id": "7d803061-7201-3319-8d54-7b9a58595a71",
                        "source_sense_id": "2055ada0-8672-3f3f-b02a-43c7693258a3",
                        "source_sense_description": "modern or revived form of paganism",
                        "target_lang_word": "Neuheidentum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neuheidentum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2bfcd1a-5abe-3dad-9575-7fbd236aa50f",
                                        "entry_id": "4b67e20b-56aa-3248-ac52-0679461cbe08",
                                        "glosses": [
                                            "neuzeitliches Heidentum, vielfach Wiederbelebung und Fortentwicklung alter heidnischer Kulturen und Religionen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cb3e975-c6d5-4a57-80e7-8bcb863868c2",
                                                "sense_id": "c2bfcd1a-5abe-3dad-9575-7fbd236aa50f",
                                                "text": "„Neukeltentum und Neugermanentum werden unter dem Begriff »Neuheidentum« zusammgefasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01f60f03-e561-475f-bb75-bec3ba783d5f",
                        "source_entry_id": "7d803061-7201-3319-8d54-7b9a58595a71",
                        "source_sense_id": "2055ada0-8672-3f3f-b02a-43c7693258a3",
                        "source_sense_description": "modern or revived form of paganism",
                        "target_lang_word": "Neopaganismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neopaganismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1458513-2eef-3911-85e6-18a317c8414f",
                                        "entry_id": "de8bb2cd-13e4-3615-bd63-55e6ddc42dea",
                                        "glosses": [
                                            "neu entstandenes oder neu belebtes Glaubenssystem, das auf älteren Formen einer heidnischen Naturreligion aufbaut; neopagane Religion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd694eea-8fb1-456d-9d7a-46f5a7fa2015",
                                                "sense_id": "f1458513-2eef-3911-85e6-18a317c8414f",
                                                "text": "„Der Neopaganismus wird hier definiert als der Versuch zahlreicher viktorianischer Autoren, Wertvorstellungen, die man mit dem antiken Heidentum assoziierte, wiederzubeleben.“"
                                            },
                                            {
                                                "example_id": "57a4416a-8791-4540-a620-c7e5443e5111",
                                                "sense_id": "f1458513-2eef-3911-85e6-18a317c8414f",
                                                "text": "„Im Unterschied dazu ist Neopaganismus keine aus einer anderen Region neue hinzugetretene Religion, sondern eine neuentstandene religiöse Strömung.“"
                                            },
                                            {
                                                "example_id": "4046b3d9-2a0a-435f-b57f-240b894f489c",
                                                "sense_id": "f1458513-2eef-3911-85e6-18a317c8414f",
                                                "text": "„Zum einen seien sie sogenannte Kraftorte, denen bestimmte energetische Eigenschaften innewohnen sollen, auf Grund derer sie im Neopaganismus als heilige Orte betrachtet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
