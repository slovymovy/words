                                "target_senses": [
                                    {
                                        "sense_id": "fefa7a06-cc55-370c-96f7-a82683ca755b",
                                        "entry_id": "5c965691-fafc-3992-a241-cf51fe5c5cd0",
                                        "glosses": [
                                            "A female provocator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7d7dc28-edca-40c0-aa77-648785a57b33",
                                                "sense_id": "fefa7a06-cc55-370c-96f7-a82683ca755b",
                                                "text": "Rounding out the primary characters is professional provocatrix Sarah Silverman, who voices Vanellope von Schweetz[…]."
                                            },
                                            {
                                                "example_id": "7f0712da-d780-4cf6-bc18-ce88044c49aa",
                                                "sense_id": "fefa7a06-cc55-370c-96f7-a82683ca755b",
                                                "text": "In the Condé Nast universe,[…]former French Vogue editor Carine Roitfeld was the provocatrix; but Sozzani has become the activist – though you’d never know it to look at her."
                                            },
                                            {
                                                "example_id": "229d6cab-af2a-44a1-9328-a48e02aab723",
                                                "sense_id": "fefa7a06-cc55-370c-96f7-a82683ca755b",
                                                "text": "The famously contrarian feminist scholar and provocatrix is gracing her longtime employer, Salon, with a three-part interview this week."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
