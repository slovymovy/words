                                                "sense_id": "8d8c658d-ebdd-37d3-9a0e-141bece9c508",
                                                "text": "These new phones are the business!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77923bb6-7459-3e7b-90b4-a61b3c0dcd44",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "The act of defecation, or the excrement itself, particularly that of a non-human animal."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcd2ca76-4bef-484b-87e6-11876e98b69e",
                                                "sense_id": "77923bb6-7459-3e7b-90b4-a61b3c0dcd44",
                                                "text": "Your ferret left his business all over the floor."
                                            },
                                            {
                                                "example_id": "03d6d687-656a-4561-937d-8bb72b7bf2ab",
                                                "sense_id": "77923bb6-7459-3e7b-90b4-a61b3c0dcd44",
                                                "text": "As the cart went by, its horse lifted its tail and did its business."
                                            }
