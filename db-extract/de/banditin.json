                "senses": [
                    {
                        "sense_id": "015849c8-2392-3c76-bf8c-1fbce46d1129",
                        "entry_id": "3c17faf4-62e5-3ac2-a3dc-0b37f1d96d96",
                        "glosses": [
                            "Verbrecherin, Straßenräuberin, die meist einer kriminellen Gruppe angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0af892b-37bc-438d-9ca1-a9727e56bb1d",
                                "sense_id": "015849c8-2392-3c76-bf8c-1fbce46d1129",
                                "text": "„Dieses Henkerspiel hatte Sesto schon oft ohne ein anderes Gefühl als das des Respekts vor der famosen Banditin beobachtet.“"
                            },
                            {
                                "example_id": "cc4577ef-e814-4568-a27d-fc7c080a262f",
                                "sense_id": "015849c8-2392-3c76-bf8c-1fbce46d1129",
                                "text": "„Bob wurde nur von einer einzigen Person betrauert, einer Banditin, die in Custer einen Gasthof unterhielt und deren Liebhaber er war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f91c6309-466e-4bb0-83e5-0805c9f62a2e",
                        "source_entry_id": "3c17faf4-62e5-3ac2-a3dc-0b37f1d96d96",
                        "source_sense_id": "015849c8-2392-3c76-bf8c-1fbce46d1129",
                        "source_sense_description": "Verbrecherin, Straßenräuberin, die meist einer kriminellen Gruppe angehört",
                        "target_lang_word": "bandit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bandit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c65fb72-a97f-3ffe-9112-4ef1fafb9a84",
                                        "entry_id": "4bb5a215-ab1a-351a-a168-8a9184fa2809",
                                        "glosses": [
                                            "One who robs others in a lawless area, especially as part of a group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c4b13db-c6ac-4808-80b3-8d9693220f00",
                                                "sense_id": "1c65fb72-a97f-3ffe-9112-4ef1fafb9a84",
                                                "text": "Do you recollect a story my nurse told us of a Sicilian bandit, the terror of the country?—how he saved a young child from a cottage on fire, brought it up delicately, and far removed from his own pursuits; while, at his execution, his chief regret was the future provision for that boy?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27df473d-a5e7-3f2a-89b4-f46bc8eb5328",
                                        "entry_id": "4bb5a215-ab1a-351a-a168-8a9184fa2809",
                                        "glosses": [
                                            "An outlaw."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f90e51e-e32e-336b-9ac6-139a93fb11b3",
                                        "entry_id": "4bb5a215-ab1a-351a-a168-8a9184fa2809",
                                        "glosses": [
                                            "One who cheats others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b799bfbe-37db-36fb-a357-b49e69373e64",
                                        "entry_id": "4bb5a215-ab1a-351a-a168-8a9184fa2809",
                                        "glosses": [
                                            "An aircraft identified as an enemy, but distinct from \\\"hostile\\\" or \\\"threat\\\" in that it is not immediately to be engaged."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10b33389-086b-348d-bd1e-1f35d1a7505c",
                                        "entry_id": "4bb5a215-ab1a-351a-a168-8a9184fa2809",
                                        "glosses": [
                                            "A runner who covertly joins a race without having registered as a participant."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "656baf2c-7578-3e3e-8a35-190bf1d58dc4",
                                        "entry_id": "4bb5a215-ab1a-351a-a168-8a9184fa2809",
                                        "glosses": [
                                            "Synonym of arse bandit."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
