                        "sense_id": "cf3a0b29-c780-3a5c-a599-ef200d85a67f",
                        "entry_id": "b3c9ad56-6f87-3126-8d03-328eea3e835a",
                        "glosses": [
                            "kraina historyczna i region w północno-zachodniej Francji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e33f6ae-d812-4571-8d45-62a060e0f344",
                                "sense_id": "cf3a0b29-c780-3a5c-a599-ef200d85a67f",
                                "text": "Bretania to francuski region, złożony z czterech departamentów."
