                "senses": [
                    {
                        "sense_id": "7b771102-6744-3f22-9d56-282c0f070a47",
                        "entry_id": "c02943ed-c460-3f92-9345-343ad7ddc84b",
                        "glosses": [
                            "Person, die es versteht, sich in Pose/in Szene zu setzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cba7df5-3da8-469e-ad57-6b8eb5dd41fc",
                                "sense_id": "7b771102-6744-3f22-9d56-282c0f070a47",
                                "text": "„Er war tatsächlich beides, doch vor allem war er ein unverbesserlicher Poseur, der die Rolle, die er im öffentlichen Leben wirklich spielte, wie ein Schmierenkomödiant abzog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
