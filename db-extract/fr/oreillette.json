        "fr-extract.jsonl": [
            {
                "entry_id": "9bd6e44f-cb38-3dac-a94b-9f311314b8ec",
                "word": "oreillette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "953ebe8e-e9cf-4ce1-ba6e-70dc60df77c3",
                        "entry_id": "9bd6e44f-cb38-3dac-a94b-9f311314b8ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "oreillettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0dc0860c-5582-3d12-96cc-4de4a032dbe9",
                        "entry_id": "9bd6e44f-cb38-3dac-a94b-9f311314b8ec",
                        "glosses": [
                            "Chacune des deux cavités du cœur qui sont placées au-dessus des deux ventricules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd120e75-51c1-4f56-b6cc-0e00d8ccd658",
                                "sense_id": "0dc0860c-5582-3d12-96cc-4de4a032dbe9",
                                "text": "L’oreillette droite., l’oreillette gauche."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b630538-f666-3ecd-a83d-e1491bafd53a",
                        "entry_id": "9bd6e44f-cb38-3dac-a94b-9f311314b8ec",
                        "glosses": [
                            "Écouteur discret, placé dans le pavillon de l’oreille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2feab39c-96a2-46f6-b2df-aa84bc2ba929",
                                "sense_id": "7b630538-f666-3ecd-a83d-e1491bafd53a",
                                "text": "Aucune des personnes qui lui parlent dans ses oreillettes ne lui a soufflé de « question qui tue » ?"
                            },
                            {
                                "example_id": "b2ffb76a-0127-4b42-b347-21b7c9d38331",
                                "sense_id": "7b630538-f666-3ecd-a83d-e1491bafd53a",
                                "text": "« Les tournages longs, pour moi, ça reflète la générosité des coachs », estime Matthieu Grelier qui insiste pour rappeler que, contrairement à certaines versions étrangères, les coachs ne sont équipés d’aucune oreillette et ne reçoivent aucune consigne."
                            }
                        ]
                    },
                    {
                        "sense_id": "67ae7f55-6f2a-3fcd-b30a-a3c04030eae9",
                        "entry_id": "9bd6e44f-cb38-3dac-a94b-9f311314b8ec",
                        "glosses": [
                            "Genre de beignet composé d’une pâte frite très fine et croustillante, saupoudrée de sucre."
                        ],
                        "tags": [
                            "Pâtisserie",
                            "Occitanie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7dec0f53-fa3b-370c-a13a-bed151c69294",
                        "entry_id": "9bd6e44f-cb38-3dac-a94b-9f311314b8ec",
                        "glosses": [
                            "Asarum europaeum ^([1]), l’asaret d’Europe (plante herbacée)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "96bb7f37-0c1c-3ddf-9824-0f48523968b4",
                        "entry_id": "9bd6e44f-cb38-3dac-a94b-9f311314b8ec",
                        "glosses": [
                            "Appendice situé à la base du limbe d’une feuille ou d’une bractée embrassante, ou encore à la base du pétiole, de part et d’autre de la ligne d’insertion."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b4f41e40-bff3-3f88-8c00-4171296796c2",
                        "entry_id": "9bd6e44f-cb38-3dac-a94b-9f311314b8ec",
                        "glosses": [
                            "Anse d’un récipient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94fa940c-5ee5-4ad6-9bce-bf24c3ff022c",
                                "sense_id": "b4f41e40-bff3-3f88-8c00-4171296796c2",
                                "text": "Avec d’infinies précautions, elle passa un tisonnier dans l’oreillette du pesant ustensile et le recula un peu."
                            }
                        ]
                    },
                    {
                        "sense_id": "c74a2160-65cc-39d8-a6c4-22d7749bce3a",
                        "entry_id": "9bd6e44f-cb38-3dac-a94b-9f311314b8ec",
                        "glosses": [
                            "Élément d’une coiffure qui couvre les oreilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa5a0875-c416-4c22-8df1-ed9cc92c0857",
                                "sense_id": "c74a2160-65cc-39d8-a6c4-22d7749bce3a",
                                "text": "Cléophas Pesant, fils de Thadée Pesant le forgeron, s’enorgueillissait déjà d’un habillement d’été de couleur claire, un habillement américain aux larges épaules matelassées ; seulement il avait gardé pour ce dimanche encore froid sa coiffure d’hiver, une casquette de drap noir aux oreillettes doublées en peau de lièvre, au lieu du chapeau de feutre dur qu’il eût aimé porter."
                            }
                        ]
                    },
                    {
                        "sense_id": "444f388c-785a-38bf-8772-106bdb49327b",
                        "entry_id": "9bd6e44f-cb38-3dac-a94b-9f311314b8ec",
                        "glosses": [
                            "Partie de casque (camail, etc.) qui couvrait l'oreille."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "494cdba5-7b00-4e2e-b7f6-3d0c3c81f98e",
                                "sense_id": "444f388c-785a-38bf-8772-106bdb49327b",
                                "text": "Ce camail est en toile métallique bombée, et ressemble beaucoup pour la forme au masque du tireur d'armes. Il est simple, ou avec oreillettes, ou encore avec oreillettes et rebord postérieur comme en ont certains casques."
                            },
                            {
                                "example_id": "2c46dbbd-f981-4c33-b536-9e708496b8dd",
                                "sense_id": "444f388c-785a-38bf-8772-106bdb49327b",
                                "text": "… spécial à l'infanterie dans le principe, mais adopté par les cavaliers à la fin du XVIᵉ siècle, en y ajoutant une visière articulée dite bavière ou garde-face, qui s'attachait aux deux oreillettes par des crochets, …"
                            }
                        ]
                    },
                    {
                        "sense_id": "15f06ed0-8f05-33a4-b795-5de2599deb00",
                        "entry_id": "9bd6e44f-cb38-3dac-a94b-9f311314b8ec",
                        "glosses": [
                            "Élément latéral du dossier d'un fauteuil, destiné à reposer la tête."
                        ],
                        "tags": [],
                        "note": "On le nomme aussi oreille",
                        "examples": [
                            {
                                "example_id": "84f36c17-cce1-4801-a9fe-5e8126bf0594",
                                "sense_id": "15f06ed0-8f05-33a4-b795-5de2599deb00",
                                "text": "Il ne fût point sorti, n’eût point bougé de son fauteuil à oreillettes, — qu’il avait fait descendre à la cuisine, ne voulant pas rester seul, — sans Marie, qui lui apportait sa canne et son chapeau."
                            },
                            {
                                "example_id": "b968d6b3-c273-4808-bebb-e854c9b5585d",
                                "sense_id": "15f06ed0-8f05-33a4-b795-5de2599deb00",
                                "text": "J’achève de vivre, en robe de chambre, dans l’appareil des grands malades incurables, au fond d’un fauteuil à oreillettes où ma mère a attendu sa fin."
                            },
                            {
                                "example_id": "191783ee-b3b6-4740-a8a9-95699b813386",
                                "sense_id": "15f06ed0-8f05-33a4-b795-5de2599deb00",
                                "text": "20 mai 1940 – La soirée s’est passée à faire de la stratégie de salon, grand-mère dans le fauteuil à oreillettes et les autres membres de la famille dans des fauteuils de confort décroissant avec l’âge des occupants."
                            },
                            {
                                "example_id": "703977b6-59a1-44a2-9443-88830eae4d9f",
                                "sense_id": "15f06ed0-8f05-33a4-b795-5de2599deb00",
                                "text": "C’était en fait des sortes de fauteuils larges et profonds, recouverts de tissu à motifs floraux façon tapisserie, avec des accoudoirs rembourrés et des appuis-tête à oreillettes."
                            }
                        ]
                    }
                ],
