                "senses": [
                    {
                        "sense_id": "dcb81249-493c-3080-9b04-c8c266215ddb",
                        "entry_id": "20aaabfd-c1f6-3332-9bf0-d768b7ab794a",
                        "glosses": [
                            "Variante de cadeauter."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "4fea2a89-74ec-4e61-b5bd-a9174a44bf5a",
                                "sense_id": "dcb81249-493c-3080-9b04-c8c266215ddb",
                                "text": "« Ça ne coûte rien ! Le bourgeois qui en fabrique nous en cadote. »"
                            },
                            {
                                "example_id": "7de012da-7f83-4b9c-beca-71959c22e65c",
                                "sense_id": "dcb81249-493c-3080-9b04-c8c266215ddb",
                                "text": "Tout se paie, tout se monnaye, le bakchich est un sésame indispensable, il faut « cadoter » pour être soigné, pour passer à travers les mailles serrées des contrôles tatillons, policiers ou douaniers."
                            },
                            {
                                "example_id": "e034a7db-9478-425f-b241-beafb22e8d7e",
                                "sense_id": "dcb81249-493c-3080-9b04-c8c266215ddb",
                                "text": "S'il ne faute pas (ne commet pas d'erreur), vous pouvez le cadoter (donner un cadeau)."
                            }
                        ]
                    }
                ],
