                "senses": [
                    {
                        "sense_id": "b32f7a06-3a32-30bb-9cad-167b00e672b6",
                        "entry_id": "2c03983e-824f-3179-81e5-4409011c9fbd",
                        "glosses": [
                            "dunkle Stellen, Schatten unter dem Auge"
                        ],
                        "tags": [
                            "plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "cd5314af-0102-41ec-bd87-7bb20e415cd6",
                                "sense_id": "b32f7a06-3a32-30bb-9cad-167b00e672b6",
                                "text": "Ihre großen, dunklen Augenringe am Neujahrstag lassen vermuten, dass sie in der Silvesternacht nur wenig Schlaf gefunden hat."
                            },
                            {
                                "example_id": "bc1a8fb7-e741-4f3f-861e-4a361679b24d",
                                "sense_id": "b32f7a06-3a32-30bb-9cad-167b00e672b6",
                                "text": "„Es ist ein Kupferstich, auf dem sie für heutige Augen deutlich älter als 20 Jahre wirkt, ihre Augenringe sind ebenso ausgeprägt wie ein Grübchen am Kinn.“"
                            },
                            {
                                "example_id": "0a66d993-3166-4fba-ba96-52cf521b081d",
                                "sense_id": "b32f7a06-3a32-30bb-9cad-167b00e672b6",
                                "text": "„Sie hoffte, dass ihre Augenringe nicht allzu offensichtlich waren, was aber gänzlich unwahrscheinlich war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0698d0c7-4260-3d2e-9bec-c01129b4bffb",
                        "entry_id": "2c03983e-824f-3179-81e5-4409011c9fbd",
                        "glosses": [
                            "farbiger Ring um das Auge bei einigen Vögeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9c5e019-a7d6-4727-b948-f0ea974f6cd3",
                                "sense_id": "0698d0c7-4260-3d2e-9bec-c01129b4bffb",
                                "text": "Samtkopf-Grasmücken haben einen auffälligen, roten Augenring."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92988c00-84cb-4a8d-ab7a-f859d961e52f",
