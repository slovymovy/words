                        "glosses": [
                            "Gerät zum Fangen von Aalen in der Form einer Gabel mit mehreren Zacken, die mit Widerhaken versehen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b677cfcd-810a-42c0-8f7a-760f7a34f2f8",
                                "sense_id": "8bc4e475-e3b8-3a74-ae4d-32a5d65c962f",
                                "text": "„Die Aalgabel oder Stechgabel ist von Eisen, hat drei Zinken von neun Zoll Länge, von denen zwei oben etwas nach Außen gebogen, auf der inneren Seite aber, so wie der mittelste auf beiden Seiten mit Kerben versehen sind.“"
                            }
                        ],
