                        "translation_id": "461e1eff-c1af-4b68-a673-a6c0665c68f9",
                        "source_entry_id": "92634ff2-1358-31a7-9bfc-64620e31aacf",
                        "source_sense_description": "Kyōto, Japan",
                        "target_lang_word": "Kyoto",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kyoto",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83026720-7395-3a7b-99fc-1e480bace57e",
                                        "entry_id": "95ad371d-344f-33b1-9b4f-194d19c63ffd",
                                        "glosses": [
                                            "Ville du Japon située dans la région du Kansaï, dans le Japon occidental, proche d’Osaka. L’ancienne capitale de ce pays jusqu’en 1868 (comme ville impériale) ou jusqu’en 1192 (comme centre politique)."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c4265a3-bf67-45a3-a7cb-0331b9110cdd",
                                                "sense_id": "83026720-7395-3a7b-99fc-1e480bace57e",
                                                "text": "Un cultivateur de riz, un autre de thé, un ostréiculteur, un moine bouddhiste cuisinier, un forgeron de katana, un champion de plongée libre, une geiko (geisha de Kyoto) ou encore une jeune karatéka témoignent de leur quotidien et de l’importance qu’ils accordent à la composante spirituelle de ce qui les environne ainsi que de leur attachement aux traditions."
                                            },
                                            {
                                                "example_id": "6ac0f30c-de76-49be-a4c6-69f9cd2a19d8",
                                                "sense_id": "83026720-7395-3a7b-99fc-1e480bace57e",
                                                "text": "Les joueurs incarnent des voyageurs de Tokaïdo, la route de la mer, entre Kyoto et Edo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eca163e-5248-3dc3-a449-4d9e47c92e7a",
                                        "entry_id": "95ad371d-344f-33b1-9b4f-194d19c63ffd",
                                        "glosses": [
                                            "Préfecture du Japon, dont la capitale est la précédente."
                                        ],
                                        "tags": [
                                            "Moins courant"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b0ae277-65e0-4f8f-9977-2d0e615ab443",
