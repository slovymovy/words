                "senses": [
                    {
                        "sense_id": "194ba9f9-7970-3aa2-bac3-5283b31f6da7",
                        "entry_id": "1e8da0b7-505e-3fb7-a98a-507d20dd0414",
                        "glosses": [
                            "мед. врач — специалист в области оториноларингологии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb6a5130-5032-43ec-93aa-2caf05eab824",
                                "sense_id": "194ba9f9-7970-3aa2-bac3-5283b31f6da7",
                                "text": "По понедельникам нас всех обязательно водят к врачу, к оториноларингологу, проще — к горловику .."
                            },
                            {
                                "example_id": "4932d1bc-14ec-4500-84d2-7b87f2e578c3",
                                "sense_id": "194ba9f9-7970-3aa2-bac3-5283b31f6da7",
                                "text": "Только оториноларинголог, заглянув при помощи особых зеркал внутрь ушка, увидит, прошло ли воспаление."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02655948-2074-40ef-b817-f3b159353e49",
