                        "examples": [
                            {
                                "example_id": "5a1c3ce3-1e71-4ae3-80a1-675f347755fa",
                                "sense_id": "2a136ba2-0980-3dcf-9377-3b5733815f65",
                                "text": "In 2014 werden in Nederland de eerste diversiteitsmedewerkers in het hoger onderwijs aangesteld. De Universiteit Leiden en de Vrije Universiteit Amsterdam waren de eerste universiteiten met zo'n medewerker. Elke universiteit en hogeschool uit het onderzoek heeft tegenwoordig een vorm van diversiteitsbeleid."
                            },
                            {
                                "example_id": "84b07ecf-0c89-4cd0-af06-e08630b9f5ce",
                                "sense_id": "2a136ba2-0980-3dcf-9377-3b5733815f65",
                                "text": "Randstad zegt na eigen onderzoek dat het loonverschil daar niet speelt. Beide bedrijven zeggen dat het beloningsbeleid onderdeel is van een breder diversiteitsbeleid, met bijvoorbeeld vrouwvriendelijke arbeidsvoorwaarden en genderneutrale vacatureteksten."
                            },
                            {
                                "example_id": "0d1ebae2-a7e9-4358-ac5f-46f3188da678",
                                "sense_id": "2a136ba2-0980-3dcf-9377-3b5733815f65",
                                "text": "Gesterkt door juridische uitspraken en de verkiezing van Donald Trump voeren conservatieven fel strijd tegen diversiteitsprogramma’s van bedrijven. Toch blijkt dat Amerikaanse werknemers en managers vrij positief zijn over diversiteitsbeleid op de werkvloer."
                            }
                        ]
                    }
