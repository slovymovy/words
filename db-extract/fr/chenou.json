                "senses": [
                    {
                        "sense_id": "3e218e92-9512-3ea7-bf7c-8d014169abeb",
                        "entry_id": "7b4da67d-c6d9-3243-b869-99dd76054584",
                        "glosses": [
                            "Sorte de prince de l'ancien Congo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d98d752e-92f2-453a-b5fe-e8965bfb6609",
                                "sense_id": "3e218e92-9512-3ea7-bf7c-8d014169abeb",
                                "text": "Chaque homme a un nombre de femmes proportionné à son rang: le chenou ou chef en a 50, et les mafouks ou officiers, de 10 à 20."
                            },
                            {
                                "example_id": "0332a07e-6c0b-432b-8c30-1c76a136bcce",
                                "sense_id": "3e218e92-9512-3ea7-bf7c-8d014169abeb",
                                "text": "Le chef d'une chenounie prend le titre de chenou, et son autorité est héréditaire dans sa famille, en ligne féminine. La fille d'un chenou a droit de se choisir un mari, et il n'est pas permis à celui sur lequel le choix tombe de refuser."
                            },
                            {
                                "example_id": "586563cb-4bdd-4f1c-9589-d3e2a1e5ee61",
                                "sense_id": "3e218e92-9512-3ea7-bf7c-8d014169abeb",
                                "text": "Les chenous sont des princes aimant le luxe et la représentation , et rien de plus ridicule que le bizarre accoutrement des chenous depuis la cataracte du Zaïre jusqu'à son embouchure."
                            }
                        ]
                    }
                ],
