                "senses": [
                    {
                        "sense_id": "29ecd072-d71a-3004-882d-7ee7f23ac5ad",
                        "entry_id": "57cc190c-3aab-3fb1-b495-49046b4e5edb",
                        "glosses": [
                            "The sound of a siren; nee-naw."
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "f10f2f7a-21e9-479b-81f8-a8c891b4091f",
                                "sense_id": "29ecd072-d71a-3004-882d-7ee7f23ac5ad",
                                "text": "Lange gab es noch Angst, wenn irgendwo ein Tatütata zu hören war und die Kinder nicht zu Hause waren.",
                                "translation": "For a long time, it was scary when I heard a \"nee-naw\" somewhere and the children weren't at home.",
                                "english": "For a long time, it was scary when I heard a \"nee-naw\" somewhere and the children weren't at home."
                            },
                            {
                                "example_id": "5eba96bb-87f7-437d-abe9-7e456ac91e35",
                                "sense_id": "29ecd072-d71a-3004-882d-7ee7f23ac5ad",
                                "text": "Die Feuerwehr hat es eilig. Wenn sie mit lautem Tatütata angefahren kommt, bleiben alle Autos stehen.",
                                "translation": "The fire brigade are in a hurry. When they show up with a loud nee-naw, all the cars stand still.",
                                "english": "The fire brigade are in a hurry. When they show up with a loud nee-naw, all the cars stand still."
                            },
                            {
                                "example_id": "02133163-0199-4a40-bca4-791b760eeec2",
                                "sense_id": "29ecd072-d71a-3004-882d-7ee7f23ac5ad",
                                "text": "Noch nie hat er das Tatütata der Polizeisirene mit solcher Freude vernommen.",
                                "translation": "He had never been so glad to hear the \"nee-naw\" of the police siren.",
                                "english": "He had never been so glad to hear the \"nee-naw\" of the police siren."
                            }
                        ]
                    }
                ],
