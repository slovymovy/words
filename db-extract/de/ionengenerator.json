                "senses": [
                    {
                        "sense_id": "0d51a58f-43ab-3b67-a8e1-5734a6fd7c28",
                        "entry_id": "5f31ba2b-b433-37da-b0df-e1b29aefea6c",
                        "glosses": [
                            "Gerät bestehend aus einem Ionisator und einer Hochspannungsquelle zur Erzeugung von Koronaentladungen in Luft oder einem technischen Gas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96186bf2-c508-4515-86ce-61cd8eaf0d53",
                                "sense_id": "0d51a58f-43ab-3b67-a8e1-5734a6fd7c28",
                                "text": "„Die Standardisierung von Generator- und Mess-Ausrüstungen durch eine unabhängige Autorität würde den hastigen und bedauernswerten Trend, Ionengeneratoren von fragwürdiger Sicherheit, Qualität und Ausstoß zu vermarkten, beenden.“"
                            },
                            {
                                "example_id": "90a7b8a8-91e0-4ecc-9c9d-87e6a3551b40",
                                "sense_id": "0d51a58f-43ab-3b67-a8e1-5734a6fd7c28",
                                "text": "„Ionengenerator […] der geregelt so viele negative und positive Ionen in der Zuluft erzeugt, dass das Ionenverhältnis (negative/positive Ionen) wieder dem der Außenluft entspricht (Niveau ca. 2000 Ionen/cm3, Verhältnis zugunsten neg. Ionen ca. 1,5/1).“"
                            },
                            {
                                "example_id": "4ee986d6-ef88-4994-9f7a-ad0b38bcc986",
                                "sense_id": "0d51a58f-43ab-3b67-a8e1-5734a6fd7c28",
                                "text": "„Ionengenerator mit einer Nadelelektrode und einer Masseelektrode, die mit der Nadelelektrode zusammenwirken kann, um zum Produzieren von Ionen eine Koronaentladung in der Luft zu erzeugen, wobei die Masseelektrode derart angeordnet ist, dass sie eine imaginäre Verlängerung einer Längsachse der Nadelelektrode umgibt, dadurch gekennzeichnet, dass ein Teil der Masseelektrode entleert ist, um eine darin ausgebildete Spaltregion zu bilden.“"
                            },
                            {
                                "example_id": "65e696e7-8a9d-47b1-9edc-ca52fcbaadd5",
                                "sense_id": "0d51a58f-43ab-3b67-a8e1-5734a6fd7c28",
                                "text": "„Einrichtung zur Elektroklimatisierung des Innenraumes eines Kraftfahrzeuges […] in dem Frischluft Einlaßkanal ein Ionengenerator angeordnet ist; […]“ Patent:"
                            },
                            {
                                "example_id": "fa64e8ed-2a6b-445c-bf1d-fc89bbf199f6",
                                "sense_id": "0d51a58f-43ab-3b67-a8e1-5734a6fd7c28",
                                "text": "„Ein Ionengenerator, der ein Ionenerzeugungselement in einem Gehäuse beherbergt, wobei das Ionenerzeugungselement eine Entladungsnadelelektrode und eine Masseelektrode, die der Entladungsnadelelektrode zugewandt ist, aufweist, wobei der Ionengenerator Folgendes umfasst: […]“"
                            },
                            {
                                "example_id": "945d0c98-f4d9-47c9-bfec-ae67f08abdbe",
                                "sense_id": "0d51a58f-43ab-3b67-a8e1-5734a6fd7c28",
                                "text": "„Positive oder negative Iongenerator im Gasmedium mit Plasmaeinschluss“"
                            },
                            {
                                "example_id": "1bb2c528-7b6e-43a8-8b5d-335379aed5e0",
                                "sense_id": "0d51a58f-43ab-3b67-a8e1-5734a6fd7c28",
                                "text": "„Ein Klimagerät besteht aus einem Gebläse mit druckseitig angeordnetem Ionengenerator und einem zuströmseitig vom Ionengenerator angeordneten elektrischen Staubabscheider.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
