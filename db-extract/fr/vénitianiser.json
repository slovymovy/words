                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69ed2dbb-72f1-41ae-9fd0-b3c0e1e49891",
                                "sense_id": "27065d2f-9584-3a7a-b6e1-6ddb2f6ea097",
                                "text": "Ouvert à toutes les nouveautés, il sut les assimiler et les « vénitianiser »; parti de Mantegna, il arrive à Giorgione."
                            },
                            {
                                "example_id": "248312ff-7067-4173-aa69-fb3375d6ce23",
                                "sense_id": "27065d2f-9584-3a7a-b6e1-6ddb2f6ea097",
                                "text": "L’Inquisition ne tarda pas à se «vénitianiser» et le gouvernement de la République trouvant que les méthodes et la procédures du Saint-Office avaient du bon les adoptèrent généreusement."
                            }
                        ]
                    }
