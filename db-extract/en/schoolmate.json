                "senses": [
                    {
                        "sense_id": "57dec2e6-75ad-30bb-8cb7-6ca3ec4f5e0d",
                        "entry_id": "9235123b-7a7e-3a62-a5a9-a0d738700730",
                        "glosses": [
                            "A person who was a fellow attendee at one's school."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9f6a56a-df39-46ed-877c-c82ad32c0202",
                                "sense_id": "57dec2e6-75ad-30bb-8cb7-6ca3ec4f5e0d",
                                "text": "I've lost touch with all my old schoolmates: I only see them at class reunions."
                            },
                            {
                                "example_id": "52a4bf9f-a273-4769-ac39-cca554fad459",
                                "sense_id": "57dec2e6-75ad-30bb-8cb7-6ca3ec4f5e0d",
                                "text": "The truth seems to be, however, that when he casts his leaves forth upon the wind, the author addresses, not the many who will fling aside his volume, or never take it up, but the few who will understand him better than most of his schoolmates or lifemates."
                            }
                        ]
                    }
                ],
                "translations": [
