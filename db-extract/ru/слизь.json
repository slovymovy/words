                    },
                    {
                        "sense_id": "139dbbd3-305f-3164-aebc-9f5504f23ff6",
                        "entry_id": "c3b90b3f-764e-3220-8db4-41e0e3d6206e",
                        "glosses": [
                            "любое тягучее скользкое полужидкое вещество"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e49769e7-3e39-422e-bd76-2175c24a4417",
                        "source_entry_id": "c3b90b3f-764e-3220-8db4-41e0e3d6206e",
                        "source_sense_description": "скользкая масса, выделяемая клетками организмов",
                        "target_lang_word": "mucus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mucus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3b1185e-6791-3bfc-bf70-3c3c47fb6b2f",
                                        "entry_id": "fef3ffca-87a6-3d73-afb4-52e3fe85e3db",
                                        "glosses": [
                                            "Mucosité, sécrétion visqueuse et translucide, produite par une muqueuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4247e17-3223-4c1b-ac96-84a46a2951b4",
                                                "sense_id": "a3b1185e-6791-3bfc-bf70-3c3c47fb6b2f",
                                                "text": "Certains mucus produits par des amphibiens peuvent contenir de puissantes toxines protégeant l’animal contre ses prédateurs et des infections fongiques, bactériennes ou virales."
                                            },
                                            {
                                                "example_id": "68641d86-2ae8-4b68-9ec3-7db4fa9b0d5f",
                                                "sense_id": "a3b1185e-6791-3bfc-bf70-3c3c47fb6b2f",
                                                "text": "Pour la défense, des cellules produisent du mucus, sorte d’épaisse couche de gel qui tapisse les cellules de notre tube digestif et les protège, comme un bouclier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bf840d4-11a3-4926-aaeb-9b19ef583c02",
                        "source_entry_id": "c3b90b3f-764e-3220-8db4-41e0e3d6206e",
                        "source_sense_description": "скользкая масса, выделяемая клетками организмов",
                        "target_lang_word": "mucosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mucosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79028b6e-94a1-38bc-a7bd-fe81787510b1",
                                        "entry_id": "08487f50-8849-362b-97a3-2c362fd3083a",
                                        "glosses": [
                                            "Mucus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ebff49f-2f26-426a-a0d3-e50f08bea93b",
                                                "sense_id": "79028b6e-94a1-38bc-a7bd-fe81787510b1",
                                                "text": "Ce fait permet de prévoir l'utilité du spirophore pour combattre l'asphyxie due à l'abondance de mucosités bronchiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2402381e-1bf9-34ae-a854-0a4c3ba11701",
                                        "entry_id": "08487f50-8849-362b-97a3-2c362fd3083a",
                                        "glosses": [
                                            "Suc qui n’est ni tout à fait fluide, ni tout à fait visqueux, que contiennent certaines plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af67b846-305a-4005-99d6-743f6707a90e",
                                                "sense_id": "2402381e-1bf9-34ae-a854-0a4c3ba11701",
                                                "text": "Cette plante abonde en mucosité."
                                            },
                                            {
                                                "example_id": "222c5cf4-1543-4801-a309-07655eedc3af",
                                                "sense_id": "2402381e-1bf9-34ae-a854-0a4c3ba11701",
                                                "text": "Le contenu de ces utricules consiste d’abord en une espèce de mucosité plus lourde que l’eau, et qui maintient la plante au fond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb8ff026-3f54-434a-83e5-8af5ea14e385",
                        "source_entry_id": "c3b90b3f-764e-3220-8db4-41e0e3d6206e",
                        "source_sense_description": "скользкая масса, выделяемая клетками организмов",
                        "target_lang_word": "bave (escargot)",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f227da9d-9130-4bb6-9fbf-c2ca1e963c2f",
                        "source_entry_id": "c3b90b3f-764e-3220-8db4-41e0e3d6206e",
                        "source_sense_description": "скользкое полужидкое вещество",
                        "target_lang_word": "glaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47a71b03-f5e4-3144-ba87-cf246b35fd72",
                                        "entry_id": "5e9ccb4d-3c90-3bc0-b3c2-588c4bc84298",
                                        "glosses": [
                                            "Blanc d’œuf non cuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "082ad16e-5327-4667-8dc0-98a3f0556b30",
                                                "sense_id": "47a71b03-f5e4-3144-ba87-cf246b35fd72",
                                                "text": "Le glaire c'est le nom qu'on donne au blanc d'œuf cru et c'est après qu'on a appelé \"glaire\" tout ce qui sortait de certaines muqueuses, tout ce que l'on peut sécréter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05addf1e-b6d0-35c1-be2a-ae69b869e641",
                                        "entry_id": "5e9ccb4d-3c90-3bc0-b3c2-588c4bc84298",
                                        "glosses": [
                                            "Liquide visqueux, inodore, filant comme du blanc d’œuf, sécrété par les muqueuses dans certaines affections."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d51d4c8-94d7-4ec4-b8b2-ba2f3dddb040",
                                                "sense_id": "05addf1e-b6d0-35c1-be2a-ae69b869e641",
                                                "text": "Comme chaque fois qu’il criait très fort, sa voix s’étrangla sur une toux grasse, venue du fond de ses bronches malades avec un flot de glaires."
                                            },
                                            {
                                                "example_id": "647c6864-d936-465b-9f57-ee0f8a20ca70",
                                                "sense_id": "05addf1e-b6d0-35c1-be2a-ae69b869e641",
                                                "text": "Avoir l’estomac plein de glaires."
                                            }
                                        ]
                                    }
                                ]
                            },
