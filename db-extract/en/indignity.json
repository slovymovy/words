                "translations": [
                    {
                        "translation_id": "da927b5f-141e-4900-a612-515be5000c66",
                        "source_entry_id": "28e2f6c8-444e-3455-aa28-5018d72023ee",
                        "source_sense_id": "3498866c-0ec4-3183-ab2a-7dfc60c8d3ad",
                        "source_sense_description": "sdü",
                        "target_lang_word": "Demütigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Demütigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f502821-b446-3858-b840-eb6fae33002b",
                                        "entry_id": "3b42f778-c78c-3cbe-a424-2f88f2982909",
                                        "glosses": [
                                            "Verletzung der Rechte/der Selbstachtung anderer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db8b9df2-fda4-421e-8174-4242f65156fc",
                                                "sense_id": "0f502821-b446-3858-b840-eb6fae33002b",
                                                "text": "„Der Zweite Weltkrieg und die deutsche Besatzung lagen erst fünfzehn Jahre zurück, und die Erinnerung an Demütigung und Kollaboration schmerzte.“"
                                            },
                                            {
                                                "example_id": "6a771f27-c669-4a2d-baea-a7ce10657566",
                                                "sense_id": "0f502821-b446-3858-b840-eb6fae33002b",
                                                "text": "„Natürlich war es eine Demütigung, von einer Sechzehnjährigen aufs Kreuz gelegt zu werden, doch angesichts des Blutbads, das seine ehemaligen Kollegen da draußen veranstalteten, war die Schmach verkraftbar.“"
                                            },
                                            {
                                                "example_id": "9e871ca6-f497-4596-a20a-e9035198ee2f",
                                                "sense_id": "0f502821-b446-3858-b840-eb6fae33002b",
                                                "text": "„Die Siegesparade in Paris war natürlich ein gewollter Schlag ins Gesicht aller Franzosen, eine bewusste und gezielte Demütigung der Unterlegenen, viele Zuschauer ließ sie erschaudern.“"
                                            },
                                            {
                                                "example_id": "dd40ca2d-8a67-464c-b8d6-b1ad8b652b45",
                                                "sense_id": "0f502821-b446-3858-b840-eb6fae33002b",
                                                "text": "„Mehr als eine Demütigung pro Tag war selbst ihm zuviel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
