                    {
                        "sense_id": "0cd3c4c9-0f56-3214-af6b-7a73b93913d4",
                        "entry_id": "b9f74bdc-2231-3bc8-8326-cf795ac5e1f8",
                        "glosses": [
                            "een wandeling door het bos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f3d96b-6984-4784-8eb2-786395f08979",
                                "sense_id": "0cd3c4c9-0f56-3214-af6b-7a73b93913d4",
                                "text": "Omdat het zulk lekker weer was, wilden zij een lange boswandeling gaan maken."
                            },
                            {
                                "example_id": "501de6f5-2c9c-4133-9be1-a6cc4aaa1d81",
                                "sense_id": "0cd3c4c9-0f56-3214-af6b-7a73b93913d4",
                                "text": "Mijn kinderen staan trouwens absoluut niet te trappelen om zelf ook lange wandelingen te gaan maken. Een boswandeling vinden ze al saai, maar ik heb goede hoop dat ze later in hun leven hun bergschoenen zullen afstoffen en op reis gaan. We zullen zien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a380f761-fd9d-4191-aab1-208e07d80423",
                        "source_entry_id": "b9f74bdc-2231-3bc8-8326-cf795ac5e1f8",
                        "source_sense_id": "0cd3c4c9-0f56-3214-af6b-7a73b93913d4",
                        "source_sense_description": "een wandeling door het bos",
                        "target_lang_word": "Waldspaziergang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waldspaziergang",
