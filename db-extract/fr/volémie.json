                "senses": [
                    {
                        "sense_id": "721f0257-94a5-3155-b84f-ae2a2389ed7f",
                        "entry_id": "a4007e2f-02ed-3373-b111-d075cacaeb46",
                        "glosses": [
                            "Quantité totale de sang dans l’organisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6c69f7a-90f5-4d92-997e-710bd68a5264",
                                "sense_id": "721f0257-94a5-3155-b84f-ae2a2389ed7f",
                                "text": "La volémie est le résultat d’un équilibre entre l’apport en eau et les pertes physiologiques (urines, selles, sueurs, respiration)."
                            },
                            {
                                "example_id": "e7408e60-d8a7-4b1c-93a6-1dbff5739ded",
                                "sense_id": "721f0257-94a5-3155-b84f-ae2a2389ed7f",
                                "text": "L'hémorragie aiguë entraîne une perte brutale proportionnelle de plasma et d'éléments figurés du sang. Bien qu'ici le sang total perdu atteigne 2,5 l, soit environ la moitié de la volémie d'un adulte, l'hématocrite reste initialement stable (t1)."
                            }
                        ]
                    }
                ],
