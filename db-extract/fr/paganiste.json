                "senses": [
                    {
                        "sense_id": "7b55b89d-5c38-3dd1-bd85-a0c3a545c080",
                        "entry_id": "ca28e0e0-1cfa-3273-ada9-50913a18a618",
                        "glosses": [
                            "Païen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c31b384f-3349-48aa-b6e4-1a8c35d1a01a",
                                "sense_id": "7b55b89d-5c38-3dd1-bd85-a0c3a545c080",
                                "text": "Au vu des faits retenus dans l'Ancien Testament pour exclure les paganistes de toute union consacrée, on aurait pu penser que la survenue du catholicisme allait rendre les choses plus simples."
                            },
                            {
                                "example_id": "1b4afee7-3cde-4c4d-8d8d-03aa3709005d",
                                "sense_id": "7b55b89d-5c38-3dd1-bd85-a0c3a545c080",
                                "text": "Une position qui ne satisfait ni les militants du MNR ni ceux du FN, qui rassemblent des gens de « sensibilités différentes » et mélangent des catholiques traditionalistes, des anciens de l’OAS, des royalistes, des racialistes, des paganistes."
                            },
                            {
                                "example_id": "95202a13-6a63-468a-bb82-d59594baba4d",
                                "sense_id": "7b55b89d-5c38-3dd1-bd85-a0c3a545c080",
                                "text": "L’Église refuse pourtant toujours de reconnaître l’athéisme pour ce qu'il est. […]. L’athée serait un paganiste qui s'ignore et qui compterait parmi ses divinités le culte de l'ego, ce qui le conduirait à vouloir que l'humain prenne la place de Dieu."
                            }
                        ]
                    }
