                                "target_senses": [
                                    {
                                        "sense_id": "77fbcba4-7514-3bee-80bb-9bc5aedb1efe",
                                        "entry_id": "7b70c423-b11d-391a-bed8-30986c81b583",
                                        "glosses": [
                                            "Einheit aus hundert Soldaten unter dem Befehl eines Zenturios"
                                        ],
                                        "tags": [
                                            "Römisches Reich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc818a04-7ac0-4fb3-8bba-3afd002b0c1f",
                                                "sense_id": "77fbcba4-7514-3bee-80bb-9bc5aedb1efe",
                                                "text": "„Der Befehlshaber einer Zenturie, der Zenturio ›(Centurio)‹, stieg immer aus den Mannschaftsdienstgraden auf, Zenturio konnte also jeder römische Bürger werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
