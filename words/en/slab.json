{
    "word_family": [
        "slab-sided",
        "slabbing",
        "slab-like"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5aa3099a-e138-3c22-a56b-7723b49c2d17",
                    "sense_definition": "A large, flat, and thick piece of a solid material such as stone, wood, or food.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "flat_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen island was topped with a heavy <w>slab</w> of polished white marble.",
                            "target_lang_translations": {
                                "ru": "Кухонный остров был накрыт тяжелой <w>плитой</w> из полированного белого мрамора.",
                                "zh": "厨房岛台上方铺着一块厚重的抛光白色大理石<w>板</w>。"
                            }
                        },
                        {
                            "text": "He cut a thick <w>slab</w> of cheese to eat with his bread for lunch.",
                            "target_lang_translations": {
                                "ru": "Он отрезал толстый <w>ломоть</w> сыра, чтобы съесть его с хлебом на обед.",
                                "zh": "他切了一大<w>块</w>奶酪，午餐时配着面包吃。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slab of marble",
                        "slab of concrete",
                        "thick slab"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой, плоский и толстый кусок твердого материала, такого как камень, дерево или еда.",
                        "zh": "指石材、木材或食物等固体材料的大块、平坦且厚实的片状物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плита",
                                "target_lang_sense_clarification": "каменная или бетонная"
                            },
                            {
                                "target_lang_word": "ломоть",
                                "target_lang_sense_clarification": "толстый кусок еды"
                            },
                            {
                                "target_lang_word": "слэб",
                                "target_lang_sense_clarification": "цельный спил дерева или камня"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "板",
                                "target_lang_sense_clarification": "指石材或木材的厚板"
                            },
                            {
                                "target_lang_word": "块",
                                "target_lang_sense_clarification": "指食物的厚块"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34e61373-ea55-3269-911a-16195d432b61",
                    "sense_definition": "A thick layer of poured concrete used as a foundation for a building or structure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction crew spent the morning pouring the concrete <w>slab</w> for the new garage.",
                            "target_lang_translations": {
                                "ru": "Строительная бригада все утро заливала бетонную <w>плиту</w> для нового гаража.",
                                "zh": "施工队花了一上午时间为新车库浇筑混凝土<w>地基</w>。"
                            }
                        },
                        {
                            "text": "Before the walls can go up, the <w>slab</w> must be completely dry and level.",
                            "target_lang_translations": {
                                "ru": "Прежде чем возводить стены, <w>плита</w> должна полностью высохнуть и быть ровной.",
                                "zh": "在砌墙之前，混凝土<w>地基</w>必须完全干燥且平整。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "concrete slab",
                        "pour the slab",
                        "foundation slab"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толстый слой залитого бетона, используемый в качестве фундамента для здания или сооружения.",
                        "zh": "用作建筑物或结构地基的厚混凝土层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плита",
                                "target_lang_sense_clarification": "фундаментная или железобетонная"
                            },
                            {
                                "target_lang_word": "бетонное основание",
                                "target_lang_sense_clarification": "конструкция фундамента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混凝土板",
                                "target_lang_sense_clarification": "建筑地基用的混凝土板"
                            },
                            {
                                "target_lang_word": "地基",
                                "target_lang_sense_clarification": "指建筑的基础结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f723f7dc-990a-35fa-981a-c17a360dd9e4",
                    "sense_definition": "A cardboard carton containing 24 cans of a beverage, typically beer.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "packaging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stopped at the bottle shop to pick up a <w>slab</w> of beer for the weekend barbecue.",
                            "target_lang_translations": {
                                "ru": "Он зашел в магазин спиртного, чтобы купить <w>упаковку</w> пива для барбекю на выходных.",
                                "zh": "他顺路去酒铺买了一<w>整箱</w>啤酒，准备周末烧烤用。"
                            }
                        },
                        {
                            "text": "We managed to finish a whole <w>slab</w> of cola during the long road trip.",
                            "target_lang_translations": {
                                "ru": "Нам удалось прикончить целую <w>упаковку</w> колы во время долгой поездки.",
                                "zh": "在漫长的公路旅行中，我们竟然喝完了整整一<w>整箱</w>可乐。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slab of beer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly Australian and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Картонная упаковка, содержащая 24 банки напитка, обычно пива.",
                        "zh": "一种包含24罐饮料（通常是啤酒）的纸板包装。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упаковка",
                                "target_lang_sense_clarification": "из 24 банок"
                            },
                            {
                                "target_lang_word": "ящик",
                                "target_lang_sense_clarification": "пива"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "整箱",
                                "target_lang_sense_clarification": "指成箱的饮料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44ff08c9-bc27-3bb7-a4e0-13fe013dfde4",
                    "sense_definition": "A specific portion or tier within a tax rate structure.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government announced changes to the income tax <w>slab</w> for middle-income earners.",
                            "target_lang_translations": {
                                "ru": "Правительство объявило об изменениях в <w>ступенях</w> подоходного налога для лиц со средним уровнем дохода.",
                                "zh": "政府宣布调整中等收入者的个人所得<w>税阶</w>。"
                            }
                        },
                        {
                            "text": "If your income increases, you might move into a higher tax <w>slab</w>.",
                            "target_lang_translations": {
                                "ru": "Если ваш доход вырастет, вы можете перейти на более высокий налоговый <w>уровень</w>.",
                                "zh": "如果你的收入增加，你可能会进入更高的纳税<w>税率档次</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tax slab",
                        "income tax slab"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in Indian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная часть или уровень в структуре налоговых ставок.",
                        "zh": "税率结构中的特定部分或等级。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ступень",
                                "target_lang_sense_clarification": "налоговой шкалы"
                            },
                            {
                                "target_lang_word": "уровень",
                                "target_lang_sense_clarification": "налогообложения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "税阶",
                                "target_lang_sense_clarification": "税收等级"
                            },
                            {
                                "target_lang_word": "税率档次",
                                "target_lang_sense_clarification": "纳税的收入区间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "741c900d-17e3-32ef-9e6e-1d89ae17da03",
                    "sense_definition": "A very large, heavy, and powerful ocean wave that breaks in shallow water.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ocean",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surfer took a deep breath before dropping into the massive <w>slab</w>.",
                            "target_lang_translations": {
                                "ru": "Серфер сделал глубокий вдох, прежде чем нырнуть в массивный <w>слэб</w>.",
                                "zh": "冲浪者深吸一口气，随后冲向那道巨大的<w>巨浪</w>。"
                            }
                        },
                        {
                            "text": "Only the most experienced professionals attempt to ride a <w>slab</w> of that size.",
                            "target_lang_translations": {
                                "ru": "Только самые опытные профессионалы пытаются оседлать <w>слэб</w> такого размера.",
                                "zh": "只有经验最丰富的专业人士才敢尝试挑战那种规模的<w>巨浪</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "massive slab"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "surfing terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большая, тяжелая и мощная океанская волна, которая разбивается на мелководье.",
                        "zh": "一种在浅水区破碎的巨大、沉重且强劲的海浪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слэб",
                                "target_lang_sense_clarification": "мощная волна в серфинге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巨浪",
                                "target_lang_sense_clarification": "冲浪术语中的强劲浪潮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdc68539-d13d-3816-a40b-b38396a26763",
                    "sense_definition": "The portion of a tectonic plate that sinks into the mantle during subduction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geologists study how the subducting <w>slab</w> affects volcanic activity on the surface.",
                            "target_lang_translations": {
                                "ru": "Геологи изучают, как погружающийся <w>слэб</w> влияет на вулканическую активность на поверхности.",
                                "zh": "地质学家研究俯冲的<w>俯冲板块</w>如何影响地表的火山活动。"
                            }
                        },
                        {
                            "text": "The sinking <w>slab</w> pulls the rest of the tectonic plate along with it.",
                            "target_lang_translations": {
                                "ru": "Погружающаяся <w>плита</w> тянет за собой остальную часть тектонической плиты.",
                                "zh": "下沉的<w>俯冲板块</w>带动了构造板块的其余部分。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "subducting slab",
                        "tectonic slab"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть тектонической плиты, которая погружается в мантию во время субдукции.",
                        "zh": "俯冲带中沉入地幔的构造板块部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слэб",
                                "target_lang_sense_clarification": "погружающаяся часть плиты"
                            },
                            {
                                "target_lang_word": "плита",
                                "target_lang_sense_clarification": "литосферная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "俯冲板块",
                                "target_lang_sense_clarification": "地质学中下沉的板块部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20fc2318-af83-34ab-955e-2a170bbbbb2c",
                    "sense_definition": "A car, often a classic American luxury model, that has been heavily customized with loud speakers and bright paint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent thousands of dollars customizing his <w>slab</w> with a candy-colored paint job.",
                            "target_lang_translations": {
                                "ru": "Он потратил тысячи долларов на тюнинг своего <w>авто</w>, покрасив его в леденцовый цвет.",
                                "zh": "他花了数千美元改装他的<w>改装车</w>，并喷上了糖果色的车漆。"
                            }
                        },
                        {
                            "text": "The parade featured several <w>slabs</w> with hydraulics bouncing down the street.",
                            "target_lang_translations": {
                                "ru": "В параде участвовало несколько <w>лоурайдеров</w> на гидравлике, подпрыгивающих вдоль улицы.",
                                "zh": "游行队伍中有几辆装有液压装置的<w>改装车</w>在街上弹跳前行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "custom slab"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "African American Vernacular English, particularly in Houston"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Автомобиль, часто классическая американская модель класса люкс, сильно кастомизированный с громкими динамиками и яркой краской.",
                        "zh": "一种经过深度改装、配有大功率扬声器和鲜艳喷漆的汽车，通常为经典美式豪华车型。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слэб",
                                "target_lang_sense_clarification": "кастомизированное авто"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "改装车",
                                "target_lang_sense_clarification": "指经过个性化改装的汽车"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19d88796-f99d-3033-9c82-ef252d6b2f73",
                    "sense_definition": "To destroy a building so thoroughly that only the concrete foundation remains.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The powerful hurricane managed to <w>slab</w> several beachfront properties.",
                            "target_lang_translations": {
                                "ru": "Мощному урагану удалось <w>сровнять с землей</w> несколько домов на побережье.",
                                "zh": "强劲的飓风将几处海滨房产彻底<w>夷为平地</w>。"
                            }
                        },
                        {
                            "text": "The neighborhood was completely <w>slabbed</w> by the force of the tornado.",
                            "target_lang_translations": {
                                "ru": "Район был полностью <w>разрушен до основания</w> силой торнадо.",
                                "zh": "整个街区被龙卷风的力量彻底<w>夷为平地</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "raze"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the context of natural disasters"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушить здание настолько основательно, что остается только бетонный фундамент.",
                        "zh": "彻底摧毁建筑物，使其仅剩下混凝土基础。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сровнять с землей",
                                "target_lang_sense_clarification": "оставив только фундамент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "夷为平地",
                                "target_lang_sense_clarification": "指彻底摧毁建筑"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b446a122-c3b6-3662-b509-e3f4e1440d11",
                    "sense_definition": "Having a thick or viscous consistency.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "viscosity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witch stirred the <w>slab</w> mixture in her bubbling cauldron.",
                            "target_lang_translations": {
                                "ru": "Ведьма мешала <w>густое</w> варево в своем бурлящем котле.",
                                "zh": "女巫在沸腾的坩埚里搅拌着那团<w>浓稠</w>的混合物。"
                            }
                        },
                        {
                            "text": "The mud was so <w>slab</w> that it was difficult to walk through the field.",
                            "target_lang_translations": {
                                "ru": "Грязь была такой <w>вязкой</w>, что по полю было трудно идти.",
                                "zh": "泥地非常<w>粘稠</w>，走过那片田野十分困难。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий густую или вязкую консистенцию.",
                        "zh": "具有浓稠或粘稠的质地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "густой",
                                "target_lang_sense_clarification": "вязкий"
                            },
                            {
                                "target_lang_word": "вязкий",
                                "target_lang_sense_clarification": "плотный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浓稠",
                                "target_lang_sense_clarification": "形容物质粘稠"
                            },
                            {
                                "target_lang_word": "粘稠",
                                "target_lang_sense_clarification": "形容质地厚重"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}