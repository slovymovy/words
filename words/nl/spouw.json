            "senses": [
                {
                    "sense_id": "8acbb89a-44e4-32da-aa22-ac2bfc42ac59",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>spouwen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>spouw</w> de vis direct nadat hij gevangen is.",
                            "target_lang_translations": {
                                "en": "I <w>gut</w> the fish immediately after it is caught."
                            }
                        },
                        {
                            "text": "Als ik de vis <w>spouw</w>, verwijder ik voorzichtig de ingewanden.",
                            "target_lang_translations": {
                                "en": "When I <w>slit open</w> the fish, I carefully remove the entrails."
                            }
