                                            {
                                                "example_id": "0322d677-2423-4f81-b573-bc6a1e376ce7",
                                                "sense_id": "4d5e03aa-6a4d-3cd6-b81f-039d46c2e9e9",
                                                "text": "Lass uns den Senegal hinunterfahren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Senegal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f0a8ff6-e25e-357e-bf48-295f72d1d10d",
                                        "entry_id": "46f3d150-6db6-3cb6-9f50-34715348a520",
                                        "glosses": [
                                            "Staat an der westafrikanischen Atlantikküste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa0def0a-4a73-4c4a-8aad-9c4ff00796f0",
                                                "sense_id": "1f0a8ff6-e25e-357e-bf48-295f72d1d10d",
                                                "text": "Dakar ist die Hauptstadt von Senegal."
                                            },
                                            {
                                                "example_id": "88e76d3b-a2c5-4259-a622-787952d646ee",
                                                "sense_id": "1f0a8ff6-e25e-357e-bf48-295f72d1d10d",
                                                "text": "„Der Senegal liegt im äußersten Westen Afrikas im Übergang der Sahelzone zu den Tropen.“"
                                            },
                                            {
                                                "example_id": "6a6bcbba-5d1f-4363-9cf0-3cc909ea80c7",
                                                "sense_id": "1f0a8ff6-e25e-357e-bf48-295f72d1d10d",
                                                "text": "„Grundsätzlich hat der Senegal den Status eines Entwicklungslandes, ist jedoch im Vergleich zu anderen westafrikanischen Ländern weiter entwickelt, was aber seine Produkte im Regionalvergleich überteuert wirken lässt.“"
                                            },
                                            {
                                                "example_id": "87fa3a4f-b239-4881-923a-f11609f24f9c",
                                                "sense_id": "1f0a8ff6-e25e-357e-bf48-295f72d1d10d",
                                                "text": "„Senegal liegt im Bereich wechselfeuchten Tropenklimas im Süden und tropischen Trockenklimas im Norden.“"
                                            },
                                            {
                                                "example_id": "5d2be3a2-83fd-4130-be79-7db2849a6f6b",
                                                "sense_id": "1f0a8ff6-e25e-357e-bf48-295f72d1d10d",
                                                "text": "„Laye floh mit seiner Frau und vier Kindern nach Senegal und kehrte nicht mehr nach Guinea zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1802196b-e865-46a9-a2fd-03cc9f682efb",
                        "source_entry_id": "3253c3ad-d481-360b-bed6-9fd6759ed1e6",
                        "source_sense_id": "81c9974f-2c06-3455-82da-f2da83f5050a",
                        "source_sense_description": "land in West-Afrika",
                        "target_lang_word": "Sénégal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sénégal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1503cd9-0ea1-32f7-a903-62dae357dc11",
                                        "entry_id": "ae0d5faf-68b0-38da-b50b-18ed43d2c617",
                                        "glosses": [
                                            "Pays d’Afrique, bordé par l’océan Atlantique à l’ouest, la Mauritanie au nord-est, le Mali à l’est, la Guinée au sud-est et la Guinée-Bissau au sud. Sa capitale est Dakar."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b79d6bdc-6b76-451c-83da-83dd2d33eaa7",
                                                "sense_id": "e1503cd9-0ea1-32f7-a903-62dae357dc11",
                                                "text": "Nous étions à 800 kilomètres environ de la côte du Sénégal ; il était 10 heures (G.M.T.) et nous volions depuis 14 heures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "330d83f9-18d5-3eb7-9e05-c5ba4c3bfcc0",
                                        "entry_id": "ae0d5faf-68b0-38da-b50b-18ed43d2c617",
                                        "glosses": [
                                            "Ancienne colonie française d’Afrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b49d77f7-56fe-4bdb-821b-9138538099f1",
                                                "sense_id": "330d83f9-18d5-3eb7-9e05-c5ba4c3bfcc0",
                                                "text": "Quand on considère avec quelle prudence ce Directeur Général du Commerce François au Sénégal, ménagea les affaires de la Compagnie, & quelle considération il s'attira des Rois Nègres dans tous ses Voyages, on prend nécessairement une haute idée de son esprit & de son habileté."
                                            },
                                            {
                                                "example_id": "8b23f541-e4b5-42e0-86c5-eed17a32c351",
                                                "sense_id": "330d83f9-18d5-3eb7-9e05-c5ba4c3bfcc0",
                                                "text": "Le Sénégal peut fournir, année commune, cinquante captifs, quatre mille cuirs, douze cens quintaux de gomme, & vingt quintaux de morfil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "045ad1a1-c781-3481-bb29-b6cd129bf2d4",
                                        "entry_id": "ae0d5faf-68b0-38da-b50b-18ed43d2c617",
                                        "glosses": [
                                            "Fleuve d’Afrique, qui sert de frontière entre la Mauritanie et le Sénégal."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d4e551-2663-416a-b9bc-446b08443e12",
                                                "sense_id": "045ad1a1-c781-3481-bb29-b6cd129bf2d4",
                                                "text": "Le chemin de fer dont la nature impose tout d'abord le tracé est celui qui doit relier le terminus du Sénégal navigable au point de départ du moyen Niger, soit approximativement Kayes à Bammako."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
