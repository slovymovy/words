{
    "word_family": [
        "décapitation",
        "décapiteur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b644147-3762-3be7-8842-31a7636ac5e0",
                    "sense_definition": "Trancher la tête d'une personne, notamment lors d'une exécution.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le roi a été condamné à mort puis <w>décapité</w> sur la place publique devant la foule."
                        },
                        {
                            "text": "Au Moyen Âge, le bourreau pouvait <w>décapiter</w> les condamnés d'un seul coup d'épée."
                        }
                    ],
                    "synonyms": [
                        "couper le cou"
                    ],
                    "common_phrases": [
                        "faire décapiter",
                        "être décapité"
                    ]
                },
                {
                    "sense_id": "4400eca1-aa2e-332f-abc3-7b91ec866222",
                    "sense_definition": "Trancher ou enlever la partie supérieure de quelque chose, comme un végétal ou un objet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "trancher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier a dû <w>décapiter</w> les grands arbres pour éviter qu'ils ne touchent les câbles."
                        },
                        {
                            "text": "Une violente tempête a fini par <w>décapiter</w> le vieux clocher du village voisin."
                        }
                    ],
                    "synonyms": [
                        "étêter"
                    ],
                    "common_phrases": [
                        "décapiter un arbre"
                    ]
                },
                {
                    "sense_id": "cc8ba1ff-32a9-348b-9c12-837427e27cf7",
                    "sense_definition": "Priver un groupe, une organisation ou un mouvement de ses principaux dirigeants.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dirigeants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vaste opération de police a permis de <w>décapiter</w> le réseau criminel en arrêtant ses chefs."
                        },
                        {
                            "text": "Le gouvernement a cherché à <w>décapiter</w> l'opposition politique en emprisonnant tous ses meneurs."
                        }
                    ],
                    "common_phrases": [
                        "décapiter l'opposition",
                        "décapiter un réseau"
                    ]
                }
            ]
        }
    ]
