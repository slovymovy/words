                        "examples": [
                            {
                                "example_id": "a2bc9a54-ecc3-49aa-9da8-74ab736cef0b",
                                "sense_id": "8bc40876-b21e-3799-9046-06ee789cbcac",
                                "text": "Ben oui, où sortir à Gre le soir, sans avoir à déplier une méga carte des bars et salles, ou à éplucher son journal favori pour consulter l’agenda du jour ?"
                            },
                            {
                                "example_id": "617f917f-e46f-4d02-9683-99ae88d38990",
                                "sense_id": "8bc40876-b21e-3799-9046-06ee789cbcac",
                                "text": "Bidouille à Gre est une association qui a pour objet la promotion du « Do It Yourself » (Fais-le toi même), du bricolage et de la bidouille sous toutes ses formes, à travers des évènements festifs dans l’agglomération grenobloise."
                            }
                        ]
                    }
