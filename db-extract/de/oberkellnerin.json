                                "example_id": "0241f7cb-8b40-477b-adb0-97de6623e474",
                                "sense_id": "0e9d61a7-665a-38ae-b84b-f955b48b6f81",
                                "text": "„Auch die Oberkellnerin und der Personalchef hätten ihm nicht weitergeholfen.“"
                            },
