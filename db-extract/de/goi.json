                "senses": [
                    {
                        "sense_id": "0e660cbf-3db7-33fa-9ed6-1e8bcb566b89",
                        "entry_id": "bda20dfc-959e-3e80-9bb5-b40b3778d744",
                        "glosses": [
                            "Nichtjude"
                        ],
                        "tags": [
                            "jüdische Bezeichnung für"
                        ],
                        "examples": [
                            {
                                "example_id": "96e76907-285a-42e3-afb7-1216a6bd81e8",
                                "sense_id": "0e660cbf-3db7-33fa-9ed6-1e8bcb566b89",
                                "text": "„Die Durchschnittsmeinung dürfte dahin gegangen sein, daß ein Ger-toschab, der 12 Monate im Lande gewohnt hat, ohne die Beschneidung anzunehmen und damit Vollproselyt […] zu werden, einfach als ein Goi, d. h. als ein Nichtjude anzusehen sei.“"
                            },
                            {
                                "example_id": "2d4ffb67-cbf9-4a5f-acb5-6fd68ae76657",
                                "sense_id": "0e660cbf-3db7-33fa-9ed6-1e8bcb566b89",
                                "text": "„Der alte Mann sieht die Gesichter der Gojim auf die Opfer starren.“"
                            },
                            {
                                "example_id": "2bd97cf7-d82e-450d-8757-5c2e44d2bb99",
                                "sense_id": "0e660cbf-3db7-33fa-9ed6-1e8bcb566b89",
                                "text": "„Er hatte sich, obwohl er ein Unterweltler war, nie an die Gojim und ihr Benehmen gewöhnen können.“"
                            },
                            {
                                "example_id": "8058e5c9-c76e-4f56-b154-b8ab8d2249d0",
                                "sense_id": "0e660cbf-3db7-33fa-9ed6-1e8bcb566b89",
                                "text": "„Alle Kinder waren wohl gelungen, mit hellen Augen und hellen Haaren, groß und schlank, sie sahen aus wie Gojim.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e95d3c85-bc2c-3696-a83f-4fb227745e08",
                        "entry_id": "bda20dfc-959e-3e80-9bb5-b40b3778d744",
                        "glosses": [
                            "Christ, aber auch erweitert für Heide oder Nichtjude"
