{
    "word_family": [
        "bangly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e7f1230-539b-3cd2-94be-c1ddc95cb28c",
                    "sense_definition": "A rigid bracelet or anklet, typically without a clasp.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jewelry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore several gold <w>bangles</w> that jingled whenever she moved her arm.",
                            "target_lang_translations": {
                                "ru": "На ней было несколько золотых <w>браслетов</w>, которые звенели при каждом движении руки."
                            }
                        },
                        {
                            "text": "The artisan crafted a beautiful silver <w>bangle</w> for the wedding ceremony.",
                            "target_lang_translations": {
                                "ru": "Мастер изготовил красивый серебряный <w>браслет</w> для свадебной церемонии."
                            }
                        }
                    ],
                    "synonyms": [
                        "bracelet"
                    ],
                    "common_phrases": [
                        "gold bangle",
                        "wear bangles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жесткий браслет или ножной браслет, обычно без застежки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "браслет",
                                "target_lang_sense_clarification": "украшение в виде кольца, носимое на запястье или лодыжке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c820358c-7ba6-3463-867a-7995cd7279e6",
                    "sense_definition": "A large, rough stick or a cut branch of a tree.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The woodsman gathered a heavy <w>bangle</w> to use as a makeshift tool.",
                            "target_lang_translations": {
                                "ru": "Лесник подобрал тяжелый <w>сук</w>, чтобы использовать его как временный инструмент."
                            }
                        },
                        {
                            "text": "He cleared the path by removing a large <w>bangle</w> that had fallen during the storm.",
                            "target_lang_translations": {
                                "ru": "Он расчистил тропинку, убрав большую <w>ветку</w>, упавшую во время бури."
                            }
                        }
                    ],
                    "synonyms": [
                        "stick",
                        "branch"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or archaic usage referring to wood."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая грубая палка или срезанная ветка дерева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ветка",
                                "target_lang_sense_clarification": "часть дерева, отделившаяся или срезанная"
                            },
                            {
                                "target_lang_word": "сук",
                                "target_lang_sense_clarification": "толстая, часто грубая ветка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27ac3bfa-fc97-37e2-b23f-a83266e98c33",
                    "sense_definition": "To waste or squander something carelessly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>bangle</w> away your precious time on trivial matters.",
                            "target_lang_translations": {
                                "ru": "Не <w>растрачивайте</w> свое драгоценное время на пустяки."
                            }
                        },
                        {
                            "text": "They <w>bangled</w> away their inheritance on foolish investments.",
                            "target_lang_translations": {
                                "ru": "Они <w>промотали</w> свое наследство на глупых инвестициях."
                            }
                        }
                    ],
                    "synonyms": [
                        "squander",
                        "waste",
                        "fritter"
                    ],
                    "antonyms": [
                        "save",
                        "conserve"
                    ],
                    "common_phrases": [
                        "bangle away"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспечно тратить или разбазаривать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растрачивать",
                                "target_lang_sense_clarification": "небрежно расходовать ресурсы или время"
                            },
                            {
                                "target_lang_word": "проматывать",
                                "target_lang_sense_clarification": "бессмысленно тратить деньги или наследство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2a313a0-8995-3e8a-9cb5-2af6d2c47d0b",
                    "sense_definition": "To flap or hang down loosely.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old hat began to <w>bangle</w> over his eyes as the wind picked up.",
                            "target_lang_translations": {
                                "ru": "Старая шляпа начала <w>болтаться</w> у него на глазах, когда поднялся ветер."
                            }
                        },
                        {
                            "text": "The dog's ears <w>bangled</w> as it ran through the tall grass.",
                            "target_lang_translations": {
                                "ru": "Уши собаки <w>болтались</w>, пока она бежала через высокую траву."
                            }
                        }
                    ],
                    "synonyms": [
                        "dangle",
                        "flap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободно свисать или болтаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтаться",
                                "target_lang_sense_clarification": "свободно висеть или раскачиваться"
                            },
                            {
                                "target_lang_word": "свисать",
                                "target_lang_sense_clarification": "находиться в висячем положении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7255d12-f528-3cb4-be35-d05d61a40094",
                    "sense_definition": "To beat down or flatten crops due to wind or weather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy storm wind <w>bangled</w> the corn in the field.",
                            "target_lang_translations": {
                                "ru": "Сильный штормовой ветер <w>примял</w> кукурузу в поле."
                            }
                        },
                        {
                            "text": "Strong gusts often <w>bangle</w> the wheat before the harvest.",
                            "target_lang_translations": {
                                "ru": "Сильные порывы ветра часто <w>приминают</w> пшеницу перед сбором урожая."
                            }
                        }
                    ],
                    "synonyms": [
                        "flatten",
                        "beat"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Specific to agricultural contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пригибать к земле или приминать сельскохозяйственные культуры из-за ветра или непогоды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приминать",
                                "target_lang_sense_clarification": "пригибать растения к земле"
                            },
                            {
                                "target_lang_word": "повалить",
                                "target_lang_sense_clarification": "о сильном воздействии ветра на посевы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50c155ec-3337-33c4-84c4-dc046573f5db",
                    "sense_definition": "To flutter or beat about in the air, specifically referring to a hawk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young hawk began to <w>bangle</w> in the air instead of diving.",
                            "target_lang_translations": {
                                "ru": "Молодой ястреб начал <w>порхать</w> в воздухе вместо того, чтобы пикировать."
                            }
                        },
                        {
                            "text": "The bird <w>bangled</w> uncertainly before finally catching a thermal.",
                            "target_lang_translations": {
                                "ru": "Птица неуверенно <w>трепетала</w> крыльями, прежде чем наконец поймала восходящий поток."
                            }
                        }
                    ],
                    "synonyms": [
                        "flutter"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the context of falconry."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Порхать или беспорядочно махать крыльями в воздухе (о ястребе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порхать",
                                "target_lang_sense_clarification": "неуверенно или часто махать крыльями"
                            },
                            {
                                "target_lang_word": "трепетать",
                                "target_lang_sense_clarification": "о быстрых, суетливых движениях крыльев"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}