                },
                {
                    "sense_id": "c13cbbd4-fdba-39e6-b692-5bba6c887be0",
                    "sense_definition": "Met minachting bekijken of afwijzen; verachten.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geestelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij leek de adviezen van zijn vrienden volkomen te <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "He seemed to completely <w>spurn</w> his friends' advice."
                            }
                        },
                        {
                            "text": "De trotse koning wilde het aanbod van zijn tegenstander <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "The proud king wanted to <w>scorn</w> his opponent's offer."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "obsoleet"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To view with contempt or reject; to despise."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "despise",
                                "target_lang_sense_clarification": "to look down upon"
                            },
                            {
                                "target_lang_word": "spurn",
                                "target_lang_sense_clarification": "to reject contemptuously"
                            },
                            {
                                "target_lang_word": "scorn",
                                "target_lang_sense_clarification": "to treat with disdain"
                            }
                        ]
                    }
                },
