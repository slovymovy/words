                "senses": [
                    {
                        "sense_id": "1a0d6cf3-01dd-322b-8df4-98e2c82bc200",
                        "entry_id": "1b8ac074-61e0-3b79-9611-70abf81f66c5",
                        "glosses": [
                            "неперех., разг. вести жизнь, характерную для цыган; скитаться, бродяжничать, переезжать с места на место"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8e9617e9-c758-3e51-9282-214e442cb420",
                        "entry_id": "1b8ac074-61e0-3b79-9611-70abf81f66c5",
                        "glosses": [
                            "устар., разг. насмехаться, передразнивая; подымать на смех"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7a2f07d-2231-4bf4-8984-f5757182fe98",
                                "sense_id": "8e9617e9-c758-3e51-9282-214e442cb420",
                                "text": "На глазах лебезят хозяину, а чуть за угол, и пошли его ругать да цыганить…"
                            }
                        ]
                    },
                    {
                        "sense_id": "445c8e10-f344-30a6-83d8-1630bb55f9e4",
                        "entry_id": "1b8ac074-61e0-3b79-9611-70abf81f66c5",
                        "glosses": [
                            "перен., разг. назойливо выпрашивать, клянчить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f9ed46e-c55f-44cd-8f6e-aafb04a39fe3",
                                "sense_id": "445c8e10-f344-30a6-83d8-1630bb55f9e4",
                                "text": "Давай, старик, цыгань отпуск и рви к нам."
                            },
                            {
                                "example_id": "1831db68-29e0-4bf6-a3a4-b40870b2b198",
                                "sense_id": "445c8e10-f344-30a6-83d8-1630bb55f9e4",
                                "text": "— И хлеба бы подкинуть надо, — продолжала цыганить Анфиса."
                            }
                        ]
                    }
                ],
