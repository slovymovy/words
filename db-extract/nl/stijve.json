                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "057b6688-1202-496b-b6da-77629bb10039",
                                                "sense_id": "6f1d4263-7f1d-39f9-8047-6d3423cde41e",
                                                "text": "Ich habe mein Fahrrad am Ständer abgeschlossen."
                                            },
                                            {
                                                "example_id": "efa4c199-0141-4d36-8abc-29b7d81baa9c",
                                                "sense_id": "6f1d4263-7f1d-39f9-8047-6d3423cde41e",
                                                "text": "„Und er hob, als er wieder allein war, den Koffer auf den Ständer und begann zu packen.“"
                                            },
                                            {
                                                "example_id": "c982e6b1-de1c-4c07-9632-0caadd5f409a",
                                                "sense_id": "6f1d4263-7f1d-39f9-8047-6d3423cde41e",
                                                "text": "„Man hatte Ständer aufgestellt und so mit gelbem Absperrband verbunden, dass sie einen Korridor mit labyrinthartigen Kehrtwendungen bildeten.“"
                                            },
                                            {
                                                "example_id": "b2bd4efb-2ec5-4ba7-a70b-74953e4273da",
                                                "sense_id": "6f1d4263-7f1d-39f9-8047-6d3423cde41e",
                                                "text": "„Aus dem finsteren Flur sah Ari Bjarki am Schreibtisch sitzen, mehrere Kerzen erleuchteten den Raum, große weiße Kerzen in altmodischen Ständern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9f016ee4-0f03-3d7a-97ba-7bd0c550adc2",
                                        "entry_id": "69741292-520c-38e3-b3cd-6fb3965ec9a5",
                                        "glosses": [
                                            "erigiertes männliches Glied"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c18b2e0-4018-4ced-8036-b537623fe2e2",
                                                "sense_id": "9f016ee4-0f03-3d7a-97ba-7bd0c550adc2",
                                                "text": "Seine Erregung sah man ihm an seinem Ständer an."
                                            },
                                            {
                                                "example_id": "f53108a2-96c1-4e10-afa9-a2b8a7049947",
                                                "sense_id": "9f016ee4-0f03-3d7a-97ba-7bd0c550adc2",
                                                "text": "„Wie fast jeden Morgen war er mit einem ordentlichen Ständer erwacht, und er fragte sich, ob Elisabeth es gesehen hatte.“"
                                            },
                                            {
                                                "example_id": "49cbc94a-aa97-4b45-a5d3-57ef5b0b8e2d",
                                                "sense_id": "9f016ee4-0f03-3d7a-97ba-7bd0c550adc2",
                                                "text": "„Einen Ständer hatte ich eh schon.“"
                                            },
                                            {
                                                "example_id": "a994fccb-68f1-4a5f-917f-3f93b9034e42",
                                                "sense_id": "9f016ee4-0f03-3d7a-97ba-7bd0c550adc2",
                                                "text": "„Ich hatte die ganze Zeit einen Ständer.“"
                                            },
                                            {
                                                "example_id": "cac6b7dd-0cf0-4333-8808-34525d41a4b0",
                                                "sense_id": "9f016ee4-0f03-3d7a-97ba-7bd0c550adc2",
                                                "text": "„Ich hatte einen jener unermüdlichen, ausdauernden Ständer, die eine Frau verrückt machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
