    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "583f6638-acb5-3080-9816-bcc5c367efcb",
                    "sense_definition": "iemand (meestal een patiënt) naar een specialist of een andere instantie sturen voor verdere hulp",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verwijzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De huisarts <w>verwees</w> de ernstig zieke patiënt direct <w>door</w> naar het ziekenhuis.",
                            "target_lang_translations": {
                                "en": "The GP <w>referred</w> the seriously ill patient to the hospital immediately."
                            }
                        },
                        {
                            "text": "Ik moet een patiënt <w>doorverwijzen</w> naar een specialist voor een uitgebreid onderzoek.",
                            "target_lang_translations": {
                                "en": "I need to <w>refer</w> a patient to a specialist for an extensive examination."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwijzen"
                    ],
                    "common_phrases": [
                        "naar een specialist doorverwijzen",
                        "naar het ziekenhuis doorverwijzen"
                    ],
                    "target_lang_definitions": {
                        "en": "to send someone (usually a patient) to a specialist or another institution for further help"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "refer",
                                "target_lang_sense_clarification": "medical or professional context"
                            },
                            {
                                "target_lang_word": "send through",
                                "target_lang_sense_clarification": "to a specialist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79c54556-f3d2-30ec-b365-c56cdd314ee3",
                    "sense_definition": "iemand van de ene persoon of afdeling naar de andere sturen, vaak binnen een organisatie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verwijzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze werd wel drie keer <w>doorverwezen</w> over de telefoon voordat ze de juiste persoon sprak.",
                            "target_lang_translations": {
                                "en": "She was <w>referred</w> as many as three times over the phone before she spoke to the right person."
                            }
                        },
                        {
                            "text": "De receptioniste zal u <w>doorverwijzen</w> naar de juiste afdeling voor uw vragen.",
                            "target_lang_translations": {
                                "en": "The receptionist will <w>direct</w> you to the correct department for your questions."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorsturen"
                    ],
                    "common_phrases": [
                        "naar de juiste afdeling doorverwijzen",
                        "over de telefoon doorverwijzen"
                    ],
                    "target_lang_definitions": {
                        "en": "to send someone from one person or department to another, often within an organization"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "refer",
                                "target_lang_sense_clarification": "to another department or person"
                            },
                            {
                                "target_lang_word": "direct",
                                "target_lang_sense_clarification": "to the right person or place"
                            },
                            {
                                "target_lang_word": "forward",
                                "target_lang_sense_clarification": "a person or a call"
                            }
                        ]
                    }
                }
            ]
        }
    ]
