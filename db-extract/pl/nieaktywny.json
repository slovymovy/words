                                        "entry_id": "718a2cac-3dd8-3110-b974-324063f76a00",
                                        "glosses": [
                                            "als Mensch nicht tätig, nicht engagiert, nicht mit Beiträgen dabei seiend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be12c8a3-391b-4357-9b0d-1b60aa1e168a",
                                                "sense_id": "cf859dfe-dbf6-3960-ad28-3cbb1a700c88",
                                                "text": "„Aber auch eine andere Erfahrungsweisheit erhält ihre Gültigkeit: Wer bei der Arbeit, auch einer nicht gerade geliebten, lau und lustlos ist, wird auch sonst ein inaktiver Mensch sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99f31b8f-4f77-30bd-93fc-1e9c966e6308",
                                        "entry_id": "718a2cac-3dd8-3110-b974-324063f76a00",
                                        "glosses": [
                                            "nicht reagierend, nicht wirksam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37d39f3-276a-4b26-8216-6a13cb5fb986",
                                                "sense_id": "99f31b8f-4f77-30bd-93fc-1e9c966e6308",
                                                "text": "„Die Veränderung der Rezeptorkonformation wirkt als Signal, das eine inaktive Substanz (A) in ihre aktive Form umwandelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6359f193-c6c3-347a-b1e9-a3327d875330",
                                        "entry_id": "718a2cac-3dd8-3110-b974-324063f76a00",
                                        "glosses": [
                                            "als Sache/Ding (vorübergehend) ruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7901b40-073e-408f-8b11-5f28cf6d7cde",
                                                "sense_id": "6359f193-c6c3-347a-b1e9-a3327d875330",
                                                "text": "„Heutzutage gilt der Vesuv als ein inaktiver Vulkan, wobei die Fumarolen der Phlegräischen Felder zeigen, dass es im Erdinneren brodelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
