                                    {
                                        "sense_id": "bacd1a38-ae6c-3488-8b8a-2d0a3e10a16e",
                                        "entry_id": "e583a426-dd78-338e-a699-e1e755b900ab",
                                        "glosses": [
                                            "An entryway or reception area; vestibule; passageway; corridor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6b85dd6-d456-4b5a-813c-2ffd7a934049",
                                                "sense_id": "bacd1a38-ae6c-3488-8b8a-2d0a3e10a16e",
                                                "text": "I had to wait in the lobby for hours before seeing the doctor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45521634-6db9-39bc-a402-e0aeebba965f",
                                        "entry_id": "e583a426-dd78-338e-a699-e1e755b900ab",
                                        "glosses": [
                                            "That part of a hall of legislation not appropriated to the official use of the assembly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a996f3b9-ebe9-3e76-a1a9-78edf23c5567",
                                        "entry_id": "e583a426-dd78-338e-a699-e1e755b900ab",
                                        "glosses": [
                                            "A class or group of interested people who try to influence public officials; collectively, lobbyists."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b4cfa99-5450-4b0e-9939-b3349db57bd2",
                                                "sense_id": "a996f3b9-ebe9-3e76-a1a9-78edf23c5567",
                                                "text": "Near-synonym: special interest"
                                            },
                                            {
                                                "example_id": "521f4646-298c-4778-89f6-8f650923d9a4",
                                                "sense_id": "a996f3b9-ebe9-3e76-a1a9-78edf23c5567",
                                                "text": "The influence of the tobacco lobby has decreased considerably in the US."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10c30f93-570d-30b3-9076-c68cb7cf62f1",
                                        "entry_id": "e583a426-dd78-338e-a699-e1e755b900ab",
