                ],
                "senses": [
                    {
                        "sense_id": "c618af5c-384f-33bf-9042-7fe30069f439",
                        "entry_id": "232ee89a-78e1-3d24-a262-09f3cb747dd6",
                        "glosses": [
                            "Attitude de celui qui ne manifeste aucun intérêt, aucune compassion envers quoi que ce soit."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "112de9e6-3ee9-4fb2-85cc-00cf1fc7772d",
                                "sense_id": "c618af5c-384f-33bf-9042-7fe30069f439",
                                "text": "Ce n’était qu’un signe de plus du laisser-aller général, du j’menfoutisme et du bordel systématique qui s’installaient partout !"
                            },
                            {
                                "example_id": "51fd822c-ca2c-4e76-8930-740dcd9c1a38",
                                "sense_id": "c618af5c-384f-33bf-9042-7fe30069f439",
                                "text": "Le manque de consistance et de générosité dans l’échange correspondent, plus que de l’indifférence, à du « j’menfoutisme »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f02870f-c3d7-4b3b-8b12-dac3d7421f17",
                        "source_entry_id": "232ee89a-78e1-3d24-a262-09f3cb747dd6",
                        "source_sense_id": "c618af5c-384f-33bf-9042-7fe30069f439",
                        "target_lang_word": "indifference",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indifference",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8211dc7b-db8d-3724-99de-b6801dc58e8e",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "The state of being indifferent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d345c28b-656b-4d8a-8a21-7e08bc97b6b4",
                                                "sense_id": "8211dc7b-db8d-3724-99de-b6801dc58e8e",
                                                "text": "\"I do not care for them; I would not have them now,\" cried Lady Penrhyn; \"it is only your affection I care for. Do not suppose, for a moment, that I wish for the tables when you do not: oh, no! my only concern was for your indifference. But I am content if you tell me I was mistaken.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a27db88c-7273-307a-8052-46118583ce1b",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Unbiased impartiality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de990e00-d921-3dc4-9660-7bec3d0ef936",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Unemotional apathy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe74535a-2673-4243-b1ba-a0c645804ac4",
                                                "sense_id": "de990e00-d921-3dc4-9660-7bec3d0ef936",
                                                "text": "His daughter's indifference towards the sexist group made him wonder if she felt no empathy for the bullied."
                                            },
                                            {
                                                "example_id": "59bc99c5-eb46-4f3c-b268-f80e9563c626",
                                                "sense_id": "de990e00-d921-3dc4-9660-7bec3d0ef936",
                                                "text": "I wish the consequences of this moment for young women punctured the apparent indifference of so many men and boys I saw that day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f444eaa-e3f2-3a51-aa04-1b3a0d65594b",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "A lack of enthusiasm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc199469-40a1-3131-9fcc-60afdb8c26b5",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Unconcerned nonchalance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24b5fe27-4d36-434c-8cad-fdf51614a63c",
                                                "sense_id": "bc199469-40a1-3131-9fcc-60afdb8c26b5",
                                                "text": "I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me. I look upon notoriety with the same indifference as on the buttons on a man's shirt-front, or the crest on his note-paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f9ba4cb-8ccf-3405-b6f5-330befd59489",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Self-identity defined through the negation of difference, non-difference."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c41dda57-14d0-4802-9f64-925669bf2cc3",
                                                "sense_id": "9f9ba4cb-8ccf-3405-b6f5-330befd59489",
                                                "text": "\"I call reason absolute reason, or reason insofar as it is conceived as the total indifference of the subjective and objective.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a31ce173-df47-4048-819c-02af3f2a308b",
                        "source_entry_id": "232ee89a-78e1-3d24-a262-09f3cb747dd6",
                        "source_sense_id": "c618af5c-384f-33bf-9042-7fe30069f439",
                        "target_lang_word": "pasotismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pasotismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "8de5a47f-f5a7-3df9-9d4b-3438294d61e2",
                                        "entry_id": "5903259a-95c6-374e-8b80-6a077783afe3",
                                        "glosses": [
                                            "Condición o carácter de pasota."
                                        ],
                                        "tags": [
                                            "Spain",
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "835a98dc-84ad-4623-8cd5-d4dc5c5b4250",
                                                "sense_id": "8de5a47f-f5a7-3df9-9d4b-3438294d61e2",
                                                "text": "Políticos, científicos y ensayistas luchaban con heroísmo contra el desencanto de las nuevas generaciones, sus peligrosas tendencias hacia un pasotismo comodón, anarquizante e irresponsable."
                                            },
                                            {
                                                "example_id": "8e428de3-ebab-42dc-bbf0-fceaa94b7210",
                                                "sense_id": "8de5a47f-f5a7-3df9-9d4b-3438294d61e2",
                                                "text": "En estos aspectos se concentra, básicamente, el problema policial español contra las organizaciones criminales, con consecuencias sociales terribles: unas por la inacción y el pasotismo policial que genera la ausencia de regulación, y otras por los problemas penales y profesionales que acarrea cualquier servicio policial complicado, o en el que haya confidentes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
