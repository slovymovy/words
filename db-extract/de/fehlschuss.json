                "senses": [
                    {
                        "sense_id": "d3933ada-f75e-3aae-8a86-24d34580571c",
                        "entry_id": "a219330d-e712-3abc-9d98-0d49823280d6",
                        "glosses": [
                            "„Schuss, der sein Ziel verfehlt“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f124309d-fda8-445f-a0ae-891fcf18a2af",
                                "sense_id": "d3933ada-f75e-3aae-8a86-24d34580571c",
                                "text": "Die ersten Versuche waren samt und sonders Fehlschüsse."
                            },
                            {
                                "example_id": "b907ce84-2a1c-49b6-80ae-5bc815395a57",
                                "sense_id": "d3933ada-f75e-3aae-8a86-24d34580571c",
                                "text": "„Julian Eberhard zeigte erneut eine starke Laufleistung und verpasste mit einem Fehlschuss das Podium als Vierter um 0,2 Sekunden.“"
                            },
                            {
                                "example_id": "e6b279a0-e435-44bf-8138-6f39e32e8a6e",
                                "sense_id": "d3933ada-f75e-3aae-8a86-24d34580571c",
                                "text": "„Die Bundeswehr füllt damit Kanonenrohre auf, um Fehlschüsse bei Truppenübungen zu vermeiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
