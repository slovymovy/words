                                        "entry_id": "aa938a4c-b2e2-3540-9a08-6cf50893e0cd",
                                        "glosses": [
                                            "Sorte de jeu d’échecs japonais utilisant un tablier de 9×9 cases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a69eac09-02c9-49f2-9fdb-2d9c190e474f",
                                                "sense_id": "56cdfeba-2ec6-3e59-bdfd-32af88f85bbb",
                                                "text": "Le dîner est terminé. Les deux jouent au shôgi. Mon fils rit beaucoup. Je vois qu’il adore son futur oncle."
                                            },
                                            {
                                                "example_id": "72cd585c-8319-4d55-8b7b-fc33037038dc",
                                                "sense_id": "56cdfeba-2ec6-3e59-bdfd-32af88f85bbb",
                                                "text": "Comme les professionnels des échecs, les maîtres du shogi, ou échecs japonais, jouent trois à quatre heures par jour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
