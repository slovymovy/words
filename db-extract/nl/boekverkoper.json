                        "examples": [
                            {
                                "example_id": "0be5366c-47e8-4a38-bada-eddbf1cf8ad5",
                                "sense_id": "f808822a-0ed5-3d80-80dc-7ddfb2917b1b",
                                "text": "Bij boekverkoper Segijn aan het Rokin de Traité de la police gekocht."
                            },
                            {
                                "example_id": "2bdcd78a-f057-44a0-87c8-cd42da19e27e",
                                "sense_id": "f808822a-0ed5-3d80-80dc-7ddfb2917b1b",
                                "text": "Maar als begin dit jaar een wet wordt gelanceerd die het mogelijk maakt Hongkongers uit te leveren aan het Chinese vasteland, wordt het de boekverkoper te heet onder de voeten. \"Niemand wil wonen op een plek waar je je constant zorgen moet maken over je persoonlijke veiligheid. Ik werd constant gevolgd in Hongkong, mijn telefoon werd gemonitord. In zo'n omgeving wil ik niet leven.\" Hij vertrok naar Taiwan."
                            }
                        ]
                    }
