{
    "word_family": [
        "conditional",
        "conditioner",
        "conditioning",
        "unconditional",
        "precondition"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "763fcaa5-9811-3111-9058-868961e03fd7",
                    "sense_definition": "The particular state that something or someone is in at a specific time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car is in excellent <w>condition</w> despite being over ten years old.",
                            "target_lang_translations": {
                                "ru": "Машина находится в отличном <w>состоянии</w>, несмотря на то, что ей более десяти лет."
                            }
                        },
                        {
                            "text": "Doctors are monitoring the patient's <w>condition</w> closely after the surgery.",
                            "target_lang_translations": {
                                "ru": "Врачи внимательно следят за <w>состоянием</w> пациента после операции."
                            }
                        }
                    ],
                    "synonyms": [
                        "fettle"
                    ],
                    "common_phrases": [
                        "excellent condition",
                        "physical condition",
                        "stable condition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное состояние, в котором находится кто-либо или что-либо в определенное время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "физическое или качественное положение объекта"
                            },
                            {
                                "target_lang_word": "положение",
                                "target_lang_sense_clarification": "ситуация или обстоятельства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e37cfcbd-fb4c-3ec8-ae57-0460d9f859f8",
                    "sense_definition": "Something that must happen or be agreed upon before something else can happen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "requirement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A high level of safety is a <w>condition</w> for reopening the factory.",
                            "target_lang_translations": {
                                "ru": "Высокий уровень безопасности является <w>условием</w> для возобновления работы завода."
                            }
                        },
                        {
                            "text": "They agreed to the deal on the <w>condition</w> that the price was lowered.",
                            "target_lang_translations": {
                                "ru": "Они согласились на сделку при <w>условии</w>, что цена будет снижена."
                            }
                        }
                    ],
                    "synonyms": [
                        "requisite",
                        "necessity"
                    ],
                    "common_phrases": [
                        "on the condition",
                        "necessary condition",
                        "terms and conditions"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что должно произойти или быть согласовано, прежде чем сможет произойти что-то другое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "условие",
                                "target_lang_sense_clarification": "требование или предпосылка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97fa8880-7b74-3264-ac54-25f70674dd52",
                    "sense_definition": "An illness or a medical problem that someone has for a long time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a rare heart <w>condition</w> that requires daily medication.",
                            "target_lang_translations": {
                                "ru": "У него редкое сердечное <w>заболевание</w>, требующее ежедневного приема лекарств."
                            }
                        },
                        {
                            "text": "Living with a chronic <w>condition</w> can be very challenging for many people.",
                            "target_lang_translations": {
                                "ru": "Жизнь с хроническим <w>заболеванием</w> может быть очень трудной для многих людей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "medical condition",
                        "heart condition",
                        "chronic condition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Болезнь или медицинская проблема, которая сохраняется у человека в течение длительного времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заболевание",
                                "target_lang_sense_clarification": "хроническая медицинская проблема"
                            },
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "медицинский статус здоровья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44253d2f-0442-30d2-8fbe-e5feb55540a4",
                    "sense_definition": "The social or economic position of a person in society.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the past, a person of his <w>condition</w> would not be allowed to marry into royalty.",
                            "target_lang_translations": {
                                "ru": "В прошлом человеку его <w>положения</w> не разрешили бы вступить в брак с представителем королевской семьи."
                            }
                        },
                        {
                            "text": "The novel explores the human <w>condition</w> through the eyes of the poor.",
                            "target_lang_translations": {
                                "ru": "Роман исследует человеческое <w>бытие</w> глазами бедняков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "human condition",
                        "person of condition"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in historical or literary contexts regarding social rank"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Социальное или экономическое положение человека в обществе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положение",
                                "target_lang_sense_clarification": "социальный статус"
                            },
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "устар. сословие или звание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fde3a9e0-fa1b-351f-8d7b-f38b3d14ed21",
                    "sense_definition": "A specific clause in a legal contract that limits or modifies an obligation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer pointed out a specific <w>condition</w> in the contract regarding late payments.",
                            "target_lang_translations": {
                                "ru": "Адвокат указал на конкретное <w>условие</w> в контракте, касающееся просрочки платежей."
                            }
                        },
                        {
                            "text": "Failure to meet this <w>condition</w> will result in the immediate termination of the agreement.",
                            "target_lang_translations": {
                                "ru": "Невыполнение этого <w>условия</w> приведет к немедленному расторжению соглашения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "breach of condition",
                        "express condition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный пункт в юридическом договоре, который ограничивает или изменяет обязательство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "условие",
                                "target_lang_sense_clarification": "пункт или статья договора"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e0749fd-b630-39fd-9873-d083f961276c",
                    "sense_definition": "To train or influence a person or animal to behave in a certain way or to accept certain circumstances.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Society often <w>conditions</w> people to follow certain beauty standards.",
                            "target_lang_translations": {
                                "ru": "Общество часто <w>приучает</w> людей следовать определенным стандартам красоты."
                            }
                        },
                        {
                            "text": "The dogs were <w>conditioned</w> to salivate at the sound of a bell.",
                            "target_lang_translations": {
                                "ru": "У собак <w>выработали рефлекс</w> выделять слюну на звук колокольчика."
                            }
                        }
                    ],
                    "common_phrases": [
                        "socially conditioned",
                        "conditioned response"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обучать или влиять на человека или животное, чтобы они вели себя определенным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приучать",
                                "target_lang_sense_clarification": "формировать привычку или поведение"
                            },
                            {
                                "target_lang_word": "обусловливать",
                                "target_lang_sense_clarification": "определять реакцию или поведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a741ff35-5b0d-3ee4-acc4-a41a46d67309",
                    "sense_definition": "To apply a substance to something, such as hair or skin, to improve its quality or softness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>condition</w> your hair after every wash to keep it healthy.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>использовать кондиционер</w> для волос после каждого мытья, чтобы они оставались здоровыми."
                            }
                        },
                        {
                            "text": "The leather needs to be <w>conditioned</w> regularly so it does not crack.",
                            "target_lang_translations": {
                                "ru": "Кожу нужно регулярно <w>обрабатывать</w>, чтобы она не трескалась."
                            }
                        }
                    ],
                    "common_phrases": [
                        "condition hair",
                        "deeply condition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить вещество на что-либо (например, на волосы или кожу) для улучшения качества или мягкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кондиционировать",
                                "target_lang_sense_clarification": "обрабатывать специальным средством"
                            },
                            {
                                "target_lang_word": "смягчать",
                                "target_lang_sense_clarification": "улучшать текстуру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08f67f8e-1d10-34ea-8e9b-094fbc08d8f2",
                    "sense_definition": "To make someone or something become used to a new environment or situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Athletes often arrive early to <w>condition</w> themselves to the high altitude.",
                            "target_lang_translations": {
                                "ru": "Спортсмены часто приезжают заранее, чтобы <w>акклиматизироваться</w> к условиям высокогорья."
                            }
                        },
                        {
                            "text": "It took months to <w>condition</w> the team to the new rigorous schedule.",
                            "target_lang_translations": {
                                "ru": "Потребовались месяцы, чтобы <w>приучить</w> команду к новому строгому графику."
                            }
                        }
                    ],
                    "common_phrases": [
                        "condition to the climate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приучать кого-либо или что-либо к новой среде или ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приспосабливать",
                                "target_lang_sense_clarification": "адаптировать к условиям"
                            },
                            {
                                "target_lang_word": "подготавливать",
                                "target_lang_sense_clarification": "тренировать для определенных условий"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}