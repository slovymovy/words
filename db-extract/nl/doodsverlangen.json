                    }
                ],
                "senses": [
                    {
                        "sense_id": "e684e3f5-babf-3fe6-89da-708dca50a4c1",
                        "entry_id": "2370a020-3825-37f7-9b9b-16208cab0511",
                        "glosses": [
                            "de wens om te sterven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99ccbad2-70b7-4b8c-849c-6e6fa09780a9",
                                "sense_id": "e684e3f5-babf-3fe6-89da-708dca50a4c1",
                                "text": "Totdat ik een keer verzuimde in vervoering mijn ogen te sluiten, en recht in Tonio's gezichtje keek. Bij elke zwaai schuin opwaarts vervormden zijn gelaatstrekken zich tot een klein, mollig masker van angst, compleet met neergetrokken mondhoeken en wijd opengesperde ogen. Godweet hoe vaak hij van doodsschrik al zo'n smoeltje opgezet had, zonder dat ik erop lette."
                            },
                            {
                                "example_id": "0c813587-00d7-4277-9336-fd8d2dcdded4",
                                "sense_id": "e684e3f5-babf-3fe6-89da-708dca50a4c1",
                                "text": "Eric Arnold was zich bewust van de gevaren die de klim naar de top van Mount Everest met zich meebracht. \"Dat is geen doodsverlangen, maar wel een soort levensdrift\", zei hij eind februari in het radioprogramma De Nieuws BV op NPO Radio 1. \"Voor mij ligt dat in de bergen. En blijkbaar iets dichter naar de rand van het leven toe, wordt voor mij het leven ook steeds mooier.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa3a3819-28e0-4933-86e1-50278c612c2e",
                        "source_entry_id": "2370a020-3825-37f7-9b9b-16208cab0511",
                        "source_sense_id": "e684e3f5-babf-3fe6-89da-708dca50a4c1",
                        "source_sense_description": "de wens om te sterven",
                        "target_lang_word": "death wish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "death wish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd97b1c4-5dbe-3a66-9043-44308a57f368",
                                        "entry_id": "e6fd797b-9178-34a0-a8f2-24f1606dd767",
                                        "glosses": [
                                            "A desire, especially subconscious, for the death of oneself or of someone else."
                                        ],
                                        "tags": [
                                            "often",
                                            "sarcastic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b1bd07-8054-4f74-a790-ae10b43eb6b9",
                                                "sense_id": "dd97b1c4-5dbe-3a66-9043-44308a57f368",
                                                "text": "Does Trump suffer from some kind of political death wish? If so, we must hope his fall comes quickly. It is hard to think of any precedent for such a calamitous display of insensitivity, historical ignorance and uncomprehending political stupidity."
                                            },
                                            {
                                                "example_id": "da71d143-757d-48a2-bab5-47f62beccc3a",
                                                "sense_id": "dd97b1c4-5dbe-3a66-9043-44308a57f368",
                                                "text": "Wait, Kris! What the HELL was that!??!?! Why would NOELLE?? Ask ME?? To do HOMEWORK?? With HER?!?? Deathwish much? Does she WANNA fail?"
                                            },
                                            {
                                                "example_id": "d4320d09-9ccf-47ce-ac95-ca38115e7929",
                                                "sense_id": "dd97b1c4-5dbe-3a66-9043-44308a57f368",
                                                "text": "\"I reiterate: outside is death.\" Brenda squeezed her hand. \"You won't make it far by yourself.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
