                ],
                "senses": [
                    {
                        "sense_id": "3cb399e8-f52f-327d-8b83-15ef8a04a6fe",
                        "entry_id": "46af08ec-1f0b-351c-85f7-89453b0ff2ff",
                        "glosses": [
                            "Fertigkeit zur motorischen Beherrschung eines Spiels, gekonnter Umgang mit einem Spielgerät"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "f1a3927f-91b8-4717-9047-b51bac5d8834",
                                "sense_id": "3cb399e8-f52f-327d-8b83-15ef8a04a6fe",
                                "text": "„Seine Spieltechnik war in den 1960er Jahren Vorbild unter anderem für Jimmy Page und Neil Young, aber auch Musiker einer jüngeren Generation wie Pete Doherty orientierten sich an Jansch.“"
                            },
                            {
                                "example_id": "e69535e1-ebac-4678-ae48-88ae93e9a73e",
                                "sense_id": "3cb399e8-f52f-327d-8b83-15ef8a04a6fe",
                                "text": "„Zur Didaktik der Spielerziehung gehört nicht nur die lernende Vermittlung der Spieltechnik und Spieltaktik und die Sicherung eines Spielrahmens, der dem Wesen des Spiels gerecht wird.“"
                            },
                            {
                                "example_id": "0c211c4d-275d-45a3-895d-ab31eb13e422",
                                "sense_id": "3cb399e8-f52f-327d-8b83-15ef8a04a6fe",
                                "text": "„Auch für Kinder ist der Umgang mit den bunten Steinen oder Karten ein Erlebnis, sie finden sich mit der einfachen Spieltechnik, den gemischten Händen, sehr schnell zurecht.“"
                            },
                            {
                                "example_id": "689c3130-89ab-4f42-a858-f35aaeebef13",
                                "sense_id": "3cb399e8-f52f-327d-8b83-15ef8a04a6fe",
                                "text": "„Die Wahl des Spielgeräts, der Spieltechnik, der Spielfeldgröße, der Spielerzahl, der Geräteanzahl, des Spielziels bestimmt wesentlich das Anspruchsniveau des Spiels.“"
                            },
                            {
                                "example_id": "c595e16d-34ec-48a4-a9b3-3755bed9054d",
                                "sense_id": "3cb399e8-f52f-327d-8b83-15ef8a04a6fe",
                                "text": "„Mein Gitarrenlehrer brachte mir uralte Spieltechniken aus dem Mississippi-Delta und aus den Appalachen bei – alles fand in Zeitlupe statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
