                "senses": [
                    {
                        "sense_id": "5bacdca5-659f-38dc-b127-becbff105a22",
                        "entry_id": "246e7f97-4adc-3d19-8b49-b42d654f09a0",
                        "glosses": [
                            "место для проведения соревнований по кордовым моделям"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fddc1ab-b4d6-4613-816a-b1375bd73342",
                                "sense_id": "5bacdca5-659f-38dc-b127-becbff105a22",
                                "text": "Соревнования авиамоделистов — воздушных бойцов состоялись на новом воронежском кордодроме .."
                            },
                            {
                                "example_id": "304c65b7-d346-4fd9-8d07-1157deebed0c",
                                "sense_id": "5bacdca5-659f-38dc-b127-becbff105a22",
                                "text": "Этап Кубка мира и этап Кубка России «16-я Сибирская Икариада» по авиамодельному спорту в классе кордовых моделей воздушного боя прошли на кордодроме спортивного клуба «Московский»."
                            },
                            {
                                "example_id": "0aff4392-697d-4d23-a87f-abf67ee5a736",
                                "sense_id": "5bacdca5-659f-38dc-b127-becbff105a22",
                                "text": "Для запуска кордовых моделей нужен кордодром — асфальтированная площадка с сеткой."
                            }
                        ]
                    }
