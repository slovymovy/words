                "senses": [
                    {
                        "sense_id": "fa4e7ef4-05e8-3d2c-bb00-f679e0fb998a",
                        "entry_id": "e42acf75-36a0-3780-b128-6d511b930486",
                        "glosses": [
                            "Sandwich mit Schinken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adb61485-8f83-4a66-9120-c694e75f0a26",
                                "sense_id": "fa4e7ef4-05e8-3d2c-bb00-f679e0fb998a",
                                "text": "„Für den Dollarschein bekam man in Amerika vielleicht ein Schinkensandwich, in einem thailändischen Flüchtlingslager verwandelte er sich aber in farbenprächtige Baht, die einen kämpfenden Mann tagelang ernähren konnte.“"
                            },
                            {
                                "example_id": "57ee689e-bfad-4262-91e9-037cb7b2f132",
                                "sense_id": "fa4e7ef4-05e8-3d2c-bb00-f679e0fb998a",
                                "text": "„In der Küche legt sie das Gewehr auf den Tisch, während sie ein schnelles, spätes Mittagessen einnimmt - ein Schinkensandwich mit Havarti-Käse, Senf und geschnittenen Tomaten.“"
                            },
                            {
                                "example_id": "c44fd340-ec12-4932-8d82-818298b6d7e6",
                                "sense_id": "fa4e7ef4-05e8-3d2c-bb00-f679e0fb998a",
                                "text": "„Du hast dir die Haare schneiden lassen und ein Schinkensandwich mit Salat und Tomaten bei The American gegessen.“"
                            },
                            {
                                "example_id": "e3c85a41-e5b9-49bb-b1ad-3212e0b3f1cf",
                                "sense_id": "fa4e7ef4-05e8-3d2c-bb00-f679e0fb998a",
                                "text": "„Ein kleines Schinkensandwich lag noch unberührt auf dem Teller vor ihm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
