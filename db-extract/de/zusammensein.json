                        ],
                        "form": "das Zusammensein"
                    },
                    {
                        "form_id": "cbe062b8-8bbe-4a6a-b808-7fe915b8d5de",
                        "entry_id": "54c9af7d-0b81-3d15-b013-8e2ca6ccf0a5",
                        "tags": [
                            "genitive",
