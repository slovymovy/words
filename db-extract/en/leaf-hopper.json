                                "target_senses": [
                                    {
                                        "sense_id": "493aa7ca-2954-34a4-ae00-3d2ed8e72e42",
                                        "entry_id": "c7621b15-832f-39ae-b23d-79e333c286e5",
                                        "glosses": [
                                            "Un insecte piqueur de la famille des cicadellidés (Cicadellidae) qui ressemble à une petite cigale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4c5d3a2-1d28-4b35-bbe0-74b01a65ee2f",
                                                "sense_id": "493aa7ca-2954-34a4-ae00-3d2ed8e72e42",
                                                "text": "La cicadelle du tilleul, Macropsis tilae, pond, elle, ses œufs en provoquant des lésions sur les rameaux. Sa présence se repère aux petites taches jaune argenté que ses piqûres laissent sur les feuilles."
                                            },
                                            {
                                                "example_id": "cf86e6db-c845-45c6-9396-3954abea3fef",
                                                "sense_id": "493aa7ca-2954-34a4-ae00-3d2ed8e72e42",
                                                "text": "Depuis 1975, on a pu identifier avec certitude le rôle joué par plusieurs cicadelles dans la transmission naturelle de \"Spiroplasma citri\", …."
                                            }
                                        ]
                                    }
                                ]
                            }
