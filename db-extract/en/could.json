    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c1e88d0e-65b7-3536-9bed-b9145e79677e",
                "word": "could",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "40527862-f54f-4bbb-9504-cf1e8cd6cc9a",
                        "entry_id": "c1e88d0e-65b7-3536-9bed-b9145e79677e",
                        "tags": [
                            "plural"
                        ],
                        "form": "coulds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fc399cc-b058-3b9a-a7f8-eaf25c512160",
                        "entry_id": "c1e88d0e-65b7-3536-9bed-b9145e79677e",
                        "glosses": [
                            "Something that could happen, or could be the case, under different circumstances; a potentiality."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eac40b9c-e815-4e4b-a2ac-1ea9c81289f5",
                                "sense_id": "1fc399cc-b058-3b9a-a7f8-eaf25c512160",
                                "text": "When the golf ball is there, the whole self-interference package — the hopes, worries, and fears; the thoughts on how-to and how-not-to; the woulds, the coulds, and the shoulds — is there too."
                            },
                            {
                                "example_id": "57708bc9-a667-49ef-b8c1-d971ad8ddcf8",
                                "sense_id": "1fc399cc-b058-3b9a-a7f8-eaf25c512160",
                                "text": "Shushona you must learn to rightfully prioritize all the woulds, shoulds and coulds of your life."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "17da4900-a059-3374-b5ff-7fa96e61520a",
                "word": "could",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "20525875-9777-3522-bc55-42bf0ad4b4fa",
                        "entry_id": "17da4900-a059-3374-b5ff-7fa96e61520a",
                        "glosses": [
                            "simple past of can"
                        ],
                        "tags": [
                            "form-of",
                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "930fcba9-2fc9-4eef-b9b2-574f4dca6b2c",
                                "sense_id": "20525875-9777-3522-bc55-42bf0ad4b4fa",
                                "text": "Before I was blind, I could see very well."
                            },
                            {
                                "example_id": "073f77da-eb30-4121-a272-c7c49b21b67e",
                                "sense_id": "20525875-9777-3522-bc55-42bf0ad4b4fa",
                                "text": "When I was young everybody could easily find a job in a matter of days."
                            },
                            {
                                "example_id": "92f35ffa-ca69-4d50-aebb-90e681fdde71",
                                "sense_id": "20525875-9777-3522-bc55-42bf0ad4b4fa",
                                "text": "When I was your age, I could run 10mi in under an hour."
                            },
                            {
                                "example_id": "982fa878-e62d-46a4-bf18-8898e96cb89d",
                                "sense_id": "20525875-9777-3522-bc55-42bf0ad4b4fa",
                                "text": "I could only find the street, but I couldn't locate his house."
                            }
                        ]
                    },
                    {
                        "sense_id": "05db27fd-841e-3712-87bc-235b636ca20a",
                        "entry_id": "17da4900-a059-3374-b5ff-7fa96e61520a",
                        "glosses": [
                            "conditional of can",
                            "Used as a past subjunctive (contrary to fact)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e2e8770-15e4-4ad5-ba5d-b464246075a0",
                                "sense_id": "05db27fd-841e-3712-87bc-235b636ca20a",
                                "text": "I think he could do it if he really wanted to."
                            },
                            {
                                "example_id": "5dcabb0a-9613-4220-8c84-7eb5ab5e53b1",
                                "sense_id": "05db27fd-841e-3712-87bc-235b636ca20a",
                                "text": "I wish I could fly!"
                            },
                            {
                                "example_id": "0a01682f-2e81-4dec-bd3f-d17665947164",
                                "sense_id": "05db27fd-841e-3712-87bc-235b636ca20a",
                                "text": "I'd have thought you could have done the dishes, at least."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3007048-db6d-353e-b530-1bbcf29e8dad",
                        "entry_id": "17da4900-a059-3374-b5ff-7fa96e61520a",
                        "glosses": [
                            "conditional of can",
                            "Used to politely ask for permission to do something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00bcfcac-9cbe-41ce-936a-31e1467bc4a4",
                                "sense_id": "f3007048-db6d-353e-b530-1bbcf29e8dad",
                                "text": "Could I borrow your coat?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f2e9db45-ce0d-33db-9b03-8c12a55a10fc",
                        "entry_id": "17da4900-a059-3374-b5ff-7fa96e61520a",
                        "glosses": [
                            "conditional of can",
                            "Used to politely ask for someone else to do something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42a37d66-8e21-4043-875c-58f9179e749f",
                                "sense_id": "f2e9db45-ce0d-33db-9b03-8c12a55a10fc",
                                "text": "Could you proofread this email?"
                            },
                            {
                                "example_id": "c059c5d1-b085-4efd-bd92-2c31bfd10a62",
                                "sense_id": "f2e9db45-ce0d-33db-9b03-8c12a55a10fc",
                                "text": "I wonder, you couldn't loan me the money, could you?"
                            }
                        ]
                    },
                    {
                        "sense_id": "4b29644f-9dbc-3032-aa69-2cdebca75148",
                        "entry_id": "17da4900-a059-3374-b5ff-7fa96e61520a",
                        "glosses": [
                            "conditional of can",
                            "Used to show the possibility that something might happen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b8d3916-ec03-4442-b1cf-94879decd061",
                                "sense_id": "4b29644f-9dbc-3032-aa69-2cdebca75148",
                                "text": "Even without hovering drones, a lurking assassin, a thumping score and a denouement, the real-life story of Edward Snowden, a rogue spy on the run, could be straight out of the cinema. But, as with Hollywood, the subplots and exotic locations may distract from the real message: America’s discomfort and its foes’ glee."
                            },
                            {
                                "example_id": "5d2a9188-e631-46fb-866d-4562b01e32a0",
                                "sense_id": "4b29644f-9dbc-3032-aa69-2cdebca75148",
                                "text": "We could rearrange the time if you like."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc85618f-b135-3c41-80d4-5bf2a793f06c",
                        "entry_id": "17da4900-a059-3374-b5ff-7fa96e61520a",
                        "glosses": [
                            "conditional of can",
                            "Used to suggest something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38cf5da1-7536-47d0-97c0-c0c33148fceb",
                                "sense_id": "cc85618f-b135-3c41-80d4-5bf2a793f06c",
                                "text": "You could try adding more salt to the soup."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0a28e18-f615-3b78-8afd-528aba8d2251",
                        "entry_id": "17da4900-a059-3374-b5ff-7fa96e61520a",
                        "glosses": [
                            "past participle of can"
                        ],
                        "tags": [
                            "form-of",
                            "participle",
                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "0b6aefae-f16f-4492-b469-4baf1b88c835",
                                "sense_id": "e0a28e18-f615-3b78-8afd-528aba8d2251",
                                "text": "I haven't could sleep."
                            }
                        ]
                    }
                ],
