                        "entry_id": "76c5e593-564a-3923-9cde-e629bcab5a8f",
                        "glosses": [
                            "augmentative of towarzystwo (“companionship, company”) (group of gathered people)"
                        ],
                        "tags": [
                            "augmentative",
                            "colloquial",
