                    {
                        "sense_id": "61625740-4505-32ed-b7d4-49de01c1a345",
                        "entry_id": "05b21e3d-d791-35b5-b1a0-4850e6bd19fd",
                        "glosses": [
                            "Verkehrsanlage mit Bussteigen zur zentralen Verknüpfung mehrerer Buslinien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25a48abe-b5d1-4c5f-a68f-df03c185acb3",
                                "sense_id": "61625740-4505-32ed-b7d4-49de01c1a345",
                                "text": "„Die Stadt Sursee will das Bahnhofareal aufwerten, einen neuen Bushof bauen und eine unterirdische Velostation erstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c1227b6b-6b9d-3c40-94bd-0c1fe319c62d",
                        "entry_id": "05b21e3d-d791-35b5-b1a0-4850e6bd19fd",
                        "glosses": [
                            "Halle oder Platz zum Abstellen und manchmal Warten von Bussen"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "31162a4b-e998-4b80-88e3-1c220b3904f3",
                                "sense_id": "c1227b6b-6b9d-3c40-94bd-0c1fe319c62d",
                                "text": "Sie muss ihren Bus jeden Abend noch zum Bushof bringen und dort abstellen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
