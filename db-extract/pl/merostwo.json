                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffa514f4-8b36-4235-8913-a85c89c84b62",
                                "sense_id": "f43a579b-bad6-34b1-9f9b-c25eedd535c0",
                                "text": "Możesz zaparkować przed budynkiem merostwa."
