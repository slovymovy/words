        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "e832ecea-f276-396a-b510-8c40a7adff66",
                    "sense_definition": "Указывает на уступку; соответствует по значению словам «хотя», «несмотря на то что».",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это был полезный опыт, <w>пусть</w> и очень трудный.",
                            "target_lang_translations": {
                                "en": "It was a useful experience, <w>even if</w> very difficult.",
                                "zh": "这是一次有益的经历，<w>尽管</w>非常困难。",
                                "nl": "Het was een nuttige ervaring, <w>ook al</w> was het erg moeilijk.",
                                "pl": "To było pożyteczne doświadczenie, <w>chociaż</w> bardzo trudne.",
                                "de": "Es war eine nützliche Erfahrung, <w>wenn auch</w> eine sehr schwierige.",
                                "fr": "C'était une expérience utile, <w>bien que</w> très difficile.",
                                "it": "È stata un'esperienza utile, <w>anche se</w> molto difficile.",
                                "cs": "Byla to užitečná zkušenost, <w>i když</w> velmi těžká.",
                                "tr": "Çok zor <w>olsa</w> da faydalı bir deneyimdi.",
                                "es": "Fue una experiencia útil, <w>aunque</w> muy difícil."
                            }
                        },
                        {
                            "text": "Мы решили ехать на дачу, <w>пусть</w> даже погода испортится.",
                            "target_lang_translations": {
