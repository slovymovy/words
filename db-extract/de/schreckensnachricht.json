                            {
                                "example_id": "a0b02d4b-94b5-4684-9173-610084ee930a",
                                "sense_id": "952e5e66-c813-3afb-b5b3-639d0e970e98",
                                "text": "„Schockierend war an der Schreckensnachricht der Name des Anführers, der die Römer in die tödliche Falle geführt hatte: Arminius vom germanischen Stamm der Cherusker, die mit etwa 200000 Menschen zwischen Elbe, Weser und Harz siedelten.“"
                            },
                            {
                                "example_id": "0ece21e1-e62f-48f7-8971-7ceb193853cd",
                                "sense_id": "952e5e66-c813-3afb-b5b3-639d0e970e98",
                                "text": "„Drei Tage nach der Schreckensnachricht klingelte kurz vor Mitternacht mein Telefon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
