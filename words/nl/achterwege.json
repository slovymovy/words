{
    "word_family": [
        "achterweg"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "79a2f28c-f877-3588-811b-1549c8bf3ba3",
                    "sense_definition": "niet gebeurend of weggelaten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "omissie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een officiële verklaring van de directie bleef helaas <w>achterwege</w>.",
                            "target_lang_translations": {
                                "en": "An official statement from the management was unfortunately not <w>forthcoming</w>."
                            }
                        },
                        {
                            "text": "Sommige details kunnen beter <w>achterwege</w> blijven om de tekst leesbaar te houden.",
                            "target_lang_translations": {
                                "en": "Some details are better <w>omitted</w> to keep the text readable."
                            }
                        }
                    ],
                    "synonyms": [
                        "weggelaten"
                    ],
                    "antonyms": [
                        "aanwezig"
                    ],
                    "common_phrases": [
                        "achterwege blijven"
                    ],
                    "target_lang_definitions": {
                        "en": "not happening, omitted, or failing to materialize"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forthcoming",
                                "target_lang_sense_clarification": "used with 'not' to indicate something expected didn't happen"
                            },
                            {
                                "target_lang_word": "omitted",
                                "target_lang_sense_clarification": "left out or not included"
                            },
                            {
                                "target_lang_word": "lacking",
                                "target_lang_sense_clarification": "absent when expected"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e834a1a-f2de-3e76-8673-ce5403f6565b",
                    "sense_definition": "iets niet doen of niet uitvoeren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "omissie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt die onbeleefde opmerkingen voortaan beter <w>achterwege</w> laten.",
                            "target_lang_translations": {
                                "en": "It would be better if you <w>refrained from</w> making those rude remarks from now on."
                            }
                        },
                        {
                            "text": "De leraar besloot de laatste opdracht <w>achterwege</w> te laten wegens tijdgebrek.",
                            "target_lang_translations": {
                                "en": "The teacher decided to <w>skip</w> the last assignment due to a lack of time."
                            }
                        }
                    ],
                    "synonyms": [
                        "nalaten",
                        "overslaan"
                    ],
                    "antonyms": [
                        "uitvoeren",
                        "doen"
                    ],
                    "common_phrases": [
                        "achterwege laten"
                    ],
                    "target_lang_definitions": {
                        "en": "to refrain from doing something or to omit an action"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "refrain from",
                                "target_lang_sense_clarification": "to deliberately not do something"
                            },
                            {
                                "target_lang_word": "omit",
                                "target_lang_sense_clarification": "to leave something out"
                            },
                            {
                                "target_lang_word": "dispense with",
                                "target_lang_sense_clarification": "to decide not to use or do something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}