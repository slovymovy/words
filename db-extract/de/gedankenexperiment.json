                "senses": [
                    {
                        "sense_id": "c56bbbd4-8e15-3d6a-ab94-12ee7ec25957",
                        "entry_id": "9d18873b-0c06-3357-83f5-cf9731be3f54",
                        "glosses": [
                            "nur gedanklich und nicht praktisch durchgeführtes Experiment zum Beweisen einer Theorie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fdbbb7c-0f1d-4f76-ab01-3107168e39eb",
                                "sense_id": "c56bbbd4-8e15-3d6a-ab94-12ee7ec25957",
                                "text": "„In einem Gedankenexperiment waren die Forscher der Frage nachgegangen, was mit einem Astronauten passierte, wenn dieser in ein Schwarzes Loch stürzt.“"
                            },
                            {
                                "example_id": "11fdf275-a3aa-48dd-bd8f-a0ece768b265",
                                "sense_id": "c56bbbd4-8e15-3d6a-ab94-12ee7ec25957",
                                "text": "„Sobald wir mit dem Begriff Zeit zu experimentieren beginnen, und sei es auch nur als Gedankenexperiment oder zum rein intellektuellen Zeitvertreib, müssen wir feststellen, daß unsere Sprache und mit ihr unsere Denkprozesse uns sehr bald im Stich lassen.“"
                            },
                            {
                                "example_id": "aa0c114a-e9f8-4afc-868d-2f542842d209",
                                "sense_id": "c56bbbd4-8e15-3d6a-ab94-12ee7ec25957",
                                "text": "„Wieland stellt den Roman als ein Gedankenexperiment vor, für dessen Gelingen entscheidend ist, dass ein Charakter wie der vorgestellte möglich sei – mehr aber auch nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
